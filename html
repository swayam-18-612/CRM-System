<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Birthday Box</title>
    <style>
        body {
            background-color: #f0f2f5;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* The Birthday Card / Box */
        .birthday-card {
            position: relative;
            background: white;
            padding: 40px 60px;
            border: 2px solid #ddd;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            text-align: center;
            border-radius: 4px;
        }

        /* The "Tape" at the top */
        .birthday-card::before {
            content: "";
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 35px;
            background: rgba(255, 255, 200, 0.6); /* Semi-transparent yellow tape */
            border-left: 2px dashed rgba(0,0,0,0.1);
            border-right: 2px dashed rgba(0,0,0,0.1);
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        h1 {
            color: #ff4757;
            margin: 0;
            font-size: 2.5rem;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        p {
            color: #57606f;
            font-size: 1.2rem;
            margin-top: 10px;
        }

        .emoji {
            font-size: 3rem;
            display: block;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>

    <div class="birthday-card">
        <span class="emoji">🎁</span>
        <h1>Happiest birthday</h1>
        <p>Happy birthday to my sister-in-law.</p>
        <p>from chotu brother-in-low</p>
     
    </div>

</body>
</html>