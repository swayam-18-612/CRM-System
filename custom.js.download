function getPlanFeaturesData(){return [{"name":"callsheetBuilder","shortDesc":"Call Sheets","description":"Call Sheets","order":8,"show":true,"tooltip":"Create industry-standard call sheets with details such as weather, shoot locations, cast, schedules, and more.","icon":"callsheets","overviewBlockId":"58de8752153efb50dbe0fec9","src":"callsheetBuilder","_id":"55b3e5383223366953622352"},{"name":"stripboard","shortDesc":"Shooting Schedules","description":"Shooting Schedules","order":3,"show":true,"tooltip":"<strong>Import Scripts:</strong> Import Final Draft scripts to parse scene details, cast, pages, etc.<br/><br/><strong>Smart Ordering:</strong> Reorder strips and add day breaks automatically.<br/><br/><strong>Reports:</strong> Generate shooting schedules for printing and sharing.<br/><br/><strong>Version History:</strong> Create new versions with every import. Roll back at any time.<br/><br/><strong>Spin-off Call Sheets:</strong> Populate shoot dates, locations, and schedules automatically.","icon":"stripboard","overviewBlockId":"58be8752153efb50dbe0fec9","withImg":true,"_id":"55b3e55e3223366953612353"},{"name":"team","shortDesc":"Users","description":"Users","hasCounter":true,"tooltip":"Add additional users to your team.","withImg":true,"_id":"55b3e5383233366953622352"},{"name":"shotList","shortDesc":"Shot Lists","description":"Shot Lists","order":7,"show":true,"tooltip":"List out every shot by scene. Tag shots in the script, add camera setups, and share with your team.","icon":"shots","overviewBlockId":"58df8752153efb50dbe0fec9","_id":"55b3e55e32233689536a2353"},{"name":"brandedCallsheets","shortDesc":"Custom Branding","description":"Custom Branding","order":11,"tooltip":"<strong>Email Branding:</strong> Remove StudioBinder branding from outgoing emails.<br/><br/> <strong>Reports:</strong> Remove StudioBinder letterhead from all reports such as shooting schedules, breakdown summaries, storyboards, etc.<br/><br/><strong>Call Sheet SMS:</strong> Remove “Sent via StudioBinder” phrasing in call sheet texts.<br/><br/> ","overviewBlockId":"58de8752153efb50dbe0fec9","_id":"5695846499591ecf6e6b2f29"},{"name":"callsheetPDFs","shortDesc":"Call Sheet PDFs","description":"Call Sheet PDFs","order":4,"tooltip":"Generate and attach PDF versions of call sheets.","overviewBlockId":"58de8752153efb50dbe0fec9","withImg":true,"_id":"55ce82488d085cba14c4a409"},{"name":"projects","shortDesc":"Projects","description":"Projects","hasCounter":true,"order":0.2,"show":true,"tooltip":"Total number of projects per account.","withImg":true,"_id":"55b3e5073223366953612350"},{"name":"workflowColumns","shortDesc":"Workflow Columns","description":"Workflow Columns","order":9,"tooltip":"<strong>Custom Status:</strong> Track progress with customizable statuses across all task cards.<br/><br/> <strong>Customize Workflow:</strong> Create and customize columns on the Workflow page to better fit your company's process.","overviewBlockId":"58ae8752153efb50dbe0fec9","withImg":true,"_id":"589005c12cd54d2024349c58"},{"name":"collaborators","shortDesc":"Editors","description":"Invite Editors","order":13,"show":true,"tooltip":"<strong>Share Pages:</strong> Invite collaborators to specific pages. Collaborators are not required to sign in.<br/><br/><strong>Access Permissions:</strong> Decide which collaborators can view, add comments, or fully edit pages.","shortName":"Invite Collaborators","icon":"contacts-2","overviewBlockId":"58ae8752153efb50dbe0fec9","_id":"5695846499591ecf6e6b2f59"},{"name":"breakdowns","shortDesc":"Script Breakdowns","description":"Script Breakdowns","order":9.1,"show":true,"tooltip":"<strong>Import Script:</strong> Import and display full scripts made in Final Draft.<br/><br/><strong>Tag Elements:</strong> View scenes in script format and tag elements directly on the page.<br/><br/><strong>Element Pages:</strong> Explore elements by category, scene lists, QTY, etc.<br/><br/><strong>Reports:</strong> Generate breakdown summaries, DOOD reports, element reports and more.<br/><br/><strong>Version History:</strong> Create new versions with every import. Roll back at any time.","icon":"breakdowns","overviewBlockId":"58be8752153efb50dbe0fec9","withImg":true,"_id":"55b3e55e3223368953612353"},{"name":"callsheetAttachments","shortDesc":"File Attachments","description":"File Attachments","order":5,"tooltip":"Attach up to 10mb of files to call sheet emails.","overviewBlockId":"58de8752153efb50dbe0fec9","withImg":true,"_id":"55b3e5383223366953612352"},{"name":"reviewers","shortDesc":"Reviewers","description":"Reviewers","hasCounter":true,"order":9,"tooltip":"Invite reviewers to add comments and tasks on pages.","icon":"contacts-2","overviewBlockId":"58ae8752153efb50dbe0fec9","withImg":true,"_id":"5695846499591ecf6e6b2e59"},{"name":"contacts","shortDesc":"Contact Book","description":"Contact Book","order":1,"tooltip":"Organize your rolodex of production contacts. Add contact details, rates, and share custom contact lists with your team.","icon":"contacts","overviewBlockId":"58ae8752153efb50dbe0fec9","withImg":true,"_id":"55b3e59e32233689536a2353"},{"name":"calendar","shortDesc":"Production Calendar","description":"Production Calendar","order":11,"show":true,"tooltip":"<strong>Drag-and-Drop Scheduling</strong> Draw milestones on a gantt-style calendar. View milestones for multiple projects on a single page.<br><br> <strong>Collaborate with Teams</strong> Assign teammates to milestones. Add tasks, comments and files.<br><br> <strong>Calendar Templates</strong> Save calendar templates and quickly apply them to new projects.","icon":"calendars","withImg":true,"_id":"55b3e59e32233689536b2353"},{"name":"fileStorage","shortDesc":"File Storage","description":"File Storage","hasCounter":true,"order":0.1,"show":true,"tooltip":"Total cloud storage per account.","unit":"GB","withImg":true,"_id":"5695803b99591ecf6e6b2f28"},{"name":"callsheetApproval","shortDesc":"Call Sheet Approval System","description":"Client Approval System","order":5,"tooltip":"<strong>Share Preliminary Call Sheet:</strong> Send call sheets for review and digital sign-offs.<br/><br/> <strong>Comments & Feedback:</strong> Enable comments to collect feedback on call sheets.<br/><br/> <strong>Digital Approval:</strong> Request timestamped approvals from supervisors and clients.","overviewBlockId":"58de8752153efb50dbe0fec9","_id":"5727b451b939693719cd5cbb"},{"name":"storyboardList","shortDesc":"Storyboards","description":"Storyboards","order":6,"show":true,"tooltip":"Upload images to visualize every scene. Customize panel sizes, aspect ratios, and more","icon":"storyboards","overviewBlockId":"58df8752153efb50dbe0fec9","withImg":true,"_id":"189005c12cd54d2014349c58"},{"name":"moodboard","shortDesc":"Mood Boards","description":"Mood Boards","order":5,"show":true,"tooltip":"Create and share mood boards to communicate tone and atmosphere.","icon":"moodboards","overviewBlockId":"58df8752153efb50dbe0fec9","withImg":true,"_id":"189005c12cd14d2014349c58"},{"name":"scriptwriting","shortDesc":"Scriptwriting","description":"Scriptwriting","order":1,"show":true,"tooltip":"Write and share screenplays in script format. Import fdx, pdf, and Fountain files to continue writing in StudioBinder.","icon":"screenplays","overviewBlockId":"58df8752153efb50dbe0fcc9","_id":"589005c12cd54d2014349c58"},{"name":"notes","shortDesc":"Docs","description":"Docs","order":2,"show":true,"tooltip":"A shared destination of production notes and documents. Write, organize, and share unlimited documents as you go.","icon":"freeform","overviewBlockId":"58df8752153efb50dbe0fcc9","withImg":true,"_id":"589105c12cd54d2014349c58"},{"name":"avscript","shortDesc":"AV Scripting","description":"AV Scripting","order":2.1,"show":true,"tooltip":"Write and share scripts in two-column audio/video format, ideal for voice-overs, short-form, and commercials","icon":"avscripts","overviewBlockId":"58df8752153efb50dbe0fcc9","withImg":true,"_id":"589005c12cd54d2011349c58"},{"name":"reports","shortDesc":"Reports","description":"Reports","order":5,"show":true,"tooltip":"<strong>Custom Status:</strong> Track progress with customizable statuses across all task cards.<br/><br/> <strong>Customize Workflow:</strong> Create and customize columns on the Workflow page to better fit your company's process.","icon":"reports","_id":"589055c12cd54d2014349c58"},{"name":"scriptOutline","shortDesc":"Script Outline","description":"Script Outline","order":2.2,"tooltip":"Script Outline","icon":"scriptOutline","overviewBlockId":"58df8752153efb50dbe0fcc9","withImg":true,"_id":"599005c12cd54d2011349c58"},{"name":"reportsScheduling","shortDesc":"Reports","description":"Reports","order":4,"show":true,"tooltip":"Generate scheduling reports like shooting schedules, DOOD reports, one-liner schedules, and more.","icon":"reports","overviewBlockId":"58be8752153efb50dbe0fec9","_id":"579055c12cd54d2014349c58"},{"name":"sides","shortDesc":"Script Sides","description":"Script Sides","order":3,"tooltip":"Share the shooting script with the cast, crew, and staff. Filter by character, shoot day, locations, and more.","icon":"sides","overviewBlockId":"58be8752153efb50dbe0fec9","_id":"579055c12cd54d4014349c58"},{"name":"reportsBreakdowns","shortDesc":"Breakdown Reports","description":"Breakdown Reports","order":5,"tooltip":"Generate and share breakdown sheets, summaries, element reports, and more.","icon":"reports","overviewBlockId":"58be8752153efb50dbe0fec9","_id":"599055c12cd54d2014349c58"},{"name":"elements","shortDesc":"Element Manager","description":"Element Manager","order":6,"tooltip":"Add elements, edit details, categories, rates, and merge elements.","icon":"elements","overviewBlockId":"58be8752153efb50dbe0fec9","withImg":true,"_id":"599055c12ce54d2014349c58"},{"name":"elementProfiles","shortDesc":"Element Profiles","description":"Element Profiles","order":7,"tooltip":"Expand on elements with extended details, image mood boards, documents, and share with your team.","icon":"elements","overviewBlockId":"58be8752153efb50dbe0fec9","_id":"599055c12bd54d2014349c58"},{"name":"linkedElements","shortDesc":"Element Linking","description":"Element Linking","order":8,"tooltip":"Link multiple elements into create groups for more efficient tagging.","icon":"elements","overviewBlockId":"58be8752153efb50dbe0fec9","_id":"599055c22cd54d2014349c58"},{"name":"storyboardArrows","shortDesc":"Storyboard Arrows","description":"Storyboard Arrows","order":12.2,"show":true,"tooltip":"Annotate images with a gallery of professionally-drawn storyboard arrows.","icon":"shots","overviewBlockId":"58df8752153efb50dbe0fec9","videoUrl":"https://www.youtube.com/embed/pTCd9V6XAo0","_id":"189005c12cd14d2014359c58"},{"name":"moodboardList","shortDesc":"Mood Boards","description":"Mood Boards","order":5,"tooltip":"Adjust images and filters.","icon":"moodboards","overviewBlockId":"58df8752153efb50dbe0fec9","withImg":true,"_id":"189105c12cd14d2014349c58"},{"name":"storyboardVideos","shortDesc":"Storyboard Videos","description":"Storyboard Videos","order":7,"tooltip":"<strong>Customizable:</strong> Create mood boards.","icon":"storyboard","overviewBlockId":"58df8752153efb50dbe0fec9","_id":"189105c12dd14d2014349c58"},{"name":"videoEditor","shortDesc":"Video Editor","description":"Video Editor","order":8,"tooltip":"<strong>Customizable:</strong> Create mood boards.","icon":"storyboards","overviewBlockId":"58df8752153efb50dbe0fec9","_id":"189105c12ed14d2034349c58"},{"name":"mediaLibrary","shortDesc":"Media Library","description":"Media Library","order":2,"tooltip":"Upload, organize, and share documents and media for every project.","icon":"contacts","overviewBlockId":"58ae8752153efb50dbe0fec9","withImg":true,"_id":"5695803c99591ecf6e6b2f28"},{"name":"pdfBuilder","shortDesc":"PDF Builder","description":"PDF Builder","order":11,"show":true,"tooltip":"Create customizable PDFs. Adjust display details, layouts, and styles.","icon":"download-pdf","overviewBlockId":"58ae8752153efb50dbe0fec9","