                    _this.quill = quill;

                    if(!_this.quill.pagination) {
                        _this.quill.pagination = new Pagination(_this.quill);
                    }

                    _this.readOnly = options.readOnly;
                    _this.changeLock = options.changeLock;
                    _this.onRenumberedForSync = options.onRenumberedForSync;
                    _this.onAddScriptNotes = options.onAddScriptNotes;
                    _this.onAddTitlePage = options.onAddTitlePage;
                    _this.isFirstTextChange = -1;
                    _this.isAuthenticated = options.isAuthenticated ? true : false;
                    _this.isScriptLocked = options.isScriptLocked ? true : false;
                    _this.isScriptLockedFirst = options.isScriptLockedFirst ? true : (options.isScriptLocked ? true : false);
                    //secondary btns are moved
                    _this.showSecondaryButtons = false;//options.showSecondaryButtons ? true : false;

                    if (options.sceneNumber) {
                        _this.sceneNumber = options.sceneNumber;
                    }
                    if (options.withoutRenumber) {
                        _this.withoutRenumber = options.withoutRenumber;
                    }
                    if (options.hideLock) {
                        _this.hideLock = options.hideLock;
                    }
                    _this.watchers = options.watchers ? options.watchers : [];

                    setList('initCharacters');
                    setList('initLocations');
                    setList('initScenes');


                    _this.getParVal = function(el) {
                        return '[' + el.k + '] ' + el.d;
                    }

                    var parTypes = [];
                    for (var prop in ParTypes) {
                        var el = ParTypes[prop];
                        parTypes.push({value: _this.getParVal(el), id: el.t, k: el.k});
                    }
                    _this.parTypes = parTypes;

                    _this.quill.on('text-change', _this.onTextChange.bind(_this));
                    _this.quill.on('selection-change', _this.onSelectionChange.bind(_this));


                    // bind handlers to this instance
                    if (!_this.readOnly) {
                        _this.popupTypes = {
                            Transition: {
                                name: "Transition",
                                values: scriptService.Transitions,
                                parType: ParTypes.transition.v
                            },
                            SceneType: {name: "SceneType", values: scriptService.SceneTypes, parType: ParTypes.scene.v},
                            Location: {name: "Location", parType: ParTypes.scene.v},
                            DayTime: {name: "DayTime", values: scriptService.TimesOfDay, parType: ParTypes.scene.v},
                            CharAppend: {
                                name: "CharAppend",
                                values: scriptService.CharAppend,
                                parType: ParTypes.character.v
                            },
                            Character: {name: "Character", parType: ParTypes.character.v},
                            ParTypes: {name: "ParTypes", values: parTypes},
                        };
                        _this.isPopupElement = isPopupElement;

                        _this.popupSource = popupSource;
                        _this.popupInfo = {
                            startPos: null,
                            itemIndex: 0,
                            values: [],
                            popupType: null,
                            withRemaining: false
                        };

                        _this.onPopupOpen = onPopupOpen;

                        _this.options = {
                            renderItem: function (item) {
                                return item.text ? item.text : item.value;
                            },
                            allowedChars: /^[A-Za-z\sÅÄÖåäö]*$/,

                            offsetTop: 2,
                            offsetLeft: 0,
                            isolateCharacter: false,
                            fixPopupsToQuill: false,
                            defaultMenuOrientation: 'bottom',
                            dataAttributes: ['value', 'id', 'k'],
                        };

                        addContainer('popupRemaining', 'ql-mention-remaining');

                        var field = 'sceneNumberField';
                        addContainer(field, 'ql-mention-scenenumber scene-wrapper', true);

                        _this.sceneInputEl = document.createElement('input');
                        LCS.addClass(_this.sceneInputEl, 'form-control hover-underline');
                        BlotService[field].appendChild(_this.sceneInputEl);

                        _this.popupContainer = document.createElement('div');
                        LCS.addClass(_this.popupContainer, 'ql-mention-list-container sb-hide');
                        _this.popupContainer.style.position = 'absolute';

                        if (_this.options.fixPopupsToQuill) {
                            _this.popupContainer.style.width = 'auto';
                        }
                        _this.popupList = document.createElement('ul');
                        _this.popupList.className = 'ql-mention-list';
                        _this.popupContainer.appendChild(_this.popupList);

                        _this.popupContainer.onmousemove = _this.onContainerMouseMove.bind(_this);
                        _this.quill.container.appendChild(_this.popupContainer);

                        //todo create the side popovers
                        _this.clickHandler = _this.clickHandler.bind(_this);
                        LCS.bindElementListeners(true, _this.quill.root, _this.clickHandler);

                        _this.handlePaste = _this.handlePaste.bind(_this);
                        LCS.bindElementListeners(true, _this.quill.root, _this.handlePaste, 'paste', false);

                        _this.bindKeyboardEvents();
                        _this.bindSecondaryBtns();

                        bind('SYNC_QUILL_TO_PROJECT', 'onSyncToProject');
                        bind('QUILL_LOCK_CHANGED', 'onLockChanged');

                        bind('SCRIPT_LOCK_POPUP', 'lockHandler');
                        bind('SCRIPT_NOTES_POPUP', 'scriptNotesHandler');
                        bind('SCRIPT_TITLEPAGE_POPUP', 'scriptTitlePageHandler');

                        bind('SCRIPT_SYNC_POPUP', 'syncHandler');
                        bind('SCRIPT_RENUMBER_POPUP', 'renumberHandler');
                        bind('SCRIPT_CHARACTERS', 'exportCharactersHandler');
                        bind('SCRIPT_LOCATIONS', 'exportLocationsHandler');
                    }


                    function setList(type) {
                        if(options[type] && options[type].length>0){
                            _this[type] = options[type];
                        }
                    }
                    function bind(e, m){
                        _this[m] = _this[m].bind(_this);
                        //console.log('editor event binded: ' + e + ': ' + m);
                        if(!config.watchers){config.watchers=[];}
                        _this.watchers.push(
                            RootEventsService.addRootWatcher(config.watchers, e, _this[m])
                        );
                    }

                    function addContainer(name, cls, onService){
                        _this[name] = document.createElement('div');
                        LCS.addClass(_this[name],  cls + ' sb-hide');
                        _this[name].style.position = 'absolute';
                        _this.quill.container.appendChild(_this[name]);
                        if(onService){
                            BlotService[name] = _this[name];
                        }
                    }

                    function isPopupElement(popupType, val){
                        if(!val){return false;}
                        val = val.toLowerCase();
                        return _.find(popupType.values, function(el){
                            return val === el.toLowerCase();
                        });
                    }

                    function onMouseOver(ev) {
                        var node = Parchment.find(ev.target);
                        if (BlotService.isScenePar(node)) {
                            this.quill.setSelection(image.offset(this.quill.scroll), 1, Sources.USER);
                        }
                    }

                    function onMouseOut(ev) {
                        var node = Parchment.find(ev.target);
                        if (BlotService.isScenePar(node)) {
                            this.quill.setSelection(image.offset(this.quill.scroll), 1, Sources.USER);
                        }
                    }

                    function popupSource(searchTerm, renderList, popupType) {
                        //console.log('popupSource');
                        var popupTypes = _this.popupTypes[popupType], same = false;

                        if (!popupTypes) {return;}

                        _this.popupInfo.popupType = popupType;
                        _this.popupInfo.parType = popupTypes.parType;
                        if (popupType === _this.popupTypes.Character.name) {
                            popupTypes.values = _this.characters;
                        } else if (popupType === _this.popupTypes.Location.name) {
                            popupTypes.values = _this.locations;
                        }
                        var values = popupTypes.values ? popupTypes.values.map(function (val) {
                            return typeof(val) === 'string' ? {value: val} : val;
                        }) : [];

                        var l = searchTerm ? searchTerm.length : 0;
                        if (l > 0) {
                            var matches = [], val, v, match,
                                exp = new RegExp('^' + escapeRegexp(searchTerm), 'gi');
                            for (var i = 0; i < values.length; i++) {
                                val = values[i];
                                v = val.value;
                                match = v.match(exp);
                                if (match) {
                                    var m = match[0];
                                    val.text = "<strong>" + m + "</strong>" + (v.length > m.length ? v.substring(m.length) : '');
                                    matches.push(val);
                                }
                            }
                            return renderList(matches, searchTerm);
                        } else {
                            return renderList(values, searchTerm);
                        }
                    }
                }

                function escapeRegexp(queryToEscape) {
                    return queryToEscape.replace(/([.?*+^$[\]\\(){}|-])/g, '\\$1');
                }

                ScriptingModule.prototype.hideClickedBlock =  function(justClear){
                    var _this = this;
                    if(_this.clickedBlock) {
                        if(!justClear) {
                            BlotService.setNodeScene(_this.clickedBlock, _this.sceneInputEl.value || '');
                        }
                        _this.bindSceneNumberEvents( false);
                        _this.clickedBlock = null;
                        LCS.addClass(BlotService.sceneNumberField, 'sb-hide');
                    }
                }

                ScriptingModule.prototype.clickHandler =  function(e){
                    //console.log('ScriptingModule.prototype.clickHandler');
                    var _this = this,
                        blot = e.target.__blot.blot,
                        node = blot.constructor && blot.constructor.className && blot.constructor.className.indexOf(SBScriptEditorClass) !== -1 ? blot : null;

                    var isScene = node ? BlotService.isScenePar(node) : null,
                        isSceneNumber = e.offsetX < blot.domNode.offsetLeft,
                        cont = BlotService.sceneNumberField;
                    if (isScene && isSceneNumber) {
                        if(_this.clickedBlock !== node) {
                            _this.hideClickedBlock();
                            setNodeFocus(node);
                        }
                    } else {
                        _this.hideClickedBlock();
                    }

                    function setNodeFocus(){
                        _this.clickedBlock = node;
                        if (_this.sceneInputEl) {
                            _this.sceneInputEl.value = node.domNode.dataset.scene || '';
                            LCS.timeout(function (){
                                _this.sceneInputEl.focus();
                            },10);
                            _this.bindSceneNumberEvents(true);
                        }
                        BlotService.setPosition(cont, node.domNode.offsetTop);
                        if(cont){
                            var editor = _this.quill.container.querySelector('.ql-editor');
                            if(editor) {
                                var s = window.getComputedStyle(editor),
                                marginLeft = (s.width + parseInt(s.marginRight.replace('px', '')) + 10) + 'px';
                                if(!cont.style) {
                                    cont.style = {};
                                }
                                cont.style.setProperty('left', marginLeft, 'important');
                            }
                        }

                        LCS.removeClass(cont, 'sb-hide');
                    }
                };

                ScriptingModule.prototype.bindSceneNumberEvents =  function(isBind) {
                    var _this = this;
                    if (_this.sceneInputEl) {
                        if (!_this.sceneInputBlur) {
                            _this.sceneInputBlur = function (e) {
                                //console.log('sceneInputBlur');
                                preventDefault(e);
                                clear();
                            }
                        }
                        if (!_this.sceneInputKeyUp) {
                            _this.sceneInputKeyUp = function (e) {
                                if (e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                }
                                //console.log('sceneInputKeyUp');
                                if (e.type === 'paste') {
                                    //process();
                                    return;
                                }
                                switch (e.which) {
                                    case 13: //enter
                                        preventDefault(e);
                                        clear();
                                        break;

                                    case 27: //esc
                                        preventDefault(e);
                                        clear(true);
                                        break;

                                    default:
                                        e.stopPropagation();
                                        break;
                                }
                            }
                        }

                        LCS.bindElementListeners(isBind, _this.sceneInputEl, _this.sceneInputBlur, 'blur');
                        LCS.bindElementListeners(isBind, _this.sceneInputEl, _this.sceneInputKeyUp, 'keyup');
                        LCS.bindElementListeners(isBind, _this.sceneInputEl, _this.sceneInputKeyUp, 'paste');

                        function clear(justClear) {
                            _this.hideClickedBlock(justClear);
                        }

                        function preventDefault(e) {
                            LCS.preventDefault(e);
                        }
                    }
                }

                ScriptingModule.prototype.handlePaste = function (evt) {
                    //console.log('ScriptingModule.prototype.handlePaste');
                    var t0 = performance.now();
                    var _this = this;
                    if (evt.clipboardData && evt.clipboardData.items && evt.clipboardData.items.length) {
                        // Remove background and color
                        _this.quill.clipboard.addMatcher(Node.ELEMENT_NODE, function (node, delta) {
                            // ////console.log(node);
                            delta.ops.forEach(function (match) {
                                var attrs = match.attributes;
                                if (attrs) {
                                    var parId = attrs.id;
                                    var ch = _this.getBlots(), l = ch && ch.length > 0 ? ch.length : 0,
                                        exists;
                                    if (parId) {
                                        if (parId.indexOf('par') === 0) {
                                            //check if the par already exists
                                            exists = false;
                                            if (l > 0) {
                                                ch.forEach(function (node) {
                                                    if(BlotService.getId(node) === parId) {
                                                        exists = true;
                                                    }
                                                });
                                            }
                                            if (exists) {
                                                //console.log('parId alreadyExists');
                                                delete match.attributes.id;
                                            }
                                        } else {
                                            delete match.attributes.id;
                                        }
                                    }

                                    var prop = 'scene',
                                        isScene = attrs[prop] === true,
                                        attr = 'data-'+prop;
                                    if (isScene) {
                                        var sceneNumber = attrs[attr];
                                        if (l > 0) {
                                            ch.forEach(function (node) {
                                                var s = node && node.dataset ? node.dataset[prop] : null;
                                                if (s && s.toLowerCase() === sceneNumber) {
                                                    delete match.attributes[attr];
                                                }
                                            });
                                        }
                                    } else {
                                        delete match.attributes[attr];
                                    }

                                    delete match.attributes['style'];
                                }
                            });
                            return delta;
                        });
                        _this.pastedItems = true;
                    }

                    getExecTime('handlePaste', t0);
                };

                ScriptingModule.prototype.bindKeyboardEvents = function () {
                    var _this = this;

                    bind(Keys.TAB, 'keyTabHandler', true);
                    bind(Keys.ENTER, 'keyEnterHandler', true);
                    bind(Keys.SPACE, 'keySpaceHandler', false);
                    bind(Keys.BACKSPACE, 'keyBackspaceHandler', false);
                    bind(Keys.ESCAPE, 'escapeHandler', true);
                    bind(Keys.UP, 'keyUpHandler', false);
                    bind(Keys.DOWN, 'keyDownHandler', false);
                    bind(Keys.RIGHT, 'keyRightHandler', true);

                    for (var p in ParTypes) {
                        var par = ParTypes[p];
                        _this.quill.keyboard.addBinding({
                            key: par.k,
                            shiftKey: false,
                            empty: true
                        }, onParKey);

                        function onParKey(range, context){
                            if (_this.isPopupOpen &&
                                _this.popupInfo.popupType === _this.popupTypes.ParTypes.name){
                                _this.selectItem(_this.getParVal(par));
                                return false;
                            }
                            return true;
                        }
                    }

                    // Handlers can also be added post initialization
                    var toolbar = _this.quill.getModule('toolbar');

                    for (var prop in ParTypes) {
                        addCustomKey(ParTypes[prop]);
                    }

                    function bind(key, method, unbind){
                        _this.quill.keyboard.addBinding({key: key }, _this[method].bind(_this));
                        if(unbind) {
                            _this.quill.keyboard.bindings[key].unshift(_this.quill.keyboard.bindings[key].pop());
                        }
                    }

                    function addCustomKey(par) {
                        var keyCode = par.k;
                        _this.quill.keyboard.addBinding({
                            key: keyCode,
                            altKey: true,
                            shortKey: false,
                            //shiftKey: prop === ParTypes.action.t
                        }, function (range, context) {
                            onCustomKey();
                        });

                        toolbar.addHandler(prop, function (value) {
                            //console.log('btnClick' + prop + ': ' + value);
                            onCustomKey(value);
                        });

                        function onCustomKey(value) {
                            console.log('onCustomKey ' + value);
                            _this.changeScriptFormat(_this.selectedBlot, par.t);
                        }
                    }
                };

                function showNextPopup(_this, node, other){
                    if(other && other.hideExisting) {
                        _this.hidePopupList();
                    }

                    var nextPopup = other && other.nextPopup ? other.nextPopup : _this.getNextPopup(node);

                    if (nextPopup) {
                        _this.showPopup(nextPopup);
                    }
                    return nextPopup;
                }

                function processLabelLock(_this, li, dontBindEvents) {
                    if (li) {
                        var els = li.children[0].children;
                        for (var i = 0; i < els.length; i++) {
                            var el = els[i], cls = el.className, prop;
                            if (cls.indexOf('btnLock') !== -1) {
                                LCS[_this.isScriptLocked ? 'addClass' : 'removeClass'](el, 'active');
                                el.querySelector('.sbf').setAttribute('class', 'sbf ' +
                                    (_this.isScriptLocked ? 'lock' : 'unlock gray'));
                                if (!dontBindEvents) {
                                    _this.lockHandler = _this.lockHandler.bind(_this);
                                    LCS.bindElementListeners(true, el, _this.lockHandler);
                                }
                            }

                            if (cls.indexOf('btnSync') !== -1) {
                                if (!dontBindEvents) {
                                    _this.syncHandler = _this.syncHandler.bind(_this);
                                    LCS.bindElementListeners(true, el, _this.syncHandler);
                                }
                            }
                        }
                    }
                }

                ScriptingModule.prototype.keyBackspaceHandler = function (range, context) {
                    //console.log('keyBackspaceHandler');
                    var _this = this;
                    //if at the begining of the line don't allow to backspace into previous block
                    var node = getSelectedBlot(_this);
                    if (node){
                        if(context.empty){
                            _this.hidePopupList();
                        }else if(!context.prefix && range && range.length === 0) {
                            var prev = node ? node.prev : null,
                                type = BlotService.getParType(node);
                            if (type === ParTypes.scene.v && range.length === 1) {
                                _this.RunRenumber = true;
                            }
                            if (prev && type !== BlotService.getParType(prev)) {
                                soundEffectService.play(soundEffectService.SOUND_TYPES.DROP_CALL);
                                return false;
                            }
                        }
                    }
                    return true;
                }

                ScriptingModule.prototype.keyUpHandler = function (range, context) {
                    return processUpDownRight(this, Keys.UP);
                }

                ScriptingModule.prototype.keyDownHandler = function (range, context) {
                    return processUpDownRight(this, Keys.DOWN);
                }

                ScriptingModule.prototype.keyRightHandler = function (range, context) {
                    return processUpDownRight(this, Keys.RIGHT);
                }

                function processUpDownRight(_this, type){
                    //console.log('processUpDownRight ' + type);
                    if (_this.isPopupOpen) {
                        switch (type) {
                            case Keys.UP:
                                _this.prevItem();
                                break;

                            case Keys.DOWN:
                                _this.nextItem();
                                break;

                            case Keys.RIGHT:
                                _this.selectItem(undefined, Keys.RIGHT);
                                break;

                        }
                        return false;
                    } else {
                        _this.quill.keyType = type;
                    }
                    return true;
                }

                ScriptingModule.prototype.keySpaceHandler = function (range, context) {
                    //console.log('keySpaceHandler');
                    var _this = this;
                    if(context.empty){
                        showNextPopup(_this, getSelectedBlot(_this));
                        return false;
                    }
                    return true;
                }

                ScriptingModule.prototype.keyEnterHandler = function (range, context) {
                    var _this = this;
                    return keyEnterTab(_this, range, context, true);
                };

                ScriptingModule.prototype.keyTabHandler = function (range, context) {
                    var _this = this;
                    return keyEnterTab(_this, range, context, false);
                };

                function getTextAfter(_this, node, startBlot){
                    return _this.getText(_this.cursorPos, (startBlot === undefined ?_this.getNodeIndex(node) : startBlot) + node.length() - _this.cursorPos).replace('\n','').replace(/ -(\s)*$/, '');
                }

                function keyEnterTab(_this, range, context, isEnter){
                    //console.log(isEnter ? 'keyEnterHandler' : 'keyTabHandler');
                    if (_this.isPopupOpen) {
                        _this.selectItem(undefined, isEnter ? Keys.ENTER : Keys.TAB);
                        return false;
                    }

                    var format = context.format,
                        isEmpty = context.empty,
                        suffix = context.suffix,
                        current = getCurrentFormat(format),
                        removeExtraPar = isEnter ? (!suffix || suffix && suffix.trim() === '') : true,
                        node = getSelectedBlot(_this),
                        next = null,
                        textAfter;

                    if (isEmpty){
                        if(isEnter) {
                            showNextPopup(_this, node, {
                                nextPopup: _this.popupTypes.ParTypes,
                                isEmpty: isEmpty
                            });
                            return false;
                        }
                    }else{
                        if(!isEnter){
                            textAfter = getTextAfter(_this, node);
                            if(textAfter){
                                return ;
                            }
                        }
                    }

                    switch (current) {
                        case ParTypes.character.t:
                        case ParTypes.scene.t:
                            var isScene = current === ParTypes.scene.t;
                            if(isEmpty || !isScene){
                                goNext();
                            }
                            else {
                                var text = getBlotTextToCursor(_this, node), match;
                                node = _this[isScene ? 'getSceneHeadingInfo' : 'getCharactersHeadingInfo'](node, text, {
                                    addMissing: !isEnter
                                });

                                var sceneInfo = _this.getSceneInfo(node),
                                    nextPopup = sceneInfo ? sceneInfo.popupType : null;

                                if (!nextPopup || nextPopup && isEnter) {
                                    goNext();
                                } else {
                                    switch (nextPopup.name) {
                                        case _this.popupTypes.Location.name:
                                            match = ' ';
                                            get(' ', _this.popupTypes.Location);
                                            break;

                                        case _this.popupTypes.DayTime.name:
                                            get(scriptService.LineSep, _this.popupTypes.DayTime, true);
                                            break;
                                    }

                                    function get(match, popupType, withReplace) {
                                        if (isScene) {
                                            node = getSceneHeader(_this, node,
                                                text.substring(text.length - match.length) !== match ? ((withReplace ? text.replace(/ -(\s)*$/, '') : text) + match) : text, popupType);
                                        }
                                    }

                                    return false;
                                }

                            }

                            function goNext(){
                                if (!isEmpty) {
                                    isScene ? _this.addLocationFromNode(node) : _this.addCharacterFromNode(node);
                                }
                                next = isScene ? ParTypes.action.t : (isEnter ? ParTypes.dialogue.t : ParTypes[isEmpty ? 'transition' : 'parenthetical'].t);
                            }
                            break;

                        case ParTypes.parenthetical.t:
                            next = ParTypes.dialogue.t;
                            break;

                        case ParTypes.dialogue.t:
                            next = isEnter ? ParTypes.action.t : ParTypes.parenthetical.t;
                            break;

                        case ParTypes.transition.t:
                            next = ParTypes.scene.t;
                            break;

                        case ParTypes.page.t:
                            next = ParTypes.page.t;
                            break;

                        case ParTypes.action.t:
                            if(isEnter) {
                                var prefix = context.prefix;
                                if (scriptService.isTransition(prefix)) {
                                    node = _this.changeScriptFormat(node, ParTypes.transition.t);
                                    if (prefix.match(/fade out/gi)) {
                                        next = ParTypes.action.t;
                                    } else {
                                        next = ParTypes.scene.t;
                                    }
                                } else {
                                    next = ParTypes.action.t;
                                }
                            }else{
                                next = ParTypes[isEmpty ? 'character' : 'action'].t;
                            }
                            break;

                        default:
                            next = ParTypes.action.t;
                            break;
                    }

                    node = !isEnter && isEmpty ?
                        _this.changeScriptFormat(node, next) :
                        _this.insertEmbed(node, next, removeExtraPar);

                    if(isEmpty){
                        if (_this.isPopupOpen) {
                            _this.hidePopupList();
                        }
                    }
                    else if(!isEnter){
                        showNextPopup(_this, node, {
                            isEmpty: isEmpty,
                            hideExisting: isEmpty,
                            nextPopup: nextPopup
                        });
                    }
                }

                ScriptingModule.prototype.bindSecondaryBtns = function (dontBindEvents) {

                    //console.log('ScriptingModule.prototype.bindSecondaryBtns')
                    var _this = this;

                    var toolbar = _this.quill.getModule('toolbar'),
                        ch = toolbar.container.children,
                        secCh = ch.length > 1 ? toolbar.container.children[1] : null;
                    if(!secCh){return;}

                    if (!secCh.style) {
                        secCh.style = {};
                    }


                    var btns = secCh.children;
                    for (var i = 0; i < btns.length; i++) {
                        var btn = btns[i], cls = btn.className;
                        if (cls.indexOf('renumber') !== -1) {
                            processBtnRenumber(btn);
                        }
                        if (cls.indexOf('script-notes') !== -1) {
                            processBtnScriptNotes(btn);
                        }
                    }

                    if (!dontBindEvents && !_this.hideLock) {
                        LCS.appendChildFragment(secCh, '<div class="table-div lockContainer"><div class="centered">' +
                            '<a class="btnLock btnq with-margin-right"><div class="sbf pull-left gray">' + LCS.getISBPath(3) +'</div></a>' +
                            (_this.isAuthenticated ? ('<a class="btnSync hide-ipad">' + LCS.getISBDiv('sync', 2, 'pull-left') + ' <span class="hide-lower1200">Sync to Project</span></a>') : '' ) +
                            '</div></div>');
                    }
                        //secCh.style.display = 'none';

                    if(secCh){_this.secCh = secCh;}
                    if(btns.length>0) {
                        processLabelLock(_this, btns[btns.length - 1], dontBindEvents);
                    }

                    function processBtnRenumber(btn) {
                        bind(btn, 'renumberHandler', false);
                    }

                    function processBtnScriptNotes(btn) {
                        bind(btn, 'scriptNotesHandler', false);
                    }

                    function processBtnEditSceneNumber(li, btn) {
                        bind(btn, 'editSceneNumberHandler', true);
                    }

                    function bind(btn, m, withShow){
                        if (btn) {
                            if (!dontBindEvents) {
                                _this[m] = _this[m].bind(_this);
                                LCS.bindElementListeners(true, btn, _this[m]);
                            }
                            if(withShow) {
                                showLi(li);
                            }
                        }
                    }
                    function showLi(li) {
                        if (!li.style) {
                            li.setAttribute('style', '');
                        }
                        li.style.display = !_this.isScriptLocked ? 'none' : 'block';
                    }
                };

                ScriptingModule.prototype.onSyncToProject = function (did) {
                    //console.log('ScriptingModule.onSyncToProject');
                    var _this = this ;
                    if (did === getId(_this)){
                        //chekid && check if has missing scene numbers if yes trigger popup
                        _this.onRenumberedForSync({renumberId: did});
                    }
                };

                ScriptingModule.prototype.onLockChanged = function (data) {
                    //console.log('ScriptingModule.onLockChanged');
                    var _this = this;
                    var id = data.id;
                    var did = getId(_this);
                    if (did && did.endsWith(id.toString())){
                        //chekid && check if has missing scene numbers if yes trigger popup

                        _this.isScriptLocked = data.isLocked ? true:false;
                        _this.isScriptLockedFirst = data.isLockedFirst ? true:false;
                        if(_this.isScriptLocked) {
                            _this.autosetSceneNumbers();
                        }

                        if(_this.secCh){
                            var btns = _this.secCh.children;
                            processLabelLock(_this, btns[btns.length - 1], true);
                        }
                    }
                };
                ScriptingModule.prototype.scriptNotesHandler = function (e) {
                    //console.log('ScriptingModule.scriptNotesHandler');
                    var _this = this;
                    _this.onAddScriptNotes({id: getId(_this)});
                };

                ScriptingModule.prototype.scriptTitlePageHandler = function (e) {
                    //console.log('ScriptingModule.scriptTitlePageHandler');
                    var _this = this;
                    _this.onAddTitlePage({id: getId(_this)});
                };

                ScriptingModule.prototype.syncHandler = function (e) {
                    //console.log('ScriptingModule.syncHandler');
                    var _this = this;
                    var props =  {
                            btn: 'Apply',
                            icon: 'sync',
                            //title:  txt + ' this screenplay',
                            title: 'Ready to Sync?',
                            //pageClass: $ctrl.pageClass,
                            accordion: {
                                title:'Things to know about syncing a screenplay',
                                content: '<ul>' +
                                    '<li>Your screenplay content will be synced across various pages such as breakdowns, shot lists, stripboards etc.</li>' +
                                    '<li>If you don’t have scene numbers yet, they will be assigned to every scene heading.</li>' +
                                    '<li>You can return to this page anytime to edit your screenplay. When you’re done, remember to re-sync so the project reflects the changes.</li>' +
                                    '<li>When you add a new scene on a previously synced screenplay, a letter will automatically follow the scene number (e.g. Scene 2A). This preserves the scene numbers that follow.</li>' +
                                    '</ul>'
                            },
                            message: '<p>If you’re done with a screenplay and ready to start production planning, it’s time to sync it to your project. Syncing a script turns it into a “shooting script,” and updates your project on various pages.</p>'
                        },
                        next = function () {
                            _this.onSyncToProject(getId(_this));
                        };

                    var checkQuota = false;// 'stripboard' enable for everybody for now
                    CPS.popupsService.openConfirmPopup({
                        next: next,
                        props: props ,
                        confirmType: 'confirmLarge',
                        checkTeamAccess: true,
                        checkQuota:checkQuota,
                        dontShowAgainProp: 'showsync',
                    }, checkQuota ? CPS : null);
                };

                function getId(_this){
                    //return _this.quill.root.parentElement.parentElement.parentElement.getAttribute('data-id');
                    return _this.quill.root.parentElement.parentElement.id;
                }

                ScriptingModule.prototype.exportCharactersHandler = function (e) {
                    processScenes(this, 'character');
                }

                ScriptingModule.prototype.exportLocationsHandler = function (e) {
                    processScenes(this, 'location');
                }

                ScriptingModule.prototype.exportScenes = function (e) {
                    processScenes(this, 'scene');
                }

                function processScenes(_this, type) {
                    //console.log('processScenes: ' + type);
                    var node, i = 0, j = -1,
                        ch = _this.getBlots(),
                        l = ch && ch.length > 0 ? ch.length : 0, prev;
                    if (l > 0) {
                        var sceneNumber, el, scenes = [], locations = [], characters;
                        while ((node = (i === 0 ? ch.head : node.next)) && i < l) {
                            //console.log('i: '+i);
                            if (!node) {
                                break;
                            }
                            var parType = BlotService.getParType(node);
                            if (parType === ParTypes.scene.v) {
                                j++;
                                sceneNumber = BlotService.getSceneNumber(node);
                                scenes.push({scene: sceneNumber, text: _this.getNodeValue(node)});
                                if (type === 'location'){
                                    var sceneInfo = _this.getSceneInfo(node);
                                    locations = processItem(locations, sceneInfo ? sceneInfo.location : null);
                                }
                            }else{
                                if (type === 'character' && parType === ParTypes.character.v) {
                                    var sceneInfo = _this.getSceneInfo(node);
                                    var char = sceneInfo ? sceneInfo.character : null;
                                    if(char && char.length>0){
                                        _.each(char, function (c) {
                                            characters = processItem(characters, sceneInfo ? sceneInfo.character : null);
                                        });
                                    }
                                }
                            }
                            i++;

                            function processItem(list, val){
                                var exists;
                                if(val){
                                    for(var x = 0; x < list.length;x++) {
                                        var name = list[x].name ? list[x].name.toUpperCase() : null;
                                        if(name === val){
                                            if(_.find(list[x].scenes, sceneNumber) === undefined){
                                                list[x].scenes.push(sceneNumber);
                                            }
                                            exists = true;
                                            break;
                                        }
                                    }
                                    if(!exists){
                                        list.push({name: val, scenes:[sceneNumber]});
                                    }
                                }
                                return list;
                            }
                        }
                    }
                }

                //with one option
                ScriptingModule.prototype.renumberHandler = function (e) {
                    //console.log('ScriptingModule.renumberHandler');
                    var _this = this;

                    var isSyncScript = e && e.isSyncScript ? true : false,
                        params = isSyncScript && e ? {renumberId: e.renumberId} : null;


                    var props = {
                            modalLarge: true,
                            btn: 'Apply',
                            icon: 'renumber',
                            title:  (isSyncScript ? "Renumber Scenes before Syncing to Project" : "Scene Numbers"),
                            //pageClass: $ctrl.pageClass,
                            message: '<p class="text-center">Are you sure? This will overwrite existing scene numbers and renumber based on numbers.</p>',
                         },
                        next = function () {
                            _this.autosetSceneNumbers(true, true);

                            if (isSyncScript) {
                                _this.onRenumberedForSync(params);
                            }
                        };

                    CPS.popupsService.openConfirmPopup({
                        next: next,
                        props: props,
                        confirmType: 'confirmLarge',
                        checkTeamAccess: false
                    });
                };

                ScriptingModule.prototype.lockHandler = function (e) {
                    //console.log('ScriptingModule.lockHandler');
                    var _this = this,
                        txt = _this.isScriptLocked ? 'Unlock' : 'Lock';

                    var props = {
                            modalLarge: true,
                            btn: 'Apply',
                            icon: txt.toLowerCase(),
                            title: txt + ' Your Screenplay?',
                            accordion: _this.isScriptLocked ? '' : {
                              title: 'Things to know about locking a screenplay',
                              content: '<ul>' +
                                    '<li>You can edit a locked screenplay at anytime.</li>' +
                                    '<li>If you add a new scene to a locked screenplay, a letter will automatically follow the scene number (e.g. Scene 2A). This preserves the scene numbers that follow.</li>' +
                                    '<li>When you’re ready to begin production planning in StudioBinder, <semibold>sync</semibold> the screenplay to your project.</li>' +
                                    '<li>You can re-sync your screenplay at anytime.</li>' +
                                    '<li>When you re-sync, all changes, including new and omitted scenes, will update across your project.</li>' +
                                    '</ul>'
                            },
                            //pageClass: $ctrl.pageClass,
                            message: _this.isScriptLocked ?
                                    ('<p class="accordion-with-list text-center">Unlocking a script will allow you to make changes without automatically adjusting the scene numbers or marking deleted scenes as “omitted.”</p>') :
                                    ('<p class="accordion-with-list">If you’re done with a screenplay and ready to start production planning, lock it. Locking a screenplay assigns scene numbers to each scene heading. That way everyone on a production has the same point of reference.</p>')
                        },
                        next= function() {
                            _this.isScriptLocked = !_this.isScriptLocked;
                            if (!_this.isScriptLockedFirst && _this.isScriptLocked) {
                                _this.isScriptLockedFirst = true;
                            }
                            if(_this.isScriptLocked){
                                _this.autosetSceneNumbers();
                            }

                            if (typeof(_this.changeLock) === 'function') {
                                _this.changeLock({
                                    isLocked: _this.isScriptLocked,
                                    isScriptLockedFirst: _this.isScriptLockedFirst
                                });
                            }
                            _this.bindSecondaryBtns(true);
                        };

                    CPS.popupsService.openConfirmPopup({
                        next: next,
                        props: props,
                        confirmType: 'confirmLarge',
                        checkTeamAccess: false,
                        //dontShowAgainProp: 'confirm'+txt
                    });
                };

                ScriptingModule.prototype.getBlots = function(){
                    //console.log('ScriptingModule.prototype.getBlots');
                    var t0 = performance.now();
                    var _this = this;
                    //return array of children
                    var ch = _this.quill.scroll.children;

                    getExecTime('ScriptingModule.prototype.getBlots', t0);
                    return ch;
                };

                ScriptingModule.prototype.getText = function(offset, length){
                    //console.log('ScriptingModule.prototype.getText');
                    var _this = this;
                    //return array of children
                    return _this.quill.getText(offset, length);
                };

                ScriptingModule.prototype.deleteText = function(offset, length, source) {
                    //console.log('ScriptingModule.prototype.deleteText');
                    var _this = this;
                    _this.quill.deleteText(offset, length, source ? source : Sources.API);
                };

                ScriptingModule.prototype.insertText = function(offset, text, source ) {
                    //console.log('ScriptingModule.prototype.insertText');
                    var _this = this;
                    _this.quill.insertText(offset, text, source ? source : Sources.API);
                };

                ScriptingModule.prototype.onBlockAdded = function (node, parType) {
                    var _this = this;
                    switch (parType){
                        case ParTypes.scene.t:
                            _this.autosetSceneNumbers();
                        break;

                        case ParTypes.character.t:
                            _this.addCharContd(node);
                            break;
                    }
                }
                ScriptingModule.prototype.insertEmbed = function (node, parType, removeExtraPar) {
                    //console.log('ScriptingModule.prototype.insertEmbed');
                    var t0 = performance.now();
                    //console.log('insertEmbed: ' + format);
                    var _this = this;
                    var index = _this.getSelection();

                    if (_this.isPopupOpen) {
                        _this.hidePopupList();
                    }

                    var value = true;
                    _this.quill.insertEmbed(index, parType, value, Sources.API);

                    if (removeExtraPar) {
                        _this.deleteText(index + 2, 1, Sources.SILENT);
                    }

                    index = index + 1;
                    _this.onBlockAdded(node, parType);

                    //split the block in 2 pars. change id for sec block
                    if (!removeExtraPar) {
                        node = BlotService.changeNodeId(_this.getBlotAtIndex(index));
                    }

                    return _this.setSelection(index);
                };

                ScriptingModule.prototype.addCharContd = function (node) {
                    //console.log('ScriptingModule.prototype.addCharContd');
                    var _this = this,
                        stop = false;
                    while(!stop) {
                        var prev = node.previous;
                        if (prev) {

                        }else{
                            stop = true;
                        }
                    }
                };

                ScriptingModule.prototype.autosetSceneNumbers = function (renumber, force) {
                    var _this = this, isLocked;
                    if(_this.withoutRenumber && !_this.isScriptLocked && !force){return;}
                    //if the script is locked keep on adding scene numbers when adding a new block

                    //console.log('ScriptingModule.prototype.autosetSceneNumbers');
                    if (renumber) {//sort based on numbers from the begining
                        isLocked = _this.isScriptLockedFirst;
                        if (isLocked) {
                            _this.isScriptLockedFirst = false;
                        }
                        setNumericalSceneNumbers(_this);
                        if (isLocked) {
                            _this.isScriptLockedFirst = true;
                        }
                    } else if (_this.isScriptLockedFirst) {
                        setAlphaNumericalSceneNumbers(_this);
                    } else {
                        setNumericalSceneNumbers(_this);
                    }
                };

                function setNumericalSceneNumbers(_this) {
                    //console.log('setNumericalSceneNumbers');
                    if (_this.isScriptLockedFirst) {
                        return;
                    }
                    var changed = false;
                    processEmptySceneNumber(_this, function (node, s, sn) {
                        if (!s || s && (s.n !== sn || s.b || s.a)) {
                            changed = true;
                            node = BlotService.setNodeScene(node, sn);
                        }
                    });
                    if (changed) {
                        _this.sceneNumbersChanged = true;
                    }
                }

                function setAlphaNumericalSceneNumbers(_this) {
                    if (!_this.isScriptLockedFirst) {
                        return;
                    }
                    //console.log('setNumericalSceneNumbers');
                    var node, i = 0, j = -1,
                        ch = _this.getBlots(),
                        l = ch && ch.length > 0 ? ch.length : 0, prev;
                    if (l > 0) {
                        var unnumbered = [], numbered = [], el;
                        while ((node = (i === 0 ? ch.head : node.next)) && i < l) {
                            //console.log('i: '+i);
                            if (!node) {
                                break;
                            }
                            if (BlotService.isScenePar(node)) {
                                j++;
                                var s = BlotService.getSceneNumber(node);
                                if (!s || s && (s.n === undefined || s.n === null)) {//if there is no scene upfront start them with 1
                                    el = {node: node, pos: j};
                                    el.prev = prev ? prev : null;
                                    unnumbered.push(el);
                                } else {
                                    prev = s.n;
                                    var exists = false;
                                    for (var k = 0, kl = numbered.length; k < kl; k++) {
                                        el = numbered[k];
                                        if (el.n === prev) {
                                            exists = true;
                                            el.pos = j;
                                            numbered[k] = process(el, s);
                                            break;
                                        }
                                    }
                                    if (!exists) {
                                        el = {n: prev, pos: j};
                                        numbered.push(process(el, s));
                                    }

                                    function process(el, s) {
                                        if (s.a) {
                                            var val = getCharFromScene(s.a);
                                            //keep only max
                                            el.maxLetter = el.maxLetter === undefined ? val : (el.maxLetter > val ? el.maxLetter : val);
                                        }
                                        return el;
                                    }
                                }
                            }
                            i++;
                        }
                        var ul = unnumbered && unnumbered.length > 0 ? unnumbered.length : 0, nullScMaxLetter;
                        if (ul > 0) {
                            var nl = numbered && numbered.length > 0 ? numbered.length : 0, lastIncremented;
                            if (nl > 0) {
                                var lastN = numbered[nl - 1], lastPos = lastN.pos,
                                    lasUn = _.filter(unnumbered, function (item) {
                                        return item.prev === lastN.n && item.pos > lastPos;
                                    }),
                                    hasLastItem = lasUn && lasUn.length > 0 && (lastPos === (j - lasUn.length));

                                for (i = 0; i < ul; i++) {
                                    var el = unnumbered[i],
                                        prev = el.prev;
                                    if (prev) {
                                        if (lastIncremented) {
                                            el.node = BlotService.setNodeScene(el.node, (++lastIncremented).toString());
                                        } else {
                                            for (var j = 0; j < nl; j++) {
                                                var sc = numbered[j];
                                                if (sc.n === prev) {
                                                    if (hasLastItem && el.pos > lastPos) {//prev is last element -> increment scene number
                                                        lastIncremented = prev + 1;
                                                        el.node = BlotService.setNodeScene(el.node, lastIncremented.toString());
                                                    } else {
                                                        var maxLetter = sc.maxLetter === undefined ? 0 : (sc.maxLetter + 1);
                                                        el.node = BlotService.setNodeScene(el.node, getSceneWithChar(prev, maxLetter));//prefserve after
                                                        numbered[j].maxLetter = maxLetter;
                                                    }
                                                    break;
                                                }
                                            }
                                        }
                                    } else {//there is no prev elements in front of first numbered
                                        nullScMaxLetter = nullScMaxLetter === undefined ? 0 : (nullScMaxLetter + 1);
                                        var sn = numbered.length > 0 ? (numbered[0].n - 1) : 1;
                                        el.node = BlotService.setNodeScene(el.node, getSceneWithChar(0, nullScMaxLetter));//prefserve after
                                    }
                                }
                            } else {//order alphabetically
                                for (i = 0; i < ul; i++) {
                                    var el = unnumbered[i];
                                    el.node = BlotService.setNodeScene(el.node, i + 1);
                                }
                            }
                        }
                    }

                    function getSceneWithChar(scene, letter) {
                        return scene.toString() + String.fromCharCode('A'.charCodeAt(0) + letter);
                    }

                    function getCharFromScene(scene) {
                        return scene.toString().toUpperCase().charCodeAt(0) - 'A'.charCodeAt(0);
                    }
                }

                function hasMissingSceneNumbers(_this) {
                    var hasEmpty = false;
                    processEmptySceneNumber(_this, function (node, s) {
                        if (!s) {
                            hasEmpty = true;
                            return true;
                        }
                        return false;
                    });
                    return hasEmpty;
                }

                function processEmptySceneNumber(_this, next) {
                    //console.log('processEmptySceneNumber' );
                    var node, i = 0, j = 0,
                        ch = _this.getBlots(),
                        l = ch && ch.length > 0 ? ch.length : 0;
                    if (l > 0) {
                        while ((node = (i === 0 ? ch.head : node.next)) && i < l) {
                            if (!node) {
                                break;
                            }
                            if (BlotService.getParType(node) === ParTypes.scene.v) {
                                var s = BlotService.getSceneNumber(node), sn;
                                sn = j + 1;
                                if (next(node, s, sn)) {
                                    break;
                                }
                                j++;
                            }
                            i++;
                        }
                    }
                }

                ScriptingModule.prototype.selectBlock = function (id, dif) {
                    var _this = this;

                    //console.log('selectBlock');
                    var node, index, selected, prev, i = 0,
                        ch = _this.getBlots(),
                        l = ch && ch.length > 0 ? ch.length : 0;
                    if (l > 0) {
                        while ((node = (i === 0 ? ch.head : node.next)) && i < l) {
                            if (!node) {
                                break;
                            }
                            if (index !== undefined && index === i) {
                                i++;
                                continue;
                            }
                            if (BlotService.getId(node) === id) {
                                if (dif !== 0) {
                                    index = i + dif;
                                    if (index < l && index >= 0) {
                                        selected = dif < 0 ? prev : node.next;
                                        unselect(node);
                                    }
                                }
                                if (!selected) {
                                    selected = node;
                                }
                                select(node);
                            } else {
                                if (dif < 0) {
                                    prev = node;
                                }//keep track of prev
                                unselect(node);
                            }
                            i++;
                        }
                    }


                    function select(node) {
                        sselect(node, true);
                    }

                    function unselect() {
                        sselect(node, false);
                    }

                    function sselect(node, value) {
                        /*  var domNode = node.domNode;
                          if(value){
                              if(!domNode.dataset){domNode.dataset = {};}
                              if(!domNode.dataset.selected){domNode.dataset.selected = true;}
                          }else if(domNode.dataset){
                              delete domNode.dataset.selected;
                          }*/
                    }
                };

                ScriptingModule.prototype.setNodeValue = function (node, value) {
                    var source = null;
                   //console.log('ScriptingModule.prototype.setNodeValue' );
                    var _this = this, index = node.offset();
                    _this.deleteText(index, node.length() - 1, source);
                    _this.insertText(index, value, source);
                    if (!value || value === '') {
                        delete node.domNode.sceneInfo;
                    }
                   return _this.setSelection(index + value.length, source);
                    //console.log('ScriptingModule.prototype.setNodeValue: index: ' + index + '; value: ' + value);
                };

                ScriptingModule.prototype.getNodeValue = function (node) {
                    //console.log('ScriptingModule.prototype.getNodeValue' );
                    try {
                        return this.getText(node.offset(), node.length() - 1);
                    } catch (e) {
                        return '';
                    }
                };

                ScriptingModule.prototype.processNodeValue = function (node, other) {
                    //console.log('ScriptingModule.prototype.processNodeValue' );
                    var _this = this, changes,
                        addExtra = other && other.addExtra ? true : false,
                        withoutPopup = other && other.withoutPopup ? {withoutPopup: true} : null,
                        text = _this.getNodeValue(node),
                        type = BlotService.getParType(node);
                    if (type === ParTypes.scene.v) {
                        node = _this.getSceneHeadingInfo(node, text, withoutPopup);
                        if(addExtra) {
                            _this.addSceneFromNode(node);
                            _this.addLocationFromNode(node);
                        }
                        changes = true;
                    } else if (type === ParTypes.character.v) {
                        node = _this.getCharactersHeadingInfo(node, text, withoutPopup);
                        if(addExtra) {
                            _this.addCharacterFromNode(node);
                        }
                        changes = true;
                    } else {
                        delete node.domNode.sceneInfo;
                        changes = true;
                    }

                    return changes ? _this.getNodeValue(node) : text;
                };

                ScriptingModule.prototype.addLocationFromNode = function (node) {
                    add(this.locations, this.getLocation(node));
                };

                ScriptingModule.prototype.addSceneFromNode = function (node) {
                    add(this.scenes, this.getScene(node));
                }

                ScriptingModule.prototype.addCharacterFromNode = function (node) {
                    var _this = this;
                    var characters = _this.getCharacter(node),
                        l = characters && characters.length > 0 ? characters.length : 0;
                    if (l > 0) {
                        _.each(characters, function (c) {
                            add(_this.characters, c);
                        });
                    }
                }

                ScriptingModule.prototype.preloadCharsAndLocations = function (nodes) {
                    //console.log('ScriptingModule.prototype.preloadCharsAndLocations');

                    var _this = this;

                    LCS.timeout(function () {
                        _this.characters = _this.initCharacters || [];
                        _this.locations = _this.initLocations || [];
                        _this.scenes = _this.initScenes || [];


                        if (nodes && nodes.length > 0) {
                            nodes.forEach(function (node) {
                                if (node) {
                                    _this.processNodeValue(node, {
                                        addExtra: true,
                                        withoutPopup: true
                                    });
                                }
                            });
                        }
                    }, 100);
                };

                function add(list, c) {
                    if (!c) {return;}

                    c = c.toUpperCase();
                    if(!list){list = [];}
                    if (_.find(list, function (l) {
                        return l && c && l.toUpperCase() === c;
                    }) === undefined) {
                        list.push(c);
                        list = list.sort(function (a, b) {
                            return a > b ? 1 : (a < b ? -1 : 0);
                        });
                    }
                }

                ScriptingModule.prototype.getContentLength = function (source) {
                    //console.log('ScriptingModule.prototype.getContentLength' );
                    return this.quill.getLength() - 1;
                };

                ScriptingModule.prototype.getSelection = function (atBegining) {
                    //console.log('ScriptingModule.prototype.getSelection' );
                    var quill = this.quill;
                    var index = (quill.getSelection(true) || {}).index; //getselection with true sets focus
                    if (index === undefined) {
                        index = atBegining ? 0 : this.getContentLength();
                        quill.setSelection(index, 0, Sources.SILENT);
                        LCS.timeout(function () {
                            if (!quill.hasFocus()) {
                                quill.focus();
                            }
                        }, 0);
                    }
                    //console.log('getSelection: ' + index);
                    return index;
                };

                ScriptingModule.prototype.setSelection = function (index) {
                    //console.log('ScriptingModule.prototype.setSelection' );
                    this.quill.setSelection(index, 0, Sources.API);
                    return this.setCursorPosition (true, index);
                };

                ScriptingModule.prototype.getBlotAtIndex = function (index) {
                    //console.log('ScriptingModule.prototype.getBlotAtIndex' );
                    var _this = this;
                    var node = _this.getBlots().find(index !== null && index !== undefined ? index : _this.getSelection());
                    return node ? node[0] : null;
                };

                ScriptingModule.prototype.getStartIndexForNode = function (index) {
                    //console.log('ScriptingModule.prototype.getCurrentIndex' ) ;
                    return this.getNodeIndex(this.getBlotAtIndex(index));
                };

                ScriptingModule.prototype.getNodeIndex = function (node) {
                    //console.log('ScriptingModule.prototype.getNodeIndex');
                    return node ? this.quill.getIndex(node) : null;
                };

                ScriptingModule.prototype.escapeHandler = function () {
                    //console.log('ScriptingModule.prototype.escapeHandler' );
                    if (this.isPopupOpen) {
                        this.hidePopupList();
                        return false;
                    }
                    return true;
                };

                ScriptingModule.prototype.highlightItem = function (scrollItemInView, itemIndex) {
                    //console.log('ScriptingModule.prototype.highlightItem');
                    var _this = this;
                    if (itemIndex === undefined) {
                        itemIndex = _this.popupInfo.itemIndex;
                    }
                    if (scrollItemInView === undefined) {
                        scrollItemInView = true;
                    }
                    var nodes = _this.popupList.childNodes;
                    for (var i = 0; i < nodes.length; i++) {
                        _this.popupList.childNodes[i].classList.remove('selected');
                    }
                    var l = nodes && nodes.length > 0 ? nodes.length : 0,
                        selected;
                    if (l > 0) {
                        var index = l > itemIndex ? itemIndex : 0;
                        selected = nodes[index];
                        if (selected) {
                            selected.classList.add('selected');
                        }

                        if (scrollItemInView) {
                            var scrollableContainer = _this.popupList, //_this.popupContainer
                                itemHeight = selected.offsetHeight + 0,
                                itemPos = index * itemHeight,
                                containerTop = scrollableContainer.scrollTop,
                                containerBottom = containerTop + scrollableContainer.offsetHeight;
                            if (itemPos < containerTop) {
                                // Scroll up if the item is above the top of the container
                                scrollableContainer.scrollTop = itemPos;
                            } else if (itemPos > (containerBottom - itemHeight)) {
                                // scroll down if any part of the element is below the bottom of the container
                                scrollableContainer.scrollTop += (itemPos - containerBottom) + itemHeight;
                            }
                            //console.log('highlightItem: ' + index);
                        }
                    }
                    _this.popupRemaining.parType = this.popupInfo.parType;
                    _this.popupInfo.remainingText = selected ? selected.dataset.remaining : null;
                    _this.popupRemaining.innerHTML = '<'+SBScriptEditorBlockType+' class="' + SBScriptEditorClass + _this.popupInfo.parType + '">' +
                        (selected ? selected.dataset.remaining : '&nbsp;').replace(/ /g, '&nbsp;') +
                        '</'+SBScriptEditorBlockType+'>';
                };

                ScriptingModule.prototype.getItemData = function () {
                    //console.log('ScriptingModule.prototype.getItemData' );
                    return this.popupList.childNodes[this.popupInfo.itemIndex].dataset;
                };

                ScriptingModule.prototype.onContainerMouseMove = function () {
                    //console.log('ScriptingModule.prototype.onContainerMouseMove' );
                    this.suspendMouseEnter = false;
                };

                ScriptingModule.prototype.selectItem = function (value, key) {
                    //console.log('ScriptingModule.prototype.selectItem ' + key);
                    var _this = this;
                    //console.log('selectItem');
                    var item;
                    if (value === undefined) {
                        try {
                            item = _this.getItemData();
                            value = item ? item.value : null;

                            //console.log('ScriptingModule.prototype.selectItemValue: ' + value);
                        } catch (e) {
                        }
                    }
                    var l = value && value.length > 0 ? value.length : 0;
                    if (l) {
                        var node = getSelectedBlot(_this);
                        if (!node) {
                            _this.hidePopupList();
                        } else {
                            var startBlot = _this.getNodeIndex(node),
                                startPos = _this.popupInfo.startPos,
                                textBefore = _this.getText(startBlot, startPos - startBlot),
                                textAfter = getTextAfter(_this, node, startBlot);

                            switch (_this.popupInfo.popupType) {
                                case _this.popupTypes.SceneType.name:
                                    node = getSceneHeader(_this, node, value + ' ');
                                    break;

                                case _this.popupTypes.Location.name:
                                    node = getSceneHeader(_this, node, addSpaceAfter(textBefore) + value);
                                    break;

                                case _this.popupTypes.DayTime.name:
                                    node = getSceneHeader(_this, node,
            (textBefore ? textBefore.replace(/ -(\s)*$/, '') : '') + scriptService.LineSep + value);
                                    insert(ParTypes.action.t);
                                    break;

                                case _this.popupTypes.Character.name:
                                case _this.popupTypes.CharAppend.name:
                                    node = getCharactersHeader(_this, node,
                 (textBefore ? (textBefore.replace(/(\s)*(\()*$/, '') + ' ') : '') + value);
                                    insert(ParTypes.dialogue.t);
                                    break;

                                case _this.popupTypes.Transition.name:
                                    node = _this.setNodeValue(node, value);
                                    _this.hidePopupList();
                                    var isFadeOut = value && value.match(/fade out/gi);
                                    node = _this.insertEmbed(node, (isFadeOut ? ParTypes.action : ParTypes.scene).t, true);
                                    if (!isFadeOut) {
                                        //_this.showPopup(_this.popupTypes.SceneType);
                                    }
                                    break;

                                case _this.popupTypes.ParTypes.name:
                                    _this.hidePopupList();
                                    if (!item) {
                                        item = _.find(_this.popupTypes[_this.popupInfo.popupType].values, function (item) {
                                            return item.value === value;
                                        });
                                    }
                                    if (item) {
                                        node = _this.changeScriptFormat(node, item.id);
                                    }
                                    break;
                            }

                            function insert(type){
                                if(key === Keys.ENTER || key === Keys.TAB) {
                                    node = _this.insertEmbed(node, type, true);
                                }
                            }

                            function addSpaceAfter(val){
                                return (val ? (val.replace(/(\s)*$/, '') + ' ') : '');
                            }
                        }
                    }
                };

                function getSceneHeader(_this, node, text, nextPopup) {
                    return getVals(_this, node, text, nextPopup, 'setSceneHeader');
                }

                function getCharactersHeader(_this, node, text, nextPopup) {
                    return getVals(_this, node, text, nextPopup, 'setCharactersHeader');
                }

                function getVals(_this, node, text, nextPopup, method){
                    node = _this[method](node, text, true);
                    _this.hidePopupList();
                    if(nextPopup) {
                        showNextPopup(_this, node, {
                            hideExisting: true,
                            isEmpty: text !== '',
                            nextPopup: nextPopup
                        });
                    }
                    return node;
                }

                ScriptingModule.prototype.getSceneHeadingInfo = function (node, text, other) {
                    return processHeadingInfo(this, node, text, other, true);
                }

                ScriptingModule.prototype.getCharactersHeadingInfo = function (node, text, other) {
                    return processHeadingInfo(this, node, text, other, false);
                }

                function processHeadingInfo(_this, node, text, other, isScene) {
                    var addMissing = other ? other.addMissing : false,
                        withoutPopup = other ? other.withoutPopup : false;

                    if (text === null) {
                        text = getBlotTextToCursor(_this, node);
                    }

                    var sceneInfo = scriptService[isScene ? 'getSceneHeadingInfo' : 'getCharactersInfo'](text) || {};

                    if (!withoutPopup) {
                        isScene ? matchScene() : matchChar();
                    } else {
                        setP(null);
                    }

                    return node;

                    function matchScene() {
                        if (!sceneInfo.sceneType ||
                            !_this.isPopupElement(_this.popupTypes.SceneType, sceneInfo.sceneType)) {
                            setP(_this.popupTypes.SceneType);
                        } else if (!sceneInfo.location) {
                            //show location popup if format 'SCENE_TYPE '
                            var m = text.match(/^.*\. $/gi);
                            if (m) {
                                setP(_this.popupTypes.Location);
                            } else if (text.match(/^.*\.$/gi) && addMissing) {
                                setP(_this.popupTypes.Location, sceneInfo.sceneType + ' ');
                            } else {
                                setP(null);
                            }
                        } else {
                            var txt0 = sceneInfo.sceneType + ' ',
                                txt = txt0 + sceneInfo.location,
                                txt1 = txt + scriptService.LineSep,
                                hasDayMatch = sceneInfo.location.split(scriptService.LineSep),
                                l = hasDayMatch ? hasDayMatch.length : 0,
                                day = l > 1 ? hasDayMatch[l - 1] : null;
                            if (l === 1) {//working on location still
                                if (text.match(new RegExp('^' + escapeRegexp(txt), 'gi')) && addMissing) {
                                    setP(_this.popupTypes.DayTime, txt1);
                                } else {
                                    setP(_this.popupTypes.Location);
                                }
                            } else if (day) { // location is set or has a dash
                                if (text.match(new RegExp('^' + escapeRegexp(txt1)))) {
                                    set();
                                } else if (text.match(new RegExp('^' + escapeRegexp(txt.replace(/(\s)?-(\s)*$/, '')), 'gi')) && addMissing) {
                                    set(txt1);
                                } else if (text.match(new RegExp('^' + escapeRegexp(txt0 + hasDayMatch.join(scriptService.LineSep)), 'gi'))) {
                                    set();
                                } else {
                                    setP(null);
                                }

                                function set(txt) {
                                    hasDayMatch.splice(l - 1, 1);
                                    sceneInfo.location = hasDayMatch.join(scriptService.LineSep);
                                    sceneInfo.dayTime = day;
                                    setP(_this.popupTypes.DayTime, txt);
                                }
                            } else if (text.match(new RegExp('^' + escapeRegexp(txt.replace(/(\s)?-(\s)*$/, '')), 'gi')) && addMissing) {
                                setP(_this.popupTypes.DayTime, txt1);
                            } else {
                                setP(null);
                            }
                        }
                    }

                    function matchChar() {
                        var m = text.match(/(\s)*\(/) && !text.match(/(\s)*\)$/);
                        if (m) {
                            var l = text.split('(');
                            var last = l[l.length-1];
                            sceneInfo.charText =  text.substring(0, text.length - last.length - 2).replace(/(\s)$/, '');
                            sceneInfo.characterAp = '(' + last;
                            setP(_this.popupTypes.CharAppend, sceneInfo.charText + ' ' + sceneInfo.characterAp);
                        } else if (!_this.isPopupElement(_this.characters, sceneInfo.charText)) {
                            setP(_this.popupTypes.Character);
                        } else {
                            setP(null);
                        }
                    }

                    function setP(popupType, txt) {
                        if (!sceneInfo) {
                            sceneInfo = {};
                        }
                        sceneInfo.popupType = popupType;
                        node.domNode.sceneInfo = sceneInfo;
                        if (txt) {
                            _this.setNodeValue(node, txt);
                        }
                    }
                }

                ScriptingModule.prototype.setSceneHeader = function (node, text, withoutValChange) {
                    //console.log('ScriptingModule.prototype.setSceneHeader' );
                    var _this = this, val = '';
                    node = _this.getSceneHeadingInfo(node, text);
                    var sceneInfo = _this.getSceneInfo(node);
                    if(withoutValChange){
                        node = _this.getSceneHeadingInfo(node, text);
                        val = text;
                    }else{
                        if (sceneInfo.sceneType) {
                            val = sceneInfo.sceneType + ' ';
                        }

                        if (sceneInfo.location) {
                            val += sceneInfo.location;
                        }

                        if (sceneInfo.dayTime) {
                            val += scriptService.LineSep + sceneInfo.exactTime;
                        }
                    }
                    if (sceneInfo.sceneScript) {
                        node = BlotService.setNodeScene(node, sceneInfo.sceneScript);
                    }
                    return _this.setNodeValue(node, val);
                };

                ScriptingModule.prototype.setCharactersHeader = function (node, text, withoutValChange) {
                    //console.log('ScriptingModule.prototype.setCharactersHeader' );
                    var _this = this, val = ''
                    node = _this.getCharactersHeadingInfo(node, text);
                    var sceneInfo = _this.getSceneInfo(node);
                    if(withoutValChange){
                        val = text;
                    }else {
                        if (sceneInfo.charText) {
                            val = sceneInfo.charText;
                        }

                        if (sceneInfo.characterAp) {
                            val += (val ? ' ' : '') + '(' + sceneInfo.characterAp + ')';
                        }
                    }

                    return _this.setNodeValue(node, val);
                };

                ScriptingModule.prototype.hasSceneType = function (node) {
                  //console.log('ScriptingModule.prototype.hasSceneType' );
                    return this.hasSceneInfoProp(node, 'sceneType');
                };

                ScriptingModule.prototype.getSceneType = function (node) {
                  //console.log('ScriptingModule.prototype.getSceneType' );
                    this.getSceneInfoProp(node, 'sceneType');
                };

                ScriptingModule.prototype.getLocation = function (node) {
                    //console.log('ScriptingModule.prototype.getLocation' );
                    return this.getSceneInfoProp(node, 'location', true);
                };
                ScriptingModule.prototype.getScene= function (node) {
                    //console.log('ScriptingModule.prototype.getLocation' );
                    return this.getSceneInfoProp(node, 'sceneScript', true);
                };
                ScriptingModule.prototype.getCharacter = function (node) {
                    //console.log('ScriptingModule.prototype.getCharacter' );
                    return this.getSceneInfoProp(node, 'character', true);
                };

                ScriptingModule.prototype.hasSceneInfoProp = function (node, prop) {
                    //console.log('ScriptingModule.prototype.hasSceneInfoProp' );
                    var val = this.getSceneInfoProp(node, prop);
                    return val && val.length > 0 ? true : false;
                };

                ScriptingModule.prototype.getSceneInfo = function (node, force) {
                    return force ? (BlotService.getParType(node) === ParTypes.scene.v ? scriptService.getSceneHeadingInfo: scriptService.getCharactersInfo)(this.getNodeValue(node), true, {withoutPopup: true}) : node.domNode.sceneInfo;
                };

                ScriptingModule.prototype.getSceneInfoProp = function (node, prop, force) {
                    //console.log('ScriptingModule.prototype.getSceneInfoProp');
                    var sceneInfo = this.getSceneInfo(node, force);
                    return sceneInfo ? sceneInfo[prop] : false;
                };

                ScriptingModule.prototype.onItemMouseEnter = function (e) {
                    //console.log('ScriptingModule.prototype.onItemMouseEnter');
                    if (this.suspendMouseEnter) {
                        return;
                    }

                    var index = Number(e.target.dataset.index);
                    if (!Number.isNaN(index) && index !== this.popupInfo.itemIndex) {
                        this.popupInfo.itemIndex = index;
                        this.highlightItem(false);
                    }
                };

                ScriptingModule.prototype.onItemClick = function (e) {
                    //console.log('ScriptingModule.prototype.onItemClick');
                    e.stopImmediatePropagation();
                    e.preventDefault();
                    var data = e.currentTarget.dataset;
                    this.popupInfo.itemIndex = Number(data.index);
                    this.highlightItem(true);
                    this.selectItem(data.value);
                };

                ScriptingModule.prototype.attachDataValues = function (element, data) {
                    //console.log('ScriptingModule.prototype.attachDataValues');
                    var _this = this;
                    var mention = element;
                    Object.keys(data).forEach(function (key) {
                        if (_this.options.dataAttributes.includes(key)) {
                            mention.dataset[key] = data[key];
                        } else {
                            delete mention.dataset[key];
                        }
                    });
                    return mention;
                };

                ScriptingModule.prototype.renderList = function (popupType, data, searchTerm) {
                    //console.log('ScriptingModule.prototype.renderList');
                    var _this = this;
                    if (!data || !data.length > 0) {
                        _this.hidePopupList(true);
                        return;
                    }

                    _this.popupInfo.popupType = popupType;
                    _this.popupInfo.values = data;
                    _this.popupInfo.itemIndex = 0;
                    _this.popupInfo.searchTerm = searchTerm;
                    _this.popupInfo.withRemaining = _this.popupInfo.popupType!==_this.popupTypes.ParTypes.name;

                    _this.popupList.innerHTML = '';
                    for (var i = 0; i < data.length; i++) {
                        var li = document.createElement('li');
                        li.className = 'ql-mention-list-item';
                        li.dataset.index = i;

                        li.innerHTML = _this.options.renderItem(data[i], searchTerm);
                        var x = li.innerHTML.split('</strong>');
                        li.dataset.remainingL = x.length === 1;
                        li.dataset.remaining = x.length === 1 ? x[0] : (x.length === 2 ? x[1] : '');
                        li.onmouseenter = _this.onItemMouseEnter.bind(_this);
                        li.onclick = _this.onItemClick.bind(_this);
                        _this.popupList.appendChild(_this.attachDataValues(li, data[i]));
                    }
                    _this.highlightItem(true);
                    showPopupList();

                    function showPopupList() {
                        //console.log('ScriptingModule.prototype.showPopupList' );
                        LCS.replaceClass(_this.popupContainer, 'sb-hide', 'sb-hidden');
                        if(_this.popupInfo.withRemaining) {
                            LCS.replaceClass(_this.popupRemaining, 'sb-hide', 'sb-hidden scene-wrapper');
                        }
                        setpopupContainerPosition();
                        _this.setIsOpen(true);
                    }

                    function setpopupContainerPosition() {
                        //console.log('ScriptingModule.prototype.setpopupContainerPosition');
                        var cw = _this.quill.container.clientWidth,
                            pw = _this.popupContainer.clientWidth,
                            dif = cw - pw,

                            containerPos = _this.quill.container.getBoundingClientRect(),
                            startPos = _this.quill.getBounds(_this.popupInfo.startPos),
                            containerHeight = _this.popupContainer.offsetHeight,

                            topPos = _this.options.offsetTop,
                            leftPos = _this.options.offsetLeft;

                        _this.popupInfo.startPosBounds = startPos;

                        // handle horizontal positioning
                        if (_this.options.fixPopupsToQuill) {
                            var rightPos = 0;
                            _this.popupContainer.style.right = rightPos + "px";
                        } else {
                            leftPos += startPos.left > dif ? dif : startPos.left;//startPos.left;
                        }

                        if (_this.containerRightIsNotVisible(leftPos, containerPos)) {
                            var containerWidth = _this.popupContainer.offsetWidth + _this.options.offsetLeft;
                            var quillWidth = containerPos.width;
                            leftPos = quillWidth - containerWidth;
                        }

                        // handle vertical positioning
                        if (_this.options.defaultMenuOrientation === 'top') {
                            // Attempt to align the mention container with the top of the quill editor
                            if (_this.options.fixPopupsToQuill) {
                                topPos = -1 * (containerHeight + _this.options.offsetTop);
                            } else {
                                topPos = startPos.top - (containerHeight + _this.options.offsetTop);
                            }

                            // default to bottom if the top is not visible
                            if (topPos + containerPos.top <= 0) {
                                var overstartPos = _this.options.offsetTop;

                                if (_this.options.fixPopupsToQuill) {
                                    overstartPos += containerPos.height;
                                } else {
                                    overstartPos += startPos.bottom;
                                }

                                topPos = overstartPos;
                            }
                        }
                        else {
                            // Attempt to align the mention container with the bottom of the quill editor
                            if (_this.options.fixPopupsToQuill) {
                                topPos += containerPos.height;
                            } else {
                                topPos += startPos.bottom;
                            }

                            // default to the top if the bottom is not visible
                            if (_this.containerBottomIsNotVisible(topPos, containerPos)) {
                                var overstartPos = _this.options.offsetTop * -1;

                                if (!_this.options.fixPopupsToQuill) {
                                    overstartPos += startPos.top;
                                }

                                topPos = overstartPos - containerHeight;
                            }
                        }

                        BlotService.setPosition(_this.popupContainer, topPos, leftPos);

                        if(_this.popupInfo.withRemaining){
                            setRemaining();
                        }

                        function setRemaining() {
                            //startPos.top
                            var h = _this.popupRemaining.querySelector('div').offsetHeight,
                                //top = -(h * 2),
                                top = //Math.ceil(
                                (startPos.top === -1 ? 0 : startPos.top) - (_this.popupRemaining.offsetHeight - _this.popupRemaining.querySelector('div').offsetHeight) + 2.5,
                                //)  , //(startPos.top - _this.popupRemaining.offsetHeight - 2) + 'px',
                                left = 'initial',
                                right = 'initial';
                            switch (_this.popupRemaining.parType) {
                                case ParTypes.transition.v:
                                    right = '-' + (_this.popupRemaining.offsetWidth - LCS.blockPaddingLeft);
                                    break;

                                default:
                                    try {
                                        var range = _this.quill.root.ownerDocument.getSelection().getRangeAt(0);
                                                                                                                                                //convert pt to px
                                        left = (range.endOffset === 0 ? range.startContainer : range).getClientRects()[0].x - containerPos.x - _this.quill.pageLeft * 1.333;
                                    } catch (e) {
                                        //console.log(e);
                                    }
                                    /*if (isEmpty) {
                                        left = LCS.blockPaddingLeft;
                                    } else {

                                    }*/
                                    break;
                            }

                            BlotService.setPosition(_this.popupRemaining, top, left, right);
                        }
                    }
                };

                ScriptingModule.prototype.hidePopupList = function (withoutReset) {
                    //console.log('ScriptingModule.prototype.hidePopupList' );
                    var _this = this;
                    if(withoutReset) {
                        _this.popupInfo.popupType = null;
                        _this.popupInfo.startPos = null;
                        _this.popupInfo.startPosBounds = null;
                        _this.popupInfo.itemIndex = null;
                        _this.popupInfo.searchTerm = 0;
                    }
                    LCS.addClass(_this.popupContainer, 'sb-hide');
                    LCS.addClass(_this.popupRemaining, 'sb-hide');

                    _this.setIsOpen(false);
                };

                ScriptingModule.prototype.nextItem = function () {
                    //console.log('ScriptingModule.prototype.nextItem');
                    setItem(this, (this.popupInfo.itemIndex + 1) % this.popupInfo.values.length);
                };

                ScriptingModule.prototype.prevItem = function () {
                    //console.log('ScriptingModule.prototype.prevItem');
                    setItem(this,((this.popupInfo.itemIndex + this.popupInfo.values.length) - 1) % this.popupInfo.values.length);
                };

                function setItem(_this, index){
                    //console.log('ScriptingModule.prototype.nextItem');
                    _this.popupInfo.itemIndex = index;
                    _this.suspendMouseEnter = true;
                    _this.highlightItem(true);
                }

                ScriptingModule.prototype.hasValidChars = function (s) {
                    //console.log('ScriptingModule.prototype.hasValidChars');
                    return this.options.allowedChars.test(s);
                };

                ScriptingModule.prototype.containerBottomIsNotVisible = function (topPos, containerPos) {
                    //console.log('ScriptingModule.prototype.containerBottomIsNotVisible');
                    var popupContainerBottom = topPos + this.popupContainer.offsetHeight + containerPos.top;
                    return popupContainerBottom > window.pageYOffset + window.innerHeight;
                };

                ScriptingModule.prototype.containerRightIsNotVisible = function (leftPos, containerPos) {
                    //console.log('ScriptingModule.prototype.containerRightIsNotVisible');
                    if (this.options.fixPopupsToQuill) {
                        return false;
                    }

                    var rightPos = leftPos + this.popupContainer.offsetWidth + containerPos.left;
                    var browserWidth = window.pageXOffset + document.documentElement.clientWidth;
                    return rightPos > browserWidth;
                };

                ScriptingModule.prototype.setIsOpen = function (isPopupOpen) {
                    //console.log('ScriptingModule.prototype.setIsOpen');
                    var _this = this;
                    if (_this.isPopupOpen !== isPopupOpen) {
                        _this.onPopupOpen(isPopupOpen);
                        _this.isPopupOpen = isPopupOpen;
                        _this.quill.isPopupOpen = isPopupOpen;
                    }
                };

                function onPopupOpen(isPopupOpen) {
                    return true;
                }

                //todo
                /*
                    case "sceneType":  values = scriptService.SceneTypes; break; //scene
                    case "locations":  values = scriptService.locations; break; //scene
                    case "timeOfDay":  values = scriptService.TimesOfDay; break; //scene
                    case "transition":  values = scriptService.Transitions; break; //transition
                    case "character":  values = scriptService.characters; break; //character
                */

                ScriptingModule.prototype.showPopup = function (popup, other) {
                    //console.log('ScriptingModule.prototype.showPopup');
                    var _this = this;
                    var popupType = popup ? popup.name : null;
                    if (!popupType) {
                        return;
                    }
                    //_this.cursorPos = _this.getCursorPos();
                    if (!_this.isPopupOpen ||
                        _this.isPopupOpen && (_this.popupInfo.popupType !== popupType)) {
                        _this.popupInfo.startPos = other && other.startPos !== undefined ? other.startPos : _this.cursorPos;
                        _this.popupSource(other && other.searchTerm ? other.searchTerm : '', _this.renderList.bind(_this, popupType), popupType);
                    }
                };

                ScriptingModule.prototype.onTextChange = function (delta, oldDelta, source) {
                    //console.log('ScriptingModule.prototype.onTextChange  ' + source);
                    var _this = this;
                    _this.quill.isLoading = true;
                    if (source === Sources.USER) {
                        if (_this.sceneNumbersChanged) {
                            _this.sceneNumbersChanged = false;
                            console.log('sceneNumbersChanged none ');
                            return;
                        }
                        //console.log('ScriptingModule.prototype.onTextChange Sources.USER');
                        var type = 'onTextChange',
                            node = _this.setCursorPosition(true);
                        if (delta && delta.ops) {
                            //console.log('delta && delta.ops');
                            if (delta.ops.length >= 2) {
                                var del = delta.ops[1].delete;
                                //console.log('update scene numbers after delete');
                                if (del > 1 || _this.RunRenumber) {
                                    //update scene numbers after delete
                                    //console.log(type+'deleted');
                                    //console.log(delta.ops);
                                    //run autoset scene numbers if multiple items are deleted or if is backspace
                                    _this.autosetSceneNumbers();
                                    _this.RunRenumber = false;
                                    setPages();
                                }
                            } else if (_this.pastedItems === true) {
                                //console.log('_this.pastedItems === true');
                                _this.pastedItems = false;
                                _this.autosetSceneNumbers();
                                setPages();
                            }

                            if(!_this.quill.isInit) {
                                var h = BlotService.getNodeHeight(node);
                                if (node.height !== h) {
                                    node.height = h;
                                    setPages(node);
                                }
                            }
                        }

                        if(!_this.quill.isInit && (!_this.quill.pagination || _this.quill.pagination && !_this.quill.pagination.settingPages)) {
                            _this.processPopups(node, type);
                        }
                    }
                    else if (source === Sources.API) {
                        if (_this.quill.isInit){
                            _this.quill.setLineHeight = setLineHeight;
                            _this.quill.setLineHeight();

                            initText();
                            _this.quill.isInit = false;
                        }

                        function setLineHeight(){
                            var s = getComputedStyle(_this.quill.container),
                                unit = s.getPropertyValue('--printunit').replaceAll("'",'').replaceAll('"',''),
                                lineHeight = getProp(s, 'lineHeightInit');
                            _this.quill.printUnit = unit;
                            _this.quill.lineHeightInit = lineHeight;
                            _.each(['printunit','pageHeight', 'pageWidth', 'pageTop', 'pageBottom', 'pageLeft', 'pageRight'], function(prop){
                                _this.quill[prop] = getProp(s, prop);
                            });
                            _this.options = _.extend(_this.options, {
                                lineHeight: lineHeight,
                                top: _this.quill.pageTop,
                                bottom: _this.quill.pageBottom,
                               // left: _this.quill.pageLeft,
                               // right: _this.quill.pageRight,
                                pageHeight: _this.quill.pageHeight - _this.quill.pageTop - _this.quill.pageBottom
                            });

                            var css = '@media print{' +
                                'body{zoom:1}' +
                                '@page{size:' + _this.quill.pageWidth + unit+' ' + _this.quill.pageHeight + unit+'; ' +
                                'margin:' + _this.quill.pageTop + unit+' 0 ' + _this.quill.pageBottom + unit + ' 0;'
                                //';margin-left:' + _this.quill.pageLeft +  unit + ';margin-right:' + _this.quill.pageRight +  unit +
                                '}' +
                                '}';
                            LCS.addStyleBlock('sbeditorprint', _this.quill.root.parentNode, css, true, 'sbeditorprint');


                            function getProp(s, prop){
                                return eval(s.getPropertyValue('--'+prop).replaceAll('calc', '').replaceAll(unit, ''));
                            }
                        }

                        function initText() {
                            //console.log('ScriptingModule.prototype.onTextChange Sources.API');
                            _this.cursorPos = 1;
                            var nodes = _this.getBlots();
                            _this.preloadCharsAndLocations(nodes);
                            node = _this.setCursorPosition(true);

                            if (!_this.getContentLength()) { //is empty
                                //update scene numbers
                                if (nodes.length === 1) {
                                    node = _this.changeScriptFormat(node, ParTypes.scene.t,
                                        _this.sceneNumber ? _this.sceneNumber : (_this.isScriptLocked ? 1 : null));
                                }
                                //console.log('cursorPos = ' + _this.cursorPos);
                            } else if(!_this.quill.isInit){
                                _this.autosetSceneNumbers();
                            }
                            setPages();
                        }


                    }
                    _this.quill.isLoading = false;

                    function setPages(blot){
                        if(_this.withoutPagination){return;}
                        LCS.timeout(function(){
                            if(_this.quill.pagination) {
                                _this.quill.pagination.setPages(blot);
                            }
                        }, 200);
                    }

                    function debounce(func, wait) {
                        const context = this;
                        const called = func;
                        const waitTime = wait;
                        let invoking = null;
                        let time = null;

                        return function invok() {
                            const now = Date.now();
                            if (invoking) {
                                clearTimeout(invoking);
                            }
                            if (time == null || time + waitTime > now) {
                                time = now;
                                invoking = LCS.timeout(invok, waitTime);
                            } else {
                                time = invoking = null;
                                called.call(context);
                            }
                        }
                    }

                };

                ScriptingModule.prototype.onSelectionChange = function (range, oldRange, source) {
                    //console.log('ScriptingModule.prototype.onSelectionChange ' + source);
                    var _this = this;
                    if (range){
                        var node = _this.setCursorPosition(true);
                        //dont display popup when just selecting a block - something must be typed
                        if(_this.prevSelectedBlot){
                            switch (BlotService.getParType(_this.prevSelectedBlot)){
                                case ParTypes.scene.v:
                                    _this.addLocationFromNode(_this.prevSelectedBlot);
                                    BlotService.addScene(_this.prevSelectedBlot);
                                    break;

                                case ParTypes.character.v:
                                    _this.addCharacterFromNode(_this.prevSelectedBlot);
                                    break;
                            }
                        }
                        if(source === Sources.USER) {
                            if (BlotService.getParType(_this.selectedBlot) === ParTypes.page.v) {
                                var isLast = LCS.hasClass(_this.selectedBlot.domNode, 'last'),
                                    isUp = _this.quill.keyType === Keys.UP || isLast;
                                var next = _this.selectedBlot[isUp ? 'prev' : 'next'];
                                if (next) {
                                    _this.setSelection(next.offset() + (isUp ? (next.length() - 1) : 0));
                                }
                            } else {
                                _this.processPopups(node, 'onSelectionChange');
                            }
                        }
                        //this.$emit('focus', this.quill)
                    }
                    _this.quill.keyType = null;
                    //else{ this.$emit('blur', this.quill)}
                };

                ScriptingModule.prototype.setCursorPosition = function (withSelect, cursorPos) {
                    //console.log('ScriptingModule.prototype.setCursorPosition');
                    //var t0 = performance.now();

                    var _this = this;
                    _this.cursorPos = cursorPos === undefined || cursorPos === null ? _this.getSelection(true) : cursorPos;
                    if (withSelect) {
                        _this.prevSelectedBlot = _this.selectedBlot;
                        var prevSelectedId = BlotService.getId(_this.selectedBlot);
                        _this.selectedBlot = _this.getBlotAtIndex(_this.cursorPos);
                        if (prevSelectedId !== BlotService.getId(_this.selectedBlot)) {
                            _this.selectBlock(_this.selectedBlot, 0);
                        }else{
                            _this.prevSelectedBlot = null;
                        }
                    }
                    return _this.selectedBlot;
                };

                function getBlotTextToCursor(_this, node, startPos) {
                    var startBlot = _this.getNodeIndex(node);
                    if (startPos === undefined) {
                        startPos = _this.cursorPos;
                    }
                    return _this.getText(startBlot, startPos - startBlot);
                }

                ScriptingModule.prototype.getNextPopup = function (node) {
                    //console.log('ScriptingModule.prototype.getNextPopup');

                    if (!node) {
                        return null;
                    }
                    var _this = this,
                        val = _this.processNodeValue(node);
                    switch (BlotService.getParType(node)) {
                        case ParTypes.scene.v:
                        case ParTypes.character.v:
                            return _this.getSceneInfoProp(node, 'popupType');

                        case ParTypes.transition.v:
                            return _this.popupTypes.Transition;
                    }
                    return null;
                };

                ScriptingModule.prototype.processPopups = function (node, type) {
                    //console.log('ScriptingModule.prototype.processPopups.' + type);
                    var _this = this;
                    if (_this.isProcessPopups || _this.readOnly) {
                        //console.log('isProcessPopups');
                        return;
                    }
                    _this.isProcessPopups = true;
                    var textBefore, offset, nextPopup;
                    //console.log('cursorPos: ' + _this.cursorPos);
                    if (node) {
                        var parType = BlotService.getParType(node);
                        var cursorParId = BlotService.getId(node);
                        if (_this.isPopupOpen) {
                            var startPos = _this.popupInfo.startPos,
                                prevPopupNode = _this.getBlotAtIndex(startPos),
                                startParId = BlotService.getId(prevPopupNode),
                                popupType = _this.popupInfo.popupType;

                            nextPopup = _this.popupTypes[popupType];
                            if ((!startParId || startParId && cursorParId !== startParId) ||
                                (nextPopup.parType !== parType)) {
                                _this.hidePopupList();
                            } else {
                                //text change - > reload popup
                                textBefore = _this.getText(startPos, _this.cursorPos - startPos);
                                _this.popupSource(textBefore, _this.renderList.bind(_this, popupType), popupType);
                                /*if (_this.popupInfo.remainingText === '') {
                                    _this.hidePopupList();
                                }*/
                                if (parType === ParTypes.scene.v ||
                                    parType === ParTypes.character.v) {
                                    node = _this[parType === ParTypes.scene.v ? 'getSceneHeadingInfo' : 'getCharactersHeadingInfo'](node, null);

                                    var p = _this.getSceneInfoProp(node, 'popupType');
                                    if (p && p !== nextPopup.name) {
                                        _this.hidePopupList();
                                        processnext(p, _this.getNodeValue(node));
                                    }
                                }
                            }
                        } else if (type !== 'onSelectionChange') {
                            var val = _this.getNodeValue(node);
                            if (type === 'onCustomKey' && !val) {
                                _this.hidePopupList();
                            } else {
                                processnext(_this.getNextPopup(node), val);
                            }
                        }
                    }

                    _this.isProcessPopups = false;

                    function processnext(nextPopup, val) {
                        var offset1 = node.offset();

                        if (type === 'onTextChange') {
                            if (parType === ParTypes.transition.v) {
                                offset = offset1;
                            } else {
                                var prevText = _this.getText(offset1, _this.cursorPos - offset1);
                                if (parType === ParTypes.scene.v) {
                                    if (nextPopup) {
                                        var sceneInfo = _this.getSceneInfo(node);
                                        switch (nextPopup.name) {
                                            case _this.popupTypes.SceneType.name:
                                                if (prevText.match(/ $/)) {
                                                    _this.hidePopupList();
                                                    return;
                                                }
                                                offset = offset1;
                                                break;

                                            case _this.popupTypes.Location.name:
                                                setOffset('location', getS(sceneInfo));
                                                break;

                                            case _this.popupTypes.DayTime.name:
                                                setOffset('dayTime', getS(sceneInfo) + getL(sceneInfo, 'location') + scriptService.LineSep.length);
                                                break;
                                        }
                                    }
                                } else if (parType === ParTypes.character.v) {
                                    if (nextPopup) {
                                        var sceneInfo = _this.getSceneInfo(node);
                                        switch (nextPopup.name) {
                                            case _this.popupTypes.Character.name:
                                                offset = offset1;
                                                break;

                                            case _this.popupTypes.CharAppend.name:
                                                setOffset('characterAp', offset1 + getL(sceneInfo, 'charText') + 1);
                                                break;
                                        }
                                    }
                                } else if (parType === ParTypes.action.v) {
                                    //onDot
                                    if (prevText.match(/^(int|ext)(\.)$/gi)) {
                                        node = _this.changeScriptFormat(node, ParTypes.scene.t);
                                        node = _this.setSceneHeader(node, val);
                                        //  nextPopup = _this.popupTypes.Location;
                                        offset = _this.cursorPos;
                                    }
                                }

                                function getS(sceneInfo) {
                                    return offset1 + getL(sceneInfo, 'sceneType') + 1;
                                }

                                function getL(sceneInfo, prop) {
                                    return sceneInfo && sceneInfo[prop] ? sceneInfo[prop].length : 0;
                                }

                                function setOffset(prop, val) {
                                    var l = getL(sceneInfo, prop);
                                    if (l === 0) {
                                        nextPopup = null;
                                    } else {
                                        offset = val;
                                    }
                                }
                            }
                        }
                        else if (type === 'onCustomKey') {
                            //dont show popup if the script format changes
                            _this.hidePopupList();
                            if (nextPopup) {
                                nextPopup = null;
                            }
                            /*  if (val === '' && nextPopup) {
                                  offset = _this.cursorPos;
                              }*/
                        }

                        if (offset !== undefined) {
                            textBefore = _this.getText(offset, _this.cursorPos - offset);
                            //console.log('show popup ' + nextPopup + ' at ' + offset);
                        }
                        _this.showPopup(nextPopup, {searchTerm: textBefore, startPos: offset});
                    }
                };

                ScriptingModule.prototype.changeScriptFormat = function (node, format, sceneNumber) {
                    var _this = this;
                    //console.log('ScriptingModule.prototype.changeScriptFormat: ' + format);
                    var parType = BlotService.getParType(node),
                        sameType = BlotService.hasParName(node, format),
                        sceneFormat = format === ParTypes.scene.t;
                    if (sceneNumber) {
                        node.domNode.setAttribute('data-scene', sceneNumber);
                    }
                    if (!sameType) {
                        _this.quill.format(format, true, Sources.API);
                        node = getSelectedBlot(_this, true);
                        if ((parType === ParTypes.scene.v || sceneFormat) && !sceneNumber) {
                            _this.autosetSceneNumbers();
                        }
                    }

                    _this.processPopups(node, 'onCustomKey');
                    return node;
                };

                return ScriptingModule;

                function getSelectedBlot(_this, force){
                    if(!_this.selectedBlot || force) {
                        _this.selectedBlot = _this.getBlotAtIndex(_this.cursorPos);
                    }
                    return _this.selectedBlot;
                }
            }());

            Quill.register('modules/scripting', ScriptingModule, true);
        }

        function getCurrentFormat(format) {
            for (var p in format) {
                var type = p ? format[p] : null,
                    el = type ? ParTypes[p] : null;
                if (el) {
                    return el.t;
                }
            }
            return null;
        }
    }
}

