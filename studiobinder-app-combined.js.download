angular.module('product.callsheet.addCallsheetRecipients.component', [
    'apiConstants.AddCallsheetRecipients.services',
    'apiPagination.Contacts',
    'apiServices.CallsheetInvitations',
    'product.callsheet.addRecipients.group.component'
])
    //should not pass comp options so it can be inherited from constants options
.component('addCallsheetRecipientsPopup', popupComponentParams('AddCallsheetRecipientsPopupCtrl', true))
.controller('AddCallsheetRecipientsPopupCtrl', AddCallsheetRecipientsPopupCtrl);
AddCallsheetRecipientsPopupCtrl.$inject = ['ContactsPageCtrlServiceInit', 'ContactsService','AddCallsheetRecipientsConstantsService', 'CallsheetInvitationsService','$element'];
function AddCallsheetRecipientsPopupCtrl( ContactsPageCtrlServiceInit, service, constantsService, CallsheetInvitationsService, $element) {
    console.log('AddCallsheetRecipientsPopupCtrl');
    var $ctrl = this;
    $ctrl.isInTreeModal = true;
    $ctrl.isPopup= true;

    $ctrl.getGroupBodyAddonOther = getGroupBodyAddonOther;
    $ctrl.getLeftButtons = getLeftButtons;
    $ctrl.getNewGroupTopButtons = getNewGroupTopButtons;
    $ctrl.getGroupFilters = getGroupFilters;
    $ctrl.onPageInitOther = onPageInitOther;

    $ctrl.onAddToCallsheet = onAddToCallsheet;
    $ctrl.close = close;
    $ctrl.showFilter = showFilter;

    $ctrl = new ContactsPageCtrlServiceInit($ctrl, $element, {
        constantsService: _.extend({}, constantsService),
        listOptionsService: null,
        service: service
    });

    function showFilter(){
        return false;
    }

    function getLeftButtons() {
return '<div class="pull-right btnAddToCallsheetW">' +
            '<a ng-class="{\'disabled\': $ctrl.keyboardService.SelectedRows.length===0}" class="btnAddToCallsheet btn btn-small primary without-text with-margin-left pull-left hide-ipad '+$ctrl.getBtnActionCls()+'" data-type="processSelectedCustomBtns" data-info="addToCallsheet" analytics-on analytics-action="Add Recipient to Call sheet" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? \'Please select at least one recipient to add to call sheet.\' : (\'Add to call sheet \' + $ctrl.keyboardService.SelectedRows.length + \' recipient\' + ($ctrl.keyboardService.SelectedRows.length == 1 ? \'\' : \'s\'))}}" tooltip-placement="bottom">' +
                $ctrl.LCS.getISBDiv('plus', 2, 'pull-left show-ipad') +
                '<div class="hide-ipad">Add Selected to Call Sheet</div>' +
            '</a>' +
            '<button class="btn btn-small filtersx transp small with-margin-left '+$ctrl.getBtnActionCls()+'" data-type="close" tooltip-placement="bottom" tooltip="Close">' + $ctrl.LCS.getISBDiv('cancel', null, 'centered') + '</button>' +
        '</div>';
    }

    function getGroupBodyAddonOther() {
        return _.extend({
            'callsheet-id': '"::$ctrl.callsheetId"',
            'on-add-to-callsheet': '"$ctrl.onAddToCallsheet(ids, e)"'
        }, $ctrl.isPopup ? {'is-popup': 'true'} : null);
    }

    function getNewGroupTopButtons() {
        return '';
    }

    function onPageInitOther() {
        $ctrl.title = 'Add <span class="hide-ipad">Call Sheet</span> Recipients';
        console.log('AddCallsheetRecipientsPopupCtrl.onPageInitOther');
        if (!$ctrl.extraParam) {
            $ctrl.extraParam = {};
        }
        $ctrl.popupTitle = 'Select call sheet recipients';

        $ctrl.preLoadingService = $ctrl.extraParam.preLoadingService;
        $ctrl.listTreeService.preLoadingService = $ctrl.preLoadingService;
        $ctrl.listTreeService.preloadingType = $ctrl.PreloadingTypes.Contacts;
        $ctrl.listTreeService.getSearch = getSearch;

        $ctrl.hideSidebarToggleOnDesktop = $ctrl.extraParam.hideSidebarToggleOnDesktop;
        $ctrl.filterRole = $ctrl.extraParam.filterRole;
        $ctrl.isEditCallsheet = $ctrl.extraParam && $ctrl.extraParam.isEditCallsheet === true;
        $ctrl.callsheetId = $ctrl.extraParam.callsheet ? $ctrl.extraParam.callsheet._id : null

        $ctrl.addRootWatcher('CLOSE_POPUP_ADD_CALLSHEET_RECIPIENTS', function (){
            $ctrl.close();
        });
    }

    function getSearch(active) {
        console.log('setSearch');
        active.selectedListId = $ctrl.filterRole;
        return active;
    }

    function onAddToCallsheet(ids, e) {
        console.log('addCallsheetRecipientsPopup.onAddToCallsheet');
        if(!ids || !ids.length){return;}
        CallsheetInvitationsService.insertRecipients($ctrl.extraParam.callsheet, ids, onSuccess, onError);

        function onSuccess(result) {
            var updatesG = result.updatesG,
                table = 'callsheetInvitations';
            if (updatesG) {
                var items = updatesG && updatesG[table] && updatesG[table].add ? updatesG[table].add : null;
                if (items && items.length > 0) {
                    var elemType = 'RECIPIENT',
                        currentListId = $ctrl.filterRole;
                    $ctrl.broadcastRoot('UPDATED_'+ elemType +'_ITEM', result);
                    $ctrl.broadcastRoot('CLEAR_SELECTED_ROWS_' + elemType);
                    //there is no tree for recipients here
                    //must update the grid counter
                    //ensure this is not called on recipients page
                    if($ctrl.isEditCallsheet){
                        var list = [];
                        _.each(items, function (item) {
                            var roles = item.roles && item.roles.length>0 ? item.roles : null;
                            if(roles) {
                                _.each(roles, function (r) {
                                    list.push(r.type);
                                });
                            }
                        });
                        list = _.unique(list);
                        _.each(list, function (filterRole) {
                            var prop = 'LOAD_GROUP' + getPrefix() + '_' + elemType + '_' + filterRole + '_' + $ctrl.callsheetId;
                            console.log(prop);
                            $ctrl.broadcastRoot(prop);
                        });
                    }else {
                        $ctrl.broadcastRoot('TREE_SERVICE_RELOAD_LIST_' + elemType, $ctrl.filterRole);
                    }

                    //update contacts grid
                    $ctrl.LCS.timeout(function () {
                        delete result.updatesG;
                        //remove the currently added callsheet recipients items from the contacts grid
                        elemType = 'CONTACT';
                        currentListId = ($ctrl.listTreeService.active.selectedListId || 'All').toString();
                        $ctrl.broadcastRoot('TREE_SERVICE_RELOAD_LIST_' + elemType, currentListId);
                    }, 300);

                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.callsheet.UPDATE.cast.success', 'success', {name: 'this'});
                    if($ctrl.clearSelected){$ctrl.clearSelected();}
                    if(ids.length > 1) {
                        close();
                    }
                }
            }
        }
    }

    function getPrefix(){
        return ($ctrl.isPrintLayout ? '_PRINT_LAYOUT' : '');
    }

    function onError(error) {
        $ctrl.isUpdating = false;
        $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.callsheet.UPDATE.cast.error');
    }

    function getGroupFilters() {
        //console.log('AddCallsheetRecipientsPopupCtrl: getGroupFilters');
        //get the callsheet recipients -> object is not nec
        var ids = _.uniq(_.filter($ctrl.preLoadingService.getList($ctrl.preLoadingService.TblTypes.CallsheetInvitations), function (item) {
            return item && item.castId;
        }).map(function (item) {
            return item.castId;
        }));
        return {
            callsheetId: $ctrl.callsheetId,
            contactIds: ids && ids.length>0 ? ids: null,
            productContactListId: $ctrl.CPS.product ? $ctrl.CPS.product.contactListId : null
        };
    }

    function close(e) {
        $ctrl.preventDefault(e);
        if ($ctrl.onClose) {
            $ctrl.onClose({result:'cancel'});
        }
    }
}

