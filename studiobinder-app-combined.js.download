angular.module('sb.fields.popovers.assignCollaboratorsInline.component',[
'user.share.collaborators.service'
])
.component('sbAssignCollaboratorsInline', {
    bindings: {
        uId: '<',
        list: '<',
        isPageShare: '<',
        todoPageId: '@',
        compOptions: '<'
    },
    controller: 'AssignCollaboratorsInlineCtrl'
})

    .controller('AssignCollaboratorsInlineCtrl', AssignCollaboratorsInlineCtrl);
AssignCollaboratorsInlineCtrl.$inject =['TemplateCompileCompCtrlService', 'SBFieldMethods', 'RouteCollaboratorsService', '$element'];

function AssignCollaboratorsInlineCtrl(TemplateCompileCompCtrlService, SBFieldMethods, RouteCollaboratorsService, $element) {
    console.log('AssignCollaboratorsInlineCtrl');
    var $ctrl = this;
    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
    $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;
    $ctrl.SBFieldMethods = SBFieldMethods;


    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;

    $ctrl.clipboard = {
        showTooltip: false,
        onSuccess: function (e) {
            $ctrl.clipboard.showTooltip = true;
            $ctrl.clipboard.message = 'Copied!';
        },
        onError: function (e) {
            $ctrl.clipboard.showTooltip = true;
            $ctrl.clipboard.message = e ? e.action : null;
        }
    };

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.liShare = 'liShare';
        $ctrl.liTeam = 'liTeam';

        //$ctrl.CPS.productId >>>
        $ctrl.team = $ctrl.RouteCollaboratorsService.getProjectTeam($ctrl.CPS.product);
        $ctrl.teamCount = ($ctrl.team ? $ctrl.team.length : 0);

        $ctrl.todoPage = $ctrl.RouteCollaboratorsService.BlocksSetupService.getTodoPageById($ctrl.todoPageId); //todo set it

        addWatcher();

        //when collaborators from the parent get updated propagate : {uId: uId, c:collaborators}
        $ctrl.removeWatcher($ctrl.uPIdRootWatcher);
        $ctrl.uPIdRootWatcher = $ctrl.addRootWatcher('UPDATE_PARENT_COLLABORATORS', onUpdateParentCollaborators);
    }

    function setCollabCount() {
        $ctrl.userCollabs = $ctrl.RouteCollaboratorsService.getUserCollaborators($ctrl.uId, $ctrl.todoPage);
        $ctrl.collabCount = $ctrl.userCollabs ? $ctrl.userCollabs.length : 0;
    }

    function getSharedUrl(item) {
        return item && item._id ? ($ctrl.CPS.websiteUrl + '/shared/' + item._id) : null;
    }

    function addWatcher() {
        if($ctrl.uIdRootWatcher) {
            $ctrl.removeWatcher($ctrl.uIdRootWatcher);
        }
        if ($ctrl.uId) {
            if($ctrl.isDoc) {
                $ctrl.shareListType = $ctrl.itemTitle;
                $ctrl.shareListName = $ctrl.list.name;
            }else {
                var info = $ctrl.RouteCollaboratorsService.getShareListInfo($ctrl.uId, $ctrl.compOptions, $ctrl.isDoc ? $ctrl.list : null ),
                    shareList = info ? info.shareList : null;
                if (shareList) {
                    $ctrl.shareListType = shareList.type;
                    $ctrl.shareListName = shareList.name;
                }
            }

            $ctrl.removeWatcher($ctrl.uIdRootWatcher);
            $ctrl.uIdRootWatcher = $ctrl.addRootWatcher('UPDATE_ITEM_COLLABORATORS_' + $ctrl.uId, onUpdateItemCollaborators);
        }
        setCollabCount();
    }

    function onUpdateItemCollaborators(result) {
        console.log('UPDATE_ITEM_COLLABORATORS');
        $ctrl.reloadTemplate();
    }

    function onUpdateParentCollaborators(result) {
        console.log('UPDATE_PARENT_COLLABORATORS');
        $ctrl.reloadTemplate();
    }

    function share(e) {
        $ctrl.preventDefault(e);
        //todo dont allow collaborators to see the share page
        if (canShare()) {
            if($ctrl.isPageShare){
                $ctrl.broadcastRoot('SHARE_PAGE', {
                    params: {
                        isPageShare: true,
                        uId: $ctrl.uId
                    },
                    e: e
                });
            }else {
                $ctrl.broadcastRoot('SHARE_LIST_FROM_COMMENTS', {uId: $ctrl.uId});

            }
        } else {
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.share.permissions.error', 'error');
        }
    }

    function canShare() {
        return $ctrl.canEdit && !$ctrl.isDashboard && $ctrl.CPS.isAuthenticated &&
                $ctrl.BlocksSetupService.todoPageHasShare();
    }

    function goToTeam() {
        $ctrl.popupsService.teamAdminAccess(function () {
            $ctrl.CPS.transitionTo('user.team', $ctrl.CPS.currentPathParams());
        });
    }

    function onDestroy() {
        bind(false);
    }

    function onLoaded() {
        bind(true);
    }

    function bind(isBind){
        bindOne(isBind, $ctrl.liTeam, goToTeam);
        bindOne(isBind, $ctrl.liShare, share);
    }

    function bindOne(isBind, cls, method) {
        if(isBind){
            $ctrl['btn' + cls] = $ctrl.element.querySelector('.' + cls);
        }

        $ctrl.LCS.bindElementsClick(isBind, $ctrl['btn' + cls], method);
    }

    function getItemTemplate() {
        setCollabCount();
        return '<div>' +
                    getCollabs()+
                    getTeam() +
                '</div>';

        function getCollabs(){
        return '<div class="list-table with-border-bottom">' +
                    '<div class="header">' +
                        $ctrl.LCS.getISBDiv('team', 2, 'pull-left with-margin-right gray') +
                        'Shared with ' + ($ctrl.collabCount + ' collaborator' + ($ctrl.collabCount === 1 ? '' : 's')) +
                    '</div>' +
                    '<div class="select-choices with-teams display-block without-hover clearfix">' +
                        loadlist(true) +
                    '</div>' +
                    getAccess() +
                '</div>';

            function getAccess (){
                return $ctrl.CPS.isAuthenticated ? (
                    '<div>' +
                        '<a class="small inline-block semibold ' + $ctrl.liShare + '" analytics-on analytics-action="Open Share Popup">Manage Access</a>' +

                        /*'<button id="btnLinkCopy" class="btn small inline-block semibold" ngclipboard data-clipboard-target="#linkCopy" ng-copy="$ctrl.sharedLink" ngclipboard-success="$ctrl.clipboard.onSuccess()" ngclipboard-error="$ctrl.clipboard.onError()" ng-mouseleave="$ctrl.clipboard.showTooltip=false"><span>Copy Link</span><div ng-show="$ctrl.clipboard.showTooltip" class="tooltip bottom" ng-class="{\'fade in\': $ctrl.clipboard.showTooltip}"><div class="tooltip-arrow"></div><div class="tooltip-inner ng-binding" ng-bind="$ctrl.clipboard.message"></div></div></button>' +*/
                        '<div class=" padding-right-24 sb-hide">' +
                            '<input class="form-control with-hover font-size-14" id="linkCopy" ng-model="$ctrl.sharedLink" readonly style="min-height: 32px;height:32px">' +
                        '</div>' +
                    '</div>') : '';
            }
        }

        function getTeam(){
     return '<div class="list-table">' +
                '<div class="header">' +
                    $ctrl.LCS.getISBDiv('team', 2, 'pull-left with-margin-right gray') + 'Project Team' +
         //' <span class="with-parenthesis"> ' + ($ctrl.teamCount + ' member' + ($ctrl.teamCount===1?'':'s'))+'</span>' +
                '</div>' +
                '<div class="select-choices with-teams display-block without-hover clearfix">' +
                    loadlist(false)+
                '</div>' +
                getAccess() +
            '</div>';

     function getAccess(){
         return ($ctrl.CPS.isAuthenticated ? ('<div><a class="small inline-block semibold ' + $ctrl.liTeam + '" analytics-on analytics-action="Add Team Members">Add Team to Account</a></div>') : '');
     }
        }

        function loadlist(isCollabs) {
            var name = isCollabs ? 'userCollabs' : 'team',
                list = $ctrl[name];
            if(!list){return '';}
            if(isCollabs && !list.length){return '';}

            var el = '';
            _.each(list, function (item, i) {
                el += '<li class="ui-select-choices-group" '+
                    ((isCollabs && (i === 0)) || (!isCollabs && (i === (list.length - 1)))?'style="border-color:transparent"':'')+
                    '>' +
                        '<div class="select-choices-row-inner">' +
                            '<div class="col40 vtop">' + getImage(item, "small34") + '</div>' +
                            '<div class="with-padding-left">' +
                                (item.name ? ('<div class="name">' + item.name + '</div>') : '') +
                                '<div class="email">' + (isCollabs? getAccess(item) : getMemberTypeText(item)) + '</div>' +
                            '</div>' +
                        '</div>' +
                    '</li>';
            });

            return '<ul style="max-height:100%">' + el + '</ul>';
        }

        function getAccess(item) {
            return item.permission === 1 ? 'Viewer' : (item.permission === 2 ? 'Commenter' : 'Editor');
        }

        function getImage(item, cls) {
            return $ctrl.security.getImage(item, cls, 'profilePictureURL', 50);
        }

        function getMemberTypeText(item) {
            var el = _.find($ctrl.SBFieldMethods.MemberTypes, {value: item.memberType});
            return el ? el.text : '';
        }
    }
}

angular.module('user.share.collaboratorsFacesMenu.component',[
    'sb.fields.popovers.assignCollaboratorsMenuInit.controller.service'
])
.component('sbAssignCollaboratorsMenu', {
    bindings: {
        shareListType: '@?',
        shareListName: '@?',
        drpClass: '@?',
        team : '<?',
        userCollabs:'<',
        withShare:'<',
        withTeam:'<',
        onSelect: '&',
        onAction: '&'
    },
    controller: 'SBAssignCollaboratorsMenuCtrl'
})

.controller('SBAssignCollaboratorsMenuCtrl', SBAssignCollaboratorsMenuCtrl);
SBAssignCollaboratorsMenuCtrl.$inject =['SBAssignCollaboratorsMenuInitCtrlService', '$element'];

function SBAssignCollaboratorsMenuCtrl(SBAssignCollaboratorsMenuInitCtrlService, $element) {
    console.log('SBAssignCollaboratorsMenuCtrl');
    var $ctrl = this;
    $ctrl.getInnerContent = getInnerContent;
    $ctrl.bind = bind;

    function bind(isBind) {
        bindOne(isBind, $ctrl.liTeam, goToTeam);
        bindMultiple(isBind, $ctrl.liShare, share);
    }

    function bindOne(isBind, cls, method) {
        bindx(isBind, cls, method, false);
    }

    function bindMultiple(isBind, cls, method) {
        bindx(isBind, cls, method, true);
    }

    function bindx(isBind, cls, method, isMultiple) {
        if(isBind){
            $ctrl['btn' + cls] = $ctrl.element[isMultiple ? 'querySelectorAll' : 'querySelector']('.' + cls);
        }
        $ctrl.LCS.bindElementsClick(isBind, $ctrl['btn' + cls], method);
    }

    function share(e) {
        onAction(e, 'share');
    }

    function goToTeam(e) {
        onAction(e, 'team');
    }

    function onAction(e, type) {
        $ctrl.preventDefault(e);
        $ctrl.onAction({type: type});
    }

    function getInnerContent() {
        return '' +
            //getInvitePeople()+
            getShare() +
            getAccess();

        function getAccess() {
            return $ctrl.CPS.isAuthenticated ? (
                '<div class="spacing-half-top">' +
                '<a class="small inline-block semibold ' + $ctrl.liShare + '" analytics-on analytics-action="Open Share Popup">Manage Access</a>' +
                '<div class=" padding-right-24 sb-hide">' +
                '<input class="form-control with-hover font-size-14" id="linkCopy" ng-model="$ctrl.sharedLink" readonly style="min-height: 32px;height:32px">' +
                '</div>' +
                '</div>') : '';
        }

        function getShare() {
            return '<div ' + ($ctrl.withShare ? ('class="' + $ctrl.liShare + '" analytics-on analytics-action="Open Share" ') : '') + '>' +
                '<div class="header margin-top-half">Who Has Access <span class="with-parenthesis"> ' + ($ctrl.membersCount + ' member' + ($ctrl.membersCount === 1 ? '' : 's')) + '</span></div>' +
                '<div class="select-choices with-teams display-block without-hover">' +
                $ctrl.loadlist(true) +
                $ctrl.loadlist(false) +
                '</div>' +
                '</div>';
        }

        function getInvitePeople() {
            if (!($ctrl.withShare || $ctrl.withTeam)) {
                return '';
            }

            return '<div>' +
                '<div class="header">Invite People</div>' +
                '<ul>' +
                ($ctrl.withShare ? ('<li class="table-div full-width with-cursor spacing-half-top ' + $ctrl.liShare + '" analytics-on analytics-action="Open Share">' +
                    '<div class="padding-right10" style="padding-top:2px">' +
                    $ctrl.LCS.getISBDiv('plus-circled', 2, 'sideicon gray') +
                    '</div>' +
                    '<div>' +
                    '<div class="name">Invite Collaborators</div>' +
                    '<div class="full-width">Invite collaborators to view or edit ' +
                    ($ctrl.shareListName ? ('<br/>the <span class="semibold">' + $ctrl.shareListType + '</span> for <span class="semibold ">\"' + $ctrl.shareListName + '\"</span>') : 'this page') +
                    '</div>' +
                    '</div>' +
                    '</li>') : '') +
                ($ctrl.withTeam ? ('<li class="table-div full-width with-cursor spacing-half-top ' + $ctrl.liTeam + '" analytics-on analytics-action="Add Team Members">' +
                    '<div class="padding-right10" style="padding-top:2px">' +
                    $ctrl.LCS.getISBDiv('team', null, 'sideicon gray') +
                    '</div>' +
                    '<div>' +
                    '<div class="name">Add Team Members</div>' +
                    '<div class="full-width">Admin access to all the projects and pages on this account.</div>' +
                    '</div>' +
                    '</li>') : '') +
                '</ul>' +
                '</div>';
        }
    }
}

angular.module('sb.fields.popovers.assignCollaborators.component',[
    'sb.fields.popovers.assignCollaboratorsInit.controller.service',
    'user.share.collaboratorsFacesMenu.component'
])
.component('sbAssignCollaborators', {
    bindings: {
        canEdit: '<',

        showAllTeam: '@',
        showOnlyCounter: '@?',
        maxCount: '@?',
        circleSize: '@',
        withCount: '@?',

        uId: '<?',//the item to share
        list: '<', //set in getSBContentEditObjectParams
        todoPageId: '@',
        service: '<',
        value: '<?',
        compOptions:'<',

        elementId: '@',
        onCancel: '&',
        onChange: '&'
    },
    template: getSBDropdownTemplate('collabSelector'),
    controller: 'SBAssignCollaboratorsCtrl'
})
.controller('SBAssignCollaboratorsCtrl', SBAssignCollaboratorsCtrl);
SBAssignCollaboratorsCtrl.$inject =['SBAssignCollaboratorsInitCtrlService', '$element', '$attrs'];

function SBAssignCollaboratorsCtrl(SBAssignCollaboratorsInitCtrlService, $element, $attrs) {
    console.log('SBAssignCollaboratorsCtrl');
    var $ctrl = this;

    $ctrl.menuTag = 'sb-assign-collaborators-menu';
    $ctrl.controllername = 'SBAssignCollaboratorsCtrl';

    $ctrl.initDrpOther = initDrpOther;
    $ctrl.onAction = onAction;

    $ctrl = new SBAssignCollaboratorsInitCtrlService($ctrl, $element, $attrs);

    function initDrpOther(){
        $ctrl.showOnlyCounter = $ctrl.showOnlyCounter === true || $ctrl.showOnlyCounter === 'true';
        $ctrl.showAllTeam = $ctrl.showAllTeam === true || $ctrl.showAllTeam === 'true';

        if (!$ctrl.circleSize) {
            $ctrl.circleSize = 'little';
        }
        if ($ctrl.maxCount === undefined || $ctrl.maxCount === 'undefined') {
            $ctrl.maxCount = 100;
        }
        $ctrl.maxCount = parseInt($ctrl.maxCount, 10);

        var cls = 'team-members with-cursor one-line-tooltip';
        if ($ctrl.maxCount) {
            cls += ' moreusers ' + $ctrl.circleSize;
        }
        $ctrl.LCS.addClass($ctrl.element, cls);
    }

    function share(e) {
        $ctrl.preventDefault(e);
        //todo dont allow collaborators to see the share page
        if (canShare()) {
            $ctrl.RouteCollaboratorsService.share($ctrl.uId, $ctrl.uId ? {
                type: $ctrl.shareListType,
                name: $ctrl.shareListName
            } : null, $ctrl.compOptions);
        } else {
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.share.permissions.error', 'error');
        }
    }

    function canShare() {
        return $ctrl.canEdit && !$ctrl.isDashboard && $ctrl.CPS.isAuthenticated &&
            $ctrl.todoPage && $ctrl.todoPage.hasShare;
    }

    function goToTeam() {
        $ctrl.popupsService.teamAdminAccess(function () {
            $ctrl.CPS.transitionTo('user.team', $ctrl.CPS.currentPathParams({addSeats: true}));
        });
    }

    function onAction(type) {
        if (type === 'share') {
            share();
        } else if (type === 'team') {
            goToTeam();
        }
    }
}

angular.module('sb.fields.popovers.assignLikesInline.component',[
'user.share.collaborators.service'
])
.component('sbAssignLikesInline', {
    bindings: {
        list: '<',
        isPageShare: '<',
        todoPageId: '@',
        elemType: '@',
        compOptions: '<'
    },
    controller: 'SBAssignLikesInlineCtrl'
})

    .controller('SBAssignLikesInlineCtrl', SBAssignLikesInlineCtrl);
SBAssignLikesInlineCtrl.$inject =['TemplateCompileCompCtrlService', 'SBFieldMethods', 'RouteCollaboratorsService', '$element'];

function SBAssignLikesInlineCtrl(TemplateCompileCompCtrlService, SBFieldMethods, RouteCollaboratorsService, $element) {
    console.log('SBAssignLikesInlineCtrl');
    var $ctrl = this;

    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
    $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;
    $ctrl.SBFieldMethods = SBFieldMethods;

    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        //$ctrl.CPS.productId >>>
        $ctrl.team = $ctrl.RouteCollaboratorsService.getProjectTeam($ctrl.CPS.product);
        $ctrl.todoPage = $ctrl.RouteCollaboratorsService.BlocksSetupService.getTodoPageById($ctrl.todoPageId);
        $ctrl.userCollabs = $ctrl.RouteCollaboratorsService.getUserCollaborators($ctrl.list ? $ctrl.list._id : null, $ctrl.todoPage);
    }

    function postInit(){
        $ctrl.addRootWatcher('MATERIAL_VIEWER_UPDATE_LIKES_' + $ctrl.elemType + '_' + $ctrl.list.currentItemId, onLikesChanged);
    }

    function onLikesChanged(likes){
        console.log('onLikesChanged');
        if(!$ctrl.list){$ctrl.list = {};}
        $ctrl.list.likes = likes;
        $ctrl.reloadTemplate();
    }

    function setCollabCount() {
        if(!$ctrl.list){$ctrl.list = {};}
        if(!$ctrl.list.likes){$ctrl.list.likes = [];}
        $ctrl.activity = _.sortBy(_.filter($ctrl.list.likes, function (item) {
            return item.removed !== true;
        }).map(function (item1) {
            var item = _.extend({}, item1, {
                createdAtX: $ctrl.MomentService.getTimestamp(item1.createdAt)
            });

            item.createdAt = $ctrl.MomentService.getMomentFromString(item.createdAt);

            item.user = isInList($ctrl.team, true);
            if (!item.user) {
                item.user = isInList($ctrl.userCollabs, false);
            }

            return item;

            function isInList(list, isUser) {
                var el = _.find(list, function (u) {
                    return u.userId === item.userId;
                });
                if (el) {
                    el.isUser = isUser;
                }

                return el;
            }
        }), 'createdAtX');

        $ctrl.broadcastRoot('MATERIAL_VIEWER_UPDATE_LIKES_COUNT', {count: $ctrl.activity && $ctrl.activity.length ? $ctrl.activity.length : 0, likes: $ctrl.list.likes});
    }

    function getItemTemplate() {
        setCollabCount();

return '<div class="list-table">' +
           // '<div class="header">' + $ctrl.LCS.getISBDiv('team', 2, 'pull-left with-margin-right gray') + 'Shared with ' + ($ctrl.collabCount + ' collaborator' + ($ctrl.collabCount === 1 ? '' : 's')) + '</div>' +
            '<div class="select-choices with-teams display-block without-hover clearfix">' +
                loadlist(true) +
            '</div>' +
        '</div>';

        function loadlist() {
            var l = $ctrl.activity && $ctrl.activity.length ? $ctrl.activity.length : 0,
                el = l > 0 ? $ctrl.activity.map(function (a, i) {
                    var item = a.user,
                        isCollabs = !item.isUser;
                return '<li class="ui-select-choices-group">' +
                        '<div class="select-choices-row-inner">' +
                            '<div class="col40 vtop">' + getImage(item, "small34") + '</div>' +
                            '<div class="with-padding-left">' +
                                (item.name ? ('<div class="name">' + item.name + ' liked this on ' + displayDate(a.createdAt) + '</div>') : '') +
                                '<div class="email">' + (isCollabs ? getAccess(item) : getMemberTypeText(item)) + '</div>' +
                            '</div>' +
                        '</div>' +
                    '</li>';
                }).join('') : '';
            return '<ul style="max-height:100%">' + el + '</ul>';
        }

        function displayDate(date) {
            return date ? $ctrl.CPS.getCreatedAt(date, 'MMM D @ ' + $ctrl.CPS.timeFormat) : '';
        }

        function getAccess(item) {
            return item.permission === 1 ? 'Viewer' : (item.permission === 2 ? 'Commenter' : 'Editor');
        }

        function getImage(item, cls) {
            return $ctrl.security.getImage(item, cls, 'profilePictureURL', 50);
        }

        function getMemberTypeText(item) {
            var el = _.find($ctrl.SBFieldMethods.MemberTypes, {value: item.memberType});
            return el ? el.text : '';
        }
    }
}

angular.module('user.share.assignLikesMenu.component',[
])
.component('sbAssignLikesMenu', {
    bindings: {

        shareListType: '@?',
        shareListName: '@?',
        drpClass: '@?',
        team : '<?',
        userCollabs:'<',
        withShare:'<',
        withTeam:'<',
        onSelect: '&',
        onAction: '&'
    },
    controller: 'SBAssignLikesMenuCtrl'
})

.controller('SBAssignLikesMenuCtrl', SBAssignLikesMenuCtrl);
SBAssignLikesMenuCtrl.$inject =['TemplateCompileCompCtrlService', 'SBFieldMethods', '$element'];

function SBAssignLikesMenuCtrl(TemplateCompileCompCtrlService, SBFieldMethods, $element) {
    console.log('SBAssignLikesMenuCtrl');
    var $ctrl = this,
    withoutTemplateScope = false;
    $ctrl.SBFieldMethods = SBFieldMethods;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;
    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        $ctrl.liShare = 'liShare';
        $ctrl.liTeam = 'liTeam';
        $ctrl.teamCount = ($ctrl.team ? $ctrl.team.length : 0);
        $ctrl.collabCount = ($ctrl.userCollabs ? _.filter($ctrl.userCollabs, function (el) {
            if (el.isGeneral) {
                $ctrl.hasGeneralLink = true;
            }
            return !el.isGeneral;
        }).length : 0);
        $ctrl.membersCount =  $ctrl.collabCount + $ctrl.teamCount;
    }
    function onDestroy() {
        bind(false);
    }

    function onLoaded() {
        bind(true);
    }

    function bind(isBind) {
        bindOne(isBind, $ctrl.liTeam, goToTeam);
        bindMultiple(isBind, $ctrl.liShare, share);
    }

    function bindOne(isBind, cls, method) {
        bindx(isBind, cls, method, false);
    }

    function bindMultiple(isBind, cls, method) {
        bindx(isBind, cls, method, true);
    }

    function bindx(isBind, cls, method, isMultiple) {
        if(isBind){
            $ctrl['btn' + cls] = $ctrl.element[isMultiple ? 'querySelectorAll' : 'querySelector']('.' + cls);
        }
        $ctrl.LCS.bindElementsClick(isBind, $ctrl['btn' + cls], method);
    }

    function share(e) {
        onAction(e, 'share');
    }

    function goToTeam(e) {
        onAction(e, 'team');
    }
    
    function onAction(e, type) {
        $ctrl.preventDefault(e);
        $ctrl.onAction({type: type});
    }

    function getItemTemplate() {
return '<div class="dropdown-menu selectabledropdown addteammate team'+ $ctrl.membersCount+' '+($ctrl.drpClass?$ctrl.drpClass:'')+'">' +
            '<div class="show-scrollbar-on-hover" style="padding-right: 11px">' +
                '<div class="fancy-scrollbar vertical" style="max-height: 438px;padding-right: 17px;">' +
                    //getInvitePeople()+
                    getShare() +
                    getAccess() +
                '</div>' +
            '</div>' +
        '</div>';

function getAccess(){
    return $ctrl.CPS.isAuthenticated ? (
        '<div class="spacing-half-top">' +
        '<a class="small inline-block semibold ' + $ctrl.liShare + '" analytics-on analytics-action="Open Share Popup">Manage Access</a>' +
        '<div class=" padding-right-24 sb-hide">' +
        '<input class="form-control with-hover font-size-14" id="linkCopy" ng-model="$ctrl.sharedLink" readonly style="min-height: 32px;height:32px">' +
        '</div>' +
        '</div>') : '';
}
        function getInvitePeople(){
            if(!($ctrl.withShare || $ctrl.withTeam)){return '';}

            return '<div>' +
                        '<div class="header">Invite People</div>' +
                        '<ul>' +
                ($ctrl.withShare ?('<li class="table-div full-width with-cursor spacing-half-top '+$ctrl.liShare+'" analytics-on analytics-action="Open Share">' +
                                '<div class="padding-right10" style="padding-top:2px">' +
                                    $ctrl.LCS.getISBDiv('plus-circled', 2, 'sideicon gray') +
                                '</div>' +
                                '<div>' +
                                    '<div class="name">Invite Collaborators</div>' +
                                    '<div class="full-width">Invite collaborators to view or edit '+
                       ($ctrl.shareListName ? ('<br/>the <span class="semibold">'+$ctrl.shareListType+'</span> for <span class="semibold ">\"'+$ctrl.shareListName+'\"</span>'): 'this page') +
                                    '</div>' +
                                '</div>' +
                            '</li>') : '') +
                    ($ctrl.withTeam ?('<li class="table-div full-width with-cursor spacing-half-top '+$ctrl.liTeam+'" analytics-on analytics-action="Add Team Members">' +
                                '<div class="padding-right10" style="padding-top:2px">' +
                                     $ctrl.LCS.getISBDiv('team', null, 'sideicon gray')+
                                '</div>' +
                                '<div>' +
                                    '<div class="name">Add Team Members</div>' +
                                    '<div class="full-width">Admin access to all the projects and pages on this account.</div>' +
                                '</div>' +
                            '</li>') : '') +
                        '</ul>' +
                    '</div>';
            }

        function getShare() {
    return '<div '+($ctrl.withShare ?('class="'+$ctrl.liShare+'" analytics-on analytics-action="Open Share" '):'')+'>' +
                '<div class="header margin-top-half">Who Has Access <span class="with-parenthesis"> ' + ($ctrl.membersCount + ' member' + ($ctrl.membersCount===1?'':'s'))+'</span></div>' +
                '<div class="select-choices with-teams display-block without-hover">' +
                    loadlist(true) +
                    loadlist(false)+
                '</div>' +
            '</div>';
        }

        function loadlist(isCollabs) {
            var name = isCollabs ? 'userCollabs' : 'team',
            list = $ctrl[name];

            if(!list){return '';}

            if(isCollabs && !(list.length - ($ctrl.hasGeneralLink ? 1 : 0))){return '';}

            var el = '';
            _.each(list, function (item, i) {
                if(!(isCollabs&&item.isGeneral)){
        el += '<li class="ui-select-choices-group" '+
                    ((isCollabs && (i === 0)) || (!isCollabs && (i === (list.length - 1)))?'style="border-color:transparent"':'')+
                    '>' +
                    '<div class="select-choices-row-inner">' +
                        '<div class="col40 vtop">' + getImage(item, "small34") + '</div>' +
                        '<div class="with-padding-left">' +
            (item.name ? ('<div class="name">'+item.name+'</div>') : '') +
                            '<div class="email">'+(isCollabs?('Can ' + (item.permission===1?'View':(item.permission===2?'Comment':'Edit'))): getMemberTypeText(item))+'</div>' +
                        '</div>' +
                    '</div>' +
                '</li>';
                }
            });

            return '<ul style="max-height:100%">'+el+'</ul>';
        }

        function getImage(item, cls) {
            return $ctrl.security.getImage(item, cls, 'profilePictureURL', 50);
        }

        function getMemberTypeText(item) {
            var el = _.find($ctrl.SBFieldMethods.MemberTypes, {value: item.memberType});
            return el ? el.text : '';
        }
    }

}

angular.module('sb.fields.popovers.assignLikes.component',[
'user.share.collaborators.service'
])
.component('sbAssignLikes', {
    bindings: {
        uId: '<',
        list: '<',
        isPageShare: '<',
        todoPageId: '@',
        compOptions: '<'
    },
    controller: 'SBAssignLikesCtrl'
})
.controller('SBAssignLikesCtrl', SBAssignLikesCtrl);
SBAssignLikesCtrl.$inject =['TemplateCompileCompCtrlService', 'SBFieldMethods', 'RouteCollaboratorsService', '$element'];

function SBAssignLikesCtrl(TemplateCompileCompCtrlService, SBFieldMethods, RouteCollaboratorsService, $element) {
    console.log('SBAssignLikesCtrl');
    var $ctrl = this;
    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
    $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;
    $ctrl.SBFieldMethods = SBFieldMethods;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.liShare = 'liShare';
        $ctrl.liTeam = 'liTeam';

        //$ctrl.CPS.productId >>>
        $ctrl.team = $ctrl.RouteCollaboratorsService.getProjectTeam($ctrl.CPS.product);
        $ctrl.teamCount = ($ctrl.team ? $ctrl.team.length : 0);

        $ctrl.todoPage = $ctrl.RouteCollaboratorsService.BlocksSetupService.getTodoPageById($ctrl.todoPageId); //todo set it

        addWatcher();

        //when collaborators from the parent get updated propagate : {uId: uId, c:collaborators}
        $ctrl.removeWatcher($ctrl.uPIdRootWatcher);
        $ctrl.uPIdRootWatcher = $ctrl.addRootWatcher('UPDATE_PARENT_COLLABORATORS', onUpdateParentCollaborators);
    }

    function setCollabCount() {
        $ctrl.userCollabs = $ctrl.RouteCollaboratorsService.getUserCollaborators($ctrl.uId, $ctrl.todoPage);
        $ctrl.collabCount = $ctrl.userCollabs ? $ctrl.userCollabs.length : 0;
    }

    function getSharedUrl(item) {
        return item && item._id ? ($ctrl.CPS.websiteUrl + '/shared/' + item._id) : null;
    }

    function addWatcher() {
        if($ctrl.uIdRootWatcher) {
            $ctrl.removeWatcher($ctrl.uIdRootWatcher);
        }
        if ($ctrl.uId) {
            if($ctrl.isDoc) {
                $ctrl.shareListType = $ctrl.itemTitle;
                $ctrl.shareListName = $ctrl.list.name;
            }else {
                var info = $ctrl.RouteCollaboratorsService.getShareListInfo($ctrl.uId, $ctrl.compOptions, $ctrl.isDoc ? $ctrl.list : null ),
                    shareList = info ? info.shareList : null;
                if (shareList) {
                    $ctrl.shareListType = shareList.type;
                    $ctrl.shareListName = shareList.name;
                }
            }

            $ctrl.removeWatcher($ctrl.uIdRootWatcher);
            $ctrl.uIdRootWatcher = $ctrl.addRootWatcher('UPDATE_ITEM_COLLABORATORS_' + $ctrl.uId, onUpdateItemCollaborators);
        }
        setCollabCount();
    }

    function onUpdateItemCollaborators(result) {
        console.log('UPDATE_ITEM_COLLABORATORS');
        $ctrl.reloadTemplate();
    }

    function onUpdateParentCollaborators(result) {
        console.log('UPDATE_PARENT_COLLABORATORS');
        $ctrl.reloadTemplate();
    }

    function share(e) {
        $ctrl.preventDefault(e);
        //todo dont allow collaborators to see the share page
        if (canShare()) {
            if($ctrl.isPageShare){
                $ctrl.broadcastRoot('SHARE_PAGE', {
                    params: {
                        isPageShare: true,
                        uId: $ctrl.uId
                    },
                    e: e
                });
            }else {
                $ctrl.broadcastRoot('SHARE_LIST_FROM_COMMENTS', {uId: $ctrl.uId});

            }
        } else {
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.share.permissions.error', 'error');
        }
    }

    function canShare() {
        return $ctrl.canEdit && !$ctrl.isDashboard && $ctrl.CPS.isAuthenticated &&
            !$ctrl.SBStateService.isProductOverviewState() &&
                $ctrl.BlocksSetupService.todoPageHasShare();
    }

    function onDestroy() {
        bind(false);
    }

    function onLoaded() {
        bind(true);
    }

    function bind(isBind){
        bindOne(isBind, $ctrl.liTeam, goToTeam);
        bindOne(isBind, $ctrl.liShare, share);
    }

    function bindOne(isBind, cls, method) {
        if(isBind){
            $ctrl['btn' + cls] = $ctrl.element.querySelector('.' + cls);
        }

        $ctrl.LCS.bindElementsClick(isBind, $ctrl['btn' + cls], method);
    }

    function getItemTemplate() {
        setCollabCount();
        return '<div>' +
                    getCollabs()+
                    getTeam() +
                '</div>';

        function getCollabs(){
        return '<div class="list-table with-border-bottom">' +
                    '<div class="header">' +
                        $ctrl.LCS.getISBDiv('team', 2, 'pull-left with-margin-right gray') +
                        'Shared with ' + ($ctrl.collabCount + ' collaborator' + ($ctrl.collabCount === 1 ? '' : 's')) +
                    '</div>' +
                    '<div class="select-choices with-teams display-block without-hover clearfix">' +
                        loadlist(true) +
                    '</div>' +
                    getAccess() +
                '</div>';

            function getAccess (){
                return $ctrl.CPS.isAuthenticated ? (
                    '<div>' +
                        '<a class="small inline-block semibold ' + $ctrl.liShare + '" analytics-on analytics-action="Open Share Popup">Manage Access</a>' +
                        '<div class=" padding-right-24 sb-hide">' +
                            '<input class="form-control with-hover font-size-14" id="linkCopy" ng-model="$ctrl.sharedLink" readonly style="min-height: 32px;height:32px">' +
                        '</div>' +
                    '</div>') : '';
            }
        }

        function getTeam(){
     return '<div class="list-table">' +
                '<div class="header">' +
                    $ctrl.LCS.getISBDiv('team', 2, 'pull-left with-margin-right gray') + 'Project Team' +
         //' <span class="with-parenthesis"> ' + ($ctrl.teamCount + ' member' + ($ctrl.teamCount===1?'':'s'))+'</span>' +
                '</div>' +
                '<div class="select-choices with-teams display-block without-hover clearfix">' +
                    loadlist(false)+
                '</div>' +
            '</div>';

        }

        function loadlist(isCollabs) {
            var name = isCollabs ? 'userCollabs' : 'team',
                list = $ctrl[name];
            if(!list){return '';}
            if(isCollabs && !list.length){return '';}

            var el = '';
            _.each(list, function (item, i) {
                el += '<li class="ui-select-choices-group" '+
                    ((isCollabs && (i === 0)) || (!isCollabs && (i === (list.length - 1)))?'style="border-color:transparent"':'')+
                    '>' +
                        '<div class="select-choices-row-inner">' +
                            '<div class="col40 vtop">' + getImage(item, "small34") + '</div>' +
                            '<div class="with-padding-left">' +
                                (item.name ? ('<div class="name">' + item.name + '</div>') : '') +
                                '<div class="email">' + (isCollabs? getAccess(item) : getMemberTypeText(item)) + '</div>' +
                            '</div>' +
                        '</div>' +
                    '</li>';
            });

            return '<ul style="max-height:100%">' + el + '</ul>';
        }

        function getAccess(item) {
            return item.permission === 1 ? 'Viewer' : (item.permission === 2 ? 'Commenter' : 'Editor');
        }

        function getImage(item, cls) {
            return $ctrl.security.getImage(item, cls, 'profilePictureURL', 50);
        }

        function getMemberTypeText(item) {
            var el = _.find($ctrl.SBFieldMethods.MemberTypes, {value: item.memberType});
            return el ? el.text : '';
        }
    }
}

