angular.module('product.callsheet.edit.layout.service', [
    'user.callsheet.item.template.component',
    'product.settings.popup.component',
    'apiServices.Callsheets',
    'sb.sortable.service'
])
.service('CallsheetLayoutServiceController', CallsheetLayoutServiceController);
CallsheetLayoutServiceController.$inject = ['TemplateCompileCompCtrlService', 'CallsheetConstantsService', 'SortInitService',
    'SBSortableService'
];
function CallsheetLayoutServiceController(TemplateCompileCompCtrlService, CallsheetConstantsService, SortInitService, SBSortableService) {
    return function ($ctrl, $element){
        console.log('CallsheetLayoutServiceController');
        $ctrl.SBSortableService = SBSortableService;
        $ctrl.SortInitService = SortInitService;

        $ctrl.dontShowActivity= true;
        $ctrl.quotaTypeAdvanced = 'callsheetAdvanced';
        $ctrl.currentListId = null;
        $ctrl.itemSelector = 'flex-wrap .dd-item';

        $ctrl.getItemTemplate = getItemTemplate;
        $ctrl.preInit = preInit;
        $ctrl.postInit = postInit;
        $ctrl.onDestroy = onDestroy;
        $ctrl.onLoaded = onLoaded;
        $ctrl.openProPopup = openProPopup;

        $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

        return $ctrl;

        function openProPopup(quotaType, e){
            $ctrl.CPS.loadQuotaPopup(quotaType ? quotaType : $ctrl.quotaTypeAdvanced, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});

            function process(){}
        }
        //open warning popup first
        function preInit() {
            $ctrl.CallsheetConstantsService = angular.copy(CallsheetConstantsService);

            $ctrl.preLoadingTableName = 'Callsheets';
            if (!$ctrl.optionsProp) {
                console.warn('Parent for CallsheetLayoutServiceController must define prop optionsProp');
            }

            if (!$ctrl.preLoadingService) {
                console.log('Must define preLoadingService');
            }
            $ctrl.callsheet = angular.copy($ctrl.CurrentProduct.getCallsheet());
            $ctrl.callsheetId = $ctrl.callsheet._id;

            $ctrl.sortableContainmentCls = 'sortableContainmentLayout';
            $ctrl.sortableGrid = 'callsheetsidebar' + $ctrl.optionsProp;
            $ctrl.changeOrderServerSide = changeOrderServerSide;

            preset($ctrl.callsheet.options);

            if ($ctrl.optionsProp === 'blocks') {
                $ctrl = new $ctrl.SortInitService($ctrl);
            }
        }

        function postInit() {
            $ctrl.addRootWatcher('CALLSHEET_TEMPLATE_CHANGED', onTemplateChanged);
            $ctrl.addRootWatcher('CALLSHEET_'+$ctrl.optionsProp.toUpperCase()+'_CHANGED', onSettingsChanged);
        }

        function onSettingsChanged(result) {
            console.log('layout.onSettingsChanged');
            if(result){
                var info = result.info;
                if (info) {
                    for(var block in info){
                        var updates = info[block];
                        for (var prop in updates) {
                            var value = updates ? updates[prop] : null;
                            if(!$ctrl.options[block]){$ctrl.options[block] = {};}
                            $ctrl.options[block][prop] = value;
                            if (prop === 'title') {
                                var el = $ctrl.element.querySelector('li[data-id="' + block + '"] .itemTitle');
                                if (el) {
                                    el.innerText = value;
                                }
                            } else if (prop === 'show') {
                                var el = $ctrl.element.querySelector('li[data-id="' + block + '"]');
                                if (el) {
                                    $ctrl.LCS[value ? 'addClass' : 'removeClass'](el, 'active');
                                }
                            } else if (prop === 'colList') {

                            }
                        }
                    }
                }
             //   updateTitle(updates.colList);
            }
        }

        function onTemplateChanged(options) {
            console.log('layout.onTemplateChanged');
            preset(options);
            $ctrl.reloadTemplate();
        }

        function preset(options) {
            $ctrl.options = options ? options[$ctrl.optionsProp] : {};
            $ctrl.list = $ctrl.CallsheetConstantsService.getBlockList(options, $ctrl.optionsProp);
        }

        function getItemTemplate() {
            var hasQuotaType= hideProForGrid(),
                withSortable = $ctrl.optionsProp === 'blocks',
                listId  = 'null',
                cls = 'callsheetLayout',

                el = $ctrl.list.map(function (item) {
                    var settings = $ctrl.CallsheetConstantsService[$ctrl.optionsProp+'Settings'][item.id];
                    if(settings) {
                        var isPro = !(item.quotaType ?  hideProForGrid(item.quotaType) : hasQuotaType) && item.isPro;
                        return '<li data-id="' + item.id + '" ' +
                            (isPro ? (' data-type="openProPopup" ' + (item.quotaType ? (' data-info="' + item.quotaType + '"') : '')) : '') +
                            'class="' +
                                (isPro ? ($ctrl.getBtnActionCls() + ' with-cursor ') : '') +
                                (withSortable ? ('dd-item as-sortable-item') : 'btnShow with-cursor ') + ' ' + (item.show ? 'active' : '') +
                            '" analytics-on analytics-action="Toggle Grid ' + item.title + '">' +
                            getContent(
                            '<div class="'+(withSortable?'col25 with-padding-right centered':'full-width centering')+'">'+$ctrl.LCS.getISBDiv(item.icon, 5, 'gray ' + (withSortable ? '' : 'centering ')) +'</div>' +
                            '<div class="info centered '+(withSortable? 'grow-column':'full-width centering')+'"><span class="with-ellipsis itemTitle">' + item.title + '</span>' +
                            (isPro ? '<span class="with-margin-left profeature small-padding">PRO</span>' : '') +
                            '</div>' +
                            (withSortable && !isPro? ('<div class="btnShow with-cursor centered text-center col30"><div class="with-hover" tooltip-placement="bottom" tooltip="Show/Hide">'+$ctrl.LCS.getISBDiv($ctrl.options && $ctrl.options.show ? 'eye-hidden' : 'eye', 2, 'gray')+'</div></div>' + // (item.show?'Hide':'Show')+
                            '<div class="btnEdit with-cursor centered text-center col30"><div class="with-hover" tooltip-placement="bottom" tooltip="Settings">'+$ctrl.LCS.getISBDiv('cog', 2, 'gray')+'</div></div>'
                            ) :'')
                            ) +
                            '</li>';

                        function getContent(content){
                            return withSortable ? ('<div class="row-schedule without-hover full-width">' +
                                '<div class="as-sortable-item-handle col25 centered text-center hide-print">' + $ctrl.LCS.getISBDiv('dd3-handle', 0, 'centered gray') + '</div>' + content + '</div>') : content;
                        }
                    }
                    return '';
                }).join('');

            return '<div id="'+$ctrl.sortableGrid+'" class="tree-node tree-node-content" current-list-id="'+listId+'" data-id="'+listId+'">' +
                        '<div class="dd full-width ' + (cls ? (cls + ' ') : '') +  (withSortable ? $ctrl.sortableContainmentCls : '')+ '" data-currentlistid="'+listId+'">' +
                            '<ul class="flex-wrap">' + el + '</ul>' +
                        '</div>' +
                   '</div>';
        }

        function hideProForGrid(quotaType) {
            return $ctrl.CPS.hasQuotaType(quotaType ? quotaType : $ctrl.quotaTypeAdvanced);
        }

        function onLoaded(){
            bind(true);
            if($ctrl.optionsProp === 'blocks') {
                initSortableService();
            }
        }

        function initSortableService(){
            var sortableContainmentCls = $ctrl.sortableContainmentCls ? ('.' + $ctrl.sortableContainmentCls) : ($ctrl.sortableGrid ? ('#' + $ctrl.sortableGrid) : '');

            $ctrl.sortableService = new $ctrl.SBSortableService($ctrl.element, {
                currentListId: $ctrl.currentListId,
                elemType: $ctrl.elemType,

                sortableContainerCls: $ctrl.sortableContainerCls,
                sortableContainmentCls: sortableContainmentCls,
                containerPositioning: 'relative',//optional param.
                scrollableParentCls: $ctrl.scrollableParentCls ? $ctrl.scrollableParentCls : sortableContainmentCls,
            }, {isDragula: true});

            $ctrl.sortableService.addContainer($ctrl.element, {
                sortableGrid: $ctrl.sortableGrid
            });
        }
        //update grids order from sidebar
        function changeOrderServerSide(result, ids) {
            console.log('CallsheetLayoutController: changeOrderServerSide');
            var up = result ? result.updates :null;
            if(!up || $ctrl.isUpdating){return;}

            $ctrl.isUpdating = true;
            var prop = 'order',
                info = {
                    dontShowActivity: $ctrl.dontShowActivity
            };
            for(var block in up){
                var value = up[block];
                if($ctrl.options[block][prop] !== value){
                    var updates = {};
                    updates[prop] = value;
                    info[block] = updates;
                }
            }

            update(info, onSuccess, 'blockOrder');

            function onSuccess(result) {
                //$ctrl.preLoadingService.updateItem($ctrl.preLoadingTableName, params);
                $ctrl.broadcastRoot('CALLSHEET_ORDER_CHANGED', {optionsProp: $ctrl.optionsProp, info: info});
                //btnShow.setAttribute('tooltip', (value?'Hide':'Show')+' View');
            }
        }

        function onDestroy() {
            bind(false);
            if($ctrl.sortableService){
                $ctrl.sortableService.destroy();
            }
        }

        function bind(isBind) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('.btnShow'), toggleVisibility);
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('.btnEdit'), openEdit);
        }

        function toggleVisibility(e) {
            //console.log('CallsheetLayoutController: toggle');
            if($ctrl.isUpdating){return;}

            var btnShow = e.currentTarget,
                liEl = $ctrl.LCS.findClosestParent(btnShow, 'li'),
                block = liEl.getAttribute('data-id');
            if (!block) {return;}



            $ctrl.isUpdating = true;
            var prop = 'show',
                value = $ctrl.options[block][prop] ? false : true,
                info = $ctrl.CurrentProduct.setCallsheetInfo({
                    dontShowActivity: $ctrl.dontShowActivity
                }, prop, value, block);
            update(info, onSuccess, 'blockVisibility');

            function onSuccess(result) {
                //$ctrl.preLoadingService.updateItem($ctrl.preLoadingTableName, params);
                $ctrl.broadcastRoot('CALLSHEET_VISIBILITY_CHANGED', {optionsProp: $ctrl.optionsProp, info: info});
                $ctrl.LCS[value ? 'addClass' : 'removeClass'](liEl, 'active');
                //btnShow.setAttribute('tooltip', (value?'Hide':'Show')+' View');
            }
        }

        function update(info, onSuccess, errorType){
            $ctrl.CurrentProduct.updateCallsheetInfo($ctrl, info, onSuccess, errorType, true);
        }

        function openEdit(e) {
            var btnShow = e.currentTarget,
                liEl = $ctrl.LCS.findClosestParent(btnShow, 'li'),
                block = liEl.getAttribute('data-id');
            $ctrl.popupsService.open(_.extend({}, $ctrl.options[block]), $ctrl.popupsService.operations.callsheetColumns,{
                callsheetId : $ctrl.callsheetId,
                CallsheetConstantsService: $ctrl.CallsheetConstantsService,
                block: block,

            },$ctrl.compOptions);
        }
    }
}

angular.module('product.callsheet.edit.recipients.component', [
    'user.callsheet.item.template.component',
    'product.settings.popup.component',
    'sb.sortable.service'
])
.component('callsheetSidebarRecipients',{
    bindings: {
        preLoadingService :'<?',
        onChange: '&'
    },
    controller: 'CallsheetLayoutRecipientsController',
})
.controller('CallsheetLayoutRecipientsController', CallsheetLayoutRecipientsController);
CallsheetLayoutRecipientsController.$inject = ['TemplateCompileCompCtrlService', 'CallsheetConstantsService',
    'SBSortableService',
    '$element'];
function CallsheetLayoutRecipientsController(TemplateCompileCompCtrlService, CallsheetConstantsService, SBSortableService, $element) {
    console.log('CallsheetLayoutRecipientsController');
    var $ctrl = this;
    $ctrl.SBSortableService = SBSortableService;
    $ctrl.onDestroy = onDestroy;
    $ctrl.setTemplate = setTemplate;
    $ctrl.isSelected = isSelected;

    $ctrl.onLoaded = onLoaded;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.optionsProp = 'blocks';
        $ctrl.CallsheetConstantsService = angular.copy(CallsheetConstantsService);

        $ctrl.callsheet = angular.copy($ctrl.CurrentProduct.getCallsheet());

        $ctrl.sortableContainmentCls = 'sortableContainmentLayout';
        $ctrl.sortableGrid = 'callsheetLayout';
        $ctrl.options = $ctrl.callsheet.options;
        $ctrl.list = $ctrl.CallsheetConstantsService.getBlockList($ctrl.options, $ctrl.optionsProp);
    }

    function postInit(){
        $ctrl.addRootWatcher('RECIPIENT_ADDED', onAdded);
        $ctrl.addRootWatcher('RECIPIENT_REMOVED', onRemoved);
    }

    function onAdded(data) {
        onChanged(data, 'title');
    }

    function onRemoved(data) {
        onChanged(data, 'show');
    }

    function onChanged(data, type) {
        var prop = data.prop,
            title = data[type];

        $ctrl.options[prop][type] = title;

        $ctrl.templateCompile.loadTemplate($ctrl.onLoaded);
    }

    function getItemTemplate() {
        var template ='<ul id="'+$ctrl.sortableGrid+'" class="'+$ctrl.sortableContainmentCls+'" style="margin-top:-6px">';
        _.each($ctrl.list, function (item) {
template += '<li data-id="'+item.id+'" class="as-sortable-item table-div full-width '+(item.show?'active':'')+'" ng-click="$ctrl.setTemplate(t)">'+
                '<div class="as-sortable-item-handle col25 centered text-center hide-print">' + $ctrl.LCS.getISBDiv('dd3-handle', 0, 'centered') + '</div>'+
                '<div class="info centered"><span class="with-ellipsis">'+item.title+'</span></div>' +
                '<div class="with-cursor btnShow centering centered col30"><div class="with-hover" tooltip-placement="bottom" tooltip="Show/Hide">'+$ctrl.LCS.getISBDiv(item.show?'eye-hidden':'eye',3) +'</div></div>' +
                '<div class="with-cursor btnEdit centering centered col30"><div class="with-hover" tooltip-placement="bottom" tooltip="Edit Block Columns">'+$ctrl.LCS.getISBDiv('cog') +'</div></div>' +
            '</li>';
        });
        template += '</ul>';
        return template;
    }

    function onLoaded(){
        bind(true);
        $ctrl.currentListId = null;
        $ctrl.elemType = 'CALLSHET_LAYOUT';
        var sortableContainmentCls = $ctrl.sortableContainmentCls ? ('.' + $ctrl.sortableContainmentCls) : ($ctrl.sortableGrid ? ('#' + $ctrl.sortableGrid) : '');
        $ctrl.sortableService = new $ctrl.SBSortableService($ctrl.element, {
            currentListId: $ctrl.currentListId,
            elemType: $ctrl.elemType,
            sortableContainerCls: $ctrl.sortableContainerCls,
            sortableContainmentCls: sortableContainmentCls,
            containerPositioning: 'relative',//optional param.
            scrollableParentCls: $ctrl.scrollableParentCls ? $ctrl.scrollableParentCls : sortableContainmentCls,
        }, {isDragula: true});


        $ctrl.sortableService.addContainer($ctrl.element, {
            sortableGrid: $ctrl.sortableGrid
        });
    }

    function onDestroy(){
        bind(false);
        if($ctrl.sortableService){
            $ctrl.sortableService.destroy();
        }
    }

    function bind(isBind) {
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('.btnShow'), toggleBlock);
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('.btnEdit'), openEdit);
    }

    function toggleBlock(e) {
        var open = e.currentTarget.getAttribute('data-id');
        if(open){
            $ctrl.open =  parseInt(open,10);
           // setStyle();
        }
    }

    function openEdit(e) {
        var target = e.currentTarget,
            popup = target.getAttribute('data-popup');
        $ctrl.popupsService.open(null, $ctrl.popupsService.operations[popup],
            null,//data ? data.extraParam : null,
            $ctrl.compOptions);
    }

    function setTemplate(item) {
        $ctrl.selectedId = item._id;
        $ctrl.onChange({options: $ctrl.options});
    }

    function isSelected(item) {
        return item._id ===  $ctrl.selectedId;
    }

}

angular.module('product.callsheet.sidebar.component', [
    'product.callsheet.edit.templates.component',
    'product.callsheet.edit.topSection.component',
    'product.callsheet.edit.layout.component',
    'product.callsheet.edit.styles.component',
    'product.callsheet.edit.recipients.component',
    'expandableSection.controller.service'
])
.component('callsheetSidebar', {
    bindings: {
        preLoadingService: '<',
    },
    controller: 'CallsheetSidebarCtrl',
})
.controller('CallsheetSidebarCtrl', CallsheetSidebarCtrl);
CallsheetSidebarCtrl.$inject = ['TemplateCompileCompCtrlService', 'ExpandableSectionService',  '$element'];
function CallsheetSidebarCtrl(TemplateCompileCompCtrlService, ExpandableSectionService, $element) {
    console.log('CallsheetSidebarCtrl');
    var $ctrl = this;
    $ctrl.ExpandableSectionService = ExpandableSectionService;

    $ctrl.Sections = [
        {name: 'Header', id: 1, type: 2, comp:'callsheet-sidebar-top'},
        {name: 'Grids', id: 2, type: 2, comp:'callsheet-sidebar-layout'},
        {name: 'Styles', id: 3, type: 2, comp:'callsheet-sidebar-styles', quotaType: 'callsheetAdvanced'
        },
        //{name: 'Recipients', id: 6, type: 2, comp:'callsheet-sidebar-recipients'},
        {name: 'Templates', id: 4, type: 1, quotaType: 'callsheetTemplates'},
        {name: 'Settings', id: 5, type: 1}
    ];

    $ctrl.Templates = [
        {text: 'Save As New Template', popup: 'createCallsheetTemplate', action:'Save'},
        {text: 'Load Template', popup: 'changeCallsheetTemplate', action:'Load'}
    ];
    $ctrl.Settings = [
        {text: 'Call Sheet Type', popup: 'callsheetType', action:'Edit'},
        {text: 'Departments', popup: 'departmentSettings', action:'Edit'},
        {text: 'Time & Temperature', popup: 'projectSettings', action:'Edit'}
    ];

    $ctrl.mode = 'design';
    $ctrl.dontAutoloadTemplate = false;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.postInit = postInit;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;
    $ctrl.getSidebarName = getSidebarName;
    $ctrl.getSidebarNameOther = getSidebarNameOther;

    $ctrl.expandableSections = new $ctrl.ExpandableSectionService($element);
    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);


    function postInit() {
        $ctrl.addRootWatcher('UPDATE_BLOCK_TITLE', onTitleChanged);
    }

    function onLoaded() {
        $ctrl.expandableSections.setExpandable();
        bind(true);
    }

    function onDestroy() {
        bind(false);
    }

    function bind(isBind) {
        $ctrl.expandableSections.bindExpandable(isBind);
        $ctrl.bindElementsClickBySelector(isBind, '.openPopup', openPopup);
    }
    function getSidebarName(){
        return $ctrl.SBStateService.currentState.name + ($ctrl.isCommentsSidebar ? '_COMMENTS' : '') + ($ctrl.isInTreeModal ? ('_' + $ctrl.isInTreeModal) : '') + ($ctrl.getSidebarNameOther ? ('_' + $ctrl.getSidebarNameOther()) : '');
    }
    function getSidebarNameOther(){
        return ($ctrl.mode||'') + '_' + $ctrl.canEdit;
    }

    function getItemTemplate() {
        bind(false);
return '<div class="outtercontainer show-scrollbar-on-hover">' +
            '<div class="innercontainer fancy-scrollbar sb-scrolling-monitor ultrathin medium-template callsheet-sidebar" sb-scrolling-monitor sb-scrolling-monitor-id="tree" style="background-color: white">' +
                '<div class="sidebarScrollingContainer">' +
                    '<div class="sidebar-toggle no-padding"><a class="btn btn-small transparent noborder smaller inline-block '+$ctrl.getBtnActionCls()+'" data-type="toggleInnerSidebar">'+$ctrl.LCS.getISBDiv('angle-double-left', 2 , 'centered gray')+'</a></div>' +
                    $ctrl.expandableSections.getExpandableContent($ctrl.Sections, getExpandableItem) +
                '</div>' +
            '</div>' +
        '</div>';

        function getExpandableItem(el) {
            if (el.type === 1) {
                var props = $ctrl[el.name],
                    l = props.length,
                    t = '';
                _.each(props, function (item, i) {
                    t += '<div class="field position-relative table-div full-width ' + ((l - 1 === i) ? '' : 'margin-bottom-half') + '">' +
                        '<div class="centered"><span class="semibold">' + item.text + '</span></div>' +
                        '<div class="col80 centered"><a class="pull-right display-block with-cursor openPopup btn btn-small primary-faded without-text full-width" data-popup="' + item.popup + '">' + item.action + '</a></div>' +
                        '</div>';
                });
                return t;
            } else if (el.type === 2) {
                return getComp(el.comp);
            }
        }

        function getComp(name){
            return '<' + name + ' pre-loading-service="::$ctrl.preLoadingService"></' + name + '>';
        }
    }

    function openPopup(e) {
        var popup = e.currentTarget.getAttribute('data-popup');
        if (!popup) {
            return;
        }

        var data = find($ctrl.Settings) || find($ctrl.Templates);
        if (!data) {
            return;
        }

        if(popup === 'createCallsheetTemplate' || popup === 'changeCallsheetTemplate'){
            $ctrl.CPS.loadQuotaPopup('callsheetTemplates', process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});
        }else{
            process();
        }
        function process() {
            var options = getOptions(data.popup);
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations[popup], options, $ctrl.compOptions, null, options ? options.onSuccessPopup : null);
        }
        function find(list) {
            return _.find(list, function (item) {
                return item.popup === popup;
            });
        }
    }

    function getOptions(popup) {
        var callsheet = angular.copy($ctrl.CurrentProduct.getCallsheet());
        switch (popup) {
            case 'createCallsheetTemplate':
                $ctrl.options = callsheet.options;
                var logos = {}, exists;
                _.each(['productionLogo', 'productionLogoId', 'logo', 'logoId', 'commentsCount'], function (prop){
                    if(callsheet[prop]){
                        logos[prop] = callsheet[prop]; exists = true;
                    }
                });

                if(exists){$ctrl.options.logos = logos;}
                return {
                    options: $ctrl.options,
                    companyId: $ctrl.CPS.companyId,
                    parentId: callsheet.templateId
                };

            case 'changeCallsheetTemplate':
                return {
                    change: true
                };

            case 'callsheetType':
                return {
                    productId: $ctrl.CPS.productId
                };

            case 'projectSettings' :
                return {
                    isEditCallsheet: callsheet._id,
                };

            case 'departmentSettings':
                return {
                    onSuccessPopup: function (){
                        console.log('onClose departmentSettings');
                        var elemType = 'RECIPIENT';
                        $ctrl.LCS.timeout(function (){
                            $ctrl.broadcastRoot( 'LOAD_GROUP' +'_' + elemType + '_' + 2 + '_'+  callsheet._id, {
                                updatePreloadSettings: true,
                                forceReload: true
                            });
                        }, 200);
                    }
                };
        }
    }

    function onTitleChanged(options) {
        if(options){
            $ctrl.openId = null;
        }
    }
}


angular.module('product.callsheet.edit.styles.component', [
    'apiConstants.callsheet.services'
])
.component('callsheetSidebarStyles', {
    bindings: {
        preLoadingService: '<',
    },
    controller: 'CallsheetStylesController',
})
.controller('CallsheetStylesController', CallsheetStylesController);
CallsheetStylesController.$inject = ['ListItemTemplateFormCtrlService', 'CallsheetConstantsService', 'CallsheetsService', 'SBFieldMethods', '$element'];
function CallsheetStylesController(ListItemTemplateFormCtrlService, CallsheetConstantsService, service, SBFieldMethods, $element) {
    console.log('CallsheetStylesController');
    var $ctrl = this ;
    $ctrl.dontShowActivity= true;
    $ctrl.ColorSettings = [
        {id: 'headerColor', prop: 'headerColor', text:'Header Text'},
        {id: 'headerLine', prop: 'headerLine', text:'Header Line'},
       // {id: 'borderColor', prop: 'borderColor', text:'Grid Lines'}
       // {id: 'depBg', prop: 'depBg', text:'Department Background Color',tooltip:'This is Background color'}
    ];

    $ctrl.dontAutoloadTemplate = false;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitOther = preInitOther;
    $ctrl.postInitOther = postInitOther;
    $ctrl.onDestroy = onDestroy;
    $ctrl.toggleBorders = toggleBorders;
    $ctrl.hasBorders = hasBorders;

    $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

    //open warning popup first
    function preInitOther() {
        if (!$ctrl.preLoadingService) {
            console.log('Must define preLoadingService');
        }

        if(!$ctrl.extraParam) {
            $ctrl.extraParam = {};
        }
        $ctrl.extraParam.service = service;
        $ctrl.CallsheetsService = service;

        $ctrl.CallsheetConstantsService = angular.copy(CallsheetConstantsService);

        $ctrl.preLoadingTableName = 'Callsheets';
        $ctrl.optionsProp = 'styles';

        $ctrl.Colors = SBFieldMethods.Colors;
        $ctrl.Borders = $ctrl.CallsheetConstantsService.BorderOptions;
        $ctrl.withUncheck = true;
        $ctrl.setStyleProp = setStyleProp;

        $ctrl.onChangeOther = onChangeOther;
        $ctrl.callsheet = angular.copy($ctrl.CurrentProduct.getCallsheet());
        $ctrl.callsheetId = $ctrl.callsheet._id;
        preset($ctrl.callsheet.options);
    }

    function postInitOther() {
        $ctrl.addRootWatcher('CALLSHEET_TEMPLATE_CHANGED', onTemplateChanged);
    }

    function getForm() {
        var columns = [{

        }];

        _.each($ctrl.ColorSettings, function (item) {
            columns.push({

            });
        });

        return $ctrl.SBFieldTypesService.getPopupSBForm($ctrl, columns, {
            onChangeOther: $ctrl.onChangeOther
        });
    }

    function onChangeOther() {

    }

    function getItemTemplate() {
        var isSwitch = true,
            t = '<div class="field spacing-half-bottom position-relative position-relative table-div full-width" ng-click="$ctrl.toggleBorders($event)">' +
                    '<div class="centered">' +
                        '<span class="semibold">Vertical Borders</span>' +
                    '</div>' +
                    '<div class="centered col80">' +
                        '<div class="pull-right custom-checkbox ' +  (isSwitch ? ' switch display-block' :' inrow centered') + '">' +
                            '<label' + (isSwitch ? ' class="i-switch radiobtn"' : '') + '>' +
                                '<input type="checkbox" ng-checked="$ctrl.hasBorders()" ' + '>' +
                                (isSwitch ? ('<i></i>') : ('<span></span>')) +
                            '</label>' +
                        '</div>' +
                    '</div>' +

                  /*  '<sb-dropdown ' +
            'without-close="true" ' +
            'c-class-attr="with-underline" ' +
            'field-class="selected-text centering text-left" ' +
            'init-list="::$ctrl.Borders" ' +
            'value="::$ctrl.options.borders" ' +
            'item-label="text" ' +
            'item-value="id" ' +
            'on-change="$ctrl.setStyleProp(\'borders\', result)" ' +
            'parent-container="true"' +
            '></sb-dropdown>' +*/

                 //   '<a class="btnResetBorders small with-margin-left"><span class="text-center sbf centered reset"></span></a>' +
                '</div>';
        var l = $ctrl.ColorSettings.length;
        _.each($ctrl.ColorSettings, function (item, i) {
            t+= '<div class="field position-relative table-div full-width '+(l-1===i?'':'margin-bottom-half')+'">' +
                    '<div class="col120 centered" ' +
                (item.tooltip?('tooltip="'+item.tooltip+'" tooltip-placement="bottom"'):'') +
                    '>' +
                        '<span class="semibold">' + item.text + '</span>' +
                        //'<span class="sbf info-circle-empty hide-print with-margin-left"></span>' +
                    '</div>' +
                    '<div>' +
                        '<sb-color-dropdown class="pull-right" ' +
                        'element-id="' + $ctrl.item._id + '_'+item.prop+'" ' +
                        'without-close="true" ' +
                        'init-list="::$ctrl.Colors" ' +
                        'value="::$ctrl.options.'+item.id+'" ' +
                        'with-uncheck="::'+$ctrl.withUncheck+'" ' +
                        'on-change="$ctrl.setStyleProp(\''+item.prop+'\', result)" ' +
                        'parent-container="true"></sb-color-dropdown>'+
                    '</div>'+
                '</div>';
        });
        return t;
    }

    function hasBorders(){
        return $ctrl.options.borders === $ctrl.Borders[0].id;
    }

    function toggleBorders(e){
        if(e){
            e.stopPropagation();
            e.preventDefault();
        }
        console.log('toggleBorders');
        setStyleProp1('borders', $ctrl.options.borders === $ctrl.Borders[1].id ? $ctrl.Borders[0].id : $ctrl.Borders[1].id);
    }

    function setStyleProp(prop, result) {
        setStyleProp1(prop, result.selected.val);
    }

    function setStyleProp1(prop, value) {
        if ($ctrl.isUpdating) {return;}
        $ctrl.isUpdating = true;
        var info = $ctrl.CurrentProduct.setCallsheetInfo({
            dontShowActivity: $ctrl.dontShowActivity
        }, prop, value, null);
        $ctrl.CurrentProduct.updateCallsheetInfo($ctrl, info, function(result) {
            //$ctrl.preLoadingService.updateItem($ctrl.preLoadingTableName params);
            $ctrl.broadcastRoot('CALLSHEET_STYLE_CHANGED', info[null]);
        }, 'callsheetStyle');
    }

    function preset(options) {
        $ctrl.options = options[$ctrl.optionsProp];
        if(!$ctrl.options){$ctrl.options = {};}
        if ($ctrl.options.borders === undefined) {
            $ctrl.options.borders = 0;
        }
    }

    function onTemplateChanged(options) {
        console.log('layout.onTemplateChanged');
        preset(options);
        $ctrl.reloadTemplate();
    }

    function onDestroy() {
        if($ctrl.sortableService){
            $ctrl.sortableService.destroy();
        }
    }
}

angular.module('product.callsheet.edit.topSection.component', [
    'product.callsheet.edit.layout.service'
])
.component('callsheetSidebarTop', {
    bindings: {
        preLoadingService: '<',
    },
    controller: 'CallsheetSidebarTopController',
})
.controller('CallsheetSidebarTopController', CallsheetSidebarTopController);
CallsheetSidebarTopController.$inject = ['CallsheetLayoutServiceController', '$element'];
function CallsheetSidebarTopController(CallsheetLayoutServiceController, $element) {
    console.log('CallsheetSidebarTopSectionController');

    var $ctrl = this;
    $ctrl.optionsProp = 'top';
    $ctrl = new CallsheetLayoutServiceController($ctrl, $element);
}


