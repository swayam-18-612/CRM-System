angular.module('product.script.sides.popup.component', [
])
.component('scriptSidesPopup', popupComponentParams('ScriptSidesPopupCtrl'))
.controller('ScriptSidesPopupCtrl', ScriptSidesPopupCtrl);
ScriptSidesPopupCtrl.$inject = ['ListItemPopupTemplateCtrlService', '$element'];
function ScriptSidesPopupCtrl(ListItemPopupTemplateCtrlService, $element) {
    var $ctrl = this;

    $ctrl.getItemPopupTemplate = getItemPopupTemplate;
    $ctrl.preInitOther = preInitOther;
    $ctrl.toggleTagging = toggleTagging;

    $ctrl = new ListItemPopupTemplateCtrlService($ctrl, $element);

    function preInitOther() {
        if(!$ctrl.extraParam){$ctrl.extraParam = {};}
        $ctrl.strips = $ctrl.extraParam.strips && $ctrl.extraParam.strips.length>0 ?  $ctrl.extraParam.strips : ($ctrl.item ? [$ctrl.item] : null);
        $ctrl.hasStrips = $ctrl.strips.length > 0;
        $ctrl.scriptLoadingService = $ctrl.extraParam.scriptLoadingService;
        $ctrl.scriptSides = {withTagging: false, showTagging: true, loadTags: false};
        stringify();
    }

    function toggleTagging() {
        $ctrl.scriptSides.showTagging = !$ctrl.scriptSides.showTagging;
        stringify();
    }

    function stringify() {
        $ctrl.scriptSidesJson = JSON.stringify($ctrl.scriptSides);
    }

    function getItemPopupTemplate(){
        if(!$ctrl.strips){
            return 'There are no scenes to preview';
        }
        return '<div class="hide-print">' +
            '<a class="btn btn-small primary-faded without-text sbf with-margin-left" ng-class="{false:\'cal-expand\',true:\'cal-collapse\'}[$ctrl.scriptSides.showTagging==true]" ng-click="$ctrl.toggleTagging()" analytics-on analytics-action="($ctrl.scriptSides.showTagging ? \'Hide\':\'Show\')+ \' Tags\'" tooltip="{{$ctrl.scriptSides.showTagging ? \'Hide\':\'Show\'}} Tags" tooltip-placement="bottom"></a>' +
            '<print-button ng-disabled="!$ctrl.hasStrips" ng-class="$ctrl.hasStrips ? \'\':\'disabled\'" show-title="false" btn-class="btn btn-small primary-faded without-text transparent with-margin-left hide-lower1024" default-print="$ctrl.defaultPrint"></print-button>' +
        '</div>' +
        '<div class="with-min-height spacing" style="background-color : white; min-height:600px">' +
            '<script-sides ' +
                'script-sides-json="$ctrl.scriptSidesJson" ' +
                'strips="::$ctrl.strips" ' +
                'script-loading-service="::$ctrl.scriptLoadingService"' +
            '></script-sides>' +
        '</div>' +
    '<breakdown-sidebar ' +
        'class="breakdown-sidebar clearfix hide-print h-full side-nav static long mini-strips" ' +
        'tagging-scenes="$ctrl.taggingScenes" ' +
        'categories="::$ctrl.categories" ' +
        'count="$ctrl.count" ' +
    '></breakdown-sidebar>';
    }
}

