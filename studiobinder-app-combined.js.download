angular.module('product.schedulingPage.service', [
    'apiServices.StripSchedules',
    'apiServices.SchedulesLists',
    'apiServices.SchedulesListOptions',
    'apiConstants.scheduling.services',
    'product.scheduling.group.component',
    'product.breakdowns.page.init.service.component',
    'product.scheduling.item.process.component',
    'page.tree.simple.controller.service.injector'
])
.constant('SchedulingPageCtrlServiceInjectors', {
    pageCtrlService: 'BreakdownsPageInitServiceCtrl',
    constantsService: 'SchedulingConstantsService',
    listOptionsService: 'SchedulesListOptionsService',
    listsService: 'SchedulesListsService',
    service: 'StripSchedulesService'
})
.service('SchedulingPageCtrlService', SchedulingPageCtrlService);
SchedulingPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'SchedulingPageCtrlServiceInjectors'];
function SchedulingPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    return function ($ctrl, $element, printPageParams) {
        $ctrl.isScheduling = true;
        $ctrl.StripTypes = {Scene: 1, DayBreak: 0, Banner: 2};

        $ctrl.getLeftButtons = getLeftButtons;
        $ctrl.getStripsCount = getStripsCount;
        $ctrl.getGroupFilters = getGroupFilters;
        $ctrl.checkShowAddNewItem = checkShowAddNewItem;

        $ctrl.canMergeMulti = canMergeMulti;
        $ctrl.canMoveMulti = canMoveMulti;
        $ctrl.canCopyMulti = canCopyMulti;
        $ctrl.canRemoveMulti = canRemoveMulti;
        $ctrl.canArchiveMulti = canArchiveMulti;

        $ctrl.getPrintListsInfo = getPrintListsInfo;
        $ctrl.getCollabBannerInfo = getCollabBannerInfo;

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);

        return $ctrl;

        function getCollabBannerInfo(){
            return {txt: 'Create and share your own shooting schedules for free.', campaign:'collab-stripboard'};
        }

        function canArchiveMulti(){
            return true;
        }

        function canRemoveMulti(){
            return false;
        }

        function canMergeMulti() {
            return false;
        }

        function canCopyMulti(){
            return false;
        }

        function canMoveMulti(){
            return false;
        }

        function getPrintListsInfo(){
            return {

            };
        }

        function getGroupFilters(isDisplay) {
            return isDisplay ? {type: $ctrl.StripTypes.Scene} : null;
        }

        function getLeftButtons() {
            return '';
            //todo bring back counters
            return '<div ng-if="$ctrl.listTreeService.active.selectedList.count>0" class="left-separator hide-ipad text-info-count with-line-height pull-left">' +
                '<span tooltip-placement="bottom" tooltip="{{$ctrl.filtersService.selectedFilter==true?\'Number of existing scenes in this stripboard.\':\'\'}}"><span ng-bind="$ctrl.getStripsCount($ctrl.StripTypes.Scene)"></span> Scene<span ng-bind="$ctrl.getStripsCount($ctrl.StripTypes.Scene) !== 1 ? \'s\' : \'\'"></span></span>' +
                '<span class="hide-lower1024" ng-show="$ctrl.filtersService.selectedFilter==true"> <span class="dot">•</span> <span tooltip-placement="bottom" tooltip="Day breaks mark the end of a shoot day. You can spin-off call sheets from day breaks."><span ng-bind="$ctrl.getStripsCount($ctrl.StripTypes.DayBreak)"></span> Day Break<span ng-bind="$ctrl.getStripsCount($ctrl.StripTypes.DayBreak)  !== 1 ? \'s\' : \'\'"></span></span> <span class="dot">•</span> ' +
                '<span class="hide-lower1024" tooltip-placement="bottom" tooltip="Banners are stripboard notes (e.g. Meal Break, Company Move, etc)."><span ng-bind="$ctrl.getStripsCount($ctrl.StripTypes.Banner)"></span> Banner<span ng-bind="$ctrl.getStripsCount($ctrl.StripTypes.Banner)!== 1 ? \'s\' : \'\'"></span></span></span>' +
                '</div>';
        }

        function checkShowAddNewItem() {
            return false;
        }

        function getStripsCount(type) {
            if(!$ctrl.listTreeService){return 0;}
            var list = $ctrl.listTreeService.getActiveList() ;//? _.filter($ctrl.list.items, {type: type}).length : 0;

            if(!list || !list.length){return 0;}
            if (type === undefined || type === null) {
                type = 1;
            }
            return _.filter(list, function (item) {
                return item.type === type;
            }).length;
        }
    }
}


angular.module('product.scheduling.item.autobreak.component', [
'product.breakdowns.item.process.controller.service'
])
.component('autoBreakPopup', popupComponentParams('AutoBreakPopupCtrl'))
.controller('AutoBreakPopupCtrl', AutoBreakPopupCtrl);
AutoBreakPopupCtrl.$inject = ['ProcessBreakdownsPopupCtrlService', '$element'];
function AutoBreakPopupCtrl(ProcessBreakdownsPopupCtrlService, $element) {
    var $ctrl = this;

    $ctrl.preInitGeneralOther = preInitGeneralOther;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.preSetTemplateDataOther = preSetTemplateDataOther;

    $ctrl = new ProcessBreakdownsPopupCtrlService($ctrl, $element);

    function preSetTemplateDataOther() {
        $ctrl.icon = 'daybreak';
        $ctrl.iconLevel = 3;
        $ctrl.popupTitle = 'Add Day Breaks';
        $ctrl.subdesc = 'Insert multiple day breaks and adjust as needed';
        $ctrl.firstBtnMethod = 'autoBreaks';
        $ctrl.btnText = '<span>Add</span><span class="hide-ipad"> day breaks</span>';
    }

    function preInitGeneralOther() {
        $ctrl.initStartDate();
    }

    function getPopupBodyContent() {
        return '<div class="spacing-quarter-top semibold margin-bottom-half"> Add a day break every:</div>' +
            $ctrl.getAutoBreaksDiv(0) +
            $ctrl.getStartDateBlock('centered');
    }
}

angular.module('product.scheduling.item.sort.component', [
    'product.breakdowns.item.process.controller.service'
])
.component('autoSortPopup', popupComponentParams('AutoSortPopupCtrl'))
.controller('AutoSortPopupCtrl', AutoSortPopupCtrl);
AutoSortPopupCtrl.$inject = ['ProcessBreakdownsPopupCtrlService', '$element'];
function AutoSortPopupCtrl(ProcessBreakdownsPopupCtrlService, $element) {
    var $ctrl = this;

    $ctrl.preInitGeneralOther = preInitGeneralOther;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.preSetTemplateDataOther = preSetTemplateDataOther;

    $ctrl = new ProcessBreakdownsPopupCtrlService($ctrl, $element);

    function preSetTemplateDataOther() {
        $ctrl.icon = 'sort-strips';
        $ctrl.iconLevel = 4;
        $ctrl.subdesc = 'Existing day breaks will be removed';
        $ctrl.firstBtnMethod = 'sortStrips';
        $ctrl.btnText = 'Reorder<span class="hide-ipad"> Stripboard</span>';
        $ctrl.textAnalytics = $ctrl.removeHtmlTags($ctrl.btnText);
        $ctrl.popupTitle = $ctrl.textAnalytics;
    }

    function preInitGeneralOther() {
        var drp = {
            fieldClass: 'col60 form-control with-underline centering inline-block full-width ',
            canEdit: true,
            type: $ctrl.SBFieldTypesService.PropTypes.Drp,
            parentContainer: true,
            itemLabel: 'text',
            itemValue: 'id',
            initListName: 'SortingTypes',
        };

        $ctrl.columnsList = [
            _.extend({
                prop: 't1',
                order: 1,
                tabIndex: 1,
                tabNextIndex: 2,
            }, drp),
            _.extend({
                prop: 't2',
                order: 2,
                tabIndex: 2,
                tabNextIndex: 3,
            }, drp),
            _.extend({
                prop: 't3',
                order: 3,
                tabIndex: 3,
                tabNextIndex: 4,
            }, drp)
        ].concat($ctrl.columnsList);

        $ctrl.initStartDate();
    }

    function getPopupBodyContent() {
        var i = 0;
       return add(i++, '1st Sort') +
              add(i++, '2nd Sort') +
              add(i++, '3rd Sort') +
             '<div class="form-group field col220 margin-top-half" ng-class="{\'last\':!$ctrl.item.autobreaks}">' +
                '<div class="custom-checkbox small with-label font14 '+$ctrl.pageClass+'"><label >' +
                    '<input type="checkbox" ng-checked="$ctrl.item.autobreaks" ng-click="$ctrl.item.autobreaks = !$ctrl.item.autobreaks">' +
                    '<span class="semibold"><span>&nbsp; Add day breaks <span ng-show="$ctrl.item.autobreaks">every: </span><span></span>' +
                '</label></div>' +
            '</div>' +
            '<div ng-show="$ctrl.item.autobreaks">' + $ctrl.getAutoBreaksDiv(i++) + '</div>' +
            $ctrl.getStartDateBlock('', 'ng-show="$ctrl.item.autobreaks"') ;

      function add(index, txt){
      return '<div class="field position-relative table-div full-width">' +
                  '<div class="semibold centered spacing-half-bottom">'+txt+':</div>' +
                  '<div class="  padding-left-20 col240 centered">' +
                  $ctrl.getPopupFormForSelectedCol($ctrl.columnsList[index]) +
                  '</div>' +
              '</div>';
      }
    }
}

