angular.module('product.preLoading.team.group.service', [
    'product.preLoading.init.group.service',
    'product.preLoading.team.service',
    'product.preLoading.teamLists.service',
    'product.preLoading.products.service'
])
 .service('TeamGroupLoadingService', TeamGroupLoadingService);
TeamGroupLoadingService.$inject = ['InitGroupLoadingService', 'TeamLoadingService', 'TeamListsLoadingService', 'ProductsLoadingService'];
function TeamGroupLoadingService(InitGroupLoadingService, Team, TeamLists, Products) {
    var Tbl = {}, TblTypes = {};

    _.each([TeamLists, Team], function (table){
        var name = table.name;
        TblTypes[name] = table.tableType;
        Tbl[TblTypes[name]] = {loadingService: table};
    });

    return new InitGroupLoadingService(Tbl, 'isInitTeam', {
        parent: TblTypes.TeamLists,
        child: TblTypes.Team,
    }, TblTypes);

 /* todo
get it to work with products
    _.each([TeamLists, Team, Products], function (table) {
        var name = table.name;
        var withoutLoad = false;// = name === 'Products';
        TblTypes[name] = table.tableType;
        Tbl[TblTypes[name]] = {loadingService: table, withoutLoad: withoutLoad};
    });

    var Resource = new InitGroupLoadingService(Tbl, 'isInitTeam', {
        parent: TblTypes.TeamLists,
        child: TblTypes.Team,
    }, TblTypes);

    Resource.prototype.load = function(next, otherParams) {
        var _this = this;
        async.parallel([
            function (c){
                _this.preloadTables(c) ;
            },
            function (c){
                _this.loadAndInitTable(_this.TblTypes.Products, null, null, c, 'getAll');

            }
        ], next);
    };

    Resource.prototype.loadProducts = function (next) {
        var _this = this;
        if (!Resource.isProductsLoaded && !Resource.isProductsLoading) {
            Resource.isProductsLoading = true;
            _this.loadAndInitTable(_this.TblTypes.Products, null, null, c, 'getAll');
        } else {
            next1();
        }

        function c() {
            Resource.isProductsLoaded = true;
            Resource.isProductsLoading = false;
            return next1();
        }

        function next1() {
            next(_this.getObjectList(_this.TblTypes.Products, function (item) {
                return item.active === true;
            }));
        }
    };
    return Resource;

 */
}

angular.module('product.preLoading.todoCards.group.service', [
    'product.preLoading.init.group.service',
    'product.preLoading.todoCards.service',
    'product.preLoading.todoColumns.service',
    'product.preLoading.todoPages.service'
])
.service('TodoCardsGroupLoadingService', TodoCardsGroupLoadingService);
TodoCardsGroupLoadingService.$inject = ['InitGroupLoadingService', 'TodoColumnsLoadingService', 'TodoPagesLoadingService', 'TodoCardsLoadingService'];
function TodoCardsGroupLoadingService(InitGroupLoadingService, TodoColumns, TodoPages, TodoCards) {

    var type = 1;//workflow type is 1

    var Tbl = {}, TblTypes = {};

    TblTypes.TodoColumns = TodoColumns.tableType;
    Tbl[TblTypes.TodoColumns] = {
        loadingService: TodoColumns,
        tableParamsColsInit: ['companyId', 'productId', 'type']
    };

    TblTypes.TodoCards = TodoCards.tableType;
    Tbl[TblTypes.TodoCards] = {loadingService: TodoCards};

    TblTypes.TodoPages = TodoPages.tableType;
    Tbl[TblTypes.TodoPages] = {loadingService: TodoPages};

    var Resource = new InitGroupLoadingService(Tbl, 'isInitTodoCards', null, TblTypes);

    Resource.prototype.load = function (next, otherParams) {
        var _this = this,
            m = 'getAll',
            tasks = {};

        add('TodoColumns', m, function (params) {
            if(!params.type){
                params.type = type;
            }
            return params;
        });

        add('TodoCards', m,function (params) {
            params.type = type;
            return params;
        });

        add('TodoPages', 'getAllForPreloading');

        async.parallel(tasks, function (err, res) {
            next();
        });

        function add(table, m, processParams, pageSize, populate){
            tasks[table] = function (c) {
                _this.loadAndInitTable(_this.TblTypes[table], pageSize, populate, c, m, processParams);
            };
        }
    };

    return Resource;
}

angular.module('product.preLoading.todoCardsBoards.group.service', [
    'product.preLoading.init.group.service',
    'product.preLoading.todoCards.service',
    'product.preLoading.todoColumns.service'
])
.service('TodoCardsBoardsGroupLoadingService', TodoCardsBoardsGroupLoadingService);
TodoCardsBoardsGroupLoadingService.$inject = ['InitGroupLoadingService', 'TodoColumnsLoadingService', 'TodoCardsLoadingService'];
function TodoCardsBoardsGroupLoadingService(InitGroupLoadingService, TodoColumns, TodoCards) {

    var Tbl = {}, TblTypes = {},
        tableParamsColsInit = ['companyId', 'taskBoardId', 'type'];

    TblTypes.TodoColumns = TodoColumns.tableType;
    Tbl[TblTypes.TodoColumns] = {
        loadingService: TodoColumns,
        //withoutLoad: true,
        tableParamsColsInit: tableParamsColsInit
    };

    TblTypes.TodoCards = TodoCards.tableType;
    Tbl[TblTypes.TodoCards] = {
        loadingService: TodoCards,
        //withoutLoad: true,
        tableParamsColsInit: tableParamsColsInit
    };

    var Resource = new InitGroupLoadingService(Tbl, 'isInitTodoCardsBoards', {
            parent: TblTypes.TodoColumns,
            child: TblTypes.TodoCards,
        }, TblTypes);

    Resource.prototype.load = function (next, otherParams) {
        var _this = this,
            tasks = {};

        //type for todocolumn is 4 for taskboards
        add('TodoColumns', 4);
        add('TodoCards', 1);

        async.parallel(tasks, function (err, res) {
            next();
        });

        function add(table, type, pageSize, populate) {
            tasks[table] = function (c) {
                _this.loadAndInitTable(_this.TblTypes[table], pageSize, populate, c, 'getAll', processParams);

                function processParams(params) {
                    params.type = type;
                    return _.extend({}, params, otherParams);
                }
            };
        }
    };

    return Resource;
}

angular.module('product.preLoading.todoCardsScript.group.service', [
    'product.preLoading.init.group.service',
    'product.preLoading.todoCards.service',
    'product.preLoading.todoColumns.service'
])
.service('TodoCardsScriptGroupLoadingService', TodoCardsScriptGroupLoadingService);
TodoCardsScriptGroupLoadingService.$inject = ['InitGroupLoadingService', 'TodoColumnsLoadingService', 'TodoCardsLoadingService'];
function TodoCardsScriptGroupLoadingService(InitGroupLoadingService, TodoColumns, TodoCards) {

    var Tbl = {}, TblTypes = {};

    TblTypes.TodoColumns = TodoColumns.tableType;
    Tbl[TblTypes.TodoColumns] = {
        loadingService: TodoColumns,
        withoutLoad: true,
        tableParamsColsInit: ['companyId', 'productId', 'type', 'uId']
    };

    TblTypes.TodoCards = TodoCards.tableType;
    Tbl[TblTypes.TodoCards] = {
        loadingService: TodoCards,
        withoutLoad: true
    };

    var type = 3;
    var Resource = new InitGroupLoadingService(Tbl, 'isInitTodoCardsScript', {
        parent: TblTypes.TodoColumns,
        child: TblTypes.TodoCards,
    }, TblTypes);

    Resource.prototype.load = function (next, otherParams) {
        var _this = this,
            m = 'getColumnsForScript',
            tasks = {};

        add('TodoColumns', m, function (params) {
            if (!params.type) {
                params.type = type;
            }
            return params;
        });

        add('TodoCards', 'getAll',function (params) {
            delete params.type;
            if(otherParams){delete params.uId;}
            return _.extend({}, params, otherParams ? otherParams : {type: type});
        });

        async.parallel(tasks, function (err, res) {
            next();
        });

        function add(table, m, processParams, pageSize, populate){
            tasks[table] = function (c) {
                _this.loadAndInitTable(_this.TblTypes[table], pageSize, populate, c, m, processParams);
            };
        }
    };

    return Resource;
}

angular.module('product.preLoading.todoCardsSidebar.group.service', [
    'product.preLoading.init.group.service',
    'product.preLoading.todoCards.service',
    'product.preLoading.todoColumns.service',
    'product.preLoading.todoPages.service'
])
.service('TodoCardsSidebarGroupLoadingService', TodoCardsSidebarGroupLoadingService);
TodoCardsSidebarGroupLoadingService.$inject = ['InitGroupLoadingService', 'TodoColumnsLoadingService', 'TodoPagesLoadingService', 'TodoCardsLoadingService'];
function TodoCardsSidebarGroupLoadingService(InitGroupLoadingService, TodoColumns, TodoPages, TodoCards) {

    var type = 1;

    var pageSize = null;
    var Tbl = {}, TblTypes = {};

    TblTypes.TodoColumns = TodoColumns.tableType;
    Tbl[TblTypes.TodoColumns] = {
        loadingService: TodoColumns,
        tableParamsColsInit: ['companyId', 'productId', 'type']
    };

    TblTypes.TodoCards = TodoCards.tableType;
    Tbl[TblTypes.TodoCards] = {loadingService: TodoCards};

    TblTypes.TodoPages = TodoPages.tableType;
    Tbl[TblTypes.TodoPages] = {loadingService: TodoPages};

    var Resource = new InitGroupLoadingService(Tbl, 'isInitTodoCardsSidebar', null, TblTypes);

    Resource.prototype.load = function (next, otherParams) {
        var _this = this,
            m = 'getAll',
            tasks = {};

        add('TodoColumns', m, function (params) {
            params.type = type;
            return params;
        });

        add('TodoCards', m,function (params) {
            if(params.type === 2){//iscalendar
                var  p = _.extend({}, params, {calendarId: params.uId, onlyArchived: true});
                delete p.uId;
                return p;
            }
            return _.extend({}, params, otherParams ? otherParams : (params.calendarId ? null :{
                type: type
            }));
        }, pageSize, 'createdById');

        add('TodoPages', 'getAllForPreloading');

        async.parallel(tasks, function (err, res) {
            next();
        });

        function add(table, m, processParams, pageSize, populate){
            tasks[table] = function (c) {
                _this.loadAndInitTable(_this.TblTypes[table], pageSize, populate, c, m, processParams);
            };
        }
    };

    return Resource;
}

angular.module('product.preLoading.widgets.group.service', [
    'product.preLoading.init.group.service',
    'product.preLoading.dashboards.service'
])
 .service('WidgetsGroupLoadingService', WidgetsGroupLoadingService);
WidgetsGroupLoadingService.$inject = ['InitGroupLoadingService', 'DashboardsLoadingService'];
function WidgetsGroupLoadingService(InitGroupLoadingService, Dashboards) {
    var Tbl = {}, TblTypes = {},
        pageSize = 100,
        param = 'teamId',
        tableParamsColsInit = ['companyId', param];
    var tables = [
        {t: Dashboards, withoutLoad: false},

    ];

    _.each(tables, function (t) {
        var table = t.t,
            name = table.name;
        TblTypes[name] = table.tableType;
        Tbl[TblTypes[name]] = {
            loadingService: table,
            tableParamsColsInit: getTableParams(t.otherParams),
             withoutLoad: t.withoutLoad
        };
    });

    var Resource = new InitGroupLoadingService(Tbl, 'isInitDashboard', null, TblTypes);

    Resource.prototype.load = function (next, otherParams) {
        var _this = this,
            tasks = {};

        _.each(tables, function (t) {
            if(!t.withoutLoad) {
                add(t.t.name, t.m || 'getAll', t.processParams, t.pageSize, t.populate);
            }
        });

        async.parallel(tasks, function (err, res) {
            next();
        });

        function add(table, m, processParams, pageSize, populate) {
            tasks[table] = function (c) {
                _this.loadAndInitTable(_this.TblTypes[table], pageSize, populate, c, m, processParams, true);
            };
        }
    };

    Resource.prototype.loadTable = function (table, next, groupFilterM) {
        var _this = this,
            loaded = 'is' + table + 'Loaded',
            loading = 'is' + table + 'Loading';
        if (!Resource[loaded] && !Resource[loading]) {
            Resource[loading] = true;
            tasks[table](c);
        } else {
            next1();
        }

        function c() {
            Resource[loading] = false;
            Resource[loaded] = true;
            return next1();
        }

        function next1() {
            next(_this.getObjectList(_this.TblTypes[table], groupFilterM));
        }
    };

    return Resource;

    function getTableParams(other){
        return (other || []).concat(tableParamsColsInit);
    }
}

angular.module('services.blocksSetup', [
    'services.layoutConfigsService',
    'services.blocksSetupEvents',
    'services.stateService'
])
.service('BlocksSetupService', BlocksSetupService);

BlocksSetupService.$inject = ['LCS', 'SBStateService'];
function BlocksSetupService(LCS, SBStateService) {
    var _this = this;
    _this.LCS = LCS;
    _this.SBStateService = SBStateService;
    _this.isLoaded = false;
    _this.customOverviewBlocks = null;
    _this.overviewBlocks = null;
    _this.todoPages = null;

    _this.init = init;

    _this.getCurrentTodoPage = getCurrentTodoPage;
    _this.getTodoPage = getTodoPage;

    _this.todoPageHasShare = todoPageHasShare;
    _this.getTodoPageById = getTodoPageById;
    _this.getTodoPageByName = getTodoPageByName;
    _this.getChildPage = getChildPage;
    _this.hasProductSidebarChanged = hasProductSidebarChanged;
    _this.getBlockByType = getBlockByType;
    _this.getProductSidebarBlocks = getProductSidebarBlocks;
    _this.getParentBlocks = getParentBlocks;
    _this.getNonParentBlocks = getNonParentBlocks;
    _this.getOverviewBlocksDataInfo = getOverviewBlocksDataInfo;

    return _this;

    function getOverviewBlocksDataInfo(){
        var info = _this.LCS.API_CONFIGS.site;
        return getOverviewBlocksData({
            showScriptOutline: info ? (info.showScriptOutline === true) : false,
           // showAVScripts: info ? (info.showAVScripts === true) : false
        });
    }

    function getNonParentBlocks(ob, isList) {
        return getBlocks(ob, isList, false);
    }

    function getParentBlocks(ob, isList) {
        return getBlocks(ob, isList, true);
    }

    function getBlocks(ob, isList, isParent){
        if(!ob){
            ob = _this.overviewBlocks;
        }
        var l = isList ?  [] : {};
        for (var id in ob) {
            var item = ob[id];
            if (cond(item)) {
                if(isList){
                    l.push(item);
                }else {
                    l[id] = item;
                }
            }
        }

        return  isList ? _.sortBy(l, 'order') : l;

        function cond(item){
            return isParent ? (item.isParent && item.mainNav  === true) : (item.parentNavId != null);
        }
    }

    function init() {
        setOverviewBlocks();
        setTodoPages();

        _this.isLoaded = true;

        function setOverviewBlocks() {
            var result = _this.getOverviewBlocksDataInfo();
            var ob = {}, cob = {}, ol = 0, col = 0;
            if (result && result.length > 0) {
                for (var i = 0; i < result.length; i++) {
                    var r = result [i];
                    (r.isCustom ? cob : ob)[r._id] = r;
                    if (r.isCustom) {
                        col += 1;
                    } else {
                        ol += 1;
                    }
                }
            }
            var val = (col > 0 || ol > 0) ? {} : null;
            if (val) {
                if (ol > 0) {
                    _this.overviewBlocks = ob;
                }
                if (col > 0) {
                    _this.customOverviewBlocks = cob;
                }
            }

            return val;
        }

        function setTodoPages() {
            var result = getTodoPagesData(),
                val;
            for (var i = 0; i < result.length; i++) {
                var r = result [i];
                if
                (!val) {
                    val = {};
                }
                val[r.name] = r;
            }

            _this.todoPages = val;
        }

    }

    function getCurrentTodoPage(stateName) {
        return _this.getTodoPage(stateName ? stateName : _this.SBStateService.getCurrentStateName());
    }

    function getTodoPage(name) {
        return _this.todoPages ? _this.todoPages[name] : null;
    }

    function todoPageHasShare(stateName) {
        var page = _this.getTodoPage(stateName ? stateName : _this.SBStateService.getCurrentStateName());
        if (page != null) {
            return page.hasShare;
        }
        return false;
    }

    function getTodoPageById(id) {
        for (var prop in _this.todoPages) {
            var el = _this.getTodoPage(prop);
            if (el && el._id === id) {
                return el;
            }
        }
        return null;
    }

    function getTodoPageByName(name) {
        for (var prop in _this.todoPages) {
            var el = _this.getTodoPage(prop);
            if (el && el.name.indexOf(name) !== -1) {
                return el;
            }
        }
        return null;
    }

    function getChildPage(parentPageId) {
        for (var prop in _this.todoPages) {
            var el = _this.getTodoPage(prop);
            if (el && el.parentPageId === parentPageId) {
                return el;
            }
        }
        return null;
    }

    function hasProductSidebarChanged(product) {
        var overviewBlockIds = product.productType && product.productType.overviewBlockIds ? product.productType.overviewBlockIds : [];
        if (!_this.overviewBlockIds ||_this.overviewBlockIds &&( product._id !== _this.overviewBlockIds.productId || _this.overviewBlockIds.overviewBlockIds !== overviewBlockIds)) {
            _this.overviewBlockIds = {productId: product._id, overviewBlockIds: overviewBlockIds};
        }
        return _this.overviewBlockIds;
    }

    function getBlockByType(type) {
        var ob = _this.overviewBlocks;
        if (!ob) {
            return null;
        }
        for (var prop in ob) {
            var el = ob[prop];
            if (el.type === type) {
                return el;
            }
        }
        return null;
    }

    function getProductSidebarBlocks(product, processItem) {
        var overviewBlockIds = product.productType && product.productType.overviewBlockIds ? product.productType.overviewBlockIds : [];
        return {
            o: getBlocks(false, product, overviewBlockIds, processItem),
            c: getBlocks(true, product, overviewBlockIds, processItem)
        }

        function getBlocks(isCustom, product, overviewBlockIds, processItem) {
            var bl = isCustom ? _this.customOverviewBlocks : _this.overviewBlocks;
            var  html = '';
            if(!bl){return html;}

            var m = overviewBlockIds ? overviewBlockIds.length : 0, html = '', i = 0;
            if (!isCustom) {
                //ensure parent Labels are added and that children are sorted by navOrder
                var parents = [], l = {}, o, parentId;
                for (i = 0; i < m; i++) {
                    o = bl[overviewBlockIds[i]];
                    if (o) {
                        parentId = o.parentNavId;
                        if (parentId) {
                            var ep =_.find(parents, {_id: parentId});
                            if (!ep) {
                                var p = _.find(_this.overviewBlocks, {_id: parentId});
                                if (p) {
                                    p.urls = o.urls;
                                    parents.push(p);
                                }
                                l[parentId] = [];
                            }else{
                                ep.urls = ep.urls.concat(o.urls);
                            }
                            l[parentId].push(o);
                        }
                    }
                }

                parents = _.sortBy(parents, 'order');
                for (i = 0, m = parents.length; i < m; i++) {
                    var p = parents[i], ch = l[p._id];
                    if (!ch) {
                        break;
                    }
                    if (ch.length > 1) {
                        ch = _.sortBy(ch, 'navOrder');
                        p.url = ch[0].url;
                        html += processItem(p, ch, overviewBlockIds);
                    } else {
                        html += processItem(ch[0], null, overviewBlockIds);
                    }
                }
            } else {
                for (i = 0; i < m; i++) {
                    o = bl[overviewBlockIds[i]];
                    if (o) {
                        html += processItem(o);
                    }
                }
            }
            return html;
        }
    }
}

angular.module('services.blocksSetupEvents', [
])
.service('BlocksSetupEventsService', BlocksSetupEventsService);

BlocksSetupEventsService.$inject = ['RootEventsService'];
function BlocksSetupEventsService(RootEventsService) {
    var _this = this;

    _this.emitClearFeed = function () {
        RootEventsService.broadcastRoot('CLEAR_FEED');
    };
    _this.onClearFeed = function (watchers, method) {
        return RootEventsService.addRootWatcher(watchers, 'CLEAR_FEED', method);
    };

    return _this;
}

angular.module('services.cheatSheet', [
    'service.currentPageSettings.service',
    'services.blocksSetup',
    'services.cheatSheetEvents'
])
    .service('CheatSheetService',CheatSheetService);
CheatSheetService.$inject = ['BlocksSetupService', 'CPS', 'CheatSheetEventsService', 'CommentsSidebarService'];
function CheatSheetService(BlocksSetupService, CPS, CheatSheetEventsService, CommentsSidebarService) {
    var introOptions = {
        disableInteraction: true,
        showStepNumbers: false,
        showBullets: true,
        exitOnOverlayClick: true,
        exitOnEsc: true,
        nextLabel: 'Next',
        prevLabel: '',
        skipLabel: '',
        overlayOpacity: .7
    },
     initWrapperCls = 'group-init-wrapper';

    //must initialize $scope.cheatSheetInfo
    var _this = this;

    _this.CPS = CPS;
    _this.LCS = CPS.LCS;
    _this.BlocksSetupService = BlocksSetupService;
    _this.CommentsSidebarService = CommentsSidebarService;
    _this.CheatSheetEventsService = CheatSheetEventsService;
    _this.RootEventsService = CheatSheetEventsService.RootEventsService;
    _this.popupsService = CPS.popupsService;

    _this.onUpdateCheatsheet = _this.CheatSheetEventsService.onUpdateCheatsheet;
    _this.emitStartIntro = _this.CheatSheetEventsService.emitStartIntro;
    _this.onStartIntro = _this.CheatSheetEventsService.onStartIntro;

    _this.hotkeys = null;
    _this.cheatSheetInfo = null;

    _this.toggleHelp = toggleHelp;
    _this.startIntro = startIntro;
    _this.setBlock = setBlock;
    _this.emitUpdateCheatsheet = emitUpdateCheatsheet;

    return _this;

    function toggleHelp() {
        console.log('toggleHelp');
        _this.started = false;
        // $ctrl.service.cheatSheetInfo
        var params = getCheatSheetParams();
        if (!params) {
            return;
        }

        toggleModal(true);
        params.hasIntro = params.hasIntro && _this.cheatSheetInfo && _this.cheatSheetInfo.showIntro();
        _this.popupsService.open(null, _this.popupsService.operations.viewTutorials, params);
    }

    function closeModal(popupName){
        _this.RootEventsService.broadcastRoot('CLOSE_POPUP_' + popupName, 'close');
    }

    function toggleModal(show){
        _this.LCS[show ? 'removeClass' : 'addClass'](_this.LCS.bodyElement, 'dontDisplayModal');
    }
    function startIntro(isAuthenticated, isCollaborator, canEdit, canComment, firstTime, forceSave) {
        if(isCollaborator || !isAuthenticated){return;}
        console.log('startIntroS');
        if(_this.started){return;}
        _this.started = true;
        var param = getStateParam(),
            prop = 'intro' + (_this.cheatSheetInfo.stateName.replace('user.product.', 'up').replace('product.', 'p').replaceAll('_', '').replaceAll('.', '') + (param ? param:'')) + (isCollaborator ? (canEdit ? 'edit' : 'view') : ''),
            settings = _this.LCS.getSetting(prop),
            todoPage = _this.BlocksSetupService.getCurrentTodoPage(),
            triggerCloseEl = {},
            elWasOpened = {},
            closeEl = {},
            nextStepOnBeforeChange = null;

        _this.currentElement = null;

        if (!_this.LCS.isMobileSize && showIntroS() && (forceSave || firstTime && !settings || !firstTime)) {
            _this.LCS.timeout(function () {
                var steps = getIntroSteps(isAuthenticated, canEdit, canComment, _this.cheatSheetInfo);
                if (!steps || !steps.length) {
                    return;
                }

                console.log('startIntroS has steps');
                loadIntro(steps);
                if (firstTime) {
                    _this.LCS.setSetting(prop, true);
                }
            }, 500);
        }

        function getStateParam() {
            return _this.cheatSheetInfo.stateName.indexOf('callsheet.edit') !== -1 ? _this.CPS.SBStateService.getCurrentStateParams().mode : null;
        }

        function loadIntro(steps) {
            var intro = introJs.tour();
            introOptions.steps = steps;
            intro.setOptions(introOptions);

            intro.onbeforechange(onbeforechange);
            intro.onchange(onchange);
            intro.onafterchange(onafterchange);

            intro.onComplete(onexit);
            intro.onExit(onexit);

            intro.start();

            function onafterchange(el) {
                if(!el){return;}
                if (el.onAfterChange) {
                    el.onAfterChange(el, intro);
                }

                if(el.absolutePosition){
                    _this.LCS.replaceClass(el, 'introjs-relativePosition', 'introjs-absolutePosition');
                }
            }

            function onchange(el) {
                _this.currentElement = el;
                toggleCommentsSidebar(_this.currentElement, false);
                toggleLeftSidebar(_this.currentElement, el.forceOpen === true && el.openSidebar);
                toggleDrpMenu(_this.currentElement, el.forceOpen === true && el.openDrp);
            }

            function onbeforechange(el) {
                if(!el){return;}
                if(el.withFocus) {
                    el.focus();
                }

                if(el.onBeforeChange){
                    el.onBeforeChange(el, intro);
                }

                highlightGridHeader(el);

                toggleCommentsSidebar(el, true);
            }

            function onexit() {
               // console.log('intro.onexit');
                toggleCommentsSidebar(_this.currentElement, false);
                toggleLeftSidebar(_this.currentElement, false);
                toggleDrpMenu(_this.currentElement, false);

                if (closeEl && closeEl.openedPopup) {
                    closeModal(closeEl.openedPopup);
                }
                toggleModal(true);

                _this.started = false;
            }

            function highlightGridHeader(el) {
                if (el.highlightGridHeader) {
                    var groupContentCls = 'group-content1';
                    var el1 = _this.LCS.findClosestParent(el, '.' + groupContentCls);
                    if (el1) {
                        el1 = el1.querySelector('.row-header.list-header');
                        _this.LCS.addClass(el1, 'introjs-showElement introjs-relativePosition');
                    }
                }
            }
        }

        function toggleDrpMenu(el, open) {
            if(!el || open && !el.openDrp){return;}
            var clsOpen = 'open';
            toggleSidebarEl(el ? el : {}, open, {
                showCls: 'introjs-relativePosition',

                closeEl: 'closeDrp',

                getSidebar: function(el){
                    return _this.LCS.findClosestParent(open ? el : el.closeDrp, '.dropdown-wrapper');
                },

                isItem: function (el) {
                    return _this.LCS.hasClass(el, '.side-nav') ;
                    // return el.hasClass('data-type') === 'toggleInnerSidebar';
                },

                isSidebarOpen: function (sidebar) {
                    return _this.LCS.hasClass(sidebar, clsOpen);
                },

                toggleSidebar: function (sidebar, open) {
                    _this.LCS[open ? 'addClass' : 'removeClass'](sidebar, clsOpen);
                }
            });
        }

        function toggleLeftSidebar(el, open) {
            if(!el || open && !el.openSidebar){return;}
            toggleSidebarEl(el ? el : {}, open, {
                showCls: 'introjs-relativePosition',

                closeEl: 'closeSidebar',
                sidebarCls: '.side-table > .side-nav',

                isItem: function (el) {
                    return _this.LCS.hasClass(el, '.side-nav') ;
                   // return el.hasClass('data-type') === 'toggleInnerSidebar';
                },

                isSidebarOpen: function () {
                    return _this.LCS.hasInnerSidebar(_this.cheatSheetInfo.stateName);
                    //+ ($ctrl.isInTreeModal ? ('_' + $ctrl.isInTreeModal) : '')
                },

                toggleSidebar: function (sidebar, open) {
                    _this.LCS[open ? 'removeClass' : 'addClass'](sidebar, 'sb-hide');
                    //_this.LCS.toggleInnerSidebar(_this.cheatSheetInfo.stateName);
                }
            });
        }

        function toggleCommentsSidebar(el, open) {
            if(!el || open && !el.openComments){return;}
            toggleSidebarEl(el, open, {
                closeEl: 'closeComments',
                sidebarCls: '.comments-sidebar #comments-bar',

                isItem: function (el) {
                    return el.id === 'btnTopcomments';
                },

                isSidebarOpen: function () {
                    return _this.CommentsSidebarService.isOpen;
                },

                toggleSidebar: function () {
                    var sidebarType = todoPage ? (todoPage.hasListComments ? 4 : (todoPage.hasComments ? 5 : null)) : null;
                    if (sidebarType) {
                        _this.RootEventsService.broadcastRoot('COMMENTS_SIDEBAR_TOGGLE', {
                            open: open,
                            sidebarType: sidebarType
                        });
                    }
                }
            });
        }

        function toggleSidebarEl(el, open, data) {
            if (!el) {
                return;
            }
            var sidebar = data.getSidebar ? data.getSidebar(el) : _this.LCS.bodyElement.querySelector(data.sidebarCls);

            if (!sidebar) {
                return;
            }

            var shouldClose = el ? el[data.closeEl] : null;

            if (open && (el.forceOpen || data.isItem(el)) ||
                !open && shouldClose) {

                if (open) {
                    if (!data.isSidebarOpen(sidebar)) {
                        toggleSidebar();
                    }
                    toggle();
                } else if (triggerCloseEl[data.closeEl]) {
                    toggle();
                    if (elWasOpened[data.closeEl]) {
                        toggleSidebar();
                    }
                    if (shouldClose) {
                        el[data.closeEl] = false;
                    }
                }

                function toggleSidebar() {
                    data.toggleSidebar(sidebar, open);
                    elWasOpened[data.closeEl] = open;
                }

                function process() {
                    if (!el.forceOpen) {
                        showEl(sidebar, open, data.showCls);
                    }
                }

                function toggle() {
                    if (open && !data.noDelay) {
                        _this.LCS.timeout(process, 200);
                    } else {
                        process();
                    }
                    triggerCloseEl[data.closeEl] = open;
                }
            }
            return sidebar;
        }

        function showEl(el, open, cls) {
            _this.LCS[open ? 'addClass' : 'removeClass'](el, 'introjs-showElement' + (cls ? (' ' + cls) : ''));
        }

        function showIntroS() {
            var s = _this.cheatSheetInfo.showIntro;
            return typeof (s) === 'function' ? s() : false;
        }

        function getSubheader() {
            return _this.LCS.bodyElement.querySelector('nav.subheader');
        }

        function getFiltersNav() {
            return _this.LCS.bodyElement.querySelector('nav.filters:not(.short)');
        }

        function getIntroSteps(isAuthenticated, canEdit, canComment, cheatSheetInfo) {
            var overviewBlockType = cheatSheetInfo.overviewBlockType,
                stateName = cheatSheetInfo.stateName,
                subheader = getSubheader(),
                filters = getFiltersNav(),

                firstItem,
                steps;

            switch (overviewBlockType) {
                case 'screenplays':
                    //screenplay
                    if (stateName.indexOf(overviewBlockType) === -1) {
                        setScreenplaySteps();
                    }
                    break;

                case 'avscripts':
                    if (stateName.indexOf(overviewBlockType) === -1) {
                        setAVScriptSteps();
                    } else{
                        setAVScriptSteps();
                    }
                    break;

                case 'breakdowns':
                    if (stateName.indexOf(overviewBlockType) !== -1) {
                        setBreakdownsSteps();
                    } else { //breakdown
                        setSceneBreakdownSteps();
                    }
                    break;

                case 'scheduling':
                    setSchedulingSteps();
                    break;

                case 'reports':
                    setReportsSteps();
                    break;

                case 'script':
                    setSidesSteps();
                    break;

                case 'moodboards':
                    setMoodboardsSteps();
                    break;

                case 'shots':
                    setShotListSteps();
                    break;

                case 'storyboards':
                    setStoryboardsSteps();
                    break;

                case 'contacts':
                    setContactsSteps();
                    break;

                case 'callsheets':
                    if(stateName.indexOf('callsheet.edit') !== -1) {
                        setCallsheetEdit();
                    } else if(stateName.indexOf('callsheet.confirmations') !== -1){

                        setCallsheetConfirmations();
                    }
                    break;

                case 'locations':
                    setLocationsSteps();
                    break;

                case 'elements':
                    setElementsSteps();
                    break;

                case 'calendar':
                    setCalendarSteps();
                    break;

                case 'taskBoards':
                    setTaskBoardSteps();
                    break;

                case 'materials':
                   // setMediaLibrarySteps();
                    break;

                case 'documents':
                    if (stateName.indexOf(overviewBlockType) === -1) {

                    } else {
                        setDocumentsSteps();
                    }
                    break;
            }

            return steps;

            function setMediaLibrarySteps(){

                var itemTitle = 'file';
                var listTitle = 'folder';

                if (!addFirstItemStep({
                    intro: "<div class='title'>"+itemTitle+"</div>" +
                        "<p>Elements are listed in rows like this. You can rename the element or replace the avatar image.</p>"
                })) {
                    return;
                }
                addLeftSidebarStep({
                    intro: "<div class='title'>Toggle sidebar</div>" + "<p>This button can show or hide the "+listTitle+"s.</p>",
                    introSidebar: "<div class='title'>"+_this.CPS.capitalizeFirst(listTitle) +"s</div>" +
                        "<p>Switch between the various " + listTitle + "s here.</p>"
                });

                addSearchBtn({ intro: "<div class='title'>Search "+itemTitle+"s</div>" +
                        "<p>Quickly find a specific "+itemTitle+".</p>"});

                if (canEdit) {
                    addNewBtn({
                        intro: "<div class='title'>Create new "+ itemTitle +"</div>" +
                            "<p>text.</p>"
                    });
                }
                addCommentsStep(filters);

                addViewTypeStep();

                addShareStep(subheader);

                addTutorialsStep({introExtra: 'manage files'});

            }

            function setDocumentsSteps(){
                var itemTitle = 'document';
                var listTitle = 'folder';
                var el = _this.LCS.bodyElement.querySelector('.document-group');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Select your docs here" +
                            "<p>Documents that are created can be found here.</p>",
                        position: 'left'
                    });
                }
                el = _this.LCS.bodyElement.querySelector('.document-version-editor-child');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Write here…" +
                            "<p>This is the main content area. Documents autosave periodically, but to force a save, click the disk icon.</p>",
                        position: 'left'
                    });
                }

                addLeftSidebarStep({
                    intro: "<div class='title'>Toggle sidebar</div>" + "<p>You can toggle to view "+itemTitle+" "+listTitle+"s here.</p>",
                    introSidebar: "<div class='title'>"+_this.CPS.capitalizeFirst(listTitle)+" sidebar</div>" +
                        "<p>You can swap between "+listTitle+"s here.</p>"
                });


                addSearchBtn({ intro: "<div class='title'>Search "+itemTitle+"s</div>" +
                        "<p>Search "+itemTitle+"s within a selected "+listTitle+".</p>"});

                if (canEdit) {
                    addNewBtn({
                        intro: "<div class='title'>Create new "+ itemTitle +"s</div>" +
                            "<p>Click here to create new docs.</p>"
                    });
                }

                addSettingsStep(null, [{
                    cls:'a[data-type="openTitlePage"]',
                    other: {
                        intro: "<div class='title'>Title page designer</div>" +
                            "<p>Design your title page which will be automatically appended to the PDF.</p>"
                    }
                },{
                    cls:'a[data-type="openVersions"]',
                    other: {
                        intro: "<div class='title'>Revision history</div>" +
                            "<p>View and restore previous autosaves in the cloud and on your local device. Rest assured, your work is safe and backed up.</p>"
                    }
                }]);

                addCommentsStep(filters);

                addViewTypeStep();

                addShareStep(subheader);

                addTutorialsStep({introExtra: 'manage documents'});
            }

            function setScreenplaySteps() {
                var el = _this.LCS.bodyElement.querySelector('.document-version-editor-child .editorwrapper');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>This is your script</div>" +
                            "<p>You can start writing here, or import an existing script to continue writing in StudioBinder.</p>",
                        position: 'left'
                    });
                }
                  el = _this.LCS.bodyElement.querySelector('.editortoolbar1 .btn-group');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Formatting options</div>" +
                            "<p>Use the formatting toolbar to format your script into an industry standard screenplay.</p>",
                        position: 'left'
                    });
                }
//1. Highlight sidebar.
                addLeftSidebarStep({
                    intro: "<div class='title'>Toggle sidebar</div>" +
                        "<p>You can toggle to view your sidebar of screenplay revisions here.</p>",
                    introSidebar: "<div class='title'>Screenplay Revisions</div>" +
                        "<p>Create color-coded revisions as your script goes through its stages of development.</p><p>You can view and swap between screenplay revisions at any time via this sidebar.</p>"

                });
                  el = _this.LCS.bodyElement.querySelector('.lockContainer .btnLock');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Lock your script</div>" +
                            "<p>When your script is complete, lock it. Doing so will assign scene numbers to each scene heading. Then, everyone on the production will have the same point of reference.</p>",
                        position: 'left'
                    });
                }

                  el = _this.LCS.bodyElement.querySelector('.lockContainer .btnSync');
                el.absolutePosition=true;
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Sync to project</div>" +
                            "<p>When you’re ready to start production planning, sync your screenplay with the rest of your StudioBinder project.</p><p>Syncing a script locks it, turns it into a “shooting script,” and updates various pages across your project with the screenplay data.\n.</p>",
                        position: 'left'
                    });
                }

                addNavFilterStep('a[data-type="openScratchpad"]', {
                    intro: "<div class='title'>Script outline</div>" +
                        "<p>Access the Script Outline here — a convenient place to structure your script, capture ideas, and gather research.</p>"
                });

                addSettingsStep(null, [{
                    cls:'a[data-type="openTitlePage"]',
                    other: {
                        intro: "<div class='title'>Title page designer</div>" +
                            "<p>Design your title page which will be automatically appended to the PDF.</p>"
                    }
                },{
                    cls:'a[data-type="openVersions"]',
                    other: {
                        intro: "<div class='title'>Revision history</div>" +
                            "<p>View and restore previous autosaves in the cloud and on your local device. Rest assured, your work is safe and backed up.</p>"
                    }
                }]);

                addCommentsStep(filters);

                addShareStep(subheader);

                addTutorialsStep({introExtra: 'write and manage documents'});
            }

            function setTaskBoardSteps() {
                var listTitle = 'task board';

                addNewItem();
                addNewColumn();
                addTeam();

                //1. Highlight sidebar.
                addLeftSidebarStep({
                    intro: "<div class='title'>Toggle sidebar</div>" +
                        "<p>Create new " + listTitle + "s here</p>",
                    introSidebar: "<div class='title'>"+_this.CPS.capitalizeFirst(listTitle)+"s</div>" +
                        "<p>You can toggle to show or hide your sidebar of  "+listTitle+"s here.</p>"
                });

                if (canEdit) {
                    addFilters(null, {intro: "<div class='title'>Active "+listTitle+"s</div>" +
                            "<p>You can swap between active and archived " + listTitle + "s here.</p>"
                    });
                }

                addTutorialsStep({introExtra: 'manage tasks'});

                function addNewItem() {
                    var el = _this.LCS.bodyElement.querySelector('.swimlane-wrapper .todo-card-add');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Add task cards here</div>" +
                                "<p>Create task card here. You can click on the cards to assign more details, team members, checklists, and more.</p><p>As a task card is worked on, the card is dragged into the appropriate column, or phase.</p>",
                            position: 'left'
                        });
                    }
                }

                function addNewColumn() {
                    var el = _this.LCS.bodyElement.querySelector('.swimlane-wrapper .add-swimlane');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Add columns</div>" +
                                "<p>You can add columns here to designate key phases of your workflow.</p>",
                            position: 'left'
                        });
                    }
                }

                function addTeam( ) {
                    addNavFilterStep('.sb-assign-team', {
                        intro: "<div class='title'>Assign team</div>" +
                            "<p>This is where you can assign team members to a board. By default, admins are automatically assigned to every board.</p>",
                        position: 'left'
                    });
                }
            }

            function setAVScriptsSteps() {
                var itemTitle = 'AV script';
                var listTitle = 'group' ;
                if (!addFirstItemStep({
                    intro: "<div class='title'>This is a " + listTitle + " " + itemTitle + "</div>" +
                        "<p> text.</p>"
                })) {
                    return;
                }

                //1. Highlight sidebar.
                addLeftSidebarStep({
                    intro: "<div class='title'>" + _this.CPS.capitalizeFirst(listTitle) + "s sidebar</div>" +
                        "<p>Create new " + listTitle + "s here</p>"
                });

                if (canEdit) {
                    addFilters(listTitle);
                }

                addSearchBtn({itemTitle: itemTitle});

                if (canEdit) {

                    addNewBtn({
                        intro: "<div class='title'>Create new "+ itemTitle +"</div>" +
                            "<p>text.</p>"
                    });
                }

                addViewTypeStep();
                addVersionsStep({listTitle: listTitle});
                addShareStep(subheader);
                //addTasksStep();
                addTutorialsStep({introExtra: 'write AV scripts'});
            }

            function setAVScriptSteps() {
                var itemTitle = 'row';
                var listTitle = 'version' ;
                if (!addFirstItemStep({
                    highlightGridHeader:true,
                    intro: "<div class='title'>This is a " + itemTitle + "</div>" +
                        "<p>Think of each row of your script as a distinct visual or shot in your project.</p><p>Connected to that visual is the audio or narration that corresponds to it, along with other useful information like the shot number, image reference or duration.</p><p>Every time the visual significantly changes, simply add a new row below.</p><p>Each row can be easily dragged and reordered.</p>"
                })) {
                    return;
                }

                addRowNo(firstItem);
                addWordCount(firstItem);
                addTotalWordCount();
                addImage(firstItem);
                addDuration(firstItem);
                addRowComments(firstItem);

                //1. Highlight sidebar.
                addLeftSidebarStep({
                    intro: "<div class='title'>Toggle sidebar</div>" +
                        "<p>You can toggle to view your sidebar of AV script versions.</p>",
                    introSidebar: "<div class='title'>Script versions</div>" +
                        "<p>You can swap between script versions here.</p><p>As you get more feedback on a script, it’s wise to create a new version so you can make changes, while still being able to view past versions as needed.</p><p>The latest version will always be the default when the page is first loaded. You can also archive versions to tidy up the sidebar.</p>"
                });

                if (canEdit) {
                    addFilters(null, {   intro: "<div class='title'>Active script versions</div>" +
                            "<p>You can swap between active and archived " + listTitle + "s here.</p>"
                    });
                }

                addShareStep(filters);

                /*4. Highlight Script Preview*/
                addNavFilterStep('a[data-type="openScratchpad"]', {
                    intro: "<div class='title'>Script outline</div>" +
                        "<p>Toggle the Script Outline to map out your script or use it as a scratchpad to collect your ideas and research.</p>"
                });

                addGeneratePDFStep({listTitle: listTitle});

                addSettingsStep(null, [{
                    cls:'a[data-type="columnSettings"]',
                    other: {
                        intro: "<div class='title'>Customize columns</div>" +
                            "<p>You can toggle the columns in the AV script here. Feel free to make the AV script as simple or as complex as you need.</p>"
                    }
                }]);

                addTutorialsStep({introExtra: 'write AV scripts'});

                function addRowNo(firstItem, other) {
                    var el = firstItem.querySelector('.shotnoprop');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Row number</div>" +
                                "<p>This is the row number. The first number corresponds to the segment, and the second number represents the row number. Since we’re in Segment 1, Row 1, the short name is “1.1.”</p><p>The next row in this segment would be designated “1.2” and so on.</p>",
                            position: 'left'
                        }, other);
                    }
                }

                function addWordCount(firstItem, other) {
                    var el = firstItem.querySelector('.wc');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Words & Runtime</div>" +
                                "<p>The word count is tallied based on the audio column of that row.</p><p>“RT” stands for runtime which is the time between the start and end of the project.</p><p>After setting a duration for each row, the running time will be automatically calculated.</p>",
                            position: 'left'
                        }, other);
                    }
                }

                function addTotalWordCount() {
                    addNavFilterStep('.nonselectedrowcount', {
                        intro: "<div class='title'>Total Words and TRT</div>" +
                            "<p>The The Total RT, or Total Runtime, is the total length of the entire project. This total is based on the sum total of all the durations across all the rows.</p><p>Total Words is the sum total of all the words across all the audio cells.</p>",
                        position: 'left'
                    });

                }

                function addImage(firstItem, other) {
                    var el = firstItem.querySelector('.storylogo');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Reference image</div>" +
                                "<p>You can add images to each row to act as a reference or storyboard.</p><p>Click here to upload new images, or search and select previously uploaded images from your Media Library.",
                            position: 'left'
                        }, other);
                    }
                }

                function addDuration(firstItem, other) {
                    var el = firstItem.querySelector('.sb-col-duration');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Duration</div>" +
                                "<p>This is where you can estimate how long the audio or visual will remain on screen.</p><p>We suggest using the built-in Stopwatch feature to time the narration time per row.</p>",
                            position: 'left'
                        }, other);
                    }
                }

                function addRowComments(firstItem, other) {
                    var el = firstItem.querySelector('.sb-click-viewComments');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Row comments</div>" +
                                "<p>Click here to open the Comments sidebar.</p><p>Comments are a great way to get feedback and approval from team members and collaborators.</p><p>Each comment can be marked as “resolved” which then archives the comment.</p>",
                            position: 'left'
                        }, other);
                    }
                }
            }

            function setSceneBreakdownSteps() {
                var topBreakdownScene = _this.LCS.bodyElement.querySelector('.topBreakdownScene');
                firstItem = topBreakdownScene ? topBreakdownScene.querySelector('.row-schedule') : null;

                if (!addFirstItemStep({
                    intro: "<div class='title'>Scene strip</div>" +
                        "<p>This strip lets us know what scene we're currently on. It displays a number of important details at a glance.</p>"
                })) {
                    return;
                }

                addAssignCharStep(firstItem);
                addAssignLocStep(firstItem);
                addPageLengthStep(firstItem,  "<div class='title'>Page length</div>" +
                    "<p>Each page of a script is broken down into 8ths. The page length of a given scene can be found here.</p><p>When creating a schedule, the page length informs how long it will take to shoot that scene.</p>");

                /*5.Highlight left/right arrows*/
                el = topBreakdownScene.querySelector('.side-arrow > .table-div.right');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Switch scenes</div>" +
                            "<p>The right or left arrows allow you to jump to the next or previous scene.</p>",
                        position: 'left'
                    });
                }

                //highlight tagging
                var el = _this.LCS.bodyElement.querySelector('.breakdown-inner-container .scene-tagging-item');
                if (el) {
                    var intro = (canEdit ? ("<div class='title'>Select to tag</div>" +
                            "<p>To start tagging elements such as cast, props, wardrobe, set dressing, and more, simply click-and-drag the word or phrase.</p>" +
                            "<div class='text-center'><img style='width: 200px' src='" + _this.LCS.getImgUrl('breakdown-tagging-guide.gif', false) + "'></div>") :
                        ("<div class='title'>Tagged elements are colored</div>" +
                            "<p>Tagged elements are colored such as cast, props, wardrobe, etc.</p>"));
                    addStep({
                        element: el,
                        intro: intro,
                        position: 'left'
                    });
                }

                //1. Highlight sidebar.
                addLeftSidebarStep({
                    intro: "<div class='title'>Toggle sidebar</div>" +
                        "<p>This button can show or hide the <b>Elements Sidebar</b>, which acts as a ledger of all of the tagged elements in the current scene.</p>",

                    introSidebar: "<div class='title'>Element sidebar</div>" +
                        "<p>All tagged elements in a scene will be listed here. If you come across any elements that are not explicitly mentioned in the script, you can manually type them in via this sidebar.</p>"
                });

                //scene notes
                createStep({
                    selector: '#sceneNotesSection',
                    intro: "<div class='title'>Scene notes</div>" +
                        "<p>Below the script, you can " + (canEdit ? "add notes, upload images, or embed videos" : "view notes") + " that relate to the scene here.</p>",
                    position: 'right'
                });

                //6.Scene Number dropdown
                addNavFilterStep('.btnSearchFilter', {
                    intro: "<div class='title'>Jump to scene</div>" +
                        "<p>You can jump to a specific scene via this dropdown.</p>",
                    position: 'right'
                });

                addShareStep(filters);
                addCommentsStep(filters);
                addVersionsStep({listTitle: 'breakdown'});

                addTasksStep();

                addTutorialsStep({introExtra: 'break down a script'});
            }

            function setBreakdownsSteps() {
                var itemTitle = 'scene';
                if (!addFirstItemStep({
                    intro: "<div class='title'>Scene strip</div>" +
                        "<p>Every scene is listed and accessible here. Select the scene heading to begin tagging elements for that scene.</p>"
                })) {
                    return;
                }

                addAssignCharStep(firstItem);
                addAssignLocStep(firstItem);
                addPageLengthStep(firstItem);
                addElementsStep(firstItem);
                addPreviewPopupStep(firstItem);

                addNotesStep(firstItem, {itemTitle: itemTitle});

                if (canEdit) {
                    addFilters(null,{
                        intro: "<div class='title'>Scene filter</div>" +
                            "<p>Select to see all scenes, omitted scenes, or only the active scenes.</p>"
                    });
                }

                addSearchBtn({
                    itemTitle: itemTitle,
                    intro: "<div class='title'>Search scenes</div>" +
                    "<p>Quickly search for a specific scene by slugline, cast, or location.<p></p>This is a convenient way to filter by set and bulk-assign locations or cast to multiple scenes at once.</p>"
                });

                if (canEdit) {
                    addNewBtn({
                        intro: "<div class='title'>New scene</div>" +
                            "<p>If you want to write a new scene, you can do so here.<p></p>This is especially useful when splitting apart \"hidden\" scenes within a scene (e.g. characters watching a TV broadcast, where the broadcast is the hidden scene that needs to be shot.)</p>"
                    });
                }

                addSettingsStep(null);

                addVersionsStep({ intro: "<div class='title'>Version manager</div>" +
                        "<p>Every time a script is imported or synced with a project, a new version of the project is generated. You can view and roll back to previous versions here.</p>"});

                addShareStep(subheader);

              //  addTasksStep();

                addCommentsStep(subheader);

                addTutorialsStep({introExtra: 'break down a script'});
            }

            function setSchedulingSteps() {
                var itemTitle = 'strip';
                var listTitle = 'schedule';
                if (!addFirstItemStep({
                    intro: "<div class='title'>This is a scene strip</div>" +
                        "<p>Each scene is represented as a strip of important details. The colors are industry-standard and based on a unique combination of INT/EXT and time of day.</p>"
                }, '.scene')) {
                    return;
                }

                //collumn callouts on item in grid
                addReorderGridStep({itemTitle: itemTitle});

                addAssignCharStep(firstItem);
                addAssignLocStep(firstItem, {
                    intro: "<div class='title'>Assign locations</div>" +
                        "<p>Similar to cast, you can assign shooting locations to each scene.</p><p>Once most of your strips have a location, you can auto-reorder your entire stripboard by location, and build your schedule more efficiently.</p>"
                });
                addPageLengthStep(firstItem);
               // addElementsStep(firstItem);
                addEstTimeStep(firstItem, {withFocus: true});

                //1. Highlight sidebar.
                addLeftSidebarStep({
                    intro: "<div class='title'>Toggle sidebar</div><p>If you need to create multiple schedules, open the Schedules sidebar here.</p>",
                    introSidebar:"<div class='title'>Schedules sidebar</div><p>Sometimes you may find yourself needing to create multiple drafts of a schedule, or additional schedules for second unit teams, geography, episodes, etc.</p><p>You can create and swap between your schedules here.</p>"
                });

                addSearchBtn({ intro: "<div class='title'>Search strips</div><p>Quickly search for a specific scene by slugline, cast, or location. This is a great way to quickly filter by sets and assign locations.</p>" });

                //btns on filters
                if (canEdit) {

                    /*6.Highlight all toolbar buttons (incl. # of strips if possible)*/
                    addNavFilterStep('a[data-type="autoSort"]', {
                        intro: "<div class='title'>Reorder strips</div>" +
                            "<p>Auto-reorder your entire stripboard according to your preferred criteria.</p>"
                    });

                    addNavFilterStep('a[data-type="autoBreak"]', {
                        intro: "<div class='title'>Add day breaks</div>" +
                            "<p>Day breaks represent the end of a shoot day. This automatically adds a day break according to the number of pages you expect to shoot per day.</p>"
                    });
                }

                addSettingsStep(null, [{
                    cls:'a[data-type="columnSettings"]',
                    other: {
                        intro: "<div class='title'>Customize columns</div>" +
                            "<p>The stripboard can be as simple or complex as you like. Toggle various column options here to find the layout that best fits your needs.</p>"
                    }
                }]);
                addCommentsStep(filters);

                addVersionsStep({listTitle: listTitle});
                addShareStep(subheader);
                //addTasksStep();
                addTutorialsStep({introExtra: 'schedule your project'});
            }

