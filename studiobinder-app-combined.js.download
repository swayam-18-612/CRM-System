                    desc: desc + 'get your call sheet approved.',
                };

            //NOT AVAILABLE
            case 'callsheetScheduler':
                return {
                    desc: desc + 'schedule your call sheets.',
                };

            //Locations
            //Location Sync
            case 'locationSync':
                return {
                    desc: desc + 'sync location details across the project.' +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>' +
                                '<li>Add details to a location entry.</li>'+
                                '<li>Details sync across the project.</li>' +
                                '<li>Update stripboard, call sheets, etc.</li>' +
                                '</ul>'
                        })
                };

            //Location Mood Boards
            case 'locationMoodboards':
                return {
                    desc: desc + 'upload and share location scout images.' +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>' +
                                '<li>Upload photos from scouting.</li>'+
                                '<li>Share images with the team.</li>' +
                                '<li>Get feedback and comments.</li>' +
