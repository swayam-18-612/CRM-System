angular.module('user.team.invite.controller.service', [
    'apiServices.Team'
])
.service('InviteTeamPopupCtrlService', InviteTeamPopupCtrlService);

InviteTeamPopupCtrlService.$inject = ['ListItemPopupTemplateCtrlService', 'TeamService'];

function InviteTeamPopupCtrlService(ListItemPopupTemplateCtrlService, service) {
   return function($ctrl, $element ){
    console.log('InviteTeamPopupCtrlService');
    $ctrl.addItem = addItem;
    $ctrl.removeItem = removeItem;
    $ctrl.invite = invite;
    $ctrl.isFocus = isFocus;
    $ctrl.getFocus = getFocus;
    $ctrl.getForm = getForm;

   $ctrl.preInitOther = preInitOther;
   $ctrl.postInitOther = postInitOther;

   if($ctrl.withBtnDisabled){
       $ctrl.isBtnDisabled = isBtnDisabled;
   }

   $ctrl.withFormValidation = true;

   $ctrl = new ListItemPopupTemplateCtrlService($ctrl, $element);

   return $ctrl;

   function isBtnDisabled() {
       return !$ctrl.team.invites || !$ctrl.team.invites.length;
   }

    function preInitOther() {
        $ctrl.service = service;

        $ctrl.getInitials = $ctrl.security.getInitialsByName;
        $ctrl.getNameColor = $ctrl.security.getNameColor;
        $ctrl.formHolderItem ={};
        $ctrl.formHolder = {};
        $ctrl.quotaType = 'team';
        $ctrl.maxCount = $ctrl.extraParam.remaining;

        $ctrl.amount = $ctrl.CPS.currentPlan.amount;
        $ctrl.company = $ctrl.security.getCurrentCompany();
        $ctrl.isNew = $ctrl.type === 'Invite Team';
        $ctrl.focus = 1;

        $ctrl.team = {
            isNew: $ctrl.isNew,
            companyId: $ctrl.CPS.companyId,
            message: $ctrl.extraParam.message,
            invites: $ctrl.isNew ? [{email: null, name: null}] : $ctrl.extraParam.selected
        };
    }

    function postInitOther() {
        $ctrl.onSave = onSave;
        $ctrl.onError = onError;
    }

    function onSave(result) {
        $ctrl.isUpdating = false;
            //send updates
        $ctrl.SessionService.loadCompanyDetails(function () {
            if (result.items){
                _.each(result.items, function(item){
                    $ctrl.broadcastRoot('ADDED_' + $ctrl.elemType + '_ITEM', {item: item});
                });
            }else {
                $ctrl.broadcastRoot('ADDED_' + $ctrl.elemType + '_ITEM', result);
            }
            $ctrl.cancelPopup();
        });
    }

    function getFocus(index, val) {
        return index * 2 + val;
    }

    function isFocus(index, val) {
        return $ctrl.getFocus(index, val) === $ctrl.focus;
    }

    function onError(error) {
        $ctrl.isUpdating = false;
        $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.member.Invite Team.error');
    }

    function addItem(e) {
        $ctrl.preventDefault(e);
        $ctrl.team.invites.push({name: null, email: null});
        $ctrl.focus = $ctrl.getFocus($ctrl.team.invites.length - 1, 1);
    }

    function removeItem(e, el) {
       $ctrl.preventDefault(e);
        for (var i = $ctrl.team.invites.length - 1; i >= 0; i--) {
            if ($ctrl.team.invites[i]._id === el._id) {
                $ctrl.team.invites.splice(i, 1);
                if (i > 1) {
                    $ctrl.focus = $ctrl.getFocus(i - 1, 1);
                }
                break;
            }
        }
    }

    function invite(e) {
        $ctrl.preventDefault(e);
        if ($ctrl.isUpdating) {
            return;
        }

        $ctrl.error = null;
        if ($ctrl.team.invites.length === 0) {
            $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.team.invite.invalidcount');
            return;
        }

        if (!$ctrl.isValidForm()) {
            return;
        }

        //send only to selected
        $ctrl.isUpdating = true;
        $ctrl.service.inviteTeamMembers($ctrl.team, $ctrl.onSave, $ctrl.onError);
    }

    function getForm() {
return '<form name="$ctrl.formHolderItem[$ctrl.formName]" novalidate autocomplete="off">' +
    '<table class="repeater-container shares list full-width">' +
        '<tr class="with-mouse-hover with-more-padding" ng-repeat="item in $ctrl.team.invites" ng-style="{\'border-bottom\':0}" style="background-color: white" >' +
            '<td class="col35 padding-left-0 padding-right-0 spacing-quarter">' +
                '<div class="thumb-sm with-radius smaller">' +
                    '<div class="avatar sbf display-block text-center" ng-class="item.name ? $ctrl.getNameColor(item.name) : \'user\'" ng-bind="$ctrl.getInitials(item.name)"><span class="sbp p1"></span><span class="sbp p2"></span></div>' +
                '</div>' +
            '</td>' +
            '<td class="thinner col150">' +
                '<div class="position-relative">' +
                    '<input id=\'name\' tabindex="{{$ctrl.getFocus($index, 1)}}" placeholder="Name…" capitalize-first class="form-control with-underline" type="text" name="{{\'name\' + $index}}" ng-model="item.name" required ui-focus="$ctrl.isFocus($index, 1)">' +
                    '<div ng-show="($ctrl.formHolderItem[$ctrl.formName][\'name\' + $index].$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem[$ctrl.formName][\'name\' + $index].$error.required" class="help-inline ng-hide lower">Name is required.</div>' +
                '</div>' +
            '</td>' +
            '<td class="thinner with-padding-left">' +
                '<div class="position-relative">' +
                    '<input tabindex="{{$ctrl.getFocus($index, 2)}}" name="{{\'email\' + $index}}" type="email" ng-model="item.email" class="form-control with-underline" placeholder="Email Address…" required ui-focus="$ctrl.isFocus($index, 2)"/>' +
                    '<div ng-show="($ctrl.formHolderItem[$ctrl.formName][\'email\' + $index].$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem[$ctrl.formName][\'email\' + $index].$error.required" class="help-inline ng-hide lower">Please insert an email address.</div>' +
                    '<div ng-show="($ctrl.formHolderItem[$ctrl.formName][\'email\' + $index].$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem[$ctrl.formName][\'email\' + $index].$error.email" class="help-inline ng-hide lower">Please insert a valid email address.</div>' +
                '</div>' +
            '</td>' +
            '<td class="remove-col with-t-padding position-relative with-no-padding col1">' +
                '<div ng-if="$index !== 0" class="remove  " style="position: absolute;left: 0px;top: -1px;' +
    '"><a ng-click="$ctrl.removeItem($event, item)" class="editable-btn btn gray-light display-block" tooltip-placement="top" tooltip="Remove">'+$ctrl.LCS.getISBDiv('trash')+'</a></div>' +
            '</td>' +
        '</tr>' +
    '</table>' +
    '<a ng-if="$ctrl.maxCount > $ctrl.team.invites.length " id="btnNewList" class="margin-top-quarter display-block small ng-scope" ng-click="$ctrl.addItem($event)" analytics-on analytics-action="Add Team Member">' +
    $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left') +
    '<div class="padding-left20 gray inline-block">Add Team Member</div> </a>' +
    '</form>';
    }
}
}

