angular.module('product.material.init.controller.service',[
    'product.material.fileStats.service'
])
.service('MaterialInitCtrlService', MaterialInitCtrlService);
MaterialInitCtrlService.$inject = ['MaterialsService', 'TemplateCompileService', 'FileStatsService'];
function MaterialInitCtrlService(MaterialsService, TemplateCompileService, FileStatsService) {
    return function($ctrl) {

        if(!$ctrl.quotaType) {
            $ctrl.quotaType = 'fileStorage';
        }
        $ctrl.quotaFiles = $ctrl.quotaType;

        if(!$ctrl.compLoaded){
            console.log('parent for must implement CompInitCtrlService' );
        }

        if(!$ctrl.service){
            console.log('parent for MaterialInitCtrlService must define $ctrl.service to be MaterialsService');

            $ctrl.service = MaterialsService;
        }
        $ctrl.openUploadFiles = openUploadFiles;
        $ctrl.openViewMaterial = openViewMaterial;

        $ctrl.uploadFile = uploadFile;
        $ctrl.remove = remove;
        $ctrl.goToFile = goToFile;
        $ctrl.getDownloadLink = getDownloadLink;

        $ctrl.convertResource = convertResource;

        $ctrl.FileStatsService = FileStatsService;
        $ctrl.getExtension = FileStatsService.getExtension;
        $ctrl.getShortExtension = FileStatsService.getShortExtension;
        $ctrl.getShortFileName = FileStatsService.getShortFileName;
        $ctrl.getTextFileSize = FileStatsService.getTextFileSize;
        $ctrl.getFileSize = FileStatsService.getFileSize;
        $ctrl.getTextFilesSizes = FileStatsService.getTextFilesSizes;
        $ctrl.getFileType = FileStatsService.getFileType;
        $ctrl.getIconClass = FileStatsService.getIconClass;
        $ctrl.isImage = FileStatsService.isImage;
        $ctrl.detectFileType = FileStatsService.detectFileType;

        $ctrl.onMaterialInitDestroy = onMaterialInitDestroy;
        $ctrl.onFileUploadSuccess = onFileUploadSuccess;

        $ctrl.onRemoveDrop =  onRemoveDrop;

        return $ctrl;

        function onMaterialInitDestroy(){
            //console.log('materials group: onRemoveDrop');
            if ($ctrl.templateCompileDrop) {
                $ctrl.templateCompileDrop.destroyNewScope();
            }
        }

        function getDownloadLink(item) {
            //console.log('getDownloadLink');
            if (item.isDownloading) {
                return;
            }

            item.isDownloading = true;
            item.productId = $ctrl.CPS.productId;
            item.companyId = $ctrl.CPS.companyId;

            $ctrl.service.getDownloadLink({
                id: item._id,
                versionId: item.versionId,
                productId: item.productId,
                companyId: item.companyId,
            }, onSuccess, onError);

            function onSuccess(link) {
                item.isDownloading = false;
                $ctrl.SBStateService.assignUrl(link, 500);
                return false;
            }

            function onError(err) {
                item.isDownloading = false;
                item.downloadLink = null;
            }
        }

        function goToFile(item) {
            return $ctrl.CPS.getStateHref('user.product.library-file', $ctrl.CPS.currentPathParams({
                materialId: item._id,
                role: $ctrl.CPS.isCollaborator ? $ctrl.CPS.rolePaths.collabPath : $ctrl.CPS.rolePaths.currentUserPath
            }));
        }

        function remove(item) {
            $ctrl.sizeError = null;
            $ctrl.popupsService.open(item, $ctrl.popupsService.operations.remove, {
                isFolder: item.isFolder ? 'Folder' : 'File',
                service: $ctrl.service,
                params:{
                    codeName: $ctrl.codeName
                }
            }, $ctrl.compOptions, null, function (result) {
                if (typeof ($ctrl.onRemoved) === 'function') {
                    $ctrl.onRemoved(result);
                }
            });
        }

        function convertResource(item) {
            return MaterialsService.convertResource(item);
        }

        function uploadFile(params) {
            console.log('uploadFile');
            if (!$ctrl.templateCompileDrop) {
                $ctrl.templateCompileDrop = new TemplateCompileService(null);
            }
            $ctrl.templateCompileDrop.getItemTemplate = getDropTemplate;

            if ($ctrl.onFileUploadError) {
                params.onFileUploadError = $ctrl.onFileUploadError;
            }
            if ($ctrl.onFileUploadSuccess) {
                params.onFileUploadSuccess = $ctrl.onFileUploadSuccess;
            }


            params = _.extend({
                onRemoveDrop: $ctrl.onRemoveDrop,
                uploadObjService: $ctrl.uploadObjService,
                onBefore: onBefore
            }, params);

            $ctrl.templateCompileDrop.loadTemplate(null, params, angular.element($ctrl.LCS.bodyElement));

            /*{
                txtFileType: params.txtFileType,
                fileType: params.fileType,
                multipleFiles: params.multipleFiles,
                awsSignPath: params.awsSignPath,
                codeName: params.codeName,
                parentId: params.parentId,
            }*/
            function getDropTemplate() {

                return "<upload-drop-file " +
                    'class="upload-drop-file" ' +
                    "id='uploadFile' " +
                    "images-only='::$ctrl.imagesOnly' " +
                    "start-order='::$ctrl.startOrder' " +
                    "remaining-size='::$ctrl.remainingSize' " +
                    "close-on-drop='true' " +

                    "txt-file-type ='::$ctrl.txtFileType' " +
                    "file-type='::$ctrl.fileType' " +
                    "multiple-files='::$ctrl.multipleFiles' " +

                    "aws-sign-path='::$ctrl.awsSignPath' " +
                    ($ctrl.codeName ? ("code-name='" + $ctrl.codeName + "' ") : '') +
                    "parent-id='::$ctrl.parentId' " +
                    "with-subparent-id='::$ctrl.withSubparentId' " +

                    'editor-options="::$ctrl.editorOptions" ' +

                    "upload-obj-service='$ctrl.uploadObjService' " +
                    'extra-param="::$ctrl.extraParam" ' +
                    ($ctrl.dontShowActivity ? 'dont-show-activity="true"' :'') +

                    ($ctrl.onRemoveDrop ? 'on-remove-drop="$ctrl.onRemoveDrop(result)" ' : '') +
                    ($ctrl.onFileUploadSuccess ? 'on-success="$ctrl.onFileUploadSuccess(result)" ' : '') +
                    (typeof($ctrl.onBeforeFilesUploaded) === 'function' ? 'on-before="$ctrl.onBefore(result)" ' : 'without-on-before="true"') +
                    ($ctrl.onFileUploadError ? 'on-error="$ctrl.onFileUploadError(id)" ' : '') +
                    "></upload-drop-file>";
            }
        }

        function onBefore(result){
            console.log('MaterialInitCtrlService.onBeforeFilesUploaded1');
            if(typeof($ctrl.onBeforeFilesUploaded === 'function')) {
                $ctrl.onBeforeFilesUploaded({result: result});
            }
        }

        function onFileUploadSuccess(result) {
            console.log('materials group onFileUploadSuccess');
            if(result && result.result){
                result =  result.result;
            }
            if (result) {
                $ctrl.broadcastRoot('ADDED_' + $ctrl.elemType + '_ITEM', result);
            }
        }

        function onRemoveDrop(result) {
            console.log('materials init: onRemoveDrop ');
            onMaterialInitDestroy();
        }

        function openUploadFiles(e) {
            console.log('openUploadFiles');
            $ctrl.preventDefault(e);

            $ctrl.CPS.loadQuotaPopup($ctrl.quotaFiles, process, null,null,null, {e:e});
            function process() {
                var remainingSize = $ctrl.maxSize ? ($ctrl.maxSize - $ctrl.FileStatsService.getFilesSize($ctrl.list.items)) : 0;

                if (!$ctrl.maxSize || remainingSize > 0) {
                    return $ctrl.uploadFile({
                        startOrder: $ctrl.getStartOrder(),
                        remainingSize: remainingSize,
                        imagesOnly: $ctrl.imagesOnly,

                        txtFileType: $ctrl.txtFileType,
                        fileType: $ctrl.fileType,
                        multipleFiles: $ctrl.multipleFiles,

                        awsSignPath: $ctrl.awsSignPath,
                        codeName: $ctrl.codeName,
                        parentId: $ctrl.parentId,
                        withSubparentId: $ctrl.withSubparentId
                    });
                } else {
                    $ctrl.sizeError = 'Uploading more files will put you over the ' + $ctrl.getTextFileSize($ctrl.maxSize) + ' limit.';
                    $ctrl.LCS.prependElementFragment($ctrl.element, '<div class="form-group alert alert-danger position-relative">' + $ctrl.sizeError + '</div>');
                }
            }
        }

        //view popup
        function openViewMaterial(item) {
            console.log('MaterialsGroupInitCtrlService: view material popup');
            var version = item ? item.versionId : null;
            if (version) {
                var params = {
                    canUpload: false,
                    canComment: $ctrl.canComment,
                    isPreview: true,
                };
                if (params.canUpload) {
                    params.editorOptions = $ctrl.editorOptions;
                    params.onImageEdited = onImageEdited;
                }
                $ctrl.popupsService.open(version, $ctrl.popupsService.operations.materialViewer, params, $ctrl.compOptions);
            }
        }
    }
}

