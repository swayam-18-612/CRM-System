angular.module('product.callsheet.confirmations.group.component',[
    'product.callsheet.confirmations.item.grid.component',
    'product.callsheet.recipients.group.controller.service'
])
.component('confirmationGroup', getCallsheetRecipientsGroupParams( 'CallsheetConfirmationsGroupCtrl'))
.controller('CallsheetConfirmationsGroupCtrl',CallsheetConfirmationsGroupCtrl);
CallsheetConfirmationsGroupCtrl.$inject = ['CallsheetRecipientsGroupInitCtrl', 'CallsheetConstantsService', '$element'];
function CallsheetConfirmationsGroupCtrl(CallsheetRecipientsGroupInitCtrl, CallsheetConstantsService, $element) {
    var $ctrl = this;
    $ctrl.quotaTracking = 'callsheetTracking';

    $ctrl.Statuses = {Created: 0, Sent: 1, Confirmed: 2, MailOpened: 3, PageViewed: 4};
    $ctrl.EmailStatus = {
        Sent: 1,
        Confirmed: 2,
        Delivered: 3,
        Bounced: 4,
        Dropped: 5,
        Deferred: 6,
        Spam: 7,
        Blocked: 8
    };

    $ctrl.groupItemTag = 'confirmation';
    //$ctrl.additionalMessageRemove = 'You will lose this project’s contacts, call sheets, and files.';
    //item methods
    $ctrl.onInitOther = onInitOther;
    $ctrl.getMorePopoverTemplateOther2 = getMorePopoverTemplateOther2;
    //views and confirms
    $ctrl.processListItemColumn = processListItemColumn;
    $ctrl.getRowMobileActions = getRowMobileActions;
    $ctrl.openProPopup = openProPopup;

    $ctrl = new CallsheetRecipientsGroupInitCtrl($ctrl, $element);

    function onInitOther() {
        $ctrl.hasCallsheetTracking = $ctrl.CPS.hasQuotaType($ctrl.quotaTracking);
        if ($ctrl.canEdit) {
            $ctrl.sendElemCallsheet = sendElemCallsheet;
        }
        $ctrl.previewElemCallsheet = previewElemCallsheet;
    }

    function getActions(item){
        return [{
            type: 'sendElemCallsheet',
            action: (item.callsheetInvitationSentId ? 'Resend' : 'Send') + ' Call Sheet',
            icon: 'paper-plane'
        },{
            type: 'sendElemMessage',
            action: 'Send Message',
            icon: 'mail'
        }];
    }
    function getRowMobileActions(item) {
        getActions(item);
    }

    function getMorePopoverTemplateOther2(item, isMobile) {
return (isMobile ? '' : getActions(item).map(function (el){return $ctrl.getSideMenuLi(el);}).join('') ) +
            //(item.callsheetInvitationSentId ?
            $ctrl.getSideMenuLi(_.extend({
                withTopBorder: true,
                action: 'Personalized Call Sheet',
                icon: 'eye'
            }, isMobile ? {type: 'previewElemCallsheet'} : {href: getPreviewHref(item._id, false)}));
    }

    function sendElemCallsheet(item, param, e) {
        console.log('sendElemCallsheet');
        $ctrl.processEventOther([{id: item._id}], 'sendCallsheet', e);
    }

    function previewElemCallsheet(item) {
        console.log('previewElemCallsheet');
        getPreviewHref(item._id, true);
    }

    function getPreviewHref(id, isTransition) {
        if (isTransition) {
            $ctrl.broadcastRoot('HIDE_MOBILE_DETAILS');
        }
        return $ctrl.CPS[isTransition ? 'transitionTo' : 'getStateHref']('user.product.callsheet.preview-recipient', $ctrl.CPS.currentProductPathParams({
            callsheetId: $ctrl.callsheetId,
            invitationId: id
        }));
    }

    function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
         var prop = c.prop;
        switch (prop) {
            case 'pageViewsCount':
                var t = getPageViewTooltip(item),
                    el = $ctrl.hasCallsheetTracking ?
                ('<span class="views ' + (item.pageViewsCount ? '' : 'gray') + ' with-tooltip with-cursor"' +
                    //' tooltip="' + t + '" tooltip-placement="top"' +
                    '>' + (item.pageViewsCount || 0) + ' View' + (item.pageViewsCount === 1 ? '' : 's') + '</span>' +
                    ('<div class="tooltip tooltip-inline bottom"><div class="tooltip-inner">' + t +'</div></div>')
                ):
                getTrackingInfo(prop);
                return '<div class="' + cls + ' wider-tooltip toggleDetails">' + el + '</div>';

            case 'status':
                return '<div class="' + cls + ' wider-tooltip toggleDetails">' + ($ctrl.hasCallsheetTracking ? getStatus(item) : getTrackingInfo(prop)) + '</div>';

            default:
                return $ctrl.processListItemColumnInit(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);
        }
    }

    function getTrackingInfo(prop){
        return '<span class="text-center with-underline with-cursor semibold ' + $ctrl.getClickEventName('openProPopup') + '" analytics-on analytics-action="Confirmations col '+prop+'" data-type="openProPopup"><a class="blue display-block">Upgrade</a> <span class="darkgray">to see stats</span></span>';
    }

    function getPageViewTooltip(item) {
return item.callsheetInvitationSentId ? (item.pageViewsCount > 0 ?('Last Viewed on ' + displayDate(item.callsheetInvitationSent?item.callsheetInvitationSent.lastPageViewedAt : null)) : (item.name + ' has not viewed the call sheet yet.')) : ('Call sheet has not been sent to ' + item.name + ' yet.')
    }

    function displayDate(date) {
       return date ? $ctrl.CPS.getCreatedAt(date, 'MMM D @ ' + $ctrl.CPS.timeFormat) : '';
    }

    function getStatus(item) {
        var tooltip = '', icon = '', text = '',
            sent = item.callsheetInvitationSent;
        if (sent && item.callsheetInvitationSentId) {
            if(item.status === $ctrl.Statuses.Confirmed){
                tooltip = 'Confirmed on ' + displayDate(item.confirmedAt);
                text = 'Confirmed';
                icon = 'green check-mark-circle';
            }
            else if ($ctrl.Statuses !== $ctrl.Statuses.Created) {
                var reason = sent.reason,
                    updatedAt = displayDate(sent.updatedAt),
                    on = updatedAt ? ('on ' + updatedAt) : '';
                switch (sent.status) {
                    case $ctrl.EmailStatus.Delivered:
                        tooltip = item.pageViewsCount > 0 ?
                            ('Last Viewed on ' + displayDate(sent.lastPageViewedAt)) :
                            ('Message has been successfully delivered to the receiving server ' + on);
                        text = item.pageViewsCount > 0 ? 'Opened' : 'Delivered';
                        icon = item.pageViewsCount > 0 ? 'blue mail-viewed' : 'green-del mail-delivered';
                        break;

                    case $ctrl.EmailStatus.Bounced:
                        if(reason && reason.indexOf('550 5.1.1') === 0){
                            tooltip = 'The email account that you tried to reach does not exist. Please try double-checking the recipient\'s email address for typos.';
                        } else{
                            tooltip = 'Receiving server could not or would not accept message ' + on + getR();
                        }
                        text = 'Bounced';
                        icon = 'purple-bo mail-bounced';
                        break;

                    case $ctrl.EmailStatus.Dropped:
                        tooltip = 'Dropped: After multiple failed attempts, we can no longer send emails to this address. Please revise the email address and resend the call sheet'; // + on + ' because: ' + reason;
                        text = 'Dropped';
                        icon = 'purple-dr mail-dropped';
                        break;

                    case $ctrl.EmailStatus.Deferred:
                        tooltip = 'Deferred ' + on + getR();
                        text = 'Deferred';
                        icon = 'green-def mail-deferred';
                        break;

                    case $ctrl.EmailStatus.Spam:
                        tooltip = 'Recipient marked message as spam ' + on;
                        text = 'Spam Report';
                        icon = 'red-sp mail-spam';

                        break;
                    case $ctrl.EmailStatus.Blocked:
                        tooltip = 'Recipient blocked ' + on + getR();
                        text = 'Blocked';
                        icon = 'red-bl mail-blocked';
                        break;

                    default:
                        tooltip = 'Last Sent on ' + displayDate(sent.createdAt); //sent
                        text = '<span class="hide-ipad">Email </span>Sent';
                        icon = 'red mail-sent';
                        break;
                }
            }
            else {
                setUnsent();
            }
        } else {
            setUnsent();
        }

        return '<span class="with-tooltip with-cursor"' +
            //'tooltip="' + tooltip + '" tooltip-placement="top"' +
            '>' + $ctrl.LCS.getISBDiv(icon, null, 'views') + ' <span>' + text + '</span></span>' +
            '<div class="tooltip tooltip-inline bottom"><div class="tooltip-inner">' + tooltip +'</div></div>' ;

        function getR(){
            return (reason? (' because: ' + reason):'');
        }
        function setUnsent() {
            tooltip = 'Call sheet has not been sent to ' + item.name + ' yet.';
            text = 'Unsent';
            icon = 'orange mail-unsent';
        }
    }

    function openProPopup(item, param, e){
        $ctrl.CPS.loadQuotaPopup($ctrl.quotaTracking, function (){}, null, null, $ctrl.compOptions, {e:e});
    }
}

