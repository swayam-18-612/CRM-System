                                '<li>Approvals synced to project.</li>' +
                                '<li>Update stripboard, call sheets, etc.</li>' +
                                '</ul>'
                        })
                };

            //Upload Videos
            case 'locationVideo':
                return {
                    desc: desc + 'upload and share location scout videos.' +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>' +
                                '<li>Upload videos from scouting.</li>'+
                                '<li>Share footage with the team.</li>' +
                                '<li>Get feedback and comments.</li>' +
                                '</ul>'
                        })
                };


            //General

            //NOT AVAILABLE on new plans
            case 'collaborators':
                return {
                    desc: desc + 'invite collaborators to add comments or edit pages.' +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>' +
