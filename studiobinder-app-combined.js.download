UserCalendarsPageCtrl.$inject = ['CalendarPageInitCtrlService','$element'];
function UserCalendarsPageCtrl( CalendarPageInitCtrlService, $element) {

    console.log('UserCalendarsPageCtrl');

    var $ctrl = this;

    $ctrl.$onInit = $onInit;
    $ctrl.$onDestroy = $onDestroy;

    function $onInit() {
        $ctrl.onInit();
    }

    function $onDestroy() {
        $ctrl.onDestroy();
    }

    $ctrl.canEditCalendar = false;
    $ctrl.productId = null;
    $ctrl.isOnProduct = false;

    $ctrl.withoutCheatSheet = true;
    $ctrl.getPageTemplate = getPageTemplate;

    $ctrl = new CalendarPageInitCtrlService($ctrl, $element, {
        hasEmptyStateBtns: false,
        moreFilterButtons: true,
    });

    function getPageTemplate() {
        return ($ctrl.withoutTopFilters ? '' : ('<nav ng-if="$ctrl.list.items.length!==0" class="filters on-top hide-print" ng-class="{\'with-side-margin\':$ctrl.list.items.length === 0}">' +
            $ctrl.getTopFilters() +
            '</nav>')) +
            //todo figure out
            '<!--' +
            '<div ng-if="!$ctrl.list.busy&&!($ctrl.list.items.length==0&&!$ctrl.search&&$ctrl.selectedFilter)" class="full-content with-fancy-scrollbar with-filters h-full">' +
            '    <div class="fancy-scrollbar vertical thin scrollable-content h-full first-scrolling-wrapper">' +
            '        <div class="tab-content" style="margin-bottom: 200px">' +
            '            <sb-calendar is-company="true" product="null" class="margin-top-half with-big-margin-bottom with-no-bg"></sb-calendar>' +
            '        </div>' +
            '    </div>' +
            '</div>' +
            '-->'
        /*  '<sb-calendar class="h-full" ' +
        //  'ng-if="$ctrl.list.items.length!==0" ' +

          'comp-options="::$ctrl.compOptions" ' +
          'is-company="::true" ' +
          'get-empty-state="$ctrl.getEmptyState()" ' +
          'calendar-id="::null" ' +
          '></sb-calendar>'*/
        //  '<div ng-if="$ctrl.list.items.length==0" class="empty-state-wrapper with-side-margin with-margin-top">' +$ctrl.getEmptyState() +'</div>';
    }
}

