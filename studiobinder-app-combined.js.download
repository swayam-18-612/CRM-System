angular.module('service.currentDashboard', [
    'apiServices.Dashboards',
    'services.stateService',
    'service.currentSettings.service'
])
.service('CurrentDashboard', CurrentDashboardFactory);
CurrentDashboardFactory.$inject = ['RootEventsService', 'DashboardsService'];
function CurrentDashboardFactory(RootEventsService, service) {
    var defaultWidgets = [{_id:'2'}, {_id:'1', isDouble: 2}, {_id:'3', isDouble: 2}, {_id:'6'}],
        defaulColumn = 3,
        dash,
        isChanging;
    return {
        service: service,
        WidgetSizes: [{id: 0, n: 'Default', i:'cal-collapse'}, {id: 1, n: 'Wider',i: 'wider', hideModile:true}, {id:2, n: 'Taller',i: 'taller'}],
        Widgets: [
            {
                _id: '1',
                icon: 'workflow',
                title: 'My Tasks',
                component: 'my-tasks',
                btnAction: 'user.taskboards',
                withPopup: true
            }, {
                _id: '3',
                icon: 'project',
                title: 'Recent Activity',
                component: 'my-activity',
                //btnAction: 'user.activity',
                withPopup: true
            },{
                _id: '2',
                icon: 'project',
                title: 'Recent Projects',
                component: 'my-projects',
                btnAction: 'user.projects',
                moreText: 'View Projects',
                withAdd: true,
                itemTitle: 'Project'
            },{
                _id: '4',
                icon: 'conversations',
                title: 'Recent Comments',
                component: 'my-comments',
                //btnAction: 'user.comments',
                moreText: 'Show all comments',
                withPopup: true
            },{
                _id: '5',
                icon: 'callsheets',
                iconLevel: 6,
                title: 'Upcoming Call Sheets',
                component: 'my-callsheets',
                //btnAction: 'user.callsheets',
                moreText: 'Show all call sheets',
                withPopup: true
            },{
                _id: '6',
                icon: 'team',
                title: 'My Team',
                component: 'my-team',
                //btnAction: 'user.myteam',
                moreText: 'Show team',
                withPopup: true,
                adminOnly: true
            },{
                _id: '7',
                icon: 'notes',
                iconLevel: 3,
                title: 'Scratchpad',
                component: 'my-scratchpad',
                bodyCls:'with-margin-top',
                withPopup: true
                //btnAction: 'user.team',
                //moreText: 'Show team'
            },
        ],
        updateDashboard: updateDashboard,
        setDashboard: setDashboard,
        getDashboard: getDashboard,
        onDashboardChanged: onDashboardChanged,
        broadcastDashboard: broadcastDashboard,
        openChangeBackgroundPopup:openChangeBackgroundPopup
    };

    function openChangeBackgroundPopup($ctrl, type, onsuccess){
        $ctrl.popupsService.open(_.extend({step: 'step2'}, dash), $ctrl.popupsService.operations.updateListWithBg, _.extend({
            quotaTypeLayout: 'fileStorage',
            service: service,
            isTreeAdd: false,
            elemType: 'DAHBOARD',
            itemTitle: 'Background',
            itemIcon: 'home',
            nameForList: 'Dashboard',
            onCurrentTreeListChangedOther: $ctrl.onCurrentTreeListChangedOther,
            onSuccess: onSuccess
        }, type ? type: {
            withBgImg: true,
            withBgGradient: true,
            withBgColor: true
        }), $ctrl.compOptions);

        function onSuccess(result) {
            //$ctrl.item.backgroundId = id;
            //$ctrl.item.backgroundImgId = 'url(' + $ctrl.BGs[id - 1].n + ')';
            onsuccess(result);
        }
    }

    function updateDashboard(changes, settings){
        if(isChanging){return;}
        isChanging = true;
        if(settings && settings.withoutDBUpdate){
            onsuccess();
        } else{
            service.update(_.extend({_id: dash._id}, changes), onsuccess, onerror);
        }

        function onsuccess() {
            setDashboard(_.extend(dash, changes), changes, settings);
            onfinally();
        }

        function onerror(err) {
            onfinally();
        }

        function onfinally(){
            isChanging = false;
        }
    }

    function setDashboard(item, changes, settings) {
        if(!item){item = {};}
        if (item && !item.widgets) {
            item.widgets = defaultWidgets;
        }
        if (item && !item.column) {
            item.column = defaulColumn;
        }
        item.widgets = _.unique(item.widgets, '_id');
        broadcastDashboard(item, changes, settings);
    }

    function broadcastDashboard(item, changes, settings) {
        dash = item;
        RootEventsService.broadcastRoot('UPDATED_DASHBOARD_ITEM', {item: item, changes: changes, settings: settings});
    }

    function onDashboardChanged(watchers, callback) {
        RootEventsService.addRootWatcher(watchers, 'UPDATED_DASHBOARD_ITEM', function (result) {
            callback(result);
        });
    }

    function getDashboard() {
        return dash;
    }
}

angular.module('user.dashboard.init.service', [
    'company.settings.init.service',
])
.service('UserDashboardInitCtrlService', UserDashboardInitCtrlService);
UserDashboardInitCtrlService.$inject = ['SettingsInitCtrlService'];
function UserDashboardInitCtrlService(SettingsInitCtrlService) {
    return function ($ctrl, $element, withFormTemplateCompileCtrlService) {
        console.log('UserDashboardInitCtrlService');

        if($ctrl.preInit) {
            $ctrl.preInit();
        }

        $ctrl.preInitSettings = preInitSettings;
        $ctrl.getSettingsTemplateInit = getSettingsTemplate;

        $ctrl = new SettingsInitCtrlService($ctrl, $element, withFormTemplateCompileCtrlService);

        return $ctrl;

        function preInitSettings() {
            $ctrl.withoutFiltersAbove = true;
            $ctrl.withLinksInFilters = true;
            $ctrl.templateType = 'dashboard';
            if($ctrl.preInitSettingsOther){
                $ctrl.preInitSettingsOther();
            }
            if($ctrl.groupTag) {
                $ctrl.getSettingsTemplate = getSettingsTemplate;
            }
        }

        function getSettingsTemplate() {
            return '<' + $ctrl.groupTag + ' block="' + $ctrl.groupTag.replace('-', '') + '"' +
                ($ctrl.isFullItem ? ' is-full-item="true"' : '') +
                ' class="clearfix display-block tab-content with-padding with-radius with-side-margin padding-bottom-80 sb-scrolling-monitor with-no-bg spacing-half-top"'+
                ($ctrl.canEdit ? 'can-edit="true"' : '') + '></' + $ctrl.groupTag +'>';
        }
    }
}

