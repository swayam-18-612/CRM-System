ShotRemovePopupCtrl.$inject = ['ListItemPopupTemplateCtrlService', '$element'];
function ShotRemovePopupCtrl(ListItemPopupTemplateCtrlService, $element) {
    var $ctrl = this;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ListItemPopupTemplateCtrlService($ctrl, $element);

    function setTemplateData() {
        $ctrl.typeS = $ctrl.item.type === 1 ? 'Shot' : ($ctrl.item.type === 2 ? 'Banner' : $ctrl.typeS);
        $ctrl.icon = 'trash';
        $ctrl.popupTitle = 'Remove '+$ctrl.typeS;
        $ctrl.withFooterBtns = true;
        $ctrl.btnText = '<span>Remove</span><span class="hide-ipad"> '+$ctrl.typeS+'</span>';
    }

    function getPopupBodyContent() {
        return '<p class="text-center">Are you sure you want to remove the selected ' + $ctrl.typeS + '</p>';
    }
}

