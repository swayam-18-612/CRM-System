                    //'counter-reset: page 1;' +
                    //'@top-center{content:env(doc-title)}' +
                   // '@bottom-right{content:counter(page) "/" counter(pages)}' +
                '}' +
            '}' +
        '</style>';
    }
}

angular.module('product.callsheet.view.component', [
    'apiServices.Callsheets',
    'apiServices.CallsheetInvitations',
    'product.callsheet.blocks.component',
    'product.callsheet.template.init.controller.service'
])
.component('callsheetView', {
    bindings:{
        pageType: '@',
        showMoreMenuLinks: '<',
        info:'<?',
        withApproval:'<?',
        getCounters: '<?',
        preLoadingService: '<?',
        viewInlineModeButtons: '<?',
        isDifferentUser: '<?'
    },
    controller: 'CallsheetViewCtrl'
})
.controller('CallsheetViewCtrl', CallsheetViewCtrl);
CallsheetViewCtrl.$inject = [ 'CallsheetTemplateInitControllerService', 'ResourcePathsService', 'CallsheetInvitationsService', '$element'];
function CallsheetViewCtrl(CallsheetTemplateInitControllerService,  ResourcePathsService, CallsheetInvitationsService, $element) {
    console.log('CallsheetViewCtrl');
    var $ctrl = this,
    cls = 'preview-callsheet centering topbox clearfix position-relative with-bottom-xs';

    $ctrl.CallsheetInvitationsService = CallsheetInvitationsService;
    $ctrl.ResourcePathsService = ResourcePathsService;

    $ctrl.pageClass = 'callsheetsPage';

    $ctrl.confirm = confirm;
    $ctrl.getTitle = getTitle;
    $ctrl.sendCallsheet = sendCallsheet;
    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.getItemTemplate =  getItemTemplate;
    $ctrl.onPageLoaded = onPageLoaded;
    $ctrl.onSetViewMode = onSetViewMode;
    $ctrl.getBtnActionCls = getBtnActionCls;

    $ctrl.isViewMode = isViewMode;
    $ctrl.setViewMode = setViewMode;

    $ctrl = new CallsheetTemplateInitControllerService($ctrl, $element);

    function getBtnActionCls(){
        return 'btnActionView';
    }

    function isViewMode(val) {
        return $ctrl.viewMode === val;
    }

    function setViewMode(val) {
        $ctrl.onSetViewMode();
        set(false);
        $ctrl.viewMode = $ctrl.ViewModes[val];
        $ctrl.onSetViewMode();
        set(true);

        function set(isAdd) {
            $ctrl.LCS[isAdd ? 'addClass' : 'removeClass']($ctrl.element.querySelector('.view-resolution-buttons .btn[data-info="' + $ctrl.viewMode + '"]'), 'active');
        }
    }
    function preInit() {
        $ctrl.canEdit = false;
    }

    function onSetViewMode(){
        $ctrl.reloadTemplate();
    }

    function postInit() {
        $ctrl.LCS.addClass($ctrl.element, 'callsheet-view clearfix display-block h-full');
        $ctrl.viewInlineModeButtons = $ctrl.viewInlineModeButtons === 'true' || $ctrl.viewInlineModeButtons === true;
        $ctrl.shortUrl = $ctrl.LCS.shortUrl;

        $ctrl.ViewModesDrp = [
            {value: 1, text: 'Desktop'},
            {value: 2, text: 'Mobile'},
            {value: 3, text: 'Inbox'},
            {value: 4, text: 'SMS'}
        ];

        if ($ctrl.info) {
            var pixelPageCalltimePath = $ctrl.API_CONFIGS.server.pixelPageCalltimePath;
            $ctrl.setCreatedBy($ctrl.info.createdBy);
            if ($ctrl.withApproval) {
                $ctrl.pagePixelPath = $ctrl.ResourcePathsService.getCallsheetPath($ctrl.defaultParams) + '/shared/' + $ctrl.info._id + pixelPageCalltimePath;
            }

            if($ctrl.pageType === 'confirm') {
                $ctrl.pagePixelPath = $ctrl.ResourcePathsService.getCallsheetPath($ctrl.defaultParams) + '/' + $ctrl.info._id + '/' + $ctrl.info.callsheetInvitationSentId + pixelPageCalltimePath;

                //count as view only if the user is not the creator or is the creator and its in own callsheet
                $ctrl.countAsView = $ctrl.createdBy._id !== $ctrl.CPS.userId ||
                    $ctrl.createdBy._id === $ctrl.CPS.userId && $ctrl.info.cast.userId === $ctrl.CPS.userId;

                try {
                    $ctrl.senderIsRecipient = $ctrl.createdBy.email === $ctrl.info.cast.email;
                } catch (e) {

                }
            }
        }
        else  if ($ctrl.withApproval) {
            $ctrl.loadrevoke = true;
        }

        $ctrl.setCallsheet($ctrl.callsheet);
    }

    function onPageLoaded(){
        console.log('onPageLoaded');
        $ctrl.bindActions(true);
        if($ctrl.pageType === 'edit' || $ctrl.pageType === 'preview'){

            $ctrl.removeWatcher($ctrl.sendCallsheetWatcher);
            $ctrl.sendCallsheetWatcher = $ctrl.addRootWatcher('SEND_CALLSHEET', setSendCallsheetIntro);

        }
        if($ctrl.pageType === 'edit') {
            $ctrl.removeWatcher($ctrl.setViewModeWatcher);
            $ctrl.setViewModeWatcher = $ctrl.addRootWatcher('SET_VIEW_MODE', setViewModeIntro);
        }

        if(typeof($ctrl.onPageLoadedOther) === 'function') {
            $ctrl.onPageLoadedOther();
        }
    }

    function setSendCallsheetIntro(){
        $ctrl.openSendCallsheetPopup();
    }

    function setViewModeIntro(result) {
        var type = result.type, intro = result.intro,
            isViewMode = $ctrl.isViewMode($ctrl.ViewModes[type]),
            isEnd = result.isEnd;
        if (!isViewMode) {
            $ctrl.setViewMode(type);
            if(!isEnd) {
                intro._steps[intro.currentStep()].element = $ctrl.element.querySelector('.btnActionView[data-info="' + type + '"]');
                intro.refresh();
                $ctrl.LCS.timeout(set, 100);
            }
        } else {
            if(!isEnd) {
                set();
            }
        }

        function set() {
            $ctrl.LCS.addClass($ctrl.element.querySelector('.wrapper-view'), 'introjs-showElement introjs-relativePosition');
        }
    }

    function getDownloadHref() {
        return 'type="button" data-type="download"';//($ctrl.CPS.isUserPath ? 'download' : 'downloadAnonLink')
    }

    function getD(noTxt, inline, cls) {
        return getBtn1(noTxt, inline, 'download', 'Download PDF', 'download-pdf', 5, cls);
    }

    function getEdit(noTxt, inline) {
        return getBtn1(noTxt, inline, 'goToEdit', 'Edit Call Sheet', 'pencil', 2, 'hide-lower1024');
    }

    function getBtn1(noTxt, inline, type, txt, icon, iconLevel, cls1) {
        var cls = inline ? 'fixed-layout table-div' : ('pull-left btn btn-small primary-faded without-text with-margin-right ' + (cls1||''));
        return (inline ? '<li>' : '') + '<'+(inline ? 'a' : 'button type="button"') + ' class="' + $ctrl.getBtnActionCls() + ' ' + cls + '" data-type="' + type + '" analytics-on analytics-action="'+txt+'"' +
            (noTxt ? ('tooltip-placement="bottom" tooltip='+txt+'"') : '') +
            '>' +
            (inline ? (
                '<div class="col30' + (noTxt ? '' : ' with-margin-right') + '">' + getI() + '</div>' +
                (noTxt ? '' : ('<div><div class="with-ellipsis">' + txt + '</div></div>'))
            ) : (getI('pull-left') + (noTxt ? '' : ('<span class="with-margin-right">' + txt + '</span>')))) +
            '</'+(inline?'a':'button')+'>' + (inline ? '</li>' : '');
        function getI(cls) {
            return $ctrl.LCS.getISBDiv(icon, iconLevel, cls);
        }
    }

    function getCheatSheetBtn(){
        return '<cheat-sheet-button class="table-cell centered col40 with-padding-left hide-lower1024" btn-class="btn btn-small primary-faded without-text"></cheat-sheet-button>';
    }

    function getMore( ) {
        //Edit, Confirmations, Download PDF, Request Approval
return '<div dropdown class="pull-right position-relative one-line-tooltip dropdown with-margin-left show-lower1024">' +
        '<button id="btnSettings" type="button" class="btn btn-small primary-faded without-text dropdown-toggle" dropdown-toggle tooltip="More" tooltip-placement="bottom" aria-haspopup="true" aria-expanded="false" analytics-on analytics-action="More Settings">'+$ctrl.LCS.getISBDiv('horizontal-dots', 3, 'centered')+'</button>' +
        '<div class="dropdown-menu side-menu fadeInDownLeft with-overflow drpSettings" role="menu">' +
            //'<div class="header-small clearfix spacing-half-top padding-left20">More Options</div>' +
            '<ul class="listitems-selector with-checked">' +
               getBtn1(false, true, 'sendCallsheet', 'Send Call Sheet', 'paper-plane', 2) +
               getEdit(false, true) +
                (($ctrl.pageType === 'confirm'||$ctrl.pageType === 'preview') ? '' : getD(false, true))+
    '<cheat-sheet-button li="true"></cheat-sheet-button>' +
            '</ul>' +
        '</div>' +
    '</div>';
    }
    
    function getDownloadRow() {
        if($ctrl.isDifferentUser&&!$ctrl.callsheetPDFs){return '';}
        return '<div class="preview-callsheet centering dowload-pdf-section visible-xs hide-print">'+
                    '<div class="text-center spacing-half">' +
                        '<a class="btn btn-small transparent" analytics-category="Download PDF" analytics-on ' + getDownloadHref() + '>Download PDF</a>' +
                    '</div>' +
              '</div>';
    }

    function getItemTemplate() {
        if (!$ctrl.callsheet) {
        return '<div class="tab-content spacing margin-top-half">' +
                    '<h3 class="spacing-half-bottom">Invalid Call Sheet</h3>' +
                    '<div class="text-center">This call sheet has been either removed or you don\'t have sufficient permissions to access it.</div>' +
               '</div>';
        }

        return getNav() +
            getViewInlineModeBtns() +
            getC();

        function getNav() {
            if($ctrl.pageType === 'edit'){return '';}
            var hasNav = !$ctrl.loadrevoke && ($ctrl.senderIsRecipient || !$ctrl.senderIsRecipient && (!$ctrl.isDifferentUser || $ctrl.isDifferentUser && ($ctrl.callsheetApproval || $ctrl.callsheetPDFs)));
            if (!hasNav) {
                return '';
            }

            return '<nav class="filters on-top hide-print">' +
                (($ctrl.isDifferentUser || $ctrl.pageType === 'confirm') ?
                    ('<div class="top-logo pull-left callsheet-confirm"><a class="logo with-no-padding" analytics-on analytics-action="home icon" href="'+$ctrl.CPS.websiteUrl+'" target="_blank"><div class="navbar-brand gradient-linear-accent"><div class="logoTopLoggedIn with-bg-image"></div></div></a></div>') :
                    ('<div class="pull-left">' +
                        ($ctrl.pageType === 'preview' ?
                            ('<a class="' + $ctrl.getBtnActionCls() + ' with-line-height semibold" data-type="goToStats" analytics-on analytics-action="View Confirmations">'+
                                $ctrl.LCS.getISBDiv('back', 2, 'sbf14') + '<span class="with-margin-left hide-ipad">Confirmations</span>' +
                                '</a>') : getLeftBtns()) +
                        '</div> ')) +
                /*           template += '<span ng-if="::$ctrl.CPS.isAuthenticated" class="hide-lower1024 hide-print"><a ui-sref="user.dashboard($ctrl.CPS.currentPathParams())" analytics-on analytics-action="Projects">Projects</a> '+$ctrl.LCS.getISBDiv('forward',2)+'</span>' +
                               ($ctrl.CPS.product ? ('<span class=" '+($ctrl.CPS.isAuthenticated?'':'inactive')+'"><a ui-sref="user.product.overview($ctrl.CPS.currentProductPathParams())" tooltip-placement="bottom" tooltip="\''+($ctrl.CPS.product.name.length>20?$ctrl.CPS.product.name:'')+'\'">'+$ctrl.CPS.product.name.substring(0,20)+'</a><span class="sbf forward" ></span></span>') : '') +
                               '<a ui-sref="user.product.callsheets-list($ctrl.CPS.currentProductPathParams())" analytics-on analytics-action="Callsheets" tooltip-placement="bottom" tooltip ="Call Sheets">...</a>'+$ctrl.LCS.getISBDiv('forward',2) +
                               '<a ng-href="{{$ctrl.CPS.getStateHref(\'user.product.callsheet.\' + ($ctrl.callsheet.status != $ctrl.Statuses.Draft ? \'confirmations\' : \'edit\'), $ctrl.CPS.currentProductPathParams({ callsheetId : $ctrl.callsheetId}))}}" tooltip-placement="bottom" tooltip ="\''+($ctrl.callsheet.status !== $ctrl.Statuses.Draft ? 'View Recipients' : $ctrl.callsheet.title)+'\'">...</a>'+$ctrl.LCS.getISBDiv('forward',2)
                */
                '<div class="pull-left one-line-tooltip"><span class="'+($ctrl.pageType === 'confirm' ? '' : 'left-separator ') +' text-info-count with-line-height pull-left"><span tooltip="'+$ctrl.callsheet.title+'" tooltip-placement="bottom">'+getTitle()+'</span></span></div>' +
                getRightButtons() +
                '</nav>';

            function getRightButtons() {
                var x = '';
                if ($ctrl.isDifferentUser) {
                    x = getD(true);
                } else {
                    var status = $ctrl.callsheet.status === $ctrl.Statuses.Draft ? 'Send' : 'Resend',
                        isP = ($ctrl.pageType === 'confirm' || $ctrl.pageType === 'preview'),
                        txt = status + ' Call Sheet';
                    x = (isP ? getD(true) : (
                            '<button type="button" class="' + $ctrl.getBtnActionCls() + ' hide-ipad pull-left btn btn-small primary with-margin-right without-text" ng-class="{\'col160\':$ctrl.LCS.getWindowWidth()>1024}" data-type="sendCallsheet" analytics-on analytics-action="Open  ' + txt + '" ' + ($ctrl.LCS.getWindowWidth()<1024?( 'tooltip="' + txt + '" tooltip-placement="bottom"' ): '' ) + '>' + $ctrl.LCS.getISBDiv('paper-plane', 2, 'pull-left') +
                            ' <div class="hide-lower1024">' + txt + '</div></button>' +
                            getEdit(true) +
                            getD(true)
                        )) +
                        getCheatSheetBtn() +
                        ($ctrl.CPS.isUserPath && !isP ? getMore() : '') ;
                }
                return '<div class="text-right sidebuttons position-relative hide-print pull-right">' + x + '</div>';
            }

            function getLeftBtns() {
                return '<div dropdown class="position-relative dropdown dropdown-wrapper">' +
                    '<button id="btnFilters" type="button" class="btn btn-small without-text transparent noborder dropdown-toggle semibold with-bg" dropdown-toggle>' +
                    '<span class="txt pull-left">View Call Sheet</span> <div class="sbf down-arrow pull-right"></div>' +
                    '</button>' +
                    '<div class="dropdown-menu side-menu fadeInDownLeft drpProjectsFilter" role="menu">' +
                    '<ul class="listitems-selector with-checked">' +
                    '<li><a class="active"><div class="with-padding-right with-ellipsis">View Call Sheet</div>' + getCheck() + '</a></li>' +
                    '<li><a class="' + $ctrl.getBtnActionCls() + '" data-type="goToStats"><div class="with-padding-right with-ellipsis">Confirmations</div>' + getCheck() + '</a></li>' +
                    '</ul>' +
                    '</div>' +
                    '</div>';

                function getCheck(){
                    return '<div class="checkmark centered">'+$ctrl.LCS.getISBDiv('check-mark', 2, 'primary')+'</div>';
                }
            }
        }

        function getViewInlineModeBtns() {
            if ($ctrl.isDifferentUser || !$ctrl.viewInlineModeButtons) {
                return '';
            }
            return '<nav class="filters on-top hide-print view-resolution-buttons hide-ipad">' +
                '<div class="centered">' +
                getBtn('Desktop', 'desktop', 3) +
                getBtn('Mobile', 'mobile') +
                getBtn('Inbox', 'inbox') +
                getBtn('SMS', 'note-dots') +
                //getDownloadBtn()  +
                '</div>' +
                '</nav>';

            function getDownloadBtn() {
                return '<div >' +
                    '<a class="' + $ctrl.getBtnActionCls() + ' group-btns btn-top btn btn-small transparent without-text" ' + getDownloadHref() + 'analytics-on analytics-action="Download PDF" tooltip-placement="bottom" tooltip="Download PDF">' + $ctrl.LCS.getISBDiv('download-pdf', 5, 'gray') + '</a>' +
                    '</div>';
            }

            function getBtn(type, icon, iconLevel) {
                return '<div tooltip-placement="top" tooltip="' + type + ' View">' +
                    '<a ' +
                    'class="' + $ctrl.getBtnActionCls() + ' group-btns btn-top btn btn-small transparent without-text' +
                    ($ctrl.isViewMode($ctrl.ViewModes[type]) ? ' active' : '') + '' +
                    '" ' +
                    // 'ng-class="{\'active\':$ctrl.isViewMode($ctrl.ViewModes.' + type + ')}" ' +
                    'data-type="setViewMode" data-info="' + type + '" analytics-on analytics-action="Preview ' + type + '">' + $ctrl.LCS.getISBDiv(icon, iconLevel ? iconLevel : 2, 'gray') + '</a>' +
                    '</div>';
            }
        }

        function getC(){
            var  t = '';

            $ctrl.element.setAttribute('data-view-mode',
                $ctrl.viewMode === $ctrl.ViewModes.Mobile || $ctrl.viewMode === $ctrl.ViewModes.SMS ? 2 :0);

            if ($ctrl.isViewMode($ctrl.ViewModes.Inbox)) {
                t += getEmailView();
            } else if ($ctrl.isViewMode($ctrl.ViewModes.SMS)) {
                t += getSmsView();
            }else {//desktop & mobile
                if (!$ctrl.loadrevoke) {
                    t += getHtmlView();
                }else{
                    t += getApprovalRevoked();
                }
            }
          //  t += getDownloadRow();

            return ($ctrl.isViewMode($ctrl.ViewModes.Desktop) || $ctrl.isViewMode($ctrl.ViewModes.Inbox))? (
                '<div class="full-content with-fancy-scrollbar h-full with-filters-above show-scrollbar-on-hover"><div class="fancy-scrollbar vertical scrollable-content h-full first-scrolling-wrapper">' + t + '</div></div>') : t;

            function getHtmlView() {
                var withC = $ctrl.pageType === 'confirm' || $ctrl.pageType === 'preview',
                    template = '<div id="htmlView" class="preview-div spacing-half template-wrapper' +
                    ($ctrl.isViewMode($ctrl.ViewModes.Mobile) ? ' preview-mobile preview-simulation' : '') + '"' +
                    ' ng-class="{\'preview-mobile\':$ctrl.LCS.isMobileSize}"' +
                    '>' +
                    '<div class=" centering" ng-class="{\'preview-frame-content\':!$ctrl.LCS.isMobileSize}"' +
                    '>' +
                    '<div class="preview-viewport wrapper-view h-full position-relative">';
                if ($ctrl.withApproval && $ctrl.isDifferentUser && $ctrl.callsheetApproval && $ctrl.info && ($ctrl.info.type === 2)) {
                    template += '<callsheet-approvals class="sectionApprovals for-approver hide-print" callsheet-id="::$ctrl.callsheet._id"></callsheet-approvals>';
                }
                template += getConfirmationRow(withC);

                var showWatermark = ($ctrl.callsheet.status === $ctrl.Statuses.Draft && !$ctrl.callsheet.callsheetSentId) || $ctrl.callsheet.status !== $ctrl.Statuses.Draft && !$ctrl.callsheetBuilder && !$ctrl.senderIsRecipient,
                    other = (showWatermark?'show-watermark="true"' :'')+
                        (withC ? ' info="::$ctrl.info" ' : '') +
                        'class="display-block clearfix"';

                template += $ctrl.getCallsheetBlocksTemplate(other);

                if (!$ctrl.isDifferentUser) {
                    //      template += '<callsheet-approvals class="sectionApprovals hide-print" ng-if="!$ctrl.isViewMode($ctrl.ViewModes.Mobile)" ng-show="$ctrl.list.items.length > 0 || $ctrl.callsheetApproval" callsheet-id="$ctrl.callsheetId"></callsheet-approvals>';
                }

                template += '</div>' +
                    '</div>' +
                    '</div>';

                if ($ctrl.pagePixelPath && $ctrl.isDifferentUser) {
                    template += '<img src="' + $ctrl.pagePixelPath + '" style="opacity:0;position:absolute;z-index: -100"/>';
                }

                return template;

                function getConfirmationRow(withC) {
                    if (!withC || !$ctrl.info){
                        return '';
                    }
                    var cs = $ctrl.getCallsheetTypeInfo($ctrl.callsheet, false),
                        isConfirmed = $ctrl.info.status === $ctrl.Statuses.Confirmed,
                        imgU = ($ctrl.createdBy ? ('<div class="img-col">' + $ctrl.security.getUserImageComponent('$ctrl.createdBy', 'small') + '</div>') : ''),
                        imgC = $ctrl.security.getCompanyImage(40),
                        t = '<div class="' + cls + ' confirmation-row ' + ($ctrl.info.personalNote ? 'no-padding-bottom' : '') + '">' +
                            '<div class="table-div full-width">' +
                            '<div class="col40 vtop centering">' + imgC + '</div>' +
                            '<div class="text-confirm centered padding-left-10">Hi ' + ($ctrl.info.cast.name ? $ctrl.info.cast.name.split(' ')[0] : '') +
                            '. Your ' + getCalltime1($ctrl.info.getCustomTime($ctrl.info.calltime, $ctrl.CPS.timeFormat, true)) + '. ' +
                            '<span class="confirmedcontent">' + (isConfirmed ? getConfirmed(cs) : getUnconfirmed(cs)) + '</span>' +
                            '</div>' +
                            '<div class="col170 centered confirmedcontentbtn">' + (isConfirmed ? getConfirmedBtn(cs) : getUnconfirmedBtn(cs)) + '</div>' +
                            '</div>' +
                            '</div>' +
                            getP();

                    if($ctrl.countAsView) {
                        t += '<img alt="" src="' + $ctrl.pagePixelPath + '" style="opacity: 0;position: absolute;z-index: -100"/>';
                    }

                    return t;

                    function getUnconfirmedBtn(cs){
                        //todo check if the callsheet has been sent
                        if(!$ctrl.info.callsheetInvitationSentId){

                        }

                        return (hasCallsheetTracking() && $ctrl.callsheet.callsheetSentId ? ('<button class="' + $ctrl.getBtnActionCls() + ' btn btn-small primary without-text col160 height40 ' + $ctrl.pageClass + '" ng-class="{\'disabled\': $ctrl.isUpdating||!$ctrl.info.callsheetInvitationSentId}" type="button" data-type="confirm"' +
                            ($ctrl.info.callsheetInvitationSentId ?'': ('tooltip="The call sheet has not been sent yet to this recipient." tooltip-placement="bottom"')) +
                            '><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span>'+$ctrl.LCS.getISBDiv('check-mark-circle', 2, 'primary pull-left', 'ng-show="$ctrl.isUpdating === false"')+' Confirm '+cs+'</button>') : '');
                    }

                    function getUnconfirmed(cs) {
                        return (hasCallsheetTracking() ? ('<span class="italic"><br/>Please <span class="semibold">confirm</span> you received this '+cs.toLowerCase()+'.</span>') : '') +
                            $ctrl.LCS.getErrorBlock();
                    }

                    function hasCallsheetTracking(){
                        return true;
                        //allow displaying btns even if doesn t have         callsheetTracking                                       //is view recipient page
                        return ($ctrl.CPS.hasQuotaType('callsheetTracking') || $ctrl.SBStateService.currentState.name.indexOf('preview-recipient')!==-1);
                    }

                    function getCalltime1(t) {
                        return $ctrl.getCallsheetTypeInfo($ctrl.callsheet, true).toLowerCase() +
                            ' for <br class="show-ipad"/><span class="timef">' + $ctrl.CPS.getCreatedAt($ctrl.callsheet.startDate, $ctrl.CPS.dateFormat) + '</span> is <span class="timef">' + t + '</span>';
                    }

                    function getP(){
                        return $ctrl.info.personalNote ?
                            ('<div class="'+cls+' message-row">' +
                                '<div class="table-div full-width">' +
                                '<div class="col40 vtop centering">'+imgU+'</div>' +
                                '<div class="text-confirm centered padding-left-10">' +
                                '<div class="headerm full-width"><span class="uppercase">Message from ' + $ctrl.info.createdBy.name + '</span><br class="show-ipad"/> <span class="with-parenthesis">only you can see this</span></div>' +
                                '<div class="message htmlcontent word-wrap">' + $ctrl.info.personalNote + '</div>' +
                                '</div>' +
                                '</div>' +
                                '</div>') : '';
                    }
                }
            }

            function getEmailView(){
                var CSSUB = $ctrl.getCallsheetTypeInfoLong($ctrl.callsheet);
                //   if (!$ctrl.emailView) {
                $ctrl.emailView = '<div class="centering email-wrapper wrapper-view">' +
                    '<div class="osx_controls"><ul><li></li><li></li><li></li></ul></div>' +
                    '<div class="subject clearfix">' + getCalltime($ctrl.CPS.getCreatedAt($ctrl.callsheet.startDate, $ctrl.CPS.timeFormat), true) + '</div>' +
                    '<div class="address1 clearfix wider-tooltip ">' +
                    '<div class="pull-left">' +
                    '<strong>'+$ctrl.createdBy.name+'</strong> <span tooltip="For maximum deliverability, emails are sent from our whitelabeled domain, but with your full name visible." tooltip-placement="bottom">&lt;no-reply@studiobinder.com&gt;</span>' +
                    '</div>' +
                    '<!-- If you want to send from a custom business email address, upgrade to the Studio plan.-->' +
                    '<div class="pull-right date">'+$ctrl.CPS.getCreatedAt($ctrl.MomentService.getUtcDateNow(), 'MMM D, YYYY')+'</div>' +
                    '</div>' +
                    '<div class="full-width centered">' +
                    '<table class="innertable full-width centered text-center fixed-layout" style="max-width: 520px; background-color: #ffffff">' +
                    '<tr class="tablewithbg" style="background-color:var(--body-bg)">' +
                    '<td class="text-center wider-tooltip" style="padding-top:15px;padding-bottom: 15px;">' +
                    ($ctrl.brandedCallsheets ? '&nbsp;': ('<div style="padding-top:15px;padding-bottom: 15px;" class="logoTopEmail bigger text-center" tooltip="Upgrade to Studio plan remove this StudioBinder branding." tooltip-placement="top"></div>')) +
                    '</td>' +
                    '</tr>' +
                    '<tr class="tablewithbg">' +
                    '<td class="tdwithradius height60">' + '&nbsp;' + '</td>' +
                    '</tr>' +
                    '<tr>' +
                    '<td class="vtop with-no-padding with-no-margin">' +
                    ((
                        //$ctrl.callsheet.logo ||
                        $ctrl.CPS.product.logo
                    )? ('<div style="margin:0 auto;min-height:100px!important;width:100px!important;max-height:100px!important;overflow:hidden!important;border-radius:4px!important;padding:0;">' +
                        $ctrl.security.getProjectImageComponent(
                            //$ctrl.callsheet.logo ? '$ctrl.callsheet' :
                            '$ctrl.CPS.product', 'medium') +
                        '</div>'): ('<img class="vbottom col70" height="67" style="height: 67px;" src="'+$ctrl.LCS.getImgUrl('email-bubble-studiobinder.png', false)+ '"/>')) +
                    '</td>' +
                    '</tr>' +
                    '<tr>' +
                    '<td style="padding: 20px 10% 20px 10%;font-family: \'Arial\';color: #383E42">' +
                    '<div class="full-width" style="font-weight:400;font-size:20px">' + CSSUB +' for “'+$ctrl.CPS.product.name+'”' +
                    '</div>' +
                    '<div class="full-width" style="font-weight:900;font-size:24px;margin-bottom:26px;margin-top:24px">'+$ctrl.CPS.getCreatedAt($ctrl.callsheet.startDate, $ctrl.CPS.dateFormat)+'</div>'+
                    '<div class="full-width" style="font-weight:900;font-size:14px;color:#383E42; text-transform: uppercase">' + $ctrl.getCallsheetTypeInfo($ctrl.callsheet, true) + '</div>' +
                    '<div class="blueish full-width " style="font-weight:900;font-size:38px;color:#2c3542" tooltip="This general call time will be replaced with the recipient’s personalized call time." tooltip-placement="top">'+$ctrl.CPS.getCreatedAt($ctrl.callsheet.startDate, $ctrl.CPS.timeFormat)+'</div><br/>' +
                    '<div style="font-size:16px;font-weight:400;margin-top:30px;margin-bottom:24px">Please click below to confirm you’ll<br/>be on '+($ctrl.callsheet.type === 1 ? 'set' : 'site')+' at this time.</div>' +
                    '<button style="cursor:default;width: 230px" class="btn btn-primary" tooltip-placement ="top" tooltip="This button will allow the recipient to view the full call sheet and confirm it.">Confirm '+CSSUB+'</button>' +
                    '</td>' +
                    '</tr>' +
                    getPrivateNote()+
                    getGeneralNote()+
                    getLocations() +
                    getAuto()  +
                    getFooter() +
                    '</table>' +
                    '</div>' +
                    '</div>';
                // }
                return $ctrl.emailView;


                function getCalltime(t, withT, withBr) {
                    return $ctrl.getCallsheetTypeInfoLong($ctrl.callsheet, true) +
                        ' for “<span class="productn">' + $ctrl.CPS.product.name + '</span>” is ' + (withBr ? '<br/>' : '') +
                        '<span class="timef">' +
                            $ctrl.CPS.getCreatedAt($ctrl.callsheet.startDate, $ctrl.CPS.dateFormat) + ' @ ' +
                            (withT ? ('<span class="blueish" tooltip="This general call time will be replaced with the recipient’s personalized call time." tooltip-placement="top">' + t + '</span>') : t) +
                        '</span>';
                }

                function getSep(){
                    return '<tr><td><div class="full-width" style="margin-bottom: 40px; margin-top: 40px;background-color:var(--body-bg);height:10px">&nbsp;</div></td></tr>';
                }

                function getLocations(){
                    return '<tr><td><div class="full-width" style="margin-bottom: 10px; margin-top: 40px;background-color:var(--body-bg);height:10px">&nbsp;</div></td></tr>' +
                        '<tr class="preview-mobile">' +
                        '<td class="centered font-general font-general-12 medium-template">' +
                        '<table class="centered" style="max-width: 400px;width:94%;">' +
                        '<tr><td style="text-align: left">' +
                        '<callsheet-locations-group class="clearfix large-column-padding display-block locationsSection tree-node with-bottom-xs preview-callsheet callsheet-table centering with-white-bg side-borders-0" data-id="null" current-list-id="null" is-mobile-mode="::true" pre-loading-service="::$ctrl.preLoadingService" block="locations" can-edit="::false" options-prop="blocks" id="sortable-CALLSHEET_LOCATION_null"></callsheet-locations-group>' +
                        '</td></tr>' +
                        '</table>' +
                        '</td>' +
                        '</tr>' +
                        '<tr><td><div class="full-width" style="margin-bottom: 40px; margin-top: 0px;background-color:var(--body-bg);height:10px">&nbsp;</div></td></tr>';
                }

                function getGeneralNote(){
                    return $ctrl.callsheet.generalNote? (getSep() +
                        '<tr>' +
                        '<td class="text-center centered">' +
                        '<table class="centered" style="max-width: 400px;width:94%;">' +
                        '<tr><td style="text-align: center">' +
                        '<div style="min-height: 40px!important;width:40px!important;max-height:40px!important;overflow:hidden!important;border-radius:6px!important;display:inline-block!important;margin:0;padding:0">' +
                        '<img class="vbottom" height="40"  width="40" src="'+($ctrl.callsheet.productionLogo ? $ctrl.security.getLogoPath($ctrl.callsheet, 'productionLogo', 200, false) : $ctrl.LCS.getImgUrl('email-bubble-studiobinder.png', false))+ '"/>' +
                        '</div>' +
                        '</td></tr>' +
                        '<tr><td>' +
                        '<div style="width:100%;padding-top:8px;  text-align:center;font-weight:900;font-size:15px;line-height:1.6;color:#2C3042">Production Notes</div>' +
                        '<div style="width:100%;padding-top:7px;  text-align:center;font-size:11px;line-height:1.6;color:#6C7393;">General announcements for everyone</div>' +
                        '</td></tr>' +
                        '<tr><td style="padding-top: 18px;padding-bottom: 14px"><div style="width:100%;height:1px;border-top:1px solid #E3ECF2">&nbsp;</div></td></tr>' +
                        '<tr><td style="text-align:left">' + $ctrl.callsheet.generalNote + '</td></tr>' +
                        '</table>' +
                        '</td>' +
                        '</tr>') : '';
                }

                function getPrivateNote(){
                    return getSep() +
                        '<tr>' +
                        '<td class="text-center centered">' +
                        '<table class="centered" style="max-width: 400px;width:94%;">' +
                        '<tr><td style="text-align: center">' +
                        '<div style="min-height: 40px!important;width:40px!important;max-height:40px!important;overflow:hidden!important;border-radius:100px!important;display:inline-block!important;background:#ebeff2;margin:0;padding:0;border:1px solid #a8b5bf;'+
                        ($ctrl.createdByImage ? '' : $ctrl.security.getStyleForColor($ctrl.createdByInit))+'">' +
                        ($ctrl.createdByImage? ('<img src="'+$ctrl.createdByImage+'" class="col40 with-no-padding with-no-margin line-height40" style="min-height: 40px!important;outline:none!important;text-decoration:none!important;border:0">') :
                            ('<h2 class="with-no-margin with-no-padding" style="color:#fff!important;line-height:40px;font-size:13px!important;font-weight:900!important">'+$ctrl.createdByInit+'</h2>')) +
                        '</div>' +
                        '</td>' +
                        '<tr><td>' +
                        '<div style="width:100%;padding-top:8px;text-align:center;font-weight:900;font-size:15px;line-height:1.6;color:#2C3042">Private Note from '+$ctrl.createdBy.name+'</div>' +
                        '<div style="width:100%;padding-top:7px;text-align:center;font-size:11px;line-height:1.6;color:#6C7393;">Only the recipient will see this</div>' +
                        '</td></tr>' +
                        '<tr><td style="padding-top: 18px;padding-bottom: 14px"><div style="width:100%;height:1px;border-top:1px solid #E3ECF2">&nbsp;</div></td></tr>' +
                        '<tr><td style="text-align: center">' +
                        '<div style="margin-left:auto;margin-right:auto;font-weight:900;font-size:11px;line-height:1;color:#886800;padding:6px 16px; border-radius:50px;background-color:#FFE799;text-transform:uppercase;display: inline-block"><span tooltip="This will be replaced with a private note for a recipient (if you added one)." tooltip-placement="top">Private Note Here</span></div>' +
                        '</td></tr>' +
                        '</table>' +
                        '</td>' +
                        '</tr>';
                }

                function getAuto(){
                    return '<tr>' +
                        '<td style="margin: 0 auto; text-align: center;padding-bottom:30px">' +
                        '<table style="max-width: 400px;width:94%; margin: 0 auto">' +
                        '<tr>' +
                        '<td style="width:40px;vertical-align: top;text-align:left;">' +
                        '<img width="33" height="33" style="height: 33px;width:33px" src="'+$ctrl.LCS.getImgUrl('email/info.svg', false)+'">' +
                        '</td>' +
                        '<td>' +
                        '<div class="font-size-12 italic full-width font-size-12" style="text-align:left;font-weight:400;line-height:1.6;color:#2c3542;font-style: italic">' +
                        'This is an automated email. Please don\'t reply.<br/> Any questions or comments for production? </br>Email us  <a href="mailto:'+$ctrl.createdByEmail+'" style="text-decoration:none">'+$ctrl.createdByEmail+'</a>' +
                        '</div>' +
                        '</td>' +
                        '</tr>' +
                        '</table>' +
                        '</td>' +
                        '</tr>';
                }

                function getFooter(){
                    return '<tr>' +
                        '<td class="text-center font-size-12" style="padding:10px 0;color:#6F7494;line-height:18px;background-color:var(--body-bg)">' +
                        '<div class="spacing bottom-branding">' +
                        '<div class="gray-logo with-bg-image text-center"></div>' +
                        '<div class="text-center margin-top-half uppercase"><a class="text-uppercase" style="font-size:11px;color:#6F7494;font-weight: normal;letter-spacing:0.5px" target="_blank" href="'+$ctrl.CPS.websiteUrl+'">Powered by '+$ctrl.API_CONFIGS.site.companyName+'</a></div>' +
                        '<div class="font-size-10 text-italic" style="font-size:11px;font-weight:normal;color:#828c94; margin-top: 6px">'+$ctrl.API_CONFIGS.site.companyName+' • ' + $ctrl.API_CONFIGS.site.address+'</div>' +
                        ' </div>' +
                        '</td>' +
                        '</tr>';
                }
            }

            function getSmsView(){
                // if(!$ctrl.smsView){
                $ctrl.smsView = '<div class="preview-div spacing-half-top template-wrapper centering preview-mobile sms">' +
                    '<div class="preview-frame-content centering">' +
                    '<div class="preview-viewport wrapper-view h-full position-relative">' +
                    '<div class="ios-messages-header">' +
                    '<div>' +
                    '<div class="circled-img-recipient"></div>' +
                    '<div class="phone-number" tooltip="This is the number we use to send text messages." tooltip-placement="bottom">+1 (323) 310-3107</div>' +
                    '</div>' +
                    '</div>' +
                    '<div class="ios-messages-wrapper">' +
                    '<div class="message from">' +
                    $ctrl.getCallsheetTypeInfo($ctrl.callsheet, true) +' for "'+$ctrl.CPS.product.name+'" is:<br/><br/>' + $ctrl.CPS.getCreatedAt($ctrl.callsheet.startDate, $ctrl.shortDateFormat)+' @ <span tooltip="This general call time will be replaced with the recipient\'s custom call time." tooltip-placement="top">' +$ctrl.CPS.getCreatedAt($ctrl.callsheet.startDate, $ctrl.CPS.timeFormat) +'</span><br/><br/>' +
                    'Please view and CONFIRM your call sheet here:<br/>' +
                    "<a tooltip-html=\"'This will be replaced with a personalized link to the recipient’s call sheet.'\" tooltip-placement='top' class='display-block'>"+$ctrl.shortUrl+"/XyaSz</a><br/><br/>" +
                    ($ctrl.brandedCallsheets ? '' : ('<div>- Sent via StudioBinder</div>')) +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>';
                //  }
                return $ctrl.smsView;
            }

            function getApprovalRevoked(){
                return '<div class="padding-bottom-40"style="padding-top:120px">' +
                    '<div class="form-wrapper long modal-content centered without-shadows">' +
                    '<div class="modal-header clearfix">' +
                    '<div class="modal-icon">'+$ctrl.LCS.getISBDiv('info', 3)+'</div>' +
                    '<h3 class="text-center">Oops! Access was revoked.</h3>' +
                    '</div>' +
                    '<div class="modal-body clearfix">' +
                    '<div class="text-center spacing-half-bottom form-wrapper centering ">Your access to this call sheet was removed. <br/>If you want to regain access, please contact the creator of this call sheet.</div>' +
                    '<div class="spacing-bottom"></div>' +
                    '</div>' +
                    '</div>' +
                    '</div>'
            }
        }
    }

    function getTitle() {
        if($ctrl.info){
            return 'Call Sheet for ' + $ctrl.info.cast.name;//$ctrl.info.cast.getName();
        }
        return 'General Call Sheet for ' + $ctrl.CPS.getCreatedAt($ctrl.callsheet.startDate, $ctrl.shortDateFormat);
    }

    function getConfirmedBtn(cs){
        return '<div class="confirmed green hide-ipad centered">' + $ctrl.LCS.getISBDiv('check-mark-circle', 2) + '</div>';
    }

    function getConfirmed(cs){
        return '<div class="confirmed-info">'+$ctrl.LCS.getISBDiv('check-mark-circle', 2, 'sbf14 green')+' <span class="text-confirm italic"> '+cs+' <span class="semibold">confirmed</span> on ' +
            $ctrl.CPS.getCreatedAt($ctrl.info.confirmedAt, $ctrl.CPS.dateTimeFormat)+'</span></div>';
    }

    function sendCallsheet(e){
        $ctrl.preventDefault(e);

        $ctrl.CPS.loadQuotaPopup('callsheetBuilder', process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});

        function process() {
            $ctrl.openSendCallsheetPopup();
        }
    }

    function confirm(e) {
        $ctrl.preventDefault(e);
        $ctrl.confirmError = '';
        if (!$ctrl.callsheetBuilder && $ctrl.senderIsRecipient) {
            process();
        }
        else {
            $ctrl.CPS.loadQuotaPopup('callsheetBuilder', process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});
        }

        function process() {
            process2();
            //allow confirming to collect stats
            //$ctrl.CPS.loadQuotaPopup('callsheetTracking', process2, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}));

            function process2() {
                $ctrl.isUpdating = true;
                $ctrl.CallsheetInvitationsService.confirmCalltime(_.extend({
                    invitationId: $ctrl.info._id,
                    cisId: $ctrl.info.callsheetInvitationSentId
                }, $ctrl.defaultParams), onsuccess, onerror);

                function onsuccess(res) {
                    var cs = $ctrl.getCallsheetTypeInfoLong($ctrl.callsheet, true);
                    $ctrl.isUpdating = false;
                    $ctrl.info.status = $ctrl.Statuses.Confirmed;
                    $ctrl.info.confirmedAt = new Date();
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.callsheetConfirm.success', 'success');
                    //$ctrl.element.querySelector('#confirmedDate').value($ctrl.CPS.getCreatedAt($ctrl.info.confirmedAt, $ctrl.CPS.dateTimeFormat))
                    var el = $ctrl.element.querySelector('.confirmedcontent');
                    if (el) {
                        el.innerHTML = getConfirmed(cs);
                    }
                    el = $ctrl.element.querySelector('.confirmedcontentbtn');
                    if (el) {
                        el.innerHTML = getConfirmedBtn(cs);
                    }
                }

                function onerror(error) {
                    $ctrl.isUpdating = false;
                    $ctrl.confirmError = $ctrl.localizedMessages.getFromError(error, 'crud.callsheetConfirm.error');
                }
            }
        }
    }

    function getMobileFrameJS(){
        $(function(){
            //Global Vars
            const globalState = {
                dateTime: {
                    meses: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'],
                    dias: ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado']
                },
                bateriaBaja: false,
                draggScreen: false
            }
            //EXtended Functions
            $.fn.extend({
                touchMov: function(config){
                    config = jQuery.extend({
                        mov: 'x',
                        movIzq: function(){},
                        movDer: function(){},
                        movUp: function(){},
                        movDown: function(){},
                        updateMovX: function(){},
                        updateMovY: function(){},
                        finishMov: function(){}
                    }, config);
                    let el = this;
                    let initCoords = { x: 0, y: 0 };
                    let movCoords = { x: 0, y: 0 };
                    let downCoords = { x: 0, y: 0 };
                    el.mousedown(function (e) {
                        initCoords = { x: e.pageX, y: e.pageY };
                        downCoords = { x: movCoords.x, y: movCoords.y };
                        el.mousemove(function (e2) {
                            globalState.draggScreen = true;
                            movCoords = { x: e2.pageX, y: e2.pageY };
                            if (config.mov === 'x') {
                                config.updateMovX(e2, (movCoords.x - initCoords.x))
                            } else if (config.mov === 'y') {
                                config.updateMovY(e2, (movCoords.y - initCoords.y))
                            }
                        })
                        el.mouseup(function (ex) {
                            if (config.mov === 'x') {
                                if (movCoords.x - downCoords.x != 0) {
                                    (movCoords.x - initCoords.x) > 0 ? config.movDer(ex) : config.movIzq(ex);
                                }
                            } else if (config.mov === 'y') {
                                if (movCoords.y - downCoords.y != 0) {
                                    (movCoords.y - initCoords.y) > 0 ? config.movDown(ex) : config.movUp(ex);
                                }
                            }
                            globalState.draggScreen = false;
                            config.finishMov(ex);
                            el.off('mousemove');
                            el.off('mouseup');
                            el.off('mouseleave');
                        })
                        el.mouseleave(function (a) {
                            if (config.mov === 'x') {
                                if (movCoords.x - downCoords.x != 0) {
                                    (movCoords.x - initCoords.x) > 0 ? config.movDer(a) : config.movIzq(a);
                                }
                            } else if (config.mov === 'y') {
                                if (movCoords.y - downCoords.y != 0) {
                                    (movCoords.y - initCoords.y) > 0 ? config.movDown(a) : config.movUp(a);
                                }
                            }
                            globalState.draggScreen = false;
                            config.finishMov(a);
                            el.off('mousemove');
                            el.off('mouseup');
                            el.off('mouseleave');
                        })
                    })
                    return this;
                },
                calendario: function(config){
                    config = jQuery.extend({
                        fecha: new Date(),
                        diaCompleto: false
                    }, config);
                    let mes = globalState.dateTime.meses[config.fecha.getMonth()];
                    let diasMes = new Date(config.fecha.getFullYear(), (config.fecha.getMonth() + 1), 0).getDate();
                    let hoy = config.fecha.getDate();
                    let primerDia = new Date(config.fecha.getFullYear(), config.fecha.getMonth(), 0).getDay();
                    this.append(`
<div class="mes">
<p class="mesName">${mes}</p>
<div class="calendarioTabla">
<div class="tablaHeader"></div>
<div class="tablaContent"></div>
</div>
</div>`
                    );
                    let header = this.find('.mes .tablaHeader');
                    let content = this.find('.mes .tablaContent');
                    globalState.dateTime.dias.map(dia => header.append(`<div class="diaName">${config.diaCompleto ? dia : dia.charAt(0)}</div>`))
                    for (var k = 0; k <= primerDia; k++) {
                        content.prepend('<div></div>');
                    }
                    for (let index = 1; index <= diasMes; index++) {
                        content.append(`<div class="diaNum ${hoy == index ? 'activo':''}">${index}</div>`);
                    }
                    return this;
                },
                fechaIcono: function(config){
                    config = jQuery.extend({
                        fecha: new Date(),
                        diaCompleto: false
                    }, config);
                    let hoy = config.fecha.getDate();
                    let dia = globalState.dateTime.dias[config.fecha.getDay()];
                    this.append(`<div class="fechaWrapper"><p class="diaNom">${config.diaCompleto ? dia : dia.substring(0, 3)}</p><p class="diaNum">${hoy}</p></div>`);
                    return this;
                },
                reloj: function(){
                    let tiempo = new Date();
                    let numeros = '';
                    for (let index = 1; index <= 12; index++) {
                        numeros += `<div class="numero" data-num="${index}"></div>`;
                    }
                    let transformHora = `calc(${(360 / 12 - 360) * tiempo.getHours()}deg + ${(30 / 60) * tiempo.getMinutes()}deg)`;
                    let transformMinutos = `calc(6deg * ${tiempo.getMinutes()} + ${(6 / 60) * tiempo.getSeconds()}deg)`;
                    let transformSegundos = `calc(6deg * ${tiempo.getSeconds()})`;
                    this.append(
                        `<div class="relojWrapper">
                        <div class="reloj">
                        <div class="numeros">${numeros}</div>
                        <div class="manecillas">
                        <div class="manecilla hora" style="transform: rotate(${transformHora});"><div class="barra"></div></div>
                        <div class="manecilla minutos" style="transform: rotate(${transformMinutos});"><div class="barra"></div></div>
                        <div class="manecilla segundos" style="transform: rotate(${transformSegundos});"><div class="barra"></div></div>
                        </div>
                        </div>
                        </div>`
                    );
                    return this;
                },
                hora: function(config) {
                    config = jQuery.extend({
                        realtime: true
                    }, config);
                    var hoy = new Date();
                    var hora = hoy.getHours();
                    if (hora < 10) hora = '0' + hora;
                    var minutos = hoy.getMinutes();
                    if (minutos < 10) minutos = '0' + minutos;
                    if (config.realtime) {
                        setInterval(() => {
                            hoy = new Date();
                            hora = hoy.getHours();
                            if (hora < 10) hora = '0' + hora;
                            minutos = hoy.getMinutes();
                            if (minutos < 10) minutos = '0' + minutos;
                            this.empty();
                            this.text(`${hora}:${minutos}`);
                        }, 1000);
                    }
                    this.text(`${hora}:${minutos}`);
                    return this;
                },
                fecha: function (config) {
                    config = jQuery.extend({
                        fecha: new Date(),
                        diaCompleto: true
                    }, config);
                    let hoy = config.fecha.getDate();
                    let dia = globalState.dateTime.dias[config.fecha.getDay()];
                    let mes = globalState.dateTime.meses[config.fecha.getMonth()];
                    this.text(`${config.diaCompleto ? dia : dia.substring(0, 3)}, ${hoy} de ${mes}`);
                    return this;
                },
            })

            //Functions
             function encendido(){
                setTimeout(() => {
                    $('.iphone').removeClass('initAnimation').addClass('powerOn');
                    setTimeout(() => {
                        $('.iphone').removeClass('powerOn').addClass('arrhe');
                        $('.mainScreen').removeClass('bloqueado');
                    }, 2000);
                }, 1000);
            }

            encendido();
            //Hora de la statusBar
            $('.statusBar .hora').hora();
            //Hora de la pantalla de bloqueo
            $('.lockScreen .hora').hora();
            //Fecha de la pantalla de bloqueo
            $('.lockScreen .fecha').fecha();

            //Touch actions
            $('.lockScreen').touchMov({
                mov: 'y',
                movUp: function(e){
                    $(e.currentTarget).siblings('.statusBar').addClass('mov');
                    $(e.currentTarget).addClass('hidden');
                    setTimeout(() => {
                        $(e.currentTarget).siblings('.statusBar').removeClass('mov');
                        $(e.currentTarget).siblings('.statusBar').find('.operador').addClass('hidden');
                        $(e.currentTarget).siblings('.statusBar').find('.hora').removeClass('hidden');
                    }, 300)
                    //Timeout para simular el agotamiento de la bateria
                    if (!globalState.bateriaBaja) {
                        setTimeout(() => {
                            alertaiOS({
                                encabezado: 'La batería se está agotando',
                                mensaje: 'Batería restante: 10%',
                                acciones: [
                                    {
                                        texto: 'Ok'
                                    }
                                ]
                            });
                            $('.mainScreen .statusBar .bateria').removeClass('mid').addClass('low');
                            globalState.bateriaBaja = true;
                        }, 3000);
                    }
                }
            });
            $('.statusBar').touchMov({
                mov: 'y',
                movDown: function (e) {
                    $(e.currentTarget).parent().addClass('blur');
                }
            });

        })

    }

