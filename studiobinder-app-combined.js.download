angular.module('public.home.component', [
    'public.home.controller.service'
])
.component('home', {
    controller:'HomeCtrl',
    bindings: {
        popupOpened: '<',
        resetPasswordToken: '<'
    }
})
.controller('HomeCtrl', HomeCtrl);
HomeCtrl.$inject = ['HomeCtrlService', '$element'];
function HomeCtrl(HomeCtrlService, $element) {
    var $ctrl = this;

    $ctrl.load = load;
    $ctrl.getHomeTemplate = getHomeTemplate;

    $ctrl = new HomeCtrlService($ctrl, $element, false);

    function load() {
        console.log('HomeCtrl');
        $ctrl.hasPopup = false;
        var popups = $ctrl.security.Popups;
        $ctrl.modalType = popups.Login;
        switch ($ctrl.popupOpened) {
            case 'login':
                $ctrl.modalType = popups.Login;
                break;

            case 'signup':
                $ctrl.modalType = popups.SignUp;
                break;

            case 'resetPassword':
                if ($ctrl.resetPasswordToken && $ctrl.resetPasswordToken !== '') {
                    $ctrl.modalType = popups.ResetPassword;
                }
                break;

            case 'recoverPassword':
                $ctrl.modalType = popups.RecoverPassword;
                break;

            case 'passwordChanged':
                $ctrl.modalType = popups.PasswordChanged;
                break;

            case 'contact':
                $ctrl.popupsService.open(null,$ctrl.popupsService.operations.contactUs);
                break;
        }
    }

    function getHomeTemplate() {
        return '<auth class="display-block clearfix" has-popup="::$ctrl.hasPopup" modal-type="::$ctrl.modalType" show-header="::$ctrl.showHeader" style="min-height:470px"></auth>';
    }
}

angular.module('public.home.controller.service', [
])
.service('HomeCtrlService', HomeCtrlService);
HomeCtrlService.$inject = ['TemplateCompileCompCtrlService'];
function HomeCtrlService(TemplateCompileCompCtrlService) {
    return function ($ctrl, $element, withoutTemplateScope) {

        $ctrl.preInit = preInit;
        $ctrl.getItemTemplate = getItemTemplate;

        $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);
        return $ctrl;

        function preInit() {
            $ctrl.preload = $ctrl.SBStateService.$stateParams.preload;

            if (!$ctrl.getHomeTemplate) {
                console.warn('Parent for HomeCtrlService must define $ctrl.getHomeTemplate');
            }

            $ctrl.isSB = $ctrl.LCS.isSB;

            if (typeof ($ctrl.load) === 'function') {
                $ctrl.load();
            }
        }

        function getItemTemplate(){
            if($ctrl.preload) {
                return '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
            }

            return '<div class="with-fancy-scrollbar h-full show-scrollbar-on-hover">' +
                        '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper flex-block">' +
                            '<div class="flowing">' +
                                '<div class="loginw full-width">' +
                                    '<div class="form-wrapper long modal-content centered margin-top">' + $ctrl.getHomeTemplate() + '</div>' +
                ($ctrl.isSB ? '' :  ('<div class="bottom-branding">' +
                                        '<!--<div class="gray-logo with-bg-image text-center"></div>-->' +
                                        '<div class="margin-top-half"><a href="https://www.studiobinder.com" target="_blank">Powered by StudioBinder Inc.</a></div>' +
                                        '<div class="tag-line text-center">Production Management for Creatives.</div>' +
                                    '</div>')) +
                                '</div>' +
                            '</div>' +
                            ($ctrl.isSB ? '<footer class="footer fixed footer_logged"></footer>' :'') +
                        '</div>' +
                    '</div>';
        }
    }
}

angular.module('public.home', [
    'public.home.routing'
]);
angular.module('public.home.routing', [
    'public.home.component'
])
.config(HomeRouting);

HomeRouting.$inject = ['$uiRouterProvider'];
resetPasswordToken.$inject = ['$transition$'];

function HomeRouting($uiRouter) {
    addStates($uiRouter, [
        {name: 'home', url: null, title: 'StudioBinder', type: 'login'},
        {name: 'login', url: 'login?redirectUrl&preload', title: 'Login', type: 'login'},
        {name: 'recoverPassword', url: 'recoverPassword', title: 'Recover Password', type: 'recoverPassword'},
        {name: 'register', url: 'register', title: 'Register', type: 'signup'},
        {name: 'resetPassword', url: 'resetPassword/:resetPasswordToken', title: 'Reset Password', type: 'resetPassword'},
        {name: 'passwordChanged', url: 'passwordChanged', title: 'Password Changed', type: 'passwordChanged'},
        {name: 'callbackAuth', url: 'callbackAuth', title: 'Login Oauth', type: 'twitter-callback'}
    ], function (state) {
        var resolve = {
            popupOpened: function () {
                return state.type;
            },
            resetPasswordToken: resetPasswordToken
        };
        return {
            name: 'public.' + state.name,
            url: state.url,
            data: {
                bodyClass: 'home-page usecases',
                title: state.title
            },
            views: {
                publicview: 'home'
            },
            resolve: resolve,
        };
    });
}

function resetPasswordToken($transition$) {
    var params = $transition$.params();
    return params ? params.resetPasswordToken : null;
}

