angular.module('product.preLoading.strips.service', [
    'product.preLoading.resource.service',
    'apiServices.Strips',
    'product.preLoading.taggingElements.service',
    'product.preLoading.locations.service',
    'sb.fields.methods.service'
])
    .service('StripsLoadingService', StripsLoadingService);

StripsLoadingService.$inject = ['PreloadingResourceService', 'StripsService', 'TaggingElementsLoadingService','LocationsLoadingService', 'SBFieldMethods'];
function StripsLoadingService(PreloadingResourceService, objectService, TaggingElementsLoadingService, LocationsLoadingService, SBFieldMethods ) {
    var _this = new PreloadingResourceService(objectService, {
        name: 'Strips',
        tableParamsColsInit: ['companyId', 'productId', 'scriptId']
    });

    _this.getPreById = getPreById;
    _this.setUpdateFromStrip = setUpdateFromStrip;
    _this.populateStrip = populateStrip;

    _this.getNewSceneNumber = _this.service.getNewSceneNumber;

    return _this;

    function getPreById(tableParams, id, settings) {
        var item = _this.service.getObjectById(tableParams, _this.tableType, id), locations, stripEls;
        if(settings){
            if(settings.locations){
                locations = settings.locations;
            }

            if(settings.stripEls){
                stripEls = settings.stripEls;
            }
        }

        if(!stripEls){
            stripEls = TaggingElementsLoadingService.getElementsForStrip(tableParams, id);
        }

        if(!locations) {
            locations = LocationsLoadingService.getLocationsForStrip(tableParams, item);
        }

        return _this.populateStrip(item, locations, stripEls);
    }

    function populateStrip(item, locations, stripEls) {
        var characterCategoryId = "5a69235edf0fbc89a637c1ab";
        var stripLocationCategoryId = "5a69235fdf0fbc89a637c1c1";
        if (!item) {
            return item;
        } //these are added based on elements
        item.stripLocation = stripEls ? _.find(stripEls, {categoryId: stripLocationCategoryId}) : null;
        item.stripLocationId = item.stripLocation ? item.stripLocation._id : null;

        item.elements = stripEls ? (stripEls.length - (item.stripLocationId ? 1 : 0)) : 0;

        //these are added based on elements
        item.characters = stripEls ? _.filter(stripEls, {
            categoryId: characterCategoryId
        }) : null;
        item.characterIds = getListIds(item.characters);

        //based on locationIds
        item.locations = getList(item.locationIds, locations);
        item.locationIds = getListIds(item.locations);

        item.pagesDisplay = SBFieldMethods.getPagesDisplay(item);
        item.miniTitle = SBFieldMethods.getMiniTitle(item);
        item.sceneText = SBFieldMethods.getSceneText(item);
        item.color = SBFieldMethods.getColorClass(item);

        item.htmlContent = objectService.getHtmlContent(item);

        return item;

        function getListIds(list) {
            return list ? list.map(function (c) {
                return c ? c._id : null;
            }) : null;
        }

        function getList(ids, list) {
            if (ids && ids.length > 0) {
                return ids && ids.length > 0 ? _.filter(list, function (item) {
                    return _.find(ids, function(id1){return id1 ===  item._id });
                }) : null;
            }
        }
    }

    function setUpdateFromStrip(tableParams, item) {
        if (!item) {
            return;
        }
        var updates = {_id: item._id};

        if (item.type === 0) {
            updates.date = item.date;
            updates.scenes = item.scenes;
            updates.pages = item.pages;
        } else if (item.type === 1) {
            updates.scene = item.scene;
            updates.sceneType = item.sceneType;
            updates.locationIds = item.locationIds;
            updates.note = item.note;
            updates.dayTime = item.dayTime;
            updates.storyDay = item.storyDay;
            updates.pages = item.pages;
            updates.pagesCustom = item.pagesCustom;
            updates.pagesDisplay = item.pagesCustom ? item.pagesCustom : item.pages;
            updates.scriptPosition = item.scriptPosition;
            updates.allText = item.allText;
            updates.content = item.content;
            updates.description = item.description;
            updates.breakdownNotes = item.breakdownNotes;
        } else{
            updates.breakdownNotes = item.breakdownNotes;
        }

        _.each(['prepTime', 'shootTime', 'estTime', 'duration', 'time', 'endTime', 'active'], function (prop){
            updates[prop] = item[prop];
        });

        //updates.order = item.order;

        _this.service.updateItem(tableParams, _this.tableType, updates);
    }
}

addMoSePa('Strips', 'strips', TempStripsService,{
    serviceInjectList: [ 'ScriptConvertService', 'SBFieldMethods', 'TaggingElements'],
    serviceInjectMod: [
        'service.scriptConvert',
        'sb.fields.methods.service',
        'resources.TaggingElements'
    ]
})
function TempStripsService(ApiService,  model, ScriptConvertService, SBFieldMethods, TaggingElements) {
    var service = ApiService(model, {
        listType: 'isGroup',
        withScriptId: true,
        fieldsUpdatedOnOrderChanged: ['name', 'pages', 'scenes', 'scene',
            'estTime','prepTime', 'shootTime', 'duration',
            'note', 'scriptPosition', 'active', 'order'],
       // listField: 'stripsListId'
        convertOtherResources: convertOtherResources
});

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.renumberScenes = renumberScenes;

    service.getHtmlContent = getHtmlContent;
    service.getHtmlContentWithEmpty = getHtmlContentWithEmpty;
    service.parseContent = parseContent;
    service.getEditableFields =  getEditableFields;
    service.getChanges = getChanges;
    service.itemWithUpdatedSceneContent = itemWithUpdatedSceneContent;

    return service;

    function getChanges(changedFields, item, copyItem, dontCompareHashKey) {
        return service.getChangesInit(changedFields, item, copyItem, dontCompareHashKey);
    }

    function getHtmlContent(item) {
        return item ? (item.htmlContent && item.htmlContent.trim() !== '' ? item.htmlContent :  processHtmlContent(item)) : null;
    }

    function processHtmlContent(item){
        return ScriptConvertService.getHtmlContent(item.content, item.scene,
            ((item.isNotOmitted !== undefined ? item.isNotOmitted : item.active) === false))
    }

    function parseContent(item, html) {
        var result =  ScriptConvertService.parseContent(html);
        item.content = result ? result.content : null;
        item.htmlContent = html;

        return getItemFromContent(item, result);
    }

    function itemWithUpdatedSceneContent(item, isOmitted, likeOnScript) {
        item.content = getFilledContent(item, isOmitted, likeOnScript); //set new content
        var result = parseContent(item, processHtmlContent(item));
        return getItemFromContent(item,  result);
    }

    function getItemFromContent(item, result){
        item.allText = result.allText;  //uses item.content if item.htmlContent is null
        item.description = result.description;
        item.scene = result.scene;

        var name = result.content && result.content.length > 0 ? _.find(result.content, {type: 0}) : null;
        item.name = name && name.text ? name.text.toUpperCase() : null;

        return item;
    }

    function getHtmlContentWithEmpty(item, isOmitted, likeOnScript) {
        item.content = getFilledContent(item, isOmitted, likeOnScript);
        return processHtmlContent(item);
    }

    function getFilledContent(item, isOmitted, likeOnScript) {
        var content = item.content;
        if (!content) {
            content = [];
        }
        var index = _.findIndex(content, {type: 0}),
            text = SBFieldMethods.getMiniTitle(item, likeOnScript),
            par = {
                type: 0,
                // stripId: item._id,
                text: text
            };
        if (isOmitted) {
            par.isOmitted = isOmitted;
        }
        if (index > -1) {
            par.parId = content[index].parId;
            content[index] = par;
        } else {
            par.parId = SBFieldMethods.shortGuidGenerator();
            content = [par].concat(content);
        }
        return content;
    }


    function getChangedFieldForUpdateOther(){
        return ['scene', 'sceneType', 'stripLocationId','stripLocation', 'note', 'dayTime', 'characterIds', 'characters', 'locationIds', 'locations', 'pages', 'pagesCustom', 'scriptPosition', 'content', 'contentScript', 'allText', 'htmlContent', 'description', 'color', 'sceneText' , 'miniTitle', 'breakdownNotes', 'elements', 'storyDay',
            'time','estTime','prepTime','shootTime', 'duration'];
    }

    function getEditableFields(type) {
        var def = ['time', 'endTime', 'timeComp', 'endTimeComp',
                'estTime', 'prepTime', 'shootTime', 'duration'],
            el;
        switch (type) {
            case 0://$ctrl.stripTypes.DayBreak://to be updated on daybreak
                el = ['name', 'date', 'scenes', 'pages']; break;

            case 1://$ctrl.stripTypes.Scene://to be updated on scene
                el = ['scene', 'sceneType', 'stripLocationId','stripLocation', 'note', 'dayTime', 'characterIds', 'characters', 'locationIds', 'locations', 'pages', 'pagesCustom', 'scriptPosition', 'content', 'contentScript', 'allText', 'htmlContent','description', 'color', 'sceneText' , 'miniTitle', 'breakdownNotes', 'elements', 'storyDay', 'active']; break;//time ?  'order'

            case 2: //$ctrl.stripTypes.Banner://to be updated on banner
                  el =['name', 'color', 'note'];break;
        }
        return [].concat(el, def);
    }


    function convertOtherResources(item) {
        var l = item && item.locationIds && item.locationIds.length > 0 ? item.locationIds && item.locationIds.length : 0;
        if (l > 0) {
            if (typeof (item.locationIds[0]) === 'object') {
                item.locations = [];
                for (var i = 0; i < l; i++) {
                    var el = item.locationIds[i];
                    item.locations.push(new TaggingElements(el));
                    item.locationIds[i] = el._id;
                }
            }
        }
        return item;
    }

    function renumberScenes(params, successcb, errorcb){
        console.log('strips.renumberScenes');
        return service.postUrl( '/renumber-scenes', params, successcb, errorcb);
    }

}

