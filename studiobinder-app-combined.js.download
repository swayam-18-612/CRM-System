angular.module('product.print.coverpage.component.service', [
    'product.contentEditorBubblePopup.controller.service'
]) 
.service('CoverPageCtrlService', CoverPageCtrlService);
CoverPageCtrlService.$inject = ['ContentEditorBubbleCtrlService', 'SBFieldTypesService'];
function CoverPageCtrlService(ContentEditorBubbleCtrlService, SBFieldTypesService) {
    return function ($ctrl, $element, isPopup) {
        $ctrl.SBFieldTypesService = SBFieldTypesService;

        var bgColorProp = 'bgColor';
        var colorProp = 'fontColor';
        var hColorProp = 'hColor';
        var borderProp = 'border';

        $ctrl.isFullPageSize = true;
        $ctrl.customTitle = '  ';
        $ctrl.editorType = 'pagecover';
        $ctrl.dontTriggeUpdateItem = true;

        $ctrl.getColor = $ctrl.SBFieldTypesService.SBFieldMethods.getColor;
        $ctrl.getCustomStyle = $ctrl.SBFieldTypesService.getCustomStyle;

        $ctrl.onAdditionalInit = onAdditionalInit;
        $ctrl.onLoadedOther = onLoadedOther;
        $ctrl.getPopupBodyContentOther = getPopupBodyContentOther;
        $ctrl.onChangeColor = onChangeColor;
        $ctrl.onChangeStyle = onChangeStyle;
        $ctrl.onChangeBorder = onChangeBorder;
        $ctrl.processProp = processProp;
        $ctrl.getEditorEl = getEditorEl;
        $ctrl.getCSSProp = getCSSProp;

        if(!$ctrl.updateColorAndBg){
            $ctrl.updateColorAndBg = updateColorAndBg;
        }

        $ctrl = new ContentEditorBubbleCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function getCSSProp(p){
            return  $ctrl.SBFieldTypesService.getCSSProp(p, !$ctrl.isCustomNotes);
        }

        function getPopupBodyContentOther() {
            return '<div class="btnsColors" >' + get() + '</div>';

            function get() {
                return $ctrl.SBFieldTypesService.getPopupSBForm($ctrl, $ctrl.columnsList, {
                    withLabel: false,
                });
            }
        } 

        function onLoadedOther() {
            $ctrl.LCS.timeout(function () {
                if($ctrl.onLoadedOther2){
                    $ctrl.onLoadedOther2();
                }
                $ctrl.updateColorAndBg(null, true);
            }, 250);
        }

        function getEditorEl(){
            if (!$ctrl.cover) {
                $ctrl.cover = $ctrl.element.querySelector('.modal-content .modal-body');
            }

            if ($ctrl.cover && !$ctrl.editor) {
                $ctrl.editor = $ctrl.cover.querySelector('.ql-editor');
            }
            return $ctrl.editor;
        }

        function updateColorAndBg(prop1, isLoad) {
            getEditorEl();

            processProp(prop1, $ctrl.editor, colorProp);
            processProp(prop1, $ctrl.editor, hColorProp);
            processProp(prop1, $ctrl.isCustomNotes ? $ctrl.editor : $ctrl.cover, bgColorProp);
            processProp(prop1, $ctrl.isCustomNotes ? $ctrl.editor : $ctrl.cover, borderProp);

            if($ctrl.updateColorAndBgOther) {
                $ctrl.updateColorAndBgOther(isLoad);
            }
        }

        function processProp(prop1, el, prop) {
            if (!prop1 || prop === prop1) {
                var v = $ctrl.item[prop];
                if (el && v) {
                    if (!el.style) {
                        el.style = {};
                    }
                    el.style.setProperty(getCSSProp(prop), v);
                }
            }
        }

        function addTopBarProp(name, prop, val, icon, other) {
            var drp = getDrpProp(prop);
            if (!$ctrl[drp]) {
                $ctrl[drp] = other.type;
            }

            $ctrl[drp] = [].concat($ctrl[drp]);
            if(other.type === $ctrl.SBFieldMethods.Colors) {
                $ctrl[drp].push(other.value);
            }

            if (!$ctrl.Settings) {
                $ctrl.Settings = {};
            }
            if (!$ctrl.Settings[drp]) {
                $ctrl.Settings[drp] = $ctrl[drp];
            }

            if (!$ctrl.item[prop] && val) {
                $ctrl.item[prop] = val;
            }

            $ctrl.columnsList.push(_.extend({
                prop: prop,
                name: name,
                initListName: drp,
                formGroupClass: ($ctrl.isCustomNotes ? ' centered ' :  'pull-left with-margin-right ') + (other.formGroupClass || ($ctrl.isCustomNotes ? ' colordrp' : ' col30')),
                withoutLabelInPopup: true,
                withUncheck: false,
                header:  ($ctrl.isCustomNotes ? '':'Change ') + name,
                icon: icon,
                groupLabelUnder : true,
                groupLabel: name.split(' ')[0],

                drpClassAttr: $ctrl.isCustomNotes ? (' wrapper-style-drp drp-' + prop): null

                //   drpMenuCls: colCls,
            }, other.params));
        }

        function onAdditionalInit() {
            for (var prop in $ctrl.extraParam) {
                if ($ctrl.extraParam[prop]) {
                    $ctrl[prop] = $ctrl.extraParam[prop];
                }
            }

            if($ctrl.forceCanEdit){
                $ctrl.canEdit = $ctrl.forceCanEdit;
            }

            $ctrl.columnsList = [];

            if($ctrl.onAdditionalInitOther){
                $ctrl.onAdditionalInitOther();
            }

            var font = $ctrl.SBFieldMethods.FontStyles[0];

            addStyle('Style', 'styleId', font.id);

            if($ctrl.isCustomNotes) {
                addColor('Header Color', hColorProp, $ctrl.isCustomNotes ? font.hColor : 'var(--color-print)', $ctrl.isCustomNotes ? null : 'hold-filled', {
                    subheader: 'Color selected applies only to headers'
                });
            }

            addColor('Text Color', colorProp, $ctrl.isCustomNotes ? font.fontColor : 'var(--color-print)', $ctrl.isCustomNotes ? null : 'text-color', {
                groupLabel: 'Body',
                subheader: 'Color selected applies only to body text'
            });

            addColor('Background Fill', bgColorProp, $ctrl.isCustomNotes ? font.bgColor : 'var(--bg-color)', $ctrl.isCustomNotes ? null : 'background-color', {
                groupLabel: 'Fill',
                subheader: 'The background color of the text box'
            });

            addBorder('Border', borderProp, 'none');

            if(!$ctrl.field) {
                $ctrl.field = 'content';
            }
        }

        function addColor(name, prop, val, icon, other) {
            addTopBarProp(name, prop, val, icon,{
                type: $ctrl.SBFieldMethods.Colors,
                value: $ctrl.getColor(val),
                params:_.extend({
                    type: $ctrl.SBFieldTypesService.PropTypes.Color,
                    onChange: '$ctrl.onChangeColor(result)'
                }, other)
            });
        }

        function addStyle(name, prop, val, icon) {
            if(!$ctrl.hasStyle){return;}
            addTopBarProp(name, prop, val, icon,{
                type: $ctrl.SBFieldMethods.FontStyles,
                value: val,
                formGroupClass: ' styledrp',
                params:{
                    type: $ctrl.SBFieldTypesService.PropTypes.Style,
                    //drpMenuCls: 'wrap-dd-select',
                    eClassAttr: 'form-control without-underline',
                    cClassAttr: 'wrap-dd-select  long-caret',
                    fieldClass: 'without-underline',
                    itemValue: 'id',
                    itemLabel: 'h',
                    onChange: '$ctrl.onChangeStyle(result)',
                    groupLabel: 'Style'
                }
            });
        }

        function addBorder(name, prop, val, icon) {
            if(!$ctrl.hasBorder){return;}
            addTopBarProp(name, prop, val, icon,{
                type: $ctrl.SBFieldMethods.FontBorders,
                value: val,
                formGroupClass: ' borderdrp',
                params:{
                    type: $ctrl.SBFieldTypesService.PropTypes.Border,
                    //drpMenuCls: 'wrap-dd-select',
                    eClassAttr: 'form-control without-underline',
                    cClassAttr: 'wrap-dd-select  long-caret',
                    fieldClass: 'without-underline',
                    itemValue: 'id',
                    itemLabel: 'n',
                    onChange: '$ctrl.onChangeBorder(result)',
                    groupLabel: 'Border'
                }
            });
        }

        function getDrpProp(prop) {
            return prop + 'List';
        }

        function onChangeColor(result) {
            var prop = result && result.prop ? result.prop : null;
            console.log('onChangeColor: ' + prop);
            var v = result.selected ? result.selected.val : undefined;
            if (v) {
                $ctrl.item[prop] = v;
                addColorToDrp(prop, v);
                $ctrl.updateColorAndBg(prop);
            }
        }

        function onChangeStyle(result){
            var prop = result && result.prop ? result.prop : null;
            console.log('onChangeStyle: ' + prop);
            var v = result.selected ? result.selected.val : undefined;
            if (v) {
                if($ctrl.onChangeStyleOther){$ctrl.onChangeStyleOther(v);}
            }
            $ctrl.updateColorAndBg();
        }

        function onChangeBorder(result){
            var prop = result && result.prop ? result.prop : null;
            console.log('onChangeBorder: ' + prop);
            var v = result.selected ? result.selected.val : undefined;
            if (v) {
                $ctrl.item[prop] = v;
            }
            $ctrl.updateColorAndBg();
        }
        
        function addColorToDrp(prop, val) {
            var drp = $ctrl[getDrpProp(prop)];
            if (!_.find(drp, function (el) {
                console.log('')
                return el && el.id && el.id.toLowerCase() === val.toLowerCase();
            })) {
                var c = $ctrl.getColor(val);
                if(!c) {
                    drp.push($ctrl.getColor(val));
                }
            }
        }
    }
}

angular.module('product.print.page.popup.component', [
])
//should not pass comp options so it can be inherited from constants options
.component('printPagePopup', popupComponentParams('PrintPagePopupCtrl', true))
.controller('PrintPagePopupCtrl', PrintPagePopupCtrl);

PrintPagePopupCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];

function PrintPagePopupCtrl(TemplateCompileCompCtrlService, $element) {
    console.log('PrintPagePopupCtrl');

    var $ctrl = this;
    $ctrl.isPopup = true;

    //$ctrl.onLoaded = onLoaded;
    //$ctrl.onDestroy = onDestroy;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function getItemTemplate() {
        $ctrl.selectedParams = $ctrl.extraParam.selectedParams;
        $ctrl.printPageParams = $ctrl.extraParam.printPageParams;
        $ctrl.printPageParams.isPopup = $ctrl.isPopup;
        if ($ctrl.isPopup) {
            $ctrl.closePopup = closePopup;
            $ctrl.printPageParams.onClose = closePopup;
        }

        var c = $ctrl.extraParam.printPageParams.constantsService.CompOptions;
        var tag = (c.pageComponent || c.overviewBlockType) + '-print';//$ctrl.printPageParams ? 'print-tree-page' : 'print-page';
        return '<' + tag + ' ' +
            'print-page-params="::$ctrl.printPageParams" ' +
            'selected-params="::$ctrl.selectedParams" ' +
            'class="' + tag + ' print-mode ' + ($ctrl.printPageParams.isPageTree ? 'print-tree-page' : '') + ' display-block clearfix h-full ' + tag + '"' +
            '></' + tag + '>';

        function closePopup(result, id) {
            console.log('closePopup');
            $ctrl.onClose(result, id);
        }
    }
}

angular.module('product.print.sidebar.component', [
    'product.print.options.controller.service',

    'ctrl.PopupsCtrl.columnSettings.component'
])
.component('printSidebar', {
    bindings: {
        optionsStr: '<',
        listTreeService: '<',
        compOptions: '<',
        customGridSetting: '<',
        onSidebarChanges: '&',
        getCustomContent: '&',
        onDownload: '&',
        onClose: '&',
        preChangeColumn: '&'
    },
    controller: 'PrintSidebarCtrl',
})
.controller('PrintSidebarCtrl', PrintSidebarCtrl);
PrintSidebarCtrl.$inject = ['PrintOptionsCtrlService', '$element'];
function PrintSidebarCtrl(PrintOptionsCtrlService, $element) {
    var $ctrl = this;
    $ctrl.expandDefaultSectionId = 3;
    $ctrl.dontAutoloadTemplate = true;

    $ctrl.preInitGeneralOther = preInitGeneralOther;
    $ctrl.preSetTemplateDataOther = preSetTemplateDataOther;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onChangeOther = onChangeOther;
    $ctrl.getCustomContent = getCustomContent;

    $ctrl.download = download;

    $ctrl.$onChanges = $onChanges;
    $ctrl = new PrintOptionsCtrlService($ctrl, $element);

    function $onChanges(changes) {
        if (!changes) {
            return;
        }
        console.log('PrintSidebarCtrl.$onChanges');
        console.log(changes);
        var field = 'optionsStr',
            change = changes[field];
        //the init previousValue = {}
        if (change !== undefined && !angular.equals(change.currentValue, change.previousValue)) {
            loadStr(change.currentValue === undefined);
        }
    }

    function loadStr(withoutReload) {
        $ctrl.item = $ctrl.optionsStr ? JSON.parse($ctrl.optionsStr) : {};
        if (!$ctrl.item.lists) {
            $ctrl.item.lists = [];
        }

        if($ctrl.Sections && $ctrl.Sections.length > 0){
            $ctrl.Sections[1].hide = $ctrl.item.hideGridSettings;
            $ctrl.expandDefaultSectionId = $ctrl.item.dontExpandGridSettings ? null : _.find($ctrl.Sections, function (item) {
                return !item.hide;
            }).id;
        }

        if(!withoutReload) {
            $ctrl.reloadTemplate();
        }
    }

    function preSetTemplateDataOther() {
        $ctrl.icon = 'print';
    }

    function preInitGeneralOther() {

        $ctrl.Sections = [
            {name: 'Custom', id: 1, type: 2, hide: true},
            {name: 'Grid Settings', id: 2, type: 2},
            {name: 'Layout', id: 3, type: 1},
            {name: 'Style', id: 7, type: 1},
            {name: 'Page Margins', id: 8, type: 1, hide: true},
            get({name: 'Front Cover', id: 5, type: 1}),
            get({name: 'Back Cover', id: 6, type: 1}),
            get({name: 'Security', id: 4, type: 1})
        ];

        loadStr();


        function get(item){
            return _.extend({
                quotaType: 'advancedPdfBuilder'
            }, item);
        }
    }

    function getName(l) {
        return l !== 1 && $ctrl.nameForLists ? $ctrl.nameForLists : ($ctrl.nameForList + (l === 1 ? '' : 's'));
    }

    function getItemTemplate() {
        bind(false);

        console.log('PrintSidebarCtrl.getItemTemplate');
        var quota = 'pdfBuilder';
        if(!$ctrl.expandableSections) {
            return '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
        }

    return '<div class="outtercontainer show-scrollbar-on-hover">' +
                '<div class="innercontainer fancy-scrollbar sb-scrolling-monitor ultrathin medium-template callsheet-sidebar printing bg-white">' +
                    '<div class="sidebarScrollingContainer table-rewards list">' +
                        '<h3 class="text-left spacing-half-top padding-left-24 font18 sidebar-header">' +
                            'Generate ' + getName(1) + ' PDF' +
                            '<span class="with-margin-left profeature position-absolute' + ($ctrl.CPS.hasQuotaType(quota) ? ' sb-hide' : '') + '" data-quota="'+quota+'">PRO</span>'+
                            //($ctrl.count ? ('&nbsp;&nbsp;<span class="with-parenthesis">' + $ctrl.count + ' </span>') : '') +
                        '</h3>' +
                        getSidebarContent() +
                    '</div>' +
                '</div>' +
            '</div>' +
            getBtns();
    }

    function getBtns() {
        var cls = 'btn col100 btn-small';
        return '<div class="bottombtns full-width with-side-padding spacing-half fixed-layout">' +
            //'<a class="'+cls+' pull-right primary" href="javascript:window.print()">Print</a>' +
             '<button id="btnPCancel" class="' + cls + ' pull-left primary-faded with-margin-right" type="button">Cancel</button>' +
            getDownloadBtn() +
            '</div>'  ;
    }

    function bind(isBind) {
        $ctrl.bindElementClickBySelector(isBind, '#btnPDownload', download);
        $ctrl.bindElementClickBySelector(isBind, '#btnPCancel', cancel);

        if (typeof ($ctrl.bindOther) === 'function') {
            $ctrl.bindOther(isBind);
        }
    }


    function cancel(e) {
        $ctrl.preventDefault(e);
        $ctrl.closePopup();
    }

    function download(e) {
        $ctrl.preventDefault(e);
        if ($ctrl.onDownload) {
            $ctrl.onDownload({e:e});
        }
    }

    function getSidebarContent() {
        $ctrl.coverBtns = [];
        $ctrl.customContent = getCustomContent();
        return $ctrl.expandableSections.getExpandableContent($ctrl.Sections, getExpandableItem);
    }

    function getExpandableItem(el) {
        switch (el.id) {
            case 1: //Custom
                return $ctrl.customContent;

            case 2: //Grid Settings
                return getGridSettings();

            case 3: //Layout
                return $ctrl.getLayoutWrapper();

            case 7: //Style
                return $ctrl.getStyleWrapper();

            case 8: //Style
                return $ctrl.getPageMarginsWrapper();

            case 4: //Security
                var w = $ctrl.getSecurityWrapper();
                if (!$ctrl.CPS.hasQuotaType('fileStorage')) {
                    w = '<div class="full-width ' + $ctrl.wrapperId + '">' + w + '</div>';
                }
                return w;

            case 5:
            case 6:
                return $ctrl.getCoverSection(el.name, el.id === 6 ? 1 : 0);

        }
    }

    function getDownloadBtn() {
        return '<button type="button" id="btnPDownload" class="btn primary col150 table-div pull-left btn-small" data-type="download" analytics-on analytics-action="PDF Generator Download">' +
            '<div class="col30 with-margin-right">' + $ctrl.LCS.getISBDiv('download-pdf', 5) + '</div>' +
            '<div><div class="with-ellipsis">Download PDF</div></div>' +
            '</button>';
    }

    function getGridSettings() {
        return $ctrl.getViewType() +
                getColumnSettings() +
            ($ctrl.customGridSetting ? $ctrl.customGridSetting.content : '');

        function getColumnSettings() {
            $ctrl.columnsTitle = null;//'Columns';
            if (!$ctrl.listTreeService) {
                return '';
            }
            var tag = 'column-settings';
            $ctrl.extraParamColumns = {
                isPrintLayout: true,
                preChangeColumn: $ctrl.preChangeColumn,
                listTreeService: $ctrl.listTreeService,
                columnsPerRow: 2
            };
            return getHeader($ctrl.columnsTitle) +
                '<' + tag + ' class="display-block full-width ' + tag + '" extra-param="::$ctrl.extraParamColumns" comp-options="::$ctrl.compOptions"></' + tag + '>';
        }
    }

    function getHeader(name) {
        return name ? ('<div class="label-header font-general font-general-12 margin-bottom-half">' + name + '</div>') : '';
    }

    function onDestroy() {
        $ctrl.expandableSections.bindExpandable(false);
        bind(false);
    }

    function onLoaded() {
        //open More Settings
        $ctrl.expandableSections.onExpandableLoaded($ctrl.expandDefaultSectionId);

       /* $ctrl.onSidebarChanges({
            result: {
                force: true,
                item: $ctrl.item
            }
        });*/
        bind(true);
    }

    function onChangeOther(result) {
        console.log('onChangeOther');
        $ctrl.onSidebarChanges({
            result: {
                field: result.selected.field,
                item: _.extend({}, $ctrl.item)
            }
        });
    }

    function getCustomContent() {
        return '';
        //dont display custom content
        var el = '',
            nodes = $ctrl.listTreeService ? $ctrl.listTreeService.active.selectedList.nodes : null,
            l = nodes ? nodes.length : 0;
        if (l > 0) {
            _.each(nodes, function (n, i) {
                el += '<div class="' + (i !== 0 ? 'margin-top-half' : '') + (i !== l - 1 ? ' margin-bottom-half' : '') + '">' +
                    n.name +
                    '</div>';
            });

            $ctrl.Sections[0].hide = false;
            $ctrl.Sections[0].name = getName(l);
        }

        return el;
    }
}

