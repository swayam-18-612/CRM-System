angular.module('user.comments.answerItem.component', [
    'user.comments.reply.component',
    'user.comments.answers.component',
    'user.comments.baseItemCtrl.service',
    'user.comments.commentDate.component',
    'group.sbPopover.events.service'
])
.component('answer', {
    bindings: {
        level:'<',
        createdBy: '<',
        item: '<',
        highlight: '<?',
        tasksCard: '<',
        pictureClass: '@',
        replyPictureClass:'@',
        noReply: '<?',
        parentAnswer: '<',
        isComment: '<?',
        isInModal: '<?',
        onUpdateStats:'&'
    }, controller: 'AnswerItemCtrl'
})
.controller('AnswerItemCtrl', AnswerItemCtrl);
AnswerItemCtrl.$inject = ['BaseItemCtrlService', '$element'];
function AnswerItemCtrl(BaseItemCtrlService, $element) {
    //console.log('AnswerItemCtrl');
    var $ctrl = this;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitBase = preInitBase;
    $ctrl.postInitOther = postInitOther;

    $ctrl.updateStats = updateStats;

    $ctrl.getItemById = getItemById;

    $ctrl = new BaseItemCtrlService($ctrl, $element);

    function preInitBase() {
        if($ctrl.canComment && $ctrl.CPS.isCollaborator){
            $ctrl.canEdit = true;
        }
        $ctrl.dateFormat = 'MMM D @ ' + $ctrl.CPS.timeFormat;
        //for popover
        /*
    var id = 'answer' + new ObjectId().toString();
        $ctrl.isEditPopup = true;
        $ctrl.keyboardService ={
            getRowClass: function () {
                return '.item-container'
            },
            ROW_CLICK_POPOVER:  $ctrl.objectType.toUpperCase() + '_POPUP_CLICK_POPOVER',
            sbPopoverClass: '.with-sb-popover'+id,
            clickEvent: $ctrl.LCS.clickEvent + '.answer'+id
        };
        $ctrl = new PopoverInitEventsService($ctrl);
*/
    }

    function postInitOther(){
        $ctrl.tempAnswer = null;
        $ctrl.onSave = onSave;

        $ctrl.edit = edit;
        $ctrl.cancel = cancel;
        $ctrl.remove = remove;

        $ctrl.reloadListItemTemplate();
    }

    function getItemById() {
        return $ctrl.item;
    }

    function getItemTemplate() {
        var replyPictureClass = $ctrl.replyPictureClass || $ctrl.pictureClass || 'small24',
            commentParams = 'tasks-card="::$ctrl.tasksCard" ' +
            'picture-class="'+replyPictureClass+'" ' +
            'reply-picture-class="'+replyPictureClass+'" ' +
            'is-comment="::' + (!$ctrl.isComment) + '" '+
            'parent-answer="$ctrl.item" '  ;

        $ctrl.showButtons=true;
return '<div class="item-container position-relative clearfix">' +
            '<comment-date class="date-row-wrapper table-div full-width clearfix date-row" ' +
                'created-by="::$ctrl.createdBy" ' +
                'picture-class="' + ($ctrl.level === 1 ? $ctrl.pictureClass : replyPictureClass)+'" ' +
                'created-at="::$ctrl.item.createdAt"' +
                '></comment-date>' +
            getSideBtns() +

        '<!--ng-init="$ctrl.typeText =\'Answered\';$ctrl.type=2"  addbuttons-->' +
            '<div ng-show="!$ctrl.item.isEdit" class="description wysiwyg" ng-bind-html="$ctrl.item.answer| highlight: $ctrl.highlight|unsafe"></div>' +

    ($ctrl.canEdit ? ('<div ng-show="$ctrl.item.isEdit" class="text-container position-relative padding-left-0">' +
                $ctrl.getReplyFormTemplate() +
            '</div>' +
        ($ctrl.tasksCard.isOnlyComment ? '' : getActionButtons())
    ):'') +
        '</div>' +
($ctrl.isComment ? ('<div ng-if="$ctrl.isShowComments()" class="answer-comments">' +
            '<answers class="answers" ng-if="$ctrl.item.stats.answers>0" ' +
                'level="::'+(($ctrl.level || 0) + 1)+'" ' +
                'can-edit="::$ctrl.canEdit" ' +
                'highlight="::$ctrl.highlight" ' +
                'is-in-modal="::$ctrl.isInModal" ' +
                'on-update-stats="$ctrl.updateStats(result)" ' +
    commentParams +
                '></answers>' +

    ($ctrl.canEdit &&!$ctrl.isOnlyComment ? (
            '<reply ' +
            commentParams +
                'show-buttons="::'+$ctrl.showButtons+'" ' +
                'class="reply-smaller" ' +
                '></reply>') :
            '') +
        '</div>'
):'') +
    (!$ctrl.isComment&&!$ctrl.isOnlyComment?('<div ng-style="::{\'padding-top\':$ctrl.isShowComments()?\'10px\':\'20px\'}" class="clearfix"></div>'):'')
    }

    function getActionButtons() {
return '<div ng-if="$ctrl.item.stats.answers > 0 && '+!$ctrl.canEdit+' || '+$ctrl.canEdit+'" class="question-actions table-div full-width '+($ctrl.isComment?'bottom':'top')+'">' +
        '<div>' +
    ($ctrl.isComment ? ('<div class="inline-block no-drag">' +
                '<a class="reply ' + $ctrl.getBtnActionCls() + '" data-type="toggleComments">' +
        //'<span class="sbf reply sbf14"></span> ' +
        '<span ng-show="$ctrl.item.stats.answers > 0" ng-bind="$ctrl.item.stats.answers"></span> {{$ctrl.item.stats.answers > 1 ? \'Replies\' : \'Reply\'}}</a>' +
            '</div>') : '')+
        '</div>' +
    '</div>'
    }

    function getSideBtns() {
        var canEdit = $ctrl.canEdit && ($ctrl.CPS.userId === $ctrl.item.createdById ||
             $ctrl.CPS.userId !== $ctrl.item.createdById && $ctrl.CPS.isAuthenticated && $ctrl.CPS.memberType >= 1);
        if (!canEdit) {
            return '';
        }
        var parent = $ctrl.LCS.findClosestParent($ctrl.element, '.comments-sidebar-inner'),
            isInSidebar = parent !== null && parent !== '';
var liCls = 'table-div full-width ' + $ctrl.getBtnActionCls();
    return '<div class="one-line-tooltip toggle-actions" > ' +
                '<div class="btn-group actions" dropdown dropdown-append-to="' + ($ctrl.isInModal ?  '.modal-dialog .modal-body'  : '.sb-scrolling-monitor .todo-cards-sidebar') + '">' +
                $ctrl.LCS.getMoreBtn() +
                    '<ul class="dropdown-menu fadeInDownLeft side-menu answer" role="menu" dropdown-menu>' +
                       '<li><a class="' + liCls + '" data-type="edit" analytics-on analytics-action="Edit ' + $ctrl.itemName + '"><div class="col30">' +
                        $ctrl.LCS.getISBDiv('pencil', 2) + '</div><div>Edit ' + $ctrl.itemName + '</div></a></li>' +
                    '<li class="with-top-border"></li>' +
                    '<li><a class="accent ' + liCls + '" data-type="remove" analytics-on analytics-action="Open Remove ' + $ctrl.itemName + ' Popup"><div class="col30">' + $ctrl.LCS.getISBDiv('trash') + '</div> <div>Remove ' + $ctrl.itemName + '</div></a></li>' +
                    '</ul>' +
                '</div>' +
            '</div>';
        //todo bring in popover
        /*'side-actions hide-print no-drag" >' +
              '<div class="with-dots with-hover">' +
              '<div class="btn-group actions with-sb-popover'+id+'" popover-type="more-actions">' +
              '<button type="button" class="btn btn-default dropdown-toggle dots">' +
              '<span class="sbf vertical-dots"></span>' +
              '</button>' +
              '</div>' +
          '</div>'*/
    }

    function remove() {
        $ctrl.popupsService.open(null, $ctrl.popupsService.operations.treeKeyboardActions, {
            btn: 'Apply',
            icon: 'trash',
            title: 'Remove ' + $ctrl.itemName,
            message: 'Are you sure you want to remove the selected ' + $ctrl.itemName.toLowerCase() + ($ctrl.isComment ? ' and the associated replies' : '') + '?',
            itemTitle: 'image',
            onConfirm: onConfirm
        }, $ctrl.compOptions);

        function onConfirm() {
            var type = 'Remove';
            var params = {
                _id: $ctrl.item._id,
                companyId: $ctrl.CPS.companyId,
            };
            //for taskboard we dont have productID
            if ($ctrl.tasksCard.productId) {
                params.productId = $ctrl.tasksCard.productId; //$ctrl.CPS.productId
            }
            if ($ctrl.tasksCard.uIdList) {
                params.uIdList = _.extend({}, $ctrl.tasksCard.uIdList, {currentItemLikes: null});
            }

            $ctrl.service.delete(params, onCustomSave, function (err) {
                onCustomError(err, 'error');
            });

            function onCustomSave(result) {
                onCustomError(null, 'success');
                console.log('ANSWER_Removed');

                result.type = $ctrl.parentAnswer ? 'reply' : 'comment';

                updateStats(_.extend(result, {isRemove: true}));
            }

            function onCustomError(err, isSuccess) {
                $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.' + $ctrl.itemName.toLowerCase() + '.' + type + '.' + isSuccess, isSuccess);
            }
        }
    }

    function updateStats(result) {
        console.log('answeritem ');
        var item = result.item, updates,
            isComment = result.type ==='comment';

        updates = isComment ? (result.updatesG && result.updatesG.todoCards && result.updatesG.todoCards.set ? result.updatesG.todoCards.set[$ctrl.tasksCard._id] : null) : result.parentAnswer;

        if (item) {
            if(!$ctrl.isComment && !isComment ){
                $ctrl.parentAnswer.stats.answers = updates.stats.answers;
            }
            var isCurrentReplyList = $ctrl.isComment && !isComment && updates;
            if (isCurrentReplyList){
                if(result.isRemove && !updates.stats.answers){
                    $ctrl.toggleComments();
                }
            }
        }
        $ctrl.onUpdateStats({result: result});
    }

    function onSave(result) {
        console.log('onSave');
        var item = result ? result.item : {};
        $ctrl.item.answer = item.answer;
        $ctrl.item.isEdit = false;
        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.itemName.toLowerCase() + '.Edit.success', 'success');
    }

    function edit() {
        $ctrl.tempAnswer = $ctrl.item.answer;
        $ctrl.item.isEdit = true;
    }

    function cancel() {
        $ctrl.item.answer = $ctrl.tempAnswer;
        $ctrl.item.isEdit = false;
    }
}

angular.module('user.comments.answers.component', [
    'user.comments.answerItem.component',
    'user.comments.reply.component',
    'list.ctrl',
    'apiPagination.Answers',
    'group.templatePreloadedCtrl.service'
])
.component('answers', {
    bindings: {
        level: '<',
        tasksCard: '<',
        parentAnswer: '<',
        replyPictureClass: '@',
        pictureClass: '@',
        highlight: '<?',
        canEdit: '<?',
        isComment:'<?',
        isInModal:'<?',
        inAnswer: '<?',
        onUpdateStats:'&'
    },
    controller: 'AnswersListCtrl'
})
.controller('AnswersListCtrl', AnswersListCtrl);
AnswersListCtrl.$inject = ['AnswersPagination', 'ListInitService','TemplateCompileCompCtrlService', 'TemplatePreloadedCtrlService', '$element'];
function AnswersListCtrl(AnswersPagination, ListInitService, TemplateCompileCompCtrlService,TemplatePreloadedCtrlService, $element) {
    var $ctrl = this;

    $ctrl.RowObserverCtrlService = RowObserverCtrlService;
    $ctrl.TemplateCompileCompCtrlService = TemplateCompileCompCtrlService;
    $ctrl.TemplatePreloadedCtrlService = TemplatePreloadedCtrlService;

    $ctrl.updateStats = updateStats;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoadedPreloadedTemplate = onLoadedPreloadedTemplate;
    $ctrl.getTemplateWithoutPreloader = getTemplateWithoutPreloader;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {

        if(!$ctrl.rowObserverService){
            $ctrl.rowObserverService = new $ctrl.RowObserverCtrlService($ctrl.watchers);
        }

        $ctrl.loaded = true;
        $ctrl.objectType = $ctrl.isComment ? 'comment' : 'reply';
        //console.log('AnswersListCtrl' + $ctrl.objectType);
        $ctrl.insertAfter = ($ctrl.tasksCard.isOnlyComment || !$ctrl.isComment || !$ctrl.tasksCard.isOnlyComment && $ctrl.isInModal);

        $ctrl = new ListInitService($ctrl, {
            list:  new AnswersPagination(1000,
                ["shortDesc", "answer", "name", "stats", 'createdById', 'createdAt', 'parentAnswerId', 'favorite', 'uId', 'uIdComment'],
                ['name', 'answer', 'shortDesc'],
                ['order','createdAt','createdAtT', 'stats.favorites', 'stats.answers'],
                'createdById'),
            preloadAll: true,
            orders: {createdAtT: $ctrl.insertAfter ? 1 : -1},
            withProperty: withProperty
        });

        $ctrl = new $ctrl.TemplatePreloadedCtrlService($ctrl, $element);
        //todo correct
        //$ctrl.popupsService.operations.update.template = getBasePopupTemplateByTag( 'comment-remove');
    }

    function postInit() {
        //comments in sidebar are bound to taskcard. each comment block is a task card
        var id = $ctrl.tasksCard && $ctrl.tasksCard.isOnlyComment ? $ctrl.tasksCard._id : ($ctrl.parentAnswer ? $ctrl.parentAnswer._id : 'NULL');
        $ctrl.addRootWatcher($ctrl.objectType + '_' + id + '_ADDED', onAdded);
        $ctrl.addRootWatcher('CHANGE_FILTER', onChangeFilter);
        $ctrl.addRootWatcher('SEARCH_FILTER', onSearchFilter);
    }

    function onLoaded() {
        $ctrl.setTemplateCompile($ctrl.element);
    }

    function onDestroy(){
        if($ctrl.onDestroyTemplatePreloader) {
            $ctrl.onDestroyTemplatePreloader();
        }
    }

    function getItemTemplate() {
        return '';
    }

    function getTemplateWithoutPreloader(el) {
return '<div class="ng-hide ' + ($ctrl.isComment?'answers comments-list':'') +'" ' +
                'ng-show="$ctrl.list.items.length>0" ' +
                'ng-class="{\'with-radius\':$ctrl.isComment && $ctrl.list.items.length == 0}">' +
            '<div ng-show="$ctrl.list.isLoaded" ' +
                 'infinite-scroll="$ctrl.list.nextPage($ctrl.withProperty(), $ctrl.orders, $ctrl.search)" ' +
                'infinite-scroll-disabled="$ctrl.list.busy" ' +
                'infinite-scroll-distance="1"' +
    '>' +
                '<answer class="' + ($ctrl.isComment ? 'answer-item' : '') + ' display-block clearfix" ' +
                    'level="::' + ($ctrl.level || 0) + '" ' +
                    'ng-repeat="item in ' + ($ctrl.canEdit ? '' : '::') + '$ctrl.list.items track by item._id" ' +
                    'id="item_{{::item._id}}" ' +
                    'ng-class="{\'task\':item.stats.isTask}" ' +
                    'created-by="::$ctrl.createdBy" ' +
                    'item="item" ' +
                    'parent-answer="$ctrl.parentAnswer" ' +
                    'highlight="::'+$ctrl.highlight+'" ' +
                    'tasks-card="::$ctrl.tasksCard" ' +
                    'picture-class="'+$ctrl.pictureClass+'" ' +
                    'reply-picture-class="'+($ctrl.replyPictureClass || $ctrl.pictureClass)+'" ' +
                    'is-comment="::'+$ctrl.isComment+'" ' +
                    'is-in-modal="::'+$ctrl.isInModal+'" ' +
                    'on-update-stats="$ctrl.updateStats(result)"'+
                '></answer>' +
                '<loading-more ng-if="$ctrl.list.busy"></loading-more>' +
            '</div>' +
            '<preloader-center class="preloader" ng-if="!$ctrl.list.isLoaded"></preloader-center>' +
        '</div>';
    }

    function onLoadedPreloadedTemplate(el) {
        //console.log('onLoaded');

        if($ctrl.loadedPreloader) {
            $ctrl.getAll();
        }
    }

    function withProperty() {
        var p = {
            companyId: $ctrl.CPS.companyId,
            uId: $ctrl.tasksCard._id,
            parentAnswerId: $ctrl.parentAnswer ? $ctrl.parentAnswer._id : null
        };
        //for taskboard we dont have productID
        if($ctrl.tasksCard.productId){
            p.productId = $ctrl.tasksCard.productId; //$ctrl.CPS.productId
        }
        return p;
    }

    function onAdded(result) {
        console.log('ANSWER_ADDED');
        result.isAnswerAdded = !$ctrl.parentAnswer;
        $ctrl.updateStats(result);
    }

    function updateStats(result) {
        console.log('ANSWERS updateStats ');
        var item = result.item, updates,
            isComment = result.type ==='comment';
        updates = isComment ? (result.updatesG && result.updatesG.todoCards && result.updatesG.todoCards.set ? result.updatesG.todoCards.set[$ctrl.tasksCard._id] : null) : result.parentAnswer;

        if (item) {
            if(isComment !== $ctrl.isComment) {
               return process({result: result});
            }

            if (result.isRemove) {
                $ctrl.list.removeElement(item);
            } else {
                if (!item.createdBy) {
                    item.createdBy = $ctrl.user;
                }
                item = $ctrl.service.convertResource(item);
                $ctrl.list.insertElement(item, $ctrl.insertAfter);
            }

            if (!$ctrl.isComment) {//we are in reply list //!$ctrl.isComment && !isComment
                if (!isComment && $ctrl.parentAnswer._id === updates._id) { //a reply was added or deleted
                    $ctrl.parentAnswer.stats.answers = updates.stats.answers;
                    //dont propagate cause taskCard didnt change
                }
            } else if (isComment && updates) {  //we are in comments list // $ctrl.isComment && isComment
                process();
                //propagate to comments group to update the task card info
            }
        }

        function process() {
            $ctrl.tasksCard = _.extend($ctrl.tasksCard, updates);
            $ctrl.onUpdateStats({result: result});
        }
    }

    function onChangeFilter(selectedFilter) {
        console.log('CHANGE_FILTER');
        $ctrl.orders = selectedFilter;
        $ctrl.getAll();
    }

    function onSearchFilter(search) {
        console.log('SEARCH_FILTER');
        $ctrl.search = search;
        $ctrl.highlight = search;
        if (!$ctrl.list.busy) {
            $ctrl.getAll();
        }
    }
}

angular.module('user.comments.baseItemCtrl.service', [
    'apiServices.Answers'
])
.service('BaseItemCtrlService', BaseItemCtrlService);
BaseItemCtrlService.$inject = ['ListItemTemplateFormCtrlService', 'AnswersService'];
function BaseItemCtrlService(ListItemTemplateFormCtrlService, service) {
    return function($ctrl, $element){

        $ctrl.elNameCls = 'answer';

        $ctrl.preInitOther = preInitOther;

        $ctrl.onLoaded = onLoaded;
        $ctrl.onDestroy = onDestroy;

        $ctrl.isThisCreator = isThisCreator;

        $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

        return $ctrl;

        function onLoaded(){
            if($ctrl.withoutFocus !== 'true'){
                $ctrl.LCS.timeout(function () {
                    focus();
                }, 100);
            }
            bind(true);
        }

        function getName(){
            if(!$ctrl.elName) {
                $ctrl.elName = $ctrl.element.querySelector('.' + $ctrl.elNameCls);
            }
            return $ctrl.elName;
        }

        function focus(){
            var el = getName();
            if (el){
                el.focus();
            }
        }

        function onDestroy(){
            bind(false);
        }

        function bind(isBind) {
            var el = getName();
            if (el) {
                //$ctrl.LCS.bindElementsClick(isBind, el, onBlur, null, 'blur');
                $ctrl.LCS.bindElementsClick(isBind, el, onKeyDown, null, 'keydown paste');
            }
        }

        function onKeyDown(e) {
            console.log('BaseItemCtrlService: onKeyDown');
            //check if is cmd
            var isCtrl = e.ctrlKey || e.metaKey;
            switch (e.which) {
                case 13: //enter
                    if(isCtrl) {
                        $ctrl.preventDefault(e);
                        $ctrl.reply(e);
                    }
                    break;

                case 8: //delete
                    if(isCtrl && $ctrl.isOnlyComment) {
                        $ctrl.preventDefault(e);
                        cancelEdit();
                    }
                    break;
            }
        }

        function preInitOther() {
            if($ctrl.preInitBase){
                $ctrl.preInitBase();
            }

            $ctrl.getReplyFormTemplate = getReplyFormTemplate;

            $ctrl.favor = favor;
            $ctrl.toggleComments = toggleComments;
            $ctrl.isShowComments = isShowComments;
            $ctrl.reply = reply;
            $ctrl.isReply = isReply;

            $ctrl.cancelEdit = cancelEdit;

            init();
        }

        function init() {
            $ctrl.isOnlyComment = $ctrl.tasksCard && $ctrl.tasksCard.isOnlyComment;
            $ctrl.actionName = $ctrl.isOnlyComment ? 'Reply' : ($ctrl.isComment ? 'Reply' : 'Comment');
            $ctrl.itemName = $ctrl.isComment ? 'Comment' : 'Reply';
            $ctrl.changedTaskCardFields = ['answers', 'updated'];
            $ctrl.dontNotify = true;

            if (!$ctrl.actiontype) {
                $ctrl.actiontype = 'Edit';
            }

            if (!$ctrl.createdBy) {
                $ctrl.createdBy = $ctrl.item ? $ctrl.item.createdBy : null;
                if($ctrl.createdBy && !$ctrl.createdById){$ctrl.createdById = $ctrl.item.createdBy._id;}
            }
            $ctrl.isCreator = isThisCreator();

            $ctrl.type = $ctrl.actiontype;
            $ctrl.service = service;
            if(!$ctrl.extraParam){$ctrl.extraParam = {};}
            $ctrl.extraParam.service = $ctrl.service;
       }

       function cancelEdit(){
           setEdit(false);

           if($ctrl.isOnlyComment && $ctrl.onBlur){
               $ctrl.onBlur();
           }else{
               $ctrl.cancel();
           }
       }

       function setEdit(isEdit) {
           $ctrl.item.isEdit = isEdit;
           $ctrl.LCS[isEdit ? 'addClass' : 'removeClass']($ctrl.element.querySelector('.reply-container'), 'edit');
           $ctrl.LCS[isEdit ? 'removeClass' : 'addClass']($ctrl.element.querySelector('.btnCancel'), 'sb-hide');
           $ctrl.element.querySelector('.btnText').innerText = getBtnText(isEdit);
       }

       function getBtnText(isEdit){
           return isEdit ? 'Save' : $ctrl.itemName;
       }

        function getReplyFormTemplate() {
            var isEdit = $ctrl.item.isEdit;
            return '<form class="reply-container auto'+(isEdit ? ' edit':'')+'" name="$ctrl.formHolderItem[$ctrl.formName]" novalidate autocomplete="off">' +
                    '<div class="baseitem word-wrap contenteditable '+$ctrl.elNameCls+'" placeholder="Add new '+$ctrl.itemName.toLowerCase()+'…" contenteditable="true" contenteditable-html strip-br="true" ng-model="$ctrl.item.answer"></div>' +
                    '<span ng-show="($ctrl.formHolderItem.formItem.answer.$dirty || $ctrl.formHolder[\'formItem_attempted\']) && $ctrl.formHolderItem.formItem.answer.$error.required" class="help-inline">' + $ctrl.itemName + ' is required.</span>' +
                    '<span class="error" ng-show="$ctrl.error"></span>' +
                getBottomBtns(isEdit) +
                '</form>';

            function getBottomBtns(isEdit) {
                return ($ctrl.showButtons ? ('<div class="actions no-drag">' +
                    '<button class="btn btn-primary reply-answer ' + $ctrl.getBtnActionCls() + '" data-type="reply" type="submit" analytics-on analytics-action="Comments Sidebar ' + $ctrl.itemName + '" ng-disabled="$ctrl.isUpdating || !$ctrl.formHolderItem.formItem.$valid"' +
                    '><span class="sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> <span class="btnText">' + getBtnText(isEdit) + '</span></button>' +
                    '<button class="btnCancel btn btn-primary reply-answer transparent with-margin-left ' +
                    (($ctrl.isOnlyComment || isEdit) ? '' : 'sb-hide ') +
                    $ctrl.getBtnActionCls() + '" data-type="cancelEdit">Cancel</button>' +
                    '</div>') : '');
            }
        }

        function isThisCreator() {
            return $ctrl.CPS.userId && $ctrl.createdById === $ctrl.CPS.userId;
        }

        function isReply() {
            return $ctrl.showReply === 'true';
        }

        function reply(e) {
            console.log('reply');
            $ctrl.LCS.preventDefault(e);
            $ctrl.error = null;

            if (!$ctrl.item.answer) {
                $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.answer-question.answer');
            } else {
                // $ctrl.item.answer = cleanHtmlForWYSIWYG($ctrl.item.answer);
                $ctrl.save();
            }
        }

        function favor(item) {
            if (!item.isLoading) {
                item.isLoading = true;
                var params = angular.copy(item);
                params.answerId = item._id;
                params.type = item.parentAnswerId ? 3 : 2;
                /*  Answers.favor(params,function (result) {
                      item.isLoading = false;
                      item.stats.favorites = result.favoritesCount;
                      item.favorite = result.favorite;
                      i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.item.getType() + '.' + (item.favorite ? 'favor' : 'unfavor')+'.success', 'success');
                  }, function (err) {
                      item.isLoading = false;
                      i18nNotifications.pushForCurrentRoute(err, 'crud.' + $ctrl.item.getType() + '.favor.error', 'error');
                  });
      */
            }
        }

        function toggleComments() {
            $ctrl.showComments = $ctrl.showComments ? false : true;
        }

        function isShowComments() {
            return $ctrl.showComments;
        }
    }
}

angular.module('user.comments.commentDate.component', [
])
.component('commentDate', {
    bindings: {
        createdBy: '<',
        createdAt: '<',
        pictureClass: '@',
    },
    controller: 'CommentDateController'
})
.controller('CommentDateController', CommentDateController);
CommentDateController.$inject = ['TemplateCompileCompCtrlService', '$element'];
function CommentDateController(TemplateCompileCompCtrlService, $element) {
    //console.log('CommentDateController');
    var $ctrl = this;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInit = preInit;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        if(!$ctrl.pictureClass){$ctrl.pictureClass = 'small';}
        $ctrl.dateFormat = 'MMM D @ ' + $ctrl.CPS.timeFormat;
    }


    function getItemTemplate() {
return ($ctrl.createdBy ? ('<div class="centered picture ' +$ctrl.pictureClass+ '">' +
            '<div class="profile-card position-relative">' +
     $ctrl.security.getUserImageComponent('$ctrl.createdBy', $ctrl.pictureClass ? $ctrl.pictureClass : 'smaller') +
            '</div>' +
        '</div>') : '') +
        '<div class="profile-info">' +
            ($ctrl.createdBy ? ('<div class="name">'+$ctrl.createdBy.name+'</div>') : '') +
            ($ctrl.createdAt ?('<div class="date">'+$ctrl.CPS.getCreatedAt($ctrl.createdAt, $ctrl.dateFormat)+'</div>'):'')+
        '</div>';
    }
}

angular.module('user.comments.remove.component', [
    'item.listTemplate.popup.controller.service'
])
.component('commentRemovePopup', popupComponentParams('CommentRemovePopupController'))
.controller('CommentRemovePopupController', CommentRemovePopupController);

CommentRemovePopupController.$inject = ['ListItemPopupTemplateCtrlService', '$element'];
function CommentRemovePopupController(ListItemPopupTemplateCtrlService, $element) {
    var $ctrl = this;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupHeader = getPopupHeader;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ListItemPopupTemplateCtrlService($ctrl, $element);

    function setTemplateData() {
        $ctrl.popupTitle = ($ctrl.type.indexOf('Remove') !== -1 ? 'Remove' : $ctrl.type) + ' ' + $ctrl.objectType;
        $ctrl.icon = $ctrl.type.indexOf('Remove') !== -1 ? 'remove' : 'box';
        $ctrl.withFooterBtns = true;
    }

    function getPopupHeader() {
        return '<div class="modal-header">' +
            '<div class="form-wrapper">' +
            '<div class="circled-icon little2 sbf spacing-bottom-half ' + $ctrl.icon + '"></div>' +
            '<h3 class="text-center">' + $ctrl.popupTitle + '</h3>' +
            '</div>' +
            '</div>'
    }

    function getPopupBodyContent() {
        return '<p class="text-center">' +
                ($ctrl.extraParam.noDefault !== true ? ('Are you sure you want to '+ ($ctrl.type.indexOf('Remove') !== -1 ? 'Remove' : $ctrl.type) + ' the selected ' + $ctrl.objectType+ '? ') : '')+
                ($ctrl.extraParam.additionalMessage?$ctrl.extraParam.additionalMessage:'') +
            '</p>';
    }
}

angular.module('user.comments.commentsGroup.component', [
    'user.comments.answers.component'
])
.component('commentsGroup', {
    bindings: {
        title:'@',
        canEdit: '<?',
        tasksCard: '<',
        pictureClass: '@',
        replyPictureClass: '@',
        withoutFocus: '@',
        isInModal: '<',
        onUpdateStats:'&'
    },
    controller: 'CommentsGroupCtrl'
})
    //$ctrl.iscomment is true if parent is null
.controller('CommentsGroupCtrl', CommentsGroupCtrl);
CommentsGroupCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];
function CommentsGroupCtrl(TemplateCompileCompCtrlService, $element) {
    //console.log('CommentsGroupCtrl');
    var isReplyOpened = null;

    var $ctrl = this;

    $ctrl.level = 1;
    $ctrl.dontUpdateG = true;
    $ctrl.isComment = true;
    $ctrl.highlight = false;

    $ctrl.showReply = showReply;
    $ctrl.hideReply = hideReply;
    $ctrl.replyOpened = replyOpened;
    $ctrl.updateStats = updateStats;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function getItemTemplate() {
        var isOnlyComment = $ctrl.tasksCard.isOnlyComment,
            isInModalTaskCard = $ctrl.isInModal && !isOnlyComment,
            replyPictureClass = $ctrl.replyPictureClass || $ctrl.pictureClass,
            commonParams = 'tasks-card="::$ctrl.tasksCard" ' +
                'is-comment="::'+$ctrl.isComment+'" ' +
                'parent-answer="::null" ';

        return getCard()+
            (isInModalTaskCard ? '' : getReply())+
            getAnswers() +
            getReply(true);

        function getCard() {
            return isOnlyComment ? '' :
                ('<div class="clearfix small-filters table-div">' +
                    '<div class="pull-left subitem table-div">' +
                    '<div class="centered col30 icon-absolute">' + $ctrl.LCS.getISBDiv('chat') + '</div>' +
                    '<div class="centered"><span>' + ($ctrl.title ? $ctrl.title : 'Comments') + '</span>' +
                    '<span class="stats with-padding-left" ng-show="$ctrl.tasksCard.stats.answers>0" ng-bind="$ctrl.tasksCard.stats.answers ? $ctrl.tasksCard.stats.answers : 0"></span></div>' +
                    '</div>' +
                    '<custom-search ng-if="$ctrl.list.totalCount>0" class="custom-search search-field pull-right" placeholder="{{::$ctrl.searchPlaceholder ? $ctrl.searchPlaceholder : (\'Search \'+$ctrl.itemTitle)+\'s\'}}…" on-search="$ctrl.onSearchGroup(search)"></custom-search>' +
                    '</div>');
        }

        function getAnswers() {
            return '<answers ' +
                'level="::' + $ctrl.level + '" ' +
                'can-edit="::$ctrl.canEdit" ' +
                'highlight="::$ctrl.highlight" ' +
                'is-in-modal="::'+$ctrl.isInModal+'" ' +
                'on-update-stats="$ctrl.updateStats(result)" ' +
                'picture-class="' + $ctrl.pictureClass+'" ' +
                'reply-picture-class="' + replyPictureClass + '" ' +
                commonParams +
                '></answers>';
        }

        function getReply(isBottom) { //bottom all the time
            var v = (isBottom?1:2);
            return $ctrl.canEdit ? ('<div ' +
                (isBottom ? 'ng-class="($ctrl.tasksCard.stats.answers>0)?\'\':\'empty\'" ' : 'ng-show="$ctrl.tasksCard.stats.answers>0" ') +
                'class="bottom-reply no-drag ' +
                (isBottom ? ' ' : 'ng-hide top') +
                ( (isInModalTaskCard || !isBottom) ? '' : 'margin-left-24 ') +
                '">' +
      (isOnlyComment?('<div class="showmore-wrap' + ($ctrl.tasksCard.completed ? ' ng-hide' : '') + '"><a class="show-more-btn ' + $ctrl.getBtnActionCls() + '" data-type="showReply" data-info="'+v+'">' +
          //$ctrl.LCS.getISBDiv('reply', 2,'pull-left')+' '+
          'Reply</a></div>') :'') +

                    '<reply ng-if="' + (!isOnlyComment)+'||'+isOnlyComment+'&&$ctrl.replyOpened('+v+')" ' +
                        commonParams +
                        'picture-class="'+replyPictureClass+'" ' + //small30
                        'class="reply-small" ' +
                        'show-buttons="::true" ' +
                    (isInModalTaskCard && $ctrl.withoutFocus === 'true' ? ('without-focus="true" ') : '') +
                        'on-blur="$ctrl.hideReply($event)"' +
                    '></reply>' +
                '</div>') : '';
        }
    }

    function onLoaded() {
        setCounterOnItem();
        setOnSearch();
    }

    function setOnSearch(){
        (function (timer, delay) {
            $ctrl.onsearch = onsearch;

            function onsearch(search) {
                if (timer) {
                    $ctrl.LCS.cancelTimeout(timer);
                }
                timer = $ctrl.LCS.timeout(function () {
                    $ctrl.broadcastRoot('SEARCH_FILTER', search);
                }, delay);
            }
        })(false, 500);
    }

    function setCounterOnItem(){
        var el = $ctrl.LCS.findClosestParent($ctrl.element, '.todo-card');
        if(el){
            el.setAttribute('has-answers', $ctrl.tasksCard.stats.answers>0);
        }
    }

    function updateStats(result) {
        console.log('COMMENTS GROUP updateStats ');
        var updates = result.updatesG && result.updatesG.todoCards && result.updatesG.todoCards.set ? result.updatesG.todoCards.set[$ctrl.tasksCard._id] : null;
        if(updates){
            $ctrl.onUpdateStats({
                result: {
                    custom:true, newRes: result,
                    editchanges: _.extend({_id: $ctrl.tasksCard._id}, updates)
                }});
            setCounterOnItem();
        }
    }

    function showReply(v, e) {
        if (v === 'null') {
            v = null;
        }
        if (v !== null && v !== undefined) {
            v = parseInt(v, 10);
        }
        if (isReplyOpened === null || isReplyOpened !== v) {
            isReplyOpened = v;
        } else {
            isReplyOpened = null;
        }
    }

    function hideReply(e) {
        $ctrl.preventDefault(e);
        isReplyOpened = null;
    }

    function replyOpened(v) {
        return isReplyOpened === v;
    }

}

angular.module('user.comments', [
    'user.comments.commentsGroup.component',
    'user.comments.answers.component'
]);

angular.module('user.comments.reply.component', [
    'user.comments.baseItemCtrl.service'
])
.component('reply', {
    bindings: {
        tasksCard: '<',
        parentAnswer: '<',
        isComment: '<?',
        showButtons: '<?',
        pictureClass: '@',
        withoutFocus: '@',
        onBlur:'&',
    },
    controller: 'ReplyCtrl'
})
.controller('ReplyCtrl',ReplyCtrl);
ReplyCtrl.$inject = ['SessionService', 'BaseItemCtrlService', '$element'];
function ReplyCtrl(SessionService, BaseItemCtrlService, $element) {
    var $ctrl = this;
    $ctrl.SessionService = SessionService;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitBase = preInitBase;
    $ctrl.postInitOther = postInitOther;

    $ctrl = new BaseItemCtrlService($ctrl, $element);

    function preInitBase() {
        $ctrl.isOnlyComment = $ctrl.tasksCard.isOnlyComment;
        $ctrl.createdBy = $ctrl.SessionService.getSetting('user');
        $ctrl.replyType = $ctrl.parentAnswer ? 'reply' : 'comment';
        $ctrl.actiontype = 'Create';
    }

    function postInitOther(){
        $ctrl.onSave = onSave;

        createItem();

        $ctrl.reloadListItemTemplate();
    }

    function getItemTemplate() {
return '<div class="transparent clearfix">' +
            ($ctrl.createdBy ? (
            '<div class="picture pull-left '+$ctrl.pictureClass+ '">' +
                '<div class="profile-card position-relative">' +
                $ctrl.security.getUserImageComponent('$ctrl.createdBy', $ctrl.pictureClass) +
                '</div>' +
            '</div>') : '') +
            '<div class="text-container clearfix ' + ($ctrl.canComment ? ' margin-bottom-40' : 0)+ '">'+
                $ctrl.getReplyFormTemplate() +
            '</div>' +
        '</div>';
    }

    function onSave(result) {
        console.log('onSave');
        // push item to answers and display: result.item
        result.item.createdBy = $ctrl.item.createdBy ? $ctrl.item.createdBy : $ctrl.createdBy;
        result.type = $ctrl.replyType;

        if($ctrl.parentAnswer && result.type === 'reply'){
            $ctrl.parentAnswer.stats.answers = result.parentAnswer.stats.answers;
        }

        var id = $ctrl.tasksCard && $ctrl.tasksCard.isOnlyComment === true ? $ctrl.tasksCard._id :
            ($ctrl.parentAnswer ? $ctrl.parentAnswer._id : 'NULL');
        $ctrl.broadcastRoot($ctrl.replyType + '_' + id + '_ADDED', result);

        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.replyType + '.Create.success', 'success');
        $ctrl.show = false;
        createItem();
        if($ctrl.onBlur){$ctrl.onBlur();}
        else{
//set focus
        }
    }

    function createItem() {
        $ctrl.item = $ctrl.service.convertResource({
            uId: $ctrl.tasksCard._id,
            uIdList: _.extend({}, $ctrl.tasksCard.uIdList, {currentItemLikes: null}),
            uIdComment: $ctrl.tasksCard.uIdComment,
            type: 1,
            isOnlyComment:  $ctrl.isOnlyComment,
            parentAnswerId: $ctrl.parentAnswer ? $ctrl.parentAnswer._id : null,
            _id: new ObjectId().toString(),
            createdById: $ctrl.createdBy ? $ctrl.createdBy._id : null,
            createdBy: $ctrl.createdBy,
            companyId: $ctrl.CPS.companyId,
        });
        //for taskboard we dont have productID
        if($ctrl.tasksCard.productId){
            $ctrl.item.productId = $ctrl.tasksCard.productId; //$ctrl.CPS.productId
        }
    }
}

angular.module('product.workflow.item.grid.component',[
    'apiServices.Tasks',
    'components.validateLowers',
    'components.validateGreaters',
    'product.workflow.item.controller.service',
    'product.tasks.list.component',
    'product.todoFiles.list.component',
    'product.workflow.tasksReorder.popup'
])
.component('taskcardItemGrid', itemGridComponentParams({
    isInModal: '<',
    maxAddedCount: '<',
    onClose:'&',
}, 'TodoCardGridItemCtrl', '<div class="row-schedule"></div>'))
.controller('TodoCardGridItemCtrl',TodoCardGridItemCtrl);
TodoCardGridItemCtrl.$inject = ['TodoCardGridItemCtrlService', 'GridItemGroupInitCtrlService', '$element'];
function TodoCardGridItemCtrl(TodoCardGridItemCtrlService, GridItemGroupInitCtrlService, $element) {
    var $ctrl = this;
    $ctrl.bindingNames = ['goToProduct', 'goToProductPage'];
    $ctrl = new TodoCardGridItemCtrlService($ctrl);
    $ctrl = new GridItemGroupInitCtrlService($ctrl, $element);
}

angular.module('product.workflow.item.init.controller.service', [
    'services.blocksSetup',
    'user.calendar.topNav.service'
])
.service('TodoCardGridItemInitCtrlService', TodoCardGridItemInitCtrlService);
TodoCardGridItemInitCtrlService.$inject = ['MomentService', 'BlocksSetupService', 'TopNavCalendarService', 'SBFieldTypesService', 'LCS'];
function TodoCardGridItemInitCtrlService(MomentService, BlocksSetupService, TopNavCalendarService, SBFieldTypesService, LCS) {
    var sidePaddingCls = 'with-side-padding50',
        completeddrpId = 'completeddrp';

    var service = {
        MomentService: MomentService,
        SBFieldTypesService: SBFieldTypesService,
        Colors: SBFieldTypesService.SBFieldMethods.Colors,
        BlocksSetupService: BlocksSetupService,
        TopNavCalendarService: TopNavCalendarService,

        isUpcomingDate:  isUpcomingDate,
        getStatsProgress: getStatsProgress,
        getGridItemTemplate: getGridItemTemplate,
        update: update,
        archive: archive,
        activate: activate,
        remove: remove,
        duplicate: duplicate,
        complete: complete,
        getColumns: getColumns,
        getExtendedSettingsParams: getExtendedSettingsParams,
        getStats: getStats,
        getStatsTasks: getStatsTasks,
        setCompletedCSS: setCompletedCSS,
        getDatesContent: getDatesContent,
        getUIdList: getUIdList,
        onChangedFieldInModal: onChangedFieldInModal,
        setItemColumn: setItemColumn,
        getCommentCard: getCommentCard,
        getCompleteMark: getCompleteMark,
        setCompleteEvent: setCompleteEvent
    };
    return service;


    function getProgress(stats) {
        return stats && stats.tasks > 0 ? Math.round(100 * stats.tasksCompleted / stats.tasks) : 0;
    }

    function getStatsProgress(item, onlyInner) {
        var percentage = item ? getProgress(item.stats) : 0;
        return (percentage ? (
            onlyInner ? getSvg() : ('<div class="progressElStats">' + getSvg() + '</div>')
        ) : '');

        function getColor(val) { //0-100
            return val < 20 ?
                //red                    orange                 yellow                 lime green   green
                '#F9185F' : (val < 40 ? '#FF7824' : (val < 60 ? '#FFC800' : (val < 80 ? '#A2C71F' : '#00B865')));
        }

        function getSvg() {
            var width = 1;
            return '<svg viewBox="0 0 100 1" preserveAspectRatio="none"><path d="M 0,0.5 L 100,0.5" stroke="#E4E6F2" stroke-width="' + width + '" fill-opacity="0"></path><path d="M 0,0.5 L 100,0.5" stroke="' + getColor(percentage) + '" stroke-width="' + width + '" fill-opacity="0" style="stroke-dasharray: 100, 100; stroke-dashoffset: ' + (100-percentage) + '"></path></svg>'
        }
    }

    function setItemColumn($ctrl, val) {
        var todoColumn;
        if(!$ctrl.todoColumns){
            $ctrl.todoColumns = $ctrl.Settings.todoColumns;
        }
        if (val && $ctrl.todoColumns) {
            todoColumn = _.find($ctrl.todoColumns, function (item) {
                return item._id === val;
            });
            if(todoColumn) {
                p('todo-status-border', 'background-color', todoColumn.color, true);
                p('todo-status-name', 'innerText', todoColumn.name, false);

                function p(cls, prop, val, isStyle) {
                    var els = $ctrl.element.querySelectorAll('.' + cls);
                    if (els) {
                        _.each(els, function (el) {
                            if (el) {
                                if(isStyle) {
                                    $ctrl.LCS.setCSSStyle(el, prop, val);
                                }else{
                                    el[prop] = val;
                                }
                            }
                        });
                    }
                }
            }
        }
    }

    function onChangedFieldInModal($ctrl, result) {
        console.log('TodoCardGridItemInitCtrlService.onChangedFieldInModal');
        var newres = result.newRes;
        if (newres) {
            //updates $ctrl.item in modal
            result.prevItem = _.extend({}, _.clone($ctrl.item));
            onChangedFieldManually(result);
            newres.editchanges = result.editchanges;

            //changeStatusColumn
            if(result.prop === 'todoColumnId') {
                console.log('changeStatusColumn');
                var val = result && result.selected ? result.selected.val : null,
                    oldColumnId = $ctrl.item.todoColumnId;
                if (oldColumnId !== val) {
                    setItemColumn($ctrl, val);
                }
            }else{
                newres.eventType = 'CHANGED_FIELD';
                //notifyNewTeam();
               // $ctrl.item = _.extend($ctrl.item, newres.editchanges);
            }

            if(newres.item){
                newres.item = $ctrl.item;
            }
            //updates $ctrl.item in the group
            $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', newres);
        }

        function onChangedFieldManually(result) {
            if (!$ctrl.isInModal || result.custom) {
                return;
            }

            console.log('onChangedFieldManually');
            var prop = result && result.prop ? result.prop : null,
                updates,
                v = result.selected.val;

            if (prop === 'dates') {
                var c = $ctrl.getColFromProp(prop);
                if (v && c) {
                    updates = {};
                    if (v.from) {
                        updates[c.propFrom] = v.from;
                    }
                    if (v.to) {
                        updates[c.propTo] = v.to;
                    }
                }
            } else {
                updates = {};
                updates[prop] = v;
            }

            onSuccessUpdated(updates, null, result);
        }

        function onSuccessUpdated(updates, updates1, result) {
            if(!updates){return false;}
            //onchanges is not gonna be called so we must trigger it
            $ctrl.item = _.extend({}, _.clone($ctrl.item), updates, updates1);
            $ctrl.$onChanges({item: {
                    previousValue: result.prevItem ,
                    currentValue: $ctrl.item
                }});
            return true;
        }
    }

    function getUIdList(uIdList){
        var l = {};
        _.each(['_id', 'name', 'collectionName', 'elemType', 'itemTitle', 'nameForList', 'currentItemId', 'currentItemLogoId', 'currentItemLogo','currentItemLikes', 'currentProductId' ], function (p) {
            l[p] = uIdList[p] ? uIdList[p] : null;
        });
        return l;
    }

    function getExtendedSettingsParams($ctrl) {
        //the preloading service is necessary to get the columns - should consider the product id companyid - that correspond to the workflow
        //adjust if it happens on dashboard
        return {
            icons: service.TopNavCalendarService.getIcons(),
            team: $ctrl.team ? $ctrl.team : ($ctrl.CPS.productId && $ctrl.isCalendarPage ? $ctrl.RouteCollaboratorsService.getProjectTeam($ctrl.CPS.product) : null) ,
            Colors: SBFieldMethods.Colors
        }
    }

    function getStatsTasks(isInModal, item, withoutProgress) {//edit mode
        if (isInModal || !item.stats) {
            return '';
        }

        var stats = item.stats,
            cls = 'pull-left sbf12 gray',
            percentage = getProgress(stats),
            hasTasks = stats && stats.tasks && stats.tasks > 0,
            tasks = (stats.tasksCompleted + '/' + stats.tasks) +
                (percentage ? ('&nbsp; • &nbsp;' +  getProgress(stats) +'% completed') : '');
        return (hasTasks ? ('<div class="stat top">' + LCS.getISBDiv('taskList', 2, cls) + tasks + '</div>' +
            (withoutProgress ? '' : getStatsProgress(item))
        ) : '');
    }

    function getStats(isInModal, item, withTasks) {//edit mode
        if (isInModal || !item.stats) {
            return '';
        }

        var cls = 'pull-left sbf12 gray',
            stats = item.stats,
            hasAttach = stats && stats.attachments && stats.attachments > 0,
            hasComments = stats && stats.answers && stats.answers > 0;
        return (hasAttach ? ('<div class="stat top">' + LCS.getISBDiv('attachment', 2, cls) + stats.attachments + '</div>') : '') +
            (hasComments ? ('<div class="stat top">' + LCS.getISBDiv('chat', 2, cls) + stats.answers + '</div>') : '') +
            (withTasks ? getStatsTasks(isInModal, item, true) : '');
    }

    function getColumns($ctrl, columns, getColumnDate) {
        if(!$ctrl.SBFieldTypesService){
            $ctrl.SBFieldTypesService = SBFieldTypesService;
        }

        if(!$ctrl.Colors) {
            $ctrl.Colors = SBFieldTypesService.SBFieldMethods.Colors;
        }
        if(!$ctrl.Settings) {
            $ctrl.Settings = {};
        }
        if(!$ctrl.Settings.Colors) {
            $ctrl.Settings.Colors = $ctrl.Colors;
        }
        for (var prop in columns) {
            var c = columns[prop], changed;
            switch (c.prop) {
                case 'name':
                    if($ctrl.isInModal){
                        c.canEdit = $ctrl.isInModal && $ctrl.canEdit;
                        c.startInEditMode = c.canEdit;
                        var txt = c.colCls + ' without-vertical-padding';
                        if(c.editableContainerClass.indexOf(txt) === -1) {
                            c.editableContainerClass += ' ' + txt;
                        }
                        if(c.startInEditMode) {
                            c.editableContainerClass += ' with-sb-editable-hover';
                        }
                    }
                    c.placeholder = $ctrl.isScriptPage ? 'Scene idea' : ($ctrl.isCommentsSidebar ? 'Event name' : 'Task card');
                    changed = true;
                    break;

                case 'description':
                    if($ctrl.isInModal){

                        var txt = c.colCls + ' without-vertical-padding defaultbggray';
                        if(c.editableContainerClass.indexOf(txt) === -1) {
                            c.editableContainerClass += ' ' + txt;
                        }
                    }
                    c.placeholder = 'Add a ' + ($ctrl.isScriptPage ? 'scene ' : '') + 'description (optional)…';
                    changed = true;
                    break;

                case 'todoColumnId':
                case 'teamIds':
                case 'color':
                    c = setParent(c);
                    if(c.prop === 'color'){
                        if($ctrl.isInModal && $ctrl.canEdit){
                            c.withoutClose = true;
                        }
                    } else if(c.prop === 'teamIds'){
                        if(!$ctrl.isInModal){
                            c.circleSize = 'small24';
                        }
                        c.canEdit = $ctrl.isInModal && $ctrl.canEdit;
                        c.startInEditMode = c.canEdit;
                        c.teamLabel = $ctrl.taskBoardId ? 'Board Members' : ($ctrl.CPS.productId ? 'Project Users' : 'Team');

                    } else if(c.prop === 'todoColumnId'){
                        c.withoutText = false;
                        c.colorClass = $ctrl.isCommentsSidebar && !$ctrl.isInModal ? 'without-bg gray' : '';

                        if($ctrl.isInModal) {
                            c.cClassAttr = 'opendrp auto-width with-transition';
                            c.editableContainerClass = 'wrapper-outer without-padding with-arrow with-bgcolorgray' + ($ctrl.canEdit ? ' with-arrow' : '');

                            c.startInEditMode = $ctrl.canEdit;
                        }
                    }

                    changed = true;
                    break;

                case 'dates':
                    if ($ctrl.canEdit && $ctrl.isInModal) {
                        c.fieldClass = ' dueDate with-cursor ';
                        c.editableContainerClass = 'wrapper-outer without-padding with-arrow with-bgcolorgray' + ($ctrl.canEdit ? ' with-arrow' : '');
                        c.emptyIsCircle = false;
                        c.placeholder = '<span>No due date</span>';

                        c.dateFormat = 'MMM D';
                        //c.withoutOpenedDrp = true;
                        //c.withoutClose = true;
                        //c.withEditableOuter = true; //todo: the calendar doesnt trigger on clikc if this is enabled
                        c.startInEditMode = true;
                    }
                    break;

                default:
                  if(c.prop.indexOf('Date')!==-1){

                      //  c = _.extend(getColumnDate(prop, c.placeholder, true), c, setParent);
                  }
                    changed = true;
                    break;
            }
            if (changed) {
                columns[prop] = c;
            }
        }
        return columns;

        function setParent(c) {
            c.canEdit = $ctrl.isInModal && $ctrl.canEdit;
            if($ctrl.isInModal) {
                c.popoverContainer = '.modal-body.todocardpopup';
            }
            return c;
        }
    }

    function getCompletedStatusTooltip($ctrl, item, c) {
        return item.completed ? ('Completed on ' + $ctrl.CPS.getCreatedAt(item.completedAt, 'MMM D @ ' + $ctrl.CPS.timeFormat)) : (c && c.tooltipPlaceholder !== undefined ? c.tooltipPlaceholder : 'Mark as completed');
    }
    function getCompletedHtml($ctrl, item, prop) {
        var  c = (typeof($ctrl.getColumnByProp) === 'function' ? $ctrl.getColumnByProp : $ctrl.getColFromProp)(prop, true),
            canEdit = (item.isOnlyComment && $ctrl.canComment || !item.isOnlyComment && $ctrl.canEdit && c.canEdit),
            t = getCompletedStatusTooltip($ctrl, item, c);
        return c ? ('<div class="check no-drag' +
            (t ? ((item.isOnlyComment ? ' smaller-tooltip' : '') +
                '" tooltip-placement="' +(c.tooltipPlacement? c.tooltipPlacement : (item.isOnlyComment ? 'left' : 'right')) + '" tooltip="' + t + '"'
                //+ (canEdit ? ' tooltip-clear-cache="true"' : '')
            ) : '"') +
            '>' + getCheck() + '</div>') : '';

        function getCheck(){
             return $ctrl.SBFieldTypesService.getColDisplayDiv($ctrl, item, _.extend({}, c, {canEdit:false}));
        }

    }

    function getTitle(item, $ctrl) {
        return item.isOnlyComment ? $ctrl.itemTitle : ($ctrl.isScriptPage ? 'Scene idea' : (($ctrl.isCommentsSidebar && !$ctrl.isInModal || $ctrl.isInModal && $ctrl.isCalendarPage)  ? 'Event' : 'Task card'));
    }

    function getGridItemTemplate(item, $ctrl) {
        if(item.isOnlyComment) {
            $ctrl.itemTitle = 'Comment';
        }
        if (item.todoPageId) {
            $ctrl.todoPage = service.BlocksSetupService.getTodoPageById(item.todoPageId);
        }

        if($ctrl.isCommentsSidebar && $ctrl.uIdList && $ctrl.todoPage){
            item.uIdList = _.extend({}, getUIdList($ctrl.uIdList), !$ctrl.isInModal && $ctrl.todoPage.hasCommentGroups && $ctrl.commentGroup ? {
                currentItemId: $ctrl.commentGroup._id
            } : null);
        }

        var todoColumn;
        if(!todoColumn && item.todoColumnId) {
            todoColumn = _.find($ctrl.Settings.todoColumns, {_id: item.todoColumnId});
        }

        var title = getTitle(item, $ctrl);

        if(!item.icon){
            item.icon = $ctrl.isScriptPage? 'bulb' : ($ctrl.todoPage ? $ctrl.todoPage.icon : '');
            if($ctrl.isScriptPage){
                item.icon = 'bulb';
                item.iconLevel = 4;
            }else{
                if($ctrl.todoPage) {
                    item.icon = $ctrl.todoPage.icon;
                    item.iconLevel = $ctrl.todoPage.iconLevel;
                }
            }
        }

        return item.isOnlyComment ? ($ctrl.getCommentCard ? $ctrl.getCommentCard (item) : service.getCommentCard(item, $ctrl)) : getTabTask();

        function getColDisplayEl(prop, c, other) {
            c = _.extend({}, c ? c : $ctrl.getColumnByProp(prop), other, {
                onChange: "$ctrl.onChangedFieldInit(result)",
                onCancel: "$ctrl.onCloseEditableField(result)",
            });
            return c.startInEditMode && c.canEdit
                ? ('<div class="' + c.editableContainerClass + '">' +
                    $ctrl.SBFieldTypesService.getSBColContentEditTag($ctrl, c, item, {
                        withoutClose: true
                    }) +
                '</div>') : $ctrl.SBFieldTypesService.getColDisplayDiv($ctrl, item, c)
        }

        function getTabTask() {
            var clsblock = 'display-block clearfix min-height-132 ',
                withHSet = false;
            var res = '<div id="item_' + item._id + ($ctrl.isInModal ? '_modal' : '') + '" class="todo-card-item clearfix position-relative">' +
               getItem() +
               getTasks() +
               getFiles() +
               getComments(item, $ctrl,sidePaddingCls + ' comments-group min-height-162', 'smaller', 'small24') +
                '</div>';

            if(withHSet) {
                $ctrl.LCS.timeout(function (){
                    var cls = 'section-h-set',
                        els = $ctrl.element.querySelectorAll('.' + cls);
                    if (els) {
                        _.each(els, function (el) {
                            if (el) {
                                if (el.style) {
                                    el.style.removeProperty('height');
                                }
                                $ctrl.LCS.removeClass(el, cls);
                            }
                        });
                    }
                }, 400);
            }

            return res;


            function getItem() { //tasks only

                var tag = ($ctrl.isInModal && $ctrl.canEdit) ? 'form' : 'div';
        return '<' + tag + ' class="todo-card full-width clearfix display-block ' + ($ctrl.isInModal ? (sidePaddingCls + ' with-line-bottom') : (item.isOnlyComment ? '' : 'with-cursor')) + '" ' +
                    ($ctrl.isInModal && $ctrl.canEdit ? ('name="$ctrl.formHolder.form' + item._id + '" novalidate') : '') +
                    '>' +
                //(($ctrl.isInModal)&&todoColumn&&todoColumn.color ? ('<div class="todo-border todo-status-border" style="background-color:'+ todoColumn.color+'"></div>') : '') +
                    ($ctrl.isInModal && !item.active ? ('<div class="alert alert-info alert-archived text-center"><div><span class="sbf box with-margin-right"></span> This card has been archived.</div></div>') : '') +

                    '<div class="position-relative top-section ' + ($ctrl.isCommentsSidebar ? 'with-calendar ' : '') +
            (item.active ? '' : 'with-archived') + '">' +
                        '<div class="header-section clearfix one-line-tooltip" ' +
                            (($ctrl.isInModal || item.isOnlyComment) ? '' : $ctrl.getClickEventName('edit')) +
                        '>' +
                            ($ctrl.isInModal ? getHeaderInfo() : getName()) +
                        '</div>' +
                         getMoreBtnTemplate(item, $ctrl, false) +
                         (getCompleteMark(item, $ctrl, 'pull-left')) +
                    '</div>' +

                    ($ctrl.isInModal ? '' :
                        ('<div class="stats clearfix">' +
                            /*($ctrl.isCommentsSidebar ? (
                                (item.teamIds && item.teamIds.length>0 ? ('<div class="with-padding-right inline-block">' + getTeam() + '</div>') : '') +
                                ((hasDate()) ? ('<div class="with-padding-right inline-block">' + getDateContent() + '</div>') : '')
                            ) : '') +*/
                            '<div class="wrapper-tasks full-width">' + getStatsTasks($ctrl.isInModal, item) + '</div>' +
                             '<div class="wrapper">' + getStats($ctrl.isInModal, item) + '</div>' +
                             '<div class="stat">' + getDateContent() + '</div>' +
                             '<div class="stat pull-right no-padding">' + getTeam() + '</div>' +
                        '</div>'
                      )
                    ) +
                '</' + tag + '>' +
                ($ctrl.isInModal ? getDescription() : '');

                function hasDate(){
                    return item.startDate && item.startDate.value || item.dueDate && item.dueDate.value;

                }

                function getHeaderInfo() {
                    return '' +
                        //'<div class="full-width">'+ getStatusDrp()+'</div>'+

                        getColorDrp() + //todo see when this should display
                        getName() +
                        //getCardInfo() +
                        getBottomCard();
                }

                function getColorDrp() {
                    if (!$ctrl.isInModal || !$ctrl.isCalendarPage) {
                        return '';
                    }
                    return '<span class="custom-color-drp smaller custom-drp-selector">' + getColDisplayEl('color') + '</span>';
                }

                function getName() {
return $ctrl.isInModal ? ('<div class="name top position-relative table-div full-width ' + ($ctrl.isCalendarPage?'padding-left40':'')+' ">' +
        getModalIcon() +
    ($ctrl.canEdit ? (
            $ctrl.isInModal ? ('<div>'+ getColDisplayEl('name')+ '</div>') :
                getEditableName()
            ) :

            ('<div class="nametext contenteditable word-wrap">' + item.name + '</div>')
    ) +
    '</div>') :
    (   ($ctrl.isCommentsSidebar &&!$ctrl.isInModal ? getStatusOnSidebar() : '') +
         '<div class="name table-div full-width">' +
            (($ctrl.isLikeWorkflow || $ctrl.isInModal || $ctrl.isCommentsSidebar && $ctrl.isDashboard) ? ('<div class="col20">'+getIcon('sbf14')+'</div>') : '') +
            '<div class="nametext word-wrap ' + ($ctrl.isInModal ? '' : $ctrl.SBFieldTypesService.getViewEditElemSelector('name',true, $ctrl.canEdit)) + '">' + (item.name ? item.name : '') +
            '</div>' +
            //item._id +
            //'<div class=" '+$ctrl.SBFieldTypesService.getPropMark('order') +'">'+item.order+'</div>'+
        '</div>'
    );
                }

                function getEditableName(){
                    return '<div class="contenteditable nametext hover-underline" ' +
                        'placeholder="' + title + '…" ' +
                        'ng-model="$ctrl.item.name" ' +
                        'ui-focus="$ctrl.noname||' + $ctrl.isCommentsSidebar + '" ' +
                        'ng-blur="$ctrl.save()" ' +
                        'ui-keyup="{\'enter\':\'$ctrl.save()\'}" ' +
                        'contenteditable="true" ' +
                        'contenteditable-html strip-br="true" one-line="true" ' +
                        'ng-model-options="$ctrl.modelOptions" ' +
                        'required id="name" name="name"></div>' +
                        '<div ng-show="($ctrl.formHolder[\'form\'+$ctrl.item._id].name.$dirty || $ctrl.formHolder[\'form\'+$ctrl.item._id][\'formItem_attempted\']) && $ctrl.formHolder[\'form\'+$ctrl.item._id].name.$error.required" class="help-inline ng-hide">Please enter ' + title + '</div>';
                }

                function getModalIcon(){
                    return $ctrl.isCalendarPage ? '' : ('<div class="icon-absolute col30 centered vtop" style="padding-top:8px">' +
                        ($ctrl.canEdit && $ctrl.isScriptPage? getColDisplayEl('icon') : getIcon('sbf20')) +
                        '</div>');
                }

                function getStatusOnSidebar() {
                    return $ctrl.isDashboard ? '' : ('<div class="selected with-color centered">' +
                        getStatus(false,
                            '<div class="col10 centered inline-block"><div class="todo-status-border circle-container-10" style="background-color:' + (todoColumn ? todoColumn.color : '') + '"></div></div>' +
                            '<div class="todo-status-name statusname centered inline-block">' + (todoColumn ? todoColumn.name : '') + '</div>') +
                        '</div>');
                }

                function getStatusDrp() {
                    //'<span id="statusdrp">' + getColDisplayEl('todoColumnId') + '</span>' +
                    return $ctrl.isInModal ? getStatus(true, getColDisplayEl('todoColumnId')) : '';
                }

                function getStatus(isLarge, content) {
                    return '<div class="statusinline ' + (isLarge ? 'large' : '') + '">' + content + '</div>';
                }

                function getIcon(cls) {
                    return $ctrl.LCS.getISBDiv($ctrl.isScriptPage ? item.icon : $ctrl.todoPage.icon, $ctrl.todoPage.iconLevel ? $ctrl.todoPage.iconLevel : 2, 'colored icon ' + (cls ? cls : ''), $ctrl.isScriptPage ? '' : 'style="color:' + $ctrl.todoPage.color + '"');
                }

                function getCardInfo() {
                    return ($ctrl.isCommentsSidebar &&!$ctrl.isInModal || $ctrl.isScriptPage || $ctrl.isCalendarPage || !$ctrl.todoPage) ?
                        '' : ('<div class="card-info">in <a class="solid" href="' + getHref() + '" ng-click="$ctrl.cancelPopup()">' + $ctrl.todoPage.text + '</a>' + '</div>');

                    function getHref() {
                        var id = $ctrl.todoPage._id, params ={};
                        var stateParams = $ctrl.CPS.stateParams;
                        if (id && stateParams[id]) {
                            params[id] = stateParams[id];
                        }
                        return $ctrl.CPS.getStateHref($ctrl.todoPage.name, $ctrl.CPS.currentProductPathParams(params));
                    }
                }

                function getDescription() {
                    var el = '';
                    if (!$ctrl.canEdit) {
                        if (item.description) {
                            el += '<div class="word-wrap description contenteditable">' + item.description + '</div>';
                        }
                    } else {
                        //el += '<div class=" word-wrap description form-control contenteditable hover-underline" placeholder="Add a description (optional)…" ng-model="$ctrl.item.description" contenteditable="true" contenteditable-html strip-br="true" ng-blur="$ctrl.save()" ng-model-options="$ctrl.modelOptions"></div>';

                        el += getColDisplayEl('description');
                    }
                    if(!el){return  '';}

                    if($ctrl.isInModal){
                        var c = $ctrl.getColumnByProp('description');
                return '<div class="todo-card full-width clearfix display-block with-line-bottom ' + sidePaddingCls + '  ">' +
                            '<div class="subitem small-filters table-div">' +
                                '<div class="centered col30 icon-absolute">' + $ctrl.LCS.getISBDiv(c.icon) + '</div>' +
                                '<div class="centered"><span>'+c.name+'</span> <span class="taskStatsEl stats"></span></div>' +
                            '</div>' +
                            el +
                            '<button class="btn primary-faded-gray display-block block-show-more sb-hide ' + $ctrl.getBtnActionCls() + '"  data-type="showExtendedViewDescription">Show <span class="txt">more</span>...</button>' +

                            ($ctrl.canEdit ? ('<div class="full-width spacing-quarter-top sb-hide block-show-save">' +
                                '<button class="btn btn-small primary with-margin-right col100 ' + $ctrl.getBtnActionCls() + '"  data-type="saveDescription">Save</button>' +
                                '<button class="btn btn-small primary-faded-gray   col100 ' + $ctrl.getBtnActionCls() + '"  data-type="cancelSaveDescription">Cancel</button>' +
                            '</div>') : '') +
                        '</div>';
                    } else {
                        return '<div class="margin-top-quarter">' + el + '</div>';
                    }
                }

                function getBottomCard() {
                    var l = $ctrl.isInModal ? ('<span class="date-label">'+getDateLabel()+'</span>') : '';
                    return '<div class="bottom-card clearfix full-width ' + ($ctrl.isInModal ? '' : ''
                                //'table-div'
                        ) + '">' +
                                getCol(1, 'Team', getTeam(), !$ctrl.isInModal) +
                                ($ctrl.isInModal ? getCol(2, 'Column', getStatusDrp()) : '') +

                                getCol(3,  l, getDateContent(), !$ctrl.isInModal) +
                                //getShowTasks() +
                           '</div>';

                    function getCol(id, name, content, hideHeader) {
                        var cls = 'vtop ' + ($ctrl.isInModal ? 'padding-right-15 inline-block margin-bottom-quarter ' : ' inline-block pull-left with-padding-right'
                            //'centered with-padding-right'
                        );
                        return '<div class="' + cls + '"' + (id === 3 && !$ctrl.isInModal ? ' style="min-height:24px;align-content:center"' : '') + '>' +
                            (hideHeader ? '' : ('<div class="header-small clearfix">' + name + '</div>')) +
                            content +
                            '</div>';
                    }
                }

                function getDateContent(){
                    var d = getEditDueDate();//($ctrl.isCalendarPage ? getCalendarDueDate() : getEditDueDate());
                    return $ctrl.canEdit ? d : getNonModalDueDate($ctrl, 'centered ' + ($ctrl.isInModal ? 'medium' : ''), true, item);
                }

                function getTeam() {
                    var p = {
                        //startInEditMode: false,
                        canEdit: false,
                        canChangeOnEdit: true
                    }
                    return $ctrl.isScriptPage ? '' : getColDisplayEl('teamIds', null,
                        $ctrl.isInModal ? null : _.extend(p, {circleSize: $ctrl.isCommentsSidebar ? 'small16' : 'small24'}, p));
                }

                function getCalendarDueDate() {
                return '<div class="centered position-relative ' + ($ctrl.isInModal ? 'medium' : '') + '">' +
                        '<div class="one-line-tooltip padding-left10 col240">' +
                            '<div class="inline-block sbf calendar calendar-drp thinner position-relative vtop">' +
                                getColDisplayEl('startDate') +
                              /*  '<input validate-lowers="$ctrl.item.dueDate" class="elemdate dueDate date_picker form-control with-underline" id="startDate" name="startDate" type="text" close-text="Close" show-weeks="false" show-button-bar="false" ng-model="$ctrl.item.startDate" ng-click="$event.preventDefault();$event.stopPropagation();$ctrl.isStartOpen=!$ctrl.isStartOpen" is-open="$ctrl.isStartOpen" datepicker-popup="MMM d, yyyy" tooltip=\'Start Date\' tooltip-placement=\'bottom\'/>' +*/
                            '</div>' +
                            '<div class="inline-block or text-center centered col20 vtop line-height30">-</div>' +
                            '<div class="inline-block sbf calendar-drp thinner position-relative vtop">' +
                            getColDisplayEl('dueDate') +
                           /* '<input validate-greaters="$ctrl.item.startDate" class="elemdate dueDate date_picker form-control with-underline" id="dueDate" name="dueDate" type="text" close-text="Close" show-weeks="false" show-button-bar="false" ng-model="$ctrl.item.dueDate" ng-click="$event.preventDefault();$event.stopPropagation();$ctrl.isEndOpen=!$ctrl.isEndOpen" is-open="$ctrl.isEndOpen" datepicker-popup="MMM d, yyyy" tooltip=\'Due Date\' tooltip-placement=\'bottom\' />' +*/
                            '</div>' +
                        '</div>' +
                        '<div ng-show="$ctrl.dateError" class="help-inline ng-hide padding-left10">Due date must be after the start date.</div>' +
                        '</div>';
                }

                function getEditDueDate() {
                    return '<div class="centered ' + ($ctrl.isInModal ? 'medium padding-right-20' : 'thinner') + '">' +
                        ($ctrl.isInModal ?
                            (getModalDueDate() +
                                ('<div ng-show="$ctrl.dateError" class="help-inline ng-hide padding-left10">Due date must be after the start date.</div>')) : getNonModalDueDate($ctrl,null, true, item)) +
                        '</div>';
                }
            }

            function getModalDueDate() { //with dates
                var prop = 'dates';

                $ctrl.item.dates = ($ctrl.item.startDate || $ctrl.item.dueDate) ? {
                    from: $ctrl.item.startDate,
                    to: $ctrl.item.dueDate
                } : null;

                if (!$ctrl.getOtherFormParams) {
                    $ctrl.getOtherFormParams = {};
                }
                $ctrl.getOtherFormParams[prop] = function (result) {
                    console.log('getOtherFormParams: ' + prop);
                }

                var label = $ctrl.element.querySelector('.date-label');
                if(label){
                    label.innerText = getDateLabel();
                }

                return getColDisplayEl('dates');
            }

            function getDateLabel(){
                return $ctrl.item.startDate ? ($ctrl.item.dueDate ? 'Dates' : 'Start') : 'Due';
            }

            function getShowTasks() {
                return $ctrl.isInModal ? '' : ('<div class="centered no-drag text-right">' +
                    '<a ng-if="$ctrl.item.stats.tasks > 0 && $ctrl.item.stats.tasksCompleted < $ctrl.item.stats.tasks" class="showstats with_underline inline-block" ng-click="$ctrl.toggleShowTasks($event)">{{$ctrl.isShowTasks() ? \'Hide\' : \'Show\'}} Task{{$ctrl.item.stats.tasks == 1 ? \'\' : \'s\'}}</a>' +
                    '</div>');
            }

            function getTasks() {
                var prop = 'tasks',
                    h = getStyleH(prop);
        return '<tasks class="' + clsblock + ($ctrl.isInModal ? (sidePaddingCls + ' with-line-bottom') : '') +
                        (h?' section-h-set ' : '') +
                    '" ' +
                    getStyleH(prop) +
                    'ng-if="(' + $ctrl.isInModal + '||' + !$ctrl.isInModal + '&& $ctrl.isShowTasks() && $ctrl.item.stats.tasks >0 &&$ctrl.item.stats.tasks >= $ctrl.item.stats.tasksCompleted) && (' + $ctrl.canEdit + ' || $ctrl.item.stats.tasks > 0 && ' + !$ctrl.canEdit + ')" ' +
                    'ng-hide="' + !$ctrl.isInModal + ' && $ctrl.isShowTasks() && $ctrl.item.stats.tasks>0 && $ctrl.item.stats.tasks === $ctrl.item.stats.tasksCompleted" ' +

                    'tasks-card="::$ctrl.item" ' +
                    ($ctrl.isScriptPage ? 'title="Scene goals" ' : '')+

                    ($ctrl.withShortHandleCol ? ('with-short-handle="'+$ctrl.withShortHandleCol+'" ') : '')+
                    'can-edit="::'+$ctrl.canEdit+'" ' +
                    'is-in-modal="::' + $ctrl.isInModal + '" ' +
                    'selected-filter="::' + $ctrl.tasksFilter + '" ' +
                    'on-update-stats="$ctrl.onTasksUpdate(result)" ' +
                '></tasks>';
            }

            function getFiles() {
                if (!$ctrl.isInModal) {
                    return '';
                }
                var prop = 'attachments',
                    h = getStyleH(prop);
                return '<todo-files class="todo-files-section ' + clsblock + ($ctrl.isInModal ? sidePaddingCls : '') +
                    (h?' section-h-set ' : '') +
                    '" ' +
                    'ng-if="$ctrl.item.stats.' + prop + ' > 0 && ' + !$ctrl.canEdit + ' || ' + $ctrl.canEdit + '" ' +
                    getStyleH(prop) +
                    'can-edit="::' + $ctrl.canEdit + '" ' +
                    'tasks-card="::$ctrl.item" ' +
                    'on-update-stats="$ctrl.onFilesUpdate(result)" ' +
                    '></todo-files>';
            }

            function getStyleH(prop) {
                var minH = 132, h = getH(prop);
                if ($ctrl.isInModal && h > minH) {
                    withHSet = true;
                    return 'style="height:' + h + 'px"';
                }

                return '';
                function getH(prop) {
                    return $ctrl.isInModal && item && item.stats && item.stats[prop] ? 32 * item.stats[prop] : 0;
                }
            }
        }
    }

    function getCommentCard(item, $ctrl, cls) {
        var replyPictureClass = $ctrl.replyPictureClass || 'small16',
            canComment  = $ctrl.canComment && item.active;
    return '<div id="item_'+item._id+'" class="commentcard todo-card-item clearfix ng-hide position-relative' + (cls ? (' ' + cls) : '') + '" ng-class="$ctrl.item.completed?\'completed\':\'\'" ng-hide="'+($ctrl.tasksFilter===2)+'&&$ctrl.item.completed">' +
                '<div class="todo-card full-width clearfix">' +
                    '<div class="todocardinfo">' +
                        '<div class="header-section clearfix">' +
                            '<div class="item-container position-relative clearfix topmargin">' +
                                '<div class="profile-card pull-left with-margin-right">' +
                                    (item.createdBy ?  $ctrl.security.getUserImageComponent('$ctrl.item.createdBy', 'small24') : '') +
                                '</div>' +
                                '<div class="profile-info">' +
                                    (item.createdBy ? ('<div class="name">'+item.createdBy.name+ '</div>') : '') +
                                    '<div class="date">'+ $ctrl.CPS.getCreatedAt(item.createdAt, 'MMM D @ ' + $ctrl.CPS.timeFormat) +'</div>' +
                                '</div>' +
                                getCompleteMark(item, $ctrl, 'pull-right') +
                                (canComment ? getMoreBtnTemplate(item, $ctrl, false) : '') +
                            '</div>'+
                            '<div class="reply-container-unedit nametext word-wrap forse-select">'+(item.name||'')+'</div>' +
                            '<form class="sb-hide reply-container edit auto" name="$ctrl.formHolder.form'+item._id+'" novalidate autocomplete="off">' +
                                '<div class="word-wrap answer contenteditable" placeholder="Enter comment…" contenteditable="true" contenteditable-html ' +
        //'ng-model="$ctrl.item.nameEdit" ' +
        //'ui-focus="true"' +
        '></div>' +
                               //'<span ng-show="($ctrl.formHolder[\'form\'+$ctrl.item._id].name.$dirty || $ctrl.formHolder[\'formItem_attempted\']) && $ctrl.formHolder[\'form\'+$ctrl.item._id].name.$error.required" class="help-inline">Comment is required.</span>' +
                                '<span class="error" ng-show="$ctrl.error"></span>' +
                                '<div class="actions sb-hide">' +
                                    '<button class="btn btn-primary reply-answer" type="submit" ng-click="$ctrl.updateCommentName()" ng-disabled="$ctrl.isUpdating || !$ctrl.formHolder[\'form\'+$ctrl.item._id].$valid"><span class="sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Save</button>' +
                                    '<button class="btn btn-primary reply-answer transparent with-margin-left" ng-click="$ctrl.cancelEdit($event)">Cancel</button>' +
                                '</div>' +
                            '</form>' +
                        '</div>' +
                    '</div>' +
                    getComments(item, $ctrl,null, replyPictureClass, replyPictureClass) +
                '</div>' +
            '</div>';
    }

    function getComments(item, $ctrl, cls, pictureClass, replyPictureClass) {
        var canComment  = $ctrl.canComment && item.active;
        return (item.isOnlyComment || $ctrl.isInModal) ? ('<comments-group  ' +
            'ng-if="$ctrl.item.stats.answers > 0 && ' + (!canComment) + ' || ' + canComment + '" ' +
            'tasks-card="::$ctrl.item" ' +
            'class="'+(item.isOnlyComment?'with-comments-only ':'') + (cls ? cls : '') + '" ' +
            'can-edit="::'+canComment+'" ' +
            'is-in-modal="::'+$ctrl.isInModal+'" ' +
            ($ctrl.isScriptPage ? 'title="Scene Comments" ' : '') +
            'picture-class="' + pictureClass + '" ' +
            'reply-picture-class="' + replyPictureClass + '" ' +
            'on-update-stats="$ctrl.onCommentsUpdate(result)" ' +
            'without-focus="true" ' +
            '></comments-group>' +

            ($ctrl.canEdit ? '': '<div ng-if="!$ctrl.item.stats.answers" class="height30"></div>')) : '';
    }

    function dontShowCompleteMark($ctrl, item) {
        var show = ($ctrl.canComment && item.isOnlyComment || $ctrl.canEdit && !item.isOnlyComment) && item.active;
        return (!show && !item.completed);
    }

    function setCompleteEvent($ctrl,isBind) {
        var completeddrp = $ctrl.element.querySelector('#' + completeddrpId);
        if (completeddrp) {
            $ctrl.LCS.bindElementsClick(isBind, completeddrp, $ctrl.complete, 'taskcardCompleteddrp');
            $ctrl.LCS.addClass(completeddrp, 'with-cursor');
        }
    }

    function getCompleteMark(item, $ctrl, cls) {
        if (dontShowCompleteMark($ctrl, item)) {
            return '';
        }
        var val = getCompletedHtml($ctrl, item, 'completed');
        return val ? ('<div id="' + completeddrpId + '" ' + (cls ? ('class="' + (item.isOnlyComment ? '' : 'one-line-tooltip ') + cls + '"') : '') + '>' + val + '</div>') : '';
    }

    function getMoreBtnTemplate(item, $ctrl, hide) {
        //todo bring in popover
        var isCreator = $ctrl.CPS.userId === item.createdById;
        var show = (!item.isOnlyComment && $ctrl.canEdit || item.isOnlyComment && ($ctrl.CPS.isAuthenticated || !$ctrl.CPS.isAuthenticated && isCreator && $ctrl.canComment));
        if (!show) {
            return '';
        }
        var title = getTitle(item, $ctrl),
          canEditText = item.isOnlyComment && $ctrl.canComment && (isCreator || !isCreator && $ctrl.CPS.isAuthenticated && $ctrl.CPS.memberType >= 1),

            liCls = 'table-div full-width ', // + $ctrl.getBtnActionCls(),
            showTopBorder = false,
            el  = hide ? '' : ( $ctrl.isInModal ? (
                    '<div class="with-dots hide-print one-line-tooltip position-absolute'+($ctrl.isCommentsSidebar ? '' : ' with-bg') + '" style="left:0">' +
                    '<div class="btn-group actions" dropdown>' +
                    $ctrl.LCS.getMoreBtn() +
                    '<ul class="dropdown-menu-right side-menu fadeInDownLeft dropdown-menu workcardMenu" role="menu" dropdown-menu>' +
                    (!item.active && !$ctrl.isCalendarPage && (showTopBorder = true) ? ('<li><a class="'+liCls+'" ng-click="$ctrl.processItem($ctrl.item,\'Restore\')" analytics-on analytics-action="Restore ' + title + '"><div class="centered col30 with-padding-right">' + getI('box') + '</div> <div class="centered">Restore ' + title + '</div></a></li>'):'') +
                    (item.active !== false && !item.isOnlyComment && (showTopBorder = true) ? ('<li><a class="'+liCls+'" ng-click="$ctrl.processItem($ctrl.item,\'Duplicate\')" analytics-on analytics-action="Duplicate ' + title + '"><div class="centered col30 with-padding-right">' + getI('copy') + '</div> <div class="centered">Duplicate ' + title + '</div></a></li>'):'') +

                    // (item.active !== false && canEditText ? ('<li><a class="'+liCls+'" ng-click="$ctrl.item.isEdit=true" analytics-on analytics-action="Edit ' + title + '"><div class="centered col30 with-padding-right">' +$ctrl.LCS.getISBDiv('pencil', 2) + '</div><div class="centered">Edit ' + $ctrl.itemName + '</div></a></li>') : '') +
                    (showTopBorder ? '<li class="with-top-border table-div full-width"></li>' : '') +
                    getRemoveBtns() +
                    '</ul>' +
                    '</div>' +
                    '</div>') :(

                    '<div class="with-dots with-hover with-bg">' +
                    '<div class="btn-group actions with-sb-popover" popover-type="more-actions"><button type="button" class="btn btn-default dropdown-toggle dots">' + $ctrl.LCS.getISBDiv('vertical-dots',2) + '</button></div>' +
                    '</div>')
            );

        return '<div class="side-actions hide-print no-drag">' + el + '</div>';

        function getI(icon){
            return $ctrl.LCS.getISBDiv(icon,2);
        }

        function getRemoveBtns() {
            var isActive = $ctrl.isCalendarPage || !item.isOnlyComment && item.active;
            return (item.isOnlyComment ? '' : (isActive ? get('Archive', 'box') : get('Activate', 'box'))) +
                get('Remove', 'trash');

            function get(txt, icon) {
                return '<li><a class="accent table-div full-width" ng-click="$ctrl.processItem($ctrl.item,\'' + txt + '\')" analytics-on analytics-action="' + txt + ' ' + title + '"><div class="centered col30 with-padding-right">' + getI(icon) + '</div> <div class="centered">' + txt + ' ' + title + '</div></a></li>';
            }
        }
    }

    function getNonModalDueDate($ctrl, cls, withContainer, item, type) {
        var startDate = getDate('startDate'),
            dueDate = getDate('dueDate'),
            isSame = startDate && startDate === dueDate;

        if (!startDate && !dueDate && !$ctrl.canEdit) {
            return '';
        }

        var dueDateLabel = type === 2 ? '' : '',//'<span>Due: </span>',
            startDateLabel = type === 1 ? '' : '<span>Start: </span>',
            sd = (startDate ? getDateSpan(startDate, dueDate ? '' : startDateLabel, item.startDate) : ''),
            dd = (dueDate && !isSame ? getDateSpan(dueDate, startDate ? '' : dueDateLabel, item.dueDate) : '');
        return type === 1 ? sd : (type === 2 ? dd : get());

        function get() {
            var val = ((startDate || dueDate) ? ($ctrl.LCS.getISBDiv('clock', 6, ($ctrl.isCommentsSidebar ? 'sbf14 margin-top-3 ' : '') + 'gray pull-left with-margin-right')) : '') +
                sd +
                (startDate && dueDate && !isSame ? ('<div class="inline-block or text-center centered due-date"> - </div>') : '') +
                dd;
            return withContainer ? ('<div class="date-container ' + (cls || '') + '"' + (type?(' data-type="' + type + '"') : '') + '>' + val + '</div>') : val;
        }

        function getDate(prop) {
            var dateFormat1 = 'MMM D' + ($ctrl.isInModal ? ', YYYY' : '');//+' @ '+ $ctrl.CPS.timeFormat;
            return item[prop] && item[prop].value ? $ctrl.CPS.getCreatedAt(item[prop].value, dateFormat1) : null;
        }

        function getDateSpan(d, l,d1 ) {
            return d ? ('<div class="inline-block due-date' +
                //(isUpcomingDate(d1) ? ' alertd' : '') +
                '">' + l + '<span>' + d + '</span></div>') : '';
        }
    }

    function isUpcomingDate(d) {
        return d && MomentService.utc().isBefore(d.value);
    }

    function getDatesContent($ctrl, item, cls, type){
        return getNonModalDueDate($ctrl, cls, true, item, type);
    }

    function duplicate(item, $ctrl, onSuccess, onError) {
        var quotaType = $ctrl.isCalendarPage ? 'calendar' : ($ctrl.isScriptPage ? 'scriptOutline' : 'workflow');
        $ctrl.CPS.loadQuotaPopup(quotaType, process, $ctrl.maxFreeItemsCount, $ctrl.maxAddedCount || null, $ctrl.compOptions);
        function process() {
            console.log('duplicate task card');
            if(!$ctrl.service){
                console.warn('parent for TodoCardGridItemInitCtrlService must define service');
            }
            $ctrl.service.duplicate(_.extend({
                todoCardId: item._id,
                nextDay: item.startDate && item.startDate.value ? true : false
            }, getP(item, $ctrl)), function (result) {
                if (!result || !result.item) {
                    return onError();
                }
                result.item.createdBy = $ctrl.CPS.user;
                onSuccess(result);
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.todoCard.duplicate.success', 'success');
            }, onError);
        }
    }

    function archive(item, $ctrl, onSuccess, onError) {
        console.log('archive task card');
        if(!$ctrl.service){
            console.warn('parent for TodoCardGridItemInitCtrlService must define service');
        }
        $ctrl.service.archive(_.extend({
            _id: item._id
        }, getP(item, $ctrl)), function (result) {
            if (!result || !result.item) {
                return onError();
            }
            result.item.createdBy = $ctrl.CPS.user;
            onSuccess(result);
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.todoCard.Archive.success', 'success');
        }, onError);
    }

    function activate(item, $ctrl, onSuccess, onError) {
        console.log('activate task card');
        if(!$ctrl.service){
            console.warn('parent for TodoCardGridItemInitCtrlService must define service');
        }
        $ctrl.service.activate(_.extend({
            _id: item._id
        }, getP(item, $ctrl)), function (result) {
            if (!result || !result.item) {
                return onError();
            }
            result.item.createdBy = $ctrl.CPS.user;
            onSuccess(result);
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.todoCard.Activate.success', 'success');
        }, onError);
    }

    function remove(item, $ctrl, onSuccess, onError) {
        console.log('activate task card');
        if(!$ctrl.service){
            console.warn('parent for TodoCardGridItemInitCtrlService must define service');
        }
        $ctrl.service.delete(_.extend({
            _id: item._id
        }, getP(item, $ctrl)), function (result) {
            if (!result || !result.item) {
                return onError();
            }
            result.item.createdBy = $ctrl.CPS.user;
            onSuccess(result);
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.todoCard.Remove.success', 'success');
        }, onError);
    }

    function update(item, data, $ctrl, onSuccess, onError){
        console.log('activate task card');
        if(!$ctrl.service){
            console.warn('parent for TodoCardGridItemInitCtrlService must define service');
        }
        $ctrl.service.update(_.extend({}, data, getP(item, $ctrl)), function (result) {
            if (!result || !result.item) {
                return onError();
            }
            onSuccess(result);
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.todoCard.Remove.success', 'success');
        }, onError);
    }

    function complete(item, $ctrl, onSuccess, onError) {
        if(!$ctrl.canComment){return;}
        item.clicked = true;
        item.isEdit = false;

        if(!$ctrl.service){
            console.warn('parent for TodoCardGridItemInitCtrlService must define service');
        }

        var p = _.extend({
            id: item._id,
            completed: !item.completed
        }, getP(item, $ctrl));

        $ctrl.service.complete(p, onComplete, onError);

        function onComplete(result) {
            var el = result ? result.item : null;
            if(!el){return onError();}
            if (el) {
                var updates = {
                    _id: el._id,
                    completed: el.completed,
                    completedById: el.completedById
                };
                if(el.completedAt) {
                    updates.completedAt = $ctrl.MomentService.getMomentFromString(el.completedAt);
                }
                result.editchanges = updates;

                $ctrl.LCS[el.completed ? 'addClass' : 'removeClass']($ctrl.element.querySelectorAll('.showmore-wrap'), 'ng-hide');

                if($ctrl.isInModal) {
                    $ctrl.item = _.extend($ctrl.item, updates);
                    updateCompletedCheckmark($ctrl, $ctrl.item);
                }

                onSuccess(result);
            }
        }
    }

    function updateCompletedCheckmark($ctrl, item) {
        //getCSSClassFromProp(prop, notClass)
        var prop = 'completed';
        var inputEl = $ctrl.element.querySelector('.sb-prop-' + prop + ' input');
        if (inputEl) {
            if (item.completed) {
                inputEl.setAttribute('checked', 'checked');
            } else {
                inputEl.removeAttribute('checked');
            }

            var checkEl = $ctrl.LCS.findClosestParent(inputEl, '.check');
            checkEl.setAttribute('tooltip', getCompletedStatusTooltip($ctrl, item));
            checkEl.setAttribute('tooltip-clear-cache', true);
        }
    }

    function setCompletedCSS($ctrl, item, prop){
        $ctrl.LCS[item[prop] ? 'addClass' : 'removeClass']($ctrl.element, 'completed');
        updateCompletedCheckmark($ctrl, item);
       // $ctrl.element.querySelector('#'+ completeddrpId).innerHTML = getCompletedHtml($ctrl, $ctrl.item, prop);
    }

    function getP(item, $ctrl) {
        var p = {
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.productId, // $ctrl.CPS.productId,
            tabTasks : $ctrl.tabTasks
        };

        var uIdList = item.uIdList ? item.uIdList : $ctrl.uIdList;
        if(uIdList && item.isOnlyComment){
            p.uIdList = getUIdList(uIdList);
            if(item.uIdComment && $ctrl.todoPage.hasCommentGroups){
                p.uIdComment = item.uIdComment;
            }
        }
        return p;
        //return $ctrl.getParams();
    }
}

angular.module('product.workflow.item.controller.service',[
    'apiServices.Tasks',
    'components.validateLowers',
    'components.validateGreaters',
    'product.workflow.item.init.controller.service',
    'product.tasks.list.component',
    'product.todoFiles.list.component',
    'product.workflow.tasksReorder.popup'
])
.service('TodoCardGridItemCtrlService', TodoCardGridItemCtrlService);
TodoCardGridItemCtrlService.$inject = ['CompInitCtrlService', 'TodoCardGridItemInitCtrlService', 'RouteCollaboratorsService'];
function TodoCardGridItemCtrlService(CompInitCtrlService, TodoCardGridItemInitCtrlService, RouteCollaboratorsService) {
    return function ($ctrl) {
        $ctrl.TodoCardGridItemInitCtrlService = TodoCardGridItemInitCtrlService;
        $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
        $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;

        $ctrl.loadGridItemWithScope = true;
        $ctrl.withoutBorderBottom = true;
        $ctrl.showTasks = false;
        $ctrl.containerClass = 'references-view-item';

        $ctrl.onTasksUpdate = onTasksUpdate;
        $ctrl.onFilesUpdate = onFilesUpdate;
        $ctrl.onCommentsUpdate = onCommentsUpdate;
        $ctrl.preloadInitItem = preloadInitItem;
        $ctrl.bind = bind;
        $ctrl.isShowTasks = isShowTasks;
        $ctrl.toggleShowTasks = toggleShowTasks;
        $ctrl.cancelPopup = cancelPopup;
        $ctrl.updateEditableItemPropsAll = updateEditableItemPropsAll;

        $ctrl.$onDestroy = $onDestroy;

        $ctrl.preInitGridItem = preInitGridItem;
        if($ctrl.withPostInitGridItemOther){//mystaskitem
            $ctrl.postInitGridItemOther = postInitGridItem;
        } else{
            $ctrl.postInitGridItem = postInitGridItem;
        }
        $ctrl.onChangeOther = onChangeOther;
        $ctrl.updateCommentName = updateCommentName;
        $ctrl.initItemOther = initItemOther;

        $ctrl.validateEditableFields = validateEditableFields;
        $ctrl.onScrollDesc = onScrollDesc;
        $ctrl.toggleViewEditElemOther = toggleViewEditElemOther;
        $ctrl.cancelEdit = cancelEdit;

        return $ctrl;

        function toggleDescription(isEditMode) {
            // console.log('toggleDescription ' + isShow);
            var isShort = false;

            var el = $ctrl.element.querySelector('.with-sb-editable.sb-col-description .sb-view-content.ql-editor');

            if (!el) {
                return;
            }
            if (!$ctrl.initDescHeight) {
                $ctrl.initDescHeight = el.clientHeight;
            }

            if (el.scrollHeight <= $ctrl.initDescHeight) {
                isShort = true;
            }

            var showEl = $ctrl.element.querySelector('.block-show-more');
            $ctrl.LCS[isShort ? 'addClass' : 'removeClass'](showEl, 'sb-hide');
            if (!isShort) {
                showEl.querySelector('.txt').innerText = $ctrl.showExtenderDesc ? 'less' : 'more';
                $ctrl.LCS[$ctrl.showExtenderDesc ? 'addClass' : 'removeClass'](el, 'fullheight');
            }

            $ctrl.LCS[(isEditMode || isShort) ? 'removeClass' : 'addClass'](el.parentElement, 'long-desc');
            $ctrl.LCS[isEditMode ? 'removeClass' : 'addClass']($ctrl.element.querySelector('.block-show-save'), 'sb-hide');
        }

        function toggleViewEditElemOther(prop, showView) {
            //console.log('toggleViewEditElemOther');
            if (prop === 'description') {
                var isEditMode = !showView;
                if (isEditMode) {
                    $ctrl.LCS.timeout(function () {
                        $ctrl.showExtenderDesc = false;
                        bindDescScroll(isEditMode);
                        toggleDescription(isEditMode);
                    }, 220);

                } else {
                    $ctrl.showExtenderDesc = true;
                    bindDescScroll(isEditMode);
                    toggleDescription();
                }
            }
        }

        function bindDescScroll(isBind) {
            $ctrl.descEl = $ctrl.element.querySelector('.sb-col-description.toolbarontop .sb-editable-outer');
            if ($ctrl.descEl) {
                $ctrl.descToolbarEl = $ctrl.descEl.querySelector('.editortoolbar');
                if ($ctrl.descToolbarEl) {
                    var b = $ctrl.descToolbarEl.getBoundingClientRect();

                    $ctrl.descToolbarElWidth = b.width;
                    $ctrl.descToolbarElHeight = b.height;
                    $ctrl.descToolbarElLeft = b.left;
                    $ctrl.descToolbarElTop = b.top;

                    $ctrl.scrollerEl = $ctrl.LCS.$document[0].querySelector('body.modal-open .modal.fade.in');
                    if ($ctrl.scrollerEl) {
                        $ctrl.LCS.bindElementListeners(isBind, $ctrl.scrollerEl, $ctrl.onScrollDesc, 'scroll', {
                            passive: true
                        });
                    }
                }
            }
        }

        function onScrollDesc(e) {
            //console.log('onScroll pageYOffset scrollTop ' + $ctrl.scrollerEl.scrollTop);
            if ($ctrl.descEl && $ctrl.scrollerEl) {
                var isOnTop = ($ctrl.scrollerEl.scrollTop >= $ctrl.descToolbarElTop) &&
                    ($ctrl.scrollerEl.scrollTop < $ctrl.descToolbarElTop + $ctrl.descEl.clientHeight - $ctrl.descToolbarElHeight - 4);
                if ($ctrl.isOnTop !== isOnTop) {
                    $ctrl.isOnTop = isOnTop;
                    if (!$ctrl.descToolbarEl) {
                        $ctrl.descToolbarEl = $ctrl.descEl.querySelector('.editortoolbar');
                    }
                    if ($ctrl.descToolbarEl) {
                        if (!$ctrl.descToolbarEl.style) {
                            $ctrl.descToolbarEl.style = {};
                        }
                        if (isOnTop) {
                            $ctrl.descToolbarEl.style.position = 'fixed';
                            $ctrl.descToolbarEl.style.left = $ctrl.descToolbarElLeft + 'px';
                            $ctrl.descToolbarEl.style.width = $ctrl.descToolbarElWidth + 'px';
                            $ctrl.descToolbarEl.style.top = '-10px';
                        } else {
                            $ctrl.descToolbarEl.style.removeProperty('position');
                            $ctrl.descToolbarEl.style.removeProperty('left');
                            $ctrl.descToolbarEl.style.removeProperty('width');
                            $ctrl.descToolbarEl.style.removeProperty('top');
                        }
                    }
                }
            }
        }

        function initItemOther() {
            $ctrl.team = $ctrl.Settings ? $ctrl.Settings.team : null;

            if ($ctrl.item.taskBoardId) {
                $ctrl.addRootWatcher('TASKBOARD_TEAM_UPDATED_' + $ctrl.item.taskBoardId, onTaskBoardTeamChanged);
            }
        }

        function validateEditableFields(elements) {
            var id = $ctrl.item ? $ctrl.item._id : null;
            return id ? _.filter(elements, function (el) {
                var gridItem = $ctrl.LCS.findClosestParent(el, '.row-scheduleTemp');
                return !gridItem || gridItem && gridItem.getAttribute('data-id') === id;
            }) : elements;
        }

        function onTaskBoardTeamChanged(teamIds) {
            $ctrl.team = $ctrl.RouteCollaboratorsService.getTeamByIds(teamIds);
            if (!$ctrl.Settings) {
                $ctrl.Settings = {};
            }
            $ctrl.Settings.team = $ctrl.team;
            var prop = 'teamIds';
            if ($ctrl.item[prop]) {
                $ctrl.updatePropContent(prop);
            }
        }

        function setEditMode(show, val) {
            console.log('setEditMode');
            if ($ctrl.item.isEdit !== show) {
                if(show) {
                    $ctrl.item.nameOld = $ctrl.item.name;
                } else{
                    delete $ctrl.item.nameOld;
                }
                var wrapper = getContentEditEl(),
                    el = wrapper ? wrapper.querySelector('.contenteditable') : null;
                set(wrapper, el, show);

                $ctrl.LCS[show ? 'removeClass' : 'addClass'](wrapper.querySelector('.actions'), 'sb-hide');

                el = getContentEl();
                set(el, el, !show);

                $ctrl.item.isEdit = show;
                return el;
            }

            function set(wrapper, el, show) {
                if (wrapper) {
                        if(!wrapper.classList){wrapper.classList = {};}
                        wrapper.classList[show ?'remove' : 'add']('sb-hide');
                       // $ctrl.LCS[show ? 'removeClass' : 'addClass'](wrapper, 'sb-hide');
                    if (show && el) {
                        el.innerHTML = val;
                    }
                }
            }
        }

        function cancelEdit(e){
            if($ctrl.item.nameOld) {
                $ctrl.item.name = $ctrl.item.nameOld;
            }
            setEditMode(false, $ctrl.item.name);
        }

        function getContentEditEl() {
            return $ctrl.element.querySelector('.todocardinfo .reply-container.edit');
        }

        function getContentEl() {
            return $ctrl.element.querySelector('.todocardinfo .reply-container-unedit');
        }

        function onCommentEdit() {
            console.log('onCommentEdit');

            var val = $ctrl.item.name;
            //$ctrl.item.nameEdit = val;
            var el = setEditMode(true, val);

            if (el) {
                $ctrl.LCS.timeout(function () {
                    el.focus();
                }, 0);
            }
        }

        function updateCommentName() {
            console.log('updateCommentName');
            if( $ctrl.isUpdating){return;}

            $ctrl.isUpdating = true;
            var prop = 'name',
                wrapper = getContentEditEl(),
                el = wrapper ? wrapper.querySelector('.contenteditable') : null,
                val = el ? el.innerHTML : null;

            if (val && val !== $ctrl.item.nameOld) {
                $ctrl.item[prop] = val;
                var editchanges = {_id: $ctrl.item._id};
                editchanges[prop] = val;

                //processItem(null, editchanges, 'Update', onSuccessOther);

                 $ctrl.TodoCardGridItemInitCtrlService.update($ctrl.item, editchanges, $ctrl, onSuccess, onError);

                function onSuccess() {
                    $ctrl.isUpdating = false;
                    //  $ctrl.LCS.toast('Comment updated successfully', 'success');


                    var result = {
                        editchanges: editchanges,
                        newRes: {item: $ctrl.item, type: 'todoCards'},
                        prop: prop,
                        selected: {field: prop, val: val}
                    }

                    $ctrl.onChangedField(result);

                    setEditMode(false, $ctrl.item.name);
                }

                function onError(err) {
                    $ctrl.isUpdating = false;
                    console.log(err);
                    $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.todoCard.' + errType + '.error', 'error');
                }
            }
        }

        function preInitGridItem() {
            $ctrl = new CompInitCtrlService($ctrl);
            $ctrl.isInModal = $ctrl.isInModal === true || $ctrl.isInModal === 'true';
            $ctrl.isOnlyComment = $ctrl.item.isOnlyComment;
            if (!$ctrl.item.stats) {
                $ctrl.item.stats = {};
            }
        }

        function postInitGridItem() {
            if ($ctrl.canEdit) {
                $ctrl.postInitItem = postInitItem;
                $ctrl.complete = complete;

                if ($ctrl.isInModal) {
                    $ctrl.clear = clearDate;
                    $ctrl.processItem = processItem;
                    $ctrl.onChangedField = onChangedField;
                    $ctrl.onChange = onChange;

                    setTempDate();

                    if (!$ctrl.watcherUpdatedDate) {
                        $ctrl.watcherUpdatedDate = $ctrl.addRootWatcher('UPDATED_TASKCARD_DATE_' + $ctrl.item._id, onUnpdateTodoCardDate);
                    }
                } else if ($ctrl.canComment && $ctrl.item.isOnlyComment && $ctrl.todoPage
                    //&& $ctrl.todoPage.editCommentFromGroup
                ) {
                    if (!$ctrl.watcherCommentEdit) {
                        console.log('TRIGGER_COMMENT_EDIT_' + $ctrl.item._id);
                        $ctrl.watcherCommentEdit = $ctrl.addRootWatcher('TRIGGER_COMMENT_EDIT_' + $ctrl.item._id, onCommentEdit);
                    }
                }
            }

            scrollToEl();

            hideDescription();
            if ($ctrl.isInModal) {
                if (!$ctrl.watcherDesc) {
                    $ctrl.watcherDesc = $ctrl.addRootWatcher('TOGGLE_TASKCARD_EXTENDED_DESC_' + $ctrl.item._id, onToggleExtendedDesc);
                }
            }
        }

        function onToggleExtendedDesc() {
            console.log('onToggleExtendedDesc');
            $ctrl.showExtenderDesc = $ctrl.showExtenderDesc ? false : true;
            toggleDescription();
        }

        function hideDescription() {
            if ($ctrl.isInModal) {
                $ctrl.LCS.timeout(function () {
                    $ctrl.showExtenderDesc = false;
                    toggleDescription();
                }, 250);
            }
        }

        function scrollToEl() {
            $ctrl.LCS.timeout(function () {
                var id = $ctrl.CPS.getSearchFilter($ctrl.item.isOnlyComment ? 'comment' : 'task');
                if (id && id === $ctrl.item._id) {
                    var p = $ctrl.LCS.findClosestParent($ctrl.element, '.scrollable-content');
                    if (p) {
                        p.scrollTop = $ctrl.element.offsetTop;// + $ctrl.element.offsetHeight;
                    }
                    $ctrl.LCS.addClass($ctrl.element.querySelector('.row-schedule'), 'selected');
                }
            }, 500);
        }

        //if in modal
        function onChangedField(result) {
            console.log('TodoCardGridItemCtrl.onChangedField');
            $ctrl.TodoCardGridItemInitCtrlService.onChangedFieldInModal($ctrl, result);

            if ($ctrl.isInModal && result && result.prop === 'description') {
                bindDescScroll(false);
                hideDescription();
            }
        }

        function onChangeOther(result) {
            console.log('TodoCardGridItemCtrl.onChangeOther');
            $ctrl.TodoCardGridItemInitCtrlService.onChangedFieldInModal($ctrl, result);
        }

        function onChange(result) {
            if (!result) {
                console.log('onchange: result is undefined');
                return;
            }
            console.log('GridItemEditGroupInitCtrlService.onchange');
            var selected = result.selected;
            if (selected) {
                var s = selected.field.split('.');
                if (s.length === 1) {
                    $ctrl.item[selected.field] = selected.val;
                } else if (s.length === 2) {
                    if (!$ctrl.item[s[0]]) {
                        $ctrl.item[s[0]] = {};
                    }
                    $ctrl.item[s[0]][s[1]] = selected.val;
                }
            }

            if (typeof ($ctrl.onChangeOther) === 'function') {
                $ctrl.onChangeOther(result);
            }

            onCancel(result);

            function onCancel(result) {
                if (result.close) {
                    var prop = result.selected ? result.selected.field : null;
                    if (prop) {
                        $ctrl.broadcastRoot('CLOSE_GRID_EDITABLE_FIELD', prop ? {
                            _id: $ctrl.item._id,
                            prop: prop,
                            elementId: $ctrl.getElementId(prop)
                        } : null);
                    }
                }
            }
        }

        function setItemColumn(todoColumnId) {
            $ctrl.TodoCardGridItemInitCtrlService.setItemColumn($ctrl, todoColumnId);
        }

        function updateEditableItemPropsAll(changes) {
            console.log('onchangedfi');
            if (!$ctrl.canEdit || !changes) {
                return;
            }
            if ($ctrl.hasPropChanged(changes, 'todoColumnId')) {
                setItemColumn($ctrl.item.todoColumnId);
                if (!$ctrl.isInModal) {
                    $ctrl.triggerAction(null, 'changeStatus', changes.previousValue.todoColumnId);
                }
            }
            if ($ctrl.hasPropChanged(changes, 'stats')) {
                var el = $ctrl.element.querySelector('.stats .wrapper');
                if (el) {
                    el.innerHTML = $ctrl.TodoCardGridItemInitCtrlService.getStats($ctrl.isInModal, $ctrl.item);
                }

                var el = $ctrl.element.querySelector('.stats .wrapper-tasks');
                if (el) {
                    el.innerHTML = $ctrl.TodoCardGridItemInitCtrlService.getStatsTasks($ctrl.isInModal, $ctrl.item);
                }
            }

            //dates is not changed in non popup
            if (!$ctrl.isInModal && ($ctrl.hasPropChanged(changes, 'dueDate') || $ctrl.hasPropChanged(changes, 'startDate'))) {
                console.log('startDate or due date');
                var el = $ctrl.element.querySelector('.date-container');
                if (el) {
                    el.innerHTML = $ctrl.TodoCardGridItemInitCtrlService.getDatesContent($ctrl, $ctrl.item, el.getAttribute('data-type'));
                }
            }
            var prop = 'completed';
            if ($ctrl.hasPropChanged(changes, prop)) {
                $ctrl.TodoCardGridItemInitCtrlService.setCompletedCSS($ctrl, $ctrl.item, prop);
            }
        }

        function $onDestroy() {
            bind(false);

            if ($ctrl.onInitDestroy) {
                $ctrl.onInitDestroy();
            }
            $ctrl.destroyGridItem();

            $ctrl.removeWatchers();
        }

        function postInitItem() {
            if (!$ctrl.isNotFirstTime && $ctrl.isInModal) {
                $ctrl.LCS.addClass($ctrl.element.querySelector('.row-schedule'), 'without-hover');
            }

            bind(true);

            $ctrl.isNotFirstTime = true;
            $ctrl.LCS[$ctrl.item.completed ? 'addClass' : 'removeClass']($ctrl.element, 'completed');


            if ($ctrl.isInModal && !$ctrl.resizeWatcher) {
                $ctrl.resizeWatcher = $ctrl.addRootWatcherSimple($ctrl.LCS.onWindowWidthChanged(onWindowResize));
            }
        }

        function onWindowResize() {
            if ($ctrl.descToolbarEl) {
                var b = $ctrl.descToolbarEl.getBoundingClientRect();
                $ctrl.descToolbarElLeft = b.left;
            }
        }

        function bind(isBind) {
            if (isBind) {
                set(!isBind);
            }
            set(isBind);

            function set(isBind) {
                $ctrl.TodoCardGridItemInitCtrlService.setCompleteEvent($ctrl, isBind);

                if ($ctrl.isOnlyComment) {
                    if ($ctrl.canComment) {
                        if ($ctrl.isInModal) {
                            var name = $ctrl.element.querySelector('.nametext.contenteditable');
                            $ctrl.LCS.bindElementsClick(isBind, name, onBlur, 'taskcardName', 'blur');
                        }
                    }
                } else {
                    if (!$ctrl.isInModal) {
                        if (!$ctrl.isTouchScreen) {
                            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('.todo-card'), bindSidebarCard, 'taskcardSidebarCard');
                        }
                    } else {
                        $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('.showstats'), stopPropagation, 'taskcardShowstats');

                        if ($ctrl.canEdit) {
                            var name = $ctrl.element.querySelector('.nametext.contenteditable');
                            $ctrl.LCS.bindElementsClick(isBind, name, stopPropagation, 'taskcardName');
                            $ctrl.LCS.bindElementsClick(isBind, name, onBlur, 'taskcardName', 'blur');
                            $ctrl.LCS.bindElementsClick(isBind, name, onKeyDown, 'taskcardName', 'keydown');
                        }
                    }
                }
            }

            function bindSidebarCard(e) {
                console.log('on binded click');
                var target = e.target;
                if (!$ctrl.LCS.findClosestParent(target, '.tasks') &&
                    !$ctrl.LCS.findClosestParent(target, '.side-actions') &&
                    !$ctrl.LCS.findClosestParent(target, '.action-buttons') &&
                    !$ctrl.LCS.findClosestParent(target, '.modal-body')) {
                    $ctrl.preventDefault(e);
                    $ctrl.edit();
                }
            }

            function onBlur(e, val) {
                stopPropagation(e);
                changeNameField(e, val);
            }

            function onKeyDown(e, val) {
                stopPropagation(e);
                switch (e.which) {
                    case 13:
                        changeNameField(e, val);
                        break;
                }
            }

            function stopPropagation(e) {
                e.stopPropagation();
            }

            function changeNameField(e, val) {
                if ($ctrl.noname) {
                    $ctrl.LCS.timeout(function () {
                        $ctrl.noname = false;
                    }, 0);
                }
            }
        }

        //not used
        function preloadInitItem() {
            bind(false);
            $ctrl.noname = !$ctrl.item.name;
            setItemColumn($ctrl.item.todoColumnId);
            setItemPage();
            loadTeam();

            function loadTeam() {
                if (!$ctrl.team) {
                    $ctrl.team = $ctrl.Settings.team;
                }
                /* $ctrl.item.team = [] ;
                 var l = $ctrl.item.teamIds ? $ctrl.item.teamIds.length : 0;
                 if (l > 0 && $ctrl.team) {
                     for (var i = 0; i < l; i++) {
                         var id = $ctrl.item.teamIds[i];
                         for (var j = 0; j < $ctrl.team.length; j++) {
                             var el = $ctrl.team[j];
                             if (id === el._id) {
                                 $ctrl.item.team.push(el);
                                 break;
                             }
                         }
                     }
                 }*/
            }
        }

        function setItemPage() {
            if ($ctrl.item.todoPageId) {
                $ctrl.todoPage = $ctrl.BlocksSetupService.getTodoPageById($ctrl.item.todoPageId);
            }
        }

        function onTasksUpdate(result) {
            console.log('TodoCardGridItemCtrl.onTasksUpdate');
            onCountersUpdate(['tasks', 'tasksCompleted'], result);
        }

        function onFilesUpdate(result) {
            console.log('TodoCardGridItemCtrl.onFilesUpdate');
            onCountersUpdate(['attachments'], result);
        }

        function onCommentsUpdate(result) {
            console.log('TodoCardGridItemCtrl.onCommentsUpdate');
            onCountersUpdate(['answers'], result);
        }

        function onCountersUpdate(props, result) {
            console.log('TodoCardGridItemCtrl.onCountersUpdate');
            if (!result) {
                return;
            }
            $ctrl.onChangedField(result);

        }

        function getDate(date) {
            return new Date(date.year(), date.month(), date.date(), 0, 0, 0, 0);
        }

        function clearDate(isStartDate) {
            $ctrl.item[isStartDate ? 'startDate' : 'dueDate'] = null;
        }

        function onUnpdateTodoCardDate(item) {
            if (!item) {
                console.log('invalid item');
            }
            $ctrl.item.startDate = item.startDate;
            $ctrl.item.dueDate = item.dueDate;
            setTempDate();
        }

        function updateDate(newVal, oldVal) {
            if ($ctrl.temp) {
                if ($ctrl.temp.startDate && $ctrl.temp.dueDate && $ctrl.temp.startDate > $ctrl.temp.dueDate) {
                    return;
                }
                setDate('startDate');
                setDate('dueDate');
            }

            function setDate(prop) {
                var date = $ctrl.temp[prop];
                if (date) {
                    var t = $ctrl.item[prop].value;
                    if (!t) {
                        t = prop === 'startDate' ? $ctrl.MomentService.getUtcMomentStartDay() : $ctrl.MomentService.getUtcMomentEndDay();
                    }
                    t = t.date(date.getDate()).month(date.getMonth()).year(date.getFullYear());
                    $ctrl.item[prop].value = t;
                } else {
                    $ctrl.item[prop].value = null;
                }
            }
        }

        function setTempDate() {
            var startDate = $ctrl.item.startDate.value,
                dueDate = $ctrl.item.dueDate.value;
            $ctrl.temp = {
                startDate: startDate ? getDate(startDate) : startDate,
                dueDate: dueDate ? getDate(dueDate) : dueDate,
            };
        }

        //$ctrl.process(item, $ctrl.operations.duplicateCallsheet, $ctrl.objectType
        function complete(e) {
            //console.log('complete');
            $ctrl.preventDefault(e);
            processItem(null, 'Complete');
        }

        function cancelPopup() {
            if ($ctrl.onClose) {
                $ctrl.onClose({result: 'cancel'});
            }
        }

        function processItem(item, type, onSuccessOther) {
            $ctrl.type = type;

            if (type === 'Duplicate' && $ctrl.quotaType) {
                $ctrl.CPS.loadQuotaPopup($ctrl.quotaType, process, $ctrl.maxFreeItemsCount, $ctrl.maxAddedCount, $ctrl.compOptions);
            } else {
                process();
            }

            function process() {
                var m = type.toLowerCase(),
                    errType = type,
                    event = 'UPDATED',
                    change;

                if ($ctrl.item.isOnlyComment && $ctrl.uIdList && !$ctrl.item.uIdList) {
                    $ctrl.item.uIdList = _.extend({}, $ctrl.uIdList, {currentItemLikes: null});
                }
                //Duplicate Archive Activate Remove
                switch (type) {
                    case 'Duplicate':
                        event = $ctrl.isCalendarPage ? 'DUPLICATED' : 'ADDED';
                        break;

                    case 'Restore':
                    case 'Archive':
                    case 'Remove':
                        event = $ctrl.isCalendarPage ? 'REMOVED' : 'UPDATED';
                        change = !$ctrl.isCalendarPage;

                        if (type === 'Restore') {
                            m = 'activate';
                        }
                        break;

                    case 'Complete':
                        errType = 'complete';
                        break;
                }

                if (m) {
                    $ctrl.TodoCardGridItemInitCtrlService[m]($ctrl.item, $ctrl, onSuccess, onError);
                }

                function onSuccess(result) {
                    result.eventType = type === 'Restore' ? 'Activate' : type;
                    result.isInModal = $ctrl.isInModal;

                    if (change) {
                        var item = result.item;

                        if (type !== 'Remove') {
                            result.editchanges = {
                                _id: item._id,
                                active: type === 'Restore'
                            };
                        }
                        $ctrl.broadcastRoot('RELOAD_ARCHIVED_TREE_GROUPS');
                    }

                    $ctrl.broadcastRoot(event + '_TASKCARD_ITEM', result);

                    if(!type === 'Complete') {
                        $ctrl.cancelPopup();
                    }

                    if(onSuccessOther){
                        onSuccessOther(result);
                    }
                }

                function onError(err) {
                    console.log(err);
                    $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.todoCard.' + errType + '.error', 'error');
                }
            }
        }

        function isShowTasks() {
            return $ctrl.showTasks === true;
        }

        function toggleShowTasks(e) {
            $ctrl.preventDefault(e);
            $ctrl.showTasks = $ctrl.showTasks ? false : true;
        }

        function onDestroyItemGrid() {
            bindDescScroll(false);
        }
    }
}

angular.module('product.workflow.item.new.component',[
    'apiServices.TodoCards'
])
.component('todoCardNew', {
    bindings: {
        compOptions:'<',
        showBorder: '<',
        showIcon: '<',
        getNew: '&',
        onAdded: '&',
        cancelNewCard: '&',

        showOnClick: '@',
        isShow:'@',
        uIdComment: '@',
        toggleEnterComment: '&'
    },
    controller: 'TodoCardNewDirectiveController',
})
.controller('TodoCardNewDirectiveController', TodoCardNewDirectiveController);

TodoCardNewDirectiveController.$inject = ['ListItemTemplateFormCtrlService', 'TodoCardsService', 'BlocksSetupService', '$element'];
function TodoCardNewDirectiveController(ListItemTemplateFormCtrlService, service, BlocksSetupService, $element) {

    var debugNewCard = false;

    var $ctrl = this;

    $ctrl.elNameCls = 'nametext';
    $ctrl.pictureClass = 'small24';//for comments
    $ctrl.dontAutoloadTemplate = false;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitOther = preInitOther;
    $ctrl.postInitOther = postInitOther;

    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl.showEnterComment = showEnterComment;

    $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

    function onLoaded() {
        focus();
        bind(true);

        if ($ctrl.uIdComment && !$ctrl.showWatcher) {
            $ctrl.showWatcher = $ctrl.addRootWatcher('TOGGLE_COMMENT_ENTER_' + $ctrl.uIdComment, toggleComment);
        }
    }

    function getName() {
        if (!$ctrl.elName) {
            $ctrl.elName = $ctrl.element.querySelector('.' + $ctrl.elNameCls);
        }
        return $ctrl.elName;
    }

    function focus() {
        if (!$ctrl.showOnClick || $ctrl.showOnClick && $ctrl.isShow) {
            var el = getName();
            if (el) {
                el.focus();
            }
        }
    }

    function onDestroy() {
        bind(false);
    }

    function bind(isBind) {
        var el = getName();
        if (el) {
            //$ctrl.LCS.bindElementsClick(isBind, el, onBlur, null, 'blur');
            $ctrl.LCS.bindElementsClick(isBind, el, onKeyDown, 'taskcardName1', 'keydown paste');
            //comment out below if u dont want to remove new card on blur - good for debug
            if(!debugNewCard) {
                $ctrl.LCS.bindElementsClick(isBind, el, onBlur, 'taskcardName1', 'blur');
            }
        }
    }

    function onBlur(e) {
        if ($ctrl.tabTasks === 'tasks') {
            $ctrl.saveNew(e);
        }
    }

    function toggleComment(isShow) {
        //console.log('todoCardNew: toggleComment ' + $ctrl.uIdComment);
        if (!($ctrl.isShow && isShow || !$ctrl.isShow && !isShow)) {
            showEnterComment();
        }
    }

    function setBtnsVisible() {
        if (!$ctrl.commentBtns) {
            $ctrl.commentBtns = $ctrl.element.querySelector('.commentbtns');
        }

        $ctrl.LCS[$ctrl.item.name && $ctrl.item.name.trim().length > 0 ? 'removeClass' : 'addClass']($ctrl.commentBtns, 'sb-hide');
    }

    function onKeyDown(e) {
        //console.log('todoCardNew: onKeyDown');
        setBtnsVisible();

        //check if is cmd
        var isCtrl = e.ctrlKey || e.metaKey,
            isComments = $ctrl.tabTasks === 'comments' && isCtrl;
        switch (e.which) {
            case 13: //enter
                if ($ctrl.tabTasks === 'tasks' || isComments) {
                    saveNew(e);
                }
                break;

            case 8: //delete
                if (isComments) {
                    $ctrl.preventDefault(e);
                    cancelNew();
                }
                break;
        }
    }

    function showEnterComment() {
        $ctrl.isShow = $ctrl.isShow ? false : true;
        $ctrl.LCS[$ctrl.isShow ? 'removeClass' : 'addClass']($ctrl.element.querySelector('.todo-card-item'), 'sb-hide');
        if ($ctrl.isShow) {
            focus();

            if ($ctrl.uIdComment) {
                $ctrl.toggleEnterComment({result: {uIdComment: $ctrl.uIdComment, isShow: true}});
            }
        }
    }

    function preInitOther() {
        //$ctrl.isShow = $ctrl.element.getAttribute('is-show') === 'true';

        $ctrl.cancelNew = cancelNew;

        getNew();

        setItemColumn();
        setItemPage();

        $ctrl.tabTasks = !$ctrl.item.active ? 'archived' : ($ctrl.item.isOnlyComment ? 'comments' : 'tasks');
        $ctrl.type = 'Create';
        $ctrl.extraParam = {service: service};
    }

    function postInitOther() {
        $ctrl.itemTitle = $ctrl.tabTasks === 'comments' ? 'Comment' : 'Task Card title';

        $ctrl.onSave = onSave;
        $ctrl.saveNew = saveNew;
    }

    function onSave(result) {
        if ($ctrl.tabTasks !== 'comments') {
            $ctrl.LCS.addClass($ctrl.element, 'sb-hide');
        } else {
            cancelNew(true);
            //getNew();
        }
        if ($ctrl.onAdded) {
            $ctrl.onAdded({result: result});
        }

        toggleAddCommentLink(true);
    }

    function toggleAddCommentLink(show) {
        if ($ctrl.showOnClick) {
            var el = $ctrl.element.querySelector('.btnShowEnterComment');
            if (el) {
                $ctrl.LCS[show ? 'removeClass' : 'addClass'](el, 'sb-hide');
            }
        }
    }

    function saveNew(e) {
        $ctrl.preventDefault(e);

        if (!$ctrl.item._id && !$ctrl.isUpdating) {
            if ($ctrl.item.name) {
                $ctrl.save(e);
            } else {
                if ($ctrl.tabTasks !== 'comments') {
                    $ctrl.cancelNewCard();
                } else {
                    getNew();

                    toggleAddCommentLink(false);
                }
            }
        }
    }

    function getNew() {
        //console.log('getNew');
        $ctrl.item = $ctrl.getNew();
        setBtnsVisible();
    }

    function getItemTemplate() {
        var isTasks = $ctrl.tabTasks === 'tasks',
            icon = $ctrl.isScriptPage ? 'bulb' : ($ctrl.todoPage.icon ? $ctrl.todoPage.icon : ''),
            title = $ctrl.isScriptPage ? 'Scene idea' :
                (isTasks ? ('Write a task name') : ('Enter ' + $ctrl.itemTitle));
        return ($ctrl.showOnClick ? ('<a class="btnShowEnterComment ' + $ctrl.getBtnActionCls() + ($ctrl.isShow ? ' sb-hide' : '') + '" data-type="showEnterComment">Add ' + $ctrl.itemTitle + '</a>') : '') +
            '<div class="clearfix todo-card-item new-card' + ($ctrl.showOnClick && !$ctrl.isShow ? ' sb-hide' : '') + '">' +
            '<form class="todo-card full-width clearfix" name="$ctrl.formHolderItem[$ctrl.formName]" novalidate autocomplete="off">' +
            //getTopBorder() +
            '<div class="header-section clearfix">' +
            getStatusOnSidebar() +
            (isTasks ? '' : getCommentPicture()) +
            '<div class="name ' + (isTasks ? 'table-div full-width' : 'topmargin') + '">' +
            (isTasks ? getIcon() : '') +
            getEditableName() +
            getCommentBtns() +
            '</div>' +
            $ctrl.LCS.getErrorBlock() +
            '</div>' +
            '</form>' +
            '</div>';

        function getIcon() {
            return $ctrl.isCommentsSidebar ? '' :
                ('<div class="col20 ' + ($ctrl.isTaskBoards ? '  with-check-mark' : '') + '">' +
                    ($ctrl.isTaskBoards ? '' : $ctrl.LCS.getISBDiv(icon, 6, 'sbf14 icon colored')) +
                '</div>');
        }

        function getStatusOnSidebar() {
            return $ctrl.isCommentsSidebar && isTasks ? ('<div class="statusinline table-div">' +
                '<div class="selected with-color col10 centered"><div class="todo-status-border circle-container-10" style="background-color:' + ($ctrl.todoColumn ? ($ctrl.todoColumn.color || '') : '') + '"></div></div>' +
                '<div class="todo-status-name statusname centered">' + ($ctrl.todoColumn ? ($ctrl.todoColumn.name || '') : '') + '</div>' +
                '</div>') : '';
        }

        function getCommentPicture() {
            return '<div class="picture pull-left with-margin-right"> ' +
                '<div class="profile-card position-relative">' +
                ($ctrl.CPS.user ? $ctrl.security.getUserImageComponent('$ctrl.CPS.user', $ctrl.pictureClass) : '') +
                '</div>' +
                '</div>'
                //+ getProfileInfo()
                ;

            function getProfileInfo() {
                return '<div class="profile-info">' +
                    '<div class="name">' + $ctrl.CPS.user.name + '</div>' +
                    '<div class="date">' + $ctrl.CPS.getCreatedAt($ctrl.MomentService.getMomentNow(), 'MMM D @ ' + $ctrl.CPS.timeFormat) + '</div>' +
                    '</div>';
            }
        }

        function getTopBorder() {
            return ($ctrl.showBorder ? ('<div class="todo-border todo-status-border" ' +
                ($ctrl.todoColumn && $ctrl.todoColumn.color ? ('style="background-color:' + $ctrl.todoColumn.color + '"') : '') +
                '></div>') : '')
        }

        function getEditableName() {
            return '<div id="name" tabindex="123" class="contenteditable word-wrap ' + $ctrl.elNameCls + '" ' +
                'contenteditable="true" contenteditable-html ' +
                'placeholder="' + title + '…" ' +
                'ng-model="$ctrl.item.name" ' +
                'analytics-on analytics-action="New ' + title + '" ' +
                'strip-br="' + isTasks + '" ' +
                'one-line="' + isTasks + '"' +
                '></div>';
        }

        function getCommentBtns() {
            return isTasks ? '' : (
                '<div class="commentbtns clearfix margin-top-quarter wide-tooltip' + ($ctrl.item.name && $ctrl.item.name.trim().length > 0 ? '' : ' sb-hide') + '">' +
                '<a class="' + $ctrl.getBtnActionCls() + '" data-type="saveNew" analytics-on analytics-action="New ' + title + '"><span class="sbf font12 loadingicon animate-spin sb-hide"></span> Post</a>' +
                '<span class="dot-separator small"></span>' +
                '<a class="' + $ctrl.getBtnActionCls() + '" data-type="cancelNew">Cancel</a>' +
                '<div class="with-padding-left inline-block" tooltip-placement="top" tooltip="All team members (and collaborators invited to this page) will be notified by email when a new comment or reply is posted or marked as complete.">' + $ctrl.LCS.getISBDiv('info-circle', 4, 'gray') + '</div>' +
                '</div>');
        }
    }

    function cancelNew(justAdded) {
        $ctrl.error = null;
        getNew();

        $ctrl.cancelNewCard({result: {force: true, justAdded: justAdded}});
    }

    function setItemColumn() {
        if ($ctrl.todoColumns && $ctrl.item.todoColumnId) {
            $ctrl.todoColumn = _.find($ctrl.todoColumns, {_id: $ctrl.item.todoColumnId});
        }
    }

    function setItemPage() {
        if ($ctrl.item.todoPageId) {
            $ctrl.todoPage = BlocksSetupService.getTodoPageById($ctrl.item.todoPageId);
        }
    }
}

angular.module('progressbar.service', [
])
    .service('ProgressBarService', ProgressBarService);
ProgressBarService.$inject = ['LCS'];
function ProgressBarService(LCS) {
     return function (options){
          //console.log('ProgressBarService');
          var colors = {red:'#F9185F', orange: '#FF7824', yellow: '#FFC800', lime: '#A2C71F', green: '#00B865'},
            service = {

                 LCS: LCS,
                 delay: 240,
               progressCls: 'progressEl',
               wrapperCls: null,
               showEmpty: false,
               animationTime: 1400,
               parentElement: null,
               elementSelector: null,
               progressBar: null,
               progressType: 'Line',
               progressText: '{{completed}} of {{total}} task{{plural}}',

               setProgressBar: setProgressBar,
               getProgressBar: getProgressBar,
               getProgressBarContent: getProgressBarContent,
               onDestroyProgressBar: onDestroyProgressBar,
                 getCallsheetOptions: getCallsheetOptions
          };

          service.colors = _.extend({}, colors, options.otherColors);
          if(options.otherColors) {
               delete options.otherColors;
          }

          service = _.extend(service, options);

          if(!service.strokeWidth) {
               if (service.progressType === 'Circle') {
                    service.strokeWidth = 12;
               } else {
                    service.strokeWidth = 1;
               }
          }

          return service;

          function getCallsheetOptions() {
               var options = {
                    animate: {
                         duration: 1000,
                         enabled: true
                    },
                    scaleLength: 0,
                    trackColor: '#DBE2E3',
                    lineWidth: 3,
                    lineCap: 'round',
                    size: 64
               };
               return {
                    OptionsView: _.extend({barColor: DefaultTodoCardColor}, options),
                    OptionsConfirm: _.extend({barColor: '#27CE94'}, options)
               };
          }

          function setProgressBar(stats){
               if(!ProgressBar){
                    console.warn('ProgressBar.js must be imported');
                    return;
               }

               service.stats = stats;

               var isShow = service.showEmpty || service.stats && service.stats.total > 0;

               //console.log('loadProgressBar');
               if(setProgressVisibility(isShow)) {
                    installBar();
                    service.LCS.timeout(animateProgress, service.delay);
               }

               function setProgressVisibility(exists) {
                    set(exists);
                    if (service.setProgressVisibilityOther) {
                         service.setProgressVisibilityOther(exists);
                    }
                    return exists;

                    function set(exists) {
                         service.LCS[exists ? 'removeClass' : 'addClass'](getEl(), 'sb-hide');
                    }
               }

               function installBar(){
                    var el = getEl();
                    if(!el){
                         //console.log('getProgressBarContent mustbe added to elem that should have the progrss bar');
                         return;
                    }
                    if(!el.innerHTML || !service.progressBar) {
                         service.fromColor = getColor(0);
                         service.toColor = getColor(0);

                         var colorTrail = '#E4E6F2';

                         service.progressBar = new ProgressBar[service.progressType](el, _.extend({
                              easing: 'easeInOut',
                              trailColor: colorTrail,
                              trailWidth: service.trailWidth ? service.trailWidth : service.strokeWidth,
                              strokeWidth: service.strokeWidth,
                              svgStyle: null, //{width: '100%', height: '100%'},
                              text: {
                                   autoStyleContainer: false
                              },
                              color: service.fromColor,
                              step: function (state, bar) {
                                   bar.path.setAttribute('stroke', state.color);

                                   /*if(service.progressType === 'Circle') {
                                    bar.path.setAttribute('stroke-width', state.width);
                                   }*/

                                   var completed = service.stats ? service.stats.completed : 0,
                                       total = service.stats ? service.stats.total : 0;
                                   bar.setText('<div class="table-div full-width">' +
                                       '<div class="left">' + Math.round(bar.value() * 100) + '% complete</div>' +
                                       '<div class="right">' + getProgressText(completed, total) + '</div>' +
                                       '</div>');

                              }
                         }, getAnimationParams()));
                    }
               }

               function getProgressText(completed, total){
                    return service.progressText.replace('{{completed}}', completed)
                        .replace('{{total}}', total)
                        .replace('{{plural}}', (total === 1 ? '' : 's'));
               }

               function animateProgress(isInit){
                    var val = getStatsPercentage();

                    if(!isInit){
                         service.fromColor = service.toColor;
                         service.toColor = getColor(val);
                    }

                    if(service.progressBar && service.progressBar.animate) {
                         try{
                              service.progressBar.animate(val, getAnimationParams(800));// Number from 0.0 to 1.0}

                         }catch (err){}
                    }

                    function getStatsPercentage(){
                       return service.stats && service.stats.completed ? (service.stats.completed / service.stats.total) : 0;
                    }
               }

               function getAnimationParams(duration) {
                    return {
                         duration: duration ? duration : service.animationTime,
                         from: {color: service.fromColor},
                         to: {color: service.toColor},
                    };
               }

               function getEl( ){
                    var name = service.progressCls;
                  //  if (!service[name]) {
                         service[name] = service.parentElement ? service.parentElement.querySelector(
                             (service.elementSelector ? (service.elementSelector) : '') +
                             '.' + name) : null;
                   // }
                    return service[name];
               }

               function getColor(val){ //0-1
                    return val < 0.2 ? service.colors.red : (val < 0.4 ? service.colors.orange: (val < 0.6 ? service.colors.yellow : (val < 0.8 ? service.colors.lime : service.colors.green)));
               }
          }


          function getProgressBar(){
               return '';
          }

          function getProgressBarContent(isShow){
               return '<div class="' + service.progressCls +
                   (service.wrapperCls ? (' ' + service.wrapperCls) : '') +
                   ((isShow || service.showEmpty) ? '' : ' sb-hide') + '">' + service.getProgressBar() + '</div>';
          }

          function onDestroyProgressBar(){
               if(service.progressBar) {
                    try {
                         service.progressBar.destroy();
                    }catch (e){
                         //console.log('destroy progress bar error');
                         //console.log(e);
                    }
               }
          }
     }
}


angular.module('apiConstants.tasks.services', [
    'sb.fields.types.service'
])
.service('TasksConstantsService', TasksConstantsService);
TasksConstantsService.$inject = ['SBFieldTypesService'];
function TasksConstantsService(SBFieldTypesService ) {
    var PropTypes = SBFieldTypesService.PropTypes,
        eClassAttr = 'form-control without-underline ' ,
        eClassAttr1 = eClassAttr + ' autogrow ' ,
        eClassAttr2 = 'form-control hover-underline ',

        Settings = {
            Columns: {
                "1": {
                    id: "1",
                    name: 'Completed',
                    prop: 'stats',
                    type: PropTypes.BigCheck,
                    canEdit: true,
                    order: 1,
                    triggerEditOnCol: true,
                    colCls: 'col30 text-left vtop',
                    fieldClass: 'circled inrow',
                    withTooltip: false,
                    showMobile: true,
                    tooltipPlacement: 'right',
                    notInModal: true
                },
                "2": {
                    id: "2",
                    name: 'Name',
                    prop: 'name',
                    type: PropTypes.Html,
                    colCls: 'col100 primarycolor full-height-editor without-vertical-padding ',
                    placeholder: 'Task…',
                    triggerEditOnCol: true,
                    canChangeOnEdit: true,
                    canEdit: true,
                    order: 2,
                    grow: true,
                    canHide: false,
                    showMobile: true,
                    isMobileTitle: true,

                    parentContainer: true,
                    eClassAttr: eClassAttr1,
                    editableContainerClass: 'noninlineeditor',

                    withFullHeight: true,
                    withEditableOuter: true,
                    autofocus: true,

                    withNoToolbar: true,
                    saveOnEnter: true,  //simulate field
                    saveOnKeydown: true,

                    withoutLabelInPopup: true,
                    canOnlyChangeManually: true,

                },

                "3": {
                    id: "3",
                    name: 'Notes',
                    prop: 'note',
                    placeholder: 'Special Instructions…',
                    canEdit: false,
                    canChangeOnEdit: true,
                    order: 3,
                    type: PropTypes.HtmlTooltip,
                    colCls: 'note-tooltip text-center',
                    notInModal: true
                },

                "4": {
                    id: "4",
                    name: 'Due Date',
                    prop: 'dueDate',
                    type: PropTypes.Date,
                    colCls: 'time-col view inline',
                    fieldClass: 'datetime',
                    order: 4,
                    canHide: true,
                    canEdit: true,
                    placeholder: 'Assign Due Date…',
                    triggerEditOnCol: true,
                    notInModal: true,
                },
                "5": {
                    id: "5",
                    name: 'Team',
                    prop: 'teamIds',
                    type: PropTypes.Team,
                    colCls: 'teamWrapper one-line-tooltip centered',
                    order: 5,
                    canHide: true,
                    canEdit: true,
                    placeholder: 'Assign Team…',
                    triggerEditOnCol: true,
                    notInModal: true,
                },
                "6": {
                    id: "6",
                    name: 'Segment',
                    nameLong: 'Seg # ',
                    placeholder: 'Seg #',
                    prop: 'segNo',
                    type: PropTypes.Field,
                    fieldClass: 'text-center shotList ',
                    colCls: 'cant-shrink scene-col shotList text-center',
                    order: 20,
                    canSort: false,
                    canHide: true,
                    canEdit: false,
                    canChangeOnEdit: true,
                    eClassAttr: eClassAttr2,
                    wrapperClass: 'centered',
                    showMobile: true,
                    hideHeaderColumn: true,
                    cantEditInPopup: true,
                    notInModal: true,
                    notInFilter: true
                },
            }
        },

    CompOptions = {
        withoutMouseHover: true,
        //withCreateInlineGroup: true,
        withEditInlineGroup: true,
        dragHandleOnTheSide: true,
        withoutBorderBottom: true,
        noSideColumnBorders: true,
        withoutCheckbox: true,
        listField: 'todoCardId',
        objectType: 'task',
        itemTitle: 'Task',
        elemType: 'TASK',
        preLoadingTableName: 'Tasks',
        hasTree: false,
        cantBeDraggedLast: true,
    },

    ListParams = {
        includeFields: ['name', 'note', 'stats', 'createdById', 'createdAt', 'dueDate', 'teamIds', 'order', 'type', 'setupId'],
        searchFields: ['name'],
        orderFields: ['order'],
        populate: 'createdById teamIds'
    },

    Options = {
        columns: [1, 2
            //,3,4,5
        ]
    },

    GroupSettings = {
        customButtons:true,
        gridItemClass: 'short-item-grid',
        groupItemTag: 'task',
        withoutSideBorderCls: true,
        showSortingColumns: false,
    },

    KeyboardServiceParams = {
        canCopy: false,
        canMove: false
    };

    return {
        ViewProp: 'tasksView',
        ListParams: ListParams,
        CompOptions: CompOptions,
        PropTypes: PropTypes,
        Options: Options,
        Settings: Settings,
        GroupSettings: GroupSettings,
        KeyboardServiceParams: KeyboardServiceParams,
    };
}

angular.module('product.tasks.item.grid.component', [
    'groupBlock.item.controller.service',
    'product.avscript.item.withSetup.service',
    'progressbar.service'
])

.component('taskItemGrid', itemBlockGroupGridItemParams({
    isInModal: '<',
    shotTypes: '<'
}, 'TaskItemGridCtrl'))
.controller('TaskItemGridCtrl', TaskItemGridCtrl);
TaskItemGridCtrl.$inject = ['GridBlockItemGroupInitCtrlService', 'GridItemWithSetupCtrlService', 'ProgressBarService', 'LCS', '$element'];
function TaskItemGridCtrl(GridBlockItemGroupInitCtrlService, GridItemWithSetupCtrlService, ProgressBarService, LCS, $element) {
    //console.log('TaskItemGridCtrl: $onInit');

    var $ctrl = this;

    $ctrl.LCS = LCS;
    $ctrl.ProgressBarService = ProgressBarService;


    $ctrl.groupParentCls = '.tree-node';
    $ctrl.groupItemTag = 'task';
    $ctrl.preLoadingTableNameInit = 'Tasks';
    $ctrl.setupRowCls = 'setup1';
    $ctrl.drpWrapperCls = 'task-drp-wrapper';

    $ctrl.changedFields = ['item'];
    $ctrl.bindingNames = ['create'];
    $ctrl.segmentProps = ['name', 'stats'];

    $ctrl.setPostInitGridItemOther = true;
    $ctrl.compiledBottomButtons = true;

   // $ctrl.loadGridItemWithScope = true; //for task-new component

    $ctrl.isCurrentListItem = isCurrentListItem;
    $ctrl.getBottomBtns = getBottomBtns;
    $ctrl.getHeaderSegmentContent = getHeaderSegmentContent;
    $ctrl.onCreate = onCreate;
    $ctrl.onSetupNameChanged =  onSetupNameChanged;
    $ctrl.preInitGridItemOther = preInitGridItemOther;
    $ctrl.addBottomButtonsOther = addBottomButtonsOther;
    $ctrl.toggleDropdown = toggleDropdown;
    $ctrl.onHeaderSegmentContentAdded = onHeaderSegmentContentAdded;
    $ctrl.canTriggerSetNextSetup = canTriggerSetNextSetup;
    $ctrl.getEditableColFromProp = getEditableColFromProp;
    $ctrl.onCloseEditableField = onCloseEditableField;
    $ctrl.onDestroyGridItemOther = onDestroyGridItemOther;

    $ctrl = new GridItemWithSetupCtrlService($ctrl);
    $ctrl = new GridBlockItemGroupInitCtrlService($ctrl, $element);

    function canTriggerSetNextSetup(){
        return $ctrl.isInModal;
    }
    function preInitGridItemOther() {
        $ctrl.triggerEditSegment = true;
        try{
            $ctrl.triggerEditSegment = !JSON.parse( $ctrl.compOptions).withCreateInlineGroup;
        }catch(e){}

        if(!$ctrl.item || $ctrl.item.type !== 0 || !$ctrl.canTriggerSetNextSetup()){return;}//only for setups
        initProgressBar();

        if ($ctrl.canEdit) {
            var name = 'Checklist';
            $ctrl.sideActions = [
                {n: 'Add ' + name + ' Under', m: 'create', icon: 'daybreak', iconLevel: 4},
               // {n: 'Edit Segment', m: 'edit', icon: 'pencil'},
                {n: 'Move ' + name, m: 'openTasksReorder', icon: 'transition rotate', iconLevel: 5},
               // {n: 'Duplicate Segment', m: 'create', other: true, icon: 'copy'},
                {n: 'Remove ' + name, m: 'remove', icon: 'trash'}
            ];
            $ctrl.triggerSideAction = triggerSideAction;
        }
    }

    function triggerSideAction(e){
        //$ctrl.preventDefault(e);
        var el = e.currentTarget,
            parent = $ctrl.LCS.findClosestParent(el, '.'+$ctrl.headerSetupCls);
        if(!parent){return;}
        var segId = parent.getAttribute('data-next');
        if(segId) {
            var p = {
                id: segId,
                type: el.getAttribute('data-type')
            };
            var other = el.getAttribute('data-other');
            if(other){
                p.other = other;
            }
            $ctrl.broadcastRoot('SIDE_ACTION_SETUP_' + $ctrl.elemType + '_' + $ctrl.currentListId, p);
        }
        toggleDropdown(e);
    }

    function addBottomButtonsOther() {
        $ctrl.LCS.timeout(function () {
            //setProgressBar($ctrl.item);
        }, 300);

        if ($ctrl.canTriggerSetNextSetup()) {
            $ctrl.addRootWatcher('UPDATE_SETUP_' + $ctrl.elemType + '_' + $ctrl.item._id, updateProgressBar);

            $ctrl.addRootWatcher('UPDATE_NEXT_SETUP_INFO_' + $ctrl.elemType + '_' + $ctrl.item._id, $ctrl.triggerSetNextSegment);
        }
    }

    function updateProgressBar(item){
        if(item) {
            $ctrl.item.setupStats = item.setupStats;
        }
        setProgressBar($ctrl.item);
    }

    function isCurrentListItem(item) {
        return item.todoCardId === $ctrl.currentListId;
    }

    function getBottomBtns(item) {
        //console.log('getBottomBtns');
        var tag = $ctrl.groupItemTag +'-new';
        return $ctrl.canTriggerSetNextSetup() &&  $ctrl.canEdit ? '<'+tag+' class="task-new display-block clearfix full-width" object-type="::$ctrl.objectType" on-create="$ctrl.onCreate(result, $event)"></'+tag+'>' : '';
    }

    function onCreate(more, e){
        //console.log('onCreate');
        $ctrl.createInit($ctrl.shotTypes.Shot, more, e);
    }

    function getEditableColFromProp(prop) {
        return prop === 'name' ? _.extend({}, _.find($ctrl.columnsList, {prop: prop}), {
            placeholder: 'Checklist name…',
            canEdit: $ctrl.canEdit,
            editableContainerClass: 'without-height-padding noninlineeditor'
        }) : $ctrl.getColFromProp(prop);
    }

    function getCustomeTriggerName(withDot){
        return $ctrl.SBFieldTypesService.SBFieldEditableTrigger + (withDot ? '.' : ' ') + 'customedit';
    }

    function getHeaderSegmentContent(seg) {
        //console.log('getHeaderSegmentContent');
        return '<div class="full-width table-div">' +
            ($ctrl.triggerEditSegment ?  getName() : getNameWithEdit())+
            '<div class="col100">' + getProgressBarContent() + '</div>' +
            getBtns() +
            getToggle() +
            '</div>';

        function getName(){
            var name = seg ? seg.name : null;
                                                            //bind edit segment on click
            return '<div class="clearfix' + ($ctrl.canEdit ? (' with-cursor with_underline editSegment sb-col-name" data-info="' + seg._id) : '') + '">' + '</span><span class="sb-prop-name inline-block' +
                ' sb-field-manual' +
                '">' + (name||'') + '</span>' + '</div>';
        }

        function getNameWithEdit(){
            var c = $ctrl.getEditableColFromProp('name');
            return '<div class="clearfix' + ($ctrl.canEdit ? (' with-cursor " data-info="' + seg._id) : '') + '">' +
                //remove sb-editable-trigger to allow for binding customevent
                $ctrl.SBFieldTypesService.getColDisplayEl($ctrl, seg, c, ' ', 'div', false, false, false).replace($ctrl.SBFieldTypesService.SBFieldEditableTrigger, getCustomeTriggerName()) +
                '</div>';
        }

        function getProgressBarContent(){
            return $ctrl.progressBarService ? $ctrl.progressBarService.getProgressBarContent(hasTasks(seg)) : '';
        }

        function getBtns(){
            return '<div class="side-actions hide-print no-drag col20 position-relative">' +
                '<div class="with-dots hide-print one-line-tooltip position-absolute with-bg" style="left:0;top:-5px">' +
                    '<div class="btn-group actions dropdown ' + $ctrl.drpWrapperCls + '">' +
                        '<button type="button" class="btn btn-default dropdown-toggle dots" aria-haspopup="true" aria-expanded="false">' +
                            $ctrl.LCS.getISBDiv('vertical-dots-bold') + '<span class="sr-only">Toggle Dropdown</span>' +
                        '</button>' +
                        '<ul class="dropdown-menu-right side-menu fadeInDownLeft dropdown-menu workcardMenu" role="menu">' + getItems() + '</ul>' +
                    '</div>' +
                '</div>' +
            '</div>';

            function getItems(){
            return  $ctrl.sideActions.map(function (item){
                return '<li><a class="table-div full-width " data-type="' + item.m + '" ' +
                    (item.other ? (' data-other="'+item.other+'" ') : '') + 'analytics-on analytics-action="' + item.n + '">' +
                    '<div class="centered col30 with-padding-right">' + $ctrl.LCS.getISBDiv(item.icon, item.iconLevel) + '</div>' +
                    '<div class="centered">' + item.n + '</div>' +
                    '</a></li>';
            }).join('');
            }
        }

        function getToggle(){
            return '';
        }
    }

    function onCloseEditableField(result){
        //console.log('onCloseEditableField');

        $ctrl.onCloseEditableFieldInit(result);
        if($ctrl.isInModal && $ctrl.item && $ctrl.item.type === 0 && result.prop === 'name' ) {
          //  $ctrl.onCloseEditableFieldOther('name', result);
            var viewEl = $ctrl.element.querySelector($ctrl.SBFieldTypesService.getViewEditElemSelector(result.prop, false, true));
            if(viewEl) {
                viewEl = viewEl.querySelector('.sb-view-content');
                if(viewEl) {
                    viewEl.innerHTML = $ctrl.nextSegment.name;
                }
            }
        }
    }

    function onHeaderSegmentContentAdded(isBind, parent, seg) {
        //console.log('onHeaderSegmentContentAdded');
        if ($ctrl.canEdit && $ctrl.canTriggerSetNextSetup()) {
            $ctrl.LCS.bindElementsClick(isBind, parent.querySelectorAll('.side-actions .dropdown-toggle'), $ctrl.toggleDropdown);
            $ctrl.LCS.bindElementsClick(isBind, parent.querySelectorAll('.side-actions .dropdown-menu li a'), $ctrl.triggerSideAction);

            if(!$ctrl.triggerEditSegment) {
                $ctrl.LCS.bindElementsClick(isBind, parent.querySelector('.' + getCustomeTriggerName(true)), makeFieldNameEditable);
            }
        }

        function makeFieldNameEditable(e) {
            e.item = seg; //$ctrl.nextSegment;
            e.fieldEditParams = {
                //service: null,
                onCancel: onCloseNameField,
                onChange: onChangedNameField
            }
            $ctrl.makeFieldEditable(e);
        }

        function onCloseNameField(result){
            //console.log('onCloseNameField');
            onCloseEditableField(result);
        }

        function onChangedNameField(result) {
            console.log('onChangedNameField');
            var changes = result.editchanges;
            if (changes && changes._id === seg._id) {
                seg.name = changes.name;
            }
            result.eventType =  'CHANGED_FIELD';
            $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result);
        }
    }

    function toggleDropdown(e, id) {
        //console.log('toggleDropdown ' + id);
        var el, isOpen,
            cls = '.' + $ctrl.headerSetupCls,
            drpCls = '.' + $ctrl.drpWrapperCls,
            prop = 'data-current';
        if (e) {
            $ctrl.preventDefault(e);

            el = $ctrl.LCS.findClosestParent(e.currentTarget, drpCls);
            var nextSetup = $ctrl.LCS.findClosestParent(el, cls);
            id = nextSetup ? nextSetup.getAttribute(prop) : null;
        } else if (id) {
            el = $ctrl.LCS.findClosestParent($ctrl.element, $ctrl.groupParentCls).querySelector(cls + '[' + prop + '="' + id + '"] .side-actions ' + drpCls);
        }

        if (el) {
            isOpen = $ctrl.LCS.hasClass(el, 'open');
            if (!isOpen) {
                bindBodyClick(true, id);
            }
            $ctrl.LCS[isOpen ? 'removeClass' : 'addClass'](el, 'open');

            if (isOpen) {
                bindBodyClick(false, id);
            }
        }
    }

    function bindBodyClick(isBind, id){
        $ctrl.removeWatcher($ctrl.bodyWatcher);
        if(isBind){
            $ctrl.bodyWatcher = $ctrl.addRootWatcher(getBodyWatcherEvent(id), toggleDropdownBody);
        }
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.LCS.bodyElement, onBodyClick, 'task-dropdown');

        function toggleDropdownBody(id){
            toggleDropdown(null, id);
        }

        function onBodyClick(e) {
            if (!$ctrl.LCS.findClosestParent(e.target, '.' + $ctrl.drpWrapperCls)) {
                //console.log('onbody.taskpopoverClick');
                $ctrl.broadcastRoot(getBodyWatcherEvent(id), id);
                bindBodyClick(false, id);
            }
        }
    }

    function getBodyWatcherEvent(id){
        return 'TASK_POPOVER_CLICK_' + id;
    }

    //for current segment
    function initProgressBar() {
        if ($ctrl.progressBarService) {
            return;
        }

        var groupEl = $ctrl.LCS.findClosestParent($element[0], $ctrl.groupParentCls);
        if (!groupEl) {
            return;
        }

        $ctrl.progressBarService = new $ctrl.ProgressBarService({
            progressType: 'Circle',
            parentElement: groupEl,
            wrapperCls: 'setup-progress',
            elementSelector: '.' + $ctrl.headerSetupCls + '[data-next="' + $ctrl.item._id + '"] '
        });
    }

    function setProgressBar(seg){
        if($ctrl.progressBarService) {
            $ctrl.progressBarService.setProgressBar(getProgressStats(seg));
        }
    }

    function hasTasks(seg) {
        return getProgressStats(seg).total > 0;
    }

    function getProgressStats(seg){
        var stats = seg.setupStats;
        return {
            total: stats && stats.tasks ? stats.tasks : 0,
            completed: stats && stats.tasksCompleted ? stats.tasksCompleted : 0
        }
    }

    function onSetupNameChanged(result){

    }

    function onDestroyGridItemOther(){
        bindBodyClick(false);
        if($ctrl.progressBarService) {
            $ctrl.progressBarService.onDestroyProgressBar();
        }
    }
}

angular.module('product.tasks.item.edit.popup.component', [
])
.component('taskEditPopup', popupComponentParams('TaskEditPopupCtrl'))
.controller('TaskEditPopupCtrl', TaskEditPopupCtrl);
TaskEditPopupCtrl.$inject = ['GeneralItemEditCtrlService', '$element'];
function TaskEditPopupCtrl(GeneralItemEditCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.preSetTemplateData = preSetTemplateData;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preSetTemplateData() {
        $ctrl.itemTitle = $ctrl.item.type === 0 ? 'Checklist' : 'Task';
        $ctrl.withCloseBtn = true;
        $ctrl.icon = 'taskList';
        $ctrl.popupTitle = ($ctrl.item._id ? 'Rename' : 'New') + ' ' + $ctrl.itemTitle;
        $ctrl.btnText = '<span>'+(($ctrl.item._id ? 'Update' : 'Save'))+' </span><span class="hide-ipad"> ' + $ctrl.itemTitle + '</span>';
    }
}

angular.module('product.tasks.new.component', [
    'apiServices.Tasks'
])
.component('taskNew',{
    bindings: {
        objectType: '<',
        placeholder: '<',
        onCreate: '&'
    },
    controller: 'TaskNewCtrl'
})

.controller('TaskNewCtrl',TaskNewCtrl);
TaskNewCtrl.$inject = ['ListItemTemplateFormCtrlService', 'TasksService', '$element'];

function TaskNewCtrl(ListItemTemplateFormCtrlService, service, $element) {
    var $ctrl = this;

    $ctrl.itemTitle = 'Task';
    $ctrl.isOpened = false;
    $ctrl.btnAddNewCls = 'new-task-item';
    $ctrl.formCls = 'new-task-item-form';

    $ctrl.dontAutoloadTemplate = false;

    $ctrl.getNew = getNew;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitOther = preInitOther;
    $ctrl.postInitOther = postInitOther;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.preventDefault = preventDefault;

    $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

    function preInitOther() {
        $ctrl.placeholder = 'Add New ' + $ctrl.itemTitle + '…';
        $ctrl.type = 'Create';
        $ctrl.objectType = 'task';
        $ctrl.extraParam = {service: service};

        $ctrl.getNew();
    }

    function postInitOther() {
        $ctrl.saveNew = saveNew;
        $ctrl.onSave = onSave;
    }

    function getNew() {
        //console.log('getNew');
        $ctrl.error = null;
        return $ctrl.item = {
            name: null
        };
    }

    function onLoaded() {
        bind(false);
        if ($ctrl.isOpened) {
            //  $ctrl.LCS.removeClass($ctrl.element.querySelector('.elementnew'),'sb-hide');
            $ctrl.setFocus();
        } else {
            bind(true);
        }
    }

    function getItemTemplate() {
    return '<div class="min-height-30 ' + $ctrl.btnAddNewCls + '">' +
                //'<div class="add-new-task"><div></div></div><div class="show-more-btn field">' + $ctrl.placeholder + '</div>' +
                '<button class="col100 btn btn-small primary-faded-gray" type="button">Add Task</button>' +
            '</div>' +
            '<div class="sb-hide min-height-30 ' + $ctrl.formCls + '">' +
                '<form class="elementnew auto" name="$ctrl.formHolderItem[$ctrl.formName]" novalidate autocomplete="off" ui-keyup="{\'enter\':\'$ctrl.saveNew($event)\'}">' +
                    $ctrl.LCS.getErrorBlock() +
                    '<div class="new-task-item">' +
                        '<div class="add-new-task"><div></div></div>' +
                        '<div class="field thinner">' +
                            '<input autocomplete="off" placeholder="' + $ctrl.placeholder + '" class="form-control with-transition with-bgcolor primarycolor" type="text" id="name" name="name" ng-model="$ctrl.item.name" required ng-blur="$ctrl.saveNew($event, true)">' +
                        '</div>' +
                        '<div class="text-left clearfix" ng-show="($ctrl.formHolderItem.formItem.name.$error.duplicate || $ctrl.formHolderItem.formItem.name.$error.required) && $ctrl.formHolderItem[\'formItem_attempted\']">' +
                            '<div ng-show="($ctrl.formHolderItem.formItem.name.$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem.formItem.name.$error.required" class="help-inline ng-hide text-left with-relative">' + $ctrl.itemTitle + ' is required.</div>' +
                            '<div ng-show="($ctrl.formHolderItem.formItem.name.$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem.formItem.name.$error.duplicate" class="help-inline ng-hide with-relative" ng-bind="$ctrl.formHolderItem.formItem.name.$error.duplicate"></div>' +
                        '</div>' +
                    '</div>' +
                '</form>' +
            '</div>';
    }

    function bind(isBind) {
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('.' + $ctrl.btnAddNewCls), showMore);
    }

    function onSave(result) {
        if ($ctrl.onAdded) {
            $ctrl.onAdded({result: result});
        }

        $ctrl.getNew();
    }

    function saveNew(e, isClose) {
        $ctrl.preventDefault(e);
        if ($ctrl.item.name) {
            $ctrl.onCreate({result: {name: $ctrl.item.name}, e: e});
        }
        $ctrl.getNew();
        if (isClose) {
            setAOpened(false);
        }
    }

    function showMore(e) {
        $ctrl.preventDefault(e);
        setAOpened(true);
    }

    function setAOpened(isOpened) {
        if ($ctrl.isOpened !== isOpened) {
            $ctrl.isOpened = isOpened;
        }
        if (!isOpened) {
            $ctrl.getNew();
        }

        reload();
    }

    function reload() {
        var el = $ctrl.element.querySelector('.' + $ctrl.btnAddNewCls);
        if (el) {
            $ctrl.LCS[$ctrl.isOpened ? 'addClass' : 'removeClass'](el, 'sb-hide');
        }

        el = $ctrl.element.querySelector('.' + $ctrl.formCls);
        if (el) {
            $ctrl.LCS[$ctrl.isOpened ? 'removeClass' : 'addClass'](el, 'sb-hide');
        }

        // $ctrl.reloadListItemTemplate();
        if ($ctrl.isOpened) {
            $ctrl.setFocus();
        }
    }

    function onDestroy() {
        bind(false);
    }

    function preventDefault(e) {
        $ctrl.LCS.preventDefault(e);
    }
}

angular.module('product.tasks.group.component', [
    'apiPagination.Tasks',
    'product.tasks.item.grid.component',
    'groupBlock.controller.service',
    'product.avscript.group.withSetup.service',
    'product.tasks.item.edit.popup.component'
])
.component('tasksGroup', groupBlockComponentParams('TasksGroupCtrl', {
    isInModal: '<',
    withShortHandleCol: '@',
    dontProcessG: '<',
    onUpdateStats:'&',
}))
.controller('TasksGroupCtrl',TasksGroupCtrl);
TasksGroupCtrl.$inject = ['TasksPagination', 'GroupBlockInitCtrlService', 'GroupWithSetupCtrlService', '$element'];
function TasksGroupCtrl(Pagination, GroupBlockInitCtrlService, GroupWithSetupCtrlService,  $element) {
    var $ctrl = this;
    $ctrl.dontScrollInView = true;
    $ctrl.rowLoadNow = true;
    $ctrl.hasHeader = true;
    $ctrl.changedTaskCardFields = ['tasks', 'tasksCompleted'];

    if(!$ctrl.dayBreakColumns) {
        $ctrl.dayBreakColumns = ['name', 'segNo', 'stats'];
    }
    if(!$ctrl.setupCls) {
        $ctrl.setupCls = 'setup';
    }
    $ctrl.setupType = 'SEGMENT';
    $ctrl.setupTypeName = 'Checklist';
    $ctrl.setupTypeIcon = 'daybreak';
    $ctrl.setupIconLevel = 4;
    $ctrl.btnRemoveIcon = 'cancel';

    $ctrl.ShotTypes = {Shot: 1, Setup: 0};

   // $ctrl.quotaType='taskBoardChecklists';

    $ctrl.getGridHeader = getGridHeader;
    $ctrl.changeFilter = changeFilter;
    $ctrl.onPreloadGroup = onPreloadGroup;

    $ctrl.$onInit = $onInit;

    $ctrl.getMoreBtnCls = getMoreBtnCls;

    $ctrl.afterProcessUpdates = afterProcessUpdates;
    $ctrl.afterProcessUpdatesOther1 = afterProcessUpdatesOther1;
    $ctrl.listItemsQuery = listItemsQuery;

    $ctrl.getItemTitleForMovePopup = getItemTitleForMovePopup;

    if(!$ctrl.processListItemColumn) {
        $ctrl.processListItemColumn = processListItemColumn;
    }

    $ctrl.onReloadGroupTemplate = onReloadGroupTemplate;

    $ctrl.getNewParams = getNewParams;
    $ctrl.getGroupItemAttributes = getGroupItemAttributes;
    $ctrl.getShotTypeName = getShotTypeName;

    $ctrl.onInitAddFromTop = onInitAddFromTop;

    $ctrl.onAllLoaded = onAllLoaded;
    $ctrl.onAddedOther = onAddedOther;
    $ctrl.onRemoved = onRemoved;

    $ctrl.getParams = getParams;
    $ctrl.onTasksReorder = onTasksReorder;
    $ctrl.getRemoveParams = getRemoveParams;

    function getRemoveParams(item){
        var p = _.extend({
            _id: item._id,
            withoutType: true,
            companyId: $ctrl.CPS.companyId
        }, item.productId ? {productId: item.productId} : null);
        p[$ctrl.listField] = item[$ctrl.listField];
        return p;
    }

    function onInitAddFromTop(addInline){//addInline, e
        console.log('TasksGroupCtrl.onInitAddFromTop');
        var setups = $ctrl.getSetups($ctrl.list.items),
            after = setups && setups.length ? setups[setups.length - 1] : null;
        addChecklist(after, addInline);
    }

    function $onInit() {
        console.log('TasksGroupCtrl');
        $ctrl.options = $ctrl.constantsService.Options;

        if(!$ctrl.isInModal){
            $ctrl.options.columns = [1, 2];
        }

        $ctrl.Filters = [
            {value: 1, text: 'All Tasks'},
            {value: 2, text: 'Hide Completed'}
        ];

        $ctrl = new GroupWithSetupCtrlService($ctrl);

        $ctrl.onPostloadGroup = onPostloadGroup;
        $ctrl.hasTasksReorder = hasTasksReorder;

        $ctrl = new GroupBlockInitCtrlService($ctrl, $element, Pagination, $ctrl.constantsService, null);
    }

    function onPostloadGroup(){
        $ctrl.onGroupSetupInitOther();

        if($ctrl.isInModal) {
            $ctrl.addRootWatcher('SIDE_ACTION_SETUP_' + $ctrl.elemType + '_' + $ctrl.currentListId, onSideAction);
        }
    }

    function hasTasksReorder(){
        return $ctrl.canEdit && $ctrl.isInModal;
    }

    function getParams(){
        var params = {
            companyId: $ctrl.CPS.companyId,
        };
        //todo what if is dashboard widget
        if ($ctrl.CPS.productId) {
            params.productId = $ctrl.CPS.productId;
        }
        params[$ctrl.listField] = $ctrl.currentListId;
        return params;
    }

    function addChecklist(item, addInline, other){
        console.log('addChecklist');
        var maxAddedcount = 1,
            maxFree = 1,
            quotaType = 'workflowAdvanced',
            count = $ctrl.getSetups($ctrl.list.items).length;

        $ctrl.CPS.loadQuotaPopup(quotaType, process, maxFree, maxFree === 0 ? 0 : (count + maxAddedcount), $ctrl.compOptions);

        function process() {
            $ctrl.create(item, $ctrl.ShotTypes.Setup, null, addInline, other);
        }
    }

    function onSideAction(result) {
        console.log('SIDE_ACTION_SETUP');
        var type = result.type,
            item = _.find($ctrl.list.items, {_id: result.id});
        if (!item) {
            return;
        }
        if (type === 'create') {
            var addInline = false;
            addChecklist(item, addInline, result && (result.other === 'true' || result.other === true));
        } else if (type === 'remove') {
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations.treeKeyboardActions, {
                btn: 'Apply',
                icon: 'trash',
                title: 'Remove ' + $ctrl.setupTypeName,
                message: 'Are you sure you want to remove the selected ' + $ctrl.setupTypeName.toLowerCase() + ' and the associated ' + $ctrl.itemTitle.toLowerCase() + 's' + '?',
                onConfirm: process
            }, $ctrl.compOptions);
        } else {
            process();
        }

        function process() {
            $ctrl[type](item);
        }
    }

    function onAllLoaded( ){
        updateSetupCounters();

        $ctrl.onAllLoadedInit(true);
    }

    function getShotTypeName(type){
        return type === $ctrl.ShotTypes.Shot ? $ctrl.itemTitle : (type === $ctrl.ShotTypes.Banner ? $ctrl.bannerTypeName: $ctrl.setupTypeName);
    }
    function getGroupItemAttributes(){
        return 'is-in-modal="::$ctrl.isInModal" '+
               'shot-types="::$ctrl.ShotTypes" ';
    }

    function getNewParams(after, type, items) {
        console.log('tasksL getNewParams');
        if (type && typeof (type) === 'string') {
            type = parseInt(type, 10);
        }
        var p = {};

        if (type === undefined) {
            type = $ctrl.ShotTypes ?  $ctrl.ShotTypes.Shot : 1;
        }
        p.type = type;

        if (after) {
            p.afterId = after._id;
        }

        if(type === $ctrl.ShotTypes.Setup) {
            var setups = $ctrl.getSetups(items),

                max = setups && setups.length > 0 ? (parseInt(_.max(setups, function (x) {
                    return parseInt(x.segNo, 10);
                }).segNo, 10) + 1) : 1;
            p.name = $ctrl.setupTypeName + (max === 1 ? '' : (' ' + max));
        }

        return p;
    }

    function addDefaultChecklist(addAtTheEnd) {
        if ($ctrl.isInModal) {
            var l = $ctrl.list.items ? $ctrl.list.items.length : 0;
            //backwards compatibility for project tasks without checklists
            if ($ctrl.canEdit) {
                var addInline = !$ctrl.withCreateInlineGroup;
                if (!l) {
                    addChecklist(null, addInline);
                } else if (addAtTheEnd && $ctrl.list.items[l - 1].type !== 0) {
                    $ctrl.create($ctrl.list.items[l - 1], $ctrl.ShotTypes.Setup, null, addInline);
                  //  onInitAddFromTop(addInline);//add setup at the end if there is none on tje last position
                }
            }
            updateSetupCounters();
        }
    }

    function onReloadGroupTemplate() {
        if(!$ctrl.isNotFirstTime){
            addDefaultChecklist(true);
            $ctrl.isNotFirstTime = true;
        }
    }

    function getItemTitleForMovePopup(item, id) {
        var isSetup = item.type === 0;
        return {
            name: (isSetup ? ($ctrl.setupTypeName + ' ') : '') + item.segNo + '.' + (isSetup ? (' ' + getTxt(item.name)) : (item.rowNo + ' ' + getFirst(item.audio))),
            _id: item._id,
            active: item._id === id,
            type: item.type
        };

        function getTxt(n) {
            return n ? $ctrl.LCS.createFragment('<div>' + n + '</div>').children[0].innerText : '';
        }

        function getFirst(n) {
            var el = getTxt(n);
            return el && el.length > 50 ? (el.substring(0, 50) + '…') : el;
        }
    }

    function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails){
        //console.log('tasks group processListItemColumn' );
        var withS = isMobile || isMobileRowDetails;

        if(withS && (isMobileRowDetails && c.viewRowDetailsMobile
            //    || !c[withS ? 'isMobileTitle' : 'isListTitle']
        )) {
            return $ctrl.getDisplayItemCol(item, c, cls, canEdit, textOnly, isMobile, isMobileRowDetails);
        }

        switch (item.type) {
            case $ctrl.ShotTypes.Shot:
                return $ctrl.processListItemColumnInit(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);

            case $ctrl.ShotTypes.Setup:
                return  getColsSetup(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);
        }

        function getColsSetup(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
            switch (c.prop) {
                default:
                    return '';
            }
        }
    }

/*----*/

    function getMoreBtnCls() {
        return ' with-hover ';
    }
    
    function onPreloadGroup() {
        if ($ctrl.filtersService.selectedFilter === undefined) {
            $ctrl.filtersService.selectedFilter = 1;
        }
    }

    function onTasksReorder(result){
        afterProcessUpdates(result);
    }

    function afterProcessUpdates(result, initResult) {
        console.log('TasksGroupCtrl.afterProcessUpdates');
        if(!result) {return;}
        $ctrl.onUpdateStats({result: result});

        if($ctrl.afterProcessUpdatesOther){
            $ctrl.afterProcessUpdatesOther(result, initResult);
        }
    }

    function afterProcessUpdatesOther1(result, initResult) {
        //on completed -> taskcompleted updates for the specific setup
        console.log('afterProcessUpdatesOther1 ' + result.type);

        if (!result) {
            return;
        }
        var change = result.type === 3 || result.updateOrder,
            statsChanged = result.eventType === 'CHANGED_FIELD' && result.editchanges && result.editchanges.stats;

        if (change ||  //isremove or onOrderChanged
            statsChanged) { //or stats changed
            updateSetupCounters(result.updateOrder);
        }
    }

    function onAddedOther(result) {
        updateSetupCounters();
    }

    function onRemoved(result){
        //console.log('TasksGroupCtrl.onRemoved');
        afterProcessUpdates(result);
        addDefaultChecklist();
    }

    function updateSetupCounters(updateOrder){
        $ctrl.LCS.timeout(process, 230);
        function process() {
            //console.log('TasksGroupCtrl.updateSetupCounters');
            var setups = $ctrl.getSetups($ctrl.list.items), l = setups.length;
            for (var i = 0; i < l; i++) {
                var setup = setups[i],
                    id = setup._id,
                    els = _.filter($ctrl.list.items, {setupId: id, type: 1}),
                    prev = setup.setupStats || {},
                    prevTasks = {
                        tasks: prev.tasks || 0,
                        tasksCompleted: prev.tasksCompleted || 0
                    },
                    stats = {
                        tasks: els.length,
                        tasksCompleted: _.filter(els, function (el) {
                            return el.stats && el.stats.completed;
                        }).length
                    };

                var updates = {}, changes;
                _.each(['tasks', 'tasksCompleted'], function (prop) {
                    if (prevTasks[prop] !== stats[prop]) {
                        updates[prop] = stats[prop];
                        changes = true;
                    }
                });
                if (changes) {
                    $ctrl.replaceElementProps(id, {setupStats: stats});
                }
                $ctrl.broadcastRoot('UPDATE_SETUP_' + $ctrl.elemType + '_' + id, $ctrl.list.getElementById(id));
                if(i === l-1){//if is last segment dont have next segment
                    var el = $ctrl.element.querySelector('.nextSetup[data-current="' + id + '"]');
                    if (el) {
                        $ctrl.LCS.removeElement(el);
                    }
                }
            }
        }
    }

    function changeFilter(result) {
        $ctrl.filtersService.selectedFilter = result.selected.val;
        $ctrl.loadGroupTemplate();
    }

    function getGridHeader() {
        if(!$ctrl.isInModal){return '';}
    return getFilterDrp()+
        (typeof($ctrl.getTopOfHeader) === 'function' ? $ctrl.getTopOfHeader() : '');

        function getFilterDrp(){

            return '<div class="pull-right wrapper-outer wrapper-tasks-filter with-arrow with-bgcolorgray" ng-show="!$ctrl.canEdit&&$ctrl.list.totalCount||$ctrl.canEdit">' +
                '<sb-dropdown ' +
                    //'class="col130" ' +
                    'drp-class-attr="drpTasksFilter" '+
                    'without-close="true" ' +
                    'c-class-attr="without-underline without-arrow opendrp auto-width thinner" ' +
                    'init-list="::$ctrl.Filters" ' +
                    'value="::$ctrl.filtersService.selectedFilter" ' +
                    'on-change="$ctrl.changeFilter(result)" ' +
                    'field-class="selected-text  ">' +
                '</sb-dropdown>' +
            '</div>';
        }
    }

    function listItemsQuery(item) {
        return item ? ($ctrl.filtersService.selectedFilter === 1 ? true : (item.stats && item.stats.completed ? false : true)) : false;
    }
}

angular.module('product.tasks.list.component', [
    'product.tasks.group.component',
    'product.tasks.new.component',
    'apiConstants.tasks.services',
    'group.container.block.controller.service',
    'apiConstants.tasks.services',
    'progressbar.service'
])
.component('tasks', {
    bindings: {
        title: '@',
        selectedFilter: '<',
        canEdit:'<',
        tasksCard: '<',
        isInModal: '<',
        onUpdateStats:'&'
    },
    controller: 'TasksCtrl'
})   
    
.controller('TasksCtrl', TasksCtrl);
TasksCtrl.$inject = ['GroupContainerBlockCtrlService', 'TasksConstantsService', 'ProgressBarService', '$element'];

function TasksCtrl(GroupContainerBlockCtrlService, constantsService, ProgressBarService, $element) {

    var $ctrl = this;

    $ctrl.GroupContainerBlockCtrlService = GroupContainerBlockCtrlService;
    $ctrl.ProgressBarService = ProgressBarService;

    $ctrl.gridTitle = 'Tasks';
    $ctrl.taskStatsCls = 'taskStatsEl';
    $ctrl.setupType = 'SEGMENT';

    $ctrl.getGroupHeader = getGroupHeader;
    $ctrl.getGroupBodyAttrs = getGroupBodyAttrs;
    $ctrl.onUpdateGroup = onUpdateGroup;

    $ctrl.createFromTop = createFromTop;
    $ctrl.openReorder = openReorder;

    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl.onInit = onInit;

    if(!$ctrl.$onInit) {
        $ctrl.$onInit = $ctrl.onInit;
    }

    function onInit() {
        $ctrl.dontProcessG = true;
        $ctrl.block = 'tasks';
        $ctrl.currentListId = $ctrl.tasksCard._id;

        $ctrl.preloadingType = 'Tasks';
        $ctrl.preLoadingTableName = 'Tasks';

        $ctrl.groupTag = $ctrl.block + '-group';
        $ctrl.smallPreloader = true;

        if(!$ctrl.progressBarService) {
            $ctrl.progressBarService = new $ctrl.ProgressBarService({
                parentElement: $element[0],
                wrapperCls: 'all-tasks-progress'
            });
        }

        $ctrl = new $ctrl.GroupContainerBlockCtrlService($ctrl, $element, constantsService);
    }

    function getGroupHeader() {
        if (!$ctrl.isInModal) {
            return '';
        }
    return '<div class="subitem small-filters table-div full-width">' +
                '<div class="centered col30 icon-absolute">' + $ctrl.LCS.getISBDiv('taskList') + '</div>' +
                '<div class="centered"><span>' + $ctrl.gridTitle + '</span> <span class="' + $ctrl.taskStatsCls + ' stats">' + getStats() + '</span></div>' +
                ($ctrl.canEdit ? ('<div class="centered col200 padding-right-110">' + getBtns() + '</div>'):'') +
            '</div>' +
            $ctrl.progressBarService.getProgressBarContent(hasTasks());

        function getBtns() {
            var cls = 'btn btn-small primary-faded-gray without-text gray with-margin-left ' + $ctrl.getBtnActionCls();
            return '<div class="with-hover pull-right">' +
                '<button type="button" class="' + cls + '" tooltip-placement="bottom" tooltip="Reorder Checklists" data-type="openReorder">' + $ctrl.LCS.getISBDiv('transition', 5, 'rotate') + '</button>' +
                '<button type="button" class="' + cls + '" tooltip-placement="bottom" tooltip="Add Checklist" data-type="createFromTop" analytics-on analytics-action="Add Checklist">' + $ctrl.LCS.getISBDiv('plus') + '</button>' +
                '</div>';
        }

        function getMoreDrp(){
        return '<div class="with-dots hide-print one-line-tooltip with-bg with-hover">' +
                    '<div class="btn-group actions dropdown" dropdown="">' +
                        '<button type="button" class="btn btn-default dropdown-toggle dots" dropdown-toggle="" aria-haspopup="true" aria-expanded="false">' + $ctrl.LCS.getISBDiv('vertical-dots-bold') +
                            '<span class="sr-only">Toggle Dropdown</span>' +
                        '</button>' +
                        '<ul class="dropdown-menu-right side-menu fadeInDownLeft dropdown-menu workcardMenu" role="menu" dropdown-menu="">' +
                            '<li>' +
                                '<a class="table-div full-width '+$ctrl.getBtnActionCls()+'" data-type="createFromTop" analytics-on analytics-action="Add Checklist">' +
                                    '<div class="centered col30 with-padding-right">' + $ctrl.LCS.getISBDiv('plus') + '</div>' +
                                    '<div class="centered">Add Checklist</div>' +
                                '</a>' +
                            '</li>' +
                        '</ul>' +
                    '</div>' +
                '</div>';
        }
    }

    function createFromTop(type, e){
        console.log('createFromTop');
         process();
        //check permissions
      //  $ctrl.CPS.loadQuotaPopup('reviewers', process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}));

        function process() {
            var type = 0; //add a new checklist
            $ctrl.broadcastRoot('ADD_FROM_PAGE_TOP_' + $ctrl.elemType, {type: type, e: e});
        }
    }

    function getGroupBodyAttrs() {
        return 'dont-process-g="::'+$ctrl.dontProcessG+'" ' +
                'is-in-modal="::'+$ctrl.isInModal+'" ' +
                'on-update-stats="$ctrl.onUpdateGroup(result)" ';
    }

    function onUpdateGroup(result1) {
        //console.log('TasksCtrl.onUpdateGroup');
        var table = 'todoCards',
            result = angular.copy(result1),
            updates = result && result.updatesG && result.updatesG[table] && result.updatesG[table].set ?
                result.updatesG[table].set[$ctrl.tasksCard._id] : null;
        if (updates) {
            if (updates.stats && updates.stats.completedAt) {
                updates.stats.completedAt = $ctrl.MomentService.getMomentFromString(stats.completedAt);
            }

            $ctrl.tasksCard = _.extend($ctrl.tasksCard, updates);

            setStatsEl();
            setProgressBar();

            $ctrl.onUpdateStats({
                result: {
                    custom: true,
                    newRes: result,
                    editchanges: _.extend({_id: $ctrl.tasksCard._id}, updates)
                }
            });
        }
    }

    function setStatsEl() {
        set($ctrl.taskStatsCls, getStats, hasTasks());
    }

    function set(name, m, exists) {
        var el = getEl(name);
        if (el && m) {
            $ctrl[name].innerHTML = m();
        }
        $ctrl.LCS[exists ? 'removeClass' : 'addClass'](el, 'sb-hide');
    }

    function getEl(name){
        if (!$ctrl[name]) {
            $ctrl[name] = $ctrl.element.querySelector('.' + name);
        }
        return $ctrl[name];
    }

    function hasTasks(){
       return getProgressStats().total > 0;
    }

    function getStats() {
        var stats = getProgressStats();
        return stats.total > 0 ? (stats.completed + '/' + stats.total) : '';
    }

    function openReorder() {
        $ctrl.broadcastRoot('REORDER_'+$ctrl.setupType+'_'+$ctrl.currentListId);
    }

    function onDestroy(){
        if($ctrl.progressBarService) {
            $ctrl.progressBarService.onDestroyProgressBar();
        }
    }
/***/

    function getProgressStats(){
        var stats = $ctrl.tasksCard.stats;
        return {
            total: stats && stats.tasks ? stats.tasks : 0,
            completed: stats && stats.tasksCompleted ? stats.tasksCompleted : 0
        }
    }

    function onLoaded(){
        setProgressBar();
    }

    function setProgressBar(){
        if($ctrl.progressBarService) {
            $ctrl.progressBarService.setProgressBar(getProgressStats());
        }
    }
}


angular.module('apiConstants.todofiles.services', [
