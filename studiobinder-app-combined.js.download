angular.module('user.layoutLogged.component.service', [
    'services.stateService',
    'user.layout.controller.service',
    'services.commentsSidebar'
]) 

.service('LayoutLoggedCtrlService', LayoutLoggedCtrlService);

LayoutLoggedCtrlService.$inject = ['LayoutCtrlService', 'CommentsSidebarService', 'CPS'];
function LayoutLoggedCtrlService(LayoutCtrlService, CommentsSidebarService, CPS) {
    return function ($ctrl, $element) {
        //console.log('LayoutLoggedCtrlService');
        $ctrl.CommentsSidebarService = CommentsSidebarService;
        $ctrl.BlocksSetupService = CommentsSidebarService.BlocksSetupService;
        $ctrl.CPS = CPS;
        $ctrl.CurrentProduct = $ctrl.CPS.CurrentProduct;
        $ctrl.SBStateService = $ctrl.CPS.SBStateService;

        $ctrl.currentPathParams = $ctrl.CPS.security.currentPathParams;

        $ctrl = new LayoutCtrlService($ctrl, $element);
        $ctrl.onLayoutInit = onLayoutInit;

        return $ctrl;

        function onLayoutInit() {
            onStateChanged();
            $ctrl.RootEventsService.addRootWatcherSimple($ctrl.watchers, $ctrl.SBStateService.onStateChanged(onStateChanged));
        }

        function onStateChanged() {
            //todo $ctrl.setShowComments();
            var stateName = $ctrl.SBStateService.getCurrentStateName();
            var params = $ctrl.SBStateService.getCurrentStateParams();

            //console.log('LayoutLoggedCtrlService.onStateChanged : ' + stateName);
            $ctrl.CommentsSidebarService.onStateChanged(stateName, params);
            if (!$ctrl.prevStateName || $ctrl.prevStateName !== stateName) {

                if ($ctrl.productId === undefined || params.productId !== $ctrl.productId) {
                    $ctrl.productId = params.productId ? params.productId : null;

                    var product = $ctrl.CurrentProduct.getProduct();
                    if ($ctrl.productId && !product) {
                        return $ctrl.SBStateService.goToProjects($ctrl.currentPathParams());
                    }
                    if ($ctrl.BlocksSetupService.hasProductSidebarChanged(product)) {
                        $ctrl.loadMenu = new ObjectId().toString();
                    }
                }
                var info = {
                        productId: $ctrl.productId,
                        isAuthenticated: $ctrl.CPS.isAuthenticated,
                        companyId: $ctrl.CPS.companyId,
                        teamId: $ctrl.CPS.teamId
                    },
                    infoStr = JSON.stringify(info);

                if (!$ctrl.infoStr || $ctrl.infoStr !== infoStr) {
                    $ctrl.infoStr = infoStr;
                }

                var infoStrExt = JSON.stringify(_.extend({
                    currentStateName: stateName
                }, info));

                if (!$ctrl.infoStrExt || $ctrl.infoStrExt !== infoStrExt) {
                    $ctrl.infoStrExt = infoStrExt;
                }

                $ctrl.prevStateName = stateName;
            }
        }
    }
}


