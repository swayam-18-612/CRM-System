    function onLoaded() {
        if (!$ctrl.isCompany && !$ctrl.calendarId) {
            return;
        }
        load();
    }

    function load() {
        console.log('loading calendar');
        if (CalendarApiService.isInit() && !firstLoadFinished) {
            var params = {
                companyId: $ctrl.CPS.companyId,
                product: $ctrl.CPS.product
            };
            if ($ctrl.isCompany) {
                params.isCompany = $ctrl.isCompany;
            }
            if ($ctrl.calendarId) {
                params.calendarId = $ctrl.calendarId;
            }
            CalendarRowContentService.loadCalendars(params, TopNavCalendarService.canEdit, function (err, timespan) {
                reloadDataAndRefresh(true);

                $ctrl.isLoaded = true;

                //open card
                if (card) {
                    var task = CalendarRowContentService.getDBItem({id: card});
                    if (task) {
                        updateTaskCard(task);
                    } else {
                        card = null;
                        $ctrl.CPS.setSearchFilter(card, 'card', 2);
                    }
                }
            });
        }
    }

    function loadCalendarApi(api) {
        // API Object is used to control methods and events from angular-gantt.
        $ctrl.api = api;

        // Add some DOM events
        api.directives.on.new($scope, function (directiveName, directiveScope, element) {

        });

        api.core.on.ready($scope, function () {
            api.scroll.on.scroll($scope, logScrollEvent);
            api.core.on.ready($scope, logReadyEvent);
            api.data.on.remove($scope, addEventName('data.on.remove', logDataEvent));
            api.data.on.load($scope, addEventName('data.on.load', logDataEvent));
            api.data.on.clear($scope, addEventName('data.on.clear', logDataEvent));
            api.data.on.change($scope, addEventName('data.on.change', logDataEvent));

            api.tasks.on.add($scope, addEventName('tasks.on.add', logTaskEvent));
            //  api.tasks.on.change($scope, addEventName('tasks.on.change', logTaskEvent));
            //api.tasks.on.rowChange($scope, addEventName('tasks.on.rowChange', logTaskEvent));
            api.tasks.on.remove($scope, addEventName('tasks.on.remove', logTaskEvent));

            if (api.tasks.on.moveBegin) {
                api.tasks.on.moveBegin($scope, addEventName('tasks.on.moveBegin', logTaskEvent));
                //api.tasks.on.move($scope, addEventName('tasks.on.move', logTaskEvent));
                api.tasks.on.moveEnd($scope, addEventName('tasks.on.moveEnd', logTaskEvent));

                api.tasks.on.resizeBegin($scope, addEventName('tasks.on.resizeBegin', logTaskEvent));
                //api.tasks.on.resize($scope, addEventName('tasks.on.resize', logTaskEvent));
                api.tasks.on.resizeEnd($scope, addEventName('tasks.on.resizeEnd', logTaskEvent));
            }

            if (api.tasks.on.drawBegin) {
                api.tasks.on.drawBegin($scope, addEventName('tasks.on.drawBegin', logTaskEvent));
                //api.tasks.on.draw($scope, addEventName('tasks.on.draw', logTaskEvent));
                api.tasks.on.drawEnd($scope, addEventName('tasks.on.drawEnd', logTaskEvent));
            }
            api.rows.on.add($scope, addEventName('rows.on.add', logRowEvent));
            api.rows.on.change($scope, addEventName('rows.on.change', logRowEvent));
            api.rows.on.remove($scope, addEventName('rows.on.remove', logRowEvent));
            api.rows.on.move($scope, reorderRowEvent);

            api.side.on.resizeBegin($scope, addEventName('labels.on.resizeBegin', logLabelsEvent));
            //api.side.on.resize($scope, addEventName('labels.on.resize', logLabelsEvent));
            api.side.on.resizeEnd($scope, addEventName('labels.on.resizeEnd', logLabelsEvent));

            api.timespans.on.add($scope, addEventName('timespans.on.add', logTimespanEvent));
            api.columns.on.generate($scope, logColumnsGenerateEvent);
            api.columns.on.startGenerate($scope, logColumnsStartGenerateEvent);

            api.rows.on.filter($scope, logRowsFilterEvent);
            api.tasks.on.filter($scope, logTasksFilterEvent);

            api.data.on.change($scope, function (newData) {
            });
            api.dependencies.on.add($scope, addEventName('dependencies.on.add', logTaskDependenciesEvent));
            api.dependencies.on.remove($scope, addEventName('dependencies.on.remove', logTaskDependenciesEvent));
            // api.dependencies.on.change($scope, addEventName('dependencies.on.change', logTaskDependenciesEvent));

            api.core.on.rendered($scope, function (api) {
                if (typeof(TopNavCalendarService.onCalendarRendered) === 'function') {
                    TopNavCalendarService.onCalendarRendered();
                }
            }); // todo: implement this: Gantt is fully rendered in browser.

            loadLiveRows(api);
        });
    }

    function setWatchers() {
        console.log('setWatchers');
        $ctrl.removeWatchers();

        $ctrl.addRootWatcher('ADDED_CALENDARTEMPLATE_ITEM', onAddedCalendarTemplate);
        $ctrl.addRootWatcher('ADDED_CALENDARMILESTONE_ITEM', onAddedCalendarMilestone);
        $ctrl.addRootWatcher('UPDATED_CALENDARMILESTONE_ITEM', onUpdatedCalendarMilestone);
        $ctrl.addRootWatcher('MOVE_CALENDARMILESTONE_ITEM', onMovedCalendarMilestone);
        $ctrl.addRootWatcher('REMOVED_CALENDARMILESTONE_ITEM', onRemovedCalendarMilestone);
        $ctrl.addRootWatcher('UPDATED_TASKCARD_ITEM', onUpdatedTodoCard);
        $ctrl.addRootWatcher('DUPLICATED_TASKCARD_ITEM', onDuplicatedTodoCard);
        $ctrl.addRootWatcher('REMOVED_TASKCARD_ITEM', onRemovedTodoCard);

        $ctrl.addToObservable($scope, '$ctrl.calendarId', onCalendarIdChanged);
        $ctrl.addToObservable($scope, '$ctrl.options.sideMode', onSideModeChanged);

        $ctrl.addToObservable($scope, '$ctrl.topNavApi.timestampTemplate', saveTemplate);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.dependencies', toggleDependencies);
      //$ctrl.addToObservable($scope, 'topNavApi.conflicts', toggleConflicts);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.timeFramesWorkingMode', toggleTimeframesWorking);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.timeFramesNonWorkingMode', toggleTimeframesNonWorking);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.collapse', toggleCollapse);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.autoWidth', toggleAutoWidth);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.scale', toggleScale);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.hideTasksOutOfRange', toggleHideTasksOutOfRange);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.startWeekOnSunday', toggleStartWeekOnSunday);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.hideRowsWithoutTasks', toggleHideRowsWithoutTasks);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.hideTaskNames', toggleHideTaskNames);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.currentDate', toggleCurrentDate);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.showRowBorders', toggleShowRowBorders);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.dateRangeChanged', toggleDateRange);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.workingDaysChanged', changeWorkingDays);
        $ctrl.addToObservable($scope, '$ctrl.topNavApi.filter', getFiltered, true);


        $ctrl.addToObservable($scope, '$ctrl.topNavApi.zoom', toggleZoom);
        //setGeneralWatchers()
    }

    function setGeneralWatchers() {
        $ctrl.addRootWatcher('UPDATED_TODO_COLUMNS', onUpdatedTodoColumns);
       //todo what was here ?
        // $ctrl.watchers.push($ctrl.SessionService.onUpdatedTeam(onUpdatedTeam));
    }

    function logScrollEvent(left, date, direction) {
        if (date !== undefined) {
            console.log('[Event] api.on.scroll: ' + left + ', ' + (date === undefined ? 'undefined' : date.format()) + ', ' + direction);
        }
    }

    function logDataEvent(eventName) {
        console.log('[Event] ' + eventName);
    }

    // Event utility function
    function addEventName(eventName, func) {
        return function (param1, param2) {
            return func(eventName, param1, param2);
        };
    }

    function getTasksCount() {
        return CalendarRowContentService.getTasksCollections().length;
    }

    function checkIfCanAddTasks(checkTaskCount, onsuccess, e) {
        return $ctrl.CPS.loadQuotaPopup($ctrl.quotaType, onsuccess, checkTaskCount ? $ctrl.maxFreeItemsCount : null, getTasksCount(), $ctrl.compOptions, {e:e});
    }

    function onInsertDbTask(model, isDrawn) {
        CalendarRowContentService.insertTask(model, isDrawn, TopNavCalendarService.canEdit, function (task) {
            if (task) {
                TopNavCalendarService.clearTaskFilters();
                reloadDataAndRefresh(true);
                updateTaskCard(task);
            }
        }, function (error) {
            console.log(error);
            $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.todoCard.Create.error', 'error');
        });
    }

    function updateTaskCard(task) {
        $ctrl.popupsService.open(task, $ctrl.popupsService.operations.updateTaskCard, {
            canEdit : $ctrl.canEdit,
            service: $ctrl.TodoCardsService,
            onGridItemActions: $ctrl.onGridItemActions,
            Settings: $ctrl.Settings,
            maxAddedCount: CalendarRowContentService.getTasksCollections().length
        }, $ctrl.compOptions);
    }

    function handleRowClick(row, newType, event, isUnder, e) {
        console.log('handleRowClick');
        var model = row.model, data = model.data;
        //  if(model.data.type !== $ctrl.RowTypes.Event && row.from)
        //      model.from = row.from;
        if (event === $ctrl.EventTypes.Duplicate) {
            checkIfCanAddTasks(false, onsuccess, e);

            function onsuccess() {
                CalendarRowContentService.duplicateRow(model, TopNavCalendarService.canEdit, function (isAdded) {
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.calendarMilestone.duplicate.success', 'success', {
                        name: data.name,
                        type: data.type === $ctrl.RowTypes.Milestone ? 'row' : 'group'
                    });
                    reloadDataAndRefresh(isAdded);
                }, function (err) {
                    if (err) {
                        console.log(err);
                        //$ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.todoCard.dependencies.add.error', 'error');
                    }
                });
            }
        } else {
            CalendarRowContentService.handleRowClick(model, newType, event, isUnder, onInsertDbTask, $ctrl.popupsService.operations, $ctrl.popupsService.open, $ctrl.compOptions, e);
        }
    }

    function clear() {
        reloadDataAndRefresh(CalendarRowContentService.clearCalendars());
    }

    function addOverlapTaskToTargetRowIndex() {
        var targetDataAddRowIndex = parseInt($ctrl.options.targetDataAddRowIndex, 10);

        if (targetDataAddRowIndex) {
            var targetRow = $ctrl.data[$ctrl.options.targetDataAddRowIndex];

            if (targetRow && targetRow.tasks && targetRow.tasks.length > 0) {
                var firstTaskInRow = targetRow.tasks[0],
                    copiedColor = firstTaskInRow.color,
                    firstTaskEndDate = firstTaskInRow.to.toDate(),
                    overlappingFromDate = new Date(firstTaskEndDate);

                overlappingFromDate.setDate(overlappingFromDate.getDate() - 1);

                var overlappingToDate = new Date(overlappingFromDate);

                overlappingToDate.setDate(overlappingToDate.getDate() + 7);

                targetRow.tasks.push({
                    'name': 'Overlapping',
                    'from': overlappingFromDate,
                    'to': overlappingToDate,
                    'color': copiedColor
                });
            }
        }
    }

    function onUpdatedTodoColumns(result) {
        console.log('UPDATE_TODO_COLUMNS');
        process(2);
    }

    function onUpdatedTeam(result) {
        console.log('onUpdatedTeam');
        process(3);
    }

    function process(val) {
        var isInit = CalendarApiService.isInit();
        initRootParams(val);
        if (!isInit) {
            load();
        }
    }

    function onSideModeChanged(newValue, oldValue) {
        console.log('$watch options.sideMode');
        $ctrl.api.side.setWidth(undefined);
        $ctrl.LCS.timeout(function () {
            $ctrl.api.columns.refresh();
        });
    }

    function onCalendarIdChanged(newVal, oldVal) {
        console.log('$watch calendarId');
        if (firstLoadFinished) {
            firstLoadFinished = false;
        }

        if(!oldVal ){
            $ctrl.reloadTemplate();
        }else {
            load();
        }
    }

    function onAddedCalendarTemplate(result) {
        console.log('ADDED_CALENDARTEMPLATE_ITEM');
        TopNavCalendarService.resetCalendarTemplate();
        var item = result.item;
        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.calendarTemplate.Create.success', 'success', {
            name: item.name
        });
    }

    function onAddedCalendarMilestone(result) {
        console.log('ADDED_CALENDARMILESTONE_ITEM');
        var changed = CalendarRowContentService.addRow(result, TopNavCalendarService.canEdit);
        if (changed) {
            reloadDataAndRefresh(changed);
            var item = result.item;
            if (item) {
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.calendarMilestone.Create.success', 'success', {
                    name: item.name,
                    type: item.isFolder ? 'group' : 'row'
                });
            }
        } else {
            //error?
        }
    }

    function onUpdatedCalendarMilestone(result) {
        console.log('UPDATED_CALENDARMILESTONE_ITEM');
        var item = result.item;
        var changed = CalendarRowContentService.updateRow(item);
        if (changed) {
            if (item) {
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.calendarMilestone.Update.success', 'success', {
                    name: item.name,
                    type: item.isFolder ? 'group' : 'row'
                });
            }
        } else {
            //error?
        }
    }

    function onRemovedCalendarMilestone(result) {
        console.log('REMOVED_CALENDARMILESTONE_ITEM');
        var changed = CalendarRowContentService.removeRow(result);
        if (changed) {
            reloadDataAndRefresh(changed);
            var item = result.item;
            if (item) {
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.calendarMilestone.Remove.success', 'success', {
                    name: item.name,
                    type: item.isFolder ? 'group' : 'row'
                });
            }
        } else {
            //error?
        }
    }

    function onDuplicatedTodoCard(result) {
        console.log('DUPLICATE_TASKCARD_ITEM');
        var task = result && result.item ? result.item : null;
        CalendarRowContentService.duplicateTask(task, TopNavCalendarService.canEdit, function (result) {
            if (result) {
                reloadDataAndRefresh(result);
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.todoCard.duplicate.success', 'success');
            }
        }, function (err) {
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.todoCard.duplicate.error', 'error');
        });
    }

    function onUpdatedTodoCard(result) {
        var dbItem = result.item;
        console.log('onUpdatedTodoCard UPDATED_TASKCARD_ITEM');
        var timespan = CalendarRowContentService.updateTask(dbItem, TopNavCalendarService.canEdit);
        if (timespan) {
            CalendarRowContentService.updateMilestoneColorFromTask(dbItem, function () {
                reloadDataAndRefresh(timespan);
            });
        }
    }

    function onRemovedTodoCard(result) {
        var task = result && result.item ? result.item : null;
        console.log('REMOVED_TASKCARD_ITEM');
        try {
            var changed = CalendarRowContentService.removeTask(task);
            if (changed) {
                reloadDataAndRefresh(changed);
            } else {
                //error?
            }
        } catch (e) {
            console.log(e);
        }
    }

    function onMovedCalendarMilestone(result) {
        if (result) {
            console.log('MOVE_CALENDARMILESTONE_ITEM');
            var tasks = [];
            _.each(result, function (milestone){
                tasks.push(function (c){
                    CalendarRowContentService.moveRow(milestone, TopNavCalendarService.canEdit, function (result) {
                        c();
                    });
                });
            });
            async.series(tasks, function (err, result1){
                reloadDataAndRefresh(true);
            });
        }
    }

    function initRootParams(type) {
        console.log('initRootParams' + type);
        CalendarApiService.initRootParams($ctrl.CPS.product, type);
        load();
    }

    function saveTemplate(newVal, oldVal) {
        console.log('saveTemplate');
        if (!newVal || newVal === oldVal || $ctrl.isCompany) {
            return;
        }
        var productId = TopNavCalendarService.getCalendarTemplate();
        if (productId) {
            CalendarRowContentService.saveTemplate($ctrl.CPS.companyId, productId, function (item) {
                $ctrl.popupsService.open(item, $ctrl.popupsService.operations.saveCalendarTemplate, null,$ctrl.compOptions);
            });
        }
    }

    function toggleAutoWidth(newVal, oldVal) {
        $ctrl.options.width = newVal;
        refreshInterface();
    }

    function toggleHideTasksOutOfRange(newVal, oldVal) {
        $ctrl.options.taskOutOfRange = newVal ? false : true;
        refreshInterface();
    }

    function toggleStartWeekOnSunday(newVal, oldVal) {
        refreshInterface();
    }

    function toggleCurrentDate(newVal, oldVal) {
        toggleProp(newVal, oldVal, 'currentDate');
    }

    function toggleDependencies(newVal, oldVal) {
        toggleProp(newVal, oldVal, 'dependencies');
    }

    function toggleHideRowsWithoutTasks(newVal, oldVal) {
        toggleProp(newVal, oldVal, 'hideRowsWithoutTasks');
    }

    function toggleHideTaskNames(newVal, oldVal) {
        toggleProp(newVal, oldVal, 'hideTaskNames');
    }

    function toggleConflicts(newVal, oldVal) {
        toggleProp(newVal, oldVal, 'conflicts');
    }

    function toggleTimeframesWorking(newVal, oldVal) {
        toggleProp(newVal, oldVal, 'timeFramesWorkingMode');
        refreshInterface();
    }

    function toggleTimeframesNonWorking(newVal, oldVal) {
        toggleProp(newVal, oldVal, 'timeFramesNonWorkingMode');
    }

    function toggleShowRowBorders(newVal, oldVal) {
        toggleProp(newVal, oldVal, 'showRowBorders');
    }

    function toggleScale(newVal, oldVal) {
        toggleProp(newVal, oldVal, 'scale');
        $ctrl.options = TopNavCalendarService.updateHeaders($ctrl.options);
        refreshInterface();
    }

    function changeWorkingDays(newVal, oldVal) {
        refreshInterface();
    }

    function toggleZoom(newVal, oldVal) {
        toggleProp(newVal, oldVal, 'zoom');
    }

    function toggleCollapse(collapse, oldVal) {
        if (collapse) {
            $ctrl.api.tree.collapseAll();
        } else {
            $ctrl.api.tree.expandAll();
        }
    }

    function toggleProp(newVal, oldVal, prop) {
        $ctrl.options[prop] = newVal;
    }

    function toggleDateRange(newVal, oldVal) {
        refreshInterface();
    }

    function getFiltered(newVal, oldVal) {
        console.log('startSearch: ' + newVal);
        $ctrl.options.filterTask = filterTask;
        $ctrl.options.filterRow = filterRow;
        refreshInterface();
    }

    function filterTask(task, index) {
        var dbTask = CalendarRowContentService.getDBItem(task.model);
        return TopNavCalendarService.filterTasks(dbTask);
    }

    function filterRow(row, index) {
        var model = row.model;
        if (model.data.type === $ctrl.RowTypes.Product) {
            return true;
        }
        if (TopNavCalendarService.hideRows) {
            return CalendarRowContentService.hasTasks(model);
        }
        return true;
    }

    function handleTaskClick(e, model, event) {
        if (e && !$ctrl.LCS.isTouchScreen) {
            $ctrl.preventDefault(e);
        }

        var item = CalendarRowContentService.getDBItem(model);

        switch (event) {
            case $ctrl.EventTypes.Edit:
                updateTaskCard(item);
                break;
            case $ctrl.EventTypes.Remove:
                //$ctrl.popupsService.open(item, $ctrl.popupsService.operations.updateTaskCard, 'task card', null, null, true);
                break;
        }
    }

    function logTaskDependenciesEvent(eventName, dependency, oldDependency) {
        var taskModel = dependency.task.model,
            fromTask = taskModel.id,
            toTask = dependency.model.to,
            eventType = null;
        $log.info('[Event] ' + eventName + ': ' + fromTask + ' -> ' + toTask);
        switch (eventName) {
            case 'dependencies.on.add':
                eventType = $ctrl.EventTypes.Add;
                break;
            case 'dependencies.on.remove':
                eventType = $ctrl.EventTypes.Remove;
                break;
        }

        CalendarRowContentService.updateTaskDependencies(fromTask, toTask, eventType, TopNavCalendarService.canEdit,
            reloadDataAndRefresh, function (err) {
                if (err) {
                    console.log(err);
                    $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.todoCard.dependencies.add.error', 'error');
                }
            });
    }

    function logTaskEvent(eventName, task, row) {
        var rowModel = task.row.model, taskModel = task.model;

        $log.info('[Event] ' + eventName + ': ' + taskModel.name);
        switch (eventName) {
            case 'tasks.on.rowChange':
                console.log('tasks.on.rowChange');
                break;
            //case 'tasks.on.change':
            //    break;
            //case 'tasks.on.rowChange':
            //    break;
            case 'tasks.on.resizeEnd':
            case 'tasks.on.moveEnd':
                //save temp row to db only when moving from another row to the temp row
                var supportInsert = eventName === 'tasks.on.moveEnd';
                CalendarRowContentService.updateTaskRowAndDate(taskModel, rowModel.id, TopNavCalendarService.canEdit, supportInsert, function (result) {
                    if (result) {
                        reloadDataAndRefresh(true);
                        var item = CalendarRowContentService.getDBItem(taskModel);
                        $ctrl.broadcastRoot('UPDATED_TASKCARD_DATE_' + item._id, item);
                    }
                }, function (err) {
                    if (err) {
                        console.log(err);
                        $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.todoCard.update.error', 'error');
                    }
                });
                break;

            case 'tasks.on.drawEnd':
                onInsertDbTask(taskModel, true);
                break;
        }
    }

    function drawTaskFactory(rowModel) {
        console.log('drawTaskFactory');
        return $ctrl.checkIfCanAddTasks(true, process, function () {
            console.log('cant add the task so remove it from interface ');
            return null;
        });

        function process() {
            return CalendarRowContentService.drawTaskFactory(rowModel, TopNavCalendarService.canEdit);
        }
    }

    function reloadDataAndRefresh(changed) {
        if (changed) {
            console.log('reloadDataAndRefresh');
            $ctrl.data = CalendarRowContentService.getData();
            TopNavCalendarService.setTasksCollections(CalendarRowContentService.getTasksCollections());
            if (!firstLoadFinished) {
                $ctrl.options.scale = TopNavCalendarService.setScaleBasedOnTasks();
            }
            getDB();
            //console.log($ctrl.live.dbSource);
            //console.log($ctrl.data);
            refreshInterface();
            return true;
        }
        return false;
    }

    function reorderRowEvent(row, targetRow, isShift) {
        var name = row.model.data ? row.model.data.name : row.model.text;
        var toname = targetRow.model.data ? targetRow.model.data.name : row.model.text;
        $log.info('[Event] on.move.rows: ' + name + ' to ' + toname);
        CalendarRowContentService.reorderRow(row.model, targetRow.model, isShift,
            reloadDataAndRefresh,
            function (err) {
                console.log(err);
                $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.todoCard.error.error', 'error');
            });
    }

    function logRowEvent(eventName, row) {
        var name = row.model.data ? row.model.data.name : row.model.text;
        $log.info('[Event] ' + eventName + ': ' + name);
        switch (eventName) {
            case 'rows.on.remove':
                //$ctrl.api.tree.refresh();
                break;
        }
    }

    function logTimespanEvent(eventName, timespan) {
        var name = timespan.model.data ? timespan.model.data.name : timespan.model.text;
        $log.info('[Event] ' + eventName + ': ' + name);
    }

    function logLabelsEvent(eventName, width) {
        $log.info('[Event] ' + eventName + ': ' + width);
    }

    function logColumnsGenerateEvent(columns, headers, time) {
        $log.info('[Event] ' + 'columns.on.generate' + ': ' + columns.length + ' column(s), ' + headers.length + ' header(s),' + time + 'time');

        if (refreshCalendar) {
            $ctrl.LCS.timeout(function () {
                if ($ctrl.api) {
                    $ctrl.api.scroll.toDate(TopNavCalendarService.getFocusDay());
                    refreshCalendar = false;
                }
            }, 0);

            setWatchers();
        }

        loaderShow(true, time);
        if (!firstLoadFinished) {
            console.log('firstLoadFinished');
            firstLoadFinished = true;
            setWatchers();
        }
    }

    function logColumnsStartGenerateEvent(time) {
        $log.info('[Event] ' + 'columns.on.startGenerate: ' + time);
        loaderShow(false, time);
    }

    function loaderShow(isStarted, time) {
        $rootScope.$emit(isStarted ? 'loaderShow' : 'loaderHide', {
            method: 'PUT',
            name: time ? time.toString() : null
        });
    }

    function logRowsFilterEvent(rows, filteredRows) {
        $log.info('[Event] rows.on.filter: ' + filteredRows.length + '/' + rows.length + ' rows displayed.');
    }

    function logTasksFilterEvent(tasks, filteredTasks) {
        $log.info('[Event] tasks.on.filter: ' + filteredTasks.length + '/' + tasks.length + ' tasks displayed.');
    }

    function logReadyEvent() {
        $log.info('[Event] core.on.ready');
    }

    function refreshInterface(prop) {
        console.log('refreshInterface');
        var fromDate = angular.copy(TopNavCalendarService.fromDate),
            toDate = angular.copy(TopNavCalendarService.toDate),
            changed, wChanged;
        var options = $ctrl.options;

        if (!options.fromDate || !options.toDate || options.fromDate && options.toDate
        //    && (options.fromDate > fromDate || toDate > options.toDate)
        ) {
            if (!options.fromDate || options.fromDate && !GanttMoment.isSameDate(options.fromDate, fromDate) || !TopNavCalendarService.tasksCount) {
                changed = true;
                options.fromDate = fromDate;
            }
            if (!options.toDate || options.toDate && !GanttMoment.isSameDate(options.toDate, toDate) || !TopNavCalendarService.tasksCount) {
                changed = true;
                options.toDate = toDate;
            }
        }

        if (options.scale !== TopNavCalendarService.scale) {
            changed = true;
            options.scale = TopNavCalendarService.scale;
            options = TopNavCalendarService.updateHeaders(options);
        }

        if (options.workingDays !== TopNavCalendarService.workingDays) {
            options.workingDays = TopNavCalendarService.workingDays;
            wChanged = true;
        }

        if (prop === 'zoom') {
            options.zoom = TopNavCalendarService.zoom;
            wChanged = true;
        }

        if (changed || wChanged) {
            //console.log('options.scale:' + options.scale + '; options.range:' + options.fromDate.toString() + ' - ' + options.toDate.toString());
            refreshCalendar = true;
            $ctrl.options = options;
        }

        if ($ctrl.api) {
            if(wChanged){
                $ctrl.LCS.timeout(function () {
                    $ctrl.api.columns.generate();
                }, 0);
            }else if (changed) {
                $ctrl.api.gantt.addSideColumns = true;
            } else {
                $ctrl.LCS.timeout(function () {
                    $ctrl.api.tree.refresh();
                    $ctrl.api.groups.refresh();
                    $ctrl.api.rows.refresh();
                    $ctrl.api.dependencies.refresh();
                }, 0);
                $ctrl.LCS.timeout(function () {
                    $ctrl.api.scroll.toDate(TopNavCalendarService.getFocusDay());
                }, 100);
            }
        }
    }

    function getDB() {
        $ctrl.live.dbSource = CalendarRowContentService.getDB();
        $ctrl.live.dbSourceJson = angular.toJson($ctrl.live.dbSource, true);
    }

    $ctrl.showLiveRows = false;
    $ctrl.live = {};

    function loadLiveRows(api) {
        if (!$ctrl.isDebug) {
            return false;
        }
        objectModel = new ObjectModel(api);
        // Visual two way binding.
        var debounceValue = 1000;

        var listenTaskJson = debounce(function (taskJson) {
            if (taskJson !== undefined) {
                var task = angular.fromJson(taskJson);
                objectModel.cleanTask(task);
                var model = $ctrl.live.task;
                angular.merge(model, task);
            }
        }, debounceValue);

        var listenRowJson = debounce(function (rowJson) {
            if (rowJson !== undefined) {
                var row = angular.fromJson(rowJson);
                objectModel.cleanRow(row);
                var tasks = row.tasks;

                delete row.tasks;
                delete row.drawTask;

                var rowModel = $ctrl.live.row;

                angular.merge(rowModel, row);

                var newTasks = {};
                var i, l;

                if (tasks !== undefined) {
                    for (i = 0, l = tasks.length; i < l; i++) {
                        objectModel.cleanTask(tasks[i]);
                    }

                    for (i = 0, l = tasks.length; i < l; i++) {
                        newTasks[tasks[i].id] = tasks[i];
                    }

                    if (rowModel.tasks === undefined) {
                        rowModel.tasks = [];
                    }
                    for (i = rowModel.tasks.length - 1; i >= 0; i--) {
                        var existingTask = rowModel.tasks[i];
                        var newTask = newTasks[existingTask.id];
                        if (newTask === undefined) {
                            rowModel.tasks.splice(i, 1);
                        } else {
                            objectModel.cleanTask(newTask);
                            angular.merge(existingTask, newTask);
                            delete newTasks[existingTask.id];
                        }
                    }
                } else {
                    delete rowModel.tasks;
                }

                _.each(newTasks, function (newTask) {
                    rowModel.tasks.push(newTask);
                });
            }
        }, debounceValue);

        $ctrl.addToObservable($scope, '$ctrl.live.taskJson', listenTaskJson);
        $ctrl.addToObservable($scope, '$ctrl.live.rowJson', listenRowJson);
        $ctrl.addToObservable($scope,'$ctrl.live.task', onLiveTask,true);
        $ctrl.addToObservable($scope,'$ctrl.live.row', onLiveRow,true);
        $ctrl.addToObservable($scope,'$ctrl.live.row.tasks', onLiveRowTasks,true);

        function onLiveTask(task) {
            $ctrl.LCS.timeout(function () {
                $ctrl.live.taskJson = angular.toJson(task, true);
                $ctrl.live.rowJson = angular.toJson($ctrl.live.row, true);
            });
        }

        function onLiveRowTasks() {
            $ctrl.LCS.timeout(function () {
                $ctrl.live.rowJson = angular.toJson($ctrl.live.row, true);
            });
        }

        function onLiveRow(row) {
            $ctrl.LCS.timeout(function () {
                $ctrl.live.rowJson = angular.toJson(row, true);
                if (row !== undefined && row.tasks !== undefined && row.tasks.indexOf($ctrl.live.task) < 0) {
                    $ctrl.live.task = row.tasks[0];
                }
            });
        }
    }
}

angular.module('calendar.Api.service', [
    'calendar.RowContent.service',
    'services.todoColumnsConfigsService'
])

.service('CalendarApiService', CalendarApiService);
CalendarApiService.$inject = ['CalendarRowContentService', 'RouteCollaboratorsService', 'TodoColumnsConfigsService'];

function CalendarApiService(CalendarRowContentService, RouteCollaboratorsService,  TodoColumnsConfigsService) {
    var initvals= {todoPages:false, todoColumns:false, team:false};

    var methods =  {
        BlocksSetupService: RouteCollaboratorsService.BlocksSetupService,
        RouteCollaboratorsService: RouteCollaboratorsService,
        CalendarRowContentService: CalendarRowContentService,
        init: init,
        isInit: isInit,
        initRootParams: initRootParams
    };

    return methods;

    function isInit(){
        return initvals.todoPages && initvals.todoColumns && initvals.team;
    }

    function init(companyId, shortDateFormat, isDebug) {
        methods.CalendarRowContentService.initUtils(companyId, shortDateFormat, isDebug);
    }

    // Reload data action
    function initRootParams(product, type) {
        var allTodoColumns = TodoColumnsConfigsService.getTodoColumns();
        switch(type) {
            case 1:
                initPages();
                break;
            case 2:
                initColumns(allTodoColumns);
                break;
            case 3:
                initTeam(product);
                break;
        }
    }

    function initTeam(product){
        var team = methods.RouteCollaboratorsService.getProjectTeam(product);
        if(team && team.length > 0  ) {
            initvals.team = true;
            methods.CalendarRowContentService.setTeam(team);
        }
    }

    function initPages(){
        var todoPages = methods.BlocksSetupService.todoPages;
        if(todoPages) {
            initvals.todoPages = true;
            methods.CalendarRowContentService.setTodoPage(todoPages['user.product.calendar']);
        }
    }

    function initColumns(allTodoColumns) {
        if (allTodoColumns) {
            initvals.todoColumns = true;
            methods.CalendarRowContentService.setTodoColumns(allTodoColumns);
        }
    }

    //Scale = ['minute', '5 minutes', 'hour', '3 hours', 'day', 'week', '2 weeks', 'month', 'quarter', '6 months', 'year'];
    //Sort = [{label: 'disabled', value: undefined},{label: 'name', value: 'model.name'},{label: 'from', value: 'from'},{label: 'to', value: 'to'}];
    //CurrentDate = ['none', 'line', 'column'];
    //Expand =  ['none', 'both', 'left', 'right'];
    //TaskOutOfRange = ['expand', 'truncate'];
    //ColumnMagnet = ['column', '1 second', '1 minute', '5 minutes', '15 minutes', '1 hour', '1 day', '5 days'];
    //SideMode = ['Tree', 'Table', 'TreeTable', 'Disabled'];
    //GroupDisplayMode = ['group', 'overview', 'promote', 'Disabled'];
    //Working = ['visible', 'hidden', 'cropped']; //timeFramesWorkingMode
}


angular.module('calendar.Content.service', [
    'calendar.Utils.service',
    'calendar.TodoPage.service',
    'calendar.TodoColumn.service',
    'calendar.Team.service',
    'calendar.Tooltips.service'
])
    .service('CalendarContentService', CalendarContentService);
CalendarContentService.$inject = ['CalendarTodoColumnService', 'CalendarTodoPageService', 'GanttMoment', 'CalendarUtilsService', 'SBFieldMethods', 'CPS'];

function CalendarContentService( CalendarTodoColumnService, CalendarTodoPageService, GanttMoment, CalendarUtilsService, SBFieldMethods, CPS) {
    var LCS = CPS.LCS,
        security = CPS.security,
        RowTypes = CalendarUtilsService.getRowTypes(),
        EventTypes = CalendarUtilsService.getEventTypes(),
        convertResource = CalendarUtilsService.convertResource,
        getModelService = CalendarUtilsService.getModelService,
        getElemType = CalendarUtilsService.getElemType,
        getItemTitle = CalendarUtilsService.getItemTitle,
        getRowItemClasses = CalendarUtilsService.getRowItemClasses,
        getTypeName = CalendarUtilsService.getTypeName,
        shortDateFormat = CalendarUtilsService.shortDateFormat,
        getDebugId = CalendarUtilsService.getDebugId,
        DefaultTodoCardColor = CalendarUtilsService.DefaultTodoCardColor,
        methods = {
            getContent: getContent,
            getItem: getItem,
            handleRowClick: handleRowClick,
            getTaskObject: getTaskObject,
            newTaskForRow: newTaskForRow
        };

    return methods;

    function getDbTaskFromModel(taskModel, dbTask) {
        dbTask.startDate = {value: taskModel.from, hasTime: true};
        dbTask.dueDate = {value: taskModel.to, hasTime: true};
        return convertResource(dbTask, RowTypes.Event);
    }


    function getNewItemOrder(list){
        return (list && list.length > 0 ? _.max(list, function (item) {
            return item.order;
        }).order : -1) + 1;
    }

    function newTaskForRow(row) {
        var order = getNewItemOrder(row.tasks), //order starts at 0
            data = row.data,
            startDate = row.taskDate ? GanttMoment.getStartOfDayMoment(row.taskDate) : GanttMoment.getStartOfDayMoment(),
            endDate = row.taskDate ? GanttMoment.getEndOfDayMoment(row.taskDate) : GanttMoment.getEndOfDayMoment();

        return convertResource({
            _id: new ObjectId().toString(),
            name: 'New Event ' + (order + 1), // Name shown on top of each task.
            color: row.color ? row.color : DefaultTodoCardColor, // Color of the task in HEX
            // format (Optional).
            productId: data.productId,
            calendarId: data.calendarId,
            calendarMilestoneId: row.id,
            order: order,
            startDate: {value: startDate, hasTime: true},
            dueDate: {value: endDate, hasTime: true},
            todoPageId: CalendarTodoPageService.getTodoPageId(), //calendar
            todoColumnId: CalendarTodoColumnService.getTodoColumnId(data.productId),
            active: true,
            type: 2
        }, RowTypes.Event);
    }

    function handleRowClick(item, model, newType, event, isUnder, onInsertDbTask, operations, process, compOptions, e) {
        console.log('handleRowClick calendarContentService ');
        var currentType = model.data.type,
            calendarId = model.data.calendarId;

        switch (event) {
            case EventTypes.Add:
                if (newType === RowTypes.Event) {
                    onInsertDbTask(model, false);
                } else { //add group or milestone
                    var newItem = getNewItem(item, newType, currentType, calendarId, isUnder, model.data.parentId);
                    if(newType === RowTypes.Group){
                        CPS.loadQuotaPopup(JSON.parse(compOptions).quotaTypeGroups, processPlan, null, null, compOptions, {e:e});
                    } else{
                        processPlan();
                    }

                    function processPlan() {
                        openCalendarPopup(newItem, newType, 'createCalendar' + getTypeName(newType), 'Create', operations, process, compOptions);
                    }
                }
                break;

            case EventTypes.Edit:
                openCalendarPopup(item, newType, 'updateCalendar' + getTypeName(newType), 'Edit', operations, process, compOptions);
                break;

            case EventTypes.Remove:
                openCalendarPopup(item, newType, 'removeCalendar', 'Remove', operations, process, compOptions);
                break;

            case EventTypes.Move:
                item.startDate = model.from;
                openCalendarPopup(item, newType, 'moveCalendar', 'Move', operations, process, compOptions);
                break;
        }
    }

    function openCalendarPopup(item, type, optype, opname, operations, process, compOptions) {
        var operation = operations[optype],
            name = getTypeName(type).toLowerCase(),
            t = getElemType(type).toLowerCase();

        console.log('openCalendarPopup - type: ' + type + '; optype: ' + optype);
        var extraParam = opname !== 'Move' ? {service: getModelService(type)} : {
            service: getModelService(RowTypes.Milestone),
            type: t
        };

        process(item, operation, extraParam, JSON.stringify(_.extend({}, compOptions ? JSON.parse(compOptions) : {}, {
            itemTitle: getItemTitle(type),
            elemType: getElemType(type),
            objectType: optype.indexOf('remove') !== -1 ? name.toLowerCase() : t
        })));
    }

    function getNewItem(parent, type, currentType, calendarId, isUnder, parentGroup) {
        var isProduct = currentType === RowTypes.Product;
        var parentId = parent._id, item = {companyId: CalendarUtilsService.getCompanyId()};
        item.productId = isProduct ? parentId : parent.productId;

        if (type === RowTypes.Group) {
            item.isFolder = true;
        }
        if (type === RowTypes.Group || type === RowTypes.Milestone) {
            item.calendarId = calendarId;
        }

        if (type === RowTypes.Milestone) {
            if (currentType === RowTypes.Milestone) {// set parentid only if it doesnt belong to a group
                if (isUnder) {
                    item.afterId = parentId;
                    item.parentId = parent.parentId;
                }
            } else if (currentType === RowTypes.Group) {// set parentid cause it belongs to a group
                if (isUnder) {
                    item.parentId = parent.parentId; //parent is product
                    item.afterId = parentId;
                } else {
                    item.parentId = parentId;
                }  //parent is group
            }
        } else if (type === RowTypes.Group) {
            if (currentType === RowTypes.Milestone) { //add group under parent of milestone
                if (isUnder) {
                    item.afterId = parent.parentId ? parentGroup : parentId;
                }
            } else if (currentType === RowTypes.Group) { //add group under group
                item.afterId = parentId;
            }
        }

        return convertResource(item, type);
    }

    function getEventType(){
         return 'ng-click';
    }

    function getCollapseEvent(){
        return getEventType()+"='row.model.children? (!isCollapseDisabled() && toggle()) : null'";
    }

    function getTaskEvent(type){
        return getEventType()+"='$root.handleTaskClick($event, task.model," + type + ")'";
    }

    function getAction(obj, type, event, name, isUnder){
var m = 'handleRowClick';
        return getEventType()+'="$root.'+m+'(' + obj + ',' + type + ', ' + event + ',' + (isUnder?'true':'false') + ', $event)" data-type="'+m+'" analytics-on analytics-action="' + name + '"';
    }

    function getContent(item, type, actions, canEdit) {
        var clickEvent = getCollapseEvent();

        switch (type) {
            case RowTypes.Product:
                //return "<div class='handler sbf menu'></div>"+
             return getHandleCol() +
                    getPictureCol() +
                    "<div class='action-buttons-trigger'>" +
                        "<div> " +
                            "<div "+clickEvent+" ng-class=\"{'with-cursor':row.model.children}\" " +
                            //"  tooltip-placement='top' tooltip-html=\"$root.getGroupTooltip(row)|unsafe\" "+
                            ">" +
                                "<span class='with-margin-left name cursor-pointer' ng-bind='row.model.data.name''></span>" +
                                "<span class='duration' ng-if=\"row.rangeToDays('d')\" ng-bind=\"row.rangeToDays('d')\"></span>" +
                                getDebugParams() +
                            "</div>" +
                            actions +
                        "</div> " +
                    "</div>";

            case RowTypes.Group:
                return getHandleCol() +
                    "<div class='action-buttons-trigger'>" +
                    "<div "+clickEvent+" ng-class=\"{'with-cursor':row.model.children}\" " +
                    //"  tooltip-placement='top' tooltip-html=\"$root.getGroupTooltip(row)|unsafe\" "+
                    ">" +
                    "<span class='sbf gray sbf14 col20' ng-class=\"(row.model.children ? (collapsed == true?'closed':'open'): 'closed')+'-folder-filled'\">"+LCS.getISBPath(2)+"</span>" +
                    "<span class='with-margin-left name' ng-bind='row.model.data.name'></span> <span class='duration' ng-if=\"row.rangeToDays('d')\" ng-bind=\"row.rangeToDays('d')\"></span>" +
                    getDebugParams() +
                    "</div>" +
                    actions +
                    "</div>";

            case RowTypes.Milestone:
                return "<div class='handler'>"+(canEdit ?LCS.getISBDiv('dd3-handle', 2, 'gray'):'')+"</div>" +
                    "<div ng-if='row.model.data.parentId' class='gantt-tree-group-column'>&nbsp;</div>" +
                    "<div class='action-buttons-trigger'>" +
                    "<div "+clickEvent +
                    //"  tooltip-placement='top' tooltip-html=\"$root.getGroupTooltip(row)|unsafe\" "+
                    ">" +
                    LCS.getISBDiv('calendars', 3, 'pull-left gray sbf14 col20') +
                    "<span class='with-margin-left name' ng-bind='row.model.data.name'></span> <span class='duration' ng-if=\"row.rangeToDays('d')\" ng-bind=\"row.rangeToDays('d')\"></span>" +
                    getDebugParams() +
                    "</div>" +
                    actions +
                    "</div>";

            case RowTypes.Event:
                return "<div class='todo-card-block' ng-style='{color:task.model.textColor}'>" +
                    "<div class='with-hover' " + getTaskEvent(EventTypes.Edit) + "><span ng-bind-html='task.model.data.name|unsafe'></span> <span ng-if='task.width>204'><span class='or'>•</span> <span ng-bind=\"task.rangeToDays('D')\"></span></span></div>" +
                    '</div>';
        }

        return null;

        function getHandleCol() {
            return "<div class='gantt-tree-handle-column centered text-center action-buttons-trigger' ng-class=\"{'with-hover':row.model.children}\" "+clickEvent+">" +
                "<span ng-if='row.model.children.length>0' class='gantt-tree-handle gray sbf' ng-class=\"{true:'sort-right', false:'sort-down'}[collapsed == true]\"></span>" +
                '</div>';
        }

        function getPictureCol() {
            return "<div class='centered logo-col'>"  +
                security.getImage(item, 'smaller', 'logo', 100, {
                    avatar: 'project',
                    iconPaths: LCS.getISBPath(2),
                    withSquareImg: true,
                    imgClass: 'centering'
                }) +
                "</div>";
        }

        function getDebugParams() {
            if (getDebugId()) {
                return "<div class='font-size-9'><span ng-bind='row.model.id'></span> <span class='or'>•</span>" +
                    "<span ng-bind='row.model.order'></span> <span class='or'>•</span>RowFrom: " +
                    "<span ng-bind='row.from| amDateFormat: " + shortDateFormat + "'></span> <span class='or'>•</span>ModelFrom: " +
                    "<span ng-bind='row.model.from| amDateFormat: " + shortDateFormat + "'></span> <span class='or'>•</span>" +
                    "<span ng-bind='$root.getDBItemOrder(row.model)'></span>" +
                    "</div>";
            }
            return '';
        }
    }

    function getActions(type, parentId, canEdit) {
        if(!canEdit){return '';}

        var name = getTypeName(type);
        //Add Row  /  Add Group Edit / Delete
        var actions = addButtons(false, type);

        if (type !== RowTypes.Product){
                var obj = (type === RowTypes.Event ? 'task' : 'row');//+ '.model';
                actions += '<div ng-if="row.data.type == ' + RowTypes.Product + '&& row.model.from || row.data.type !==' + RowTypes.Product + '" class="btn-group actions with-margin-left" dropdown>' +
                    LCS.getMoreBtn('more-hor', 2, 'gray') +

                    '<ul class="dropdown-menu side-menu fadeInDownLeft actions-drp" role="menu">' +
                        getLi('row', type, EventTypes.Duplicate, 'Duplicate ' + name, false, 'copy', 2, null, null) +
                        getLi('row', type, EventTypes.Move, 'Change Start Date', false, 'date', 6, 'row.from', null) +

                        getLi(obj, type, EventTypes.Edit, 'Edit ' + name, false, 'pencil', 2, null, null) +

                       addButtons(true, type) +

                      '<li class="with-top-border"></li>' +

                       getLi(obj, type, EventTypes.Remove, 'Remove ' + name, false, 'trash', 2, null, 'accent') +

                  '</ul>' +
                '</div>';
        }

        return '<div class="action-buttons ' + (type === RowTypes.Product ? "with-margin-left" : "") + (getDebugId() ? ' debug' : '') + '">' +
            actions +
            '</div>';

        function getLi(obj, t, event, name, isUnder, icon, iconLevel, cond, cls) {
            return '<li' + (cond ? (' ng-if="' + cond + '"') : '') + '><a class="table-div full-width ' + (cls || '') + '" ' + getAction(obj, t, event, name, isUnder) + '>' +
                '<div class="col30">' + LCS.getISBDiv(icon, iconLevel) + '</div>' +
                '<div>' + name + '</div>' +
                '</a></li>';
        }

        function addButtons(isIpad, type) {
            var start = isIpad ? '<li class="hide-desktop hide-print">' : '', end = isIpad ? '</li>' : '';
            return addBtn('Add Row',// + (type === RowTypes.Milestone ? ' Under' : '');
                    RowTypes.Milestone, EventTypes.Add, type === RowTypes.Milestone, 'style="line-height:24px;margin-right:' + (RowTypes.Product ? 10 : 20) + 'px"', isIpad) +
                addBtn('Add Group',// + (type === RowTypes.Product ? '' : ' Under');
                    RowTypes.Group, EventTypes.Add, type !== RowTypes.Product, '', isIpad);

            function addBtn(name, t, event, isUnder, style, isIpad) {
             return start +
                    '<a ' + (isIpad ? '' : style) + ' class="' + (isIpad ? 'table-div full-width' : 'hide-ipad') + '"' +
                        getAction('row', t, event, name, isUnder) + '>' +
                        (isIpad ? '<div class="col30">' + LCS.getISBDiv('plus', 2) + '</div><div>' : '+ ') +
                            name +
                        (isIpad ? '</div>' : '') +
                    '</a>' +
                    end;
            }       //if(type === RowTypes.Milestone)addBtn(Add Event', RowTypes.Event + "," + EventTypes.Add);;
        }
    }

    function getModelDependencies(dbItem) {
        var l = dbItem.dependencies ? dbItem.dependencies.length : 0;
        if (l > 0) {
            var d = [];
            for (var i = 0; i < l; i++) {
                d.push({to: dbItem.dependencies[i]});
            }
            return d;
        }
        return null;
    }

    /*content*/
    function getItem(item, type, canEdit, setDBItem, order) {
        item = convertResource(item, type);
        var d = {
            type: type,
            name: item.name,
            calendarId: item.calendarId,
            parentId: type !== RowTypes.Event ? item.parentId : item.calendarMilestoneId,
            productId: type === RowTypes.Product ? item._id : item.productId
        };
        if (type === RowTypes.Product) {
            d.icon = 'project';
        }
        if (type === RowTypes.Group) {
            d.icon = 'open-folder-filled';
        }
        if (item.isTemp) {
            d.isTemp = item.isTemp;
        }

        var params = {
            id: item._id,
            name: item._id,
            classes: getRowItemClasses(type, item.parentId, item.isTemp),
            data: d,
            // onDrop: reorderRow
        };

        if (item.from) {
            params.from = item.from;
        }
        if (item.to) {
            params.to = item.to;
        }
        if (order !== undefined) {
            params.order = order;
        }
        if (item.children) {
            params.children = item.children;
        }

        if (type !== RowTypes.Event) {
            params.sortable = type !== RowTypes.Product && canEdit;
            params.drawTask = type === RowTypes.Milestone && canEdit;
        }

        if (type === RowTypes.Product) {
            // params.parent = null;
            params.dragChannel = 'product';
            params.dropChannels = 'milestone,group,product';
        } else if (type === RowTypes.Group) {
            //params.parent =item.productId;
            params.dragChannel = 'group';
            params.dropChannels = 'milestone,group';
        } else if (type === RowTypes.Milestone) {
            //params.parent = item.parentId ? item.parentId : item.productId;
            params.dragChannel = 'milestone';
            params.dropChannels = 'milestone';
            if (!item.isTemp) {
                params.color = item.color;
                var tasks = [];
                if (item.todoCards) {
                    for (var i = 0, m = item.todoCards.length; i < m; i++) {
                        var taskModel = getItem(item.todoCards[i], RowTypes.Event, canEdit, setDBItem);
                        if (taskModel.from && (!params.from || params.from > taskModel.from)) {
                            params.from = angular.copy(taskModel.from);
                        }
                        if (taskModel.to && (!params.to || params.to < taskModel.to)) {
                            params.to = angular.copy(taskModel.to);
                        }
                        tasks.push(taskModel);
                    }
                }
                params.tasks = tasks;
            }
        } else if (type === RowTypes.Event) {
            //params.parent = item.calendarMilestoneId;
            params.color = item.color;
            params.order = item.order;
            params.textColor = getTodoCardsTextColor(item.color);
            if (item.startDate && item.startDate.value) {
                params.from = item.startDate.value;
            }
            if (item.dueDate && item.dueDate.value) {
                params.to = item.dueDate.value;
            }
            if (item.priority) {
                params.priority = item.priority;
            }
            params.progress = getProgress(item.stats);
            //all dependencies are from the current task to another task

            var dep = getModelDependencies(item);
            if (dep) {
                params.dependencies = dep;
            }
        }

        params.tooltips = false;
        var actions = type === RowTypes.Event ? '' : getActions(type, item.parentId, canEdit);
        params.content = getContent(item, type, actions, canEdit);

        //{item: convertResource(item, type), type: type}

        setDBItem(item);
        return params;
    }

    function getProgress(stats) {
        return stats && stats.tasks > 0 ? (100 * stats.tasksCompleted / stats.tasks) : 0;
    }

    function getTaskObject(isDrawn, model, dbTask) {
        return isDrawn ? getDbTaskFromModel(model, dbTask) : newTaskForRow(model);
    }

    function getTodoCardsTextColor (color) {
        var c1 =color ? color.toUpperCase() : SBFieldMethods.DefaultTodoCardColor,
        el = _.find(SBFieldMethods.Colors, function (el){return c1 && el.id === c1;});
        return el ? el.text : '#fff';
    }
}

angular.module('calendar.Data.service', [
    'calendar.Utils.service'
])
    .service('CalendarDataService', CalendarDataService);
CalendarDataService.$inject = [ 'CalendarUtilsService'];
function CalendarDataService(CalendarUtilsService) {
    var RowTypes = CalendarUtilsService.getRowTypes(),
        getRowItemClasses = CalendarUtilsService.getRowItemClasses;
    var data;//stores the data that will be used to sync the calendar
    //items contain children as arrays of ids . the children's info is added as new item
    //tasks are added fully to items for property tasks
    var tasksCount = 0;

    var methods = {
        getDataRowById: getDataRowById,
        getDataRowByOrder: getDataRowByOrder,
        getDataRowByIndex: getDataRowByIndex,
        setDataRowByIndex: setDataRowByIndex,
        addDataRow: addDataRow,
        removeDataRow: removeDataRow,
        clear: clear,
        getReorderRowUpdates: getReorderRowUpdates,
        reorderData: reorderData,
        reorderDataRow: reorderDataRow,
        length: length,
        getData: getData,
        updateTimespan: updateTimespan,
        updateTimespanForParents: updateTimespanForParents,
        updateTimespanRecursive: updateTimespanRecursive,
        getRowsByType: getRowsByType,
        hasTasks: hasTasks
    };

    return methods;

    function hasTasks(row) {
        return checkTasks(row.id);
    }

    function checkTasks(id) {
        var row = getDataRowById(id).row;
        if (row.data.type === RowTypes.Milestone) {
            if (row.tasks && row.tasks.length > 0) {
                return true;
            }
        } else {
            var ch = row.children, l = ch ? ch.length : 0;
            if (ch) {
                for (var i = 0; i < l; i++) {
                    var check = checkTasks(ch[i]);
                    if (check) {
                        return true;
                    }
                }
            }
        }
        return false;
    }

    function getRowsByType(type) {
        return _.filter(data, function (item) {
            return item && item.data && item.data.type === type;
        });
    }

    function length() {
        return data ? data.length : 0;
    }

    function removeDataRow(row) {
        var expRow = data[row.index];
        if (expRow.id === row.row.id) {
            data.splice(row.index, 1);
            if (expRow.tasks) {
                tasksCount -= expRow.tasks.length;
                if (tasksCount < 0) {
                    tasksCount = 0;
                }
            }
        }
    }

    function clear() {
        data = [];
        tasksCount = 0;
    }

    function getData() {
        return data;
    }

    function addDataRow(item) {
        if (!CalendarUtilsService.existsItemInList(data, {id: item.id})) {
            data.push(item);
            return true;
        }
        return false;
    }

    function getDataRowByProp(prop, val) {
        for (var i = 0; i < data.length; i++) {
            var row = data[i];
            if (row[prop] === val) {
                return {row: row, index: i};
            }

        }
        return null;
    }

    function getDataRowById(id) {
        return getDataRowByProp('id', id);
    }

    function getDataRowByOrder(order) {
        return getDataRowByProp('order', order);
    }

    function getDataRowByIndex(index) {
        if (data.length > index) {
            return data[index];
        }
        return null;
    }

    function setDataRowByIndex(index, row) {
        row.updatedAt = Date.now();
        data[index] = row;
    }

    function reorderDataRow(updates, children, updateOrder, onsuccess, onerror) {
        updateOrder(updates, function (result) {
            //update children for parentRow and toParentRow
            for (var u in children) {
                var ch = children[u];
                var x = getDataRowById(u), dataRow = x.row;
                if (ch && ch.length > 0) {
                    dataRow.children = ch;
                }
                else {
                    delete dataRow.children;
                }
                setDataRowByIndex(x.index, dataRow);
            }
            console.log('CalendarMilestonesService.updateOrder');
            return onsuccess();
        }, onerror);
    }

    function getReorderRowUpdates(r, tr, row, toRow, isShift) {
        //update order and parent for row based on parent row
        var id = r.id, toId = tr.id;
        if (id === toId) {
            return null;
        }

        var toParentRow, childrenIds, toChildrenIds,
            type = r.data.type,
            productId = type === RowTypes.Product ? row._id : row.productId,
            parentId = row.parentId ? row.parentId : productId,
            isProductParent = parentId === productId,
            parentRow = angular.copy(getDataRowById(parentId));
        if (parentRow) {
            childrenIds = parentRow.row.children;
        }
        var toType = tr.data.type,
            toProductId = toType === RowTypes.Product ? toRow._id : toRow.productId,
            toParentId = type === RowTypes.Milestone && toType === RowTypes.Group ? toId : (toRow.parentId ? toRow.parentId : toProductId),
            isToProductParent = toParentId === toProductId;

        //support movement only between same product
        var sameProduct = productId === toProductId;
        if (!sameProduct) {
            return null;
        }

        var sameParent = parentId === toParentId;
        if (!sameParent) {
            toParentRow = angular.copy(getDataRowById(toParentId));
            if (toParentRow) {
                toChildrenIds = toParentRow.row.children;
            }
        }
        var updates = {}, children = {};

        switch (toType) {
            case RowTypes.Product:
                if (type === RowTypes.Product) { //move product in position  of other product
                    //reorder products, not supported for now
                    return null;
                } else if (type === RowTypes.Group || type === RowTypes.Milestone) {  //move group or milestone to product
                    // if milestone or group from children is moved to  product - >reorder product children
                    if (parentId === productId) { // same parentId
                        //there is nothing to change if it's last item in children list already
                        if (id === childrenIds[0]) {
                            return null;
                        }
                        //remove item from where it is and add it at the begining
                        childrenIds = repositionChildAtIndex(isProductParent, childrenIds, id, 0, parentId, true);
                    } else {// a milestone from a group is moved to a product
                        //1. remove the milestone from the parent group where currently  is
                        childrenIds = repositionChildAtIndex(isProductParent, childrenIds, id, null, parentId, true);

                        //2. add the id at the begining of product children
                        //change the parent for the milestone
                        toChildrenIds = repositionChildAtIndex(isToProductParent, toChildrenIds, id, 0, toParentId, false);
                    }
                }
                break;

            case RowTypes.Group:
                if (type === RowTypes.Group) { //reorder groups in same product
                    // - > same parent
                    //remove group from the current position in children
                    //add group to the in front of toId
                    // reorder all children from the new position on
                    childrenIds = repositionChildAtIndex(isProductParent, childrenIds, id, toId, parentId, true);
                } else if (type === RowTypes.Milestone) {//move milestone from a group or from the product
                    // into a group ( by default) or in place of a group (if holding shift)
                    if (isShift) {
                        console.log('isShift');
                        childrenIds = repositionChildAtIndex(isProductParent, childrenIds, id, toId, parentId, true);
                    } else {//add milestone in the group
                        //remove milestone from the children of the parent
                        childrenIds = repositionChildAtIndex(isProductParent, childrenIds, id, null, parentId, true);
                        //add milestone as child for the new parent
                        toChildrenIds = repositionChildAtIndex(isToProductParent, toChildrenIds, id, 0, toParentId, false);
                    }
                }
                break;

            case RowTypes.Milestone:
                if (type === RowTypes.Group) {//move group in place of a milestone . can be only at product level
                    //same parent - that is the product
                    childrenIds = repositionChildAtIndex(isProductParent, childrenIds, id, toId, parentId, true);
                } else if (type === RowTypes.Milestone) {
                    if (sameParent) {//reorder milestone in same group or product
                        childrenIds = repositionChildAtIndex(isProductParent, childrenIds, id, toId, parentId, true);
                    } else {//move milestone from group or product to another group, product
                        //remove milestone from the children of the parent
                        childrenIds = repositionChildAtIndex(isProductParent, childrenIds, id, null, parentId, true);
                        //add milestone as child for the new parent
                        toChildrenIds = repositionChildAtIndex(isToProductParent, toChildrenIds, id, toId, toParentId, false);
                    }
                }

                break;
        }

        //toId or index
        function repositionChildAtIndex(isProductParent, list, id, toId, parentId, remove) {
            if (!list) {
                list = [];
            }

            //get index for id and toId
            var toIdIndex = -1, idIndex = -1, i, l;
            if (typeof (toId) === 'string') {
                //change only the indexes for item that start at index
                for (i = 0, l = list.length; i < l; i++) {
                    if (list[i] === id) {
                        idIndex = i;
                    }
                    else if (list[i] === toId) {
                        toIdIndex = i;
                    }
                }
            } else {
                toIdIndex = toId;
            }

            //remove id from where it is in list of product children & add it at the end
            if (remove) {
                if (idIndex !== -1) {
                    list.splice(idIndex, 1);
                }
                else {
                    for (i = 0, l = list.length; i < l; i++) {
                        if (list[i] === id) {
                            list.splice(i, 1);
                            break;
                        }
                    }
                }
            }

            //add id at index
            if (toIdIndex === -1) {
                toIdIndex = 0;
            }
            if (toIdIndex != null) {
                if (toIdIndex >= list.length) {
                    list.push(id);
                }//at the end
                else if (toIdIndex === 0) {
                    list.unshift(id);
                }// at begining
                else {
                    list.splice(toIdIndex, 0, id);
                } //at index
            }

            //update indexes
            for (i = 0, l = list.length; i < l; i++) {
                var up = {order: i};
                if (isProductParent) {
                    up.productId = parentId;
                }
                up.parentId = isProductParent ? null : parentId;
                updates[list[i]] = up;
            }

            if (!list || list.length === 0) {
                list = null;
            }

            children[parentId] = list;

            console.log('repositionChildAtIndex');
            return list;
        }

        return {updates: updates, children: children};
    }

    function reorderData() {
        if (!data || data.length === 0) {
            return;
        }
        var productRows = [], nonProductRows = {}, i, l;
        for (i = 0, l = data.length; i < l; i++) {
            var row = getDataRowByIndex(i);
            if (row.data.type === RowTypes.Product) {
                productRows.push(row);
            }
            else {
                nonProductRows[row.id] = row;
            }
        }

        var k = -1, //order starts at 0
            dup = [];
        for (i = 0, l = productRows.length; i < l; i++) {
            var productCh = addRow(productRows[i], null);
            if (productCh && productCh.length > 0) {
                for (var j = 0, m = productCh.length; j < m; j++) {
                    var groupRow = nonProductRows[productCh[j]];
                    var groupCh = addRow(groupRow, null);
                    if (groupCh && groupCh.length > 0) { //if is a group with children add the children
                        for (var a = 0, n = groupCh.length; a < n; a++) {
                            addRow(nonProductRows[groupCh[a]], groupRow.id); //milestone
                        }
                    }
                }
            }
        }
        data = dup;

        function addRow(row, parentId) {
            if (!row) {
                return;
            }
            row.order = ++k;
            row.data.parentId = parentId;
            row.classes = getRowItemClasses(row.data.type, parentId, row.data.isTemp);
            dup.push(row);
            return row.children;
        }
    }

    function updateTimespanRecursive(row, notRecursive) { //return timestamp for current row
        var timespan = updateTimespan(row.id); //update current row timespan based on tasks
        if (!notRecursive) {
            updateTimespanForParents(row);
        }
        return timespan;
    }

    function updateTimespanForParents(row) { //return timestamp for current row
        var parentId = row.data.parentId;
        // is part of a group so update timespan for the parent group
        if (parentId) {
            updateTimespan(parentId);
        }
        var productId = row.data.productId; //get the product row
        if (productId) {
            updateTimespan(productId);
        }//update timespan for the parent group
    }

    function updateTimespan(id) {
        var dataRow = getDataRowById(id), index = dataRow.index, row = dataRow.row;
        var notimespan = true, hasTasks = row.data.type === RowTypes.Milestone,
            tasks = hasTasks ? row.tasks : row.children;
        if (tasks && tasks.length > 0) {
            var timespan = {from: null, to: null};
            for (var j = 0, n = tasks.length; j < n; j++) {
                var task = tasks[j];
                if (!hasTasks) {
                    task = getDataRowById(task).row;
                }
                if (task.from && (!timespan.from || timespan.from > task.from)) {
                    timespan.from = angular.copy(task.from);
                }
                if (task.to && (!timespan.to || timespan.to < task.to)) {
                    timespan.to = angular.copy(task.to);
                }
            }
            row.from = timespan.from ? angular.copy(timespan.from) : null;
            row.to = timespan.to ? angular.copy(timespan.to) : null;
            if (timespan.from && timespan.to) {
                notimespan = false;
            }
        }
        if (notimespan) {
            row.from = null;
            row.to = null;
        }
        setDataRowByIndex(index, row);
        return {id: row.id, from: row.from, to: row.to};
    }
}

angular.module('calendar.DB.service', [])
    .service('CalendarDBService', CalendarDBService);
function CalendarDBService() {
    var dbSource = {};  //stores the database items -> dbSource[id]= database element

    //db item of type group have parentId null
    //db item of type milestone have parentid null if they're attached to product or groupid if they re attached to a group

    var methods = {
        getDB: getDB,
        getDBItem: getDBItem,
        removeDBItem: removeDBItem,
        removeDBItems: removeDBItems,
        setDBItem: setDBItem,
        setDBItems: setDBItems,
        updateDBRow: updateDBRow,
        processDBUpdates: processDBUpdates,
        clear: clear,
        getDBChangesOnReorder: getDBChangesOnReorder,
        getDBItemOrder: getDBItemOrder
    };

    return methods;

    function clear() {
        dbSource = {};
    }

    function getDB() {
        return dbSource;
    }

    function getDBItem(row) {
        var t = dbSource[row.id];
        return t ? t : null;
    }

    function getDBItemOrder(row) {
        var item = getDBItem(row);
        return item ? item.order : -1;
    }

    function removeDBItem(id) {
        console.log('removeItem:' + id);
        delete dbSource[id];
    }

    function removeDBItems(list) {
        if (list) {
            var l = list.length;
            if (l > 0) {
                for (var i = l - 1; i >= 0; i--) {
                    removeDBItem(list[i]);
                }
                return true;
            }
        }
        return false;
    }

    function setDBItem(el) {
        dbSource[el._id] = el;
    }

    function setDBItems(els) {
        if (!els || els.length === 0) {
            return false;
        }
        for (var i = 0, n = els.length; i < n; i++) {
            setDBItem(els[i]);
        }
        return true;
    }

    function updateDBRow(row, dbItem) {
        var el = getDBItem(row);
        if (el) {
            el.parentId = dbItem.parentId;
            el.name = dbItem.name;
            el.color = dbItem.color;
            setDBItem(el);
            return el;
        }
        return null;
    }

    function processDBUpdates(result) {
        if (!result) {
            return;
        }
        for (var prop in result) {
            var res = result[prop];
            var el = getDBItem({id: prop});
            if (el) {
                for (var p1 in res) {
                    el[p1] = res[p1];
                }
                setDBItem(el);
            }
        }
    }

    function getDBChangesOnReorder(updates) {
        var els = [], updates1 = {}, changed = false;
        console.log("get updates");
        for (var u in updates) {
            var props = updates[u];
            var changedx = false;
            var el = angular.copy(getDBItem({id: u}));
            if (el) {
                for (var prop in props) {
                    var nv = props[prop];
                    if (el[prop] !== nv) {
                        el[prop] = nv;
                        if (!updates1[u]) {
                            updates1[u] = {};
                        }
                        updates1[u][prop] = nv;
                        changed = true;
                        changedx = true;
                    }
                }
                if (changedx) {
                    els.push(el);
                }
            } else {
                console.log('el doesnt exist:' + u);
            }
        }
        if (!changed) {
            return null;
        }
        return {updates: updates1, els: els};
    }
}

angular.module('calendar.Management.service', [
    'calendar.Utils.service'
])
    .service('CalendarManagementService', CalendarManagementService);
CalendarManagementService.$inject = ['CalendarUtilsService'];

function CalendarManagementService(CalendarUtilsService) {
    var RowTypes = CalendarUtilsService.getRowTypes(),
        CalendarService = CalendarUtilsService.getModelService(RowTypes.Calendar),
        sortItems = CalendarUtilsService.sortItems,
        timeFrame = {
            from: null,
            to: null
        };

    var methods = {
        saveTemplate: saveTemplate,
        loadCalendars: loadCalendars,
        getCalendarMilestones: getCalendarMilestones,
        getTimeFrame: getTimeFrame
    };

    return methods;

    function getTimeFrame() {
        return timeFrame;
    }

    function getCalendarMilestones(milestones, m) {
        var level1 = [], level2 = {};

        //get the groups and milestones on level1
        for (var i = 0; i < m; i++) {
            var el = milestones[i], parentId = el.parentId;
            //add groups and milestones without parent to level1
            if (el.isFolder || !el.isFolder && !parentId) {
                level1.push(el);
            }
            else { //add milestones with parent group to level2 for each group
                if (!level2[parentId]) {
                    level2[parentId] = [];
                }
                level2[parentId].push(el);
            }
        }
        level1 = sortItems(level1);

        level1 = level1.map(function (el) {
            var ch = level2[el._id];
            if (el.isFolder && ch) {
                el.children = sortItems(ch);
            }
            return el;
        });
        return level1;
    }

//result = {from, structure, color}
    function saveTemplate(companyId, result, processTemplate) {
        if (result && result.structure) {
            result.isPredefined = false;
            result.companyId = companyId;
            processTemplate(result);
        }
    }

    function loadCalendars(params, canEdit, loadProductCalendar, onloaded) {
        var nd = {companyId: params.companyId},
            calTimespan = {from: null, to: null};
        if (params.isCompany) {
            nd.isCompany = true;
        }
        else {
            nd.productId = params.product._id;
            nd.calendarId = params.calendarId;
        }

        CalendarService.getAll(nd, null, null, onsuccess, onerror);

        function onsuccess(result) {
            var order = -1, timespan, tempcal;
            if (params.isCompany) {
                for (var i = 0, n = result.length; i < n; i++) {
                    var cal = result[i];
                    if (cal) {
                        tempcal = loadProductCalendar(cal, canEdit, order);
                        if (tempcal.order !== undefined) {
                            order = result.order;
                        }
                        timespan = tempcal ? tempcal.timespan : {};
                        if (timespan.from && (!calTimespan.from || calTimespan.from > timespan.from)) {
                            calTimespan.from = angular.copy(timespan.from);
                        }
                        if (timespan.to && (!calTimespan.to || calTimespan.to < timespan.to)) {
                            calTimespan.to = angular.copy(timespan.to);
                        }
                    }
                }
            } else {
                var product = params.product;
                product.calendar = result;
                tempcal = loadProductCalendar(product, canEdit);
                timespan = tempcal ? tempcal.timespan : {};
                if (timespan.from && (!calTimespan.from || calTimespan.from > timespan.from)) {
                    calTimespan.from = angular.copy(timespan.from);
                }
                if (timespan.to && (!calTimespan.to || calTimespan.to < timespan.to)) {
                    calTimespan.to = angular.copy(timespan.to);
                }
            }
            onloaded(null, timespan);
        }

        function onerror(err) {
            onloaded(err, null);
        }
    }
}

angular.module('calendar.Options.service', [
    'calendar.Utils.service'
])
    .service('CalendarOptionsService', CalendarOptionsService);
CalendarOptionsService.$inject = ['GanttMoment', 'CalendarUtilsService'];
function CalendarOptionsService( GanttMoment, CalendarUtilsService) {
    var RowTypes = CalendarUtilsService.getRowTypes();

    var viewScale = GanttMoment.ViewScale;
    var autoExpandDirection = {Both: 'both', Left: 'left', Right: 'right', None: 'none'};
    var columnMagnet = {
        Column: 'column',
        Minute: '1 minute',
        QuarterHour: '15 minutes',
        HalfHour: '30 minutes',
        Hour: '1 hour',
        Day: '1 day',
        Days5: '5 days',
        Days7: '7 days'
    };
    var methods = {
        getOptions: getOptions
    };

    return methods;

    function getOptions() {
        var options = {
            ViewScale: viewScale,
            AutoExpandDirection: autoExpandDirection,
            ColumnMagnet: columnMagnet,
            unitsExpanded: 10,
            mode: 'custom',
            // sortMode: undefined,//'model.data.item.order',//Sort
            autoExpand: autoExpandDirection.Both, //How to expand cells
            taskOutOfRange: 'expand',
            // Behavior when tasks are defined out of the Gantt rendering range (see from-date and to-date).
            //expand: rendering range will be expanded to display the tasks entirely.
            //truncate: tasks will be truncated, or even totally hidden if they are not in rendering range at all.

            //Precision of the column. All date and time computation will be rounded using this precision. It will also snap to borders of timeFrames and columns is time-frames-magnet is true.

            sideMode: 'TreeTable',//Side Tree or TreeTable
            maxHeight: 0,//Height
            groupDisplayMode: 'group', //Groups
            width: false,//Width
            labelsEnabled: true,//Show Labels
            allowSideResizing: true,//Side section can be resized.

            columns: ['model'],
            columnsHeaders: {'model': ''},
            columnsHeaderContents: {'model': ''},
            columnsClasses: {'model': 'gantt-column-name'},

            columnsFormatters: {
                'from': function (from) {
                    return from !== undefined ? from.format('lll') : undefined;
                },
                'to': function (to) {
                    return to !== undefined ? to.format('lll') : undefined;
                }
            },
            treeTableColumns: [],
            treeHeaderContent: '',
            timeFrames: {
                'day': {
                    start: GanttMoment.getFormattedMoment('00:00:00 000', 'HH:mm:ss SSS'),
                    end: GanttMoment.getFormattedMoment('23:59:59 999', 'HH:mm:ss SSS'),
                    color: '#ACFFA3',
                    working: true,
                    default: true
                },
                'weekend': {
                    working: false
                },
               /* 'noon': {
                    start: GanttMoment.getFormattedMoment('12:00', 'HH:mm'),
                    end: GanttMoment.getFormattedMoment('13:00', 'HH:mm'),
                    working: true,
                    default: true
                },
                'closed': {
                    working: false,
                    default: true
                },
                'holiday': {
                    working: true,
                    //color: 'red',
                   // classes: ['gantt-timeframe-holiday']
                }
               */
            },
            dateFrames: {
                'weekend': {
                    targets: ['weekend']
                },
                /*'11-november': {
                    evaluator: function (date) {
                        return date.month() === 10 && date.date() === 11;
                    },
                    targets: ['holiday']
                }*/
            },

            movable: {
                allowResizing: true,
                allowRowSwitching: function (task, targetRow) {
                    var rowModel = targetRow.model, data = rowModel ? rowModel.data : null;
                    return data && data.type === RowTypes.Milestone && data.productId === task.model.data.productId;
                }
            },
            corner: {
                /*headersLabels: function (key) {
                    return '<span class="'+key+'">key.charAt(0).toUpperCase() + key.slice(1)</span>'
                    //return '';
                },*/
                headersLabelsTemplates: function (headerName, headerUnit, columns) {
                    return'<div class="'+headerName+'">{{getLabel(header)}}</div>';
                    // Other case will default template.
                }
            },
            targetDataAddRowIndex: undefined,

            columnMagnet: columnMagnet.Day,//expand by day
            daily: false,//Fill up view of tasks by rounding their from/to date to the start/end of day.
            timeFramesMagnet:  false,//TimeFrames
        };

        return options;
    }

}
angular.module('calendar.Row.service', [
    'calendar.Utils.service',
    'calendar.DB.service',
    'calendar.Data.service',

    'apiServices.CalendarMilestones'
])
    .service('CalendarRowService', CalendarRowService);
CalendarRowService.$inject = ['CalendarDBService', 'CalendarDataService', 'CalendarUtilsService'];
function CalendarRowService(CalendarDBService, CalendarDataService,  CalendarUtilsService) {
    var RowTypes = CalendarUtilsService.getRowTypes(),
        CalendarMilestonesService = CalendarUtilsService.getModelService(RowTypes.Milestone),
        sortItems = CalendarUtilsService.sortItems,
        getRowItemClasses = CalendarUtilsService.getRowItemClasses,
        DefaultTodoCardColor = CalendarUtilsService.DefaultTodoCardColor;
    var methods = {
        addRow: addRow,
        updateRow: updateRow,
        removeRow: removeRow,
        reorderRow: reorderRow,
        duplicateRow: duplicateRow,
        getCalendarStructure: getCalendarStructure,
        updateMilestoneColorFromTask: updateMilestoneColorFromTask,
        addTempRow: addTempRow,
        addTempDataRow: addTempDataRow,
        addCalendarMilestone: addCalendarMilestone,
        getTasksCollections: getTasksCollections
    };

    return methods;

    function getTasksCollections() {
        var rows = CalendarDataService.getRowsByType(RowTypes.Milestone);
        var allTasks = [];
        for (var i = 0, n = rows.length; i < n; i++) {
            var row = rows[i];
            if (row) {
                var tasks = row.tasks,
                    l = tasks ? tasks.length : 0;
                for (var j = 0; j < l; j++) {
                    allTasks.push(CalendarDBService.getDBItem(tasks[j]));
                }
            }

        }
        return allTasks;
    }

    //add old temp row in db and create new temp row
    function addTempRow(item, canEdit, getItem, onsuccess, onerror) {
        var dataRow = item.row,
            index = item.index,
            order = dataRow.order,
            params = CalendarDBService.getDBItem(dataRow);

        if (order > 0) {
            try {
                var prevRow = CalendarDataService.getDataRowByOrder(order - 1).row;
                var parentId = prevRow.data.parentId;
                if (parentId) {
                    var row = CalendarDataService.getDataRowById(parentId).row;
                    if (row) {
                        params.afterId = row.id;
                    }
                } else {
                    params.afterId = prevRow.id;
                }
            } catch (e) {
            }
        }
        CalendarMilestonesService.insert(params, function (result) { //item, updates
            var newRow = result.item;
            CalendarDBService.setDBItem(newRow);//add row to db
            dataRow.name = newRow.name;
            dataRow.color = newRow.color;
            delete dataRow.data.isTemp;
            dataRow.classes = dataRow.classes.replace('temporary', '').replace(' debug', '');

            CalendarDataService.setDataRowByIndex(index, dataRow);

            //add a new temp row under
            addTempDataRow(getItem, newRow.productId, newRow.calendarId, canEdit);
            onsuccess(dataRow);
        }, onerror);
    }

    // add a temp row at the end of the product data
    function addTempDataRow(getItem, productId, calendarId, canEdit, tempOrder, chOrder) {
        if (tempOrder === undefined) {
            var product = CalendarDataService.getDataRowById(productId), dataRow = product ? product.row : null;
            if (!dataRow) {
                return null;
            }

            //check if there is already a temp row for this item. if yes skip adding new one
            var children = dataRow.children ? dataRow.children : [], hasTemp;
            children.map(function (x) {
                var item = CalendarDBService.getDBItem({id: x});
                if (item.isTemp) {
                    hasTemp = true;
                }
            });
            if (hasTemp) {
                return null;
            }
            chOrder = children.length;
        }

        var id = new ObjectId().toString();
        var item = {
            _id: id,
            companyId: CalendarUtilsService.getCompanyId(),
            productId: productId,
            calendarId: calendarId,
            name: 'New Row ' + (tempOrder ? tempOrder : CalendarDataService.length()),
            isTemp: true,
            parentId: null,
            isFolder: false,
            order: chOrder
        };
        //check if there is already a temp row added
        var isAdded = tempOrder ?
            addCalendarMilestone(getItem, item, canEdit, tempOrder) :
            addRow({item: item}, canEdit, getItem, tempOrder);
        return isAdded ? id : null;
    }

    function duplicateRow(item, canEdit, getItem, onsuccess, onerror) {
        var isFolder = item.data.type === RowTypes.Group,
            newItem = {
                _id: item.id,
                companyId: CalendarUtilsService.getCompanyId(),
                productId: item.data.productId,
                calendarId: item.data.calendarId,
            },
            structure = getStructure(newItem._id, false);
        if (structure) {
            newItem.structure = structure;
        }
        CalendarMilestonesService.duplicate(newItem, function (result) {
            //item ; updates; children with tasks ;
            if (result) {
                var children = result.children;
                if (children) {
                    var timespan = {from: null, to: null};
                    for (var i = 0; i < children.length; i++) {
                        var t = addCalendarMilestone(getItem, children[i], canEdit);
                        if (t.from && (!timespan.from || t.from < timespan.from)) {
                            timespan.from = angular.copy(t.from);
                        }
                        if (t.to && (!timespan.to || t.to > timespan.to)) {
                            timespan.to = angular.copy(t.to);
                        }
                    }
                    result.item.from = timespan.from ? angular.copy(timespan.from) : null;
                    result.item.to = timespan.to ? angular.copy(timespan.to) : null;
                }
                var row = addRow(result, canEdit, getItem);
                CalendarDataService.updateTimespanForParents(row);
                onsuccess(true);
            } else {
                onsuccess();
            }
        }, onerror);
    }

    function addRow(result, canEdit, getItem, order) {  //result = {item, updates}
        var el = result ? result.item : null;
        if (el) {
            addCalendarMilestone(getItem, el, canEdit, order);
            CalendarDBService.processDBUpdates(result.updates);
            var parentId = el.parentId ? el.parentId : el.productId;
            var item = CalendarDataService.getDataRowById(parentId), dataRow = item.row;
            if (dataRow) {
                var children = dataRow.children ? dataRow.children : [], has = false;
                var nc = children.map(function (x) {
                    if (x === el._id) {
                        has = true;
                    }
                    var item = CalendarDBService.getDBItem({id: x});
                    if (item.isTemp) {
                        setTempItemOrder(item, children.length);
                    }//temp element should be last of children
                    return item;
                });

                if (children.length === 0 && el.isTemp) {
                    setTempItemOrder(el, 0);//if there are no children set order for the new temp element to be 0
                }
                if (!has) {
                    nc.push(el);
                    nc = sortItems(nc);
                    nc = nc.map(function (x) {
                        return x._id;
                    });
                    if (nc.length > 0) {
                        dataRow.children = nc;
                    }

                    CalendarDataService.setDataRowByIndex(item.index, dataRow);
                    CalendarDataService.reorderData();
                    return dataRow;
                }
            }
        }
        return null;

        function setTempItemOrder(item, order) {
            item.order = order;
            CalendarDBService.setDBItem(item);
        }
    }

    function addCalendarMilestone(getItem, el, canEdit, order) {
        var item = getItem(el, el && el.isFolder ? RowTypes.Group : RowTypes.Milestone, canEdit, order);
        if (item) {
            CalendarDataService.addDataRow(item);
            return {from: item.from, to: item.to};
        }
        return null;
    }

    function updateRow(dbItem) {
        var item = CalendarDataService.getDataRowById(dbItem._id), dataRow = item.row;
        if (item) {
            dbItem = CalendarDBService.updateDBRow(dataRow, dbItem);
            if (dbItem) {
                var type = dataRow.data.type;
                dataRow.data.parentId = dbItem.parentId;
                dataRow.data.productId = type === RowTypes.Product ? dbItem._id : dbItem.productId;
                dataRow.data.name = dbItem.name;
                dataRow.color = dbItem.color;
                dataRow.classes = getRowItemClasses(type, dbItem.parentId, dataRow.data.isTemp);
            }

            CalendarDataService.setDataRowByIndex(item.index, dataRow);
            return true;
        }

        return false;
    }

    function removeRow(result) {  //result = {item, updates}
        if (!result) {
            return false;
        }

        var removed = result.removed, el = result.item, id = el._id,
            removeRowById = function removeRowById(id) {
                var index = removed.indexOf(id);
                if (index > -1) {
                    removed.splice(index, 1);
                    return removeDataRowAndTasksById(id);
                }
            };

        if (el) {
            var item = removeRowById(id), dataRow = item.row; //remove row
            if (item) {  //remove the children
                var ch = dataRow.children;
                if (ch && ch.length > 0) {
                    for (var j = ch.length - 1; j >= 0; j--) {
                        removeRowById(ch[j]);
                    }
                }
                //get the parent and if the parent has children remove the child from the list
                var parentId = dataRow.data.parentId ? dataRow.data.parentId : dataRow.data.productId;
                removeDataRowFromParentChildren(parentId, id);
            }

            CalendarDBService.processDBUpdates(result.updates);
            CalendarDataService.updateTimespanForParents(dataRow);

            return true;
        }

        return false;
    }

    function removeDataRowFromParentChildren(parentId, id) {
        var item = CalendarDataService.getDataRowById(parentId), dataRow = item.row;
        if (item) {
            var ch = dataRow.children;
            if (ch && ch.length > 0) {
                for (var j = ch.length - 1; j >= 0; j--) {
                    if (ch[j] === id) {
                        ch.splice(j, 1);
                        if (ch.length === 0) {
                            delete dataRow.children;
                        }
                        CalendarDataService.setDataRowByIndex(item.index, dataRow);
                        break;
                    }
                }
            }
        }
        return item;
    }

    function removeDataRowAndTasksById(id) {
        var item = CalendarDataService.getDataRowById(id), dataRow = item.row;
        if (item) {
            removeDbTasksForRow(dataRow);
            CalendarDataService.removeDataRow(item);
        }
        return item;
    }

    function removeDbTasksForRow(row) {
        if (row) {
            return CalendarDBService.removeDBItems(row.tasks);
        }
        return false;
    }

    function reorderRow(r, tr, isShift, onsuccess, onerror) {
        var row = CalendarDBService.getDBItem({id: r.id}),
            toRow = CalendarDBService.getDBItem({id: tr.id}),
            parentId = r.data.parentId,
            data = CalendarDataService.getReorderRowUpdates(r, tr, row, toRow, isShift); //returns {updates: updates, children:children};
        if (!data || !data.updates) {
            return onsuccess();
        }
        var dbChanges = CalendarDBService.getDBChangesOnReorder(data.updates);
        //{updates: , els:}
        if (dbChanges && dbChanges.updates) {
            CalendarDataService.reorderDataRow(dbChanges.updates, data.children,
                CalendarMilestonesService.updateOrder, function () {
                    CalendarDBService.setDBItems(dbChanges.els);
                    //update old parent in case of moving between groups
                    if (parentId) {
                        CalendarDataService.updateTimespan(parentId);
                    }
                    CalendarDataService.updateTimespanRecursive(r);
                    CalendarDataService.updateTimespanRecursive(tr);
                    onsuccess(true);
                }, onerror);
        }
        else {
            onsuccess();
        }
    }

    //the structure for the calendar sidebar
    function getCalendarStructure(productId) {
        return getStructure(productId, true);
    }

    function getStructure(itemId, isCalendar) {
        //[{n:'g1', f:1, m:[
        //  {n:'m11', c:'red', f:0, t:['id1', 'id2', 'id3']},
        //  {n:'m12', c:'red', f:0, t:['id1', 'id2', 'id3']}
        //]},
        //{n:'g2', f:1, m:[
        //  {n:'m21', c:'red', f:0, t:['id1', 'id2', 'id3']},
        //  {n:'m22', c:'red', f:0, t:['id1', 'id2', 'id3']}
        //]},
        //{n:'m3', f:0}]
        var result = {from: null, structure: null};
        var dataRow = CalendarDataService.getDataRowById(itemId), row = dataRow ? dataRow.row : null;
        if (!row) {
            return null;
        }
        if (isCalendar) {
            result.from = row.from;
            //get all children for the product
            result.structure = processRowStructure(null, row.children);
//must update task dependencies
            if (!result.structure) {
                return null;
            }
            return result;
        } else {
            switch (row.data.type) {
                case RowTypes.Group:
                    return processRowStructure(null, row.children);
                case RowTypes.Milestone:
                    return processTaskStructure(null, row);
            }
        }

        return null;

        function processRowStructure(g, ch) {
            if (!g) g = [];
            var l = ch ? ch.length : 0;
            if (l) {
                for (var K = 0; K < l; K++) {
                    var dataRow = CalendarDataService.getDataRowById(ch[K]),
                        row = dataRow ? dataRow.row : null;
                    if (row && !row.data.isTemp) {
                        var isFolder = row.data.type === RowTypes.Group;
                        var ng = {n: isCalendar ? row.data.name : row.id, f: isFolder};
                        if (!isFolder) {
                            ng = processTaskStructure(ng, row);
                        }
                        else if (row.children && row.children.length > 0) {
                            ng.m = processRowStructure(ng.m, row.children);
                        }
                        g.push(ng);
                    }
                }
            }
            return g;
        }

        function processTaskStructure(ng, row) {
            var tasks = row.tasks, t;
            if (tasks && tasks.length > 0) {
                t = tasks.map(function (x) {
                    return x.id;
                });
            }
            if (ng) {
                if (row.color && row.color !== DefaultTodoCardColor) {
                    if (!result.color) {
                        result.color = row.color;
                    }
                    ng.c = row.color;
                }
                if (t) {
                    ng.t = t;
                }
                return ng;
            } else {
                return t;
            }
        }
    }

    function updateMilestoneColorFromTask(dbTask, onsuccess) {
        var item = CalendarDataService.getDataRowById(dbTask.calendarMilestoneId), dataRow = item ? item.row : null;
        if (dataRow) {
            var updates = {}, update;
            if (!dataRow.color && dbTask.color && dbTask.color !== DefaultTodoCardColor) {
                updates.color = dbTask.color;
                update = true;
            }
            if ((!dataRow.name || dataRow.name.toLowerCase().indexOf('new row') !== -1) && dbTask.name && dbTask.name.toLowerCase().indexOf('new event') === -1) {
                updates.name = dbTask.name;
                update = true;
            }
            if (update) {
                updates._id = dataRow.id;
                CalendarMilestonesService.update(updates, function (result) {
                    var el = CalendarDBService.getDBItem(dataRow);
                    var color = updates.color;
                    if (color) {
                        el.color = color;
                        dataRow.color = color;
                    }
                    var name = updates.name;
                    if (name) {
                        el.name = name;
                        dataRow.data.name = name;
                    }
                    CalendarDBService.setDBItem(el);
                    CalendarDataService.setDataRowByIndex(item.index, dataRow);
                    onsuccess();
                });
            } else {
                onsuccess();
            }
        } else {
            onsuccess();
        }
    }
}

angular.module('calendar.RowContent.service', [
    'calendar.Utils.service',
    'calendar.Options.service',
    'calendar.DB.service',
    'calendar.Data.service',
    'calendar.Tooltips.service',
    'calendar.Content.service',
    'calendar.Management.service',
    'calendar.Row.service',
    'calendar.Task.service'
])
.service('CalendarRowContentService', CalendarRowContentService);
CalendarRowContentService.$inject = ['CalendarDBService', 'CalendarDataService', 'CalendarUtilsService', 'CalendarRowService', 'CalendarManagementService', 'CalendarContentService', 'CalendarTaskService', 'CalendarTooltipsService', 'CalendarTodoPageService', 'CalendarTodoColumnService', 'CalendarTeamService', 'CalendarOptionsService'];
function CalendarRowContentService(CalendarDBService, CalendarDataService,  CalendarUtilsService, CalendarRowService, CalendarManagementService,CalendarContentService, CalendarTaskService, CalendarTooltipsService, CalendarTodoPageService, CalendarTodoColumnService, CalendarTeamService, CalendarOptionsService) {

    var RowTypes = CalendarUtilsService.getRowTypes(),
        EventTypes = CalendarUtilsService.getEventTypes(),
        convertResource = CalendarUtilsService.convertResource;

    var methods = {
        RowTypes: RowTypes,
        EventTypes: EventTypes,
        initUtils: initUtils,
        addRow: addRow,
        updateRow: updateRow,
        moveRow: moveRow,
        reorderRow: reorderRow,
        removeRow: removeRow,
        duplicateRow: duplicateRow,
        handleRowClick: handleRowClick,

        loadCalendars: loadCalendars,
        clearCalendars: clearCalendars,
        saveTemplate: saveTemplate,

        getGroupTooltip: CalendarTooltipsService.getGroupTooltip,

        insertTask: insertTask,
        updateTask: CalendarTaskService.updateTask,
        duplicateTask: CalendarTaskService.duplicateTask,
        removeTask: CalendarTaskService.removeTask,
        updateTaskRowAndDate: updateTaskRowAndDate,
        updateTaskDependencies: CalendarTaskService.updateTaskDependencies,
        updateMilestoneColorFromTask: CalendarRowService.updateMilestoneColorFromTask,
        getTaskTooltip: getTaskTooltip,
        getTasksCollections: CalendarRowService.getTasksCollections,

        getData: CalendarDataService.getData,
        getDB: CalendarDBService.getDB,
        getDBItem: CalendarDBService.getDBItem,
        setTodoPage: CalendarTodoPageService.setTodoPage,
        setTodoColumns: CalendarTodoColumnService.setTodoColumns,
        setTeam: CalendarTeamService.setTeam,
        //getSampleTimespans: getSampleTimespans ,
        getTasksOutOfRange: CalendarUtilsService.getTasksOutOfRange,

        getRowModel: getRowModel,
        getTaskModel: getTaskModel,
        drawTaskFactory: drawTaskFactory,
        getDBItemOrder: CalendarDBService.getDBItemOrder,
        hasTasks: CalendarDataService.hasTasks,
        options: CalendarOptionsService.getOptions()
    };

    return methods;

    function initUtils(companyId, shortDateFormat, isDebug) {
        CalendarUtilsService.init(companyId, shortDateFormat, isDebug);
    }


    function addRow(result, canEdit) {
        return CalendarRowService.addRow(result, canEdit, getItem);
    }

    function moveRow(result, canEdit) {
        //is folder?{id: el._id, f:false, t: el.todoCards}:{id: mId, f:true, m:m};
        //task = {id : {startDate: el.startDate, dueDate: el.dueDate}}
        if (result) {
            var timespan = {from: null, to: null}, id = result.id, isFolder = result.f;
            if (isFolder) {//is folder
                var m = result.m;
                for (var j = 0, l = m.length; j < l; j++) {
                    var ml = m[j],
                        temp = CalendarTaskService.updateRowTasksTimestamps(ml.id, ml.t, canEdit, true);
                    if (temp.from && (!timespan.from || timespan.from && temp.from < timespan.from)) {
                        timespan.from = temp.from;
                    }
                    if (temp.to && (!timespan.to || timespan.to && temp.to > timespan.to)) {
                        timespan.to = angular.copy(temp.to);
                    }
                }
            } else {
                timespan = CalendarTaskService.updateRowTasksTimestamps(id, result.t, canEdit, true);
            }

            var item = CalendarDataService.getDataRowById(id), dataRow = item ? item.row : null;
            if (dataRow) {//  update timespan current row
                if (isFolder) {
                    dataRow.from = angular.copy(timespan.from);
                    dataRow.to = angular.copy(timespan.to);
                    CalendarDataService.setDataRowByIndex(item.index, dataRow);
                }

                CalendarDataService.updateTimespanForParents(dataRow);
                return true;
            }
        }
        return false;
    }

    function updateRow(dbItem) {
        return CalendarRowService.updateRow(dbItem);
    }

    function reorderRow(r, tr, isShift, onsuccess, onerror) {
        CalendarRowService.reorderRow(r, tr, isShift, function (result) {
            if (result) {
                CalendarDataService.reorderData();
            }
            onsuccess(result);
        }, onerror);
    }

    function removeRow(result) {
        var applied = CalendarRowService.removeRow(result);
        if (applied) {
            CalendarDataService.reorderData();
        }
        return applied;
    }

    function saveTemplate(companyId, productId, processTemplate) {
        var structure = CalendarRowService.getCalendarStructure(productId);
        return CalendarManagementService.saveTemplate(companyId, structure, processTemplate);
    }

    function getItem(item, type, canEdit, order) {
        return CalendarContentService.getItem(item, type, canEdit, CalendarDBService.setDBItem, order);
    }

    function drawTaskFactory(rowModel, canEdit) {
        return getItem(CalendarContentService.newTaskForRow(rowModel.model), RowTypes.Event, canEdit);
    }

    function getTaskTooltip(taskRow) {
        var item = CalendarDBService.getDBItem(taskRow),
            team = CalendarTeamService.getTeam(),
            todoPage = CalendarTodoPageService.getTodoPage(),
            todoColumn = CalendarTodoColumnService.getTodoColumnById(item);
        return CalendarTooltipsService.getTaskTooltip(item, team, todoPage, todoColumn);
    }

    function updateTaskRowAndDate(taskModel, rowId, canEdit, supportInsert, onsuccess, onerror) {
        if (supportInsert) {
            //check if model is a temp row
            var item = CalendarDataService.getDataRowById(rowId), dataRow = item ? item.row : null;
            if (dataRow) {
                if (dataRow.data.isTemp) {
                    //if yes save the row first and create new temp row. then update the task
                    CalendarRowService.addTempRow(item, canEdit, getItem, function (newRow) {
                        processTask();
                    }, onerror);
                } else {
                    processTask();
                }
            } else {
                onsuccess(null);
            }
        } else {
            processTask();
        }

        function processTask() {
            CalendarTaskService.updateTaskRowAndDate(taskModel, rowId, canEdit, onsuccess, onerror);
        }
    }

    function insertTask(taskModel, isDrawn, canEdit, onsuccess, onerror) {
        var dbTask = CalendarDBService.getDBItem(taskModel),
            taskObject = CalendarContentService.getTaskObject(isDrawn, taskModel, dbTask);
        var rowId = dbTask.calendarMilestoneId;
        var item = CalendarDataService.getDataRowById(rowId), dataRow = item.row;
        if (dataRow) {
            if (dataRow.data.isTemp) {//insert new row into db insert new
                CalendarRowService.addTempRow(item, canEdit, getItem, function (newRow) {   //add taks to row
                    CalendarTaskService.insertDbTask(newRow, taskObject, canEdit, onsuccess, onerror);
                }, onerror);
            } else {
                CalendarTaskService.insertDbTask(dataRow, taskObject, canEdit, onsuccess, onerror);
            }
        } else {
            onsuccess(null);
        }
    }

    function clearCalendars() {
        CalendarDBService.clear();
        CalendarDataService.clear();
        return true;
    }

    function loadCalendars(params, canEdit, onloaded) {
        clearCalendars();
        CalendarManagementService.loadCalendars(params, canEdit, loadProductCalendar, onloaded);
    }

    function loadProductCalendar(product, canEdit, order) {
        if (order === undefined) {
            order = -1;
        }
        var calendar = product.calendar;
        if (calendar) {
            var milestones = angular.copy(calendar.milestones), m = milestones ? milestones.length : 0;
            delete product.calendar.milestones;
            product.calendar = convertResource(calendar, RowTypes.Calendar);
            product.calendarId = product.calendar._id;

            var productRow = getItem(product, RowTypes.Product, canEdit, ++order),
                calT = {from: null, to: null};

            var setTimespan = function (elm, canEdit, order) {
                var t = CalendarRowService.addCalendarMilestone(getItem, elm, canEdit, order); //add milestone to data
                if (t.from && (!calT.from || calT.from > t.from)) {
                    calT.from = angular.copy(t.from);
                }
                if (t.to && (!calT.to || calT.to < t.to)) {
                    calT.to = angular.copy(t.to);
                }
                return t;
            };

            if (m > 0) {
                var productChildren = [];
                var nl = CalendarManagementService.getCalendarMilestones(milestones, m);
                for (var i = 0, n = nl.length; i < n; i++) {
                    var el = nl[i];
                    productChildren.push(el._id);
                    var parentorder = ++order;
                    if (el.isFolder) {
                        var children = el.children, mc = [];
                        if (children) {
                            for (var j = 0, nx = children.length; j < nx; j++) {
                                var elm = children[j];
                                mc.push(elm._id); //add milestone to group children
                                var t = setTimespan(elm, canEdit, ++order);   //add milestone to data
                                if (t.from && (!el.from || el.from > t.from)) {
                                    el.from = angular.copy(t.from);
                                }
                                if (t.to && (!el.to || el.to < t.to)) {
                                    el.to = angular.copy(t.to);
                                }
                            }
                            el.children = mc;
                        }
                    }
                    setTimespan(el, canEdit, parentorder); //add group to data
                }

                //add a new temp row that will allow us to draw tasks under the rows of the calendar
                if (canEdit) {
                    var tempId = CalendarRowService.addTempDataRow(getItem, product._id, product.calendarId, canEdit, ++order, productChildren.length);
                    productChildren.push(tempId);
                }

                productRow.children = productChildren;

            }
            if (calT) {
                if (calT.from) {
                    productRow.from = angular.copy(calT.from);
                }
                if (calT.to) {
                    productRow.to = angular.copy(calT.to);
                }
            }
            CalendarDataService.addDataRow(productRow);
            return {order: order, timespan: calT};
        }

        return {order: order, timespan: {}};
    }

    function getSampleTimespans() {
        return [
            /*     {
                     from: new Date(2017, 5, 21, 8, 0, 0),
                     to: new Date(2017, 5, 25, 15, 0, 0),
                     name: 'Sprint 1 Timespan'
                     //priority: undefined,
                     //classes: [],
                     //data: undefined
                 }*/
        ];
    }

    function duplicateRow(item, canEdit, onsuccess, onerror) {
        CalendarRowService.duplicateRow(item, canEdit, getItem, onsuccess, onerror);
    }

    function handleRowClick(model, newType, event, isUnder, onInsertDbTask, operations, process, compOptions, e) {
        console.log('handleRowClick rowContentService ');
        var item = CalendarDBService.getDBItem(model);
        CalendarContentService.handleRowClick(item, model, newType, event, isUnder, onInsertDbTask, operations, process, compOptions, e);
    }

    function getRowModel(id, type) {
        var rowId;
        if (type === RowTypes.Event) {
            var dbItem = CalendarDBService.getDBItem({id: id});
            if (!dbItem) {
                return null;
            }
            rowId = dbItem.calendarMilestoneId;
        } else {
            rowId = id;
        }
        var dataRow = CalendarDataService.getDataRowById(rowId);
        return dataRow ? dataRow.row : null;
        //{id: row.id, from: task.startDate.value, to: task.dueDate.value}
    }

    function getTaskModel(id) {
        var dbItem = CalendarDBService.getDBItem({id: id});
        if (!dbItem) {
            return null;
        }
        return {id: dbItem._id, from: dbItem.startDate.value, to: dbItem.dueDate.value};
    }
}

angular.module('calendar.Task.service', [
    'calendar.Utils.service',
    'calendar.DB.service',
    'calendar.Data.service',
    'calendar.Content.service',
    'apiServices.TodoCards'
])
    .service('CalendarTaskService', CalendarTaskService);
CalendarTaskService.$inject = ['CalendarDBService', 'CalendarDataService', 'CalendarUtilsService', 'CalendarContentService', 'GanttMoment'];
function CalendarTaskService(CalendarDBService, CalendarDataService, CalendarUtilsService, CalendarContentService, GanttMoment) {
    var RowTypes = CalendarUtilsService.getRowTypes(),
        EventTypes = CalendarUtilsService.getEventTypes(),
        TodoCardsService = CalendarUtilsService.getModelService(RowTypes.Event),
        getItem = CalendarContentService.getItem;

    var methods = {
        insertDbTask: insertDbTask,
        updateTaskDependencies: updateTaskDependencies,
        updateTaskRowAndDate: updateTaskRowAndDate,
        duplicateTask: duplicateTask,
        removeTask: removeTask,
        updateTask: updateTask,
        updateRowTasksTimestamps: updateRowTasksTimestamps
    };

    return methods;

    function insertDbTask(dataRow, task, canEdit, onsuccess, onerror) {
        TodoCardsService.insert(task, function (result) {
            var dbTask = result.item;
            processNewTask(dataRow, dbTask, canEdit);
            onsuccess(CalendarDBService.getDBItem({id: dbTask._id}));
        }, onerror);
    }

    function updateTaskDependencies(fromTask, toTask, eventType, canEdit, onsuccess, onerror) {
        var el = CalendarDBService.getDBItem({id: fromTask});
        var dependencies = el.dependencies, update = false;
        if (eventType === EventTypes.Add) {
            if (!dependencies) {
                dependencies = [toTask];
                update = true;
            }
            else {
                if (dependencies.indexOf(toTask) === -1) {
                    dependencies.push(toTask);
                    update = true;
                }
            }
        } else {
            if (!dependencies) {
                var index = dependencies.indexOf(toTask);
                if (index !== -1) {
                    dependencies.splice(index, 1);
                    update = true;
                }
            }
        }
        if (update) {
            if (dependencies.length === 0) {
                delete el.dependencies;
            }
            else el.dependencies = dependencies;

            TodoCardsService.update({
                _id: el._id,
                dependencies: el.dependencies ? el.dependencies : null
            }, function (result) {
                var updatedDbTask = result ? result.item : null;
                onsuccess(updateTask(updatedDbTask, canEdit));
            }, onerror);
        } else {
            onsuccess();
        }
    }

    function updateTaskRowAndDate(task, rowId, canEdit, onsuccess, onerror) {
        var changeRow, updates = {}, changed;
        var el = CalendarDBService.getDBItem(task);
        if (!el) {
            return onsuccess(false);
        }

        if (el.startDate.value.toString() !== task.from.toString()) {
            el.startDate.value = task.from;
            updates.startDate = el.startDate;
            changed = true;
        }

        if (el.dueDate.value.toString() !== task.to.toString()) {
            el.dueDate.value = task.to;
            updates.dueDate = el.dueDate;
            changed = true;
        }

        var currentRowId = el.calendarMilestoneId;
        if (rowId && rowId !== currentRowId) {
            el.calendarMilestoneId = rowId;
            updates.calendarMilestoneId = el.calendarMilestoneId;
            changeRow = true;
            changed = true;
        }

        if (!changed) {
            return onsuccess();
        }

        updates._id = el._id;
        TodoCardsService.update(updates, function (result) {
            var updatedDbTask = result ? result.item : null;
            //remove task from current row
            //add task to changedRow
            var timespan = changeRow ?
                swapDataTask(updatedDbTask, currentRowId, rowId, canEdit) :
                updateTask(updatedDbTask, canEdit);


            onsuccess(timespan);
        }, onerror);
    }

    function swapDataTask(dbTask, rowId, changedRowId, canEdit) {
        var t1 = removeTaskFromRow(rowId, dbTask._id);
        var t2 = addTaskToRow(changedRowId, dbTask, canEdit); //add task to new row
        return t2;
    }

    function processNewTask(dataRow, dbTask, canEdit) {
        if (dataRow) {
            var tasks = dataRow.tasks, exists;
            var task = getItem(dbTask, RowTypes.Event, canEdit, CalendarDBService.setDBItem);
            for (var i = 0, n = tasks.length; i < n; i++) {
                if (tasks[i].id === dbTask._id) {
                    tasks[i] = task;
                    exists = true;
                    break;
                }
            }
            if (!exists) {
                if (!tasks) {
                    tasks = [];
                }
                tasks.push(task);
            }
            dataRow.tasks = tasks;

            return onTaskUpdate(dataRow);
        } else {
            return null;
        }
    }

    function addTaskToRow(rowId, dbTask, canEdit) {
        var item = CalendarDataService.getDataRowById(rowId), dataRow = item.row;
        return processNewTask(dataRow, dbTask, canEdit);
    }

    function duplicateTask(task, canEdit, onSuccess, onError) {
        onSuccess(addTaskToRow(task.calendarMilestoneId, task, canEdit));

        /*TodoCardsService.duplicate({
            todoCardId: task._id,
            productId: task.productId,
            companyId: task.companyId,
            nextDay: true
        },  function onsuccess(result) {
            onSuccess(addTaskToRow(task.calendarMilestoneId, task, canEdit));
        }, onError);

        function onsuccess(result) {
            onSuccess(addTaskToRow(task.calendarMilestoneId, result.item, canEdit));
        }*/
    }

    function updateTask(dbTask, canEdit) {
        if (!dbTask) {
            return null;
        }
        var id = dbTask._id;
        var item = CalendarDataService.getDataRowById(dbTask.calendarMilestoneId), dataRow = item ? item.row : null;
        if (dataRow) {
            var tasks = dataRow.tasks, l = tasks && tasks.length > 0 ? tasks.length : 0;
            if (l) {
                for (var j = 0; j < l; j++) {
                    if (tasks[j].id === id) {
                        tasks[j] = getItem(dbTask, RowTypes.Event, canEdit, CalendarDBService.setDBItem);
                        break;
                    }
                }
                dataRow.tasks = tasks;
                return onTaskUpdate(dataRow);
            }
        }
        return null;
    }

    function removeTask(dbTask) {
        if (!dbTask) {
            return false;
        }
        return removeTaskFromRow(dbTask.calendarMilestoneId, dbTask._id);
    }

    function removeTaskFromRow(rowId, taskId) {
        var item = CalendarDataService.getDataRowById(rowId), dataRow = item ? item.row : null;
        if (dataRow) {
            CalendarDBService.removeDBItem(taskId);
            var tasks = dataRow.tasks, l = tasks && tasks.length > 0 ? tasks.length : 0;
            if (l) {
                for (var j = 0; j < l; j++) {
                   var el = tasks[j];
                    if (el && el.id === taskId) {
                        tasks.splice(j, 1);
                        dataRow.tasks = tasks;
                    }
                }
            }

            return onTaskUpdate(dataRow);
        }
        return null;
    }

    function updateRowTasksTimestamps(id, t, canEdit, notRecursive) {
        var item = CalendarDataService.getDataRowById(id), dataRow = item ? item.row : null, changed = false;
        if (dataRow) {
            var tasks = dataRow.tasks, l = tasks && tasks.length > 0 ? tasks.length : 0;
            if (l) {//check if the row has tasks for which the date has been updated
                for (var j = 0; j < l; j++) {
                    var tid = tasks[j].id, tinfo = t[tid];
                    changed = false;
                    if (tinfo) {
                        var dbTask = CalendarDBService.getDBItem({id: tid});
                        dbTask.startDate.value = GanttMoment.getMoment(tinfo.startDate);
                        dbTask.dueDate.value = GanttMoment.getMoment(tinfo.dueDate);
                        tasks[j] = getItem(dbTask, RowTypes.Event, canEdit, CalendarDBService.setDBItem);
                        changed = true;
                    }
                }
                if (changed) {
                    dataRow.tasks = tasks;
                }
            }
            return onTaskUpdate(dataRow, notRecursive);
        }
        return null;
    }

    function onTaskUpdate(row, notRecursive) {
        return CalendarDataService.updateTimespanRecursive(row, notRecursive);
    }
}

angular.module('calendar.Team.service', [])
.service('CalendarTeamService', CalendarTeamService);
function CalendarTeamService() {
    var team;

    var methods = {
        setTeam: setTeam,
        getTeam: getTeam
    };

    return methods;

    function setTeam(val) {
        team = val;
    }

    function getTeam(val) {
        return team;
    }
}

angular.module('calendar.TodoColumn.service', [])
.service('CalendarTodoColumnService', CalendarTodoColumnService);
function CalendarTodoColumnService() {
    var initTodoColumns, todoColumns;

    var methods = {
        hasSetTodoColumns: hasSetTodoColumns,
        setTodoColumns: setTodoColumns,
        getTodoColumnsForProduct: getTodoColumnsForProduct,
        getTodoColumnId: getTodoColumnId,
        getTodoColumnById: getTodoColumnById
    };

    return methods;

    function hasSetTodoColumns() {
        return initTodoColumns;
    }

    function setTodoColumns(cols) {
        if (!cols) {
            return;
        }
        initTodoColumns = true;
        todoColumns = cols;
    }

    function getTodoColumnsForProduct(productId) {
        return todoColumns ? todoColumns[productId] : null;
    }

    function getTodoColumnId(productId) {
        var cols = getTodoColumnsForProduct(productId),
            todoColumnId = null;
        var l = cols ? cols.length : 0;
        if (l > 0) {
            for (var i = 0; i < l; i++) {
                var c = cols[i];
                if (c.name.toLowerCase() === 'in progress') {
                    todoColumnId = c._id;
                    break;
                }
            }

            if (!todoColumnId) {
                todoColumnId = cols[0]._id;
            }
        }
        return todoColumnId;
    }

    function getTodoColumnById(item) {
        var cols = getTodoColumnsForProduct(item.productId);
        var l = cols ? cols.length : 0;
        for (var i = 0; i < l; i++) {
            var el = cols[i];
            if (el._id === item.todoColumnId) {
                return el;
            }
        }
        return null;
    }
}

angular.module('calendar.TodoPage.service', [])
.service('CalendarTodoPageService', CalendarTodoPageService);
function CalendarTodoPageService() {
    var todoPage, todoPageId;

    var methods = {
        setTodoPage: setTodoPage,
        getTodoPage: getTodoPage,
        getTodoPageId: getTodoPageId
    };

    return methods;

    function setTodoPage(val) {
        if (val) {
            todoPage = val;
            todoPageId = todoPage._id;
        }
    }

    function getTodoPage() {
        return todoPage;
    }

    function getTodoPageId() {
        return todoPageId;
    }
}

angular.module('calendar.Tooltips.service', [
    'calendar.Utils.service','security.service'
])
    .service('CalendarTooltipsService', CalendarTooltipsService);
CalendarTooltipsService.$inject = ['CalendarUtilsService', 'CPS'];

function CalendarTooltipsService(CalendarUtilsService, CPS){
    var security = CPS.security,
        LCS = CPS.LCS,
        MomentService = CPS.MomentService;
    var shortDateFormat = "ddd, MMM D";
    var getShortDate = CalendarUtilsService.getShortDate;
    var methods = {
        getGroupTooltip: getGroupTooltip,
        getTaskTooltip: getTaskTooltip
    };

    return methods;

    function getTaskTooltip(item, team, todoPage, todoColumn){
        var stats = item.stats,
          dueDate = item.dueDate ? item.dueDate.value : null,
          startDate = item.startDate ? item.startDate.value : null,
          range = dueDate && startDate ? ("<span style>" + item.rangeToDays('d')+ "</span>") : '';
        var content =  "<div class='todo-card full-width clearfix'>" +
            "<div class='header-section clearfix'>" +
                "<div class='name'>" +
                    getTodoColumnTaskContent(todoColumn) +
                    "<strong class='nametext word-wrap'>" + item.name + "</strong>" +
                "</div>"+
            "</div>" +
            ((dueDate || startDate) ?
                ('<div class="thinner">' + getDateSpan(startDate) + getDateSpan(dueDate, true) + range + '</div>')
                : ''
            );

        if(stats && (stats.tasks>0 || stats.answers>0 || stats.attachments>0)){
var cls= 'sbf14 gray';
            content += "<div class='stats clearfix'>";
            if(stats.tasks>0) {
                content += "<span class='with-margin-right'>"+LCS.getISBDiv('taskList', 2, cls)+" <span>" + stats.tasksCompleted + "</span>/<span>" + stats.tasks + "</span></span>";
            }
            if(stats.attachments>0){
                content += "<span class='with-margin-right'>"+LCS.getISBDiv('attachment', 2, cls)+" <span>" + stats.attachments + "</span></span>";
            }
            if(stats.answers>0){
                content += '<span>' + LCS.getISBDiv('conversations', 2, cls) + ' <span>' + stats.answers + '</span></span>';
            }
            content += '</div>';
        }

        content += getTeamTaskContent(item.teamIds, team) +
          '</div>';
        return content;

        function getDateSpan(d, dash) {
            return d ? ((dash && dueDate && startDate ? ' - ' : '') + '<span class="due-date "' +
                //todo: bring back logic for red date
                //   (MomentService.isUpcomingDate(d) ? 'alertd' :'') +
                '">' + getShortDate(d, shortDateFormat) + '</span>') : '';
        }
    }

    function getTodoColumnTaskContent(todoColumn, withName) {
        if (!todoColumn) {return '';}
        return '<div class="table-div pull-left" style="width: 18px;padding-top: 3px">'+
                    '<div class="centered" style="width: 16px">' +
                        '<div class="circle-wrapper" style="border:0;background-color:' + todoColumn.color + '"></div>' +
                    '</div>'+
                    (withName ? ('<div class="smaller strong">' + todoColumn.name + '</div>') :'')+
                "</div>";
    }

    function getTodoPageTaskContent(todoPage) {
        if(!todoPage){return "";}
        return LCS.getISBDiv(todoPage.icon, 6, 'with-margin-right', 'style="color:' + todoPage.color + '"');
    }

    function getTeamTaskContent(teamIds, team) {
        var content = '';
        if(teamIds && teamIds.length>0 && team) {
            content += "<div class='bottom-card clearfix'>" +
                            "<div class='pull-left with-margin-right'>" +
                                "<div class='teamSelector smaller-drp'>" +
                                    "<div>" +
                                        "<div class='small team-members'>" ;
                                    for(var i = 0, l = team.length; i < l;i++){
                                        var c = team[i];
                                        if(teamIds.indexOf(c._id) !== -1) {
                                            content += "<div class='user'>" + security.getUserImageComponent('item', 'little1')+ "</div>";
                                        }
                                    }
                                    content+="</div>" +
                                    "</div>" +
                                "</div>" +
                            "</div>"+
                        "</div>";
        }
        return content;
    }
    function getGroupTooltip(row){
        return '<strong>'+row.model.data.name+'</strong>'+
            (row.model.from ? ('<div><strong>Start Date:</strong> '+ getShortDate(row.model.from)+'</div>'):'')+
            (row.model.to ? ('<div><strong>Duration:</strong> '+row.rangeToDays(row, 'D')+'</div>'):'');
    }
}

angular.module('user.calendar.topNav.service', [
    'calendar.Options.service',
    'calendar.Utils.service'
])
.factory('TopNavCalendarService', TopNavCalendarService);
TopNavCalendarService.$inject = ['GanttMoment','CPS', 'TodoColumnsConfigsService','CalendarUtilsService', 'SBFieldMethods'];
function TopNavCalendarService(GanttMoment ,CPS, TodoColumnsConfigsService, CalendarUtilsService, SBFieldMethods) {

    var MomentService = CPS.MomentService,
        SBStateService = CPS.SBStateService,
        PersistenceService = CPS.LCS.PersistenceService,
        today = GanttMoment.getLocalMoment(),
        startDate = GanttMoment.getStartOfDayMoment(today).add(-7, 'day'),
        endDate = GanttMoment.getEndOfDayMoment(today).add(21, 'day'),
        DefaultTodoCardColor = CalendarUtilsService.DefaultTodoCardColor,
        taskProps = initTasksCollections();

    var headers = {
        day: {
            headers: ['week', 'day'],
            headersScale: {week: 'week', day: 'day'},
            headersFormats: {
                week: function (column) {
                    var date = column.date;
                    return "<div><span class='month'>" + date.format('MMM') + "</span> <span class='week'>W" + date.format('w') + "</span></div>";
                },
                day: function (column) {
                    var width = column.width;
                    if (width < 20) {return null;}

                    var date = column.date, isToday = GanttMoment.isSameDate(date, today);
                    var header = "<span ";
                    if (width < 30) {
                        header += " class='font-small ";
                        if (isToday) {
                            header += 'current-date';
                        }
                        header += " '";
                    } else if (isToday) {
                        header += "class='current-date'";
                    }
                    header += ">";
                    if (width >= 20) {
                        header += "<span>" + date.format('dd') + "</span>";
                    }
                    header += " <span class='day'>" + date.format('D') + "</span>";
                    header += "</span>";
                    return header;
                },
            },
        },
        week: {
            headers: ['week', 'day'],
            headersScale: {week: 'week', day: 'day'},
            headersFormats: {
                week: function (column) {
                    var date = column.date;
                    return "<div><span class='month'>" + date.format('MMM') + "</span> <span class='week'>W" + date.format('w') + "</span></div>";
                },
                day: function (column) {
                    var width = column.width;
                    if (width < 20) {
                        return null;
                    }

                    var date = column.date,
                        isToday = GanttMoment.isSameDate(date, today);
                    var header = "<span ";
                    if (width < 30) {
                        header += " class='font-small ";
                        if (isToday) {
                            header += 'current-date';
                        }
                        header += " '";
                    } else if (isToday) {
                        header += "class='current-date'";
                    }
                    header += ">";
                    header += " <span class='day'>" + date.format('D') + "</span>";
                    header += "</span>";
                    return header;
                }
            }
        },
        month: {
            headers: ['month', 'week'],
            headersScale: {month: 'month', week: 'week'},
            headersFormats: {
                month: function (column) {
                    var date = column.date;
                    return "<div><span class='month'>" + date.format('MMM') + "</span></div>";
                },
                week: function (column) {
                    var width = column.width, date = column.date;
                    var header = "<span class='week " + (width < 35 ? 'font-small' : '') + "'>W" + date.format('w') + "</span> ";
                    if (width > 80) {
                        header += "<span class='weeks2'>•</span> " +
                            " <span class='day'>" + moment(date).startOf('week').format('D') + "</span>" +
                            "<span>-</span>" +
                            " <span class='day'>" + moment(date).endOf('week').format('D') + "</span>";
                    }
                    return header;
                }
            }
        },
        quarter: {
            headers: ['quarter', 'month'],
            headersScale: {quarter: 'quarter', month: 'month'},
            headersFormats: {
                quarter: function (column) {
                    var date = column.date, width = column.width;
                    return "<div><span class='week uppercase'> " + (width < 150 ? "Q" : "Quarter ") + date.format('Q') + "</span></div>";
                },
                month: function (column) {
                    var width = column.width, date = column.date;
                    return "<div " + (width < 55 ? "class='font-small'>" : "") + "<span class='uppercase'>" + date.format('MMM') + "</span> <span>" + (width < 20 ? '' : date.format(" ’YY")) + "</span></div>";
                },
            }
        },
        year: {
            headers: ['year', 'quarter'],
            headersScale: {year: 'year', quarter: 'quarter'},
            headersFormats: {
                year: function (column) {
                    var date = column.date;
                    return "<div><span class='month uppercase'>Year</span> <span class='week'>" + date.format('YYYY') + "</span></div>";
                },
                quarter: function (column) {
                    var width = column.width, date = column.date;
                    return "<div class='year2'><span class=' uppercase'>" + (width < 85 ? "Q" : "Quarter ") + date.format('Q') + "</span></div>";
                },
            }
        }
    };

    var timeframesShow = {
            Hidden: 'hidden',
            Visible: 'visible',
            Cropped: 'cropped',
        },
        currentDateDisplay = {None: 'none', Line: 'line', Column: 'column'},
        currentDateDisplayOptions = getOptions(currentDateDisplay),
        timeframesOptions = getOptions(timeframesShow),
        zoomTypes = ZoomTypesOptions,
        defaultZoom = 1.5,
        displayTypes = {Toggle: 0, Drp: 1, CkDrp: 2},

        Zooms = ZoomsDropdown,
        ScaleOptions = [
            {value: 'day'},
            {value: 'week'},
            {value: 'month'},
            {value: 'quarter'},
            {value: 'year'}
        ],
        DisplayOptions = [
            /* {
                 _id: 7,
                 // tooltip: "Working timeframes.",
                 name: "Working Days",
                 options: timeframesOptions,
                 prop: 'timeFramesWorkingMode',
                 type: displayTypes.Drp,
             },*/
            {
                _id: 8,
                //   tooltip: "Show non-working timeframes.",
                name: "Non-Working Days",
                options: [
                    {value: 'visible', name: 'Grayed-Out'},
                    {value: 'hidden', name: 'Standard'},
                    //{value: 'cropped', name:'Hidden'},
                ],
                prop: 'timeFramesNonWorkingMode',
                type: displayTypes.Drp
            },
            {
                _id: 1,
                tooltip: "Link row events together in a particular order.",
                name: "Enable Dependencies",
                options: [{value: true, name: ''}, {value: false, name: ''}],
                type: displayTypes.Toggle,
                prop: 'dependencies',
                action: 'toggleDependencies'
            },
            /*{
                _id: 2, tooltip: "Highlight any row events that overlap.", name: "Conflicts", icon: 'conflicts',
                options: [{value: true, name: ''}, {value: false, name: ''}],
                type: displayTypes.Toggle
            },*/

            /*
                    {
                        _id: 3, tooltip: "Adjust the scale of the calendar.", name: "Grid Scale", icon: 'scale',
                        options: [{value: 'day'},
                            {value: 'week'},
                            {value: '2 weeks'},
                            {value: 'month'},
                            {value: '3 months'},
                            {value: 'quarter'},
                            {value: '6 months'},
                            {value: 'year'}],
                        type: displayTypes.Drp,
                    prop: 'scale'
            },*/
            /*   {
                   _id: 5,
                   tooltip: "Expand the width of the calendar based on the width of the column.",
                   name: "Auto Width",
                   options: [{value: true, name: ''}, {value: false, name: ''}],
                  type: displayTypes.Toggle,
                   prop: 'autoWidth'
               },
   */
            /*
                        {
                            _id: 9,
                        //    tooltip: "Week starts on Sunday.",
                            name: "Start Week On Sunday",
                            options: [{value: true, name: ''}, {value: false, name: ''}],
                            type: displayTypes.Toggle,
                            prop: 'startWeekOnSunday'
                        },
              */       /*   {
                _id: 6,
                name: "Hide Events Out Of Range",
                //tooltip: "Hide events out of range.",
                options: [{value: true, name: ''}, {value: false, name: ''}],
                type: displayTypes.Toggle,
                prop: 'hideTasksOutOfRange'
            },
          */ /* {
                _id: 11,
             //   tooltip: "Show rows without tasks.",
                name: "Hide Rows Without Events",
                options: [{value: true, name: ''}, {value: false, name: ''}],
                type: displayTypes.Toggle,
                prop: 'hideRowsWithoutTasks'
            },
           *//* {
                _id: 12,
          //      tooltip: "Show task names.",
                name: "Hide Event Names",
                options: [{value: true, name: ''}, {value: false, name: ''}],
                type: displayTypes.Toggle,
                prop: 'hideTasksNames'
            },*/
            /* {
                _id: 13,
                //tooltip: "Show task names.",
                name: "Current Date Display",
                options: currentDateDisplayOptions,
                type: displayTypes.Drp,
                prop: 'currentDate'
            }, {
                _id: 14,
                tooltip: "Show row borders.",
                name: "Display row border",
                options: [{value: true, name: ''}, {value: false, name: ''}],
                type: displayTypes.Toggle,
                prop: 'showRowBorders'
            },*/
        ],
          moreDaysFilter = [
            {
                id: 1, items: [
                    {id: 1, name: 'All Incomplete Tasks'},//stats.tasks > 0 && stats.tasks > stats.tasksCompleted
                    {id: 2, name: 'Incomplete Task Due Today'}, //dueDate.value ==  today &&  (stats.tasks > 0 && stats.tasks > stats.tasksCompleted)
                    {id: 3, name: 'Overdue Tasks'},    //dueDate.value < today
                    {id: 4, name: 'Events Without Tasks'} //stats.tasks == 0
                ]
            }, {
                id: 2, items: [
                    {id: 5, name: 'Events Starting Today'},//startDate.value == today
                    {id: 6, name: 'Events Starting Tomorrow'},//startDate.value == today.add(1,'day')
                    {id: 7, name: 'Events Starting Within a Week'},  //startDate.value == today.add(7,'day')
                    {id: 8, name: 'Events Starting Within a Month'}, //startDate.value == today.add(28,'day')
                ]
            }, {
                id: 3, items: [
                    {id: 9, name: 'Events Ending Today'}, //dueDate.value == today
                    {id: 10, name: 'Events Ending Tomorrow'}, //dueDate.value == today.add(1,'day')
                    {id: 11, name: 'Events Ending Within a Week'},  //dueDate.value <=  today.add(7,'day')
                    {id: 12, name: 'Events Ending Within a Month'},  //dueDate.value <=  today.add(28,'day')
                ]
            }
        ],

          initTeam = [], // all team members objects
        initFilterDate = false,

      localStorageProps = ['dependencies', 'workingDays', 'timeFramesNonWorkingMode', 'scale'],
      methods = {
          updateHeaders: updateHeaders,
          getIcons: getIcons,
          currentDate: currentDateDisplay.Line,  //Display today as colum
          ScaleOptions: ScaleOptions,
          hideRowsWithoutTasks: false,
          hideTasksNames: false,
          workingDays: [1, 2, 3, 4, 5, 6],
          WeekDays: [],
          startWeekOnSunday: false,
          getColumnWidth: getColumnWidth,
          MoreDaysFilter: moreDaysFilter,
          ZoomTypes: zoomTypes,
          colors: [],
          team: [],
          initStatuses: [],
          statuses: [],
          filter: {
              name: undefined,
              taskTeam: undefined,
              taskColors: undefined,
              taskActive: true,
              taskProgress: undefined,
              taskStatus: undefined
          },
          dependencies: true,
          conflicts: true,
          scale: 'day',
          collapse: false,
          template: null,
          timestampTemplate: null,
          zoom: defaultZoom,
          autoWidth: true,
          hideTasksOutOfRange: true, //print only tasks that are visible in the range
          tasksCount: 0,
          fromDate: null,
          toDate: null,
          dateRangeChanged: null,
          changeZoom: changeZoom,
          timeFramesWorkingMode: timeframesShow.Hidden,
          timeFramesNonWorkingMode: timeframesShow.Visible,
          Zooms: Zooms,
          DisplayOptions: DisplayOptions,
          filterTasks: filterTasks,
          setInitTeam: function (val) {
              initTeam = val;
          },
          setInitStatuses: setInitStatuses,
          setInitFilterDate: function setInitFilterDate(val) {
              initFilterDate = val;
          },
          getInitFilterDate: function getInitFilterDate() {
              return initFilterDate;
          },
          initOptions: initOptions,

          saveTemplate: saveTemplate,
          getCalendarTemplate: getCalendarTemplate,
          resetCalendarTemplate: resetCalendarTemplate,

          setTasksCollections: setTasksCollections,
          getFocusDay: getFocusDay,

          setViewType: setViewType,
          isViewType: isViewType,
          toggleCollapse: toggleCollapse,
          setFromToDate: setFromToDate,
          setSearch: setSearch,
          getSearch: getSearch,

          getTeam: getTeam,
          getTaskTeam: getTaskTeam,
          clearTaskTeam: clearTaskTeam,
          hasTaskTeam: hasTaskTeam,
          isTaskTeam: isTaskTeam,
          checkTaskTeam: checkTaskTeam,

          getColors: getColors,
          getTaskColors: getTaskColors,
          clearTaskColors: clearTaskColors,
          hasTaskColors: hasTaskColors,
          isTaskColor: isTaskColor,
          checkTaskColor: checkTaskColor,

          getActive: getActive,
          getTaskActive: getTaskActive,
          clearTaskActive: clearTaskActive,
          hasTaskActive: hasTaskActive,
          isTaskActive: isTaskActive,
          checkTaskActive: checkTaskActive,

          getStatuses: getStatuses,
          getTaskStatus: getTaskStatus,
          clearTaskStatus: clearTaskStatus,
          hasTaskStatus: hasTaskStatus,
          isTaskStatus: isTaskStatus,
          checkTaskStatus: checkTaskStatus,

          setTaskProgress: setTaskProgress,
          getTaskProgress: getTaskProgress,
          clearTaskProgress: clearTaskProgress,
          hasTaskProgress: hasTaskProgress,
          isTaskProgress: isTaskProgress,
          checkTaskProgress: checkTaskProgress,

          hasTaskFilters: hasTaskFilters,
          clearTaskFilters: clearTaskFilters,

          changeWorkingDay: changeWorkingDay,
          isWorkingDay: isWorkingDay,

          updateHeadersParams: updateHeadersParams,
          isNonWorkingDate: isNonWorkingDate,
          setScaleBasedOnTasks: setScaleBasedOnTasks
      };

    setLocale();

    methods.workingDaysChanged = methods.workingDays.join('|');

    return methods;

    function setLocale() { //val = 0 or 1. 1 for starts monday
        var val = methods.startWeekOnSunday ? 0 : 1;
        moment.locale('en', {
            week: {
                dow: val, // Monday is the first day of the week.
                doy: 4 // The week that contains Jan 4th is the first week of the year.
            }
        });

        methods.WeekDays = GanttMoment.getWeekDays(val);
    }

    function getIcons() {
        return SBFieldMethods.Icons.map(function (item) {
            return {id: item};
        });
    }

    function loadFromLocalStorage() {
        var settings = PersistenceService.getProductionCalendarSettings(CalendarUtilsService.getCompanyId());
        if (settings) {
            _.each(localStorageProps, function (prop) {
                var v = settings[prop];
                if (v !== undefined) {
                    methods[prop] = v;
                    if(prop === 'scale') {
                        methods.scaleLoadedFromStorage = true;
                   }
                }
            })
        }
    }

    function setLocalStorageVal(prop, val) {
        var companyId = CalendarUtilsService.getCompanyId();
        var settings = PersistenceService.getProductionCalendarSettings(companyId);
        if (!settings) {
            settings = {};
        }
        settings[prop] = val;
        PersistenceService.setProductionCalendarSettings(companyId, settings);
    }

    function setInitStatuses(companyId, productId) {
        TodoColumnsConfigsService.getTodoColumnsForProductAsync(companyId, productId, function (todoColumns) {
            methods.initStatuses = todoColumns;
        });
    }

    function getCalendarTemplate(productId) {
        return methods.template;
    }

    function resetCalendarTemplate() {
        methods.template = null;
        methods.timestampTemplate = null;
    }

    function setViewType(id, selected) {
        if(id && typeof(id) === 'string'){
            id = parseInt(id, 10);
        }
        switch (id) {
            case 1:
                var prop = 'dependencies',
                    val = methods[prop] ? false : true;
                set(prop, val);
                return val;
            case 3:
                set('scale', selected);
                break;
            case 8:
                set('timeFramesNonWorkingMode', selected);
                break;

            case 2:
                methods.conflicts = methods.conflicts ? false : true;
                break;

            case 4:
                var prop = 'collapse';
                var val = methods[prop] ? false : true;
                methods[prop] = val;
                break;
            case 5:
                methods.autoWidth = methods.autoWidth ? false : true;
                break;
            case 6:
                methods.hideTasksOutOfRange = methods.hideTasksOutOfRange ? false : true;
                break;
            case 7:
                var prop = 'timeFramesWorkingMode';
                methods[prop] = selected;
                break;

            case 9:
                methods.startWeekOnSunday = methods.startWeekOnSunday ? false : true;
                break;
            case 11:
                methods.hideRowsWithoutTasks = methods.hideRowsWithoutTasks ? false : true;
                break;
            case 12:
                methods.hideTasksNames = methods.hideTasksNames ? false : true;
                break;
            case 13:
                methods.currentDate = selected;
                break;
            case 14:
                methods.showRowBorders = methods.showRowBorders ? false : true;
                break;
        }

        function set(prop, val) {
            methods[prop] = val;
            setLocalStorageVal(prop, val);
            setSearchParams();
        }
    }

    function isViewType(id) {
        switch (id) {
            case 1:
                return methods.dependencies ? true : false;
            case 2:
                return methods.conflicts ? true : false;
            case 4:
                return methods.collapse ? true : false;
            case 5:
                return methods.autoWidth ? true : false;
            case 6:
                return methods.hideTasksOutOfRange ? true : false;
            case 7:
                return methods.timeFramesWorkingMode === id;
            case 8:
                return methods.timeFramesNonWorkingMode === id;

            case 9:
                return methods.startWeekOnSunday ? true : false;
            case 11:
                return methods.hideRowsWithoutTasks ? true : false;
            case 12:
                return methods.hideTasksNames ? true : false;
            case 13:
                return methods.currentDate === id;
            case 14:
                return methods.showRowBorders ? true : false;
        }
        return false;
    }

    function toggleCollapse() {
        methods.collapse = !methods.collapse;
        setLocalStorageVal('collapse', methods.collapse);
    }

    function initTasksCollections() {
        return {
            tasksCount: 0,
            colors: [],
            team: [],
            statuses: [],
            fromDate: null,
            toDate: null
        };
    }

    function getFocusDay() {
        var copytoday = angular.copy(today);
        if (!methods.tasksCount) {
            return copytoday;
        }
        else {
            if (methods.fromDate <= today && today <= methods.toDate) {
                return copytoday;
            }
            else {
                return angular.copy(methods.fromDate);
            }
        }
    }

    function setTasksCollections(tasks) {
        var tc = initTasksCollections();
        var m = tasks && tasks.length > 0 ? tasks.length : 0;
        if (m) {
            for (var j = 0; j < m; j++) { // all cards
                var card = tasks[j];

                if(card) {
                    var c = card.color;
                    if (c && tc.colors.indexOf(c) === -1) {
                        tc.colors.push(c);
                    }

                    var te = card.teamIds, s = card.todoColumnId, tl = te ? te.length : 0;
                    if (s && tc.statuses.indexOf(s) === -1) {
                        tc.statuses.push(s);
                    }
                    if (tl) {
                        for (var k = 0; k < tl; k++) {
                            var x = te[k];
                            if (x && tc.team.indexOf(x) === -1) {
                                tc.team.push(x);
                            }
                        }
                    }
                    tc.tasksCount++;

                    var fromDate = card.startDate && card.startDate.value ? GanttMoment.getStartOfDayMoment(card.startDate.value) : null;
                    if (fromDate && (!tc.fromDate || tc.fromDate > fromDate)) {
                        tc.fromDate = fromDate;
                    }

                    var toDate = card.dueDate && card.dueDate.value ? GanttMoment.getEndOfDayMoment(card.dueDate.value) : null;
                    if (toDate && (!tc.toDate || tc.toDate < toDate)) {
                        tc.toDate = toDate;
                    }
                }
            }
        } else {
            tc.fromDate = GanttMoment.getStartOfDayMoment(today);
            tc.toDate = GanttMoment.getEndOfDayMoment(today);
        }

        taskProps = tc;
        methods.fromDate = taskProps.fromDate;
        methods.toDate = taskProps.toDate;
        methods.tasksCount = tc.tasksCount;
    }

    function setScaleBasedOnTasks() {
        if (!methods.scaleLoadedFromStorage && methods.fromDate && methods.toDate) {
            var ms = GanttMoment.getDuration(methods.fromDate, methods.toDate);
            if (ms < 2419200000) {
                methods.scale = 'day';
            }//4weeks
            else if (ms < 3628800000) {
                methods.scale = 'week';
            } //< 6weeks
            else if (ms < 7257600000) {
                methods.scale = 'month';
            }//< 3mo
            else if (ms < 31556926000) {
                methods.scale = 'quarter';
            } //< 1yr
            else {
                methods.scale = 'year';
            }
            methods = updateHeaders(methods);

        }
        return methods.scale;
    }

    function setCustomProp(prop, val, isNotFilter, dontUpdateSearchParams) {
        if (isNotFilter) {
            if (methods[prop] !== val) {
                methods[prop] = val;
                if (!dontUpdateSearchParams) {
                    setSearchParams();
                }
            }
        } else {
            if (methods.filter[prop] !== val) {
                methods.filter[prop] = val;
                if (!dontUpdateSearchParams) {
                    setSearchParams();
                }
            }
        }
    }

    function setFromToDate(from, to) {
        if (methods.fromDate !== from && methods.toDate !== to) {
            methods.dateRangeChanged = new Date().getTime();
        }
        methods.fromDate = from;
        methods.toDate = to;
    }

    function setSearch(val) {
        setCustomProp('name', val);
    }

    function getSearch() {
        return methods.filter.name;
    }

    function getTeam() {
        return getListItemsById(taskProps.team, initTeam, '_id');
    }

    function getTaskTeam() {
        return methods.filter.taskTeam;
    }

    function clearTaskTeam(dontUpdateSearchParams) {
        setCustomProp('taskTeam', null, false, dontUpdateSearchParams);
    }

    function hasTaskTeam() {
        return hasTaskFilter(methods.filter.taskTeam);
    }

    function isTaskTeam(id) {
        return isTaskFilter(methods.filter.taskTeam, id);
    }

    function checkTaskTeam(id) {
        updateTaskFilter('taskTeam', id);
    }

    function getColors() {
        return getListItems(SBFieldMethods.Colors, taskProps.colors, 'id', true);
    }

    function getTaskColors() {
        return methods.filter.taskColors;
    }

    function clearTaskColors(dontUpdateSearchParams) {
        setCustomProp('taskColors', null, false, dontUpdateSearchParams);
    }

    function hasTaskColors() {
        return hasTaskFilter(methods.filter.taskColors);
    }

    function isTaskColor(id) {
        return isTaskFilter(methods.filter.taskColors, id);
    }

    function checkTaskColor(id) {
        updateTaskFilter('taskColors', id);
    }
///

    function getActive() {
        return getListItems([
            {value: true, text: 'Active'},
            {value: false, text: 'Archived'}
        ], taskProps.colors, 'id', true);
    }

    function getTaskActive() {
        return methods.filter.taskActive;
    }

    function clearTaskActive(dontUpdateSearchParams) {
        setCustomProp('taskActive', null, false, dontUpdateSearchParams);
    }

    function hasTaskActive() {
        return hasTaskFilter(methods.filter.taskActive);
    }

    function isTaskActive(id) {
        return isTaskFilter(methods.filter.taskActive, id);
    }

    function checkTaskActive(id) {
        updateTaskFilter('taskActive', id);
    }
    ///
    function getStatuses() {
        return getListItems(methods.initStatuses, taskProps.statuses, '_id'); // get statuses that have tasks
    }

    function getTaskStatus() {
        return methods.filter.taskStatus;
    }

    function clearTaskStatus(dontUpdateSearchParams) {
        setCustomProp('taskStatus', null, false, dontUpdateSearchParams);
    }

    function hasTaskStatus() {
        return hasTaskFilter(methods.filter.taskStatus);
    }

    function isTaskStatus(id) {
        return isTaskFilter(methods.filter.taskStatus, id);
    }

    function checkTaskStatus(id) {
        updateTaskFilter('taskStatus', id);
    }

    function setTaskProgress(val) {
        setCustomProp('taskProgress', val);
    }

    function getTaskProgress() {
        return methods.filter.taskProgress;
    }

    function clearTaskProgress(dontUpdateSearchParams) {
        setCustomProp('taskProgress', null, false, dontUpdateSearchParams);
    }

    function hasTaskProgress() {
        return methods.filter.taskProgress != null;
    }

    function isTaskProgress(id) {
        return methods.filter.taskProgress === id;
    }

    function checkTaskProgress(id) {
        updateTaskFilter('taskProgress', id, true);
    }

    function saveTemplate(productId) {
        methods.template = productId;
        methods.timestampTemplate = MomentService.utc(new Date()).unix();
    }

    function getColumnWidth() {
        var scale = methods.scale,
            zoom = methods.zoom,
            autoWidth = methods.autoWidth;
        if (scale) {
            if (!autoWidth && canAutoWidth(scale)) {
                return undefined;
            }
            if (scale.match(/.*?week.*?/)) {
                return 150 * zoom;
            }
            if (scale.match(/.*?month.*?/)) {
                return 300 * zoom;
            }
            if (scale.match(/.*?quarter.*?/)) {
                return 500 * zoom;
            }
            if (scale.match(/.*?year.*?/)) {
                return 800 * zoom;
            }
        }
        return 40 * zoom;
    }

    function canAutoWidth(scale) {
        return !(scale.match(/.*?hour.*?/) || scale.match(/.*?minute.*?/));
    }

    function initOptions(options) {

        loadFromLocalStorage();
        loadSearchParams();

        //options.moveThreshold = 0;
        options.taskOutOfRange = !methods.hideTasksOutOfRange;

        options.timeFramesWorkingMode = methods.timeFramesWorkingMode;
        options.timeFramesNonWorkingMode = methods.timeFramesNonWorkingMode;
        options.showTaskNames = methods.showTaskNames;
        options.today = today;
        options.currentDateValue = new Date(today.year(), today.month(), today.date(), 0, 0, 0, 0);

        options.sortable = methods.canEdit;
        options.readOnly = !methods.canEdit;
        options.dependencies = methods.dependencies;
        options.conflicts = methods.dependencies;
        options.currentDate = methods.currentDate;
        options.showRowBorders = methods.showRowBorders;
        options.workingDays = methods.workingDays;
        options.scale = methods.scale;

        options.canDraw = canDraw;
        options.dateFrames.weekend.evaluator = isNonWorkingDate;

        var h = headers[options.scale];
        for(var prop in h){
            options[prop] = h[prop];
        }
        return _.extend({}, options);
    }

    function getOptions(props) {
        var list = [];
        for (var prop in props) {
            list.push({value: props[prop]});
        }
        return list;
    }

    function getListItems(l1, l2, prop, uppercase) {
        var c = [];
        _.each(l1, function(d){
            if (d && _.find(l2, function (v){return uppercase ? (v && v.toUpperCase() === d[prop]) : (v === d[prop]);})) {
                c.push(d);
            }
        });
        return c;
    }

    function getListItemsById(l2, l1, prop) {
        var c = [];
        _.each(l1, function(d){
            if (d && _.find(l2, function (v){return v === d[prop];})) {
                c.push(d);
            }
        });
        return c;
    }

    function hasTaskFilter(l) {
        return l && l.length > 0;
    }

    function isTaskFilter(l, id) {
        return l && l.length > 0 && l.indexOf(id) !== -1;
    }

    function updateTaskFilter(prop, id, isNotList) {
        var l = methods.filter[prop], newV;
        if (isNotList) {
            newV = methods.filter[prop] === id ? null : id;
        }
        else {
            if (!l) {
                l = [];
            }
            var index = l.indexOf(id);
            if (index === -1) {
                l.push(id);
            }
            else {
                l.splice(index, 1);
            }
            if (l.length === 0) {
                l = null;
            }
            newV = l;
        }

        methods.filter[prop] = newV;
        setSearchParams();
    }

    function changeZoom(type) {
        var current = methods.zoom,
            changed = true;
        switch (parseInt(type, 10)) {
            case zoomTypes.Reset:
                if(current !== defaultZoom) {
                    current = defaultZoom;
                } else {
                    changed = false;
                }
                break;
            case zoomTypes.In:
                if (current < 5) {
                    current += 0.1;
                } else {
                    changed = false;
                }
                break;
            case zoomTypes.Out:
                if (current > 0.1) {
                    current -= 0.1;
                } else {
                    changed = false;
                }
                break;
        }
        if (changed) {
            methods.zoom = Math.round(current * 10) / 10;
        }
    }

    function filterTasks(dbTask) {
        var filter = methods.filter;
        return isNameFilter(filter, dbTask) &&
            isTeamFilter(filter, dbTask) &&
            isActiveFilter(filter, dbTask) &&
            isColorFilter(filter, dbTask) &&
            isStatusFilter(filter, dbTask) &&
            isProgressFilter(filter, dbTask);
    }

    function isNameFilter(filter, data) {
        var val = filter ? filter.name : null;
        if (!val) {
            return true;
        }
        return data.name.toLowerCase().indexOf(val.toLowerCase()) >= 0;
    }

    function isTeamFilter(filter, dbTask) {
        var team = filter.taskTeam,
            tl = team && team.length > 0 ? team.length : 0;
        if (tl === 0) {
            return true;
        }// no filters

        var dbT = dbTask.teamIds, dbL = dbT ? dbT.length : 0;
        if (dbL > 0) {//has assigned teammembers
            for (var i = 0; i < tl; i++) {
                if (team.indexOf(dbT[i]) !== -1) {
                    return true;
                }
            }
        } else { //has no assigned team
            if (team.indexOf(0) !== -1) {
                return true;
            }//has unassigned filter
        }
        return false;
    }

    function isColorFilter(filter, dbTask) {
        var colors = filter.taskColors, cl = colors && colors.length > 0 ? colors.length : 0;
        return cl === 0 || cl > 0 && (
            dbTask.color && colors.indexOf(dbTask.color) !== -1 ||  //task has color that is in the filters
            (!dbTask.color || dbTask.color === DefaultTodoCardColor) && colors.indexOf(0) !== -1 //task has no color and default color is in the filters
        );
    }

    function isStatusFilter(filter, dbTask) {
        var statuses = filter.taskStatus, sl = statuses && statuses.length > 0 ? statuses.length : 0;
        return sl === 0 || sl > 0 && statuses.indexOf(dbTask.todoColumnId) !== -1;
    }

    function isActiveFilter(filter, dbTask) {
        var colors = filter.taskColors, cl = colors && colors.length > 0 ? colors.length : 0;
        return cl === 0 || cl > 0 && (
            dbTask.color && colors.indexOf(dbTask.color) !== -1 ||  //task has color that is in the filters
            (!dbTask.color || dbTask.color === DefaultTodoCardColor) && colors.indexOf(0) !== -1 //task has no color and default color is in the filters
        );
    }

    function addDays(days) {
        return GanttMoment.getEndOfDayMoment(angular.copy(today).add(days, 'day'));
    }

    function dueIn(dueDate, days) {
        return dueDate >= today && dueDate <= addDays(days);

    }

    function startsIn(startDate, days) {
        return startDate >= today && startDate <= addDays(days);
    }

    function isProgressFilter(filter, dbTask) {
        var progress = filter.taskProgress;
        if (!progress) {
            return true;
        }
        var noTasks = !dbTask.stats || dbTask.stats && !dbTask.stats.tasks,
            isCompleted = !dbTask.stats || dbTask.stats && (dbTask.stats.tasks === dbTask.stats.tasksCompleted),
            dueDate, startDate;
        if (dbTask.dueDate) {
            dueDate = dbTask.dueDate.value;
        }
        if (dbTask.startDate) {
            startDate = dbTask.startDate.value;
        }
        switch (progress) {
            case 1:
                return !isCompleted; //All Incomplete Tasks
            case 2:
                return GanttMoment.isSameDate(dueDate, today) && !isCompleted; //Incomplete Task Due Today
            case 3:
                return !GanttMoment.isSameDate(dueDate, today) && dueDate < today; //Overdue  Tasks
            case 4:
                return noTasks; //Events Without Tasks

            case 5:
                return GanttMoment.isSameDate(startDate, today); //Events Starting Today
            case 6:
                return startsIn(startDate, 1); //Events Starting Tomorrow
            case 7:
                return startsIn(startDate, 7); //Starts within a week
            case 8:
                return startsIn(startDate, 28); //Starts within a Month

            case 9:
                return GanttMoment.isSameDate(dueDate, today); //Events Ending Today
            case 10:
                return dueIn(dueDate, 1); //Events Ending Tomorrow
            case 11:
                return dueIn(dueDate, 7); //Events Ending Within a Week
            case 12:
                return dueIn(dueDate, 28); //Events Ending Within a Month
        }

        return false;
    }

    function hasTaskFilters() {
        return methods.filter.name || hasTaskProgress() || hasTaskTeam() || hasTaskColors() || hasTaskActive() || hasTaskStatus();
    }

    function clearTaskFilters() {
        clearTaskProgress(true);
        clearTaskTeam(true);
        clearTaskColors(true);
        clearTaskStatus(true);
        setCustomProp('name', null);
    }

    function changeWorkingDay(id) {
        var prop = 'workingDays',
            l = methods[prop] ? angular.copy(methods[prop]) : [],
            index = l.indexOf(id);
        index === -1 ? l.push(id) : l.splice(index, 1);


        methods[prop] = l;
        setLocalStorageVal(prop, l);
        setSearchParams();

        methods.workingDaysChanged = l.join('|');
    }

    function isWorkingDay(id) {
        return methods.workingDays && methods.workingDays.indexOf(id) !== -1;
    }

    function isNonWorkingDate(date) {
        var workingDays = methods.workingDays;
        return !workingDays || workingDays && workingDays.indexOf(date.isoWeekday()) === -1; //is not in the working days
    }

    function canDraw(event) {
        var options = methods.options;
        return options.canDrawTasks && options.canEdit && (event.button === 0 || event.button === 1);

        // var isLeftMouseButton = event.button === 0 || event.button === 1;
        // var options = methods.options;
        // return options.draw && !options.readOnly && isLeftMouseButton;
    }

    function updateHeadersParams() {
        setSearchParams();
        return headers[methods.scale];
    }

    function updateHeaders(options){
        var h = headers[options.scale];
        for(var prop in h){
            options[prop] = h[prop];
        }
        return options;
    }

    function setSearchParams() {
        var search = {}, filter = methods.filter, hasFilter;
        set('name', 'n', true);
        set('taskTeam', 't', true, true);
        set('taskColors', 'c', true, true);
        set('taskActive', 'a');
        set('taskProgress', 'p', true);
        set('taskStatus', 's', true, true);
        set('scale', 'sc');
        set('dependencies', 'd');
        set('workingDays', 'wd');
        set('timeFramesNonWorkingMode', 'tf');

        SBStateService.setSearchFilter(hasFilter ? search : '', 'filter');

        function set(prop, sprop, isFilter, isList) {
            var t = isFilter ? filter : methods;
            var val = t ? t[prop] : null;
            if (val && (!isList || isList && val.length > 0)) {
                search[sprop] = val;
                hasFilter = true;
            }
        }
    }

    function loadSearchParams() {
        var search = SBStateService.getSearchFilter('filter');
        if (search) {
            //BlocksSetupService.toggleComments(false);
            //name: undefined, taskTeam: undefined, taskColors: undefined, taskProgress: undefined,taskStatus:undefined
            //scale, 'dependencies', 'workingDays', 'timeFramesNonWorkingMode'
            //n,t,c,p,s, sc, d, wd, tf
            //fr,to,   ?? todo

            if (search) {
                set('name', 'n', true);
                set('taskTeam', 't', true);
                set('taskColors', 'c', true);
                set('taskActive', 'a', true);
                set('taskProgress', 'p', true);
                set('taskStatus', 's', true);

                set('scale', 'sc');
                set('dependencies', 'd');
                set('workingDays', 'wd');
                set('timeFramesNonWorkingMode', 'tf');
            }
        }

        function set(prop, sprop, isFilter) {
            if (search[sprop]) {
                if(isFilter && !methods.filter){methods.filter = {};}
                (isFilter ? methods.filter : methods)[prop] = search[sprop];
            }
        }
    }
}

angular.module('calendar.Utils.service', [
    'apiServices.Calendars',
    'apiServices.CalendarTemplates',
    'apiServices.CalendarMilestones',
    'apiServices.TodoCards'
])
    .service('CalendarUtilsService', CalendarUtilsService);
CalendarUtilsService.$inject = ['$filter', 'CalendarTemplatesService', 'CalendarMilestonesService', 'TodoCardsService', 'CalendarsService'];
function CalendarUtilsService( $filter, CalendarTemplatesService, CalendarMilestonesService, TodoCardsService, CalendarsService) {
    var isDebug = false,
        shortDateFormat = "ddd, MMM D, YYYY, h:mma",
        shortDateFormatDebug = "ddd, MMM D, YYYY, HH:mm:ss SSS",
        EventTypes = {Add: 1, Edit: 2, Remove: 3, Duplicate: 4, Move: 5},
        RowTypes = {Product: 1, Calendar: 2, Group: 3, Milestone: 4, Event: 5, Template: 6},
        companyId,
        methods = {
            TodoCardsService: TodoCardsService,
            DefaultTodoCardColor: DefaultTodoCardColor,
            getShortDate: getShortDate,
            getShortDateFormat: getShortDateFormat,
            getDebugId: getDebugId,
            setDebugId: setDebugId,
            getCompanyId: getCompanyId,
            setCompanyId: setCompanyId,
            getTasksOutOfRange: getTasksOutOfRange,
            getModelService: getModelService,
            getElemType: getElemType,
            getItemTitle: getItemTitle,
            getEventTypes: getEventTypes,
            getRowTypes: getRowTypes,
            convertResource: convertResource,
            existsItemInList: existsItemInList,
            getTypeName: getTypeName,
            getRowItemClasses: getRowItemClasses,
            sortItems: sortItems,
            init: init
        };

    return methods;

    function init(companyId, dateFormat, isDebug) {
        if (!dateFormat) {
            setShortDateFormat(dateFormat);
        }
        setCompanyId(companyId);
        if (isDebug) {
            setDebugId(isDebug);
        }
    }

    function getShortDateFormat() {
        return shortDateFormat;
    }

    function setDebugId(val) {
        isDebug = val;
    }

    function getDebugId() {
        return isDebug;
    }

    function getEventTypes() {
        return EventTypes;
    }

    function getRowTypes() {
        return RowTypes;
    }

    function getModelService(type) {
        switch (type) {
            case RowTypes.Calendar:
                return CalendarsService;
            case RowTypes.Group:
            case RowTypes.Milestone:
                return CalendarMilestonesService;
            case RowTypes.Event:
                return TodoCardsService;
            case RowTypes.Template:
                return CalendarTemplatesService;
        }
    }

    function getElemType(type) {
        switch (type) {
            case RowTypes.Product:
                return 'PRODUCT';
            case RowTypes.Calendar:
                return 'CALENDAR';
            case RowTypes.Group:
            case RowTypes.Milestone:
                return 'CALENDARMILESTONE';
            case RowTypes.Event:
                return 'TASKCARD';
            case RowTypes.Template:
                return 'CALENDARTEMPLATE';
        }
    }

    function getItemTitle(type) {
        switch (type) {
            case RowTypes.Product:
                return 'Product';
            case RowTypes.Calendar:
                return 'Calendar';
            case RowTypes.Group:
                return 'Group';
            case RowTypes.Milestone:
                return 'Row';
            case RowTypes.Event:
                return 'Task Card';
            case RowTypes.Template:
                return 'Calendar Template';
        }
    }

    function convertResource(item, type) {
        if (!item) {
            return null;
        }
        var convert = typeof (item.getType) !== 'function';
        if (!convert || type === RowTypes.Product) {
            return item;
        }
        var service = getModelService(type);
        return service ? service.convertResource(item) : item;
    }

    function getTasksOutOfRange(val) {
        return val ? 'expand' : 'truncate';
    }

    function getCompanyId() {
        return companyId;
    }

    function setCompanyId(val) {
        companyId = val;
    }

    function setShortDateFormat(val) {
        shortDateFormat = val;
    }

    function getShortDate(date, format) {
        // return $filter('amDateFormat')(date, shortDateFormat);
        var f = isDebug ? shortDateFormatDebug : (format ? format : shortDateFormat);
        return $filter('amDateFormat')(date, f);
    }

    function existsItemInList(data, expression) {
        var exists = _.filter(data, expression);
        return exists && exists.length > 0;
    }

    function getTypeName(type) {
        switch (type) {
            case RowTypes.Product:
                return 'Product';
            case RowTypes.Group:
                return 'Group';
            case RowTypes.Milestone:
                return 'Row';
            case RowTypes.Event:
                return 'Event';
        }
        return null;
    }

    function getRowItemClasses(type, parentId, isTemp) {
        return 'gantt-row-' + getTypeName(type).toLowerCase() + ' tooltip-bigger clearfix ' +
            (type === RowTypes.Milestone && parentId ? 'with-parent' : '') + (isTemp ? (' temporary ' + (isDebug ? ' debug ' : '')) : '');
    }

    function sortItems(list) {
        return list.sort(function (o1, o2) {
            return o1.order - o2.order;
        });
    }
}

