angular.module('product.shots.tagShots.controller.service', [
    'product.shots.sceneShotsTagging.component',
    'ctrl.PopupsCtrl.generalItemEdit.service'
]) 
.service('TagShotsCtrlService', TagShotsCtrlService);

TagShotsCtrlService.$inject = ['GeneralItemEditCtrlService'];
function TagShotsCtrlService(GeneralItemEditCtrlService) {
    return function($ctrl, $element, isPopup){
        console.log('TagShotsCtrlService');
        $ctrl.minFontSize = 15;
        $ctrl.maxFontSize = 15;
        $ctrl.fixedPadding = true;

        $ctrl.viewAction = 'Preview Scene';
        $ctrl.viewIcon = 'sides';
        $ctrl.editIcon = 'pencil';
        $ctrl.hideLock = true;

        $ctrl.preInitGeneral = preInitGeneral;
        $ctrl.getBody = getBody;

        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, isPopup);

        return $ctrl;
        function preInitGeneral() {
            $ctrl.origItem = _.clone($ctrl.item);

            if (!$ctrl.extraParam) {
                $ctrl.extraParam = {};
            }

            if ($ctrl.extraParam.scriptLoadingService) {
                $ctrl.scriptLoadingService = $ctrl.extraParam.scriptLoadingService;
            }

            $ctrl.Settings = $ctrl.scriptLoadingService.preloadSettings() || {};
            $ctrl.canEdit = $ctrl.extraParam.canEdit === true;
            $ctrl.isEditMode = $ctrl.canEdit && $ctrl.extraParam.isEditMode === true;

            $ctrl.listPropId = $ctrl.extraParam.listPropId;
            $ctrl.listField = $ctrl.extraParam.listField;
            $ctrl.objectType = $ctrl.extraParam.objectType;
            $ctrl.itemTitle = $ctrl.extraParam.itemTitle;
            $ctrl.extraColsJson = $ctrl.extraParam.extraColsJson;

            $ctrl.editAction = 'Tag ' + $ctrl.itemTitle + 's';

//tagging-shots-selector
//tagging-storyboards-selector
            $ctrl.tagSelector = 'tagging-' + $ctrl.objectType + 's-selector';
            console.log('')
        }

        function getViewStep() {
            if(!$ctrl.item || !$ctrl.item._id){
                return '<p class="text-center semibold">The scene has been removed.</p>';
            }
            var tagObject = 'scene-shots-tagging';
            return '<' + tagObject + ' ' +
                "class='clearfix display-block " + tagObject + "' " +

                "id='scene" + $ctrl.item._id + "' " +

                "script-loading-service='::$ctrl.scriptLoadingService' " +
                "with-tagging='::" + $ctrl.isEditMode + "' " +
                "load-tags='::" + false + "' " +

                "tagging-scenes='::null' " +
                "categories='::null' " +
                "elements='::null' " +

                "max-font-size='::$ctrl.maxFontSize' " +
                "min-font-size='::$ctrl.minFontSize' " +
                "doc-wrapper-class='::$ctrl.docWrapperClass' " +
                "fixed-padding='::$ctrl.fixedPadding' " +

                "item='::$ctrl.item' " +

                "tag-selector='::$ctrl.tagSelector' " +

                "list-prop-id='::$ctrl.listPropId' " +
                "list-field='::$ctrl.listField' " +
                "object-type='::$ctrl.objectType' " +
                "item-title='::$ctrl.itemTitle' " +
                'extra-cols-json="::$ctrl.extraColsJson" ' +

                '></' + tagObject + '>';
        }

        function getBody() {
            return getBack() +
                getHeader() +
                getSimpleBody(getViewStep()) +
                getFooter();

            function getSimpleBody(content){
    return '<div class="body-table medium-template h-full">' +
                 '<div class="body-table-parent-wrapper h-full full-width">' +
                     '<div class="h-full full-width padding-left-0  with-fancy-scrollbar show-scrollbar-on-hover">' +
                         '<div id="right" class="fancy-scrollbar ultrathin scrollable-content h-full first-scrolling-wrapper nopadding">' +
                             '<div>' +
                                 '<div class="with-white-bg with-padding column-right-screenplay single-col centered">' +
                                    '<div class="sceneEditorWrapper document-version-wrapper screenplay-tagging centering screenplay-padding"> ' + content + '</div>' +
                                 '</div>' +
                             '</div>' +
                         '</div>' +
                     '</div>' +
                 '</div>' +
             '</div>';
            }

            function getHeader(){
return '<div class="modal-header clearfix hide-ipad">' +
             '<div class="top-table table-div full-width">' +
                 '<div class="table-col">' +
                    $ctrl.LCS.getISBDiv($ctrl.isEditMode ? $ctrl.editIcon : $ctrl.viewIcon, 2, 'gray') +
                    '<span class="stronger title with-margin-left">' + ($ctrl.isEditMode ? $ctrl.editAction : $ctrl.viewAction) + ' </span>' +
                '</div>' +
                $ctrl.getErrorBlock() +
             '</div>' +
         '</div>';
            }

            function getBack(){
                return $ctrl.isPopup ? $ctrl.getMobileBack() : '';
            }

            function getFooter(){
                return '<div class="modal-footer clearfix semi-tall hide-ipad">&nbsp;</div>';
            }
        }
    }
}


angular.module('product.shots.tagShotsSelector.controller.service', [
    'product.breakdown.taggingSelector.controller.service'
])
.service('TagShotsSelectorCtrlService', TagShotsSelectorCtrlService);

TagShotsSelectorCtrlService.$inject = ['TaggingSelectorCtrlService'];
function TagShotsSelectorCtrlService(TaggingSelectorCtrlService) {
    return function ($ctrl, $element, service) {

        $ctrl.saveEvent = 'PROCESS_TAGGED_SHOT';

        $ctrl.withoutQty = true;
        $ctrl.withoutCategories = true;
        $ctrl.cantChangeCategory = true;

        $ctrl.getListItems = getListItems;

        $ctrl.getElementNewFormTemplate = getElementNewFormTemplate;

        $ctrl = new TaggingSelectorCtrlService($ctrl, $element, service);

        return $ctrl;

        function getListItems() {
            return [];
        }

        function getElementNewFormTemplate() {
            $ctrl.errormessage = 'Please enter a valid name so we can generate a new ' + $ctrl.itemTitle + ' for this scene';
            $ctrl.btnText1 = 'Add ' + $ctrl.itemTitle;
            var cols = $ctrl.objectType === 'shot' ? null : JSON.parse($ctrl.extraColsJson);

            if($ctrl.objectType === 'shot'){
                return getRow('name', 'Description', null, true) +
                    getRow('subject', 'Subject', null, false, true)
            }else {
                var n = cols.length, p = '';
                for (var i = 0; i < n; i++) {
                    var c = cols[i];
                    p += getRow(c.p, c.n, c.pl, false, i !== 0);
                }
                return p;
            }

            function getRow(prop, name, placeholder, isRequired, withMarginTop) {
                return '<label class="stronger title ' + (withMarginTop ? 'margin-top-half' : '') + '">' + name + '</label>' +
                    '<div class="form-group field clearfix last table ' + ($ctrl.rowClass ? $ctrl.rowClass : '') + ' show-scrollbar-on-hover">' +
                    getContentEditable(prop, placeholder || name, isRequired) +
                    '</div>';
            }

            function getContentEditable(prop, placeholder, isRequired) {
                return '<div id="' + $ctrl.item._id + '_' + prop + '" class="form-control editable-content word-wrap contenteditable with-underline fancy-scrollbar ultrathin with-padding-top" ng-model="$ctrl.item.' + prop + '" placeholder="' + placeholder + '" contenteditable="true" contenteditable-html strip-br="true"></div>' +
                    (isRequired ? ('<div ng-show="($ctrl.formHolderItem.formItem.' + prop + '.$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem.formItem.' + prop + '.$error.required" class="help-inline ng-hide text-left">' + placeholder + ' is required.</div>') : '');
            }
        }
    }
}

angular.module('product.shots.list.tree.component', [
    'product.shots.firstShotList.component',
    'list.tree.sidebar.controller.service'
])
.component('shotSidebar', {
    bindings: _.extend(getTreeSidebarInitParams(), {
        service: '<',
        onGetDrpSelectedFilters: '&'
    }),
    controller: 'ShotSidebarCtrl',
})
.controller('ShotSidebarCtrl', ShotSidebarCtrl);
ShotSidebarCtrl.$inject = ['SidebarTreeCtrlService', '$element'];
function ShotSidebarCtrl(SidebarTreeCtrlService, $element) {
    console.log('ShotSidebarCtrl');
    var $ctrl = this;

    $ctrl.isSidebar = true;

    $ctrl.getNewTreeItem = getNewTreeItem;
    $ctrl.onTreeItemAdded = onTreeItemAdded;
    $ctrl.getSidebarHeader = getSidebarHeader;
    $ctrl.$onInit = $onInit;
    $ctrl.getFirstListType = getFirstListType;
    $ctrl.isNotInline = isNotInline;

    function $onInit() {
        $ctrl = new SidebarTreeCtrlService($ctrl, $element);

        if ($ctrl.canEdit) {
            $ctrl.addRootWatcher('ADD_LIST_FROM_TOP_' + $ctrl.elemType, onAddListFromTop);
            $ctrl.addRootWatcher('ADD_FIRST_LIST' + $ctrl.elemType, onAddFirstList);
        }
    }

    function getSidebarHeader(isInTreeModal) {
        return $ctrl.onGetDrpSelectedFilters({filter: 'treeType'});
       //  return isInTreeModal ? '' : $ctrl.onGetDrpSelectedFilters({filter: 'treeType'});
    }

    function onAddFirstList(addFolder) {
        var isFolder = addFolder === true;
        openAddPopup(  'createFirstShotList', isFolder);
    }

    function openAddPopup(type, isFolder, next) {
        console.log('ADD_FIRST_LIST');
        $ctrl.popupsService.open($ctrl.getNewCreatedItem({
            item: {type: $ctrl.getFirstListType()},
            addFolder: isFolder,
            isParent: false,
            useSelected: false,
            preserveName: false
        }), $ctrl.popupsService.operations[type], {
            listTreeService: $ctrl.listTreeService,
            service: isFolder ? $ctrl.listsService : $ctrl.service,
            canEdit: $ctrl.canEdit,

            onFileUploaded: onFileUploaded,
            onBeforeFilesUploaded: onBeforeFilesUploaded
        }, $ctrl.compOptions, null, function (result){
            console.log('onAddFirstList');
            if(typeof(next) === 'function'){next(result);}
        });
    }

    function onBeforeFilesUploaded(result){
        console.log('ShotSidebarCtrl.onBeforeFilesUploaded');
        $ctrl.broadcastRoot('BEFORE_IMAGE_UPLOADED_' + $ctrl.elemType, result);
    }

    function onFileUploaded(result) {
        console.log('ShotSidebarCtrl.onFileUploaded');
        $ctrl.broadcastRoot('IMAGE_UPLOADED_' + $ctrl.elemType, result);
    }

    function getFirstListType() {
        return $ctrl.treeTypeCustomList !== undefined ? $ctrl.treeTypeCustomList: $ctrl.treeType;
    }

    function isNotInline() {
        return $ctrl.toggleUpload;
    }

    function onAddListFromTop(result) {
        console.log('ADD_LIST_FROM_TOP_' + $ctrl.elemType);
        if (result) {
            $ctrl.toggleUpload = true;
            result.itemIsSet = true;
            result.addInline = true;
            $ctrl.addItem($ctrl.getFirstListType(), result);
        }
    }

    function onTreeItemAdded(result) {
        console.log('onTreeItemAdded');
        //if is first list open upload popup after couple seconds
        if (result && result.item && $ctrl.toggleUpload) {
            $ctrl.broadcastRoot('FIRST_' + $ctrl.elemType + '_ADDED', result.item);
            $ctrl.toggleUpload = false;
        }
    }

    function getNewTreeItem(item) {
        return {
            scriptId: $ctrl.treeType === $ctrl.treeTypeCustomList ? null : $ctrl.CPS.scriptId,
            type: item.type,
        };
    }

    function emptyState(){
    return '<div ng-if="$ctrl.count===0" class="todono h-full table-div">' +
                '<div class="centered text-center">' +
                    $ctrl.LCS.getISBDiv('breakdowns', 3, 'big') +
                    '<div class="text-center">' +
                        '<h3 class="text-center">No elements have been tagged <br>in this scene yet.</h3>' +
    ($ctrl.canEdit ? ('<div class="category margin-half-bottom with-tagging-selector on-top" style="border-bottom-width:0">' +
                            '<a id="aAddElement0" ng-click="$ctrl.openEditElement($event)" class="margin-top-half edit-profile btn btn-small transparent">' +
                            '<span class="pull-left sbf plus"><span class="sbp p1"></span><span class="sbp p2"></span></span>' +
                            ' Add Element</a>' +
                        '</div>' +
                    '</div>') : '') +
                '</div>' +
            '</div>';
    }
}


