angular.module('product.script.versionEdit.controller.service', [
    'product.document.edit.service',
    'apiServices.Scripts'
])
.service('ScriptVersionEditCtrlService', ScriptVersionEditCtrlService);
ScriptVersionEditCtrlService.$inject = ['ScriptsService', 'DocumentVersionPopupCtrlService'];
function ScriptVersionEditCtrlService(service, DocumentVersionPopupCtrlService) {
    return function ($ctrl, $element, isPopup) {

        $ctrl.dontAutoloadTemplate = false;

        $ctrl.getFormTemplate = getFormTemplate;
        $ctrl.getBtnsTemplate = getBtnsTemplate;

        $ctrl.getPopupTemplate = getPopupTemplate;
        $ctrl.getInlineTemplate = getInlineTemplate;
        $ctrl.onLoaded = onLoaded;

        if(!$ctrl.withDefaultSave && !$ctrl.saveItem){
            $ctrl.saveItem = saveItem;
        }

        $ctrl.postInitDocumentVersion = postInitDocumentVersion;
        $ctrl.postInitOther = postInitOther;
        $ctrl.preSetTemplateData = preSetTemplateData;

        $ctrl.getItemTemplate = getItemTemplate;
        $ctrl.onComplete = onComplete;

        return new DocumentVersionPopupCtrlService($ctrl, $element, isPopup);

        function onComplete(result) {
            $ctrl.onClose ({result: result});
        }

        function saveItem() {
            $ctrl.onClose ({result: {item:$ctrl.item}});
        }

        function getItemTemplate() {
            $ctrl.setTemplateDataInit();
            return $ctrl.isPopup ? $ctrl.getPopupTemplate($ctrl.modalTitle, $ctrl.btnText) :  $ctrl.getInlineTemplate($ctrl.modalTitle, $ctrl.btnText);
        }

        function preSetTemplateData() {
            $ctrl.btnText = $ctrl.extraParam.btnText;
            //$ctrl.modalBodyFormClass = 'long';
        }

        function postInitDocumentVersion() {
            $ctrl.item.type = $ctrl.extraParam.type || 2; //script
            $ctrl.elemType = $ctrl.extraParam.elemType;
            $ctrl.itemTitle = $ctrl.extraParam.itemTitle;
            $ctrl.icon = $ctrl.extraParam.icon;
            $ctrl.iconLevel = $ctrl.extraParam.iconLevel;

            $ctrl.modalTitle = $ctrl.extraParam.modalTitle;
        }

        function postInitOther(){
            $ctrl.onSave = onSave;
        }

        function onSave(result) {
            $ctrl.isUpdating = false;
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.elemType + '.' + ($ctrl.isNew ? ($ctrl.isDuplicate ? 'Duplicate' : 'Create') : 'Edit') + '.success', 'success', {name: $ctrl.item.name});
            result.type = $ctrl.type;
            $ctrl.broadcastRoot(($ctrl.isNew ? 'ADDED' : 'UPDATED') + '_' + $ctrl.elemType + '_ITEM', result);

            $ctrl.onComplete({result: result});
        }

        function onLoaded() {
            $ctrl.setFocus();
            if($ctrl.onLoadedOther){
                $ctrl.onLoadedOther();
            }
        }

        function getFormTemplate() {
    return '<form name="$ctrl.formHolderItem[$ctrl.formName]" class="auto" novalidate autocomplete="off">' +
                '<div class="form-wrapper '+($ctrl.modalBodyFormClass||'')+'">' +
                    $ctrl.getErrorBlock() +
                    '<div class="form-group table-div full-width margin-half-top last">' +
                        '<div class="col50 vbottom">' +
                            '<sb-color-dropdown class="sb-color-dropdown clearfix with-sb-edit ng-isolate-scope display-block wrap-dd-select custom-drp-selector custom-color-selector without-arrow smaller square '+($ctrl.pageClass||'')+'" ' +
                            'element-id="undefined_color_documentVersion" ' +
                            'on-change="$ctrl.onChange(result)" ' +
                            'on-validation="$ctrl.onValidation(result)" ' +
                            'on-cancel="$ctrl.onCancel(result)" ' +
                            'without-close="true" ' +
                            'value="$ctrl.item.color" ' +
                            'tab-index="1" ' +
                            'tab-next-index="2" ' +
                            'parent-container="true" ' +
                            'init-list-name="Colors" ' +
                            'field-class="selected-text centering text-left with-underline" ' +
                            'with-uncheck="true" ' +
                            'square="true" ' +
                            'show-color-name="true" ' +
                            'init-list="::$ctrl.initList ? $ctrl.initList : $ctrl.Settings.Colors"></sb-color-dropdown>'+
                        '</div>' +
                        '<div class="col40 thin with-padding-right">' +
                            '<sb-number class="sb-number clearfix with-sb-edit versionnumber '+($ctrl.pageClass||'')+' " ' +
                            'element-id="undefined_version_documentVersion" ' +
                            'on-change="$ctrl.onChange(result)" ' +
                            'on-validation="$ctrl.onValidation(result)" ' +
                            'on-cancel="$ctrl.onCancel(result)" ' +
                            'without-close="true" ' +
                            'value="::$ctrl.item.version" ' +
                            'e-class-attr="form-control with-underline " ' +
                            'placeholder="#" ' +
                            'tab-index="1" ' +
                            'save-on-keydown="true" ' +
                            'parent-container="true" ' +
                            '></sb-number>' +
                        '</div>' +
                        '<div class="thin padding-right10">' +
                            '<input placeholder="' + $ctrl.itemTitle + ' name…" class="form-control with-underline '+($ctrl.pageClass||'')+'" type="text" id="name" name="name" ng-model="$ctrl.item.name" required>' +
                            //'<label ng-show="$ctrl.item.name" class="with-label">Name</label>' +
                            '<div ng-show="($ctrl.formHolderItem.formItem.name.$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem.formItem.name.$error.required" class="help-inline ng-hide">' + $ctrl.itemTitle + ' is required.</div>' +
                        '</div>' +
                    '</div>' +
                   /* '<div class="form-group field">' +
                        '<div tabindex="0" class="form-control with-underline without-border-bottom autogrow contenteditable" placeholder="Notes…" contenteditable="true" contenteditable-html strip-br="true" ng-model="$ctrl.item.notes"></div>' +
                    '</div>' +*/
                '</div>' +
            '</form>' ;
        }

        function getBtnsTemplate(btnText) {
            if(!btnText){
                btnText = ($ctrl.isNew ? ($ctrl.isDuplicate ? 'Duplicate' : 'Create New') : 'Save') + ' ' + $ctrl.itemTitle;
            }

            return '<div class="form-wrapper text-center">' +
                        '<button class="btn btn-primary ' + $ctrl.pageClass + ' full-width" type="submit" ng-click="$ctrl.saveItem()" analytics-on analytics-action="' + $ctrl.btn + '" ng-disabled="$ctrl.isUpdating || !$ctrl.formHolderItem.formItem.$valid"> <span class="sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> ' + btnText + '</button>' +
                    '</div>';
        }

        function getInlineTemplate(modalTitle, btnText) {
            return $ctrl.getFormTemplate() +  $ctrl.getBtnsTemplate(btnText);
        }

        function getPopupTemplate(modalTitle, btnText) {
            if(!modalTitle){ modalTitle = $ctrl.modalTitle ? $ctrl.modalTitle : (($ctrl.isNew ? ($ctrl.isDuplicate ? 'Duplicate' : 'Create New') : 'Rename') + ' ' + $ctrl.itemTitle);}
            return ($ctrl.withCloseBtn && $ctrl.nonMobileCloseBtn ? $ctrl.nonMobileCloseBtn() : '') +
                $ctrl.getMobileBack() +
            '<div class="modal-header clearfix">' +
                '<div class="form-wrapper '+($ctrl.modalBodyFormClass||'')+'">' +
                    '<div class="centered circled-svg-colored small76 page-class ' + ($ctrl.pageClass ? $ctrl.pageClass : '') + '">'+ ($ctrl.icon ? $ctrl.LCS.getISBDiv($ctrl.icon, $ctrl.iconLevel) : '') + '</div>' +
                    '<h3 class="text-center">'+modalTitle+'</h3>' +
                '</div>' +
            '</div>' +
            '<div class="modal-body clearfix">' + $ctrl.getFormTemplate() + '</div>' +
            '<div class="modal-footer clearfix semi-tall">' + $ctrl.getBtnsTemplate(btnText) + '</div>';
        }
    }
}

