angular.module('components.sbScriptViewer', [
])
.component('sbScriptViewer', {
    bindings: {
        src: '<?',
    },
    controller: 'SbScriptViewerCtrl',
})
.controller('SbScriptViewerCtrl', SbScriptViewerCtrl);
SbScriptViewerCtrl.$inject = ['TemplateCompileService', 'ScriptLoaderService', '$element'];
function SbScriptViewerCtrl(TemplateCompileCompCtrlService, ScriptLoaderService, $element) {
    var $ctrl = this;

    $ctrl.changedFields = ['src'];

    $ctrl.beforePreloadTemplate = ScriptLoaderService.loadScript;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.$onChanges = $onChanges;
    $ctrl.onDestroy = destroyBook;
    $ctrl.onLoaded = onLoaded;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function $onChanges(changes) {
        console.log(changes);
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                $ctrl.reloadTemplate();
                break;
            }
        }
    }

    function destroyBook() {
        console.log("unloading");
        if($ctrl.book){$ctrl.book.destroy();}
    }

    function getItemTemplate() {
    return getStyle() +
            '<div class="h-full full-width sb-epub-viewer"> ' +
                '<div class="viewer h-full full-width">' +
                    '<select id="toc"></select>' +
                    '<div id="viewer" class="spreads"></div>' +
                    '<a id="prev" href="#prev" class="arrow">‹</a>' +
                    '<a id="next" href="#next" class="arrow">›</a>' +
                '</div>' +
            '</div>';
    }
    
    function getStyle() {
        return '<style type="text/css">' +
            '.sb-epub-viewer{margin:0;background:#fafafa;font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;color:#333;position:absolute;height:100%;width:100%;min-height:800px}' +
            '.sb-epub-viewer #title{width:900px;min-height:18px;margin:10px auto;text-align:center;font-size:16px;color:#e2e2e2;font-weight:400}' +
            '.sb-epub-viewer #title:hover{color:#777}' +
            '.sb-epub-viewer #viewer.spreads{width:900px;height:600px;box-shadow:0 0 4px #ccc;border-radius:5px;padding:0;position:relative;margin:10px auto;background:#fff url(ajax-loader.gif) center center no-repeat;top:calc(50vh - 400px)}' +
            '.sb-epub-viewer #viewer.spreads .epub-view>iframe{background:#fff}' +
            '.sb-epub-viewer #viewer.scrolled{overflow:hidden;width:800px;margin:0 auto;position:relative;background:url(ajax-loader.gif) center center no-repeat}' +
            '.sb-epub-viewer #viewer.scrolled .epub-container{background:#fff;box-shadow:0 0 4px #ccc;margin:10px;padding:20px}#viewer.scrolled .epub-view>iframe{background:#fff}' +
            '.sb-epub-viewer #prev{left:0}' +
            '.sb-epub-viewer #next{right:0}' +
            '.sb-epub-viewer #toc{display:block;margin:10px auto}' +
            '@media (min-width:1000px){' +
                '.sb-epub-viewer #viewer.spreads:after{position:absolute;width:1px;border-right:1px #000 solid;height:90%;z-index:1;left:50%;margin-left:-1px;top:5%;opacity:.15;box-shadow:-2px 0 15px #000;content:""}' +
                '.sb-epub-viewer #viewer.spreads.single:after{display:none}' +
                '.sb-epub-viewer #prev{left:40px}' +
                '.sb-epub-viewer #next{right:40px}' +
            '}' +
            '.sb-epub-viewer .arrow{position:fixed;top:50%;margin-top:-32px;font-size:64px;color:#e2e2e2;font-family:arial,sans-serif;font-weight:700;cursor:pointer;-webkit-user-select:none;-moz-user-select:none;user-select:none;text-decoration:none}' +
            '.sb-epub-viewer .navlink{margin:14px;display:block;text-align:center;text-decoration:none;color:#ccc}' +
            '.sb-epub-viewer .arrow:hover,' +
            '.sb-epub-viewer .navlink:hover{color:#777}' +
            '.sb-epub-viewer .arrow:active,' +
            '.sb-epub-viewer .navlink:hover{color:#000}' +
            '.sb-epub-viewer #book-wrapper{width:480px;height:640px;overflow:hidden;border:1px solid #ccc;margin:28px auto;background:#fff;border-radius:0 5px 5px 0;position:absolute}' +
            '.sb-epub-viewer #book-viewer{width:480px;height:660px;margin:-30px auto;-moz-box-shadow:inset 10px 0 20px rgba(0,0,0,.1);-webkit-box-shadow:inset 10px 0 20px rgba(0,0,0,.1);box-shadow:inset 10px 0 20px rgba(0,0,0,.1)}' +
            '.sb-epub-viewer #book-viewer iframe{padding:40px 40px}' +
            '.sb-epub-viewer #controls{position:absolute;bottom:16px;left:50%;width:400px;margin-left:-200px;text-align:center;display:none}#controls>input[type=range]{width:400px}' +
            '.sb-epub-viewer #navigation{width:400px;height:100vh;position:absolute;overflow:auto;top:0;left:0;background:#777;-webkit-transition:-webkit-transform .25s ease-out;-moz-transition:-moz-transform .25s ease-out;-ms-transition:-moz-transform .25s ease-out;transition:transform .25s ease-out}' +
            '.sb-epub-viewer #navigation.fixed{position:fixed}' +
            '.sb-epub-viewer #navigation h1{width:200px;font-size:16px;font-weight:400;color:#fff;margin-bottom:10px}' +
            '.sb-epub-viewer #navigation h2{font-size:14px;font-weight:400;color:#b0b0b0;margin-bottom:20px}' +
            '.sb-epub-viewer #navigation ul{padding-left:36px;margin-left:0;margin-top:12px;margin-bottom:12px;width:340px}' +
            '.sb-epub-viewer #navigation ul li{list-style:decimal;margin-bottom:10px;color:#cccddd;font-size:12px;padding-left:0;margin-left:0}' +
            '.sb-epub-viewer #navigation ul li a{color:#ccc;text-decoration:none}' +
            '.sb-epub-viewer #navigation ul li a:hover{color:#fff;text-decoration:underline}' +
            '.sb-epub-viewer #navigation ul li a.active{color:#fff}' +
            '.sb-epub-viewer #navigation #cover{display:block;margin:24px auto}' +
            '.sb-epub-viewer #navigation #closer{position:absolute;top:0;right:0;padding:12px;color:#cccddd;width:24px}' +
            '.sb-epub-viewer #navigation.closed{-webkit-transform:translate(-400px,0);-moz-transform:translate(-400px,0);-ms-transform:translate(-400px,0)}' +
            '.sb-epub-viewer svg{display:block}' +
            '.sb-epub-viewer .close-x{stroke:#cccddd;fill:transparent;stroke-linecap:round;stroke-width:5}' +
            '.sb-epub-viewer .close-x:hover{stroke:#fff}' +
            '.sb-epub-viewer #opener{position:absolute;top:0;left:0;padding:10px;stroke:#e2e2e2;fill:#e2e2e2}' +
            '.sb-epub-viewer #opener:hover{stroke:#777;fill:#777}' +
            '</style>';
    }

    function onLoaded() {
        destroyBook();
        $ctrl.nextBtn = $ctrl.element.querySelector('#next');
        $ctrl.prevBtn = $ctrl.element.querySelector('#prev');
        $ctrl.viewerEl = $ctrl.element.querySelector('#viewer');
        $ctrl.tocEl = $ctrl.element.querySelector('#toc');

        var params = URLSearchParams && new URLSearchParams(document.location.search.substring(1));
        var url = params && params.get("url") && decodeURIComponent(params.get("url"));
        var currentSectionIndex = (params && params.get("loc")) ? params.get("loc") : undefined;

// Load the opf
        console.log('load book ' + $ctrl.src)
        $ctrl.book = ePub($ctrl.src || "https://s3.amazonaws.com/moby-dick/moby-dick.epub");
        var rendition = $ctrl.book.renderTo("viewer", {
            width: "100%",
            height: "100%",
            spread: "always"
        });

        rendition.display(currentSectionIndex);

        $ctrl.book.ready.then(onBookReady);

        rendition.on('rendered', onRendered);
        rendition.on('relocated', onRelocated);
        rendition.on('layout', onLayout);

        function onBookReady() {
            $ctrl.LCS.bindElementListeners(true, $ctrl.nextBtn, function (e) {
                $ctrl.book.package.metadata.direction === "rtl" ? rendition.prev() : rendition.next();
                e.preventDefault();
            });

            $ctrl.LCS.bindElementListeners(true, $ctrl.prevBtn, function (e) {
                $ctrl.book.package.metadata.direction === "rtl" ? rendition.next() : rendition.prev();
                e.preventDefault();
            });

            var keyListener = function (e) {

                // Left Key
                if ((e.keyCode || e.which) === 37) {
                    $ctrl.book.package.metadata.direction === "rtl" ? rendition.next() : rendition.prev();
                }

                // Right Key
                if ((e.keyCode || e.which) === 39) {
                    $ctrl.book.package.metadata.direction === "rtl" ? rendition.prev() : rendition.next();
                }

            };

            rendition.on('keyup', keyListener);
            $ctrl.LCS.bindElementListeners(true, $ctrl.LCS.$document[0], keyListener, 'keyup');
        }

        function onRendered(section) {
            var current = $ctrl.book.navigation && $ctrl.book.navigation.get(section.href);

            if (current) {
                var $select = $ctrl.tocEl;
                var $selected = $select.querySelector("option[selected]");
                if ($selected) {
                    $selected.removeAttribute("selected");
                }

                var $options = $select.querySelectorAll("option");
                for (var i = 0; i < $options.length; ++i) {
                    var selected = $options[i].getAttribute("ref") === current.href;
                    if (selected) {
                        $options[i].setAttribute("selected", "");
                    }
                }
            }
        }

        function onRelocated(location) {
            console.log(location);

            var next = $ctrl.book.package.metadata.direction === "rtl" ? $ctrl.prevBtn : $ctrl.nextBtn;
            var prev = $ctrl.book.package.metadata.direction === "rtl" ? $ctrl.nextBtn : $ctrl.prevBtn;

            if (location.atEnd) {
                next.style.visibility = "hidden";
            } else {
                next.style.visibility = "visible";
            }

            if (location.atStart) {
                prev.style.visibility = "hidden";
            } else {
                prev.style.visibility = "visible";
            }
        }

        function onLayout(layout) {
            $ctrl.viewerEl.classList[layout.spread ? 'remove':'add']('single');
        }

        $ctrl.book.loaded.navigation.then(function (toc) {
            var $select = $ctrl.tocEl,
                docfrag = document.createDocumentFragment();

            toc.forEach(function (chapter) {
                var option = document.createElement("option");
                option.textContent = chapter.label;
                option.setAttribute("ref", chapter.href);

                docfrag.appendChild(option);
            });

            $select.appendChild(docfrag);

            $select.onchange = function () {
                var index = $select.selectedIndex,
                    url = $select.options[index].getAttribute("ref");
                rendition.display(url);
                return false;
            };
        });
    }
}

angular.module('components.secureVideoViewer.comments.service', [
])
 .factory('SecureVideoViewerComments', SecureVideoViewerComments);

function SecureVideoViewerComments() {
    return function (player, options){
        var commenter = {};

        setupAnnotations(player, options);

        function setupAnnotations(player, options) {
            if (!options || !options.show || !player) {
                return commenter;
            }
            commenter = player.annotationComments(options);
            commenter.onReady(onReady);

            function onReady() {
                // do stuff with the commenter, such as fire events or setup listeners
                initFireCommenterMethods();

                initCommenterListeners();
            }

        }

        function initFireCommenterMethods() {
            // openAnnotation : Opens an annotation within the player given an ID
            commenter.openAnnotation = openAnnotation;

            // closeActiveAnnotation : Closes any active annotation
            commenter.closeActiveAnnotation = closeActiveAnnotation;

            // newAnnotation : Adds a new annotation within the player and opens it given comment data
            /*
            item = {
                id: 1,
                range: {start: 20, end: null},
                shape: { // NOTE - x/y vals are % based (Floats) in video, not pixel values
                    x1: null,
                    x2: null,
                    y1: null,
                    y2: null
                }
                commentStr: "This is my comment."
            }
             */
            commenter.addAnnotation = addAnnotation;

            // destroyAnnotation : Removes an annotation and it's marker within the player given comment data
            commenter.destroyAnnotation = destroyAnnotation;

            // newComment : Adds a new comment to an Annotation given an Annotation ID and a body
            /*item =  {annotationId: 1, body: "My comment string"}*/
            commenter.newComment = newComment;

            // destroyComment : Removes a comment from an Annotation given a Comment ID
            commenter.destroyComment = destroyComment;

            // addingAnnotation : commenter enters the adding annotation state (adding an annotation at the current player timestamp)
            commenter.addingAnnotation = addingAnnotation;

            // cancelAddingAnnotation : commenter exits the adding annotation state
            commenter.cancelAddingAnnotation = cancelAddingAnnotation;

            // toggleAnnotationMode : toggle annotation mode to alternative on/off value
            commenter.toggleAnnotations = toggleAnnotations;
        }

        function onEnteredAddingAnnotation(event) {
            var startTime = event.detail.range.start;
            // do something when adding annotation state begin
        }

        function openAnnotation(id) {
            commenter.fire('openAnnotation', {id: id});
        }

        function addAnnotation(item) {
            commenter.fire('newAnnotation', item);
        }

        function closeActiveAnnotation() {
            commenter.fire('closeActiveAnnotation');
        }

        function destroyAnnotation(id) {
            commenter.fire('destroyAnnotation', {id: id});
        }

        function newComment(item) {
            commenter.fire('newComment', item);
        }

        function destroyComment(id) {
            commenter.fire('destroyComment', {id: id});
        }

        function addingAnnotation() {
            commenter.fire('addingAnnotation');
        }

        function cancelAddingAnnotation() {
            commenter.fire('cancelAddingAnnotation');
        }

        function toggleAnnotations() {
            commenter.fire('toggleAnnotations');
        }

//todo: implement

        function initCommenterListeners() {
            // annotationOpened : Fired whenever an annotation is opened
            commenter.on('annotationOpened', onAnnotationOpened);

            // annotationClosed : Fired whenever an annotation is closed
            commenter.on('annotationClosed', onAnnotationClosed);
            // addingAnnotationDataChanged : Fired from adding annotation state if:
            //  1. the marker is dragged
            //  2. the start of the marker is moved via control buttons
            //  3. the shape is dragged
            commenter.on('addingAnnotationDataChanged', onAddingAnnotationDataChanged);

            // annotationDeleted : Fired when an annotation has been deleted via the UI
            commenter.on('annotationDeleted', onAnnotationDeleted);

            // enteredAnnotationMode : Fired when the commenter enters adding annotation mode
            // includes initial range data
            commenter.on('enteredAddingAnnotation', onEnteredAddingAnnotation);

            // onStateChanged: Fired when commenter state has changed (annotation added, removed, etc)
            // This is a way to watch global commenter state, as an alternative to watching various annotation events
            commenter.on('onStateChanged', onCommenterStateChanged);

            // playerBoundsChanged : Fired when the player boundaries change due to window resize or fullscreen mode
            commenter.on('playerBoundsChanged', onCommenterPlayerBoundsChanged);

            // Entering annotation mode (annotation icon was clicked when previously 'off')
            commenter.on('annotationModeEnabled', onAnnotationModeEnabled);

            // Exiting annotation mode (annotation icon was clicked when previously 'on')
            commenter.on('annotationModeDisabled', onAnnotationModeDisabled);
        }

        function onAnnotationOpened(event) {
            console.log('onAnnotationOpened');
            // event.detail =
            // {
            //      annotation: (object) annotation data in format {id:.., comments:..., range:..., shape:...},
            //      triggered_by_timeline: (boolean) TRUE = the event was triggered via a timeline action (like scrubbing or playing), FALSE = the annotation was opened via marker click, UI button interactions, or API/event input
            // }
        }

        function onAnnotationClosed(event) {
            console.log('onAnnotationClosed');
            // event.detail = annotation (object) in format {id:.., comments:..., range:..., shape:...}
        }

        function onAddingAnnotationDataChanged(event) {
            console.log('onAddingAnnotationDataChanged');
            var newRange = event.detail.range; // returns range data if range was changed
            var newShape = event.detail.shape; // returns shape data if shape was changed
            // do something with the data
        }

        function onAnnotationDeleted(event) {
            console.log('onAnnotationDeleted');
            // annotationId = event.detail
        }

        function onCommenterStateChanged(event) {
            console.log('onCommenterStateChanged');
            // event.detail = annotation state data
        }

        function onCommenterPlayerBoundsChanged(event) {
            console.log('onCommenterPlayerBoundsChanged');
            var bounds = event.detail;
            // do something with the new boundaries
        }

        function onAnnotationModeEnabled(event) {
            console.log('onAnnotationModeEnabled');
            // do something
        }

        function onAnnotationModeDisabled(event) {
            // do something
        }
    }
}

angular.module('components.videoViewer.container.component', [
])
.component('sbVideoContainer', {
    bindings: {
        optionsStr: '<',
        onReady:'&',
    },
    controller: 'SbVideoContainerCtrl'
})
.controller('SbVideoContainerCtrl', SbVideoContainerCtrl);
SbVideoContainerCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];
function SbVideoContainerCtrl( TemplateCompileCompCtrlService, $element) {
    var $ctrl = this;
    $ctrl.changedFields = ['optionsStr'];

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.preInit = preInit;
    $ctrl.$onChanges = $onChanges;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.options = JSON.parse($ctrl.strOptions);
    }

    function $onChanges(changes) {
        if (!changes) {
            return;
        }
        console.log(changes);
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                reload();
                break;
            }
        }
    }

    function reload() {
        $ctrl.options = JSON.parse($ctrl.strOptions);
        $ctrl.reloadTemplate();
    }

    function getItemTemplate() {
        return '<div class="vjs-directive-container"><video class="video-js vjs-default-skin vjs-big-play-centered vjs-paused vjs-controls-enabled vjs-workinghover vjs-v6 vjs_video_1-dimensions vjs-user-active" controls preload="auto"></video></div>';
    }

    function onLoaded() {
        $ctrl.videoElement = prepareVideoElement($ctrl.element, $ctrl.options);
        //bootstrap video js
        initVideoJs($ctrl.videoElement, $ctrl.options);
    }

    function prepareVideoElement(element, options) {
        //vjs-ratio="{{options.ratio}}" vjs-media="options.media" vjs-setup="options.setup" vjs-comments="commentsOptions"
        var vid = getVidElement(element, true);
//we want to confirm that the vjs-video directive or
        //any corresponding attributes are not defined on the
        //internal video element
        if (vid.getAttribute('vjs-video') !== null) {
            throw new Error('vjs-video should not be used on the video tag when using vjs-video-container!');
        }

        //we also want to make sure that no vjs-* attributes
        //are included on the internal video tag
        if (vid.getAttribute('vjs-setup') !== null || vid.getAttribute('vjs-media') !== null || vid.getAttribute('vjs-ratio') !== null) {
            throw new Error('directive attributes should not be used on the video tag when using vjs-video-container!');
        }

        //check if video.js version 5.x is running
        if (getVersion().match(/^5\./)) {
            if (options.ratio) {
                if (!options.setup) {
                    options.setup = {};
                }

                options.setup.aspectRatio = options.ratio;
            }
        } else {
            //set width and height of video to auto
            vid.setAttribute('width', 'auto');
            vid.setAttribute('height', 'auto');
        }

        return vid;
    }

    function mediaChangedHandler(e) {
        var vidEl = $ctrl.element.querySelector(
            'video, audio'
        );

        if (vidEl) {
            //remove any inside contents
            while (vidEl.firstChild) {
                vidEl.removeChild(vidEl.firstChild);
            }

            //add generated sources and tracks
            while (e.element.childNodes.length > 0) {
                vidEl.appendChild(e.element.childNodes[0]);
            }
        }
    }

    function getCommentsOptions() {
        return {
            show: true,
            options: {
                // Collection of annotation data to initialize
                annotationsObjects: [],
                // Flexible meta data object (currently used for user data, but addl data can be provided to wrap each comment with metadata - provide the id of the current user and fullname of the current user at minimum, which are required for the UI)
                meta: {user_id: $ctrl.CPS.userId,
                    user_name: $ctrl.CPS.user ? $ctrl.CPS.user.name : 'Anonymous'},
                // Use arrow keys to move through annotations when Annotation mode is active
                bindArrowKeys: true,
                // Show or hide the control panel and annotation toggle button (NOTE - if controls are hidden you must provide custom UI and events to drive the annotations - more on that in "Programmatic Control" below)
                showControls: true,
                // Show or hide the comment list when an annotation is active. If false, the text 'Click and drag to select', will follow the cursor during annotation mode
                showCommentList: true,
                // If false, annotations mode will be disabled in fullscreen
                showFullScreen: true,
                // Show or hide the tooltips with comment preview, and annotation shape, on marker hover or timeline activate
                showMarkerShapeAndTooltips: true,
                // If false, step two of adding annotations (writing and saving the comment) will be disabled
                internalCommenting: true,
                // If true, toggle the player to annotation mode immediately after init. (NOTE - "annotationModeEnabled" event is not fired for this initial state)
                startInAnnotationMode: false
            }
        };
    }

    function overwriteButtons(player, controlBar) {
        // Create variables and new div, anchor and image for download icon
        var newElement = document.createElement('div'),
            newLink = document.createElement('a'),
            newImage = document.createElement('img');
        // Assign id and classes to div for icon
        newElement.id = 'downloadButton';
        newElement.className = 'downloadStyle vjs-control';
        // Assign properties to elements and assign to parents
        newImage.addClass('sbf download');
        newLink.setAttribute('href', $ctrl.options.src);
        newLink.appendChild(newImage);
        newElement.appendChild(newLink);

        // Get controlbar and insert before elements
        // Remember that getElementsByClassName() returns an array
        controlBar = document.getElementsByClassName('vjs-control-bar')[0];
        // Change the class name here to move the icon in the controlBar
        var insertBeforeNode = document.getElementsByClassName('vjs-volume-menu-button')[0];
        // Insert the icon div in proper location
        controlBar.insertBefore(newElement, insertBeforeNode);
        // Get the spacer element
        var spacer = document.getElementsByClassName('vjs-spacer')[0];
        // Place the new element in the spacer
        spacer.appendChild(newElement);

        var playButton = document.getElementsByClassName("vjs-big-play-button")[0];
        playButton.addClass("sbf play");
    }

    function initVideoJs(videoElement, params ) {
        var opts = params.vjsSetup || {},
            ratio = params.vjsRatio,
            isValidContainer = !isMediaElement(videoElement) && !getVersion().match(/^5\./) ? true : false,
            mediaWatcher;

        if (!videojs) {
            return null;
        }

        //override poster settings if defined in vjsMedia
        if (params.vjsMedia && params.vjsMedia.poster) {
            opts.poster = params.vjsMedia.poster;
        }

        //generate any defined sources or tracks
        generateMedia(params, mediaChangedHandler);

        //watch for changes to vjs-media
        mediaWatcher = $scope.$watch(
            function () {
                return params.vjsMedia;
            },
            function (newVal, oldVal) {
                if (newVal && !angular.equals(newVal, oldVal)) {
                    //deregister watcher
                    mediaWatcher();

                    if (isValidContainer) {
                        removeVideoJs(videoElement);
                    }  $scope.$emit('vjsVideoMediaChanged');
                }
            }
        );

        //bootstrap videojs
        var player = videojs(videoElement, opts, function () {
            if (isValidContainer) {
                applyRatio(element, ratio);
            }
        });

        if (player) {
            //emit ready event with reference to video
            $scope.$emit('vjsVideoReady', {
                id: videoElement.getAttribute('id'),
                vid: player,
                player: player,
                controlBar: player.controlBar
            });
        }
    }

    function getVidElement(element, isContainer) {
        var vid = null,
            videos;

        if (!videojs) {
            throw new Error('video.js was not found!');
        }

        if (isContainer) {
            videos = element[0].querySelectorAll('video, audio');
            if (videos.length === 0) {
                throw new Error(
                    'video tag must be defined within container directive!'
                );
            } else if (videos.length > 1) {
                throw new Error(
                    'only one video can be defined within the container directive!'
                );
            }

            vid = videos[0];
        } else {
            if (isMediaElement(element)) {
                vid = element[0];
            } else {
                throw new Error(
                    'directive must be attached to a video or audio tag!'
                );
            }
        }

        return vid;
    }

    function applyRatio(element, ratioVal) {
        var ratio = ratioVal,
            style = document.createElement('style'),
            parseRatio = function (r) {
                var tokens = r.split(':'),
                    tokenErrorMsg =
                        'the ratio must either be "wide", "standard" or ' +
                        'decimal values in the format of w:h';

                //if invalid ratio throw an error
                if (tokens.length !== 2) {
                    throw new Error(tokenErrorMsg);
                }

                //confirm that both tokens are numbers
                if (isNaN(tokens[0]) || isNaN(tokens[1])) {
                    throw new Error(tokenErrorMsg);
                }

                //confirm that the width or height is not zero
                if (
                    Number(tokens[0]) === 0 ||
                    Number(tokens[1]) === 0
                ) {
                    throw new Error(
                        'neither the width or height ratio can be zero!'
                    );
                }

                return Number(tokens[1]) / Number(tokens[0]) * 100;
            },
            genContainerId = function (element) {
                var container = element[0].querySelector('.vjs-tech'),
                    vjsId;

                if (container) {
                    vjsId =
                        'vjs-container-' + container.getAttribute('id');
                } else {
                    //vjsId = 'vjs-container-default';
                    throw new Error(
                        'Failed to find instance of video-js class!'
                    );
                }

                //add generated id to container
                element[0].setAttribute('id', vjsId);

                return vjsId;
            },
            containerId,
            ratioPercentage,
            css;

        //if ratio isn't defined lets default to wide screen
        if (!ratio) {
            ratio = '16:9';
        }

        switch (ratio) {
            case 'wide':
                ratio = '16:9';
                break;
            case 'standard':
                ratio = '4:3';
                break;
        }

        containerId = genContainerId(element);

        ratioPercentage = parseRatio(ratio);

        css = [
            '#',
            containerId,
            ' ',
            '.video-js {padding-top:',
            ratioPercentage,
            '%;}\n',
            '.vjs-fullscreen {padding-top: 0px;}'
        ].join('');

        style.type = 'text/css';
        style.rel = 'stylesheet';
        if (style.styleSheet) {
            style.styleSheet.cssText = css;
        } else {
            style.appendChild(document.createTextNode(css));
        }

        element[0].appendChild(style);
    }

    function generateMedia(ctrl, mediaChangedHandler) {
        var errMsgNoValid =
            'a sources and/or tracks element must be ' +
            'defined for the vjs-media attribute',
            errMsgNoSrcs =
                'sources must be an array of objects with at ' +
                'least one item',
            errMsgNoTrks =
                'tracks must be an array of objects with at ' +
                'least one item',
            div,
            curDiv;
        //check to see if vjsMedia is defined
        if (!options.media) {
            return;
        }

        //if sources and tracks aren't defined, throw an error
        if (!options.media.sources && !options.media.tracks) {
            throw new Error(errMsgNoValid);
        }

        //verify sources and tracks are arrays if they are defined
        if (
            options.media.sources &&
            !(options.media.sources instanceof Array)
        ) {
            throw new Error(errMsgNoSrcs);
        }
        if (
            options.media.tracks &&
            !(options.media.tracks instanceof Array)
        ) {
            throw new Error(errMsgNoTrks);
        }

        //build DOM elements for sources and tracks as children to a div
        div = document.createElement('div');

        if (options.media.sources) {
            options.media.sources.forEach(function (curObj) {
                curDiv = document.createElement('source');
                curDiv.setAttribute('src', curObj.src || '');
                curDiv.setAttribute('type', curObj.type || '');
                div.appendChild(curDiv);
            });
        }

        if (options.media.tracks) {
            options.media.tracks.forEach(function (curObj) {
                curDiv = document.createElement('track');
                curDiv.setAttribute('kind', curObj.kind || '');
                curDiv.setAttribute('label', curObj.label || '');
                curDiv.setAttribute('src', curObj.src || '');
                curDiv.setAttribute('srclang', curObj.srclang || '');

                //check for default flag
                if (curObj.default === true) {
                    curDiv.setAttribute('default', '');
                }

                div.appendChild(curDiv);
            });
        }

        //invoke callback
        mediaChangedHandler.call(undefined, {element: div});
    }

    function isMediaElement(element) {
        return (
            element[0].nodeName === 'VIDEO' || element[0].nodeName === 'AUDIO'
        );
    }

    function getVersion() {
        return videojs && videojs.VERSION ? videojs.VERSION : '0.0.0';
    }

    function onDestroy() {
        removeVideoJs(vid);
    }

    function removeVideoJs(vid) {
        if(vid){videojs(vid).dispose();}
    }
}

angular.module('components.videoViewer', [
    'components.secureVideoViewer.comments.service',
    'components.videoViewer.container.component'
])
.component('sbVideoViewer', {
    bindings: {
        src:'<',
        materialVersion: '<?',
        options:'<?',
        template: '<div class="material-content flex-box preview-video h-full full-width sb-hide">' +
            '<div class="material-video-wrapper">' +
            '<div class="material-video-aspect-container">' +
            '<div class="material-video-container">' +
            '<div class="video-player h-full">' +
            '<sb-video-container class="display-block clearfix" options-str="$ctrl.optionsStr" on-ready="$ctrl.onVjsVideoReady(result)"></sb-video-container>' +
            '</div>' +
            '</div>' +
            '</div>' +
            '</div>' +
            '</div>' +
            '<preloader-center class="preloader"></preloader-center>'
    },

    controller: 'SbVideoViewerCtrl'
})
.controller('SbVideoViewerCtrl', SbVideoViewerCtrl);
SbVideoViewerCtrl.$inject = ['SecureVideoViewerComments', 'LCS', '$element'];
function SbVideoViewerCtrl(SecureVideoViewerComments, LCS, $element) {

    var $ctrl = this;

    $ctrl.LCS = LCS;

    $ctrl.$element = $element;
    $ctrl.element = $ctrl.$element[0];

    $ctrl.changedFields = ['src', 'materialVersion'];

    $ctrl.updateOptions = updateOptions;
    $ctrl.onVjsVideoReady = onVjsVideoReady;
    $ctrl.$onInit = $onInit;
    $ctrl.$onChanges = $onChanges;
    $ctrl.$onDestroy = $onDestroy;

    function $onInit() {
        $ctrl.materialContainer =  $ctrl.element.querySelector('.material-content');
        $ctrl.preloaderCenter =  $ctrl.element.querySelector('.preloader-center');
    }

    function $onChanges(changes) {
        if (!changes) {
            return;
        }
        console.log(changes);
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                togglePreloader(true);
                reload();
                break;
            }
        }
    }

    function reload(){
        $ctrl.optionsStr = updateOptions($ctrl.src);
    }

    function updateOptions(src) {
        var options = _.extend({src: src}, $ctrl.options||{});

        if($ctrl.materialVersion){
            var metadata = $ctrl.materialVersion.metadata;
            options.width = metadata && metadata.width ? metadata.width : 640;
            options.height = metadata && metadata.height ? metadata.height : 264;
            options.ratio = options.width + ':' + options.height;
            options.setup = { //data-setup attribute video.js
                loop: true
            };
            options.media = {
                sources: [{
                    src: options.src,
                    type: $ctrl.materialVersion.mimeType
                }],
                /*tracks: [
                    {
                        kind: 'subtitles',
                        label: 'English subtitles',
                        src: 'assets/subtitles.vtt',
                        srclang: 'en',
                        default: true
                    }
                ],*/
                // poster: 'images/screen.jpg'
            };
        } else{
            options.media = {
                sources: [{
                    src: options.src,
                }]
            }
        }
        return JSON.stringify($ctrl.options);
    }

    function onVjsVideoReady(e, data) {
        //data contains `id`, `vid`, `player` and `controlBar`
        //NOTE: vid is depricated, use player instead
        //overwriteButtons(data.player, data.controlBar);
        togglePreloader(false);
    }

    function $onDestroy() {
    }

    function togglePreloader(isOn) {
        $ctrl.LCS[isOn?'addClass':'removeClass']($ctrl.materialContainer, 'sb-hide');
        $ctrl.LCS[isOn?'removeClass':'addClass']($ctrl.preloaderCenter, 'sb-hide');
    }
}
