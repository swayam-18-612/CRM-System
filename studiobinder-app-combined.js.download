]);

angular.module('services.cookies', [
    'ngKookies',
    'services.SBMachineIdService'
])
.service('CookiesService', CookiesServiceFactory);

CookiesServiceFactory.$inject = ['API_CONFIGS','$kookies', '$window', 'SBMachineIdService'];
function CookiesServiceFactory(API_CONFIGS, $kookies, $window, SBMachineIdService) {
    var configs = API_CONFIGS();
    var actualSessionCookieName = configs.server.cookieName + '-' + (configs.server.cookieFingerprint ? (getFingerprintTimestamp() + '-') : '');
    $kookies.remove('name', {path: '/'}); // true
    var params = {path: '/', secure: configs.server.cookieSSL};

    var cookiesService = {
        actualSessionCookieName: actualSessionCookieName,
        collabToken: {},
        getPayload: getPayload,
        removeCookieByKey: removeCookieByKey,
        removeCookie: removeCookie,
        setCookie: setCookie,
        getCookie: getCookie,
        clearCookies: clearCookies,
        getSessionCookieUser: getSessionCookieUser,
        setSessionCookieUser: setSessionCookieUser,
        setAuthorizationHeader: setAuthorizationHeader,
        isValidToken: isValidToken,
        isAuthenticatedUser: isAuthenticatedUser,
        isFingerprintTimestamp: isFingerprintTimestamp
    };

    return cookiesService;

    function getFingerprintTimestamp() {
        return fingerprintTimestamp;
    }

    function isFingerprintTimestamp(val) {
        try {
            var fc = parseInt(getFingerprintTimestamp(),10),
                fs = parseInt(val,10);
            console.log('client side: ' + fc + '; server side: '+fs);
            return fc === fs || fc > fs;
        } catch (e) {
            return false;
        }
    }

    function isValidToken(token, user) {
        var content = getPayload(token);
        if (content != null && user != null) {
            return content._id === user._id && Math.round(new Date().getTime() / 1000) <= content.exp;
        }
        return false;
    }

    function getPayload(token) {
        if (token && token.split('.').length === 3) {
            var base64Url = token.split('.')[1];
            var base64 = base64Url.replace('-', '+').replace('_', '/');
            return JSON.parse($window.atob(base64));
        }
        return null;
    }

    function removeCookieByKey(key) {
        $kookies.remove(key, {path: '/'});
        $kookies.remove(key, params);
    }

    function removeCookie(key) {
        $kookies.remove(actualSessionCookieName + key, params);
    }

    function setCookie(key, value, json) {
        $kookies.set(actualSessionCookieName + key, encrypt(value, json), params);
    }

    function encrypt(val, json) {
        return val && val !== null ?
            encodeURIComponent(json ? JSON.stringify(val) : val)
            : null;
    }

    function decrypt(val, json) {
        return val && val != null && val !== "null" ?
            json ? JSON.parse(decodeURIComponent(val)) : decodeURIComponent(val)
            : null;
    }

    function getCookie(key, json) {
        return decrypt($kookies.get(actualSessionCookieName + key), json);
    }

    function clearCookies() {
        var cookies = document.cookie ? document.cookie.split(';') : null,
            tmp, tmpName;
        if(cookies) {
            for (var i = 1; i <= cookies.length; i++) {
                tmp = cookies[i - 1].split('=');
                tmpName = decodeURIComponent(tmp[0].trim());
                if (tmpName.indexOf(configs.server.cookieName) !== -1) {
                    removeCookieByKey(tmpName);
                }
            }
        }
    }

    function getSessionCookieUser() {
        return getCookie('user', true);
    }

    function setSessionCookieUser(val) {
      //  console.log('setSessionCookieUser');
      //  console.log(val);
        setCookie('user', val, true);
    }

    function setAuthorizationHeader(headers) {
        if (!headers) {
            headers = {};
        }
        var token, role = 0;
        try {
            role = parseInt(headers['x-role'], 10);
        } catch (e) {
        }

        if (role > 1) {//if is not collaborator
            token = getCookie('token');
        }//if is   collaborator
        else {
            var teamId = headers['x-team-id'],
                invitationId = headers['x-invitation-id'];

            var v = teamId + (invitationId ? ('_' + invitationId) : '');
            if (v) {
                token = cookiesService.collabToken[v];
            }
        }
        if (token) {
            headers.Authorization = 'Bearer ' + token;
        }

        if(configs.sbApi && configs.sbApi.key) {
            headers["x-sb-key"] = configs.sbApi.key;
        }

        headers["x-sb-machine"] = SBMachineIdService.machine;

        return headers;
    }

    function isAuthenticatedUser() {
        return isValidToken(getCookie('token'), getSessionCookieUser());
    }
}

angular.module('httpMethodInterceptor.config', [
])
.config(httpMethodInterceptorConfig);
httpMethodInterceptorConfig.$inject = ['$httpProvider'];

function httpMethodInterceptorConfig($httpProvider) {
    $httpProvider.interceptors.unshift('httpMethodInterceptor');
}

/**
 * Http method interceptor. Broadcast events for show or hide the loader.
 */
angular.module('httpMethodInterceptor.provider', [
])
.provider('httpMethodInterceptor', httpMethodInterceptorProvider);
httpMethodInterceptorProvider.$inject = []
function httpMethodInterceptorProvider() {
    var domains = [],
       loadingMethods = ['PUT'],
        whitelistLocalRequests = false;

    /**
     * Add domains to the white list
     *
     * @param {string} domain
     * Added Domain to the white list domains collection
     */
    this.whitelistDomain = function (domain) {
        domains.push(domain);
    };

    /**
     * White list requests to the local domain
     */
    this.whitelistLocalRequests = function () {
        whitelistLocalRequests = true;
    };

    this.$get = ['$q', 'RootEventsService',
        function ($q, RootEventsService) {
            /**
             * Check if the url domain is on the whitelist
             *
             * @param {string} url
             *
             * @returns {boolean}
             */

            /**
             * Emit hide loader logic
             *
             * @param {object} config
             * The response configuration
             */

            return {
                /**
                 * Broadcast the loader show event
                 *
                 * @param {object} config
                 *
                 * @returns {object|Promise}
                 */
                request: function (config) {
                    checkAndHide (true, config);
                    return config || $q.when(config);
                },

                /**
                 * Broadcast the loader hide event
                 *
                 * @param {object} response
                 *
                 * @returns {object|Promise}
                 */
                response: function (response) {
                    hideLoader(response);
                    return response || $q.when(response);
                },

                /**
                 * Handle errors
                 *
                 * @param {object} response
                 *
                 * @returns {Promise}
                 */
                responseError: function (response) {
                    hideLoader(response);
                    return $q.reject(response);
                }
            };

            function hideLoader(response) {
                if(response){checkAndHide(false, response.config);}
            }
            function isOnDocument(headers) {
                return headers&&(headers['x-collection'] === "documentVersions"&&headers['x-page'] === "user.product.document");
            }

            function isOnBreakdowns(headers) {
                return headers&&(headers['x-collection'] === "strips"&&headers['x-page'] === "user.product.breakdown");
            }
            function isUrlOnWhitelist (url) {
                if (url.substring(0, 2) !== '//' &&
                    url.indexOf('://') === -1 &&
                    whitelistLocalRequests) {
                    return true;
                }

                for (var i = domains.length; i--;) {
                    if (url.indexOf(domains[i]) !== -1) {
                        return true;
                    }
                }

                return false;
            }

            function checkAndHide(show, config) {
                if(!config){return;}
                var name = config.headers ? config.headers['x-transaction-id'] : null;
                if (loadingMethods.indexOf(config.method.toUpperCase())!==-1 &&
                    isUrlOnWhitelist(config.url) &&
                    !isOnDocument(config.headers) &&
                    !isOnBreakdowns(config.headers
                    )){
                    RootEventsService.broadcastRoot('HTTP_LOADER',  {
                        show:  show,
                        method: config.method,
                        name:   name ? name.toString() : null
                    });

                }
              /*  if(config.file && config.headers['Content-Type'] === undefined){
                   delete config.headers['Content-Type'];
                }*/
            }
        }
    ];

}

angular.module('httpMethodInterceptor.spinner.component', [
    'httpMethodInterceptor.service'
])
.component('httpSpinner', {
    bindings: {
        title:'@?',
        name: '@?'
    },
    template: '<div ng-show="$ctrl.show" class="onupdating fade-in"><span ng-bind="::$ctrl.title"></span></div>' ,
    controller: 'HttpSpinnerCtrl'
}) 
.controller('HttpSpinnerCtrl', HttpSpinnerCtrl);
HttpSpinnerCtrl.$inject = ['$element', 'httpSpinnerService'];
function HttpSpinnerCtrl($element, httpSpinnerService) {
    var $ctrl = this;

    $ctrl.$onInit = $onInit;
    $ctrl.$onDestroy = $onDestroy;

    function $onInit() {
        $ctrl.onInit();
    }

    function $onDestroy() {
        $ctrl.onDestroy();
    }

    $ctrl.httpSpinnerService = httpSpinnerService;

    $ctrl.$element = $element;

    $ctrl.onInit = onInit;
    $ctrl.onDestroy = onDestroy;

    function onInit() {
        if($ctrl.show === undefined){
            $ctrl.show = true;
        }
        // Register this spinner with the spinner service.
        $ctrl.httpSpinnerService._register( {
            name: $ctrl.name,
            show: function () {
                $ctrl.show = true;
            },
            hide: function () {
               // console.log('HttpSpinnerCtrl: hide');
                $ctrl.show = false;
                $ctrl.onDestroy();
            }
        });
    }

    function onDestroy() {
        $ctrl.httpSpinnerService._unregister($ctrl.name);
        $ctrl.$element.remove();
    }
}


angular.module('httpMethodInterceptor.service', [
])
.service('httpSpinnerService', httpSpinnerService);
function httpSpinnerService() {
    var spinners = {};

    var service = {
        methods: ['PUT'],
        _register: _register,
        _unregister: _unregister,
        _unregisterGroup: _unregisterGroup,
        _unregisterAll: _unregisterAll,
        show: show,
        hide: hide,
        showGroup: showGroup,
        hideGroup: hideGroup,
        showAll: showAll,
        hideAll: hideAll,
        isRegistered: isRegistered,
        processSpinner: processSpinner
    };

    return service;

    function processSpinner(config) {
        if(!config.name){return;}
        var isRegistered = service.isRegistered(config.name);
        if(show) {
            if(!isRegistered) {
                reload(config.name);
            }
        }else {
            service.hide(config.name);
        }
    }
    function isRegistered(name) {
        return spinners[name]!== undefined && spinners[name]!==null;
    }
    function _register(data) {
        if (!data.hasOwnProperty('name')) {
            throw new Error("Spinner must specify a name when registering with the spinner service.");
        }
        spinners[data.name] = data;
    }

    function _unregister(name) {
        if (spinners.hasOwnProperty(name)) {
            delete spinners[name];
        }
    }

    function _unregisterGroup(group) {
        for (var name in spinners) {
            if (spinners[name].group === group) {
                delete spinners[name];
            }
        }
    }

    function _unregisterAll() {
        for (var name in spinners) {
            delete spinners[name];
        }
    }

    function show(name) {
        var spinner = spinners[name];
        if (spinner){spinner.show();}
        else {console.log("No spinner named '" + name + "' is registered.");}
    }

    function hide(name) {
        var spinner = spinners[name];
        if (spinner){spinner.hide();}
        else {console.log("No spinner named '" + name + "' is registered.");}
    }

    function showGroup(group) {
        var groupExists = false;
        for (var name in spinners) {
            var spinner = spinners[name];
            if (spinner.group === group) {
                spinner.show();
                groupExists = true;
            }
        }
        if (!groupExists) {console.log("No spinners found with group '" + group + "'.");}
    }

    function hideGroup(group) {
        var groupExists = false;
        for (var name in spinners) {
            var spinner = spinners[name];
            if (spinner.group === group) {
                spinner.hide();
                groupExists = true;
            }
        }
        if (!groupExists) {console.log("No spinners found with group '" + group + "'.");}
    }

    function showAll() {
        for (var name in spinners) {
            spinners[name].show();
        }
    }

    function  hideAll() {
        for (var name in spinners) {
            spinners[name].hide();
        }
    }
}

angular.module('httpMethodInterceptor.httpSpinners.component', [
    'httpMethodInterceptor.spinner.component'
])
.component('httpLoaders', {
    /**
     * Available attributes
     *
     * @param {array|string} methods
     * @param {string} template
     * @param {string} title
     * @param {number} time to live in seconds
     */
    template: '<div id="http_loaders" class="http-loader__wrapper"></div>',
    controller: 'HttpSpinnersCtrl'
})

.controller('HttpSpinnersCtrl', HttpSpinnersCtrl);

HttpSpinnersCtrl.$inject = ['RootEventsService', 'TemplateCompileService', 'httpSpinnerService', '$element'];

function HttpSpinnersCtrl(RootEventsService, TemplateCompileService, httpSpinnerService, $element ) {
    var $ctrl = this;

    $ctrl.$onInit = $onInit;
    $ctrl.$onDestroy = $onDestroy;

    function $onInit() {
        $ctrl.onInit();
    }

    function $onDestroy() {
        $ctrl.onDestroy();
    }

    $ctrl.RootEventsService = RootEventsService;
    $ctrl.TemplateCompileService = TemplateCompileService;
    $ctrl.httpSpinnerService = httpSpinnerService;

    $ctrl.$element = $element;
    $ctrl.element = $ctrl.$element[0];

    var watchers = [];
    var title = 'Saving…';

    $ctrl.onInit = onInit;
    $ctrl.onDestroy = onDestroy;

    $ctrl.getItemTemplate = getItemTemplate;

    function onInit() {
        $ctrl.methods = $ctrl.httpSpinnerService.methods;
        $ctrl.$container = $ctrl.$element.find('#http_loaders');

        setMethods($ctrl.methods);
        $ctrl.RootEventsService.addRootWatcher(watchers, 'HTTP_LOADER', onHttpLoader);
    }

    function onHttpLoader( config) {
        if(!config.name){return;}
        //console.log('toggleShowLoader: show: ' + config.show +'; name: ' + config.name);
        var isRegistered = $ctrl.httpSpinnerService.isRegistered(config.name);
        if(!config.show) {
            $ctrl.httpSpinnerService.hide(config.name);
        }else if(!isRegistered) {
            reload(config.name);
        }
    }

    function reload(name) {
        if(!$ctrl.templateCompile) {
            $ctrl.templateCompile = new $ctrl.TemplateCompileService($ctrl.$container, $ctrl.getItemTemplate, $ctrl);
        }
        $ctrl.templateCompile.loadTemplate(onLoaded, {
            name: name
        });

        function onLoaded() {
            //console.log('spinner loaded');
        }
    }

    function getItemTemplate() {
        return "<http-spinner name='{{::$ctrl.name}}' title='"+title+"'></http-spinner>";
    }

    function setMethods(methods) {
        methods = angular.isUndefined(methods) ? [] : methods;
        methods = angular.isArray(methods) ? methods : [methods];

        _.each(methods, function (method, index) {
            methods[index] = method.toUpperCase();
        });

        if (!Array.prototype.indexOf) {
            methods.indexOf = function (value) {
                for (var i = this.length; i--;) {
                    if (this[i] === value) {
                        return i;
                    }
                }

                return -1;
            };
        }
    }

    function onDestroy() {
        $ctrl.RootEventsService.removeWatchers(watchers);

        if($ctrl.templateCompile){
            $ctrl.templateCompile.destroyNewScope();
        }
    }
}

