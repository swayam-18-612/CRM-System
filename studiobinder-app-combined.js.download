MoodboardsPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'MoodboardsPageCtrlServiceInjectors'];
function MoodboardsPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    return function ($ctrl, $element, printPageParams) {
        console.log('MoodboardsPageCtrlService');

        $ctrl.viewFilters = 'columnsLayout';

        //$ctrl.withDrpAdd = true;
        //$ctrl.withoutPreviewScene = true;

        $ctrl.getSidebarAddon = getSidebarAddon;
        $ctrl.checkShowAddNewItem = checkShowAddNewItem;
        $ctrl.getCustomizeHideCond = getCustomizeHideCond;
        $ctrl.getRightButtons = getRightButtons;
        $ctrl.getCollabBannerInfo = getCollabBannerInfo;
        $ctrl.getPageTreeListPopupExtraParam = getPageTreeListPopupExtraParam;
        $ctrl.getGroupFilters = getGroupFilters;

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);

        return $ctrl;

        function getGroupFilters(isDisplay) {
            return $ctrl.withTreeDisplayCount && isDisplay ? {type: 1} : null;
        }

        function getPageTreeListPopupExtraParam(){
            return {
                selectCustomColor: true,
                withBgColor : true
               // quotaTypeLayout: 'workflowLayout'
            }
        }

        function getCollabBannerInfo(){
            return {txt: 'Create and share your own mood boards for free.', campaign:'collab-moodboards'};
        }

        function getCustomizeHideCond(){
            return true;
        }

        function getSidebarAddon() {
           return 'on-get-drp-selected-filters="$ctrl.getDrpSelectedFilters(filter)" ';
        }

        function checkShowAddNewItem(){
            return false;
        }

        function getRightButtons() {
            return $ctrl.canEdit ? ('<a class="hide-ipad btn btn-small primary-faded with-margin-left inline-block without-text pull-right ' + $ctrl.getBtnActionCls() +'" data-type="createFromTop" data-info="2" analytics-on analytics-action="Add Text Box" tooltip-placement="bottom" tooltip="Add Text Box">' + $ctrl.LCS.getISBDiv('plus') + '</a>') :'';
        }
    }
}

