])
 .service('CallsheetInvitationsLoadingService', CallsheetInvitationsLoadingService);

CallsheetInvitationsLoadingService.$inject = ['PreloadingResourceService', 'CallsheetInvitationsService', 'ContactsLoadingService'];
function CallsheetInvitationsLoadingService(PreloadingResourceService, objectService, ContactsLoadingService) {
    var _this = new PreloadingResourceService(objectService, {
        name: 'CallsheetInvitations',
        tableParamsColsInit: ['companyId', 'productId', 'callsheetId'],
        preloadPopulate: 'callsheetInvitationSentId'
    });

    _this.updateItem = updateItem;
    _this.getPreById = getPreById;

    _this.advancedGroupFilters = advancedGroupFilters;
    return _this;

    function updateItem(tableParams, el) {
        var ni = _.extend({_id: el._id}, getUpdatedItem(tableParams, el));
        return _this.service.updateItem(tableParams, _this.tableType, ni);
    }

    function getPreById(tableParams, id, settings) {
        var item = _this.service.getObjectById(tableParams, _this.tableType, id);
        return getUpdatedItem(tableParams, item);
    }

    function getUpdatedItem (tableParams, item) {
        if(!item){return null;}
        var prop = 'castId';
        item.cast = item[prop] ? ContactsLoadingService.getById(tableParams, item[prop]) : null;
        return item;
    }

    function advancedGroupFilters(groupFilters, type, tableParams){
        return ContactsLoadingService.objectService.getContactsByTable(groupFilters, type, tableParams);
    }
}

addMoSePa('CallsheetInvitations', 'callsheetInvitations', TempCallsheetInvitationsService,{
    modelMethod: CallsheetInvitationsFactory,
    serviceInjectList: ['ResourcePathsService', 'CallsheetsSent', 'Products','Callsheets','CallsheetInvitationsSent', 'Contacts'],
    serviceInjectMod: [
        'resources.Callsheets',
        'resources.CallsheetInvitationsSent',
        'resources.Contacts',
        'resources.Products'
    ]
});

function CallsheetInvitationsFactory(ApiResource) {
    var model = ApiResource(SBApiCollections.CallsheetInvitations);

    model.prototype.getName = function () {
        return this.cast ? ( this.cast.name ? this.cast.name : this.cast.email) : null;
    };

    return model;
}

function TempCallsheetInvitationsService(ApiService, model, ResourcePathsService, CallsheetsSent, Products,Callsheets, CallsheetInvitationsSent, Contacts) {

    var service = ApiService(model, {
        convertOtherResources: convertOtherResources,
        listType: 'isGroup',
        listField: 'contactListId',
        withCallsheetId: true,
        fieldsUpdatedOnOrderChanged: ['orderLists']
    });

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.getEditableFields = getEditableFields;

    service.insertRecipients = insertRecipients;
    service.confirmCalltime = confirmCalltime;
    service.customizeRecipientsBulk = customizeRecipientsBulk;
    service.resendInvitesBulk = resendInvitesBulk;
    service.resendInvite = resendInvite;
    service.getType = getType;
    service.getItemRoles = getItemRoles;

    return service;
    function getEditableFields(){
        return ['name', 'profilePictureURL', 'phone', 'email', 'roles', 'calltime', 'personalNote', 'showDetails',
            'info.pickup', 'info.onset','info.costumes','info.hmu', 'info.mupw','info.wrap',
            'info.status','info.no', 'info.note'];
    }
    function getChangedFieldForUpdateOther() {
        return ['calltime', 'roles', 'personalNote', 'showDetails',
            'info.pickup', 'info.onset', 'info.costumes','info.hmu', 'info.mupw', 'info.wrap',
            'info.status','info.no', 'info.note',
            'orderLists',
            'profilePictureURLId', 'profilePictureURL', 'name', 'email', 'phone'];
    }

    function getItemRoles(item) {
        if (!item.roles) item.roles = [];
        return item.roles;
    }

    function getType() {
        return 'recipient';
    }

    function convertOtherResources(item) {
        if (item.productId && typeof (item.productId) === 'object') {
            item.product = new Products(item.productId);
            item.productId = item.productId._id;
        }
        if (item.callsheetId && typeof (item.callsheetId) === 'object') {
            item.callsheet = new Callsheets(item.callsheetId);
            item.callsheetId = item.callsheetId._id;
        }
        var cast = item.castId;
        if (cast && typeof (cast) === 'object') {
            item.cast = new Contacts(cast);
            item.castId = cast._id;

            item.name = cast.name;
            item.email = cast.email;
            item.phone = cast.phone;
        }
        var sentInvite = item.callsheetInvitationSentId;
        if (sentInvite && typeof (sentInvite) === 'object') {
            item.callsheetInvitationSent = new CallsheetInvitationsSent(sentInvite);
            item.callsheetInvitationSentId = sentInvite._id;
            item.status = sentInvite.status;
        }

        return item;
    }

    function insertRecipients(callsheet, castIds, successcb, errorcb) {
        var cast = [];
        for (var i = 0, l = castIds.length; i < l; i++) {
            var exists = false;
            for (var j = 0, m = cast.length; j < m; j++) {
                if (castIds[i] === cast[j]) {
                    exists = true;
                    break;
                }
            }
            if (!exists) {
                var el = castIds[j];
                cast.push(el.id ? el.id : el);
            }
        }

        var params = {
            castIds: cast,
            productId: callsheet.productId,
            companyId: callsheet.companyId,
            callsheetId: callsheet._id
        };

        return service.$post(ResourcePathsService.getCallsheetPath(params) +'/insert-recipients', params, successcb, errorcb, true);
    }

    function confirmCalltime(params, successcb, errorcb) {
        return service.$post(ResourcePathsService.getCallsheetPath(params) +'/confirm-calltime/' + params.invitationId, params, successcb, errorcb);
    }

    function customizeRecipientsBulk(params, successcb, errorcb) {
        return service.$post(ResourcePathsService.getCallsheetPath(params) +'/customize-recipients', params, successcb, errorcb);
    }

    function onsuccess(res, successcb) {
        if (res.callsheetSent) {
            res.callsheetSent = new CallsheetsSent(res.callsheetSent);
        }
        var invites = res.invites;

        if (invites && invites.length > 0) {
            for (var i = 0, l = invites.length; i < l; i++) {
                res.invites[i] = service.convertResource(invites[i]);
            }
        }
        return successcb(res);
    }

    function resendInvite(sendGeneratorRequest, send, successcb, errorcb) {
        resendInvitesBulk(sendGeneratorRequest, send, {
            productId: send.productId,
            companyId: send.companyId,
            callsheetId: send.callsheetId,
            inviteIds: [send._id]
        }, successcb, errorcb);
    }

    function resendInvitesBulk(sendGeneratorRequest, send, params, successcb, errorcb) {
        _.each(['cc', 'sms', 'dontSendConfirmToSender', 'resetConf'], function (p){
            if (send[p]) {
                params[p] = send[p];
            }
        });
        if (send.addNote && send.updateNote) {
            params.updateNote = send.updateNote;
        }

        sendGeneratorRequest('/callsheets/resend-invites', params, function (res) {
            onsuccess(res, successcb);
        }, errorcb, false);
    }
}

