        /*var info = $ctrl.getDisplayValue($ctrl.value);
        $ctrl.spanText.innerHTML = info.content || info.placeholder;
        $ctrl.LCS[info.hasPlaceholderCls ? 'addClass' : 'removeClass']($ctrl.spanText, 'empty');
        */
    }

    function generateDrpMenuContent() {
        return {
            $ctrl: {
                list: _.filter($ctrl.initList, function (item){return item;}),
                value: angular.copy($ctrl.value),
                onSelect: $ctrl.onSelect,
                drpClassAttr: $ctrl.drpClassAttr
            },
            template: ($ctrl.fixedHeight ? ("fixed-height='true' ") : '') +
                "list='::$ctrl.list' " +
                "value='::$ctrl.value' " +
                ($ctrl.valueField ? ("value-field='" + $ctrl.valueField + "' ") : '') +
                ($ctrl.labelField ? ("label-field='" + $ctrl.labelField + "' ") : '') +
                "on-select='$ctrl.onSelect(result)' "
        };
    }
}


function sbFieldComponentParams(controllerName, bindings, template) {
    var el = {
        bindings: _.extend({
           // popoverContainer: '@',
           // parentContainer: '@',

            value: '<',
            service: '<',
            elemType: '<',

            elementId: '@',
            quotaType: '@',

            onValidation: '&',
            onChange: '&',
            onChangeOther: '&',
            onCancel: '&'
        }, bindings ? bindings : null)
    };
    if (template) {
        el.template = template;
    }

    if (controllerName) {
        el.controller = controllerName;
    }
    return el;
}

