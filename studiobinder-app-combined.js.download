angular.module('app.angularitycs', [ ])
    .config(AngularyticsConfigS)
    .run(AngularyticsProviderS);

AngularyticsConfigS.$inject = ['API_CONFIGS', 'AngularyticsProvider'];
AngularyticsProviderS.$inject = ['Angularytics'];

function AngularyticsConfigS(API_CONFIGS, AngularyticsProvider) {
    var configs = API_CONFIGS();
    var apps = ['GA4' //'Console', 'GoogleUniversal',

     ];
    if(configs.intercom && configs.intercom.enabled) {apps.push('Intercom');}
    if(configs.hotjar && configs.hotjar.enabled) {apps.push('Hotjar');}
    AngularyticsProvider.setEventHandlers(apps);
}

function AngularyticsProviderS(Angularytics) {
    Angularytics.init();
}

angular.module('app.http.provider', [ ])
.config(HTTPProviderS)// add cors support
.config(InterceptorProviderS)
.config(CompileProviderS);

HTTPProviderS.$inject = ['$httpProvider'];
InterceptorProviderS.$inject = ['httpMethodInterceptorProvider', 'API_CONFIGS'];
CompileProviderS.$inject = ['$compileProvider', 'API_CONFIGS'];

function HTTPProviderS($httpProvider) {
    $httpProvider.defaults.useXDomain = true;
    $httpProvider.useLegacyPromiseExtensions = false;
    delete $httpProvider.defaults.headers.common['X-Requested-With'];
}

function InterceptorProviderS(httpMethodInterceptorProvider, API_CONFIGS) {
    httpMethodInterceptorProvider.whitelistDomain(API_CONFIGS().staticDomain);
    httpMethodInterceptorProvider.whitelistLocalRequests();
}

function CompileProviderS($compileProvider,API_CONFIGS ) {
    $compileProvider.aHrefSanitizationWhitelist(/^\s*(https?|ftp|mailto|chrome-extension|tel|imessage|sms|blob:chrome-extension|svg):/);
    $compileProvider.commentDirectivesEnabled(false);
    $compileProvider.cssClassDirectivesEnabled(false);

    var configs = API_CONFIGS();
    $compileProvider.debugInfoEnabled(configs.debugger && configs.debugger.enabled);
    //If you wish to debug an application with this information then you should open up a debug console in the browser then call this method directly in this console:
    //angular.reloadWithDebugInfo();
}


// Configure your $intercom module with appID
angular.module('app.intercom.provider', [
    'ngIntercom'
])
.config(IntercomProviderS);
IntercomProviderS.$inject = ['$intercomProvider', 'API_CONFIGS'];
function IntercomProviderS($intercomProvider, API_CONFIGS) {
    $intercomProvider.appID(API_CONFIGS().intercom.appId);
}
angular.module('app.translate.provider', [
    'pascalprecht.translate'
])
.config(TranslateProviderS);
TranslateProviderS.$inject = ['$translateProvider'];
function TranslateProviderS($translateProvider) {
     // Register a loader for the static files
     // So, the module will search missing translation tables under the specified urls.
     // Those urls are [prefix][langKey][suffix].
     $translateProvider.useStaticFilesLoader({
         prefix: 'l10n/',
         suffix: '.js'
     });
     // Tell the module what language to use by default
     $translateProvider.preferredLanguage('en');
     // Tell the module to store the language in the local storage
     $translateProvider.useLocalStorage();
 }

