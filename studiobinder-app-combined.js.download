            canCopy: true,
            canMove: true
        },

        PopupOperations = {
            createTodoColumn: {
                type: 'Create',
                template: getBasePopupTemplateByTag('todo-column-edit'),
                size: 'medium'
            },

            updateTodoColumn: {
                type: 'Edit',
                template: getBasePopupTemplateByTag('todo-column-edit'),
                size: 'medium'
            },
        },

        Hotkeys = null,

        SidebarOptions = {
            addGroupPopupName: 'createTodoColumn',
            editGroupPopupName: 'updateTodoColumn',
            removeAdditionalMessage: ' and all the task cards within it',
        };

    return {
        Settings: Settings,
        Options: Options,
        Filters: {
            Filters: Filters,
            TasksFilters: TasksFilters,
            TabTasks: TabTasks
        },
        ViewProp: 'taskcardView',
        Colors: SBFieldTypesService.SBFieldMethods.ColumnsColors,

        CompOptions: CompOptions,
        ListTreeServiceParams: ListTreeServiceParams,
        ListParams: ListParams,
        KeyboardServiceParams: KeyboardServiceParams,

        PopupOperations: PopupOperations,
        Hotkeys: Hotkeys,
        SidebarOptions: SidebarOptions,
    };
}

angular.module('product.workflow.group.component',[
    'group.controller.service',
    'product.workflow.item.grid.component',
    'product.workflow.group.component.service'
])
.component('taskcardGroup', treeGroupComponentParams( 'TaskcardGroupCtrl', {
    isInModal: '@',
    isScriptPage: '@',
    pictureClass: '@',
    fixApply: '@',
    fixParentName: '@',
    fixOffset: '@',
    fixAddBtn: '@',

    isTaskBoards: '<?',
    taskBoardId: '<?',
    taskBoard: '<?',

    rowLoadNow: '<',
    scrollableParent: '<?',
    scrollClientY: '<?',
    canSetList: '<', // used to set list for comments sidebar
    isChildTable: '<', //for drag and drop reordering
    onListItemsQuery: '&',
    onLoaded: '&',

    commentGroup: '<',
    toggleEnterComment: '&'
}))
.controller('TaskcardGroupCtrl',TaskcardGroupCtrl);
TaskcardGroupCtrl.$inject = ['TaskcardGroupCtrlService', 'TreeGroupInitCtrlService', '$element'];
function TaskcardGroupCtrl(GroupCtrlService, TreeGroupInitCtrlService, $element) {
    var $ctrl = this;

    $ctrl.GroupCtrlService = GroupCtrlService;

    $ctrl.scrollClientY = 217;
    $ctrl.scrollBy = 30;
    $ctrl.scrollInterval = 70;
    $ctrl.scrollTollerance = 10;

    $ctrl.$onInit = $onInit;
    $ctrl.getGroupTemplate = getGroupTemplate;

    $ctrl = new $ctrl.GroupCtrlService($ctrl);

    function $onInit() {
        $ctrl.onInit();

        $ctrl.getGridItemTemplate = getGridItemTemplate;

        $ctrl = new TreeGroupInitCtrlService($ctrl, $element, $ctrl.Pagination, false);
    }

    function getGridItemTemplate(item) {
        // console.log('TaskcardGroupCtrl.getGridItemTemplate');
        return $ctrl.TodoCardGridItemInitCtrlService.getGridItemTemplate(item, $ctrl);
    }

    function getGroupTemplate() {
        return $ctrl.getTasksGroupTemplate();
    }
}

angular.module('product.workflow.group.component.service',[
    'apiPagination.TodoCards',
    'services.blocksSetup',
    'list.base.component.service',
    'product.workflow.item.init.controller.service'
]) 
.service('TaskcardGroupCtrlService',TaskcardGroupCtrlService);
TaskcardGroupCtrlService.$inject = ['CompInitCtrlService', 'TodoCardsPagination', 'BlocksSetupService', 'TodoCardGridItemInitCtrlService'];
function TaskcardGroupCtrlService(CompInitCtrlService, Pagination, BlocksSetupService, TodoCardGridItemInitCtrlService) {
    return function ($ctrl) {


        var debugNewCard = false;

        $ctrl.CompInitCtrlService = CompInitCtrlService;
        $ctrl.BlocksSetupService = BlocksSetupService;
        $ctrl.TodoCardGridItemInitCtrlService = TodoCardGridItemInitCtrlService;
        $ctrl.Pagination = Pagination;

        $ctrl = new $ctrl.CompInitCtrlService($ctrl, true, true);

        $ctrl.info = {};
        $ctrl.search = null;
        $ctrl.dontNotify = true;
        $ctrl.withoutMultiSelect = true;
        $ctrl.gridItemClass = 'taskcard-item-grid';
        $ctrl.scrollwrapperCls = 'workflow-cards-scroll-wrapper';

        // item methods
        $ctrl.getGroupAdd = getGroupAdd;
        if(!$ctrl.getGroupEmpty) {
            $ctrl.getGroupEmpty = getGroupEmpty;
        }
        $ctrl.getGroupItemAttributes = getGroupItemAttributes;
        if(!$ctrl.preloadSettings) {
            $ctrl.preloadSettings = preloadSettings;
        }
        $ctrl.getEditPopupParams = getEditPopupParams;
        $ctrl.getNewPopupParamsOther = getNewPopupParamsOther;
        $ctrl.getNewParams = getNewParams;
        $ctrl.changeStatus = changeStatus;
        $ctrl.onPreloadGroup = onPreloadGroup;
        $ctrl.onPostloadGroup = onPostloadGroup;
        $ctrl.canMove = canMove;
        $ctrl.afterProcessUpdates = afterProcessUpdates;
        $ctrl.afterProcessUpdatesOther = afterProcessUpdatesOther;
        $ctrl.onClipboardProcessingSuccess = onClipboardProcessingSuccess;
        $ctrl.setGroupCounter = setGroupCounter;
        $ctrl.toggleEnterComment1 = toggleEnterComment1;

        $ctrl.editComment = editComment;
        $ctrl.getGroupQuota = getGroupQuota;
        $ctrl.getTasksGroupTemplate = getTasksGroupTemplate;

        if (!$ctrl.$onInit) {
            $ctrl.$onInit = onInit;
        }

        $ctrl.onInit = onInit;

        if(!$ctrl.getSelectedFilter) {
            $ctrl.getSelectedFilter = getSelectedFilter;
        }

        return $ctrl;

        function onInit() {
            $ctrl.teamIds = $ctrl.taskBoard ? $ctrl.taskBoard.teamIds : null;
            getCardsOptions();
            $ctrl.addBtnInside = $ctrl.fixAddBtn === 'inside';

            $ctrl.fixApply = $ctrl.fixApply && $ctrl.isLikeWorkflow && $ctrl.getSelectedFilter();
            $ctrl.isTasks = $ctrl.tabTasks !== 'comments';

            //$ctrl.quotaType = $ctrl.isTasks ? 'todoCards' : null;
            $ctrl.itemTitle = $ctrl.isTasks ? ($ctrl.isCalendarPage ? 'Event' : 'Task Card') : 'Comment';

            $ctrl.pageSize = $ctrl.isDashboard ? 3 : 1000;
            //   $ctrl.withProperty = withProperty;
//todo
            //  $ctrl = new TodoAddCardEventsService($ctrl);


            $ctrl.duplicate = duplicate;

            $ctrl.onAddedInline = onAddedInline;
            $ctrl.showNewCard = showNewCard;
            $ctrl.cancelNewCard = cancelNewCard;
            $ctrl.passesFilter = passesFilter;
            $ctrl.filterTodoCards = filterTodoCards;
            $ctrl.goToPage = goToPage;
            $ctrl.getClipboardProcessingParams = getClipboardProcessingParams;
            $ctrl.onUpdated = onUpdated;
            $ctrl.onAdded = onAdded;
            $ctrl.cloneItem = cloneItem;

            if ($ctrl.onListItemsQuery) {
                $ctrl.listItemsQuery = $ctrl.onListItemsQuery();
            }
        }

        function getTasksGroupTemplate() {
            if (!$ctrl.allLoaded) {
                return '<preloader-center class="preloader ' + ($ctrl.pageClass ? $ctrl.pageClass : '') + '"></preloader-center>';
            }
            var selectedFilter = $ctrl.getSelectedFilter();

            return getHeader() +
                //   (selectedFilter ? '' : getSearchField()) +
                '<div class="h-full todocardsloadedcontainer">' +
                $ctrl.getGroupEmpty() +
                getGroup() +
                '</div>';

            function getHeader() {
                var hasCommentGroup = hasCommentsGroup();
                var list = $ctrl.isDashboard ? $ctrl.currentList : (hasCommentGroup ? $ctrl.commentGroup.list : null);
                return list ? ('<div class="todo-column-title">' + (hasCommentGroup ? getCommentGroup(list) : getH(list)) + '</div>') : '';
            }

            function getH(list) {
                return (list.color ? ('<div class="todo-status-border circle-container-10" style="background-color:' + list.color + '"></div>') : '') +
                    '<div class="with-padding-left">' + list[($ctrl.listField === 'todoColumnId') ? 'name' : 'text'] + '</div>';
            }

            function getCommentGroup(c) {
                var itemTitle = $ctrl.uIdList && $ctrl.uIdList.itemTitle ? $ctrl.uIdList.itemTitle : 'Row';
                return c ? ('<div class="with-padding-left full-width shotnoprop bold">' + itemTitle + ' <span class="sb-prop-segNo" data-setup="' + c.setupId + '">' + c.segNo + '</span>.<span class="sb-prop-rowNo">' + c.rowNo + '</span></div>') : '';
            }

            function getGroup() {
        return '<div ng-show="(!' + $ctrl.isCommentsSidebar + ' || ' + $ctrl.isCommentsSidebar + '&&($ctrl.info.isOpened||!$ctrl.isTasks))&&$ctrl.list.items.length==0||$ctrl.list.items.length>0" class="' + $ctrl.groupListCls + ' clearfix todocardscontainer h-full">' +
                    '<div>' +
                        '<div class="fix-column-height scrollable-content">' +
                            $ctrl.getGroupAdd(true) +
                            '<div class="dd ' + $ctrl.groupWrapperName + ' todo-cards clearfix " ng-class="{\'without-min-height\': $ctrl.info.isOpened}"' +
                                /*'infinite-scroll="$ctrl.list.nextPage()"
                                infinite-scroll-disabled="$ctrl.list.busy || $ctrl.isDashboard"
                                 infinite-scroll-distance="1"' +*/
                            '>' +
                                '<div class="flex-wrap">' + $ctrl.getGroupItems() + '</div>' +
                                '<loading-more ng-if="$ctrl.list.busy"></loading-more>' +
                            '</div>' +
                            $ctrl.getGroupAdd(false) +
                            ($ctrl.addBtnInside ? getAddNewLink() : '') +
                        '</div>' +
                    '</div>' +
                    ($ctrl.addBtnInside ? '' : getAddNewLink()) +
                '</div>';
            }

            function getAddNewLink() {
                return (selectedFilter ? ('<div ng-show="!$ctrl.list.busy&&(' + (!$ctrl.isDashboard && $ctrl.canAddNew && $ctrl.isTasks) + '||' +
                    $ctrl.isDashboard + '&&$ctrl.list.items.length>0&&$ctrl.list.items.length<$ctrl.list.totalCount)" class="clearfix new-card-section">' +
                    ($ctrl.canAddNew && isActive() && $ctrl.isTasks ? getCircle($ctrl.fixApply) : '') +
                    ($ctrl.isDashboard ? ('<a ng-show=\'!$ctrl.list.busy && $ctrl.list.items.length < $ctrl.list.totalCount\' class="pull-right show-more with_underline" ng-click="$ctrl.list.nextPage()">Show More</a>') : '') +
                    '</div>') : '');
            }

            function getCircle(withText) {
                return '<a ng-class="{\'disabled\':$ctrl.info.isOpened}" ' +
                    'class="todo-card-add btn btn-small transparent justplus hide-print" data-type="showNewCard" analytics-on analytics-action="Add ' + $ctrl.itemTitle + '"' +
                    ' ng-click="!$ctrl.info.isOpened?$ctrl.showNewCard($event):null" ' +

                    '>' +
                    $ctrl.LCS.getISBDiv(withText ? 'plus' : 'plus-circled', 2, 'centered') +
                    (withText ? ('<span class="with-padding-left">Add ' + $ctrl.itemTitle + '</span>') : '') +
                    '</a>';
            }
        }
        function getGroupQuota() {
            return 'workflow';
        }

        function editComment(info, e) {
            console.log('editComment');
            if (info && info._id) {
                $ctrl.broadcastRoot('TRIGGER_COMMENT_EDIT_' + info._id);
            }
        }

        function setGroupCounter() {
            updateCount();
        }

        function cloneItem(item) {
            var item1 = item ? angular.copy(item) : item;

            item1.startDate = set(item.startDate);
            item1.dueDate = set(item.dueDate);

            return item1;

            function set(v) {
                return $ctrl.MomentService.getUtcMomentCopyWithTime(v);
            }
        }

        function afterProcessUpdates(result, initResult) {
            //is on tab tasks and
            if ($ctrl.isCommentsSidebar && initResult && initResult.eventType === 'archived' && $ctrl.tabTasks === 'archived') {
                console.log('tabTasks: ' + $ctrl.tabTasks + ' ' + $ctrl.currentListId);
                //result.
                var sId;
                try {
                    sId = initResult.updatesG.todoCards.add[0].todoColumnId;
                } catch (e) {
                }
                if (sId) {
                    $ctrl.broadcastRoot('ADDED_MULTIPLE_' + $ctrl.elemType + '_' + sId, {
                        updatesG: initResult.updatesG,
                        processMultiple: true
                    });
                }
            }

            if (typeof ($ctrl.afterProcessUpdatesOther) === 'function') {
                $ctrl.afterProcessUpdatesOther(result, initResult);
            }
        }

        function onTaskBoardTeamChanged(teamIds) {
            console.log('onTaskBoardTeamChanged');
            $ctrl.teamIds = teamIds;
            $ctrl.preloadSettings();
        }

        function onClipboardProcessingSuccess(opType, result) {
            console.log('onClipboardProcessingSuccess');
            if ($ctrl.tabTasks === 'tasks' && (
                opType === $ctrl.keyboardService.ActionTypes.Activate ||
                opType === $ctrl.keyboardService.ActionTypes.Archive)) {
                $ctrl.LCS.timeout(function () {
                    $ctrl.broadcastRoot('RELOAD_ARCHIVED_TREE_GROUPS');
                }, 1000);
            }
        }

        function canMove() {
            return $ctrl.keyboardService.canMove && !$ctrl.isCommentsSidebar;
        }

        function onUpdated(result) {
            console.log('onUpdated: ' + result.eventType + ' isinpopup: ' + $ctrl.isInModal);
            var item = result.item;
            if (result.eventType === 'Archive' || result.eventType === 'Activate' || result.eventType === 'Remove') {
                console.log('onArchiveCard ' + $ctrl.currentListId);
                var type = result.eventType;

                var selectedFilter = $ctrl.getSelectedFilter();
                if (result.item[$ctrl.listField] === $ctrl.currentListId && (type === 'Archive' && selectedFilter || type === 'Remove')) {
                    $ctrl.list.removeElement(item);
                }

                if (((type === 'Archive' && !selectedFilter) ||
                    (type === 'Activate' && $ctrl.currentListId === item[$ctrl.listField])) && !$ctrl.list.getElementById(item._id)) {
                    $ctrl.list.insertElementByOrder(item);
                }
            } else {
                if (item && item.isOnlyComment && result.editchanges.completed !== undefined) {
                    $ctrl.replaceElementProps(item._id, {completedAt: item.completedAt});
                }
                //if(item && !item.isOnlyComment && result.eventType === 'CHANGED_FIELD')

                if (result.eventType === 'CHANGED_FIELD' && (result.isAnswerAdded || result.isRemove) || result.eventType === 'Complete') {
                    updateForCommentsGroup(result.resultInit);
                }
            }
            updateCount();
        }

        function updateCount(count) {
            if ($ctrl.tabTasks === 'comments') {
                $ctrl.broadcastRoot('MATERIAL_VIEWER_UPDATE_COMMENTS_COUNT', {count: count !== undefined ? count : $ctrl.list.items.length});
            }
        }

        function getClipboardProcessingParams(params, extraParam) {
            var p = {listsField: $ctrl.listField, tabTasks: $ctrl.tabTasks};
            if ($ctrl.isCommentsSidebar) {
                var isTasks = $ctrl.tabTasks !== 'comments',
                    commentsGroups = !isTasks && hasCommentsGroup() && params.opType === 3;//remove
                if (isTasks || commentsGroups) {
                    if ($ctrl.uId !== undefined && $ctrl.uId !== null) {
                        p.uId = $ctrl.uId;
                    }

                    if (commentsGroups) {
                        p.uIdList = $ctrl.TodoCardGridItemInitCtrlService.getUIdList($ctrl.uIdList);
                        p.uIdComment = $ctrl.commentGroup._id;

                        //todo what if is in dashboard widget
                        var todoPage = $ctrl.BlocksSetupService.getCurrentTodoPage();
                        if (todoPage) {
                            p.todoPageId = todoPage._id;
                        }
                    }
                }
            }
            return p;
        }

        function onPreloadGroup() {
            //to be loaded from workflow page otherwise
            $ctrl.showEnterComment = $ctrl.commentGroup && $ctrl.element.getAttribute('show-enter-comment') === 'true';
            initForCommentsTab();
            if ($ctrl.isCommentsSidebar) {
                $ctrl.withoutGroupSorting = $ctrl.tabTasks !== 'archived';
                if ($ctrl.tabTasks === 'comments') {
                    //$ctrl.withoutGroupEdit = true;
                    $ctrl.groupEditMethod = 'editComment';
                    $ctrl.withDuplicateGroupItem = false;
                } else if ($ctrl.isTasks && $ctrl.isCalendarPage) {
                    $ctrl.itemTitle = 'Event';
                }
            } else {
                $ctrl.acceptSortableTree = acceptSortableTree;
            }
        }

        function onPostloadGroup() {
            console.log('onPostloadGroup');
            if ($ctrl.fixApply) {
                setColumnsHeight();
                $ctrl.addRootWatcherSimple($ctrl.LCS.onWindowHeightChanged(setColumnsHeight));
            }
            if (isActive()) {
                $ctrl.addRootWatcher('MOVE_TODOCOLUMN_ITEM' + ($ctrl.uId ? $ctrl.uId : ''), onMoveColumn);
            }

            if (hasCommentsGroup()) {
                $ctrl.addRootWatcher('COMMENTS_GROUP_TOGGLE_' + $ctrl.commentGroup._id, onCommentsGroupToggle);
            }

            if ($ctrl.isTaskBoards) {
                $ctrl.addRootWatcher('TASKBOARD_TEAM_UPDATED_' + $ctrl.taskBoardId, onTaskBoardTeamChanged);
            }

            //scroll to comment or card
            var isTask = $ctrl.tabTasks === 'tasks';
            if (isTask) {
                var id = $ctrl.CPS.getSearchFilter('task'),
                    item = id ? $ctrl.list.getElementById(id) : null;
                if (item) {
                    $ctrl.edit(item);
                    //open task in popup
                }
            }
        }

        function onCommentsGroupToggle(result) {
            if (!result) {
                return;
            }

            if (result.isShow) {
                //show enter only if there are no comments
                if (!$ctrl.list.totalCount && $ctrl.commentGroup) {
                    $ctrl.broadcastRoot('TOGGLE_COMMENT_ENTER_' + $ctrl.commentGroup._id, true);
                }
            } else {
                closeCommentAndGroup(true, result.isRemoveGroup ? {isRemoveGroup: true} : null);
            }
        }

        function closeCommentAndGroup(force, other) {
            if (!$ctrl.commentGroup) {
                return;
            }

            if (other && other.isRemoveGroup) {
                return removeGroup();
            }

            //might take a bit to update the counter for items after adding an element
            if ($ctrl.list.totalCount > 0 || other && other.justAdded) {//remove enter comment
                $ctrl.broadcastRoot('TOGGLE_COMMENT_ENTER_' + $ctrl.commentGroup._id, false);
            } else if (force) { //remove group
                removeGroup();
            }
        }

        function removeGroup() {
            $ctrl.$onDestroy();
            $ctrl.LCS.timeout(function () {
                $ctrl.LCS.removeElement($ctrl.element);
            }, 200);
        }

        function setColumnsHeight() {
            $ctrl.LCS.timeout(function () {
                //console.log('setColumnsHeight');
                var element = $ctrl.element.querySelector('.fix-column-height');
                if (element) {
                    var oldHeight = element.offsetHeight,
                        newHeight = ($ctrl.fixParentName ? $ctrl.LCS.findClosestParent($ctrl.element, $ctrl.fixParentName) : element.parentElement.parentElement).offsetHeight -
                            ($ctrl.fixOffset ? parseInt($ctrl.fixOffset, 10) : 44);
                    if (!$ctrl.fixHeightSet) {
                        $ctrl.LCS.addClass(element, $ctrl.scrollwrapperCls + ' fancy-scrollbar overlay-scrollbar');

                        $ctrl.fixHeightSet = true;
                    }
                    if (oldHeight !== newHeight) {
                        $ctrl.LCS.setCSSStyle(element, 'max-height', newHeight.toString() + 'px');
                    }
                }
            }, 100);
        }

        function getCardsOptions() {
            var opts;
            try {
                //console.log('TaskcardGroupCtrlService grid item');
                opts = JSON.parse($ctrl.compOptions);
            } catch (e) {
            }
            if (opts) {
                $ctrl = _.extend($ctrl, opts);
            }
        }

        function getSearchField() {
            return '<div class="search-field-width"><input autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" ng-class="{\'full-length\':$ctrl.search}" class="form-control without-underline search" type="text" placeholder="Search archive…" ng-keyup="$ctrl.onsearch(search)" ng-model="$ctrl.search">' +
                $ctrl.LCS.getISBDiv('search') +
                '<a class="clear-search gray-lighter ng-hide" ng-click="$ctrl.search=null;$ctrl.clearSearch()" ng-show="$ctrl.search">' + $ctrl.LCS.getISBDiv('delete-circle') + '</a>' +
                '</div>';
        }

        function onAdded(result, resultInit) {
            updateForCommentsGroup(resultInit);
            updateCount();
        }

        function afterProcessUpdatesOther(result, resultInit) {
            if (hasCommentsGroup() && result && result.type === 3) {//onremove
                updateForCommentsGroup(resultInit);
            }
        }

        function updateForCommentsGroup(resultInit) {
            console.log('updateForCommentsGroup');

            var hasGroup = hasCommentsGroup(),
                commentGroup = hasGroup ? $ctrl.commentGroup :
                    ($ctrl.isCommentsSidebar && $ctrl.isInModal && $ctrl.uIdList && $ctrl.uIdList.currentItemId &&
                    $ctrl.LCS.findClosestParent($ctrl.element, '.material-viewer') ? {_id: $ctrl.uIdList.currentItemId} : null)

            if (!commentGroup) {
                return;
            }

            var id = commentGroup._id;
            try {
                var updates = resultInit.updatesG[$ctrl.uIdList.collectionName].set[id];
                if (updates) {
                    commentGroup = _.extend(commentGroup, updates);
                    $ctrl.broadcastRoot('UPDATED_' + $ctrl.uIdList.elemType + '_ITEM', {
                        item: commentGroup,
                        eventType: 'CHANGED_FIELD',
                        editchanges: commentGroup
                    });

                    if (hasGroup) {
                        $ctrl.commentGroup = commentGroup;
                    }
                }
            } catch (e) {
            }

            // after remove comment there are no left items -> remove the group
            if (hasGroup && resultInit.type === 3 && !$ctrl.list.totalCount) {
                removeGroup();
                $ctrl.broadcastRoot('GROUP_COMMENTS_CLEAR_' + $ctrl.todoPage._id, [commentGroup._id]);
            }
        }

        function hasCommentsGroup() {
            //is in material view
            return $ctrl.isCommentsSidebar && !$ctrl.isTasks && $ctrl.commentGroup;
        }

        function getGroupEmpty() {
            var t = $ctrl.isTasks ? ($ctrl.isCalendarPage ? 'event' : 'task') : 'conversation',
                title = t + 's',
                s = $ctrl.getSelectedFilter();
            return $ctrl.isCommentsSidebar && !$ctrl.isDashboard ? ('<div class="todono h-full table-div" ng-if="$ctrl.list.items.length==0&&!($ctrl.info.isOpened||!$ctrl.isTasks)&&!$ctrl.list.busy">' +
                '<div class="centered text-center h-full">' +
                '<div class="big"><div class="sbf sbf30" ng-class="::' +
                ($ctrl.isTasks ? ('$ctrl.filtersService.selectedFilter?\'taskbar\':\'box\'') : '\'conversations\'') + '">' + $ctrl.LCS.getISBPath(2) + '</div></div>' +
                '<div class="text-center">' +
                '<h3 class="text-center">' +
                (s ? ('No ' + title + ' on this page') :
                        ('<span ng-if="$ctrl.search">No archived ' + title + ' match this search</span>' +
                            '<span ng-if="!$ctrl.search">No ' + title + ' have been archived</span>'
                            //+'<span ng-if="$ctrl.noUnCompleted()">There are no uncompleted comments.</span'
                        )
                ) +
                '</h3>' +
                (s && isActive() && $ctrl.isTasks ? ('<div class="content text-center">Every ' + t + ' in your project can be explored on the <a class="blue underlined" ng-click="$ctrl.goToPage(\'' + ($ctrl.isScriptPage ? 'script-outline' : 'workflow') + '\')">' +
                    ($ctrl.isScriptPage ? 'Script Outline' : 'Tasks') + '</a> page.</div>') : '') +
                ($ctrl.canAddNew ? ('<a id="addNewCardLink" ng-if="!$ctrl.info.isOpened" ng-click="$ctrl.showNewCard($event)" class="margin-top-half edit-profile btn btn-small primary-faded" data-type="showNewCard" analytics-on analytics-action="Add New ' + $ctrl.itemTitle + '">' + $ctrl.LCS.getISBDiv('plus', 2, 'pull-left') + ' Add New ' + $ctrl.itemTitle + '</a>') : '') +
                '</div>' +
                '</div>' +
                '</div>') : '';
        }

        function isActive() {
            return $ctrl.canEdit;
        }

        function getGroupAdd(isTop) {
            var commentGroupId = hasCommentsGroup() ? $ctrl.commentGroup._id : null;
            if (!$ctrl.canAddNew || !isActive()) {
                return '';
            }
            if (isTop && !($ctrl.tabTasks !== 'tasks' && !$ctrl.isDashboard)) {
                return '';
            }
            if (!isTop && $ctrl.tabTasks !== 'tasks') {
                return '';
            }
            var selectedFilter = $ctrl.getSelectedFilter();
            return '<todo-card-new class="todo-card-new-element" ' +
                'comp-options="::$ctrl.compOptions" ' +
                'on-added="$ctrl.onAddedInline(result)" ' +
                'cancel-new-card="$ctrl.cancelNewCard(result)" ' +
                'get-new="$ctrl.getNew()" ' +
                'show-border="::' + (isTop ? false : $ctrl.isCommentsSidebar) + '" ' +
                'show-icon="::' + (isTop ? false : (!$ctrl.isCommentsSidebar && selectedFilter || $ctrl.isCommentsSidebar && !selectedFilter)) + '" ' +

                (commentGroupId ? (
                    'u-id-comment="' + commentGroupId + '"' +
                    'show-on-click="true"' +
                    'toggle-enter-comment="$ctrl.toggleEnterComment1(result)" '
                ) : '') +
                ($ctrl.showEnterComment ? 'is-show="true"' : '') +
                (isTop ? '' : 'ng-if="$ctrl.info.isOpened"') +
                '></todo-card-new>';
        }

        function toggleEnterComment1(result) {
            $ctrl.toggleEnterComment({result: result});
        }

        function getGroupItemAttributes() {
            return ' is-in-modal="::$ctrl.isInModal" ';
        }

        function preloadSettings() {
            //one should not be able to assign people that are not in the team
            //$ctrl.CPS.productId >>>
            $ctrl.team = $ctrl.isTaskBoards ? $ctrl.RouteCollaboratorsService.getTeamByIds($ctrl.teamIds) :
                $ctrl.RouteCollaboratorsService.getProjectTeam($ctrl.CPS.product);
            $ctrl.Settings = _.extend({}, $ctrl.Settings, $ctrl.TodoCardGridItemInitCtrlService.getExtendedSettingsParams($ctrl), {
                todoColumns: $ctrl.todoColumns,
                team: $ctrl.team
            });
        }

        function getNewParams(after, type) {
            //TODO
            //console.log('getNewParams');
            var params = {};

            params.order = $ctrl.list.getNewItemOrder();
            params.active = true;
            params.completed = false;
            params.isOnlyComment = $ctrl.tabTasks !== 'tasks';                                  //is script outline
            //  params.isWorkflow = true;//all sidebar events should be added to the workflow page
            // params.type = $ctrl.isCalendarPage ? 2 : ($ctrl.isScriptPage ? 3 : 1);
            params.type = $ctrl.isScriptPage ? 3 : 1; // the calendar tabs are kept in the calendar page
            //cards set on dashboard are of type workflow
            params.todoPageId = $ctrl.isDashboard ? $ctrl.BlocksSetupService.getTodoPageByName('.workflow')._id : getTodoPage()._id; //workflow

            if (!params.isOnlyComment) {
                //tree is based on todoColumnId for dashboard and based on todoPageId for rest

                if ($ctrl.isDashboard) {
                    var currentListId = $ctrl.currentListId,
                        tree = $ctrl.listTreeService.getTree($ctrl.treeType, $ctrl.currentList.active),
                        cols = tree ? tree.nodes : null,
                        l = cols ? cols.length : 0;

                    if (!currentListId && l > 0) {
                        for (var i = 0; i < l; i++) {
                            var c = cols[i];
                            if (c.name.toLowerCase() === 'in progress') {
                                currentListId = c._id;
                                break;
                            }
                        }

                        if (!currentListId) {
                            currentListId = cols[0]._id;
                        }
                    }
                    params.todoColumnId = currentListId;
                } else {
                    var hasColumns = $ctrl.todoColumns && $ctrl.todoColumns.length > 0;
                    if ($ctrl.isWorkflow || $ctrl.isScriptPage) {
                        if (hasColumns) {
                            if ($ctrl.currentListId) {
                                params.todoColumnId = _.find($ctrl.todoColumns, {_id: $ctrl.currentListId});
                            }
                            if (!params.todoColumnId) {
                                params.todoColumnId = getColumnId();
                            }
                        }
                    } else {
                        if (hasColumns) {
                            params.todoColumnId = getColumnId();
                        }
                    }
                }

                if (!params.todoColumnId) {
                    console.warn('must define $ctrl.todoColumns in taskcardgroup');
                }
            }
            params.uId = $ctrl.uId ? $ctrl.uId : null;

            if (params.isOnlyComment && $ctrl.commentGroup) {
                params.uIdComment = $ctrl.commentGroup._id;
            }

            if ($ctrl.uIdList) {
                params.uIdList = $ctrl.TodoCardGridItemInitCtrlService.getUIdList($ctrl.uIdList);
            }

            if ($ctrl.isTaskBoards && $ctrl.taskBoardId) {
                params.taskBoardId = $ctrl.taskBoardId;
                params.productId = null;
            }

            return params;

            function getColumnId() {
                var c = _.find($ctrl.todoColumns, function (item) {
                    return item.name.toLowerCase() === 'in progress';
                });
                if (!c) {
                    c = $ctrl.todoColumns[0];
                }
                return c ? c._id : null;
            }
        }

        function getTodoPage() {
            $ctrl.todoPage = $ctrl.BlocksSetupService.getTodoPageById($ctrl.todoPageId);
            return $ctrl.todoPage;

        }

        function getNewPopupParamsOther() {
            return {
                service: $ctrl.service,
                listTreeService: $ctrl.listTreeService,
                preLoadingService: $ctrl.preLoadingService,
                Settings: $ctrl.Settings,
                uIdList: _.extend({}, $ctrl.uIdList, {currentItemLikes: null}),
                isTaskBoards: $ctrl.isTaskBoards,
                todoPage: getTodoPage()
            };
        }

        function getEditPopupParams(item, field) {
            return _.extend({
                onGridItemActions: $ctrl.onGridItemActions,
                canEdit: isActive()
            }, $ctrl.getNewPopupParamsOther());
        }

        function acceptSortableTree(src, dest, destItemScope) {
            var val = src.selectedFilter && dest.selectedFilter ||
                !src.selectedFilter && !dest.selectedFilter;
            return val ? true : false;
            // var sItem = src && src.itemScope && src.itemScope.item ? src.itemScope.item : null;
            //  var dItem = destItemScope && destItemScope.item ? destItemScope.item : null;
            //  return dItem && sItem && dItem.getSortableType() === sItem.getSortableType();
        }

        function checkQuota(next, e) {
            $ctrl.checkQuota($ctrl.getGroupQuota(), next, {e: e, maxAddedCount: 1});
        }

        function showNewCard(e) {
            // $ctrl.info.isOpened = true;
            checkQuota(process, e);

            function process() {
                $ctrl.info.isOpened = true;
                if ($ctrl.scrollwrapperCls && !$ctrl.scrollwrapper) {
                    $ctrl.scrollwrapper = $ctrl.element.querySelector('.' + $ctrl.scrollwrapperCls);
                }
                if ($ctrl.scrollwrapper) {
                    $ctrl.LCS.timeout(function () {
                        $ctrl.scrollwrapper.scrollTop = $ctrl.scrollwrapper.scrollHeight;
                    }, 150);
                }
            }
        }

        function cancelNewCard(result) { //result: {force, justAdded}
            if(debugNewCard) {return;}
            $ctrl.info.isOpened = false;
            closeCommentAndGroup(result ? result.force : false, result && result.justAdded ? {justAdded: true} : null);
        }

        function passesFilter(item) {
            if (!$ctrl.isLikeWorkflow) {
                return true;
            }
            return TopNavCalendarService.filterTasks(item);
        }

        function filterTodoCards(item) {
            return TopNavCalendarService.filterTasks(item);
        }

        function goToPage(page) {
            $ctrl.popupsService.teamAccess(function () {
                $ctrl.CPS.transitionTo('user.product.' + page, $ctrl.CPS.currentProductPathParams());
            });
        }

        function initForCommentsTab() {
            $ctrl.dateFormat = $ctrl.isTasks ? $ctrl.CPS.dateTimeFormat : ("MMM D" + ' @ ' + $ctrl.CPS.timeFormat);

            $ctrl.orders = $ctrl.isTasks ? {order: 1} : {updatedAt: -1};
            $ctrl.info = {isOpened: $ctrl.isTasks ? false : true};

            setCanAdd();
        }

        function setCanAdd() {
            var selectedFilter = $ctrl.getSelectedFilter(),
                val = selectedFilter && ($ctrl.isTasks ? isActive() : $ctrl.canComment);
            console.log('setCanAdd: ' + val);
            if ($ctrl.canAddNew !== val) {
                $ctrl.canAddNew = val;
            }
        }

        function onMoveColumn(item) {
            if ($ctrl.isDashboard || !$ctrl.isCommentsSidebar) {
                console.log('onMoveColumn');
                if (!item) {
                    return;
                }
                var oldColumnId = angular.copy(item.oldColumnId);

                if (oldColumnId === $ctrl.currentListId) {
                    delete item.oldColumnId;
                    $ctrl.list.removeElement(item);
                }//remove
                else if (item[$ctrl.listField] === $ctrl.currentListId && !$ctrl.list.getElementById(item._id)) {
                    $ctrl.list.insertElementByOrder(item);
                }//insert
            }
        }


        function onMoveCard(data) {
            console.log('onMoveCard');
            var item = data.item,
                currentListId = data[$ctrl.listField];
            if ($ctrl.currentListId === currentListId) {
                var el = $ctrl.list.getElementById(item._id);
                if (el) {
                    el.currentListId = currentListId;
                    $ctrl.processSorting(data.index, $ctrl.list.items.length - 1);
                }
            }
        }

        function onAddedInline(result) {
            console.log('onAdded task card');
            if (!result || !result.item) {
                return;
            }
            if (result.item) {
                result.item.createdBy = $ctrl.CPS.user;
            }

            $ctrl.onInitAdded(result);

            //dont open the card in popup for now
            /*if ($ctrl.tabTasks !== 'comments' && !$ctrl.isScriptPage) {
                $ctrl.LCS.timeout(function () {
                    $ctrl.edit(result.item);
                }, 101);
            }*/

            if ($ctrl.tabTasks === 'tasks') {
                $ctrl.cancelNewCard();
            }
        }

        function duplicate(item, param, e) {
            checkQuota(process, e);

            function process() {
                $ctrl.TodoCardGridItemInitCtrlService.duplicate(item, $ctrl, $ctrl.onInitAdded, onError);
            }

            function onError(err) {
                //i18nNotifications.pushForCurrentRoute(err, 'crud.todoCard.duplicate.error', 'error');
            }
        }

        function changeStatus(item, oldColumnId) {
            console.log('changeStatus');
            item.oldColumnId = oldColumnId;
            $ctrl.broadcastRoot('MOVE_TODOCOLUMN_ITEM' + ($ctrl.uId ? $ctrl.uId : ''), item);
        }

        function getSelectedFilter() {
            return $ctrl.filtersService && $ctrl.filtersService.selectedFilter || !$ctrl.filtersService;
        }
    }
}

angular.module('product.workflow.list.events', [])
.service('TodoAddCardEventsService',TodoAddCardEventsService);

TodoAddCardEventsService.$inject = ['LCS', '$compile'];

function TodoAddCardEventsService(LCS, $compile) {
    return function ($ctrl, $scope) {
        var clickEvent = LCS.clickEvent + '.addCard';
        var body = angular.element(document.body);
        var directivePlaceholder = 'todo-directive-placeholder';
        var onNearbyClick;

        $ctrl.onAddNewCardLink = onAddNewCardLink;
        bindClickLink(true);

        $ctrl.$onTodoCardEventsDestroy = onDestroy;
        
        return $ctrl;
        
        function clearSelector(target, onNearbyClick) {
            var pl = $('.' + directivePlaceholder);
            if (pl.length > 0) {//remove
                pl.remove();
                target.css('display', 'block');
                bindOnNearbyClick(false, onNearbyClick);
                return true;
            }
            return false;
        }

        function createSelector(parent, target, onNearbyClick) {
            var newScope = $scope.$new(true);
            newScope.$ctrl = {
                onAdded: $ctrl.onAdded,
                cancelNewCard: $ctrl.cancelNewCard,
                getNew: function(){
                    var item = $ctrl.getNew();
                    item.todoPage = $ctrl.todoPage;
                    item.todoColumn = $ctrl.todoColumn;
                    return item;
                }
            };
            var template = '<todo-card-new ' +
                    'on-added="$ctrl.onAdded(added)" ' +
                    'cancel-new-card="$ctrl.cancelNewCard(result)" ' +
                    'get-new="$ctrl.getNew()" ' +
                    'show-border="::' + $ctrl.isCommentsSidebar + '" ' +
                    'show-icon="::' + $ctrl.isCommentsSidebar + '"></todo-card-new>',
                dir = angular.element('<div class="' + directivePlaceholder + '"></div>').append($compile(template)(newScope));

            parent.append(dir);
            bindOnNearbyClick(true, onNearbyClick);
            target.css('display', 'none');
        }

        function onAddNewCardLink(e) {
            var target = $(e.target);

            onNearbyClick = function (event) {
                console.log('listen to click');
                var t = event.target,
                    el = $('.' + directivePlaceholder);
                if (el.length > 0 && !(e.target === el[0] || $.contains(el[0], t)) || el.length === 0) {
                    clearSelector(target, onNearbyClick);
                }
            }

            clearSelector(target, onNearbyClick);
            var parent = target.parents('div.todocardsloadedcontainer').find('.fix-column-height');
            createSelector(parent, target, onNearbyClick);
        }

        function onDestroy() {
            var isBind = false;
            bindOnNearbyClick(isBind);
            bindClickLink(isBind);
        }

        function bindOnNearbyClick(isBind, onNearbyClick){
            if(onNearbyClick) {
                body[isBind ? 'on' : 'off'](clickEvent, onNearbyClick);
            }
        }

        function bindClickLink(isBind) {
            body[isBind ? 'on' : 'off'](clickEvent + 'Link', $ctrl.onAddNewCardLink);
        }
    }
}


