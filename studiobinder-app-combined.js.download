}


angular.module('product.callsheet.block.init.controller.service', [
    'groupBlock.controller.service'
])
.service('CallsheetBlockGroupCtrlService', CallsheetBlockGroupCtrlService);
CallsheetBlockGroupCtrlService.$inject = ['CompInitCtrlService', 'GroupBlockInitCtrlService', 'CallsheetsService', 'CallsheetConstantsService'];
function CallsheetBlockGroupCtrlService(CompInitCtrlService, GroupBlockInitCtrlService, CallsheetsService, CallsheetConstantsService) {
    return function ($ctrl, $element, Pagination) {
        console.log('CallsheetBlockGroupCtrlService');
        //todo : check on this:$ctrl.clsSideBordersOther = 'full-width ';
        //nec here to get the call sheet from current product
        $ctrl.defaultFontSizeGeneral = 12;

        $ctrl.CallsheetsService = CallsheetsService;
        $ctrl.CallsheetConstantsService = angular.copy(CallsheetConstantsService);

        $ctrl.rowLoadNow = true;
        $ctrl.withoutKeydownEvent = true;

        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl);
        }

        $ctrl.groupBlockColumnsPopupType = 'CallsheetColumns';

        $ctrl.callsheet = angular.copy($ctrl.CurrentProduct.getCallsheet());
        $ctrl.callsheetId = $ctrl.callsheet._id;

        if (!$ctrl.constantsService) {
            console.warn('Parent for CallsheetBlockGroupCtrlService must define property $ctrl.constantsService');
        } else {
            var predefProps = angular.copy($ctrl.CallsheetConstantsService[$ctrl.optionsProp + 'Settings'][$ctrl.block]);
            $ctrl.options = $ctrl.callsheet.options[$ctrl.optionsProp] && $ctrl.callsheet.options[$ctrl.optionsProp][$ctrl.block] ? $ctrl.callsheet.options[$ctrl.optionsProp][$ctrl.block] : predefProps;

            if(!$ctrl.options){
                $ctrl.options = {};
                console.warn('$ctrl.options for CallsheetBlockGroupCtrlService must be define for block ' + $ctrl.block);
            }

            if (!$ctrl.constantsService.CompOptions) {
                $ctrl.constantsService.CompOptions = {};
            }

            $ctrl.constantsService.CompOptions = _.extend({
                loadingLayerParentClass: '.first-scrolling-wrapper .edit-mode-template',
                //withoutLoadingLayer:  true,
                icon: $ctrl.options.icon,
                iconLevel: $ctrl.options.iconLevel,
                itemIcon: $ctrl.options.icon,
                showHeaderIcon: $ctrl.options.showHeaderIcon === true,
                itemTitle: $ctrl.options.title,
                dontConfirmDelete: true,
                noSideColumnBorders: true,
                withoutBorderBottom: true,
                withoutCheckbox: true,
                withDynamicCols: true,
                withoutMouseHover: true,
                hasTree: false,
                withCreateInlineGroup: true,
                withEditInlineGroup: true,
                dragHandleOnTheSide: true,
                withoutListField: true,
               // listField: 'callsheetId',
                gridItemClass: '',//'short-item-grid ' +
                  //  ($ctrl.canEdit && !$ctrl.withoutGroupWhiteBg? 'with-white-bg' : ''), // todo small-font if not edit
                pageClass: $ctrl.CallsheetConstantsService.CompOptions.pageClass,
            }, $ctrl.constantsService.CompOptions);

            $ctrl = _.extend($ctrl, $ctrl.constantsService.CompOptions);

            $ctrl.compOptions = JSON.stringify($ctrl.constantsService.CompOptions);

            if(!$ctrl.constantsService.GroupSettings){$ctrl.constantsService.GroupSettings = {};}
            var colType = $ctrl.constantsService.GroupSettings.colType || $ctrl.block;
            $ctrl.constantsService.GroupSettings = _.extend({
                groupItemTag: 'callsheet-' + colType.split(/(?=[A-Z])/).join('-').toLowerCase(),
            }, $ctrl.constantsService.GroupSettings);

            if($ctrl.options.icon){
                $ctrl.constantsService.GroupSettings.icon = $ctrl.options.icon;
                $ctrl.constantsService.GroupSettings.iconLevel = $ctrl.options.iconLevel;
            }

            if($ctrl.constantsService.GroupSettings.templateClsOther === undefined){
                $ctrl.constantsService.GroupSettings.templateClsOther = 'with-bottom-xs preview-callsheet callsheet-table centering ';
            }

            if($ctrl.constantsService.GroupSettings.largeColPadding === undefined){
                $ctrl.constantsService.GroupSettings.largeColPadding = true;
            }
            if (!$ctrl.constantsService.Settings) {
                $ctrl.constantsService.Settings = {};
            }
            $ctrl.constantsService.Settings.Columns = $ctrl.CallsheetConstantsService.Columns[colType];
            $ctrl.constantsService.Options = $ctrl.options;
            $ctrl.constantsService.ViewProp = $ctrl.block + '_' + $ctrl.callsheetId;
            $ctrl.constantsService.KeyboardServiceParams = {
                canCopy: false,
                canMove: false
            }
        }
        if(!$ctrl.alignHandle) {
            $ctrl.alignHandle = 'left';
        }
        $ctrl.ViewModes = {Desktop: 1, Mobile: 2, Inbox: 3, SMS: 4};
        $ctrl.TemplateOptions = $ctrl.constantsService.TemplateOptions;
                                            //general                   block
        $ctrl.styles = _.extend({}, $ctrl.callsheet.options.styles, $ctrl.options.styles);
        $ctrl.startDate = $ctrl.callsheet.startDate;
        $ctrl.withoutItemKeyEvents = true;


        $ctrl.getParams = getParams;
        $ctrl.getColClsBorders = getColClsBorders;

        if(!$ctrl.getGroupTemplateOther) {
            $ctrl.getGroupTemplateOther = getGroupTemplateOther;
        }
        $ctrl.onSettingsChangedOther = onSettingsChangedOther;
        $ctrl.getMoreBtnCls = getMoreBtnCls;
        $ctrl.getCountItem = getCountItem;

        $ctrl = new GroupBlockInitCtrlService($ctrl, $element, Pagination, $ctrl.constantsService, $ctrl.CallsheetsService);

        $ctrl.onReloadGroupTemplateOther = onReloadGroupTemplateOther;

        if ($ctrl.canEdit) {
            $ctrl.onUpdateBreak = onUpdateBreak;
            $ctrl.toggleVisibility = toggleVisibility;
            $ctrl.openEditSettings = openEditSettings;
            $ctrl.addRootWatcher('CALLSHEET_STYLE_CHANGED', onSettingsChangedOther);
            $ctrl.addRootWatcher('CALLSHEET_GRID_RELOAD_' + $ctrl.block, onGridReload);
        }

        return $ctrl;

        function onGridReload() {
            console.log('onGridReload');
            $ctrl.preLoadingService.loadCallsheetSchedules(true, $ctrl.preLoadingTableName, onsuccess);

            function onsuccess() {
                $ctrl.list.items = $ctrl.preLoadingService.getObjectList($ctrl.preLoadingService.TblTypes[$ctrl.preLoadingTableName]);
                $ctrl.reloadGroupTemplate();
            }
        }

        function getCountItem(c) {
            return {
                totalCount: c,
                counterText: c + ' Total ' + $ctrl.options.title
            }
        }

        function getMoreBtnCls() {
            return 'with-hover ';
        }

        function getColClsBorders(item, c, isFirst, isLast, isMobile) {
            return (isFirst ? 'col-first ' :'') +
                (isLast ? 'col-last ' :'') +
                (isFirst && isLast ? 'grow-column ' :'') +
                 (typeof ($ctrl.getColClsBordersOther) === 'function' ? $ctrl.getColClsBordersOther(item, c, isFirst, isLast, isMobile) : '');
         /*   if (!c.withoutBorderBottom) {
                cls += 'border-bottom ';
            }
            var styles = $ctrl.callsheet.options.styles,
                defaultBorders = 2,
                borders = _.find($ctrl.CallsheetConstantsService.BorderOptions, {id: styles ? styles.borders : defaultBorders});
            borders = borders ? borders.value : $ctrl.CallsheetConstantsService.BorderOptions[defaultBorders];
            if (borders.sideBorders) {
                if (isFirst) {
                    cls += 'border-left ';
                }
                if (borders.rightBorder) {
                    cls += 'border-right ';
                }
            } else {
                if (borders.rightBorder && !isLast) {
                    cls += 'border-right ';
                }
            }*/
        }

        function toggleVisibility(e) {
            if ($ctrl.isUpdating) {return;}
            $ctrl.isUpdating = true;
            var prop = 'show',
                value = $ctrl.options[prop] ? false : true,
                info = $ctrl.CurrentProduct.setCallsheetInfo({
                    dontShowActivity: true
                }, prop, value, $ctrl.block);
            update(info, function (result) {
                $ctrl.broadcastRoot('CALLSHEET_VISIBILITY_CHANGED', {optionsProp: $ctrl.optionsProp, info: info});
                $ctrl.broadcastRoot('CALLSHEET_' + $ctrl.optionsProp.toUpperCase() + '_CHANGED', {info: info});
                //btnShow.setAttribute('tooltip', (value?'Hide':'Show')+' View');
                $ctrl.LCS.replaceClass($ctrl.btnShowF, value ? 'eye' : 'eye-hidden', value ? 'eye-hidden' : 'eye');
                $ctrl.isUpdating = false;
            }, 'blockVisibility');
        }

        function onUpdateBreak(result) {
            if (result) {
                var info = $ctrl.CurrentProduct.setCallsheetInfo({}, 'break', result.break, $ctrl.block);
                update(info, function () {
                    console.log('onUpdateBreak');
                }, ' ');
            }
        }

        function update(info, onSuccess, errorType) {
            $ctrl.CurrentProduct.updateCallsheetInfo($ctrl, info, onSuccess, errorType);
        }

        function openEditSettings(e) {
            console.log('openEditSettings');
            var block = _.clone($ctrl.block);
            $ctrl.popupsService.open(_.extend({}, $ctrl.options), $ctrl.popupsService.operations.callsheetColumns, {
                CallsheetConstantsService: $ctrl.CallsheetConstantsService,
                constantsService: $ctrl.constantsService,
                block: block,
                callsheetId: $ctrl.callsheetId
            }, $ctrl.compOptions, null, function (result) {
                console.log('onclose openEditSettings');
                $ctrl.callsheet = angular.copy($ctrl.CurrentProduct.getCallsheet());
                $ctrl.options = $ctrl.callsheet.options[$ctrl.optionsProp][$ctrl.block];
            });
        }

        function onReloadGroupTemplateOther(isInit) {
            updateStyles();
            if($ctrl.onBlockLoaded) {
                $ctrl.onBlockLoaded(isInit);
            }
        }

        function getGroupTemplateOther() {
            var t = '';
            if ($ctrl.canEdit || !$ctrl.canEdit && $ctrl.options.break) {
                t += '<callsheet-break ' +
                    'can-edit="::' + $ctrl.canEdit + '" ' +
                    ($ctrl.options.break ? 'break="true" ' : '');
                if ($ctrl.canEdit) {
                    t += 'block="' + $ctrl.block + '" ' +
                        'on-update="$ctrl.onUpdateBreak(result)" ';
                }
                t += '></callsheet-break>';
            }
            return t;
        }


        function onSettingsChangedOther(updates) {
            if (updates) {
                for (var prop in updates) {
                    console.log('CALLSHEET_STYLE_CHANGED: ' + prop);
                    var val = updates[prop];
                    var oldVal = $ctrl.styles[prop];
                    if (oldVal === undefined || oldVal !== val) {
                        $ctrl.styles[prop] = val;
                        updatePropBasedOnStyle(prop, val);
                    }
                }
            }
        }

        function updatePropBasedOnStyle(prop, val) {
            switch (prop) {
                //from $ctrl.callsheet.options.styles
                case 'borders':
                    $ctrl.LCS.removeClass($ctrl.element, 'side-borders-0 side-borders-1 side-borders-2');
                    var cls = $ctrl.getSideBorderCls(val);
                    if(cls){
                        $ctrl.LCS.addClass($ctrl.element, cls);
                    }
                    break;

                case 'headerLine':
                    var el = $ctrl.element.querySelector('.grid-header');
                    if (el) {
                        $ctrl.LCS.setCSSStyle(el, 'border-bottom-color', val);
                    }
                    break;

                case 'headerColor':
                    var el = $ctrl.element.querySelector('.grid-header h2');
                    if (el) {
                        $ctrl.LCS.setCSSStyle(el, 'color', val);
                    }
                    break;
            }
        }

        function updateStyles() {
            var styles = $ctrl.styles;
            if (!styles) {
                return;
            }
            _.each(['borders', 'headerLine', 'headerColor', 'borderColor'], function (prop) {
                var val = styles[prop];
                if (val) {
                    updatePropBasedOnStyle(prop, val);
                }
            });
        }

        function getParams() {
            console.log('GroupContainerBlockCtrlService.getParams');
            return {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                callsheetId: $ctrl.callsheetId,
            };
        }
    }
}

angular.module('product.callsheet.departmentNotes.component', [
    'product.callsheet.block.init.controller.service',
    'apiPagination.DepartmentNotes'
])

.component('callsheetDepartmentNotesItemGrid', itemBlockGroupGridItemParams())
.component('callsheetDepartmentNotesGroup', callsheetGroupComponentParams( 'DepartmentNotesGroupCtrl'))

.controller('DepartmentNotesGroupCtrl', DepartmentNotesGroupCtrl);
DepartmentNotesGroupCtrl.$inject = ['CallsheetBlockGroupCtrlService', 'DepartmentNotesPagination', '$element'];
function DepartmentNotesGroupCtrl(CallsheetBlockGroupCtrlService, Pagination, $element) {
    console.log('DepartmentNotesGroupCtrl');
    var $ctrl = this;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.constantsService = {
            CompOptions: {
                objectType: 'departmentNote',
                elemType: 'DEPARTMENT_NOTE',
                preLoadingTableName: 'DepartmentNotes',
            },
            ListParams: {
                includeFields: ['name', 'note', 'order']
            }
        };

        $ctrl.getRowViewMobileDetails = getRowViewMobileDetails;

        $ctrl = new CallsheetBlockGroupCtrlService($ctrl, $element, Pagination);
    }

    function getRowViewMobileDetails(item) {
        if(!item.note){return null;}
        return '<div class="notes-col"><div class="display-block word-wrap full-width">' + item.note + '</div></div>';
    }
}


angular.module('product.callsheet.extras1.component', [
    'product.callsheet.block.init.controller.service',
    'apiPagination.Extras'
])
.component('callsheetExtras1ItemGrid', itemBlockGroupGridItemParams())
.component('callsheetExtras1Group', callsheetGroupComponentParams( 'CallsheetExtras1GroupCtrl'))

.controller('CallsheetExtras1GroupCtrl', CallsheetExtras1GroupCtrl);
CallsheetExtras1GroupCtrl.$inject = ['CallsheetBlockGroupCtrlService', 'ExtrasPagination', '$element'];
function CallsheetExtras1GroupCtrl(CallsheetBlockGroupCtrlService, Pagination, $element) {
     console.log('CallsheetExtras1GroupCtrl');
    var $ctrl = this;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.constantsService = {
            CompOptions: {
                itemTitle: 'Atmosphere',
                Types: {Extra: 1, StandIn: 2},
                elemType: 'EXTRA',
                objectType: 'extra',
                preLoadingTableName: 'Extras',
            },
            ListParams: {
                includeFields: ['companyId', 'productId', 'callsheetId','count', 'name', 'note', 'order', 'type', 'info'],
            }
        };

        $ctrl.getGridFooter = getGridFooter;
        $ctrl.onBlockLoaded = recount;
        $ctrl.recount = recount;
        $ctrl.getCount = getCount;
        $ctrl.afterProcessUpdates = afterProcessUpdates;

        if ($ctrl.canEdit) {
            $ctrl.getNewParams = getNewParams;
        }

        $ctrl = new CallsheetBlockGroupCtrlService($ctrl, $element, Pagination);
    }

    function afterProcessUpdates(result) {
        if(!result){return;}
        $ctrl.recount();
    }

    function getNewParams(after, type) {
        if (!type) {
            type = $ctrl.Types.Extra;
        }
        return {
            name: null,
            type: type,
            count: 0,
            info: {
                call: {isTime: true, value: $ctrl.MomentService.getUtcMomentCopy($ctrl.callsheet.startDate)},
                onset: null,
                pickup: null,
                costumes: null,
                wrap: null,
                hmu: null
            },
            order: $ctrl.list.items.length
        };

    }
    function getCount(){
        var c = 0,
            l = $ctrl.list && $ctrl.list.items && $ctrl.list.items.length ? $ctrl.list.items.length : 0;
        if (l > 0) {
            for (var i = 0; i < l; i++) {
                c += $ctrl.list.items[i].count;
            }
        }
        return $ctrl.getCountItem(c);
    }

    function recount() {
        $ctrl.LCS.timeout(function (){
            $ctrl.setCounter();
        }, 100);
    }

    function getGridFooter() {
         return '<div class="row-schedule header noborderbottom large-column-padding">' +
                    ($ctrl.canEdit && ($ctrl.LCS.isTouchScreen || $ctrl.isMobileView()) ? '<div class="handle-col hide-print' + ($ctrl.withShortHandleCol ? $ctrl.withShortHandleCol :'')+ '"></div>' :'') +
                    '<div class="col-first text-center col-no '+$ctrl.totalCountCls+'">'+($ctrl.getCount().totalCount||0)+'</div>' +
                    '<div class="col-last grow-column side-padding-10">Total</div>' +
                '</div>';
    }
}


angular.module('product.callsheet.files.component', [
    'product.todoFiles.service.controller'
])
.component('callsheetFilesGroup', {
    bindings: {
        canEdit:'<',
        currentListId: '@',
        isMobileMode: '<',
        options: '<'
    },
    controller: 'CallsheetFilesListCtrl'
})
.controller('CallsheetFilesListCtrl', CallsheetFilesListCtrl);
CallsheetFilesListCtrl.$inject = ['TodoFilesListServiceCtrl', '$element'];

function CallsheetFilesListCtrl(TodoFilesListServiceCtrl, $element) {
    var withBreak = false;
    var $ctrl = this;

    $ctrl.onPreInit = onPreInit;
    $ctrl.getGridHeader = getGridHeader;
    $ctrl.onGroupEmpty = onGroupEmpty;

    //todo: get update break to work
    //$ctrl.getGroupTemplateOther= getGroupTemplateOther;
    $ctrl.onUpdateBreak= onUpdateBreak;

    $ctrl = new TodoFilesListServiceCtrl($ctrl, $element);

    function onPreInit() {
        $ctrl.quotaType = 'callsheetAttachments';
        $ctrl.styles = $ctrl.options.styles;
        $ctrl.codeName = 'callsheet-attachments';
        $ctrl.withSubparentId = $ctrl.currentListId;//creates a folder
        $ctrl.parentId = $ctrl.currentListId;
        $ctrl.btnText = 'Upload File';

        $ctrl.withShortHandleCol = 'col20';
        $ctrl.block = 'todofiles';


        $ctrl.optionsProp = 'blocks';
        $ctrl.callsheetId = $ctrl.currentListId;
        $ctrl.callsheet = angular.copy($ctrl.CurrentProduct.getCallsheet());

        $ctrl.subtitle = 'Optional. Accompany your call sheet with maps, scripts, shot lists, etc. These files will be attached to every email sent and also also located on the call sheet page online. 10mb limit.';

        $ctrl.LCS.addClass($element[0], 'with-bottom-xs preview-callsheet callsheet-table centering side-borders-0 crewGrid');

        if($ctrl.canEdit){
            $ctrl.addRootWatcher('CALLSHEET_STYLE_CHANGED', onStyleChanged);
            $ctrl.addRootWatcher('GROUP_BLOCK_files_CHANGED', onBlockChanged);
        }
    }
    
    function getGridHeader() {
        if(!$ctrl.canEdit && !$ctrl.options.showHeader){return '';}
return '<div class="grid-header" '+
            ($ctrl.styles.headerLine ? (' style="border-bottom-color:' + $ctrl.styles.headerLine + '"') : '') +
        '>' +
            '<h2 class="grid-title clearfix"' +
                ($ctrl.styles.headerColor ? (' style="color:' + $ctrl.styles.headerColor + '"') : '') +
            '>' +
                ($ctrl.options.showHeaderIcon && $ctrl.options.icon ? ($ctrl.LCS.getISBDiv($ctrl.options.icon, 2, 'gray pull-left with-margin-right') + '&nbsp;') : '') +
                '<div class="gridtitle txtTitle pull-left">' + $ctrl.options.title + '</div>' +
            '</h2>' +
        '</div>';
    }


    function onGroupEmpty(){
        //console.log('onGroupEmpty');
        $ctrl.LCS.addClass($ctrl.element, 'sb-hide');
    }

    function onStyleChanged(updates) {
        if (!updates) {return;}

        for (var prop in updates) {
            console.log('CALLSHEET_STYLE_CHANGED: ' + prop);
            var val = updates[prop],
                oldVal = $ctrl.styles ? $ctrl.styles[prop] : undefined;

            if (oldVal === undefined || oldVal !== val) {
                $ctrl.styles[prop] = val;
                var elcls = null, p = null;
                if (prop === 'headerLine') {
                    elcls = 'grid-header';
                    p = 'border-bottom-color';
                } else if (prop === 'headerColor') {
                    elcls = 'gridtitle';
                    p = 'color';
                }
                $ctrl.LCS.setCSSStyle($ctrl.element.querySelector('.' + elcls), p, val);
            }
        }
    }

    function onBlockChanged(val) {
        for (var prop in val) {
            var v = val[prop];
            if (prop === 'title') {
                if (v !== $ctrl.options.title) {
                    $ctrl.options.title = v;
                    $ctrl.element.querySelector('.gridtitle').innerText = $ctrl.options.title;
                }
            } else if (prop === 'showHeaderIcon') {
                if (v !== $ctrl.options.showHeaderIcon) {
                    $ctrl.LCS.replaceClass($ctrl.element.querySelector('.sbf.' + $ctrl.options.icon), $ctrl.options.showHeaderIcon ? '' : 'sb-hide',
                        $ctrl.options.showHeaderIcon ? 'sb-hide' : '');
                    $ctrl.options.showHeaderIcon = v;
                }
            }
        }
    }

    function getGroupTemplateOther() {
        if (!withBreak) {
            return '';
        }

        if (!($ctrl.canEdit || !$ctrl.canEdit && $ctrl.options.break)) {
            return '';
        }

        return '<callsheet-break can-edit="::' + $ctrl.canEdit + '" ' +
            ($ctrl.options.break ? 'break="true" ' : '') +
            ($ctrl.canEdit ? ('block="' + $ctrl.block + '" on-update="$ctrl.onUpdateBreak(result)" ') : '') +
            '></callsheet-break>';
    }

    function onUpdateBreak(result) {
        $ctrl.options.break = $ctrl.options.break ? false : true;
        if (result) {
            var info = $ctrl.CurrentProduct.setCallsheetInfo({}, 'break', result.break, $ctrl.block);
            update(info, function () {
                console.log('onUpdateBreak');
            }, ' ');
        }
    }

    function update(info, onSuccess, errorType) {
        $ctrl.CurrentProduct.updateCallsheetInfo($ctrl, info, onSuccess, errorType);
    }
}

angular.module('product.callsheet.blocks', [
    'product.callsheet.block.init.controller.service'
]);

angular.module('product.callsheet.locations.component', [
    'product.callsheet.block.init.controller.service',
    'product.callsheet.locations.item.grid.component',
    'apiPagination.CallsheetLocations',
    'product.callsheet.locations.import.component',
    'product.callsheet.locations.save.component'
])
.component('callsheetLocationsGroup', callsheetGroupComponentParams( 'CallsheetLocationsGroupCtrl'))
.controller('CallsheetLocationsGroupCtrl',CallsheetLocationsGroupCtrl);
CallsheetLocationsGroupCtrl.$inject = ['CallsheetBlockGroupCtrlService', 'CallsheetLocationsPagination', '$element', '$attrs'];
function CallsheetLocationsGroupCtrl(CallsheetBlockGroupCtrlService, Pagination, $element, $attrs) {
    console.log('CallsheetLocationsGroupCtrl');
    var popupTemplate = getBasePopupTemplateByTag('callsheet-location-edit');
    var $ctrl = this;

    $ctrl.withCloseBtnOnPopup = true;
    $ctrl.expandMobileRow = false;
    $ctrl.editInlineOnMobile = true;
    $ctrl.$onInit = $onInit;
    $ctrl.setWeatherAddress = setWeatherAddress;
    $ctrl.getRowFront = getRowFront;
    $ctrl.getHeaderRowFront = getHeaderRowFront;
    $ctrl.getHeaderColumnText = getHeaderColumnText;

    $ctrl.PopoverTypesOther = {
        ImportLocation: 'import-location',
        SaveLocation: 'save-location'
    }

    function $onInit() {
        $ctrl.isSet = $attrs.callsheetType === '1';
        $ctrl.locations = [];
        $ctrl.hospitalOptions = {};

        $ctrl.constantsService = {
            CompOptions: {
                expandMobileRowWithDetails: false,
                objectType: 'callsheetLocation',
                itemIcon: 'pin',
                itemTitle: 'Location',
                elemType: 'CALLSHEET_LOCATION',
                preLoadingTableName: 'CallsheetLocations',

                withLabel: true,

                defaultFocusField: 'address'
            },
            ListParams: {
                includeFields: ['companyId', 'productId', 'callsheetId', 'address', 'addressNote', 'parking','note', 'hospital', 'hospitalNote', 'order'],
                searchFields: ['address', 'parking', 'hospital'],
                orderFields: ['order'],
                populate: ''
            },
            GroupSettings: {
                icon: 'pin',
                hasRowFront: true
            },

            PopupOperations: {
                createCallsheetLocation: {
                    type: 'Create',
                    template: popupTemplate,
                    size: 'sm',
                    transp: ' '
                },

                updateCallsheetLocation: {
                    type: 'Edit',
                    template: popupTemplate,
                    size: 'sm',
                    transp: ' '
                }
            }
        };

        $ctrl.getBottomActions = getBottomActions;
        $ctrl.onBlockLoaded = onBlockLoaded;
        $ctrl.afterProcessUpdates = afterProcessUpdates;
        $ctrl.importLocation = importLocation;
        $ctrl.onUpdated = onUpdated;

        $ctrl.getMoreInfoBtnTemplate = getMoreInfoBtnTemplate;

        $ctrl.getColClsBordersOther = getColClsBordersOther;
        $ctrl.processListItemColumn = processListItemColumn;
        $ctrl.onOtherPopoverTypes = onOtherPopoverTypes;

        $ctrl = new CallsheetBlockGroupCtrlService($ctrl, $element, Pagination);

        if ($ctrl.canEdit) {
            $ctrl.scriptLoadingService = $ctrl.CurrentProduct.scriptLoadingService;


            $ctrl.addRootWatcher('CALLSHEET_TYPE_CHANGED', onCallsheetTypeChanged);
        }
    }

    function getHeaderColumnText(isMobileRowDetails, c) {
        var n = (c.prop === 'address' && !$ctrl.isSet) ? c.name.replace('Set', 'Meeting') : c.name;
        return c.prop === 'address' ? ('<span class="locationname">' + n + '</span>') : n;
    }

    function onCallsheetTypeChanged(result) {
        console.log('locations.onCallsheetTypeChanged');
        var data = result.editchanges,
            isSet = data.type && data.type === 1;
        if ($ctrl.isSet !== isSet) {
            $ctrl.isSet = isSet;
        }
        var el = $ctrl.element.querySelector('.gridheader .locationname');
        if(el) {
            //now is uppercase
            el.innerText = el.innerText.replace($ctrl.isSet ? 'MEETING' : 'SET', $ctrl.isSet ? 'Set' : 'Meeting');
        }
    }

    function getHeaderRowFront() {
        return getF();
    }

    function getRowFront(item) {
        return getF(getOrder(item));
    }

    function getF(txt){
        return '<div class="locno hide-ipad vtop col-first without-border-right">'+(txt ? ('<span class="circle-small with-nr">' + txt + '</span>'):'&nbsp;')+'</div>'
    }

    function getOrder(item){
        return item && item.order ? (item.order + 1) : 1;
    }

    function getColClsBordersOther(item, c, isFirst, isLast, isMobile) {
        if(!item){return '';}
        var method = $ctrl.SBFieldMethods.getCustomAddress;
        if(!method){return '';}
        var cls = 'hide-ipad';
        switch (c.prop) {
            case 'address':
                return !method(item.address) && !item.addressNote ? cls : '';

            case 'parking':
                return !method(item.parking) && !item.note ? cls : '';

            case 'hospital':
                return !method(item.hospital) && !item.hospitalNote ? cls : '';
        }
    }

     function getMoreInfoBtnTemplate(isHeader, item) {
         return {
             count: $ctrl.editInlineOnMobile && $ctrl.isMobileView() ? 3 : 2,
             content: isHeader ? '' : ('<a class="btnSaveLocation btnSave editable-btn btn gray-light with-sb-popover" popover-type="' + $ctrl.PopoverTypesOther.SaveLocation + '">' + $ctrl.LCS.getISBDiv('location', 2, 'sbf14 gray', 'tooltip-placement="left" tooltip="Add To Location Library"') + '</a>' +
                 '<a class="visible-xs hide-print inline-block gray-light editable-btn btn ' + $ctrl.getClickEventName('edit') + '" tooltip-placement="bottom" tooltip="Edit">' + $ctrl.LCS.getISBDiv('pencil', 2, 'gray') + '</a>' +
                 '<a class="btnRemove gray-light editable-btn btn ' + $ctrl.getClickEventName('remove') + '">' + $ctrl.LCS.getISBDiv('trash', 2, 'gray', 'tooltip-placement="left" tooltip="Remove"') + '</a>')
         }
     }

    function onBlockLoaded() {
        if ($ctrl.canEdit && !$ctrl.list.items.length) {
            addLocation();
        }
    }

    function setWeatherAddress(firstLoc) {
        $ctrl.broadcastRoot('WEATHER_ADDRESS_CHANGED', firstLoc);
    }

    function afterProcessUpdates(result) {
        if (result){
            if($ctrl.list.totalCount !== 0) {
                $ctrl.setWeatherAddress($ctrl.list.getElementByIndex(0));
            }
            if(result.type === 3 || result.updateOrder){//on remove or on order changed
                var els = $ctrl.element.querySelectorAll('.row-schedule .locno .circle-small');
                if(els && els.length > 0){
                    _.each(els, function (el, i){
                       el.innerText = i + 1;
                    });
                }
            }
        }
    }

    function onUpdated(result) {
        if(!result){return;}
        $ctrl.LCS.timeout(function () {
            var item = result ? result.item : null,
                el = item ? _.find($ctrl.list.items, function (el) {return el._id === item._id;}) : null;
            if(item && el){
                $ctrl.setWeatherAddress($ctrl.list.getElementByIndex(0));
            }
        }, 0);
    }

    function importLocation (result) {
        console.log('onItemPopoverChanged');
        var item = result && result.item ? result.item : null;
        if(item){
            addLocation(item);
        }
    }

    function getBottomActions() {
return '<div tabindex="{{$ctrl.getTabIndex($ctrl.list.items.length, 2)}}" class="import-wrapper wide-tooltip '+$ctrl.getTableClass()+'">' +
            '<div class="hover-underline wrap-dd-select with-sb-popover" tooltip="Import previously saved locations." tooltip-placement="top" ' +
    'parent-container="false" '+
    //'popover-container=".callsheet-blocks .edit-mode-template" ' +
    'popover-type="'+$ctrl.PopoverTypesOther.ImportLocation+'">' +
                '<div class="selected">' +
                    '<div class="selected-text">Import Location</div>' +
                '</div>' +
            '</div>' +
        '</div>';
    }

    function addLocation(item) {
        $ctrl.create(null, null, {
            address: item ? item.address : null,
            addressNote: item ? item.addressNote : null,

            hospital: item ? item.hospital : null,
            hospitalNote: item ? item.hospitalNote : null,

            parking: item ? item.parking : null,
            note: item ? item.note : null,

            productId: $ctrl.CPS.productId,
            companyId: $ctrl.CPS.companyId,
            callsheetId: $ctrl.callsheetId,

            order: $ctrl.list.items.length
        }, true);
    }

    function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {

        if(isMobileRowDetails && c.viewRowDetailsMobile ) {
            return get(c);
        }

        if (c.id.indexOf('.1') !== -1) {

        } else {
            var n = $ctrl.getColumnByProp(c.prop === 'parking' ? 'note' : (c.prop + 'Note'), true),
            nV = item[n.prop],
                hideEmptyContent = !canEdit && n && nV,
                t = (isFirst ? getH() : '') +
                   ('<div class="visible-xs hide-print subtitle">'+$ctrl.getHeaderColumnContent(isMobileRowDetails, c)+'</div>') +
                    get(_.extend({
                        canChangeOnEdit: c.canEdit,
                        canEdit: false,
                        formattedAddress: true,
                        hideEmptyContent: hideEmptyContent
                    }, c), 'without-height-padding');
            if (n) {
                if (!$ctrl.canEdit && n.canEdit && !nV) {
                } else {
                    t += '<div class="full-width note-info italic' + (hideEmptyContent && !item[c.prop] ?' without-margin' : '') + '">' +
                            $ctrl.LCS.getISBDiv('info', 3, 'gray pull-left with-margin-right visible-xs hide-print') + get(n, ' without-height-padding') + '</div>';
                }
            }

            return '<div class="' + (cls ? cls : '') + '">' + t + '</div>';
        }

        return '';

        function getH() {
            if (!$ctrl.canEdit && $ctrl.list.items.length === 1) {
                return '';
            }
            var o = getOrder(item);
        return '<h2 class="grid-title visible-xs hide-print">' +
                    '<div class="full-width">Location ' + o + '</div>' +
                    '<div class="subt full-width"> ' + (o === 1 ? 'First' : (o === 2 ? 'Second' : (o === 3 ? 'Third' : (o === 4 ? 'Fourth' : 'Other')))) + ' stop</div>' +
                '</h2>';
        }

        function get(c, otherCls) {
            return c ? $ctrl.getDisplayItemCol(item, c, otherCls, canEdit, textOnly, isMobile, isMobileRowDetails) : '';
        }
    }

    function onOtherPopoverTypes(result, popoverType, drpMenuId) {
        console.log('onOtherPopoverTypes');
        if (!result) {
            result = {};
        }
        if (!result.$ctrl) {
            result.$ctrl = {};
        }
        switch (popoverType) {
            case $ctrl.PopoverTypesOther.SaveLocation:
                result.$ctrl.scriptLoadingService = $ctrl.CurrentProduct.scriptLoadingService;
                result.template = '<save-callsheet-location-popover ' +
                    'field-class="form-control" ' +
                    'c-cls-attr="without-underline" ' +
                    'item="::$ctrl.item" ' +
                    'required="true" ' +

                    'header="Save to Location Library" ' +

                    'id="' + drpMenuId + '" ' +
                    'script-loading-service="::$ctrl.scriptLoadingService" ' +
                    'on-update="$ctrl.onUpdate(result)' +
                    '"></save-callsheet-location-popover>';
                break;
            case $ctrl.PopoverTypesOther.ImportLocation:
                result.$ctrl.onUpdate = $ctrl.importLocation;
                result.$ctrl.scriptLoadingService = $ctrl.CurrentProduct.scriptLoadingService;
                result.template = '<import-callsheet-location-popover ' +
                    'id="' + drpMenuId + '" ' +
                    'header="Import from Location Library" ' +
                    'script-loading-service="::$ctrl.scriptLoadingService" ' +
                    'on-update="$ctrl.onUpdate(result)"' +
                    '></import-callsheet-location-popover>';
                break;
        }

        return result;
    }
}

