            } else {
                templateUrl = tAttrs.templateUrl;
            }
            if (tAttrs.template !== undefined) {
                $templateCache.put(templateUrl, tAttrs.template);
            }
            return templateUrl;
        },
        replace: true,
        scope: true,
        controller: ['$scope', '$element', function($scope, $element) {
