function TempContactListsService(ApiService, model) {
    var service = ApiService(model, {
        listType: 'isList'
    });

    service.getAll = getAll;
    service.getAllPredef = getAllPredef;
    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;

    return service;

    function getAll(query, pageSize, populate, successcb, errorcb, withoutResourceObject) {
        var withOther = false;//query.addUnassigned;
        if (query.addUnassigned) {
            delete query.addUnassigned;
        }
        return service.getAllInit(query, pageSize, populate, function (list) {
            return successcb([].concat(getPredef(query, withOther)).concat(_.filter(list, {type: 6})));
        }, errorcb, withoutResourceObject);
    }

    function getAllPredef(query, pageSize, populate, successcb, errorcb, withoutResourceObject) {
        var withOther = true;
        //return successcb(isConfirmations ? [] : getPredef(query, withOther));
        return successcb(getPredef(query, withOther));
    }

    function getPredef(query, withOther) {
        var l = [{
            name: "Crew",
            _id: "2",
            order: -5,
            icon: 'contacts-2',
            active: true,
            isPredef: true,
            isHarcoded: true,
        }, {
            name: "Talent",
            _id: "1",
            order: -4,
            icon: 'contacts-1',
            active: true,
            isPredef: true,
            isHarcoded: true,
        }, {
            name: "Extras",
            _id: "3",
            order: -3,
            icon: 'contacts-3',
            active: true,
            isPredef: true,
            isHarcoded: true,
        }, {
            name: "Clients",
            _id: "4",
            order: -2,
            icon: 'contacts-4',
            active: true,
            isPredef: true,
            isHarcoded: true,
        }];
        var p =  [{
            name: query.callsheetId ? ('Call Sheet Recipients') : ((query.productId ? 'Project' : 'All') + ' Contacts'),
            _id: 'All',
            order: -6,
            icon: 'contacts-all',
            active: true,
            isPredef: true,
            isHarcoded: true,

        }].concat(l);

        var d = {
            name: "Unassigned",
            _id: "Unassigned",
            order: -1,
            icon: 'contacts-unassigned',
            iconLevel: 3,
            active: true,
            isPredef: true,
            isHarcoded: true,
            hideEmpty: true
        };

        if(withOther) {
            p.push(d);

            /*//todo implement add recipiens that are not in project contacts but are in contacts -> should add to project contacts and recipients
            p.push({
                name: "Other Contacts",
                _id: "GeneralContacts",
                order: -1,
                icon: 'contacts-all',
                active: true,
                isPredef: true,
                isHarcoded: true,
                hideEmpty: true,
            });*/
        }else{
            d.withLabelAfter = 'Lists';
            p.push(d);
        }

        return p;
    }

    function getChangedFieldForUpdateOther() {
        return ['profilePictureURL'];
    }
}

