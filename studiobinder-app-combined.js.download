                    '<div class="form-group field">' +
                        '<div class="form-group">' +
                            '<div class="custom-checkbox small with-label"><label><input type="checkbox" ng-click="$ctrl.emailSettings.newQFavorited = !$ctrl.emailSettings.newQFavorited" ng-checked="$ctrl.emailSettings.newQFavorited == true"><span><span>Email me when someone favors a question that I posted</span><span></label></div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="form-group field">' +
                        ' <div class="form-group">' +
                            ' <div class="custom-checkbox small with-label"><label><input type="checkbox" ng-click="$ctrl.emailSettings.newCForACreated = !$ctrl.emailSettings.newCForACreated" ng-checked="$ctrl.emailSettings.newCForACreated == true"><span><span>Email me when someone comments on an answer that I posted<span></span></label></div>' +
                        ' </div>' +
                    '</div>' +
                    '<div class="form-group field">' +
                        '<div class="form-group">' +
                            '<div class="custom-checkbox small with-label"><label><input type="checkbox" ng-click="$ctrl.emailSettings.newAFavorited = !$ctrl.emailSettings.newAFavorited" ng-checked="$ctrl.emailSettings.newAFavorited == true"><span><span>Email me when someone favors an answer that I posted</span></span></label></div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="form-group field">' +
                        '<div class="form-group">' +
                            '<div class="custom-checkbox small with-label"><label><input type="checkbox" ng-click="$ctrl.emailSettings.newCFavorited = !$ctrl.emailSettings.newCFavorited" ng-checked="$ctrl.emailSettings.newCFavorited == true"><span><span>Email me when someone favors a comment that I posted</span></span></label></div>' +
                        '</div>' +
                    '</div>' +
                    '<h3 class="onemail text-left spacing-half-top">Activity related to what I follow</h3>' +
                    '<div class="form-group field">' +
                        '<div class="form-group">' +
                            '<div class="custom-checkbox small with-label"><label><input type="checkbox" ng-click="$ctrl.emailSettings.newQForSubtopic = !$ctrl.emailSettings.newQForSubtopic" ng-checked="$ctrl.emailSettings.newQForSubtopic == true"><span><span>Email me when new questions are posted in my subscribed topics</span></span></label></div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="form-group field">' +
                        ' <div class="form-group">' +
                            ' <div class="custom-checkbox small with-label"><label><input type="checkbox" ng-click="$ctrl.emailSettings.newQForFollowing = !$ctrl.emailSettings.newQForFollowing" ng-checked="$ctrl.emailSettings.newQForFollowing == true"><span><span>Email me when those that I follow post new questions</span></span></label></div>' +
                        ' </div>' +
                    '</div>' +
                    '<div class="form-group field">' +
                        ' <div class="form-group">' +
                            ' <div class="custom-checkbox small with-label"><label><input type="checkbox" ng-click="$ctrl.emailSettings.newAForFollowing = !$ctrl.emailSettings.newAForFollowing" ng-checked="$ctrl.emailSettings.newAForFollowing == true"   ><span><span>Email me when those that I follow post new answers</span></span></label></div>' +
                        ' </div>' +
                    '</div>' +
                    '<div class="form-group field">' +
                        ' <div class="form-group">' +
                            ' <div class="custom-checkbox small with-label"><label><input type="checkbox" ng-click="$ctrl.emailSettings.newCForFollowing = !$ctrl.emailSettings.newCForFollowing" ng-checked="$ctrl.emailSettings.newCForFollowing == true"><span><span>Email me when those that I follow post new comments</span></span></label></div>' +
                        ' </div>' +
                    '</div>' +
                    '<h3 class="onemail text-left spacing-half-top">Activity related to my favorites</h3>' +
                    '<div class="form-group field">' +
                        ' <div class="form-group">' +
                            ' <div class="custom-checkbox small with-label"><label><input type="checkbox" ng-click="$ctrl.emailSettings.newAForQFavorite = !$ctrl.emailSettings.newAForQFavorite" ng-checked="$ctrl.emailSettings.newAForQFavorite == true"   ><span><span>Email me when new answers are posted for my favorite questions</span></span></label></div>' +
                        ' </div>' +
                    '</div>' +
                    '<div class="form-group field">' +
                        ' <div class="form-group">' +
                            ' <div class="custom-checkbox small with-label"><label><input type="checkbox" ng-click="$ctrl.emailSettings.newCForAFavorite = !$ctrl.emailSettings.newCForAFavorite" ng-checked="$ctrl.emailSettings.newCForAFavorite == true"><span><span>Email me when new comments are posted for my favorite answers</span></span></label></div>' +
                        ' </div>' +
                    '</div>' +
                    '<h3 class="onemail text-left spacing-half-top">Activity related to my followers</h3>' +
                    '<div class="form-group field">' +
                        '<div class="form-group">' +
                        ' <div class="custom-checkbox small with-label"><label><input type="checkbox" ng-click="$ctrl.emailSettings.newFollow = !$ctrl.emailSettings.newFollow" ng-checked="$ctrl.emailSettings.newFollow == true"><span><span>Email me when somebody follows me</span></span></label></div>' +
                '</div>' +
                    '</div>' +
                    '<div class="form-group text-center spacing-half-top">' +
                        '<button type="submit" class="btn btn-primary" ng-disabled="$ctrl.isUpdating" ng-click="$ctrl.save()"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true" analytics-on="click" analytics-on analytics-action="Save User Email Settings"></span> Save Settings</button>' +
                    '</div>' +
                    '</div>' +
                '</form>' +
            '</div>';
    }
}

