}

angular.module('product.sidebar.items.controller.service',[
    'list.ctrl',
    'product.document.list.item.more.component',
    'group.sbPopover.events.service'
])
.service('SidebarItemsCtrlService', SidebarItemsCtrlService);
SidebarItemsCtrlService.$inject = ['ListInitService', 'PopoverInitEventsService', 'KeyboardListService', 'CPS'];
function SidebarItemsCtrlService(ListInitService, PopoverInitEventsService, KeyboardListService, CPS) {
    console.log('SidebarItemsCtrlService');
    return function ($ctrl, $element) {

        $ctrl.KeyboardListService = KeyboardListService;
        $ctrl.ListInitService = ListInitService;
        $ctrl.PopoverInitEventsService = PopoverInitEventsService;

        $ctrl.CPS = CPS;
        $ctrl.SBStateService = CPS.SBStateService;
        $ctrl.CurrentProduct = CPS.CurrentProduct;

        $ctrl.active = {};

        $ctrl.getSidebarName = getSidebarName;
        $ctrl.canRemove = canRemove;
        $ctrl.getSelectedIdFromItem = getSelectedIdFromItem;
        $ctrl.onSelected = onSelected;

        if($ctrl.select){
            $ctrl.select = select;
        }

        $ctrl.onAdded = onAdded;

        $ctrl.$onInit = $onInit;
        $ctrl.$onDestroy = $onDestroy;
        $ctrl.toggleInnerSidebar = toggleInnerSidebar;
        $ctrl.getNew = getNew;
        $ctrl.getParams = getParams;

        return $ctrl;


        function getParams() {
            return {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                documentId: $ctrl.item._id,
                type: $ctrl.item.type
            };
        }

        function toggleInnerSidebar(e) {
            var clsose = 'CLOSE_SIDEBAR_' + $ctrl.getSidebarName();
            //console.log(close);
            if (e) {
                e.preventDefault(e);
                e.stopPropagation(e);
            }
            $ctrl.broadcastRoot(clsose);
        }

        function $onInit() {
            if ($ctrl.compOptions && !$ctrl.compOptionsUpdated) {
                var compOptions;
                try {
                    compOptions = JSON.parse($ctrl.compOptions);
                    if (compOptions) {
                        $ctrl = $.extend($ctrl, compOptions);
                        $ctrl.compOptionsUpdated = true;
                    }
                } catch (e) {
                }
            }

            var item_event = $ctrl.elemType + '_ITEM';
            $ctrl.Events = {
                Added: 'ADDED_' + item_event,
                Updated: 'UPDATED_' + item_event,
                Removed: 'REMOVED_' + item_event,

                AddFromTop: 'ADD_FROM_PAGE_TOP_' + $ctrl.elemType
            }

            if($ctrl.onInitOther){
                $ctrl.onInitOther();
            }

            $ctrl = new $ctrl.ListInitService($ctrl, _.extend({
                $element: $element,
                preloadAll: true,
                withProperty: $ctrl.withProperty,
                onAllLoaded: onAllLoaded
            }, $ctrl.getPaginationServiceParams()));

            $ctrl.select = select;
            $ctrl.getBgColor = getBgColor;
            $ctrl.getColorStyle = getColorStyle;
            $ctrl.getItemById = getItemById;

            if ($ctrl.canEdit) {
                loadSideMenu();

                $ctrl.edit = edit;
                $ctrl.remove = remove;
                $ctrl.duplicate = duplicate;

                $ctrl.addRootWatcher($ctrl.Events.Added, $ctrl.onAdded);
                $ctrl.addRootWatcher($ctrl.Events.Updated, onUpdated);
                $ctrl.addRootWatcher($ctrl.Events.Removed, onGroupRemoved);
                $ctrl.addRootWatcher($ctrl.Events.AddFromTop, onAddFromTop);

                bind(true);

                if($ctrl.onPostInitOther) {
                    $ctrl.onPostInitOther();
                }
            }

            $ctrl.getAll();

            function onAddFromTop(result) {
                console.log('ADD_FROM_PAGE_TOP_' + $ctrl.elemType);
                $ctrl.create(null, null, null, null, null, result.e);
            }
            function loadSideMenu() {
                $ctrl.keyboardService = new $ctrl.KeyboardListService({
                    itemTitle: $ctrl.objectType,
                    objectType: $ctrl.objectType,
                    treeClass: $ctrl.treeClass,
                    isCommentsSidebar: $ctrl.isCommentsSidebar
                });

                $ctrl.getData = getData;
                $ctrl.onGroupRemoved = onGroupRemoved;
                //list items must have class inline-tree-item
                $ctrl = new $ctrl.PopoverInitEventsService($ctrl, {
                    popupPlacement: 'bottom-end',
                    isTree: true,
                    getMorePopoverTemplate: getMorePopoverTemplate
                });
            }
        }

        function getItemById(id, isAll, anchorElement) {
            var child = $ctrl.LCS.findClosestParent(anchorElement, '.subversions');
            if (child) {
                var parent = $ctrl.LCS.findClosestParent(child, '.inline-tree-item');
                if (parent) {
                    var el = $ctrl.list.getElementById(parent.getAttribute('data-id'));
                    if (el && el.subversions) {
                        return _.find(el.subversions, {_id: id});
                    }
                }
            } else {
                return $ctrl.list.getElementById(id);
            }
        }

        function $onDestroy() {
            if ($ctrl.onPopupEventsDestroy) {
                $ctrl.onPopupEventsDestroy();
            }
            bind(false);
        }

        function bind(isBind){
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('a[data-type="toggleInnerSidebar"]'), $ctrl.toggleInnerSidebar);
        }
        function select(item) {

            $ctrl.onSelected(item);
        }

        function getSidebarName(){
            return $ctrl.SBStateService.currentState.name + ($ctrl.isCommentsSidebar ? '_COMMENTS' : '') + ($ctrl.isInTreeModal ? ('_' + $ctrl.isInTreeModal) : '') + ($ctrl.getSidebarNameOther ? ('_' + $ctrl.getSidebarNameOther()) : '');
        }

        function onSelected(item) {
            if (!$ctrl.active.selectedList || $ctrl.getSelectedIdFromItem($ctrl.active.selectedList) !== $ctrl.getSelectedIdFromItem(item)) {
                $ctrl.active.selectedList = item;
                setActive($ctrl.active);
            }
        }

        function onAllLoaded() {
            console.log('onAllLoaded');
            var fromIndex;
            var active = getSearch($ctrl.active ? $ctrl.active : {});
            var l = groupItemsByVersion(_.filter($ctrl.list.items, function (item) {
                return !item.hideInInterface;
            }).reverse());

            if ($ctrl.scriptDocumentVersionId) {
                fromIndex = _.findIndex(l, {_id: $ctrl.scriptDocumentVersionId});
                if (fromIndex !== -1 && fromIndex !== 0) {
                    var el = l[fromIndex];
                    l.splice(fromIndex, 1);
                    l.splice(0, 0, el);//move current in front
                }
            }

            $ctrl.list.items = l;
            if(l.length > 0 ) {
                if (active.selectedListId) {
                    var el = _.find($ctrl.list.items, function (item) {
                        return $ctrl.getSelectedIdFromItem(item) === active.selectedListId;
                    });
                    if (!el) {
                        active.selectedListId = null;
                        active.selectedList = null;
                    } else {
                        active.selectedList = el;
                    }
                }

                if (!active.selectedListId) {
                    var max = $ctrl.list.items.length === 0 ? null : (fromIndex !== -1 && $ctrl.scriptDocumentVersionId ? $ctrl.list.getElementById($ctrl.scriptDocumentVersionId) : _.max($ctrl.list.items, function (item) {
                        return item.version;
                    }));
                    active.selectedList = max ? max : ($ctrl.list.items.length > 0 ? $ctrl.list.getElementByIndex(0) : null);
                    active.selectedListId = $ctrl.getSelectedIdFromItem(active.selectedList);
                }
            } else{
                active.selectedListId = null;
                active.selectedList = null;
            }
            setActive(active);
            console.log('selectedListId: ' + active.selectedListId);
            $ctrl.allLoaded = true;

            function groupItemsByVersion(items) {
                var i, n = items.length, l = {}, list = [];
                for (i = n-1; i >= 0; i--) {
                    var item = items[i], v = item.scriptVersionId;
                    if(v && v.subversion > 0){
                        if(!l[v]) {
                            l[v] = [];
                        }
                        l[v].push(item);
                        items.splice(i, 1);
                    }
                }
                n = items.length;
                for (i = 0;i < n; i++) {
                    var s = l[items[i].scriptVersionId];
                    if(s && s.length > 0) {
                        items[i].subversions = _.sortBy(s, 'subversion').reverse();
                    }
                }

                return _.sortBy(items, 'version').reverse();
            }
        }

        function setActive(active) {
            active.selectedListId = $ctrl.getSelectedIdFromItem(active.selectedList);
            setSearch(active);
            $ctrl.active = active;
            //CHANGE_DOCUMENTVERSION
            $ctrl.LCS.timeout(function () {
                console.log('CHANGE_' + $ctrl.elemType + ': ' + active.selectedListId);
                $ctrl.broadcastRoot('CHANGE_' + $ctrl.elemType, active.selectedListId);
            }, 300);
        }

        function getBgColor(item) {
            var hex = item.color;
            return hex ? hex.replace('0.25', '1') : null;
        }

        function edit(item) {
            process(item, 'update');
        }

        function duplicate(item, param, e) {
            //planFeatures testmode
            var quotaType = $ctrl.item.type === 2 ? 'scriptVersions' : null;
            process(_.extend({}, item, $ctrl.withProperty()), 'duplicate', {
                items: $ctrl.list.items
            }, quotaType, e);
        }


        function getNew() {
            var params = $ctrl.getParams();
            params.order = $ctrl.list.getNewItemOrder();
            return $ctrl.service.convertResource(params);
        }

        function remove(item) {
            process(item, 'remove');
            /*if ($ctrl.list && $ctrl.list.items && $ctrl.list.items.length > 1 ){ //must remain at least one version
                process(item, 'remove');
            }*/
        }

        function process(item, type, params, quotaType, e) {
            if (!params) {
                params = {};
            }
            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}),{e: e});

            function process() {
                console.log(type === 'remove' ? type : (type + 'DocumentVersion'));
                var op = $ctrl.popupsService.operations[type === 'remove' ? type : (type + 'DocumentVersion')];
                $ctrl.popupsService.open(item, op, _.extend({
                    service: $ctrl.service,
                    itemTitle: $ctrl.itemTitle
                }, params), $ctrl.compOptions);
            }
        }

        function onAdded(result) {
            console.log($ctrl.Events.Added);
            var item = result && (result.item ? result.item : (result.document ? result.document : null));
            item = item && item.versionId ? $ctrl.service.convertResource(item.versionId) : null;
            if(!item.hideInInterface) {
                insertItem(item);
            }
        }

        function onUpdated(result) {
            console.log($ctrl.Events.Updated);
            var item = result && result.item ? $ctrl.service.convertResource(result.item) : null;
            if (item) {
                var changes = {}, exists;
                _.each($ctrl.service.getChangedFieldForUpdate(), function (prop){
                    changes[prop] = item[prop];
                    exists = true;
                });
                if(exists) {
                    $ctrl.replaceElementProps(item._id, changes);
                    if ($ctrl.active.selectedListId === $ctrl.getSelectedIdFromItem(item)) {
                        $ctrl.active.selectedList = _.extend($ctrl.active.selectedList, changes);
                    }
                    $ctrl.broadcastRoot('UPDATE_FROM_SIDEBAR_' + $ctrl.elemType, changes);
                }
            }
        }

        function insertItem(item) {
            if (item) {
                var fromIndex = $ctrl.list.items.length && $ctrl.scriptDocumentVersionId ? _.findIndex($ctrl.list.items, {_id: $ctrl.scriptDocumentVersionId}) : -1;
                $ctrl.list.insertElementAtIndex(item, fromIndex !== -1 ? (fromIndex + 1) : 0);

                select(item);
            }
        }

        function onGroupRemoved(result) {
            console.log($ctrl.Events.Removed);
            var item = result.item;
            if (item) {
                $ctrl.list.removeElement(item);
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.'+$ctrl.objectType+'.Remove.success', 'success', {
                    name: item.name
                });
                if ($ctrl.list.totalCount > 0) {
                    select($ctrl.list.getElementByIndex(0));
                }
            }
        }
        function getData(item) {
            return {
                versionId: item._id,
                id: item.documentId,
                type: $ctrl.objectType
            };
        }

        function getSearch(active) {
            var search = $ctrl.CPS.getSearchFilter('filter');
            if (search) {
                /*a = {selectedListId, view, type, ratio, column, scheduleDayId} -> l: s: v: t: r:, c:, d:*/
                if (search.l) {
                    active.selectedListId = search.l;
                }
            }
            return active;
        }

        function setSearch(active) {
            var info = {};
            if (active && active.selectedListId) {
                info.l = active.selectedListId;
            }
            $ctrl.CPS.setSearchFilter(info, 'filter');
        }

        function getColorStyle(item) {
            return $ctrl.service.getColorStyle(item);
        }

        function getMorePopoverTemplate(item, isMobile) {
            var itemTitle = $ctrl.itemTitle1 ? $ctrl.itemTitle1 : $ctrl.itemTitle,
                template = '' + //fadeInDown
                    $ctrl.getSideMenuLi({
                        type: 'edit',
                        action: 'Rename ' + itemTitle,
                        icon: 'pencil'
                    }) +

                    $ctrl.getSideMenuLi({
                        type: 'duplicate',
                        action: 'Duplicate ' + itemTitle,
                        icon: 'copy'
                    });

            if ($ctrl.getMorePopoverTemplateOther) {
                $ctrl.getMorePopoverTemplateOther(item, isMobile);
            }

            if ($ctrl.canRemove(item)
                //    && !item.lastSyncedScriptId
            ) {
                template += $ctrl.getSideMenuLi({
                    type: 'remove',
                    action: 'Remove ' + itemTitle,
                    icon: 'trash',
                    withTopBorder: true,
                    aClass: 'accent'
                });
            }

            return '<ul class="dropdown-menu side-menu display-block document-sidemenu ' +$ctrl.objectType + '-sidemenu">' + template + '</ul>';
        }

        function getSelectedIdFromItem(item) {
            return item ? item._id : undefined;
        }

        function canRemove(item){
            return (!$ctrl.checkListCounterOnRemove || $ctrl.checkListCounterOnRemove && $ctrl.list && $ctrl.list.totalCount > 1) &&
          //can remove last synced script
                !(item.type === 2 && item._id===$ctrl.scriptDocumentVersionId);
        }
    }
}

angular.module('product.document.version.editor.component', [
    'apiServices.DocumentVersions',
    'apiServices.Documents',
    'apiServices.Materials',
    'components.fileUploader.fileUploader.init.controller.service',
    'services.revisionsPersistanceService'
])
.component('documentVersionEditor', {
    bindings: {
        withoutAutosaving:'<',
        item: '<?',
        classToolbarAttr: '@',
        placeholder: '<?',
        showSecondaryButtons: '<?',
        canEdit: '<?',
        isInModal: '@?',
        elemType: '@',
        savingAt: '<?',
        onSaveVersion: '&'
    },
    controller: 'DocumentVersionEditorCtrl'
})
.controller('DocumentVersionEditorCtrl', DocumentVersionEditorCtrl);

DocumentVersionEditorCtrl.$inject = ['CompInitCtrlService', 'GridItemUpdateInitCtrlService','DocumentVersionsService', 'FileUploaderInitCtrlService', 'MaterialsService', 'RevisionsPersistanceService','TemplateCompileService', 'DownloadExportService', 'MomentService', '$element'];
function DocumentVersionEditorCtrl( CompInitCtrlService, GridItemUpdateInitCtrlService, DocumentVersionsService, FileUploaderInitCtrlService, MaterialsService, RevisionsPersistanceService,TemplateCompileService, DownloadExportService, MomentService, $element) {
    console.log('DocumentVersionEditorCtrl');

    var $ctrl = this;
    $ctrl.MomentService = MomentService;
    $ctrl.DocumentVersionsService = DocumentVersionsService;
    $ctrl.DownloadExportService = DownloadExportService;

    $ctrl.changedFields = ['item'];
    $ctrl.$element = $element;
    $ctrl.element = $ctrl.$element[0];
    $ctrl.sceneEditorClass = 'sceneEditor';
    $ctrl.sceneNotesSectionId = 'sceneNotesSection';
    $ctrl.preloaderClass = 'preloader-center';

    $ctrl.localChanges = {saving: false, hasChanges: 0, updatedAt: null};
    $ctrl.s3Changes = {saving: false, hasChanges: 0, updatedAt: null};

    var scrollingContainer = '.scrollable-content.first-scrolling-wrapper',
        Delta = Quill.import('delta'),
        deltaChanges = new Delta();


    $ctrl.$onInit = $onInit;
    $ctrl.$onChanges = $onChanges;
    $ctrl.$onDestroy = $onDestroy;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;

    function $onInit() {
       resetInterval();
        $ctrl = new CompInitCtrlService($ctrl);
        $ctrl.companyId = $ctrl.CPS.companyId;
        if(!$ctrl.productId) {
            $ctrl.productId = $ctrl.CPS.productId;
        }
        $ctrl.savingToS3At = 300; // 5 min = 5 * 60s = 300s
        $ctrl.savingLocallyAt = 20; //20s
        $ctrl.service = $ctrl.DocumentVersionsService;
        $ctrl.field = 'content';

        $ctrl.dontDebounceUpdates = true;
        $ctrl.dontNotify = true;
        $ctrl.forceSave = true;

        $ctrl.quillEditorPrefix = 'documentEditor';
        $ctrl.materialId = null;
        $ctrl.currentListId = null;
        $ctrl.previousIsLocked = $ctrl.item && $ctrl.item.isLocked === true;

        $ctrl.templateCompile = new TemplateCompileService($ctrl.$element, $ctrl.getItemTemplate, $ctrl);
        $ctrl.templateCompile.loadTemplate($ctrl.onLoaded);
    }

    function resetInterval(){
        $ctrl.interval = {s3:null, l:null};
    }

    function updateInterval(isS3, m, timeout) {
        if(!$ctrl.interval){
            $ctrl.interval = {};
        }
        $ctrl.interval[getInterval(isS3)] = setInterval(m, timeout * 1000);
    }

    function clearAInterval(isS3) {
        var interval = $ctrl.interval ? $ctrl.interval[getInterval(isS3)] : null;
        if (interval) {
            clearInterval(interval);
        }
    }

    function getInterval(isS3) {
        return isS3 ? 's3' : 'l';
    }

    function getItemTemplate() {
        return ($ctrl.item ? ('<div id="' + $ctrl.sceneNotesSectionId + '" class="notes full-width sb-hide bg-white">' +
            '<div class="' + $ctrl.sceneEditorClass + ' ' + ($ctrl.item.type === 2 ? (' screenplayeditor' + ($ctrl.isInModal ? '' : ' screenplay-padding')) : '') + '"></div>' +
            '</div>'):'') +
            '<preloader-center class="' + $ctrl.preloaderClass + '"></preloader-center>';
    }

    function $onChanges(changes) {
        if (!changes) {
            return;
        }
        console.log(changes);
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i],
                change = changes[field];
            if (change !== undefined && !_.isEmpty(change.previousValue) && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                onItemChanged();
                onItemLockedChanged();
            }
        }
        return false;
    }

    function $onDestroy() {
        clearSaving();

        $ctrl.removeWatchers();
        if ($ctrl.templateCompile) {
            $ctrl.templateCompile.destroyNewScope();
        }
        if ($ctrl.templateEditorCompile) {
            $ctrl.templateEditorCompile.destroyNewScope();
        }
        if($ctrl.docWatcher){
            $ctrl.removeWatcher($ctrl.docWatcher);
        }
        if($ctrl.downloadWatcher){
            $ctrl.removeWatcher($ctrl.downloadWatcher);
        }
        clearAInterval(false);
        clearAInterval(true);
        resetInterval();
    }

    function onLoaded() {
        console.log('DocumentVersionEditorCtrl.onLoaded');
        $ctrl.sceneEditorElement = $ctrl.element.querySelector('.' + $ctrl.sceneEditorClass);
        $ctrl = new GridItemUpdateInitCtrlService($ctrl, $ctrl.DocumentVersionsService);

        if ($ctrl.canEdit) {
            $ctrl.onUpdate = onUpdate;
            $ctrl.insertFileToDb = insertFileToDb;
            $ctrl.onFileUploadComplete = onFileUploadComplete;
            $ctrl.propertyForFile = 'contentVersion';
            $ctrl = new FileUploaderInitCtrlService($ctrl);

            $ctrl.addRootWatcher('UPDATE_DOCUMENTVERSION_FROM_HISTORY', onUpdateVersionFromHistory);

            if(!$ctrl.withoutAutosaving) {
                savePeriodicallyS3();
                savePeriodicallyLocal($ctrl.savingAt);

                // Check for unsaved data
                window.onbeforeunload = saveLastMinuteChanges;
                $ctrl.addRootWatcher('UPDATE_AUTOSAVE_SEC', onAutosaveSecChanged);
            }
        }

        onItemChanged();
    }

    function clearSaving() {
        $ctrl.SessionService.setDocChangedProp('savingDocChanges', false);
        $ctrl.SessionService.setDocChangedProp('hasDocChanges', false);
        $ctrl.SessionService.setDocChangedProp('lastDocChanges', null);
    }

    function onItemLockedChanged() {
        console.log('onItemLockedChanged');
        if ($ctrl.previousIsLocked !== $ctrl.item.isLocked) {
            $ctrl.broadcastRoot('QUILL_LOCK_CHANGED', {
                id: $ctrl.quillEditorPrefix + $ctrl.item._id,
                isLocked: $ctrl.item.isLocked,
                isLockedFirst: $ctrl.item.isLockedFirst
            });
            $ctrl.previousIsLocked = _.clone($ctrl.item.isLocked);
        }
    }

    function onItemChanged() {
        console.log('onItemChanged');
        if (!$ctrl.currentItemId || $ctrl.currentItemId && $ctrl.item._id !== $ctrl.currentItemId) {

            console.log('DocumentVersionEditorCtrl:initGridItem: ' + $ctrl.item._id);
            setPreloader(true);
            clearSaving();

            $ctrl.currentItemId = $ctrl.item._id;

            if ($ctrl.docWatcher) {
                $ctrl.removeWatcher($ctrl.docWatcher);
            }
            $ctrl.docWatcher = $ctrl.addRootWatcher('SAVE_DOC_CHANGES_' + $ctrl.currentItemId, onSaveDocChanges);
            //{id: $ctrl.currentItemId, type: 'documentVersion', onSuccess: onSaveDocChanges});


            if ($ctrl.downloadWatcher) {
                $ctrl.removeWatcher($ctrl.downloadWatcher);
            }
            $ctrl.addRootWatcher('DOWNLOAD_SBX_' + $ctrl.item._id, onDownloadSBX);

            if ($ctrl.initGridItem) {
                $ctrl.initGridItem();
            }

            load();
        }
    }

    function getDescription(content){
        var d;
        if(typeof(content) === 'string') {
            d = $ctrl.LCS.convertHtmlToText(content);
        }else {
            d = '';
            var ops = content && content.ops.length > 0 ? content.ops : null;
            if (ops && ops.length > 0) {
                while (d.length < 100) {
                    _.each(ops, function (op) {
                        if (op && op.insert) {
                            d += op.insert + ' ';
                        }
                    });
                }
            }
        }
        return d ? d.substring(0, 100).replace('\n', '').replace('\f', '') : null;
    }

    function getTempContent(){
        return $ctrl.tempContent ? $ctrl.tempContent : $ctrl.editorContent;
    }

    function onDownloadSBX(ext) {
        var content = getTempContent(),
            timestamp = $ctrl.MomentService.getTimestamp(),
            filename = $ctrl.item.name + ($ctrl.item.version ? (' v' + $ctrl.item.version) : '') + ' ' + moment(timestamp).format('MM-DD-YY_HH-mm') + '.' + ext;
        $ctrl.DownloadExportService.downloadAttachment($ctrl.DownloadExportService.createBlobFromContent(filename, content || '', timestamp));
    }

    function setPreloader(isOn) {
        if (!$ctrl.preloaderEl) {
            $ctrl.preloaderEl = $ctrl.element.querySelector('.' + $ctrl.preloaderClass);
        }
        if (!$ctrl.sceneEl) {
            $ctrl.sceneEl = $ctrl.element.querySelector('#' + $ctrl.sceneNotesSectionId);
        }
        $ctrl.LCS[isOn ? 'removeClass' : 'addClass']($ctrl.preloaderEl, 'sb-hide');
        $ctrl.LCS[isOn ? 'addClass' : 'removeClass']($ctrl.sceneEl, 'sb-hide');
    }

    function onAutosaveSecChanged(val) {
        console.log('onAutosaveSecChanged: ' + val);
        savePeriodicallyLocal(val);
    }

    function onUpdateVersionFromHistory(result) {
        if (result && result.versionId === $ctrl.item._id) {
            var v = result.contentVersion ? result.contentVersion : null,
                id = v._id;
            if (id) {
                $ctrl.materialId = v.materialId;
                //update contentVersionId id
                saveDoc('contentVersionId', id, true, function (result) {
                    setContentVersion(v);
                    load(true);
                });
            }
        }
    }

    function onUpdate(result) {
        console.log('onUpdate DocumentVersion');
        var item = result ? result.item : null;
        if (item) {
            var changedFields = [
                'content',
                'description',
                'isLocked',
                'isLockedFirst',
                'lastSyncedAt',
                'lastSyncedById',
                'lastSyncedScriptId',
                'updatedAt',
                'updatedAtT'
            ]
            _.each(changedFields, function (prop){
                $ctrl.item[prop] = item[prop];
            });

            setContentVersion(item.contentVersion);
        }
        postSave('s3Changes');
    }

    function setContentVersion(contentVersion){
        console.log('setContentVersion');
        if(!contentVersion){
            console.log('contentVersion has not changed');
        }else if ($ctrl.item.contentVersionId !== contentVersion._id) {
            $ctrl.item.contentVersionId = contentVersion._id;
            $ctrl.item.contentVersion = contentVersion;
            $ctrl.materialId = contentVersion && contentVersion.materialId ? contentVersion.materialId : null;
        }

        if($ctrl.onSaveVersion) {
            $ctrl.onSaveVersion({version: $ctrl.item});
        }
    }

    function load(loadOlderVersion) {
        console.log('load version editor');
        getDownloadContent(onSuccess, loadOlderVersion);

        function onSuccess(content, loadOlderVersion) {
            var reloadContent = false;
            if (content) {
                $ctrl.editorContent = content;
            }

            if (!$ctrl.editorContent) {
                $ctrl.editorContent = $ctrl.item.content;
                reloadContent = true;
                console.log('load from content field');
            }

            if (!$ctrl.materialId || reloadContent) {
                updateContentDoc($ctrl.editorContent, true);
            }

            if (!$ctrl.placeholder) {
                $ctrl.placeholder = $ctrl.canEdit ? ($ctrl.item.type === 2 ? '' : 'Enter content…') : 'There is no content added';
            }

            $ctrl.treeType = $ctrl.item.type;
            var isScript = $ctrl.treeType === 2;

            if (!$ctrl.templateEditorCompile) {
                $ctrl.templateEditorCompile = new TemplateCompileService(null);
            }
            $ctrl.templateEditorCompile.getItemTemplate = getEditorTemplate;
            $ctrl.templateEditorCompile.loadTemplate(function () {
                console.log('sbEditor loaded');
                setPreloader(false);
            }, _.extend({
                placeholder: $ctrl.placeholder,
                editorContent: $ctrl.editorContent,
                onContentChanged: onContentChanged,
                onSelectionChanged: onSelectionChanged,
                onAddScriptNotes: onAddScriptNotes,
                onAddTitlePage: onAddTitlePage,
                showSecondaryButtons: $ctrl.showSecondaryButtons,
            }, isScript ? {
                isScriptLocked: $ctrl.item.isLocked,
                isScriptLockedFirst: $ctrl.item.isLockedFirst,
                initCharacters: $ctrl.initCharacters,
                initLocations: $ctrl.initLocations,
                changeLock: changeLock,
                onRenumberedForSync: onRenumberedForSync
            }: null), $ctrl.sceneEditorElement);

            function getEditorTemplate() {
                var type = getType();
                return "<sb-editor class='display-block clearfix position-relative " + ($ctrl.canEdit ? '' : 'readOnly') + " version-editor' " +
                    "id='" + $ctrl.quillEditorPrefix + $ctrl.item._id + "' " +
                    "with-preloader='true' " +
                    "content='$ctrl.editorContent' " +                                  //treetype === 2 -> script
                    "placeholder='" + ($ctrl.placeholder ? $ctrl.placeholder : (isScript ? 'INT. LOCATION - DAY' : null)) + "' " +
                    (type ? ("editor-type='" + type + "' ") : '') +
                    ($ctrl.canEdit ? '' : 'read-only="true" ') +
                    'class-toolbar="::\'' + $ctrl.classToolbarAttr + '\'" ' +
                    'scrolling-container="::\'' + scrollingContainer + '\'" ' +

                    "on-content-changed='$ctrl.onContentChanged(editor, html, text, content, delta, oldDelta, source)' " +
                    "on-add-script-notes='$ctrl.onAddScriptNotes(notes)' " +
                    "on-add-title-page='$ctrl.onAddTitlePage(notes)' " +
                    "show-secondary-buttons='::$ctrl.showSecondaryButtons' " +
                    (isScript ? (
                        'is-script="true" ' +
                        'is-script-locked="$ctrl.isScriptLocked" ' +
                        'is-script-locked-first="$ctrl.isScriptLockedFirst" ' +
                        "init-characters='::$ctrl.initCharacters' " +
                        "init-locations='::$ctrl.initLocations' " +
                        "change-lock='$ctrl.changeLock(isLocked)' " +
                        "on-renumbered-for-sync='$ctrl.onRenumberedForSync(renumberId)' "
                    ):'') +
                    ($ctrl.item.type === 2 ? 'autofocus="true" ' : '') +
                    '></sb-editor>';
            }
        }
    }

    /*function gzipContent() {
        var gzip = require('gzip-js'),
            options = {
                level: 3,
                name: 'hello-world.txt',
                timestamp: parseInt(Date.now() / 1000, 10)
            };

// out will be a JavaScript Array of bytes
        var out = gzip.zip('Hello world', options);
    }*/

    function getDownloadContent(onSuccess, loadOlderVersion) {
        console.log('getDownloadContent');
        if (!$ctrl.item) {
            return;
        }
        //check if there is any local version
        //check if there is any uploaded version
        //get the latest of the 2  and set it to content field
        //if local version is newer

        console.log('getDownloadContent: $ctrl.item.contentVersionId: ' + $ctrl.item.contentVersionId);
        if (!$ctrl.item.contentVersionId) {
            return onComplete();
        }//there is a saved version in s3 . get it and pass it for update

        var contentVersion = $ctrl.item.contentVersion;
        $ctrl.materialId = contentVersion && contentVersion.materialId ? contentVersion.materialId : null;

        console.log('getDownloadContent: $ctrl.materialId: ' + $ctrl.materialId);
        if (!$ctrl.materialId) {
            return onComplete();
        }

        MaterialsService.getDownloadLink({
            id: $ctrl.materialId,
            versionId: $ctrl.item.contentVersionId,
            companyId: $ctrl.item.companyId,
            productId: $ctrl.CPS.productId,
        }, function (link) {
            //var headers = security.getHttpHeaders(state, params)
            console.log('MaterialsService.getDownloadLink: $ctrl.materialId: ' + $ctrl.materialId);
            $ctrl.security.getRequest(link, null, function (result) {
                //console.log('$ctrl.security.getRequest: ' + link)
                var data = result && result.data !== 'undefined' ? result.data : null,
                    size = parseInt(contentVersion.size, 10),
                    t = contentVersion.createdTimestamp ? parseInt(contentVersion.createdTimestamp, 10) : 0;
                onComplete((data && size > 0 || !data && size === 0) ? {
                    t: t,
                    c: data,
                    v: $ctrl.item.contentVersionId
                } : null);
            }, function (err) {
               // console.log(err);
                onComplete();
            })
        }, function (err) {
            // i18nNotifications.pushForCurrentRoute(err, 'crud.file.upload.error', 'error');
            onComplete();
        });

        function onComplete(downloaded) {
            console.log('$ctrl.onCompleteDownload: ' );
            var c = null, t = null, v = null;
            if (!$ctrl.canEdit) {
                c = downloaded ? downloaded.c : null;
            } else {
                var local = RevisionsPersistanceService.get($ctrl.item._id);
                if (!downloaded) {
                    if (local) {
                        c = local.c;
                        t = local.t;
                        saveToS3(t, c, true);//save local version to s3
                        console.log('load from local');
                    }
                } else {
                    c = downloaded.c;
                    t = downloaded.t;
                    v = downloaded.v;
                    if (!local) {//there is no local
                        saveToLocal(t, c, v, true);//save downloaded version t local
                        console.log('load from downloaded');
                    } else if (!loadOlderVersion) {
                        console.log('local timestamp: ' + local.t);
                        console.log('downloaded timestamp: ' + t);
                        if (local.t > t) {//local is latest && is not already on s3
                            console.log('load from local');
                            if(!local.v) {
                                c = local.c;
                                saveToS3(local.t, c, true); // save local to s3 with local timestamp}
                                console.log('save to s3');
                            }
                        } else if (local.t < t) {//downloaded is older
                            saveToLocal(t, c, v,true); //save downloaded version to local with downloaded timestamp
                            console.log('save to local ');
                        }
                    }

                    if (loadOlderVersion) { //set the older version from history as the latest
                        //todo: overwrite timestamp???
                        saveToS3(null, c, true);
                    }
                }
            }
            return onSuccess(c);
        }
    }

    function insertFileToDb(info, onSuccess, onError) {
        info.productId = $ctrl.CPS.productId;
        info.materialId = $ctrl.materialId;
        info.versionId = $ctrl.item._id;

        if($ctrl.item.documentId) {
            info.documentId = $ctrl.item.documentId;
        }
        delete info.type;
        //insert new version
        $ctrl.service.insertContentFileVersion($ctrl.DocumentVersionsService.convertResource(info), function (result) {
            if (info.extraParam) {
                result.extraParam = info.extraParam;
            }
            onSuccess(result);
        }, function (err) {
            console.log(err);
            if (typeof (onError) === 'function') {
                onError(null);
            }
        });
    }

    function onFileUploadComplete(result) {
        console.log('onFileUploadComplete');
        onUpdate(result);

        var onSuccess = result && result.extraParam ? result.extraParam.onSuccess : null;
        if (onSuccess && typeof (onSuccess) === 'function') {
            console.log('onFileUploadComplete: onSuccess');
            onSuccess(result);
        }
    }

    function savePeriodicallyS3() {
        console.log('savePeriodicallyS3')
        savePeriodically($ctrl.savingToS3At, true);
    }

    function savePeriodicallyLocal(savingAt) {
        if (savingAt === undefined) {
            savingAt = $ctrl.LCS.getDocumentAutosavings();
            if (savingAt === undefined) {
                savingAt = $ctrl.savingLocallyAt;
            }
        }
        savePeriodically(savingAt, false);
    }

    function savePeriodically(savingAt, isS3) {
        console.log('savePeriodically' + (isS3 ? 'S3' : 'Local') + ': ' + savingAt);
        clearAInterval(isS3);
        if (savingAt === 0 && !isS3) {//dont save local if is 0
            return;
        }

        updateInterval(isS3, function () {
            saveDocContent(isS3, null);
        }, savingAt);
    }

    function onSaveDocChanges(res) {

        if(!res){return;}
        var id = res.id,
            type = res.type,
            onSuccess = typeof (res.onSuccess === 'function') ? res.onSuccess : null;

        console.log('onSaveDocChanges: ' + id);
        if (type === 'documentVersion' && $ctrl.item && id === $ctrl.item._id) {
            $ctrl.s3Changes.hasChanges = $ctrl.MomentService.getTimestamp();
            saveDocContent(true, {
                forceSave: true,
                onSuccess: onSuccess
            });
        }
    }

    function saveDocContent(isSaveToS3, other) {
        deltaChanges = new Delta();
        return updateContentDoc(getTempContent(), isSaveToS3, other);
    }

    function updateContentDoc(val, isSaveToS3, other) {
        console.log('updateContentDoc save to ' + (isSaveToS3 ? 's3' : 'local'));
        var processCalled = false;
        if (!($ctrl.canEdit || $ctrl.localChanges.hasChanges || $ctrl.s3Changes.hasChanges)) {
            return false;
        }

        var timestamp = $ctrl.MomentService.getTimestamp();

        if (isSaveToS3 && saveToS3(timestamp, val, other ? other.forceSave : false, process)) {
            return true;
        } else {
            process();
            return false;
        }

        function process(res) {
            if(!processCalled) {
                processCalled = true;
                var v = 'v';// + ($ctrl.item ? $ctrl.item._id : ''; // todo set it up
                saveToLocal(timestamp, val, v, false);
                if (other && typeof (other.onSuccess) === 'function') {
                    //console.log('updateContentDoc.process.onSuccess');
                    other.onSuccess(res);
                }
            }
        }
    }

    function onContentChanged(editor, html, text, content, delta, oldDelta, source) {
        //console.log('DocumentVersionEditorCtrl.onContentChanged');
        deltaChanges = deltaChanges.compose(delta);

        if (deltaChanges.length() > 0) {
            var timestamp = $ctrl.MomentService.getTimestamp();
            $ctrl.localChanges.hasChanges = timestamp;
            $ctrl.s3Changes.hasChanges = timestamp;
            setHasChanges();
            var saveAsJSON = false;
            //var txt = html ? $ctrl.LCS.createFragment(html).children[0].innerText(html) : '';
            $ctrl.tempContent = saveAsJSON ? editor.editor.delta : html;
        }
    }

    function setSavingChanges() {
        $ctrl.SessionService.setDocChangedProp('savingDocChanges', $ctrl.localChanges.saving || $ctrl.s3Changes.saving);
    }

    function setHasChanges() {
        $ctrl.SessionService.setDocChangedProp('hasDocChanges', $ctrl.localChanges.hasChanges || $ctrl.s3Changes.hasChanges);
    }

    function preSave(timestamp, prop, force) {
        if (!$ctrl.canEdit) {
            return false;
        }
        if (!timestamp) {
            timestamp = $ctrl.MomentService.getTimestamp();
        }

        if (force) {
            $ctrl[prop].hasChanges = timestamp;
            setHasChanges();
        }

        if (!$ctrl[prop].hasChanges) {
            console.log('no new ' + prop + ' changes');
            return false;
        }

        if ($ctrl[prop].saving) {
            console.log('already isSaving' + prop);
            return false;
        }

        console.log('save to ' + prop + ' @ ' + timestamp);
        $ctrl[prop].saving = true;
        setUpdatedAt(prop, timestamp);
        setSavingChanges();
        return true;
    }

    function setUpdatedAt(prop, timestamp, prevS3LastChanged) {
        $ctrl[prop].updatedAt = timestamp;
        $ctrl.SessionService.setDocChangedProp('lastDocChanges', timestamp ? moment(timestamp).format($ctrl.CPS.timeFormat) : prevS3LastChanged);

    }
    function postSave(prop) {
        $ctrl[prop].saving = false;
        if ($ctrl[prop].hasChanges <= $ctrl[prop].updatedAt) {
            $ctrl[prop].hasChanges = 0;
        }
        $ctrl[prop].updatedAt = null;
        setSavingChanges();
        setHasChanges();
    }

    function saveToLocal(timestamp, val, v, force) {
        var prop = 'localChanges';
        if (!preSave(timestamp, prop, force)) {
            return false;
        }

        RevisionsPersistanceService.set($ctrl.item._id, val, timestamp, v);

        postSave(prop);
        return false;
    }

    function saveToS3(timestamp, val, force, onSuccess) {
        if(getOnlineStatus() && $ctrl.dontNotifyUntil){
            $ctrl.dontNotifyUntil = null;
        }

        if($ctrl.dontNotifyUntil){
            if($ctrl.MomentService.getTimestamp() < $ctrl.dontNotifyUntil){
                console.log('hour has not passed');
                return next(false);
            }
            $ctrl.dontNotifyUntil = null;
        }

        var prop = 's3Changes';
        $ctrl.prevS3UpdatedAt = $ctrl[prop].updatedAt;
        $ctrl.prevS3LastChanged = $ctrl.SessionService.lastDocChanges;
        if (!preSave(timestamp, prop, force)) {
            return next(false);
        }
        var filename = $ctrl.DocumentVersionsService.getFilename($ctrl.item, timestamp),
        $file = $ctrl.DownloadExportService.createBlobFromContent(filename,  val, timestamp);
        $file.description = getDescription(val);
        if(!getOnlineStatus()){
            return processOffline();
        }else {
            //see if not logged in
            $ctrl.onOneFileSelected($file, false, {
                onSuccess: onSuccess
            });
            //return processOffline();

            return true;
        }

        function next(isUpdated) {
            if(typeof onSuccess === 'function'){
                onSuccess();
            }
           return isUpdated === true;
        }

        function processOffline() {
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations.openTreePopupActionsStatic, {
                btn:  'Dismiss',
                icon: 'info',
                iconLevel: 3,
                title: 'Connection Lost',
                message: '<p class="text-center">There seems to be a problem with your internet connection. To backup your latest changes to the server, please check your internet connection, and save again.</p><p class="text-center"><a ng-click="$ctrl.extraParam.download()"><span class="sbf download" style="top:0;position:relative"></span> Download Script Backup</a></p>' +
                    (getLocalStorageStatus()? '' : '<p class="text-center">If you want to work offline, please enable Local Storage on your browser.</p>') +
                    '<div class="form-group field last margin-top-half">' +
                        '<div class="custom-checkbox small with-label" style="padding-right: 5px;padding-left:60px"><label>' +
                            '<input type="checkbox" ng-click="$ctrl.notifyMe=$ctrl.notifyMe?false:true;$ctrl.extraParam.onNotify({notify: $ctrl.notifyMe})">' +
                            '<span><span class="font-size-13">Don\'t notify me for one hour</span></span>' +
                            '</label>' +
                        '</div>' +
                    '</div>',
                onConfirm: onConfirm,
                onNotify: onNotify,
                download: function () {
                    $ctrl.DownloadExportService.downloadAttachment($file);
                }
            }, $ctrl.compOptions);

            return next(false);
        }

        function onNotify(newVal) {
            $ctrl.dontNotifyUntil = newVal && newVal.notify ? $ctrl.MomentService.getNextHourTimestamp() : null;
        }

        function onConfirm() {
            //saveDocContent(true);
            setUpdatedAt(prop, $ctrl.prevS3UpdatedAt, $ctrl.prevS3LastChanged);
            postSave(prop);
        } 

        function getOnlineStatus() {
            return typeof window.navigator.onLine !== 'undefined' ? window.navigator.onLine : true;
        }

        function getLocalStorageStatus() {
            try {
                return 'localStorage' in window && window['localStorage'] !== null;
            } catch(e) {
                return false;
            }
        }
    }

    function saveLastMinuteChanges() {
        console.log('saveLastMinuteChanges');
        saveDocContent(true);
        if ($ctrl.canEdit && $ctrl.SessionService.hasDocChanges) {
            return 'There are unsaved changes. Are you sure you want to leave?';
        }
    }

    function getType() {
        switch ($ctrl.treeType) {
            case 1:
                return 'notes'; //$ctrl.withDocumentInline ? 'editorsimple' : 'doc';
            case 2:
                return 'screenplay';
            case 3:
                return 'avscript';
        }
        return null;
    }

    function onSelectionChanged(editor, range, oldRange, source) {

    }

    function changeLock(isLocked) {
        saveDoc('isLocked', isLocked);
    }

    function onRenumberedForSync(renumberId) {
        console.log('onRenumberedForSync');
        saveDocContent(true, {
            onSuccess: function (result) {
                broadcastRoot('PUBLISH_SCRIPT_2', renumberId);
            }
        });
    }

    function onAddScriptNotes(id) {
        broadcastRoot('ADD_SCRIPT_NOTES', id);
    }

    function onAddTitlePage(id) {
        broadcastRoot('ADD_SCRIPT_NOTES', id);
    }

    function broadcastRoot(m, id){
        if (id) {
            id = id.replace($ctrl.quillEditorPrefix, '');
        }
        $ctrl.broadcastRoot(m, id);
    }


    function saveDoc(field, value, forceSave, onUpdate, onError) {
        $ctrl.item[field] = value;
        $ctrl.save(forceSave, [field], onUpdate, onError);
    }
}


angular.module('apiConstants.documents.services', [
    'compOptions.documents.constant'
])
.service('DocumentsConstantsService', DocumentsConstantsService);
DocumentsConstantsService.$inject = ['SBFieldTypesService', 'DocumentsCompOptions'];
function DocumentsConstantsService(SBFieldTypesService, compOptions){
    return DocumentsConstantsServiceInit(SBFieldTypesService, compOptions);
}


function DocumentsConstantsServiceInit(SBFieldTypesService, compOptions) {
    var popupTemplate = getBasePopupTemplateByTag('document-edit'),
        PropTypes = SBFieldTypesService.PropTypes,

        Options = {
            columns: ['1', '2', '3'],
            view: 2,
            column: 3
        },

        Settings = {
            Columns: angular.copy(SBApiGridColumns['documents'](PropTypes))
        },

        Filters = [{value: true, text: 'Active'}, {value: false, text: 'Archived'}],

        CompOptions = angular.copy(compOptions),

        ListTreeServiceParams = {
            withLabelAfter: CompOptions.withLabelAfter ? CompOptions.withLabelAfter : 'Folders',
            isRecursiveTree: true,
            //cachedListName: 'documentsList',
            preLoadingTableName: 'Documents',
            ungroupOnTreeDelete: CompOptions.ungroupOnTreeDelete,

            listCheckerConsidersItemsCount: true,

            startIndent: CompOptions.startIndent,
            hideLevel0: true,
            withHarcodedAll: true,
            dontStartTreeWithAll: true,

            withArchiveGroupAsList: CompOptions.withArchiveGroupAsList, // display archive as a list
            cantDuplicateTreeOnFree: CompOptions.cantDuplicateTreeOnFree,
            moveInGroup: CompOptions.moveInGroup,
            hasTreeCopy: CompOptions.hasTreeCopy,
            hasGroupCopy: CompOptions.hasGroupCopy,
            hasTreeShare: CompOptions.hasTreeShare,
            noTreeDrag: CompOptions.noTreeDrag,
            withTreeEditPopupColumns: CompOptions.withTreeEditPopupColumns,
            updateChangedFields: CompOptions.treeUpdateChangedFields ? CompOptions.treeUpdateChangedFields : ['order', 'description']
        },

        ListParams =  {
            includeFields: ['name', 'icon', 'parentId', 'isFolder', 'createdById', 'updatedById', 'order', 'type', 'updatedAt', 'versionId', 'active', 'description'].concat(CompOptions.treeIncludeFields ? CompOptions.treeIncludeFields : []),
            searchFields: ['name'],
            orderFields: ['updatedAt','updatedAtT', 'createdAtT', 'createdAt', 'order', 'name'],
            populate: 'createdById versionId',
            defaultOrder: CompOptions.treeDefaultOrder ? CompOptions.treeDefaultOrder : 'updatedAtT',
            defaultOrderDir: CompOptions.treeDefaultOrderDir ? CompOptions.treeDefaultOrderDir : -1
        },

        KeyboardServiceParams =  {
            canCopy: ListTreeServiceParams.hasGroupCopy ? ListTreeServiceParams.hasGroupCopy : ListTreeServiceParams.hasTreeCopy,
            canMove: ListTreeServiceParams.moveInGroup
        },

        PopupOperations = {
            createDocument: {
                type: 'Create',
                template: popupTemplate,
                size: 'fieldset',
                transp: 'transparent'
            },
            updateDocument: {
                type: 'Edit',
                template: popupTemplate,
                size: 'medium'
            },
            duplicateDocument: {
                type: 'Duplicate',
                template: popupTemplate,
                size: 'fieldset',
                transp: 'transparent'
            },
        },

        Hotkeys = [
            {key: 'e', desc: 'Edit selected folder'},
            {key: 'mod+c', desc: 'Copy selected folders'},
            {key: 's', desc: 'Add folder under'},
            {key: 'mod+x', desc: 'Cut selected folders'},
            {key: 'b', desc: 'Add document under'},
            {key: 'mod+v', desc: 'Paste selected folders'},
            {key: 'backspace', desc: 'Delete selected folders'},
            /*
                {key: 'up', desc: 'First slide'},
                {key: 'down', desc: 'Last slide'},
                {key: 'left', desc: 'Previous slide'},
                {key: 'right', desc: 'Next slide'},
                {key: 'mod+f', desc: 'Enter fullscreen'},
                {key: 'esc', desc: 'Exit fullscreen'},
            */
        ],

        SidebarOptions = {
            addGroupPopupName: 'createDocument',
            editGroupPopupName: 'updateDocument',
            ungroupAdditionalMessage:  CompOptions.ungroupAdditionalMessage,
            removeAdditionalMessage:  CompOptions.removeAdditionalMessage
        };

    return {
        Settings: Settings,
        Options: Options,
        Filters: {Filters: Filters},
        ViewProp: compOptions.overviewBlockType.substring(0, compOptions.overviewBlockType.length - 1) + 'View',

        CompOptions: CompOptions,
        ListTreeServiceParams: ListTreeServiceParams,
        ListParams: ListParams,
        KeyboardServiceParams: KeyboardServiceParams,

        PopupOperations: PopupOperations,
        Hotkeys: Hotkeys,
        SidebarOptions: SidebarOptions,
    };
}


