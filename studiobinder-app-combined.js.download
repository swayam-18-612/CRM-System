CallsheetEditPopupCtrl.$inject = ['CallsheetStep1PopupEditCtrlService', 'CallsheetsConstantsService', '$element'] ;
function CallsheetEditPopupCtrl(CallsheetStep1PopupEditCtrlService, constantsService, $element) {
    var $ctrl = this;
    $ctrl.withLabel = true;

    $ctrl.defaultProp = 'title';
    $ctrl.disabledText = '$ctrl.isUpdating===true||!$ctrl.formHolderItem[$ctrl.formName].$valid';
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getItemPopupTemplate = getItemPopupTemplate;
    $ctrl.isValidForm = isValidForm;

    $ctrl = new CallsheetStep1PopupEditCtrlService($ctrl, $element);

    //todo: this is a fast hack. the original isValidform dpenst seem to work
    function isValidForm(){
        return $ctrl.element.querySelector('#formControl_undefined_title_callsheet').value.trim()!=='';
    }
    function setTemplateData() {
        //for scheduling and contacts
        if(!$ctrl.compOptions) {
            var compOptions = _.extend({}, constantsService.CompOptions);
            $ctrl = _.extend($ctrl, compOptions);
            $ctrl.compOptions = JSON.stringify(compOptions);
        }
        $ctrl.withFooterBtns = true;
        $ctrl.withBtnDisabled = true;
        $ctrl.popupTitle = $ctrl.isDuplicate ? 'Duplicate Call Sheet' : ($ctrl.isNew ? 'Call Sheet Details' : 'Rename Call Sheet');
        $ctrl.btnText = '<span>' + ($ctrl.isDuplicate ? 'Duplicate' : ($ctrl.isNew ? 'Create' : 'Save')) + '</span><span class="hide-ipad"> ' +$ctrl.itemTitle +'</span>';

        if($ctrl.isDuplicate){
            $ctrl.icon = 'copy';
            $ctrl.iconLevel = 3;
            $ctrl.firstBtnCls = 'colmax394';
            $ctrl.firstBtnMethod = 'saveCSDetails';
        }else{
            $ctrl.icon = 'callsheets';
            $ctrl.iconLevel = 8;
           // $ctrl.modalBodyFormClass ='longest';
            $ctrl.modalBodyFormClassOther = 'longest';
        }
    }

    function getItemPopupTemplate() {
return '<form class="full-width" name="$ctrl.formHolderItem[$ctrl.formName]" novalidate autocomplete="off">' +
            '<div ms-form class="full-width msform" on-next="$ctrl.msFormOnNext()">' +
                '<fieldset class="fieldset"><div class="display-block clearfix">' +
                    $ctrl.getItemPopupFieldsetContent({
                        btn: getFirstStepBtn(),
                        body: getFirstBody()
                    }) +
                '</div></fieldset>' +

                ($ctrl.isNew && !$ctrl.isDuplicate ? ('<fieldset class="fieldset"><div class="display-block clearfix">' +
                    $ctrl.getItemPopupFieldsetContent({
                        btn: getSecStepBtn(),
                        headerInfo: {title: 'Select Your Layout'},
                        body: getSecBody()
                    }) + '</div></fieldset>') : '') +
            '</div>' +
        '</form>';

        function getFirstStepBtn() {
            return $ctrl.isDuplicate ? null : ($ctrl.isNew ? ('<button data-required="true"  class="btn btn-primary max-width300 nextbtn '+($ctrl.pageClass||'')+'" ng-disabled="'+$ctrl.disabledText+'" ng-class="{\'disabled\':'+$ctrl.disabledText+'}">Next <span class="hide-ipad">»</span></button>') :
                ('<button class="btn btn-primary max-width300 submitbtn '+($ctrl.pageClass||'')+' ' + $ctrl.getBtnActionCls()+'" type="submit" data-type="saveCSDetails" analytics-on analytics-action="'+$ctrl.removeHtmlTags($ctrl.btnText)+'" ng-disabled="'+$ctrl.disabledText+'" ng-class="{\'disabled\':'+$ctrl.disabledText+'}"> <span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> '+$ctrl.btnText+'</button>' ));
        }

        function getFirstBody() {
            return '<div class="colmax394 centered" id="formCallsheetDetails">' + $ctrl.getCSForm() + '</div>' +
            ($ctrl.isDuplicate ? '' : getProgress(1));
        }

        function getSecStepBtn() {
            return '<button class="max-width200 margin-right10 btn btn-small transparent big callSheet-outline previousbtn hide-ipad" type="button">« Previous</button>' +
                '<button class="max-width200 btn btn-primary submitbtn '+($ctrl.pageClass||'') + ' ' + $ctrl.getBtnActionCls()+'" type="submit" data-type="saveCSDetails" analytics-on analytics-action="'+$ctrl.removeHtmlTags($ctrl.btnText)+'" ng-disabled="'+$ctrl.disabledText+'" ng-class="{\'disabled\':'+$ctrl.disabledText+'}"> <span class="sbf loadingicon animate-spin pull-left" ng-show="$ctrl.isUpdating===true"></span>  '+$ctrl.btnText+'</button>';
        }

        function getSecBody() {
            return '<div class="centered" style="overflow: scroll; max-height: 260px;">' +
                '<callsheet-templates value="::$ctrl.item.templateId" on-change="$ctrl.onTemplateChanged(selected)" page-class="::$ctrl.pageClass"></callsheet-templates>' +
                '</div>' +
                getProgress(2);
        }

        function getProgress(step) {
            if(!$ctrl.isNew){return '';}
            var a = 'with-primary-bg-before active';
            return '<ul class="progressdots margin-top-half hide-ipad ' + $ctrl.pageClass + '">' +
                '<li><button class="' + (step === 1 ? a : 'previousbtn') + '"></button></li>' +
                '<li><button '+(step === 1 ?'data-required="true" ':'')+' class="' + (step === 1 ? 'nextbtn' : a) + '"></button></li>' +
                '</ul>';
        }
    }
}

angular.module('product.callsheet.noDayBreaksPopup.component', [
