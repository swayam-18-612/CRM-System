                        if (name === parName && value) {
                            domNode = BlotService.setParClass(domNode, parClass);

                           /* if (isCustom) {
                                domNode = BlotService.setDataset(domNode, 'parType', parType);
                            }*/
                            if (parType !== ParTypes.scene.v) {
                                delete domNode.sceneInfo;
                            }
                            BlotService.addScene(node);
                        }

                        if (isCustom){
                            _.each(propArray, function(prop){
                                if(name === ('data-' + prop)) {
