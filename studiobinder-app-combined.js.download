angular.module('product.callsheet.recipientsPage.component', [
    'product.callsheet.recipients.page.controller.service',
    'product.callsheet.recipients.group.component',
    'apiConstants.CallsheetRecipients.services'
])
.component('callsheetRecipients', getCallsheetRecipientsComponentParams('CallsheetRecipientsPageCtrl'))
.controller('CallsheetRecipientsPageCtrl', CallsheetRecipientsPageCtrl);
CallsheetRecipientsPageCtrl.$inject = ['CallsheetRecipientsPageCtrlService', 'CallsheetRecipientsConstantsService', '$element'];
function CallsheetRecipientsPageCtrl(CallsheetRecipientsPageCtrlService, constantsService, $element) {
    console.log('CallsheetRecipientsPageCtrl');
//preloading for cast must share contacts in the same table
    var $ctrl = this;

    $ctrl.onPageRecipientsInitOther = onPageRecipientsInitOther;

    $ctrl = new CallsheetRecipientsPageCtrlService($ctrl, $element, constantsService);

    function onPageRecipientsInitOther() {
        $ctrl.mode = $ctrl.Modes.Recipients;
        $ctrl.title = '<span class="hide-ipad">Call Sheet </span>Recipients';
    }
}


