})
.service('BreakdownsPageCtrlService', BreakdownsPageCtrlService);
BreakdownsPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'BreakdownsPageCtrlServiceInjectors'];
function BreakdownsPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    return function ($ctrl, $element, printPageParams) {

        console.log('BreakdownsPageCtrlService');
        $ctrl.isScheduling = false;

        $ctrl.isPreloadTable = isPreloadTable;
        $ctrl.getGroupFilters = getGroupFilters;

        $ctrl.isNotEmptyGroupState = isNotEmptyGroupState;
        $ctrl.getDisplayListCount = getDisplayListCount;
        $ctrl.hasLists = hasLists;
        $ctrl.isWithSidebar = isWithSidebar;
        $ctrl.getCollabBannerInfo = getCollabBannerInfo;

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);

        return $ctrl;

        function isWithSidebar() {
            return !$ctrl.hideSidebar;
        }

        function getCollabBannerInfo() {
            return {txt: 'Create and share your own script breakdowns for free.', campaign: 'collab-breakdowns'};
        }

        function hasLists() {
            return $ctrl.getDisplayListCount() > 0;
        }

        function getDisplayListCount(list) {
            var l = $ctrl.listTreeService.getList((list ? list : $ctrl.listTreeService.active).selectedListId);
            return l ? l.length : 0;
        }

        function isNotEmptyGroupState() {
            var l = $ctrl.listTreeService.active.selectedList;
            return $ctrl.listTreeService.isNotEmptyGroupState($ctrl.currentList) ||
                l && l.nodes && l.nodes.length > 0 && l.nodes[0].count > 0;
        }

        function isPreloadTable() {
            return !setInitialSceneId();
        }

        //backwards compatibility : send /breakdowns?scene=val to  /breakdown/val/
        function setInitialSceneId() {
            var scene = $ctrl.CPS.getSearchFilter('scene');
            if (scene && $ctrl.allStrips && _.find($ctrl.allStrips, {_id: scene})) {
                $ctrl.CPS.transitionTo('user.product.breakdown', $ctrl.CPS.currentPathParams({
                    scene: scene,
                    productId: $ctrl.CPS.productId
                }, $ctrl.CPS.isCollaborator ? $ctrl.CPS.rolePaths.collabPath : $ctrl.CPS.rolePaths.currentUserPath));
                return true;
            }
        }

        function getGroupFilters() {
            return {
                type: 1
            };
        }
    }
}

angular.module('product.breakdowns.page.init.service.component', [
    'apiServices.Scripts',
    'product.breakdowns.group.component',
    'page.group.controller.service'
])
.service('BreakdownsPageInitServiceCtrl', BreakdownsPageInitServiceCtrl);
BreakdownsPageInitServiceCtrl.$inject = ['PageTreeInitCtrlService'];
function BreakdownsPageInitServiceCtrl(PageTreeInitCtrlService) {
    return function ($ctrl, $element, initOptions) {
        $ctrl.scriptOrder = 'scriptPosition';

        $ctrl.getEmptyStateButtons = getEmptyStateButtons;
        $ctrl.getDrpSettingsAfter = getDrpSettingsAfter;
        $ctrl.getGroupBodyAddon = getGroupBodyAddon;
        $ctrl.onChangedGroupFilters = onChangedGroupFilters;

        $ctrl.preProcessGroupItems = preProcessGroupItems;
        $ctrl.preBroadcastPreload = preBroadcastPreload;

        $ctrl.getGroupFilterButtonsOther = getGroupFilterButtonsOther;
        $ctrl.getGroupFilterButtonsOtherXS = getGroupFilterButtonsOtherXS;

        $ctrl.afterProcessUpdatesG = preBroadcastPreload;
        $ctrl.getPrintScriptInfo = getPrintScriptInfo;

        $ctrl.showTopFilters = showTopFilters;

        if(!$ctrl.serviceName) {
            $ctrl.serviceName = 'ContactsPageCtrlServiceInit';
        }

        $ctrl.onPageTreeInit = onPageTreeInit;

        var o = _.extend({}, initOptions),
            s = {
                showOnlyHalf: function () {
                    return !$ctrl.CPS.hasQuotaType('stripboard');
                }
            };

        if(!o.otherOptions) {
            o.otherOptions = {};
        }
        o.otherOptions.listTreeServiceParams = _.extend(o.otherOptions.listTreeServiceParams ? o.otherOptions.listTreeServiceParams : {} , s);

        $ctrl = new PageTreeInitCtrlService($ctrl, $element, o);

        if($ctrl.canEdit) {
            if ($ctrl.isScheduling) {
                $ctrl.SettingsActions = []
                  //todo bring back share
                   /*
                   .concat(
                        ($ctrl.LCS.isMobileSize && $ctrl.showShareInListNav && $ctrl.CPS.isAuthenticated && $ctrl.CPS.productId) ? [{
                            id: 'btnShare',
                            name: 'Share List',
                            icon: 'link',
                            type: 'shareList',
                            active:true,
                            cond: '$ctrl.isActiveGroup()',
                            callDirectly: true
                            //tooltip: 'Reorder strips by shooting location or scene number'
                        }] : []
                    )
                    */
                    .concat([
                        {
                            id: 'btnReorderStrips',
                            name: 'Reorder Strips',
                            icon: 'sort-strips',
                            iconLevel: 4,
                            type: 'autoSort',
                            active:true,
                            //tooltip: 'Reorder strips by shooting location or scene number'
                            exposeOnDesktop: true,
                            quotaType: $ctrl.quotaTypeCustomize
                        },
                        {
                            id: 'btnAddDayBreaks',
                            name: 'Add Day Breaks',
                            icon: 'daybreak',
                            iconLevel: 3,
                            type: 'autoBreak',
                            active:true,
                            exposeOnDesktop: true
                            //tooltip: 'Auto-add day breaks based on page count'
                        },
                        {
                            id: 'btnAddScene',
                            name: 'Add Scene',
                            icon: 'add-scene',
                            iconLevel: 4,
                            type: 'createFromTop',
                            data: $ctrl.StripTypes.Scene,
                            active:true,
                            isMobileOnly: true,
                            callDirectly: true
                        },
                        {
                            id: 'btnAddBanner',
                            name: 'Add Banner',
                            icon: 'banner',
                            iconLevel: 4,
                            type: 'createFromTop',
                            data: $ctrl.StripTypes.Banner,
                            active:true,
                            isMobileOnly: true,
                            callDirectly: true
                        },
                        {
                            id: 'btnAddDay',
                            name: 'Add Day Break',
                            icon: 'daybreak',
                            iconLevel: 4,
                            type: 'createFromTop',
                            data: $ctrl.StripTypes.DayBreak,
                            active:true,
                            isMobileOnly: true,
                            callDirectly: true
                            //tooltip: 'Reorder strips by shooting location or scene number'
                        }/*
                        {
                            id: 'btnRemoveStrips',
                            name: 'Remove Strips',
                            icon: 'trash',
                            type: 'removeScheduling',
                            //tooltip: 'Remove Strips, DayBreaks, Banners, or Elements'
                        }*/
                    ]);
            }/*else{
                $ctrl.SettingsActions = [{
                    id: 'btnRenumberStrips',
                    name: 'Renumber scenes',
                    icon: 'renumber',
                    type: 'renumberScenes',
                    tooltip: 'Renumber scenes'
                }];ctrl.SettingsActions
            }*/
        }

        $ctrl.processSettings = processSettings;

        return $ctrl;

        function showTopFilters(){
            return $ctrl.isScheduling ? $ctrl.hasLists() : $ctrl.allStrips && $ctrl.allStrips.length > 0;
        }

        function getPrintScriptInfo(){
            var el = '',
                cs = [];
            _.each($ctrl.allStrips, function (strip) {
                if (strip.characters && strip.characters.length > 0) {
                    cs = _.unique(cs.concat(strip.characters));
                }
            });
            if(cs && cs.length > 0) {
                _.each(_.sortBy(cs, 'order'), function (c, i) {
                    el += '<span>' + (i === 0 ? '' : '<span class="dot-separator smaller"></span> ') +
                        '<span class="numbered-char smallerx inline-block">' + c.currentId + '</span> <span class="uppercase">' + c.name + '</span></span>';
                });
            }
            return el ? ('<div class="cast-members full-width font-size-10"><div class="header full-width">Cast Legend</div><div class="full-width">' + el + '</div></div>') : '';
        }

        function onPageTreeInit() {
            $ctrl.listTreeService.preloadingType = $ctrl.PreloadingTypes.Scripts;
            $ctrl.onPageInit();

            $ctrl.addRootWatcher('RELOAD_ALL_STRIPS', reloadAll);
        }

        function getGroupBodyAddon() {
            return {
                'is-scheduling': '"::$ctrl.isScheduling"',
                'is-breakdown': '"::$ctrl.isBreakdown"',
                'pre-process-group-items': '"$ctrl.preProcessGroupItems(item)"'
            };
        }

        function onChangedGroupFilters(type) {
            if(!$ctrl.isCommentsSidebar && type === 'selectedFilter'){
                console.log('onChangedGroupFilters: type = ' + type);
                $ctrl.preBroadcastPreload();
            }
        }

        function preBroadcastPreload() {
            $ctrl.allStrips = $ctrl.scriptLoadingService.getProcessedStripsTables({
                type: 1
            }, $ctrl.scriptOrder, false, $ctrl.CPS.hasQuotaType('stripboard')).strips;
        }

        function reloadAll(allStrips) {
            console.log('RELOAD_ALL_STRIPS');
            $ctrl.allStrips = allStrips;
        }

        function preProcessGroupItems(item, strip) {
           // console.log('preProcessGroupItems');

            if ($ctrl.isScheduling && item.type !== 1) {
                return item;
            }

            var index = _.findIndex($ctrl.allStrips, function (el) {
                return el._id === item[$ctrl.isScheduling ? 'stripId' : '_id'];
            });

            if (index > -1) {
                if (!strip) {
                    strip = $ctrl.allStrips[index];
                } else {
                    $ctrl.allStrips[index] = strip;
                }
            }
                                                                                            //Settings
            return $ctrl.scriptLoadingService.getExtendedStrip(item, strip, $ctrl.isScheduling, null);
        }

        function getEmptyStateButtons() {
            var strips = $ctrl.scriptLoadingService.getStrips(),
                hasStrips = strips && strips.length > 0,
                cls1 = 'btn btn-primary ' + ($ctrl.pageClass || ''),
                hasBtn1 = $ctrl.CPS.isAuthenticated && !hasStrips,
                cls2 = hasBtn1 ? 'btn btn-small transparent big with-margin-left' : cls1,
                name2 = $ctrl.isScheduling ? ('New ' + $ctrl.nameForList) : ('Add ' + $ctrl.itemTitle),
                m = $ctrl.isScheduling ? 'onAddItemBtn' : 'createFromTop';
            return (hasBtn1 ? ('<import-script btn-class="' + cls1 + '" show-title="true" show-text-on-ipad="true" ' + ($ctrl.pageClass ? ('page-class="' + $ctrl.pageClass + '" ') : '') + '></import-script>') : '') +
                ('<button class="[ACTION_BUTTON] ' + cls2 + '" data-type="' + m + '" analytics-on analytics-action="' + name2 + '">' + getI('plus-circled', 'pull-left') + ' ' + name2 + '</button>');
        }

        function getGroupFilterButtonsOther() {
            return processFilters(false);
        }

        function getGroupFilterButtonsOtherXS() {
            return processFilters(true);
        }

        function processFilters(isLi){
            return process(isLi ? addBtn2 : addBtn1);

            function process(add){
                return add('assignLocations', 'pin', 'Assign Locations', 'to') +
                    add('assignCast', 'contacts-1', 'Assign Cast', 'to') +
                    add('removeLocations', 'pin-remove sbf14', 'Unassign Locations', 'from');
            }

            function addBtn1(method, icon, text, ap){
                return '<a ng-show="$ctrl.isActiveFilter()" ng-class="{\'disabled\': $ctrl.keyboardService.SelectedRows.length===0}" class="btn btn-small primary-faded with-margin-left pull-left without-text '+$ctrl.getBtnActionCls()+'" data-type="processSelectedCustomBtns" data-info="'+method+ '" analytics-on analytics-action="Open '+text+'" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? \'Please select at least one scene to ' +
                    text.toLowerCase()+' '+ap+'.\' : (\'' + text + ' ' + ap + ' \' + $ctrl.keyboardService.SelectedRows.length + \' Scene\'+($ctrl.keyboardService.SelectedRows.length === 1 ? \'\':\'s\'))}}" tooltip-placement="bottom">' +
                    getI(icon, 'pull-left') + ' <span class="hide-lower1400 with-padding-left">' + text + '</span></a>' ;
            }
            function addBtn2(method, icon, text){
                return '<li ng-show="$ctrl.isActiveFilter()">' +
                    '<a class="table-div full-width '+$ctrl.getBtnActionCls()+'" ng-class="{\'disabled\': $ctrl.keyboardService.SelectedRows.length==0}" data-type="processSelectedCustomBtns" data-info="'+method+'" analytics-on analytics-action="Open ' + text + '">' +
                    '<div class="col30">'+getI(icon)+'</div>' +
                    '<div>'+text+'</div>' +
                    '</a>' +
                    '</li>';
            }
        }

        function getI(icon, cls){
            return $ctrl.LCS.getISBDiv(icon, 2, cls);
        }

        function getDrpSettingsAfter(cls) {
    return $ctrl.CPS.isAuthenticated ? ('<import-script ng-show="$ctrl.isActiveFilter()" is-li="true" ' +
        (cls?('li-'+cls):'') +  ($ctrl.pageClass ? (' page-class="'+$ctrl.pageClass+'" ') : '') +
        '></import-script>') : '';
        }

        function processSettings(type) {
            var params = _.extend({
                currentListId: $ctrl.listTreeService.active.selectedListId,
                service: $ctrl.service
            }, $ctrl.getParams());

            if(type === 'columnSettings'){
                params = _.extend(params, {
                    listTreeService: $ctrl.listTreeService
                })
            }

            $ctrl.popupsService.open(null, $ctrl.popupsService.operations[type], params, $ctrl.compOptions);
        }
    }
}

