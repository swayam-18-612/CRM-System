angular.module('product.materials.group.component',[
    'product.materials.group.int.controller.service',
    'product.materials.item.edit.component',
    'product.materials.item.grid.component',
    'product.material.init.controller.service'
])
.component('materialGroup', treeGroupComponentParams( 'MaterialGroupCtrl', {
    onLoadDirectory: '&',

    awsSignPath: '<?',
    codeName: '@',
    parentId: '<?',
    maxSize: '<'
}))

.controller('MaterialGroupCtrl', MaterialGroupCtrl);
MaterialGroupCtrl.$inject = ['MaterialsGroupInitCtrlService', 'RouteCollaboratorsService', '$element'];
function MaterialGroupCtrl(MaterialsGroupInitCtrlService, RouteCollaboratorsService, $element) {
    var $ctrl = this;
    var hideCollabs = true;

    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;

    $ctrl.loadDirectory = loadDirectory;
    $ctrl.getGroupHeader = getGroupHeader;
    $ctrl.getGroupEmptyText = getGroupEmptyText;
    $ctrl.processGridViewItem = processGridViewItem;
    $ctrl.processListItemColumn = processListItemColumn;

    $ctrl.getSharePageName = getSharePageName;
    $ctrl.getInlineActions = getInlineActions;
    $ctrl.canDownload = canDownload;

    $ctrl.$onInit = $onInit;

    function $onInit() {
       // $ctrl.withImgBg = true;
        var fileParams = {
            filtersClass: 'small',

            isPredef: $ctrl.currentList ? $ctrl.currentList.isPredef : false,

            btnText: 'Upload Files',

            txtFileType: 'your files',
            multipleFiles: true,

            withShare: true,
            withDownload: true,

            parentId: $ctrl.parentId ? $ctrl.parentId : $ctrl.currentList._id,
            codeName: $ctrl.codeName,
            awsSignPath: $ctrl.awsSignPath,
            maxSize: $ctrl.maxSize
        };

        $ctrl = new MaterialsGroupInitCtrlService($ctrl, $element, fileParams, true, null);

        if ($ctrl.canEdit) {
            $ctrl.getInlineParams = getInlineParams;
        }
    }

    function getInlineParams() {
        var item = $ctrl.getNew();
        item.isFolder = true;
        return {
            service: $ctrl.service,
            item: item,
            elemType: $ctrl.elemType,
            objectType: $ctrl.objectType,
        }
    }

    function getGroupHeader() {
        return getC('name', 'Name', 'grow-column name-col') +
            '<div ng-if="!$ctrl.isGridView" class="folder-col">&nbsp;</div>' +
            getC('size', 'File Size', 'col130 hide-ipad') +
            getC('updatedAt', 'Modified', 'col120 hide-ipad');
            //'<div ng-if="!$ctrl.isGridView" class="created-col col150 hide-ipad text-center">Members</div>' + ;

        function getC(prop, name, cls) {
            return '<div ng-if="!$ctrl.isGridView" class="' + cls + '" ng-init="prop=\'' + prop + '\'"><a class="named" ng-click="$ctrl.changeOrder(prop)"> ' + '<span class="sbf inline-block hide-print pull-right" ng-class="$ctrl.getOrderArrow(prop)"></span>' + name + '</a></div>';
        }
    }

    function getGroupEmptyText() {
        return 'Upload a new file below';
    }

    function processGridViewItem(item) {
        return processItemView(true, item);
    }

    function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
        return processItemView(false, item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);
    }

    function processItemView(isGrid, item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
        //var item = $ctrl.item,
        if(!isGrid && !c){return '';}
        var el = '',
            isImg = $ctrl.isImage(item),
            version = item.isFolder ? null : item.version,
            versionId = version ? version.version : null,
            itemName =  version ? version.name : item.name,
             itemTooltip = itemName && itemName.length > 40 ? itemName.replace(/\'/g, "\\'"): null,
            ext = item.isFolder ? '' : $ctrl.getExtension(itemName),
            shortExt = ext ? $ctrl.getShortExtension(itemName) : '',
            //$ctrl.ext = item.isFolder ? 0 : ($ctrl.getExtension(item.name).length + 1);
            createdAt = item.isFolder ? item.updatedAt : (item.version ? item.version.createdAt : null),
            fileSize = item.isFolder ? '--' : (item.version ? $ctrl.getTextFileSize(item.version.size) : 0),

            collabProp = 'collaboratorIds',
            collabIdsCol = _.extend({}, $ctrl.getColumnByProp(collabProp), {
                canEdit: item.createdById === $ctrl.CPS.userId || $ctrl.CPS.memberType >= $ctrl.security.MemberTypes.Admin,
                showOnlyCounter: !$ctrl.isGridView,
                list: item,
                uId: item._id
            }),
            withclick = $ctrl.isActiveFilter() && !$ctrl.isPrintLayout ? ('no-drag with-cursor ' + $ctrl.getClickEventName('loadDirectory')) : '';

        createdAt = createdAt ? createdAt.format('MMM D, YYYY') : '';
        itemTooltip = itemTooltip?('tooltip-placement="bottom" tooltip="'+itemTooltip+'" '):'';

        if (isGrid) {
//filtersService.options.column = 3 ' + filtersService.options.column +'
            collabIdsCol.circleSize = 'smaller';
    el = '<div class="full-width">' +
            $ctrl.getImage(item, isImg, ext, shortExt, withclick) +
            $ctrl.getCustomCheckbox(!item.isPredef) +
            '<div class="table-div full-width bottom-table ' + (isImg ? 'with-image' : 'white-bg') + '">' +
                '<div class="grow-column center-cont-text centered col-title">' +
                    '<div class="table-div wrap no-drag fixed-layout">' +
                    (versionId && versionId>1 ? ('<div class="version-label">v' +versionId+'</div>') : '') +
                        '<div class="title1 with-padding-left with-padding-right centered ' + $ctrl.getViewEditElemSelector('name') + ' ' + withclick + '"><div class="with-ellipsis" '+ itemTooltip +'>'+itemName+'</div></div>'+
                    '</div>' +
                '</div>' +
               (hideCollabs ? '' : ( '<div class="centered col30 no-drag">'+
                     $ctrl.getDisplayItemCol(item, collabIdsCol, null, canEdit, textOnly, isMobile, isMobileRowDetails) +
                '</div>')) +
                '<div class="centered side-col">' +
                    $ctrl.getMoreBtnTemplate(false, item, isMobile) +
                '</div>'+
            '</div>' +
        '</div>';
        }
        else {
            switch (c.prop) {
                case 'name':
                 el += '<div class="folder-col with-padding hide-print">' +
                            $ctrl.getImage(item, isImg, ext, shortExt, withclick) +
                        '</div>' +
                        '<div class="one-line-tooltip grow-column name-col">' +
                            (versionId &&  versionId> 1? ('<div class="version-label inline-block with-margin-right">v' + versionId + '</div>') : '') +
                            '<div class="no-drag inline-block '+$ctrl.getViewEditElemSelector('name')+' ' + (withclick ? ('with_underline ' + withclick) : '') + '" ' + itemTooltip + '><div class="with-ellipsis">' + itemName + '</div></div>' +
                        '</div> ' +

                        '<div class="col130 hide-ipad">' + fileSize + '</div>' +
                        '<div class="col120 hide-ipad">' + createdAt + '</div>';
                    break;

                default:
                    if(!hideCollabs) {
                        el += $ctrl.getDisplayItemCol(item, c.prop === collabProp ? collabIdsCol : c, cls, canEdit, textOnly, isMobile, isMobileRowDetails);
                    }
                    break;
            }
        }

        return el;

        //'<sb-assign-collaborators value="::$ctrl.item.collaborators" show-only-counter="true" item="$ctrl.item" share-list-name="' + shareListName + '" max-count="0"></sb-assign-collaborators>'
    }

    function getInlineActions(isHeader, item) {
        return $ctrl.isPrintLayout ? '' : (
            //getShare() +
            ('<div class="with-btn with-hover text-center hide-print hide-ipad no-drag">' +
      (isHeader && !($ctrl.withDownload && item && !item.isFolder)? '&nbsp;' : ('<a class="text-center btn btn-small primary-faded without-text ' + $ctrl.getClickEventName('getDownloadLink') + '" analytics-on analytics-action="Download File" target="_self">' +
          $ctrl.LCS.getISBDiv('download', 3, 'pull-left', 'tooltip-placement="bottom" tooltip="Download"') +
          '</a>')) +
      '</div>'));

        function getShare(){
            return $ctrl.canEdit ? ('<div class="with-btn with-hover text-center hide-print hide-ipad no-drag">' +
                (isHeader ? '' : ('<a class="btn btn-small primary-faded without-text ' + $ctrl.getClickEventName('share') + '" analytics-on analytics-action="Open Share" >' +
                    $ctrl.LCS.getISBDiv('link', 2, 'pull-left gray', 'tooltip-placement="bottom" tooltip="Share"') + '</a>')) +
                '</div>') : '';
        }
    }

    function getSharePageName(list) {
        return 'user.product.library' + (list.isFolder ? '' : '-file');
    }

    function loadDirectory(item) {
        $ctrl.onLoadDirectory({item: item});
    }

    function canDownload(item) {
        return item && $ctrl.withDownload && !item.isFolder && $ctrl.isGridView;
    }
}

angular.module('product.materials.item.grid.component', [
])
.component('materialItemGrid', itemGridComponentParams(null,'MaterialGridItemCtrl'))
.controller('MaterialGridItemCtrl',MaterialGridItemCtrl);
MaterialGridItemCtrl.$inject = ['GridItemGroupInitCtrlService', '$element'];
function MaterialGridItemCtrl(GridItemGroupInitCtrlService, $element) {
    var $ctrl = this;

    $ctrl.withUncheck = true;
    $ctrl.bindingNames = ['share', 'loadDirectory', 'getDownloadLink'];

    $ctrl.getColFromProp = getColFromProp;

    $ctrl = new GridItemGroupInitCtrlService($ctrl, $element);

    function getColFromProp(prop) {
        var c = $ctrl.getColFromPropInit(prop);
        if (c.type !== $ctrl.SBFieldTypesService.PropTypes.Collaborators) {
            return c;
        }
        var c1 = _.extend({}, c, {
            canEdit: $ctrl.item.createdById === $ctrl.CPS.userId || $ctrl.CPS.memberType >= $ctrl.security.MemberTypes.Admin,
            showOnlyCounter: !$ctrl.isGridView,
            list: $ctrl.item,
            uId: $ctrl.item._id
        });
        $ctrl.list = $ctrl.item;
        if ($ctrl.isGridView) {
            c1.circleSize = 'smaller';
        }
        return c1;
    }
}

angular.module('product.materials.group.int.controller.service', [
    'group.controller.service',
    'apiPagination.Materials',
    'product.material.init.controller.service',
    'apiConstants.materials.services',
    'product.material.fileStats.service'
])
.service('MaterialsGroupInitCtrlService', MaterialsGroupInitCtrlService);
MaterialsGroupInitCtrlService.$inject = ['MaterialsPagination', 'TreeGroupInitCtrlService', 'GroupBlockInitCtrlService', 'MaterialInitCtrlService'];
function MaterialsGroupInitCtrlService(Pagination, TreeGroupInitCtrlService, GroupBlockInitCtrlService, MaterialInitCtrlService) {
    return function ($ctrl, $element, fileParams, isTreeGroup, constantsService) {
    //include in $onInit

        $ctrl = new MaterialInitCtrlService($ctrl);

        if(!$ctrl.create) {
            $ctrl.create = create;
        }

        //$ctrl.createMaterial = $ctrl.openUploadFiles;

        $ctrl.getImage = getImage;
        $ctrl.onMaterialsGroupInitDestroy = $onDestroy;

        if(!$ctrl.$onDestroy){
            $ctrl.$onDestroy = $onDestroy;
        }

        if (fileParams){
            $ctrl = _.extend($ctrl, fileParams);
        }

        if(isTreeGroup){
            $ctrl = new TreeGroupInitCtrlService($ctrl, $element, Pagination, false);
        }else{
            //$ctrl.options = $ctrl.constantsService.Options;
            $ctrl = new GroupBlockInitCtrlService($ctrl, $element, Pagination, constantsService, null);
        }

        $ctrl.view = $ctrl.openViewMaterial;

        return $ctrl;

        function create(after, type, moreNewItemData, addInline, isDuplicate, e) {
            if (isDuplicate) {
                $ctrl.createInit(after, type, moreNewItemData, addInline, isDuplicate, e);
            } else {
                $ctrl.openUploadFiles(e);
            }
        }

        function $onDestroy() {
            if (typeof ($ctrl.onInitGroupDestroy) === 'function') {
                $ctrl.onInitGroupDestroy();
            }
            $ctrl.onMaterialInitDestroy();
        }

        function getImage(item, isImg, ext, shortExt, withclick) {
            var el = '';
            if ($ctrl.isGridView) {
                if (isImg) {
                    el += '<div class="stretchy-wrapper imageRatio-0 no-drag ' + withclick + '">' + getCompImg() + '</div>';
                } else {
                    el += '<div class="table-div fixed-layout full-width top-table centered">' +
                            '<div class="text-center centered">' +
                                (item.isFolder ? getFolder(true) : ('<div class="' + $ctrl.getClickEventName('view') + '">' + getFile(true) + '</div>')) +
                            '</div>' +
                          '</div>';
                }
            }else{
                el +=  item.isFolder ? getFolder() : (isImg ? getCompImg() : getFile());
            }

            return el;

            function getFolder(isLarge) {
                return '<div class="folder-icon centered text-center ' + (isLarge ? 'large ' : '') + '">' +
                    $ctrl.LCS.getISBDiv(item.icon ? item.icon : '', item.iconLevel ? item.iconLevel : 8, 'folder-inner-icon') +
                    '</div>';
            }

            function getFile(isLarge) {
                return '<div class="file-icon centered text-center ' + (isLarge ? 'large ' : '') + $ctrl.getIconClass(item) + '">' +
                    '<div class="mini-icon"></div>' +
                    '<div class="text ' + ext + '">' + shortExt + '</div>' +
                    '</div>';
            }

            function getCompImg() {
                return $ctrl.security.getImgTag('$ctrl.item.version',
                 ($ctrl.isGridView ?'no-radius' : 'square'), null, 'path',
                 ($ctrl.isGridView ?'no-radius' : 'square'),
                    'class="full-height-img full-width" ' +
                    'without-initials="true" ' +
                    //($ctrl.withImgBg ?
                        ('with-img-bg="true" ') +
            //: '') +
                    ($ctrl.canEdit ? ' can-upload-attr="true" ' : '') + ' ' +
                    //todo who should see comments
                    //'with-comments="true" ' +
                    ($ctrl.canComment ? 'can-comment="true" ':'') +
                    'collection-prop="materials" ' +
                    'no-overlay="true" ');
            }
        }
    }
}

