            m = '48px';
    return '<style>'+
        '@media print{' +
                'html{zoom: ' + scale + '}' +
                'html,body{background-color:transparent}' +
                '@page{' +
                    'margin:' + m + ' ' + m + ' ' + m + ' ' + m + ';' +
