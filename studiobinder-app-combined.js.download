angular.module('sbApp.component', [
    'services.blocksSetup',
    'app.refreshPopup.component',
    'user.layoutLogged.component',
    'user.layoutUnlogged.component',
    'sb.console.service'
])
.component('sbapp', {
    template: '<div ng-if="$ctrl.isLoaded" class="h-full appview">' +
                '<div ui-view="appview" class="display-block h-full"/>' +
                '<app-notifications class="hide-print"></app-notifications>' +
                '<http-loaders class="hide-print"></http-loaders>' +
            '</div>',
    controller: 'SBAppCtrl'
})
.controller('SBAppCtrl', SBAppCtrl);

SBAppCtrl.$inject = ['SBConsoleService', 'BlocksSetupService', 'LCS', 'RootEventsService', 'PopupsCtrlService', 'i18nNotifications'];

function SBAppCtrl(SBConsoleService, BlocksSetupService, LCS , RootEventsService, PopupsCtrlService, i18nNotifications) {
    console.log('SBAppCtrl');
    var $ctrl = this;

    SBConsoleService.init();

    $ctrl.watchers = [];
    $ctrl.popupsService = PopupsCtrlService;
    $ctrl.LCS = LCS;
    $ctrl.RootEventsService = RootEventsService;
    $ctrl.i18nNotifications = i18nNotifications;

    $ctrl.$onInit = $onInit;
    $ctrl.$onDestroy = $onDestroy;

    function $onInit() {
        if (!BlocksSetupService.isLoaded) {
            BlocksSetupService.init();
            console.log('BlocksSetupService.isLoaded');
        }

        $ctrl.isLoaded = true;

        initStatus();
        bind(true);

        $ctrl.LCS.initAppSettings(function () {
            setIsMobileOpened();
            setWindowWidth();
            setWindowHeight();
        });

        $ctrl.RootEventsService.addRootWatcherSimple($ctrl.watchers, $ctrl.LCS.onIsMobileOpenedChanged(setIsMobileOpened));
        $ctrl.RootEventsService.addRootWatcherSimple($ctrl.watchers, $ctrl.LCS.onWindowWidthChanged(setWindowWidth));
        $ctrl.RootEventsService.addRootWatcherSimple($ctrl.watchers, $ctrl.LCS.onWindowHeightChanged(setWindowHeight));
        $ctrl.RootEventsService.addRootWatcher($ctrl.watchers, 'APP_REFRESH', onAppRefresh);

    }

    function $onDestroy() {
        bind(false);
        $ctrl.RootEventsService.removeWatchers($ctrl.watchers);
    }

    function onAppRefresh() {
        $ctrl.popupsService.open(null, $ctrl.popupsService.operations.appRefresh);
    }

    function setIsMobileOpened() {
        setSetting('isMobileOpened', $ctrl.LCS, true);
    }

    function setWindowWidth() {
        setSetting('windowWidth', $ctrl.LCS, true);
    }

    function setWindowHeight() {
        setSetting('windowHeight', $ctrl.LCS, true);
    }

    function setSetting(prop, service, byProp) {
        var p = byProp ? service[prop] : service.getSetting(prop);
        if ($ctrl[prop] === undefined || p !== $ctrl[prop]) {
            $ctrl[prop] = p;
           // console.log(prop + ': ' + p);
            return true;
        }
        return false;
    }

    function bind(isBind) {
        var event = window[isBind ? 'addEventListener' : 'removeEventListener'];
        if (typeof window !== 'undefined' && event) {
            $ctrl.LCS.bindElementListeners(isBind, window, setStatus, 'online');
            $ctrl.LCS.bindElementListeners(isBind, window, setStatus, 'offline');
            $ctrl.LCS.timeout(setStatus, 3000);
        }
    }

    function initStatus() {
        $ctrl.LCS.isOnline = getStatus();
    }

    function setStatus() {
        var isOnline = getStatus();
        if ($ctrl.LCS.isOnline === isOnline) {
            return;
        }
        $ctrl.LCS.isOnline = isOnline;
        $ctrl.RootEventsService.broadcastRoot('SB_ONLINE', isOnline);
        var message = isOnline ? 'online' : 'offline';
        $ctrl.i18nNotifications.pushSticky(null, 'SB_ONLINE.' + message, message);
        /* console.log('is-online');
         $ctrl.RootEventsService.broadcastRoot('SB_ONLINE', true);
         /!*this.emit('is-online');
         if (this.wasOffline) {
             this.emit('back-online');
             this.info(this.i18n('connectedToInternet'), 'success', 3000);
             this.wasOffline = false;
         }*!/
         console.log('is-offline');
         /!*this.emit('is-offline');

         this.info(this.i18n('noInternetConnection'), 'error', 0);
         this.wasOffline = true;*!/
*/
    }

    function getStatus() {
        return typeof window.navigator.onLine !== 'undefined' ? window.navigator.onLine : true;
    }

}

