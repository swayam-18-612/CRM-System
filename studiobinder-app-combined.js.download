.component('userDashboardPage', {
    controller: 'UserDashboardPageCtrl',
})
.controller('UserDashboardPageCtrl', UserDashboardPageCtrl);
UserDashboardPageCtrl.$inject = ['UserDashboardInitCtrlService', 'PageWithBgCtrlService', 'CompaniesService', '$element'];
function UserDashboardPageCtrl(UserDashboardInitCtrlService, PageWithBgCtrlService, CompaniesService, $element) {
    console.log('UserDashboardPageCtrl');
    var $ctrl = this,
    isDebug = false;

    $ctrl.CompaniesService = CompaniesService;
    $ctrl.UserDashboardInitCtrlService = UserDashboardInitCtrlService;
    $ctrl.PageWithBgCtrlService = PageWithBgCtrlService;

    var opencomp,
        isOpened;

    $ctrl.elemType = 'WIDGET';
    $ctrl.hasOnPageDestroyOther = true;

    $ctrl.$onInit = $onInit;
    $ctrl.postInitSettings = postInitSettings;
    $ctrl.getSettingsTemplate = getSettingsTemplate;
    $ctrl.onDestroy = onDestroy;

    return $ctrl;

    function $onInit() {
        $ctrl = new $ctrl.PageWithBgCtrlService($ctrl);
        $ctrl = new $ctrl.UserDashboardInitCtrlService($ctrl, $element);
    }

    function onDestroy(){
        if($ctrl.onPageWithBgDestroy) {
            $ctrl.onPageWithBgDestroy();
        }
    }

    function getSettingsTemplate() {
    return '<div class="clearfix display-block tab-content with-padding with-radius with-side-margin padding-bottom-80 sb-scrolling-monitor with-no-bg  no-side-margin-xs withcontentwrapper" sb-scrolling-monitor-id="group">' +
            //'<div class="contentwrapper">' +
                '<div class="lower-filters with-list-header center-list-title">' +
                    '<div class="listname center display-block">' +
                        '<div class="date">' + $ctrl.CPS.getCreatedAt(new Date(), $ctrl.CPS.dateFormat) + '</div>' +
                        '<div class="greeting">' + greetBasedOnTime() + ', ' + $ctrl.CPS.user.name.split(' ')[0] + '</div>' +
                    '</div>' +
                    '<div class="display-block desc"></div>' +
                '</div>' +
                '<dashboard-widgets></dashboard-widgets>' +
            //'</div>' +
        '</div>';
    }

    function greetBasedOnTime() {
        const currentTime = new Date().getHours();
        return 'Good ' + ((currentTime >= 5 && currentTime < 12) ? 'morning' :
            ((currentTime >= 12 && currentTime < 18) ? 'afternoon' : 'evening'));
    }

    function postInitSettings() {
        console.log('UserDashboardPageCtrl.postInitSettings');
        loadPopups();

        if($ctrl.postInitPageBg) {
            $ctrl.postInitPageBg();
        }
    }

    function loadPopups() {
        if (isOpened) {return;}

        if ($ctrl.SBStateService.getSearchFilter('paymentFailed')) {
            openPopup(null, 'paymentFailed');
            isOpened = true;
        } else if ($ctrl.SBStateService.getSearchFilter('lowQuota')) {
            openPopup(null, 'lowQuota');
            isOpened = true;
        }
        /*else if($ctrl.SBStateService.getCurrentStateParams()){
              openPopup(null,  ); isOpened = true;
        } */

        if (!opencomp && $ctrl.CPS.isOwner) {
            var company = $ctrl.security.getCurrentCompany();
            if (company) {
                company = $ctrl.CompaniesService.convertResource(company);
            }
            var maxShowCount = 2,//show company step only 1 extra time
                currentCount = isDebug ? 0 : $ctrl.LCS.getHideCompanySettings(company._id),//how many times the popup has been shown
                showCount = currentCount || 0,
                show = (showCount < maxShowCount) && company && (!company.logo || company.name === 'My Company');

            if (show) {
                $ctrl.LCS.setHideCompanySettings(company._id, showCount + 1);
                opencomp = true;
                if (showCount === 0) {//show welcome step only one time
                    company.isFirstTime = true;
                }
                openPopup(company, 'onboarding');
            }
        }

        function openPopup(item, type) {
            console.log('openPopup  ' + type);
            $ctrl.popupsService.open(item, $ctrl.popupsService.operations[type]);
        }
    }
}

 angular.module('company.settings.popup.component',[
     'company.settings.component'
 ])
 .component('companySettingsPopup', popupComponentParams('CompanySettingsPopupCtrl'))
 .controller('CompanySettingsPopupCtrl', CompanySettingsPopupCtrl);
 CompanySettingsPopupCtrl.$inject = ['ListItemPopupTemplateCtrlService', '$element'];
 function CompanySettingsPopupCtrl(ListItemPopupTemplateCtrlService, $element) {
     var $ctrl = this;

     $ctrl.getPopupBodyContent = getPopupBodyContent;

     $ctrl = new ListItemPopupTemplateCtrlService($ctrl, $element);

     function getPopupBodyContent() {
         return '<company-settings on-close="$ctrl.onClose(result)" in-popup="true" class="clearfix display-block"></company-settings>';
     }
 }

 angular.module('user.dashboard.customize.component',[
     'ctrl.PopupsCtrl.generalItemEdit.service',
     'service.currentDashboard',
     'services.colors'
 ])
 .component('customizeDashboard', {
     controller: 'CustomizeDashboardCtrl'
 })
 .controller('CustomizeDashboardCtrl', CustomizeDashboardCtrl);
 CustomizeDashboardCtrl.$inject = ['GeneralItemEditCtrlService', 'SBColorService', 'CurrentDashboard', '$element'];
 function CustomizeDashboardCtrl(GeneralItemEditCtrlService, SBColorService, CurrentDashboard, $element) {
     var $ctrl = this;
     var source = 'sidebar';
     $ctrl.CurrentDashboard = CurrentDashboard;
     $ctrl.SBColorService = SBColorService;

     $ctrl.isPopup = false;
     $ctrl.elemType = 'WIDGET';

     $ctrl.BGs = [{id: '1', n: 'Photos'}, {id: '2', n: 'Gradients'}, {id: '3', n: 'Colors'}];
     $ctrl.Layouts = [{id: 3, n: 'Compact', icon: '<svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" viewBox="0 0 40 40" width="40" height="40" xmlns:v="https://vecta.io/nano"><g fill="var(--fill-color)" fill-rule="nonzero"><path d="M5.798 6.67h5.004c.921 0 1.668.746 1.668 1.666v8.317c0 .92-.747 1.666-1.668 1.666H5.798c-.921 0-1.668-.746-1.668-1.666V8.336c0-.92.747-1.666 1.668-1.666z" opacity=".3"/><use href="#B" opacity=".6"/><use href="#B" x="11.7"/><path d="M5.798 21.68h5.004c.921 0 1.668.746 1.668 1.666v8.317c0 .92-.747 1.666-1.668 1.666H5.798c-.921 0-1.668-.746-1.668-1.666v-8.317c0-.92.747-1.666 1.668-1.666z" opacity=".3"/><use href="#C" opacity=".6"/><use href="#C" x="11.7"/></g><defs ><path id="B" d="M17.498 6.67h5.004c.921 0 1.668.746 1.668 1.666v8.317c0 .92-.747 1.666-1.668 1.666h-5.004c-.921 0-1.668-.746-1.668-1.666V8.336c0-.92.747-1.666 1.668-1.666z"/><path id="C" d="M17.498 21.68h5.004c.921 0 1.668.746 1.668 1.666v8.317c0 .92-.747 1.666-1.668 1.666h-5.004c-.921 0-1.668-.746-1.668-1.666v-8.317c0-.92.747-1.666 1.668-1.666z"/></defs></svg>'}, {id: 2, n: 'Comfortable', icon: '<svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet" viewBox="0 0 40 40" width="40" height="40" xmlns:v="https://vecta.io/nano" fill="var(--fill-color)" fill-rule="nonzero" xmlns:v="https://vecta.io/nano"><path d="M24.18 6.67h9.15a2.5 2.5 0 0 1 2.5 2.499v6.651a2.5 2.5 0 0 1-2.5 2.499h-9.15a2.5 2.5 0 0 1-2.5-2.499V9.169a2.5 2.5 0 0 1 2.5-2.499zm0 15.01h9.15a2.5 2.5 0 0 1 2.5 2.499v6.651a2.5 2.5 0 0 1-2.5 2.499h-9.15a2.5 2.5 0 0 1-2.5-2.499v-6.651a2.5 2.5 0 0 1 2.5-2.499z"/><path d="M6.67 6.67h9.15a2.5 2.5 0 0 1 2.5 2.499v6.651a2.5 2.5 0 0 1-2.5 2.499H6.67a2.5 2.5 0 0 1-2.5-2.499V9.169a2.5 2.5 0 0 1 2.5-2.499zm0 15.01h9.15a2.5 2.5 0 0 1 2.5 2.499v6.651a2.5 2.5 0 0 1-2.5 2.499H6.67a2.5 2.5 0 0 1-2.5-2.499v-6.651a2.5 2.5 0 0 1 2.5-2.499z" opacity=".3"/></svg>'}];
     $ctrl.Widgets = $ctrl.CurrentDashboard.Widgets;

     $ctrl.dontAutoloadTemplate = true;

     $ctrl.preInitGeneral = preInitGeneral;
     $ctrl.postInitGeneral = postInitGeneral;
     $ctrl.getItemPopupTemplate = getItemPopupTemplate;
     $ctrl.addWidget = addWidget;
     $ctrl.changeBackground = changeBackground;
     $ctrl.changeLayout = changeLayout;
     $ctrl.onCurrentTreeListChangedOther = onCurrentTreeListChangedOther;

     $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

     function preInitGeneral() {
         $ctrl.item = $ctrl.CurrentDashboard.getDashboard();
     }

     function postInitGeneral() {
         $ctrl.CurrentDashboard.onDashboardChanged($ctrl.watchers, onDashboardChanged);
     }

     function onDashboardChanged(result) {
         var settings = result ? result.settings : {};
         if (!result || (settings && !settings.withoutDBUpdate && settings.source === source)) {
             return;
         }

         console.log('CustomizeDashboardCtrl.loadDashboard');

         if (!$ctrl.isLoaded) {
             $ctrl.item = result.item;
             $ctrl.isLoaded = true;
             $ctrl.reloadTemplate();
         } else {
             var changes = result ? result.changes : null;
             if (changes) {
                 _.each(['widgets', 'background', 'column'], function (prop) {
                     if (changes[prop]!==undefined) {
                         var v = changes[prop];
                         $ctrl.item[prop] = v;
                         if (prop === 'widgets') {
                             getWidgets(false);
                         } else if (prop === 'background') {
                             setBackground($ctrl.item);
                         }
                         //else if (prop === 'column') {setLayout($ctrl.item);}
                     }
                 });
             }
         }
     }

     function getImgUrl(v, m) {
         return $ctrl.security.resizeUploadedImg(v, {width: 400, m : m});
     }

     function getItemPopupTemplate() {
         console.log('CustomizeDashboardCtrl.getItemPopupTemplate');
         return getsection('Background', getBgs()) +
             getsection('Layout', getLayout(), 'Affects columns and size of widgets') +
             getsection('Widgets', getWidgets(true, 'Add widgets to personalize your dashboard.'), null, true);

         function getsection(name, content,desc, isLast) {
             var cls = name === 'Layout' ? 'hide-ipad' : '';
             return '<div class="' + cls + ' header">' + name + '</div>' +
                 (desc ? ('<div class="' + cls + ' title">' + desc + '</div>') : '') +
                 '<div class="' + cls + ' ' + name.toLowerCase() + 'Section">' + content + '</div>' +
                 (isLast ? '' : '<div class="' + cls + ' sep"></div>');
         }

         function getBgs() {
             return getListContent($ctrl.BGs, function (item) {
                 var id = item.id,
                     v = getDefaultBackground($ctrl.item, id, false);
                 return '<div data-info="' + id + '" data-type="changeBackground" class="itemb with-cursor ' + $ctrl.getBtnActionCls() + (v.a ? ' active' : '') + '">' +
                     '<div class="img"' + getStyle() + '>&nbsp;</div>' +
                     '<div class="txt">' + item.n + '</div>' +
                     '</div>';

                 function getStyle() {
                     return 'style="' + v.p + ':' + v.c + '"';
                 }
             });
         }

         function getLayout(){
             return getListContent($ctrl.Layouts, function (item) {
                 var prop = 'column',
                     id = item.id,
                     isActive = id === $ctrl.item[prop],
                     v = item[prop];
                 return '<div data-info="' + id + '" data-type="changeLayout" class="iteml with-cursor table-div ' + $ctrl.getBtnActionCls() + (isActive ? ' active' : '') + '">' +
                     '<div class="custom-checkbox centered col20" style="min-width: 20px"><div class="md-radio-button '+(isActive ? ' md-checked' : '') + '"><div class="md-container md-ink-ripple"><div class="md-off"></div><div class="md-on"></div><div class="md-ripple-container"></div></div></div></div>' +

                     '<div class="txt centered">' + item.n + '</div>' +
                     '<div class="img centered col40"' +
                     //' style="background-image:url(' + $ctrl.LCS.getImgUrl('customize-dashboard/layout-' + item.n.toLowerCase() + '.svg')+')"
                      '>'+item.icon+'</div>' +
                     '</div>';
             });
         }
     }

     function getDefaultBackground(options, id, isStyleProp) {
         var isActive = isBGActive(options, id),
             prop = 'background',
             v = isActive ? (id === 3 ? options[prop] !== undefined : options[prop]) : null,
             isImg = $ctrl.SBColorService.isImage(v),
             isG = v && $ctrl.SBColorService.isGradient(v);
         return {
             a: isActive,
             p: id === '3' ? (isStyleProp ? 'backgroundColor' : 'background-color') : (isStyleProp ? 'backgroundImage' : 'background-image'),
             c: id === '1' ? ('url(' + getImgUrl(isImg ? v : $ctrl.SBColorService.PredefBgs[0].v, isImg && options[prop + 'Id'] ? true : null) + ')') :
                 (id === '2' ? (isG ? v : $ctrl.SBColorService.PredefGradients[0].v) :
                     (!isG && !isImg && v ? v : $ctrl.SBColorService.PredefColors[0].v))
         };
     }

     function setBackground(options) {
         if (!options) {
             options = {};
         }
         var section = $ctrl.element.querySelector('.backgroundSection');
         if(!section){return;}
         _.each($ctrl.BGs, function (item) {
             var id = item.id,
                 sEl = section.querySelector('.itemb[data-info="' + id + '"]');
             if (sEl) {
                 var v = getDefaultBackground(options, id, true);
                 $ctrl.LCS[v.a ? 'addClass' : 'removeClass'](sEl, 'active');
                 var imgEl = sEl.querySelector('.img');
                 if(imgEl) {
                     if (!imgEl.style) {
                         imgEl.style = {};
                     }
                     imgEl.style[v.p] = v.c;
                 }
             }
         });
     }

     function setLayout(options) {
         if (!options) {
             options = {};
         }
         var prop = 'column';
         var section = $ctrl.element.querySelector('.layoutSection');
         if(!section){return;}
         _.each($ctrl.Layouts, function (item) {
             var id = item.id,
                 sEl = section.querySelector('.iteml[data-info="' + id + '"]');
             if (sEl) {
                 var isActive = id === options[prop],
                     v = item[prop];
                 $ctrl.LCS[isActive ? 'addClass' : 'removeClass'](sEl, 'active');

                 var check = sEl.querySelector('.md-radio-button');
                 if (check) {
                     $ctrl.LCS[isActive ? 'addClass' : 'removeClass'](check, 'md-checked');
                 }
             }
         });
     }

     function getWidgets(isFirst, desc) {
         //get widgets that are not in the list yet
         var exists,
             items = getListContent($ctrl.Widgets, function (item) {
                 var show = !isWidgetAdded(item);
                 if (show) {
                     exists = true;
                 }
                 if (isFirst) {
                     return getWidget(item, show);
                 } else {
                     var id = 'el' + item._id;
                     if (!$ctrl[id]) {
                         $ctrl[id] = $ctrl.element.querySelector('.item[data-info="' + item._id + '"]');
                     }
                     $ctrl.LCS[show ? 'removeClass' : 'addClass']($ctrl[id], 'sb-hide');
                     return '';
                 }
             });
         if (isFirst) {
             return ('<div class="widgets ' + (exists ? '' : 'sb-hide') + '">' +
                     (desc ? ('<div class="desc">' + desc + '</div>') : '') +
                     items + '</div>') +
                 '<div class="widgets-empty ' + (!exists ? '' : 'sb-hide') + '">' + getEmptyWidgets() + '</div>';
         } else {
             if (!$ctrl.elWidgets) {
                 $ctrl.elWidgets = $ctrl.element.querySelector('.widgets');
             }
             $ctrl.LCS[exists ? 'removeClass' : 'addClass']($ctrl.elWidgets, 'sb-hide');

             if (!$ctrl.elWidgetsEmpty) {
                 $ctrl.elWidgetsEmpty = $ctrl.element.querySelector('.widgets-empty');
             }
             $ctrl.LCS[!exists ? 'removeClass' : 'addClass']($ctrl.elWidgetsEmpty, 'sb-hide');
         }
     }

     function isWidgetAdded(item) {
         return _.find($ctrl.item.widgets, function (w) {
             return w && w._id === item._id;
         });
     }

     function getListContent(list, m) {
         return list ? list.map(m).join('') : '';
     }

     function isBGActive(options, id) {
         var def = id === '3',
             val = options ? options.background : null;
         return val ? ($ctrl.SBColorService.isImage(val) ? (id === '1') : ($ctrl.SBColorService.isGradient(val) ? (id === '2') : def)) : def;
     }
     function getEmptyWidgets() {
         return '' +
         //'<div class="title">Add widgets to personalize your dashboard.</div>' +
             '<div class="empty-img" style="background-image: url(' + $ctrl.LCS.getImgUrl('customize-dashboard/sidebar.svg', false) + ')">&nbsp;</div>' +
             '<div class="empty-txt">You\'ve added all widgets.</div>';
     }

     function getWidget(item, show) {
         if(!$ctrl.CPS.isOwnerOrAdmin && item.adminOnly){return '';}
         return '<div class="item with-cursor ' + (show ? '' : 'sb-hide') + ' ' + $ctrl.getBtnActionCls() + '" data-type="addWidget" data-info="' + item._id + '">' +
             '<div class="header"><span class="bold">' + item.title + '</span><div class="btnAdd pull-right">+ Add</div></div><div class="content" style="background-image: url(' + $ctrl.LCS.getImgUrl('customize-dashboard/' + item.component + '.svg', false) + ')">&nbsp;</div></div>';
     }

     function addWidget(id, e) {
         console.log('addWidget');
         if (_.find($ctrl.item.widgets, {_id: id})) {
             return;
         }
         var col = _.find($ctrl.CurrentDashboard.Widgets, {_id: id});

         $ctrl.item.widgets.push(_.extend({_id: id}, col.isDouble ? {isDouble: col.isDouble} : null));

         updateDashboard({
             widgets: $ctrl.item.widgets,
             added: id
         });
         next();

         function next() {
             getWidgets();
             $ctrl.LCS.addClass($ctrl.element.querySelector('.item[data-info="' + id + '"]'), 'sb-hide');
         }
     }

     function updateDashboard(changes, otherData) {
         $ctrl.CurrentDashboard.updateDashboard(changes, _.extend({source: source}, otherData));
     }

     function changeBackground(id, e) {
         console.log('changeBackground');
        var isImg = id === '1';
         $ctrl.CurrentDashboard.openChangeBackgroundPopup($ctrl, getType(id), onSuccess);

         function getType(id) {
             var p = {};
             p[isImg ? 'withBgImg' : (id === '2' ? 'withBgGradient' : 'withBgColor')] = true;
             return p;
         }

         function onSuccess(result) {
             console.log('onChangeBgSuccess');
             updateDashboard(result.editchanges, {withoutDBUpdate: true});
         }
     }

     function changeLayout(id, e) {
         console.log('changeLayout');
           id = parseInt(id);

         var prop = 'column';
         var p = {}; p[prop] = id;
         updateDashboard(p);
         $ctrl.item = _.extend($ctrl.item, p);
         setLayout($ctrl.item);
     }

     function onCurrentTreeListChangedOther(list) {
         console.log('CustomizeDashboardCtrl.onCurrentTreeListChangedOther');
         $ctrl.broadcastRoot('BACKGROUND_COLOR_CHANGED_' + $ctrl.elemType, _.extend({},list, {_id:null}));
     }
 }

angular.module('user.onboarding.popup.component', [
    'user.onboarding.popup.component.service'
])
.component('onboardingPopup', popupComponentParams('UserOnboardingPopupCtrl'))
.controller('UserOnboardingPopupCtrl', UserOnboardingPopupCtrl);

UserOnboardingPopupCtrl.$inject = ['UserOnboardingPopupCtrlService', '$element'];
function UserOnboardingPopupCtrl(UserOnboardingPopupCtrlService, $element) {
    var $ctrl = this;

    $ctrl.UserOnboardingPopupCtrlService = UserOnboardingPopupCtrlService;

    $ctrl.getItemPopupTemplate = getItemPopupTemplate;
    $ctrl.onFinishOther = onFinishOther;

    $ctrl = new $ctrl.UserOnboardingPopupCtrlService($ctrl, $element);

    function onFinishOther() {
        var block = 'myprojects';
        $ctrl.broadcastRoot('GROUP_BLOCK_' + block + '_ADD');
    }

    function getItemPopupTemplate() {
        $ctrl.isFirstTime = $ctrl.item.isFirstTime;
        return $ctrl.getItemPopupMSForm(getWrappers().map(getWrapper), 'onboarding' + ($ctrl.isFirstTime ? ' many-slides' : ''), false);

        function getWrappers() {
            var btnText = 'Next';
            return ($ctrl.isFirstTime ? [
                {id:1, content: getWelcome(null, btnText), bg: '#FA1971', type: 'projects', imgId: 1, btnText: btnText, oneColumn: true}
            ]: []). concat([
                {id:2, content: getPersonalize(), bg: '#5D79FF', fCls: 'company', type: 'company'}
            ]);

            function getWelcome(withIcon, btnText) {
                return $ctrl.getIT('studiobinder', 'Welcome to StudioBinder!', withIcon, true) +
                    '<p>Whether you’re a studio or a filmmaker, StudioBinder takes you from development through production.</p>' +
                    '<div class="table-bottom clearfix">' +
                    '<ul class="progressdots pull-left">' +
                    '<li><button class="with-primary-bg-before active"></button></li>' +
                    '<li><button class="nextbtn" sibling="1"></button></li>' +
                    '</ul>' +
                    $ctrl.getbtnnext(true, btnText) +
                    '</div>';
            }
            function getPersonalize() {
                return '<company-settings on-close="$ctrl.onFinish()" in-popup="true" class="clearfix display-block company-settings margin-right-20"></company-settings>' +
                    ($ctrl.isFirstTime ? ('<div class="table-bottom clearfix">' +
                        '<ul class="progressdots pull-left">' +
                            '<li><button class="previousbtn" sibling="1"></button></li>' +
                            '<li><button class="with-primary-bg-before active"></button></li>' +
                        '</ul>' +
                    '</div>') : '');
            }
        }

        function getWrapper(el) {
            return {
                fCls: el.fCls,
                btn: $ctrl.getbtnnext(el.btnText),

                body: '<div id="wrapper' + el.id + '" class="wrapper full-width ' + (el.oneColumn ? 'one-column ' : 'table-div ') + (el.fCls || '') + '">' +
                        '<div class="centered left '+(el.fCls ||  'clearfix ')+'">' + getVideo() + '</div>' +
                        '<div class="right">' + el.content + '</div>' +
                      '</div>'
            };

            function getVideo(){
                var p = 'emptystate/' + (el.type ? el.type : el.img) + '/emptystate' + (el.imgId || '') + '.';
                if(el.type){
                    var poster = el.noPoster ? '' : ('poster="' + $ctrl.LCS.getImgUrl(p + ($ctrl.LCS.webPEnabled ? 'webp' : 'jpg')) + '"');
                    return '<video class="video-anime" style="width:600px;max-width:100%;height: 370px" muted playsinline autoplay="autoplay" loop="loop" ' + poster + '><source src="' + $ctrl.LCS.getVideoUrl(p + 'mp4') + '" type="video/mp4"></video>';
                } else{
                    return '<img style="max-width: 100%" src="' + $ctrl.LCS.getImgUrl(p + ($ctrl.LCS.webPEnabled ? 'webp' : 'png')) + '"/>';
                }
            }
        }
    }
}

angular.module('user.onboarding.popup.component.service', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'services.videoService'
])
.service('UserOnboardingPopupCtrlService', UserOnboardingPopupCtrlService);

UserOnboardingPopupCtrlService.$inject = ['GeneralItemEditCtrlService', 'VideoService'];
function UserOnboardingPopupCtrlService(GeneralItemEditCtrlService, VideoService) {
    return function ($ctrl, $element) {

        $ctrl.VideoService = VideoService;

        $ctrl.isPopup = true;
        $ctrl.dontAutoloadTemplate = false;
        $ctrl.hideHeader = true;

        if(!$ctrl.getItemPopupTemplate){
            console.warn('Parent for UserOnboardingPopupCtrlService must define method getItemPopupTemplate');
        }

        $ctrl.onFinish = onFinish;
        $ctrl.onLoaded = onLoaded;
        $ctrl.onDestroy = onDestroy;
        $ctrl.msFormOnNext = msFormOnNext;
        $ctrl.getbtnnext = getbtnnext;

        $ctrl.getIT = getIT;
        $ctrl.getAccordion = getAccordion;

        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

        return $ctrl;


        function getIT(icon, h3, withIcon, withoutColor) {
            return '<div class="icon ' + (withIcon ? '' : 'hide-ipad') + '">' +
                '<div class="centered circled-svg-colored small60 ' + icon + '">' + $ctrl.LCS.getISBDiv(icon + (withoutColor ? '' : '-color'), 6) + '</div>' +
                '</div>' +
                '<h3>' + h3 + '</h3>';
        }

        function getAccordion(res) {
            return '<div class="modal-accordion" uib-accordion close-others="true">' +
                '<div uib-accordion-group>' +
                '<div class="question-wrap">' +
                '<div uib-accordion-heading>' + res.title + '</div>' +
                '<div class="spacing-quarter-top">' + res.content + '</div>' +
                '</div>' +
                '</div>' +
                '</div>';
        }

        function getbtnnext(hideIpad, btnText) {
            return '<button class="btn btn-primary nextbtn page-class ' + (hideIpad ? ' hide-ipad' + (btnText ? '' : ' pull-right') : '') + '" type="button">' + (btnText || 'Next') + '</button>';
        }

        function onFinish(result) {
            console.log('onfinish');
            if($ctrl.onFinishOther) {
                $ctrl.onFinishOther();
            }
            $ctrl.LCS.timeout(function () {
                $ctrl.closePopup();
            }, 200)
        }

        function onLoaded() {
            $ctrl.LCS.timeout(function () {
                bind(true);
            }, 700);
        }

        function onDestroy() {
            bind(false);
        }

        function bind(isBind) {
            $ctrl.VideoService.bindVideo($ctrl, isBind);
        }

        function msFormOnNext(e) {
            if ($ctrl.currentVideo) {
                $ctrl.currentVideo.pause();
            }
            $ctrl.currentVideo = $ctrl.VideoService.playVideo(e.currentTarget.querySelector('.video-anime'));
        }
    }
}

