addMoSePa('Scripts', 'scripts', TempScriptsService, {
    serviceInjectList: ['ResourcePathsService', 'MaterialVersions', 'DocumentVersions'],
    serviceInjectMod: ['apiServices.paths.service',
        'resources.MaterialVersions',
        'resources.DocumentVersions']
});
function TempScriptsService(ApiService, model, ResourcePathsService, MaterialVersions, DocumentVersions) {
    var sp = '/compare-and-update-scene';
    var scp = '/compare-and-update-script';

    var service = ApiService(model, {
        listType: 'isGroup',
        convertOtherResources: convertOtherResources
    });
    service.Colors = SBScriptColors;
    service.getPostPath = ResourcePathsService.getScriptsPath;
    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.updateScript = updateScript;
    service.compareScript = compareScript;
    service.getCompareScriptPath = getCompareScriptPath;
    service.changeVersion = changeVersion;
    service.getDownloadLink = getDownloadLink;
    service.getUpdateScriptPath = getUpdateScriptPath;
    service.compareAndUpdateScene = compareAndUpdateScene;
    service.compareAndUpdateScript = compareAndUpdateScript;
    service.getCompareAndUpdateScenePath = getCompareAndUpdateScenePath;
    service.getCompareAndUpdateScriptPath = getCompareAndUpdateScriptPath;

    service.getNextColor = getNextColor;
    service.getColorStyle = getColorStyle;
    service.duplicateFromScript = duplicateFromScript;
    service.getUpdatedInfo = getUpdatedInfo;

    return service;

    function convertOtherResources(item) {
        if (item.versionId && typeof(item.versionId) === 'object') {
            item.materialVersion = new MaterialVersions(item.versionId);
            item.versionId = item.versionId._id;
        }

        if (item.documentVersionId && typeof(item.documentVersionId) === 'object') {
            item.documentVersion = new DocumentVersions(item.documentVersionId);
            item.documentVersionId = item.documentVersionId._id;
        }

        if (item.contentVersionId && typeof(item.contentVersionId) === 'object') {
            item.contentVersion = new MaterialVersions(item.contentVersionId);
            item.contentVersionId = item.contentVersionId._id;
        }
        return item;
    }

    function getUpdatedInfo(item, items){
        if (item.type !== 2) { return item;}
        var prevColor = item.color;
        item.color = getNextColor();
        item.name = (prevColor ? item.name.replace(getSufix(prevColor), '') :
            item.name).substring(0, 150) + getSufix(item.color);

        return item;

        function getSufix(color) {
            return ' - ' + _.find(service.Colors, {id: color}).name + ' Revision';
        }

        function getNextColor() {
            var max = items && items.length > 0 ? _.max(items, function (item) {
                return item.version;
            }) : item;

            return service.getNextColor(max ? max.color : null);
        }
    }

    function getColorStyle(item) {
        var c = getColor(item.color);
        if (!c){return null;}
        var s = {'color': c.text, 'background-color': c.id};
        if (c.border) {
            s.border = '1px solid ' + c.border;
        }
        return s;
    }

    function getColor(color) {
        if (!color) {
            return service.Colors[0];
        }
        var c = _.find(service.Colors, function (el) {
            return el.id === color;
        });
        return c ? c : service.Colors[0];
    }

    function getNextColor(color) {
        if(!color){return service.Colors[1].id;}
        var l = service.Colors.length, index;
        for (var i = 0; i < l; i++) {
            if (!color) {
                return service.Colors[0].id;
            } else if (service.Colors[i].id && service.Colors[i].id.toUpperCase() === color.toUpperCase()) {
                index = i;
                break;
            }
        }
        return service.Colors[index < l - 1 ? (index + 1) : 0].id;
    }

    function getChangedFieldForUpdateOther() {
        return [ 'isDefault'];
    }

    function updateScript(params, successcb, errorcb) {
        return service.postUrl('/update-script', params, successcb, errorcb);
    }

    function compareScript(params, successcb, errorcb) {
        return service.postUrl('/compare-script', params, successcb, errorcb);
    }

    function compareAndUpdateScene(params, successcb, errorcb) {
        return service.postUrl(sp, params, successcb, errorcb);
    }

    //not used
    function compareAndUpdateScript(params, successcb, errorcb) {
        return service.postUrl(scp, params, successcb, errorcb);
    }

    function getUpdateScriptPath() {
        return ResourcePathsService.getScriptsPath() + '/update-script';
    }

    function changeVersion(data, successcb, errorcb) {
        return service.postUrl('/change-version', data, successcb, errorcb);
    }
    function duplicateFromScript(data, successcb, errorcb) {
        return service.postUrl('/duplicate-from-script', data, successcb, errorcb);
    }
    function getDownloadLink(params, onsuccess, onerror) {
        var path = '/download';
        return service.postUrl(path, params, function (res) {
            return onsuccess(res ? res.signed_request : null);
        }, onerror);
    }

    function getCompareScriptPath() {
        return ResourcePathsService.getScriptsPath() + '/compare-script';
    }

    function getCompareAndUpdateScenePath() {
        return ResourcePathsService.getScriptsPath() + sp;
    }

    function getCompareAndUpdateScriptPath() {
        return ResourcePathsService.getScriptsPath() + scp;
    }
}

