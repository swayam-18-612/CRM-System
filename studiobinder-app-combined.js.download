    }

    _this.emitDocChanged = function (val) {
        _this.RootEventsService.broadcastRoot('DOC_CHANGED', val);
    }

    _this.onDocChanged = function (watchers, method) {
        return _this.RootEventsService.addRootWatcher(watchers, 'DOC_CHANGED', method);
    }

    return _this;
}

