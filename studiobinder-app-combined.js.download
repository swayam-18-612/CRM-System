            '</div>' +
        '</div>';

        function getShare() {
    return '<div>' +
                '<div class="header margin-top-half">Who Has Access <span class="with-parenthesis"> ' + ($ctrl.membersCount + ' member' + ($ctrl.membersCount===1?'':'s'))+'</span></div>' +
                '<div class="select-choices with-teams display-block without-hover">' +
                    $ctrl.loadlist(true) +
        $ctrl.loadlist(false)+
                '</div>' +
            '</div>';
        }

        function getImage(item, cls) {
            return $ctrl.security.getImage(item, cls, 'profilePictureURL', 50);
        }

        function getMemberTypeText(item) {
            var el = _.find($ctrl.SBFieldMethods.MemberTypes, {value: item.memberType});
            return el ? el.text : '';
        }
    }
}

