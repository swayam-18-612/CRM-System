angular.module('fields.address.gPlacesAutocompleteDrawer.component', [
    'dropdowns.drpMenuWithHover.controller.service'
])
.component('gPlacesAutocomplete', {
    bindings: {
        input: '@',

        valueField:'@',
        strList: '<',
        value: '<',

        onSelect: '&'
    },
    controller: 'GPlacesAutocompleteCtrl',
})
.controller('GPlacesAutocompleteCtrl', GPlacesAutocompleteCtrl);
GPlacesAutocompleteCtrl.$inject = ['SBDrpMenuWithHoverCtrlService', '$element'];
function GPlacesAutocompleteCtrl(SBDrpMenuWithHoverCtrlService, $element) {
    var $ctrl = this;

    $ctrl.preInitOtherHover = preInitOtherHover;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new SBDrpMenuWithHoverCtrlService($ctrl, $element);

    function preInitOtherHover() {
        $ctrl.itemClass = 'pac-item';

        $ctrl.activeClass = 'pac-item-selected';
    }

    function getItemTemplate() {
        console.log('GPlacesAutocompleteCtrl.getItemTemplate');
        $ctrl.bindClick(false);

        var el = '';
        if ($ctrl.list) {
            _.each($ctrl.list, function (p, i) {
             el += '<div class="'+$ctrl.itemClass+' table-div full-width fixed-layout" role="option" data-id="' + p[$ctrl.valueField] + '" data-index="' + (i++) + '">' +
                        '<div class="col30 centered">' + $ctrl.LCS.getISBDiv('pin') + '</div>' +
                        '<div class="centered">' +
                            '<span class="pac-item-query">' + highlightMatch(p) + '</span>' +
                            unmatchedTermsOnly(p) +
                            (p.distance ? ('<span class="distance">&nbsp;' + p.distance + '</span>') : '') +
                        '</div>' +
                    '</div>';
            });
        }

        return '<div class="pac-container display-block ' + ($ctrl.list ? '' : 'sb-hide') + '" role="listbox" aria-hidden="' + ($ctrl.list ? 'false' : 'true') + '">' + (el ? ('<div>' + el + '</div>') : '') + '</div>';

        function highlightMatch(p) {
            var matchedPortion = '', unmatchedPortion = '', matched, term;
            if (p.matched_substrings.length > 0 && p.terms.length > 0) {
                matched = p.matched_substrings[0];
                term = p.terms[0].value;
                matchedPortion = term.substr(matched.offset, matched.length);
                unmatchedPortion = term.substr(matched.offset + matched.length);
            }
            return '<span class="pac-matched">' + matchedPortion + '</span>' + unmatchedPortion;
        }

        function unmatchedTermsOnly(p) {
            var el = '', filtered = [], terms = p.terms;
            if (terms && terms.length > 0) {
                _.each(terms, function (term) {
                    if (p.matched_substrings.length > 0 && term.offset > p.matched_substrings[0].length) {
                        filtered.push(term);
                    }
                });
                _.each(filtered, function (t, i) {
                    el += '<span>' + t.value + (filtered.length - 1 !== i ? ',' : '') + '&nbsp;</span>';
                });
            }
            return el;
        }
    }
}

/** DI wrapper around global google places library. Note: requires the Google Places API to already be loaded on the page.**/

angular.module('fields.address.googlePlacesApi.factory', [
])
.service('loadGoogleMapAPI', loadGoogleMapAPI);
loadGoogleMapAPI.$inject = ['ScriptLoaderService', '$window', '$q'];
function loadGoogleMapAPI(ScriptLoaderService, $window, $q) {
    console.warn('Global `google` var missing. Did you forget to include the places API script?');

    var deferred = $q.defer();

    if (!$window.google) {
        if ($window.attachEvent) {
            $window.attachEvent('onload', loadScript)
        } else {
            $window.addEventListener('load', loadScript, false)
        }

        function loadScript() {
            console.log('start loading script')
            ScriptLoaderService.loadScript('googleMaps', {
                url: 'https://maps.googleapis.com/maps/api/js?libraries=places&key={{key}}',
                key: 'googleMaps.apiKey'
            }, function () {
                console.log('script loaded');
                onSuccess();
            });
        }
    } else {
        onSuccess();
    }

    return deferred.promise;

    function onSuccess() {
        console.log('Google maps loaded loaded');
        deferred.resolve();
    }
}


angular.module('fields.address.googlePlacesApi.service', [
    //'fields.address.googlePlacesApi.factory'
])
.service('GooglePlacesApiService', GooglePlacesApiService); //loadGoogleMapAPI
GooglePlacesApiService.$inject = ['$window'];
function GooglePlacesApiService ($window){
    var service = this;

    /* Loads google map script
    return loadGoogleMapAPI.then(onGoogleApiLoaded , function (err) {
        // Promise rejected
        console.error('error loading the Google api');
    });
*/
   return onGoogleApiLoaded();

    function onGoogleApiLoaded() {
        var  google = $window.google;

        // Promised resolved
        service.getPlacesDetails = getPlacesDetails;
        service.getPredictions = getPredictions;
        service.geolocate = geolocate;
        service.setNewPlace = setNewPlace;
        service.getPlacesService = getPlacesService;

        init();

        return service;

        function init() {
            service.autocomplete = new google.maps.places.AutocompleteService();
            service.PlacesStatuses = google.maps.places.PlacesServiceStatus;
            service.geocoder = new google.maps.Geocoder();
            service.GeocoderStatuses = google.maps.places.GeocoderStatus;
        }

        function getPlacesService(element) {
            return new google.maps.places.PlacesService(element);
        }

        function getPlacesDetails(placesService, placeId) {
            return placesService ? placesService.getDetails(placeId) : null;
        }

        function geolocate(address, next) {
            if (!address) {
                return next();
            }
            service.geocoder.geocode({address: address}, function (results, status) {
                if (status !== service.GeocoderStatuses.OK) {
                    console.log("Geocode for '" + address + "' was not successful: " + status);
                    return next({formatted_address: address});
                }

                if (results && results.length > 0) {
                    var res = results[0];
                    if (res.place_id) {
                        setNewPlace(res, next);
                    } else {
                        updateModel(res, next);
                    }
                }
            });
        }

        function setNewPlace(placesService, prediction, next) {
            if (!prediction) {
                return next();
            }
            var placeId = prediction.place_id;
            if (!placeId) {
                return next();
            }

            placesService.getDetails({placeId: placeId}, function (place, status) {
                if (status !== service.PlacesStatuses.OK) {
                    return next();
                }
                if (prediction.description) {
                    place.description = prediction.description;
                }
                updateModel(place, next);
            });
        }

        function updateModel(val, next) {
            next(getPlaceInfo(val));
        }

        function getPlaceInfo(place) {
            var newAddress = '';
            if (place) {
                var address = place.formatted_address;
                if (place.name && place.formatted_address.indexOf(place.name) === 0) {
                    address = place.formatted_address.substring(place.name.length + 2, place.formatted_address.length);
                }

                newAddress = {
                    name: place.name,
                    formatted_address: address,
                    url: place.url,
                    phone: place.formatted_phone_number
                };

                if (place.geometry && place.geometry.location) {
                    newAddress.geoloc = {
                        lat: place.geometry.location.lat(),
                        lng: place.geometry.location.lng()
                    };
                }

                for (var prop in place.address_components) {
                    var valprop = place.address_components[prop];
                    var val = valprop.types[0];
                    var name = valprop.short_name;
                    if (val === 'postal_code') {
                        newAddress.zipcode = name;
                    } else if (val === 'locality') {
                        newAddress.locality = name;
                    } else if (val === 'administrative_area_level_1') {
                        newAddress.state = name;
                    } else if (val === 'country') {
                        newAddress.country = name;
                    }
                }
            }
            return newAddress;
        }

        function distance(lat1, lon1, lat2, lon2, unit) {
            var radlat1 = Math.PI * lat1 / 180;
            var radlat2 = Math.PI * lat2 / 180;
            var theta = lon1 - lon2;
            var radtheta = Math.PI * theta / 180;
            var dist = Math.sin(radlat1) * Math.sin(radlat2) + Math.cos(radlat1) * Math.cos(radlat2) * Math.cos(radtheta);
            dist = Math.acos(dist);
            dist = dist * 180 / Math.PI;
            dist = dist * 60 * 1.1515;
            if (unit === "K") {
                dist = dist * 1.609344;
            }
            if (unit === "N") {
                dist = dist * 0.8684;
            }
            return dist;
        }

        function getPredictions(query, options, next) {
            service.autocomplete.getPlacePredictions(_.extend({input: query}, options), function (predictions, status) {
                var customPlacePredictions;

                /* if($ctrl.options.location) {
                 var lat = $ctrl.options.location.lat();
                 var lng = $ctrl.options.location.lng();
                 for (var i = 0; i < predictions.length; i++) {
                 //to do
                 var lat1 =  predictions[i];
                 var lat1 =  predictions[i];
                 predictions[i].distance = getDistance(predictions[i], predictions[i], lat, lng, 'N') + 'mi';
                 }
                 }*/

                next(status === service.PlacesStatuses.OK ? predictions : null)
            });
        }
    }
}

angular.module('sb.fields.address.component', [
    'sb.fields.input.controller.service',
    'fields.address.googlePlacesApi.service',
    'fields.address.gPlacesAutocompleteDrawer.component',
