//other: {withPrint, isMainNav, isMainAndProduct}
function addRoutingForType(type, other) {
    var withPrint = other && other.withPrint,
        isMainNav = other && other.isMainNav,
        isMainAndProduct = other && other.isMainAndProduct,
        prefix = isMainNav ? 'user.' : 'product.',
        typeU = type[0].toUpperCase() + type.substring(1);

    getPage(false);

    if(withPrint) {
        getPage(true);
    }

    getConfig();

    function getConfig() {
        var modConfig =[prefix + getCo(false) + '.component'];
        if(!other.withoutConstantObj) {
            modConfig.push('compOptions.' + type + '.constant')
        }

        if (withPrint) {
            modConfig.push(prefix + getCo(true) + '.component');
        }

        var mConfig = function ($uiRouter, compOptions) {
            var isProduct = isMainNav ? false : true;

            pageRouting(isProduct, $uiRouter, compOptions, isMainAndProduct ? _.extend({title: 'Project ' + other.title}, getPermissions(isProduct), other) : other);
            /*
            withCommentsSidebar: true,
            withPrint: true,*/

            if (isMainAndProduct) {
                isProduct = isMainNav ? true : false;
                pageRouting(isProduct, $uiRouter, compOptions, _.extend({}, getPermissions(isProduct), other));
            }

            function getPermissions(isProduct){
                return isProduct ? {minRole: 1, minMemberType: 0} :// for collabs and users
                        {minRole: 2, minMemberType: 1}; // at least admins
            }
        }

        angular.module(prefix + type, modConfig)
            .config(mConfig);
        mConfig.$inject = ['$uiRouterProvider',  other && other.compOptionsName ? other.compOptionsName : (typeU + 'CompOptions')];
    }

    function getPage(isPrint) {
        var co = getCo(isPrint),
            ctrl = getCtrl(isPrint),
            modComp = [getServiceMod()],

            //Name + 'PageCtrlService'
            //Name + 'PrintPageCtrlService'
            inj = [getService(), '$element'],
            bindings = isPrint ? {
                printPageParams: '<',
                selectedParams: '<',
            } : other.bindings;

        if (isPrint) {
            inj.push('PageTreePrintCtrlService');
            //prefix = 'product'
            modComp.push('product.print.tree.page.controller.service');
        } else {
           if(!other.withoutConstantObj){
               modComp.push('compOptions.' + type + '.constant');
           }
        }

        var m = function (pageCtrlService, $element, PageTreePrintCtrlService) {
            console.log('getPage: ' + ctrl);

            var $ctrl = this;

            $ctrl.pageCtrlService = pageCtrlService;
            $ctrl.isPrintLayout = isPrint;

            $ctrl = new $ctrl.pageCtrlService($ctrl, $element);

            if ($ctrl.isPrintLayout) {
                $ctrl.$onInit = onInitPrint;
            }

            function onInitPrint() {
                if(!PageTreePrintCtrlService){

                    var hardReload = true;
                    $ctrl.CPS.reloadCurrentState(hardReload);
                    return;
                }
                $ctrl = new PageTreePrintCtrlService($ctrl, $element);
                var prop = 'printId',
                    val = $ctrl.SBStateService.getCurrentStateParams()[prop];
                if (val) {
                    var p = {};
                    p[prop] = val;
                    $ctrl.service.loadPrint(p, function (result) {
                        $ctrl.onInitPagePrint();
                    }, function (errS) {
                        console.log('err');
                        $ctrl.onInitPagePrint();
                    });
                } else {
                    $ctrl.onInitPagePrint();
                }
            }
        };

        angular.module(prefix + co + '.component', modComp)
            .component(co, _.extend({
                controller: ctrl
            }, bindings ? {bindings: bindings} : null))
            .controller(ctrl, m);
        m.$inject = inj;
    }

    function getService(){
        return getCtrl(false) + 'Service';
    }

    function getServiceMod(){
        return prefix + getCo(false) + '.service';
    }

    function getCtrl(isPrint){
        return getCoU(isPrint) + 'Ctrl';
    }

    function getCoU(isPrint){
        return typeU + getP(isPrint);
    }

    function getCo(isPrint){
        return type + getP(isPrint);
    }

    function getP(isPrint){
        return isPrint ? 'Print' : 'Page';
    }
}


