TaskPopupCtrl.$inject = ['ListItemTemplateFormCtrlService', 'TodoCardsService', 'SBFieldMethods', '$element'];
function TaskPopupCtrl(ListItemTemplateFormCtrlService, service, SBFieldMethods, $element) {
    var $ctrl = this;

    $ctrl.SBFieldMethods = SBFieldMethods;

    $ctrl.dontAutoloadTemplate = false;
    $ctrl.saveOnKeydown = true;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitOther = preInitOther;

    $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

    function preInitOther(){
        $ctrl.objectType = 'taskCard';
        $ctrl.type = 'Create';

        if(!$ctrl.extraParam){ $ctrl.extraParam= {};}
        $ctrl.extraParam.service = service;
        $ctrl.item = $ctrl.extraParam.service.convertResource($ctrl.event);
        $ctrl.Colors = $ctrl.SBFieldMethods.Colors;
        if(!$ctrl.Settings){$ctrl.Settings = {};}
        $ctrl.Settings.Colors = $ctrl.Colors;
        $ctrl.isSOpen = true;
    }

    function getItemTemplate() {
return '<div id="'+$ctrl.id+'" class="taskPopup dropdown-menu" ng-class="{\'fadeInDownDrp\': $ctrl.isSOpen}" ng-style="{display: $ctrl.isSOpen ? \'block\' : \'none\',top:$ctrl.position.top +\'px\', left: $ctrl.position.left+\'px\'}">' +
    '<div class="spacing-half">' +
        '<form name="$ctrl.formHolderItem[$ctrl.formName]" class="auto elementnew" novalidate>' +

    $ctrl.LCS.getErrorBlock('inside-tagger') +
            '<div class="form-group with-side-padding">' +
                '<span class="custom-color-drp">' +
                    '<sb-color-dropdown ' +
                        'without-close="true" ' +
                        'init-list="::$ctrl.Settings.Colors" ' +
                        'value="::$ctrl.item.color" ' +
                        'with-uncheck="::true" ' +
                        'on-change="$ctrl.onChange(result)"' +
                    '></sb-color-dropdown>' +
                '</span>' +
                '<div class="name">' +
                    '<div class="contenteditable nametext without-underline form-control '+$ctrl.pageClass+ '" placeholder="Enter event name…" ng-model="$ctrl.item.name" ui-focus="true" contenteditable="true" contenteditable-html strip-br="true" one-line="true" required name="name"></div>' +
                    '<div ng-show="($ctrl.formHolder[\'form\'+$ctrl.item._id].name.$dirty || $ctrl.formHolder[\'form\'+$ctrl.item._id][\'formItem_attempted\']) && formHolder[\'form\'+$ctrl.item._id].name.$error.required" class="help-inline ng-hide padding-left10">Please enter event name</div>' +
                '</div>' +
            '</div>' +
            '<div class="with-side-padding form-group text-left clearfix last spacing-half-top margin-half-top" style="border-top: 1px solid #EDF0F2">' +
                '<button class="btn primary pull-left '+$ctrl.pageClass+'" ' +
    'style="width:'+($ctrl.bigBtns?($ctrl.isNew && !$ctrl.showCancel?'100%':'47%'):'auto')+'" ' +
    'class="'+($ctrl.showCancel && !$ctrl.bigBtns? 'smallbtn small-btns':'btn-gray btn-small')+'" ' +
    'type="button" ' +
    'ng-click="$ctrl.saveNew($event)" ' +
    'analytics-on analytics-action="Save ' + $ctrl.itemTitle +'" ' +
    'ng-disabled="$ctrl.isUpdating || !$ctrl.category"' +
    '> <span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> <span>'+
    ($ctrl.btnText?$ctrl.btnText: ($ctrl.isNew ? 'Add Element ':'Update')) +
    '</span></button>' +
    ($ctrl.showCancel && $ctrl.bigBtns ? '<button class="edit-profile btn btn-small transparent pull-right" style="width: 48%" ng-click="$ctrl.cancelPopup()" type="button">Cancel</button>' : '') +
    ($ctrl.showCancel && !$ctrl.bigBtns ? '<span class="orsmall">or</span>' : '') +
    ($ctrl.showCancel && !$ctrl.bigBtns ? '<a class="cancelsmall" ng-click="$ctrl.cancelPopup()">Cancel</a>' : '')+
            '</div>' +
            '<div class="clearfix" style="height:0"><input id="gotobottom" type="text" style="width:0;height:0;border:0;background: transparent; text-indent:9999px"></div>' +
        '</form>' +
    '</div>' +
'</div>';
    }
}

