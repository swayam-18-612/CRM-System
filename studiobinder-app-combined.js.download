addMoSePa('Collaborators', 'collaborators', TempCollaboratorsService,{
    serviceInjectList: ['ResourcePathsService'],
    serviceInjectMod: ['apiServices.paths.service']
});
function TempCollaboratorsService(ApiService, model, ResourcePathsService) {
    var service = ApiService(model, {
        listType: 'isGroup',
        convertOtherResources: convertOtherResources
    });

    service.Permissions = [
        {id:1, text: 'Viewer', icon:'eye', desc:'Can only view this page.'},
        {id:2, text:'Commenter', icon:"note-bubble-filled", desc:'Can add comments and tasks to this page.'},
        {id:3, text:'Editor', icon:'pencil', desc:'Can edit this page, and add comments & tasks'},
    ];

    service.getPostPath = ResourcePathsService.getCollaboratorPath;

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.getPermissionName= getPermissionName;
    service.getPermissionDesc= getPermissionDesc;
    service.getPermissionIcon = getPermissionIcon;

    service.share = share;
    service.reshare = reshare;
    service.requestAccess = requestAccess;
    service.getAll = getAll;

    return service;

    function convertOtherResources(item) {
        if (item.userId && typeof(item.userId) === 'object') {
            item.user = new service.Users(item.userId);
            item.userId = item.userId._id;
        }
        return item;
    }
    function getChangedFieldForUpdateOther(){
        return ['order', 'permission'];
    }

    function getPermissionName(item){
        return getPermissionProp(item, 'text');
    }

    function getPermissionDesc(item){
        return getPermissionProp(item, 'desc');
    }
    function getPermissionIcon(item){
      return getPermissionProp(item, 'icon');
    }

    function getPermissionProp(item, prop){
        if(!item){return null;}
        for(var i = 0 ; i < service.Permissions.length;i++){
            var p = service.Permissions[i];
            if(p.id === item.permission){return p[prop];}
        }
        return null;
    }

    function share(params, successcb, errorcb){
        return service.postUrl('/share', params, successcb , errorcb, true );
    }

    function reshare(params, successcb, errorcb){
        return service.postUrl('/reshare', params, successcb , errorcb, true);
    }

    function requestAccess(params, successcb, errorcb){
        return service.postUrl('/request-access', params, successcb , errorcb, false);
    }

    function getAll(query, pageSize, populate, successcb, errorcb) {
        return service.$getAll(query, pageSize, populate, successcb, errorcb, true);
    }
}

