angular.module('product.materials.page.service', [
    'apiServices.Materials',
    'product.materials.group.component',
    'apiConstants.materials.services',
    'page.tree.simple.controller.service'
])

.constant('MaterialsPageCtrlServiceInjectors', {
    pageCtrlService: 'PageTreeSimpleCtrlService',
    constantsService: 'MaterialConstantsService',
    listsService: 'MaterialsService',
    service: 'MaterialsService'
})
.service('MaterialsPageCtrlService', MaterialsPageCtrlService);
MaterialsPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'MaterialsPageCtrlServiceInjectors'];
function MaterialsPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    return function ($ctrl, $element, printPageParams, otherOptions) {
        //params = {compOptions, listTreeServiceParams, keyboardServiceParams}
        console.log('MaterialsPageCtrlService');
        if(!$ctrl.quotaFiles) {
            $ctrl.quotaFiles = 'fileStorage';
        }
        $ctrl.getGroupBodyAddon = getGroupBodyAddon;
        $ctrl.getGroupFilters = getGroupFilters;
        $ctrl.getRightButtons = getRightButtons;

        if(!otherOptions){otherOptions = {};}

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams, _.extend(otherOptions, {
            sidebarOptions: {
                getNewItem: getNewItem,
            }
        }));

        $ctrl.filtersClass = 'small';
        $ctrl.hasSidebar = hasSidebar;
        $ctrl.onLoadDirectory = onLoadDirectory;

        $ctrl.onContainerInit = $ctrl.onPageTreeInit;

        return $ctrl;

        function getGroupBodyAddon() {
            var p = {
                'aws-sign-path': '"::$ctrl.awsSignPath"', // null
                'max-size': '"::$ctrl.maxSize"',

                'on-load-directory': '"$ctrl.onLoadDirectory(item)"'
            };

            if ($ctrl.codeName) {
                p['code-name'] = '"' + $ctrl.codeName + '"';
            }
            return p;
        }

        function getRightButtons() {
            if ($ctrl.isMaterial) {
                return ($ctrl.canEdit ? ('<a ng-show="!$ctrl.listTreeService.active.selectedList.isPredef" data-type="createFromTop" analytics-on analytics-action="Upload Files" class="'+ $ctrl.getBtnActionCls() + ' pull-left btn btn-small primary without-text transparent with-margin-left ' + ($ctrl.pageClass || '') + '" tooltip="Upload New Version" tooltip-placement="bottom">'+ $ctrl.LCS.getISBDiv('upload-2', 3)+'</a>') : '') +
                    '<a data-type="openVersions" analytics-on analytics-action="Version History" class="'+ $ctrl.getBtnActionCls() + '"><span class="sbf versions"></span> <span>Version History</span></a>';
            } else if($ctrl.canEdit) {
                return $ctrl.getNewGroupTopButtons();
            }
        }

        function hasSidebar() {
            if (!$ctrl.allInfoLoaded) {
                return false;
            }
            var tree = $ctrl.listTreeService.getTree($ctrl.treeType, $ctrl.listTreeService.selectedFilter),
                parent = tree ? tree[0] : null,
                nodes = parent && parent.nodes ? parent.nodes.length : 0;

            return !($ctrl.CPS.isCollaborator && !$ctrl.canEdit && !nodes);
        }

        function onLoadDirectory(item) {
            console.log('onLoadDirectory: ' + item._id);
             if (item){
                 if(item.isFolder) {
                     $ctrl.broadcastRoot('FOLDER_CHANGED_' + $ctrl.elemType + '_TREE', item);
                }else{
                     var rolePath = $ctrl.CPS.isCollaborator ? $ctrl.CPS.rolePaths.collabPath : $ctrl.CPS.rolePaths.currentUserPath,
                         params = {
                            productId: $ctrl.CPS.productId,
                            materialId: item._id
                        };
                    if($ctrl.CPS.isCollaborator){
                        $ctrl.popupsService.open(null, $ctrl.popupsService.operations.singleMaterial, params, $ctrl.compOptions);
                    }else{
                        $ctrl.CPS.transitionTo('user.product.library-file', $ctrl.CPS.currentPathParams(params, rolePath));
                    }
                }
            }
        }

        function getGroupFilters() {
            var params = {isFolder: false};
            /* if ($ctrl.CPS.isCollaborator) {
                 var parentId = $ctrl.getParentId();
                 if (parentId) {
                     params.parentId = parentId;
                     $ctrl.hideAddNewGroupForCollabs = parentId;
                 }
             }*/
            return params;
        }

        function getNewItem(item, addFolder) {
            var el = _.extend({
                isFolder: addFolder,
                type: item.type,
            }, $ctrl.withProperty());

            var selectedList = $ctrl.listTreeService.active ? $ctrl.listTreeService.active.selectedList : null,
                check = null;
            if (selectedList) {
                var tree = $ctrl.listTreeService.getTree(el.type, selectedList.active);
                check = item._id ? item : (selectedList.type === el.type ? selectedList : (tree && tree.length > 0 ? tree[0] : null));
            }
            return {el: el, selectedList: check};
        }

        function getBreadcrumbs() {
         return '<a ng-if="$ctrl.hideAddNewGroupForCollabs" ui-sref="user.product.library($ctrl.CPS.currentProductPathParams())" ng-bind="::$ctrl.title" ng-class="::{\'inactive\':!$ctrl.CPS.isAuthenticated}"> </a>' +
                '<span ng-repeat="n in $ctrl.breadcrumbs track by n._id">' +
                    '<span ng-if="$index!==0&&!$ctrl.hideAddNewGroupForCollabs||$ctrl.hideAddNewGroupForCollabs" class="sbf forward"></span>' +
                    '<a ng-if="$index!==$ctrl.breadcrumbs.length-1" ng-click="$ctrl.CPS.isCollaborator&&$ctrl.material ? null: $ctrl.loadDirectory(n)"><span ng-bind="n._id?n.name:title| truncate : 20" tooltip="{{n.name.length>18?n.name:\'\'}}" tooltip-placement="bottom" ng-class="{\'inactive\':!$ctrl.CPS.isAuthenticated&&!n._id}" ></span></a>' +
                    '<span ng-if="$index==$ctrl.breadcrumbs.length-1" ng-bind="n._id?n.name:title| truncate : 20" tooltip="{{n.name.length>18?n.name:\'\'}}" tooltip-placement="bottom"></span>' +
                '</span>' +
                '<a ng-if="$ctrl.material&&$ctrl.material.version.version" ng-click="$ctrl.openVersions($event)" analytics-on analytics-action="Version History">' +
                    '<span class="mark-version file" tooltip="{{$ctrl.material.version.name}}" tooltip-placement="bottom">' +
                        '<span ng-bind="\'v\' +$ctrl.material.version.version" class="with-margin-left"></span> ' +
                        $ctrl.LCS.getISBDiv('arrow-filled-down', 2, 'pull-right blue hide-print') +
                    '</span>' +
                '</a>';
        }
    }
}

angular.module('product.materials.item.edit.component', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'apiServices.Materials'
])
.component('materialEditPopup', popupComponentParams('MaterialEditPopupCtrl'))
.controller('MaterialEditPopupCtrl', MaterialEditPopupCtrl);
MaterialEditPopupCtrl.$inject =['GeneralItemEditCtrlService', '$element'];
function MaterialEditPopupCtrl( GeneralItemEditCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.preSetTemplateData = preSetTemplateData;
    $ctrl.getPopupFooterBtns = getPopupFooterBtns;

    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl.postInitGeneral = postInitGeneral;
    $ctrl.onLoaded = onLoaded;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function onLoaded() {
        $ctrl.setFocus();
    }

    function preInitGeneral() {
        $ctrl.isFolder = $ctrl.item.isFolder;
        $ctrl.itemTitle1 = $ctrl.CPS.capitalizeFirst( $ctrl.isFolder ? $ctrl.nameForGroup : $ctrl.itemTitle);
        $ctrl.icon = $ctrl.isFolder ? $ctrl.iconForGroup : $ctrl.itemIcon;

        if ($ctrl.isDuplicate) {
            $ctrl.item.materialId = $ctrl.extraParam.materialId;
        }
    }

    function postInitGeneral() {
        $ctrl.onSaveGeneral = onSaveGeneral;
    }

    function onSaveGeneral(result) {
        var item = result.item;
        var m = ($ctrl.isFolder ? 'folder.' : '') + ($ctrl.isDuplicate ? 'Duplicate' : ($ctrl.isNew ? 'Create' : 'Edit'));
        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.objectType + '.' + m + '.success', 'success', {name: item.name});
        $ctrl.LCS.timeout(function () {
            if ($ctrl.isNew && !$ctrl.isFolder) {
                $ctrl.CPS.transitionTo('user.product.' + $ctrl.objectType, $ctrl.CPS.currentProductPathParams({
                    materialId: item._id,
                }, $ctrl.CPS.isCollaborator ? $ctrl.CPS.rolePaths.collabPath : $ctrl.CPS.rolePaths.currentUserPath));
            }
        }, 100);
    }

    function preSetTemplateData() {
        $ctrl.icon = $ctrl.isDuplicate ? 'copy' : ($ctrl.isFolder ? $ctrl.iconForGroup : $ctrl.itemIcon);
        $ctrl.itemTitle1 = $ctrl.CPS.capitalizeFirst( $ctrl.isFolder ? $ctrl.nameForGroup : $ctrl.itemTitle);
        $ctrl.popupTitle = ($ctrl.isNew ? 'Name ' : 'Rename ') + $ctrl.itemTitle1;
        $ctrl.withFooterBtns = true;
        $ctrl.withBtnDisabled = true;
        $ctrl.btnText = $ctrl.action;
        $ctrl.textAnalytics = $ctrl.removeHtmlTags($ctrl.popupTitle);
    }

    function getPopupFooterBtns() {
        var checkDisabled = true;
        var disabled = '$ctrl.isUpdating===true' + (checkDisabled ? '||$ctrl.isBtnDisabled()' : ''),
            cls = ($ctrl.pageClass ? $ctrl.pageClass : '') + ' max-width200',
            action = ($ctrl.isNew ? ($ctrl.isDuplicate ? 'Duplicate' : 'Create') : 'Rename');
        return '<button class="btn btn-primary ' + (cls ? cls : '') + '" type="submit" ' +
            'ng-click="$ctrl.save()" ' +
            'analytics-on analytics-action="' + action + ' ' + $ctrl.itemTitle1 + '" ' +
            'ng-class="{\'disabled\':' + disabled + '}" ng-disabled="' + disabled + '" ' +
            '> <span class="sbf loadingicon animate-spin pull-left" ng-show="$ctrl.isUpdating===true"></span> <span>' + action + '</span><span class="hide-ipad">  ' + $ctrl.itemTitle1 + '</span></button>';
    }
}



angular.module('apiConstants.moodboards.services', [
    'compOptions.moodboards.constant',
    'sb.fields.types.service'
])
.service('MoodboardConstantsService', MoodboardConstantsService);
MoodboardConstantsService.$inject = ['SBFieldTypesService', 'MoodboardsCompOptions'];
function MoodboardConstantsService(SBFieldTypesService, compOptions ) {
    var PropTypes = SBFieldTypesService.PropTypes,

        Options = {columns: ['1', '8','9', '10'
            //25
            ],
            view: 3,
            column: 5,
            printColumn: 4,
            ratio: 1, type: 1,
            orientation: 'portrait',
            hidePrintGridSettings: true,
            showPrintBorders: true,
            hidePrintFontSizes: true,
        },
        CompOptions = angular.copy(compOptions),


        Settings = {
            ViewModes: [
                {id: 3, code: 'Grid', name: 'Grid View', icon: 'storyboard-grid'}
            ],
            Columns: angular.copy(SBApiGridColumns['moodboards'](PropTypes, CompOptions.withLikesOnItem))
        },

        Filters = [{value: true, text: 'Active'}, {value: false, text: 'Archived'}],

        ListTreeServiceParams = {
            level0Name: 'All Mood Boards',
            preLoadingTableName: 'MoodboardsLists',
            listCheckerConsidersItemsCount: true,

            addListOnEmptyState: true,
            maxLevel: 2,
            startIndent: 0,
