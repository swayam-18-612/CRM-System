/**
 * Angular Selectize2
 * https://github.com/machineboy2045/angular-selectize
 **/

angular.module('sb.fields.selectize.service', [])
.service('SBSelectizeCtrlService', SBSelectizeCtrlService);
SBSelectizeCtrlService.$inject = ['$timeout'];

function SBSelectizeCtrlService($timeout) {
   return function ($element, $attrs, params) {
       var $ctrl = this,
           selectize, settings;

       $ctrl.$element = $element;
       $ctrl.selectorCacheUpdate = selectorCacheUpdate;
       
       $ctrl.setSelectizeValue = setSelectizeValue;
       $ctrl.setSelectizeOptions = setSelectizeOptions;

       init(params);

       return $ctrl;

       function init() {
           if(params){
               $ctrl = _.extend($ctrl, params);
           }

           if (!$ctrl.initList) {
               $ctrl.initList = [];
           }
           if (!$ctrl.config) {
               $ctrl.config = {};
           }
           
           settings = _.extend({}, Selectize.default, {
               delimiter: '|',
               wrapperClass: 'selectize-control',
               inputClass: $attrs.fieldClass ? $attrs.fieldClass : 'selectize-input selected-text countries',
               dropdownClass: 'selectize-dropdown ',
               dropdownContentClass: 'selectize-dropdown-content ',

               maxItems: $attrs.maxItems ? parseInt($attrs.maxItems,10) : 1,

               placeholder: $attrs.placeholder ? $attrs.placeholder :'',
           }, $ctrl.config);
           
           settings.onChange = onChange;
           settings.onOptionAdd = onOptionAdd;
           settings.onInitialize = onInitialize;

           $ctrl.isRequired = $attrs.required==='true' || $attrs.required===true || settings.required;

           $ctrl.$element.selectize(settings);
           $ctrl.$element.on('$destroy', onElementDestroy);
       }

       function selectorCacheUpdate(key, value, type) {
           var cached = selectize.renderCache[type][key];
           // update cached element
           var newValue = angular.element(cached).html(value);
           selectize.renderCache[type][key] = newValue[0].outerHTML;
           return newValue.html();
       }


       function setSelectizeOptions(options, selectedItem) {
           //console.log('setSelectizeOptions');
           options = _.filter(options, function (o){
              return !o.isFromSelectize;
           });

           selectize.clear();
           selectize.clearOptions();
           selectize.renderCache = {};

           selectize.addOption(options, true);
           $ctrl.setSelectizeValue(selectedItem);
           $ctrl.prevOptions = angular.copy(options);

           $timeout(function () {
               //console.log('setSelectizeOptions: refreshOptions');
               selectize.refreshOptions(false); // updates results if user has entered a query
           }, 0);
       }

       function setSelectizeValue(selectedItem) {
           if($ctrl.isRequired && $ctrl.modelCtrl) {
               $ctrl.modelCtrl.$setValidity('required', !isEmpty($ctrl.ngModel));

               selectize.$control.toggleClass('ng-valid', $ctrl.modelCtrl.$valid);
               selectize.$control.toggleClass('ng-invalid', $ctrl.modelCtrl.$invalid);
               selectize.$control.toggleClass('ng-dirty', $ctrl.modelCtrl.$dirty);
               selectize.$control.toggleClass('ng-pristine', $ctrl.modelCtrl.$pristine);
           }

           if(selectedItem!==undefined){
               $ctrl.ngModel = selectedItem;
           }
           if(selectedItem === 'sb-clear'){
               selectize.clear();
           }else{
               if (!angular.equals(selectize.items, $ctrl.ngModel)) {
                   selectize.setValue($ctrl.ngModel, true);
               }
           }

           function isEmpty(val) {
               return val === undefined || val === null || !val.length; //support checking empty arrays
           }
       }

       function onChange(value) {
           var value = angular.copy(selectize.items);
           if (settings.maxItems === 1) {
               value = value[0];
           }
           if($ctrl.modelCtrl) {
               $ctrl.modelCtrl.$setViewValue(value);
           }

           if ($ctrl.config.onChange) {
               $ctrl.config.onChange.apply(this, arguments);
           }


           if ($ctrl.onChange) {
               $ctrl.onChange({result:{value: value}});
           }
       }

       function onOptionAdd(value, data) {
           //console.log('SBSelectize.onOptionAdd');
           if(data && data.isFromSelectize){
               if ($ctrl.config.onOptionAdd) {
                   $ctrl.config.onOptionAdd.apply(this, arguments);
               }
           }
       }

       function onInitialize() {
           selectize = $ctrl.$element[0].selectize;
           if ($attrs.partialId) selectize.partialId = $attrs.partialId;

           $ctrl.setSelectizeOptions($ctrl.initList);

           //provides a way to access the selectize element from an
           //angular controller
           if ($ctrl.config.onInitialize) {
               $ctrl.config.onInitialize(selectize);
           }
       }

       function onElementDestroy() {
           if (selectize) {
               selectize.destroy();
               $ctrl.$element = null;
           }
       }
   }
}

angular.module('sb.fields.popovers.assignCast.menu.controller.service',[
    'sb.fields.popovers.assignElements.controller.service.component'
])
.service('AssignCastMenuCtrlService', AssignCastMenuCtrlService);
AssignCastMenuCtrlService.$inject =['AssignElementsCtrlService'];
function AssignCastMenuCtrlService(AssignElementsCtrlService) {
    return function ($ctrl, $element) {
        console.log('AssignCastMenuCtrlService');

        $ctrl.elementType = 1;

        $ctrl.withoutTemplateCompile = true;
        $ctrl.withSquareImg = false;

        $ctrl.categoryId = "5a69235edf0fbc89a637c1ab";
        $ctrl.itemTitle = 'Cast';
        $ctrl.emptyItemTitle = 'Cast Member';

        $ctrl.emptyIcon = 'contacts-1';
        $ctrl.emptyIconLevel = 2;
        $ctrl.fields = ['name', 'currentId', 'allScenes'];
        $ctrl.showTagAll = true;

        $ctrl.allScenesOnUpdate = true;

        $ctrl.goToManage = goToManage;
        $ctrl.initOthers = initOthers;
        $ctrl.setNewForm = setNewForm;
        $ctrl.getAddNewForm = getAddNewForm;

        $ctrl.saveNewOther = saveNewOther;
        $ctrl.getElementFromCache = getElementFromCache;

        $ctrl.getDefaultParams = getDefaultParams;
        $ctrl.clearValidation = clearValidation;

        $ctrl = new AssignElementsCtrlService($ctrl, $element);

        return $ctrl;

        function initOthers() {
            $ctrl.getNew = getNew;
            $ctrl.service = $ctrl.scriptLoadingService.getObjectService($ctrl.scriptLoadingService.TblTypes.TaggingScenes);
        }

        function getElementFromCache (elementId) {
            return elementId ? $ctrl.scriptLoadingService.getTaggingElementById(elementId) : null;
        }

        function setNewForm() {
            var prop = 'currentId';
            if ($ctrl.hasField(prop)) {
                var el = $ctrl.addNewForm.querySelector('#' + prop);
                if(el){el.value = $ctrl.item[prop];}
            }

            prop = 'allScenes';
            if ($ctrl.hasField(prop)) {
                var el = $ctrl.addNewForm.querySelector('#' + prop);
                if(el){el.removeAttribute('checked');}
            }
        }

        function clearValidation(withEmpty) {
            $ctrl.setReqField('currentId', true, withEmpty);
        }

        function saveNewOther() {
            var prop = 'currentId', val;
            if($ctrl.hasField(prop)) {
                val = $ctrl.setReqField(prop, false);
                if (!val) {
                    return;
                }
                $ctrl.item[prop] = val;
            }

            prop = 'allScenes';
            if($ctrl.hasField(prop)) {
                var el = $ctrl.addNewForm.querySelector('#' + prop);
                $ctrl.item[prop] = el ? el.checked : false;
            }
        }

        function getNew() {
            return $ctrl.service.convertResource(_.extend({
                currentId: $ctrl.service.getNewCurrentId($ctrl.initList),
                order: $ctrl.getOrder($ctrl.initList),
                name: null,
                type: $ctrl.elementType,
                allScenes: false,
                searchPosition: true,
                count: 1,
                withoutStripId: true
            }, $ctrl.getDefaultParams()));
        }

        function getAddNewForm() {
        return '<div class="form-group sbfgroup thinner text-left clearfix without-right-padding table field full-width">' +
                    '<div class="col30">'+$ctrl.LCS.getISBDiv('contacts-1', 2, 'pull-left gray') +'</div>' +
                    '<div ' + ($ctrl.hasField('currentId') ? 'class="with-padding-right"' : '') + '>' +
                        '<input placeholder="' + $ctrl.itemTitle + ' Name…" class="no-indent form-control with-underline uppercase" type="text" id="name" name="name">' +
                        '<div style="top:29px" class="help-inline sb-hide req valname">Name is required.</div>' +
                    '</div>' +
                    getCurrentIdField() +
               '</div>';

            function getCurrentIdField() {
                if (!$ctrl.hasField('currentId')) {
                    return '';
                }
                return '<div class="col50" >' +
                    '<input placeholder="ID #" class="form-control with-underline text-center no-indent" type="text" id="currentId" name="currentId">' +
                    '<div style="top:29px" class="help-inline sb-hide req valcurrentId">ID is required.</div>' +
                    '<div style="top:29px" class="help-inline sb-hide no valcurrentId">ID must be a number.</div>' +
                    '</div>';
            }
        }

        function getDefaultParams(type) {
            return _.extend({
                categoryId: $ctrl.categoryId
            }, $ctrl.getDefaultInitParams(type));
        }

        function goToManage() {
            $ctrl.popupsService.teamAccess(function () {
                if ($ctrl.onClose) {
                    $ctrl.onClose({result: 'cancel'});
                }

                $ctrl.CPS.transitionTo('user.product.elements', $ctrl.CPS.currentProductPathParams({categoryId: $ctrl.categoryId}));
            });
        }
    }
}

angular.module('sb.fields.popovers.assignElements.controller.service.component',[
    'sb.fields.popovers.assignElements.init.controller.service.component',
    'product.selectors.searchonlist.controller.service'
])
.service('AssignElementsCtrlService', AssignElementsCtrlService);
AssignElementsCtrlService.$inject =['AssignElementsInitCtrlService', 'SearchOnListCtrlService', 'TemplateCompileService'];
function AssignElementsCtrlService(AssignElementsInitCtrlService, SearchOnListCtrlService, TemplateCompileService) {
    return function($ctrl, $element){
        $ctrl.withEmptyBtn = true;
        $ctrl.withEllipsis = false;
        $ctrl.addNewFormCls = 'add-new-form';
        $ctrl.btnStartAddCls = 'btnStartAdd';
        $ctrl.btnCancelAddCls = 'btnCancelAdd';
        $ctrl.btnSaveAddCls = 'btnSaveAdd';
        $ctrl.btnManageCls = 'btnManage';
        $ctrl.btnResetCls = 'btnReset';
        $ctrl.btnUpdateCls = 'btnUpdate';
        $ctrl.btnsUpdateCls = 'btnsUpdate';
        $ctrl.btnsAddCls = 'btnsAdd';

        $ctrl.allMentionsText = 'Tag all mentions in script';

        $ctrl.scrollableContainerSelector = '.selected-projects .listitems-selector';
        $ctrl.errormessage = 'Please enter a valid name so we can assign cast to this scene';
        $ctrl.initiated = false;
        $ctrl.multipleSelection = true;
        if(!$ctrl.imageField) {
            $ctrl.imageField = 'logo';
        }
        $ctrl.getSearchPlaceholder = getSearchPlaceholder;

        $ctrl.onOtherError = onOtherError;
        $ctrl.setReqField = setReqField;
        $ctrl.postCustomSelectorInitSave = postCustomSelectorInitSave;
        $ctrl.getItemTemplate  = getItemTemplate;

        $ctrl.startAddFromEmpty = startAddFromEmpty;
        $ctrl = new AssignElementsInitCtrlService($ctrl, $element);

        $ctrl.resetValue = resetValue;
        $ctrl.getTitleSingular = getTitleSingular;
        $ctrl.updateItem = updateItem;
        $ctrl.$onInit = $onInit;
        $ctrl.$onDestroy = $onDestroy;
        $ctrl.getAllScenesField = getAllScenesField;
        $ctrl.hasField = hasField;
        $ctrl.clearValidationInit = clearValidationInit;

        return $ctrl;

        function $onInit() {
            $ctrl.replaceExistingText = 'Replace existing ' + $ctrl.itemTitle.toLowerCase();
            $ctrl = new SearchOnListCtrlService($ctrl);

            $ctrl.assignElementsInit();
            setItems();
            $ctrl.addRootWatcher('SAVE_ASSIGNED_'+$ctrl.elemtype+'_'+$ctrl.element.getAttribute('id'), onSaveAssigned);
        }

        function getSearchPlaceholder(){
            return 'Search '+$ctrl.itemTitle.toLowerCase()+' by name…';
        }

        function postCustomSelectorInitSave(withChange, isCreate) {
            console.log('postCustomSelectorInitSave');
            if(withChange) {
                reloadElements();
            }

            removeSpinner();

            if(isCreate) {
                $ctrl.item = $ctrl.getNew();
                setNewForm(null, false);
                //if is firt tinme trigger apply without showing the form to select
                if($ctrl.withNoItems){
                    $ctrl.withNoItems = false;
                    $ctrl.LCS.timeout(function (){
                        onBtnUpdate();
                    }, 200);
                }
            }
        }

        function setItems(element, get) {
            var el = element ? element : $ctrl.element,
            m = get ? get : getItemTemplate;
            if ($ctrl.withoutTemplateCompile) {
                $ctrl.LCS.appendChildFragment(el, m());
                onTemplateLoaded(get === true);
            } else {
                reloadTemplate(angular.element(el), m);
            }
        }

        function reloadTemplate(element, getItemTemplate) {
            if (!$ctrl.templateCompile) {
                $ctrl.templateCompile = new TemplateCompileService(element, getItemTemplate, $ctrl);
            }
            $ctrl.templateCompile.withoutTimeout = $ctrl.withoutTemplateCompile;
            $ctrl.templateCompile.loadTemplate(onLoaded);
        }

        function onLoaded() {
            onTemplateLoaded(false);
        }

        function removeSpinner() {
            $ctrl.setLoader(false);
        }

        function onSaveAssigned(next){
            console.log('onSaveAssigned');
            $ctrl.applyChanges(null, next);
        }

        function onTemplateLoaded(isPartial) {
            if(!isPartial){
                bindAddNew(true);
                bindDefault(true);
            }

            bindItemClicks($ctrl.element, false);
            bindItemClicks($ctrl.element,true);

            if($ctrl.hasCustomTemplate && (!$ctrl.initList || !$ctrl.initList.length)){
                startAddFromEmpty();
            }
            $ctrl.setFocusOnSearch(100);
        }

        function reloadElements() {
            resetLists();
            if($ctrl.isEmptyListOn){
                $ctrl.LCS.removeClass($ctrl.element.querySelector('.search-field'), 'sb-hide');
                var el = $ctrl.element.querySelector('.selected-items-dropdown');
                $ctrl.LCS.emptyElement(el);

                setItems(el, getItemsList);
                $ctrl.isEmptyListOn = false;
            }else{
                processLists(true);
            }
        }

        function processLists(isReload){
            var m = isReload ? reloadList : loadlist;
            return m('members', true) +
                   m($ctrl.listBottomName, false);

            function reloadList(type, checked) {
                var list = $ctrl[type],
                    cls = 'block' + type,
                    ulCls = 'ul-' + cls;
                if (!$ctrl[cls]) {
                    $ctrl[cls] = $ctrl.element.querySelector('.' + cls);
                }

                if ($ctrl[cls]) {
                    $ctrl.LCS[list.length > 0 ? 'removeClass' : 'addClass']($ctrl[cls], 'sb-hide');

                    if (!$ctrl[ulCls]) {
                        $ctrl[ulCls] = $ctrl[cls].querySelector('ul');
                    }
                }

                if ($ctrl[ulCls]) {
                    bindItemClicks($ctrl[ulCls], false);
                    $ctrl.LCS.appendChildFragment($ctrl[ulCls], getListContent(list, checked), true);
                    bindItemClicks($ctrl[ulCls], true);
                }
            }

            function loadlist(type, checked) {
                var list = $ctrl[type];
                return '<div class="block' + type + ' ' + (list && list.length > 0 ? '' : 'sb-hide') + '">' +
                    /*  '<div class="header-small clearfix spacing-half-top with-side-padding '+($ctrl.initList.length>0?'':'sb-hide')+'">'+(checked? 'Assigned to Scene' : 'Unassigned')+'</div>' +*/
                    '<ul>' + getListContent(list, checked) + '</ul>' +
                    '</div>';
            }

            function getListContent(list, checked) {
                return list ? _.map(list, getListItem).join('') : '';

                function getListItem(item) {
                    if(!item){return '';}
            return '<li class="' + $ctrl.itemClass + ' ui-select-choices-group with-cursor" data-id="' + item._id + '">' +
                        '<a class="select-choices-row-inner table-div fixed-layout">' +
                            '<div class="col20">' +
                            '<div class="custom-checkbox"><label><input type="checkbox" '+(checked ? 'checked="checked"' :'')+'><span></span></label></div>' +
                            '</div>'+
                            '<div class="col45 position-relative">' +
                            getImage(item, "smaller") +
                            (item.currentId ?('<div class="numbered-char on-top">'+item.currentId+'</div>') : '')+
                            '</div>' +
                            '<div>' +
                            '<div class="'+($ctrl.withEllipsis ? 'with-ellipsis' : '') +' name '+
                            ($ctrl.isLocations ? '' : 'uppercase') + '">' +(item.name?item.name:'–')+'</div>' +
                            //not confirmed
                            // (item.memberType!== $ctrl.security.MemberTypes.Owner && item.status !== 2 ? '<div class="smaller-orange">Invited and pending…</div>' : '') +
                            '</div>' +
                        '</a>' +
                        '</li>';

                    function getImage(item, cls) {
                        return $ctrl.security.getImage($ctrl.isElement? item.element : item, cls, $ctrl.imageField, 100, {
                            withSquareImg : $ctrl.withSquareImg
                        });
                    }
                }
            }
        }

        function getMemberById(id) {
            return _.find($ctrl.initList, function (item) {
                return item._id === id
            });
        }

        function getItemTemplate() {
            return $ctrl.hasCustomTemplate ? getItemTemplateContent() : getItemTemplateContent();
        }

        function getItemTemplateContent() {
            console.log('getItemTemplateContent');
            var isEmpty = $ctrl.isPopup && !$ctrl.initList.length;
return '<div class="dropdown-menu selector-dropdown with-overflow selectabledropdown addteammate cast-popup assign-elements-drp hide-new-form ' +
    ($ctrl.drpClass ? $ctrl.drpClass : '')+ '">' +
        '<div class="wrapper '+(isEmpty?'sb-hide':'')+'">'+
            '<div class="search-field form-group sbfgroup field last withSearch margin-top-quarter no-indent ' + ($ctrl.initList.length > 0 ? '' : 'sb-hide') + '">' + $ctrl.getSearchContent() + '</div>' +
            '<div class="selected-items-dropdown margin-quarter">' +
                ($ctrl.initList.length>0 ? getItemsList() : $ctrl.getEmptyList()) +
            '</div>' +
        '</div>'+
        getAddNew() +
    '</div>';
        }

        function getItemsList() {
            resetLists();

    return '<div class="show-scrollbar-on-hover">' +
                '<div class="fancy-scrollbar vertical padding-right-0">' +
                    '<div>' +
                        '<div class="select-choices with-teams display-block">' + processLists( false)+ '</div>' +

                    // ($ctrl.search ? getEmptySearch():
                    '</div>' +
                '</div>' +
            '</div>';
        }

        function resetLists() {
            $ctrl.members = _.sortBy($ctrl.value.length ? _.filter($ctrl.value.map(getMemberById), function(item){return item !== null && item !== undefined;}) : [], 'order');

            $ctrl.unselected = _.sortBy(_.filter($ctrl.initList, function (item) {
                return !$ctrl.value || $ctrl.value.indexOf(item._id) === -1;
            }), 'order');
        }

        function bindItemClicks(parent, isBind) {
            if(!parent){
                console.log('parent for bindItemClicks is null on isbind = ' + isBind);
                return;
            }
            $ctrl.LCS.bindElementsClick(isBind, parent.querySelectorAll('.' + $ctrl.itemClass), updateItem);
        }

        function getAddNew(){
     return '<div class="add-new-block centering with-side-padding '+($ctrl.initList.length>0?($ctrl.hasCustomTemplate ?'':'with-border-top'): 'sb-hide')+'">' +
                '<div class="add-new-btns form-group clearfix last">' +
                    '<div id="'+$ctrl.btnsAddCls+'" '+($ctrl.hasCustomTemplate ? 'class="full-width clearfix" ' : '')+'>' +
                        '<a id="'+$ctrl.btnStartAddCls+'" class="pull-left smaller-font small inline-block semibold">' +
         $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left with-margin-right') + ' Add ' + getTitleSingular() + '</a>' +
                        '<a id="'+$ctrl.btnManageCls+'" class="pull-right smaller-font small inline-block semibold hide-ipad '+($ctrl.hasCustomTemplate ?'sb-hide':'')+'">Manage '+$ctrl.itemTitle+'</a>' +
                     '</div>'+
                     '<div id="'+$ctrl.btnsUpdateCls+'" class="'+($ctrl.hasCustomTemplate ? 'text-center full-width clearfix spacing-half-top with-border-top' : 'sb-hide')+'">' +
         $ctrl.getAllScenesField(true) +
         getReplaceExisting() +
                        '<button id="'+$ctrl.btnUpdateCls+'" class="btn primary ' + ($ctrl.hasCustomTemplate ? ' full-width' : 'pull-left btn-gray btn-small') + '" ' +
         ($ctrl.hasCustomTemplate ? '' : 'style="width:47%;min-width: 80px"' ) +
         ' type="button"><div class="pull-left sbf1"></div> <span>Apply</span></button>' +
         ($ctrl.hasCustomTemplate ? '' : ('<button id="'+$ctrl.btnResetCls+'" class="edit-profile btn btn-small transparent pull-right" style="width: 48%" type="button">Cancel</button>')) +
                     '</div>' +

                '</div>' +
                '<div class="'+$ctrl.addNewFormCls+'">' + getAddNewForm() + '</div>' +
            '</div>';
        }

        function getTitleSingular(){
            return ($ctrl.itemTitle.indexOf('s') === ($ctrl.itemTitle.length-1)) ? $ctrl.itemTitle.substring(0, $ctrl.itemTitle.length-1) : $ctrl.itemTitle;
        }

        function getAddNewForm() {
            var isEmpty = $ctrl.isPopup && !$ctrl.initList.length,
            txt = 'Add '+$ctrl.emptyItemTitle;
    return '<form name="$ctrl.formHolderItem[$ctrl.formName]" class="auto" novalidate autocomplete="off">' +
                $ctrl.LCS.getErrorBlock('block-error sb-hide') +
                '<div class="centering text-left">' +
                    $ctrl.getAddNewForm()+
                    $ctrl.getAllScenesField() +
                    '<div class="form-group clearfix '+(isEmpty ? 'text-center ' : 'text-left margin-bottom-quarter')+'">' +
                        '<button id="'+$ctrl.btnSaveAddCls+'" class="btn primary '+
        (isEmpty ? ('btn-primary max-width300 full-width ' + ($ctrl.pageClass||'')) : 'primary smallbtn pull-left small-btns')+'" type="button" analytics-on analytics-action="'+txt+'" > ' +
        '<div class="sbf1 pull-left"></div> '+(isEmpty ? txt : 'Create' )+'</button>' +
                       (isEmpty ? '' : ( '<span class="orsmall"> or </span>' + '<a id="'+$ctrl.btnCancelAddCls+'" class="cancelsmall">Cancel</a>')) +
                    '</div>' +
                '</div>' +
            '</form>';
        }

        function getAllScenesField(isUpdate) {
            if(!$ctrl.showTagAll){return '';}
            if (!$ctrl.hasField('allScenes') || isUpdate && !$ctrl.allScenesOnUpdate ){return '';}
            return addCheckbox('allScenes', $ctrl.allMentionsText);
        }

        function getReplaceExisting(){
            return $ctrl.withReplaceExisting ? addCheckbox('replaceExisting', $ctrl.replaceExistingText) :'';
        }

        function addCheckbox(prop, text){
            return '<div class="form-group text-left clearfix">' +
                '<div class="custom-checkbox">' +
                '<label><input id="'+prop+'" type="checkbox" name="'+prop+'" ' +
                ($ctrl.item[prop]?'checked="checked" ':'')+
                '><span><span class="longer">'+text+'</span></span></label></div>' +
                '</div>';
        }


        function hasField(field) {
            return $ctrl.fields.indexOf(field) !== -1;
        }

        function bindAddNew(isBind) {
            if (isBind) {
                $ctrl.startNew(true);
            }
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('#' + $ctrl.btnCancelAddCls), cancelAdd);
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('#' + $ctrl.btnSaveAddCls), saveNew);
        }

        function bindDefault(isBind) {
            if ($ctrl.addEmptyListBtnBind) {
                bindEmptyListBtn(isBind);
            }
            bindList(isBind);

            function bindList(isBind){
                if (isBind && !$ctrl.btnStartAdd) {
                    $ctrl.btnStartAdd = $ctrl.element.querySelector('#' + $ctrl.btnStartAddCls);
                }
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnStartAdd, startAdd);

                if (isBind && !$ctrl.btnManage) {
                    $ctrl.btnManage = $ctrl.element.querySelector('#' + $ctrl.btnManageCls);
                }
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnManage, goToManage);

                if (isBind && !$ctrl.btnUpdate) {
                    $ctrl.btnUpdate = $ctrl.element.querySelector('#' + $ctrl.btnUpdateCls);
                }
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnUpdate, onBtnUpdate);

                if (isBind && !$ctrl.btnReset) {
                    $ctrl.btnReset = $ctrl.element.querySelector('#' + $ctrl.btnResetCls);
                }
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnReset, resetValue);
                $ctrl.bindSearch(isBind);
            }

            function bindEmptyListBtn(isBind){
                if (isBind && !$ctrl.btnStartAddEmpty) {
                    $ctrl.btnStartAddEmpty = $ctrl.element.querySelector('#btnSaveAddEmpty');
                }
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnStartAddEmpty, startAddFromEmpty);
            }
        }

        function onBtnUpdate(e){
            console.log('onBtnUpdate');
            $ctrl.applyChanges(e, function (result){
                $ctrl.onApplyChanges({result: result })
            });
        }

        function startAddFromEmpty(e) {
            toggleAddNewForm(true);
            setNewForm(e, true);
        }

        function startAdd(e) {
            setNewForm(e, true);
        }

        function cancelAdd(e) {
            $ctrl.setLoader(false);

            $ctrl.LCS.addClass($ctrl.addNewForm.querySelector('.block-error'), 'sb-hide');
            $ctrl.clearValidationInit(true);
            setNewForm(e, false);
            toggleAddNewForm(!($ctrl.initList.length === 0));
        }

        function toggleAddNewForm(show) {
            $ctrl.LCS[show ? 'removeClass' : 'addClass']($ctrl.element.querySelector('.add-new-block'), 'sb-hide');

            if ($ctrl.initList.length === 0) {
                $ctrl.LCS[show ? 'addClass' : 'removeClass']($ctrl.element.querySelector('.no-project'), 'sb-hide');
            }
        }

        function setNewForm(e, show) {
            $ctrl.preventDefault(e);
            $ctrl.addNewBlockEl = $ctrl.element.querySelector('.add-new-block');
            if(!$ctrl.hasCustomTemplate) {
                $ctrl.LCS[$ctrl.initList.length > 0 ? 'addClass' : 'removeClass']($ctrl.addNewBlockEl, 'with-border-top');
            }
            if (!$ctrl.addNewBtns) {
                $ctrl.addNewBtns = $ctrl.element.querySelector('.add-new-btns');
            }
            $ctrl.LCS[show ? 'addClass' : 'removeClass']($ctrl.addNewBtns, 'sb-hide');

            if (!$ctrl.addNewForm) {
                $ctrl.addNewForm = $ctrl.element.querySelector('.' + $ctrl.addNewFormCls);
            }
            $ctrl.LCS[show ? 'removeClass' : 'addClass']($ctrl.element.querySelector('.assign-elements-drp'), 'hide-new-form');
            if (show) {
                if (!$ctrl.formAddAdded) {
                    var isBind = true;
                    $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('#' + $ctrl.btnCancelAddCls), cancelAdd);
                    $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('#' + $ctrl.btnSaveAddCls), saveNew);
                    $ctrl.formAddAdded = true;
                }
                var name = $ctrl.addNewForm.querySelector('*[name="name"]');
                if(name) {
                    name.focus();
                    name.value = null;
                }

                $ctrl.setNewForm();
            }
        }

        function saveNew(e) {
            $ctrl.withNoItems = $ctrl.tableType === 'locations' && $ctrl.isPopup && $ctrl.initList.length === 0;
            $ctrl.preventDefault(e);

            console.log('saveNew');
            if ( $ctrl.isUpdating) {return;}

            $ctrl.clearValidationInit(false);

            var prop = 'name';
            var val = setReqField(prop, false);
            if(!val) {
                return;
            }
            if(_.find($ctrl.initList, function(item){
                return item.name && val && item.name.toUpperCase() === val.toUpperCase();
            })){
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.'+$ctrl.elemtype+'.Create.alreadyExists', 'error');
                return;
            }

            $ctrl.item[prop] = val;

            $ctrl.saveNewOther();

            $ctrl.formHolderItem = {};
            $ctrl.formHolderItem[$ctrl.formName] = {$valid:true, $setPristine:function(){}};

            if($ctrl.isUpdating){return;}

            $ctrl.setLoader(true);
            $ctrl.save();
        }

        function clearValidationInit(withEmpty) {
            setReqField('name', true, withEmpty);
            if (typeof ($ctrl.clearValidation) === 'function') {
                $ctrl.clearValidation(withEmpty);
            }
        }

        function setReqField(n, isClear,withEmpty ) {
            if(!hasField(n)) {
                return;
            }
            var isNumber = n !=='name';
            var input = $ctrl.addNewForm.querySelector('*[name="'+n+'"]'),
                val = input ? input.value : '';
            if(val.trim() === ''){val = null;}
            if(isClear || !val){
                process();
                if(!isClear) {return null;}
            }

            var match = /^[1-9]+[0-9]*\w*$/.test(val);
            if(isNumber && (isClear || !match)){
                process();
                if(!isClear) {return null;}
            }

            if (withEmpty && input) {
                input.value = null;
            }

            return val;

            function process() {
                $ctrl.LCS[isClear ? 'addClass' : 'removeClass']($ctrl.addNewForm.querySelector('.' + (isNumber ? 'no' : 'req') + '.val' + n), 'sb-hide');
                $ctrl.LCS[isClear ? 'removeClass' : 'addClass'](input, 'ng-invalid');
            }
        }

        function goToManage(e) {
            console.log('goToManage');
            $ctrl.preventDefault(e);
            $ctrl.goToManage();
        }


        function onOtherError(err, type, mess, name) {
            removeSpinner();
        }

        function updateItem(e) {
            console.log('updateItem');
            var el = e.currentTarget,
                id = el.getAttribute('data-id'),
                input = el.querySelector('input'),
                isToRemove = input.getAttribute('checked') === 'checked';
            $ctrl.preventDefault(e);
            var index = $ctrl.value ? $ctrl.value.indexOf(id) : -1;
            if (isToRemove) {
                if (index !== -1) {
                    $ctrl.value.splice(index, 1);
                }
                input.removeAttribute('checked');
            } else {
                if (index === -1) {
                    $ctrl.value.push(id);
                }
                input.setAttribute('checked', 'checked');
            }
            $ctrl.sendUpdate(e, false);
        }

        function resetValue(e) {
            processListChecks('members', true);
            processListChecks( $ctrl.listBottomName, false);
            $ctrl.value = angular.copy($ctrl.prevValue);

            var withClose = true;
            $ctrl.sendUpdate(e, withClose);

            function processListChecks(type, checked){
                var blockEl = $ctrl.element.querySelector('.block' + type),
                children = blockEl.querySelectorAll('li  input');
                if(children) {
                    _.each(children, function (el) {
                        if (checked) {
                            el.setAttribute('checked', 'checked');
                        } else {
                            el.removeAttribute('checked');
                        }
                    });
                }
            }
        }

        function $onDestroy() {
            bindAddNew(false);
            bindDefault(false);
            $ctrl.bindSearch(false);
            bindItemClicks($ctrl.element, false);
            if ($ctrl.templateCompile) {
                $ctrl.templateCompile.destroyNewScope();
            }
            $ctrl.removeWatchers();
        }
    }
}

angular.module('sb.fields.popovers.assignStrip.controller.service',[
    'sb.fields.popovers.assignStripInit.controller.service'
])
.service('AssignElementsForStripCtrlService', AssignElementsForStripCtrlService);
AssignElementsForStripCtrlService.$inject =['AssignStripInitCtrlService', 'SBDrpNonClosedCtrlService', 'SBFieldTypesService'];

function AssignElementsForStripCtrlService(AssignStripInitCtrlService, SBDrpNonClosedCtrlService, SBFieldTypesService) {
    return function ($ctrl, $element, $attrs, withoutTemplateScope) {
        console.log('AssignElementsForStripCtrlService');

        $ctrl.onClosingOther = onClosingOther;

        $ctrl = new AssignStripInitCtrlService($ctrl);

        $ctrl.SBFieldTypesService = SBFieldTypesService;
        $ctrl.SBFieldMethods = SBFieldTypesService.SBFieldMethods;
        $ctrl.SBDrpNonClosedCtrlService = SBDrpNonClosedCtrlService;

        $ctrl.propType = $ctrl.SBFieldTypesService.PropTypes[$ctrl.propType];

        $ctrl.generateDrpMenuContent = generateDrpMenuContent;
        $ctrl.onRepeatFieldLoaded = onRepeatFieldLoaded;
        $ctrl.preDisplayValue = preDisplayValue;
        $ctrl.triggerUpdate = triggerUpdate;

        $ctrl = new $ctrl.SBDrpNonClosedCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

        return $ctrl;

        function onRepeatFieldLoaded() {
            $ctrl.allEls = angular.copy($ctrl.initList);
            $ctrl.setDisplayValue();
        }

        function preDisplayValue() {
            $ctrl.initList = $ctrl.SBFieldMethods.getElsInList($ctrl.allEls, $ctrl.value);
        }

        function generateDrpMenuContent() {
            var p = {
                scriptLoadingService: $ctrl.scriptLoadingService,
                value: $ctrl.value,
                onSelect: $ctrl.onSelect,
                list: $ctrl.allEls
            };

            $ctrl.menuCls = 'display-block position-relative';

            p.stripIds = [$ctrl.stripId];

            return {
                $ctrl: p,

                template: 'elemtype="' + $ctrl.elemtype + '" ' +

                    'strip-ids="::$ctrl.stripIds" ' +
                    'script-loading-service="::$ctrl.scriptLoadingService" ' +

                    'list="::$ctrl.list" ' +
                    'value="::$ctrl.value" ' +

                    'on-select="$ctrl.onSelect(result)" '
            };
        }

        function onClosingOther(result){
            $ctrl.setNewValue(result.e, result.value);
            if(result.withClose) {
                $ctrl.closeDrp(result.e);
            }
        }

        function triggerUpdate(next){
            $ctrl.broadcastRoot('SAVE_ASSIGNED_'+$ctrl.elemtype+'_'+$ctrl.drpMenuId, next);
        }
    }
}

angular.module('sb.fields.popovers.assignElements.init.controller.service.component',[
    'dropdowns.selector.controller.service'
])
.service('AssignElementsInitCtrlService', AssignElementsInitCtrlService);
AssignElementsInitCtrlService.$inject =['CompInitCtrlService', 'SBSelectorInitCtrlService'];
function AssignElementsInitCtrlService(CompInitCtrlService, SBSelectorInitCtrlService) {

    return function($ctrl, $element){

        var initList = [];
      //  $ctrl.$onDestroy = $onDestroy;
        if(!$ctrl.compLoaded) {
            $ctrl = new CompInitCtrlService($ctrl);
        }

        $ctrl.setLoader = setLoader;

        $ctrl.applyChanges = applyChanges;
        $ctrl.applyChangesInit = applyChangesInit;

        $ctrl.onSBFieldInit = onSBFieldInit;
        $ctrl.assignElementsInit = assignElementsInit;

        $ctrl.getDefaultInitParams = getDefaultInitParams;

        if(!$ctrl.getDefaultParams){
            $ctrl.getDefaultParams = getDefaultInitParams;
        }

        $ctrl.getOrder = getOrder;

        if(!$ctrl.getList) {
            $ctrl.getList = getList;
        }

        $ctrl.sendUpdate = sendUpdate;

        return $ctrl;

        function setLoader(isUpdating) {
            if(!isUpdating) {
                $ctrl.isUpdating = isUpdating;
            }
            if ($ctrl.addNewForm) {
                $ctrl.LCS[isUpdating ? 'addClass' : 'removeClass']($ctrl.addNewForm.querySelector('#' + $ctrl.btnSaveAddCls + ' .sbf1'), 'sbf loadingicon animate-spin');
            }
        }

        function assignElementsInit() {
            $ctrl.objectType = $ctrl.elemtype;
            initList = $ctrl.getList();
            $ctrl.initList = initList;

            $ctrl.onCustomSelectorInitSave = onCustomSelectorInitSave;
            $ctrl.onError = onError;

            if($ctrl.initOthers){
                $ctrl.initOthers ();
            }
            if(!$ctrl.getElementFromCache){
                console.log('Parent for AssignElementsInitCtrlService must define method getElementFromCache');
            }

            if(!$ctrl.setReqField){
                console.log('Parent for AssignElementsInitCtrlService must define method setReqField');
            }

            //$attrs
            //$ctrl.isSOpen = true; //to prevent opening the popper
            $ctrl.withoutPopper = true; //to prevent opening the popper
            $ctrl = new SBSelectorInitCtrlService($ctrl, $ctrl.service, $element);

        }

        function getOrder(elements) {
            return elements && elements.length > 0 ? _.max(elements, function (item) {
                return item.order;
            }).order + 1 : 1;
        }

        function getList() {
            return $ctrl.list;
        }

        function getDefaultInitParams(type) {
            return _.extend({
                productId: $ctrl.CPS.productId,
                companyId: $ctrl.CPS.companyId,

                scriptId: $ctrl.CPS.scriptId,
            }, getStripParam(type));
        }

        function getStripParam(type) {
            //dont pass the strips if add new location
            //dont pass the strips if add new strip location in edit strip popup
            return type !== 'ApplyChanges' ? null : {stripIds: $ctrl.stripIds};
        }

        function onSBFieldInit() {
            $ctrl.addNew = true;

            if(!$ctrl.value && $ctrl.multipleSelection) {
                $ctrl.value = [];
            }
            $ctrl.prevValue = angular.copy($ctrl.value);

            $ctrl.$element = $element;
            $ctrl.element = $ctrl.$element[0];
            $ctrl.attrs = {};
        }

        function onError(err, type, mess, name) {
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.'+$ctrl.objectType+'.' + type + '.' + (mess ? mess : 'error'), 'error',{name:name});

            if($ctrl.onOtherError) {$ctrl.onOtherError();}
        }

        function sendUpdate(e, withClose, initResult) {
            console.log('sendUpdate');
            var result = {
                e: e,
                value: angular.copy($ctrl.value)
            };

            result.stripIds = $ctrl.stripIds;
            result.initResult = initResult;
            result.withClose = withClose;
            $ctrl.onSelect({result: result});
        }

        function applyChanges(e, next) {
            console.log('applyChanges');

            var added = [], removed =[],
                pv = angular.copy($ctrl.prevValue);
            _.each($ctrl.value, function (id) {
                var index = pv.indexOf(id);
                if (index === -1) {//if doesnt exits in prev value add it
                    added.push(id);
                }
            });
            _.each(pv, function (id) {
                var index = $ctrl.value.indexOf(id);
                if (index === -1) {//if doesnt exits in current value remove it
                    removed.push(id);
                }
            });
            $ctrl.applyChangesInit(e, added, removed, next);
        }

        function applyChangesInit(e, added, pv, next) {
            console.log('applyChangesInit');
            if (!added.length && !pv.length) {
                return;
            }
            if ($ctrl.saveInProgress) {return;}

            $ctrl.saveInProgress = true;

            $ctrl.type = 'ApplyChanges';
            var params = $ctrl.getDefaultParams($ctrl.type);

            if (added.length > 0) {
                params.added = added;
            }
            if (pv.length > 0) {
                params.removed = pv;
            }

            if($ctrl.withReplaceExisting){
                var el =  $ctrl.element.querySelector('#replaceExisting');
                if(el && el.checked){
                    params.replaceExisting = true;
                }
            }
            $ctrl.service.updateMultipleForStrip(params, onsuccess, onerror);

            function onsuccess(result) {
                console.log('on updateMultipleForStrip');
                console.log(result);
                $ctrl.saveInProgress = false;
                $ctrl.onCustomSelectorInitSave(result, $ctrl.type, e, next);
            }

            function onerror(err) {
                $ctrl.saveInProgress = false;
                $ctrl.onError(err, $ctrl.type, null);
            }
        }

        function onCustomSelectorInitSave(result, opType, e, next) {
            console.log('onCustomSelectorInitSave');
            if(!opType){opType = 'Create';}
            var isCreate = opType=== 'Create';
            if(result) {
                result.type = opType;
            }

            var withChange = onCustomSelectorSave(result, opType);
            if(withChange) {
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.objectType + '.' + opType + '.success', 'success', isCreate ? {
                    name: result.item ? result.item.name : null
                } : null);
            }

            if(next){
                next(result);
            }else  if (isCreate && !$ctrl.isPopup && $ctrl.elemtype === 'character') {
                //to trigger update for  cast elems on sidebar for breakdowns
                // when new cast is added
                result.elemtype = $ctrl.elemtype;
                $ctrl.broadcastRoot('CREATED_BREAKDOWN_ITEM', result);
            }

            $ctrl.postCustomSelectorInitSave(withChange, isCreate);
        }

        function onCustomSelectorSave (result1, opType) {
            console.log('onCustomSelectorSave');
            if (!result1) {
                return;
            }
            var isCreate = opType === 'Create',
                tableType = $ctrl.tableType === 'locations' ? $ctrl.tableType : (isCreate ? 'taggingElements' : 'taggingScenes'),
                result = $ctrl.scriptLoadingService.processSceneElement(result1, tableType),
                hasChanges = result && (result.countUpdated > 0 || result.withStripChanges);

            if (isCreate) {
                var sceneItem = result.item,
                    parId = tableType === 'taggingScenes' ? 'elementId' : '_id',
                    elementId = sceneItem ? sceneItem[parId] : null,
                    element = elementId ? $ctrl.getElementFromCache(elementId) : null;
                if (element && _.find($ctrl.initList, {_id: elementId}) === undefined) {
                    $ctrl.initList.push(element);
                    $ctrl.initS();

                    if ($ctrl.multipleSelection) {
                        $ctrl.value.push(elementId);
                    } else {
                        $ctrl.value = elementId;
                    }
                    $ctrl.sendUpdate(null, false);
                }
            }

            return hasChanges;
        }
    }
}

angular.module('sb.fields.popovers.assignLocations.menu.controller.service',[
    'sb.fields.popovers.assignElements.controller.service.component'
])
.service('AssignLocationsMenuCtrlService', AssignLocationsMenuCtrlService);
AssignLocationsMenuCtrlService.$inject =['SBFieldTypesService', 'AssignElementsCtrlService'];
function AssignLocationsMenuCtrlService(SBFieldTypesService, AssignElementsCtrlService) {
    return function ($ctrl, $element) {
        $ctrl.isLocations = true;
        $ctrl.withUppercase = true;
        $ctrl.categoryId = "5a69235fdf0fbc89a637c1c1";
        $ctrl.SBFieldTypesService = SBFieldTypesService;

        $ctrl.withoutTemplateCompile = false;
        $ctrl.withSquareImg = true;

        $ctrl.itemTitle = 'Locations';
        $ctrl.emptyItemTitle = 'Location';
        $ctrl.tableType = 'locations';

        $ctrl.emptyIcon = 'locations';
        $ctrl.emptyIconLevel = 2;

        $ctrl.fields = ['name', 'address', 'allScenes'];

        $ctrl.goToManage = goToManage;
        $ctrl.initOthers = initOthers;
        $ctrl.setNewForm = setNewForm;
        $ctrl.getAddNewForm = getAddNewForm;
        $ctrl.getNew = getNew;

        $ctrl.saveNewOther = saveNewOther;
        $ctrl.getElementFromCache = getElementFromCache;

        $ctrl.onChange = onChange;

        $ctrl = new AssignElementsCtrlService($ctrl, $element);

        return $ctrl;

        function initOthers() {
            $ctrl.getNew = getNew;
            $ctrl.service = $ctrl.scriptLoadingService.getObjectService($ctrl.scriptLoadingService.TblTypes.Locations);
        }

        function getElementFromCache(elementId) {
            return elementId ? $ctrl.scriptLoadingService.getLocationById(elementId) : null;
        }

        function setNewForm() {
            var prop = 'allScenes';
            if ($ctrl.hasField(prop)) {
                var el = $ctrl.addNewForm.querySelector('#' + prop);
                if (el) {
                    el.removeAttribute('checked');
                }
            }
            //todo remove text for address
        }

        function saveNewOther() {
            var prop = 'address', val;
            if ($ctrl.hasField(prop)) {
                val = $ctrl.setReqField(prop, false);
                if (!val) {
                    return;
                }
                $ctrl.item[prop] = val;
            }
        }

        function getNew() {
            return $ctrl.service.convertResource(_.extend({
                order: $ctrl.getOrder($ctrl.initList)
            }, $ctrl.getDefaultParams()));
        }

        function getAddNewForm() {
            var columns = [],
                eClassAttr = 'form-control with-underline ' + ($ctrl.pageClass || ''),
                itemTitle = $ctrl.getTitleSingular(),
                formGroupClass = 'field form-group font-general ' + ($ctrl.isPopup ? ' ' : 'font-general-12 margin-bottom-quarter');
            if (!$ctrl.hideFilledIn || $ctrl.hideFilledIn && !$ctrl.item.name) {
                columns.push({
                    type: $ctrl.SBFieldTypesService.PropTypes.Field,
                    prop: 'name',
                    tabIndex: 1,
                    tabNextIndex: 2,
                    placeholder: itemTitle + ' Name…',
                   // withInlineLabel: itemTitle,
                    eClassAttr: eClassAttr,
                    isRequired: true,
                    icon: 'pin',
                    name: 'name',
                    canEdit: true,
                    formGroupClass:  formGroupClass
                });
            }

            if (!$ctrl.hideFilledIn || $ctrl.hideFilledIn && !$ctrl.item.address) {
                columns.push({
                    type: $ctrl.SBFieldTypesService.PropTypes.Address,
                    prop: 'address',
                    tabIndex: 2,
                    tabNextIndex: 3,
                    placeholder: 'Shooting Location (optional)…',
                    eClassAttr: eClassAttr,
                    fieldClass: 'address',
                    icon: 'search',
                    name: 'Address',
                    canEdit: true,
                    formGroupClass: formGroupClass
                });
            }

            return $ctrl.SBFieldTypesService.getPopupSBForm($ctrl, columns, {
                onChange: $ctrl.onChange
            });
        }

        //todo reassess where to add these
        function onChange(result) {
            if(!result){
                console.log('onchange: result is undefined');
                return;
            }
            console.log('onchange');
            var selected = result.selected;
            if (selected) {
                var s = selected.field.split('.');
                if (s.length === 1) {
                    $ctrl.item[selected.field] = selected.val;
                } else if (s.length === 2) {
                    if (!$ctrl.item[s[0]]) {
                        $ctrl.item[s[0]] = {};
                    }
                    $ctrl.item[s[0]][s[1]] = selected.val;
                }
            }
            setEditFocus(result.tabNextIndex);
        }

        function setEditFocus(tabIndex) {
            if (tabIndex !== undefined) {
                $ctrl.broadcastRoot('SET_FIELD_FOCUS_' + tabIndex);
            }
        }

        function goToManage() {
            $ctrl.popupsService.teamAccess(function () {
                if ($ctrl.onClose) {
                    $ctrl.onClose({result: 'cancel'});
                }

                $ctrl.CPS.transitionTo('user.product.locations', $ctrl.CPS.currentProductPathParams());
            });
        }
    }
}

angular.module('sb.fields.popovers.assignStripInit.controller.service',[
