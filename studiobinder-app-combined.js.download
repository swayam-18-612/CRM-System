angular.module('user.commentsSidebar.inner.component',[
    'product.workflow.block.controller.service',
    'services.commentsSidebar',
    'sb.fields.popovers.assignCollaboratorsInline.component',
    'apiConstants.product.workflow.services'
])
.component('commentsSidebarInner', {
    controller: 'CommentsSidebarInnerCtrl',
    bindings: {
        isInModal: '@',
        selectedListStr: '<?',
        closeComments: '&'
    }
})
.controller('CommentsSidebarInnerCtrl', CommentsSidebarInnerCtrl);
CommentsSidebarInnerCtrl.$inject = ['CompInitCtrlService', 'CommentsSidebarService', 'WorkflowBlockCtrlService', 'TemplateCompileService', 'WorkflowConstantsService', '$element'];
function CommentsSidebarInnerCtrl(CompInitCtrlService, CommentsSidebarService, WorkflowBlockCtrlService, TemplateCompileService, constantsService, $element) {
    console.log('commentsSidebarInnerController');

    var $ctrl = this;
    $ctrl.CommentsSidebarService = CommentsSidebarService;

    $ctrl.toggleCommentsCls = 'aToggleCommentsFilter';
    $ctrl.toggleTabCls = 'aToggleTabComments';
    $ctrl.withoutGroupSorting = true;
    $ctrl.SidebarTypes = $ctrl.CommentsSidebarService.SidebarTypes;
    $ctrl.isCommentsSidebar = true;
    $ctrl.btnToggle = 'btnToggle';

    $ctrl.$onDestroy = $onDestroy;
    $ctrl = new CompInitCtrlService($ctrl, true);

    $ctrl.FiltersTasks = [
        {value: 0, text: 'All Tasks'},
        {value: 2, text: 'Completed Tasks'}
    ];
    $ctrl.changedFields = ['selectedListStr'];
    $ctrl.treeType = 6;
    $ctrl.treeTag = 'todo-cards'; //loads todoCardsSidebar
    $ctrl.info = {totalCount: 0};
    $ctrl.withoutUiOnParamsChanged = true;
    $ctrl.withoutCheatSheet = true;

    $ctrl.$initElement = $element;
    $ctrl.initElement = $ctrl.$initElement[0];

    $ctrl.getTreeFilters = getTreeFilters;


    $ctrl.$onInit = $onInit;
    $ctrl.$onChanges = $onChanges;

    $ctrl.getPageTemplate = getPageTemplate;

    function $onInit() {
        // people with comment privileges can add comments
        console.log('CommentsSidebarInnerCtrl.$onInit');
        $ctrl.canEdit = $ctrl.CPS.canEdit || $ctrl.CPS.canComment;

        getSelectedList();

        $ctrl.dontStartTreeWithAll = !$ctrl.isDashboard;
        var p = _.extend({
            isCurrentPage: false,
            tasksFilter: 2,//Completed:1 Uncompleted:2, All: 0
            dontStartTreeWithAll: $ctrl.dontStartTreeWithAll
        }, getExtraWorkflowParams());

        if(!$ctrl.productId){
            $ctrl.productId = $ctrl.uIdList && $ctrl.uIdList.currentProductId ? $ctrl.uIdList.currentProductId : $ctrl.CPS.productId;
        }
        $ctrl = new WorkflowBlockCtrlService($ctrl, constantsService, p);

        reload();
    }

    function reload() {
        if ($ctrl.fileComments) {// they have only comments and no tasks->materialview
            $ctrl.$element = $element;
            $ctrl.element = $ctrl.$element[0];
            $ctrl.loadPageGroup();
        } else {
            reloadTemplate();
        }
    }

    function getExtraWorkflowParams(){
        return {
            tabTasks: $ctrl.tabTasks,
            uId: $ctrl.uId,
            uIdList:  _.extend({}, $ctrl.uIdList, {currentItemLikes: null})
        };
    }

    function $onChanges(changes) {
        console.log('CommentsSidebarInnerCtrl.changes');
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i], change = changes[field];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                if (field === 'selectedListStr') {
                    console.log('selectedListStr');
                    getSelectedList();
                    //this happens when the tree list changes or type
                    updateInfo();
                    $ctrl.reloadWorkflow(getExtraWorkflowParams());
                }
                break;
            }
        }
    }

    function getSelectedList() {
        console.log('getSelectedList');
        var res = $ctrl.selectedListStr && $ctrl.selectedListStr !== '{}' ? JSON.parse($ctrl.selectedListStr) : null;
        if (res) {
            var pageInfo = res.pageInfo || {};
            $ctrl.isCalendarPage = pageInfo.isCalendarPage;
            $ctrl.isScriptPage = pageInfo.isScriptPage;
            $ctrl.isDashboard = pageInfo.isDashboard;
            $ctrl.isWorkflow = pageInfo.isWorkflow;
            $ctrl.todoPage = pageInfo.todoPage;
            $ctrl.sidebarType = res.sidebarType;
            $ctrl.uIdList = res.currentList;
            if ($ctrl.uIdList && Object.keys($ctrl.uIdList).length === 0) {
                $ctrl.uIdList = null;
            }
            $ctrl.uId = res.uId;
            $ctrl.uIdComment = res.uIdComment;

            $ctrl.fileComments = res.fileComments;
            $ctrl.pageHasTree = $ctrl.todoPage && $ctrl.todoPage.hasTree && !$ctrl.fileComments;
            console.log('selected list  : ' + $ctrl.uId);

            $ctrl.isLikeWorkflow = $ctrl.isWorkflow || $ctrl.isScriptPage;
            $ctrl.isPageShare = !$ctrl.CommentsSidebarService.isListLevel($ctrl.sidebarType);

            switch ($ctrl.sidebarType) {
                case $ctrl.SidebarTypes.PageComments:
                case $ctrl.SidebarTypes.ListComments:
                    $ctrl.tabTasks = 'comments';
                    $ctrl.tabTitle = 'Comments';
                    $ctrl.isCommentsTab = true;
                    break;

                case $ctrl.SidebarTypes.PageTasks:
                case $ctrl.SidebarTypes.ListTasks:
                    $ctrl.tabTasks = 'tasks';
                    $ctrl.tabTitle = 'Tasks';
                    $ctrl.isTasksTab = true;
                    break;

                case $ctrl.SidebarTypes.PageArchived:
                case $ctrl.SidebarTypes.ListArchived:
                    $ctrl.tabTasks = 'archived';
                    $ctrl.tabTitle = 'Archived';
                    $ctrl.isTasksTab = true;
                    break;

                case $ctrl.SidebarTypes.PageFilters:
                case $ctrl.SidebarTypes.ListFilters:
                    $ctrl.tabTasks = 'filters';
                    $ctrl.tabTitle = 'Filters';
                    $ctrl.isFiltersTab = true;
                    break;
            }
            //  $ctrl.tabTasks = ($ctrl.isLikeWorkflow || $ctrl.isCalendarPage) ? 'filters' : 'comments';

            $ctrl.hasSubtitle = $ctrl.isTasksTab || $ctrl.isCommentsTab && $ctrl.SidebarTypes.PageComments === $ctrl.sidebarType;
        }
    }

    function $onDestroy() {
        $ctrl.removeWatchers();

        bindFilters(true);

        bind(false, true);
        bind(false);
        if ($ctrl.onWorkflowBlockDestroy) {
            $ctrl.onWorkflowBlockDestroy();
        }
        if ($ctrl.initTemplateCompile) {
            $ctrl.initTemplateCompile.destroyNewScope();
        }
    }

    function getTreeFilters(item) {
        return (!$ctrl.isCommentsSidebar || $ctrl.isDashboard) ? true : $ctrl.todoPage && item._id === $ctrl.todoPage._id;
    }

    function reloadTemplate() {
        if (!$ctrl.initTemplateCompile) {
            $ctrl.initTemplateCompile = new TemplateCompileService($ctrl.$initElement, getInitTemplate, $ctrl);
        }
        $ctrl.initTemplateCompile.loadTemplate(onInitLoaded);
    }

    function onInitLoaded() {
        bind(true, true);
        $ctrl.element = $ctrl.initElement.querySelector('#divContent');
        $ctrl.$element = angular.element($ctrl.element);

        //update info
        updateInfo();
        bind(true);

        if ($ctrl.element) {
            $ctrl.loadPageGroup();
        }
    }

    function updateInfo() {
        setCommentsFilter($ctrl.tasksFilter);
        if ($ctrl.element) {
            setTabTask($ctrl.tabTasks);
            setListInfo($ctrl.uId);
        }
    }

    function setListInfo(val) {
        var el = $ctrl.initElement.querySelector(".tabtitle");
        if (el) {
            el.innerText = getTabTitle();
        }

        if($ctrl.hasSubtitle) {
            el = $ctrl.initElement.querySelector(".tabsubtitle");
            if (el) {
                el.innerText = getTabSubtitle();
            }
        }
    }

    function getTabTitle() {
        return $ctrl.LCS.convertHtmlToText($ctrl.isCommentsTab ? ($ctrl.uIdList && $ctrl.uIdList.name ? ('“' + $ctrl.uIdList.name + '”') : $ctrl.tabTitle) : $ctrl.tabTitle).trim();
    }

    function getTabSubtitle() {
        return 'for ' + $ctrl.todoPage.text;
    }

    function getInitTemplate() {
        console.log('commentsSidebarInner.getInitTemplate');
        var todoPage = $ctrl.todoPage || {},
            icon = todoPage.icon ? todoPage.icon : '',
            iconLevel = todoPage.iconLevel ? todoPage.iconLevel : 2,
            cls = $ctrl.canEdit ? 'smaller' : '';

        return '<div class="medium-template h-full ' + $ctrl.tabTasks + '-tab' + ($ctrl.hasSubtitle ? ' with-subtitle' : '') +'">' +
                    '<div class="top-part ' + cls + '">' +
                        '<div>' +
                            '<div class="titlesection full-width">' +
                                '<div class="title table-div full-width ' + ($ctrl.isCommentsTab && $ctrl.uIdList && $ctrl.uIdList.name ? 'small' : '') + '">' +
                                    (icon ? ('<div class="centered col30">' + $ctrl.LCS.getISBDiv(icon, iconLevel, 'colored icon sbf16') + '</div>') : '') +
                                    '<div class="tabtitle centered '+($ctrl.uIdComment ? 'uIdCommentName' : '')+'">' + getTabTitle() + '</div>' +
                                '</div>' +
    ($ctrl.hasSubtitle ? ('<div class="tabsubtitle full-width subtitle">' + getTabSubtitle() + '</div>') : '')+
                            '</div>' +
                            getTabs() +
                        '</div>' +
                        getFilters() +
                        '<div class="sidebar-toggle ' + $ctrl.btnToggle + '"><a>' + $ctrl.LCS.getISBDiv('closesidebar', 3, 'gray') + '</a></div>' +
                    '</div>' +
                    '<div class="with-fancy-scrollbar h-full withcards ' + cls + '">' +
                        '<div class="fancy-scrollbar sb-scrolling-monitor ultrathin vertical visible-scroll scrollable-content h-full">' +
                            '<div class="h-full">' + getContent() + '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>';

        function getContent() {
            if ($ctrl.isFiltersTab) {
                return '<calendar-filters class="h-full" product-id="::$ctrl.productId"></calendar-filters>';
            } else {
                $ctrl.commentSidebarId = $ctrl.todoPage && $ctrl.todoPage.parentUId&&$ctrl.uIdList ? $ctrl.uIdList[$ctrl.todoPage.parentUId] : $ctrl.uId;
                return '<div id="divContent" class="h-full">' +                                                             //on av script the collabs are for documentId not for the version
                    ($ctrl.isCommentsTab ? ('<sb-assign-collaborators-inline class="assign-collaborators-inline sb-hide clearfix" list="::$ctrl.uIdList" u-id="::$ctrl.commentSidebarId" is-page-share="::$ctrl.isPageShare" todo-page-id="'+$ctrl.todoPage._id+'"></sb-assign-collaborators-inline>') : '') +
                    '</div>';
            }
        }

        function getTabs() {
            switch ($ctrl.tabTasks) {
                case 'comments':
                    return '<div class="tabscontainer full-width"><ul class="subheader-tabs two short spacing-quarter-top">' +
                        '<li class="' + $ctrl.toggleTabCls + ' active" data-tasks="' + $ctrl.tabTasks + '"><a><span class="counter-text-comment"></span><span>' + $ctrl.tabTitle + '</span></a></li>' +
                        ($ctrl.isCommentsTab ? ('<li class="' + $ctrl.toggleTabCls + '" data-tasks="access"><a><span>Who has access</span></a></li>') : '') +
                        '</ul></div>';
            }
            return '';
        }
    }

    function getFilters() {
        var el, cls;

        switch ($ctrl.tabTasks) {
            case 'comments':
                cls = '';
                el = '<div class="' + $ctrl.toggleCommentsCls + '">' +
                    '<a class="inline-block" tooltip-placement="left"><div class="text inline-block"></div> ' + $ctrl.LCS.getISBDiv('check-bg', 2, 'pull-right with-margin-left gray') + '</a>' +
                    '</div>';
                break;

            case 'tasks':
//filter for tasks
                /*el = '<div class="pull-left" ng-if="!$ctrl.canEdit&&$ctrl.list.totalCount||$ctrl.canEdit">' +
                        '<sb-dropdown ' +
                        'drp-class-attr="drpTasksFilter" ' +
                        'without-close="true" ' +
                        'c-class-attr="hover-underline opendrp auto-width pull-right autoheight thinner font-small" ' +
                        'init-list="::$ctrl.FiltersTasks" ' +
                        'value="::$ctrl.tasksFilter" ' +
                        'on-change="$ctrl.changeFilter(result)" ' +
                        'field-class="selected-text text-right">' +
                        '</sb-dropdown>' +
                    '</div>';*/
                break;
        }

        return el ? ('<div class="filtersinfo full-width ' + (cls || '') + '">' + el + '</div>') : '';
    }

    function bind(isBind, first) {
        if (first) {
            set($ctrl.btnToggle, closeComments);
        } else {
            set($ctrl.toggleTabCls, toggleTabComments);
            set($ctrl.toggleCommentsCls, toggleCommentsFilter);
        }

        function set(cls, m) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.initElement.querySelectorAll('.' + cls), m);
        }
    }

    function setTabTask(val, oldVal, dontChangeOutside) {
        processEl(val, true);
        processEl(oldVal, false);

        setAccessTabOnCommentsBar();

        if (!dontChangeOutside) {
           var el = $ctrl.initElement.querySelector('.innercontainer');
            if (el) {
                var isComments = val === 'comments';
                $ctrl.LCS.replaceClass(el, isComments ? 'with-comments-only' : '', isComments ? '' : 'with-comments-only');
            }
        }

        function processEl(val, isAdd) {
            var el = $ctrl.initElement.querySelector("." + $ctrl.toggleTabCls + "[data-tasks='" + val + "']");
            if (el) {
                $ctrl.LCS[isAdd ? 'addClass' : 'removeClass'](el, 'active');
            }
        }

        function setAccessTabOnCommentsBar() {
            var isAccess = val === 'access';
            if (!$ctrl.commentsBar) {
                $ctrl.commentsBar = $ctrl.LCS.findClosestParent($ctrl.initElement, '#comments-bar');
            }
            if ($ctrl.commentsBar) {
                $ctrl.LCS[isAccess ? 'addClass' : 'removeClass']($ctrl.commentsBar, 'accesstab');
            }
        }
    }

    function setCommentsFilter(val) {
        var text = (val === 0 ? 'Hide' : 'Show') + ' Completed';//by def only uncompleted tasks are displayed 0 = all. when all set to hide
        var el = $ctrl.initElement.querySelector('.' + $ctrl.toggleCommentsCls + ' a');
        if (el) {
            //el.setAttribute('tooltip', text + ' completed comments');

            el = el.querySelector(".text");
            if (el) {
                el.innerHTML = text;
            }
        }
    }

    function toggleTabComments(e) {
        $ctrl.preventDefault(e);
        var target = e.target, tabTasks,
            el = $ctrl.LCS.findClosestParent(target, '.' + $ctrl.toggleTabCls);
        if (el) {
            tabTasks = el.dataset.tasks;
        }

        if (!$ctrl.commentsOption) {//init with the default
            $ctrl.commentsOption = $ctrl.tabTasks;
        }

        if ($ctrl.commentsOption !== tabTasks) {
            var isAccess = tabTasks === 'access',
                m = isAccess ? 'removeClass' : 'addClass';

            p('assignEl', '.assign-collaborators-inline', m);

            m = isAccess ? 'addClass' : 'removeClass';
            p('filtersinfo', '.filtersinfo', m);
            p('tab1', '.tab1', m);

            setTabTask(tabTasks, $ctrl.commentsOption, true);

            $ctrl.commentsOption = tabTasks;
            //if moving from comments to tasks. not when moving from comments to acccess
            //$ctrl.reloadWorkflow({tabTasks: tabTasks});
        }

        function p(el, cls, m) {
            $ctrl.LCS[m]($ctrl.initElement.querySelector(cls), 'sb-hide');
        }
    }

    function toggleCommentsFilter(e) {
        $ctrl.preventDefault(e);
        var val = $ctrl.tasksFilter === 0 ? 2 : 0;
        if ($ctrl.tasksFilter !== val) {
            setCommentsFilter(val);
            $ctrl.reloadWorkflow({tasksFilter: val});
        }
    }

    function closeComments(e) {
        console.log('closeComments');
        $ctrl.preventDefault(e);
        if ($ctrl.closeComments) {
            $ctrl.closeComments();
        }
    }

    function getPageTemplate() {
        console.log('load Comments sidebar inner');

        if (!$ctrl.isTasksAllLoaded) {
            return '<preloader-center class="preloader"></preloader-center>';
        }

        if($ctrl.fileComments){
            $ctrl.LCS.timeout(function (){
                setCommentsFilter($ctrl.tasksFilter);
                bindFilters(true);
            }, 0);
        }

        var tag = $ctrl.treeTag + '-sidebar';
        return ($ctrl.fileComments ? getFilters() : '') +
        '<' + tag + ' class="tab1 ' + tag + ' display-block clearfix h-full" ' + $ctrl.getSidebarAttributes() + '></' + tag + '>';

    }

    function bindFilters(isBind){
        $ctrl.LCS.bindElementsClick(true, $ctrl.initElement.querySelectorAll('.' + $ctrl.toggleCommentsCls), toggleCommentsFilter);
    }
}

angular.module('user.commentsSidebar.component',[
    'user.commentsSidebar.inner.component',
    'services.commentsSidebar',
    'user.dashboard.customize.component'
])
.component('commentsSidebar', {
    template: '<div id="comments-bar" class="board-menu hide-print"></div>',
    controller: 'CommentsSidebarCtrl'
})
.controller('CommentsSidebarCtrl', CommentsSidebarCtrl);
CommentsSidebarCtrl.$inject = ['TemplateCompileCompCtrlService', 'CommentsSidebarService', '$element'];
function CommentsSidebarCtrl(TemplateCompileCompCtrlService, CommentsSidebarService, $element) {
    console.log('CommentsSidebarCtrl');
    var $ctrl = this;

    $ctrl.CommentsSidebarService = CommentsSidebarService;
    $ctrl.dontAutoloadTemplate = true;

    $ctrl.btnToggle = 'btnToggle';
    $ctrl.newsCls = 'dashboard-news tasks-tab';
    $ctrl.SidebarTypes = $ctrl.CommentsSidebarService.SidebarTypes;

    $ctrl.closeComments = closeComments;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element.find('#comments-bar'));

    function preInit() {
        setShowComments($ctrl.CommentsSidebarService.getSidebarInfo(), true);
    }

    function postInit(){
        $ctrl.addRootWatcher('COMMENTS_SIDEBAR_UPDATED', onCommentsSidebarUpdated);
    }

    //info = {sidebarType currentList currentListId}
    function onCommentsSidebarUpdated(sidebarInfo){
        console.log('CommentsSidebarCtrl.onCommentsSidebarUpdated COMMENTS_SIDEBAR_UPDATED');
        setShowComments(sidebarInfo);
    }

    //close in cache
    function closeComments() {
        console.log('CommentsSidebarCtrl.closeComments');
        //$ctrl.broadcastRoot('COMMENTS_SIDEBAR_TOGGLE', {open: false, sidebarType: $ctrl.sidebarType});
        $ctrl.CommentsSidebarService.toggleComments($ctrl.componentId, $ctrl.sidebarType, false);
    }

    function onDestroy() {
        bind(false);
    }

    function getItemTemplate() {
        console.log('CommentsSidebarCtrl.getItemTemplate');
        if (!$ctrl.canShowSidebar) {
            return null;
        }

        return '<div class="board-menu-container with-transition h-full">' +
                    '<div class="board-menu-content h-full show-scrollbar-on-hover">' +
            ($ctrl.CPS.productId ? getSidebar() : getProductsSidebar()) +

//            (isDashboard() ? getProductsSidebar() : ($ctrl.CPS.productId ? getSidebar() : '')) +
                    '</div>' +
                '</div>';

        function getProductsSidebar() {
            var cls = 'isproducts smaller',
                title = 'Customize Homepage',
                tag  = 'customize-dashboard'; //sidebar-feed-blog
    return '<div class="'+$ctrl.newsCls+' medium-template innercontainer fancy-scrollbar ultrathin h-full" ng-class="{\'sb-hide\': !$ctrl.showComments}">' +
                '<div class="top-part ' + cls + '">' +
                    '<div class="table-div title">' +
                        '<div class="col30">' + $ctrl.LCS.getISBDiv('news', 2, 'icon-small gray') + '</div>' +
                        '<div>' + title + '</div>' +
                    '</div>' +
                    '<div class="'+$ctrl.btnToggle+' sidebar-toggle"><a>'+$ctrl.LCS.getISBDiv('closesidebar', 3, 'gray')+'</a></div>' +
                '</div>' +
                '<div class="with-fancy-scrollbar h-full withcards ' + cls + '">' +
                    '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full">' +
                        '<div class="h-full"><'+tag+' class="'+tag+'"></'+tag+'></div>' +
                    '</div>' +
                '</div>' +
            '</div>';
        }

        function getSidebar() {
            console.log('getSidebar: ' + $ctrl.selectedListStr);
            return '<comments-sidebar-inner ng-if="$ctrl.isReload===true" class="comments-sidebar-inner board-menu-content-frame h-full" selected-list-str="$ctrl.selectedListStr" close-comments="$ctrl.closeComments()"></comments-sidebar-inner>';
        }
    }

    function isDashboard() {
        return $ctrl.SBStateService.getCurrentStateName() !== 'user.dashboard';
    }

    function onLoaded() {
        bind(true);
    }

    function bind(isBind) {
        $ctrl.bindElementsClickBySelector(isBind, '.' + $ctrl.btnToggle, toggleSidebar);
    }

    function toggleSidebar(e) {
        console.log('CommentsSidebarCtrl.toggleSidebar');
        $ctrl.preventDefault(e);
        $ctrl.closeComments();
    }

    function setShowComments(sidebarInfo1, force) {
        console.log('CommentsSidebarCtrl.setShowComments: force=' + force);
        var sidebarInfo = _.extend({}, sidebarInfo1),
            exists = sidebarInfo && sidebarInfo.sidebarType,
            isOpen = sidebarInfo && sidebarInfo.isOpen === true;

        var pageInfo = getPageInfo(sidebarInfo);
        $ctrl.todoPage = pageInfo ? pageInfo.todoPage : null;
        $ctrl.canShowSidebar = pageInfo && pageInfo.canShowSidebar;

        //is selected and can show
        var showComments = isOpen && pageInfo.canShowSidebar,
            noSidebarComments = $ctrl.LCS.noSidebarComments();

        if ($ctrl.noSidebarComments === undefined || $ctrl.noSidebarComments !== noSidebarComments) {
            $ctrl.noSidebarComments = noSidebarComments;
        }

        if ($ctrl.showComments === undefined || $ctrl.showComments !== showComments) {
            var method = $ctrl.LCS [showComments ? 'addClass' : 'removeClass'];

            if (!$ctrl.boardWrapper) {
                $ctrl.boardWrapper = $ctrl.LCS.findClosestParent($ctrl.element, '.board-wrapper');
            }
            method($ctrl.boardWrapper, 'withCommentsSidebar');

            $ctrl.showComments = showComments;
        }

        $ctrl.LCS[$ctrl.noSidebarComments && $ctrl.showComments ? 'addClass' : 'removeClass']($ctrl.element, 'show-on-top');


        //reload if is news and was product
        if (exists) {
            if(showComments) {
                var x = 'sidebartype-';
                $ctrl.element.classList.forEach(function (el) {
                    if (el.indexOf(x) !== -1) {
                        $ctrl.LCS.replaceClass($ctrl.element, el, x +
                            $ctrl.CommentsSidebarService.getSidebarTypeName(sidebarInfo.sidebarType));
                    }
                });
            }
            //loads the comments-sidebar-inner or the news

            var prevSidebarType = $ctrl.sidebarInfo ? $ctrl.sidebarInfo.sidebarType : undefined,
                sidebarType = sidebarInfo.sidebarType,
                todoPage = getTodoPage(sidebarInfo),
                hasTree = todoPage && todoPage.hasTree;

            setSelectedListStr(sidebarInfo);

            if (force || sidebarType !== prevSidebarType &&
                (sidebarType === $ctrl.SidebarTypes.News || prevSidebarType) ||
                sidebarType === prevSidebarType && $ctrl.CommentsSidebarService.isListLevel(sidebarType) &&
                (!hasTree && $ctrl.sidebarInfo.uId !== sidebarInfo.uId ||
                  hasTree && $ctrl.sidebarInfo.uIdComment !== sidebarInfo.uIdComment)
            ) {
                $ctrl.sidebarInfo = sidebarInfo;
                $ctrl.sidebarType = sidebarInfo.sidebarType;
                bind(false);
                $ctrl.reloadTemplate();
            }
        }

        function getPageInfo(sidebarInfo){
            return sidebarInfo ? sidebarInfo.pageInfo : null;
        }

        function getTodoPage(sidebarInfo){
            var pageInfo = getPageInfo(sidebarInfo);
            return pageInfo ? pageInfo.todoPage : null;
        }

        function setSelectedListStr(sidebarInfo) {
            var isListLevel = $ctrl.CommentsSidebarService.isListLevel(sidebarInfo.sidebarType);
            var params = {
                currentList: isListLevel ? sidebarInfo.currentList : null,
                uId: isListLevel ? sidebarInfo.uId : null,
                uIdComment: isListLevel ? sidebarInfo.uIdComment : null,
                sidebarType: sidebarInfo ? sidebarInfo.sidebarType : null,
                pageInfo: getPageInfo(sidebarInfo)
            }

            var todoPage = getTodoPage(sidebarInfo);

            if(!hasTree && (isListLevel || !isListLevel && todoPage && todoPage.uId)){
                params.uId = sidebarInfo.uId;
            }

            //avscript has uIdComment and uId
            if(hasTree && isListLevel && todoPage && todoPage.uIdComment){
                params[todoPage.hasCommentGroups ? 'uIdComment' : 'uId'] = sidebarInfo.uIdComment;
            }

            var selectedListStr = JSON.stringify(params);
            /*//for screenplay   document breakdown calendar  page
            if(!$ctrl.uId && $ctrl.todoPage&& !$ctrl.todoPage.hasTree && $ctrl.todoPage.uId){
                $ctrl.uId = $ctrl.SBStateService.initStateParams[$ctrl.todoPage.uId];
            }
            if(!$ctrl.isPageShare && $ctrl.todoPage&&$ctrl.todoPage.uIdComment){
                $ctrl.uId = $ctrl.SBStateService.getSearchFilter([$ctrl.todoPage.uIdComment]);
            }*/
            //reloading workflow on onchanges doesnt seem to update the grid
            //hack to get it to reload
            if (selectedListStr !== $ctrl.selectedListStr) {
                $ctrl.isReload = false;
                $ctrl.LCS.timeout(function (){
                    $ctrl.selectedListStr = selectedListStr;
                    $ctrl.isReload = true;
                }, 0);
            }
        }
    }
}

angular.module('product.workflow.sidebar.component',[
    'product.workflow.sidebar.component.service'
])
.component('todoCardsSidebar', { 
    controller: 'TodoCardsSidebarCtrl',
    bindings: _.extend(getTreeSidebarInitParams(), {
        withAddColumn: '<',
        withSortable: '<',
        tabTasks: '<',
        getGroupBody: '&'
    }),
})
.controller('TodoCardsSidebarCtrl', TodoCardsSidebarCtrl);

TodoCardsSidebarCtrl.$inject = ['TodoCardsSidebarCtrlService',  '$element'];
function TodoCardsSidebarCtrl(TodoCardsSidebarCtrlService, $element) {
    var $ctrl = this;

    $ctrl.TodoCardsSidebarCtrlService = TodoCardsSidebarCtrlService;

    $ctrl.isCommentsSidebar = true;
    $ctrl.todoCardsScrollY = 220;
    $ctrl.fixParentName = '.board-menu-container';
    $ctrl.fixOffset = 145;

    $ctrl = new $ctrl.TodoCardsSidebarCtrlService($ctrl, $element);

}

angular.module('product.workflow.sidebar.component.service',[
    'user.calendar.filters.component',
    'services.commentsSidebar'
])
.service('TodoCardsSidebarCtrlService', TodoCardsSidebarCtrlService);

TodoCardsSidebarCtrlService.$inject = ['SidebarTreeCtrlService', 'CommentsSidebarService', 'TemplateCompileService', 'CompInitCtrlService'];
function TodoCardsSidebarCtrlService(SidebarTreeCtrlService, CommentsSidebarService, TemplateCompileService, CompInitCtrlService) {
    return function ($ctrl, $element){
        $ctrl.CommentsSidebarService = CommentsSidebarService;
        $ctrl.SidebarTreeCtrlService = SidebarTreeCtrlService;
        $ctrl.TemplateCompileService = TemplateCompileService;


        $ctrl.$onDestroy = $onDestroy;
        $ctrl = new CompInitCtrlService($ctrl, true);

        $ctrl.$element = $element;
        $ctrl.element = $ctrl.$element[0];

        $ctrl.rowLoadNow = true;
        $ctrl.editedCommentGroup = null;

        $ctrl.commentGroupIds = [];
        $ctrl.commentGroups = {};

        if(!$ctrl.$onInit) {
            $ctrl.$onInit = onInit;
        }

        $ctrl.onDestroy = onDestroy;
        $ctrl.onInit = onInit;

        //$ctrl.changedFields = ['compOptions'];
        //$ctrl.$onChanges = $onChanges;
        $ctrl.onUpdatedCount = onUpdatedCount;
        $ctrl.toggleEnterComment = toggleEnterComment;

        return $ctrl;

        function $onDestroy() {
            $ctrl.onDestroy();
        }

        function onInit() {
            getCardsOptions();
            console.log('TodoCardsSidebarCtrl: tabTasks: ' + $ctrl.tabTasks +'; tasksFilter: ' + $ctrl.tasksFilter);
            $ctrl.listTreeService.getSidebarTemplate = getSidebarTemplate;
            $ctrl.listTreeService.onSidebarLoaded = onSidebarLoaded;
            $ctrl.sortableGrid = 'sortableTreeGrid' + $ctrl.elemType;

            $ctrl = new $ctrl.SidebarTreeCtrlService($ctrl, $ctrl.$element);

            //  $ctrl.addRootWatcher('UPDATE_TOTAL_CARDS_COUNT', $ctrl.onUpdatedCount);
            /* if ($ctrl.canEdit) {
                $ctrl.addRootWatcher("UPDATED_TODOCOLUMN_COUNT", onTodoColumnCount);
            } */

            if($ctrl.tabTasks === 'archived' || $ctrl.tabTasks === 'comments') {
                $ctrl.addRootWatcher('RELOAD_ARCHIVED_TREE_GROUPS', reloadArchivedGroups);
            }

            if($ctrl.tabTasks === 'comments' && ($ctrl.todoPage && $ctrl.todoPage.hasCommentGroups)) {
                $ctrl.addRootWatcher('GROUP_COMMENTS_' + $ctrl.todoPage._id, onGroupComments);
                $ctrl.addRootWatcher('GROUP_COMMENTS_CLEAR_' + $ctrl.todoPage._id, onGroupCommentsClear);
                $ctrl.addRootWatcher('GROUP_COMMENTS_UPDATE_ORDER_' + $ctrl.todoPage._id, onGroupCommentsOrderChanged);

                $ctrl.addRootWatcher('COMMENTS_SIDEBAR_UPDATED', onCommentSidebarUpdated);
            }
        }

        function onGroupCommentsOrderChanged(items) {
            if (!$ctrl.commentGroupIds.length) {
                return;
            }

            _.each(items, function (item) {
                if(item && getCommentsGroupById(item._id)) {
                    $ctrl.commentGroups[item._id].order = item.order;
                }
            });
            sortCommentGroup();
            var delay = false;
            _.each($ctrl.commentGroupIds, function (id, i) {
                if(delay){
                    delay = false;
                    $ctrl.LCS.timeout(process, 210);
                } else {
                    process();
                }
                function process() {
                    var newPreviousId = i > 0 ? $ctrl.commentGroupIds[i - 1] : null;
                    var el = getGroupElById(id), previousId = null;
                    if (el) {
                        var sib = el.previousSibling;
                        previousId = sib ? sib.getAttribute('data-comment-group-id') : null;
                        if (previousId !== newPreviousId) { //needs update
                            var newPrevEl = getGroupElById(newPreviousId);
                            if (newPrevEl) {//add el after prev
                                newPrevEl.after(el);
                                delay = true;
                            }
                        }
                    }
                }
            });
        }

        function getGroupElById(id){
           return $ctrl.element.querySelector('.groups .tree-group[data-comment-group-id="' + id + '"]');
        }

        function onGroupCommentsClear(rowIds){
            console.log('onGroupCommentsClear');
            var l = rowIds ? rowIds.length : 0;
            if(l > 0) {
                for (var i = 0; i < l; i++) {
                    removeGroup(rowIds[i]);
                }
            }

            if(!$ctrl.commentGroupIds.length){
                var firstChild = $ctrl.element.firstChild,
                    child = $ctrl.LCS.createFragment(getEmpty(0, true));
                if(firstChild) {
                    $ctrl.element.insertBefore(child, firstChild);
                } else{
                    $ctrl.element.appendChild(child);
                }
            }

            function removeGroup(id){
                $ctrl.broadcastRoot('COMMENTS_GROUP_TOGGLE_' + id, {isShow: false, isRemoveGroup: true});
                removeCommentGroup(id);
            }
        }

        function toggleEnterComment(result){//{uIdComment, isShow}
            if(result && result.uIdComment) {
                closeEnterComments(result.uIdComment);
            }
        }

        function getCommentsGroupById(id){
            return $ctrl.commentGroups ? $ctrl.commentGroups[id] : null;
        }

        function removeCommentGroup(id){
            delete $ctrl.commentGroups[id];
            var i = findCommentGroupIndex(id);
            if(i >= 0)
                $ctrl.commentGroupIds.splice(i, 1);
        }

        function sortCommentGroup(){
            if(!$ctrl.commentGroupIds.length){return;}
            $ctrl.commentGroupIds = $ctrl.commentGroupIds.sort(function(a1, b1){
                var a = getCommentsGroupById(a1).order,
                    b = getCommentsGroupById(b1).order;
                return a > b ? 1 : (a < b ? -1 : 0);
            });
        }

        function findCommentGroupIndex(id){
            return _.findIndex($ctrl.commentGroupIds,function (el) {return id === el;});
        }

        function addCommentGroup(gr){
            if(!$ctrl.commentGroupIds){$ctrl.commentGroupIds = [];}
            $ctrl.commentGroupIds.push(gr._id);
            if(!$ctrl.commentGroups){
                $ctrl.commentGroups = {};
            }
            $ctrl.commentGroups[gr._id] = gr;
        }

        function onCommentSidebarUpdated(result){
            console.log('TodoCardsSidebarCtrl.onCommentSidebarUpdated COMMENTS_SIDEBAR_UPDATED');
                                        //CommentsLists
            if(result && result.sidebarType === 4) {
                $ctrl.currentCommentGroupId = null;
                $ctrl.LCS.removeClass($ctrl.LCS.$document[0].querySelector('.comments-sidebar-inner .comments-tab'), 'with-group-comment');

                if(result.isOpen){
                    closeEnterComments(null, {showAll: true});
                } else{
                    unsetSelectedRow();
                }
            }
        }

        function unsetSelectedRow(){
            var wrapper = $ctrl.LCS.$document[0].querySelector('.avscript-group');
            if(wrapper) {
                $ctrl.LCS.removeClass(wrapper.querySelectorAll('.row-scheduleTemp .sb-click-viewComments.selected'), 'selected');
            }
        }

        function onGroupComments(item) {
            console.log('onGroupComments');
            if ($ctrl.isProcessingGroup || !item) {
                return;
            }

            $ctrl.isProcessingGroup = true;

            var id = item._id;

            //remove all comment groups
            closeEnterComments(null, {exceptId: id});

            unsetSelectedRow();


            var gr = getCommentsGroupById(id);

            if (!gr) {
                addCommentGroup({_id:id, nodes: [], count: 0, list: item, order: item.order});
                sortCommentGroup();

                if (!$ctrl.groupCompile) {
                    $ctrl.groupCompile = new $ctrl.TemplateCompileService(null);
                    $ctrl.groupCompile.keepChildren = true;
                }

                var index = findCommentGroupIndex(id);
                $ctrl.groupCompile.insertAfterChild = index > 0 ? getGroupElById($ctrl.commentGroupIds[index - 1]) : (index === 0 ? 'inFront' : null);

                if (!$ctrl.groupsEl) {
                    $ctrl.groupsEl = $ctrl.element.querySelector('.groups');
                }

                $ctrl.groupCompile.loadTemplate(onGroupCompileLoaded, $ctrl, $ctrl.groupsEl, getGroup(id, true));
            }
            else {
                var el = $ctrl.element.querySelector('.groups .tree-group[data-comment-group-id="' + id + '"] .todo-column-title');
                if (el) {
                    var scroller = $ctrl.LCS.findClosestParent($ctrl.element, '.fancy-scrollbar'),
                        offsetPosition = el.getBoundingClientRect().top + scroller.pageYOffset - 150,
                        wrapperScroll = {behavior: "smooth", top: offsetPosition, left: 0},
                        elScroll = {
                            behavior: "smooth",
                            block: "center",
                            inline: "center",
                        };

                    if (seamless) {
                        if (scroller) {
                            seamless.scrollBy(scroller, wrapperScroll);
                        }
                        seamless.scrollIntoView(el, elScroll);
                    } else {
                        if (scroller) {
                            scroller.scrollTo(wrapperScroll);
                        }
                        el.scrollIntoView(elScroll);
                    }
                }

                onFinally();
            }

            function onGroupCompileLoaded() {
                console.log('onGroupAdded');
                $ctrl.LCS.removeClass($ctrl.groupsEl, 'count-*');
                var l = $ctrl.commentGroupIds.length;
                $ctrl.LCS.addClass($ctrl.groupsEl, 'count-' + l);
                if (l) {
                    removeEmptyState();
                } else {
                    //add empty state???
                }

                onFinally();
            }

            function onFinally() {
                $ctrl.currentCommentGroupId = id;
                if ($ctrl.canEdit) {
                    $ctrl.enterCommentId = id;
                    //toggleCommentEnter($ctrl.enterCommentId, true);
                    $ctrl.broadcastRoot('COMMENTS_GROUP_TOGGLE_' + $ctrl.enterCommentId, {isShow: true});
                }

                $ctrl.isProcessingGroup = false;
            }
        }

        function closeEnterComments(id, other) {
            if (!$ctrl.canEdit) {
                return;
            }
            if(other && other.showAll){
                unsetSelectedRow();
            }
            //close the prev;
            for (var i = $ctrl.commentGroupIds.length - 1; i >= 0; i--) {
                var gId = $ctrl.commentGroupIds[i];
                if (other || !id || id && gId !== id) {
                    var gEl = getGroupElById(gId);
                    if (gEl) {
                        if(other){
                           $ctrl.LCS[(gId === other.exceptId || other.showAll) ? 'removeClass' : 'addClass'](gEl, 'sb-hide');
                        }

                        var comments = gEl.querySelectorAll('.flex-wrap .taskcard-item-grid');
                        if (comments && comments.length > 0) {
                            toggleCommentEnter(gId, false);
                        } else {// remove group element cause has no comments.
                            $ctrl.broadcastRoot('COMMENTS_GROUP_TOGGLE_' + gId, {isShow: false});
                            removeCommentGroup(gId);
                        }
                    }
                }
            }
        }

        function toggleCommentEnter(id, v) {
            if (id) {
                $ctrl.broadcastRoot('TOGGLE_COMMENT_ENTER_' + id, v);
            }
        }

        function removeEmptyState(){
            var el = $ctrl.element.querySelector('.todono');
            if (el) {
                $ctrl.LCS.removeElement(el);
            }
        }

        function reloadArchivedGroups(){
            $ctrl.reloadTree();
        }

        function $onChanges(changes) {
            console.log(changes);
            if (!changes) {
                return;
            }

            for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
                var field = $ctrl.changedFields[i];
                var change = changes[field];
                if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                    if(field ==='compOptions'){
                        getCardsOptions();
                    }
                    break;
                }
            }
        }

        function onDestroy() {
            bind(false);
            $ctrl.removeWatchers();
            if($ctrl.onListTreeInitDestroy){
                $ctrl.onListTreeInitDestroy();
            }
        }

        function getCardsOptions() {
            var opts;
            try{
                opts = JSON.parse($ctrl.compOptions);
            }catch(e){}
            if(opts)  {
                $ctrl = _.extend($ctrl, opts);
            }
        }

        function onSidebarLoaded() {
            bind(true);
        }

        function getSidebarTemplate(isInTreeModal, canEdit) {
            bind(false);
            $ctrl.reloadTreeGroups();
            try {
                var tree = $ctrl.listTreeService.getTree($ctrl.treeType, $ctrl.selectedFilter)[0];
                if (tree) {
                    $ctrl.treeNodes = tree.nodes;
                }
            } catch (e) {
            }

            var count = 0,
                //could be in popup for material-viewer
                hasCommentGroups = $ctrl.treeNodes && $ctrl.todoPage && $ctrl.todoPage.hasCommentGroups && !($ctrl.isInModal && $ctrl.LCS.findClosestParent($ctrl.element, '.material-viewer')),
                dontShowAllGroups = hasCommentGroups,
                groups = dontShowAllGroups ? [] : getGroups(),
                hasColumns = groups && groups.length > 0,
                hasTasksInstr = $ctrl.tabTasks === 'tasks' && !hasColumns && $ctrl.CPS.isAuthenticated,
                groupsContent = getGroupsContent(),//needs to load first
                hasEmpty = (!hasColumns || !count) && $ctrl.isDashboard || hasCommentGroups && (!groups || !groups.length);

            //get all els count
            return (hasEmpty ? getEmpty(count, hasCommentGroups, hasTasksInstr) : '') +
                   '<div class="groups count-' + count + '">' + groupsContent + '</div>';

            function getGroups() {
                if (hasCommentGroups) {
                    var items = $ctrl.listTreeService.onInitLists($ctrl.treeNodes[0]);
                    if(items) {
                        var gr = _.groupBy(items, 'uIdComment');
                        if (gr){
                            for(var id in gr){
                                var nodes = gr[id],
                                list = loadCommentsGroupById(id);
                                addCommentGroup({_id: id, nodes: nodes, count: nodes ? nodes.length : 0, list: list, order: list ? list.order : 0});
                            }
                        }

                        sortCommentGroup();
                    }
                    return $ctrl.commentGroupIds;
                }

                return $ctrl.treeNodes;
            }

            function getGroupsContent() {
                var el = '';
                if (hasColumns) {
                    _.each(groups, function (c1, i) {
                        var c = hasCommentGroups ? getCommentsGroupById(c1) : c1;
                        if (c.count > 0 || !c.count && !$ctrl.isDashboard && $ctrl.canEdit) {
                            count += 1;
                            el += getGroup( hasCommentGroups ? c._id : i);
                        }
                    });
                }
                return el;
            }
        }

        function getEmpty(count, hasCommentGroups, hasTasksInstr) {
            return '<div class="todono h-full table-div text-center">' +
                        '<div class="centered text-center h-full">' +
                            '<div class="big">' + $ctrl.LCS.getISBDiv($ctrl.tabTasks === 'tasks' ? 'taskbar' : 'conversations', 2, 'sbf30') + '</div>'+
                        (count ? '' :
                            ('<h3 class="text-center">' +
        (hasCommentGroups ? ($ctrl.canComment ?
                ('Row Comments') : ('No comments have been added yet')
                            ) :
                            ('All project ' + $ctrl.tabTasks + '<br/> will aggregate here')) +
                            '</h3>')
                        ) +
                            ($ctrl.canEdit ?
                                (hasTasksInstr ? ('<h3 class="text-center">Add columns to your project.</h3>' +
                                    '<a id="manageColumns" class="edit-profile btn btn-small transparent">' + $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left') + ' Manage Columns</a>') :
                                    (hasCommentGroups ? ('<p class="text-center centered" style="max-width:250px">To add a new comment, click the comment button on a specific row.</p>') : '')
                                ) : '') +
                        '</div>' +
                    '</div>';
        }

        function loadCommentsGroupById(id){
            var n = $ctrl.CurrentTreeListService.CommentsSidebarService.nonSidebarPreLoadingService;
            return n && n.parentRel ? n.getById(n.TblTypes[n.parentRel.child], id) : null;
        }

        /*hasCommentGroups ? index : id;  id has format '"id"'*/
        function getGroup(id, showEnterComment){
            var hasCommentGroups = $ctrl.todoPage ? $ctrl.todoPage.hasCommentGroups : false,
                other = {
                    'can-edit': '"::$ctrl.canEdit"',
                    'current-list': '"::$ctrl.treeNodes[' + (hasCommentGroups ? '0' : id) + ']"'
                };

            if(getCommentsGroupById(id)){
                other = _.extend(other, {
                    'comment-group':'"::$ctrl.commentGroups[' + (hasCommentGroups ? ('\'' + id + '\'') : id) + ']"',
                    'data-comment-group-id': '"' + id + '"',
                    'toggle-enter-comment': '"$ctrl.toggleEnterComment(result)"'
                }, showEnterComment ?{
                    'show-enter-comment': '"true"'
                } : null);
            }

            if ($ctrl.isInModal) {
                other['is-in-modal'] = '"true"';
            }

            //   'show-new="$ctrl.selectedFilter" ' +
            //   'total-count="$ctrl.filteredLists[i].totalCount" ' +

            return $ctrl.getGroupBody({result: {other: other}});
        }

        function bind(isBind) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('#manageColumns'), manageColumns, 'manage-columns');
        }

        function manageColumns(e){
            $ctrl.preventDefault(e);
            var stateName = 'user.product.workflow';//'user.taskBoards'
            $ctrl.CPS.transitionTo(stateName, $ctrl.CPS.currentProductPathParams());
        }

        function onUpdatedCount(totalCount) {
            if (totalCount) {
                $ctrl.info.totalCount += totalCount;
            }
        }
    }
}

angular.module('product.workflow.tree.item.new.component', [
    'product.workflow.list.tree.item.grid.controller.service'
])

.component('addTodoColumn', {
    bindings: {
        service: '<',
        getItem: '&',
        onSaved: '&',
        onCanceled: '&',
        doesntExistName: '&',
        type: '<',
    },
    controller: 'AddTodoColumnCtrl',
})
.controller('AddTodoColumnCtrl',AddTodoColumnCtrl);
AddTodoColumnCtrl.$inject = ['ListItemTemplateFormCtrlService', 'TaskcardTreeItemGridCtrlService', '$element'];
function AddTodoColumnCtrl(ListItemTemplateFormCtrlService, TaskcardTreeItemGridCtrlService, $element) {
//to do  TaskcardTreeItemGridCtrlService must inherit template

    console.log('AddTodoColumnCtrl')

    var $ctrl = this;

    $ctrl = new TaskcardTreeItemGridCtrlService($ctrl);

    $ctrl.isNew = true;
    $ctrl.dontNotify = true;

    $ctrl.dontAutoloadTemplate = false;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitOther = preInitOther;
    $ctrl.postInitOther = postInitOther;
    $ctrl.selectColor = selectColor;

    $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

    function preInitOther() {
        $ctrl.extraParam = {service: $ctrl.service};
        $ctrl.item = $ctrl.getItem();
    }

    function postInitOther(){
        $ctrl.saveItem = saveItem;
        $ctrl.onSave = onSave;
    }

    function getItemTemplate() {
     return '<form class="lane-wrapper full-width" name="$ctrl.formHolderItem[$ctrl.formName]" novalidate autocomplete="off">' +
                 '<div class="swimlane-header">' +
                    $ctrl.LCS.getErrorBlock() +
         '<div class="swimlane-top-border" ng-style="{\'background-color\': $ctrl.item.color}"></div>' +
         '<div class="swimlane-title clearfix thinner">' +
                        '<input placeholder="Column Name…" class="form-control hover-underline name" type="text" id="name" name="name" ng-model="$ctrl.item.name" required>' +
                        '<input type="text" class="focused">' +
                        '<div ng-show="($ctrl.formHolderItem.formItem.name.$dirty||$ctrl.formHolderItem[\'formItem_attempted\'])&&$ctrl.formHolderItem.formItem.name.$error.required" class="help-inline ng-hide">Column Name is required.</div>' +
                    '</div>' +
         getColorsFormOther() +
                    '<div>' +
                        '<button class="btn btn-primary '+$ctrl.getBtnActionCls()+'" type="submit" data-type="saveItem" analytics-on analytics-action="Save TodoColumn" ng-disabled="$ctrl.isUpdating||!$ctrl.formHolderItem.formItem.$valid"> <span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Add</button>' +
                        '<button class="btn btn-primary transparent gray4 with-margin-left '+$ctrl.getBtnActionCls()+'" type="button" data-type="onCanceled">Cancel</button>' +
                    '</div>' +
                '</div>' +
            '</form>';
    }

    function saveItem() {
        $ctrl.error = null;
        var doesntexists = $ctrl.doesntExistName({name: $ctrl.item.name});

        if (doesntexists) {
            $ctrl.save();
        } else {
            $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.columns.duplicate.error');
        }
    }

    function onSave(result) {
        $ctrl.onSaved({result: result});
    }

    function getColorsFormOther( ) {
        var el = '';
        //'<label class="header thin clearfix margin-top-30">Board Color</label>' +
        _.each($ctrl.colors, get);
        return '<div class="custom-wrapper colors-wrapper circled">' + el + '</div>';

        function get(c) {
            el += '<div class="custom-checkbox inrow ' + $ctrl.pageClass + '">' +
                '<div class="' + $ctrl.getBtnActionCls() + ' customitem" style="background-color:' + c + '" data-type="selectColor" data-info="' + c + '"><label><input type="checkbox"' + (isSelectedColor(c) ? ' checked="checked"' : '') + '><span></span><span></span></label></div>' +
                '</div>';
        }
    }

    function isSelectedColor(c) {
        return $ctrl.item.color === c;
    }

    function selectColor(c) {
        $ctrl.prevColor = $ctrl.item.color;
        if (!$ctrl.prevColor || $ctrl.prevColor && $ctrl.prevColor !== c) {
            $ctrl.item.color = c;
            set($ctrl.prevColor, false);
            set(c, true);
        }

        function set(id, isChecked) {
            if (!id) {
                return;
            }
            var check = $ctrl.element.querySelector('.custom-wrapper.colors-wrapper .customitem[data-info="' + id + '"] input');
            if (isChecked) {
                check.setAttribute('checked', 'checked');
            } else {
                check.removeAttribute('checked');
            }
        }
    }
}

