ue;}})(navigator.userAgent||navigator.vendor||window.opera);
        return check;
    }
    var isMobile = mobilecheck();
    var options = {
        animation: false,
       //trigger: 'click' //comment out to use mouseover trigger
    };
    if (isMobile){options.trigger = 'dontTrigger';} // default dummy trigger event to show tooltips
    $tooltipProvider.options(options);
}


