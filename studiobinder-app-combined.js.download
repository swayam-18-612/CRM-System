angular.module('user.loggedHeader.component', [
    'services.layoutConfigsService',
    'user.loggedSidebar.component',
    'user.companySelector'
])
.component('loggedHeader', {
    template: '<nav class="navbar navbar-fixed-top navbar-default icons-only">' +
                '<div class="navbar-inner">' +
                    '<div id="sidebar-nav" class="show-scrollbar-on-hover">' +
                        '<ul class="nav navbar-nav logged icons-only" id="topnav">' +
                            '<li class="top-logo">' +
                                '<a class="logo with-no-padding" href="{{::$ctrl.dashboardHref()}}"><div class="navbar-brand gradient-linear-accent"><div class="logoTopLoggedIn with-bg-image"></div></div></a>' +
                            '</li>' +
                        '</ul>' +
                        '<div class="toggle-sidebar table-div">' +
                            '<mobile-toggle class="table-cell centered" div-class="centered" a-class="toggle-s dd3-handle btn btn-small transparent2" window-width="$ctrl.windowWidth"></mobile-toggle>' +
                        '</div>' +
                        '<logged-sidebar class="logged-sidebar" is-mobile-opened="$ctrl.isMobileOpened" window-height="$ctrl.windowHeight" window-width="$ctrl.windowWidth" info-str="$ctrl.infoStr" load-menu="$ctrl.loadMenu"></logged-sidebar>' +
                    '</div>' +
                '</div>' +
            '</nav>',
    controller: 'LoggedHeaderCtrl',
    bindings: {
        isMobileOpened: '<?',
        windowWidth: '<?',
        windowHeight: '<?',

        infoStr: '<?',

        loadMenu:'<?'
    }
})
.controller('LoggedHeaderCtrl', LoggedHeaderCtrl);
LoggedHeaderCtrl.$inject = ['$element', 'CPS'];
function LoggedHeaderCtrl($element, CPS) {
    //console.log('LoggedHeaderCtrl');
    var $ctrl = this;
    $ctrl.CPS = CPS;
    $ctrl.LCS = CPS.LCS;
    $ctrl.security = CPS.security;
    $ctrl.SBStateService = CPS.SBStateService;
    //private
    $ctrl.changedFields = ['isMobileOpened', 'windowWidth'];

    $ctrl.dashboardHref = dashboardHref;

    $ctrl.$onInit = $onInit;
    $ctrl.$onChanges = $onChanges;

    function $onInit() {
        $ctrl.element = $element[0];
        $ctrl.navbar = $ctrl.element.querySelector('.navbar');
        $ctrl.sidebar = $ctrl.element.querySelector('.toggle-sidebar');
        setClass();
    }

    function $onChanges(changes) {
       // console.log(changes);
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                setClass();
                break;
            }
        }
    }

    function setClass() {
        var isSmallW = $ctrl.LCS._noSidebarGray($ctrl.windowWidth);
        var opened = $ctrl.isMobileOpened && isSmallW;

        $ctrl.LCS[opened ? 'addClass' : 'removeClass']($ctrl.navbar, 'opened');

        if (!isSmallW || $ctrl.isMobileOpened) {
            $ctrl.LCS.replaceClass($ctrl.sidebar, 'indent', 'outdent');
        } else {
            $ctrl.LCS.replaceClass($ctrl.sidebar, 'outdent', 'indent');
        }
    }

    function dashboardHref() {
        return getHref('user.dashboard');
    }

    function getHref(state) {
        return $ctrl.SBStateService.getStateHref(state, $ctrl.security.currentPathParams());
    }
}

angular.module('user.loggedSidebar.component', [
    'user.calendar.topNav.service',
    'services.stateService',
    'services.layoutConfigsService',
    'services.sidebarConfigService'
])
.component('loggedSidebar', {
    controller: 'LoggedSidebarCtrl',
    bindings: {
        isMobileOpened: '<?',
        windowWidth: '<?',
        windowHeight: '<?',
        infoStr: '<?',
        loadMenu:'<?'
    }
})
.controller('LoggedSidebarCtrl', LoggedSidebarCtrl);

LoggedSidebarCtrl.$inject = ['BlocksSetupService','TemplateCompileService', 'CPS', 'SidebarConfigService', '$element'];
function LoggedSidebarCtrl(BlocksSetupService, TemplateCompileService, CPS, SidebarConfigService, $element) {
    console.log('LoggedSidebarCtrl');
    var $ctrl = this;
    $ctrl.BlocksSetupService = BlocksSetupService;
    $ctrl.SidebarConfigService = SidebarConfigService;
    $ctrl.RootEventsService = SidebarConfigService.RootEventsService;

    $ctrl.CPS = CPS;
    $ctrl.LCS = CPS.LCS;
    $ctrl.SessionService = CPS.SessionService;
    $ctrl.CurrentProduct = CPS.CurrentProduct;
    $ctrl.SBStateService = CPS.SBStateService;
    $ctrl.security = CPS.security;

    $ctrl.projectImgId = 'projectImgWrapper';

    $ctrl.$element = $element;
    $ctrl.element = $ctrl.$element[0];

    $ctrl.setMainSideBar = setMainSideBar;

    var isSB = $ctrl.LCS.isSB;

    $ctrl.compileTemplate = new TemplateCompileService($ctrl.$element);

    $ctrl.isProcessing = false;
    $ctrl.watchers = [];

    $ctrl.changedFields = [ 'windowWidth', 'windowHeight', 'isMobileOpened', 'infoStr', 'loadMenu'];

    $ctrl.$onInit = $onInit;
    $ctrl.$onChanges = $onChanges;
    $ctrl.$onDestroy = $onDestroy;

    $ctrl.loadSideNavMenuContent = loadSideNavMenuContent;

    function $onInit() {
        load();

        $ctrl.RootEventsService.addRootWatcher($ctrl.watchers, 'IMAGE_UPLOADED', onImageUploaded);
        $ctrl.RootEventsService.addRootWatcherSimple($ctrl.watchers, $ctrl.SidebarConfigService.onUpdateSidebar(load));
    }

    function $onChanges(changes) {
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i],
                change = changes[field];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                if(field === 'infoStr'){
                    $ctrl = $.extend($ctrl, $ctrl.infoStr ? JSON.parse($ctrl.infoStr) : {});
                }
                $ctrl.SidebarConfigService.processSidebar($ctrl.loadSideNavMenuContent);
                break;
            }
        }
    }

    function load() {
        $ctrl = $.extend($ctrl, $ctrl.infoStr ? JSON.parse($ctrl.infoStr) : {});
        $ctrl.SidebarConfigService.load($ctrl.loadSideNavMenuContent);
    }

    function onImageUploaded(result) {
        if(!$ctrl.product || !result){return;}
        var id = result && result.item ? result.item._id : null;
        if (id && $ctrl.product._id === id) {
            $ctrl.product.getUpdatedImageProps(result.updatedImage);

            var wr = $ctrl.element.querySelector('#' + $ctrl.projectImgId);
            if (wr) {
                $ctrl.LCS.removeElementChild(wr, '.featured-image' );
                $ctrl.LCS.removeElementChild(wr, '.avatar' );
                $ctrl.LCS.appendChildFragment(wr, getProjectImg());
            }
        }
    }

    function getProjectImg() {
        return $ctrl.security.getImage($ctrl.product, $ctrl.genprops.isSmallW ? 'intermedium' : 'smaller', 'logo', 200, {
            id: $ctrl.projectImgId,
            withSquareImg: true,
            imgClass: 'centering ' + ($ctrl.genprops.isSmallW ? 'roundborder' : ''),
            avatar: 'project',
            iconPaths: $ctrl.LCS.getISBPath(2)
        });
    }

    function loadSideNavMenuContent() {
        //console.log('loadSideNavMenuContent');
        if ($ctrl.isProcessing) {
            return false;
        }
        $ctrl.isProcessing = true;

        var params = $ctrl.security.currentPathParams();
        $ctrl.compileTemplate.getItemTemplate = getContent;
        $ctrl.compileTemplate.loadTemplate(function () {
            //element.removeClass($ctrl.sceneParent, 'sceneEditor');

        }, $ctrl);

        $ctrl.isProcessing = false;

        function getContent() {
            var sidebarClass = getUlClass(),
                credentialsMenu = getCredentials(isSB),
                bottomMenu = getBottomMenu(),
                line = "<li style='border-bottom: 1px solid rgba(0,0,0,0.15)'></li>",
                product = $ctrl.CurrentProduct.getProduct(),
                content;
            if ($ctrl.isAuthenticated) {
                var isProduct = $ctrl.productId !== null && $ctrl.productId !== undefined;
                $ctrl.user = $ctrl.SessionService.getSetting('user');

                if (isProduct) {
                    if (!product) {
                        return;
                    }
                    $ctrl.product = product;
                    var blocks = $ctrl.BlocksSetupService.getProductSidebarBlocks(product, processItem);
                    content = getTopMenu() + blocks.o + bottomMenu + (blocks.c ? line : '') + blocks.c + credentialsMenu;
                } else {
                    $ctrl.product = null;
                    content = getUserMenu() +
                        //todo dont load the configs
                        //getMenu($ctrl.SidebarConfigService.devSetup, 'Customize') +
                        credentialsMenu;
                }
            } else {
                $ctrl.user = null;
                $ctrl.user = null;
                $ctrl.product = product;
                content = '';
            }

            return "<ul id='bottomnav' class='" + sidebarClass + "'>" + content + "</ul>";
        }

        function processItem(item, ch, overviewBlockIds) {
            var html = '', j, isProduct = true;
            if (item && !item.isComingSoon) {
                var chl = ch && ch.length > 0 ? ch.length : 0,
                    hasCh = chl > 0;

                var html1 = '', count = 0,
                    urls = [getType(item.url, true)];
                if (hasCh) {
                    for (j = 0; j < chl; j++) {
                        var item1 = ch[j];
                        if (item1.parentNavId === item._id && !item1.isComingSoon && overviewBlockIds.indexOf(item1._id) !== -1) {
                            var sub = getSubItem(_.extend({}, item1, {
                                active: item1.isCustom && $ctrl.SBStateService.hasState([getType(item1.url, isProduct)])
                            }), isProduct)
                            html1 += sub.li;
                            //todo see for custom urls
                            urls.push(sub.url);
                            count++;
                        }
                    }
                    var top = 0;
                    switch (count) {
                        case 1:
                            top = 14;
                            break;
                        case 2:
                            top = 39;
                            break;
                        case 3:
                            top = 64;
                            break;
                        case 4:
                            top = 85;
                            break;
                        case 5:
                            top = 113;
                            break;
                        case 6:
                            top = 136;
                            break;
                        default:
                            top = 122;
                            break;
                    }
                    html1 = "<div dropdown-menu class='sub-menu fadeInUpRight scheduling " + item.name.toLowerCase() + "'  role='menu' aria-labelledby='btn" + item._id + "' style='top:-" + top + "px'><ul>" + html1 + "</ul></div>";
                }

                html += '<li ' + (hasCh ? 'dropdown' : '') +
                    ' class="tooltip-gray one-line-tooltip dropdown-toggle ' + getActiveClass(urls) +
                    (hasCh ? ' dropdown ' : '') + '" ' +
                    //todo figureout
                    //(item.isCustom ? '' : 'ng-class="{\'active\':getActiveClass('+item.urls+', true)}"') +
                    '>';
                html += "<a ";
                if (count > 0) {
                    html += "dropdown-toggle preventdefault='true' id='btn" + item._id + "' ";
                } else {
                    html += " tooltip='" + ($ctrl.genprops.isSmallW ? '' : item.name) + "' tooltip-placement='right' ";
                }
                html += " class='top-item' href='" + getUrl(item, true) + "' " +
                    "ng-click='$ctrl.setMainSideBar($event, true)' analytics-on analytics-action='" + item.name + "'>" +
                    getIcon(item.icon, item.iconLevel, (item.shortName || item.name)) + "</a>";
                if (count > 0) {
                    html += html1;
                }
                html += "</li>";
            }
            return html;
        }

        function onClick(name){
           //return "ng-click='$ctrl.setMainSideBar($event, true)' analytics-on analytics-action='" + item.name + "'
        }

        function getUlClass() {
            //console.log('w:' + $ctrl.windowWidth + ';h: ' + $ctrl.windowHeight + "; isMobileOpened: " + $ctrl.isMobileOpened);
            $ctrl.genprops = {
                isSmallW: $ctrl.LCS._noSidebarGray($ctrl.windowWidth),
                isSmallH: $ctrl.windowHeight < 716,
                isMobileOpened: $ctrl.isMobileOpened
            };
            var def = 'nav navbar-nav logged sideBar spacing-half-top';

            if($ctrl.genprops.isSmallW && $ctrl.isMobileOpened) {
                $ctrl.LCS.replaceClass($ctrl.element, 'collapseOut', 'collapseIn');
            }else{
                $ctrl.LCS.replaceClass($ctrl.element, 'collapseIn', 'collapseOut');
            }

            return def + ' ' +
                ($ctrl.genprops.isSmallW ? ($ctrl.isMobileOpened ? 'collapseIn fancy-scrollbar ultrathin' : 'collapseOut') : '') + " " +
                ($ctrl.genprops.isSmallW ? 'small-bar' : 'icons-only') + " ";
        }

        function getUrl(item, isProduct) {
            if (!item.url) {
                return '';
            }
            if (item.isCustom || item.url.indexOf('http') === 0) {
                return item.url;
            }

            var r = item.url.split('/'), p = null;
            if (r.length > 1) {
                var p1 = r[1].split(':');
                p[p1[0]] = p1[1];
            }
            return getHref(getType(r[0], isProduct), isProduct, p);
            //$ctrl.SBStateService.getStateHref('user.product.' + r[0], $ctrl.security.currentPathParams(p));
        }

        function getTopMenu() {
            var productOverview = getType('overview', true);
        return "<li class='tooltip-gray one-line-tooltip'>" +getMobileToggle() +  "</li>" +
                "<li class='picture tooltip-gray one-line-tooltip " + getActiveClass(productOverview) + "'>" +
                    "<a class='top-item' href='" + getHref(productOverview, true) + "' ng-click='$ctrl.setMainSideBar($event, true)' analytics-on analytics-action='Overview' " + ($ctrl.genprops.isSmallW ? '' : " tooltip='Overview' tooltip-placement='right'") + ">" + getProjectImg() + "</a>" +
                "</li>" +
                "<li class='show-ipad tooltip-gray one-line-tooltip dropdown-toggle'>" +
                "<a class='top-item' href='" + getHref(getType('home', false), false) + "' ng-click='$ctrl.setMainSideBar($event, true)' analytics-on analytics-action='Dashboard' " + ($ctrl.genprops.isSmallW ? '' : " tooltip='Home' tooltip-placement='right'") + ">" +
                getIcon('home', 2,'Home') +
                "</a>" +
                "</li>" +
            "<li class='show-ipad tooltip-gray one-line-tooltip dropdown-toggle'>" +
            "<a class='top-item' href='" + getHref(getType('projects', false), false) + "' ng-click='$ctrl.setMainSideBar($event, true)' analytics-on analytics-action='Projects' " + ($ctrl.genprops.isSmallW ? '' : " tooltip='Projects' tooltip-placement='right'") + ">" +
            getIcon('project', 2,'Projects') +
            "</a>" +
            "</li>";
        }

        function getCredentials(isSB) {
            isSB = false; // display sb logo
            return "<li class='features-info credentials'>" +
                "<div class='text-center made'>" + ((isSB ? 'Made' : 'Powered') + ' By') + "</div>" +
                "<div class='text-center'><a class='with-padding' href='" + (isSB ? 'http://leanometry.com' : 'https://studiobinder.com') + "' target='_blank'>" + (isSB ? 'Leanometry' : 'StudioBinder Inc.') + "</a></div>" +
                "</li>";
        }

        function getBottomMenu() {
            return getProjectManage() +
                getHelpSubMenu();
        }

        function getIcon(icon, iconLevel, name) {
           // return "<div class='col30 centered with-padding-right'><div class='sbf " + icon + "'></div></div><div>" + name + "</div>";
            return '<div>' + $ctrl.LCS.getISBDiv(icon, iconLevel ? iconLevel : 2, 'large') + '</div><div>'+name+'</div>';
        }
        function getProjectManage() {
            /*  "<li class='tooltip-gray one-line-tooltip " + getActiveClass(['user.product.settings', 'user.product.departments']) + "'>" +
              "<a class='top-item' href='" + getHref('user.product.settings', true) + "' ng-click='$ctrl.setMainSideBar($event, true)' analytics-on analytics-action='Manage' " + ($ctrl.genprops.isSmallW ? '' : " tooltip='Manage' tooltip-placement='right'") + "><div class='sbf manage'></div><span>Manage</span></a>" +
              "</li>"
*/
            var title = 'Settings',
                urls = ['settings', 'departments'].map(function (el){return getType(el, true);});
        return '<li dropdown class="tooltip-gray one-line-tooltip dropdown-toggle dropdown ' + getActiveClass(urls) + '">' +
                    '<a dropdown-toggle preventdefault="true" id="btn58be8752153efb50dbe0fec9" class="top-item dropdown-toggle" href="' + getHref(urls[0], true) + '" ng-click="$ctrl.setMainSideBar($event, true)" analytics-on analytics-action="' + title + '" aria-haspopup="true" aria-expanded="false">' +
                        getIcon('cog', 2, title) +
                    '</a>' +
                    '<div dropdown-menu class="sub-menu fadeInUpRight scheduling product-settings dropdown-menu" role="menu" aria-labelledby="btn58be8752153efb50dbe0fec9" style="top:-43px">' +
                        '<ul>' + getSubItems($ctrl.SidebarConfigService.productSettings, true) + '</ul>' +
                    '</div>' +
                '</li>';
        }

        function getSubItems(list, isProduct) {
            var el = '';
            _.each(list, function (item) {
                el += getSubItem(item, isProduct).li;
            });
            return el;
        }

        function getHelpSubMenu() {
        return "<li dropdown class='tooltip-gray one-line-tooltip dropdown-toggle dropdown "+
            "'>" +
                    "<a dropdown-toggle preventdefault='true' id='btn551b2066424bbb9d1cc87005' class='top-item dropdown-toggle' aria-haspopup='true' aria-expanded='false'>" +
            getIcon('resources', 2, 'Resources') +
            "</a>" +
                    "<div dropdown-menu class='sub-menu fadeInUpRight scheduling resources dropdown-menu' role='menu' aria-labelledby='btn551b2066424bbb9d1cc87005' style='top:-119px'>" +
                        "<ul>" + getSubItems($ctrl.SidebarConfigService.helpMenu, false) + "</ul>" +
                    "</div>" +
                "</li>";
        }

        function getMobileToggle(){
            return  "<mobile-toggle window-width='$ctrl.windowWidth' div-class='sidebar-toggle display-block clearfix' class='display-block clearfix'></mobile-toggle>";
        }

        function getUserMenu() {
            return getMobileToggle() +
                '<li class="picture user-sidebar"><img style="height: 55px;width: 55px" class="text-center" src="' + $ctrl.LCS.getImgUrl('nav-logo.png', false) + '"></li>' +
                getMenu($ctrl.SidebarConfigService.generalMenu, false) +
                getHelpSubMenu();
        }

        function getMenu(type, sep, isProduct) {
            var el = sep ? getItemSeparator(sep) : '';
            _.each(type, function(item) {
                el += getItemLi(item, isProduct);
            });
            return el;
        }

        function getItemLi(item, isProduct) {
            var sub = getSubItem(item, isProduct, {
                aClass: 'top-item',
                tooltip: $ctrl.genprops.isSmallW ? '' : " tooltip='" + item.name + "' tooltip-placement='right'"
            });
            return $ctrl.security.isAuthorized($ctrl.SBStateService.getStateDataParams(sub.url)) ?  sub.li : '';

        }

        function getAnalytics(url){
            return 'analytics-on analytics-label="sb_link" analytics-action="sidemenu ' + url + '" ';
        }

        function getSubItem(item, isProduct, other) {
            var url = getType(item.url, isProduct);
            return {
                li: '<li class="' +
                    //(item.borderTop ? 'with-border-top ' :'')+
                    getActiveClass(url) +
                    (other && other.liClass ? other.liClass : '') +
                    (other && other.tooltip ? ' tooltip-gray one-line-tooltip' : '') +
                    '">' +
                    '<a class="' + (other && other.aClass ? other.aClass : 'sub-item') + '" ' +
                    'href="' + getHref(url, isProduct) + '" ' +
                    (item.isBlank ? 'target="_blank" ' : '') +
                    getAnalytics(url) +
                    (other && other.tooltip ? other.tooltip : '') +
                    '>' + getIcon(item.icon, item.iconLevel, item.name) + '</a>' +
                    '</li>',
                url: url
            };
        }

        function getHref(state, isProduct, p) {
            return state && state.indexOf('http') === 0 ? state : $ctrl.SBStateService.getStateHref(state, isProduct ?   $ctrl.security.currentPathParams(_.extend({productId: $ctrl.productId}, p)) : params);
        }

        function getType(url, isProduct) {
            if(!url || url && url.indexOf('http') === 0){return url;}
            var x = 'user.' + (isProduct ? 'product.' : '');
            return url.indexOf(x) === 0 ? url : (x + url);
        }

        function getActiveClass(urls){
            return $ctrl.SBStateService.getActiveClass(typeof(urls) === 'string' ? [urls] : urls);
        }

        function getItemSeparator(name) {
            return "<li class='separator'><div class='sbf more-hor'></div><span class='name'>" + name + "</span></li>";
        }
    }

    function $onDestroy() {
        if($ctrl.compileTemplate) {
            $ctrl.compileTemplate.destroyNewScope();
        }
        $ctrl.RootEventsService.removeWatchers($ctrl.watchers);
    }

    function setMainSideBar(e, val) {
        if(e){
            //  e.stopPropagation();
        }
        var el = $ctrl.element.querySelector('li.active');
        if(el) {
            $ctrl.LCS.removeClass(el, 'active');
            $ctrl.LCS.removeClass(el.querySelector('.dropdown-menu ul li.active'), 'active');
        }
        el = e.currentTarget;
        if(el) {
            var p = el.parentElement;
            if(p) {
                $ctrl.LCS.addClass(p, 'active');
                if ($ctrl.LCS.hasClass(el, 'sub-item')) {
                    try {
                        $ctrl.LCS.addClass(e.currentTarget.parentElement.parentElement.parentElement.parentElement, 'active');
                    }catch (e) {}
                }
            }
        }
        return $ctrl.LCS.setMainSideBar(val);
    }
}

angular.module('user.mobileToggle.component', [
])
.component('mobileToggle', {
    controller: 'MobileToggleCtrl',
    bindings: {
        divClass: '@?',
        aClass: '@?',
        windowWidth: '<?'
    }
})

.controller('MobileToggleCtrl', MobileToggleCtrl);

MobileToggleCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];
function MobileToggleCtrl(TemplateCompileCompCtrlService, $element) {
    //console.log('MobileToggleCtrl');
    var withoutTemplateScope = false;
    var $ctrl = this;

    $ctrl.changedFields = ['windowWidth'];

    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl.$onChanges = $onChanges;
    $ctrl.toggle = toggle;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function getItemTemplate() {
        return '<div ' + ($ctrl.divClass ? ('class="' + $ctrl.divClass + '" ') : '') + '>' +
            '<a class="sbf ' + ($ctrl.aClass || 'angle-double-left') + ' blue">' + $ctrl.LCS.getISBPath(2) + '</a>' +
            '</div>';
    }

    function onLoaded() {
        $ctrl.divEl = $ctrl.element.querySelector('div');
        $ctrl.aEl = $ctrl.element.querySelector('a');

        setClass();
        bind(true);
    }

    function onDestroy() {
        bind(false);
    }

    function bind(isBind) {
        $ctrl.LCS.bindElementListeners(isBind, $ctrl.aEl, $ctrl.toggle);
    }

    function $onChanges(changes) {
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                setClass(changes.currentValue);
                break;
            }
        }
    }

    function toggle(e) {
        $ctrl.preventDefault(e);
        console.log('LCS.toggleMobileOpened');
        $ctrl.LCS.toggleMobileOpened();
    }

    function setClass() {
        var isSmallW = $ctrl.LCS._isMobileSize($ctrl.windowWidth);
        if ($ctrl.isSmallW === undefined || isSmallW !== $ctrl.isSmallW) {
            $ctrl.LCS[isSmallW ? 'removeClass':'addClass']($ctrl.divEl, 'sb-hide');
            $ctrl.isSmallW = isSmallW;
        }
    }
}

angular.module('user.onboardingButton.component', [
])
.component('onboardingButton', {
    controller:'OnboardingButtonCtrl'
})

.controller('OnboardingButtonCtrl', OnboardingButtonCtrl);
OnboardingButtonCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];
function OnboardingButtonCtrl(TemplateCompileCompCtrlService, $element) {
    var $ctrl = this;
    var withoutTemplateScope = true;
    $ctrl.btnId = 'btnOnboarding';
    $ctrl.toggle = toggle;

    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;


    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        $ctrl.name = 'Getting Started';
        $ctrl.icon = 'taskList';
    }

    function postInit() {
        $ctrl.addOnStateChange(reload);
        $ctrl.addRootWatcherSimple($ctrl.LCS.onToggleOnboarding(reload));
    }

    function reload(state) {
        $ctrl.reloadTemplate();
    }

    function getItemTemplate() {
        if ($ctrl.LCS.getShowOnboarding() || !$ctrl.SBStateService.isProductOverviewState()) {
            return '';
        }
        return '<li>' +
            '<a class="table-div table-fixed full-width" id="' + $ctrl.btnId + '" analytics-on analytics-action="OnboardingButton">' +
            '<div class="col30">' + $ctrl.LCS.getISBDiv($ctrl.icon, 2) + '</div>' +
            '<div>' + $ctrl.name + '</div>' +
            '</a>' +
            '</li>';
    }

    function onLoaded() {
        bind(true);
    }

    function onDestroy() {
        bind(false);
    }

    function bind(isBind) {
        $ctrl.bindElementClickBySelector(isBind, '#' + $ctrl.btnId, toggle);
    }

    function toggle(e) {
        $ctrl.preventDefault(e);
        var isOn = $ctrl.LCS.getShowOnboarding() ? false : true;
        $ctrl.LCS.setShowOnboarding(isOn);
        $ctrl.LCS[isOn ? 'removeClass' : 'addClass']($ctrl.LCS.bodyElement.querySelector('.product-dashboard.on-boarding'), 'sb-hide');
        $ctrl.reloadTemplate();
    }
}

angular.module('user.shareButton.component', [
    'services.blocksSetup',
    'ctrl.PopupsCtrl.service',
])
.component('shareButton',{
    controller: 'ShareButtonCtrl',
    bindings: {
        infoStrExt: '<',
        li:'@'
    }
})
.controller('ShareButtonCtrl', ShareButtonCtrl);

ShareButtonCtrl.$inject = ['TemplateCompileCompCtrlService', 'RouteCollaboratorsService', '$element'];
function ShareButtonCtrl(TemplateCompileCompCtrlService, RouteCollaboratorsService, $element) {

    var shareParams;
    var $ctrl = this;

    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
    $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;

    $ctrl.changedFields = ['infoStrExt'];
    $ctrl.dontAutoloadTemplate = true;

    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy =  onDestroy;
 
    $ctrl.$onChanges = $onChanges;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function $onChanges(changes) {
        console.log(changes);
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                onStateChanged();
            }
        }
    }

    function preInit() {
        $ctrl.operation = $ctrl.popupsService.operations.share;
        $ctrl.isLi = $ctrl.li === true || $ctrl.li === 'true';
        shareParams = $ctrl.CPS.getSearchFilter('share');
        if (shareParams) {
            $ctrl.CPS.setSearchFilter(null, 'share'); //open with share param if set
            $ctrl.LCS.timeout(onUpdateSubscription, 500);
        }
        onStateChanged();
    }

    function postInit() {
        $ctrl.addRootWatcher('SHARE_PAGE', onSharePage);
    }

    function onLoaded() {
        bind(true);
    }

    function onDestroy() {
        bind(false);
    }

    function bind(isBind) {
        $ctrl.bindElementClickBySelector(isBind, '#btnSh', share);
    }

    function share(e) {
        $ctrl.preventDefault(e);
        openPopup($ctrl.shareParams, e);
    }

    function onSharePage(result) {
        console.log('onSharePage');
        if(result) {
            openPopup(result.params, result.e);
        }
    }

    function onUpdateSubscription() {
        console.log('onUpdateSubscription');
        if ($ctrl.CPS.subscription && $ctrl.CPS.currentPlan) {
            openPopup({request: shareParams});
        }
    }

    function openPopup(params, e) {
        //todo define preLoadingService to include contacts search
        console.log('openSharePopup');
        $ctrl.CPS.loadQuotaPopup('reviewers', open, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});
        function open() {
            return $ctrl.popupsService.open(null, $ctrl.operation,
                _.extend({preLoadingService: $ctrl.preLoadingService}, params), null, null, null, null, true);
        }
    }

    function updateInfoStrExt() {
        $ctrl = $.extend($ctrl, $ctrl.infoStrExt ? JSON.parse($ctrl.infoStrExt) : {});
    }

    function onStateChanged() {
        updateInfoStrExt();
        if ($ctrl.prevStateName !== $ctrl.currentStateName) {
            var todoPage = $ctrl.BlocksSetupService.getCurrentTodoPage($ctrl.currentStateName);
            $ctrl.showShare = todoPage ? (todoPage.hasShare && !todoPage.hideShareInNav) : false;
            $ctrl.pageClass = todoPage ? todoPage.pageClass : null;
            $ctrl.prevStateName = $ctrl.currentStateName;
            $ctrl.isPageShare = true;// !todoPage && todoPage.type === 3 && todoPage.parentPageId;
            $ctrl.currentListType = $ctrl.isPageShare ? 'Page' : $ctrl.nameForList;
            //is child page
            $ctrl.shareParams = {
                isPageShare: $ctrl.isPageShare
            };

            if($ctrl.showShare) {
                var stateParams = $ctrl.SBStateService.getCurrentStateParams();
                $ctrl.page = todoPage.text;
                if(!set('parentUId') && !todoPage.hasTree) {
                    set('uId');
                }

                function set(p){
                    if(todoPage[p]){
                        $ctrl.shareParams[p] = stateParams[todoPage[p]];
                        return true;
                    }
                }
            }
            bind(false);//remove bindings
            $ctrl.reloadTemplate();

        }
    }

    function getItemTemplate() {
        if (!$ctrl.showShare) {
            return '';
        }
        var txt = 'Share ' + ($ctrl.page ? $ctrl.page : '') + ' ' + $ctrl.currentListType,
        tracking = 'id="btnSh" data-type="share" analytics-on analytics-action="Open '+txt+'" ';
        return $ctrl.isLi ? ('<li class="hide-desktop hide-print"><a '+tracking+'class="table-div full-width"><div class="col30 centered">' + $ctrl.LCS.getISBDiv('link') + '</div> <div>' + txt + '</div></a></li>') :
                            ('<a '+tracking+' class="btn btn-small without-text transparent with-margin-left hide-ipad" tooltip-placement="bottom" tooltip="' + txt + '">' + $ctrl.LCS.getISBDiv('link', 2, 'centered gray') + '</a>');
    }
}

angular.module('user.sidebarFilters.component', [
])
.component('sidebarFiltersBtn', {
    controller: 'SidebarFiltersCtrl',
    bindings: {
        hasSidebarFilters: '<?',
        li:'<?'
    }
})

.controller('SidebarFiltersCtrl', SidebarFiltersCtrl);

SidebarFiltersCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];
function SidebarFiltersCtrl(TemplateCompileCompCtrlService, $element) {
    console.log('SidebarFiltersCtrl');
    var $ctrl = this;
    var changedFields = ['hasSidebarFilters'];

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInit = init;
    $ctrl.onLoaded = onLoaded;

    $ctrl.$onChanges = $onChanges;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function $onChanges(changes) {
        console.log(changes);
        if (!changes) {
            return;
        }
        for (var i = 0, l = changedFields.length; i < l; i++) {
            var change = changes[changedFields[i]];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                reload();
                break;
            }
        }
    }

    function reload() {
        init();

        $ctrl.reloadTemplate();
    }

    function getItemTemplate() {
        //sidebarFiltersBtn
        if ($ctrl.hasSidebarFilters) {
            return '';
        }
        if ($ctrl.li === 'true' || $ctrl.li === true) {
            return '<li class="show-lower1024"><a>' +
                ($ctrl.btnClass? $ctrl.LCS.getISBDiv($ctrl.btnClass) : '') +
                ' ' + $ctrl.name + '</a></li>';
        } else {
            return '<a class="' + ($ctrl.btnClass ? $ctrl.btnClass : '') + ' btn btn-small without-text transparent sbf with-margin-left hide-lower1024 position-relative" tooltip-placement="bottom" tooltip="' + $ctrl.name + '"></a>';
        }
    }

    function onLoaded(){
        $ctrl.bind(true);
    }
    function init() {
        $ctrl.bind(false);
        var hasSidebar = $ctrl.hasInnerSidebar();
        if ($ctrl.hasSidebar === undefined || $ctrl.hasSidebar !== hasSidebar) {
            $ctrl.hasSidebar = hasSidebar;
            $ctrl.name = (hasSidebar ? 'Hide' : 'Show') + ' Filters';
            $ctrl.btnClass = hasSidebar ? 'indent' : 'outdent';
        }
    }
}

angular.module('user.sidebarToggle.component', [
    'services.layoutConfigsService'
])
.component('sidebarToggle', {
    controller: 'SidebarToggleCtrl',
    bindings: {
        divClass: '@?',
        aClass: '@?',
        windowWidth: '<?'
    }
})

.controller('SidebarToggleCtrl', SidebarToggleCtrl);

SidebarToggleCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];
function SidebarToggleCtrl(TemplateCompileCompCtrlService, $element) {
    console.log('SidebarToggleCtrl');
    var $ctrl = this,
        event;

    $ctrl.changedFields = ['windowWidth'];

    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl.$onChanges = $onChanges;

    var withoutTemplateScope = true;
    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function getItemTemplate() {
        return '<div '+($ctrl.divClass?('class="'+$ctrl.divClass+'" '):'')+'>' +
                    '<a '+($ctrl.aClass?('class="'+$ctrl.aClass+'" '):'')+'></a>' +
                '</div>';
    }

    function onLoaded() {
        $ctrl.divEl = $ctrl.element.querySelector('div');
        $ctrl.aEl = $ctrl.element.querySelector('a');
        
        setClass();
        bind(true);
    }

    function onDestroy() {
        bind(false);
    }

    function bind(isBind) {
        if ($ctrl.aEl) {
            if(!event) {
                event = function (e) {
                    $ctrl.preventDefault(e);
                    $ctrl.LCS.toggleFullscreen();
                }
            }
            $ctrl.LCS.bindElementListeners(isBind, $ctrl.aEl, event);
        }
    }

    function $onChanges(changes) {
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                setClass();
                break;
            }
        }
    }
    function setClass() {
        var noSidebar = $ctrl.LCS.noSidebarFilters;
        if ($ctrl.noSidebar === undefined || noSidebar !== $ctrl.noSidebar) {
            $ctrl.LCS[noSidebar?'addClass':'removeClass']($ctrl.divEl, 'sb-hide');
            $ctrl.noSidebar = noSidebar;
        }
    }
}

angular.module('user.userMenu.component', [
])
.component('userMenu',{
    controller: 'UserMenuCtrl',
    bindings: {
        user: '<',
        windowWidth: '<',
    }
})

.controller('UserMenuCtrl', UserMenuCtrl);

UserMenuCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];
function UserMenuCtrl(TemplateCompileCompCtrlService, $element) {
    //console.log('UserMenuCtrl');

    var $ctrl = this;
    var withoutTemplateScope = true;

    $ctrl.CompInitWithoutStateParams = true;
    $ctrl.changedFields = ['windowWidth'];
    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.onLoaded = onLoaded;

    $ctrl.setMainSideBar = setMainSideBar;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        var user = $ctrl.user;
        if (user) {
            if ($ctrl.name === undefined || $ctrl.name !== user.name) {
                $ctrl.name = user.name;
                var initials = $ctrl.security.getInitialsByName($ctrl.name);
                if ($ctrl.initials === undefined || initials !== $ctrl.initials) {
                    $ctrl.initials = initials;
                }
                var btnClass = $ctrl.initials ? $ctrl.security.getNameColor($ctrl.name) : 'user';
                if ($ctrl.btnClass === undefined || btnClass !== $ctrl.btnClass) {
                    $ctrl.btnClass = btnClass;
                }
            }
            var profilePictureURL = user.profilePictureURL;
            if ($ctrl.profilePictureURL === undefined || profilePictureURL !== $ctrl.profilePictureURL) {
                $ctrl.profilePictureURL = profilePictureURL;
                $ctrl.logoPath = profilePictureURL ? $ctrl.security.getLogoPath(user, 'profilePictureURL', 200) : '';
            }
        }
    }

    function postInit() {
        $ctrl.addRootWatcher('SB_ONLINE', setStatus);
    }

    function onLoaded() {
        setStatus($ctrl.LCS.isOnline);
    }

    function setMainSideBar(e) {
        if(e){
          //  e.stopPropagation();
        }
        return $ctrl.LCS.setMainSideBar(true);
    }

    function getItemTemplate() {
        return '<div class="thumb-sm with-radius smaller with-marging-left">' +
            ($ctrl.profilePictureURL ? ('<img class="featured-image" src="' + $ctrl.logoPath + '"/>') :
                    ('<div class="avatar sbf ' +
                        ($ctrl.initials ? '' : 'sbf user') + ' ' +
                        ($ctrl.btnClass ? $ctrl.btnClass : $ctrl.btnClass) +
                        '">' +
                        ($ctrl.initials ? $ctrl.initials : '') +
                     '</div>')
            ) +
                '<span class="online-status"></span>' +
            '</div>';
    }

    function setStatus(isOnline) {
        if ($ctrl.isOnline !== isOnline) {
            if (!$ctrl.statusElement) {
                $ctrl.statusElement = $ctrl.element.querySelector('.online-status');
            }
            if ($ctrl.statusElement) {
                if (isOnline) {
                    $ctrl.LCS.replaceClass($ctrl.statusElement, 'offline', 'online');
                } else {
                    $ctrl.LCS.replaceClass($ctrl.statusElement, 'online', 'offline');
                }
            }
            $ctrl.isOnline = isOnline;
        }
    }
}

angular.module('user.topNavMenu.component', [
    'services.sidebarConfigService'
])
.component('userTopNavMenu', {
    bindings: {
        infoStrExt: '<?'
    },
    controller: 'UserTopNavMenuCtrl'
})
.controller('UserTopNavMenuCtrl', UserTopNavMenuCtrl);

UserTopNavMenuCtrl.$inject = ['TemplateCompileCompCtrlService', 'SidebarConfigService', '$element'];
function UserTopNavMenuCtrl(TemplateCompileCompCtrlService, SidebarConfigService, $element) {
    console.log('UserTopNavMenuCtrl');
    var $ctrl = this;
    $ctrl.projectImgId = 'projectImgWrapper';
    $ctrl.SidebarConfigService = SidebarConfigService;
    $ctrl.BlocksSetupService = SidebarConfigService.BlocksSetupService;
    $ctrl.CompInitWithoutStateParams = true;

    var StateChanges = {
        CurrentNotInThisMenu: 0,
        PrevAndCurrentThisMenu: 2,
        PrevDifMenuCurrentThisMenu: 1
    };

    $ctrl.changedFields = ['infoStrExt'];
    $ctrl.$onChanges = $onChanges;

    $ctrl.goToLink = goToLink;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInit = preInit;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function $onChanges(changes) {
        console.log(changes);
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                if (hasTemplateChanged()) {
                    $ctrl.reloadTemplate();
                    break;
                }
            }
        }
    }

    function onDestroy() {
        bind(false);
    }

    function onLoaded() {
        console.log('onLoaded');
        bind(false);
        bind(true);
    }

    function bind(isBind) {
        $ctrl.bindElementsClickBySelector(isBind, 'li.redirect', $ctrl.goToLink);
    }

    function goToLink(e) {
        if ($ctrl.CPS.isAuthenticated) {
            var t = e.currentTarget.getAttribute('data-type');
            if (t) {
                $ctrl.CPS.transitionTo(t, $ctrl.params);
            }
        }
    }

    function preInit() {
        hasTemplateChanged();
    }

    function getItemTemplate() {
        return $ctrl.template;
    }

    function getProjectImg(product) {
        return $ctrl.security.getImage(product, 'smaller', 'logo', 200, {
            id: $ctrl.projectImgId,
            withSquareImg: true,
            imgClass: 'centering roundborder',
            avatar: 'project',
            iconPaths: $ctrl.LCS.getISBPath(2)
        });
    }

    function hasTemplateChanged() {
        console.log('load user-top-nav');
        $ctrl = $.extend($ctrl, $ctrl.infoStrExt ? JSON.parse($ctrl.infoStrExt) : {});
        var role = $ctrl.CPS.isCollaborator ? $ctrl.security.UserRoles.Collaborator : ($ctrl.CPS.isAuthenticated ? $ctrl.security.UserRoles.User : $ctrl.security.UserRoles.Guest);
        $ctrl.params = $ctrl.CPS.currentPathParams($ctrl.productId ? {productId: $ctrl.productId} : null);
        var product = $ctrl.CurrentProduct.getProduct(),
            n = (product.name ? product.name : 'My Project'),
            productOverview = getType('overview', true),
            desc = product ? (($ctrl.CPS.isCollaborator ? getProjectImg(product) : '') +
                '<li class="projectname-li redirect" data-type="' + productOverview + '"><a class="projectname table-div h-full fixed-layout" ' + getHref(productOverview) + '><div class="centered"><span class="with-ellipsis">' + $ctrl.LCS.encodeHTML(n) + '</span></div></a></li>') : '';

        if (!$ctrl.productId) {
            if ($ctrl.CPS.isAuthenticated) {
                desc = getGeneralMenu();
            }
        } else {
            var stateDate = $ctrl.SBStateService.getStateDataParams(),
                block = $ctrl.BlocksSetupService.getBlockByType(stateDate.overviewBlockType),
                parent, parentId;
            if (!block) {
                parentId = undefined;
            } else {
                parent = $ctrl.BlocksSetupService.overviewBlocks[block.parentNavId];
                parentId = parent ? parent._id : null;
            }
            if (parentId === $ctrl.parentId && $ctrl.prevStateName && $ctrl.prevProductId === $ctrl.productId) {
                console.log('getItemTemplate 0');
                if (!$ctrl.parentId) {
                    var status = prevAndCurrentInSameList($ctrl.SidebarConfigService.productSettings, $ctrl.currentStateName);
                    if (status === StateChanges.PrevDifMenuCurrentThisMenu) {
                        desc += getProductSettingsMenu();
                    } else if (status === StateChanges.CurrentNotInThisMenu) {
                        p();
                    }
                }
                return;
            } else {
                console.log('getItemTemplate 2')
                if ($ctrl.SBStateService.hasState([productOverview], $ctrl.currentStateName)) {
                    desc += getGeneralMenu();
                } else {
                    if (isStateInList($ctrl.SidebarConfigService.productSettings, $ctrl.currentStateName)) {
                        $ctrl.prevStateName = $ctrl.currentStateName;
                        desc += getProductSettingsMenu();
                    } else {
                        p();
                    }
                }
            }

            $ctrl.parentId = parentId;
        }
        $ctrl.prevStateName = $ctrl.currentStateName;
        $ctrl.prevProductId = $ctrl.productId;

        desc = '<ul class="user-menu pull-left">' + desc + '</ul>';

        if ($ctrl.template !== desc) {
            $ctrl.template = desc;
            return desc;
        }

        function p() {
            var product = $ctrl.CurrentProduct.getProduct(),
                overviewBlockIds = product && product.productType ? product.productType.overviewBlockIds : [],
              list = _.sortBy(_.filter($ctrl.BlocksSetupService.overviewBlocks, function(item){return item.parentNavId === parentId && _.find(overviewBlockIds, function (id){return item._id === id;});}), function (item) {
                return item.navOrder;
            });
            desc += processList(list, true);
        }

        function prevAndCurrentInSameList(list, stateName) {
            if (isStateInList(list, stateName)) {
                if ($ctrl.prevStateName && isStateInList(list, $ctrl.prevStateName)) {//prevstate and current state in same list
                    $ctrl.prevStateName = stateName;
                    return StateChanges.PrevAndCurrentThisMenu;
                }
                return StateChanges.PrevDifMenuCurrentThisMenu; //prev state and current state not in same list
            }
            return StateChanges.CurrentNotInThisMenu; //current state not in this list
        }

        function isStateInList(list, name) {
            return $ctrl.SBStateService.hasState(list.map(function (item) {
                return item.url;
            }), name);
        }

        function getProductSettingsMenu() {
            return processList($ctrl.SidebarConfigService.productSettings, true, true);
        }

        function getGeneralMenu() {
            return processList($ctrl.SidebarConfigService.generalMenu, false, true);
        }

        function getCompanySettingsMenu() {
            return processList($ctrl.SidebarConfigService.companySettings, false, true);
        }

        function getUserSettingsMenu() {
            return processList($ctrl.SidebarConfigService.userSettings, false, true);
        }

        function processList(list, isProduct, isEqual) {
            return list ? list.map(function (p) {
                if ($ctrl.security.isAuthorized($ctrl.SBStateService.getStateDataParams(getType(p.url, isProduct)))) {
                    return getItem(p, isEqual, isProduct);
                }
                return '';
            }).join('') : '';
        }

        function getItem(p, isEqual, isProduct) {
            var n = (p.shortName ? p.name : p.name),
                url = getType(p.url, isProduct);

            return url.indexOf('title') !== -1 ? ('<li class="hide-print">' + n + '</li>') :
                (($ctrl.CPS.isAuthenticated || !$ctrl.CPS.isAuthenticated && $ctrl.SBStateService.getActiveClass(p.urls ? p.urls : url)) ? ('<li class="hide-print redirect" data-type="' + url + '" ' +
                    ($ctrl.CPS.isAuthenticated ? ('ng-class="{\'active\':$ctrl.SBStateService.getActiveClass([\'' +
                        (p.urls ? p.urls.join('\', \'') : url) + '\'])}"') : '') +
                    '>' +
                    ('<a ' + $ctrl.getAnalytics('topmenu ' + url) + ' class="table-div h-full" ' + getHref(url) + '> ' +
                        (p.icon ? ('<div class="centered col30 text-center">' + $ctrl.LCS.getISBDiv(p.icon, p.iconLevel ? p.iconLevel : 2, 'top-gray') + '</div>') : '') +
                        '<div class="centered hide-lower1400 with-padding-left">' + n + '</div>' +
                        '</a>') +
                    '</li>') : '');
        }

        function getHref(url) {
            return '';
            return $ctrl.CPS.isAuthenticated ? ('href="' + $ctrl.SBStateService.getStateHref(url, $ctrl.params) + '"') : '';
        }

        function getType(type, isProduct) {
            return 'user.' + (isProduct ? 'product.' : '') + type;
        }

    }
}

angular.module('user.topNav.component', [
    'user.darkModeLi.component',
    'user.topNavMenu.component',
    'user.cheatSheetButton.component',
    'apiServices.Products'
])
.component('userTopNav', { 
    bindings: {
        infoStrExt: '<?'
    },
    controller: 'UserTopNavCtrl'
})
.controller('UserTopNavCtrl', UserTopNavCtrl);

UserTopNavCtrl.$inject = ['TemplateCompileCompCtrlService', 'RouteCollaboratorsService', 'SidebarConfigService', 'ProductsService', '$element'];
function UserTopNavCtrl(TemplateCompileCompCtrlService, RouteCollaboratorsService, SidebarConfigService, ProductsService, $element) {
    console.log('UserTopNavController');
    var $ctrl = this;

    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
    $ctrl.SidebarConfigService = SidebarConfigService;
    $ctrl.CompInitWithoutStateParams = true;
    $ctrl.ProductsService = ProductsService;

    $ctrl.changedFields = ['infoStrExt'];

    $ctrl.$onChanges = $onChanges;

    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onChangeProductTeam = onChangeProductTeam;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function onChangeProductTeam(result1) {
        console.log('onChangeProductTeam');
        var prop = result1.prop,
            editchanges = result1 ? result1.editchanges : null;
        if (!editchanges) {
            return;
        }

        var members = _.filter($ctrl.CPS.SessionService.getSetting('team'), function (item) {
                return item.memberType === 0; //only members
                }).map(function (item) {
                    return item._id;
                }),
            teamIds = editchanges.teamIds ? _.unique(_.filter(editchanges.teamIds, function (id) {
                    return _.find(members, function (idM) {
                        return idM === id;
                    });
                })) : null;

        editchanges.teamIds = teamIds && teamIds.length > 0 ? teamIds : null;

        $ctrl.ProductsService.update(editchanges, onsuccess, onerror);

        function onsuccess(result) {
            var product = result ? result.item : {};
            if (product && editchanges._id === product._id &&
                $ctrl.CPS.product && $ctrl.CPS.product._id === product._id) {
                $ctrl.CPS.product[prop] = product[prop];
                $ctrl.CurrentProduct.broadcastProduct($ctrl.CPS.product, editchanges);
            }
        }

        function onerror(error) {
            console.log(error);
        }
    }

    function preInit() {
        load();
        var u = $ctrl.security.getCurrentUser();
        $ctrl.withRequestAccess = $ctrl.security.isCollaborator && u && !u.isGeneral;
    }

    function postInit(){
        $ctrl.addRootWatcherSimple($ctrl.SidebarConfigService.onUpdateSidebar(load));
    }

    function load(){
        $ctrl = $.extend($ctrl, $ctrl.infoStrExt ? JSON.parse($ctrl.infoStrExt) : {});
        //hide tasks btn if is not in features
        var product = $ctrl.CurrentProduct.getProduct(),
            overviewBlockIds = product.productType ? product.productType.overviewBlockIds : [],
            blockW = _.find($ctrl.RouteCollaboratorsService.BlocksSetupService.overviewBlocks, {type: 'workflow'});
        $ctrl.showTasksBtn = !!(!product._id && $ctrl.SBStateService.getCurrentStateName() === 'user.dashboard' || //news
            product._id && blockW && overviewBlockIds && _.find(overviewBlockIds, function (id) {
                return id === blockW._id;
            }));
    }

    function $onChanges(changes) {
        console.log(changes);
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                load();
            }
        }
    }

    function getItemTemplate() {
return "<nav class='subheader hide-print'>" +
            "<div class='h2 text-left'>" +
                 "<script-versions-button class='liH2 clearfix script-versions-button hide-print with-margin-right'></script-versions-button>" +
                "<user-top-nav-menu info-str-ext='$ctrl.infoStrExt' class='liH2 clearfix user-top-nav-menu'></user-top-nav-menu>" +
                "<request-permissions-btn ng-if='$ctrl.CPS.isCollaborator && $ctrl.productId' class='liH2 clearfix request-permissions-btn' can-edit='$ctrl.canEdit' can-comment='$ctrl.canComment' with-request-access='$ctrl.withRequestAccess'></request-permissions-btn>" +
            "</div>" +
            "<div class='text-right sidebuttons hide-print'>" +
                "<company-selector class='company-picker pull-right'></company-selector>" +
                getUsers() +
                "<span dropdown class='dropdown dropdown-wrapper pull-right position-relative with-margin-right hide-desktop drpMoreMobile'>" +
                    "<button type='button' class='btnSubheaderMore btn btn-small without-text transparent no-border' tooltip-placement='bottom' tooltip='More' dropdown-toggle><div class='centered sbf horizontal-dots'></div></button>" +
                     "<div class='dropdown-menu more side-menu drpHopeIn' role='menu'>" +
                        "<ul>" +
                            ($ctrl.isAuthenticated && $ctrl.canEdit ? ('<share-button ng-if="$ctrl.productId&&$ctrl.LCS.isMobileSize" li="true" info-str-ext="$ctrl.infoStrExt"></share-button>') : '') +
                           ($ctrl.isAuthenticated ? "<comments-button ng-if='$ctrl.LCS.isMobileSize&&$ctrl.showTasksBtn' type='tasks' li='true' page='true'></comments-button>"  : '')+//page level tasks or dashboard or filters
                           ("<comments-button ng-if='$ctrl.LCS.isMobileSize' type='comments' li='true' page='true'></comments-button>")+//page level comments
                            "<li ng-if='!$ctrl.hidePrint && $ctrl.exposePrint' class='with-border-bottom'>" +
                                "<print-button show-title='true' default-print='$ctrl.defaultPrint' show-text-on-ipad='true'></print-button>" +
                            "</li>" +
   // ($ctrl.LCS.isDebugMode ?  '<fullscreen-li></fullscreen-li>' + '<dark-mode-li></dark-mode-li>' : '') +
                            "<sidebar-filters-btn li='::true' has-sidebar-filters='$ctrl.hasSidebarFilters'></sidebar-filters-btn>"+
                        ($ctrl.isAuthenticated ? (
                            "<onboarding-button ng-if='$ctrl.productId'></onboarding-button>" +
                            "<cheat-sheet-button li='true' class='show-lower1024'></cheat-sheet-button>"
                        ) : '') +
                        "</ul>" +
                    "</div>" +
                "</span>"+
                "<sidebar-filters-btn has-sidebar-filters='$ctrl.hasSidebarFilters'></sidebar-filters-btn>" +
               ($ctrl.isAuthenticated ? ("<comments-button ng-if='" +
                   "!$ctrl.LCS.isMobileSize&&" +
                   "$ctrl.showTasksBtn' class='pull-right' type='tasks' page='true'></comments-button>") : '')+//page level tasks or dashboard or filters
                                        ("<comments-button" +
                                            " ng-if='!$ctrl.LCS.isMobileSize' " +
                                            "class='pull-right' type='comments' page='true'></comments-button>")  +//page level comments

                ($ctrl.isAuthenticated && $ctrl.canEdit ? ('<share-button ng-if="$ctrl.productId&&!$ctrl.LCS.isMobileSize" class="pull-right" info-str-ext="$ctrl.infoStrExt"></share-button>') : '') +
                "<cheat-sheet-button class='pull-right'></cheat-sheet-button>" +
            "</div>" +
        "</nav>";

        function getUsers(){
            return $ctrl.isAuthenticated ? getTeam() : ($ctrl.CPS.isCollaborator ? getCollaborators() : '');

            function getCollaborators(){
                return '<sb-assign-collaborators ng-if="$ctrl.productId" class="clearfix collaborators-faces without-underline without-arrow pull-right" circle-size="smaller" max-count="2" parent-container="true" without-close="true" can-edit="::$ctrl.canEdit" todo-page-id="{{$ctrl.RouteCollaboratorsService.todoPage._id}}" u-id="$ctrl.RouteCollaboratorsService.uIdType?$ctrl.RouteCollaboratorsService[$ctrl.RouteCollaboratorsService.uIdType]:undefined"></sb-assign-collaborators>';
            }

            function getTeam() {
                return '<sb-assign-team ng-if="$ctrl.productId" element-id="elementid_teamIds_topNav" class="sb-assign-team touching-users without-underline without-arrow topnav-team pull-right" on-change="$ctrl.onChangeProductTeam(result)" on-cancel="$ctrl.onCancelChangeTeam(result)" c-class-attr="without-underline without-arrow" e-class-attr=" hover-underline" placeholder="Assign Team…" parent-container="true" init-list-name="team" with-count="true" max-count="' + ($ctrl.LCS.isMobileSize ? 1 : 5) + '" circle-size="smallest" can-change-edit="' + $ctrl.canEdit + '" is-product-team="true" product-id="$ctrl.productId" init-list="::null" is-assign="true" without-default-focus="true" header-selected="Project Users" show-member-type="true" display-default-members="true" team-label="Assign More Users" current-id="' + $ctrl.CPS.teamId + '" ' +
                    //if one is not admin can remove self only
                    ($ctrl.CPS.memberType < $ctrl.security.MemberTypes.Admin ? (' can-remove-current="true"') : '') +
                    // 'remove-message="::$ctrl.taskBoardRemoveMessage" ' +
                    'drp-class-attr="drp-taller" ' +
                    '></sb-assign-team>';
            }
        }
    }
}

angular.module('product.viewTutorialsPopup.component', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'apiServices.Contacts',
    'product.contacts.attachments.component',
    'services.layoutConfigsService',
    'components.fileUploader.sbResizableImg.service',
])
    .component('viewTutorialsPopup', popupComponentParams('ViewTutorialsPopupCtrl'))
    .controller('ViewTutorialsPopupCtrl', ViewTutorialsPopupCtrl);

ViewTutorialsPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', '$element'];
function ViewTutorialsPopupCtrl(ItemTemplateCompileCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.toggleFeatures = toggleFeatures;
    $ctrl.playLesson = playLesson;
    $ctrl.startIntro = startIntro;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function setTemplateData() {
        $ctrl.footerClsOther = 'margin-bottom-0 margin-top-0 padding-bottom-0';
        $ctrl.withFooterBtns = false;
        $ctrl.withCloseBtn = true;
        $ctrl.icon = null;
        $ctrl.popupTitle = null;
        $ctrl.modalBodyFormClass = 'cfp-hotkeys centering';
        $ctrl.btnToggleCls = 'btnKeys';
    }

    function getPopupBodyContent() {
        var params = $ctrl.extraParam,
            icon = (params.isSolution ? '' : 'with-radius sbf ') + (params.icon ? params.icon : 'book-open'),
            title = 'Getting Started' + (params.name ? (' with ' + params.name) : ''),
            explore = 'StudioBinder Academy',
        tour = 'Feature Tour'; //params.name;

        $ctrl.itemTitle = params.name;
        $ctrl.tutorialPlaylist = params.tutorialPlaylist;

    return '<div class="empty-state full-width table-div">' +
                '<div class="centered header text-left">' +
                    '<div class="circled-svg-colored small76 page-class ' + (params.pageClass || '') + '">' + (icon ? $ctrl.LCS.getISBDiv(icon, 8) : '') + '</div>' +
                '</div>' + '' +
                '<div class="info centered">' +
                    '<h3 class="infoh">' + title + '</h3>' +
                    '<div class="desc full-width">Explore free video courses on <br class="hide-desktop">' +
                        '<a class="semibold" href="' +
        'https://www.studiobinder.com/tutorials/' //params.tutorialUrl
        + '" target="_blank" '+$ctrl.getAnalytics(explore)+'>' + explore + '</a>' +
          (params.hasIntro ? ('<span class="introb" style="color:#6C7393">&nbsp;&nbsp;•&nbsp;&nbsp;</span>' +
              '<a '+$ctrl.getAnalytics(tour)+' data-type="startIntro" class="introb semibold ' + $ctrl.getBtnActionCls() + '">'+tour+'</a>') : '') +
                    '</div>' +
                '</div>' +
            '</div>' +
            '<div class="center spacing-half">' +
                getVideo() +
                //getTutorials() +
                getHotKeys() +
            '</div>';

        function getVideo() {
            var hasPlaylist = $ctrl.tutorialPlaylist ? true : false,
                url = hasPlaylist ? getUrl($ctrl.tutorialPlaylist[0].u) : (params.videoUrl ? params.videoUrl : null);
            return url ? ('<div class="video-wrapper table-div full-width ' + (hasPlaylist ? 'with-playlist' : '') + '">' +
                '<div class="left">' +
                '<iframe class="lesson-player" src="' + url + '" width="600" height="338" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen allowFullScreen allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture;web-share" referrerPolicy="strict-origin-when-cross-origin"></iframe>' +
                '</div>' +
                (hasPlaylist ? getPlaylist($ctrl.tutorialPlaylist) : '') +
                '</div>') : '';

            function getPlaylist(items) {
                var count = items.length,
                    content = items.map(function (item, i) {
                        return '<div ' + $ctrl.getAnalytics('playLesson', item.u) + ' class="pitem with-transition ' + (i === 0 ? 'active ' : '') + $ctrl.getBtnActionCls() + '" data-info="' + item.u + '" data-type="playLesson">' +
                            $ctrl.LCS.getISBDiv('play-circle', 'sbf20') + ' <span class="with-padding-left">Lesson ' + (i + 1) + ' — ' + item.n + '</span>  <span class="pull-right m">' + item.m + 'm</span></div>';
                    }).join('');
                return '<div class="right with-fancy-scrollbar">' +
                    '<div class="full-width header">Course: Intro to ' + params.name + '<span class="pull-right counter">' + count + ' Lesson' + (count === 1 ? '' : 's') + '</span></div>' +
                    '<div class="playlist-items fancy-scrollbar ultrathin vertical">' + content + '</div></div>';
            }
        }

        function getTutorials() {
            var url = 'https://www.studiobinder.com/tutorials;'
            return params.tutorialUrl ? ('<div class="video-frame text-left margin-top-30">' +
                '<div class="table-div">' +
                '<div class="text-left centered col30"><svg width="20px" height="20px" viewBox="0 0 20 20" version="1.1" xmlns="http://www.w3.org/2000/svg"><g transform="translate(-137.000000, -696.000000)" fill="#727DA1"><g transform="translate(70.000000, 100.000000)"><g transform="translate(67.000000, 596.000000)"><circle opacity="0.149999991" cx="10" cy="10" r="10"></circle><path d="M7,12.9237133 L7,7.07613237 C7,6.48180087 7.47626798,6 8.06377432,6 C8.25951385,6 8.45145846,6.05463404 8.61847944,6.15788817 L13.3479211,9.08167864 C13.8492296,9.3915928 14.0072705,10.0539398 13.7009153,10.5610721 C13.612916,10.7067437 13.4919199,10.8291455 13.3479211,10.918167 L8.61847944,13.8419575 C8.11717096,14.1518717 7.4624302,13.9919948 7.15607502,13.4848625 C7.07952373,13.3581416 7.03000718,13.2172382 7.01003336,13.0711696 L7,12.9237133 Z"></path></g></g></g></g></svg></div>' +
                '<div class="text-left centered">' +
                '<span class="lightz inline-block with-padding-right">Explore more video lessons on </span>' +
                '<a ' + $ctrl.getAnalytics('Tutorial on ' + params.name, params.tutorialUrl) + ' class="semibold blue" href="' + params.tutorialUrl + '" target="_blank">' + params.name + '</a>' +
                '</div>' +
                '<div class="col30 text-center centered">  •  </div>' +
                '<div class="text-left centered"><a ' + $ctrl.getAnalytics('Browse all Courses', url) + ' class="semibold " href="' + url + '" target="_blank">Browse all Courses</a></div>' +
                '</div>' +
                '</div>') : '';
        }

        function getHotKeys() {
            var keys = params.hotkeys;
            return keys ? ('<div class="wrapper-keys body full-width">' +
                '<div class="full-width margin-bottom-20"><a class="with-transition ' + $ctrl.btnToggleCls + ' gray table-div full-width ' + $ctrl.getBtnActionCls() + '" data-type="toggleFeatures">' +
                '<div class="col30 text-left centered">' + $ctrl.LCS.getISBDiv(getArrowCls()) + '</div>' +
                '<div class="centered txt text-left">' + getToggledText() + '</div>' +
                '</a></div>' +
                getItems() + '</div>') : '';

            function getItems() {
                var content = keys.map(function (hotkey) {
                    var h = hotkey.txt,
                        isPlay = h === 'play';
                    return '<div><div class="table-div full-width"> ' +
                        '<div class="cfp-hotkeys-keys">' +
                        '<span class="cfp-hotkeys-key ' + (isPlay ? ' sbf play-circle' : '') + '">' + (isPlay ? '' : h) + '</span>' +
                        '</div>' +
                        '<div class="cfp-hotkeys-text centered">' + (
                            isPlay ? ('<a>' + hotkey.desc + '</a>') : hotkey.desc
                        ) + '</div>' +
                        '</div></div>';
                }).join('');
                return '<div class="cfp-hotkeys-section features-wrapper ' +($ctrl.showToggled ? '' : 'sb-hide')+ ' "> ' + content + '</div>';
            }
        }
    }

    function playLesson(url, e){
        if(!$ctrl.lessonPlayerEl){
            $ctrl.lessonPlayerEl = $ctrl.element.querySelector('.lesson-player');

        }
        if($ctrl.lessonPlayerEl){
            $ctrl.lessonPlayerEl.src = getUrl(url);
        }

        if(!$ctrl.playlistEl){
            $ctrl.playlistEl = $ctrl.element.querySelector('.playlist-items');
        }
        if($ctrl.playlistEl){
            $ctrl.LCS.removeClass($ctrl.playlistEl.querySelectorAll('.pitem.active'), 'active');
            $ctrl.LCS.addClass($ctrl.playlistEl.querySelector('.pitem[data-info="'+url+'"]'), 'active');
        }
    }

    function getUrl(u){
        return 'https://www.youtube.com/embed/'+u+'?si=sb-app-tutorials-popup';
    }

    function toggleFeatures(){
        $ctrl.showToggled = $ctrl.showToggled ? false : true;
        var btn = $ctrl.element.querySelector('.' + $ctrl.btnToggleCls);
        if (btn) {
            $ctrl.LCS.replaceClass(btn.querySelector('.sbf'), getArrowCls(true), getArrowCls());

            var txt = btn.querySelector('.txt');
            if (txt) {
                txt.innerHTML = getToggledText();
            }
        }

        var wrapper = $ctrl.element.querySelector('.features-wrapper');
        if (wrapper) {
            $ctrl.LCS[$ctrl.showToggled ? 'removeClass' : 'addClass'](wrapper, 'sb-hide');
        }
    }

    function getArrowCls(reversed) {
        if (reversed) {
            return $ctrl.showToggled ? 'arrow-right-big' : 'arrow-down';
        }
        return $ctrl.showToggled ? 'arrow-down' : 'arrow-right-big';
    }

    function getToggledText(){
        return '<span class="semibold ">'+($ctrl.showToggled ? 'Hide' : 'Show') + ' Hotkeys</span> for ' +  $ctrl.itemTitle;
    }

    function startIntro(){
        $ctrl.broadcastRoot('START_INTRO', true);
        $ctrl.LCS.timeout(function (){
            $ctrl.closePopup();
        },100);
    }
}

