angular.module('product.scriptOutline.controller.service', [
    'apiConstants.product.scriptOutline.service',
    'product.workflow.page.init.controller.service'
])
.service('ScriptOutlineCtrlService', ScriptOutlineCtrlService);
ScriptOutlineCtrlService.$inject = ['WorkflowPageInitCtrlService', 'ScriptOutlineConstantsService'];
function ScriptOutlineCtrlService(WorkflowPageInitCtrlService, constantsService) {
    return function ($ctrl, $element) {
        console.log('ScriptOutlineCtrlService');
        $ctrl.onPreInit = onPreInit;

        $ctrl = new WorkflowPageInitCtrlService($ctrl, $element, constantsService);
        return $ctrl;

        function onPreInit() {
            if(!$ctrl.uId){
                $ctrl.uId = null;
            }
            $ctrl.title = 'Script Outline';
            $ctrl.isScriptPage = true;

            $ctrl.hasUId = true;
            $ctrl.treeType = 3;
            //$ctrl.title = $ctrl.todoPage.text;
            if ($ctrl.isPopup) {
                $ctrl.withoutUiOnParamsChanged = true;
                $ctrl.withoutCheatSheet = true;
                $ctrl.close = close;
            }
            $ctrl.getParams = getParams;
            $ctrl.withPreloaderProperty = getParams;
            $ctrl.toggleArchived = toggleArchived;
        }

        function close() {
            if (typeof ($ctrl.onClose) === 'function') {
                $ctrl.onClose({result: 'cancel'});
            }
        }

        function toggleArchived() {

        }

        function getParams() {
            return {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                uId: $ctrl.uId
            };
        }
    }
}

