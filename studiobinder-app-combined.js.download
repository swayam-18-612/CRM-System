SbDateDrpMenuCtrl.$inject = ['SbDateDrpMenuCtrlService', '$element'];
function SbDateDrpMenuCtrl(SbDateDrpMenuCtrlService, $element) {
    console.log('SbDateDrpMenuCtrl');
    var $ctrl = this;

    $ctrl.datetype = 'single';

    $ctrl.onChangeOther = onChangeOther;
    $ctrl.onDatePickerLoaded = onDatePickerLoaded;

    $ctrl = new SbDateDrpMenuCtrlService($ctrl, $element);

    function onChangeOther(selectedDates){
        console.log('onChangeOther');
        $ctrl.datepicker.close();
        $ctrl.withClose = true;

        $ctrl.onSelect({result: {value: selectedDates[0], withClose: $ctrl.withClose}});
    }

    function onDatePickerLoaded() {
        console.log('onDatePickerLoaded');
        if($ctrl.value) {
            $ctrl.datepicker.setDate($ctrl.value);
        }
    }
}

angular.module('sb.fields.date.component', [
    'sb.fields.date.component.service',
    'dropdowns.sbDate.menu.component'
])
.component('sbDate', sbFieldComponentParams('SbDateCtrl',{
    removeText: '@?',
    hasRemove: '@?',
    dateFormat: '@?',
    emptyIsCircle: '@?',
    header: '@?',
    minDate: '<',
    maxDate: '<',
    //value: moment
    defaultDate: '<', //is Date / value is date as well
    enableTime: '@',
}, getSBDropdownTemplate()))
.controller('SbDateCtrl', SbDateCtrl);

SbDateCtrl.$inject = ['SbDateCtrlService', '$element', '$attrs'];

//value: value
function SbDateCtrl(SbDateCtrlService, $element, $attrs) {
    var $ctrl = this;

    $ctrl.dateType = 1;

    $ctrl.getMenuDrpValue = getMenuDrpValue;
    $ctrl.preselect = preselect;
    $ctrl.initDrpOther = initDrpOther;

    $ctrl = new SbDateCtrlService($ctrl, $element, $attrs);

    function initDrpOther(){
        console.log('initDrpOther');
        if(!$ctrl.dateFormat) {
            $ctrl.dateFormat = 'mm/dd/yyyy';
        }

        //Date
        if(!$ctrl.defaultDate) {
            $ctrl.defaultDate = $ctrl.getDateFromMoment($ctrl.MomentService.getUtcMomentNow());
        }
        //Moment
        $ctrl.value = $ctrl.getStringToMoment($ctrl.value);
    }

    function getMenuDrpValue() {
        return $ctrl.getDateFromMoment($ctrl.value) || angular.copy($ctrl.defaultDate);
    }

    function preselect(result) {
        if (result) {
            $ctrl.setNewValue(result.e, $ctrl.getStringToMoment(result.value));
        }
    }
}

