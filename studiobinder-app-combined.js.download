angular.module('product.contacts.sendContactsMessagePopup.component', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'apiServices.Contacts',
    'product.contacts.attachments.component',
    'services.layoutConfigsService',
    'components.fileUploader.sbResizableImg.service',
])
.component('sendContactsMessagePopup', popupComponentParams( 'SendContactsMessagePopupCtrl'))
.controller('SendContactsMessagePopupCtrl', SendContactsMessagePopupCtrl);

SendContactsMessagePopupCtrl.$inject = ['GeneralItemEditCtrlService', 'ContactsService', 'ImageUploaderService', '$element'];
function SendContactsMessagePopupCtrl(GeneralItemEditCtrlService, service, ImageUploaderService, $element) {
    var $ctrl = this;
    $ctrl.isPopup = true;

    var ids = [];
    $ctrl.ImageUploaderService = ImageUploaderService;
    $ctrl.subjectId ='subject';
    $ctrl.editorWrapperCls = 'wrappercls';
    $ctrl.toolbarWrapperClass = 'editortoolbar';

    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl.postInitGeneral = postInitGeneral;
    $ctrl.getItemPopupTemplate = getItemPopupTemplate;

    $ctrl.addAttachment = addAttachment;
    $ctrl.getIcon = getIcon;
    $ctrl.getInitials = getInitials;
    $ctrl.getDisplayName = getDisplayName;
    $ctrl.getTooltip = getTooltip;

    $ctrl.onLoaded = onLoaded;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneral() {
        $ctrl.withCloseBtn = true;
        $ctrl.service = service;
        $ctrl.brandedCallsheets = $ctrl.CPS.hasQuotaType('brandedCallsheets');
        $ctrl.createdBy = $ctrl.extraParam.createdBy;
        $ctrl.cast = $ctrl.extraParam.cast;
        $ctrl.callsheetId = $ctrl.extraParam.callsheetId;
        $ctrl.todayDate = $ctrl.CPS.getCreatedAt($ctrl.MomentService.getUtcDateNow(), 'MMM D, YYYY');

        $ctrl.item = {subject: null, title: null, message: null, materialId: new ObjectId().toString()};
        $ctrl.minLength = 30;

        $ctrl.display = [];
        $ctrl.hidden = [];
        for (var i = 0, n = $ctrl.cast.length; i < n; i++) {
            var el = $ctrl.cast[i];
            ids.push($ctrl.extraParam.callsheetId && el.castId ? el.castId : el._id);
            if (i < 5) {
                $ctrl.display.push(el);
            } else {
                $ctrl.hidden.push(el);
            }
        }
    }

    function postInitGeneral(){
        $ctrl.onSave = onSave;
        $ctrl.onError = onError;
        $ctrl.cancelPopup = cancelPopup;
        $ctrl.save = save;
    }

    function onLoaded(){
        console.log('sendContactsMessagePopup loaded');
        if(!$ctrl.editorCompile) {
            $ctrl.editorCompile = new $ctrl.TemplateCompileService($ctrl.element.querySelector('.' + $ctrl.editorWrapperCls), getEditorTemplate, $ctrl);
        }
        $ctrl.editorCompile.loadTemplate(function () {
            console.log('editor loaded');
        });
    }

    function getEditorTemplate() {
        //add the content message  after load so that the toolbar can be added in the footer
       return $ctrl.getPopupFormForSelected([{
           eClassAttr: ' ',
            withoutLabelInPopup: true,
            prop: 'message',
            type: $ctrl.SBFieldTypesService.PropTypes.Html,
            canEdit: true,
            placeholder: 'Your message…',
            withBottomToolbar: true,
            toolbarParentEl: '.modal-content .email-wrapper-footer .' + $ctrl.toolbarWrapperClass,
            editorType: 'contactmessage'
        }], false, true) ;
    }

    function getItemPopupTemplate(){
    return ($ctrl.withCloseBtn && $ctrl.nonMobileCloseBtn ? $ctrl.nonMobileCloseBtn() : '') +
            $ctrl.getMobileBack() +
    '<div class="centering email-wrapper send-message">' +
        '<div class="address to">' +
            '<div class="from">To</div>' +
            '<div class="search-contacts">' +
                '<div class="selected-items wider-tooltip">' +
                    '<div class="selected-projects">' +
                        '<ul>' +
                            getItems('display', false) +
                            getItems( 'hidden', true) +
                            '<a ng-show="$ctrl.hidden.length>0" ng-click="$ctrl.showMore = $ctrl.showMore? false:true" ng-bind="$ctrl.showMore? \'Hide\': ($ctrl.hidden.length +\' More\')"></a>' +
                        '</ul>' +
                    '</div>' +
                '</div>' +
            '</div>' +
            '<div class="text-right show-ipad">' + $ctrl.getMobileBack(getBtnSend()) + '</div>' +
            '<div class="info-td text-right wider-tooltip hide-ipad">' +
                '<div tooltip="Each message will be sent separately. Recipients will not see each other." tooltip-placement="bottom">' +
                    $ctrl.LCS.getISBDiv('info-circle', 4, 'gray') +
                '</div>' +
            '</div>' +
        '</div>' +
        '<div class="address wider-tooltip ">' +
            '<div class="from">From</div>' +
            '<div><strong class="highlighted">'+$ctrl.CPS.user.name+'</strong> <span tooltip="For maximum deliverability, emails are sent from our whitelabeled domain, but with your full name visible." tooltip-placement="bottom">&lt;no-reply@studiobinder.com&gt;</span></div>' +
            '<div class="date text-right hide-ipad">'+$ctrl.todayDate+'</div>' +
        '</div>' +
        '<div class="subject table-div">' +
            '<div><div ng-model="$ctrl.item.subject" class="editable-content word-wrap contenteditable" placeholder="Email subject…" contenteditable="true" contenteditable-html strip-br="true" ui-focus="true" id="'+$ctrl.subjectId+'"></div></div>' +
        '</div>' +
$ctrl.LCS.getErrorBlock( ) +
        '<div class="body spacing-half-bottom medium-template">' +
            '<table class="innertable">' +
                '<tr class="tablewithbg">' +
                    '<td height="30" class="wider-tooltip text-center height30">' +
        (!$ctrl.CPS.hasQuotaType('brandedCallsheets') ? ('<div class="text-center logoTopEmail bigger" tooltip="Upgrade to Studio plan remove this StudioBinder branding." tooltip-placement="top"></div>') :'') +
                    '</td>' +
                '</tr>' +
                '<tr class="tablewithbg">' +
                    '<td class="tdwithradius height60">' + '&nbsp;' + '</td>' +
                '</tr>' +
                '<tr>' +
                    '<td class="vtop with-no-padding with-no-margin">' +
       ($ctrl.CPS.product.logo ? ('<div class="col80 centered" style="min-height:80px!important;max-height:80px!important;overflow:hidden!important;border-radius:6px!important;padding:0">' +  $ctrl.security.getProjectImageComponent('$ctrl.CPS.product', 'medium') + '</div>') :
                        ('<div class="logoTopForm bigger with-bg-image"> </div>')) +
                    '</td>' +
                '</tr>' +
                '<tr>' +
                    '<td class="vtop with-no-margin spacing-half-top">' +
                        '<div class="editable-content title word-wrap text-center contenteditable" placeholder="Enter heading here…" contenteditable="true" contenteditable-html strip-br="true" ng-model="$ctrl.item.title"></div>' +
                    '</td>' +
                '</tr>' +
                '<tr>' +
                    '<td style="padding: 20px 10% 20px 10%;" class="'+$ctrl.editorWrapperCls+'">' +

                    '</td>' +
                '</tr>' +
                '<tr><td><div class="full-width" style="margin-bottom: 40px; margin-top: 0px;background-color: var(--body-bg);height:10px">&nbsp;</div></td></tr>' +
                '<tr>' +
                    '<td style="margin: 0 auto; text-align: center;padding-bottom:30px">' +
                        '<table style="max-width: 400px;width:94%; margin: 0 auto">' +
                            '<tr>' +
                                '<td style="width:40px;vertical-align: top;text-align:left;">' +
                                    '<img width="33" height="33" style="height: 33px;width:33px" src="'+$ctrl.LCS.getImgUrl('email/info.svg', false)+'">' +
                                '</td>' +
                                '<td>' +
                                    '<div class="font-size-12 italic full-width font-size-12" style="text-align:left;font-weight:400;line-height:1.6;color:#2c3542;font-style: italic">This is an automated email. Please don\'t reply.<br/> Any questions or comments for production? </br>Email us  <a href="mailto:'+$ctrl.CPS.user.email+'" style="text-decoration:none">'+$ctrl.CPS.user.email+'</a>' +
                                    '</div>' +
                                '</td>' +
                            '</tr>' +
                        '</table>' +
                    '</td>' +
                '</tr>' +
                '<tr style="background-color:white;">' +
                    '<td class="text-center" style="height:60px; width: auto">&nbsp;</td>' +
                '</tr>' +
                '<tr class="hide-ipad">' +
                    '<td class="text-center font-size-12" style="padding:10px 0;color:#6F7494;line-height:18px;background-color:var(--body-bg)">' +
                        '<div class="spacing bottom-branding">' +
                            '<div class="gray-logo with-bg-image text-center"></div>' +
                            '<div class="text-center margin-top-half uppercase">' +
                                '<a class="text-uppercase" style="font-size:11px;color:#6F7494;font-weight: normal;letter-spacing:0.5px" target="_blank" href="'+$ctrl.CPS.websiteUrl+'">Powered by '+$ctrl.API_CONFIGS.site.companyName+'</a>' +
                            '</div>' +
                            '<div class="font-size-10 text-italic" style="font-size:11px;font-weight:normal;color:#828c94; margin-top: 6px">'+$ctrl.API_CONFIGS.site.companyName+' • '+$ctrl.API_CONFIGS.site.address+'</div>' +
                        '</div>' +
                    '</td>' +
                '</tr>' +
            '</table>' +
            '<message-attachments class="message-attachments clearfix display-block medium-template" current-list-id="$ctrl.item.materialId"></message-attachments>' +
        '</div>' +
    '</div>' +
    '<div class="email-wrapper-footer">' +
        '<div>' +
            '<div class="padding-right-20">' + getBtnSend() + '</div>' +
            '<div><div class="btnAttach">' + getBtnAtt() + '</div></div>' +
            '<div class="buttons">' +
                '<div class="' + $ctrl.toolbarWrapperClass + '"></div>' +
            '</div>' +
        '</div>' +
    '</div>';

        function getItems(list, showMore) {
            var el = '';
            for(var i =0; i<$ctrl[list].length;i++){
                var item = $ctrl[list][i];
                el += '<li ' + (showMore ? 'ng-if="$ctrl.showMore"' : '') + 'class="smaller" tooltip-html="\'' + $ctrl.getTooltip(item) + '\'" tooltip-placement="bottom">' +
                        '<a>' +
                            $ctrl.ImageUploaderService.generateDisplayImage(item, {containerClass: 'pull-left', imgSize: 'smaller', icon: $ctrl.getIcon(item), ingProp: 'logo', areaType: 'circle', item: item, withoutInitials: false}) +
                            '<div class="name">' + $ctrl.getDisplayName(item, true) + '</div>' +
                        '</a>' +
                    '</li>';
            }
            return el;
        }

        function getBtnSend() {
            return '<button type="button" class="btn btn-small primary without-text" ng-click="$ctrl.save($event)" analytics-on analytics-action="Send Contacts Message" ng-class="{\'disabled\': $ctrl.cast.length == 0 || $ctrl.isUpdating}" ng-disabled="$ctrl.cast.length == 0 || $ctrl.isUpdating"><div class="sbf loadingicon animate-spin pull-left" ng-show="$ctrl.isUpdating===true"></div> Send</button>';
        }

        function getBtnAtt() {
            return '<button type="button" class="btn btn-small without-text btnq" analytics-on analytics-action="Add Attachment" ng-click="$ctrl.addAttachment($event)" title="Upload File">'+$ctrl.LCS.getISBDiv('attach', 2, 'sbf16')+'</button>';
        }
    }

    function addAttachment(e){
        $ctrl.preventDefault(e);
        $ctrl.broadcastRoot('ADD_FROM_PAGE_TOP_MATERIAL', {e: e});
    }

    function onSave(result) {
        $ctrl.isUpdating = false;
        $ctrl.broadcastRoot('CLEAR_SELECTED_ROWS_'+$ctrl.elemType);
        $ctrl.closePopup(result);
    }

    function onError(error) {
        $ctrl.isUpdating = false;
        $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.cast.' + $ctrl.type + '.error', 'error');
    }

    function cancelPopup() {
        $ctrl.broadcastRoot('CLEAR_SELECTED_ROWS_'+$ctrl.elemType);
        $ctrl.closePopup({result:'cancel'});
    }

    function save(e) {
        console.log('send contact message');
        $ctrl.preventDefault(e);

        $ctrl.error = null;

        $ctrl.item.subject = $ctrl.element.querySelector('.email-wrapper #' + $ctrl.subjectId).innerText;
        if (!$ctrl.cast || $ctrl.cast.length === 0) {
            $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.cast.error.invalid-cast', 'error');
        } else if (!$ctrl.item.subject) {
            $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.cast.error.invalid-subject', 'error');
        } else if (!$ctrl.item.message) {
            $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.cast.error.invalid-message', 'error');
        } else {
            $ctrl.isUpdating = true;
            $ctrl.item.companyId = $ctrl.CPS.companyId;
            $ctrl.item.productId = $ctrl.CPS.productId;
            $ctrl.item.castIds = ids;
            $ctrl.item.objectType = $ctrl.objectType === 'callsheetInvitations' ? 'callsheetInvitations' : 'cast';
            $ctrl.service.sendMessage($ctrl.item, $ctrl.onSave, $ctrl.onError);
        }
    }

    function getEl(item) {
        return ($ctrl.objectType === 'callsheetInvitations' ? item.cast : item);
    }

    function getIcon(item) {
        var el = getEl(item).name;
        return $ctrl.security.getInitialsByName(el) ? $ctrl.security.getNameColor(el) : 'user';
    }

    function getInitials(item) {
        var el = getEl(item).name;
        return $ctrl.security.getInitialsByName(el);
    }

    function getDisplayName(item, short) {
        var el = getEl(item);
        var res = el.name ? el.name : el.email;
        var l = res ? res.length : 0;
        return short && res && l > $ctrl.minLength ? res.substring(0, $ctrl.minLength) : res;
    }

    function getTooltip(item) {
        var el = getEl(item), name = el.name;
        return name ? (name + ' &lt;' + el.email + '&gt;') : el.email;
    }
}

angular.module('product.contacts.attachments.component', [
    'product.todoFiles.service.controller'
])
.component('messageAttachments', {
    bindings: {
        itemTitle: '<',
        codeName: '<',
        currentListId: '<',
    },
   
    controller: 'MessageAttachmentsCtrl'
})
.controller('MessageAttachmentsCtrl', MessageAttachmentsCtrl);
MessageAttachmentsCtrl.$inject = ['TodoFilesListServiceCtrl', '$element'];

function MessageAttachmentsCtrl(TodoFilesListServiceCtrl, $element) {
    console.log('MessageAttachmentsCtrl');
    var $ctrl = this;

    $ctrl.onPreInit = onPreInit;

    $ctrl.getGridHeader = getGridHeader;
    $ctrl.onRecount = onRecount;

    $ctrl = new TodoFilesListServiceCtrl($ctrl, $element);

    function onPreInit() {
        $ctrl.canEdit = true;
        if(!$ctrl.codeName) {
            $ctrl.codeName = 'message-attachments';
        }
        if(!$ctrl.itemTitle) {
            $ctrl.itemTitle = 'Attachment';
        }
        $ctrl.withSubparentId = $ctrl.currentListId;

        $ctrl.objectType = 'material';
    }

    function getGridHeader() {
    return '<div class="grid-header uppercase semibold clearfix">' +
               $ctrl.LCS.getISBDiv('attach', 2, 'gray pull-left with-margin-right')  + '&nbsp;' +
               '<div class="gridtitle pull-left">' + $ctrl.gridTitle + '</div>' +
            '</div>';
    }

    function onRecount(count){
        console.log('onRecount');
        $ctrl.count = count;
        $ctrl.LCS[count ? 'removeClass' : 'addClass']($ctrl.element, 'sb-hide');
    }
}

angular.module('product.contactsPage.service', [
    'apiConstants.product.contacts.services',
    'product.contacts.page.init.controller.service',
    'product.contacts.item.edit.popup.component',
    'product.contacts.group.component',
    'product.contacts.list.search.component',
    'product.contacts.sendContactsMessagePopup.component',
    'product.contacts.popups',
    'page.tree.simple.controller.service.injector'
])
.constant('ContactsPageCtrlServiceInjectors', {
    pageCtrlService: 'ContactsPageCtrlServiceInit',
    constantsService: 'ContactsConstantsService',
    listOptionsService: 'ContactsListOptionsService',
    service: 'ContactsService'
})
.service('ContactsPageCtrlService', ContactsPageCtrlService);
ContactsPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'ContactsPageCtrlServiceInjectors'];
function ContactsPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    return function ($ctrl, $element, printPageParams) {
    //preloading for cast must share contacts in same table
        $ctrl.checkCustomListOnEmpty = true;

        $ctrl.onPageInitOther = onPageInitOther;
        $ctrl.getRightButtons = getRightButtons;
        $ctrl.getGroupFilterButtonsOther = getGroupFilterButtonsOther;
        $ctrl.getGroupFilterButtonsOtherXS = getGroupFilterButtonsOtherXS;

        $ctrl.getCollabBannerInfo = getCollabBannerInfo;

        $ctrl.canShowShareInMore = canShowShareInMore;
        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);

        return $ctrl;

        function canShowShareInMore(item, isMobile) {
            // return  item && !item.isFolder;
            return false;
        }
        function getCollabBannerInfo(){
            return {txt: 'Organize and send messages to production contacts for free.', campaign:'collab-contacts'};
        }
        function onPageInitOther() {
            $ctrl.listTreeService.preloadingType = $ctrl.PreloadingTypes.Contacts;
        }

        function getGroupFilterButtonsOther() {
            var btnCls = $ctrl.getBtnActionCls();
    return ($ctrl.CPS.productId?(
        '<a ng-show="$ctrl.isActiveFilter()" ng-class="{\'disabled\': $ctrl.keyboardService.SelectedRows.length===0}" class="btn btn-small primary-faded without-text with-margin-left pull-left '+btnCls+'" data-type="processSelectedCustomBtns" data-info="sendMessage" analytics-on analytics-action="Open Send Message to Contacts" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? \'Please select at least one contact to message.\' : (\'Send email to \' + $ctrl.keyboardService.SelectedRows.length + \' contact\' +($ctrl.keyboardService.SelectedRows.length == 1 ? \'\':\'s\'))}}" tooltip-placement="bottom">' +
           $ctrl.LCS.getISBDiv('mail', 2, 'pull-left') +
            ' <div class="pull-left hide-ipad with-padding-left">Send Message</div></a>'):'') +
       ($ctrl.CPS.productId&&$ctrl.CPS.isAuthenticated?('<a ng-show="$ctrl.isActiveFilter()" ng-class="{\'disabled\': $ctrl.keyboardService.SelectedRows.length===0}" class="btn btn-small primary-faded without-text with-margin-left pull-left '+btnCls+'" data-type="processSelectedCustomBtns" data-info="createCallsheet" analytics-on analytics-action="Create Call Sheet via Call" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? \'Please select at least one contact to create a new call sheet\' : \'\'}}" tooltip-placement="bottom">' +
           $ctrl.LCS.getISBDiv('callsheets', 8, 'pull-left') + ' <div class="pull-left hide-ipad with-padding-left">New Call Sheet</div></a>'):'') +
      (!$ctrl.CPS.productId&&$ctrl.CPS.isAuthenticated?('<a ng-show="$ctrl.isActiveFilter()" ng-class="{disabled: $ctrl.keyboardService.SelectedRows.length===0}" class="btn btn-small primary-faded without-text with-margin-left pull-left '+btnCls+'" data-type="processSelectedCustomBtns" data-info="addToProjectList" analytics-on analytics-action="Open Add Contact to Projects Popup" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? \'Please select at least one contact.\' : (\'Assign \' + $ctrl.keyboardService.SelectedRows.length + \' contact\'+($ctrl.keyboardService.SelectedRows.length===1?\'\':\'s\')+\' to a project\')}}" tooltip-placement="bottom">' +
          $ctrl.LCS.getISBDiv('project', 4, 'pull-left') + '</a>'):'') +
       ($ctrl.CPS.isAuthenticated?('<a ng-show="$ctrl.isActiveFilter()" ng-class="{disabled: $ctrl.keyboardService.SelectedRows.length===0}" class="btn btn-small primary-faded without-text with-margin-left pull-left '+btnCls+'" data-type="processSelectedCustomBtns" data-info="addToContactsList" analytics-on analytics-action="Open Add Contact to List Popup" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? \'Please select at least one contact to add to list.\' : (\'Add \' + $ctrl.keyboardService.SelectedRows.length + \' contact\'+($ctrl.keyboardService.SelectedRows.length===1?\'\':\'s\')+\' to List\')}}" tooltip-placement="bottom">' +
           $ctrl.LCS.getISBDiv('list', 2, 'pull-left') + '</a>'):'') +
       '<a ng-show="$ctrl.isActiveFilter()" ng-class="{\'disabled\': $ctrl.keyboardService.SelectedRows.length===0}" class="btn btn-small accent-faded without-text with-margin-left pull-right '+btnCls+'" data-type="processSelectedCustomBtns" data-info="removeContacts"' +
       //'($ctrl.CPS.productId||($ctrl.listTreeService.active.selectedListId && $ctrl.listTreeService.active.selectedListId.length > 12))?$ctrl.processSelectedCustomBtns(\'removeContacts\'):$ctrl.processSelectedGroup(\'Delete\')' +
       ' analytics-on analytics-action="Open Remove Selected items Popup" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? (\'Please select at least one items.\') : (\'Remove \' + $ctrl.keyboardService.SelectedRows.length + \' selected item\'+($ctrl.keyboardService.SelectedRows.length==1?\'\':\'s\'))}}" tooltip-placement="bottom">' +
        $ctrl.LCS.getISBDiv('trash', 2) +
            '</a>';
        }

        function getGroupFilterButtonsOtherXS() {
     return ($ctrl.CPS.productId?(
                    get($ctrl.canEdit, false, 'sendMessage', 'Send Message', 'mail') +
                    get($ctrl.CPS.isAuthenticated, false, 'createCallsheet', 'New Call Sheet', 'callsheets', 8)
            ):'') +
            get(!$ctrl.CPS.productId&&$ctrl.CPS.isAuthenticated, false, 'addToProjectList', 'Assign to Project', 'project') +
            get($ctrl.CPS.isAuthenticated, false, 'addToContactsList', 'Add to List', 'list') +
            get(true, true, 'removeContacts', 'Remove Selected', 'trash');

            function get(cond, isAccent, m, txt, icon, iconLevel ) {
                return cond ? ('<li ng-show="$ctrl.isActiveFilter()"><a class="table-div full-width ' + $ctrl.getBtnActionCls() + (isAccent ? ' accent' : '') + '" ng-class="{disabled: $ctrl.keyboardService.SelectedRows.length===0}" data-type="processSelectedCustomBtns" data-info="'+m+'"' +
                    // '($ctrl.CPS.productId||($ctrl.listTreeService.active.selectedListId && $ctrl.listTreeService.active.selectedListId.length > 12))?$ctrl.processSelectedCustomBtns(\'removeContacts\'):$ctrl.processSelectedGroup(\'Delete\')' +
                    ' analytics-on analytics-action="Open ' + txt + ' Popup">' +
                    '<div class="col30">' + $ctrl.LCS.getISBDiv(icon, iconLevel?iconLevel:2) + '</div> <div>' + txt + '</div>' +
                    '</a></li>') : '';
            }
        }

        function getRightButtons() {
            if(!$ctrl.canEdit){return '';}
            return  '<a ng-show="$ctrl.isActiveFilter()&&($ctrl.CPS.productId&&(!$ctrl.listTreeService.active.selectedList.isPredef || $ctrl.listTreeService.active.selectedListId === \'All\') || !$ctrl.CPS.productId && (!$ctrl.listTreeService.active.selectedList.isPredef && $ctrl.listTreeService.active.selectedListId !== \'All\'))" class="btn btn-small primary-faded without-text with-margin-left hide-lower1024 btnExistingContacts ' + $ctrl.getBtnActionCls() +'" data-type="addExistingContacts" analytics-on analytics-action="Open Existing Contacts">' +
                $ctrl.LCS.getISBDiv('plus', 2, 'pull-left') +
            ' <span class="hide-ipad">Existing Contacts</span></a>' +
                ($ctrl.CPS.productId ? '' : ('<a ng-show="$ctrl.isActiveFilter()&&$ctrl.listTreeService.active.selectedListId===\'All\'" class="btn btn-small primary-faded without-text with-margin-left hide-lower1024 btnExistingContacts ' + $ctrl.getBtnActionCls() +'" data-type="importContacts" analytics-on analytics-action="Open Import Contacts">'+
                    $ctrl.LCS.getISBDiv('upload-2', 3, 'pull-left')+' <span class="hide-ipad">Import Contacts</span></a>'));
        }
    }
}

angular.module('product.contacts.page.init.controller.service', [
    'apiPagination.Contacts',
    'apiServices.ContactsListOptions',
    'apiServices.ContactLists',
    'product.contacts.tree.component',
    'page.group.controller.service'
])
.service('ContactsPageCtrlServiceInit', ContactsPageCtrlServiceInit);
ContactsPageCtrlServiceInit.$inject = ['PageTreeInitCtrlService', 'ContactListsService'];
function ContactsPageCtrlServiceInit(PageTreeInitCtrlService, listsService) {
    return function ($ctrl, $element, initOptions) {
//preloading for cast must share contacts in same table

        $ctrl.treeTag = 'contact';
        $ctrl.onChangedGroupFilters = onChangedGroupFilters;
        $ctrl.addExistingContacts = addExistingContacts;
        $ctrl.importContacts = importContacts;
        $ctrl.getGroupBodyAddon = getGroupBodyAddon;
        $ctrl.preBroadcastPreload = preBroadcastPreload;
        $ctrl.getGroupFilterButtonsInit = getGroupFilterButtonsInit;
        $ctrl.getGroupFilterButtonsInitXS = getGroupFilterButtonsInitXS;
        if(!$ctrl.checkShowAddNewItem) {
            $ctrl.checkShowAddNewItem = checkShowAddNewItem;
        }
        $ctrl.getParams = getParams;
        $ctrl.getTreeFilters = getTreeFilters;

        if(!$ctrl.getGroupFilters) {
            $ctrl.getGroupFilters = getGroupFilters;
        }
        if(!$ctrl.getGroupOrder) {
            $ctrl.getGroupOrder = getGroupOrder;
        }

        $ctrl.getDrpSettingsOther = getDrpSettingsOther;
        $ctrl.withExistingBtn = withExistingBtn;
        $ctrl.withImportBtn = withImportBtn;

        if(!$ctrl.serviceName) {
            $ctrl.serviceName = 'ContactsPageCtrlServiceInit';
        }
        $ctrl.onPageTreeInit = onPageTreeInit;

        $ctrl = new PageTreeInitCtrlService($ctrl, $element, _.extend({
            listsService: listsService,
            otherOptions: {},
        }, initOptions));


        $ctrl.sidebarOptions = _.extend({}, $ctrl.sidebarOptions, {
            changedFields: ['selectedFilter']
        });

        return $ctrl;

        function withExistingBtn() {
            var id = $ctrl.listTreeService.active ? $ctrl.listTreeService.active.selectedListId : undefined,
                isAll = id === 'All',
                isPredef = id !== undefined && $ctrl.listTreeService.active.selectedList ?
                    $ctrl.listTreeService.active.selectedList.isPredef : false;
            return $ctrl.CPS.productId && $ctrl.isActiveFilter() || //project contacts active
                  !$ctrl.CPS.productId && (!isPredef && !isAll);  //general contacts - custom lists
        }

        function withImportBtn(){
            var id = $ctrl.listTreeService.active ? $ctrl.listTreeService.active.selectedListId : undefined;
            return $ctrl.isActiveFilter() && (id === 'All');
        }

        function getDrpSettingsOther() {
            /*'<li ng-if="$ctrl.withExistingBtn()" class="show-ipad">' +
                '<a class="fixed-layout table-div" ng-click="$ctrl.addExistingContacts($event)">' +
                '<div class="col30 with-margin-right">' +
                $ctrl.LCS.getISBDiv('plus-circled', 2) +
                '</div>' +
                '<div><div class="with-ellipsis">'+'Add Existing '+$ctrl.itemTitle+'s'+'</div></div>' +
                '</a>' +
                '</li>' +*/
            return (!$ctrl.CPS.productId  ? ('<li ng-if="$ctrl.withImportBtn()" class="show-ipad">' +
                    '<a class="fixed-layout table-div" ng-click="$ctrl.importContacts($event)">' +
                    '<div class="col30 with-margin-right">' +
                    $ctrl.LCS.getISBDiv('upload-2', 3) +
                    '</div>' +
                    '<div><div class="with-ellipsis">'+'Import '+$ctrl.itemTitle+'s'+'</div></div>' +
                    '</a>' +
                    '</li>') : '');
        }

        function onPageTreeInit() {
            $ctrl.listTreeService.getGroupOrder = $ctrl.getGroupOrder;

            if ($ctrl.onPageInitOther) {
                $ctrl.onPageInitOther();
            }
            $ctrl.onPageInit();

            if ($ctrl.onPostPageInitOther) {
                $ctrl.onPostPageInitOther();
            }
        }

        function getGroupOrder(id) {
            if (!id || id === 'All') {
                id = '0';
            }
            var o = {};
                                    //predef list
            o['orderLists.c_' + ((id.length < 16 && id !== '0') ? (($ctrl.CPS.productId ? $ctrl.CPS.product.contactListId : '0') + '_' + id) : (id + '_All'))] = 1;
            return o;
        }

        function getGroupFilters() {
            var params = {};
            if ($ctrl.productContactListId) {
                params.productContactListId = $ctrl.productContactListId;
            }

            //todo getGroupFiltersOther???
            return params;
        }

        function getTreeFilters(item) {
            //dont check if is active or not - get all active and archived
            /*var exists = $ctrl.isActiveFilter() ? (item.isHarcoded || item.active) : (!item.isHarcoded && !item.active);
            if(!exists){return false;}*/
            return item.productId === ($ctrl.CPS.productId ? $ctrl.CPS.productId : null) || item.isHarcoded;
        }

        function getParams() {
            return _.extend({
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId ? $ctrl.CPS.productId : null,
            }, $ctrl.getParamsOther ? $ctrl.getParamsOther() : {});
        }

        function checkShowAddNewItem() {
            return $ctrl.isNotEmptyGroupState() && $ctrl.isActiveFilter();
        }

        function getGroupFilterButtonsInit() {
            return '';
        }

        function getGroupFilterButtonsInitXS() {
            return '';
        }

        function getGroupBodyAddon() {
            return _.extend({
                'positions': '"::$ctrl.positions"',
                'departments': '"::$ctrl.departments"'
            }, $ctrl.getGroupBodyAddonOther ? $ctrl.getGroupBodyAddonOther() : null);
        }

        function onChangedGroupFilters(type) {
            console.log('onChangedGroupFilters: type='+type);
            if (type === 'treeType') {
                $ctrl.listTreeService.active.selectedList = undefined;
                $ctrl.listTreeService.active.selectedListId = undefined;
                $ctrl.preBroadcastPreload();
            }
        }

        function preBroadcastPreload() {
           var preLoadingService = $ctrl.listTreeService.preLoadingService;
            $ctrl.listTreeService.level0Name = $ctrl.CPS.productId ? 'Project Contacts' : 'All Contacts';
            $ctrl.listTreeService.sidebarTitle = 'Filter By';

            $ctrl.productContactListId = $ctrl.CPS.product ? $ctrl.CPS.product.contactListId : null;
            if (!$ctrl.positions) {
                $ctrl.departments = preLoadingService.getList(preLoadingService.TblTypes.Departments);
                $ctrl.positions = preLoadingService.getList(preLoadingService.TblTypes.Positions);
            }
            if($ctrl.preBroadcastPreloadOther){
                $ctrl.preBroadcastPreloadOther();
            }
        }

        function addExistingContacts(type, e) {
            $ctrl.preventDefault(e);
            $ctrl.broadcastRoot('ADD_EXISTING_CONTACTS', {e: e});
        }

        function importContacts(type, e) {
            $ctrl.preventDefault(e);
            $ctrl.broadcastRoot('IMPORT_CONTACTS', {e: e});
        }

        function hasSidebar() {
            return !($ctrl.CPS.isCollaborator && $ctrl.listTreeService.isSingleList);
        }
    }
}

angular.module('product.contacts.assign.component', [
    'product.invite.assign.controller.service'
])

.component('addExistingContactsPopup', popupComponentParams('AddExistingContactsPopupCtrl'))
.controller('AddExistingContactsPopupCtrl', AddExistingContactsPopupCtrl);
AddExistingContactsPopupCtrl.$inject = ['AssignContactsCtrlService', '$element'];
function AddExistingContactsPopupCtrl(AssignContactsCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.preInitOther = preInitOther;
    $ctrl.postInitOther = postInitOther;
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.preTemplate = preTemplate;
    $ctrl.postTemplate = postTemplate;

    $ctrl = new AssignContactsCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitOther() {
        $ctrl.popupType = 'assign-contacts';
        $ctrl.productContactListId = $ctrl.extraParam.productContactListId;
        $ctrl.currentListId = $ctrl.extraParam.currentListId;

        $ctrl.placeholder = 'Search by name, email, project name, or list…';
        $ctrl.errormessage = null;
        $ctrl.icon = 'user';
        $ctrl.contactType = $ctrl.extraParam.isCustomList ? 'List' : 'Project';
    }

    function postInitOther() {
        $ctrl.showEmail = true;
        $ctrl.showResults = true;
        $ctrl.showResults = false;
        $ctrl.hasAutoFocus = true;

        $ctrl.getLogoPath = getLogoPath;
        $ctrl.getDisplayName = getDisplayName;
        $ctrl.getEmail = getEmail;
        $ctrl.assignMultiple = assignMultiple;
        $ctrl.searchItems = searchItems;
        $ctrl.getAssignedItem = getAssignedItem;
        $ctrl.getCheckedItem = getCheckedItem;

        $ctrl.getIcon = getIcon;
        $ctrl.getInitials = getInitials;

        $ctrl.specialClass='with-underline';
        $ctrl.showEmptyState=true;

        $ctrl.reloadTemplate();
    }

    function preTemplate() {
        return '<div class="search-contacts" style="border-radius: 10px;">';
    }

    function postTemplate() {
        return '</div>';
    }

    function setTemplateData() {
        $ctrl.icon = null;
        $ctrl.popupTitle = 'Add Existing Contacts to this '+ $ctrl.contactType;
        $ctrl.withFooterBtns = true;
        $ctrl.btnText = 'Add {{$ctrl.$select.selected.length}} Contact{{$ctrl.$select.selected.length === 1?\'\':\'s\'}} to '+$ctrl.contactType;

        $ctrl.textAnalytics = $ctrl.popupTitle;

        $ctrl.firstBtnMethod = 'assign';
    }

    function getPopupBodyContent() {
        return $ctrl.getErrorBlock() + $ctrl.getSearchForm();
    }

    function getLogoPath(item) {
        return $ctrl.security.getLogoPath(item, 'logo', 100);
    }

    function getDisplayName(item, short) {
        var res;
        switch (item.type) {
            case 'contact':
                res = item.name ? item.name : item.email;
                break;
            case 'list':
                res = '<span class="named">' + (item.productId ? 'Project' : 'General') + ' List: </span>' + item.name;
                break;
            case 'project':
                res = ' <span class="named">Project: </span>' + item.name;
                break;
        }
        var l = item.type === 'contact' ? res.length : item.name.length;
        return short && res && l > $ctrl.minLength ? res.substring(0, $ctrl.minLength) : res;
    }

    function getEmail(item) {
        return item.email && item.name ? (' (' + item.email + ')') : '';
    }

    function assignMultiple(sendEmails, selItems, items) {
        if (!items ||!items.length) {
            return false;
        }

        var contactList = {
            type: $ctrl.contactType,
            contactListId: $ctrl.currentListId,
            productId: $ctrl.CPS.productId
        };
        if ($ctrl.productContactListId) {
            contactList.productContactListId = $ctrl.productContactListId;
        }

        $ctrl.service.addContactsToList({
            companyId: $ctrl.CPS.companyId,
            castIds: items,
            contactLists: [contactList]
        }, $ctrl.onSave, $ctrl.onError);
    }

    function searchItems(search, x, onSuccess, onError) {
        $ctrl.preLoadingService.searchContactsNotInList({
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId,
            contactListId: $ctrl.currentListId,
            q: search
        }, onSuccess, onError);
    }

    function getAssignedItem(item) {
        console.log('assign contacts popup getAssignedItem');
        var p = {_id: item._id, type: item.type};
        if (item.type !== 'contact') {
            p.productId = item.productId;
        }
        return p;
    }

    function getCheckedItem(item) {
        return item._id;
    }


    function getIcon(item) {
        return item.type === 'project' ? 'project' : (item.type === 'list' ? 'list' : ($ctrl.security.getInitialsByName(item.name) ? $ctrl.security.getNameColor(item.name) : 'user'));
    }

    function getInitials(item) {
        return item.type === 'contact' ? $ctrl.security.getInitialsByName(item.name) : null;
    }
}

angular.module('product.contacts.adjustRoles.popup.component', [
    'apiServices.Contacts',
    'product.contacts.adjustRoles.init.controller.service'
])
.component('adjustRolesPopup', popupComponentParams('AdjustRolesPopupComponent'))
.controller('AdjustRolesPopupComponent',  AdjustRolesPopupComponent);
AdjustRolesPopupComponent.$inject = ['ListItemPopupTemplateCtrlService', 'ContactsService', 'AdjustRolesInitCtrlService', '$element'];
function AdjustRolesPopupComponent(ListItemPopupTemplateCtrlService, ContactsService, AdjustRolesInitCtrlService, $element) {
    var $ctrl = this;


    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.postInitOther = postInitOther;

    $ctrl = new ListItemPopupTemplateCtrlService($ctrl, $element);

    $ctrl.castItem = {};

    function deepClone(roles){
        return _.deepClone(roles);
    }

    function postInitOther() {
        $ctrl.callsheetId = $ctrl.extraParam.callsheetId;
        $ctrl.productContactListId = $ctrl.CPS.product ? $ctrl.CPS.product.contactListId : null;
        $ctrl.showOverlay = $ctrl.extraParam.showOverlay;

        $ctrl.tooltip = 'Make this the default role for the contact. Will apply to future ';
        if($ctrl.callsheetId){
            var cast = $ctrl.extraParam.cast;
            if(cast) {
                $ctrl.castItem._id = cast._id;
                $ctrl.castItem.roles = deepClone(cast.roles);
                $ctrl.castItem.contactLists = deepClone(cast.contactLists);
                $ctrl.tooltip += 'call sheets';
            }
        }else{
            $ctrl.tooltip += 'projects';
        }
        $ctrl.isEditCallsheet =  $ctrl.extraParam.isEditCallsheet;
        $ctrl.ContactsService = ContactsService;
        $ctrl = new AdjustRolesInitCtrlService($ctrl);

        $ctrl.getData = getData;
        $ctrl.save = save;
    }

    function getData(item, productContactListId) {
        var itemRoles = $ctrl.itemRoles,
            data = null,
            roles = $ctrl.updateRoles(deepClone(itemRoles)),
            genRoles = item.roles,
            genComp = $ctrl.service.compareObjects(itemRoles, genRoles, true),

            cl = productContactListId ? item.contactLists : null,
            contactLists = cl ? cl['c_' + productContactListId] : null,
            prodRoles = productContactListId ? contactLists.roles : null,
            prodComp = $ctrl.service.compareObjects(itemRoles, prodRoles, true);

        if(!genComp && ( !productContactListId || productContactListId && $ctrl.setDefault)) {
            data = {roles: roles};
        }

        if(!prodComp && productContactListId){
            if(!data){data = {};}
            if(!data.contactLists){data.contactLists = deepClone(cl) || {};}
            data.contactLists['c_' + productContactListId] = deepClone(contactLists);
            if(!data.contactLists['c_' + productContactListId]){
                data.contactLists['c_' + productContactListId] = {};
            }
            data.contactLists['c_' + productContactListId].roles = roles;
        }

        return data;
    }

    function save(e) {
        $ctrl.preventDefault(e);
        console.log('onAdjustRole');
        var keepEmpty = true;
        $ctrl.error = null;
        _.each($ctrl.itemRoles, function(r, i){
            if(r.posId){$ctrl.itemRoles[i].posId = parseInt(r.posId, 10);}
        });
        var roles = $ctrl.updateRoles($ctrl.itemRoles, keepEmpty);
        $ctrl.error = $ctrl.validCrewPositions(roles);
        if ($ctrl.error) {
            return false;
        }

        $ctrl.formHolderItem.formItem_attempted = true;
        if (!($ctrl.formHolderItem.formItem && $ctrl.formHolderItem.formItem.$valid)) {
            return false;
        }

        if (!$ctrl.itemRoles || $ctrl.itemRoles.length === 0) {
            $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.cast.zeroroles.error');
            return false;
        }

        var tasks = [];

        addTask($ctrl.callsheetId, $ctrl.service, $ctrl.item, $ctrl.copyItem, $ctrl.callsheetId ? null : $ctrl.productContactListId, $ctrl.elemType);

        if($ctrl.callsheetId && $ctrl.setDefault){ //get if set default and is callsheet
            addTask(false, $ctrl.ContactsService, $ctrl.castItem, $ctrl.castItem, $ctrl.productContactListId, 'CONTACT');
        }

        async.parallel(tasks, function (err, result) {
            if(err || !result) {return;}
            $ctrl.closePopup();
        });
        
        function addTask(callsheetId, service, item, prevItem, productContactListId, elemType) {
            tasks.push(function (c) {
                var data = $ctrl.getData(prevItem, productContactListId);
                if (!data) {
                    $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.cast.updateroles.error');
                    c();//c($ctrl.error);
                    return false;
                }

                $ctrl.isUpdating = true;
                if(callsheetId){
                    data = _.extend(data, {
                        productId : $ctrl.CPS.productId,
                        callsheetId: callsheetId
                    });
                }
                service.update(_.extend(data, {
                    _id: item._id,
                    companyId: $ctrl.CPS.companyId
                }), onSuccess, onError);

                function onSuccess(result) {
                    var prop = 'roles',
                        el = result.item,
                        updates = {};
                    result.isPopup = true;

                    if (el) {
                        if (productContactListId) {
                            item.contactLists['c_' + productContactListId][prop] = el.contactLists['c_' + productContactListId][prop];

                            updates.contactLists = el.contactLists;
                        }
                        var r1 = el[prop],
                        r2 = $ctrl.copyItem.roles;

                        if(!iseq(r1, r2)) {
                            item[prop] = r1;
                            updates[prop] = r1;
                        }
                        updates._id = item._id;
                        result.editchanges = updates;
                    }

                    onSave(result);

                    function iseq(r1, r2) {
                        return $ctrl.service.compareObjects(r1, r2, true);
                    }
                }

                function onError(error) {
                    $ctrl.isUpdating = false;
                    $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.cast.updateroles.error');
                    c($ctrl.error);
                    //$ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.gridItem.success.nochanges');
                }

                function onSave(result) {
                    $ctrl.isUpdating = false;
                    $ctrl.broadcastRoot('UPDATED_' + elemType + '_ITEM', result);
                    var currentListId = $ctrl.extraParam.currentListId;

                    //refresh list in case roles change
                    $ctrl.LCS.timeout(function () {
                        $ctrl.broadcastRoot('TREE_SERVICE_RELOAD_LIST_' + $ctrl.elemType, currentListId);
                    }, 300);

                    if($ctrl.isEditCallsheet && callsheetId){
                     /*   var roles = $ctrl.itemRoles && $ctrl.itemRoles.length>0 ? $ctrl.itemRoles : null,
                            list = [];
                        if(roles) {
                            _.each(roles, function (r) {
                                list.push(r.type);
                            });
                        }
                        list = _.unique(list);
                        _.each(list, function (filterRole) {
                            var prop = 'LOAD_GROUP' +'_' + elemType + '_' + filterRole + '_'+  callsheetId;
                            console.log(prop);
                            $ctrl.broadcastRoot(prop);
                        });*/
                    }else if(currentListId !== undefined) {
                        $ctrl.broadcastRoot('COUNTER_CHANGED_' + elemType + '_TREE', {ids: [currentListId]});
                    }
                    c(null, 'success');
                }
            });
        }
    }

    function setTemplateData() {
        $ctrl.icon = 'pencil';
        $ctrl.popupTitle = 'Assign Role '+($ctrl.item.name ? ('to ' + $ctrl.item.name) : '');
        $ctrl.withFooterBtns = true;
        $ctrl.firstBtnMethod = 'save';
        $ctrl.btnText = $ctrl.isNew ? 'Add Roles' : 'Apply Changes';
    }

    function getPopupBodyContent() {
    return '<form name="$ctrl.formHolderItem[$ctrl.formName]" novalidate autocomplete="off">' +
                 $ctrl.getAddRoles('spacing-half-top', 1) +
             '</form>';
     }
}

angular.module('product.contacts.list.search.component', [
    'apiServices.ContactLists',
    'product.invite.assign.controller.service'
])
.component('assignProjectsPopup', popupComponentParams('AssignProjectsPopupCtrl'))
.controller('AssignProjectsPopupCtrl', AssignProjectsPopupCtrl);
AssignProjectsPopupCtrl.$inject = ['AssignContactsCtrlService', '$element'];
function AssignProjectsPopupCtrl(AssignContactsCtrlService, $element) {

    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.preInitOther = preInitOther;
    $ctrl.postInitOther = postInitOther;
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new AssignContactsCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitOther() {
        $ctrl.popupType = 'assign-projects';
        $ctrl.contactType = $ctrl.extraParam.contactType;
        $ctrl.isProjectType = $ctrl.contactType === 'Project';
        $ctrl.icon = $ctrl.isProjectType ? 'project' : 'list';
        $ctrl.popupTitle = ($ctrl.isProjectType ? 'Assign' : 'Add') + ' to ' + $ctrl.contactType+'s';

        $ctrl.placeholder = 'Search existing ' + $ctrl.contactType.toLowerCase()+'s…';
        $ctrl.errormessage = 'Please enter a valid name so we can assign this ' + $ctrl.contactType.toLowerCase();
    }

    function postInitOther() {
        $ctrl.getLogoPath = getLogoPath;
        $ctrl.getDisplayName = getDisplayName;
        $ctrl.getEmail = getEmail;
        $ctrl.assignMultiple = assignMultiple;
        $ctrl.searchItems = searchItems;
        $ctrl.getAssignedItem = getAssignedItem;
        $ctrl.getCheckedItem = getCheckedItem;

        $ctrl.removeExisting = removeExisting;
        $ctrl.initList = initList;
        $ctrl.addItem = addItem;
        $ctrl.removeItem = removeItem;
        $ctrl.specialClass='with-underline';
        $ctrl.selectChoicesCls = 'taller-li'
        $ctrl.withSearchTooltip=false;

        load();
    }

    function setTemplateData() {
        $ctrl.modalBodyClass = 'invite';
        $ctrl.withFooterBtns = true;
        $ctrl.firstBtnMethod = 'assign';
        var txt = ($ctrl.isProjectType ? 'Assign' : 'Add') + ' to ' + $ctrl.contactType + ($ctrl.$select.selected.length ===1 ? ''  : 's');
        $ctrl.btnText = txt;
        $ctrl.textAnalytics = txt;
    }

    function getPopupBodyContent() {
       if($ctrl.noLists) {
           $ctrl.withFooterBtns = false;
           return '<p class="text-center">There are no contact lists.</p>';
       }
        return ($ctrl.initItems && $ctrl.initItems.length ? $ctrl.getSearchForm() : '<p class="text-center">Selected contacts have been added to all the available lists.</p>');
    }

    function load() {
        var lists = $ctrl.preLoadingService.getObjectList($ctrl.preLoadingService.TblTypes.ContactLists);
        if($ctrl.isProjectType){
            $ctrl.preLoadingService.loadProducts(next);
        }else{
            lists = _.filter(lists, function (item) {
                return !item.isPredef && $ctrl.CPS.productId === item.productId && item.active!==false;
            });
            if(lists.length === 0){
                $ctrl.noLists = true;
            }
            next(lists);
        }

        function next(list) {
            $ctrl.initList($ctrl.removeExisting(list, $ctrl.extraParam.existing));
            $ctrl.reloadTemplate();
        }
    }

    function getLogoPath(item) {
        return $ctrl.security.getLogoPath(item, 'logo', 100);
    }

    function getAssignedItem(item) {
        console.log('assign projects popup getAssignedItem');
        var el = $ctrl.isProjectType ? {
            contactListId: item.contactListId,
            productId: item._id
        } : {
            contactListId: item._id,
            productId: item.productId
        };
        el.type = $ctrl.contactType;
        return el;
    }

    function getCheckedItem(item) {
        return item;
    }

    function assignMultiple(sendEmails, castIds, items) {
        var contactList = {
            type: $ctrl.type,
            contactListId: $ctrl.currentListId,
            productId: $ctrl.CPS.productId
        };
        if ($ctrl.productContactListId) {
            contactList.productContactListId = $ctrl.productContactListId;
        }

        $ctrl.contactLists = items;
        $ctrl.service.addContactsToList({
            companyId: $ctrl.CPS.companyId,
            castIds: castIds.map(function (id) {
                return {
                    _id: typeof(id) === 'string' ? id : id._id,
                    type: 'contact'
                };
            }),
            contactLists: items
        }, $ctrl.onSave, $ctrl.onError);
    }

    function searchItems(search, itemId, onSuccess, onError) {
        $ctrl.availableItems = search ? _.filter($ctrl.initItems, function (item){
            return item.name ? item.name.match(new RegExp(search, 'gi')) : false;
        }) : $ctrl.initItems;
        $ctrl.isSearching = false;
        $ctrl.setOpen(true);
    }

    function getDisplayName(item, short) {
        var res = item.name ? (item.name.indexOf('Project ') === 0 ? item.name.substring(8, item.name.length) : item.name) : item.email;
        return short && res && res.length > 25 ? res.substring(0, 25) : res;
    }

    function getEmail(item) {
        return item.email && item.name ? (' (' + item.email + ')') : '';
    }

    function removeExisting(projects, existing) {
        projects = angular.copy(projects);
        existing = angular.copy(existing);
        if (existing && existing.length > 0 && projects) {
            for (var j = projects.length - 1; j >= 0; j--) {
                if (existing.length === 0) {
                    break;
                }
                for (var i = existing.length - 1; i >= 0; i--) {
                    if (projects[j]._id === existing[i]) {
                        projects.splice(j, 1);
                        existing.splice(i, 1);
                        break;
                    }
                }
            }
        }

        return projects ? projects : [];
    }

    function initList(items) {
        $ctrl.initItems = items;
        $ctrl.availableItems = $ctrl.initItems;
    }

    function addItem(item) {
        if ($ctrl.existsItem(item) === -1) {
            $ctrl.$select.selected.push(item);
            for (var j = $ctrl.initItems.length - 1; j >= 0; j--) {
                if (item._id === $ctrl.initItems[j]._id) {
                    $ctrl.initItems.splice(j, 1);
                    break;
                }
            }
            $ctrl.clearSearch();
        }
        else {
            $ctrl.isDuplicate = true;
        }
    }

    function removeItem(item) {
        var index = $ctrl.existsItem(item);
        if (index !== -1) {
            $ctrl.$select.selected.splice(index, 1);
            $ctrl.initItems.push(item);
        }
    }
}

angular.module('product.invite.assign.controller.service', [
    'user.search',
    'apiServices.Contacts'
])
.service('AssignContactsCtrlService', AssignContactsCtrlService);
AssignContactsCtrlService.$inject = ['ItemTemplateCompileCtrlService', 'ContactsService', 'SearchInitCtrlService'];
function AssignContactsCtrlService(ItemTemplateCompileCtrlService, ContactsService, SearchInitCtrlService) {
    return function ($ctrl, $element, isPopup) {

        $ctrl.dontAutoloadTemplate = true;

        $ctrl.preInit = preInit;
        $ctrl.isBtnDisabled = isBtnDisabled;

        $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function preInit() {
            $ctrl.preLoadingService = $ctrl.extraParam.preLoadingService;
            $ctrl.service = ContactsService;
            $ctrl.extraParam.service = $ctrl.service;

            if($ctrl.preInitOther) {
                $ctrl.preInitOther();
            }

            $ctrl = new SearchInitCtrlService($ctrl);

            if($ctrl.postInitOther) {
                $ctrl.postInitOther();
            }
        }

        function isBtnDisabled() {
            return $ctrl.isOpened() || !$ctrl.$select || !$ctrl.$select.selected || !$ctrl.$select.selected.length;
        }
    }
}

