    },

    PopupOperations = {
        createCalendar: {
            type: 'Create',
            template: popupTemplate,
            size: 'fieldset',
            transp: 'transparent'
        },
        duplicateCalendar: {
            type: 'Duplicate',
            template: popupTemplate,
            size: 'fieldset',
            transp: 'transparent',
        },
        updateCalendar: {
