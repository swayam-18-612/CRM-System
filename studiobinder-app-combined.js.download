angular.module('product.callsheet.edit.recipients.item.grid.component', [
    'groupBlock.item.controller.service',
    'product.contacts.item.grid.init.controller.service'
])

.component('callsheetRecipientsItemGrid', itemBlockGroupGridItemParams( {
    depId: '@',
    onGetAdjustRoles: '&',
}, 'CallsheetRecipientsItemGridCtrl'))

.controller('CallsheetRecipientsItemGridCtrl', CallsheetRecipientsItemGridCtrl);
CallsheetRecipientsItemGridCtrl.$inject = ['CastGridItemInitCtrlService', 'GridBlockItemGroupInitCtrlService', 'ContactsService', '$element'];
function CallsheetRecipientsItemGridCtrl(CastGridItemInitCtrlService, GridBlockItemGroupInitCtrlService, ContactsService, $element) {
    console.log('CallsheetRecipientsItemGridCtrl: $onInit');
    var $ctrl = this;

    $ctrl.ContactsService = ContactsService;

    $ctrl.bindingNamesOther = ['changeDetails'];

    $ctrl.propShow = 'showDetails';
    $ctrl.changeDetails = changeDetails;
    $ctrl.updateEditableItemPropsAll = updateEditableItemPropsAll;

    $ctrl.postInitItem = postInitItem;

    $ctrl = new CastGridItemInitCtrlService($ctrl);

    $ctrl = new GridBlockItemGroupInitCtrlService($ctrl, $element);

    function postInitItem() {
        setClasses();
    }

    function updateEditableItemPropsAll(changes) {
        if ($ctrl.hasPropChanged(changes, $ctrl.propShow)) {
            setClasses();
        }
    }

    function setClasses() {
        var show = $ctrl.item[$ctrl.propShow];
        $ctrl.LCS[show? 'addClass':'removeClass']($ctrl.elRowSchedule, 'show-details');
        var el = $ctrl.element.querySelector('.toggleDetails');
        if(el) {
            var txt = (show ? 'Hide' : 'Show') + ' Details';
            el.setAttribute('tooltip', txt);
            el.setAttribute('tooltip-clear-cache', true);
            //var el1 = el.querySelector('.tooltip-inner'); if (el1) {el1.innerText = txt;}
            var toggle = el.querySelector('.sbf');
            if (toggle) {
                $ctrl.LCS.replaceClass(toggle, show ? 'eye' : 'eye-hidden', show ? 'eye-hidden' : 'eye');
            }
        }
    }

    function changeDetails(e) {
        console.log('changeDetails');
        $ctrl.preventDefault(e);
        var data = { _id: $ctrl.item._id};
        data[$ctrl.propShow] = $ctrl.item[$ctrl.propShow] ? false : true;
        $ctrl.service.update(_.extend({
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId,
            callsheetId: $ctrl.CPS.callsheetId
        }, data), function (result) {
            result.editchanges = data;
            $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result);
        }, function (error) {
            console.log(error);
        });
    }
}

angular.module('product.callsheet.talentCrewGroupCtrl.service', [
    'product.callsheet.edit.recipients.item.grid.component',
    'product.callsheet.block.init.controller.service',
    'apiPagination.CallsheetInvitations'
])
    .service('TalentCrewGroupCtrlService', TalentCrewGroupCtrlService);
TalentCrewGroupCtrlService.$inject = ['CallsheetBlockGroupCtrlService', 'CallsheetInvitationsPagination', 'CallsheetRecipientsGroupExtendedCtrl', 'CallsheetConstantsService'];
function TalentCrewGroupCtrlService(CallsheetBlockGroupCtrlService, Pagination, CallsheetRecipientsGroupExtendedCtrl, CallsheetConstantsService) {
    return function ($ctrl, $element) {
        $ctrl.CallsheetConstantsService = angular.copy(CallsheetConstantsService);
        $ctrl.CastStatuses = $ctrl.CallsheetConstantsService.CastStatuses;
        $ctrl.isEditCallsheet = true;
        $ctrl.propShow = 'showDetails';

        if(!$ctrl.constantsService){$ctrl.constantsService = {};}
        if(!$ctrl.constantsService.CompOptions){$ctrl.constantsService.CompOptions = {};}
        if(!$ctrl.constantsService.CompOptions.objectType){  $ctrl.constantsService.CompOptions.objectType = 'recipient';}
        if(!$ctrl.constantsService.CompOptions.itemTitle){$ctrl.constantsService.CompOptions.itemTitle = 'Recipient';}
        if(!$ctrl.constantsService.CompOptions.elemType){$ctrl.constantsService.CompOptions.elemType = 'RECIPIENT';}

        if(!$ctrl.constantsService.ListParams) {
            $ctrl.constantsService.ListParams = {
                includeFields: ['companyId', 'productId', 'callsheetId', 'castId', 'calltime', 'roles', 'orderLists', 'info', $ctrl.propShow],
                populate: ''
            };
        }

        $ctrl.constantsService.CompOptions.preLoadingTableName = 'CallsheetInvitations';

        var c = parseInt($ctrl.currentListId, 10);
        if(!$ctrl.constantsService.GroupSettings){$ctrl.constantsService.GroupSettings = {};}
        if(!$ctrl.constantsService.GroupSettings.colType){$ctrl.constantsService.GroupSettings.colType = 'recipients';}
        $ctrl.constantsService.GroupSettings.rolesgrid = c === 2 ? 'CrewAndUnassigned' : c;

        $ctrl.withProperty = withProperty;
        $ctrl.listItemsQuery = listItemsQuery;
        $ctrl.getStat = getStat;
        $ctrl.getPosition = getPosition;
        $ctrl.showColumnOther = showColumnOther;
        //todo see if nec: for displaying mobile
        // $ctrl.processGridItemColumnView = processGridItemColumnView;
        $ctrl.create = create;
        $ctrl.getMoreInfoBtnTemplate = getMoreInfoBtnTemplate;
        $ctrl.getRowViewMobileDetails = getRowViewMobileDetails;
        $ctrl.processListItemColumn = processListItemColumn;
        $ctrl.onBlockLoaded = onBlockLoaded;
        $ctrl.onPostloadGroup = onPostloadGroup;
        $ctrl.preloadSettings = preloadSettings;

        $ctrl.getGroupOrder = getGroupOrder;
        $ctrl.onRemoved = onRemoved;

        $ctrl = new CallsheetRecipientsGroupExtendedCtrl($ctrl);
        $ctrl = new CallsheetBlockGroupCtrlService($ctrl, $element, Pagination);

        return $ctrl;

        function getGroupOrder(id) {
            var o = {};
            o['orderLists.c_' + (id || 'All')] = 1;
            return o;
        }

        function preloadSettings(){
            $ctrl.positions = $ctrl.preLoadingService.getPositions();
            $ctrl.departments = $ctrl.preLoadingService.getDepartments();
        }

        function getGroupEvent(id){
            return 'LOAD_GROUP' + getPrefix() + '_' + $ctrl.elemType + '_' + id + '_'  +$ctrl.callsheetId;
        }

        function onBlockLoaded() {
            if(!$ctrl.uIdRootWatcher) {
                $ctrl.uIdRootWatcher = $ctrl.addRootWatcher(getGroupEvent($ctrl.currentListId), $ctrl.loadGroupTemplate);
            }
            if($ctrl.canEdit) {
                // $ctrl.addRootWatcher('POSITIONS_CHANGED', onPositionsChanged);
            }
        }

        function getPrefix(){
            return $ctrl.isPrintLayout ? '_PRINT_LAYOUT' : '';
        }

        //todo see if nec
        function onPositionsChanged(result) {
            $ctrl.positions = result.positions;
            $ctrl.departments = result.departments;
            $ctrl.afterProcessUpdates();
        }

        function onRemoved(result){
            console.log('onRemoved');
            $ctrl.LCS.timeout(function () {
                $ctrl.loadGroupTemplate({forceReload: true});
                reloadGroups(result && result.item ? result.item.roles : null);
            });
        }

        function onPostloadGroup(result) {
            if ($ctrl.canEdit) {
                $ctrl.LCS.timeout(function () {
                    $ctrl.broadcastRoot('TOP_PERSONS_CHANGED', $ctrl.callsheetId);
                    reloadGroups($ctrl.isEditCallsheet && result && result.editchanges ? result.editchanges.roles : null);
                }, 500);
            }
        }

        function reloadGroups(roles) {
            var list = [];
            if (roles) {
                _.each(roles, function (r) {
                    if (r.type.toString() !== $ctrl.currentListId.toString()) {
                        list.push(r.type);
                    }
                });
            }
            list = _.unique(list);
            if (list.length > 0) {
                _.each(list, function (filterRole) {
                    $ctrl.broadcastRoot(getGroupEvent(filterRole), {dontTriggerSetSortable: true});
                });
            }
        }

        function withProperty() {
            return {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                callsheetId: $ctrl.callsheetId,
                roles: $ctrl.rolesgrid
            };
        }

        function create() {
            console.log('create');
            $ctrl.broadcastRoot('ADD_CALLSHEET_RECIPIENTS', $ctrl.rolesgrid);
        }

        function getAddInfo(item){
            if( $ctrl.elemType === 'EXTRA'){return;}

            var length = 18,
                info = {
                    picture: null,// getLogoPath(item.cast, 'profilePictureURL', 100),
                    name: getName(),
                },
                email = getEl('email');

            info = _.extend(info, {
                email: email,
                shortEmail: email,
                tooltipEmail: getTooltipProp('email'),
                phone: item.cast ? item.cast.phone : null,

                pickup: '–',
                costumes: '–',
                wrap: '–',
                onset: '–',
                hmu: '–',

                status: '–',
                no: '–',

                hrefEmail: info.phone ? ('mailto:+' + email) : '',
                hrefPhone: info.phone ? ('tel:' + info.phone) : '',
                smsPhone: info.phone ? (($ctrl.isMobileView() ? 'sms' : 'imessage') + ':' + info.phone) : '',
                cursorPhone: info.phone ? 'hand' : 'default',
            });

            info.calltime = item.getCustomTime(item.calltime, $ctrl.CPS.timeFormat, true);

            if (item.info) {
                _.each(['pickup', 'onset', 'costumes', 'hmu', 'wrap'], function (prop){
                    info[prop] = item.getCustomTime(item.info[prop], $ctrl.CPS.timeFormat, true);
                });

                if (item.info.status) {
                    info.status = item.info.status;
                }
                if (item.info.no) {
                    info.no = item.info.no;
                }
            }

            return info;

            function getName() {
                var val = getEl('name');
                return val ? (val.length > length ? (val.substring(0, length-2) + '…') : val) : null;
            }

            function getShortProp(prop) {
                return getEl(prop) ;
            }

            function getTooltipProp(  prop) {
                var val = getEl(prop);
                return val && val.length > length ? val : '';
            }

            function getEl( prop) {
                var val = item ? (item.cast ? item.cast[prop] : null) : null;
                return val ? (val.length > length ? (val.substring(0, length-2) + '…') : val) : '–';
            }
        }

        function getPosition(posId) {
            var pos = $ctrl.preLoadingService.getPositions();
            if (!pos || pos.length === 0) {
                return null;
            }
            for (var i = 0, l = pos.length; i < l; i++) {
                var el = pos[i];
                if (el.id === parseInt(posId, 10)) {
                    return el;
                }
            }
            return null;
        }

        function listItemsQuery(item) {
            if (!item) {
                return false;
            }
            var roles = item && item.roles && item.roles.length > 0 ? item.roles : null;
            if ($ctrl.rolesgrid === 'CrewAndUnassigned' && !roles) {
                return true;
            }
            if (!roles) {
                return false;
            }
            var role = $ctrl.rolesgrid === 'CrewAndUnassigned' ? 2 : $ctrl.rolesgrid;
            return _.find(item.roles, function (el) {
                return el && el.type === role;
            });
        }

        function getStat(val) {
            if (!val) {
                return $ctrl.CastStatuses[0];
            }
            for (var i = 0; i < $ctrl.CastStatuses.length; i++) {
                var sc = $ctrl.CastStatuses[i];
                if (sc.id === val) {
                    return sc;
                }
            }
            return $ctrl.CastStatuses[0];
        }

        function getRowViewMobileDetails(item) {
            var addInfo = getAddInfo(item),
            t = '<div ng-if="$ctrl.isOpenRow(\''+item._id+'\')" class="row-mobile row-schedule fadeInDownSmall more-details">' +
                    '<div class="status-col border-right text-center grow-column">' +
                        '<div class="big">'+addInfo.status+'</div>' +
                        '<div class="small">Status</div>' +
                    '</div>' +
                    '<div class="col25p border-right text-center">' +
                        '<div class="big">'+addInfo.pickup+'</div>' +
                        '<div class="small">Pickup</div>' +
                    '</div>' +
                    '<div class="col25p border-right text-center">' +
                        '<div class="big">'+addInfo.call+'</div>' +
                        '<div class="small">Call</div>' +
                    '</div>' +
                    '<div class="col25p border-right text-center">' +
                        '<div class="big">'+addInfo.costumes+'</div>' +
                        '<div class="small">C/W</div>' +
                    '</div>' +

                    '<div class="col25p border-right text-center">' +
                        '<div class="big">'+addInfo.hmu+'</div>' +
                        '<div class="small">H/MU</div>' +
                    '</div>' +
                    '<div class="col25p text-center">' +
                        '<div class="big">'+addInfo.onset+'</div>' +
                        '<div class="small">On Set</div>' +
                    '</div>' +'<div class="col25p border-right text-center">' +
                '<div class="big">'+addInfo.wrap+'</div>' +
                '<div class="small">Wrap</div>' +
                '</div>' +
                '</div>';

            if(item.showDetails){
                // && ($ctrl.LCS.isMobileSize || $ctrl.isViewMode($ctrl.ViewModes.Mobile))
                t += '<div ng-show="$ctrl.isOpenRow(\'' +item._id + '\')" class="row-mobile row-schedule fadeInDownSmall more-details contact-info">' +
                    '<div class="table-div full-width">' +
                    (addInfo.phone ? ( '<div class="col33p text-center border-right"><a '+(addInfo.phone?('href="'+addInfo.hrefPhone+'"'):'')+' class="'+(addInfo.phone?'gray with-primary-hover':'gray-lighter')+'" analytics-category="Callsheet Preview" analytics-on analytics-action="Callsheet Preview - Call Cast" style="cursor:'+  addInfo.cursorPhone+'">' +
                        getI('phone') +
                        ' <div class="small text-center">Call</div></a> </div>' +
                        '<div class="col33p text-center border-right"><a '+(addInfo.phone?('href="'+addInfo.smsPhone+'"'):'')+' class="'+(addInfo.phone?'gray with-primary-hover':'gray-lighter')+'" style="cursor:'+ addInfo.cursorPhone+'" analytics-category="Callsheet Preview" analytics-on analytics-action="Callsheet Preview - SMS Cast">' +
                            getI('notebubble') +
                        ' <div class="small text-center">SMS</div></a> </div>') :'') +
                    '<div class="'+(addInfo.phone ? 'col33p ':'') + 'text-center"><a href="'+addInfo.hrefEmail+'" class="gray with-primary-hover" style="cursor: hand" analytics-category="Callsheet Preview" analytics-on analytics-action="Callsheet Preview - Mail Cast">' +
                        getI('message') +
                    ' <div class="small text-center">Email</div></a> </div>' +
                '</div>' +
            '</div>' +
        '</div>';
            }
            return t;

            function getI(icon){return $ctrl.LCS.getISBDiv(icon, 2, 'icon');}
        }

        function getMoreInfoBtnTemplate(isHeader, item) {
            return {
                count: 1, //$ctrl.editInlineOnMobile && $ctrl.isMobileView() ? 2 : 1,
                content: isHeader ? '' : get()
            };

            function get(){
                var txt = (item[$ctrl.propShow] ? 'Hide' : 'Show') + ' Details';
                return '<a style="top:-5px" class="position-relative toggleDetails editable-btn btn ' + $ctrl.getClickEventName('changeDetails') + '" tooltip-placement="left" tooltip="'+txt+'">' +
                    $ctrl.LCS.getISBDiv('eye', 3, 'centered gray') +
                    // '<div class="tooltip tooltip-inline left" style="top: -14px;left: -108px"><div //class="tooltip-arrow"></div><div class="tooltip-inner">' + (item[$ctrl.propShow] ? 'Hide' : 'Show') + ' Details</div></div>' +
                    '</a>' +
                    '<a class="editable-btn btn ' + $ctrl.getClickEventName('remove') + '" tooltip-placement="left" tooltip="Remove">' + $ctrl.LCS.getISBDiv('trash', 2, 'centered gray') + '</a>';
            }
        }

        function showColumnOther(item, c, isHeader, isMobile, notTextOnly){
            if(!$ctrl.canEdit && !isMobile && $ctrl.options.twoCols){
                var prop = c.prop;
                if( !(prop === 'name' || prop === 'calltime')){
                    return false;
                }
            }
            return true;
        }

        function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
            if(isMobileRowDetails && c.viewRowDetailsMobile ) {
                return get(c);
            }

            var prop = c.prop,
                is2Cols = !$ctrl.canEdit && !isMobile && $ctrl.options.twoCols,
                email = getp('email'),
                phone = getp('phone'),
                avatar = $ctrl.getColumnByProp('profilePictureURL');

            switch (prop) {
                case 'name':
                    var c1 = ' full-width ',
                        t = get(c, cls + c1); //name

                    if(!isMobileRowDetails) {
                        if(is2Cols) {
                            var roles = $ctrl.getColumnByProp('roles', true);
                            if(roles){
                                t += get(_.extend({},roles,{depId: c.depId}), c1);
                            }
                        }

                        if (email || phone) {
                            t += '<div class="full-width with-cast-info">' +
                                get(email, c1) +
                                get(phone, c1)  +
                                '</div>';
                        }
                    }

                    return (!isMobileRowDetails && is2Cols && avatar ? get(avatar, avatar.colCls) : '')+
                        '<div class="' + cls + ' without-height-padding">' + t + '</div>';

                case 'email':
                    return isMobileRowDetails && !email  ? '' : get(c);

                case 'phone':
                    return isMobileRowDetails && !phone  ? '' : get(c);

                default:
                    return get(c);
            }

            function get(c, cls1) {
                return c ? $ctrl.processListItemColumnInit(item, canEdit, c, cls1 || cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) : '';
            }
            function getp(prop){
                return ($ctrl.canEdit || !$ctrl.canEdit && item[prop]) ? $ctrl.getColumnByProp(prop) : null;
            }
        }
        function getStatusInfo($ctrl) {
            var temp = "<ul style='text-align: left; text-transform: none'>";
            for (var i = 0; i < $ctrl.CastStatuses.length; i++) {
                var el = $ctrl.CastStatuses[i];
                temp += "<li>" + el.text + ' - ' + el.desc + "</li>";
            }
            temp += "</ul>";
            return temp;
        }
    }
}

angular.module('product.callsheet.schedules.header.component', [
    'product.callsheet.blocks.controller.service'
])
.component('advancedSchedulesHeader', {
    bindings: {
        item: '<',
        onChange: '&'
    },
    controller: 'AdvancedSchedulesHeaderCtrl'
})

.controller('AdvancedSchedulesHeaderCtrl', AdvancedSchedulesHeaderCtrl);
AdvancedSchedulesHeaderCtrl.$inject = ['CallsheetBlocksCtrlService', '$element'];
function AdvancedSchedulesHeaderCtrl(CallsheetBlocksCtrlService, $element) {
    console.log('AdvancedSchedulesHeaderCtrl');
    var $ctrl = this;

    $ctrl.editableItemProps = ['advancedDate', 'advancedDayOfDays'];
    $ctrl.setColumns = setColumns;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.changeFieldManually = true;

    $ctrl = new CallsheetBlocksCtrlService($ctrl, $element);

    function setColumns() {
        $ctrl.columnsList = [
            _.extend({
                type: $ctrl.SBFieldTypesService.PropTypes.Date,
                prop: 'advancedDate',
                tabIndex: 2,
                tabNextIndex: 3,
                placeholder: 'Advanced Date',
                hasRemove: true,
                enableTime: false,
                dateFormat: 'ddd, MMM D, YYYY',//from moment

                //parentContainer:'.' +$ctrl.group,
                parentContainer: '.advancedSchedulesSection .advancedSchedule'
            }, getContentEditableParams( ' day date_picker')),

            _.extend({
                name: 'Advanced Day of Days',
                prop: 'advancedDayOfDays',
                type: $ctrl.SBFieldTypesService.PropTypes.Html,
                order: 2,
                placeholder: 'ie. Day 2 of 5',

                withBottomToolbar: true,
                withNoToolbar: true,
            }, getContentEditableParams())
        ];

        function getContentEditableParams(fieldClass){
            return {
                canEdit: true,
                triggerEditOnCol: true,

                fieldClass: 'editable-content contenteditable word-wrap ' + (fieldClass || ''),
                editableContainerClass: 'noninlineeditor',
                eClassAttr: 'non-inline-editor noninlineeditor',
                wrapperClass: ' full-width',
            }
        }
    }

    function getItemTemplate() {
        return get('advancedDayOfDays', 'col100') +
               '<div class="dot-separator col20 pull-left"></div>' +
               get('advancedDate', 'datepicker col130');

        function get(prop, cls){
            return '<div class="pull-left ' + (cls||'') + '"> '+$ctrl.getColDisplayDiv(prop) + '</div>';
        }
    }
}

angular.module('product.callsheet.advancedSchedules.component', [
    'product.callsheet.basicSchedulesListCtrl.service',
    'apiPagination.CallsheetAdvancedSchedules'
])
.component('callsheetAdvancedSchedulesGroup', callsheetGroupComponentParams( 'CallsheetAdvancedSchedulesListCtrl', {
    onChange: '&'
}))
.controller('CallsheetAdvancedSchedulesListCtrl', CallsheetAdvancedSchedulesListCtrl);
CallsheetAdvancedSchedulesListCtrl.$inject = ['CallsheetAdvancedSchedulesPagination', 'CallsheetSchedulesListInitCtrlService', '$element'];
function CallsheetAdvancedSchedulesListCtrl(Pagination, CallsheetSchedulesListInitCtrlService, $element) {
    console.log('CallsheetAdvancedSchedulesListCtrl');
    var $ctrl = this;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.constantsService = {
            CompOptions: {
                objectType: 'advancedSchedule',
                itemTitle: 'Advance Schedule',
                elemType: 'ADVANCE_SCHEDULE',
                preLoadingTableName: 'CallsheetAdvancedSchedules'
            },
            GroupSettings: {isAdvanced: true}
        };

        $ctrl = new CallsheetSchedulesListInitCtrlService($ctrl, $element, Pagination);
    }
}

angular.module('product.callsheet.schedules.component', [
    'product.callsheet.scheduleItem.controller',
    'product.callsheet.editScheduleItem.controller.service',
    'product.callsheet.basicSchedulesListCtrl.service',
    'apiPagination.CallsheetSchedules'
])
.component('callsheetSchedulesGroup', callsheetGroupComponentParams( 'CallsheetSchedulesListCtrl'))

.controller('CallsheetSchedulesListCtrl', CallsheetSchedulesListCtrl);
CallsheetSchedulesListCtrl.$inject = ['CallsheetSchedulesPagination', 'CallsheetSchedulesListInitCtrlService', '$element'];
function CallsheetSchedulesListCtrl( Pagination, CallsheetSchedulesListInitCtrlService, $element) {
    console.log('CallsheetSchedulesListCtrl');
    var $ctrl = this;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.constantsService = {
            CompOptions: {
                itemTitle: 'Schedule',
                objectType: 'callsheetSchedule',
                elemType: 'CALLSHEET_SCHEDULE',
                preLoadingTableName: 'CallsheetSchedules'
            }
        };

        $ctrl = new CallsheetSchedulesListInitCtrlService($ctrl, $element, Pagination);
