angular.module('product.callsheet.topPersons.service', [
])
.service('TopPersonsCtrlService', TopPersonsCtrlService);
TopPersonsCtrlService.$inject = ['TemplateCompileCompCtrlService'];
function TopPersonsCtrlService(TemplateCompileCompCtrlService) {
    return function($ctrl, $element){
        console.log('TopPersonsCtrlService');

        $ctrl.dontAutoloadTemplate = true;

        $ctrl.onLoaded = onLoaded;
        $ctrl.getItemTemplate = getItemTemplate;
        $ctrl.preInit = preInit;
        $ctrl.setEdit = setEdit;
        $ctrl.save = save;
        $ctrl.cancel = cancel;
        $ctrl.load = load;
        $ctrl.onCallsheetChanged = onCallsheetChanged;

        $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

        return $ctrl;

        function preInit() {
            if($ctrl.preInitService) {
                $ctrl.preInitService();
            }
            $ctrl.isEdit = false;
            $ctrl.isSaving = false;

            $ctrl.onCallsheetChanged();
        }

        function onCallsheetChanged() {
            $ctrl.load($ctrl.onGetContent(), true);
        }

        function getItemTemplate() {
            if (!$ctrl.canEdit && !$ctrl.item){return null;}
            var p = ($ctrl.placeholder ? $ctrl.placeholder : ('Enter '+$ctrl.itemTitle+'…')) + '…',
                hr = '<hr class="with-hr"/>';
            if (!$ctrl.canEdit){
                return hr + '<div class="person word-wrap">' + $ctrl.item + '</div>';
            }else{
                if($ctrl.isEdit){
                    return hr +
                    '<div>' +
                        '<div id="name" class="editable-content person word-wrap contenteditable" ng-model="$ctrl.prevItem" placeholder="' + p + '" contenteditable="true" contenteditable-html strip-br="true"></div>' +
                        '<div class="small-btns spacing-quarter-top">' +
                            '<button class="save btn btn-primary" ng-click="$ctrl.save($ctrl.prevItem)" ng-class="{\'disabled\': $ctrl.isSaving === true}"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isSaving === true" ></span> Apply</button>' +
                            '<a class="cancel" ng-click="$ctrl.cancel()">Cancel</a>' +
                        '</div>' +
                    '</div>';
                }else {
                    return hr + '<div id="topPersons">' +
                        '<div class="person word-wrap contenteditable" placeholder="' + p + '">' + ($ctrl.item ? $ctrl.item : '') + '</div>' +
                        '<div class="overlay with-radius-square vippersons white hide-print" ng-click="$ctrl.setEdit(true)"><div><div>'+$ctrl.LCS.getISBDiv('pencil')+'<div class="text">Edit '+$ctrl.itemTitle+'</div></div></div></div>' +
                    '</div>';
                }
            }
        }

        function onLoaded() {
            if($ctrl.canEdit){setFocus();}
        }

        function setFocus() {
            $ctrl.LCS.timeout(function () {
                var el = $ctrl.element.querySelector('#name');
                if (el) {
                    if(el.value || el.innerText) {
                       if(typeof (el.select) === 'function') {
                           el.select();
                       }else{
                           el.focus();
                       }
                    }else{
                        el.focus();
                    }
                }
            }, 0);
        }

        function load(item, withReload) {
            if (item !== $ctrl.prevItem) {
                $ctrl.item = item;
                $ctrl.prevItem = item ? angular.copy(item) : null;
                if(withReload) {
                    $ctrl.reloadTemplate();
                }
            }
        }

        function setEdit(val) {
            $ctrl.isSaving = false;
            $ctrl.isEdit = val;
            $ctrl.reloadTemplate();
        }

        function save(prevItem) {
            if ($ctrl.isSaving) {
                return;
            }
            $ctrl.isSaving = true;
            if (prevItem.replace(/<(?:.|)*?>/gm, '').trim() === '') {
                prevItem = null;
            }
            var updates = {};
            updates[$ctrl.prop] = prevItem;
            $ctrl.onChange({updates: updates});
            $ctrl.item = angular.copy(prevItem);
            setEdit(false);
        }

        function cancel(val) {
            setEdit(false);
            $ctrl.prevItem = $ctrl.item;
        }
    }
}

