angular.module('components.materialViewer.info.component', [
    'apiServices.Materials',
    'components.imgEditor.service'
])
.component('materialInfo',  {
    bindings: {
        canEdit:'<',
        isImg: '<',
        item: '<',
        onUpdated: '&'
    },
    controller: 'MaterialInfoCtrl',
})
.controller('MaterialInfoCtrl', MaterialInfoCtrl);
MaterialInfoCtrl.$inject = ['ListItemTemplateFormCtrlService', 'MaterialVersionsService', 'MaterialsService', 'ImgEditorService', '$element'];
function MaterialInfoCtrl(ListItemTemplateFormCtrlService, service, MaterialsService, ImgEditorService, $element){
    console.log('MaterialInfoCtrl');
    var $ctrl = this;

    $ctrl.events = [];
    $ctrl.dontAutoloadTemplate = false;
    $ctrl.metadataTemp = {};

    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitOther = preInitOther;
    $ctrl.postInitOther = postInitOther;

    $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

    function preInitOther() {
        $ctrl.service = service;

        $ctrl.metaFields = ImgEditorService.loadMetaFields($ctrl.isImg, !$ctrl.canEdit);

        if($ctrl.canEdit) {
            $ctrl.type = 'Edit';
            $ctrl.editedFields = [];
            _.each($ctrl.metaFields, function (field) {
                if (!field.readonly && !field.hide) {
                    $ctrl.editedFields.push(field.id);
                }
            });
            $ctrl.extraParam = {
                service: $ctrl.service
            };
        }
    }

    function postInitOther(){
        if($ctrl.canEdit) {
            $ctrl.onSave = onSave;
            $ctrl.saveItem = saveItem;
        }
    }

    function saveItem() {
        var data = $ctrl.service.getChanges($ctrl.editedFields, $ctrl.item, $ctrl.copyItem);
        if (data) {
            data._id = $ctrl.item._id;
            if(data.name!==undefined ){data.actiontype = 'rename';}
            $ctrl.service.update(data, function (result) {
                result.editchanges = data;
                $ctrl.onSave(result);
            }, $ctrl.onCustomError);
        } else {
            $ctrl.onSave({item: $ctrl.item});
        }
    }

    function onSave(result) {
        $ctrl.hasChanges = false;
        var item = result.item;
        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.materialVersion.update.success', 'success', {name: item.name});
        $ctrl.broadcastRoot('UPDATED_MATERIAL_ITEM', result);
        $ctrl.broadcastRoot('UPDATED_MATERIALVERSION_ITEM', result);

        //todo update in cache
    }

    function hasEvents(field){
        return !field.hide && !field.readonly && $ctrl.canEdit;
    }
    function getItemTemplate() {
        var res = '';
        _.each($ctrl.metaFields, function (field) {
            var readonly = field.readonly || !$ctrl.canEdit;
            var id = field.id,
                val = getVal(id);

            if (field.hide || readonly && !val) {
                return '';
            }
        res += '<div class="sbup-Dashboard-FileCard-fieldset table-div">' +
                    '<div class="centered text-left"><label class="sbup-Dashboard-FileCard-label">' + field.name + '</label></div>' +
                    '<div class="centered text-left txt">' +
                        (readonly ? ('<label class="sbup-Dashboard-FileCard-input">' + val + '</label>') :
                            ('<div class="sbup-Dashboard-FileCard-input">' + getEl(field) + '</div>')) +
                    '</div>' +
                '</div>';
        });

        return '<div class="full-width" name="$ctrl.formHolderItem[$ctrl.formName]" novalidate autocomplete="off">' + res + '</div>';

        function getVal(id) {
            switch (id) {
                case 'name':
                case 'mimeType':
                    return $ctrl.item[id];

                case 'size':
                    var size = $ctrl.item[id];
                    return size ? ImgEditorService.prettyBytes(size) : null;

                case 'resolution':
                    var meta = $ctrl.item.metadata;
                    return meta && meta.width && meta.height ? (meta.width + ' x ' + meta.height) : null;

                case 'createdAt':
                    return $ctrl.item.createdAt ? $ctrl.item.createdAt.format('MMM D, YYYY') : null;

                case 'createdBy':
                    return $ctrl.item.createdBy ? $ctrl.item.createdBy.name : null;

                default:
                    var predefFields = ['notes', 'tags'];
                    if(id.indexOf(predefFields)!==-1){
                        return $ctrl.item[id];
                    }
            }
            return null;
        }

        function getEl(field) {
            var cls = 'sbup-u-reset sbup-c-textInput full-width',
                d = ' placeholder="' + field.placeholder + '" id="' + field.id + '" name="' + field.id + '" ';
            switch(field.type) {
                case 'input':
                    return '<input ' + d + ' class="' + cls + '" type="text" required>' +
                        '<div ng-show="($ctrl.formHolderItem[$ctrl.formName].name.$dirty || $ctrl.formHolderItem[$ctrl.formName + \'_attempted\']) && $ctrl.formHolderItem[$ctrl.formName].name.$error.required" class="help-inline ng-hide">' + field.name + ' is required.</div>';
                case 'contenteditable':
                    return '<div ' + d + ' class="autogrow contenteditable ' + cls + '" contenteditable="true" contenteditable-html strip-br="true" paste-plain-text="true"></div>';
            }
        }
    }

    function onLoaded(){
        bind(true);
    }

    function onDestroy(){
        bind(false);
    }


    function bind(isBind) {
        _.each($ctrl.metaFields, function (field) {
            var prop = field.id;
            if(hasEvents(field)) {
                var el = $ctrl.element.querySelector('#' + prop);
                if (el) {
                    var val = isBind ? $ctrl.item[prop] : null;
                    if (prop) {
                        el[field.type === 'input' ? 'value' : 'innerHTML'] = val;
                    }
                    $ctrl.LCS.bindElementsClick(isBind, el, onBlur, null, 'blur');
                    $ctrl.LCS.bindElementsClick(isBind, el, onKeyUp, null, 'keyup paste');
                }
            }
        });
    }

    function onKeyUp(e) {
        switch (e.which) {
            case 27: //esc -> dont save and close

                break;

            case 9:  //tab -> save and go to next

                break;

            case 13: //enter -> save and go to next index
                saveMeta(e.currentTarget.id);
                break;

            default:
                if (e) {
                    e.stopPropagation();
                }
                $ctrl.metadataTemp[e.currentTarget.id] = e.currentTarget[e.currentTarget.tagName === 'INPUT' ? 'value' : 'innerHTML'];
                break;
        }
    }

    function onBlur(e){
        console.log('onBlur');
        saveMeta(e.currentTarget.id);
    }

    function saveMeta(id){
        var v = $ctrl.metadataTemp ? $ctrl.metadataTemp[id] : null;
        if (v) {
            var d = {};
            d[id] = v;
            setMeta($ctrl.item._id, d, next, false);

            function next() {
                delete $ctrl.metadataTemp[id];
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.materialVersion.updateMeta.success', 'success');
            }
        }
    }

    function setMeta(fileId, meta, next, isMovieStills){
        (isMovieStills ? MaterialsService.updateMovieStillsMeta :  MaterialsService.updateVersionMeta)({
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId,
            versionId: fileId,
            metadata: meta
        }, function(res){
            next(null, res);
        },function (err) {
            if(err){console.log(err);}
            next(err, null);
        });
    }
}

angular.module('components.materialViewer.metadatas.component', [
    'components.materialViewer.metadatas.controller.service'
])
.component('materialMetadatas',  {
    bindings: {
        canEdit:'<',
        item: '<',
        onUpdated: '&'
    },
    controller: 'MaterialMetadatasCtrl',
})
.controller('MaterialMetadatasCtrl', MaterialMetadatasCtrl);
MaterialMetadatasCtrl.$inject = ['MaterialMetadatasCtrlService', '$element',];
function MaterialMetadatasCtrl(MaterialMetadatasCtrlService,  $element) {
    console.log('MaterialMetadatasCtrl');
    var $ctrl = this;
    $ctrl.isPopup = false;
    $ctrl = new MaterialMetadatasCtrlService($ctrl, $element, $ctrl.isPopup);
}

angular.module('components.materialViewer.metadatas.controller.service', [
    'apiConstants.materialViewer.services',
    'components.imgEditor.service',
    'apiServices.MaterialMetadatas',
    'ctrl.PopupsCtrl.generalItemEdit.service'
]) 
.service('MaterialMetadatasCtrlService', MaterialMetadatasCtrlService);
MaterialMetadatasCtrlService.$inject = ['GeneralItemEditCtrlService', 'MaterialMetadatasService', 'FiltersService', 'MaterialViewerConstantsService'];
function MaterialMetadatasCtrlService(GeneralItemEditCtrlService, service, FiltersService, constantsService) {
    return function ($ctrl, $element, isPopup){
        console.log('MaterialMetadatasCtrlService'); 
    
        $ctrl.service = service;
        $ctrl.withUncheck = true;
    
        $ctrl.preInitGeneral = preInitGeneral;
    
        $ctrl.preSetTemplateData = preSetTemplateData;
        $ctrl.getPopupBodyContent = getPopupBodyContent;
        $ctrl.preTemplate = preTemplate;
        $ctrl.postTemplate = postTemplate;
    
        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, isPopup);
    
        return $ctrl
        
        function preInitGeneral() {
           // $ctrl.parentName = $ctrl.extraParam.parent.name;
            $ctrl.filtersService = new FiltersService(constantsService, null);
            $ctrl.Settings = $ctrl.filtersService.Settings;
            $ctrl.columnsList = $ctrl.filtersService.ColumnsList;
            $ctrl.onSaveGeneral = onSaveGeneral;
        }
    
        function onSaveGeneral(result) {
            if (!$ctrl.isNew) {
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.metadata.' + ($ctrl.isNew ? 'Create' : 'Edit') + '.success', 'success');
            }
        }
    
        function preSetTemplateData() {
            $ctrl.icon = 'card';
            $ctrl.iconLevel = 3;
            $ctrl.withFooterBtns = true;
            $ctrl.btnText = 'Save';
            $ctrl.firstBtnMethod = 'addF';
            $ctrl.modalBodyFormClass = 'med1';
            $ctrl.textAnalytics = 'Save File Metadata';
        }
    
        function preTemplate() {
            return '<form name="$ctrl.formHolderItem[$ctrl.formName]" class="formHolderItem auto popup-shot" novalidate autocomplete="off">';
        }
    
        function postTemplate() {
            return '</form>';
        }
    
        function getPopupBodyContent() {
    return '<div class="clearfix">' +
                '<div class="form-group table-div full-width">' +
                    '<div class="col50 vbottom"></div>' +
                    '<div class="thin padding-right-10"><div id="name" class="autogrow with-padding-top contenteditable with-underline form-control '+($ctrl.pageClass||'')+'" placeholder="Shot description…" contenteditable="true" paste-plain-text="true" contenteditable-html strip-br="true" ng-model="$ctrl.item.name" ui-focus="$ctrl.isSetFocus(7)"></div></div>' +
                '</div>' +
            '</div>' +
            processList('columns', true);
    
            function processList(type, show) {
                var el = '';
                var list = $ctrl[type];
                if (!list || !list.length) {
                    return el;
                }
                _.each(list, function (c, i) {
                    if (c.type === 12) {
                        return;
                    }
                    el += addCol(c, type, i, show);
                });
                return el;
    
                function addCol( c, type, i, show) {
                    return '<div ng-init="c=$ctrl.' + type + '[' + i + ']" ' + (show ? 'ng-show="$ctrl.show"' : '') + ' class="pull-left col185">' +
                        '<div class="field form-group padding-right10 full-width">' + $ctrl.SBFieldTypesService.getEditFieldForCol($ctrl, c) + '</div>' +
                        '</div>';
                }
            }
        }
    }
}

angular.module('components.materialViewer.component', [
    'components.materialViewer.info.component',
    'components.materialViewer.metadatas.component',
    'product.material.fileStats.service',
    'apiServices.MaterialVersions',
    'apiServices.Materials',
    'product.document.viewDocument.component',
    'sb.fields.popovers.assignLikesInline.component'
])
.component('materialViewer',  {
    bindings: {
        isInModal: '@',
        currentList: '<',
        material: '<',
        selectedPanel: '<',

        canUpload: '<',

        canComment: '<',
        withComments:'<',

        startWithLikes: '<',

        withDetails:'<',
        withHeader:'<',
        withoutSidebar:'<',
        materialVersionId: '<',
        editorOptions: '<',
        todoPage: '<',
        onImageEdited: '&',
        onFileLoaded: '&'
    },
    controller: 'MaterialViewerCtrl',
})
/*with-comments="::$ctrl.withComments" material-version-id="::$ctrl.materialVersionId" can-upload="::$ctrl.canUpload" can-comment="::$ctrl.canComment" editor-options="::$ctrl.editorOptions" on-image-edited="$ctrl.onImageEdited(result)"*/
.controller('MaterialViewerCtrl', MaterialViewerCtrl);
MaterialViewerCtrl.$inject = ['MaterialVersionsService', 'TemplateCompileCompCtrlService', 'MaterialsService', 'CommentsSidebarService', 'FileStatsService', 'RouteCollaboratorsService', '$element'];
function MaterialViewerCtrl(MaterialVersionsService, TemplateCompileCompCtrlService, MaterialsService, CommentsSidebarService, FileStatsService, RouteCollaboratorsService, $element) {
    var $ctrl = this;

    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
    $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;

    $ctrl.CommentsSidebarService = CommentsSidebarService;
    $ctrl.MaterialVersionsService = MaterialVersionsService;
    $ctrl.MaterialsService = MaterialsService;

    $ctrl.getExtension = FileStatsService.getExtension;
    $ctrl.getTextFileSize = FileStatsService.getTextFileSize;
    $ctrl.getExtension = FileStatsService.getExtension;

    $ctrl.changedFields = ['materialVersionId'];

    $ctrl.isOpen = true;
    $ctrl.withFullSize = true;

    $ctrl.onInfoUpdated = onInfoUpdated;
    $ctrl.getDownloadLink = getDownloadLink;
    $ctrl.togglePanel = togglePanel;
    $ctrl.getImgType = getImgType;
    $ctrl.openVersions = openVersions;

    $ctrl.onImageEdited1 = onImageEdited1;
    $ctrl.$onChanges = $onChanges;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.toggleSidebar = toggleSidebar;

    $ctrl.onCommentsCountChanged = onCommentsCountChanged;
    $ctrl.onLikesCountChanged = onLikesCountChanged;
    $ctrl.triggerLike = triggerLike;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function $onChanges(changes) {
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i], change = changes[field];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                if (field === 'materialVersionId') {
                    reload();
                }
                break;
            }
        }
    }

    function preInit() {
        console.log('materialViewer');
        $ctrl.hasUserId = $ctrl.CPS.security.getCurrentUserId();

        $ctrl.LCS.addClass($ctrl.element, 'sbup-Dashboard-FileCard-inner');
        $ctrl.addRootWatcher('MATERIAL_VIEWER_UPDATE_COMMENTS_COUNT', $ctrl.onCommentsCountChanged);
        $ctrl.addRootWatcher('MATERIAL_VIEWER_UPDATE_LIKES_COUNT', $ctrl.onLikesCountChanged);
    }

    function onCommentsCountChanged(result){
        onCountChanged(result, 'comments');
    }

    function onLikesCountChanged(result) {
        onCountChanged(result, 'likes');
        $ctrl.currentList.currentItemLikes = result.likes || [];
        var count = $ctrl.currentList.currentItemLikes.length;

        var el = $ctrl.element.querySelector('.btnLike');
        if (el) {
            $ctrl.LCS[isLikedByUser() ? 'addClass' : 'removeClass'](el, 'liked');
        }

        var id = 4;
        el = $ctrl.element.querySelector('.meta-panel[data-id="' + id + '"]');
        if (el && isEq(id)) {
            $ctrl.LCS[count ? 'addClass' : 'removeClass'](el, 'show');
        }
    }

    function onCountChanged(result, prop){
        if(result && $ctrl.currentList && $ctrl.currentList.currentItemId) {
            var p = $ctrl.LCS.findClosestParent($ctrl.element, '.material-viewer');
            if(p){
                var el = p.querySelector('.sb-prop-'+prop+'-count');
                if(el){
                    el.innerHTML = result.count > 0 ? result.count : '';
                }
            }
        }
    }

    function postInit() {
        reload();
    }

    function openVersions(e) {
        $ctrl.popupsService.teamAccess(function () {
            $ctrl.popupsService.open($ctrl.material, $ctrl.popupsService.operations.fileVersions, {
                canEdit: $ctrl.canEdit
            }, $ctrl.compOptions);
        });
    }

    function isLikedByUser(){
        var likes = $ctrl.currentList ? $ctrl.currentList.currentItemLikes : null;
        return likes ? _.find(likes, function (like){
            return like.userId === $ctrl.hasUserId && isLike(like);
        }) : false;

        function isLike(like){
            var withRemoved = true,
                field = 'removed';
            return (!withRemoved || withRemoved && like[field] !== true);
        }
    }

    function reload(){
        if (!$ctrl.materialVersionId) {
            return done();
        }
        $ctrl.MaterialVersionsService.getById($ctrl.materialVersionId, ($ctrl.material ? '' : 'materialId ') + 'createdById materialMetadataId contentVersionId', onGet, onError);

        function onGet(version) {
            if(!version) {return;}

            $ctrl.withLikes = $ctrl.currentList ? $ctrl.currentList.withLikesOnItem : null;

            $ctrl.materialVersion = angular.copy(version);

            if(version.material){
                $ctrl.material = angular.copy(version.material);
            }

            $ctrl.material.version = $ctrl.materialVersion;

            $ctrl.getImgType($ctrl.material, $ctrl.materialVersion);

            if (!$ctrl.selectedPanel) {
                $ctrl.selectedPanel =
                    $ctrl.startWithLikes && $ctrl.withLikes ? '4' :
                    ($ctrl.withComments && $ctrl.canComment ? '3' :   ($ctrl.withDetails ? '1' : '2'));
            }

            getSelectedListStr();

            if($ctrl.withFullSize) {
                processDownload($ctrl.materialVersion, done, onError);
            } else{
                done($ctrl.security.getLogoPath($ctrl.materialVersion, 'path', $ctrl.element.offsetWidth * (window.devicePixelRatio || 2)));
            }
        }

        function onError(err) {
          //  console.log(err);
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.version.Download.error', 'error');

            done();
        }

        function done(src) {
            $ctrl.src = src;
            $ctrl.isLoaded = true;
            reloadTemplate();
        }
    }

    function toggleSidebar() {
        $ctrl.isOpen = $ctrl.isOpen ? false : true;
        $ctrl.LCS[$ctrl.isOpen ?  'removeClass' : 'addClass']($ctrl.element, 'sidebar-closed');
    }
    
    function onImageEdited1(result) {
        console.log('MaterialViewerCtrl onImageEdited');
        console.log(result);
        $ctrl.onImageEdited({result: result});
    }

    function reloadTemplate() {
        if (!($ctrl.materialVersionId && $ctrl.isLoaded &&
            ($ctrl.groupFileType === 'sbx' || $ctrl.groupFileType === 'sbdoc'))) {
            return $ctrl.reloadTemplate();
        }

        getSBX($ctrl.materialVersion, function () {
            $ctrl.reloadTemplate();
        });
    }

    function isEq(id){
        return $ctrl.selectedPanel && $ctrl.selectedPanel.toString() === id;
    }

    function getItemTemplate() {
        bind(false);

        if (!$ctrl.materialVersionId) {
            return '<div>' +
                '<h3 class="text-center">Invalid file</h3>' +
                '<p class="text-center">This file doesn’t exist anymore.</p>' +
                '</div>';
        }

        if (!$ctrl.isLoaded) {
            return '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
        }

        return '<div class="sbup-Dashboard-FileCard-preview' + ($ctrl.withLikes ? ' with-likes' : '') + '">' +
                getItem() +
            ($ctrl.withLikes ? '<button class="btnLike sbup-Dashboard-FileCard-actionsBtn ' + (isLikedByUser() ? ' liked' : '') + '" type="button">'+$ctrl.LCS.getISBDiv('heart') + '</button>' : '') +
            '</div>' +
            getSidebar();

        function getItem() {
            var version = $ctrl.materialVersion,
                cls = 'class="display-block clearfix sb-img-viewer full-width h-full';

            switch ($ctrl.groupFileType) {
                case 'image':
                    var t = 'sb-img-viewer-with-editor';
                    return '<' + t + ' ' + cls + ' ' + t + '" ' +
                        ($ctrl.withFullSize ? ' with-full-size="true" ' : '') +
                        'filename="::$ctrl.materialVersion.name" src="::$ctrl.src" mime-type="::$ctrl.mimeType" editor-options="::$ctrl.editorOptions" on-image-edited="$ctrl.onImageEdited1(result)" can-upload="::$ctrl.canUpload"></' + t + '>';

                    //todo bring back
                /*case 'sbx':
                case 'fdx':
                case 'fountain':
                    return '<sb-script-viewer ' + cls + ' src="::$ctrl.src"></sb-script-viewer>';
*/

                case 'video':
                case 'audio':
                case 'xls':
                case 'doc':
                case 'epub':
                case 'pdf':
                    //todo figure out how to adjust them
                    if($ctrl.groupFileType === 'pdf') {
                        $ctrl.pdfOptions = {
                            //scale: 1,
                            download: true,
                            print: true
                        };
                    }
                    var t = 'sb-' + $ctrl.groupFileType + '-viewer';
                    return '<' + t + ' ' + cls + ' ' + t + '" src="::$ctrl.src"'+
                        ($ctrl.groupFileType === 'pdf' ? ' options="$ctrl.pdfOptions"' : '') +
                        '></' + t + '>';


                case 'sbx':
                case 'sbdoc':
              //  case 'sbav':
                    return viewSbx($ctrl.materialVersion, $ctrl.groupFileType === 'sbx');

                default:
                    var isScript = $ctrl.materialVersion && $ctrl.materialVersion.contentVersion && ($ctrl.groupFileType === 'fdx' || $ctrl.groupFileType === 'fountain');
                    if(isScript){
                        return viewSbx($ctrl.materialVersion.contentVersion, isScript);
                    }

            return '<div class="file-default margin-half centering with-radius form-wrapper long full-width with-white-bg with-padding-around-40">' +
                        '<div class="spacing-half">' +
                            '<div class="file-icon big centering">' +
                            '<div class="text ' + ($ctrl.extension ? $ctrl.extension : '') + '">' + ($ctrl.shortExtension ? $ctrl.shortExtension : '') + '</div>' +
                            '<hr class="short"><hr/><hr/>' +
                            '</div>' +
                        '</div>' +
                        '<div class="wide-tooltip margin-bottom-quarter">' +
                            '<div class="name text-center semibold font-size-16" tooltip-placement="bottom" tooltip="' + ($ctrl.fileName.length > 40 ? $ctrl.fileName : '') + '">' +
                            ($ctrl.fileName.substring(0, 40) + ($ctrl.fileName.length > 44 ? ('…' + $ctrl.extension) : '')) +
                            '</div>' +
                        '</div>' +
                        '<div class="modified text-center subname">Uploaded on ' + version.createdAt.format($ctrl.CPS.dateTimeFormat) + ($ctrl.materialVersion.createdBy ? (' by ' + $ctrl.materialVersion.createdBy.name) : '') + '</div>' +
                        '<div class="modified text-center subname">' + $ctrl.getTextFileSize(version.size) + '</div>' +
                        '<div class="' + $ctrl.getBtnActionCls() + ' with-cursor col50 centered position-relative" data-type="openVersions" analytics-on analytics-action="Open Versions" tooltip="Open Versions" tooltip-placement="bottom">' +
                            '<div class="size centering spacing-bottom margin-top-quarter version-label full-width">v ' + version.version +'</div>'+
                            '<div class="sbf pull-right arrow-filled-down hide-print blue" style="position:absolute;top:5px;right:4px"></div>'+
                        '</div>' +

                        '<div class="error" ng-show="$ctrl.error" ng-bind-html="$ctrl.error|unsafe"></div>' +
                        '<div class="text-center spacing-half-top margin-top-half" style="border-top:1px solid #EBEFF2">' +
                            '<a class="' + $ctrl.getBtnActionCls() + ' btn btn-primary" analytics-on analytics-action="Download Material" target="_self" data-type="getDownloadLink"><div class="pull-left sbf" ng-class="$ctrl.isDownloading?\'loadingicon animate-spin\':\'download\'">' + $ctrl.LCS.getISBPath(3) + '</div> Download</a>' +
                        '</div>' +
                    '</div>';
            }

            function viewSbx(materialVersion, isScript) {
                var tag = 'sb-view-document';
                $ctrl.fileOptions = _.extend({
                    item: materialVersion,
                    type: (materialVersion.isScript || isScript) ? 2 : 1,
                    withDownload: true,
                    withHeader: $ctrl.withHeader,
                    withoutSidebar: $ctrl.withoutSidebar
                }, $ctrl.groupFileType === 'fdx' || $ctrl.groupFileType === 'fountain' ? {originalVersion: $ctrl.materialVersion} : null);
                return '<' + tag + ' class="sb-view-document full-width h-full" file-options="::$ctrl.fileOptions"></' + tag + '>';
            }
        }

        function getSidebar() {
            if($ctrl.withoutSidebar){return '';}

            var data = [], id;

            getSelectedListStr();

            if ($ctrl.withDetails) {
                id = '1';
                data.push({
                    id: id,
                    text: "Details",
                    txt: '<material-metadatas class="meta-panel clearfix ' + (isEq(id) ? 'show' : '') + '" ' +
                        'data-id="'+id+'" ' +
                        'item="::$ctrl.materialVersion.materialMetadata" ' +
                        'on-updated="$ctrl.onInfoUpdated(result)" ' +
                        'can-edit="::$ctrl.canUpload"' +
                        '></material-metadatas>'});
            }


           if($ctrl.canComment) {
               id = '3';
               data.push({
                   id: id,
                   text: 'Comments <span class="sb-prop-comments-count"></span>',
                   txt: '<div class="meta-panel ' + (isEq(id) ? 'show' : '') + '" data-id="' + id + '">' + getComments() + '</div>',
                   hide: !$ctrl.withComments
               });
           }

            if($ctrl.withLikes) {
                var showLikes = $ctrl.uIdList && $ctrl.uIdList.likes && $ctrl.uIdList.likes.length > 0;

                id = '4';
                data.push({
                    id: id,
                    text: 'Likes <span class="sb-prop-likes-count with-padding-left"></span>',
                    txt: '<div class="meta-panel ' + (isEq(id) && showLikes ? 'show' : '') + '" data-id="' + id + '">' + getLikes() + '</div>',
                    //hide: !$ctrl.withComments
                });
            }

            id = '2';
            data.push({
                id: id,
                text: "Metadata",
                txt: '<material-info class="meta-panel clearfix ' + (isEq(id) ? 'show' : '') + '" ' +
                    'data-id="'+id+'" ' +
                    'is-img="::$ctrl.isImg" ' +
                    'item="::$ctrl.materialVersion" ' +
                    'on-updated="$ctrl.onInfoUpdated(result)" ' +
                    'can-edit="::$ctrl.canUpload"' +
                    '></material-info>'});

            return '<div class="sbup-Dashboard-FileCard-info outtercontainer show-scrollbar-on-hover hide-print"' +
        //' ng-show="$ctrl.displaySidebar()"' +
        '>' +
                '<div class="innercontainer fancy-scrollbar sb-scrolling-monitor ultrathin" sb-scrolling-monitor-id="tree">' +
                    '<div class="sidebarScrollingContainer">' + getC() + '</div>' +
                '</div>' +
            '</div>' +
            getToggle(true);

            function getToggle(inside) {
                var tag = inside ? 'button' : 'a';
                return '<div class="sidebar-toggle no-padding position-relative ' + (inside ? ' inside' : 'onsidebar') + '"><' + tag + ' ' + (inside ? 'type="button"' : '') + ' class="btnToggle ' + (inside ? 'sbup-Dashboard-FileCard-actionsBtn' : 'btn btn-small transparent noborder smaller inline-block') + '">' + $ctrl.LCS.getISBDiv('angle-double-left'
                      // + (inside ? 'right' : 'left')
                        , 2, 'centered') + '</' + tag + '></div>';
            }

            function getC() {
                var h = '', b = '';
                _.each(data, function (item) {
                    var isSel = isEq(item.id);
                    if(!item.hide) {
                        h += '<li class="panelbtn with-margin-right ' + (isSel ? 'active' : '') + '">' +
                            '<a class="' + (isSel ? 'active semibold' : '') + '" data-id="' + item.id + '">' + item.text + '</a>' +
                            '</li>';
                        b += item.txt;
                    }
                });

                return '<div class="sbup-Dashboard-FileCard-metadata">' + b + '</div>' +
                    '<ul class="sbup-Dashboard-FileCard-header subheader-tabs two short side-padding-20 comments-sub-header">' + h +
                    '</ul>' +
                    getToggle();
            }
        }
    }

    function getComments() {
        return '<comments-sidebar-inner id="comments-bar" class="comments-sidebar-inner board-menu-content-frame h-full" selected-list-str="$ctrl.selectedListStr"' + ($ctrl.isInModal ? ' is-in-modal="true"' : '') + '></comments-sidebar-inner>';
    }

    function getLikes() {
        return '<sb-assign-likes-inline class="assign-collaborators-inline likes clearfix" list="::$ctrl.uIdList" is-page-share="::$ctrl.isPageShare" todo-page-id="' + $ctrl.todoPage._id + '" elem-type="'+$ctrl.currentList.elemType+'"></sb-assign-likes-inline>';
    }

    function getSelectedListStr() {
        if (!$ctrl.material) {
            return;
        }
        var l1 = $ctrl.currentList,
            currentItemId = l1 && l1.withCommentsOnItem ? l1.currentItemId : null, //consider the item if withCommentsOnItem. otherwise consider comments on img instead of comments on item
            sidebarType = $ctrl.LCS.SidebarTypes.ListComments;//4

        if(!$ctrl.todoPage) {
            $ctrl.todoPage = $ctrl.BlocksSetupService.todoPages[currentItemId ? $ctrl.CPS.currentStateName : 'user.product.library-file']; //comments are added to files
        }

        var p = {
            currentList: $ctrl.material || {},
            pageInfo: {
                todoPage: $ctrl.todoPage
            },
            fileComments: true,
            withCommentsOnItem: l1 && l1.withCommentsOnItem,
            withLikesOnItem: l1 && l1.withLikesOnItem,
            uId: currentItemId || $ctrl.material._id,
            sidebarType: sidebarType,
            isOpen: true,
        }

        if (currentItemId) {
            var l = {};
            _.each(['_id', 'name', 'collectionName', 'elemType', 'itemTitle', 'nameForList', 'currentItemId', 'currentItemLogoId', 'currentItemLogo', 'currentItemLikes', 'currentProductId'], function (p) {
                if ($ctrl.currentList[p]) {
                    l[p] = $ctrl.currentList[p];
                }
            });
            p.currentList = l;
        }

        $ctrl.selectedListStr = JSON.stringify(p);

        //$ctrl.currentList.currentListLikes
        if($ctrl.withLikes) {
            $ctrl.uIdList = {
                _id: $ctrl.currentList._id,
                currentItemId: $ctrl.currentList.currentItemId,
                currentProductId: $ctrl.currentList.currentProductId,
                likes: $ctrl.currentList.currentItemLikes || []
            };
        }

        $ctrl.isPageShare = !$ctrl.CommentsSidebarService.isListLevel(sidebarType);

    }

    function onInfoUpdated(result) {

    }

    function getImgType(material, materialVersion) {
        $ctrl.fileName = materialVersion.name ? materialVersion.name : material.name;
        $ctrl.mimeType = materialVersion.mimeType ? materialVersion.mimeType.toLowerCase() : null;
        $ctrl.extension = FileStatsService.getExtension($ctrl.fileName ? $ctrl.fileName.toLowerCase() : null);
        $ctrl.shortExtension = FileStatsService.getShortExtension($ctrl.fileName);
        $ctrl.groupFileType = FileStatsService.detectFileType($ctrl.mimeType, $ctrl.fileName);
        if($ctrl.shortExtension === 'SBDOC'){
            $ctrl.groupFileType = 'sbdoc';
        }
        $ctrl.isImg = FileStatsService.isImage(material);

        if($ctrl.isImg){
            $ctrl.withFullSize = false;
        }
        $ctrl.isVideo = $ctrl.groupFileType === 'video';
        $ctrl.isPdf = $ctrl.groupFileType === 'pdf';
        $ctrl.isDefault = !$ctrl.isPdf && !$ctrl.isImg && !$ctrl.isVideo;
        $ctrl.onFileLoaded({withoutSidePadding: $ctrl.isPdf || $ctrl.isImg});
    }

    function getSBX(item, next) {
       return processDownload(item, onsuccess, onerror);

        function onsuccess(link) {
            //var headers = security.getHttpHeaders(state, params)
            $ctrl.security.getRequest(link, null, function (result) {
                var data = result && result.data !== 'undefined' ? result.data : null,
                    size = parseInt(item.size, 10);
                if ((data && size > 0 || !data && size === 0) ? data : null) {
                    item.content = data;
                }
                next();
            }, onerror)
        }

        function onerror(err) {
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.version.Download.error', 'error');
            //console.log(err);
        }
    }

    function getDownloadLink() {
        processDownload($ctrl.materialVersion, function (link) {
            $ctrl.SBStateService.assignUrl(link, null);
        });
    }

    function onLoaded() {
        bind(true);
    }

    function processDownload(materialVersion, onsuccess, onerror) {
        if ($ctrl.isDownloading) {
            return;
        }

        $ctrl.isDownloading = true;
        $ctrl.MaterialsService.getDownloadLink({
            id: materialVersion.materialId,
            versionId: materialVersion._id,
            //isAnonCallsheet: materialVersion.isAnonCallsheet,
            productId: materialVersion.productId,
            companyId: materialVersion.companyId,
        }, function (src) {
            $ctrl.isDownloading = false;
            $ctrl.LCS.timeout(function () {
                onsuccess(src);
            }, 500);

            return false;
        }, function (err) {
            $ctrl.isDownloading = false;
            onerror(err);
        });
    }

    function bind(isBind) {
        bindM('panelbtns', $ctrl.togglePanel, '.sbup-Dashboard-FileCard-header .panelbtn a');
        bindM('btnToggle', $ctrl.toggleSidebar);
        bindM('btnLike', $ctrl.triggerLike);

        function bindM(btn, m, cls) {
            $ctrl[btn] = $ctrl.element.querySelectorAll(cls ? cls : ('.' + btn));
            if ($ctrl[btn]) {
                $ctrl.LCS.bindElementsClick(isBind, $ctrl[btn], m, btn);
            }
        }
    }

    function triggerLike(e) {
        console.log('triggerLike');
        $ctrl.preventDefault(e);
        if ($ctrl.currentList && $ctrl.currentList.currentItemId) {
            $ctrl.broadcastRoot('UPDATE_' + $ctrl.currentList.elemType + '_LIKES_' + $ctrl.currentList._id + '_' + $ctrl.currentList.currentItemId, $ctrl.uIdList);
        }
    }

    function togglePanel(e) {
        console.log('togglePanel');
        $ctrl.preventDefault(e);
        var id = e.target.getAttribute('data-id');
        if (!isEq(id)) {
            if($ctrl.selectedPanel) {
                set($ctrl.element.querySelector('.panelbtn a[data-id="' + $ctrl.selectedPanel + '"]'), $ctrl.LCS.removeClass);
            }
            $ctrl.LCS.timeout(function (){
                $ctrl.selectedPanel = id;
                set(e.target, $ctrl.LCS.addClass);
            }, 100);
        }

        function set(el, method) {
            method(el, 'active semibold');
            method(el.parentElement, 'active');
            method($ctrl.element.querySelector('.sbup-Dashboard-FileCard-metadata .meta-panel[data-id="' + $ctrl.selectedPanel + '"]'), 'show');
        }
    }

    function onDestroy() {
        bind(false);
    }
}

angular.module('components.sbEpubViewer', [
])
.component('sbEpubViewer', {
    bindings: {
        src: '<?',
    },
    controller: 'SbEpubViewerCtrl',
})
.controller('SbEpubViewerCtrl', SbEpubViewerCtrl);
SbEpubViewerCtrl.$inject = ['TemplateCompileCompCtrlService', 'ScriptLoaderService', '$element'];
function SbEpubViewerCtrl(TemplateCompileCompCtrlService, ScriptLoaderService, $element) {
    var $ctrl = this;

    $ctrl.changedFields = ['src'];

    $ctrl.$onChanges = $onChanges;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.beforePreloadTemplate = beforePreloadTemplate;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function beforePreloadTemplate(reloadTemplate) {
        var file= 'epub';
        ScriptLoaderService.loadAll([{name: file}], [{name: file}], reloadTemplate);
    }

    function $onChanges(changes) {
        console.log(changes);
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                $ctrl.reloadTemplate();
                break;
            }
        }
    }

    function onDestroy() {
        console.log("unloading");
        if($ctrl.book){$ctrl.book.destroy();}
    }

    function getItemTemplate() {
    return '<div class="h-full full-width sb-epub-viewer"> ' +
                '<div class="viewer h-full full-width">' +
                    '<select id="toc"></select>' +
                    '<div id="viewer" class="spreads"></div>' +
                    '<a id="prev" href="#prev" class="arrow">‹</a>' +
                    '<a id="next" href="#next" class="arrow">›</a>' +
                '</div>' +
            '</div>';
    }

    function onLoaded() {
        onDestroy();
        $ctrl.nextBtn = $ctrl.element.querySelector('#next');
        $ctrl.prevBtn = $ctrl.element.querySelector('#prev');
        $ctrl.viewerEl = $ctrl.element.querySelector('#viewer');
        $ctrl.tocEl = $ctrl.element.querySelector('#toc');

        var params = URLSearchParams && new URLSearchParams(document.location.search.substring(1));
        var url = params && params.get("url") && decodeURIComponent(params.get("url"));
        var currentSectionIndex = (params && params.get("loc")) ? params.get("loc") : undefined;

// Load the opf
        console.log('load book ' + $ctrl.src)
        $ctrl.book = ePub($ctrl.src || "https://s3.amazonaws.com/moby-dick/moby-dick.epub");
        var rendition = $ctrl.book.renderTo("viewer", {
            width: "100%",
            height: "100%",
            spread: "always"
        });

        rendition.display(currentSectionIndex);

        $ctrl.book.ready.then(function () {
            next($ctrl.nextBtn, true);
            next($ctrl.prevBtn, true);

            function next(btn, isNext){
                $ctrl.LCS.bindElementListeners(true, btn,  function (e) {
                    goNext(isNext);
                    e.preventDefault();
                });
            }

            function goNext(isNext){
                $ctrl.book.package.metadata.direction === "rtl" ?
                    (isNext ? rendition.prev() : rendition.next()) :
                    (isNext ? rendition.next() : rendition.prev());
            }

            var keyListener = function (e) {
                // Left Key
                if ((e.keyCode || e.which) === 37) {
                    goNext(true);
                }

                // Right Key
                else if ((e.keyCode || e.which) === 39) {
                    goNext(false);
                }
            };

            rendition.on("keyup", keyListener);
            $ctrl.LCS.bindElementListeners(true, document, keyListener, 'keyup');
        });

        rendition.on("rendered", onRendered);
        rendition.on("relocated", onRelocated);
        rendition.on("layout", onLayout);
        function onRendered(section) {
            var current = $ctrl.book.navigation && $ctrl.book.navigation.get(section.href);

            if (current) {
                var $select = $ctrl.tocEl;
                var $selected = $select.querySelector("option[selected]");
                if ($selected) {
                    $selected.removeAttribute("selected");
                }

                var $options = $select.querySelectorAll("option");
                for (var i = 0; i < $options.length; ++i) {
                    var selected = $options[i].getAttribute("ref") === current.href;
                    if (selected) {
                        $options[i].setAttribute("selected", "");
                    }
                }
            }
        }

        function onRelocated(location) {
            console.log(location);
            set($ctrl.book.package.metadata.direction === "rtl" ? $ctrl.prevBtn : $ctrl.nextBtn, location.atEnd);
            set($ctrl.book.package.metadata.direction === "rtl" ? $ctrl.nextBtn : $ctrl.prevBtn, location.atStart);

            function set(btn, type){
                btn.style.visibility = type ? "hidden" : "visible";
            }
        }

        function onLayout(layout) {
            $ctrl.viewerEl.classList[layout.spread ? 'remove' : 'add']('single');
        }

        $ctrl.book.loaded.navigation.then(function (toc) {
            var $select = $ctrl.tocEl,
                docfrag = document.createDocumentFragment();

            toc.forEach(function (chapter) {
                var option = document.createElement("option");
                option.textContent = chapter.label;
                option.setAttribute("ref", chapter.href);

                docfrag.appendChild(option);
            });

            $select.appendChild(docfrag);

            $select.onchange = function () {
                var index = $select.selectedIndex,
                    url = $select.options[index].getAttribute("ref");
                rendition.display(url);
                return false;
            };
        });
    }
}


