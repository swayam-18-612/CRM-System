angular.module('product.preLoading.myActivities.group.service', [
    'product.preLoading.init.group.service',
    'product.preLoading.activities.service',
    'product.preLoading.todoPages.service',
    'product.preLoading.products.service'
])
.service('MyActivitiesGroupLoadingService', MyActivitiesGroupLoadingService);
MyActivitiesGroupLoadingService.$inject = ['InitGroupLoadingService', 'ProductsLoadingService',  'TodoPagesLoadingService',  'ActivitiesLoadingService'];
function MyActivitiesGroupLoadingService(InitGroupLoadingService, Products, TodoPages, Activities) {

    var Tbl = {}, TblTypes = {},
        param = 'teamId',
        pageSize= 50,
        tableParamsColsInit = ['companyId', param, 'type']; //use for view projects  vs activities
    var tables = [

        {t: Products,
            withoutLoad: true,
           // otherParams: ['type'],//set this param to not confuse with the widgets projects which are only active
            processParams: function processParams(params1) {
                var params = _.extend(params1);
                delete params[param];
                return params;
            }
        },

        {t: Activities,
            //withoutLoad: true,
            m: 'getForUser',
           // otherParam: ['type'],
            customLoading: true,
            populate: 'createdById',
            pageSize: pageSize,
            processParams: function(params1) {
                var params = _.extend({
                }, params1);
                delete params[param];
                return params;
            }
        },
        {t: TodoPages,
            //withoutLoad: true,
            m: 'getAllForPreloading'
        }
    ];

    _.each(tables, function (t) {
        var table = t.t,
            name = table.name;
        TblTypes[name] = table.tableType;
        Tbl[TblTypes[name]] = {
            loadingService: table,
            tableParamsColsInit: getTableParams(t.otherParams),
            withoutLoad: t.withoutLoad
        };
    });

    var Resource = new InitGroupLoadingService(Tbl, 'isInitMyActivities', null, TblTypes);

    Resource.prototype.load = function (next, otherParams) {
        var _this = this,
            tasks = {},
        other = {};

        _.each(tables, function (t) {
            if(!t.withoutLoad) {
                add(t.t.name, t.m || 'getAll', t.processParams, t.pageSize, t.populate, t.customLoading);
            }
        });

        async.parallel(tasks, function (err, res) {
            next(null, other);
        });

        function add(table, m, processParams, pageSize, populate, tc) {
            tasks[table] = function (c) {
                _this.loadAndInitTable(_this.TblTypes[table], pageSize, populate, tc ? onCustom : c, m, processParams, true);

                function onCustom(result, fullResult) {
                    if (fullResult) {
                        _.each(['lists', 'callsheets', 'products'], function (p) {
                            other[p] = fullResult[p];
                        });
                    }
                    return c();
                }
            };
        }
    };

    return Resource;

    function getTableParams(other){
        return (other || []).concat(tableParamsColsInit);
    }

}

angular.module('product.preLoading.myCallsheets.group.service', [
    'product.preLoading.init.group.service',
    'product.preLoading.callsheets.service',
    'product.preLoading.products.service'
])
 .service('MyCallsheetsGroupLoadingService', MyCallsheetsGroupLoadingService);
MyCallsheetsGroupLoadingService.$inject = ['InitGroupLoadingService', 'CallsheetsLoadingService', 'ProductsLoadingService'];
function MyCallsheetsGroupLoadingService(InitGroupLoadingService, Callsheets, Products) {

    var Tbl = {}, TblTypes = {},
        param = 'teamId',
        tableParamsColsInit = ['companyId', param];
    var tables = [
        {t: Callsheets,
            m: 'getForUser',
            customLoading: true,
            populate: 'createdById callsheetSentId',
            processParams: processParams
        },

        {t: Products,
            withoutLoad: true,
            otherParams: ['type'],
            processParams: processParams
        }
    ];

    _.each(tables, function (t) {
        var table = t.t,
            name = table.name;
        TblTypes[name] = table.tableType;
        Tbl[TblTypes[name]] = {
            loadingService: table,
            tableParamsColsInit: getTableParams(t.otherParams),
            withoutLoad: t.withoutLoad
        };
    });

    var Resource = new InitGroupLoadingService(Tbl, 'isInitMyCallsheets', null, TblTypes);

    Resource.prototype.load = function (next, otherParams) {
        var _this = this,
            tasks = {},
        other = {};

        _.each(tables, function (t) {
            if(!t.withoutLoad) {
                add(t.t.name, t.m, t.processParams, t.pageSize, t.populate, t.customLoading);
            }
        });

        async.parallel(tasks, function (err, res) {
            next(null, other);
        });

        function add(table, m, processParams, pageSize, populate, tc) {
            tasks[table] = function (c) {
                _this.loadAndInitTable(_this.TblTypes[table], pageSize, populate, tc ? onCustom : c, m, processParams, true);

                function onCustom(result, fullResult) {
                    if (fullResult && fullResult.products && fullResult.products.length > 0) {
                        other.products = fullResult.products;
                    }
                    return c();
                }
            };
        }
    };

    return Resource;

    function processParams(params1) {
        var params = _.extend(params1, {active: true});
        delete params[param];
        return params;
    }

    function getTableParams(other){
        return (other || []).concat(tableParamsColsInit);
    }
}

