angular.module('app.refreshPopup.service', [

])
.service('AppRefreshPopupCtrlService', AppRefreshPopupCtrlService);
AppRefreshPopupCtrlService.$inject = ['ItemTemplateCompileCtrlService', 'SBStateService'];
function AppRefreshPopupCtrlService(ItemTemplateCompileCtrlService, SBStateService) {
    return function ($ctrl, $element) {
        $ctrl.isPopup = true;

        $ctrl.SBStateService = SBStateService;

        $ctrl.refreshApp = refreshApp;
        $ctrl.setTemplateData = setTemplateData;

        $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

        return $ctrl;

        function setTemplateData() {
            $ctrl.modalBodyFormClass = 'long390';
            $ctrl.icon = 'refresh';
            $ctrl.popupTitle = 'Refresh Page';
            $ctrl.withFooterBtns = true;
            $ctrl.btnText = '<span>Refresh</span><span class="hide-ipad"> Page</span>';
            $ctrl.firstBtnMethod = 'refreshApp';

            if ($ctrl.setTemplateDataOther) {
                $ctrl.setTemplateDataOther();
            }
        }

        function refreshApp(e) {
            $ctrl.preventDefault(e);
            if ($ctrl.isUpdating) {
                return;
            }
            $ctrl.isUpdating = true;
            console.log('refreshApp');

            if (typeof ($ctrl.onClose) === 'function') {
                $ctrl.onClose({result: 'refreshApp'});
            }

            $ctrl.SBStateService.refreshPage(function () {
                $ctrl.isUpdating = false;
            });
        }
    }
}

angular.module('user.layout.controller.service', [
    'services.layoutConfigsService'
])
.service('LayoutCtrlService', LayoutCtrlService);
LayoutCtrlService.$inject = ['CPS', 'RootEventsService'];
function LayoutCtrlService(CPS, RootEventsService) {
    return function ($ctrl, $element) {
        $ctrl.RootEventsService = RootEventsService;
        $ctrl.CPS = CPS;
        $ctrl.LCS = CPS.LCS;

        $ctrl.$element = $element;
        $ctrl.element = $ctrl.$element[0];

        $ctrl.watchers = [];
        if($ctrl.changedFields === undefined) {
            $ctrl.changedFields = ['windowWidth', 'windowHeight', 'isMobileOpened'];
        }

        if($ctrl.changedFields) {
            $ctrl.$onChanges = $onChanges;
        }

        $ctrl.$onInit = $onInit;
        $ctrl.$onDestroy = $onDestroy;

        return $ctrl;

        function $onInit() {
            $ctrl.boardWrapper = $ctrl.element.querySelector('.board-wrapper');
            $ctrl.bodyWrapper = $ctrl.element.querySelector('#body-wrapper');
            setWidthClass();
            if($ctrl.onLayoutInit){
                $ctrl.onLayoutInit();
            }
        }

        function $onChanges(changes) {
            if (!changes) {
                return;
            }

            $ctrl.LCS.onFieldChanges(changes, $ctrl.changedFields, method);

            function method(field, change){
                if(field ==='windowWidth'){
                    setWidthClass(change.currentValue);
                }
                if(typeof($ctrl.onOtherChanges) === 'function') {
                    $ctrl.onOtherChanges(field);
                }

                return true;
            }
        }

        function $onDestroy() {
           if($ctrl.onLayoutDestroy) {
               $ctrl.onLayoutDestroy();
           }
            $ctrl.RootEventsService.removeWatchers($ctrl.watchers);
        }

        function setWidthClass(width) {
            var noSidebarGray = $ctrl.LCS._noSidebarGray(width);
            if ($ctrl.noSidebarGray === undefined || $ctrl.noSidebarGray !== noSidebarGray) {
                $ctrl.LCS[noSidebarGray ? 'removeClass' : 'addClass']($ctrl.bodyWrapper, 'icons-only');
                $ctrl.noSidebarGray = noSidebarGray;
            }
        }
    }
}

angular.module('user.cheatSheetButton.component', [
    'services.cheatSheet'
])
.component('cheatSheetButton', {
    controller:'CheatSheetButtonCtrl',
    bindings: {
        btnClass:'@',
        li:'@'
    }
})

.controller('CheatSheetButtonCtrl', CheatSheetButtonCtrl);
CheatSheetButtonCtrl.$inject = ['TemplateCompileCompCtrlService', 'CheatSheetService', '$element'];
function CheatSheetButtonCtrl(TemplateCompileCompCtrlService, service, $element) {
    var $ctrl = this,
        withoutTemplateScope = true;

    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.text = 'Video Tutorial';

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        $ctrl.service = service;
        $ctrl.cheatSheetInfo = $ctrl.service.cheatSheetInfo;
        $ctrl.btnId = 'btnTutorials';
        $ctrl.isLi = $ctrl.li === 'true' || $ctrl.li === true;
        if (!$ctrl.btnClass) {
            $ctrl.btnClass = "btn btn-small without-text transparent no-border hide-lower1024";
        }
    }

    function postInit(){
        $ctrl.addRootWatcherSimple($ctrl.service.onUpdateCheatsheet(onStateChanged));
    }

    function onStateChanged(state) {
        //console.log('CheatSheetButtonCtrl.onUpdateCheatsheet');
        if($ctrl.cheatSheetInfo!==$ctrl.service.cheatSheetInfo) {

            $ctrl.cheatSheetInfo = $ctrl.service.cheatSheetInfo;
            bind(false);//remove bindings
            $ctrl.reloadTemplate();
        }
    }
    
    function getItemTemplate() {
        var an =' analytics-on analytics-action="Cheatsheet" ';
        return $ctrl.CPS.isCollaborator ? '' :
        ($ctrl.cheatSheetInfo ? (
            $ctrl.isLi ? ('<li>' +
                            '<a class="table-div table-fixed full-width" id="' + $ctrl.btnId + '" '+an+'>' +
                                '<div class="col30">'+$ctrl.LCS.getISBDiv('play-circle', 3)+'</div>' +
                                '<div>'+$ctrl.text+'</div>' +
                            '</a>' +
                        '</li>'
                ):
                ('<button type="button" id="' + $ctrl.btnId + '" ' + ($ctrl.btnClass ? ('class="'+$ctrl.btnClass+'" ') : '') + ' tooltip="'+$ctrl.text+'" tooltip-placement="bottom" '+an+'>' +
                    $ctrl.LCS.getISBDiv('play-circle', 2) +
                    '</button>')
            )
            : '');
    }


    function toggleHelp(e){
       // $ctrl.preventDefault(e);
        $ctrl.service.toggleHelp();
    }

    function onLoaded() {
        bind(true);
    }
    function onDestroy() {
        bind(false);
    }

    function bind(isBind) {
        $ctrl.bindElementClickBySelector(isBind, '#' + $ctrl.btnId, toggleHelp);
    }
}

angular.module('user.commentsButton.component', [
    'services.commentsSidebar',
    'services.stateService',
    'services.sessionService',
    'components.feedList.service'
])
.component('commentsButton', {
    controller: 'CommentsButtonCtrl',
    bindings: {
        isPopup: '@',
        page: '@',
        li: '@',
        type: '@',
        btnCls: '@',
        onUpdated: '&'
    }
})
.controller('CommentsButtonCtrl', CommentsButtonCtrl)
CommentsButtonCtrl.$inject = ['TemplateCompileCompCtrlService', 'CurrentTreeListService', 'CommentsSidebarService', 'FeedListService', '$element'];

function CommentsButtonCtrl(TemplateCompileCompCtrlService, CurrentTreeListService, CommentsSidebarService, FeedListService, $element) {
    var $ctrl = this;

    $ctrl.FeedListService = FeedListService;
    $ctrl.CommentsSidebarService = CommentsSidebarService;
    $ctrl.CurrentTreeListService = CurrentTreeListService;

    $ctrl.isOpen = false;
    $ctrl.dontAutoloadTemplate = true;
    $ctrl.SidebarTypes = $ctrl.CommentsSidebarService.SidebarTypes;

    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        //console.log('CommentsButtonCtrl '+$ctrl.componentId);
        $ctrl.isTasks = $ctrl.type === 'tasks';
        $ctrl.isComments = $ctrl.type === 'comments';
        $ctrl.isFilters = $ctrl.type === 'filters';
        $ctrl.isArchived = $ctrl.type === 'archived';
        $ctrl.isPageLevel = $ctrl.page === 'true' || $ctrl.page === true;
        $ctrl.btnId = 'btnTop' + $ctrl.type;
        $ctrl.isLi = $ctrl.li === 'true' || $ctrl.li === true;
        $ctrl.acceptedTypes = $ctrl.CommentsSidebarService.getAcceptedTypes($ctrl.type, $ctrl.isPageLevel);

        onCommentsSidebarUpdated($ctrl.CommentsSidebarService.getSidebarInfo($ctrl.isPopup));
    }

    function postInit() {
        if ($ctrl.isTasks) {
            $ctrl.addRootWatcherSimple($ctrl.FeedListService.onNewsFeedItemCountChanged(updateNewsCounter));
        }

        $ctrl.addRootWatcher('COMMENTS_SIDEBAR_UPDATED', onCommentsSidebarUpdated);
        $ctrl.addRootWatcher('COMMENTS_SIDEBAR_TOGGLE', onToggleSidebar);
    }

    function onCommentsSidebarUpdated(sidebarInfo1) {
        if(sidebarInfo1 && (sidebarInfo1.componentId === $ctrl.componentId)){
            return;
        }
       // console.log('CommentsButtonCtrl.onCommentsSidebarUpdated COMMENTS_SIDEBAR_UPDATED: componentId:' + $ctrl.componentId+ ';sidebarTypeForPage:' + $ctrl.sidebarTypeForPage + '; sidebarInfo.sidebarType: '+ sidebarInfo1.sidebarType);

        var sidebarInfo = _.extend({}, sidebarInfo1);

        if(isSame() && sidebarInfo.isOpen === false){
            setOpen(false);
            $ctrl.sidebarInfo = sidebarInfo;
        }
        else {
            var sidebarTypeForPage = $ctrl.CommentsSidebarService.showBtnOnPage(sidebarInfo, $ctrl.acceptedTypes);

            if ($ctrl.sidebarTypeForPage !== sidebarTypeForPage) {
                $ctrl.sidebarInfo = sidebarInfo;
                $ctrl.sidebarTypeForPage = sidebarTypeForPage;
                if ($ctrl.sidebarTypeForPage === sidebarInfo.sidebarType) {
                    $ctrl.isOpen = sidebarInfo.isOpen;
                }

                var pageInfo = sidebarInfo.pageInfo;
                $ctrl.canShowSidebar = pageInfo.canShowSidebar;
                $ctrl.isUserDashboard = pageInfo.isUserDashboard;
                $ctrl.isLikeWorkflow = pageInfo.isCalendarPage || pageInfo.isLikeWorkflow;
                $ctrl.name = $ctrl.isTasks ? ($ctrl.isUserDashboard ? 'Customize' :
                    ($ctrl.isFilters ? 'Filters' : 'Tasks')) : 'Comments';
                $ctrl.icon = $ctrl.isTasks ? ($ctrl.isUserDashboard ? 'news' :
                    ($ctrl.isLikeWorkflow ? 'filter' : 'taskbar')) : 'conversations';

                switch ($ctrl.type){
                    case 'tasks':
                        $ctrl.icon = $ctrl.isUserDashboard ? 'news' : 'taskbar';
                        break;

                    case 'comments':
                        $ctrl.name = 'Comments';
                        $ctrl.icon = 'conversations';

                        if(sidebarInfo1 && sidebarInfo1.uId !== undefined){

                        }
                        break;

                    case 'filters':
                        $ctrl.name = 'Filters';
                        $ctrl.icon = 'filter';
                        break;

                    case 'archived':
                        $ctrl.name = 'Archived';
                        $ctrl.icon = 'box';
                        break;
                }

                updateNewsCounter();

                $ctrl.reloadTemplate();
            }
        }
       // $ctrl.CommentsSidebarService.nonSidebarPreLoadingService = $ctrl.CurrentTreeListService.nonSidebarPreLoadingService;
        if(typeof($ctrl.onUpdated) === 'function') {
            $ctrl.onUpdated({result: sidebarInfo});
        }

        function isSame(){
           return sidebarInfo && $ctrl.sidebarTypeForPage === sidebarInfo.sidebarType;
        }
    }

    function setOpen(isOpen){
        $ctrl.isOpen = isOpen;
        $ctrl.LCS[$ctrl.isOpen ? 'addClass' : 'removeClass']($ctrl.element.querySelector('.commentbtn'), 'active');
    }

    function updateNewsCounter() {
        if(!$ctrl.isUserDashboard){return;}
        var count = $ctrl.FeedListService.newFeedItemsCount || 0,
            showCount = count > 0;
        if ($ctrl.showCount === undefined || $ctrl.showCount !== showCount) {
            $ctrl.showCount = showCount;
        }
        if ($ctrl.count === undefined || $ctrl.count !== count) {
            $ctrl.count = count;
        }
    }

    function toggleSidebar(e) {
        //console.log('CommentsButtonCtrl.toggleSidebar ' + $ctrl.componentId);
        $ctrl.preventDefault(e);
        onToggleSidebar({open: !$ctrl.isOpen, sidebarType: $ctrl.sidebarTypeForPage});
    }

    function onToggleSidebar(result) {
        if (!result || result.sidebarType !== $ctrl.sidebarTypeForPage) {
            return;
        }

        $ctrl.LCS.timeout(function () {
            var isOpen = result.open;
            setOpen(isOpen);
            //console.log('COMMENTS_SIDEBAR_TOGGLE sidebarType=' + $ctrl.sidebarTypeForPage + '; open=' + isOpen);
            $ctrl.CommentsSidebarService.toggleComments($ctrl.componentId, $ctrl.sidebarTypeForPage, isOpen);
        }, 250);
    }

    function onDestroy() {
        bind(false);
    }

    function onLoaded() {
        bind(true);
    }

    function bind(isBind) {
        $ctrl.bindElementClickBySelector(isBind, '#' + $ctrl.btnId, toggleSidebar);
    }

    function getItemTemplate(){
        bind(false);

        if (!$ctrl.sidebarInfo || !$ctrl.canShowSidebar || !$ctrl.sidebarTypeForPage) {
            return null;
        }

        var active = $ctrl.isOpen ? 'active' : '',
            cls = $ctrl.isTasks ? (
                //($ctrl.isUserDashboard?'sb-pulse ' : '') +
                'with-margin-left without-text transparent speciallink hide-ipad ' + active) :
             ' without-text transparent speciallink position-relative hide-ipad ' + active;

        return $ctrl.isLi ? getLi() : getA(cls);

        function getLi(){
            return "<li class='commentbtn hide-desktop hide-print "+active+"'>" +
                        '<a id="'+$ctrl.btnId+ '" class="table-div full-width">' +
                            '<div class="col30">' + getIcon('gray') + '</div>'+
                            '<div><div>'+$ctrl.name+'</div></div>'+
                        '</a>' +
                    '</li>';
        }

        function getA(cls) {
            var btncls = 'btn btn-small ' + ($ctrl.btnCls ? $ctrl.btnCls : cls);
            return '<a id="' + $ctrl.btnId + '" class="commentbtn ' + btncls + '" tooltip-placement="bottom" tooltip="' + $ctrl.name + '">' +
                        getIcon('centered') +
                        //getPulse() +
                    '</a>';
        }


        function getIcon(cls) {
            return $ctrl.icon ? $ctrl.LCS.getISBDiv($ctrl.icon, null, cls) : '';
        }

        function getPulse() {
            return $ctrl.isUserDashboard && $ctrl.showCount ? (
                '<span class="sb-pulse__ring"></span> ' +
                '<span class="news-feed-count display-block">' +
                '<span>' + ($ctrl.count || '0') + '</span>' +
                '</span> ') : '';
        }
    }
}

angular.module('user.companySelector', [
    'apiServices.Team',
    'chat.service',
    'angularytics.provider'
])
.component('companySelector', {
    controller: 'CompanySelectorCtrl'
})
.controller('CompanySelectorCtrl',  CompanySelectorCtrl);

CompanySelectorCtrl.$inject = ['TemplateCompileCompCtrlService', 'TeamService', '$element', 'ChatService', 'Angularytics'];
function CompanySelectorCtrl(TemplateCompileCompCtrlService, service, $element, ChatService, Angularytics) {
    var $ctrl = this;

    $ctrl.ChatService = ChatService;
    $ctrl.Angularytics = Angularytics;

    $ctrl.analyticsCategory = 'companySelector';

    $ctrl.cCls = 'liCompany';
    $ctrl.changedFields = ['companyId', 'teamId', 'isAuthenticated'];

    $ctrl.service = service;

    $ctrl.select = select;
    $ctrl.setMainSideBar = setMainSideBar;
    $ctrl.goToCompanySettings = goToCompanySettings;
    $ctrl.goToUserSettings = goToUserSettings;

    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.user = $ctrl.SessionService.getSetting('user');
        if($ctrl.CPS.userId && $ctrl.CPS.isAuthenticated && $ctrl.CPS.companies && $ctrl.CPS.companies.length > 0){
            $ctrl.companies =  $ctrl.CPS.companies;
        }else{
            var company = $ctrl.security.getCurrentCompany();
            if(company) {
                $ctrl.companies = [{
                    _id: $ctrl.CPS.companyId,
                    teamId: $ctrl.CPS.teamId,
                    name: company.name,
                    logo: company.logo,
                    logoId: company.logoId,
                    memberType: $ctrl.CPS.memberType
                }];
            }
        }

        setSelected($ctrl.CPS.companyId);
    }

    function postInit() {
        $ctrl.SessionService.onUpdateCompany($ctrl.watchers, onUpdateCompany);
        $ctrl.SessionService.onUpdateUser($ctrl.watchers, load);
        $ctrl.SessionService.onReloadCompanies($ctrl.watchers, load);

        $ctrl.addOnStateChange(onStateChanged);
    }

    function onStateChanged() {
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i],
                v1 = $ctrl.SessionService.getSetting(field),
                v2 = $ctrl.CPS[field];
            if (v1 && !v2 || !v1 && v2 || v1 && v2 && !angular.equals(v1, v2)) {
                console.log('CompanySelectorCtrl: onStateChanged');
                load();
                break;
            }
        }
    }

    function load() {
        var user = $ctrl.SessionService.getSetting('user');
        $ctrl.ChatService.reset(user ? user._id : null);
        $ctrl.Angularytics.setUser($ctrl.security.getCurrentUserId());

        $ctrl.preInit();
        $ctrl.reloadTemplate();
    }

    function setSelected(companyId) {
        if(!$ctrl.companies || !$ctrl.companies.length){return;}
        for (var i = 0; i < $ctrl.companies.length; i++) {
            var c = $ctrl.companies[i];
            if (c._id === companyId) {
                $ctrl.selected = c;
                $ctrl.selectedIndex = i;
                break;
            }
        }
    }

    function onUpdateCompany(item) {
        if (!($ctrl.selectedIndex > -1)) {
            return;
        }

        if (!$ctrl.companies[$ctrl.selectedIndex]) {
            return;
        }

        if (item.name!== undefined && item.name !== $ctrl.companies[$ctrl.selectedIndex].name) {
            $ctrl.companies[$ctrl.selectedIndex].name = item.name;
        }
        if (item.logo!== undefined && item.logo !== $ctrl.companies[$ctrl.selectedIndex].logo) {
            $ctrl.companies[$ctrl.selectedIndex].logo = item.logo;
            $ctrl.companies[$ctrl.selectedIndex].logoId = item.logoId;
        }
        $ctrl.reloadTemplate();
    }

    function getItemTemplate(){
        if(!$ctrl.selected){return '';}
    var comp = '<div class="companylogo table-div fixed-layout">' +
                    '<div class="col22 centered hide-ipad padding-top-bottom-10">' +
                        '<sb-resizable-img img-size="small18" icon="company" icon-level="3" img-prop="logo" area-type="square" without-initials="true" img-watch="true" company-id="'+$ctrl.selected._id+'" size="::null" item="$ctrl.selected"></sb-resizable-img>' +
                    '</div>' +
                    '<div class="companyname text-left centered with-ellipsis hide-lower1400">'+$ctrl.selected.name+'</div>' +
                    ($ctrl.CPS.isAuthenticated ? ($ctrl.LCS.getISBDiv('down-arrow', 2, 'centered sbf14 hide-lower1400') +
                        '<user-menu user="::$ctrl.user" class="display-table-cell clearfix col30 padding-left-12" window-width="$ctrl.windowWidth"></user-menu>') :'') +
                '</div>',

        el = ($ctrl.CPS.isAuthenticated ?('<button type="button" class="btn btn-default dropdown-toggle" dropdown-toggle aria-haspopup="true" aria-expanded="true"> ' + comp + '</button>'): comp);

        if($ctrl.CPS.isAuthenticated) {
            el += '<ul class="dropdown-menu companypicker-popup dropdown-menu-anim" role="menu">' +
                    '<div class="gradient-linear-primary top">' +
                        '<div class="table-div full-width">' +
                            '<div class="centered logo-td col60">' +
                $ctrl.security.getUserImageComponent('$ctrl.user', 'small60', 'container-class="selected"') +
                            '</div>' +
                            '<div class="centered white semibold with-padding-left with-padding-right" ng-bind="$ctrl.user.name"></div>' +
                                '<div class="centered text-right">' +
                                '<a class="btnMyProfile btn btn-small black10">My Profile</a>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                    '<ul>' +
                        getCompanies() +
                        '<auth-logout></auth-logout>'+
                    '</ul>' +
                '</ul>';
        }

        return '<div class="companypicker" ' + ($ctrl.CPS.isAuthenticated ? ' dropdown ' : '') + '>' + el + '</div>';
    }

    function getCompanies() {
        var el = '';
        _.each($ctrl.companies, getC);
        return el;

        function getC(c, i) {
            var isSelected = $ctrl.selected && c._id === $ctrl.selected._id;
     el+= '<li analytics-an analytics data-id="'+c._id+'" class="compLi fixed-layout ' + $ctrl.cCls +
                ( i < ($ctrl.companies.length-($ctrl.CPS.isAuthenticated?0:1))?' with-bottom-border ':'') +
                (isSelected ? 'active' : '') + '">' +
                '<div class="companylogo logo-td">' + getImage(c) +'</div>' +
                '<div class="companyname with-padding-left with-padding-right">' +
                    '<div class="name with-ellipsis">'+c.name+'</div>' +
                    '<div class="subname"><span class="italic">'+$ctrl.service.getMemberType(c)+'</span> ' +
(($ctrl.service.isAdmin(c) || $ctrl.service.isOwner(c)) ? ('<span class="bullet-circle">•</span><a class="gray-dark btnSettings" data-id="'+c._id+'" ' +
    '>Company Settings</a>') : '') +
                    '</div>' +
                '</div>' +
                (isSelected ?('<div class="checkmark">'+$ctrl.LCS.getISBDiv('check-mark', null, 'primary')+'</div>') : '') +
            '</li>';
        }

        function getImage(c) {
            return $ctrl.security.getImage(c, 'small60', 'logo', 200, {
                withSquareImg: true,
                avatar: 'company',
                iconPaths: $ctrl.LCS.getISBPath(3)
            });
        }
    }

    function bind(isBind){
        $ctrl.bindElementClickBySelector(isBind, '.btnMyProfile', $ctrl.goToUserSettings);
        $ctrl.bindElementsClickBySelector(isBind, 'li.compLi', $ctrl.select);
        $ctrl.bindElementsClickBySelector(isBind, 'li.compLi .btnSettings', $ctrl.goToCompanySettings);
    }

    function setMainSideBar(e) {
        if(e){
            //e.stopPropagation();
        }
        return $ctrl.LCS.setMainSideBar(true);
    }

    function select(e) {
        $ctrl.preventDefault(e);
        var id = e.currentTarget.getAttribute('data-id');
        if (!$ctrl.selected || id !== $ctrl.selected._id) {
            assignById(id, 'user.dashboard');
        }
    }
    function assignById(companyId, stateName){
        var c = _.find($ctrl.companies, {_id: companyId});
        if(c) {
            assignUrl(c, stateName);
        }
    }

    function goToCompanySettings(e) {
        $ctrl.preventDefault(e);
        var id = e.currentTarget.getAttribute('data-id');
        $ctrl.setMainSideBar(e);
        assignById(id, 'user.company-settings');
    }

    function goToUserSettings(e) {
        $ctrl.preventDefault(e)
        $ctrl.setMainSideBar(e);
        if($ctrl.companies) {
            var c = _.find($ctrl.companies, {memberType: $ctrl.security.MemberTypes.Owner});
            if(c) {
                assignUrl(c, 'user.profile-settings');
            }
        }
    }

    function assignUrl(c, stateName) {
        return $ctrl.SBStateService.assignUrl($ctrl.CPS.getStateHref(stateName, {
            role: $ctrl.CPS.API_CONFIGS.rolePaths.currentUserPath,
            teamId: c.teamId,
            companyId: c._id
        }));
    }

    function onLoaded(){
        bind(true);
    }

    function onDestroy(){
        bind(false);
    }
}

angular.module('user.darkModeLi.component', [
    'sb.darkReader.service'
])
.component('darkModeLi', {
    controller:'DarkModeLiCtrl'
})

 .controller('DarkModeLiCtrl', DarkModeLiCtrl);
DarkModeLiCtrl.$inject = ['TemplateCompileCompCtrlService', 'DarkReaderService', '$element'];
function DarkModeLiCtrl(TemplateCompileCompCtrlService, service, $element) {
    var $ctrl = this;
    var withoutTemplateScope = true;
    $ctrl.btnId = 'btnDarkMode';
    $ctrl.isLoaded = !service.isNotLoaded;
    $ctrl.toggle = toggle;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    function preInit() {
        setIsOn();
    }

    function setIsOn() {
        $ctrl.isOn = service.isOn;
        $ctrl.name = $ctrl.isOn ? 'Light Mode' : 'Dark Mode';
        $ctrl.icon = $ctrl.isOn ? 'sun' : 'moon';
    }

    function getItemTemplate() {
        if (!$ctrl.isLoaded) {
            return '';
        }
        return '<li>' +
            '<a class="table-div table-fixed full-width" id="' + $ctrl.btnId + '" analytics-on analytics-action="DarkMode">' +
            '<div class="col30">' + $ctrl.LCS.getISBDiv($ctrl.icon, 2) + '</div>' +
            '<div>' + $ctrl.name + '</div>' +
            '</a>' +
            '</li>';
    }

    function onLoaded() {
        bind(true);
    }

    function onDestroy() {
        bind(false);
    }

function bind(isBind) {
    $ctrl.bindElementClickBySelector(isBind, '#' + $ctrl.btnId, toggle);
    }

    function toggle(e) {
        $ctrl.preventDefault(e);
        service.toggle();
        setIsOn();
        $ctrl.reloadTemplate();
    }
}

angular.module('user.fullscreenToggle.component',[
])
.component('fullscreenLi', {
    controller: 'FullscreenToggleCtrl',
    bindings: {
        windowWidth: '<?'
    }
})

.controller('FullscreenToggleCtrl', FullscreenToggleCtrl);

FullscreenToggleCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];
function FullscreenToggleCtrl(TemplateCompileCompCtrlService, $element) {
    //console.log('FullscreenToggleCtrl');
    var $ctrl = this;

    $ctrl.changedFields = ['windowWidth'];

    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl.$onChanges = $onChanges;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function getItemTemplate() {
        return '<li class="hide-ipad">' +
                    '<a class="table-div table-fixed full-width">' +
                        '<div class="col30">' + $ctrl.LCS.getISBDiv($ctrl.icon, 2, 'icon gray') + '</div>' +
                        '<div id="text"></div>' +
                    '</a>' +
                '</li>';
    }

    function onLoaded() {
        $ctrl.aEl = $ctrl.element.querySelector('a');
        if($ctrl.aEl ) {
            $ctrl.iconEl = $ctrl.aEl.querySelector('.icon');
            $ctrl.textEl = $ctrl.aEl.querySelector('#text');
        }
        setClass();
        bind(false);
        bind(true);
    }

    function onDestroy() {
        bind(false);
    }

    function bind(isBind) {
        $ctrl.LCS.bindElementListeners(isBind, $ctrl.aEl, $ctrl.LCS.toggleFullscreen);
    }

    function $onChanges(changes) {
        console.log(changes);
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                setClass();
                break;
            }
        }
    }

    function setClass() {
        var isFullscreen = $ctrl.LCS.isFullscreen(true);
        if ($ctrl.isFullscreen === undefined || isFullscreen !== $ctrl.isFullscreen) {
             if(isFullscreen) {
                 $ctrl.LCS.replaceClass($ctrl.iconEl, 'resize-expand', 'resize-down');

             }else{
                 $ctrl.LCS.replaceClass($ctrl.iconEl, 'resize-down', 'resize-expand');
             }
            $ctrl.textEl.innerText = isFullscreen ? 'Non Fullscreen ': 'Fullscreen';
            $ctrl.isFullscreen = isFullscreen;
        }
    }
}


