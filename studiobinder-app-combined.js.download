            MemberTypes: [
                {value: 1, text: 'Admin'},
                {value: 2, text: 'Owner', hide:true},
                {value: 0, text: 'Member'}
            ],

            Statuses : {Pending: 1, Approved: 2, Rejected: 3},
        },

        Filters = [],

        CompOptions = angular.copy(compOptions),

        ListTreeServiceParams = {

            maxLevel: 1,
            hideLevel0: true,
            withHarcodedAll: true,
            dontStartTreeWithAll: true,
            // level0Name: 'Team',
            preLoadingTableName: 'TeamLists',
            listCheckerConsidersItemsCount: true,

            // cachedListName: 'teamList',
            ungroupOnTreeDelete: true
        },

        ListParams = {
            includeFields: ['memberType', 'userId', 'order', 'teamInvitationId'],
            searchFields: ['name', 'email'],
            orderFields: ['order'],
            populate: 'userId teamInvitationId'
        },

        KeyboardServiceParams = null,

        PopupOperations = {

            removeSelectedTeam: {
                template: getBasePopupTemplateByTag('remove-team'),
                type: 'Remove Selected',
                size: 'sm',
                transp: ' '
            },

            resendTeamInvites: {
                type: 'Resend Selected',
                template: getBasePopupTemplateByTag('resend-team-invites'),
                size: ' ',
                transp: ' '
            },
        },

        Hotkeys = null,

        SidebarOptions = null;

    return {
        TeamMemberType: TeamMemberType,
        PropTypes: PropTypes,
        Settings: Settings,
        Options: Options,
        Filters: {Filters: Filters},
        ViewProp: 'teamView',

        CompOptions: CompOptions,
        ListTreeServiceParams: ListTreeServiceParams,
        ListParams: ListParams,
        KeyboardServiceParams: KeyboardServiceParams,

        PopupOperations: PopupOperations,
        Hotkeys: Hotkeys,
        SidebarOptions: SidebarOptions,
    };
}

