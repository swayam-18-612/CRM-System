angular.module('product.document.version.edit.component', [
    'product.document.edit.service',
    'services.blocksSetup'
])
.component('documentVersionPopup', popupComponentParams('DocumentVersionPopupCtrl'))
.controller('DocumentVersionPopupCtrl',DocumentVersionPopupCtrl);
DocumentVersionPopupCtrl.$inject = ['DocumentVersionPopupCtrlService', '$element'];
function DocumentVersionPopupCtrl(DocumentVersionPopupCtrlService, $element) {

    var $ctrl = this;

    $ctrl.isPopup = true;
    $ctrl.otherListField = 'documentId';

    $ctrl.preInitDocumentVersion = preInitDocumentVersion;
    $ctrl.preSetTemplateData = preSetTemplateData;
    $ctrl.onSaveAfter = onSaveAfter;
    $ctrl.getTemplatesCond = getTemplatesCond;

    $ctrl = new DocumentVersionPopupCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitDocumentVersion() {
        console.log('DocumentVersionPopupCtrl.preInitDocumentVersion');
        $ctrl.templateIdField = 'documentTemplateId';
        $ctrl.dontDuplicateNameSet = true;
        $ctrl.Colors = $ctrl.service.Colors; //script colors

        $ctrl.otherColumnColorProps = {
            showColorName: true
        }
        $ctrl.notesProp = $ctrl.item.type === 3 ? 'notes' : null;

        if ($ctrl.isDuplicate) {
            $ctrl.type = 'Duplicate';
            delete $ctrl.item.contentVersion;
            delete $ctrl.item.contentVersionId;
            $ctrl.item = _.extend({}, $ctrl.item, {
                isDuplicate: true
            });
            if ($ctrl.item.afterId) {
                $ctrl.item.versionId = $ctrl.item.afterId;
            } else if (!$ctrl.item.versionId) {
                $ctrl.item.versionId = $ctrl.item._id;
            }
            $ctrl.copyItem = _.clone($ctrl.item);
        }

        if ($ctrl.item.isTemplate) {
            $ctrl.item.name = 'Template ' + ($ctrl.item.name ? $ctrl.item.name : $ctrl.itemTitle);
        }
    }

    function preSetTemplateData() {
        if ($ctrl.item.isTemplate) {
            $ctrl.itemTitle = 'Template';
            $ctrl.icon = 'star';
            $ctrl.iconLevel = 2;
            $ctrl.popupTitle = 'Create Template';
            $ctrl.btnText = '<span>Create New</span><span class="hide-ipad"> ' + $ctrl.itemTitle + '</span>';
        } else {
            $ctrl.icon = ($ctrl.isNew ? ($ctrl.isDuplicate ? 'copy' : 'plus') : 'pencil');
            $ctrl.itemTitle = $ctrl.item.type === 3 ? 'Version' : 'Revision';
            $ctrl.popupTitle = ($ctrl.isNew ? ($ctrl.isDuplicate ? 'Duplicate' : 'Create New') : 'Rename') + ' ' + $ctrl.itemTitle;
            $ctrl.btnText = '<span>' + ($ctrl.isNew ? ($ctrl.isDuplicate ? 'Duplicate' : 'Create New') : 'Save') + '</span><span class="hide-ipad"> ' + $ctrl.itemTitle + '</span>';
        }

        $ctrl.withFooterBtns = true;
        $ctrl.withBtnDisabled = true;
        $ctrl.textAnalytics = $ctrl.removeHtmlTags($ctrl.popupTitle);
    }

    function onSaveAfter(result) {
        if (result.isTemplate && result.item) {
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentTemplate.Create.success', 'success');
        }
    }

    function getTemplatesCond() {
        return {isTemplate: true, type: $ctrl.item.type, companyId: $ctrl.CPS.companyId};
    }
}

angular.module('product.document.edit.service', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'apiServices.DocumentVersions',
    //'product.calendar.item.edit.controller.service'
])
.service('DocumentVersionPopupCtrlService', DocumentVersionPopupCtrlService);
                                                                        //CalendarItemEditCtrlService
DocumentVersionPopupCtrlService.$inject = ['GeneralItemEditCtrlService', 'DocumentVersionsService','BlocksSetupService'];
function DocumentVersionPopupCtrlService(GeneralItemEditCtrlService, service, BlocksSetupService) {
    return function ($ctrl, $element, isPopup) {

        $ctrl.BlocksSetupService = BlocksSetupService;

        $ctrl.preInitGeneral = preInitGeneral;

        //$ctrl.postInitGeneralOther = postInitGeneral; //for CalendarItemEditCtrlService
        $ctrl.postInitGeneral = postInitGeneral; //for GeneralItemEditCtrlService

        $ctrl.onChangeOther = onChangeOther;

        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function preInitGeneral() {
            console.log('DocumentVersionPopupCtrlService.preInitGeneral');
            $ctrl.service = service;
            $ctrl.extraParam.service = service;

            if($ctrl.preInitDocumentVersion){
                $ctrl.preInitDocumentVersion();
            }

            $ctrl.setColorWithVersionAndDesc($ctrl.item.type !== 1 && !$ctrl.item.isTemplate);
        }

        function postInitGeneral(){

            var page = $ctrl.BlocksSetupService.getCurrentTodoPage().text;
            if ($ctrl.isDuplicate) {
                $ctrl.item = $ctrl.service.getDuplicate($ctrl.item, null, $ctrl.extraParam.items);

                if($ctrl.item.type !== 3) { // if is not avscript
                    $ctrl.item.notes = 'This revision was duplicated from <span class="semibold">v' + ($ctrl.copyItem.version + ($ctrl.copyItem.subversion ? ('.' + $ctrl.copyItem.subversion) : '')) +
                        ' “' + $ctrl.copyItem.name + '</span>” on the <span class="semibold">' + page + '</span> page.';
                }
                $ctrl.item.summary = ($ctrl.item.isTemplate ? 'template' : 'duplicate') + '|' + page;
            }
            else {
                $ctrl.icon = $ctrl.item.type === 1 ? 'document1' : ($ctrl.item.type === 2 ? 'sbx' : 'avscript');
            }
            $ctrl.prevColor = $ctrl.item.color;

            if($ctrl.postInitDocumentVersion){
                $ctrl.postInitDocumentVersion();
            }
        }

        function onChangeOther(result) {
            console.log('onChangeOther');
            if (result) {
                var field = result && result.selected && result.selected.field ? result.selected.field : null;
                if (field === 'color') {
                    $ctrl.item.name = ($ctrl.prevColor ? $ctrl.item.name.replace(getSufix($ctrl.prevColor), '') :  $ctrl.item.name).substring(0, 150) + getSufix($ctrl.item.color);

                    $ctrl.prevColor = $ctrl.item.color;

                    function getSufix(color) {
                        return ' - ' + _.find(service.Colors, {id: color}).name + ' Revision';
                    }
                }
            }
        }

    }
}

angular.module('product.document.scriptSynced.component', [
    'services.blocksSetup',
    'services.stateService'
])
.component('syncScriptToProjectPopup', popupComponentParams('ScriptSyncedToProjectCtrl'))
.controller('ScriptSyncedToProjectPopupCtrl', ScriptSyncedToProjectPopupCtrl);

ScriptSyncedToProjectPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', 'BlocksSetupService', '$element'];
function ScriptSyncedToProjectPopupCtrl(ItemTemplateCompileCtrlService, BlocksSetupService, $element) {
    console.log('ScriptSyncedToProjectPopupCtrl');
    var $ctrl = this;

    $ctrl.BlocksSetupService = BlocksSetupService;

    $ctrl.isPopup = true;

    $ctrl.blocks = [];

    $ctrl.goTo = goTo;

    $ctrl.preInit = preInit;
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInit() {
        loadBlocks();
    }

    function setTemplateData() {
        $ctrl.icon = 'transition';
        $ctrl.iconLevel = 4;
        $ctrl.popupTitle = 'What\'s Next?';
        $ctrl.withFooterBtns = false;
        $ctrl.modalBodyClass = 'margin-bottom-50';
    }

    function getPopupBodyContent() {
return '<form name="$ctrl.formHolderItem[$ctrl.formName]" class="auto" novalidate autocomplete="off">' +
    $ctrl.getErrorBlock() +
          '<div class="form-group spacing-half-top">' +
              '<div class="feature-selector product-boxes clearfix tooltip-bigger inline">' +
                  '<div ng-repeat="(id, item) in $ctrl.blocks" ng-if="item.isSelectable" ng-click="$ctrl.setBlock(id, $event)"  class="product-box col-md-3 col-sm-3 col-xs-6 {{item.icon}}" ng-class="{\'active with-primary-border\':$ctrl.isBlock(id)}">' +
                      '<div class="table-div">' +
                          '<div class="centered">' +
                              '<div tooltip-html="$ctrl.getTooltip(item)|unsafe" tooltip-placement="top">' +
                                  '<div class="circle-check"><span class="sbf check-mark"></span></div>' +
                                  '<div class="icon text-center sbf" ng-class="item.icon" ng-style="{color:item.color}"></div>' +
                                  '<div class="name text-center" ng-bind="item.shortName ? item.shortName : item.name"></div>' +
                              '</div>' +
                          '</div>' +
                      '</div>' +
                  '</div>' +
              '</div>' +
          '</div>' +
      '</form>' ;
    }

    function loadBlocks() {
        var overviewBlocks = $ctrl.BlocksSetupService.overviewBlocks;
        for (var id in overviewBlocks) {
            if (id === '551b2066424bbb9d1cc87004' || id === '551b2066424bbb9d1cc87005' || id === '551b2066424bbb9d1cc87006' || id === '551b2066424bbb9d1cc87008' || id === '551b2066424bbb9d1cc87010' || id === '551b2066424bbb9d1cc87011') {
                $ctrl.blocks.push(overviewBlocks[id]);
            }
        }
    }

    function goTo(event,item) {
        console.log('syncScriptToProjectPopup.goto');
        var r = item.url.split('/'),
            p = {productId: $ctrl.CPS.productId};
        if (r.length > 1) {
            var p1 = r[1].split(':');
            p[p1[0]] = p1[1];
        }
        var name = 'user.product.' + r[0],
            params = $ctrl.CPS.currentPathParams(p);
        close();
        if(event.shiftKey){
            $ctrl.SBStateService.openInNewWindow(name, params);
        }
        else {
            return $ctrl.CPS.transitionTo(name, params);
        }
    }

    function close() {
        if (typeof ($ctrl.onClose) === 'function') {
            $ctrl.onClose({result:'cancel'});
        }
    }
}

angular.module('product.document.template.component', [
