})
.controller('StripsDrpMenuCtrl', StripsDrpMenuCtrl);

StripsDrpMenuCtrl.$inject = ['SBDrpMenuCtrlService', '$element'];
function StripsDrpMenuCtrl( SBDrpMenuCtrlService, $element) {
    console.log('StripsDrpMenuCtrl');
    var $ctrl = this;

    $ctrl.withChecks = true;

    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new SBDrpMenuCtrlService($ctrl, $element);

    function getItemTemplate() {
        var el = "<div class='dropdown-menu custom-drp-ul custom-icon " +
            ($ctrl.fixedHeight ? "fixedHeight " : '') +
            ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '') + "'>";
            if($ctrl.header) {
                el += "<div class='header clearfix'>" + $ctrl.header + "</div>";
            }
            el += "<div class='custom-wrapper'>";
            var i = 0;
            _.each($ctrl.list, function (item) {
                el += "<div class='"+$ctrl.itemClass+" inrow' data-id='" + item._id + "' data-index='" + (i++) + "'>" +
                        "<label class='sbf text-center customitem "+item[$ctrl.valueField]+"'><input type='checkbox'><span></span><span></span></label>" +
                      "</div>";
            });

        return el + '</div>' +
            '</div>' +
            $ctrl.getSaveBtns();
    }
}

angular.module('dropdowns.sbDropdown.strips.component', [
    'dropdowns.sbDropdown.strips.menu.component',
    'dropdowns.sbDropdown.controller.service'
])
.component('sbStripsDropdown', sbPageDrpComponentParams('StripsDrpCtrl', {
    header: '<?'
}))
.controller('StripsDrpCtrl', StripsDrpCtrl);
StripsDrpCtrl.$inject = ['SBFieldTypesService', 'SBFieldInitCtrlService', 'SBDrpInitCtrlService', '$element', '$attrs'];
function StripsDrpCtrl(SBFieldTypesService, SBFieldInitCtrlService, SBDrpInitCtrlService, $element, $attrs) {

    var withoutTemplateScope = true;

    var $ctrl = this;
    $ctrl.menuTag = 'sb-strips-dropdown-menu';
    $ctrl.SBFieldMethods = SBFieldTypesService.SBFieldMethods;
    $ctrl.propType = SBFieldTypesService.PropTypes.StripMiniTitle;
    $ctrl.$onDestroy = $onDestroy;

    $ctrl = new SBFieldInitCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

    $ctrl.onInitFieldLoaded = onInitFieldLoaded;
    $ctrl.generateDrpMenuContent = generateDrpMenuContent;

    $ctrl.setDisplayValue = setDisplayValue;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.setInputField = false;
        $ctrl.withRepeatFromDrp = true;
        $ctrl = new SBDrpInitCtrlService($ctrl, $element);
    }

    function onInitFieldLoaded(){
        $ctrl.spanText = $ctrl.element.querySelector('#spanItemText');

        $ctrl.onRepeatFieldLoaded();
    }

    function $onDestroy() {
        if($ctrl.onInitDestroy){$ctrl.onInitDestroy();}
    }

    function setDisplayValue() {
        if($ctrl.preDisplayValue){
            $ctrl.preDisplayValue();
        }
        var info = $ctrl.getDisplayValue($ctrl.value);
        $ctrl.spanText.innerHTML = info.content || info.placeholder;
        $ctrl.LCS[info.hasPlaceholderCls ? 'addClass' : 'removeClass']($ctrl.spanText, 'empty');
    }

    function generateDrpMenuContent() {
        return {
            $ctrl: {
                list: $ctrl.initList,
                value: angular.copy($ctrl.value),
                onSelect: $ctrl.onSelect,
                drpClassAttr: $ctrl.drpClassAttr
            },
            template: ($ctrl.fixedHeight ? ("fixed-height='true' ") : '') +
                "list='::$ctrl.list' " +
                "value='::$ctrl.value' " +
                "on-select='$ctrl.onSelect(result)' "
        };
    }
}

angular.module('dropdowns.sbDropdown.style.menu.component', [
    'dropdowns.drpMenu.controller.service'
])
.component('sbStyleDropdownMenu', {
    bindings: {
        fixedHeight: '@',
        labelField: '@',
        valueField: '@',
        //header: '<',
        onSelect: '&',
        //variables:

        list: '<',
        value: '<',
    },
    controller: 'StyleDrpMenuCtrl',
})
.controller('StyleDrpMenuCtrl', StyleDrpMenuCtrl);

StyleDrpMenuCtrl.$inject = ['SBDrpMenuCtrlService', 'SBFieldTypesService', '$element'];
function StyleDrpMenuCtrl( SBDrpMenuCtrlService, SBFieldTypesService, $element) {
    console.log('StyleDrpMenuCtrl');
    var $ctrl = this;
    $ctrl.SBFieldTypesService = SBFieldTypesService;

    $ctrl.withChecks = true;
    $ctrl.header = 'Style';
    $ctrl.subheader = 'You can further customize these after applying';

    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new SBDrpMenuCtrlService($ctrl, $element);

    function getStyle(Style) {
        return $ctrl.SBFieldTypesService.getStyleProps().map(function (p) {
            var v = Style[p];
            return v ? ($ctrl.SBFieldTypesService.getCSSProp(p) + ':' + v + ';') : '';
        }).join('');
    }

    function getItemTemplate() {
        return '<div class="dropdown-menu custom-drp-ul custom-style ' +
            ($ctrl.fixedHeight ? 'fixedHeight ' : '') +
            ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '') + '"><div> ' +
            ($ctrl.header ? ('<div class="header clearfix full-width">' +
                $ctrl.LCS.getISBDiv('style', 2, 'pull-left with-margin-right position-relative', 'style="top:5px"') + $ctrl.header + '</div>') : '') +
            ($ctrl.subheader ? ('<div class="s clearfix full-width">' + $ctrl.subheader + '</div>') : '') +
            '<div class="custom-wrapper full-width fancy-scrollbar">' + getItems() + '</div>' +
            '</div>' +
            '</div>';

        function getItems() {
            return $ctrl.list ? $ctrl.list.map(function (item, i) {
                var s = getStyle(item);
                return '<div class="' + $ctrl.itemClass + ' with-cursor with-transition inrow ql-editor sbitemstyle' +
                    (item.id === $ctrl.value ? ' active' : '') + '" data-h="' + item.h + '" data-id="' + item.id + '" data-style="' + item.id + '" data-index="' + (i++) + '" ' + (s ? ('style="' + s + '"') : '') + '>' +
                    '<h1' +
                    (item.hClass ? (' class="' + item.hClass + '" ') : '') +
                    (item.hStyle ? (' style="' + item.hStyle + '"') : '') +
                    '>' + item[$ctrl.labelField] + '</h1>' +
                    '<p' +
                    (item.pClass ? (' class="' + item.pClass + '" ') : '') +
                    (item.pStyle ? (' style="' + item.pStyle + '"') : '') +
                    '>' + item.p + '</p>' +
                    '</h1>' +
                    '</div>';
            }).join('') : '';
        }
    }
}

