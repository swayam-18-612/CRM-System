                                                '<div class="last-synced" ng-if="s.lastSyncedScriptId"><span class="sbf sync icon"></span> Last synced {{s.lastSyncedAt|amDateFormat:(\'MMM D @ \' + $ctrl.CPS.timeFormat)}}</div>' +
                                            '</div>' +
