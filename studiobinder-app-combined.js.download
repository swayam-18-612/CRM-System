                        "<p>You can toggle to view your sidebar of scenes here.</p>",
                    introSidebar:  "<div class='title'>Storyboard sidebar</div>" +
                        "<p>You can swap between storyboards here.</p><p>If you imported a script, each scene will be listed under the “Imported Scenes” tab along with a script preview per scene so you can tag your shots.</p><p>If you don’t have a script, or want to create one-off storyboards, switch to the “Custom Boards” tab."
                });


                if (canEdit) {
                    addFilters(listTitle);
                    addNavFilterStep('button[data-info="ADDITEM"]', {
                        intro: "<div class='title'>Add new</div>" +
                            "<p>Click here to add storyboard frames.</p>"
                    });
                }

                previewScript({
                    intro: "<div class='title'>Shot Tagger</div>" +
                        "<p>Click here to view the scene script and tag new shots.</p>"
                });

                addGeneratePDFStep({
                    listTitle: listTitle
                });

                addSettingsStep(null, [
                    {cls:'a[data-type="aspectRatio"]' , other: {
                            intro: "<div class='title'>Aspect ratio</div>" +
                                "<p>Adjust the aspect ratio of panels.</p>"
                        }
                    },{cls:'a[data-type="shotNumbering"]' , other: {
                            intro: "<div class='title'>Shot nmbering</div>" +
                                "<p>Adjust how your shots will be numbered.</p>"
                        }
                    },{cls:'a[data-type="shotSpecs"]' , other: {
                            intro: "<div class='title'>Customize frames</div>" +
                                "<p>There are many more shot specs you can toggle on. Be sure to explore them here.</p>"
                        }
                    }
                ]);

                addCommentsStep(filters);
                addViewTypeStep('Adjust the number of columns your frames will be organized within.');
                addVersionsStep({listTitle: listTitle});

                addShareStep(subheader);
                //addTasksStep();
                addTutorialsStep({introExtra: 'story board'});
            }

            function setShotListSteps() {
                var listTitle = 'shot list';
                if (!addFirstItemStep({
                    intro: "<div class='title'>This is a shot</div>" +
                        "<p>Shots are listed in rows like this. " + (canEdit ? "You can click on any item to edit it on-the-fly." : '') + "</p>"
                }, '.scene')) {
                    return;
                }

                //1. Highlight sidebar.
                addLeftSidebarStep({
                    intro: "<div class='title'>Toggle sidebar</div>" +
                          "<p>You can toggle to view your sidebar of shot lists here.</p>",
                    introSidebar: "<div class='title'>Shot lists sidebar</div>" +
                        "<p>You can swap between shot lists here.</p><p>If you imported a script, each scene will be listed under the “Imported Scenes” tab along with a script preview per scene so you can tag your shots.</p><p>If you don’t have a script, or want to create one-off shot lists, switch to the “Custom Lists” tab.</p>"
                });

                if (canEdit) {
                    addFilters(listTitle);

                    addNavFilterStep('#btnAddDrp', {
                        intro: "<div class='title'>Add new</div>" +
                            "<p>Click here to add new shots, camera setups, or banner notes.</p>"
                    });
                }

                previewScript({
                    intro: "<div class='title'>Shot Tagger</div>" +
                        "<p>Click here to view the scene script and tag new shots.</p>"
                });

                addGeneratePDFStep({
                    listTitle: listTitle
                });

                addSettingsStep(null, [
                    {cls:'a[data-type="aspectRatio"]' , other: {
                        intro: "<div class='title'>Aspect ratio</div>" +
                                "<p>Adjust the aspect ratio of images here.</p>"
                        }
                    },{cls:'a[data-type="shotNumbering"]' , other: {
                            intro: "<div class='title'>Shot numbering</div>" +
                                "<p>Adjust how your shots will be numbered.</p>"
                        }
                    },{cls:'a[data-type="shotSpecs"]' , other: {
                            intro: "<div class='title'>Customize columns</div>" +
                                "<p>There are more details you can adjust within shots. Be sure to explore them here.</p>"
                        }
                    }
                ]);

                addCommentsStep(filters);
                addViewTypeStep('You can view your shot list as a list or in storyboard mode.');

                addVersionsStep({listTitle: listTitle});
                addShareStep(subheader);
                //addTasksStep();
                addTutorialsStep({introExtra: 'shot list'});

                return steps;
            }

            function addViewTypeStep(txt) {
                var cls = '.dropdown-wrapper #btnColumns',
                    clsMenu = cls+'+.dropdown-menu',
                    btn = addNavFilterStep(cls, {
                        forceOpen: true,
                        openDrp: true,
                        intro:  "<div class='title'>Toggle layout</div>" +
                            "<p>Toggle between the view types here.</p>"
                    });

                addNavFilterStep(clsMenu, {
                    intro: "<div class='title'>Change layout</div>" +
                        "<p>"+txt+"</p>"
                });

                closeEl.closeDrp = btn;
            }

            function addBtnsStep(){
                var cls = '.dropdown-wrapper #btnAddDrp',
                    clsMenu = cls+'+.dropdown-menu',
                    btn = addNavFilterStep(cls, {
                        forceOpen: true,
                        openDrp: true,
                        intro:  "<div class='title'>Add Els</div>" +
                            "<p>Settings ....</p>"
                    });

                addNavFilterStep(clsMenu, {
                    intro:  "<div class='title'>Drp</div>" +
                        "<p>Drp txt</p>"
                });

                closeEl.closeDrp = btn;
            }

            function previewScript(other) {
                /*4. Highlight Script Preview*/
                addNavFilterStep('button[data-info="TOGGLESCENE"]', _.extend({
                    intro: "<div class='title'>Preview Script</div>" +
                        "<p>If there is an associated screenplay, read the scene here.</p>"
                }, other));
            }

            function setContactsSteps() {
                var itemTitle = 'contact';
                var listTitle = 'contact list';
                if (!addFirstItemStep({
                    intro: "<div class='title'>This is a "+itemTitle+"</div>" +
                        "<p>Each row has important contact details within it. Most of this information will ultimately be added to the call sheet.</p>"
                })) {
                    return;
                }

                //if (canEdit) {   addFilters(listTitle);}

                //1. Highlight sidebar.
                addLeftSidebarStep({
                    intro: "<div class='title'>Toggle sidebar</div>" +
                        "<p>You can toggle to view your sidebar of "+listTitle+"s here.</p>",
                    introSidebar: "<div class='title'>Contact lists</div>" +
                        "<p>You can swap between contact lists here.</p><p>Based on the assigned role of a contact, they will be automatically assigned into these categories.</p>"
                });

                addList();

                addSearchBtn({ intro: "<div class='title'>Search "+itemTitle+"s</div>" +
                        "<p>Easily filter your current contact list by name, role, email, or phone.</p>"});

                //btns on filters
                if (canEdit) {
                    addNewBtn({
                        intro: "<div class='title'>Add new "+ itemTitle +"s</div>" +
                            "<p>Click here to add new "+ itemTitle +"s.</p>"
                    });
                }

                addNavFilterStep('a.btnExistingContacts', {
                    intro: "<div class='title'>Add existing contacts</div>" +
                        "<p>If you want to import a contact (or entire contact list) from a previous StudioBinder project, search and select existing contacts here.</p>"});

                addGeneratePDFStep({listTitle: listTitle});
                addSettingsStep();
                addCommentsStep(filters);

                addShareStep(subheader);
                //addTasksStep();
                addTutorialsStep({introExtra: 'manage production contacts'});

                function addList() {
                    var el = _this.LCS.bodyElement.querySelector('.side-nav #btnNewList1');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Custom contact lists</div>" +
                                "<p>You can also create custom contact lists, each with their own customized columns.</p><p>Since each contact list can be easily printed and shared, custom lists are a great way to quickly generate lists for meetings, rehearsals, lunch orders, shoot days, tech scouts, and more. When paired with messaging, you can keep an entire list of contacts up to date with production announcements.</p>",
                            position: 'left'
                        });
                    }
                }

                function addRateColStep(firstItem, other) {
                    var el = firstItem.querySelector('.rate-col');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Rate</div>" +
                                "<p>Add a rate to each element.</p>",
                            position: 'left'
                        }, other);
                    }
                }
            }

            function setLocationsSteps() {
                var itemTitle = 'location';
                var listTitle = 'group';
                if (!addFirstItemStep({
                    intro: "<div class='title'>This is a "+itemTitle+"</div>" +
                        "<p>Each row has important location details within it.</p><p>Each location you create can be assigned to scenes on the Stripboard and Scene Breakdown pages.</p><p>Additionally, you can insert locations on a call sheet and all of its pertinent details are populated automatically.</p>"
                })) {
                    return;
                }

                //if (canEdit) {   addFilters(listTitle);}

                //1. Highlight sidebar.
                addLeftSidebarStep({
                    intro: "<div class='title'>Toggle sidebar</div>" +
                        "<p>You can toggle to show or hide your sidebar of "+itemTitle+"s here</p>",
                    introSidebar: "<div class='title'>Groups</div>" +
                        "<p>You can swap between location groups here.</p><p>For example, you may want to create groups when location scouting or geography, status, or story needs. It’s up to you.</p>"
                });

                addSearchBtn({ intro: "<div class='title'>Search "+itemTitle+"s</div>" +
                        "<p>Search and filter down "+itemTitle+"s here.</p>"});

                //btns on filters
                if (canEdit) {
                    addNewBtn({
                        intro: "<div class='title'>Add new "+ itemTitle +"s</div>" +
                            "<p>Click here to add new locations.</p>"
                    });
                }

                addSettingsStep();
                addGeneratePDFStep({listTitle: listTitle});
                addCommentsStep(filters);

                addShareStep(subheader);
                addTutorialsStep({introExtra: 'manage locations'});
            }

            function setElementsSteps() {
                var itemTitle = 'element';
                var listTitle = 'category';
                if (!addFirstItemStep({
                    intro: "<div class='title'>Element</div>" +
                        "<p>Elements are listed in rows like this. You can rename the element or replace the avatar image.</p>"
                })) {
                    return;
                }

                addRateColStep(firstItem);

                addNotesStep(firstItem, {itemTitle: itemTitle});

                addScriptColStep(firstItem);
                addTagsColStep(firstItem);
                addScenesColStep(firstItem);
                //1. Highlight sidebar.
                addLeftSidebarStep({
                    intro: "<div class='title'>Toggle sidebar</div>" + "<p>This button can show or hide the <b>Categories sidebar</b>.</p>",
                    introSidebar: "<div class='title'>Categories sidebar</div>" +
                        "<p>Switch between the various element categories here.</p>"
                });

                addSearchBtn({ intro: "<div class='title'>Search "+itemTitle+"s</div>" +
                        "<p>Quickly find a specific "+itemTitle+".</p>"});

                //btns on filters
                if (canEdit) {
                    addItemCheck(firstItem, {
                        intro: "<div class='title'>Select elements</div>" +
                            "<p>After selecting multiple elements, more options will be made available..</p>",
                    });

                    addNewBtn({
                        intro: "<div class='title'>Add elements</div>" +
                            "<p>Add a new element here.</p>"
                    });
                }

                addSettingsStep();
                addGeneratePDFStep({listTitle: listTitle});
                addCommentsStep(filters);

                addVersionsStep({listTitle: 'categories and elements'});
                addShareStep(subheader);
                //addTasksStep();
                addTutorialsStep({introExtra: 'manage your categories and elements'});

                function addRateColStep(firstItem, other) {
                    var el = firstItem.querySelector('.rate-col');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Rate</div>" +
                                "<p>Add a rate to each element.</p>",
                            position: 'left'
                        }, other);
                    }
                }

                function addScriptColStep(firstItem, other) {
                    var el = firstItem.querySelector('.script-col');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Preview script</div>" +
                                "<p>Preview all the scenes that this element is tagged within.</p>",
                            position: 'left'
                        }, other);
                    }
                }

                function addTagsColStep(firstItem, other) {
                    var el = firstItem.querySelector('.tags-col');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Tagged phrases</div>" +
                                "<p>A \"tag\" is any highlighted script phrase or manual entry that is assigned to an element.</p><p>For example, \"hammer\" and \"Thor's Hammer\" are two different tags that are assigned to the same element, \"Mjölnir.\" This avoids redundant phrasings of the same element in reports.\n.</p>",
                            position: 'left'
                        }, other);
                    }
                }

                function addScenesColStep(firstItem, other) {
                    var el = firstItem.querySelector('.scenes-col');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Scenes with this element</div>" +
                                "<p>A listing of every scene where this element is presently tagged.</p>",
                            position: 'left'
                        }, other);
                    }
                }
            }

            function setCallsheetConfirmations(){
                var itemTitle = 'recipient';
                if (!addFirstItemStep({
                    intro: "<div class='title'>Recipients</div>" +
                "<p>Each recipient of a call sheet is listed here.</p>"

            })) {
                    return;
                }

                var el = firstItem.querySelector('.sb-col-calltime');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Call time</div>" +
                            "<p>View each recipient’s call time…</p>",
                        position: 'right'
                    });
                }
                 el = firstItem.querySelector('.col-status');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Delivery status</div>" +
                            "<p>View the call sheet’s delivery status for each recipient.</p>",
                        position: 'right'
                    });
                }
                 el = firstItem.querySelector('.col-views');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>View count</div>" +
                            "<p>Track how many times the recipient has viewed the call sheet.</p>",
                        position: 'right'
                    });
                }
                 el = firstItem.querySelector('.sb-col-email');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Email</div>" +
                            "<p>View and adjust emails. One of the most common reasons for a call sheet to bounce, is an email typo. If you notice a typo, fix it here and resend the call sheet to just that recipient.</p>",
                        position: 'left'
                    });
                }
                 el = firstItem.querySelector('.sb-col-phone');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Phone</div>" +
                            "<p>Text messages are sent to the phone number listed here.</p>",
                        position: 'left'
                    });
                }

                addTutorialsStep({
                    introExtra: "build call sheets"
                });
            }

            function setCallsheetEdit() {
                var callsheetEdit = _this.LCS.bodyElement.querySelector('.callsheet-edit-page'),
                    callsheetSubheader = callsheetEdit.querySelector('.subheader.callsheet-wizard'),
                    callsheet = _this.LCS.bodyElement.querySelector('.list-tree'),
                    stateNameParam =  _this.CPS.SBStateService.getCurrentStateParams().mode;
                switch (stateNameParam) {
                    case 'design':
                        setCallsheetDesignerStep1();
                        break;

                    case 'recipients':
                        setCallsheetDesignerStep2();
                        break;
                    case 'view':
                       setCallsheetDesignerStep3();
                        break;
                }

                function addTutorial() {
                    _this.LCS.timeout(function (){
                        addTutorialsStep({
                        onBeforeChange: function (el, intro){
                            if(!el || !el.parentElement || el.id !== 'btnTutorials') {
                                intro._steps[intro.currentStep()].element = callsheetEdit.querySelector('.subheader #btnTutorials');
                            }
                        },
                        introExtra: 'build call sheets',
                        parent: callsheetEdit
                    });
                    }, 500);
                }

                function setCallsheetDesignerStep3() {
                    addCalsheetSectionStep();
                    addPreviewTogglesStep();
                    addSettings3();
                    addStepSend();

                    addTutorial();

                    function addSettings3(){
                        addSettingsStep({
                            onBeforeChange: function (el, intro){

                                _this.RootEventsService.broadcastRoot('SET_VIEW_MODE', {isEnd:true,  type: 'Desktop', intro: intro});
                            },
                            parent: callsheetSubheader,
                            isSubheader: true
                        }, [{
                            cls: 'a[data-type="download"]',
                            other: {
                                parent: callsheetSubheader,
                                intro: "<div class='title'>Download call sheet</div>" +
                                    "<p>You can download a PDF of the current call sheet here. If the call sheet has not been sent yet, there will be a “prelim” watermark across the PDF.<p></p>Once the call sheet has been sent to at least one person, the watermark will not be present.</p>"
                            }
                        }]);
                    }

                    function addCalsheetSectionStep() {
                        var el = _this.LCS.bodyElement.querySelector('.view-mode-on');
                        if (el) {
                            addStep({
                                element: el,
                                intro: "<div class='title'>Call sheet preview</div>" +
                                    "<p>This is a preview of your preliminary call sheet.</p><p>Once the call sheet has been sent, the “prelim” watermark will be automatically removed</p>",
                                position: 'left'
                            });
                        }
                    }

                    function addPreviewTogglesStep(){
                        var toggles = _this.LCS.bodyElement.querySelector('.view-resolution-buttons > div');
                        if (toggles) {
                            addStep({
                                element: toggles,
                                intro: "<div class='title'>Preview toggles</div>" +
                                    "<p>You can switch between previews of what your recipients will see on desktop, mobile, email, and text message.</p>",
                                position: 'left'
                            });
                        }

                        processTab('Desktop', "<div class='title'>Desktop view</div>" +
                            "<p>This is the full view of the call sheet on desktop. It is also a good idea of what the call sheet PDF will look like.</p>");
                        processTab('Mobile', "<div class='title'>Mobile view</div>" +
                            "<p>This is a preview of the call sheet when viewed on a mobile device.</p>");

                        processTab('Inbox', "<div class='title'>Email view</div>" +
                            "<p>This is a preview of the email that is sent to recipients. Each email is personalized with their unique call times and private notes, if any were added.</p>");

                        processTab('SMS', "<div class='title'>Text message preview</div>" +
                            "<p>Recipients with phone numbers will also receive a text message with their call time and a link to view the call sheet.</p><p>Text messages are a great way to help ensure a recipient receives the call sheet, just in case the email gets lost in their inbox.</p><p><b>Note:</b> Text messages may not be available in some countries.</p>");

                        function processTab(type, txt){

                            var el = toggles.querySelector('.btnActionView[data-info="' + type + '"]');
                            if (el) {
                                el.onBeforeChange = onChange;
                                addStep({
                                    element: el,
                                    intro: txt,
                                    position: 'left'
                                });
                            }

                            function onChange (el, intro){
                                _this.RootEventsService.broadcastRoot('SET_VIEW_MODE', {type: type, intro: intro});
                            }
                        }
                    }

                    function addStepSend() {
                        addPopupSteps({
                            popupName: 'SEND_CALLSHEET',
                            el: callsheetSubheader.querySelector('.btnTopSend'),
                            intros: [
                                //before open popup
                                {intro:"<div class='title'>Send the call sheet</div><p>Once you’re ready, you can click here to send the call sheet.</p>"},
                                //on open popup
                                {intro:"<div class='title'>Send settings</div><p>Before you send, you are presented with a few options.</p>"},
                                //on popup
                                {intro:"<div class='title'>Copy me on emails</div><p>This toggle will CC you to every email sent.</p>", innerElCls: '.f1'},
                                {intro:"<div class='title'>Receive confirmation emails</div><p>This toggle will send you an email every time a recipient confirms their call sheet. This is helpful to stay on top of confirmations when you’re away from your call sheet dashboard.</p>", innerElCls: '.f2'},
                                {intro: "<div class='title'>Include SMS</div><p>Toggle this on if you want recipients to also receive a text message with their personalized call time.</p>", innerElCls: '.f3'},
                                {intro: "<div class='title'>Reset views and confirms</div><p>If you’re sending a call sheet again, you may want to reset the view counts and confirmations to ensure your analytics match this latest send.</p>", innerElCls: '.f4'},
                                {intro: "<div class='title'>Include a message</div><p>You can include a message to be added at the top of every call sheet. You may want to add a message if you’re resending a call sheet and want to clarify why.</p>", innerElCls: '.f5'},
                                {intro: "<div class='title'>Send call sheet</div><p>Once you’re happy with your settings, click here to send the call sheet. Note the counter of how many recipients will receive the call sheet.</p>", innerElCls: '.modal-footer .btn.btn-primary'},
                                {intro: "<div class='title'>Send test call sheet</div><p>If you want to send a test call sheet to yourself, click here instead.</p>", innerElCls: '.modal-footer .btnSendTest'},
                            ],
                            delay: 1000
                        });
                    }
                }

                function setCallsheetDesignerStep2() {
                    addItemSteps();

                    addLeftSidebarStep({
                        intro: "<div class='title'>Toggle sidebar</div>" + "<p>This button can show or hide additional customizations.</p>",
                        introSidebar: "<div class='title'>Recipient sidebar</div> " +
                            "<p>You can filter recipients by these categories.</p>" +
                            "<p>This is especially useful, for example, if you want to drill down to a specific department, select all, and adjust call times for multiple recipients all at once.</p>" +
                            "<p>Similarly, you can add the private notes to multiple recipients.</p>"
                    });

                    addRecipientsPopupStep(filters);

                    addSettingsStep(null, [{
                        cls: 'a[data-type="columnSettings"]',
                        other: {
                            intro: "<div class='title'>Customize columns</div>" +
                                "<p>You can customize columns here. For example, toggle on email and phone columns to make adjustments on-the-fly.</p>"
                        }
                    }]);

                    addStepSend();
                        addTutorial();

                    function addItemSteps() {
                        if (!addFirstItemStep({
                            //itemCls: '.group-content1 .list:not(.header) .row-schedule' + (cls ? cls : '') + ':not(.header',
                            intro: "<div class='title'>This is a call sheet recipient</div>" +
                                "<p>All call sheet recipients that are currently on the call sheet are displayed here.</p><p>On this page you can confirm recipients, fine tune their call times, and even add private notes that only the individual recipient will see.</p>"
                        })) {
                            return false;
                        }

                        var el = firstItem.querySelector('.time-col');
                        if (el) {
                            addStep({
                                element: el,
                                intro: "<div class='title'>Personalized call times</div>" +
                                    "<p>You can adjust an individual’s call time here.</p><p>Each call sheet email and text message prominently displays the recipient’s personalized call time.</p>",
                                position: 'left'
                            });
                        }

                        el = firstItem.querySelector('.note-col');
                        if (el) {
                            addStep({
                                element: el,
                                intro: "<div class='title'>Private notes</div>" +
                                    "<p>A private note is a message that will be displayed on the recipient’s call sheet email. Only the recipient will see this note.</p><p>This is a great way to add special instructions, reminders, or just a friendly note.</p>",
                                position: 'left'
                            });
                        }
                    }

                    function addStepSend() {
                        var el = _this.LCS.bodyElement.querySelector('.btnTopSend');
                        if (el) {
                            addStep({
                                element: el,
                                intro: "<div class='title'>Move to Step 3</div>" +
                                    "<p>After you’re done confirming your recipients, click here to move on to the final step.</p><p><b>Note:</b> You can always return to a previous step at any time via the top nav bar.</p>",
                                position: 'left'
                            });
                        }
                    }

                    function addRecipientsPopupStep(filters, other) {
                        addPopupSteps({
                            other: other,
                            popupName: 'ADD_CALLSHEET_RECIPIENTS',
                            el: filters.querySelector('.btnActionRecipients'),
                            intros: [
                                //before open popup
                                {intro: "<div class='title'>Add more recipients</div><p>If you want to add more recipients to the call sheet, you can do so here.</p>"},
                                //on open popup
                                {intro: "<div class='title'>Recipient modal</div><p>Browse the remaining project contacts who are not assigned to this call sheet, add new contacts from scratch, or add existing contacts from previous projects.</p><p>Once you select your contacts, click the “Add Selected to Call Sheet” button and they’ll automatically be added to the correct grids based on their roles.</p>"}
                            ],
                            delay: 1000
                        });
                    }
                }

                function setCallsheetDesignerStep1() {

                    addCalsheetSectionStep();
                    addTopSectionStep();

                    addSidebarStep();
                    addBtnSendStep();

                    addTutorial();

                    function addCalsheetSectionStep() {
                        if (callsheet) {
                            addStep({
                                element: callsheet,
                                intro: "<div class='title'>This is your call sheet</div>" +
                                    "<p>You can make changes right inside the call sheet body.</p>",
                                position: 'left'
                            });
                        }
                    }

                    function addTopSectionStep() {
                        var el = callsheet.querySelector('#topSection');
                        if (el) {
                            addStep({
                                element: el,
                                intro: "<div class='title'>Call sheet header</div>" +
                                    "<p>The call sheet header has important information at a glance, such as the production company details, crew call time, weather information, and daily agenda.</p>",
                                position: 'left'
                            });
                        }
                    }

                    function addSidebarStep() {
                        var el = callsheetEdit.querySelector('.btnSidebarToggle[data-type="toggleInnerSidebar"]');
                        if (el) {
                            addStep({
                                element: el,
                                intro: "<div class='title'>Toggle sidebar</div>" +
                                    "<p>You can toggle to customize further here.</p>",
                                position: 'right',
                                forceOpen: true,
                                openSidebar: true
                            });
                        }

                        addSideNavStep({
                            gridId: '#e_1_inline',
                            intro: "<div class='title'>Header elements</div>" +
                                "<p>You You can toggle individual header elements on or off here.</p>"
                        });

                        addSideNavStep({
                            gridId: '#e_2_inline',
                            intro: "<div class='title'>Grids</div>" +
                                "<p>Each grid below the header can be found here. Drag to reorder, toggle to show or hide, and customize each grid’s settings as desired.</p>"
                        });

                        addSideNavStep({
                            gridId: '#e_3_inline',
                            intro: "<div class='title'>Styles</div>" +
                                "<p>Adjust the look and feel of your call sheet, from grid lines to colors.</p>"
                        });

                        addSideNavStep({
                            gridId: '#e_4_inline',
                            intro: "<div class='title'>Templates</div>" +
                                "<p>Either save your current call sheet template or load an existing template.<p></p>This is a major time saver once you’ve achieved the grid settings, order and appearance you desire.</p>"
                        });

                        addSideNavStep({
                            gridId: '#e_5_inline',
                            intro: "<div class='title'>Call Sheet Settings</div>" +
                                "<p>Adjust various call sheet settings here.</p>"
                        });

                        closeEl.closeSidebar = true;
                    }

                    function addBtnSendStep() {
                       var el = _this.LCS.bodyElement.querySelector('.btnTopSend');
                        if (el) {
                            el.onBeforeChange = resetElHeight;
                            addStep({
                                element: el,
                                intro: "<div class='title'>Move to Step 2</div>" +
                                    "<p>After you’re pleased with your call sheet, click here to move on to the next step.<p></p><b>Note:</b> You can always return to a previous step at any time via the top nav bar.</p>",
                                position: 'right',

                            });
                        }
                    }

                    function addSideNavStep(other) {
                        var el = _this.LCS.bodyElement.querySelector('.side-nav ' + other.gridId);
                        if (el) {
                            el.onBeforeChange = onBeforeChangeSideNav;
                            addStep({
                                element: el,
                                intro: other.intro,
                                position: 'right',
                            });
                        }

                        function onBeforeChangeSideNav(el) {
                            var el1 = el.querySelector('.expandable');
                            if (el1 && el1.clientHeight === 0) {
                                el1.style.height = 'auto';
                                closeEl.resetHeight = el1;
                            }
                        }
                    }

                    function resetElHeight() {
                        if (closeEl.resetHeight) {
                            closeEl.resetHeight.style.height = '0px';
                            delete closeEl.resetHeight;
                        }
                    }
                }
            }

            function setCalendarSteps() {
                var gantt = _this.LCS.bodyElement.querySelector('.gantt');

                //calendar container with dates
                var el = gantt.querySelector('.gantt-scrollable');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Add calendar events</div>" +
                            "<p>Click-and-drag to Add new calendar events.</p>" +
                            "<div class='text-center margin-top-30 margin-bottom-quarter''><img class='col200' src='" + _this.LCS.getImgUrl('calendar-tagging-guide.gif', false) + "'></div>",
                        position: 'left'
                    });
                }

                /*1. Highlight sidebar.*/
                el = gantt.querySelector('.gantt-side');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Calendar sidebar</div>" +
                            "<p>Organize your events into rows and group them via the sidebar.</p>",
                        position: 'right'
                    });
                }

                //3. my calendars
                addNavFilterStep('#btnCalendars', {
                    intro: "<div class='title'>Project calendars</div>" +
                        "<p>View and add new calendars inside this project.</p>"
                });

                addNavFilterStep(  '.drpScale', {
                    intro: "<div class='title'>Calendar scale</div>" +
                        "<p>Adjust calendar scale by day, week, month, quarter, or year.</p>"
                });

                addNavFilterStep(  '#btnLayout', {
                    intro: "<div class='title'>Display options</div>" +
                        "<p>Adjust display settings, work days and toggle dependencies.</p>"
                });

                /*addNavFilterStep(  '#btnLayout', {
                    intro: "<div class='title'>Scale and zoom</div>" +
                        "<p>Adjust calendar scale by day, week, month, quarter, or year. Zoom in and out as needed.</p>"
                });*/

                addCommentsStep(filters);

                addNavFilterStep('#btnToparchived', {
                    intro: "<div class='title'>Archived events</div>" +
                        "<p>Old, archived events can be viewed and restored from here.</p>"
                });

                addNavFilterStep('#btnTopfilters', {
                    intro: "<div class='title'>Filter events</div>" +
                        "<p>Filter events by dates, colors, tasks, and teammates.</p>"
                });
                addShareStep(subheader);

                addTutorialsStep({introExtra: 'build calendars'});

                return steps;
            }

            function addStep(step, other) {
                if (!steps) {
                    steps = [];
                }

                step.element = addProps(step.element, step);

                if(other) {
                    _.each(['withFocus'], function (p) {
                        if (other[p] !== undefined) {
                            step.element[p] = other[p];
                        }
                    });
                }

                _.each(['closeComments', 'closeSidebar', 'closeDrp'], function (p){
                    var v = closeEl[p];
                    if(v){
                        step.element[p] = v;
                        closeEl[p] = false;
                    }
                });

                if(typeof(nextStepOnBeforeChange) === 'function'){
                    step.element.onBeforeChange = nextStepOnBeforeChange;
                    nextStepOnBeforeChange = null;
                }

                steps.push(_.extend(step, other));

                return step.element;
            }

            function addFirstItemStep(other, cls) {
                if (!firstItem) {
                    var itemCls = other && other.itemCls ? other.itemCls : ('.' + initWrapperCls + ' .list:not(.header) .row-schedule' + (cls ? cls : '') + ':not(.header');
                    firstItem = _this.LCS.bodyElement.querySelector(itemCls);
                }
                if (!firstItem) {
                    return false;
                }
                if (other.highlightGridHeader) {
                    firstItem.highlightGridHeader = true;
                }
                addStep(_.extend({
                    /*    1. Highlight first scene strip.*/
                    element: firstItem
                }, other));
                return true;
            }

            function addReorderGridStep(other) {
                if (canEdit && firstItem) {
                    var itemTitle = other && other.itemTitle ? other.itemTitle : 'item';
                    /*2. Highlight the dragger icon of first scene.*/
                    var el = firstItem.querySelector('.handle-col');
                    if (el) {
                        addStep({
                            element: el,
                            intro: other.intro ? other.intro : ( "<div class='title'>Drag-and-drop " + itemTitle + "s</div>" +
                                "<p>You can reorder " + itemTitle + "s by dragging these icons.</p>"),
                            position: 'right'
                        });
                    }
                }
            }

            function addSearchBtn(other) {
                var itemTitle = other && other.itemTitle ? other.itemTitle : 'item';
                addNavFilterStep('.btn-search',  {
                    intro: other && other.intro ? other.intro : ("<div class='title'>Search " + itemTitle + "</div>" +
                        "<p>Quickly find a specific " + itemTitle + ".</p>") ,
                    position: 'right'
                });
            }

            function addNewBtn(other) {
                if(!other.parent){
                    other.parent = filters;
                }
                if(!other.selector){
                    other.selector = '.btnNewFromTop:not(.ng-hide)';
                }
                createStep(other);
            }

            function addFilters(listTitle, other) {
                addNavFilterStep('.btnTopFilters', other ? other : {
                    intro: "<div class='title'>All " + listTitle + "s</div>" +
                        "<p>You can swap between active and archived " + listTitle + "s here.</p>"
                });
            }

            function addNavFilterStep(selector, other) {
                return createStep(_.extend({}, other, {parent: filters, selector: selector}));
            }

            function addSubheaderFilterStep(selector, other) {
                return createStep(_.extend({}, other, {parent: other && other.parent ? other.parent : subheader, selector: selector}));
            }

            function addProps(el, other){
                _.each(['forceOpen', 'openSidebar', 'openDrp', 'openComments'], function (p){
                    if (other[p] !== undefined) {
                        el[p] = other[p];
                    }
                });
                return el;
            }

            function createStep(other) {
                var parent = other && other.parent ? other.parent : _this.LCS.bodyElement,
                    el = parent ? parent.querySelector(other.selector) : null;
                if(!el){return null;}

                if(other.onBeforeChange){
                    el.onBeforeChange = other.onBeforeChange;
                }

                return addStep(_.extend({
                    element: addProps(el, other),
                    position: other.position ? other.position : 'left',
                    intro: other.intro ? other.intro : ' '
                }, other));
            }

            function addVersionsStep(other) {
                if (canEdit && subheader) {
                    createStep({
                        parent: subheader,
                        selector: '.btnVersions',
                        intro: "<div class='title'>Version manager</div>" +
                            "<p>Every time a script is imported or synced with a project, a new version of the project is generated. You can view and roll back to previous versions here.</div>"
                    }, other);
                }
            }

            function addAssignCharStep(firstItem, other) {
                var el = firstItem.querySelector('.char-col');
                if (el) {
                    var title = canEdit ? 'Assign cast members' : 'Cast members';
                    addStep({
                        element: el,
                        intro: "<div class='title'>" + title + "</div>" +
                            "<p>"+(canEdit?("This is where you can assign cast members to each scene. "):"") + "Any characters who have dialogue in a scene are automatically assigned with their unique Cast ID number.</p>",
                        position: 'left'
                    }, other);
                }
            }

            function addAssignLocStep(firstItem, other) {
                var el = firstItem.querySelector('.loc-col');
                if (el) {
                    var title = canEdit ? 'Assign locations' : 'Locations';
                    addStep({
                        element: el,
                        intro: "<div class='title'>" + title + "</div>" +
                            "<p>Similar to cast members, you can assign shooting locations to each scene. Assigning locations and cast will make it easier to create schedules later on.</p>",
                        position: 'left'
                    }, other);
                }
            }

            function addPageLengthStep(firstItem, other) {
                var el = firstItem.querySelector('.page-col');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Page length</div>" +
                            "<p>Each page of a script is broken down into 8ths. The page length of a given scene can be found here.</p><p>When creating a schedule, the page length helps determine how long each scene will take to shoot.</p>",
                        position: 'left'
                }, other);
                }
            }

            function addElementsStep(firstItem, other) {
                var el = firstItem.querySelector('.elements-col');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Elements</div>" +
                            "<p>The total number of tagged elements for each scene is displayed here.</p>",
                        position: 'left'
                    }, other);
                }
            }

            function addEstTimeStep(firstItem, other) {
                var el = firstItem.querySelector('.sb-col-estTime');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Estimated time</div>" +
                            "<p>This is where you can estimate how long it will take to prep and shoot this scene.</p><p>Once a day break is added, all of the est. times of the scenes on that day will be totaled on the day break banner.</p>",
                        position: 'left'
                    }, other);
                }
            }

            function addPreviewPopupStep(firstItem) {
                addPopupSteps({
                    goToNext: true,
                    popupName: 'VIEW_SCENE',
                    el: firstItem.querySelector('.preview-col'),
                    intros: [
                        //before popup opens
                        {intro: "<div class='title'>Preview scene</div><p>You can read, and even edit, the scene script here.</p>"},
                        //who popups opens
                        {intro: "<div class='title'>Preview scene</div><p>This is the scene preview.</p>"},


                        {intro: "<div class='title'>Script Editor</div><p>To edit the scene script, you can open the Script Editor here.<p></p>When you make changes to a scene, you are given the option to update the shooting script.</p>",
                            innerElCls: 'a.edit-profile'
                        }
                    ],
                    goNext: function (el) {
                        var item = _this.LCS.findClosestParent(el, '.row-scheduleTemp'),
                            id = item ? item.getAttribute('data-id') : null;
                        return id;
                    },
                    delay: 2500,
                    preloadedPopup:true,
                });
            }

            function addPopupSteps(data){
                var el = data.el;
                if (!el) {return;}

                el.onAfterChange = onAfterChange;

                _.each(data.intros, function (d, i){
                    addStep({
                        element: (i === 0 ? el : _this.LCS.bodyElement),
                        intro: d.intro,
                        position: 'left',
                    }, data.other);
                });

                nextStepOnBeforeChange = function () {
                    //_this.CPS.popupsService.closeTopPopup();
                    toggleModal(false);
                    if(!data.preloadedPopup) {
                        closeModal(data.popupName);
                    }
                }

                function onAfterChange(el, intro) {
                     var id = data.goNext ? data.goNext(el) : true;
                     if(!id){return;}

                     if(!data.preloadepPopup) {
                         toggleModal(false);
                         _this.RootEventsService.broadcastRoot(data.popupName, data.goNext ? id : null);
                     }

                    var step = intro.currentStep();
                    toggleNext(false);

                    _this.LCS.timeout(processPopupSteps, data.delay);

                    function processPopupSteps() {

                        console.log('processPopupSteps');
                        var popupEl = '.' + data.popupName.toLowerCase().replaceAll('_', '-') + '-popup',
                        l = data.intros.length;
                        for(var i = 1; i < l; i++){
                            var elIntro = data.intros[i];
                            addPopupStep(step, elIntro.innerElCls ? (' ' + elIntro.innerElCls) : '', i, elIntro.onBeforeChange);
                        }

                        toggleNext(true);

                       /* if(data.goToNext) {
                            intro.goToStepNumber(step + 2);
                        }*/
                        function addPopupStep(step, cls, i, onBeforeChange) {
                            var el = _this.LCS.bodyElement.querySelector(popupEl + cls);
                            if (el) {
                                el.onBeforeChange = i === 1 ? onToggle : (l >= 3 && i === 2 ? onChangeZ : onBeforeChange);
                                intro._steps[step + i].element = el;
                                intro._steps[step + i].position = 'left';
                                intro.refresh();
                            }

                            function onToggle(){
                                console.log('onToggle');
                                closeEl.openedPopup = data.popupName;
                                toggleModal(true);
                            }

                            function onChangeZ() {
                                var index = 999998;
                                setZ('.modal-backdrop', index);
                                setZ('.modal', index + 1);

                                function setZ(cls, index){
                                    var el = _this.LCS.bodyElement.querySelector(cls);
                                    if (el) {
                                        if (!el.style) {
                                            el.style = {};
                                        }
                                        el.style.zIndex = index;
                                    }
                                }
                            }
                        }
                    }
                    function toggleNext(disabled){
                        _this.LCS[disabled?'addClass':'removeClass'](_this.LCS.bodyElement.querySelector('.introjs-nextbutton'),'introjs-disabled');
                    }

                }
            }

            function addItemCheck(firstItem, other) {
                var itemTitle = other && other.itemTitle ? other.itemTitle : 'item';
                var el = firstItem.querySelector('.check');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>"+_this.CPS.capitalizeFirst(itemTitle)+" Checkbox</div>" +
                            "<p>Select multiple "+itemTitle+"s to perform bulk actions.</p>",
                        position: 'left'
                    }, other);
                }
            }

            function addNotesStep(firstItem, other) {
                var itemTitle = other && other.itemTitle ? other.itemTitle : 'item';
                var el = firstItem.querySelector('.note-col');
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>"+_this.CPS.capitalizeFirst(itemTitle)+" Notes</div>" +
                            "<p>You can click here to add "+itemTitle+" notes.</p>",
                        position: 'left'
                    }, other);
                }
            }

            function addTasksStep() {
                var intro = (canEdit || canComment) ? ("<div class='title'>Collaborate on tasks</div>" +
                    "<p>Create task cards, add to-do's, files, and collaborate with teammates.</p>") : ("<div class='title'>View page tasks</div>" +
                    "<p>View task cards, to-do's, files added by the teammates.</p>");
                var el = subheader ? subheader.querySelector('a#btnToptasks') : null;
                if (el) {
                    addStep({
                        element: el,
                        intro: intro,
                        position: 'left'
                    });
                }
            }

            function addCommentsStep(parent) {
                var intro = "<div class='title'>Comments sidebar</div>" +
                        "<p>Comments from collaborators or team members are accessible in this sidebar. Each comment can be marked as “resolved” which then archives the comment.</p>",
                    el = parent ? parent.querySelector('#btnTopcomments') : null;
                if (el) {
                    addStep({
                        element: el,
                        intro: intro,
                        position: 'left',
                        openComments: true
                    });
                    closeEl.closeComments = true;
                }
            }

            function addLeftSidebarStep(other) {
                addNavFilterStep('a[data-type="toggleInnerSidebar"]', {
                    intro: other.intro,
                    position: 'right',
                    forceOpen: true,
                    openSidebar: true
                });

                var el = _this.LCS.bodyElement.querySelector('.side-nav');
                if (el) {
                    addStep({
                        element: el,
                        position: 'right',
                        intro: other.introSidebar
                    });
                    closeEl.closeSidebar = true;
                }
            }

            function addSettingsStep(other, btns) {
                var cls = '.dropdown-wrapper ' + (other && other.btnId ? other.btnId : '#btnSettings'),
                clsMenu = cls+'+.dropdown-menu',
                    m = other && other.isSubheader ? addSubheaderFilterStep : addNavFilterStep,
                    parent = other && other.parent? other.parent : null,
                btn = m(cls, {
                    onBeforeChange: other ? other.onBeforeChange : null,
                    parent: parent,
                    forceOpen: true,
                    openDrp: true,
                    intro: other && other.intro ? other.intro : ("<div class='title'>More settings</div>" +
                        "<p>Each page has its own unique settings, so be sure to explore them in this dropdown.</p>")
                });

                if(!btns) {
                    btns = [{
                        cls:'a[data-type="columnSettings"]',
                        other: {
                            parent: parent,
                            intro: "<div class='title'>Customize columns</div>" +
                                "<p>There are more column options that can be toggled on or off. Customize your columns here.</p>"
                        }
                    }];
                }

                _.each(btns, function (btn){
                    m(clsMenu  + ' ' +btn.cls, btn.other);
                })
/*

                m(clsMenu+' #btnImportScript', {
                    intro: other && other.intro ? other.intro : ("<div class='title'>Import script</div>" +
                        "<p>Import Script</p>")
                });
                m(clsMenu+' a[data-type="columnSettings"]', {
                    intro: other && other.intro ? other.intro : ("<div class='title'>Customize columns</div>" +
                        "<p>Toggle various column options here.</p>")
                });

                m(clsMenu+' .group-zoom-filters', {
                    intro: other && other.intro ? other.intro : ("<div class='title'>Adjust zoom</div>" +
                        "<p>group-zoom-filters</p>")
                });
*/

                closeEl.closeDrp = btn;
            }

            function addTutorialsStep(other) {
                var intro = "<div class='title'>Video tutorials</div>" +
                    "<p>We highly recommend watching each feature's video tutorials.</p><p>Ready to get started? Watch our \"Getting Started\" videos to learn how to " + (other && other.introExtra ? other.introExtra : '') + " like a pro.</p>",
                    el = (other.parent ? other.parent :  subheader).querySelector('.btn#btnTutorials');
                if(other.parent && !el){other.parent = el; }
                if (el) {
                    if(other && other.onBeforeChange){
                        el.onBeforeChange = other.onBeforeChange;
                    }
                    addStep({
                        element: el,
                        intro: intro,
                        position: 'left'
                    });
                }
            }

            function addShareStep(parent) {
                if (isAuthenticated && parent) {
                    var el = parent.querySelector('#btnSh');
                    if (el) {
                        addStep({
                            element: el,
                            intro: "<div class='title'>Share</div>" +
                                "<p>Generate view-only share links, or invite specific collaborators to post comments. Collaborators are not required to sign in.</p>",
                            position: 'left'
                        });
                    }
                }
            }

            function addGeneratePDFStep(other) {
                var parent = other && other.parent ? other.parent : filters;
                var el = parent ? parent.querySelector('a[data-type="generatePDF"]') : null;
                if (el) {
                    addStep({
                        element: el,
                        intro: other && other.intro ? other.intro : ("<div class='title'>Generate PDF</div>" +
                            "<p>Generate and customize your PDFs here.</p>"),
                        position: 'left'
                    });
                }
            }

            function addPrintStep(subheader) {/* 8.Highlight Print button*/
                var el = subheader ? subheader.querySelector('.btn.sbf.print') : null;
                if (el) {
                    addStep({
                        element: el,
                        intro: "<div class='title'>Print or save PDFs</div>" +
                            "<p>Print or save your stripboard as a PDF here.</p>",
                        position: 'left'
                    });
                }
            }
        }
    }

    function setBlock(overviewBlockType){
        var el = _this.BlocksSetupService.getBlockByType(overviewBlockType);
        if (el) {
            _this.LCS.csBlock = el;
            _this.csBlock = el;
        }
        return el;
    }


    function emitUpdateCheatsheet(cheatSheetInfo){
        _this.setBlock(cheatSheetInfo.overviewBlockType);
        _this.cheatSheetInfo = _.clone(cheatSheetInfo);
        _this.LCS.timeout(function () {
            _this.CheatSheetEventsService.emitUpdateCheatsheet(_this.cheatSheetInfo);
        }, 700);
    }

    function getCheatSheetParams(){
        var cheatSheetInfo = _this.cheatSheetInfo;
        if (!cheatSheetInfo) {return null;}
        var el = _.extend({}, _this.setBlock(cheatSheetInfo.overviewBlockType));
        if (el) {
            var page = _this.BlocksSetupService.getCurrentTodoPage();
            if (page) {
                el.pageClass = page.pageClass;
            }
            el.hotkeys = getHotkeys(cheatSheetInfo.hotkeys);
        }
        return el;

        function getHotkeys(hk){
            return hk ? hk.map(function (el){
                var combo = getCombo((el.isCmd ? 'mod+' : '') + el.key);
                return {
                    desc: el.desc,
                    txt: getFormatted(combo)
                    //combo: combo,
                };

                function getCombo(combo) {
                    return combo instanceof Array ? combo : [combo];
                }

                function getFormatted(combo){
                    var c = combo[0];
                    var seq = c.split(/[\s]/);
                    for (var i = 0; i < seq.length; i++) {
                        seq[i] = symbolize(seq[i]);
                    }
                    return seq;
                }

                /**
                 * Convert strings like cmd into symbols like ⌘
                 * @param  {String} combo Key combination, e.g. 'mod+f'
                 * @return {String}       The key combination with symbols
                 */
                function symbolize(combo) {
                    var map = {
                        command: '\u2318',     // ⌘
                        shift: '\u21E7',     // ⇧
                        left: '\u2190',     // ←
                        right: '\u2192',     // →
                        up: '\u2191',     // ↑
                        down: '\u2193',     // ↓
                        'return': '\u23CE',     // ⏎
                        backspace: '\u232B'  // ⌫
                    };
                    combo = combo.split('+');

                    for (var i = 0; i < combo.length; i++) {
                        // try to resolve command / ctrl based on OS:
                        if (combo[i] === 'mod') {
                            if (_this.LCS.$window.navigator && _this.LCS.$window.navigator.platform.indexOf('Mac') >= 0) {
                                combo[i] = 'command';
                            } else {
                                combo[i] = 'ctrl';
                            }
                        }

                        combo[i] = map[combo[i]] || combo[i];
                    }

                    return combo.join(' + ');
                }

            }) : null;
        }
    }
}

angular.module('services.commentsSidebar', [
    'services.blocksSetup',
    'services.layoutConfigsService', 
    'services.stateService'
])
.service('CommentsSidebarService', CommentsSidebarService);
//keeps track of the opened type of sidebar
CommentsSidebarService.$inject = ['BlocksSetupService', 'RootEventsService', 'CPS'];
function CommentsSidebarService(BlocksSetupService, RootEventsService, CPS) {
    //ontop nav for auth user:
    //on projects page show the news
    //on project dashboard show the tasks
    //on any page show the tasks if the page has tasks
    //on any page show the comments if the page doesnt have sub lists

    //on subnav
    //if page has tree or supports multi items (like breakdowns) -> show comments

    var _this = this;

    _this.CPS = CPS;
    _this.LCS = CPS.LCS;
    _this.RootEventsService = RootEventsService;
    _this.BlocksSetupService = BlocksSetupService;

    _this.SidebarTypes = _this.LCS.SidebarTypes;

    _this.getCurrentTodoPage = _this.BlocksSetupService.getCurrentTodoPage;

    _this.onStateChanged = onStateChanged;

    _this.onTreeListChanged = onTreeListChanged;
    _this.getPageInfo = getPageInfo;
    _this.getSidebarInfo = getSidebarInfo;
    _this.toggleComments = toggleComments;
    _this.isListLevel = isListLevel;
    _this.getAcceptedTypes = getAcceptedTypes;
    _this.showBtnOnPage = showBtnOnPage;
    _this.getSidebarTypeName = getSidebarTypeName;

    return _this;

    function getSidebarTypeName(t){
        if(!t){return '';}
        for(var name in _this.SidebarTypes){
            if(_this.SidebarTypes[name] === t) {
                return name;
            }
        }
        return '';
    }

    function getAcceptedTypes(type, isPageLevel){
        switch (type){
            case 'tasks':
                var l = [_this.SidebarTypes[isPageLevel ? 'PageTasks' : 'ListTasks']];
                if(isPageLevel){
                    l.push(_this.SidebarTypes.News);
                }
                return l;
            case 'comments': return [_this.SidebarTypes[isPageLevel ? 'PageComments' : 'ListComments']];
            case 'filters': return [_this.SidebarTypes[isPageLevel ? 'PageFilters' : 'ListFilters']];
            case 'archived': return [_this.SidebarTypes[isPageLevel ? 'PageArchived' : 'ListArchived']];
        }
    }

    function showBtnOnPage(sidebarInfo, acceptedTypes){
        for(var prop in _this.SidebarTypes){
            var type = _this.SidebarTypes[prop];
            if(acceptedTypes && acceptedTypes.indexOf(type)!== -1  && sidebarInfo.pageInfo[type]){
                return type;
            }
        }
        return null;
    }

    function isListLevel(sidebarType){
         return sidebarType === _this.SidebarTypes.ListFilters ||
                sidebarType === _this.SidebarTypes.ListArchived ||
                sidebarType === _this.SidebarTypes.ListComments ||
                sidebarType === _this.SidebarTypes.ListTasks;
    }

    function getPageInfo(){
        return _this.pageInfo;
    }

    function onStateChanged(stateName, stateParams){
        console.log('CommentsSidebarService.onStateChanged');
        if (!_this.prevStateName || _this.prevStateName !== stateName) {
            _this.todoPage = _this.BlocksSetupService.getTodoPage(stateName);

            _this.pageInfo = setPageInfo(stateName);

            var childPageId = _this.todoPage && _this.todoPage.type === 3 ? _this.todoPage.filePageId : null;
            if(childPageId){
                _this.childTodoPage = _this.BlocksSetupService.getTodoPageById(childPageId);
                if(_this.childTodoPage) {
                    _this.childPageInfo = setPageInfo(_this.childTodoPage.name);
                }
            }

            setList(null, stateParams);
            initSidebarType(true);
            _this.prevStateName = stateName;
        } else if(stateParams) { //same state different uIdComment or uId
            var changes, todoPage;
            todoPage = _this.pageInfo.todoPage;
            if (todoPage) {
                set('uId');
                set('uIdComment');

                if (changes) {
                    initSidebarType();
                }
            }
        }

        function set(prop){
            var uId = todoPage[prop];
            if(uId) {
                _this[prop] = stateParams[uId];
                changes = true;
            }
        }
    }

    function onTreeListChanged(result) {
        console.log('CommentsSidebarService.onTreeListChanged');
        setList(result ? result.list : null);
        //for News && Filter doens't matter if the tree changes
        //by here pageInfo & sidebarType is already set

        initSidebarType();
    }

    function setList(list, stateParams) {
        console.log('CommentsSidebarService: setList');
        _this.currentList = list ? list : null;
        var s = stateParams ? stateParams : _this.CPS.SBStateService.$stateParams;
        _this.uId = list ? list._id : (_this.todoPage && !_this.todoPage.hasTree && _this.todoPage.uId ? s[_this.todoPage.uId] : null);
        var uIdComment = _this.todoPage ? _this.todoPage.uIdComment : null;
        if (uIdComment && s) {
            _this.uIdComment = s[uIdComment];
        }
    }

    function initSidebarType(isFirst){
        var pageInfo = getPageInfo(),
            res = getSidebarType(pageInfo),
            isOpen = res ? res.isOpen : false,
            sidebarType = res ? res.sidebarType : null;

        toggleComments(null, sidebarType, isOpen, true);

        function getSidebarType(pageInfo){
            //hierarchy order: news comments tasks
            //rule: have ths sidebar open on comments or tasks when the page changes
            //if news was previously closed (cached as closed) closed dont reopen
            //if filters was previously closed (cached as closed) closed dont reopen

            //if sidebar was previously set, see if  a
            var hasTasks = false, hasComments = false;
            if(_this.sidebarType){
                sidebarType = p(_this.sidebarType, _this.isOpen);
                if(sidebarType){
                    return sidebarType;
                }
            }

            if(pageInfo.canShowSidebar) {
                hasTasks = _this.CPS.getSearchFilter('card');
                hasComments = !_this.CPS.getSearchFilter('item') && _this.CPS.getSearchFilter('comment');
            }

            for(var name in _this.SidebarTypes){
                var sidebarType;
                if(hasTasks) {
                    if (name.indexOf('Tasks') !== -1) {
                        sidebarType = p(_this.SidebarTypes[name]);
                        if(sidebarType){
                            if(!sidebarType.isOpen){
                                sidebarType.isOpen = true;
                            }
                            return sidebarType;
                        }
                    }
                }else if(hasComments){
                    if (name.indexOf('Comments') !== -1) {
                        sidebarType = p(_this.SidebarTypes[name]);
                        if(sidebarType){
                            if(!sidebarType.isOpen){
                                sidebarType.isOpen = true;
                            }
                            return sidebarType;
                        }
                    }
                } else{
                    sidebarType = p(_this.SidebarTypes[name]);
                    if(sidebarType) {
                        return sidebarType;
                    }
                }
            }

            return null;

            function p(prop, isOpen){
                var val = pageInfo ? pageInfo[prop] : null;
                if(!val) {
                    return null;
                }

                return {
                    sidebarType: prop,
                    isOpen: getOpen(prop, isOpen)
                };
            }
        }
    }

    function setPageInfo(stateName) {
        var r = {
            stateName: stateName,
            isCalendarPage: stateName === 'user.product.calendar' || stateName === 'user.calendar',
            isDashboard: stateName === 'user.product.overview',
            isUserDashboard: stateName === 'user.dashboard',
            isWorkflow: stateName === 'user.product.workflow' || stateName === 'user.taskBoards',
           // isScriptPage: stateName === 'user.product.screenplay',
            todoPage: _this.todoPage,
            canShowSidebar: false
        };

      //  isLikeWorkflow: stateName && (stateName === 'user.product.workflow' || stateName === 'user.taskBoards' || stateName.indexOf('.calendar') !== -1),
        r[_this.SidebarTypes.News] = r.isUserDashboard && _this.CPS.isAuthenticated;

        if(r.todoPage){
            if(_this.CPS.canComment) {
                r[_this.SidebarTypes.PageComments] = r.todoPage['hasComments'];
                r[_this.SidebarTypes.ListComments] = r.todoPage['hasListComments'];
                r[_this.SidebarTypes.ListTasks] = r.todoPage['hasListTasks']; //currently not displayed
            }
            if(_this.CPS.isAuthenticated) {
                r[_this.SidebarTypes.ListArchived] = r.todoPage['hasListArchived'];
                r[_this.SidebarTypes.PageArchived] = r.todoPage['hasComments'];

                r[_this.SidebarTypes.PageTasks] = r.todoPage['hasTasks'];
            }
            r[_this.SidebarTypes.ListFilters] = r.todoPage['hasListFilters'];
            r[_this.SidebarTypes.PageFilters] = r.todoPage['hasFilters'];
              /*  //tasks : page filters & archived - > in subnav, page comments ->in top nav
                if(r.isWorkflow){
                    r[_this.SidebarTypes.PageFilters] = true;
                    r[_this.SidebarTypes.PageArchived] = true;
                    //calendar filter, calendar archived, calendar comments - > in subnav
                    //do we want tasks for page??? -> in top nav
                }else if(r.isCalendarPage && _this.CPS.isProduct){
                    r[_this.SidebarTypes.ListFilters] = true;
                    r[_this.SidebarTypes.ListArchived] = true;
                }*/
        }

        var a = [];
        for(var prop in _this.SidebarTypes){
            if(r[_this.SidebarTypes[prop]] === true){
                r.canShowSidebar = true;
                a.push(prop);
            }
        }
        r.acceptedTypes = a;

        return r;
    }

    function toggleComments(componentId, sidebarType, isOpen, isInstall) {
        if (_this.sidebarType !== sidebarType || _this.isOpen !== isOpen || isInstall) {
            if(!isOpen && sidebarType === _this.SidebarTypes.News ){
                _this.LCS.setSetting('newsFeed', false);
            }
            _this.sidebarType = sidebarType;
            _this.isOpen = isOpen;

            _this.RootEventsService.broadcastRoot('COMMENTS_SIDEBAR_UPDATED',
                _.extend(getSidebarInfoInit(), {
                    componentId: componentId,
                    isInstall: isInstall
                }));
        }
    }

    function getOpen(prop, isOpen){
        return prop === _this.SidebarTypes.News ?
            false//_this.LCS.getSetting('newsFeed')
            : (isOpen || false);
    }

    function autoOpenNews(){

    }

    function getSidebarInfo(isPopup){
        return _.extend(getSidebarInfoInit(isPopup), {isOpen: getOpen(_this.sidebarType, _this.isOpen)});
    }

    function getSidebarInfoInit(isPopup){
        return {
            pageInfo: isPopup && _this.childPageInfo ? _this.childPageInfo : _this.pageInfo,
            currentList: _this.currentList,
            uId: _this.uId,
            uIdComment: _this.uIdComment,

            sidebarType: _this.sidebarType,
            isOpen: _this.isOpen
        };
    }

}

angular.module('service.currentSettings.service', [])
.service('CurrentLocaleSettings',CurrentLocaleSettings);
CurrentLocaleSettings.$inject = ['API_CONFIGS', 'MomentService'];
function CurrentLocaleSettings(API_CONFIGS, MomentService) {
    var Countries = getCountriesData(),

        Temperatures = [
            {value: 'f', text: 'Fahrenheit'},
            {value: 'c', text: 'Celsius'}
        ],

        TimeFormats = [
            {value: 'h:mma', text: '12 hour clock'},
            {value: 'HH:mm', text: '24 hour clock'}
        ],

        DateFormats = [
            {value: 'MM/DD/YYYY', text: 'MM/DD/YYYY'},
            {value: 'ddd, MMM D, YYYY', text: 'ddd, MMM D, YYYY'},
            {value: 'MMM, D YYYY', text: 'MMM D, YYYY'}
        ],

        defaultSettings = _.extend({
            startTime: MomentService.getUtcMomentFromTimeMoment()
        }, API_CONFIGS().defaultUserSettings),

        companySettings,
        productSettings;

    var service = {
        DefaultSettings: defaultSettings,
        Countries: Countries,

        getCompanySettings: getCompanySettings,
        getProductSettings: getProductSettings,

        initProductSettings: initProductSettings,
        initCompanySettings: initCompanySettings,
        getTimeFormat: getTimeFormat,
        getVarsByCountryCode: getVarsByCountryCode,
        getTemperatures: getTemperatures,
        getTimeFormats: getTimeFormats,
        getDateFormats: getDateFormats,
        getCurrencyBasedOnCountry: getCurrencyBasedOnCountry,
        getCurrentSettings: getCurrentSettings,
        getCurrencies: getCurrencies,
        getDateTimeFormat: getDateTimeFormat,
        getColors: getColors
    };

    return service;



    function getCurrentSettings(product) {
        return product ? productSettings : companySettings;
    }

    function getCurrencyBasedOnCountry(country) {
        var item = _.find(Countries, function (item) {
            return item.iso3 === country;
        })
        return (item ? item : defaultSettings).currency;
    }
    function initProductSettings(prodSettings){
        var country = prodSettings && prodSettings.country ? prodSettings.country : getCountryCode();
        productSettings = {
            country: country,
            currency: prodSettings && prodSettings.currency ? prodSettings.currency : getCurrencyByCountryCode(country),
            language: prodSettings && prodSettings.language ? prodSettings.language : getLanguageByCountryCode(country),
            temperature: prodSettings && prodSettings.temperature ? prodSettings.temperature : getTemperatureByCountryCode(country),
            
            timeFormat: prodSettings && prodSettings.timeFormat ? prodSettings.timeFormat : getTimeFormat(), 
            dateFormat: prodSettings && prodSettings.dateFormat ? prodSettings.dateFormat : getDateFormat(),

            startTime: MomentService.stringToUTCMoment(prodSettings && prodSettings.startTime ? prodSettings.startTime : getStartTime())
        };
        productSettings.shortDateFormat = getShortDateFormat();
        productSettings = getOtherSettings(productSettings);
    }

    function initCompanySettings(settings){
        var country = settings && settings.country ? settings.country : defaultSettings.country;
        companySettings = {
            country: country,
            currency: settings && settings.currency ? settings.currency : defaultSettings.currency,
            language: settings && settings.language ? settings.language : defaultSettings.language,
            temperature: settings && settings.temperature ? settings.temperature : defaultSettings.temperature,

            timeFormat: settings && settings.timeFormat ? settings.timeFormat : defaultSettings.timeFormat,
            dateFormat: settings && settings.dateFormat ? settings.dateFormat : defaultSettings.dateFormat,

            startTime: MomentService.stringToUTCMoment(settings && settings.startTime ? settings.startTime : defaultSettings.startTime),
        };
        companySettings.shortDateFormat = getShortDateFormat();
        companySettings = getOtherSettings(companySettings);
    }

    function getOtherSettings(settings) {
        settings.dateTimeFormat = settings.dateFormat + ' @ ' + settings.timeFormat;
        settings.numberFormatter = getNumberFormat(settings.language);
        settings.currencyFormatter = getCurrencyFormat(settings.language, settings.currency);
        settings.currencyDecimalsSeparator = getDecimalsSeparator(settings.numberFormatter);
        settings.currencyThousandSeparator = getThousandSeparator(settings.numberFormatter);
        settings.currencySymbolInFront = currencySymbolIsInFront(settings.currencyFormatter);
        settings.currencySymbol = getCurrencySymbol(settings.currencyFormatter);
        settings.countryObject = _.find(Countries, {iso3: settings.country});
        return settings;
    }

    function getDecimalsSeparator(numberFormatter) {
        var str = numberFormatter.format('0.01').replace(/[0-9]/g, '');
        return str ? (str.length > 0 ? str[0] : str) : '';
    }

    function getThousandSeparator(numberFormatter) {
        var str = numberFormatter.format('1000').replace(/[0-9]/g, '');
        return str ? (str.length > 0 ? str[0] : str) : '';
    }

    function getCurrencySymbol(formatter) {
        if(formatter){
            try {
                return _.find(formatToParts2(formatter), function (item) {
                    return item.type === 'currency';
                }).value;
            }catch (e){}
        }
        return defaultSettings.currencySymbol;
    }

    function currencySymbolIsInFront(formatter) {
        if(formatter) {
            try {
                return formatToParts2(formatter)[0].type === 'currency';
            } catch (e) {}
        }
        return defaultSettings.currencySymbolInFront;
    }

    function formatToParts2(formatter) {
        return formatter.formatToParts('0.01');
    }

    function getCountryCode() {
        return (companySettings && companySettings.country) ? companySettings.country : defaultSettings.country;
    }

    function getCompanySettings() {
        return companySettings ? angular.copy(companySettings) : null;
    }

    function getProductSettings() {
        return productSettings ? angular.copy(productSettings) : null;
    }

    function getTimeFormat() {
        return (companySettings && companySettings.timeFormat) ? companySettings.timeFormat : defaultSettings.timeFormat;
    }

    function getTemperatureFormat() {
        return (companySettings && companySettings.temperature) ? companySettings.temperature : defaultSettings.temperature;
    }

    function getCountryISO3() {
        return (companySettings && companySettings.country) ? companySettings.country : defaultSettings.country;
    }

    function getColors() {
        return (companySettings && companySettings.colors) ? companySettings.colors : null;
    }

    function getTemperatures() {
        return Temperatures;
    }

    function getTimeFormats() {
        return TimeFormats;
    }

    function getCurrencyByCountryCode(country) {
        return getPropFromCountryCode('currency', country);
    }

    function getLanguageByCountryCode(country) {
        return getPropFromCountryCode('language', country);
    }

    function getTemperatureByCountryCode(country) {
        return (country === 'BHS' || country === 'BLZ' || country === 'CYM' || country === 'PLW' || country === 'USA') ? 'f' : 'c';
    }


    function getVarsByCountryCode(country) {
        if (!country) {
            return {};
        }
        var c = _.find(Countries, function (item) {
            return item.iso3 === country;
        });
        return {
            currency: getPropFromCountryObj('currency', c) || defaultSettings.currency,
            language: getPropFromCountryObj('language', c) || defaultSettings.language,
            temperature: getTemperatureByCountryCode(country) || defaultSettings.temperature,
        }
    }

    function getPropFromCountryCode(prop, country) {
        return getPropFromCountryObj(prop, _.find(Countries, function (item) {
            return item.iso3 === country;
        }));
    }

    function getPropFromCountryObj(prop1, country) {
        var prop = prop1;
        switch(prop1) {
            case 'language':
                prop = 'languages';
                break;
            case 'currency':
                prop = 'currencyAlphaCode';
                break;
        }

        var v = country ? country[prop] : null;
        if (!v){return null;}
        switch(prop1) {
            case 'language':
                var str = v.split(',');
                v = str && str.length>1?str[0]:str;
                break;
        }

        return v;
    }

    function getStartTime() {
        return (companySettings && companySettings.startTime) ? companySettings.startTime : defaultSettings.startTime;
    }
    function getDateFormat() {
        return (companySettings && companySettings.dateFormat) ? companySettings.dateFormat : defaultSettings.dateFormat;
    }

    function getShortDateFormat() {
        return (companySettings && companySettings.shortDateFormat) ? companySettings.shortDateFormat : defaultSettings.shortDateFormat;
    }

    function getDateFormats() {
        return DateFormats;
    }

    function getDateTimeFormat() {
        return getDateFormat() + ' @ ' + getTimeFormat();
        // var user = service.getCurrentUser();
        // return (user && user.dateTimeFormat) ? user.dateTimeFormat : defaultSettings.dateTimeFormat;
    }


    function getNumberFormat(locale) {
        return new Intl.NumberFormat(locale);
    }

    function getCurrencyFormat(locale, currency) {
        try {
            return new Intl.NumberFormat(locale, {
                style: 'currency',
                currency: currency || defaultSettings.currency,
                trimZeroFractions: true,
                minimumFractionDigits: 2,
               // currencyDisplay: 'symbol',
            })
        } catch (e) {
            return defaultSettings.currencyFormatter;
        }
    }

    function getCurrencies() {
        if(!service.Currencies) {
            var list = [];
            _.each(Countries, function (c) {
                if (_.find(list, function (item) {
                    return item.v === c.currencyAlphaCode;
                }) === undefined) {
                    list.push({n: c.currencyName, v: c.currencyAlphaCode, s: c.currencySymbol});
                }
            });
            service.Currencies = list;
        }
        return service.Currencies;
    }
}

angular.module('service.currentPageSettings.service', [
    'security.service',
    'services.sessionService',
    'services.stateService',
    'sb.fields.phone.service'
])
.service('CPS', CPS);
CPS.$inject = ['security', 'SessionService', 'SBStateService', 'LCS', 'PopupsCtrlService', '$filter', 'IntlTelInputService', 'i18nNotifications', 'CurrentLocaleSettings', 'CurrentProduct', 'localizedMessages', 'MomentService'];
function CPS(security, SessionService, SBStateService, LCS, PopupsCtrlService, $filter, IntlTelInputService, i18nNotifications, CurrentLocaleSettings, CurrentProduct, localizedMessages, MomentService) {
    var service = {
        IntlTelInputService: IntlTelInputService,
        MomentService: MomentService,
        SBStateService: SBStateService,
        CurrentProduct: CurrentProduct,
        SessionService: SessionService,
        CurrentLocaleSettings: CurrentLocaleSettings,
        i18nNotifications: i18nNotifications,
        localizedMessages: localizedMessages,
        LCS: LCS,
        API_CONFIGS: LCS.API_CONFIGS,
        popupsService: PopupsCtrlService,
        security: security,

        getCurrentRate: getCurrentRate,
        setPageSettings: setPageSettings,
        currentProductPathParams: currentProductPathParams,
        loadStateDataParams: loadStateDataParams,
        setPageBanner: setPageBanner,
        closeBanner: closeBanner
    }
    //use the current website instead of the absolute. so that gen can work
    service.websiteUrl = service.API_CONFIGS.site.absUrl;
    service.awsOrigin = service.API_CONFIGS.AWS.enabled ? service.API_CONFIGS.AWS.origin : null;

    service.uploadLogo = service.LCS.uploadLogo;
    service.currentPathParams = service.security.currentPathParams;
    service.rolePaths = service.security.rolePaths;

    service.hasCurrentState = service.SBStateService.hasCurrentState;
    service.transitionTo = service.SBStateService.transitionTo;
    service.reloadCurrentState = service.SBStateService.reloadCurrentState;
    service.getStateHref = service.SBStateService.getStateHref;
    service.openInNewWindow = service.SBStateService.openInNewWindow;
    service.getSearchFilter = service.SBStateService.getSearchFilter;
    service.setSearchFilter = service.SBStateService.setSearchFilter;

    service.stringToUTCMoment = service.MomentService.stringToUTCMoment;


    service.getCreatedAt = getCreatedAt;
    service.capitalizeFirst = capitalizeFirst;
    service.displayPhone = displayPhone;

    service.loadCurrentLocale = loadCurrentLocale;
    service.loadSessionInfo = loadSessionInfo;
    service.loadSubscription = loadSubscription;
    service.loadStateDataParams = loadStateDataParams;

    service.hasQuotaType = hasQuotaType;
    service.loadQuotaPopup = loadQuotaPopup;

    service.openProPopup = openProPopup;

    return service;

    function setPageSettings(CheatSheetService) {
      //  CheatSheetService.cheatSheetInfo = null;
        service.loadSessionInfo();
        service.loadStateDataParams();
    }

    function loadStateDataParams() {
        var data = service.SBStateService.getStateDataParams();

        if (!data.nameForGroup) {
            data.nameForGroup = 'Group';
        }

        if (!data.nameForList) {
            data.nameForList = 'List';
        }

        if (!data.iconForGroup) {
            data.iconForGroup = 'folder';
        }
        return data;
    }

    function loadSessionInfo() {
        service.currentStateName = service.SBStateService.getCurrentStateName();
        service.stateParams = service.SBStateService.getCurrentStateParams();

        service.canEdit = SessionService.getSetting('canEdit');
        service.canComment = SessionService.getSetting('canComment');

        service.userId = SessionService.getSetting('userId');
        service.user = SessionService.getSetting('user');
        service.teamId = SessionService.getSetting('teamId');
        service.companyId = SessionService.getSetting('companyId');
        service.isAuthenticated = SessionService.getSetting('isAuthenticated');
        service.isCollaborator = SessionService.getSetting('isCollaborator');
        service.companies = SessionService.getSetting('companies');
        service.memberType = service.isAuthenticated && service.user ? SessionService.getSetting('memberType') : 0;
        service.isDifferentUser = isDifferentUser();
        service.isOwner = security.isCompanyOwner();
        service.isAdmin = security.isCompanyAdmin();
        service.isOwnerOrAdmin = security.isCompanyOwnerOrAdmin();

        service.isUserPath = service.stateParams.role && (service.security.getRoleFromPath(service.stateParams.role) === service.security.UserRoles.User);

        var productId = service.stateParams && service.stateParams.productId ? service.stateParams.productId : null;
        if (productId !== service.productId) {
            service.productId = service.stateParams && service.stateParams.productId ? service.stateParams.productId : null;

            service.product = service.productId ? service.CurrentProduct.getProduct() : null;
            service.scriptId = service.product && service.product.scriptId ? service.product.scriptId : null;

            service.CurrentLocaleSettings.initProductSettings(service.product ? service.product.settings : null);
        }

        service.loadCurrentLocale();
        service.loadSubscription();
    }

    function isDifferentUser() {
        var data = service.SBStateService.getCurrentStateData();
        var teamId = data && data.minRole === 0 ? null : service.teamId;
        return !(SessionService.getSetting('isUserOrCollab') && teamId && teamId === service.teamId);
    }

    function loadCurrentLocale() {
        service = $.extend(service, service.CurrentLocaleSettings.getCurrentSettings(service.product));
    }

    function getCurrentRate(amount) {
        if (amount === undefined || amount === null) {
            amount = 0;
        }
        try {
            return service.currencyFormatter.format(amount);
        } catch (e) {
            console.error('getCurrentRate: ' + amount);
            return 0;
        }
    }

    function loadSubscription() {
        service.subscription = SessionService.getSetting('subscription');
        service.currentPlan = SessionService.getSetting('plan');
    }

    function openProPopup(e, params) {
        var quotaType = e && e.currentTarget ? e.currentTarget.getAttribute('data-quota') : null;
        if(quotaType) {
            loadQuotaPopup(quotaType, function () {
            }, null, null, _.extend({}, params), {
                e: e
            });
        }
    }
    function loadQuotaPopup(quotaType, onSuccess, maxFreeItemsCount, count, compOptions, otherParams) {
        if (!quotaType) {
            return onSuccess();
        }

        var quota = service.hasQuotaType(quotaType),
            counter;
        console.log('quotaType: ' + quotaType);

        if (quota) {
            if (quota.hasCounter) {
                var t = quota.total ? quota.total : quota.count;
                if(t===undefined){t = 0;}
                counter = {
                    hasCounter: true,
                    total: t,
                    remaining: t - (count ? count : 0)
                };
            } else {
                return onSuccess(quota);
            }
        } else if (!quota) {
            if (maxFreeItemsCount !== null && maxFreeItemsCount !== undefined) {
                counter = {
                    hasCounter: true,
                    total: maxFreeItemsCount,
                    remaining: maxFreeItemsCount === 0 ? -1 : (maxFreeItemsCount - count),
                };
            }
        }

        if (otherParams && typeof (otherParams.onQuotaOpen) === 'function') {
            otherParams.onQuotaOpen();
        }

        return service.popupsService.checkQuota(quotaType, onSuccess, compOptions, _.extend({quotaCounter: counter}, otherParams));
    }

    function hasQuotaType(quotaType) {
        var planFeatures = service.currentPlan && service.currentPlan.features ? service.currentPlan.features : null,
            f = planFeatures ? planFeatures[quotaType] : null;

        if (f) {
            var subFeatures = service.subscription.features,
                isCustom = subFeatures.isCustom,
                s = subFeatures[quotaType];
            if (quotaType === 'team') {
                return service.currentPlan.name === 'Free' ? null : get(s);
            }else if (quotaType === 'fileStorage') {
                return {
                    hasCounter: true,
                    total: s.total,
                    remaining: 1000
                }
            }else if (quotaType === 'projects' && isCustom) {
                return get(s);
            }
        }

        return f;

        function get(s) {
            return {
                hasCounter: true,
                total: s.total,
                remaining: s.total === null ? 1000 : (s.total - s.used)
            };
        }
    }

    function currentProductPathParams(data) {
        return service.currentPathParams(_.extend({productId: service.productId}, data ? data : {}));
    }

    function setBanner(banner, val) {
        service.withBanner = setPageBanner(service.withBanner, service.showBannerProp, banner ? banner : service.bannerFeatureProp, val);
    }

    function closeBanner(banner) {
        setBanner(banner, false);
    }

    function setPageBanner(withBanner, showBannerProp, featureProp, val) {
        // to replace with prop per page
        var prop = (showBannerProp ? showBannerProp : 'showStripboardBanner') + (service.isCollaborator ? 'Collab' : '');
        if (val === undefined) {
            var hasFeature = service.hasQuotaType(featureProp ? featureProp : 'stripboard'),
                showBanner = true; //todo ?? service.LCS.getSetting(prop);
            val = (service.isCollaborator ? (
                !hasFeature || hasFeature && (service.SBStateService.isFromWWW() ||
                    service.companyId === service.LCS.API_CONFIGS.SBPredefCompanyId)
            ) : (showBanner && !hasFeature)) ? true : false;
        }

        if (val !== withBanner) {
            withBanner = val;
            if (!service.isCollaborator) {
                service.LCS.setSetting(prop, val);
            }
        }
        console.log('setBanner for  ' + prop + ": " + val);

        return withBanner === true;
    }

    function getCreatedAt(field, format) {
        return $filter('amDateFormat')(field, format ? format : 'MMM D, YYYY');
    }

    function capitalizeFirst(val) {
        return val ? $filter('capitalizeFirst')(val) : null;
    }

    function displayPhone(val, isInt) {
        return val ? service.IntlTelInputService[isInt ? 'formatIntNumber' : 'formatNatNumber'](val) : null;
    }
}

angular.module('service.currentProduct', [
    'apiServices.Products',
    'apiServices.Callsheets',
    'apiServices.Scripts',
    'apiServices.Users',
    'services.stateService',
    'service.currentSettings.service'
])
.service('CurrentProduct',CurrentProductFactory);
CurrentProductFactory.$inject = ['RootEventsService', 'SBStateService', 'ProductsService', 'CallsheetsService', 'ScriptsService', 'UsersService'];
function CurrentProductFactory(RootEventsService, SBStateService, ProductsService, CallsheetsService, ScriptsService, UsersService) {
    var  Callsheets = CallsheetsService.model,
        Products = ProductsService.model,
        product = null, callsheet = null, scripts = null;

    return {
        loadProduct: loadProduct,
        setProduct: setProduct,
        getProduct: getProduct,
        onProductChanged: onProductChanged,
        broadcastProduct: broadcastProduct,

        setCallsheet: setCallsheet,
        setCallsheetStyle: setCallsheetStyle,
        getCallsheet: getCallsheet,
        clearCallsheet: clearCallsheet,
        onCallsheetChanged: onCallsheetChanged,
        broadcastCallsheet: broadcastCallsheet,

        setScripts: setScripts,
        getScripts: getScripts,
        clearScripts: clearScripts,
        updateScriptDocumentVersionId: updateScriptDocumentVersionId,

        getCurrentScript: getCurrentScript,

        updateCallsheetInfo: updateCallsheetInfo,
        setCallsheetInfo: setCallsheetInfo
    };

    function setCallsheetInfo(info, prop, value, block){
        var updates = {};
        updates[prop] = value;
        info[block] = updates;
        return info;
    }

    function updateCallsheetInfo($ctrl, info, onSuccess, errorType, withMulti) {
        var params = {_id: $ctrl.callsheetId};
        for (var block in info){
            var updates = info[block];
            if(updates) {
                for (var prop in updates) {
                    params['options.' + $ctrl.optionsProp +
                    (block && block!=='null' ? ('.' + block) : '') +
                    '.' + prop] = updates[prop];
                }
            }
        }

        if(info.dontShowActivity){
            params.dontShowActivity = true;
        }

        CallsheetsService.update(params, onsuccess, onerror);

        function onsuccess(data) {
            $ctrl.isUpdating = false;
            var item = data ? data.item : null;
            if (item) {
                var v = item.options[$ctrl.optionsProp];
                if(withMulti){
                    $ctrl.options = v;
                    for (var block in info){
                        info[block] = $ctrl.options[block];
                    }
                    setCallsheetOptions($ctrl.optionsProp, $ctrl.callsheetId, info);
                }else{
                    for(var block in info){
                        $ctrl.options = v && block!=='null' ? v[block] : v;
                        if(!$ctrl.callsheet.options){$ctrl.callsheet.options = {};}
                        if(block && block!=='null') {
                            if (!$ctrl.callsheet.options[$ctrl.optionsProp]) {
                                $ctrl.callsheet.options[$ctrl.optionsProp] = {};
                            }
                            $ctrl.callsheet.options[$ctrl.optionsProp][block] = $ctrl.options;
                        }else{
                            $ctrl.callsheet.options[$ctrl.optionsProp]= $ctrl.options;
                        }
                        setCallsheet($ctrl.callsheet);
                     }
                }
                //console.log('CurrentProduct.setCallsheet options:');
                onSuccess(data);
            }
        }

        function setCallsheetOptions(optionsProp, id, info) {
            if (callsheet && callsheet._id === id) {
                if(!callsheet.options){callsheet.options = {};}
                if(!callsheet.options[optionsProp]){callsheet.options[optionsProp]  = {};}
                for(var block in info){
                    callsheet.options[optionsProp][block] = info[block];
                }
            }
        }

        function onerror(error) {
            $ctrl.isUpdating = false;
            console.log(error);
            $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.callsheet.'+errorType+'.error', 'error');
        }
    }

    function getCurrentScript(pId, onSuccess, onError){
        ProductsService.getById(pId, 'scriptId', onProduct, onError);

        function onProduct(product) {
            var script = product.script;
            if (script && script.createdById){
                UsersService.getById(script.createdById, null, onUser, onError);
            } else{
                onSuccess(script);
            }
            function onUser(user) {
                script.createdById = user;
                script = ScriptsService.convertResource(script);
                onSuccess(script);
            }
        }
    }

    function loadProduct(pId, sId, next) {
        if (!pId) {
            return complete(null);
        }
        if (pId && product && product._id === pId) {
            return complete(product, scripts);
        } else {
            return ProductsService.getById(pId, 'createdById settingsId productTypeId logoId', onSuccess, onError);

            function onSuccess (product) {
                product = ProductsService.convertResource (product);
                if (product) {
                    return ScriptsService.getAll({
                        productId: product._id,
                        companyId: product.companyId
                    }, null, 'versionId createdById documentVersionId contentVersionId', onsuccess, onerror);
                } else {
                    return onerror();
                }

                function onsuccess(scripts) {
                    return complete(product, scripts);
                }

                function onerror(err) {
                    return complete(product);
                }

            }

            function onError(error) {
                return complete(null);
            }
        }

        function complete(product, scripts) {
            setScripts(scripts);
            if (scripts) {
                var script = _.find(scripts, {isDefault: true});
                if (!script) {
                    script = scripts[0];
                }
                product.script = ScriptsService.convertResource(script);
                product.scriptId = script._id;

                if(sId && product.scriptId !== sId){
                    product.previewScript = ScriptsService.convertResource(_.find(scripts, {_id: sId}));
                    product.previewScriptId = product.previewScript ? product.previewScript._id : null;
                }

                broadcastProduct(product);
            }
            return next(product);
        }
    }

    function setProduct(data) {
        product = data ? data : null;
    }

    function broadcastProduct(p, changes) {
        product = p;
        RootEventsService.broadcastRoot('UPDATED_PRODUCT_ITEM', {item: product, changes: changes});
    }

    function onProductChanged(watchers, callback) {
        RootEventsService.addRootWatcher(watchers, 'UPDATED_PRODUCT_ITEM', function (result) {
            callback(result);
        });
    }

    function getProduct() {
        return SBStateService.getCurrentStateParams().productId ? product : new Products();
    }

    function setCallsheet(data) {
        callsheet = data ? data : null;
    }

    function setCallsheetStyle(id, val) {
        if (callsheet && callsheet._id === id) {
            if(!callsheet.options){callsheet.options  = {};}
            callsheet.options.styles = val;
        }
    }

    function clearCallsheet() {
        callsheet = null;
    }

    function getCallsheet(isNew) {
        return isNew && !SBStateService.getCurrentStateParams().callsheetId ? getNew() : (callsheet ? callsheet : getNew());

        function getNew() {
            return new Callsheets();
        }
    }

    function broadcastCallsheet(p) {
        callsheet = p;
        RootEventsService.broadcastRoot('UPDATED_CALLSHEET_ITEM', callsheet);
    }

    function onCallsheetChanged(watchers, callback) {
        RootEventsService.addRootWatcher(watchers, 'UPDATED_CALLSHEET_ITEM', callback);
    }

    function getBroadcast(prop, trigger){
        return {
            b: function(p) {
                prop = p;
                RootEventsService.broadcastRoot(trigger, p);
            },
            a: function (watchers, callback) {
                RootEventsService.addRootWatcher(watchers, trigger, callback);
            }
        }
    }

    function setScripts(data) {
        scripts = data ? data : null;
    }

    function updateScriptDocumentVersionId (script) {
        var id = script ? script._id: null;
        if(!id){return;}
        var prop = 'documentVersionId',
            val = script[prop];
        if(val){
            for(var i = 0, n = scripts.length; i < n;i++){
                var el = scripts[i];
                if(el._id === id){
                    scripts[i][prop] = val;
                    break;
                }
            }
            if(product.scriptId === id){
                scripts[i][prop] = val;
            }
        }
    }

    function clearScripts() {
        scripts = null;
    }

    function getScripts() {
        return scripts;
    }
}

 angular.module('services.positionsConfigsService', [
     'apiServices.Positions'
 ])
.service('PositionsConfigsService', PositionsConfigsService);
PositionsConfigsService.$inject = ['PositionsService'];
function PositionsConfigsService(PositionsService) {
    var _this = this;
    var info = {};

    _this.loadPositions = loadPositions;
    return _this;

    function loadPositions(companyId, productId, next) {
        var prop = 'c'+companyId+productId;
        if(info[prop]) {
            return next(info[prop]);
        }

        info = {};
        return PositionsService.getPositions({
            companyId: companyId ? companyId : null,
            productId: productId ? productId : null
        },  function (result) {
            return onreload(result);
        }, function (error) {
            return onreload();
        });

        function onreload(result) {
            info [prop]={
                p: result && result.p ? result.p : [],
                d: result && result.d ? result.d : []
            };
            next(info[prop]);
        }
    }
}

angular.module('services.revisionsPersistanceService', [
    'services.persistenceService'
])
.service('RevisionsPersistanceService', RevisionsPersistanceService);

RevisionsPersistanceService.$inject = ['PersistenceService', 'MomentService'];
function RevisionsPersistanceService(PersistenceService, MomentService) {
    var maxL = 15,
        key = 'revision_',
        _this = this;

    _this.isSupported = isSupported;
    _this.set = set;
    _this.get = get;
    _this.remove = remove;
    _this.getAll = getAll;

    return _this;

    function isSupported() {
        try {
            return 'localStorage' in window && window['localStorage'] !== null;
        } catch (e) {
            return false;
        }
    }

    function set(id, val, timestamp, v) {
        if (!val) {
            return;
        }
        var ids = getRevisionIds(id);
        if (!ids) {
            ids = [];
        } else {
            if (_.find(ids, function (rid) {
                return rid === timestamp;
            })) {
                return;
            }
            if (ids.length > maxL - 1) {
                //remove last id
                var index = ids.length - 1,
                    rid = ids[ids.length - 1];
                ids.splice(index, 1);
                //remove object for id
                remove(id, rid);
            }
        }

        //add new id in front
        if (!timestamp) {
            timestamp = MomentService.getTimestamp();
        }
        ids.unshift(timestamp);
        setRevisionIds(id, ids);

        //add new object in persistance for the new id key
        PersistenceService.set(getKey(id, timestamp), val);
        if (v) {
            PersistenceService.setText(getContentVersionKey(id, timestamp), v);
        }
    }

    function get(id) {
        if (!id) {
            return null;
        }
        var ids = getRevisionIds(id);
        if (!ids || !ids.length) {
            return null;
        }
        var el = processOne(id, ids[0]);
        return el && el.c ? el : null;
    }

    function getAll(id) {
        if (!id) {
            return null;
        }
        var ids = getRevisionIds(id), nIds = [], l = [];
        if (ids && ids.length) {
            _.each(ids, function (rid) {
                var el = processOne(id, rid);
                if (el && _.find(nIds, function (rid) {
                    return rid === el.t;
                }) === undefined) {
                    nIds.push(el);
                    l.push(el.t);
                }
            });
        }

        setRevisionIds(id, l);
        return (!nIds || !nIds.length) ? null : nIds;
    }

    function processOne(id, rid) {
        var val = PersistenceService.get(getKey(id, rid));

        return val ? {
            t: parseInt(rid, 10),
            c: val,
            v: PersistenceService.getText(getContentVersionKey(id, rid))
        } : null
    }

    function getKey(id, rid) {
        return rid ? (key + id + '_' + rid) : null;
    }


    function getContentVersionKey(id, rid) {
        return getKey(getKey(id, rid), 'v');
    }

    function getListKey(id) {
        return getKey(id, 'ids');
    }

    function getRevisionIds(id) {
        var ids = PersistenceService.getText(getListKey(id));
        return ids ? ids.split(',') : null;
    }

    function setRevisionIds(id, ids) {
        PersistenceService.setText(getListKey(id), ids && ids.length > 0 ? ids.join(',') : null);
    }

    function remove(id, rid) {
        PersistenceService.remove(getKey(id, rid));
        PersistenceService.remove(getContentVersionKey(id, rid));
    }
}

angular.module('services.sessionService', [
    'services.layoutConfigsService',
    'services.sessionEventsService'
])
.service('SessionService', SessionService);

SessionService.$inject = ['LCS', 'SBStateService', 'SessionEventsService', 'Users',  'SubscriptionsService', 'TeamService'];
function SessionService(LCS, SBStateService, SessionEventsService, Users, SubscriptionsService, TeamService) {
    var _this = this;
    var settings = {};

    _this.SBStateService = SBStateService;
    _this.RootEventsService = _this.SBStateService.RootEventsService;
    _this.$rootScope = _this.RootEventsService.$rootScope;
    _this.SessionEventsService = SessionEventsService;
    _this.LCS = LCS;

    _this.SubscriptionsService = SubscriptionsService;
    _this.TeamService = TeamService;
    _this.Users = Users;

    _this.session = {
        companyId: null,
        userId: null,
        isAuthenticated: false,
        teamId: null,
        memberType: 0,
        isUserOrCollab: false,
        isCollaborator: false,
        canEdit: false,
        canComment: false,
        team: null,
        plan: null,
        feature: null,
        subscription: null,
        subscriptionInfo: null,
    };

    _this.setSessionVars = setSessionVars;
    _this.loadCompanyDetails = loadCompanyDetails;
    _this.reloadTeam = reloadTeam;
    _this.broadcastUpdateSubscription = broadcastUpdateSubscription;
    _this.loadSubscriptionInfo = loadSubscriptionInfo;
    _this.getSubscriptionParams = getSubscriptionParams;
    _this.hasQuotaProp = hasQuotaProp;
    _this.onUserUpdated = onUserUpdated;

    /*
   // hasDocChanges:null,
   // savingDocChanges:null,
   // lastDocChanges:null,
    * */
    _this.setSetting = setSetting;
    _this.getSetting = getSetting;
    _this.setDocChangedProp = setDocChangedProp;
    _this.onReloadCompanies = _this.SessionEventsService.onReloadCompanies;

    _this.emitUpdateCompany = _this.SessionEventsService.emitUpdateCompany;
    _this.onUpdateCompany = _this.SessionEventsService.onUpdateCompany;

    _this.emitUpdateTeam = _this.SessionEventsService.emitUpdateTeam;
    _this.onUpdateTeam = _this.SessionEventsService.onUpdateTeam;

    _this.emitUpdateSubscription = _this.SessionEventsService.emitUpdateSubscription;
    _this.onUpdateSubscription = _this.SessionEventsService.onUpdateSubscription;

    _this.onSessionVarsChanged = _this.SessionEventsService.onSessionVarsChanged;
    _this.onUpdateUser = _this.SessionEventsService.onUpdateUser;

    return _this;

    function setSessionVars(security, next) {
        console.log('setSessionVars');
        var isClearing = false;
        if (!security) {
            security = {};
            isClearing = true;
        }

        var companyIdChanged = _this.setSetting('companyId', isClearing ? null : security.getCurrentCompanyId());
        _this.setSetting('userId', isClearing ? null : security.getCurrentUserId());

        var isAuthenticated = isClearing ? false : security.isAuthenticated();
        var isAuthenticatedChanged = _this.setSetting('isAuthenticated', isAuthenticated);

        if (isClearing && isAuthenticatedChanged) {
            _this.LCS.updateBody(_this.SBStateService);
        }
        if(isAuthenticatedChanged){
            _this.setSetting('companies', isClearing ? [] : security.companies);
        }
        _this.setSetting('teamId', isClearing ? null : security.getCurrentTeamId());
        _this.setSetting('memberType', isClearing ? null : security.memberType);
        var isUserOrCollabChanged = _this.setSetting('isUserOrCollab', isClearing ? false : security.isUserOrCollab());
        _this.setSetting('isCollaborator', isClearing ? false : security.isCollaborator);
        _this.setSetting('canEdit', isClearing ? false : security.canEdit());
        _this.setSetting('canComment', isClearing ? false : security.canComment());

        var user = isClearing ? null : (security.getCurrentUser() ? new _this.Users(security.getCurrentUser()) : null),
            userChanged = _this.setSetting('user', user),
            //onWatchUser
            userChanged1 = userChanged && user && user.role > security.UserRoles.Collaborator && user.userId;

        if (userChanged1) {
            _this.SessionEventsService.emitReloadCompanies();
            security.updateCurrentUser(user, _this);
        }

        if (isClearing) {
            _this.setSetting('team', null);
            _this.loadSubscriptionInfo(null);
            _this.SessionEventsService.emitSessionVarsChanged();
        }else{
            if (companyIdChanged) {
                _this.loadSubscriptionInfo(security.subscription);
                return _this.loadCompanyDetails(set);
            } else {
                return set();
            }

            function set() {
                if (isAuthenticated) {
                    _this.LCS.setMainSideBar(true);
                }

                if (isUserOrCollabChanged) {
                    _this.SessionEventsService.emitSessionVarsChanged();
                }

                return next();
            }
        }
    }

    function loadCompanyDetails(next) {
       return _this.getSetting('companyId') ? _this.reloadTeam(next) : next();
    }

    function reloadTeam(next) {
        var companyId = _this.getSetting('companyId');
        return (_this.getSetting('isUserOrCollab') && companyId) ? _this.TeamService.getCompanyTeam(companyId, set, set) : set();

        function set(result) {
            if (!result) {
                result = [];
            }
            _this.setSetting('team', result);
            _this.SessionEventsService.emitUpdateTeam(result);
            _this.SessionEventsService.emitReloadCompanies(result);
            return typeof(next)==='function'? next() : null;
        }
    }

    function broadcastUpdateSubscription(sub) {
        if (sub && sub.item) {
            sub = sub.item;
        }
        if (sub && (!sub.getType || sub.getType() !== 'subscription')) {
            sub = _this.SubscriptionsService.convertResource(sub);
        }
        _this.loadSubscriptionInfo(sub);
        _this.emitUpdateSubscription(sub);
    }

    function loadSubscriptionInfo(sub) {
        _this.setSetting('subscription', sub ? sub : null);
        var list = [],

            plan = sub ? _.find(getPlansData(), function (item) {
                return item._id === sub.planId;
            }) : null;

        if (plan) {
            var features = getPlanFeaturesData();
            var pf = plan ? plan.features : null;
            if (features) {
                for (var i = 0; i < features.length; i++) {
                    var ep = features[i];
                    var planProp = pf ? pf[ep.name] : null;
                    if (planProp) {
                        var newi = {
                            type: ep.name,
                            name: ep.shortDesc,
                            isReplenishable: ep.isReplenishable
                        };

                        if (ep.hasCounter) {
                            for (var prop in sub.features) {
                                if (ep.name === prop) {
                                    var f = sub.features[prop];
                                    if (f != null) {
                                        newi.remaining = f.total === null ? f.total : f.total - f.used;
                                        newi.total = pf && pf[prop] ? pf[prop].count : 0;
                                        newi.percent = newi.total ? (newi.remaining * 100 / newi.total) : 100;
                                    }
                                    break;
                                }
                            }
                        }

                        list.push(newi);
                    }
                }
            }
        }

        _this.setSetting('plan', plan);
        _this.setSetting('planFeatures', list);
    }

    function getSubscriptionParams(quotaType) {
        var x = _this.getSetting('planFeatures');
        if (x && x.length > 0) {
            for (var i = 0; i < x.length; i++) {
                var el = x[i];
                if (el.type === quotaType) {
                    return el;
                }
            }
        }
        return null;
    }

    function hasQuotaProp(quotaType) {
        var quota = _this.getSubscriptionParams(quotaType);
        if (!quota) {
            return false;
        }
        var rem = quota.remaining;
        return quota.isReplenishable !== true || quota.isReplenishable && (quota.total == null || rem != null && rem > 0);
    }

    function onUserUpdated(user) {
        console.log('onUserUpdated');
        var prop = 'user';
        var u = _this.getSetting(prop);
        if (u && user) {
            setUpdated(u, user);
            console.log(u);
            _this.setSetting(prop, u);

            var team = _this.getSetting('team'),
                l = team && team.length > 0 ? team.length : 0;
            for (var i = 0; i < l; i++) {
                var el = team[i];
                if (el.userId === user._id) {
                    setUpdated(team[i], user);
                    break;
                }
            }
            _this.setSetting('team', team);
        }

        _this.SessionEventsService.emitUpdateUser(u);

        return u;

        function setUpdated(item, newItem) {

            if (item && newItem) {
                setProp('memberType');
                setProp('name');
                setProp('phone');
                setProp('email');
                setProp('profilePictureURL');
                setProp('profilePictureURLId');
            }

            function setProp(prop) {
                item[prop] = newItem[prop];
            }
        }
    }

    function setSetting(prop, val) {
        var v = undefined;//_this.getSetting(prop);
        if (v !== val) {
            settings[prop] = val;
            _this.$rootScope[prop] = val;
            //todo
            // _this.session[prop] = val;
            // _this.emitSessionChanged(prop, val);
            return true;
        }
        return false;
    }

    function getSetting(prop) {
        var val = settings[prop];
        if(_this.$rootScope[prop] !== val){_this.$rootScope[prop]=val;}
        return val;
    }

    function setDocChangedProp(prop, val) {
        _this[prop] = val;
        _this.SessionEventsService.emitDocChanged({prop: val});
    }
}

