    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new AppRefreshPopupCtrlService($ctrl, $element);

    function setTemplateDataOther() {

        $ctrl.withCloseBtn = true;
        $ctrl.popupTitle = 'New Version Synced';
    }

