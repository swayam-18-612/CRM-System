angular.module('sb.fields.bigCheck.component', [
    'sb.fields.inputfield.service'
])
.component('sbBigCheck', sbFieldComponentParams('SbBigCheckCtrl',{}))
.controller('SbBigCheckCtrl', SbBigCheckCtrl);

SbBigCheckCtrl.$inject = ['SBInputFieldCtrlService', 'SBFieldTypesService', 'MomentService', '$element', '$attrs'];

function SbBigCheckCtrl(SBInputFieldCtrlService, SBFieldTypesService, MomentService, $element, $attrs) {

    //works
    var withoutTemplateScope = true;

    var $ctrl = this;
    $ctrl.MomentService = MomentService;

   // $ctrl.withBodyClick = true;
    $ctrl.fieldSelector = 'input';
    $ctrl.withPredefEvents = false;
    $ctrl.propType = SBFieldTypesService.PropTypes.BigCheck;
    $ctrl.getInputValue = getInputValue;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onItemLoaded = onItemLoaded;
    $ctrl.preInitField = preInitField;
    $ctrl.setDisplayValue = setDisplayValue;
    $ctrl.setValue = setValue;
    $ctrl.setUpdatePropValue = setUpdatePropValue;

    $ctrl = new SBInputFieldCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

    function setUpdatePropValue(item) {
        if($ctrl.prop === 'onItem') {
            item = _.extend(item, $ctrl.value);
        }else {
            $ctrl.setUpdatePropValueInit(item);
        }
    }

    function preInitField() {
        $ctrl.inputType = 'checkbox';
    }

    function getItemTemplate() {
        return '<div class="custom-checkbox ' + ($ctrl.canEdit ? 'editable ' : 'not-disabled ') + ($ctrl.fieldClass || '') + '">' +
                    '<label>' +
                        '<input type="' + $ctrl.inputType + '" ' +
                        ($ctrl.canEdit ? '' : 'disabled="disabled" ') +
                        ($ctrl.getInputValue() ? ('checked="checked"') : '') +
                        '><span></span>' +
                    '</label>' +
                '</div>';
    }

    function onItemLoaded() {
        //change on click
        $ctrl.value = toggleCompleted($ctrl.getInputValue());
        $ctrl.save(null, true);
    }

    function getInputValue() {
        return $ctrl.value && $ctrl.value.completed;
    }

    function toggleCompleted(value) {
        return value ? {completed: false} :{
            completed: true,
            completedAt: $ctrl.MomentService.getUtcMomentNow(),
            completedById: $ctrl.CPS.userId
        };
    }

    function setDisplayValue() {
        console.log('setDisplayValue');
        var isChecked = getInputValue();
        $ctrl.inputField[$ctrl.inputContentProp] = $ctrl.getDisplayValue($ctrl.value).content;
        if(!isChecked){
            $ctrl.inputField.removeAttribute('checked');
        }else{
            $ctrl.inputField.setAttribute('checked', 'checked');
        }
    }

    function setValue(next) {
        next();
    }
}

angular.module('sb.fields.email.component', [
    'sb.fields.inputfield.service',
    'apiServices.Users'
])
.component('sbEmail', sbFieldComponentParams('SbInputEmailCtrl',{}))
.controller('SbInputEmailCtrl', SbInputEmailCtrl);

SbInputEmailCtrl.$inject = ['SBInputCtrlService', 'SBFieldTypesService', '$element', '$attrs'];

function SbInputEmailCtrl(SBInputCtrlService, SBFieldTypesService, $element, $attrs) {

    var $ctrl = this;

    $ctrl.preInitField = preInitField;

    //works withoutTemplateScope
    $ctrl = new SBInputCtrlService($ctrl, SBFieldTypesService.PropTypes.Email, $element, $attrs);

    function preInitField() {
        $ctrl.inputType = 'email';
        $ctrl.col.isMaxLength = 320;
        $ctrl.options.validators.mailValidator = {
            skipOnKeyDown: true,
            name: 'mailValidator',
            message: 'Insert a valid email',
            method: function (v) {
                var emailformat = new RegExp(/^[A-Za-z0-9_!#$%&'*+\/=?`{|}~^.-]+@[A-Za-z0-9.-]+$/, "gm");
                return v && emailformat.test(v) ? true : false;
            }
        }
    }

    //todo validate email on creation of user
    function uniqueEmail(viewValue) {
        return {
            mailValidator: {
                name: 'mailValidator',
                message: 'Insert a valid email',
                method: function () {
                    UsersServices.query({email: viewValue}, function (users) {
                        if (!users || !users.length) {
                            $ctrl.$setValidity('uniqueEmail', true);
                        } else {
                            $ctrl.$setValidity('uniqueEmail', false);
                        }
                    });
                    return viewValue;
                }
            }
        };
    }
}

angular.module('sb.fields.input.component', [
    'sb.fields.inputfield.service'
])
.component('sbInput', sbFieldComponentParams('SbInputCtrl',{}))
.controller('SbInputCtrl', SbInputCtrl);

SbInputCtrl.$inject = ['SBInputCtrlService', 'SBFieldTypesService', '$element', '$attrs',  '$window'];

function SbInputCtrl(SBInputCtrlService, SBFieldTypesService, $element, $attrs, $window) {

    var $ctrl = this;

    $ctrl.preInitField = preInitField;
    //works withoutTemplateScope

    $ctrl = new SBInputCtrlService($ctrl, SBFieldTypesService.PropTypes.Field, $element, $attrs);

    function preInitField() {
        $ctrl.canEdit = $attrs.canEdit === 'true' || $attrs.canEdit === true;
        $ctrl.inputType = 'text';
        if ($attrs.selectOnClick === true || $attrs.selectOnClick === 'true') {
            $ctrl.withAutoSelect = true;
        }
        if ($ctrl.inputField) { //for drp
            if ($attrs.selectFileName === true || $attrs.selectFileName === 'true') {
                $ctrl.onFieldFocus = selectFileName;
            } else if ($ctrl.withAutoSelect) {
                $ctrl.onFieldFocus = selectOnClick;
            }
        }
    }

    function selectOnClick(e) {
        if (!$window.getSelection().toString()) {
            // Required for mobile Safari
            this.setSelectionRange(0, this.value.length);
        }
    }
    function selectFileName(e){
        var ext = 0;
        try{ext = parseInt($attrs.ext,10);}catch(e){}
        var length = this.value ? this.value.length : 0;
        if(length > 0 && ext > 0 && !$window.getSelection().toString()) {
            this.setSelectionRange(0, length - ext);
        }
    }

}

angular.module('sb.fields.number.component', [
    'sb.fields.inputfield.service'
])
.component('sbNumber', sbFieldComponentParams('SbNumberController',{}))
.controller('SbNumberController', SbNumberController);

SbNumberController.$inject = ['SBInputCtrlService', 'SBFieldTypesService', '$element', '$attrs'];

function SbNumberController(SBInputCtrlService, SBFieldTypesService, $element, $attrs) {
    var $ctrl = this;
    $ctrl.preInitField = preInitField;
    $ctrl.getInputValue = getInputValue;

    //works withoutTemplateScope
    $ctrl = new SBInputCtrlService($ctrl, SBFieldTypesService.PropTypes.Number, $element, $attrs);

    function preInitField() {
        $ctrl.inputType = 'number';
        if (!$ctrl.value) {
            $ctrl.value = 0;
        }
    }
    function getInputValue() {
        try {
            var val = $ctrl.getInputValueInit();
            return val ? parseInt(val, 10) : 0;
        }catch (e) {
          return 0;
        }
    }
}


angular.module('sb.fields.phone.service', [
])
.service('IntlTelInputService', IntlTelInputService);
IntlTelInputService.$inject = ['$window', 'API_CONFIGS'];
function IntlTelInputService($window, API_CONFIGS) {

    if (!libphonenumber) {
        console.warn('libphonenumber var missing. Did you forget to include the script js/intl-tel-input/intlTel-input.js?');
    }
    if (!$window.intlTelInput) {
        console.warn('intlTelInput var missing. Did you forget to include the script js/intl-tel-input/intlTel-input.js?');
    }
    if (!intlTelInputUtils) {
        console.warn('intlTelInputUtils var missing. Did you forget to include the script js/intl-tel-input/utils.js?');
    }
    var configs = API_CONFIGS();
    var service = {
        utilsSrc: ('https://'+configs.staticDomain + '/'+configs.distdir + '/') + 'js/intl-tel-input/utils.js',
        utils: intlTelInputUtils,
        service: $window.intlTelInput,
    };

    if (service.utils) {
        var errors = service.utils.validationError;
        service.numberFormat = service.utils.numberFormat;
        service.numberType = service.utils.numberType;

        // get the type of the given number e.g. fixed-line/mobile
        service.getNumberType = function getNumberType(number) {
            return service.utils.getNumberType(number, null)
        };

        // format the given number to the given format
        service.formatNatNumber = function (number) {
            var no = getNo(number);
            return service.utils.formatNumber(no, null, service.numberFormat.NATIONAL);
        };

        function getNo(number){
            if (!number || number === '' || number === '+') {
                return '';
            }
            return (number.substring(0,1) !=='+') ? ('+' + number) : number;
        }
        // format the given number to the given format
        service.formatIntNumber = function (number) {
            var no = getNo(number);
            return service.utils.formatNumber(no, null, service.numberFormat.INTERNATIONAL);
        };

        // format the given number to the given format
        service.formatNumber = function (number) {
            var no = getNo(number);
            return service.utils.formatNumber(no, null, service.numberFormat.E164);
        };

        service.formatAsYouType = function (number, countryCode) {
            return new libphonenumber.AsYouType(countryCode ? countryCode.toUpperCase() : 'US').input(number);
        };

        // check if given number is valid
        service.isValidNumber = function isValidNumber(number) {
            return service.utils.isValidNumber(number, null);
        };

        service.validationErrorMessage = function validationErrorMessage(code) {
            switch (code) {
                case errors.INVALID_COUNTRY_CODE:
                    return 'Please set a valid country code';
                case errors.TOO_SHORT:
                    return 'This number is too short';
                case errors.TOO_LONG:
                    return 'This number is too long';
                case errors.INVALID_LENGTH:
                    return 'Invalid phone format';

                case errors.IS_POSSIBLE_LOCAL_ONLY:
                case errors.IS_POSSIBLE:
                    return null;//'Invalid phone format';
            }
            return 'Invalid phone format';
        }
    }

    if ($window.intlTelInputGlobals) {
        service.countries = $window.intlTelInputGlobals.getCountryData();
    }

    return service;
}

//https://github.com/mareczek/international-phone-number

angular.module("sb.fields.phone.component", [
    'sb.fields.inputfield.service',
    'sb.fields.phone.service'
])

.component('sbPhone',  sbFieldComponentParams('SBPhoneNumberCtrl',{}))
.controller('SBPhoneNumberCtrl', SBPhoneNumberCtrl);

SBPhoneNumberCtrl.$inject = ['SBInputCtrlService', 'IntlTelInputService', 'SBFieldTypesService', '$element', '$attrs'];
function SBPhoneNumberCtrl(SBInputCtrlService, IntlTelInputService, SBFieldTypesService, $element, $attrs) {
    //default-country="$ctrl.CPS.countryObject.iso3" countries="$ctrl.countries"

    //todo: doenst work to remove. the fields are getting removed -> same happens in the contact popup for edit
    var $ctrl = this;
    var opts;
    $ctrl.fullNoClass = 'full_phone';
    $ctrl.itiService = IntlTelInputService.service;
    $ctrl.format = IntlTelInputService.numberFormat;
    $ctrl.inputType = 'tel';
    $ctrl.withBodyClick = true;

    $ctrl.preInitField = preInitField;
    $ctrl.onItemLoaded = onItemLoaded;
    $ctrl.setValue = setValue;

    $ctrl.onOtherKeyDownEvent = onOtherKeyDownEvent;
    $ctrl.bind = bind;

    $ctrl = new SBInputCtrlService($ctrl, SBFieldTypesService.PropTypes.Phone, $element, $attrs);

    function preInitField() {
        $ctrl.LCS.addClass($ctrl.element, 'intl-tel-input');
        setCountryData($ctrl.CPS.countryObject);
        opts = {
            formatOnDisplay: true,
            initialCountry: $ctrl.countryCode ? $ctrl.countryCode : 'us',
            //  countries: $ctrl.countries,
            nationalMode: true,
            // separateDialCode: true,
            preferredCountries: ['us', 'gb'],
            utilsScript: IntlTelInputService.utilsSrc
        };

        _.each(opts, function (value, key) {
            var option;
            if (!($ctrl.attrs.hasOwnProperty(key) && angular.isDefined($ctrl.attrs[key]))) {
                return;
            }
            option = $ctrl.attrs[key];
            if (key === 'preferredCountries') {
                opts[key] = handleWhatsSupposedToBeAnArray(option);
                return opts[key];
            } else if (key === 'onlyCountries') {
                opts[key] = handleWhatsSupposedToBeAnArray(option);
                return opts[key];
            } else if (typeof value === "boolean") {
                opts[key] = option === "true";
                return opts[key];
            } else {
                opts[key] = option;
                return opts[key];
            }
        });
        $ctrl.options.validators.phoneValidator = {
            skipOnKeyDown: true,
            name: 'phoneValidator',
            message: 'Invalid phone number',
            method:  function () {
                if(isEmpty()){return true;}
                var isV = $ctrl.iti.isValidNumber($ctrl.inputField);
                if (!isV) {
                    var mes = IntlTelInputService.validationErrorMessage($ctrl.iti.getValidationError());
                    if(!mes){return true;}
                    $ctrl.options.validators.phoneValidator.message = mes;
                }
                return isV;
            }
        };
    }

    function onItemLoaded() {
        if ($ctrl.itiService && !$ctrl.iti) {
            $ctrl.iti = $ctrl.itiService($ctrl.inputField, opts);
            if ($ctrl.value) {
                setNumber($ctrl.value);
            }
        }
    }

    function isEmpty() {
        return !$ctrl.iti || $ctrl.iti && $ctrl.iti.getNumber() === '';
    }

    function bind(isBind) {
        if ($ctrl.inputField) {
          //  $ctrl.LCS.bindElementsClick(isBind, $ctrl.inputField, onCountryChanged, null, 'countrychange');
            $ctrl.LCS.bindElementListeners(isBind, $ctrl.inputField, onCountryChanged, 'countrychange');
        }
    }

    function onCountryChanged(e) {
        $ctrl.stopPropagation(e);
        console.log('onCountryChanged');
        setCountryData($ctrl.iti.getSelectedCountryData());
        setNumber();
    }

    function setCountryData(country) {
        if(country){
            $ctrl.countryCode = country.iso2.toLowerCase();
            $ctrl.dialCode = country.dialCode;
        }
    }

    function onOtherKeyDownEvent(e) {
        //console.log('on key down');
        setNumber();
    }

    function setValue(next) {
        $ctrl.value = isEmpty() ? null : getn();
        next();
    }

    function getNumber(n) {
        var fullValue = n ? n : getn();
        return IntlTelInputService.formatAsYouType(fullValue.replace('+' + $ctrl.dialCode, ''), $ctrl.countryCode);
    }

    function getn(){
        return $ctrl.iti.getNumber($ctrl.format.E164);
    }

    function setNumber(val) {
        $ctrl.iti.setNumber(getNumber(val), $ctrl.format.NATIONAL);//doesnt update the interface if the number is not full or in national format
    }

    function handleWhatsSupposedToBeAnArray(value) {
        if (value instanceof Array) {
            return value;
        } else {
            return value.toString().replace(/[ ]/g, '').split(',');
        }
    }
}

