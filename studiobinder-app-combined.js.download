    controller: 'ExportScriptCtrl'
})
.controller('ExportScriptCtrl',ExportScriptCtrl);

ExportScriptCtrl.$inject = ['ResourcePathsService','FileUploaderInitCtrlService', 'PreLoadingProv', 'CompInitCtrlService'];

function ExportScriptCtrl(ResourcePathsService, FileUploaderInitCtrlService, PreLoadingProv, CompInitCtrlService) {

    var $ctrl = this;

    $ctrl = new CompInitCtrlService($ctrl);
    var fontsPath = $ctrl.LCS.staticUrl + 'fonts/',
        timestamp = $ctrl.LCS.timestamp,
        css = " ",
        extension = 'sbx',
        fileType = 'text/plain';

    $ctrl.fileType = [fileType];
    $ctrl.keepPopup = true;

    $ctrl.multipleFiles = false;
    $ctrl.sizeError = null;
    $ctrl.localUpload = true;
    $ctrl.url = ResourcePathsService.getScriptsPath() + "/export";
    $ctrl.customEasyChartSize = 64;
    $ctrl.filename = 'Script_' + new Date().getTime();

    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.html = "<div>" + css + "<div>" + $('body').find($ctrl.scriptContainer).html().replace(/<!--(?!\s*(?:\[if [^\]]+]|<!|>))(?:(?!-->)(.|\n))*-->/g, '') + "</div></div>";

        $ctrl.scriptLoadingService = PreLoadingProv.getScriptPreloader($ctrl.params);
        $ctrl.scriptLoadingService.preloadTables($ctrl.additionalInit);

        $ctrl = new FileUploaderInitCtrlService($ctrl);

        $ctrl.focusIndex = -1;
        $ctrl.formHolderItem = {};
        $ctrl.setFocus = setFocus;
        $ctrl.isSetFocus = isSetFocus;
        $ctrl.onFileUploadError = onFileUploadError;
        $ctrl.onFileUploadSuccess = onFileUploadSuccess;
        $ctrl.updateErrorUploading = updateErrorUploading;
        $ctrl.export = exportF;
        $ctrl.info.showDrop = true;
    }

    function setFocus(index) {
        $ctrl.focusIndex = index;
    }

    function isSetFocus(index) {
        return $ctrl.focusIndex === index;
    }

    function onFileUploadError(id) {
        $ctrl.isUploading = false;
        var el = $ctrl.uploadObjService.get(id);
        var error = el ? el.error : null;
        if (error) {
            $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.script.export-script.generating');
        }
    }

    function onFileUploadSuccess(result) {
        $ctrl.isUploading = false;
        if (result) {
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.script.export-script.generating', 'success');
            $ctrl.broadcastRoot('REMOVE_SCRIPT_EXPORTER', result);
        }
        $ctrl.setShowDrop(false);
    }

    function updateErrorUploading(error, file) {
        $ctrl.isUploading = false;
        console.log(error);
        //  $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.script.export-script.generating');
    }

    function exportF() {
        if (!$ctrl.isUploading) {
            $ctrl.formHolderItem.formItem_attempted = true;
            if ($ctrl.formHolderItem.formItem && $ctrl.formHolderItem.formItem.$valid) {
                $ctrl.isUploading = true;
                /* var filename = $ctrl.filename + '.' + extension;
                 var $file = createFileFromContent($ctrl.html, filename);
                  $ctrl.onOneFileSelected($file, false, _.extend({}, $ctrl.params, {
                     filename: filename
                 }));*/
            }
        }
    }

    function createFileFromContent(html, filename) {
        var charset = "UTF-8";
        var file = getFile(html);
        startAutoDownload(file);

        return file;

        function getFile(html) {
            var fileContent = createHtml(html);
            return new Blob([new XMLSerializer().serializeToString(fileContent)], {type: fileType + "; charset=" + charset});
        }

        // Title guesser and document creator available at https://gist.github.com/1059648
        function guessTitle(doc) {
            var h = "h6 h5 h4 h3 h2 h1".split(" "),
                i = h.length,
                headers,
                header_text
            ;
            while (i--) {
                headers = doc.getElementsByTagName(h[i]);
                for (var j = 0, len = headers.length; j < len; j++) {
                    header_text = headers[j].textContent.trim();
                    if (header_text) {
                        return header_text;
                    }
                }
            }
        }

        function createHtml(html) {
            var doc_impl = document.implementation,
                dt = doc_impl.createDocumentType('html', null, null),
                doc = doc_impl.createDocument("http://www.w3.org/1999/xhtml", "html", dt),
                doc_el = doc.documentElement,
                head = doc_el.appendChild(doc.createElement("head")),
                charset_meta = head.appendChild(doc.createElement("meta")),
                title = head.appendChild(doc.createElement("title")),
                body = doc_el.appendChild(doc.createElement("body"));
            if (html.ownerDocument) {
                charset = html.ownerDocument.characterSet;
            }

            charset_meta.setAttribute("charset", charset);

            if (typeof html === "string") {
                body.innerHTML = html;
            } else {
                body.appendChild(doc.importNode(html, true));
            }

            var title_text = guessTitle(doc);
            if (title_text) {
                title.appendChild(doc.createTextNode(title_text));
            }

            return doc;
        }

        function startAutoDownload(file) {
            var fileURL = URL.createObjectURL(file);
            var a = document.createElement('a');
            a.href = fileURL;
            a.target = '_blank';
            a.download = filename;
            a.style = "z-index:-1000;width:0;height:0";
            document.body.appendChild(a);
            a.click();
            /* $ctrl.LCS.timeout(function () {
                 window.URL.revokeObjectURL(fileURL);
                 document.body.removeChild(a);
             },20);
         */
        }
    }
}

angular.module('product.script.versionsButton.component', [
    'apiServices.DocumentVersions',
    'apiServices.Scripts',
    'services.pollingService'
])
.component('scriptVersionsButton', {
    bindings: {
        isLi: '@?'
    },
    controller: 'ScriptVersionsButtonCtrl'
})
.controller('ScriptVersionsButtonCtrl', ScriptVersionsButtonCtrl);
ScriptVersionsButtonCtrl.$inject = ['TemplateCompileCompCtrlService', 'DocumentVersionsService', 'ScriptsService', 'PollingService', '$element'];
function ScriptVersionsButtonCtrl(TemplateCompileCompCtrlService, DocumentVersionsService, service, PollingService, $element) {
    // $ctrl.scriptId = $ctrl.script ? $ctrl.script._id:null;
    var $ctrl = this,
        withoutTemplateScope = true,

    dontPoll = true;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl.dontAutoloadTemplate = true;
    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        $ctrl.service = service;
        $ctrl.btnClass = 'btnVersions';
        $ctrl.currentInfo = {};
        onStateChanged();
    }

    function postInit() {
        $ctrl.addOnStateChange(onStateChanged);
        $ctrl.CurrentProduct.onProductChanged($ctrl.watchers, function (result) {
            if(result && result.changes && result.changes === 'SCRIPT_CHANGES'){
                $ctrl.script = result.item.script;
                $ctrl.reloadTemplate();
            }else {
                onStateChanged();
            }
        });
    }

    function onDestroy() {
        bind(false);
        stopPolling();
    }

    function onLoaded() {
        bind(true);
    }

    function canedit(){
        return $ctrl.CPS.canEdit && $ctrl.CPS.isAuthenticated;
    }

    function getItemTemplate() {
        if (!$ctrl.currentInfo.scriptId || !$ctrl.currentInfo.showVersions) {
            return '';
        }
        var el = '',
            title = 'Version Manager';
        var canEdit = canedit();
        if ($ctrl.isLi) {
            if (canEdit) {
                el += '<li><a class="' + $ctrl.btnClass + '" analytics-on analytics-action="' + title + '">' +
                    '<span class="versions sbf"></div> <div>' + title + '</div></a>' +
                    '</li>';
            }
        } else {
            var tag = canEdit ? 'a' : 'span';
            el += '<' + tag + ' class="' + $ctrl.btnClass +
                    (canEdit ? '' : ' without-hover') +
                    ' btn btn-small primary-faded without-text mark-version"' +
                    (canEdit ? (' analytics-on analytics-action="' + title + '" ') : '') +
                    getColorStyleStr($ctrl.script) + '>'  +
                    '<span tooltip="' + $ctrl.script.name + '" tooltip-placement="bottom" class="with-padding-left">v ' + $ctrl.script.version + '</span> ' +
                    (canEdit ? '<div class="sbf pull-right arrow-filled-down hide-print" ' + getColorStyleStr($ctrl.script, true) + '></div>' : '') +
                '</span>' +
                 '</' + tag + '>' ;
        }
        return el;
    }

    function getColorStyleStr(item, withoutBorder) {
        var s = DocumentVersionsService.getColorStyleStr(item, withoutBorder);
        return s ? ('style="' + s + '"') : '';
    }

    function bind(isBind) {
        if(canedit()) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('.' + $ctrl.btnClass), openVersions);
        }
    }

    function onStateChanged(state) {
        console.log('scriptVersionDirective: reload');
        if (!state) {
            state = $ctrl.SBStateService.getCurrentState();
        }
        var data = state.data;
        $ctrl.showVersions = data && data.showVersions;
        var product = $ctrl.CurrentProduct.getProduct();

        stopPolling(product);

        if (!product) {
            $ctrl.script = null;
            $ctrl.scriptId = null;
            $ctrl.isNotDefault = false;
            $ctrl.productId = null;
            return;
        } else {
            $ctrl.productId = product._id;
            if (product.previewScript) {
                $ctrl.script = product.previewScript;
                $ctrl.isNotDefault = true;
            } else {
                $ctrl.script = product.script;
            }
            $ctrl.scriptId = $ctrl.script ? $ctrl.script._id : null;
        }

        if ($ctrl.currentInfo.scriptId === $ctrl.scriptId && $ctrl.currentInfo.showVersions === $ctrl.showVersions) {
            return;
        }

        $ctrl.currentInfo = {
            scriptId: $ctrl.scriptId,
            showVersions: $ctrl.showVersions
        };

        polling();

        bind(false);//remove bindings
        $ctrl.reloadTemplate();
    }

    function stopPolling(product){
        if($ctrl.polling && $ctrl.productId && (!product || product && product._id!==$ctrl.productId)){
            $ctrl.polling.stop();
            $ctrl.polling = null;
        }
    }

    function polling() {
        if ($ctrl.productId) {
            $ctrl.CurrentProduct.getCurrentScript($ctrl.productId, onSuccess, onError);
        }

        function onSuccess(script) {
            if(dontPoll === true) {
                return;
            }
            if (script._id && script._id === $ctrl.scriptId) { //same version dont display popup but start polling
                start();
            } else {
                onDiffVersion(script);
            }
        }

        function onError(err) {
            if(dontPoll === true) {
                return;
            }
            console.log(err);
            start();
        }

        function start() {
            $ctrl.polling = new PollingService({
                interval: 5,
                timeout: 60 * 5 //5 mins
            });
            $ctrl.polling.poll('/poll-current-script/' + $ctrl.productId, {
                productId: $ctrl.productId,
                companyId: $ctrl.CPS.companyId
            }, onDiffVersion);
        }


        function onDiffVersion(script) {
            console.log('onPolling');
            if(!$ctrl.refreshOpened){
                $ctrl.refreshOpened = true;
                $ctrl.popupsService.open(null, $ctrl.popupsService.operations.scriptVersionRefresh, {
                    script: script
                }, false, function (result){
                    console.log('onclose');
                    $ctrl.refreshOpened = false;
                });
            }
        }
    }

    function openVersions(e) {
        //todo : $ctrl.compOptions is null here what should be?
        $ctrl.preventDefault(e);
        $ctrl.CPS.loadQuotaPopup('requestTeamAccess', function () {
            $ctrl.CPS.loadQuotaPopup('stripboard', function () {
                if ($ctrl.scriptId) {
                    $ctrl.popupsService.open($ctrl.scriptId, $ctrl.popupsService.operations.scriptVersions, null, $ctrl.compOptions);
                }
            }, null, null, $ctrl.compOptions);
        });
    }

    function getColorStyle() {
        var style = $ctrl.script && $ctrl.script.color ? $ctrl.service.getColorStyle($ctrl.script) : null;
        return style ? ('" style="' + style) : 'blue';
    }
}

angular.module('product.script.import.component', [
    'product.script.import.controller',
    'product.script.versionEdit.popup.component',
    //'product.script.script-warning.popup'
])
.component('importScript', {
    bindings: {
        liClass:'@',
        pageClass:'@',
        btnText:'@',
        btnClass: '@',
        showTextOnIpad: '@',
        showTitle: '<?',
        script: '<?',//either product script or screenwriting file
        isJustScript: '<?'
    },
    controller: 'ImportScriptComponentCtrl', 
}) 
.controller('ImportScriptComponentCtrl', ImportScriptComponentCtrl);
ImportScriptComponentCtrl.$inject = ['ImportScriptComponentCtrlService', 'CompInitCtrlService', 'TemplateCompileService', '$element', '$attrs'];
function ImportScriptComponentCtrl(ImportScriptComponentCtrlService, CompInitCtrlService, TemplateCompileService, $element, $attrs) {

    console.log('importScriptDirective');

    var $ctrl = this;

    $ctrl.$onDestroy = $onDestroy;
    $ctrl = new CompInitCtrlService($ctrl);

    $ctrl.$element = $element;
    $ctrl.element = $ctrl.$element[0];

    $ctrl.$onInit = $onInit;

    function $onInit(){
        if(!$ctrl.btnText){
            $ctrl.btnText = 'Import Script';
        }
        $ctrl.isLi = $attrs.isLi && ($attrs.isLi === 'true'||$attrs.isLi === true);
        $ctrl.info = {showPopup: false};

        $ctrl = new ImportScriptComponentCtrlService($ctrl);

        $ctrl.templateCompile = new TemplateCompileService($ctrl.$element, getItemTemplate, $ctrl);
        $ctrl.templateCompile.loadTemplate(onLoaded);
    }

    function $onDestroy() {
        unbind();
        if($ctrl.templateCompile){
            $ctrl.templateCompile.destroyNewScope();
        }
    }

    function getItemTemplate() {
        if($ctrl.isLi){
        return '<li' + ($ctrl.liClass ? (' class="' + $ctrl.liClass + '"') : '') + '>' +
                    '<a id="'+$ctrl.elImportId+'" analytics-on analytics-action="'+$ctrl.btnText+'" class="fixed-layout table-div full-width"><div class="col30">'+$ctrl.LCS.getISBDiv('upload-2', 3)+'</div> <div>'+$ctrl.btnText+'</div></a>' +
                '</li>';
        }else{
        return '<div class="display-inline one-line-tooltip">' +
                    '<a id="'+$ctrl.elImportId+'" analytics-on analytics-action="'+$ctrl.btnText+'" class="'+($ctrl.btnClass?$ctrl.btnClass:'')+'" tooltip="'+($ctrl.showTitle?'':$ctrl.btnText)+'" tooltip-placement="bottom">'+$ctrl.LCS.getISBDiv('upload-2', 3, 'pull-left')+' ' +
                        ($ctrl.showTitle? ('<span'+($ctrl.showTextOnIpad?'':' class="hide-ipad with-padding-left"')+'>'+$ctrl.btnText+'</span>'):'')+
                    '</a>' +
               '</div>';
        }
    }

    function onLoaded() {
        unbind();
        $ctrl.bindImport(true);
        $ctrl.addRootWatcher('IMPORT_SCRIPT_FROM_BTN' + ($attrs.info ? ('_' + $attrs.info) : ''), $ctrl.importFromScript);
    }

    function unbind(){
        $ctrl.onDestroyImport();
        $ctrl.bindImport(false);
        $ctrl.removeWatchers();
    }
}

angular.module('product.script.import.controller.service', [
])
.service('ImportScriptCtrlService', ImportScriptCtrlService);
ImportScriptCtrlService.$inject = [];
function ImportScriptCtrlService() {

    return function ($ctrl) {
        console.log('ImportScriptCtrlService');

        if(!$ctrl.compLoaded){
            console.warn('Parent for ImportScriptCtrlService must inherit CompInitCtrlService');
        }

        if(!$ctrl.removeUploader){
            console.warn('Parent for ImportScriptCtrlService must define method $ctrl.removeUploader');
        }

        if(!$ctrl.onNewScriptEdit) {
            $ctrl.onNewScriptEdit = onNewScriptEdit;
        }

        $ctrl.onDropClose = onDropClose;
        $ctrl.initImportScript = initImportScript;

        $ctrl.initImportScript();

        return $ctrl;


        function onNewScriptEdit(result) {
            console.log('NEW_SCRIPT_TO_EDIT');
            var document = result ? result.document : null;


            //double check if this is still needed
            /*if(result && result.script && result.script.documentVersionId){
                $ctrl.script.documentVersionId = result.script.documentVersionId;
                $ctrl.product.script = $ctrl.script;
                $ctrl.CurrentProduct.updateScriptDocumentVersionId($ctrl.script);
            }*/

            if (document) {
                $ctrl.popupsService.open(null, $ctrl.popupsService.operations.scriptCompare, _.extend({
                    script: $ctrl.script,
                }, result)
                    /*document: document,
                    syncChanges: result.syncChanges,
                    sceneChanged: result.sceneChanged,
                    customTagsKey: result.customTagsKey,
                    notes: result.notes,
                    summary: result.summary*/
                , $ctrl.compOptions);
            }
            // $ctrl.broadcastRoot('NEW_SCRIPT_UPLOADED', result);
        }

        function initImportScript() {
            if (!$ctrl.isJustScript) {
                $ctrl.script = $ctrl.CPS.product ? $ctrl.CPS.product.script : null;
            }
            $ctrl.scriptId = $ctrl.script ? $ctrl.script._id : null;
            $ctrl.isScript = !$ctrl.isJustScript || $ctrl.isJustScript && $ctrl.script && $ctrl.script.type === 2;
        }

        function onDropClose(result) {
            console.log('onDropClose');
            if(!result || result === 'cancel'){
                return close();
            }
            var prop, res = getResult(result);

            if(res) {
                close();
                if ($ctrl.isJustScript) {
                    $ctrl.broadcastRoot(prop, res);
                } else {
                    $ctrl.onNewScriptEdit(res);
                }
            }

            function close() {
                if($ctrl.removeUploader) {
                    $ctrl.removeUploader(result);
                }
            }
            function getResult(result) {
                if(result && result.result){result = result.result;}
                if(!result){return null;}
                prop  = $ctrl.isJustScript ? 'UPLOADED_DOCUMENTVERSION_ITEM' : 'NEW_SCRIPT_TO_EDIT';

                return result[prop] ? result[prop] : null;
            }
        }
    }
}

angular.module('product.script.import.controller', [
    'product.script.import.controller.service',
    //'product.script.script-warning.popup'
])
.service('ImportScriptComponentCtrlService', ImportScriptComponentCtrlService);
ImportScriptComponentCtrlService.$inject = ['ImportScriptCtrlService', 'TemplateCompileService'];
function ImportScriptComponentCtrlService(ImportScriptCtrlService, TemplateCompileService) {
    return function ($ctrl) {
        var tag = 'upload-scriptfile';
        $ctrl.elImportId = 'btnImportScript';
        $ctrl.removeUploader = removeUploader;
        $ctrl.importFromScript = importFromScript;
        $ctrl.onDestroyImport = onDestroyImport;

        $ctrl.dirid = new ObjectId().toString();
        $ctrl.bindImport = bindImport;

        $ctrl = new ImportScriptCtrlService($ctrl);

        $ctrl.templateCompileUploader = new TemplateCompileService(null);
        $ctrl.templateCompileUploader.getItemTemplate = getUploaderItemTemplate;

        return $ctrl;

        function bindImport(isBind) {
            bindEl(isBind, $ctrl.element, $ctrl.elImportId, 'importScript', $ctrl.importFromScript);
        }

        function bindEl(isBind, parent, elName, namespace, method, otherBind) {
            if(isBind){
                $ctrl[elName] = parent.querySelector('#' + elName);
            }
            if($ctrl[elName]) {
                $ctrl.LCS.bindElementsClick(isBind, $ctrl[elName], method, namespace);
                if(otherBind) {
                    $ctrl.LCS.bindElementsClick(isBind, $ctrl[elName], otherBind.event, null, otherBind.eventName);
                }
            }
        }

        function getUploaderItemTemplate() {
            return '<' + tag + ' ' +
                'id="uploadScriptFile" ' +
                'script="::$ctrl.script" ' +
                'is-script="::' + ($ctrl.isScript === true) + '" ' +
                'is-just-script="' + ($ctrl.isJustScript === true) + '" ' +
                'dirid="::$ctrl.dirid" ' +
                'on-drop-close="$ctrl.onDropClose(result)"' +
                ($ctrl.pageClass ? ('page-class="' + $ctrl.pageClass + '" ') : '') +
                '></' + tag + '>';
        }

        function showImport(e) {
            $ctrl.preventDefault(e);
            $ctrl.initImportScript();

            $ctrl.templateCompileUploader.loadTemplate(function (clonedElement) {
                console.log('uploader loaded');
            }, {
                script: $ctrl.script,
                dirid: $ctrl.dirid,
                onDropClose: $ctrl.onDropClose
            }, angular.element($ctrl.LCS.bodyElement));
        }

        function removeUploader(result) {
            if ($ctrl.templateCompileUploader) {
                $ctrl.templateCompileUploader.destroyNewScope();
            }
        }

        function onDestroyImport() {
            $ctrl.removeUploader();
        }

        function importFromScript(e) {
            console.log('importFromScript');
            $ctrl.preventDefault(e);
            $ctrl.isJustScript ? process() : $ctrl.popupsService.teamAccess(process);

            function process() {
                if (!$ctrl.isScript || $ctrl.hideWarning) {
                    showImport();
                } else {
                    var props = {
                        btn: 'Continue',
                        icon: 'info-unfilled',
                        title: 'Before you import…',
                        pageClass: $ctrl.pageClass,
                        message: '<p class="text-center font-size-14 line-height-2">Make sure you’ve <span class="semibold">generated scenes numbers</span> using your scriptwriting software. Otherwise, scenes will not sync properly when you re-import future revisions.</p>',
                        // scriptNote: 'Scene <b>' + $ctrl.item.sceneText + '  •  ' + $ctrl.item.miniTitle + '</b> has been updated',
                    };

                    $ctrl.popupsService.openConfirmPopup({
                        dontShowAgainProp: 'showUseSceneNumbers',
                        next: showImport,
                        props: props
                    });
                }
            }
        }
    }
}

angular.module('product.script.saveContentToScriptAndSync.controller.service', [
    'product.script.upload.controller.service',
    'product.script.import.controller.service',
    'services.blocksSetup'
])
    /*
        script: '<?',
        isScript: '<?',
        isJustScript: '<?',
        dirid: '<',
        onDropClose: '&'
        */
.service('SaveContentToScriptAndSyncCtrlService', SaveContentToScriptAndSyncCtrlService);

SaveContentToScriptAndSyncCtrlService.$inject = ['StripsService', 'TaggingScenesService', 'BlocksSetupService','ImportScriptCtrlService','UploadScriptfileCtrlService', 'DownloadExportService', 'DocumentsService', 'ScriptsService'];
function SaveContentToScriptAndSyncCtrlService(StripsService, TaggingScenesService, BlocksSetupService,ImportScriptCtrlService, UploadScriptfileCtrlService, DownloadExportService, DocumentsService, ScriptsService) {
    return function ($ctrl, script, other) {
        if ($ctrl.saveContentToScriptLoaded) {
            return $ctrl;
        }
        $ctrl.BlocksSetupService = BlocksSetupService;
        //if(!$ctrl.compLoaded){$ctrl = new CompInitCtrlService($ctrl);}
        $ctrl.DownloadExportService = DownloadExportService;
        $ctrl.DocumentsService = DocumentsService;
        $ctrl.ScriptsService = ScriptsService;

        if (!script) {
            console.warn('Parent for SaveContentToScriptAndSyncCtrlService must define field $ctrl.script');
        }else{
            $ctrl.script = script;
            $ctrl.scriptId = script._id;
        }

        $ctrl.isScript = true;
        $ctrl.isJustScript = false;

        $ctrl.generateNewScript = generateNewScript;
        $ctrl.removeUploader = removeUploader;

        $ctrl.itemWithUpdatedSceneContent = StripsService.itemWithUpdatedSceneContent;
        $ctrl = new ImportScriptCtrlService($ctrl);
        $ctrl = new UploadScriptfileCtrlService($ctrl);

        $ctrl.saveContentToScriptLoaded = true;
        $ctrl.saveScene = saveScene;

        $ctrl.confirmPopup = confirmPopup;
        $ctrl.getOtherData = getOtherData;
        $ctrl.reloadPage = reloadPage;
        $ctrl.onSave1 = onSave1;

        if(other) {
            $ctrl = _.extend($ctrl, other);
        }

        return $ctrl;

        function getOtherData(data){
            return _.extend({
                updateScreenplay: $ctrl.item.updateScreenplay,
                updateSceneContent: $ctrl.updateSceneContent,
                isNewStrip: $ctrl.isNewStrip,
                syncChanges: true,
                syncToProject: false,
                //getmax currentid for el
                currentId: TaggingScenesService.getNewCurrentId($ctrl.Settings.elements)
            }, $ctrl.scriptId ? {scriptId: $ctrl.scriptId} : null, data);
        }


        function onSave1(result) {
            console.log('onsave');
            if(result.noUpdates){
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.gridItem.success.nochanges');
                $ctrl.closePopup();
            } else if($ctrl.withPageReload && $ctrl.updateSceneContent) {
                    $ctrl.closePopup();
                    $ctrl.reloadPage();
            }else{
                $ctrl.onListItemSave(result, $ctrl.listItemUpdates ? $ctrl.listItemUpdates : null, result.withoutClosePopup ? true : false);
                $ctrl.closePopup();
            }
        }

        function confirmPopup(e) {
            $ctrl.preventDefault(e);
            $ctrl.isUpdating = true;
            var updateScreenplay = true,
                cls = 'select-row item md-radio-button ' + $ctrl.pageClass,
                methodOnCheck = 'onCheck',
                noScript = $ctrl.script.version === 0,
                action = noScript ? 'create' : 'update',
                caction = capitalizeFirst(action),
                params = {
                    btn: $ctrl.btnText,
                    icon: 'info',
                    iconLevel: 3,
                    title: caction + ' Screenplay',
                    message: '<p class="text-center medium-size">Do you want to ' +
       (noScript  ? ('add this scene to a new screenplay') : ( ($ctrl.isNewStrip ? 'add ' : 'update the content of ') + ' this scene on the screenplay?')) +
                        '</p>' +
                        '<div class="max-width-300 centered margin-top-half medium-size">' +
                            '<div class="margin-bottom-quarter ' + cls + (updateScreenplay ? ' md-checked' : '') + '" data-id="true" ng-click="$ctrl.extraParam.'+methodOnCheck+'($event, $ctrl)"><div class="md-container md-ink-ripple "><div class="md-off"></div><div class="md-on"></div><div class="md-ripple-container"></div></div><div class="md-label namex">' + caction + ' screenplay</div></div>' +
                            '<div class="' + cls + (updateScreenplay ? '' : ' md-checked') + '" data-id="false" ng-click="$ctrl.extraParam.'+methodOnCheck+'($event, $ctrl)"><div class="md-container md-ink-ripple"><div class="md-off"></div><div class="md-on"></div><div class="md-ripple-container"></div></div><div class="md-label namex">Don\'t ' + action + ' screenplay</div></div>' +
                        '</div>'
                    //+ '<div class="form-group field last margin-top-half"><div class="form-control with-underline autogrow contenteditable" placeholder="Scene note…" contenteditable="true" contenteditable-html strip-br="true" tabindex="3" ng-model="$ctrl.extraParam.scriptNote" id="name"></div></div>'
                    ,
                    // scriptNote: 'Scene <b>' + $ctrl.item.sceneText + '  •  ' + $ctrl.item.miniTitle + '</b> has been updated',


                    updateScreenplay: updateScreenplay,
                    onConfirm: onConfirm,
                };

            params[methodOnCheck] = onCheck;

            $ctrl.popupsService.open(null, $ctrl.popupsService.operations.treeKeyboardActions, params, $ctrl.compOptions);

            function capitalizeFirst(str) {
                return str.charAt(0).toUpperCase() + str.slice(1).toLowerCase();
            }
            function onCheck(e, $ctrl) {
                $ctrl.preventDefault(e);
                var el = e.currentTarget,
                    update = el.getAttribute('data-id') === 'true';

                $ctrl.LCS[update ? 'addClass' : 'removeClass']($ctrl.element.querySelector(".md-radio-button[data-id='true']"), 'md-checked');
                $ctrl.LCS[update ? 'removeClass' : 'addClass']($ctrl.element.querySelector(".md-radio-button[data-id='false']"), 'md-checked');

                $ctrl.extraParam.updateScreenplay = update;
            }

            function onConfirm(param, extraParam) {
                $ctrl.item.updateScreenplay = extraParam.updateScreenplay;
                $ctrl.onConfirm();
            }
        }

        function saveScene(dontCheckIsUpdating) {
            console.log('saveScene');
            var updates = $ctrl.getDataToUpdate();
            if (!updates) {
                $ctrl.isUpdating = false;
                return $ctrl.closePopup();
            }

            updates.contentChanged = true;
            return $ctrl.save(dontCheckIsUpdating);
        }

        function reloadPage(){
            $ctrl.LCS.timeout(function () {
                //doesnt trigger the update for shotLists and storyboards Lists -> based on script
                var hardReload = true;
                $ctrl.CPS.reloadCurrentState(hardReload);
                $ctrl.isUpdating = false;
            }, 200);
        }

        function removeUploader(result) {
            console.log('removeUploader');
            $ctrl.isUpdating = false;
            $ctrl.closePopup();
        }

        function onNewScriptEdit(result) {
            var document = result && result.document? $ctrl.DocumentsService.convertResource(result.document) : null,
                versionId = document && document.version ? document.version._id : null;
            if (versionId) {
                if (!$ctrl.isUpdating) {
                    $ctrl.isUpdating = true;
                    $ctrl.error = false;
                    //previous script can be not in a doc

                    $ctrl.security.sendGeneratorRequest($ctrl.ScriptsService.getCompareAndUpdateScriptPath(), _.extend({
                        notes: $ctrl.scriptNote,
                        customTagsKey: $ctrl.customTagsKey
                    }, getDefaultParams()), function (result) {
                        // $ctrl.broadcastRoot('NEW_SCRIPT_UPLOADED', result);
                    }, onError);
                }
            }else{
                onError();
            }

            function onError(error) {
                $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.script.saveScene.error');
                $ctrl.isUpdating = false;
            }

            function getDefaultParams() {
                return {
                    companyId: $ctrl.CPS.companyId,
                    productId: $ctrl.CPS.productId,
                    scriptId: $ctrl.scriptId,
                    //syncToProject: $ctrl.syncToProject,
                    syncChanges: true,
                    newDocumentVersionId: versionId
                };
            }
        }

        function generateNewScript(name, content) {
            $ctrl.uploadContent($ctrl.DownloadExportService.getSbxFileFromContent(name, content));
        }
    }
}

angular.module('product.script.upload.component', [
    'product.script.upload.controller.service',
    'product.script.compare.component',
    'apiServices.Scripts',
    'product.material.fileStats.service'
])
.component('uploadScriptfile', {
    bindings: {
        script: '<?',
        isScript: '<?',
        isJustScript: '<?',
        dirid: '<',
        pageClass:'@',
        onDropClose: '&'
    },
    controller: 'UploadScriptfileCtrl'
}) 
.controller('UploadScriptfileCtrl',UploadScriptfileCtrl);

UploadScriptfileCtrl.$inject = ['TemplateCompileCompCtrlService', 'FileStatsService', 'UploadScriptfileCtrlService', 'ScriptsService', '$element'];
function UploadScriptfileCtrl(TemplateCompileCompCtrlService, FileStatsService, UploadScriptfileCtrlService, ScriptsService, $element) {
    var $ctrl = this;
    $ctrl.ScriptsService = ScriptsService;
    $ctrl.wrapperElementClass = 'uploader-wrapper';

    $ctrl.setShowDrop = setShowDrop;

    $ctrl.close = close;
    $ctrl.preInit = preInit;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.itemTitle = $ctrl.isScript ? 'Script' : 'Note';
        $ctrl.onFilesSelected = onFilesSelected;
        $ctrl = new UploadScriptfileCtrlService($ctrl);

        $ctrl.info = {showDrop: true};
    }

    function onDestroy() {
        removeUploader();
    }

    function onFilesSelected($files, uploadParams) {
       /* if ($ctrl.isScript && !$ctrl.isJustScript) {
            return onsuccess();
        }*/

        console.log('scriptVersionEditPopup');
        $ctrl.setShowDrop(false);

        $ctrl.setScriptVersionInfo = $ctrl.isScript;// && !$ctrl.isJustScript;
        //for script import show the name info popup after the comparison screen
        if($ctrl.setScriptVersionInfo) {
            var name = $files && $files.length > 0 ? $files[0].name : null,
            ext = name ? FileStatsService.getExtension(name) : null;
            $ctrl.popupsService.open($ctrl.ScriptsService.getUpdatedInfo({
                version: ($ctrl.script.version || 0) + 1,
                subversion: 0,
                color: $ctrl.ScriptsService.getNextColor($ctrl.script.color),
                name: name && ext ? name.replace('.' + ext, '', 'i') : name,
                importedFileName: name
            }), $ctrl.popupsService.operations.scriptVersionEdit, {
                elemType: $ctrl.elemType,
                itemTitle: $ctrl.itemTitle,
                modalTitle: 'Screenplay Name',
                btnText: 'Next',
                icon: 'screenplays',
                iconLevel: 2
            }, null, null, onSuccessPopup);
        }else {
            onSuccessPopup();
        }

        function onSuccessPopup(result) {
            console.log('result for onFilesSelected');
            $ctrl.setShowDrop(true);
            onsuccess(result ? result.item : null);
        }

        function onsuccess(item) {
            console.log('$ctrl.onFilesSelectedInit');
            if(item){
                var props = ['name', 'color', 'notes', 'summary', 'version', 'importedFileName'];
                for(var i = 0 ; i < props.length; i ++){
                    var f = props[i],
                        p = item[f];
                    if(p){
                        uploadParams[f] = p;
                    }
                }

                if(uploadParams.notes) {
                    uploadParams.notes = uploadParams.notes.replace('IMPORTED_FILE_NAME', item.importedFileName);
                }
            }
            //if uploading a previos file created an error remove the file to ensure that the 'wait' message is not displayed twice
            var del = [];
            for(var id in $ctrl.uploadObjService.uploads){
               if( $ctrl.uploadObjService.uploads[id].error){
                   del.push(id);
               }
            }
            _.each(del, function (id) {
                delete $ctrl.uploadObjService.uploads[id];
            });

            $ctrl.onFilesSelectedInit($files, uploadParams);
        }
    }

    function setShowDrop(val) {
        if ($ctrl.info.showDrop !== val) {
            $ctrl.info.showDrop = val;
            if (!$ctrl.wrapperElement) {
                $ctrl.wrapperElement = $ctrl.element.querySelector('.' + $ctrl.wrapperElementClass);
            }
            $ctrl.LCS[$ctrl.info.showDrop ? 'removeClass' : 'addClass']($ctrl.wrapperElement, 'sb-hide');
        }
    }

    function getItemTemplate() {
return '<div class="script-uploader-wrapper '+$ctrl.wrapperElementClass+' ' + ($ctrl.info.showDrop?'':'sb-hide')+'">' +
            '<div>' +
                '<div '+get('drop')+' ngf-drag-over-class="{accept:\'dragover\', reject:\'dragover-err\', \'delay\':100}" class="drop-box table-div">' +
                   '<div class="centered">' +
                        '<import-preloader class="centered import-preloader text-center display-block clearfix"></import-preloader>' +
                        getImportBlock() +
                        getProcessingBlock() +
                        $ctrl.LCS.getErrorBlock('col400 centered') +
                        '<div class="spacing-half-top">' +
                            '<a class="' + $ctrl.getBtnActionCls() + ' btn gray cancel btnClose" data-type="close">Cancel</a>'+
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</div>';

        function get(t) {
            return 'ngf-'+t+'="$ctrl.onFilesSelected($files, $ctrl.getUploadParams())" multiple="'+$ctrl.multipleFiles+'" ngf-multiple="'+$ctrl.multipleFiles+'"';
        }

        function getSyncBlock(){
    return !$ctrl.isJustScript ?
                ('<div class="paymentButtons centering uppercase margin-top-30">' +
                    '<div ng-class="{\'active\': !$ctrl.maintain.syncChanges}">'+$ctrl.maintainText1+'</div>' +
                    '<div class="custom-checkbox pull-left '+($ctrl.pageClass||'')+'"><label class="i-switch radiobtn"><input type="checkbox" ng-click="$ctrl.maintain.syncChanges = !$ctrl.maintain.syncChanges" ng-checked="$ctrl.maintain.syncChanges"><i></i></label></div>' +
                    '<div ng-class="{\'active\': $ctrl.maintain.syncChanges}">'+$ctrl.maintainText2+'</div>' +
                '</div>') : '';
        }

        function getImportBlock(){
    return '<div ng-if="!$ctrl.isUploading">' +
                '<div class="top-text text-center spacing-half-top">Import '+$ctrl.CPS.capitalizeFirst($ctrl.fileTypeName)+'</div>' +
                '<div class="lower-text white text-center spacing-half-top">Drag & drop '+$ctrl.fileTypeName+' file anywhere, or ' +
                    '<div class="inline-block divBrowse" ngf-capture '+get('select')+'><input id="ngfFile" type="file"></div>' +
                 '.</div>' +
                '<div class="lower-text gray">Supported file types: '+$ctrl.acceptedFormats+'</div>' +
                getSyncBlock() +
            '</div>';
        }

        function getProcessingBlock(){
    return '<div ng-if="$ctrl.isUploading">' +
                '<div class="top-text text-center spacing-half-top">Processing '+$ctrl.CPS.capitalizeFirst($ctrl.fileTypeName)+ '</div>' +
                '<div class="uploading-wrapper centering" >' +
                    '<div ng-repeat="f in $ctrl.uploadObjService.uploads">' +
                        '<div class="lower-text spacing-bottom">Please wait while the '+$ctrl.fileTypeName+' is being uploaded and processed…</div>' +
                        '<div class="lower-text" ng-if="f.progress == 100">Parsing '+$ctrl.fileTypeName+'…</div>' +
                        '<div ng-if="f.progress && f.progress != 100" class="easypiechart" easypiechart options="$ctrl.OptionsUpload" percent="f.progress">' +
                            '<div class="inner-pie" >' +
                                '<!--<div class="big">{{f.progress | number:0}}%</div>-->' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>';
        }
    }

    function onLoaded() {
        console.log('uploadScriptfile loaded');
    }

    function close(e) {
        $ctrl.preventDefault(e);
        console.log('uploadScriptfile close');
        $ctrl.onDropClose({result: 'cancel'} );
    }
    function removeUploader() {
        if($ctrl.templateCompile){
            $ctrl.templateCompile.destroyNewScope();
        }
    }
}

angular.module('product.script.upload.controller.service', [
    'apiServices.paths.service',
    'components.fileUploader.fileUploader.init.controller.service',
    'product.script.compare.component',
    'services.blocksSetup'
])
    /*
        script: '<?',
        isScript: '<?',
        isJustScript: '<?',
        dirid: '<',
        onDropClose: '&'
        */
.service('UploadScriptfileCtrlService',UploadScriptfileCtrlService);

UploadScriptfileCtrlService.$inject = ['FileUploaderInitCtrlService', 'BlocksSetupService', 'ResourcePathsService'];
function UploadScriptfileCtrlService(FileUploaderInitCtrlService, BlocksSetupService, ResourcePathsService) {
    return function ($ctrl) {

        $ctrl.BlocksSetupService = BlocksSetupService;
        if(!$ctrl.compLoaded){
            console.warn('Parent for UploadScriptfileCtrlService must inherit CompInitCtrlService');
        }
        $ctrl.uploadContent = uploadContent;

        init();

        return $ctrl;

        function uploadContent(file) {
            $ctrl.onFilesSelected([file], $ctrl.getUploadParams());
        }

        function init() {
            $ctrl.isUploading = false;

            $ctrl.scriptId = $ctrl.script ? $ctrl.script._id : null;
            $ctrl.fileType = ['text/plain', 'txt', 'pdf', 'doc', 'docx', 'html', 'sbdoc'];

            if ($ctrl.isScript) {
                $ctrl.fileType = $ctrl.fileType.concat(['fdx', 'xml', 'fountain', 'sbx']);
            }

            $ctrl.multipleFiles = false;

            $ctrl.fileTypeName = $ctrl.isScript ? 'screenplay' : 'document';
            $ctrl.acceptedFormats = ( $ctrl.isScript ? ['.fdx', '.sbx', '.pdf', '.txt', '.fountain' ] : ['.txt', '.pdf', '.docx', '.sbdoc']).join('<span class="sep">|</span>');

            $ctrl.txtFileType = $ctrl.fileTypeName + "s (" + $ctrl.acceptedFormats + ")";

            $ctrl.keepPopup = true;
            $ctrl.maintain = {
                syncChanges: $ctrl.isJustScript ? false : true,
                summary:  'import'+'|' + $ctrl.BlocksSetupService.getCurrentTodoPage().text
            };

            $ctrl.maintainText1 = $ctrl.isJustScript ? 'Don’t Show Changes' : ('Overwrite ' + $ctrl.CPS.capitalizeFirst($ctrl.fileTypeName));
            $ctrl.maintainText2 = 'Sync Changes';
            $ctrl.sizeError = null;
            $ctrl.localUpload = true;
            $ctrl.customEasyChartSize = 64;
            $ctrl.url = (!$ctrl.isJustScript ? ResourcePathsService.getScriptsPath() : ResourcePathsService.getDocumentsPath()) + "/upload";
            $ctrl.crud = 'crud.' + ($ctrl.isJustScript ? 'document' : 'script') + 's.import';//isjustscript = is document of type screenplay

            $ctrl = new FileUploaderInitCtrlService($ctrl);

            $ctrl.getUploadParams = getUploadParams;
            $ctrl.onFileUploadError = onFileUploadError;
            $ctrl.onFileUploadSuccess = onFileUploadSuccess;
            $ctrl.updateErrorUploading = updateErrorUploading;
        }

        function getUploadParams() {
            $ctrl.maintain.notes = 'A '+$ctrl.fileTypeName+' file was imported on <span class="semibold">' +$ctrl.BlocksSetupService.getCurrentTodoPage().text + '</span> page' +
                ($ctrl.script ? (': <span class="semibold">' +
                        'IMPORTED_FILE_NAME' +//($ctrl.script.contentVersion ? $ctrl.script.contentVersion.name : $ctrl.script.name)+
                    '</span>') : '');
            return _.extend({
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                scriptId: $ctrl.scriptId,

                isScript: $ctrl.isScript,
                uploadFromGenerator: true
            }, $ctrl.maintain);
        }

        function onFileUploadError(id) {
            $ctrl.isUploading = false;
            var el = $ctrl.uploadObjService.get(id);
            var error = el ? el.error : null;
            $ctrl.error = error ? $ctrl.localizedMessages.getFromError(error, $ctrl.crud + '.generating.error') : null;
        }

        function onFileUploadSuccess(result) {
            console.log('onFileUploadSuccess');

            if (result && result.result) {
                result = result.result;
            }
            $ctrl.isUploading = false;
            $ctrl.error = null;
            var el = {};
            if (result) {
                el[$ctrl.isJustScript ? 'UPLOADED_DOCUMENTVERSION_ITEM' : 'NEW_SCRIPT_TO_EDIT'] = _.extend($ctrl.maintain, result);
            }
            $ctrl.onDropClose({result: el});
        }

        function updateErrorUploading(error, file) {
            $ctrl.isUploading = false;
            console.log(error);
            $ctrl.error = error === 'Invalid format file type' ? ('Invalid format' + (file ? (' for the uploaded file ' + (file.name.length > 40 ? (file.name.substring(0, 40) + '…') : file.name)) : '') + '. Please upload only ' + $ctrl.fileTypeName + ' of type<br><b> ' + $ctrl.acceptedFormats + '</b>.</a>') : '';
        }
    }
}

