angular.module('product.callsheet.recipients.page.controller.service', [
    'apiServices.CallsheetInvitations',
    'product.contacts.page.init.controller.service',
    'product.callsheet.recipients.popups',
    'product.callsheet.init.actions.controller.service'
])
.service('CallsheetRecipientsPageCtrlService', CallsheetRecipientsPageCtrlService);
CallsheetRecipientsPageCtrlService.$inject = ['ContactsPageCtrlServiceInit', 'CallsheetInvitationsService', 'CallsheetInitActionsCtrlService'];
function CallsheetRecipientsPageCtrlService(ContactsPageCtrlServiceInit, service, CallsheetInitActionsCtrlService) {
//preloading for cast must share contacts in same table
    return function ($ctrl, $element, constantsService) {
        $ctrl.onPageInitOther = onPageInitOther;
        $ctrl.getRightButtons = getRightButtons;
        $ctrl.getGroupBodyAddonOther = getGroupBodyAddonOther;
        $ctrl.getParamsOther = getParamsOther;
        $ctrl.getEmptyStateButtons = getEmptyStateButtons;
        $ctrl.onSendCallsheetRecipients = onSendCallsheetRecipients;
        $ctrl.onAddCallsheetRecipients = onAddCallsheetRecipients;

        if(!$ctrl.checkShowAddNewItem) {
            $ctrl.checkShowAddNewItem = checkShowAddNewItem;
        }

        $ctrl.onPostPageInitOther = onPostPageInitOther;
        $ctrl.preProcessGroupItems = preProcessGroupItems;
        $ctrl.preBroadcastPreloadOther = preBroadcastPreloadOther;

        $ctrl.getGroupFilters = getGroupFilters;
        $ctrl.getGroupOrder = getGroupOrder;
        $ctrl.getBtnActionCls = getBtnActionCls;

        $ctrl.groupFilterActions = [
            {action:'editCalltime', txt:'Edit Call Time', icon:'clock', isAccent:false, actionTooltip:'Edit call time for'},
            {action:'editPrivateMessage', txt:'Edit Private Note', icon:'bnote', isAccent:false, actionTooltip:'Edit private note for'},
            {action:'remove', txt:'Remove Selected', icon:'trash', isAccent:true, actionTooltip:'Remove'}
        ];

        if($ctrl.groupFilterActionsOther) {
            var l = [].concat($ctrl.groupFilterActionsOther);
            if ($ctrl.groupFilterActions) {
                l = l.concat($ctrl.groupFilterActions);
            }
            $ctrl.groupFilterActions = l;
        }

        if($ctrl.groupFilterActions) {
            $ctrl.getGroupFilterButtonsOther = getGroupFilterButtonsOther;
            $ctrl.getGroupFilterButtonsOtherXS = getGroupFilterButtonsOtherXS;
        }

        $ctrl.onPageLoaded = onPageLoaded;

        $ctrl = new CallsheetInitActionsCtrlService($ctrl);
        $ctrl = new ContactsPageCtrlServiceInit($ctrl, $element, {
            constantsService: _.extend({}, constantsService),
            listOptionsService:null,
            service:service
        });

        return $ctrl;

        function getBtnActionCls(){
            return 'btnAction_callsheet_recipients';
        }

        function onPageLoaded(){
            //console.log('onPageLoadedOther');
            $ctrl.bindActions(true);
        }

        function getGroupFilterButtonsOther() {
            return getGroupFilter(false);
        }

        function getGroupFilterButtonsOtherXS() {
            return getGroupFilter(true);
        }

        function getGroupFilter(isXS) {
            var el = '';
            _.each($ctrl.groupFilterActions, function (item) {
                el += get(item.action, item.txt, item.icon, item.isAccent, item.actionTooltip, item.withBtnTxt);
            });
            return el;

            function get(action, txt, icon, isAccent, actionTooltip, withBtnTxt) {
                if (isXS) {
                    return '<li><a ng-class="{disabled: $ctrl.keyboardService.SelectedRows.length===0}" class="table-div full-width  ' + (isAccent ? 'accent ' : '') + $ctrl.getBtnActionCls()+'" data-type="processSelectedCustomBtns" data-info="' + action + '" analytics-on analytics-action="Open ' + txt + '"><div class="col30">' + $ctrl.LCS.getISBDiv(icon) + '</div> <div>' + txt + '</div></a></li>';
                } else {
                    return '<a ng-class="{\'disabled\': $ctrl.keyboardService.SelectedRows.length===0}" class="btn btn-small ' + (isAccent ? 'accent-faded' : 'primary-faded') + ' without-text with-margin-left pull-left '+$ctrl.getBtnActionCls()+'" data-type="processSelectedCustomBtns" data-info="' + action + '" analytics-on analytics-action="Open ' + txt + '" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? (\'Please select at least one item.\') : (\'' + actionTooltip + ' \' + $ctrl.keyboardService.SelectedRows.length + \' selected item\'+($ctrl.keyboardService.SelectedRows.length==1?\'\':\'s\'))}}" tooltip-placement="bottom">' + $ctrl.LCS.getISBDiv(icon, 2, 'pull-left') + (withBtnTxt ? (' <span class="show-desktop with-margin-left">' + txt + '</span>') : '') + '</a>';
                }
            }
        }

        function checkShowAddNewItem() {
            return false;
        }

        function onPageInitOther() {
            $ctrl.listTreeService.preloadingType = $ctrl.PreloadingTypes.Callsheet;
            if ($ctrl.onPageRecipientsInitOther) {
                $ctrl.onPageRecipientsInitOther();
            }
        }

        function onPostPageInitOther() {
            $ctrl.addRootWatcher('RELOAD_ALL_CONTACTS', reloadAll);
        }

        function reloadAll(allContacts) {
            //console.log('RELOAD_ALL_CONTACTS');
            $ctrl.allContacts = allContacts;
        }

        function preBroadcastPreloadOther() {
            $ctrl.listTreeService.level0Name = 'Call Sheet Recipients';
            $ctrl.allContacts = $ctrl.preLoadingService.getObjectList($ctrl.preLoadingService.TblTypes.Contacts);
        }

        function preProcessGroupItems(item, contact) {
            console.log('CallsheetRecipientsPageCtrlService preProcessGroupItems');

            var index = _.findIndex($ctrl.allContacts, function (el) {
                return el._id === item.castId;
            });

            if (index > -1) {
                if (!contact) {
                    contact = $ctrl.allContacts[index];
                } else {
                    $ctrl.allContacts[index] = contact;
                }
            }
            return _.extend({}, item, contact ? {
                name: contact.name,
                email: contact.email,
                phone: contact.phone,
                profilePictureURL: contact.profilePictureURL,
                profilePictureURLId: contact.profilePictureURLId,
            } : null);
        }

        function getParamsOther() {
            return {
                callsheetId: $ctrl.callsheetId
            };
        }

        function getGroupBodyAddonOther() {
            return {
                'callsheet-id': '"::$ctrl.callsheetId"',
                'is-different-user': '"::$ctrl.isDifferentUser"',
                'pre-process-group-items': '"$ctrl.preProcessGroupItems(item)"',
                'add-callsheet-recipients': '"$ctrl.onAddCallsheetRecipients(filterRole)"',
                'send-callsheet-recipients': '"$ctrl.onSendCallsheetRecipients(ids)"'
            };
        }

        function onAddCallsheetRecipients(filterRole) {
            console.log('onAddCallsheetRecipients');
            $ctrl.addCallsheetRecipients({filterRole: filterRole ? filterRole : ($ctrl.listTreeService.active.selectedListId || 'All')});
        }

        function onSendCallsheetRecipients(ids) {
            console.log('onSendCallsheetRecipients');

            console.log('CallsheetPageEditCtrlService.sendCallsheetRecipients');
            ids = ids.map(function (item) {
                return item.id;
            });
            var extraParam = {
                callsheetId: $ctrl.callsheetId,
                preLoadingService: $ctrl.preLoadingService,
                inviteIds: ids
            };//to do -> get the items
            if (!ids || ids.length === 0) {
                console.error('Please select at least one recipient');
                return;
            }

            var item = null;//ids.length === 1 ? $ctrl.list.getElementById(ids[0]) : null;
            $ctrl.popupsService.open(item, $ctrl.popupsService.operations.resendSelectedRecipients, extraParam, $ctrl.compOptions, null, function () {
                $ctrl.clearSelected();
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.callsheet.resendSelectedRecipients.success', 'success');


                window.location = self.location;

               /* var stateName = 'user.product.callsheet.confirmations';
                $ctrl.CPS.transitionTo(stateName, $ctrl.CPS.currentProductPathParams({
                    callsheetId: $ctrl.callsheetId
                })); */
            });
        }

        function getEmptyStateButtons() {
            return '<button class="[ACTION_BUTTON] btn btn-primary ' + ($ctrl.pageClass ? $ctrl.pageClass : '') + '" data-type="onAddItemBtn" analytics-on analytics-action="Add Recipients">' + $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left') + ' <div class="with-margin-left">Add Recipients</div></button>';
        }

        function getRightButtons() {
            if (!$ctrl.canEdit) {
                return '';
            }
            return '<a class="btnActionRecipients '+$ctrl.getBtnActionCls()+' btn btn-small primary-faded without-text with-margin-left" data-type="onAddCallsheetRecipients" analytics-on analytics-action="Open Add Recipients">' +
                $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left') +
                ' <span class="hide-ipad">Add Recipients</span></a>';
        }

        function getGroupFilters() {
            var params = {
                isCallsheetInvitation: true,
                callsheetId: $ctrl.CurrentProduct.getCallsheet()._id,
            };
            /*if ($ctrl.listTreeService.active && $ctrl.listTreeService.active.selectedListId && $ctrl.listTreeService.active.selectedListId !== 'All') {
                params.contactListId = $ctrl.listTreeService.active.selectedListId;
            }*/
            return params;
        }

        function getGroupOrder(id) {
            var o = {};
            o['orderLists.c_' + (id || 'All')] = 1;
            return o;
        }
    }
}

angular.module('product.callsheet.customizeCallsheetInvitePopup.components', [
