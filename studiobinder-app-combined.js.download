            includeFields: ['active', 'name', 'logo', 'logoId', 'createdById', 'order', 'orderAll', 'createdAt', 'updatedAt'],
            searchFields: ['name', 'production'],
            orderFields: ['order', 'createdBy.name', 'createdAt', 'createdAtT', 'updatedAt', 'updatedAtT', 'orderAll'],
           // populate: 'createdById',

            defaultOrder: 'createdAtT',
            defaultOrderDir: -1
        },

        Options = {
            columns: ['1', '2', '5'],
            view: 2
        },

        GroupSettings = {
            colType: 'myProjects',
            gridItemClass: 'short-item-grid ',
            groupItemTag: 'myproduct',
            hideGridHeader: true
        };

    return {
        ViewProp: 'myProjectsView',
        ListParams: ListParams,
        CompOptions: CompOptions,
        PropTypes: PropTypes,
        Options: Options,
        Settings: Settings,
        GroupSettings: GroupSettings
    };
}

