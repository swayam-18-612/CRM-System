angular.module('dragula.kanbanSortable.service', [
    'dragula.sortableinit.service'
])
//ensures drag between columns
.service('DKanbanSortableService', DKanbanSortableService);
DKanbanSortableService.$inject = ['DSortableInitService'];

function DKanbanSortableService(DSortableInitService) {
    return function (parentElement, sortableOptions) {
        console.log('DKanbanSortableService');

        var $ctrl = this;
        $ctrl.isKanban = true;
        $ctrl.timeout = 400;

        $ctrl.getContainer = getContainer;
        $ctrl.getItems = getItems;

        $ctrl = new DSortableInitService($ctrl, parentElement, sortableOptions);

        return $ctrl;

        function getContainer(){
            if (!$ctrl.container) {
                $ctrl.container = $ctrl.parentElement.querySelector('.' + $ctrl.sortableContainerCls); //sortableClass
            }
        }

        function getItems() {
            $ctrl.getContainer();
            return $ctrl.container ? $ctrl.container.querySelectorAll('.' + $ctrl.childClass) : [];
        }
    }
}

angular.module('dragula.sortable.service', [
    'dragula.sortableinit.service'
])
.service('DSortableService', DSortableService)
DSortableService.$inject = ['DSortableInitService'];
function DSortableService(sortableInitService) {
    return function (parentElement, sortableOptions) {
        console.log('DSortableService');
        var $ctrl = this;


        $ctrl.getSelectedItems = getSelectedItems;

        $ctrl.addContainerOther = addContainerOther;
        $ctrl.removeContainerOther = removeContainerOther;

        $ctrl = new sortableInitService($ctrl, parentElement, sortableOptions);

        return $ctrl;

        function getSelectedItems(target){
            return $ctrl.getAll($ctrl.selectedItemCls, target ? target : $ctrl.getCurrentContainer());
        }

        function addContainerOther(container) {
            $ctrl.drake.containers.push(container);
        }

        function removeContainerOther(container) {
            try {
                $ctrl.drake.containers.splice(container);
            } catch (e) {}
        }

    }
}

angular.module('dragula.sortableElement.service', [
])
.service('DSortableElementService', DSortableElementService);
DSortableElementService.$inject = ['$window'];
function DSortableElementService($window) {
    if (!$window.dragula) {
        console.warn('dragula var missing. Did you forget to include the script js/dragula-changed.js?');
    }
   return $window.dragula;

}

angular.module('dragula.sortableinit.service', [
    'list.sortableinitfirst.service',
    'dragula.sortableElement.service'
])
.service('DSortableInitService', DSortableInitService)
DSortableInitService.$inject = ['SBSortableInitFirstService', 'DSortableElementService'
];
function DSortableInitService(SBSortableInitFirstService, sortableElementService) {
    return function ($ctrl, parentElement, sortableOptions) {
        console.log('DSortableInitService');

        $ctrl.attachMethods = attachMethods;
        $ctrl.getNew = getNew;
        $ctrl.onDropOther = onDropOther;

        $ctrl = new SBSortableInitFirstService($ctrl, parentElement, sortableOptions);

        return $ctrl;

        function getNew(){
            if (sortableElementService && typeof (sortableElementService) === 'function') {
                if (typeof ($ctrl.getContainer) === 'function') {
                    $ctrl.getContainer();
                }
                return sortableElementService($ctrl.container ? [$ctrl.container] : null, getServiceParams());
            }
            return null;
        }
        function attachMethods() {
            if (!$ctrl.drake) {
                return;
            }
            $ctrl.drake //Element will be concealed from source
                .on('drag', $ctrl.onDrag)
                .on('dragend', $ctrl.onDragEnd)
                
                .on('drop', $ctrl.onDrop)
                .on('over', onOver )
                .on('out', onOut ) 
                //Element will be moved into target

            if($ctrl.withMultiSelect){
                $ctrl.drake.on('cloned', onClonedMultiSelect);
            }
        }

        function getServiceParams() {
            return {

                /* You can define a moves method which will be invoked with (el, source, handle, sibling) whenever an element is clicked. If this method returns false, a drag event won't begin, and the event won't be prevented either. The handle element will be the original click target, which comes in handy to test if that element is an expected "drag handle".*/
                moves:  moves,

                /*You can set accepts to a method with the following signature: (el, target, source, sibling). It'll be called to make sure that an element el, that came from container source, can be dropped on container target before a sibling element. The sibling can be null, which would mean that the element would be placed as the last element in the container. Note that if options.copy is set to true, el will be set to the copy, instead of the originally dragged element.*/
                accepts:  accepts,

                /*You can provide an invalid method with a (el, handle) signature. This method should return true for elements that shouldn't trigger a drag. The handle argument is the element that was clicked, while el is the item that would be dragged*/
                //  invalid: $ctrl.invalid,

                //isContainer: isContainer,

                direction: $ctrl.sortableOptions.direction ? $ctrl.sortableOptions.direction : 'vertical',             // Y axis is considered when determining where an element would be dropped

                copy: false,                       // elements are moved by default, not copied
                copySortSource: false,             // elements in copy-source containers can be reordered

                revertOnSpill: true,              // spilling will put the element back where it was dragged from, if this is true
                removeOnSpill: false,              // spilling will `.remove` the element, if this is true

                mirrorContainer: getMirrorContainer(),    // set the element that gets mirror elements appended
                ignoreInputTextSelection: true,

                /*allows users to select the amount of movement on the X axis before it is considered a drag instead of a click*/
                slideFactorX: 5,

                /*allows users to select the amount of movement on the Y axis before it is considered a drag instead of a click*/
                slideFactorY: 5
            };
        }

        function getMirrorContainer() {
            var cls = $ctrl.sortableOptions.mirrorContainerCls || $ctrl.defaultSortableContainerCls;
            if (cls) {
                var el = $ctrl.parentElement.querySelector('.' + cls);
                if (el) {
                    return el;
                }
            }
            return $ctrl.parentElement;
        }

        function moves(el, source, handle, sibling) {
            //console.log('moves');
            //move only elements that have the drag handle
            if ((handle && handle.className && handle.className.indexOf && handle.className.indexOf('vertical-dots') !== -1) || $ctrl.LCS.findClosestParent(handle, '.dropdown-menu.side-menu')) {
                return false;
            }
            return ($ctrl.LCS.hasClass(handle, $ctrl.handleClass) || $ctrl.LCS.findClosestParent(handle, '.' + $ctrl.handleClass) !== null) && !$ctrl.LCS.hasClass(handle, $ctrl.clsNoDrag) &&
                $ctrl.LCS.findClosestParent(handle, '.' + $ctrl.clsNoDrag) === null;
        }

        function accepts(el, target, source, sibling) {
            //console.log('accepts - sibling: ' + (sibling ? sibling.getAttribute('data-id') : 'null'));
            return target.classList.contains($ctrl.sortableContainerCls) && ($ctrl.cantBeDraggedLast && sibling || !$ctrl.cantBeDraggedLast);

            //if(!target.classList.contains($ctrl.sortableContainerCls)){return false;}
            //return !!sibling || sibling && el.classList.contains('gu-mirror');
            //console.log('accepts ' + target.id + ': ' + v);
            //return v;
            //todo
            //var a1 = target.getAttribute('sort-type'),
            //a2 = source.getAttribute('sort-type');
// prevent dragged containers from trying to drop inside itself
            //return (!a1 && !a2 || a1 === a2);
// && target.classList.contains($ctrl.sortableContainerCls);
// && !contains(el,target);
//// accept drags only if the drop target is the same
//       // as the source container the element came from
//       return target == source;
        }

        //el is over container, and originally came from source
        function onOver(el, container, source) {
           // console.log('listitemover');
            $ctrl.targetContainer = container;
            $ctrl.sourceContainer = source;
            $ctrl.LCS.addClass(container, 'ex-over');
        }

        //el was dragged out of container or dropped, and originally came from source
        function onOut(el, container, source) {
           // console.log('listitemout');
            $ctrl.targetContainer = null;
            $ctrl.sourceContainer = null;
            $ctrl.LCS.removeClass(container, 'ex-over');
            // unhide all
            $ctrl.onOutMultiSelect();
        }

        //el was dropped into target before a sibling element, and originally came from source
        function onDropOther(el, target, source, sibling) {
            onDropMultiSelect(target);
        }

        function onDropMultiSelect(target) {
            if (!$ctrl.withMultiSelect) {return;}

            // get the default, single dropped item
            var droppedItem = $ctrl.getSelectedItems(target)[0];
            // are we dropping multiple items?
            if ($ctrl.hasMultiple) {
                // replace it with the content of the mirror container
                var l = $ctrl.mirrorContainer && $ctrl.mirrorContainer.children ? $ctrl.mirrorContainer.children.length : 0;
                if(!l) {
                    for (var i = $ctrl.mirrorContainer.children.length - 1; i >= 0; i--) {
                        var mirror = $ctrl.mirrorContainer.children[i];
                        if (mirror) {
                            var el = angular.element($ctrl.getById(mirror, target));
                            if (el) {
                                // $ctrl.LCS.removeClass(el, $ctrl.transitCls);
                                el.insertAfter(angular.element(droppedItem));
                            }
                            // remove all vestigial items from the dom
                            $ctrl.LCS.removeElement(mirror);
                        }
                    }
                }

                // clear flag
                $ctrl.hasMultiple = false;
            }
            // single selection caseex-moved
            else {
            // edge case: if only one item happened to be selected, remove the selected item class
                $ctrl.LCS.removeClass(droppedItem, $ctrl.selectedItemCls);
            }
        }

        function onClonedMultiSelect(clone, original, type)  {
           // console.log('onClonedMultiSelect');
            // grab the mirror container dragula creates by default
            var mirrorContainers = getAll($ctrl.mirrorCls);
            if(mirrorContainers && mirrorContainers.length > 0){
                $ctrl.mirrorContainer = mirrorContainers[0];
            }

            // multi selected items will have this class,
            // but we don't want it on the ones in the mirror
            $ctrl.LCS.removeClass($ctrl.mirrorContainer, $ctrl.selectedItemCls);

            // get the multi selected items
            $ctrl.selectedItems = $ctrl.getSelectedItems();

            // do we have multiple items selected?
            // (takes into account edge case where they start dragging from an item that hasn't been selected)
            $ctrl.hasMultiple = $ctrl.selectedItems.length > 1 || ($ctrl.selectedItems.length === 1 &&
                !$ctrl.LCS.hasClass(original, $ctrl.selectedItemCls));

            // we have multiple items selected
            if($ctrl.hasMultiple) {
                // edge case: if they started dragging from an unselected item, adds the selected item class
                $ctrl.LCS.addClass(getAll($ctrl.transitCls), $ctrl.selectedItemCls);

                // update list of selected items in case of edge case above
                $ctrl.selectedItems = $ctrl.getSelectedItems();

                // clear the mirror container, we're going to fill it with clones of our items
                $ctrl.LCS.emptyElement($ctrl.mirrorContainer);

                // will track final dimensions of the mirror container
                var height = 0,
                    width = 0;

                // clone the selected items into the mirror container
                _.each($ctrl.selectedItems, function(item) {
                    // clone the item
                    var mirror = item.cloneNode(true);

                    // remove the state classes if necessary
                    $ctrl.LCS.removeClass(mirror, $ctrl.selectedItemCls + ' ' + $ctrl.transitCls);

                    //add the clone to mirror container
                    $ctrl.mirrorContainer.appendChild(mirror);
                    $ctrl.LCS.setCSSStyle($ctrl.mirrorContainer, 'background-color', 'transparent');

                    //add drag state class to item
                    $ctrl.LCS.addClass(item, $ctrl.transitCls);

                    // update the dimensions for the mirror container
                    var rect = item.getBoundingClientRect();
                    height += rect.height;
                    width = rect.width;
                });

                //set final height of mirror container
                $ctrl.LCS.setCSSStyle($ctrl.mirrorContainer, 'height', height + 'px');
            }
        }
        function getAll(cls, el) {
            return (el ? el : $ctrl.LCS.bodyElement).querySelectorAll('.' + cls.split(' ').join('.'));
        }
    }
}

angular.module('sb.kanbanSortable.service', [
    'dragula.kanbanSortable.service',
    'js.kanbanSortable.service'
])
//ensures drag between columns
.service('SBKanbanSortableService', SBKanbanSortableService);
SBKanbanSortableService.$inject = ['JSKanbanSortableService', 'DKanbanSortableService'];

function SBKanbanSortableService(JSKanbanSortableService, DKanbanSortableService) {
    return function (parentElement, sortableOptions, isDragula) {
        console.log('SBKanbanSortableService');
        return new (isDragula ? DKanbanSortableService : JSKanbanSortableService)(parentElement, sortableOptions);
    }
}


angular.module('list.masonary.service', [
    'list.sortableinitfirst.service',
    'masonary.service',
    'services.stateService'
])
.service('SBMasonarySortableService', SBMasonarySortableService);
SBMasonarySortableService.$inject = ['SBSortableInitFirstService', 'SBStateService', 'MasonaryService'];
function SBMasonarySortableService(SBSortableInitFirstService, SBStateService, MasonaryService) {
    return function (parentElement, sortableOptions, other) {
        console.log('SBMasonarySortableService');
        var $ctrl = this;

        $ctrl.MasonaryService = MasonaryService;
        $ctrl.SBStateService = SBStateService;

        if(other) {
            $ctrl = _.extend($ctrl, other);
        }
        $ctrl.attachMethods = attachMethods;
        $ctrl.getNew = getNew;
        $ctrl.layout = layout;
        $ctrl.layoutItems = layoutItems;
        $ctrl.bindDraggabilly = bindDraggabilly;

        $ctrl = new SBSortableInitFirstService($ctrl, parentElement, sortableOptions);

        return $ctrl;

        function bindDraggabilly(el, isBind) {
            if (!$ctrl.drake) {
                $ctrl.LCS.timeout(process, 200);
            } else {
                process();
            }

            function process() {
                if (!$ctrl.drake) {
                    return;
                }
                var draggie = new Draggabilly(el,  {handle: '.' + $ctrl.itemHandleCls});
                // bind drag events to Packery
                if(isBind && el.dBinded){
                    p(false);
                }

                p(isBind);

                function p(isBind) {
                    $ctrl.drake[isBind ? 'bindDraggabillyEvents' : 'unbindDraggabillyEvents'](draggie);
                    if(isBind) {
                        el.dBinded = true;
                    } else{
                        delete el.dBinded;
                    }
                }
            }
        }

        function getNew() {
            return new $ctrl.MasonaryService(parentElement.querySelector('.' + $ctrl.sortableContainerCls), getServiceParams());
        }

        function getServiceParams() {
            return {
                itemSelector: '.' + $ctrl.itemSelector,
                //columnWidth: '.grid-sizer',
                percentPosition: true,
                gutter: 10,
                //initLayout: false,// the initial layout is based on sorted list
            };
        }

        function attachMethods() {
            $ctrl.RootEventsService.addRootWatcherSimple($ctrl.watchers, $ctrl.LCS.onToggleInnerSidebar($ctrl.SBStateService.currentState.name, onToggleInnerSidebar));

           // $ctrl.drake.on('layoutComplete', savePositions);
            $ctrl.drake.on('dragItemPositioned', dragItemPositioned);
            $ctrl.drake.onDragStart = onDragStart;
            //$ctrl.drake.on('onDragStart', onDragStart);
            // layout Packery after each image loads
        }

        function onDragStart(result){
            //console.log('onDragStart');
            var el= result ? result.element : null;
            if(!el){return;}
            $ctrl.onDrag(el);
        }

        function dragItemPositioned(result) {
            var el = result ? result.element : null;
            if (!el) {
                return;
            }
            //console.log('dragItemPositioned ' + el.getAttribute('data-id') + ': isOnDragEnd=' + el.isOnDragEnd);
            var els = $ctrl.drake.getItemElements();
            $ctrl.onDragEnd(el, els ? els.map(function (el, i) {
                return el.getAttribute('data-id');
            }) : null);
        }

        function onToggleInnerSidebar(){
           //console.log('SBMasonaryService.onToggleInnerSidebar');
            $ctrl.LCS.timeout(function (){
                $ctrl.scrollableParent.scrollTo(0,0);
                $ctrl.drake.layout();
            }, 100);
        }

        function layout(result, startOnTop) { //{el,id}
            //console.log('SBMasonaryService.layout');
            if (result) {
                var l = [];
                if (result.el && !getItemById(result.id, true)) {
                    l = [result.el];
                } else if (result.items) {
                    _.each(result.items, function (item) {
                        var id = item._id;
                        if (!getItemById(id, true)) {
                            l.push($ctrl.getItemEl(id, null, result.grid));
                        }
                    });
                }
                if (l.length > 0) {
                    $ctrl.drake.appended(l);
                }
            }
            if (startOnTop) {
                $ctrl.scrollableParent.scrollTo(0, 0);
            }
            $ctrl.drake.layout();
        }

        function layoutItems(itemIds, isAdd) {
            if (!itemIds || !itemIds.length) {
                return;
            }
            //console.log('SBMasonaryService.layoutItems');
            reloadItems(itemIds, isAdd);
             $ctrl.drake.layout();
        }

        function reloadItems(itemIds, isAdd){
            //console.log('SBMasonaryService.reloadItems');
            var exists = isAdd ? true : false;
            _.each(itemIds, function (id) {
                var el = getItemById(id, true);
                if (!el) {
                    exists = isAdd ? false : true;
                }
            });
            if (!exists) {
                $ctrl.drake.reloadItems();
                return false;
            }
            return exists;
        }

        function getItemById(id, isElement) {
            var item = _.find($ctrl.drake.items, function (item) {
                return item.element.getAttribute('data-id') === id;
            });
            return item ? (isElement ? item.element : item) : null;

        }

        function getItemsByIds(itemIds, isElement) {
            var l = _.filter(itemIds.map(function (id) {
                return getItemById(id, isElement);
            }), function (item) { //remoVE undefined
                return item !== null && item !== undefined;
            });
            return l.length > 0 ? l : null;
        }
    }
}

angular.module('sb.sortable.service', [
    'dragula.sortable.service',
    'js.sortable.service',
    'list.masonary.service'
])
//ensures drag between columns
.service('SBSortableService', SBSortableService);
SBSortableService.$inject = ['SBMasonarySortableService', 'JSSortableService', 'DSortableService'];

function SBSortableService(SBMasonarySortableService, JSSortableService, DSortableService) {
    return function (parentElement, sortableOptions, other) {
        return new (other && other.isMasonary ? SBMasonarySortableService :
            other && other.isDragula ? DSortableService : JSSortableService)(parentElement, sortableOptions, other);
    }
}

angular.module('list.sortableinitfirst.service', [
])
.service('SBSortableInitFirstService', SBSortableInitFirstService)
SBSortableInitFirstService.$inject = ['RootEventsService', 'LCS'];
function SBSortableInitFirstService(RootEventsService, LCS) {
    return function ($ctrl, parentElement, sortableOptions) {
        console.log('SBSortableInitFirstService');

        $ctrl.watchers = [];
        $ctrl.LCS = LCS;
        $ctrl.RootEventsService = RootEventsService;

        $ctrl.hasMultiple = false;
        $ctrl.defaultSortableContainerCls = 'flex-wrap';
        $ctrl.selectedItems = null;     // flags if there are multiple selection

        var clsHandle = 'as-sortable-item-handle';

        $ctrl.clsNoDrag = 'no-drag';

        //multiselect
        $ctrl.transitCls = 'gu-transit';
        $ctrl.mirrorCls = 'gu-mirror';

        $ctrl.getAll = getAll;

        $ctrl.destroy = destroy;
        $ctrl.reload = reload;

        if(!$ctrl.getById) {
            $ctrl.getById = getById;
        }

        $ctrl.onDragEnd = onDragEnd;
        $ctrl.onDragEndOtherInit = onDragEndOtherInit;

        if(!$ctrl.onDragEndOther) {
            $ctrl.onDragEndOther = onDragEndOther;
        }

        if(!$ctrl.onDragEndOtherKanban) {
            $ctrl.onDragEndOtherKanban = onDragEndOtherKanban;
        }

        $ctrl.onDragInit = onDrag;

        if(!$ctrl.onDrag) {
            $ctrl.onDrag = onDrag;
        }

        if(!$ctrl.onDrop) {
            $ctrl.onDrop = onDrop;
        }

        $ctrl.onOutMultiSelect = onOutMultiSelect;
        $ctrl.onDragEndMultiSelect = onDragEndMultiSelect;
        $ctrl.getItemEl = getItemEl;

        setContainerMethods();

        $ctrl.LCS.timeout(init, $ctrl.timeout || 0);

        return $ctrl;

        function getItemEl(id, cls, parent) {
            return (parent ? parent : $ctrl.element).querySelector('.' + $ctrl.itemSelector + '[data-id="' + id + '"]' + (cls || ''));
        }

        function getCurrentContainer(){
            if($ctrl.containerId !== undefined){
                return $ctrl.containers[$ctrl.containerId].container;
            }
            if($ctrl.targetContainer){
                $ctrl.targetContainer.getAttribute('data-current-list-id');
            }
        }

        function addContainer(parent, options) {
            var containerId = options.sortableGrid;
            if ($ctrl.definedInPageTree) {
                $ctrl.containerId = containerId;
            }
            if (!containerId) {
                return;
            }

            console.log('addContainer: ' + containerId);
            if(options && options.addOnce && $ctrl.containers[containerId]){
                return;
            }
            $ctrl.containers[containerId] = {options: options};

            var timer = $ctrl.LCS.timeout(process, 10);

            /* if(!$ctrl.timers) {
                 $ctrl.timers = [];
             }
             $ctrl.timers.push(timer);
             */

            function process() {
                if (!$ctrl.drake) {
                    console.log('drake is not defined');
                }
                var container = parent.querySelector('.' + $ctrl.sortableContainerCls);
                if (!container) {
                    return;
                }
                $ctrl.containers[containerId].container = container;
                // $ctrl.drake.mirrorContainer = container;
                if(typeof($ctrl.addContainerOther) === 'function'){
                    $ctrl.addContainerOther(container);
                }
                // console.log('container ' + $ctrl.sortableContainerCls + ' added to sortable');

                //$ctrl.timers.splice(i, 1);
            }
        }

        function removeContainer(id) {
            /*for(var i = $ctrl.timers.length - 1; i >= 0; i--){
               var t = $ctrl.timers[i];
                $ctrl.LCS.cancelTimeout(t);
                $ctrl.timers.splice(i, 1);
            }*/

            var c = $ctrl.containers[id];
            if (c && c.container) {
                if(typeof($ctrl.addContainerOther) === 'function'){
                    $ctrl.removeContainerOther(c.container);
                }
            }
            delete $ctrl.containers[id];
        }

        function setContainerMethods() {
            if ($ctrl.isKanban) {
                return;
            }

            $ctrl.containers = {};

            $ctrl.addContainer = addContainer;
            $ctrl.removeContainer = removeContainer;

            $ctrl.getCurrentContainer = getCurrentContainer;
        }

        function init() {
            console.log('create drakes');
            $ctrl.parentElement = parentElement;
            $ctrl.sortableOptions = sortableOptions;

            $ctrl.canDrag = sortableOptions.canDrag;
            $ctrl.block = sortableOptions.block;
            $ctrl.selectedItemCls = sortableOptions.selectedItemCls;
            $ctrl.withMultiSelect = sortableOptions.withMultiSelect;
            $ctrl.cantBeDraggedLast = sortableOptions.cantBeDraggedLast;

            if($ctrl.withMultiSelect && !$ctrl.getCurrentContainer) {
                console.warn('Parent for SBSortableInitFirstService must define method getCurrentContainer');
            }
            $ctrl.scrollableKanbanColumnCls = $ctrl.sortableOptions.scrollableKanbanColumnCls;
            $ctrl.sortableContainerCls = $ctrl.sortableOptions.sortableContainerCls || $ctrl.defaultSortableContainerCls;
            $ctrl.scrollableParentCls = $ctrl.sortableOptions.scrollableParentCls;
            $ctrl.childClass = $ctrl.sortableOptions.childClass;
            $ctrl.handleClass = $ctrl.sortableOptions.handleClass ? $ctrl.sortableOptions.handleClass : clsHandle;

            setSortableParams();

            $ctrl.sortableContainmentCls = $ctrl.sortableOptions.sortableContainmentCls || '.list-group-items';

            reload();
        }

        function reload(){
            console.log(($ctrl.isKanban ? 'SBKanbanSortableService' : 'SBSortableInitFirstService') + '.reload');
            destroy();
            //$ctrl.element = '#' + $ctrl.sortableGrid + ' .' + $ctrl.defaultSortableContainerCls//parentElement.querySelector(elementSelector);
            //if (!$ctrl.element) {
            //    return;
            //}

            $ctrl.drake = $ctrl.getNew();
            $ctrl.scrollableParent = getScrollableElem($ctrl.scrollableParentCls);

            if(typeof($ctrl.attachMethods) === 'function') {
                $ctrl.attachMethods();
            } else{
                console.warn('Parent for SBSortableInitFirstService must define method attachMethods');
            }
        }

        function getScrollableElem(scrollableParentCls){
            var scrollableParent;
            if(scrollableParentCls) {
                scrollableParent = $ctrl.parentElement.querySelector(scrollableParentCls);
            }

            if(!scrollableParent) {
                scrollableParent = $ctrl.LCS.findClosestParent($ctrl.parentElement, scrollableParentCls);
            }

            if (!scrollableParent) {
                scrollableParent = $ctrl.LCS.$window;
            }
            return scrollableParent;
        }

        function setSortableParams() {
            if (!$ctrl.sortableOptions) {
                $ctrl.sortableOptions = {};
            }
            if (!$ctrl.sortableOptions.scrollBy) {
                $ctrl.sortableOptions.scrollBy = 20;
            }
            if (!$ctrl.sortableOptions.scrollClientY) {
                $ctrl.sortableOptions.scrollClientY = 217;
            }
            if (!$ctrl.sortableOptions.scrollInterval) {
                $ctrl.sortableOptions.scrollInterval = 70;
            }
            if (!$ctrl.sortableOptions.scrollTollerance) {
                $ctrl.sortableOptions.scrollTollerance = 10;
            }
        }

        function addScrollableDrag(el){
            setScrollable(el);
            setMouseEventOnDrag(true);
        }

        function removeScrollableDrag(el){
            setMouseEventOnDrag(false);
            clearScrollingInterval();
            removeScrollable();
        }

        //el was lifted from source
        function onDrag(el, source) {
           // console.log('listitemdrag');
            $ctrl.LCS.addClass(el, 'is-moving');
            if(!$ctrl.withoutAutoscroll) {
                addScrollableDrag(el);
            }
        }

        //el was dropped into target before a sibling element, and originally came from source
        function onDrop(el, target, source, sibling) {
            // console.log('listitemdrop');

            if(typeof($ctrl.onDropOther) === 'function'){
                $ctrl.onDropOther(el, target, source, sibling)
            }
            $ctrl.LCS.removeClass(el, 'is-moving');
            $ctrl.LCS.addClass(el, 'ex-moved');

            if(target !== source){//not in same column - so hide it
                if(!el.style){el.style={};}
                if(el.style.setProperty) {
                    el.style.setProperty('display', 'none');
                }

                $ctrl.LCS.timeout(function (){
                    if(el.style.removeProperty) {
                        el.style.removeProperty('display');
                    }
                }, 200);
            }
        }

        //Dragging event for el ended with either cancel, remove, or drop
        function onDragEnd(el, newOrder) {
           // console.log('onDragEnd');

            el.isOnDragEnd = true;

            if(!$ctrl.withoutAutoscroll) {
                removeScrollableDrag(el);
            }

            $ctrl.onDragEndOtherInit(el, newOrder);
            $ctrl.LCS.removeClass(el, 'is-moving ex-moved');

            delete el.isOnDragEnd;
        }


        function onDragEndOtherInit(el, newOrder){
            if($ctrl.onDragEndMultiSelect){
                $ctrl.onDragEndMultiSelect();
            }

            if ($ctrl.onDragEndOther) {
                $ctrl.onDragEndOther($ctrl.withMultiSelect ? $ctrl.getById(el, $ctrl.getCurrentContainer()) : el, newOrder);
            }
        }

        function onOutMultiSelect() {
            if (!$ctrl.withMultiSelect) {
                return;
            }

            //console.log('onOutMultiSelect');
            $ctrl.LCS.setCSSStyle($ctrl.selectedItems, 'display', '');
        }

        function onDragEndMultiSelect() {
            //console.log('onDragEndMultiSelect');
            if ($ctrl.withMultiSelect) {
                // remove state classes for multiple selections that may be back on the left
                $ctrl.LCS.removeClass(getAll($ctrl.transitCls), $ctrl.transitCls);
            }

            $ctrl.onOutMultiSelect();
        }

        function getById(el, parent) {
            return parent.querySelector("[data-id='" + el.getAttribute('data-id') + "']");
        }

        // http://ejohn.org/blog/comparing-document-position/
        function contains(a, b) {
            return a.contains ?
                a != b && a.contains(b) :
                !!(a.compareDocumentPosition(b) & 16);
        }

        function setMouseEventOnDrag(isBind) {
            //todo test - prevent scolling on mobile
            if($ctrl.LCS.isTouchScreen) {
                $ctrl.LCS.bindElementListeners(isBind, $ctrl.LCS.$document[0], onMouseMoveWhileDragging, 'touchmove', {passive: false});
            }
        }

        function onMouseMoveWhileDragging(e) {
            //console.log('onMouseMoveWhileDragging');

            if (e.cancelable) {
                e.preventDefault();
            }

            function other() {
                var eObj = eventObj(e);

                // checking if dragMove callback exists, to prevent application
                // rerenderings on each mouse move event
                var height = $ctrl.LCS.$window.innerHeight,
                    tollerance = $ctrl.sortableOptions.scrollTollerance,
                    below = eObj.clientY > height,
                    above = eObj.clientY < $ctrl.sortableOptions.scrollClientY;
                if (below || above) {
                    if (!$ctrl.interval) {
                        $ctrl.interval = setInterval(function () {
                            var below = eObj.clientY - height > tollerance;
                            var above = $ctrl.sortableOptions.scrollClientY - eObj.clientY > tollerance;
                            if (below || above) {
                                if ($ctrl.scrollableParent) {
                                    $ctrl.scrollableParent.scrollTop = $ctrl.scrollableParent.scrollTop + $ctrl.sortableOptions.scrollBy * (below ? 1 : -1);
                                }
                                //console.log(eObj.clientY +'; ' +height+'; '+$ctrl.sortableOptions.scrollBy + '; '+$ctrl.sortableOptions.scrollInterval);
                            } else {
                                clearScrollingInterval();
                            }
                        }, $ctrl.sortableOptions.scrollInterval);
                    }
                } else {
                    clearScrollingInterval();
                }
            }
        }

        function clearScrollingInterval() {
            if ($ctrl.interval) {
                clearInterval($ctrl.interval);
                $ctrl.interval = null;
            }
        }

        function eventObj(e) {
            var obj = e;
            if (e.targetTouches !== undefined) {
                //Set obj equal to the first Touch object in the TouchList.
                obj = e.targetTouches.item(0);
                //Logic to set obj to original TouchEvent.
            } else if (e.originalEvent !== undefined && e.originalEvent.targetTouches !== undefined) {
                obj = e.originalEvent.targetTouches.item(0);
            }
            return obj;
        }

        function destroy() {
            clearScrollingInterval();
            if ($ctrl.drake) {
                $ctrl.drake.destroy();
            }
            $ctrl.RootEventsService.removeWatchers($ctrl.watchers);
            if(typeof($ctrl.destroyOther) === 'function') {
                $ctrl.destroyOther();
            }
        }

        function setScrollable(el) {
           // console.log('setScrollable');
            if (!autoScroll){return;}

            if($ctrl.scrollableKanbanColumnCls) {
                _.each($ctrl.scrollableKanbanColumnCls, function (item, i){
                    var el1 =  $ctrl.LCS.findClosestParent(el, item.name);
                   if(el1 && item.isParent){
                       el1 = $ctrl.LCS.findClosestParent(el1, item.isParent);
                   }
                   set(i === 0 ? 'scroll' : 'scrollColumn', el1);
               });
            } else{
                set('scroll', $ctrl.scrollableParent);
            }

            function set(scroll, scrollableParent){
                removeScroll(scroll);

                if(scrollableParent) {
                    $ctrl[scroll] = autoScroll([
                        scrollableParent
                    ], {
                        margin: 20,
                        maxSpeed: 20,
                        scrollWhenOutside: true,
                        autoScroll: function () {
                            //console.log('autoScroll');
                             return $ctrl.isMasonary ? $ctrl.LCS.hasClass( el, 'is-moving') : $ctrl.drake.dragging;
                        }
                    });
                    console.log('setScroll ' + scroll);
                }
            }
        }

        function removeScrollable() {
            removeScroll('scroll');
            removeScroll('scrollColumn');
        }

        function removeScroll(scroll){
            if ($ctrl[scroll]) {
                console.log('removeScroll ' + scroll);
                $ctrl[scroll].destroy();// destroy when don't use auto-scroll
                $ctrl[scroll] = null;
            }
        }

        function getAll(cls, el) {
            return (el ? el : $ctrl.LCS.bodyElement).querySelectorAll('.' + cls.split(' ').join('.'));
        }

        function onDragEndOther(el, newOrder){
            console.log('SBSortableInitFirstService.onDragEndOther');
            if($ctrl.isKanban){
                return $ctrl.onDragEndOtherKanban(el);
            }
            var elListId = getAttribute(el, 'current-list-id'),
                treeNode = $ctrl.LCS.findClosestParent(el, '.tree-node.tree-node-content', true);

            if (!treeNode) {
                //group block
                treeNode = $ctrl.LCS.findClosestParent(el, '.tree-node.simple-group', true);
                if (!treeNode) {
                    console.warn('sortable: the parent container must have  class tree-node and attribute data-id which is the current ListID for the spec container');
                    return;
                }
            }

            var currentListId = getAttribute(treeNode, 'data-id'),
                p = {treeNode: treeNode, step: 1};
            if (currentListId !== elListId && !(currentListId === 'All' && elListId === '')) {
                p.nextListId = elListId;
                p.item = {_id: getAttribute(el, 'data-id')};
            }
            p.newOrder = newOrder;

            var type,
                flex = $ctrl.LCS.findClosestParent(el, '.' + $ctrl.sortableContainerCls);
            if (flex) {
                type = flex.getAttribute('sort-type');
            }
            if (!type) {
                type = '';
            }

            p.listId = currentListId;
            $ctrl.RootEventsService.broadcastRoot('LIST_ORDER_CHANGED_' + $ctrl.sortableOptions.elemType + '_' + currentListId, p);

            function getAttribute(el, attr) {
                var id = el.getAttribute(attr);
                if (id === 'null') {
                    id = null;
                }
                if (id === 'undefined') {
                    id = undefined;
                }
                if (el.getAttribute('data-isnumber') === 'true') {
                    id = parseInt(id, 10);
                }
                return id;
            }
        }


        function onDragEndOtherKanban(el) {
             console.log('onDragEndOther');
            var items = $ctrl.getItems();
            _.each(items, function (node, i) {
                node.dataset.order = i; //order starts at 0
            });

            if (typeof ($ctrl.sortableOptions.onDragEnd) === 'function') {
                $ctrl.sortableOptions.onDragEnd(items);
            }
        }
    }
}

angular.module('js.kanbanSortable.service', [
    'js.sortableinit.service'
])
//ensures drag between columns
.service('JSKanbanSortableService', JSKanbanSortableService);
JSKanbanSortableService.$inject = ['JSSortableInitService'];

function JSKanbanSortableService(sortableInitService) {
    return function (parentElement, sortableOptions) {
        console.log('JSKanbanSortableService');

        var $ctrl = this;
        $ctrl.isKanban = true;
        $ctrl.timeout = 400;

        $ctrl.getContainer = getContainer;

        $ctrl = new sortableInitService($ctrl, parentElement, sortableOptions);

        return $ctrl;

        function getContainer(){
            if (!$ctrl.container) {
                $ctrl.container = $ctrl.parentElement.querySelector('.' + $ctrl.sortableContainerCls); //sortableClass
            }
        }

        function getItems() {
            $ctrl.getContainer();
            return $ctrl.container ? $ctrl.container.querySelectorAll('.' + $ctrl.childClass) : [];
        }
    }
}

angular.module('js.sortable.service', [
    'js.sortableinit.service'
])
.service('JSSortableService', JSSortableService)
JSSortableService.$inject = ['JSSortableInitService'];
function JSSortableService(sortableInitService) {
    return function (parentElement, sortableOptions) {
        console.log('JSSortableService');
        var $ctrl = this;


        $ctrl.getSelectedItems = getSelectedItems;
        $ctrl.addContainerOther = addContainerOther;
        $ctrl.removeContainerOther = removeContainerOther;

        $ctrl = new sortableInitService($ctrl, parentElement, sortableOptions);

        return $ctrl;

        function getSelectedItems(target){
            return $ctrl.getAll($ctrl.selectedItemCls, target ? target : $ctrl.getCurrentContainer());
        }

        function addContainerOther(container) {
            $ctrl.drake.containers.push(container);
        }

        function removeContainerOther(container) {
            try {
                $ctrl.drake.containers.splice(container);
            } catch (e) {}
        }
    }
}

angular.module('js.sortableElement.service', [
])
.service('JSSortableElementService', JSSortableElementService);
JSSortableElementService.$inject = ['$window'];
function JSSortableElementService($window) {
    if (!$window.Sortable) {
        console.warn('dragula var missing. Did you forget to include the script js/dragula-changed.js?');
    }
   return $window.Sortable;

}

angular.module('js.sortableinit.service', [
    'list.sortableinitfirst.service',
    'js.sortableElement.service'
])
    //https://clusterize.js.org/
.service('JSSortableInitService', JSSortableInitService)
JSSortableInitService.$inject = ['SBSortableInitFirstService', 'JSSortableElementService'
];
function JSSortableInitService(SBSortableInitFirstService, sortableElementService) {
    return function ($ctrl, parentElement, sortableOptions) {
        console.log('JSSortableInitService');

        $ctrl.attachMethods = attachMethods;
        $ctrl.getNew = getNew;

        $ctrl = new SBSortableInitFirstService($ctrl, parentElement, sortableOptions);

        return $ctrl;

        function getNew(){
            if (sortableElementService && typeof (sortableElementService) === 'function') {
                if (typeof ($ctrl.getContainer) === 'function') {
                    $ctrl.getContainer();
                }
                return sortableElementService($ctrl.container ? [$ctrl.container] : null, getServiceParams());
            }
            return null;
        }

        function attachMethods() {
            if (!$ctrl.drake) {
                return;
            }
            $ctrl.drake //Element will be concealed from source
                .on('drag', $ctrl.onDrag)
                .on('dragend', $ctrl.onDragEnd)
                
                .on('drop', $ctrl.onDrop)
                //Element will be moved into target
        }

        function getServiceParams() {
            return {
                group: "name",  // or { name: "...", pull: [true, false, 'clone', array], put: [true, false, array] }
                sort: true,  // sorting inside list
                delay: 0, // time in milliseconds to define when the sorting should start
                delayOnTouchOnly: false, // only delay if user is using touch
                touchStartThreshold: 0, // px, how many pixels the point should move before cancelling a delayed drag event
                disabled: false, // Disables the sortable if set to true.
                store: null,  // @see Store
                animation: 150,  // ms, animation speed moving items when sorting, `0` — without animation
                easing: "cubic-bezier(1, 0, 0, 1)", // Easing for animation. Defaults to null. See https://easings.net/ for examples.
                handle: $ctrl.handleClass,  // Drag handle selector within list items
                filter: ".no-drag-elements",  // Selectors that do not lead to dragging (String or Function)
                preventOnFilter: true, // Call `event.preventDefault()` when triggered `filter`
                draggable: ".item",  // Specifies which items inside the element should be draggable

                dataIdAttr: 'data-id', // HTML attribute that is used by the `toArray()` method

                ghostClass: "sortable-ghost",  // Class name for the drop placeholder
                chosenClass: "sortable-chosen",  // Class name for the chosen item
                dragClass: "sortable-drag",  // Class name for the dragging item

                swapThreshold: 1, // Threshold of the swap zone
                invertSwap: false, // Will always use inverted swap zone if set to true
                invertedSwapThreshold: 1, // Threshold of the inverted swap zone (will be set to swapThreshold value by default)
                direction: $ctrl.sortableOptions.direction ? $ctrl.sortableOptions.direction : 'vertical',// Direction of Sortable (will be detected automatically if not given)

                forceFallback: false,  // ignore the HTML5 DnD behaviour and force the fallback to kick in

                fallbackClass: "sortable-fallback",  // Class name for the cloned DOM Element when using forceFallback
                fallbackOnBody: false,  // Appends the cloned DOM Element into the Document's Body
                fallbackTolerance: 0, // Specify in pixels how far the mouse should move before it's considered as a drag.

                dragoverBubble: false,
                removeCloneOnHide: true, // Remove the clone element when it is not showing, rather than just hiding it
                emptyInsertThreshold: 5, // px, distance mouse must be from empty sortable to insert drag element into it


                setData: setData,
                onChoose: onChoose,
                onUnchoose: onUnchoose,
                onStart: onDrag, //onDrag
                onEnd: onDragEnd, //onDragEnd
                onAdd: onAdd,
                onUpdate: onUpdate,
                onSort: onSort,
                onRemove: onRemove,
                onFilter: onFilter,
                onMove: onMove,
                onClone: onClone,
                onChange: onChange
            }


            function setData(/** DataTransfer */dataTransfer, /** HTMLElement*/dragEl) {
                dataTransfer.setData('Text', dragEl.textContent); // `dataTransfer` object of HTML5 DragEvent
            }

            // Element is chosen
            function onChoose(/**Event*/evt) {
                console.log('onChoose');
                evt.oldIndex;  // element index within parent
            }

            // Element is unchosen
            function onUnchoose(/**Event*/evt) {
                console.log('onUnchoose');
                // same properties as onEnd
            }

            // Element dragging started
            function onDrag(/**Event*/evt) {
                console.log('onDrag');
                evt.oldIndex;  // element index within parent
            }

            // Element dragging ended
            function onDragEnd(/**Event*/evt) {
                console.log('onDragEnd');
                var itemEl = evt.item;  // dragged HTMLElement
                evt.to;    // target list
                evt.from;  // previous list
                evt.oldIndex;  // element's old index within old parent
                evt.newIndex;  // element's new index within new parent
                evt.oldDraggableIndex; // element's old index within old parent, only counting draggable elements
                evt.newDraggableIndex; // element's new index within new parent, only counting draggable elements
                evt.clone // the clone element
                evt.pullMode;  // when item is in another sortable: `"clone"` if cloning, `true` if moving
            }

            // Element is dropped into the list from another list
            function onAdd(/**Event*/evt) {
                console.log('onAdd');
                // same properties as onEnd
            }

            // Changed sorting within list
            function onUpdate(/**Event*/evt) {
                console.log('onUpdate');
                // same properties as onEnd
            }
            // Element is removed from the list into another list
            function onRemove(/**Event*/evt) {
                console.log('onRemove');
                // same properties as onEnd
            }

            // Called by any change to the list (add / update / remove)
            function onSort(/**Event*/evt) {
                console.log('onSort');
                // same properties as onEnd
            }

            // Attempt to drag a filtered element
            function onFilter(/**Event*/evt) {
                console.log('onFilter');
                var itemEl = evt.item;  // HTMLElement receiving the `mousedown|tapstart` event.
            }

            // Event when you move an item in the list or between lists
            function onMove(/**Event*/evt, /**Event*/originalEvent) {
                console.log('onMove');
                // Example: https://jsbin.com/nawahef/edit?js,output
                evt.dragged; // dragged HTMLElement
                evt.draggedRect; // DOMRect {left, top, right, bottom}
                evt.related; // HTMLElement on which have guided
                evt.relatedRect; // DOMRect
                evt.willInsertAfter; // Boolean that is true if Sortable will insert drag element after target by default
                originalEvent.clientY; // mouse position
                // return false; — for cancel
                // return -1; — insert before target
                // return 1; — insert after target
                // return true; — keep default insertion point based on the direction
                // return void; — keep default insertion point based on the direction
            }

            // Called when creating a clone of element
            function onClone(/**Event*/evt) {
                console.log('onClone');
                var origEl = evt.item;
                var cloneEl = evt.clone;
            }

            // Called when dragging element changes position
            function onChange(/**Event*/evt) {
                console.log('onChange');
                evt.newIndex // most likely why this event is used is to get the dragging element's current index
                // same properties as onEnd
            }
        }
    }
}


angular.module('templateCompile.actions.service', [
])
.service('TemplateCompileActionsService', TemplateCompileActionsService);
TemplateCompileActionsService.$inject = ['LCS'];
function TemplateCompileActionsService(LCS) {
    return function ($ctrl, $element) {

        if($ctrl.templateCompileActionsLoaded ){
            return $ctrl;
        }

        $ctrl.$element = $element;
        $ctrl.element = $ctrl.$element[0];

        $ctrl.templateCompileActionsLoaded = true;

        $ctrl.LCS = LCS;
        $ctrl.preventDefault = $ctrl.LCS.preventDefault;

        if(!$ctrl.componentId){
            $ctrl.componentId = new ObjectId().toString();
        }

        if(!$ctrl.bindActions) {
            $ctrl.bindActions = bindActions;
        }

        $ctrl.onAction = onAction;
        $ctrl.getBtnActionCls = getBtnActionCls;

        $ctrl.bindElementClickBySelector = bindElementClickBySelector;
        $ctrl.bindElementsClickBySelector = bindElementsClickBySelector;

        if(!$ctrl.getAnalytics) {
            $ctrl.getAnalytics = getAnalytics;
        }

        if(!$ctrl.toggleInnerSidebar) {
            $ctrl.toggleInnerSidebar = toggleInnerSidebar;
        }

        return $ctrl;
        function getAnalytics(a, v) {
            if(!$ctrl.analyticsCategory && $ctrl.isPopup){
                $ctrl.analyticsCategory = $ctrl.element.tagName;
            }
            return 'analytics-on' +
                ($ctrl.analyticsCategory ? ( ' analytics-category="' + $ctrl.analyticsCategory + '"' ) : '')+
                ' analytics-action="' + a + '"' +
                (v ? ('analytics-value="' + v + '"') : '');
        }


        function bindElementClickBySelector(isBind, cls, ev) {
            bindElementClickInitBySelector(isBind, cls, ev, false);
        }

        function bindElementsClickBySelector(isBind, cls, ev) {
            bindElementClickInitBySelector(isBind, cls, ev, true);
        }

        function bindElementClickInitBySelector(isBind, cls, ev, isAll) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element[isAll ? 'querySelectorAll' : 'querySelector'](cls), ev);
        }

        function getBtnActionCls(){
            return 'btnAction' + $ctrl.componentId;
        }

        function bindActions(isBind) {
            if (isBind) {
                process(false);
            }

            process(isBind);

            function process(isBind) {
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('.' + $ctrl.getBtnActionCls()), $ctrl.onAction);

                if (typeof ($ctrl.bindActionsOthers) === 'function') {
                    $ctrl.bindActionsOthers(isBind);
                }
            }
        }

        function onAction(e){
            $ctrl.preventDefault(e);
            //console.log('onAction');
            var el = e.currentTarget,
                type = el.getAttribute('data-type'),
                data = el.getAttribute('data-info');
            if(type && typeof($ctrl[type]) === 'function'){
                $ctrl[type](data, e);
            } else {
                console.warn('TemplateCompileActionsService: method ' + type + ' is not defined');
            }
        }

        function toggleInnerSidebar() {
            console.log('toggleInnerSidebar ' + $ctrl.getSidebarName());
            $ctrl.LCS.toggleInnerSidebar($ctrl.getSidebarName());
            if($ctrl.showLeftSidebar) {
                $ctrl.showLeftSidebar();
            }
        }
    }
}


angular.module('templateCompile.controller.service', [
    'templateCompile.service',
    'templateCompile.actions.service'
])
.service('TemplateCompileCtrlService', TemplateCompileCtrlService);
TemplateCompileCtrlService.$inject = ['TemplateCompileService', 'TemplateCompileActionsService'];
function TemplateCompileCtrlService(TemplateCompileService, TemplateCompileActionsService) {
    return function ($ctrl, $element, withoutTemplateScope) {

        $ctrl.TemplateCompileService = TemplateCompileService;
        $ctrl.TemplateCompileActionsService = TemplateCompileActionsService;

        if($ctrl.templateCompileLoaded ){
            return $ctrl;
        }

        $ctrl.templateCompileLoaded = true;

        if (!$ctrl.$onDestroy) {
            $ctrl.$onDestroy = onTemplateDestroy;
        }
        $ctrl.onTemplateDestroy = onTemplateDestroy;

        if(!$ctrl.initTemplateComp){
            $ctrl.initTemplateComp = initTemplateComp;
        }

        if($ctrl.onTemplateCompileInitOther){
            $ctrl.onTemplateCompileInitOther ();
        }

        $ctrl = new $ctrl.TemplateCompileActionsService($ctrl, $element);

        $ctrl.reloadTemplate = reloadTemplate;
        $ctrl.reloadListItemTemplate = reloadListItemTemplate;


        if(!$ctrl.$onInit){
            $ctrl.$onInit = onInit;
        } else{
            onInit();
        }

        return $ctrl;

        function initTemplateComp(){
            if($ctrl.preInit) {
                $ctrl.preInit();
            }
        }

        function onInit() {
            $ctrl.initTemplateComp();

            if(!$ctrl.getItemTemplate){
                console.warn('parent for TemplateCompileCtrlService must define method getItemTemplate');
            }

            if(!$ctrl.dontAutoloadTemplate) {
                $ctrl.reloadListItemTemplate();
            }else if(typeof($ctrl.onPreloadCompileTemplate) === 'function'){
                $ctrl.onPreloadCompileTemplate();
            }
        }

        function reloadListItemTemplate() {
            if($ctrl.beforePreloadTemplate){
                $ctrl.beforePreloadTemplate($ctrl.reloadTemplate);
            }else {
                $ctrl.reloadTemplate();
            }
        }

        function onTemplateDestroy() {
            $ctrl.bindActions(false);

            if($ctrl.onDestroy){
                $ctrl.onDestroy();
            }

            //comp
            if($ctrl.removeWatchers) {
                $ctrl.removeWatchers();
            }

            if ($ctrl.templateCompile) {
                $ctrl.templateCompile.destroyNewScope();
            }
        }

        function reloadTemplate() {
            if(!$ctrl.templateCompile) {
                $ctrl.templateCompile = new $ctrl.TemplateCompileService($ctrl.$element, $ctrl.getItemTemplate, $ctrl, withoutTemplateScope);
            } else{
                $ctrl.bindActions(false);
            }
            $ctrl.templateCompile.loadTemplate(onLoaded);

            if($ctrl.postInit && !$ctrl.postInited) {
                $ctrl.postInit();
                $ctrl.postInited = true;
            }

            function onLoaded() {
                if(typeof($ctrl.onLoaded) === 'function') {
                    $ctrl.onLoaded();
                }

                $ctrl.LCS.timeout(function (){
                    $ctrl.bindActions(true);
                }, 200);
            }
        }
    }
}


angular.module('templateCompile.service', [
    'services.compile'
])
.service('TemplateCompileService', TemplateCompileService);
TemplateCompileService.$inject = ['CompileService', 'LCS'];
function TemplateCompileService(CompileService, LCS) {
    return function (parentEl, getItemTemplate, $ctrl, withoutTemplateScope) {

        var _this = this;

        _this.CompileService = CompileService;
        _this.LCS = LCS;

        _this.preventDefault = LCS.preventDefault;

        _this.delay = 0;
        _this.newScope = null;


        _this.$ctrl = $ctrl;
        _this.parentEl = getEl(parentEl);

        _this.getItemTemplate = getItemTemplate;

        _this.loadTemplate = loadTemplate;
        _this.destroyNewScope = destroyNewScope;

        return _this;

        function loadTemplate(onSuccess, newCtrl, parentEl, template, withoutRemove) {
            if(!template){template = _this.getItemTemplate();}

            if(!_this.keepChildren) {
                destroyNewScope();
            }

            if(!withoutTemplateScope) {
                _this.newScope = _this.CompileService.getNewScope();
                _this.newScope.$ctrl = newCtrl ? newCtrl : _this.$ctrl;
            }

            processTemplate(onSuccess, (template === null || template === undefined) ? '' : template, parentEl, withoutRemove);
        }

        function processTemplate(onSuccess, template, parentEl, withoutRemove) {
            var p = (parentEl ? getEl(parentEl) : _this.parentEl);
            if (withoutTemplateScope) {
                if (p) {
                    var pEl = p[0];
                    //todo check if there are some other elems same class and remove them
                    if (!withoutRemove) {// append to existing children
                        // remove all children for parent
                        while (pEl.hasChildNodes()) {
                            pEl.removeChild(pEl.firstChild);
                        }
                    }
                    if (template) {
                        //_this.templateCompileTempEl = angular.element(_this.LCS.createFragment(template));
                        //p.append(_this.templateCompileTempEl);

                        //_this.withoutTimeout = true;

                        _this.CompileService.compileTemplate(template, null, onCompiledContainer);
                    }
                } else if (typeof (onSuccess) === 'function') {
                    onSuccess(_this.templateCompileTempEl);
                }

            } else {
                _this.CompileService.compileTemplate(template, _this.newScope, onCompiledContainer);
            }

            function onCompiledContainer(clonedElement) {
                _this.templateCompileTempEl = clonedElement;
                var l = _this.templateCompileTempEl.length;

                if(!p[0]){return;}

                if(!l){
                     onadded(true);
                } else {
                    if (!_this.withoutTimeout) {
                        _this.groupObserver = new MutationObserver(onObserver);
                        _this.groupObserver.count = l;
                        _this.groupObserver.observe(_this.insertAfter ? p[0].parentElement : p[0], {
                            childList: true,
                            subtree: false
                        });
                    }

                    //console.log('onCompiledContainer: ');
                    if (_this.insertAfter) {
                        var t;
                        for (var i = 0; i < l; i++) {
                            var c = _this.templateCompileTempEl[i];
                            if (i === 0) {
                                p.replaceWith(c);//replace the placeholder
                            } else {
                                insertAfter(t, c);//add the rest after the last
                            }
                            t = _this.templateCompileTempEl[i];
                        }
                    } else {
                        for (var i = 0; i < l; i++) {
                            var el = _this.templateCompileTempEl[i];
                            if(_this.insertInFrontOfParent){
                                p.prepend(el);
                            }else {
                                if(_this.insertAfterChild){
                                    if(_this.insertAfterChild === 'inFront'){
                                        p.prepend(el);
                                    } else{
                                        insertAfter(_this.insertAfterChild, el);
                                    }
                                } else{
                                    p[0].appendChild(el);
                                }
                            }
                        }
                        _this.insertAfterChild = null;
                    }

                    if (_this.withoutTimeout) {//if not withoutTimeout is set in observer
                        onadded();
                    }
                    function insertAfter(referenceNode, newNode) {
                        referenceNode.parentNode.insertBefore(newNode, referenceNode.nextSibling);
                    }
                }

                function onObserver(mutations) {
                    //console.log('TemplateCompileService.onObserver');
                    for (var m of mutations) {
                        if (m.type === 'childList' && m.addedNodes && m.addedNodes.length > 0) {
                            _this.groupObserver.count--;
                            if (_this.groupObserver.count === 0) {
                                onadded();
                                if (_this.groupObserver) {
                                    _this.groupObserver.disconnect();
                                }
                            }
                        }
                    }
                }

                function onadded(force) {
                    _this.templateCompileTempEl.on('$destroy', removeScope);
                    if(_this.delay === -1 ||
                        force
                        //|| withoutTemplateScope
                    ){
                          p();
                    } else{
                        //console.log('withoutTemplateScope = ' + withoutTemplateScope);
                        _this.LCS.timeout(p, _this.delay);
                    }

                    function p() {
                        if (typeof(onSuccess) === 'function') {
                            onSuccess(_this.templateCompileTempEl);
                        }
                    }
                }
            }
        }

        function removeScope() {
            if (_this.newScope) {
                _this.newScope.$destroy();
            }
        }

        function destroyNewScope() {
            if (_this.templateCompileTempEl) {
                _this.templateCompileTempEl.remove().end();
            }
        }

        function getEl(e) {
            return e && e.context ? e : angular.element(e);
        }
    }
}


angular.module('templateCompileComp.controller.service', [
    'templateCompile.controller.service'
])
.service('TemplateCompileCompCtrlService', TemplateCompileCompCtrlService);
TemplateCompileCompCtrlService.$inject = ['TemplateCompileCtrlService', 'CompInitCtrlService'];
function TemplateCompileCompCtrlService(TemplateCompileCtrlService, CompInitCtrlService) {
    return function ($ctrl, $element, withoutTemplateScope) {

        $ctrl.TemplateCompileCtrlService = TemplateCompileCtrlService;
        $ctrl.CompInitCtrlService = CompInitCtrlService;

        $ctrl.onTemplateCompileInitOther = onTemplateCompileInitOther;
        $ctrl.initTemplateComp = initTemplateComp;

        $ctrl = new $ctrl.TemplateCompileCtrlService($ctrl, $element, withoutTemplateScope);

        return $ctrl;

        function onTemplateCompileInitOther() {
            if (!$ctrl.compLoaded) {
                $ctrl = new $ctrl.CompInitCtrlService($ctrl, $ctrl.CompInitWithoutStateParams);
            }
        }

        function initTemplateComp(){
            var compOptions = {};

            if($ctrl.compOptions) {
                try {
                    compOptions = JSON.parse($ctrl.compOptions);
                    if (compOptions) {
                        $ctrl = $.extend($ctrl, compOptions);
                    }
                } catch (e) {}
            }

            if($ctrl.preInit) {
                $ctrl.preInit();
            }
            //for workflow item popup for ex
            if($ctrl.compOptionsExtended){
                compOptions =  $.extend({}, compOptions, $ctrl.compOptionsExtended)
                $ctrl = $.extend($ctrl, $ctrl.compOptionsExtended);
                $ctrl.compOptions = JSON.stringify(compOptions);
            }
        }
    }
}

angular.module('list.tree.currentList.service', [
    'services.rootEvents'
])
.service('CurrentTreeListService', CurrentTreeListService);
CurrentTreeListService.$inject = ['RootEventsService', 'CommentsSidebarService'];
function CurrentTreeListService(RootEventsService, CommentsSidebarService) {
    var list = {},
        service = {
            RootEventsService: RootEventsService,
            CommentsSidebarService: CommentsSidebarService,
            broadcastTreeListChanged: broadcastTreeListChanged,
            addOnTreeListChanged: addOnTreeListChanged,
            clear: clear
        };

    return service;

    function clear(elemType) {
        list[elemType] = null;
    }

    //{isCommentsSidebar, isPrintLayout, isInTreeModal}
    function broadcastTreeListChanged(info, elemType, list, from) {
        console.log('broadcastTreeListChanged CurrentTreeListService from ' + from + ': ' + elemType + ':' + (list ? list._id : undefined));
        if (!info.isCommentsSidebar) {
            //trigger update on main tree
            service.RootEventsService.broadcastRoot(getTreeListChanged(info, elemType), list);

            if(list && info.listInfo){
                list = _.extend(list, info.listInfo);
            }

            if (!info.isPrintLayout) {
                //trigger update on sidebar tree
                service.CommentsSidebarService.onTreeListChanged({
                    elemType: elemType,
                    list: list
                });
            }
        }
    }

    function addOnTreeListChanged(watchers, info, elemType, onCurrentTreeListChanged) {
        console.log('addOnTreeListChanged CurrentTreeListService: ' +
            'isCommentsSidebar=' + info.isCommentsSidebar + '; ' +
            'isPrintLayout=' + info.isPrintLayout + '; ' +
            'isInTreeModal=' + info.isInTreeModal + '; ' +
            'elemType=' + elemType);
        if (elemType) {
            return service.RootEventsService.addRootWatcher(watchers, getTreeListChanged(info, elemType), onCurrentTreeListChanged);
        }
    }

    function getTreeListChanged(info, elemType){
        return 'CURRENT_TREE_LIST_CHANGED_' + getPrefix(info) + '_' + elemType;
    }

    function getPrefix(info){
        return (info.isPrintLayout ? '_PRINT_LAYOUT' : '') +
            (info.isInTreeModal ? '_TREE_MODAL' : '');
    }
}

angular.module('item.more.controller.service', [

])
.service('ItemMoreControllerService', ItemMoreControllerService);
ItemMoreControllerService.$inject = ['LCS'];
function ItemMoreControllerService(LCS) {
    return function($ctrl, $element, cls) {
        //console.log('ItemMoreControllerService');
        $ctrl.LCS = LCS;
        $ctrl.element = $element[0];

        $ctrl.$onInit = $onInit;
        $ctrl.$onDestroy = $onDestroy;

        function getItemTemplate() {
            return $ctrl.getTemplate({item: $ctrl.item});
        }

        function $onInit(){
            if(cls){
                $ctrl.LCS.addClass($ctrl.element, cls);
            }
            $ctrl.LCS.appendChildFragment($ctrl.element,getItemTemplate());

            bind(true);
        }

        function $onDestroy() {
            bind(false);
        }

        function bind(isBind) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('ul li a'), update, 'ItemMore');
        }

        function update(e) {
            $ctrl.onUpdate({result: {e: e, item: $ctrl.item}});
        }
    }
}

