angular.module('product.avscript.item.withSetup.service', [])
.service('GridItemWithSetupCtrlService', GridItemWithSetupCtrlService);
GridItemWithSetupCtrlService.$inject = ['TemplateCompileService'];
function GridItemWithSetupCtrlService(TemplateCompileService) {
    return function($ctrl) {
        //console.log('GridItemWithSetupCtrlService');

        var isLast = false;//$ctrl.list.items.length - 1 === $index
        if(!$ctrl.setupType){
            $ctrl.setupType = 'SEGMENT';
        }
        if (!$ctrl.setupRowCls) {
            $ctrl.setupRowCls = 'setup1';
        }

        $ctrl.headerSetupCls = 'nextSetup';

        //setups must be load now
        $ctrl.rowClsOther = rowClsOther;

        $ctrl.updateEditableItemPropsAll = updateEditableItemPropsAll;
        $ctrl.postInitItem = postInitItem;
        $ctrl.onPropChangedOther = onPropChangedOther;

        if (!$ctrl.preInitGridItem && !$ctrl.setPreInitGridItemOther) {
            $ctrl.preInitGridItem = preInitGridItem;
        } else {
            $ctrl.setPreInitGridItemOther = true;
            $ctrl.preInitGridItemOther = preInitGridItem;
        }

        if (!$ctrl.postInitGridItem && !$ctrl.setPostInitGridItemOther) {
            $ctrl.postInitGridItem = postInitGridItem;
        } else {
            $ctrl.setPostInitGridItemOther = true;
            $ctrl.postInitGridItemOther = postInitGridItem;
        }

        $ctrl.create = create;
        $ctrl.getClickEventName = getClickEventName;

        if (!$ctrl.editSegment) {
            $ctrl.editSegment = editSegment;
        }
        $ctrl.onDestroy = onDestroy;
        $ctrl.addBottomButtons = addBottomButtons;
        $ctrl.createInit = createInit;

        if (!$ctrl.isCurrentListItem) {
            $ctrl.isCurrentListItem = isCurrentListItem;
        }

        $ctrl.updateSetupId = updateSetupId;

        if(!$ctrl.canTriggerSetNextSetup){
            $ctrl.canTriggerSetNextSetup = canTriggerSetNextSetup;
        }

        $ctrl.canOnlyChangeFieldManually = canOnlyChangeFieldManually;
        $ctrl.triggerSetNextSegment = triggerSetNextSegment;

        return $ctrl;

        function canOnlyChangeFieldManually(c, el1){
            return c && c.canOnlyChangeManually && $ctrl.item.type === 0 &&
                $ctrl.LCS.findClosestParent(el1, '.' + $ctrl.headerSetupCls).getAttribute('data-next') !== $ctrl.item._id;
        }

        function canTriggerSetNextSetup(){
            return true;
        }

        function preInitGridItem() {
            if ($ctrl.item && $ctrl.item.type === $ctrl.shotTypes.Setup) {
                $ctrl.forceRowLoadNow = true;
            }

            if ($ctrl.item.type === undefined || $ctrl.item.type === null) {
                $ctrl.item.type = $ctrl.shotTypes.Shot;
            }

            $ctrl.preLoadingTableName = $ctrl.preLoadingService.TblTypes[$ctrl.preLoadingTableNameInit];

            if ($ctrl.item.type === $ctrl.shotTypes.Shot) {
                $ctrl.item.setup = $ctrl.preLoadingService.getById($ctrl.preLoadingTableName, $ctrl.item.setupId);
                $ctrl.item.segNo = $ctrl.item.setup ? $ctrl.item.setup.segNo : null;
            }

            if ($ctrl.preInitGridItemOther && !$ctrl.setPreInitGridItemOther) {
                $ctrl.preInitGridItemOther();
            }
        }

        function rowClsOther() {
            return $ctrl.item ? getRowClass($ctrl.item.type) : '';
        }

        function getRowClass(type) {
            switch (type) {
                case undefined:
                case $ctrl.shotTypes.Scene:
                    return ' scene ';
                case $ctrl.shotTypes.Setup:
                    return $ctrl.setupRowCls;
                case $ctrl.shotTypes.Banner:
                    return ' note ';
            }
        }

        function onPropChangedOther(prop, newVal) {
            //console.log('onPropChangedOther');
            if (prop === filterProp) {
                newVal = newVal ? parseInt(newVal, 10) : null;

            } else if (prop === 'column') {

            }
        }

        function updateEditableItemPropsAll(changes) {
            //console.log('GridItemWithSetupCtrlService.updateEditableItemPropsAll');
            $ctrl.postInitItem();


            var el,
                isBanner = $ctrl.shotTypes && $ctrl.item.type === $ctrl.shotTypes.Banner,
                isShot = $ctrl.shotTypes && $ctrl.item.type === $ctrl.shotTypes.Shot,
                prop = 'color';
            if ((isShot || isBanner) && $ctrl.hasPropChanged(changes, prop)) {
                //top-color-bar  color-column6
                el = $ctrl.element.querySelectorAll('.' + $ctrl.SBFieldTypesService.getPropMark(prop) + ':not(.sb-editable-trigger)');
                if (el) {
                    setBGColor(el);
                    if (isBanner) {
                        $ctrl.LCS.setCSSStyle(el, 'border-color', $ctrl.SBFieldMethods.getBannerColor($ctrl.item));
                    }
                }

                if (isBanner) {
                    el = $ctrl.element.querySelector('.b-with-border');
                    if (el) {
                        $ctrl.LCS.setCSSStyle(el, 'border-color', $ctrl.SBFieldMethods.getBorderColor($ctrl.item));
                    }

                    _.each($ctrl.element.querySelectorAll('.banner-content'), function (el) {
                        $ctrl.LCS.setCSSStyle(el, 'color', $ctrl.SBFieldMethods.getBannerColor($ctrl.item));
                    });
                }
            }

            if ($ctrl.item.type !== $ctrl.shotTypes.Setup) {
                $ctrl.updateSetupId(changes, $ctrl.element, '');
            } else if (_.find($ctrl.segmentProps, hasProp)) {
                $ctrl.triggerSetNextSegment();
            }

            if ($ctrl.updateEditableItemPropsAllOther) {
                $ctrl.updateEditableItemPropsAllOther(changes);
            }

            function hasProp(prop){
                return $ctrl.hasPropChanged(changes, prop);
            }
        }

        function updateSetupId(changes, parent, cls) {
            var prop = 'setupId';
            if ($ctrl.hasPropChanged(changes, prop)) {
                var el = parent.querySelector(cls + '.' + $ctrl.SBFieldTypesService.getPropMark('segNo'));
                if (el) {
                    el.setAttribute('data-setup', $ctrl.item[prop]);
                }
            }
        }

        function setBGColor(el, isAdd) {
            $ctrl.LCS.setCSSStyle(el, 'background-color', $ctrl.item.color || '#FFFFFF', isAdd);
        }

        function postInitItem() {
            //console.log('GridItemWithSetupCtrlService.postInitItem');
            var isAdd = $ctrl.item.type === $ctrl.shotTypes.Banner,
                isPrint = $ctrl.item.type === $ctrl.shotTypes.Shot && $ctrl.isPrintLayout;

            if ((isAdd || $ctrl.isPrintLayout) && $ctrl.elRowScheduleTemp) {
                $ctrl.LCS.removeClass($ctrl.elRowScheduleTemp, 'with-white-bg');
            }
            setBGColor($ctrl.elRowSchedule, !isAdd);
            $ctrl.LCS[isAdd ? 'addClass' : 'removeClass']($ctrl.elRowSchedule, $ctrl.SBFieldMethods.getColorClass($ctrl.item));

            //todo???
            isAdd = isLast;
            $ctrl.LCS[isAdd ? 'addClass' : 'removeClass']($ctrl.elRowSchedule, 'list-view-row' + (isAdd ? '' : ' border'));

            set($ctrl.shotTypes.Banner, 'note');
            set($ctrl.shotTypes.Setup, $ctrl.setupRowCls);

            if ($ctrl.item.type === $ctrl.shotTypes.Setup) {
                $ctrl.LCS.removeClass($ctrl.element, 'as-sortable-item as-sortable-item-handle');
                $ctrl.LCS.removeClass($ctrl.element.querySelector('.handle-col'), 'as-sortable-item-handle');
            }

            triggerSetNextSegment();

            function set(type, cls) {
                $ctrl.LCS[$ctrl.item.type === type ? 'addClass' : 'removeClass']($ctrl.elRowSchedule, cls);
            }
        }

        function getUpdateNextEvent(id){
            return 'UPDATE_NEXT_' + $ctrl.setupType + '_' + id;
        }

        function postInitGridItem() {
            $ctrl.addBottomButtons();
            if ($ctrl.item.type === $ctrl.shotTypes.Setup) {
                $ctrl.addRootWatcher(getUpdateNextEvent($ctrl.item._id), setNextSegment);
            } else if ($ctrl.item.type === $ctrl.shotTypes.Shot) {
                $ctrl.addRootWatcher('ON' + $ctrl.item._id, setNextSegment);
            }
        }

        function getItemInList(cond, justfirst) {
            var list = $ctrl.preLoadingService.getObjectList($ctrl.preLoadingTableName, cond);
            return list && list.length > 0 ? (justfirst ? list[0] : list) : null;
        }

        function triggerSetNextSegment() {
            //console.log('triggerSetNextSegment');
            if ($ctrl.item.type !== $ctrl.shotTypes.Setup || !$ctrl.canTriggerSetNextSetup()) {
                return;
            }
            var segNo = parseInt($ctrl.item.segNo, 10);
            if (segNo === 1) {
                //update in header
                if (!$ctrl.topOfHeader) {
                    $ctrl.topOfHeader = getGroupHeader();
                }
                if ($ctrl.topOfHeader) {
                    setNextSegment($ctrl.item, $ctrl.topOfHeader);
                }
            } else {
                var prev = getPreviousSegment($ctrl.item.segNo - 1);
                if (prev) {
                    $ctrl.broadcastRoot(getUpdateNextEvent(prev._id), $ctrl.item);
                }
            }
        }

        function getPreviousSegment(segNo) {
            return getItemInList(function (item) {
                return $ctrl.isCurrentListItem(item) && item.type === $ctrl.shotTypes.Setup && item.segNo === segNo;
            }, true);
        }

        function editSegment(e) {
            //console.log('editSegment ');
            $ctrl.preventDefault(e);
            var setup = $ctrl.LCS.findClosestParent(e.currentTarget, '.'+$ctrl.headerSetupCls);
            if(!setup){return;}
            var id = setup.getAttribute('data-next');
            if (id) {
                var item = getItemInList(function (item) {
                    return $ctrl.isCurrentListItem(item) && item._id === id;
                }, true);
                if (item) {
                    $ctrl.triggerAction(null, 'edit', null, item);
                }
            }
        }

        function setNextSegment(seg, parent) {
            //console.log('setNextSegment ' + seg.segNo);
            $ctrl.nextSegment = seg;
            var inHeader = false;
            if (!parent) {
                parent = $ctrl.element;
            } else {
                inHeader = true;
            }
            //find if the segment already exist in other place
            var cls = $ctrl.headerSetupCls + (inHeader ? ' in-header' : ''),
                el = parent.querySelector('.' + cls.replaceAll(' ', '.')),
                content = $ctrl.getHeaderSegmentContent(seg);
            if (!el) {
                if (seg) { //add
                    $ctrl.LCS.appendChildFragment(parent, '<div class="' + cls + '" data-current="' + getCurrentProp() + '" data-next="' + seg._id + '">' + content + '</div>');
                    bind2(true);
                }
            } else {
                if (seg) { //replace
                    if (el.getAttribute('data-next') === seg._id) {//same
                        if($ctrl.triggerEditSegment){
                            updateNextSegmentEl(el, seg);
                        }

                        if($ctrl.updateNextSegmentEl) {
                            $ctrl.updateNextSegmentEl(el, seg);
                        }
                    } else {
                        el.innerHTML = content;
                        el.setAttribute('data-next', seg._id);
                        el.setAttribute('data-current', getCurrentProp());
                        bind2(true);
                    }
                } else { //remove
                    bind2(false);
                    $ctrl.LCS.removeElement(el);
                }
            }

            $ctrl.LCS[seg ? 'removeClass' : 'addClass'](parent.querySelector('.row-schedule'), 'border-bottom');

            if (inHeader) {
                setCounters();
            }

            function getCurrentProp(){
                return inHeader ? 'header' : $ctrl.item._id;
            }

            function bind2(isBind){
                bind(isBind, inHeader);
                if($ctrl.onHeaderSegmentContentAdded) {
                    $ctrl.onHeaderSegmentContentAdded(isBind, parent, seg);
                }
            }

            function bind(isBind, inHeader) {
                bindEv(false);
                if (isBind) {
                    $ctrl.LCS.timeout(function () {
                        bindEv(isBind, inHeader);
                    }, 0);
                }
            }
        }

        function updateNextSegmentEl(el, seg) {
            var segNo = seg ? seg.segNo.toString() : null,
                name = seg ? seg.name : null,
                note = seg ? seg.note : null;

            var el1 = el.querySelector('.sb-prop-segNo');
            if (el1 && el1.value !== segNo) {
                el1.innerText = segNo;
            }

            el1 = el.querySelector('.sb-prop-name');
            if (el1 && el1.innerHTML !== name) {
                el1.innerHTML = name || '';
            }

            el1 = el.querySelector('.has-sb-prop-name');
            $ctrl.LCS[name ? 'removeClass' : 'addClass'](el1, 'sb-hide');

            el1 = el.querySelector('.sb-prop-note');
            if (el1 && el1.innerHTML !== note) {
                el1.innerHTML = note || '';
            }

            if (!name) {
                el = $ctrl.element.querySelector('.sb-view-empty.sb-prop-name');
                if (el) {
                    el.innerText = $ctrl.setupTypeName + ' ' + segNo;
                }
            }
        }

        function onDestroy() {
            bindEv(false);

            if ($ctrl.compileButtons) {
                $ctrl.compileButtons.destroyNewScope();
            }

            if($ctrl.destroyOther){
                $ctrl.destroyOther();
            }
        }

        function getGroupHeader() {
            var groupContentCls = 'group-content';
            var p = $ctrl.LCS.findClosestParent($ctrl.element, '.' + groupContentCls, true);
            if(!p){
                p = $ctrl.LCS.findClosestParent($ctrl.element, '.simple-group', true);
            }
            return p ? p.querySelector('.top-of-header') : null;
        }

        function bindEv(isBind, inHeader) {
            var el;
            try {
                el = inHeader ? getGroupHeader() : $ctrl.element;
            } catch (e) {}

            if($ctrl.triggerEditSegment) {
                $ctrl.LCS.bindElementsClick(isBind, el.querySelector('.' + $ctrl.headerSetupCls + ' .editSegment'), $ctrl.editSegment);
            }
        }

        function getMax() {
            var list = $ctrl.preLoadingService.getObjectList($ctrl.preLoadingTableName, function (item) {
                return $ctrl.isCurrentListItem(item) && item.type === $ctrl.shotTypes.Setup;
            });
            return list ? _.max(list, function (item) {
                return item.segNo;
            }) : null;
        }

        function setCounters() {
            var setup = getMax();
            if (setup) {
                //console.log('setCounters');
                var txt = $ctrl.getSetupCounter ? $ctrl.getSetupCounter(setup) : '';
                set('.tree-group', '.subtitle.counter-text-' + $ctrl.elemType);

                var el = $ctrl.LCS.findClosestParent($ctrl.element, '.side-table');
                if (el) {
                    el = el.parentElement.querySelector('.filters.on-top .text-info-count .nonselectedrowcount');
                    if (el) {
                        el.innerText = txt;
                    }
                }
            }

            function set(p, c) {
                var el = $ctrl.LCS.findClosestParent($ctrl.element, p);
                if (el) {
                    el = el.querySelector(c);
                    if (el) {
                        el.innerText = txt;
                    }
                }
            }
        }

        function addBottomButtons() {
            if($ctrl.item.type === $ctrl.shotTypes.Setup) {
                if ($ctrl.canEdit && $ctrl.getBottomBtns) {
                    if (!$ctrl.compiledBottomButtons) {
                        $ctrl.LCS.appendChildFragment($ctrl.element, $ctrl.getBottomBtns());
                    } else {
                        if (!$ctrl.compileButtons) {
                            $ctrl.clsButtons = 'setup-buttons';
                            $ctrl.LCS.appendChildFragment($ctrl.element, '<div class="row-add"><div class="handle-col">&nbsp;</div><div class="grow-column ' + $ctrl.clsButtons + '"></div></div>');
                            $ctrl.LCS.timeout(function () {
                                $ctrl.compileButtons = new TemplateCompileService(angular.element($ctrl.element.querySelector('.' + $ctrl.clsButtons)), $ctrl.getBottomBtns, $ctrl);

                                loadTemplate();
                            }, 0);
                        } else {
                            loadTemplate();
                        }

                        function loadTemplate() {
                            $ctrl.compileButtons.loadTemplate(onLoaded);

                            function onLoaded() {
                                //element.removeClass($ctrl.sceneParent, 'sceneEditor');

                            }
                        }
                    }
                }
                if ($ctrl.addBottomButtonsOther && typeof($ctrl.addBottomButtonsOther) === 'function') {
                    $ctrl.addBottomButtonsOther();
                }
            }
        }

        function getClickEventName(name) {
            return 'sb-click-' + name;
        }

        function create(e) {
            //console.log('create');
            $ctrl.preventDefault(e);
            var type = null;
            try {
                type = parseInt(e.currentTarget.getAttribute('data-info'));
            } catch (ex) {
            }
            createInit(type, null, e);
        }

        function createInit(type, more, e) {
            if (type == null) {
                return;
            }
            var after;
            //add row/banner above in this segment

            if (type === $ctrl.shotTypes.Setup) {
                after = $ctrl.item;
            } else {
                var list = _.sortBy(getItemInList(function (item) {                        //is not setup
                    return $ctrl.isCurrentListItem(item) && item.setupId === $ctrl.item._id && item.type !== 0;
                }), 'order');
                after = list && list.length > 0 ? list[list.length - 1] : null; //is first if undefined
                if (!after) {
                    var segNo = $ctrl.item.segNo - 1;
                    if (segNo > 0) {
                        after = getPreviousSegment(segNo);
                        if (after === undefined) {
                            after = null;
                        }
                    }
                }
            }
            if (after !== undefined) {
                $ctrl.broadcastRoot('ADD_ITEM_IN_' + $ctrl.setupType + '_' + $ctrl.currentListId, {
                    after: after,
                    type: type,
                    more: _.extend({},
                        //$ctrl.item.type === $ctrl.shotTypes.Setup ? {setupId: $ctrl.item._id} :
                           null, more),
                    e: e
                });
            }
        }
    }

    function isCurrentListItem() {
        return true;
    }
}

angular.module('product.avscript.group.component',[
    'apiPagination.Avscripts',
    'product.avscript.item.grid.component',
    'product.shots.group.overloaded.controller.service',
    'services.commentsSidebar',
    'product.avscript.group.withSetup.service',
    'apiServices.Documents'
])
.component('avscriptGroup', treeGroupComponentParams( 'AvscriptGroupCtrl', {
}))
.controller('AvscriptGroupCtrl', AvscriptGroupCtrl);
AvscriptGroupCtrl.$inject = ['AvscriptsPagination', 'ShotGroupOverloadedCtrlService', 'GroupWithSetupCtrlService', 'CommentsSidebarService', 'DocumentsService', '$element'];
function AvscriptGroupCtrl(Pagination, ShotGroupOverloadedCtrlService, GroupWithSetupCtrlService, CommentsSidebarService, DocumentsService, $element) {
    var $ctrl = this;

    $ctrl.DocumentsService = DocumentsService;
    $ctrl.CommentsSidebarService = CommentsSidebarService;
    $ctrl.BlocksSetupService = CommentsSidebarService.BlocksSetupService;

    $ctrl.groupItemTag = 'avscript';
    $ctrl.defaultKey = null; //'R' -> dont allow ctrl + r to create new row ;
    $ctrl.setupTypeName = 'Segment';
    $ctrl.setupType = 'SEGMENT';
    $ctrl.setupTypeIcon = 'daybreak';
    $ctrl.setupIconLevel = 4;

    //$ctrl.SegmentKeys = [$ctrl.keyboardService.keys.TKey, $ctrl.keyboardService.keys.tKey];
    //$ctrl.SegmentKeys = [84, 116];

    $ctrl.dayBreakColumns = ['name', 'duration', 'runtime', 'wordCount', 'totalWordCount', 'rowNo', 'segNo'];
    $ctrl.bannerColumns = ['name', 'note'];

    //changed props on version
    $ctrl.onListChangedProps = ['version', 'notes'];

    $ctrl.onGroupSetupsInitOther2 = onGroupSetupsInitOther2;
    $ctrl.getGroupEmptyButtons = getGroupEmptyButtons;

    $ctrl.processListItemColumnInit = processListItemColumnInit;
    $ctrl.getColsHeader = getColsHeader;
    $ctrl.getColsBanner = getColsBanner;
    $ctrl.getColsSetup = getColsSetup;

    $ctrl.getItemTitleForMovePopup = getItemTitleForMovePopup;

    $ctrl.getCustomNextToCheckbox = getCustomNextToCheckbox;

    $ctrl.additionalTargetCheckings = additionalTargetCheckings;
    // $ctrl.getKeyboardSelectedRows = getKeyboardSelectedRows;

    $ctrl.getRowMobileActions = getRowMobileActions;
    $ctrl.viewComments = viewComments;
    $ctrl.afterProcessUpdatesOther1 = afterProcessUpdatesOther1;
    $ctrl.showBottomButtons = showBottomButtons;

    $ctrl.getSidebarTwo = getSidebarTwo;
    $ctrl.hasTwoSidebars = hasTwoSidebars;
    $ctrl.toggleScratchpad = toggleScratchpad;
    $ctrl.move = move;
    $ctrl.canAddSegments = canAddSegments;
    $ctrl.getDefaultBannerColor = getDefaultBannerColor;
    $ctrl.canRemove = canRemove;
    $ctrl.editP = editP;
    //$ctrl.getClipboardProcessingParams = getClipboardProcessingParams;

    $ctrl = new GroupWithSetupCtrlService($ctrl);

    $ctrl = new ShotGroupOverloadedCtrlService($ctrl, $element, Pagination);

    function canRemove(item){
        return !$ctrl.ShotTypes || !($ctrl.ShotTypes && (item.type === $ctrl.ShotTypes.Setup && _.filter($ctrl.list.items, {type: $ctrl.ShotTypes.Setup}).length === 1) ||
            ($ctrl.ShotTypes && item.type === $ctrl.ShotTypes.Shot && _.filter($ctrl.list.items, {type: $ctrl.ShotTypes.Shot}).length === 1));
    }

    function getDefaultBannerColor(){
        return $ctrl.LCS.darkBannerColor;
    }
    function canAddSegments(result, process, otherParams){
        switch (result.type){
            case 0:
                $ctrl.CPS.loadQuotaPopup('avscriptSegments', process, null, null, $ctrl.compOptions, otherParams);
                break;
            case 1:
                process();
               // $ctrl.CPS.loadQuotaPopup('avscriptRows', process, null, null, $ctrl.compOptions, otherParams);
                break;
            case 2:
                $ctrl.CPS.loadQuotaPopup('avscriptAdvanced', process, null, null, $ctrl.compOptions, otherParams);
                break;
        }
    }

    function move(item, e) {
        $ctrl.CPS.loadQuotaPopup('avscriptSegments', process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e: e});
        function process(){
            $ctrl.openTasksReorder({popupTitle: 'Reorder Segments'});
        }
    }

    function getClipboardProcessingParams(params, extraParam) {
        //move or duplicate
        if((params.opType === 1 || params.opType === 2) && extraParam && extraParam.currentListId ) {
            var p = {};
            p[$ctrl.listField] = extraParam.currentListId
            params = _.extend(params, p);
        }
        return params;
    }

    function getSidebarTwo() {
        $ctrl.extraScratchpadParams = {documentId: $ctrl.currentList ? $ctrl.currentList.documentId : null};
        $ctrl.onCloseScratchpad = function (result) {
            console.log('onCloseScratchpad');
        }
        var tag = 'document-scratchpad';
        return '<' + tag + ' class="clearfix document-version-notes ' + tag + ' ' + ($ctrl.isPopup ? '' : 'inline display-block h-full ') + '" extra-param="::$ctrl.extraScratchpadParams" comp-options="::$ctrl.compOptions" on-close="$ctrl.onCloseScratchpad(result)"></' + tag + '>';
    }

    function toggleScratchpad(result){
        $ctrl.document = result ? result.document : null;

        //planFetatures testmode
        var quotaType = 'avscriptOutline';
        $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), result ? {e: result.e} : null);
        function process() {
            $ctrl.toggleInnerSidebar();
        }
    }

    function hasTwoSidebars(){
        //todo :: mobile??
        return $ctrl.has2Sidebars && $ctrl.canEdit;
    }

    function showBottomButtons(){
        return false;
    }
    function afterProcessUpdatesOther1(result){
        if(result ){
            if( result.type === 3){ //isremove
                //get the removed rows
                var rowIds = _.filter(result.removedItems, {type: $ctrl.ShotTypes.Shot}).map(function (r){return r._id;});
                if (rowIds && rowIds.length) {
                    updateGroupComments(true, rowIds);
                }
            }
        }

        var items = _.filter($ctrl.list.items, {type: $ctrl.ShotTypes.Shot}),
            todoPageId = getTodoPageId();
        if(items.length && todoPageId){
            $ctrl.broadcastRoot('GROUP_COMMENTS_UPDATE_ORDER_' + todoPageId, items);
        }
    }

    function showCommentsBtn(item){
        return item && item.type === $ctrl.ShotTypes.Shot;
    }

    function getComments(isHeader, item, cls) {
        var hide = $ctrl.isPrintLayout || !$ctrl.canComment;
        return showCommentsBtn(item) ? (
            '<div class="' + (cls || '') + (isHeader ? '' : ' vtop one-line-tooltip') + '">'+
                 (isHeader ? '&nbsp;' : ('<a class="btn btn-small transparent3 without-text ' +
                             (hide ? '' : $ctrl.getClickEventName('viewComments')) +
                     '"' +
                     (hide ? '' : (' tooltip="View Comments" tooltip-placement="bottom" analytics-on analytics-action="View Comments"')) +
                     '>' +
                    $ctrl.LCS.getISBDiv('conversations', 2, 'pull-left with-margin-right') + '<span class="page inline-block ' + $ctrl.SBFieldTypesService.getViewEditElemSelector('commentsCount', true, $ctrl.canComment)+'">' + item.commentsCount + '</span>' +
                 '</a>'))+
            '</div>'
        ) : '';
    }

    function getRowMobileActions(item) {
        return showCommentsBtn(item) ? [{
            type: 'viewComments',
            action: 'View Comments',
            icon: 'conversations'
        }] : null;
    }

    function getTodoPageId(){
        if (!$ctrl.todoPage) {
            $ctrl.todoPage = $ctrl.BlocksSetupService.getCurrentTodoPage();
        }
        return $ctrl.todoPage ? $ctrl.todoPage._id : null;
    }

    function updateGroupComments(isClear, data) {
        var todoPageId = getTodoPageId();
        if (todoPageId) {
            //GROUP_COMMENTS_CLEAR_ , GROUP_COMMENTS_
            $ctrl.broadcastRoot('GROUP_COMMENTS_' + (isClear ? 'CLEAR_' : '') + todoPageId, data);
        }
    }

    function setSidebarClass(isAdd){
        $ctrl.LCS[isAdd ? 'addClass' : 'removeClass']($ctrl.LCS.$document[0].querySelector('.comments-sidebar-inner .comments-tab'), 'with-group-comment');
    }

    function viewComments(item) {
        console.log('viewComments');

        var id = item ? item._id : undefined;
        var isCurrent = false;//$ctrl.currentCommentGroupId === id;

        $ctrl.CommentsSidebarService.toggleComments($ctrl.componentId, $ctrl.LCS.SidebarTypes.ListComments, !isCurrent);
        //$ctrl.broadcastRoot('COMMENTS_SIDEBAR_TOGGLE', !isCurrent);

        $ctrl.currentCommentGroupId = isCurrent ? null : id;
        setSidebarClass(!isCurrent);

        if(!isCurrent){
            $ctrl.LCS.timeout(function () {
                if($ctrl.currentCommentGroupId === id) {
                    updateGroupComments(false, item);
                    var wrapper = $ctrl.element.querySelector('.flex-wrap');
                    if(wrapper) {
                        $ctrl.LCS.addClass($ctrl.getItemEl(id, ' .sb-click-viewComments', wrapper), 'selected');
                    }
                }
            }, 300);
        }
    }

    function onGroupSetupsInitOther2(){
        setResizable();
    }

    function setResizable(l) {
        if(!$ctrl.isPrintLayout) {
            resize();
            $ctrl.addRootWatcherSimple($ctrl.LCS.onWindowWidthChanged(resize));
            $ctrl.LCS.onToggleInnerSidebar($ctrl.SBStateService.currentState.name, resize);
        }
    }

    function resize() {
        if(!$ctrl.isResizing) {
            $ctrl.isResizing = true;

            $ctrl.LCS.timeout(function () {
                var withCommentsCls = parseInt(window.getComputedStyle($ctrl.element).width, 10) > 1280;
                if (withCommentsCls !== $ctrl.withCommentsCls) {
                    $ctrl.LCS[withCommentsCls ? 'addClass' : 'removeClass']($ctrl.element, 'comments-right-padding');
                    $ctrl.withCommentsCls = withCommentsCls;
                }
                $ctrl.isResizing = false;
            }, 200);
        }
    }

    function getKeyboardSelectedRows(action, data) {
        //on remove segment remove all the rows and banners
        var setupId = action === $ctrl.keyboardService.ActionTypes.Delete && data && data.item && data.item.type === $ctrl.ShotTypes.Setup ? data.item._id : null;
        return setupId ? get() : $ctrl.keyboardService.SelectedRows;

        function get() {
            return _.filter($ctrl.list.items, function (item) {
                return item._id === setupId || item.setupId === setupId;
            }).map(function (item) {
                return {id: item._id, sId: $ctrl.currentListId};
            });
        }
    }

    function additionalTargetCheckings(e) {
        //console.log('additionalTargetCheckings');
        var isCtrl = $ctrl.keyboardService.isCtrl,
            isShift = $ctrl.keyboardService.isShift,
            isLeft = e.keyCode === 37,
            isUp = e.keyCode === 38,
            isRight = e.keyCode === 39,
            isDown = e.keyCode === 40,
            isEnter = e.keyCode === 13,
            isDelete = e.keyCode === 8,
            isBackslash = e.keyCode === 220;

        if (!(isCtrl && (isLeft || isRight || isEnter || isUp || isDown || isDelete || isShift || isBackslash))) {
            return;
        }

        if (process()) {
            $ctrl.preventDefault(e);
            return true;
        }

        return false;

        function process() {
            var rowSchedule = $ctrl.LCS.findClosestParent(e.target, '.'+$ctrl.itemSelector);
            if (!rowSchedule) {
                return false;
            }

            var id = rowSchedule.getAttribute('data-id');
            if (isEnter) {
                $ctrl.create($ctrl.list.getElementById(id), $ctrl.ShotTypes.Shot, null, null, null, e);
                return true;
            } if (isShift) {
                $ctrl.create($ctrl.list.getElementById($ctrl.list.getElementById(id).setupId), $ctrl.ShotTypes.Setup, null, null, null, e);
                return true;
            } if (isBackslash) {
                $ctrl.create($ctrl.list.getElementById(id), $ctrl.ShotTypes.Banner, null, null, null, e);
                return true;
            }if (isDelete) {
                $ctrl.remove($ctrl.list.getElementById(id));
                return true;
            } else {
                var col = $ctrl.LCS.findClosestParent(e.target, '.with-sb-edit');
                if (col) {
                    var itemIndex = $ctrl.list.getElementIndexById(id),
                        lastIndex = $ctrl.list.items.length - 1,
                        tabIndex = getIndex(col, false);
                    if (isRight || isDown) {
                        if(isDown){
                            //set focus on the same tabIndex from next item THAT is a shot
                            if (getNextRow(tabIndex)) {
                                return true;
                            }
                        } else {
                            var tabNextIndex = getIndex(col, true);
                            if (tabNextIndex) {
                                $ctrl.triggerFocus(id, tabNextIndex);
                                return true;
                            } else {
                                //set focus on first tab from next item THAT is a shot
                                if (getNextRow(1)) {
                                        return true;
                                }
                            }
                        }

                    } else if(isLeft || isUp) {
                        if (isUp) {
                            //set focus on the same tabIndex from previous item THAT is a shot
                            if (getPrevioustRow(tabIndex)) {
                                return true;
                            }
                        } else {
                            var c = _.find($ctrl.columnsList, function (c) {
                                    return c.tabNextIndex === tabIndex;
                                }),
                                tabPreviousIndex = c ? c.tabIndex : null;
                            if (tabPreviousIndex) {
                                $ctrl.triggerFocus(id, tabPreviousIndex);
                                return true;
                            } else {
                                //set focus on last tab from previous item that is a shot
                                if (getPrevioustRow(2)) {
                                    return true;
                                }
                            }
                        }
                    }

                    function getNextRow(tabIndex){
                        if (itemIndex < lastIndex - 1) {
                            for (var i = itemIndex + 1; i <= lastIndex; i++) {
                                if (trigger(i, tabIndex)) {
                                    return true;
                                }
                            }
                        }
                        return false;
                    }

                    function getPrevioustRow(tabIndex){
                        var itemIndex = $ctrl.list.getElementIndexById(id);
                        if (itemIndex > 0) {
                            for (var i = itemIndex - 1; i >= 0; i--) {
                                if (trigger(i, tabIndex)) {
                                    return true;
                                }
                            }
                        }
                        return false;
                    }
                }
            }

            return false;

            function trigger(index, tabIndex) {
                var el = $ctrl.list.getElementByIndex(index);
                if (el && el.type === $ctrl.ShotTypes.Shot) {
                    $ctrl.triggerFocus(el._id, tabIndex);
                    return true;
                }
                return false;
            }

            function getIndex(col, isNext) {
                var index = col.getAttribute('tab-' + (isNext ? 'next-' : '') + 'index');
                return index ? parseInt(index, 10) : 0;
            }
        }
    }

    function getItemTitleForMovePopup(item, id) {
        var isSetup = item.type === $ctrl.ShotTypes.Setup;
        return {
            name: (isSetup ? ($ctrl.setupTypeName + ' ') : '') + item.segNo + '.' + (isSetup ? (' ' + getTxt(item.name)) : (item.rowNo + ' ' + getFirst(item.audio))),
            _id: item._id,
            active: item._id === id,
            type: item.type
        };

        function getTxt(n) {
            return n ? $ctrl.LCS.createFragment('<div>' + n + '</div>').children[0].innerText : '';
        }

        function getFirst(n) {
            var el = getTxt(n);
            return el && el.length > 50 ? (el.substring(0, 50) + '…') : el;
        }
    }

    function getGroupEmptyButtons() {
        return $ctrl.getGroupEmptyButtonsInit('Add ' + $ctrl.setupTypeName, 'null, ' + $ctrl.ShotTypes.Setup);
    }

    function getCustomNextToCheckbox(item) {
        if(item.type === $ctrl.ShotTypes.Setup || $ctrl.LCS.isMobileSize || !$ctrl.canEdit){return '';}
        var c = $ctrl.getColumnByProp('color');
        return c ? $ctrl.SBFieldTypesService.getColDisplayDiv($ctrl, item, _.extend({}, c, {
            withoutClose: true
        })) : '';
    }

    function getColsHeader(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
        return processc($ctrl.ShotTypes.Header, item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);
    }

    function getColsSetup(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
        return processc($ctrl.ShotTypes.Setup, item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);
    }

    function getColsBanner(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
        return processc($ctrl.ShotTypes.Banner, item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);
    }

    function processListItemColumnInit(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
        return processc($ctrl.ShotTypes.Shot, item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);
    }

    function editP(tabIndex, e){
        $ctrl.edit($ctrl.item, ' + tabIndex + ')
    }

    function processc(type, item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails){
        switch(type) {
            case $ctrl.ShotTypes.Header:
                return getHeader();

            case $ctrl.ShotTypes.Shot:
                return getShot();

            case $ctrl.ShotTypes.Setup:
                return getSetup();

            case $ctrl.ShotTypes.Banner:
                return getBanner();
        }

        function getColor(){
            return (typeof($ctrl.getPreRowFront) === 'function') ? $ctrl.getPreRowFront(false, item, true) : '';
        }

        function getHeader(){
            var name = $ctrl.getColumnByProp('name', true);
            return '<div class="stretchy-wrapper text-center full-width">' +
                (canEdit ? ('<a class="with_underline banner-content ' + $ctrl.getBtnActionCls()+'" data-type="editP" data-info="' + name.tabIndex + '">') : '') +
                '<span class="' + $ctrl.getViewEditElemSelector('name') + (!item.name ? ' hide-print" ' : '') + '">' + (item.name || '') + '</span>' +
                $ctrl.getNote(item, textOnly, true) +
                (canEdit ? '</a>' : '') +
                '</div>';

        }

        function getShot() {
            switch (c.prop) {
                case 'color':
                    return getColor();

                case 'rowNo':
                    //segNo + '.' + 'shotNo'
                    //wordCount
                    var runtime = $ctrl.getColumnByProp('runtime');
                    return '<div class="' + c.colCls + '">' + getNo(c) + '</div>';

                case 'status':
                    return getCS(c, c.colCls + ' bigger-check', canEdit);

                /*    case 'duration':
                        //duration and runtime

                        return '<div class="' + c.colCls + '">' +
                            getInfo(c) +
                            '</div>';
    */
                case 'logo':
                    return textOnly ? '' : $ctrl.getLogo(item, c.prop, cls);

                case 'segNo':
                case 'note':
                case 'runtime':
                case 'wordCount':
                case 'totalWordCount':
                    return '';

                case 'commentsCount':
                    return isMobile ? '' : getComments(false, item, cls);

                default:
                    return getCS(c, null, canEdit);
            }
        }

        function getSetup(){
            var cls = 'text-center',
                duration = $ctrl.getColumnByProp('duration'),
                runtime = $ctrl.getColumnByProp('runtime'),
                wordCount = $ctrl.getColumnByProp('wordCount');

            switch (c.prop) {
                case 'name':
                    return getInfo(_.extend({}, c, {name: 'End of ' +$ctrl.setupTypeName + ' ' + item.segNo}), 'grow-column');

                case 'duration':
                    return duration ? getInfo(_.extend({}, c, {name: 'Segment RT'}), cls) : '';

                case 'wordCount':
                    return wordCount ? getInfo(_.extend({}, c, {name: 'Segment Words'}), cls + ' col100 vertical-after') : '';

                case 'runtime':
                    return runtime ? getInfo(_.extend({}, c, {name: 'Total RT', colCls: 'totalc'}), cls) : '';

                case 'totalWordCount':
                    return wordCount ? getInfo(_.extend({}, c, {name: 'Total Words', colCls: 'totalc'}), cls) : '';

                default:
                    return '';
            }
        }

        function getBanner() {
            switch (c.prop) {
                case 'name':
                    return getNameAndNote(true);

                default:
                    return '';
            }
        }

        function getNameAndNote(isBanner){
            var el = getColInfo('name', !isMobile, true, 'display-block full-width bold font-general ' + (isBanner ? 'font-general-16' : 'font-general-18'), {
                    wrapperClass:'centered',
                    openPopup: !isMobile,
                    eClassAttr:  isBanner ? 'text-center' : ''
                }) +
                ((canEdit || !canEdit && item.note) ?
                    getColInfo('note', false, false, 'display-block full-width italic', {
                        hideEmptyContent: true,
                        wrapperClass:'centered'
                    }) : '');

            return textOnly ? el : ('<div class="title-cell grow-column text-center">' + el + '</div>');
        }

        function getColInfo(prop, canEdit, isAll, cls, other) {
            return getInline($ctrl.getColumnByProp(prop, isAll), prop, canEdit, cls, other);
        }

        function getInline(c, prop, canEdit, cls, other) {
            return get(_.extend({}, c, {canEdit: canEdit},
                canEdit ? {editableContainerClass: 'without-height-padding'} : null,
                other,
                prop === 'name' ? {placeholder: 'Name'} : null),   cls || 'inline-block') ;
        }

        function get(c, nCls){
            return c ? $ctrl.getDisplayItemCol(item, c, nCls ? nCls : cls, canEdit, textOnly, isMobile, isMobileRowDetails) : '';
        }

        function getInfo(c, cls) {
            if (!c) {
                return '';
            }

            return '<div class="av-duration-col vtop '+ (c.colCls?c.colCls:'') + ' ' + (cls||'')+' ">' +
                    '<div class="labelField full-width clearfix">' + c.name + '</div>' +
                    '<div class="textField full-width clearfix">' +
                        $ctrl.getDisplayItemCol(item, _.extend({}, c, _.extend({
                            canEdit: false,
                            editableContainerClass: 'without-height-padding'
                        }, cls && cls.indexOf('text-center')!==-1 ? {
                            wrapperClass :'centered'
                        } : null )), ' ', false, textOnly, isMobile, isMobileRowDetails) +
                    '</div>' +
                '</div>';
        }

        function getNo(rowNo) {
            var segNo = $ctrl.getColumnByProp('segNo'),
                hasNo = rowNo || segNo;
            return (hasNo ? getRowNo() : '') +
                '<div class="full-width wc">' +
                getCount(item, 'wordCount', ' word', true, hasNo ? 'with-border' : '') +
                getCount(item, 'runtime', ' RT') +
                '</div>';

            function getRowNo(){
               return '<div class="full-width shotnoprop bold">' +
                   getProp(segNo, null, true) +
                   (rowNo && segNo ? '.' : '') +
                   getProp(rowNo) +
                   '</div>';
            }

            function getCount(item, prop, label, withplural, cls) {
                var c = $ctrl.getColumnByProp(prop),
                    count = c && item[c.prop] ? item[c.prop] : 0;
                return c ? ('<div class="full-width wordwrapper ' + (cls || '') + '">' +
                    getProp(c, 0) + label + (withplural ? ('<span class="' + prop + 'S' + (count === 1 ? ' sb-hide' : '') + '">s</span>') : '') +
                    '</div>') : '';
            }

            function getProp(c, other, withSetup) {
                var v = item[c.prop];
                if(c.type === $ctrl.SBFieldTypesService.PropTypes.Duration){
                    v = $ctrl.SBFieldMethods.getEstVal(v, {isDuration:true});
                } else if(c.type === $ctrl.SBFieldTypesService.PropTypes.Timecode){
                    v = $ctrl.SBFieldMethods.getEstVal(v, {isTimecode: true});
                } else if(c.type === $ctrl.SBFieldTypesService.PropTypes.TimecodeRange){
                    v = $ctrl.SBFieldMethods.getEstVal(v, {isTimecode: true, isRange: true});
                }
                return c ? ('<span class="' + $ctrl.getViewEditElemSelector(c.prop) + '"' + (withSetup ? (' data-setup="' + item.setupId + '"') : '') + '>' +
                    (v || (other !== undefined ? other : '–')) + '</span>') : '';
            }
        }

        function getCS(c, cls1, canEdit) {//to set the status to editable on mobile
            return getC(item, c, cls1 || cls, canEdit, textOnly, canEdit ? false : isMobile, isMobileRowDetails);
        }

        function getC(item, c, cls, canEdit, textOnly, isMobile, isMobileRowDetails) {
            return $ctrl.getDisplayItemCol(item, c, cls, canEdit, textOnly, isMobile, isMobileRowDetails);
        }
    }
}

angular.module('product.avscript.group.withSetup.service', [])
.service('GroupWithSetupCtrlService', GroupWithSetupCtrlService);
function GroupWithSetupCtrlService() {
    return function ($ctrl) {
        $ctrl.headerSetupCls = 'nextSetup';

        //$ctrl.createMethodNameInMore = 'create';
        if(!$ctrl.getCount) {
            $ctrl.getCount = getCount;
        }
        $ctrl.onAdded = onAdded;
        $ctrl.afterProcessUpdatesOther = afterProcessUpdatesOther;
        $ctrl.getMessageForDeleted = getMessageForDeleted;

        $ctrl.showPrefrontRow = showPrefrontRow;
        $ctrl.onGroupSetupInitOther = onGroupSetupInitOther;
        $ctrl.getDisplayRootCount = getDisplayRootCount;
        $ctrl.getTopOfHeader = getTopOfHeader;
        $ctrl.create = create;
        $ctrl.onReloadGroupTemplateOther = onReloadGroupTemplateOther;

        if(!$ctrl.showDescBlock) {
            $ctrl.showDescBlock = showDescBlock;
        }

        if(!$ctrl.isAddInline){
            $ctrl.isAddInline = isAddInline;
        }

        $ctrl.getDescBlock = getDescBlock;
        $ctrl.triggerFocus = triggerFocus;

        if(!$ctrl.showBottomButtons) {
            $ctrl.showBottomButtons = showBottomButtons;
        }
        $ctrl.getSetups = getSetups;

        if(!$ctrl.hasTasksReorder) {
            $ctrl.hasTasksReorder = hasTasksReorder;
        }

        $ctrl.openTasksReorder = openTasksReorder;

        return $ctrl;

        function hasTasksReorder(){
            return false;
        }

        function showBottomButtons() {
            return true;
        }

        function isAddInline(type){
            return type === $ctrl.ShotTypes.Shot;
        }

        function getCount() {
            if(!$ctrl.withTreeDisplayCount){return $ctrl.getCountInit();}

            var d = 0, dif = 0, l = [];
            g($ctrl.ShotTypes.Shot, false, true);

            if (!$ctrl.withoutAddBanner) {
                g($ctrl.ShotTypes.Banner, false, false);
            }

            g($ctrl.ShotTypes.Setup, true, false);

            return {totalCount: d, dif: dif, counterText: l.length > 0 ? l.join('&nbsp;•&nbsp;') : ''};

            function g(type, isLast, set) {
                var c = _.filter($ctrl.list.items, {type: type}).length;
                if (set) {
                    d = c;
                } else {
                    dif += c;
                }

                if (c) {
                    l.push(c + ' ' + $ctrl.getShotTypeName(type) + (c === 1 ? '' : 's'));
                }
            }
        }

        function onAdded(result) {
            var item = result ? result.item : null
            if (!item) {
                return;
            }

            switch (item.type) {
                case $ctrl.ShotTypes.Setup:
                    updateSegNo(item);

                    _.each($ctrl.list.items, function (el) {
                        if (el.type === 0 && el.order > item.order) {
                            updateSegNo(el);
                        }
                    });

                    //set focus on first item after the setup that is shot and belongs to the setup
                    var added = result && result.updatesG && result.updatesG.avscripts && result.updatesG.avscripts.add ? _.sortBy(result.updatesG.avscripts.add, 'order') : null;
                    if (added && added.length > 0) {
                        //takes too long
                        setFocus(added[0], 1200);
                    }
                    break;

                case $ctrl.ShotTypes.Shot:
                    //set focus in the first editable field
                    setFocus(item);
                    break;
            }

            if($ctrl.onAddedOther) {
                $ctrl.onAddedOther(result);
            }

            function setFocus(item, delay) {
                if ($ctrl.canEdit) {
                    var tabIndex = 0, c;
                    while (tabIndex < 5) {
                        if(!$ctrl.dontScrollInView){
                            $ctrl.LCS.timeout(function () {
                                var el = $ctrl.getItemEl(item._id);
                                if (el) {
                                    el.scrollIntoView({behavior: "smooth", block: "center"});
                                }
                            }, 300);
                        }
                        c = _.find($ctrl.columnsList, {tabIndex: ++tabIndex});
                        if (c) {
                            $ctrl.LCS.timeout(function () {
                                $ctrl.triggerFocus(item._id, c.tabIndex);

                            }, delay !== undefined ? delay : 100);

                            break;
                        }
                    }
                }
            }
        }

        function triggerFocus(id, tabIndex) {
            $ctrl.broadcastRoot('GRID_ITEM_FIELD_FOCUS_' + $ctrl.elemType + '_' + id, tabIndex);
        }

        function updateSegments (result) {
            //console.log('onOrderChanged');
            var updates = _.extend({}, result.updates), ids = {};
            for (var id in updates) {
                var item = updates[id];
                if(item) {
                    process(item.setupId);
                }
            }

            for (var id in updates) {
                var item = updates[id];
                if (item) {
                    if (!ids[id] && !item.setupId && item.segNo !== undefined) {
                        process(id);
                    }
                }
            }

            for (var id in ids) {
                updateSegNo(ids[id]);
            }

            function process(setupId) {
                if (setupId && !ids[setupId]) {
                    var setup = updates[setupId];
                    if (setup && setup.segNo) {
                        ids[setupId] = {_id: setupId, segNo: setup.segNo};
                        delete updates[setupId];
                    }
                }
            }
        }

        function afterProcessUpdatesOther(result, initResult) {
            if (!result) {return;}
            if (result.type === 3) {//onremove
                                        // av scripts                                                           //tasks
                onRemoved(initResult && initResult.removedItems ? initResult.removedItems : result.removedItems);
            } else if (result.updateOrder) {//onOrderChanged
                updateSegments(result);
                removeLastSegmentLowerTitle();
            }

            if($ctrl.afterProcessUpdatesOther1){
                $ctrl.afterProcessUpdatesOther1(result, initResult);
            }

            function removeSegment(item){
                removeNextSetup(item);
                updateSegNo(item);
            }

            function onRemoved(removedItems) {
                //console.log('onRemoved');
                var setups = getSetups(removedItems);
                if (setups) {
                    $ctrl.LCS.timeout(function () {
                        _.each(setups, removeSegment);
                    }, 200);

                    _.each(getSetups($ctrl.list.items), updateSegNo);
                }

            }

            function removeLastSegmentLowerTitle() {
                var setups = $ctrl.getSetups($ctrl.list.items),
                    lastSetup = setups.length > 0 ? setups[setups.length - 1] : null;
                if (lastSetup) {
                    $ctrl.LCS.timeout(function () {
                        removeNextSetup(lastSetup);
                    }, 200);
                }
            }
        }

        function removeNextSetup(item) {
            if(item) {
                var el = $ctrl.element.querySelector('.' + $ctrl.headerSetupCls + '[data-current="' + item._id + '"]');
                $ctrl.LCS.removeElement(el);
            }
        }

        function getSetups(list){
            return list ? _.filter(list, function (item) {
                return item.type === $ctrl.ShotTypes.Setup;
            }) : null;
        }

        function updateSegNo(item, delay) {
            var prop = 'segNo',
                propCls = ' .' + $ctrl.SBFieldTypesService.getPropMark(prop) + '[data-setup="' + item._id + '"]';

            $ctrl.LCS.timeout(function () {
                process($ctrl.element, '.row-schedule.scene');
                process($ctrl.LCS.$document[0], '.comments-sidebar-inner .taskcard-group .shotnoprop ');
            }, 220);

            function process(parent, query) {
                var els = parent.querySelectorAll(query + propCls);
                if (els) {
                    _.each(els, function (el) {
                        el.innerText = item[prop];
                    });
                }
            }
        }

        function getMessageForDeleted(item){
            return item.type === $ctrl.ShotTypes.Setup ? $ctrl.messageForDeleted : null;
        }

        function onGroupSetupInitOther() {
            if ($ctrl.canEdit) {
                $ctrl.addRootWatcher('ADD_ITEM_IN_' + $ctrl.setupType + '_' + $ctrl.currentListId, onAddItemInSegment);
                $ctrl.addRootWatcher('ADD_' + $ctrl.setupType + '_' + $ctrl.currentListId, onAddSegmentAtTheEnd);
                if ($ctrl.hasTasksReorder()) {
                    $ctrl.addRootWatcher('REORDER_'+$ctrl.setupType+'_'+$ctrl.currentListId, $ctrl.openTasksReorder);
                }
            }

            if($ctrl.onGroupShotsInitOther2){
                $ctrl.onGroupShotsInitOther2();
            }
            //toggleComments($ctrl.componentId, sidebarType, isOpen, isInstall)
        }

        function openTasksReorder(p) {
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations.tasksReorder, _.extend({
                setups: getSetups($ctrl.list.items)
            }, p), $ctrl.compOptions, null, onConfirm);

            function onConfirm(setups) {
                console.log('onclose openTasksReorder');

                var propForOrder = 'order',
                    originalOrder = {};
                _.each($ctrl.list.items, function (item) {
                    originalOrder[item._id] = item[propForOrder];
                });
                var ids = [];
                _.each(setups, function (setup) {
                    ids = ids.concat(_.sortBy(_.filter($ctrl.list.items, {
                        type: 1,
                        setupId: setup._id
                    }), propForOrder).map(function (item) {
                        return item._id;
                    }));
                    ids.push(setup._id);
                });
                var updates = {}, hasChanges;
                _.each(ids, function (id, i) {
                    var newOrder = i + 1;
                    if (originalOrder[id] !== newOrder) {
                        updates[id] = newOrder;
                        hasChanges = true;
                    }
                });
                if (hasChanges) {
                    var lists = [$ctrl.currentListId],
                        listIds = {};
                    listIds[$ctrl.listField] = lists;
                    $ctrl.changeOrderServerSide({
                        updates: updates,
                        listIds: listIds
                    }, lists);
                }
            }
        }

        function onAddSegmentAtTheEnd(){
            var setups = $ctrl.list.items ? _.filter($ctrl.list.items,{type:$ctrl.shotTypes.Setup}) : [];
            onAddItemInSegment({
                after: setups.length ? setups[setups.length - 1] : null,
                type: $ctrl.shotTypes.Setup
            });
        }

        function onAddItemInSegment(result) {
            console.log('onAddItemInSegment');
            if (!result) {return;}
            var otherParams =  {e: result.e};
            if(typeof($ctrl.canAddSegments) === 'function'){
                $ctrl.canAddSegments(result, process, otherParams);
            } else{
                process();
            }

            function process(){
                $ctrl.create(result.after, parseInt(result.type, 10), result.more, null, null, result.e);
            }
        }

        function showPrefrontRow() {
            return false;
        }

        function getDisplayRootCount(){
            return _.filter($ctrl.list.items, {type: $ctrl.ShotTypes.Shot}).length;
        }

        function getTopOfHeader(){
            return '<div class="full-width top-of-header"></div>';
        }

        function create(after, type, moreNewItemData, addInline, isDuplicate, e) {
            if(typeof(type) === 'string') {
                type = parseInt(type, 10);
            }
            if(!addInline) {
                addInline = type === $ctrl.ShotTypes.Shot;
            }
            return $ctrl.createInit(after, type, isDuplicate ? _.extend({}, $ctrl.getMoreNewItem(moreNewItemData), {isDuplicate: isDuplicate}) : $ctrl.getMoreNewItem(moreNewItemData), addInline, isDuplicate, e);
        }

        function setCounter() {
            var body = $ctrl.LCS.findClosestParent($ctrl.element, '.bodyWrapper');
            if(!body){return;}

            var els = body.querySelectorAll('.' + $ctrl.counterTextCls.replace(' ', '.') + ':not(.subtitle)');
            if (els) {
                var counterText = $ctrl.getCount().counterText;
                _.each(els, function (el) {
                    el.innerHTML = counterText || '';
                });
            }
        }

        function onReloadGroupTemplateOther() {
            setCounter();
            // $ctrl.getDescBlock();
        }

        function showDescBlock() {
            return true;
        }

        function getDescBlock() {
            var prop = 'notes';
            return !$ctrl.currentList[prop] && !$ctrl.canEdit ? '' : ('<div class="display-block subtitle full-width desc sb-prop-list-' + prop + '">' + ($ctrl.currentList[prop] || '') + '</div>');
        }
    }
}

angular.module('product.avscript.item.grid.component', [
    'product.avscript.item.withSetup.service'
])
.component('avscriptItemGrid', itemGridComponentParams({
    shotTypes: '<',
    isComp: '<',
}, 'AvscriptItemCtrl','<div class="row-schedule scene"></div>'))
.controller('AvscriptItemCtrl', AvscriptItemCtrl);
AvscriptItemCtrl.$inject = ['GridItemGroupInitCtrlService', 'GridItemWithSetupCtrlService', '$element'];
function AvscriptItemCtrl(GridItemGroupInitCtrlService, GridItemWithSetupCtrlService, $element) {
    //console.log('AvscriptItemCtrl');
    var $ctrl = this;

    $ctrl.createMethodName = 'create'; //is overwritten

    $ctrl.preLoadingTableNameInit = 'Avscripts';
    $ctrl.setupTypeName = 'Segment';
    $ctrl.changedFields = ['item', 'listOptions'];
    $ctrl.bindingNames = [$ctrl.createMethodName, 'viewComments'];
    $ctrl.segmentProps = ['name', 'note'];
    $ctrl.triggerEditSegment = true;

    $ctrl.isCurrentListItem =isCurrentListItem;
    $ctrl.preInitGridItemOther = preInitGridItemOther;
    $ctrl.updateEditableItemPropsAllOther = updateEditableItemPropsAllOther;
    $ctrl.getHeaderSegmentContent = getHeaderSegmentContent;
    $ctrl.getBottomBtns = getBottomBtns;

    $ctrl.getSetupCounter = getSetupCounter;

    $ctrl = new GridItemWithSetupCtrlService($ctrl);

    $ctrl = new GridItemGroupInitCtrlService($ctrl, $element, {
        itemId: $ctrl.itemId
    });

    function getSetupCounter(setup){
        return 'Total RT ' + $ctrl.SBFieldMethods.getEstVal(setup.runtime, {isDuration:true}) + ' • Total Words: ' + (setup.totalWordCount || 0);
    }

    function getBottomBtns() {
        return '<div class="row-btns hide-ipad hide-print form-group field last spacing-half-top full-width">' +
            '<div class="form-group field full-width bottom-buttons-inline in-setup">' +
            get(1, 'Row', 'Row') + //'<span class="underlined">R</span>ow'
            get(2, 'Banner', '<span class="underlined">B</span>anner') +

            //get(0, 'Segment', 'Segmen<span class="underlined">t</span>') +
            get(0, $ctrl.setupTypeName, '<span class="underlined">S</span>egment') +
            '</div>' +
            '</div>';

        function get(type, name, label) {
            return '<a class="small inline-block semibold ' + $ctrl.getClickEventName($ctrl.createMethodName) + '" data-type="'+$ctrl.createMethodName+'" data-info="' + type + '" analytics-on analytics-action="Open Create ' + name + '">' + $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left with-margin-right') + ' <span>' + label + '</span>' + '</a>';
        }
    }

    function getHeaderSegmentContent(seg){
        var segNo = seg ? seg.segNo.toString() : null;
        var name = seg ? seg.name : null;
        var note = seg ? seg.note : null;
        return '<div class="full-width text-center">' +
            '<div class="font-size-18 bold clearfix' +
                                                        //bind edit segment on click
            ($ctrl.canEdit ? (' with-cursor with_underline editSegment" data-info="' + seg._id) : '') +
            '">' +
                '<span class="sb-hide">' + $ctrl.setupTypeName +' <span class="sb-prop-segNo inline-block">' + segNo + '</span><span class="has-sb-prop-name ' + (name ? '' : 'sb-hide') + '"> — </span>' +
                '</span><span class="sb-prop-name inline-block ">' + (name||'') + '</span>' +
                '</div>' +
                '<div class="italic clearfix sb-prop-note clearfix">' + (note||'') + '</div>' +
            '</div>';
    }

    function isCurrentListItem(item){
        return item.documentVersionId === $ctrl.currentListId;
    }

    function updateEditableItemPropsAllOther(changes) {
        if ($ctrl.item.type !== $ctrl.shotTypes.Shot) {
            return;
        }

        var prop = 'audio';
        if ($ctrl.hasPropChanged(changes, prop)) {
            var el = $ctrl.element.querySelector('.' + $ctrl.SBFieldTypesService.getPropMark('wordCount'));
            if (el) {
                el.innerText = $ctrl.item.wordCount;
            }
            el = $ctrl.element.querySelector('.wordCountS');
            if (el) {
                el.innerText = $ctrl.item.wordCount === 1 ? '' : 's';
            }
        }


        var sidebarCls = '.comments-sidebar-inner .taskcard-group[data-comment-group-id="' + $ctrl.item._id + '"] .shotnoprop ';
        prop = 'rowNo';
        if ($ctrl.hasPropChanged(changes, prop)) {
            var el = $ctrl.LCS.$document[0].querySelector(sidebarCls + '.' + $ctrl.SBFieldTypesService.getPropMark(prop));
            if (el) {
                el.innerText = $ctrl.item[prop];
            }
        }

        $ctrl.updateSetupId(changes, $ctrl.LCS.$document[0], sidebarCls);
    }

    function preInitGridItemOther() {
        //LIST_FILTERS_COLUMN
        $ctrl.otherListFilters = [
            //    {prop: 'COLUMN', value: 'column'}
        ];

        $ctrl.itemId = $ctrl.item._id;
    }
}


