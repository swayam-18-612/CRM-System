    {text: "#BA7F00", id: "#FFEBBF", name:'Goldenrod'}, //Goldenrod: #BA7F00 font  /  BG: rgba(255,174,0,0.25)
    {text: "#967B00", id: "#FBF2D4", name:'Buff'}, //Buff: #967B00 font  /  BG: rgba(240,203,84,0.25)
    {text: "#E64F47", id: "#FCDDDC", name:'Salmon'}, //Salmon: #E64F47 font  /  BG: rgba(245,122,115,0.25)
