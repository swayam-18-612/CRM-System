        SidebarOptions: SidebarOptions,
    };
}

angular.module('components.sbImgViewerWithEditor', [
    'apiServices.Materials',
    'components.imgEditor.service'
])
.component('sbImgViewerWithEditor', {
    bindings: {
        withFullSize: '@',
        mimeType: '<',
        src: '<?',
        filename:'<',
        //version: '<?',
        canUpload: '<',
        editorOptions: '<',
        onImageEdited: '&'
    },
    controller: 'SbImgViewerWithEditorController',
})
.controller('SbImgViewerWithEditorController', SbImgViewerWithEditorController);
SbImgViewerWithEditorController.$inject = ['TemplateCompileCompCtrlService', 'DownloadExportService', 'ImgEditorService','MaterialsService', '$element'];
function SbImgViewerWithEditorController(TemplateCompileCompCtrlService, DownloadExportService, ImgEditorService, service, $element) {
    console.log('SbImgViewerWithEditorController');
    var $ctrl = this;
    $ctrl.DownloadExportService = DownloadExportService;
    $ctrl.ImgEditorService = ImgEditorService;
    $ctrl.changedFields = ['src'];
    $ctrl.imgContainerCls = '.imgviewer';

    $ctrl.$onChanges = $onChanges;

    $ctrl.onLoaded = onLoaded;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.preInit = preInit;

    $ctrl.dontAutoloadTemplate = true;

    $ctrl.withFullSize = true;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.service = service;

        if (!$ctrl.withFullSize) {
            return next($ctrl.src);
        }

        getFullSizeImg(next);

        function next(src) {
            $ctrl.imgSrc = src;
            $ctrl.isLoaded = true;
            $ctrl.reloadTemplate();
        }
    }

    function getFullSizeImg(next) {
        if ($ctrl.blob) {
            return p();
        }
        $ctrl.ImgEditorService.getFromImageUrl($ctrl.src, $ctrl.mimeType, function (blob) {
            $ctrl.blob = blob;
            p();
        });

        function p() {
            if (typeof (next)) {
                next($ctrl.blob ? $ctrl.blob.url : null);
            }
        }
    }

    function $onChanges(changes) {
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                $ctrl.reloadTemplate();
                break;
            }
        }
    }

    function onDestroy() {
        bind(false);
        if($ctrl.blob && $ctrl.blob.url){$ctrl.ImgEditorService.revokeObjectURL($ctrl.blob.url);}
    }

    function onLoaded() {
        if (!$ctrl.isLoaded) {
            return '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
        }
        if (!$ctrl.img) {
            $ctrl.img = $ctrl.element.querySelector($ctrl.imgContainerCls);
        }

        $ctrl.bindEvents = [];
        $ctrl.bindEvents.push({
            element: $ctrl.element.querySelector('.' + $ctrl.btnEditClass),
            method: editImage,
            nm: 'sbImgViewerWithEditor'
        });
        $ctrl.bindEvents.push({
            element: $ctrl.element.querySelector('.' + $ctrl.btnDownloadClass),
            method: downloadFile,
            nm: 'sbImgViewerWithEditor'
        });
        bind(true);
    }

    function downloadFile(e) {
        console.log('downloadFile');
        $ctrl.preventDefault(e);

        getFullSizeImg(function (){
            $ctrl.blob.name = $ctrl.filename || 'attachment';
            $ctrl.DownloadExportService.downloadAttachment($ctrl.blob);
        });
    }

    function editImage(e) {
        console.log('editImage');
        $ctrl.preventDefault(e);

        $ctrl.isEditMode = true;
        if (!$ctrl.editorOptions) {
            $ctrl.editorOptions = {};
        }
        $ctrl.editorOptions.existingMaterial = true;

        getFullSizeImg(next);

        function next() {
            $ctrl.ImgEditorService.edit(false, $ctrl.blob, $ctrl.editorOptions || {}, onsuccess, oncancel);

            function onsuccess(blob) {
                console.log('ImgEditorService.edit onsuccess');
                $ctrl.onImageEdited({result: blob});
            }

            function oncancel() {
                console.log('ImgEditorService.edit oncancel');
            }
        }
    }

    function getItemTemplate() {
        // '<img class="sb-hide" '+$ctrl.srcAttr+'="'+$ctrl.src+'"/> +
        return '<div class="sbup-Dashboard-FileCard-preview">' +
                    '<img class="sbup-DashboardItem-previewImg imgviewer" src="' + $ctrl.imgSrc + '"/>' +
                    ($ctrl.canUpload ? ('<div class="edit-btns-wrapper">' + getButtons() + '</div>') : '') +
                '</div>';
    }

    function getButtons() {
        $ctrl.btnEditClass = "btnEdit";
        $ctrl.btnDownloadClass = "btnDownload";
        var cls ='sbup-Dashboard-FileCard-actionsBtn pull-left ';
        return '<button class="' + cls + $ctrl.btnEditClass + '" type="button">' +
                '<svg aria-hidden="true" focusable="false" class="SbupIcon" width="26" height="26" viewBox="0 0 26 26"><path d="M8.5 17h1.586l7-7L15.5 8.414l-7 7V17zm-1.707-2.707l8-8a1 1 0 0 1 1.414 0l3 3a1 1 0 0 1 0 1.414l-8 8A1 1 0 0 1 10.5 19h-3a1 1 0 0 1-1-1v-3a1 1 0 0 1 .293-.707z" fill="currentColor" fill-rule="nonzero"></path></svg>' +
                '<span class="margin-right-20">Edit</span>' +
            '</button>' +
            '<button class="' + $ctrl.btnDownloadClass +' ' + cls + ' with-margin-left" type="button">' +
                $ctrl.LCS.getISBDiv('download', 4, 'pull-left')  +
            '</button>';
    }

    function bind(isBind) {
        if ($ctrl.bindEvents) {
            _.each($ctrl.bindEvents, function (item) {
                $ctrl.LCS.bindElementsClick(isBind, item.element, item.method, item.nm, item.event);
            })
        }
    }

    function loadOldViewer() {
        destroyViewer();
        if (!$ctrl.src) {
            return;
        }
        $ctrl.img.setAttribute($ctrl.srcAttr, $ctrl.src);
        $ctrl.viewer = new Viewer($ctrl.img, getOptions());

        $ctrl.viewer.show();

        function getOptions(){
            return {
                url: $ctrl.srcAttr,
                backdrop: false,
                fullscreen: true,
                container: $ctrl.imgContainerCls,
                keyboard: true,
                inline: true,
                loading: true,
                loop: false,
                zoomable: true,
                movable: true,
                rotatable: true,
                scalable: true,
                zoomRatio: 0.1,
                minZoomRatio: 0.01,
                title: true,
                //toolbar:['zoom-in', 'zoom-out', 'one-to-one', 'reset', 'prev', 'play', 'next', 'rotate-left', 'rotate-right', 'flip-horizontal', 'flip-vertical']
                toolbar: {
                    zoomIn: true,
                    oneToOne: true,
                    zoomOut: true,
                    rotateLeft: true,
                    rotateRight: true,
                    flipHorizontal: true,
                    flipVertical: true,
                    download: function () {
                        var a = document.createElement('a');
                        a.href = $ctrl.viewer.image.src;
                        a.download = $ctrl.viewer.image.alt;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                    }
                }
            };
        }

        function destroyViewer() {
            if ($ctrl.viewer) {
                $ctrl.viewer.destroy();
            }
        }
    }
}

angular.module('components.sbImgViewer', [
])
.component('sbImgViewer', {
    bindings: {
        src: '<?',
    },
    template: '<div class="h-full full-width sb-img-viewer">' +
                '<div class="viewer h-full full-width"></div>' +
                '<img class="imgviewer" class="sb-hide"/>' +
            '</div>',
    controller: 'SbImgViewerCtrl',
})
.controller('SbImgViewerCtrl', SbImgViewerCtrl);
SbImgViewerCtrl.$inject = ['$element'];
function SbImgViewerCtrl($element) {

    var $ctrl = this;
    $ctrl.$element = $element;
    $ctrl.element = $ctrl.$element[0];

    $ctrl.changedFields = ['src'];

    $ctrl.imgContainerCls = '.sb-img-viewer .imgviewer';
    $ctrl.srcAttr = 'data-src';

    $ctrl.loadViewer = loadViewer;
    $ctrl.destroyViewer = destroyViewer;

    $ctrl.$onInit = $onInit;
    $ctrl.$onChanges = $onChanges;
    $ctrl.$onDestroy = $onDestroy;

    function $onInit() {
        $ctrl.img = $ctrl.element.querySelector($ctrl.imgContainerCls);
        $ctrl.loadViewer();
    }

   function $onChanges(changes) {
        console.log(changes);
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                $ctrl.loadViewer();
                break;
            }
        }
    }

    function $onDestroy() {
        $ctrl.destroyViewer();
    }

    function loadViewer() {
        $ctrl.destroyViewer();
        if(!$ctrl.src){return;}
        $ctrl.img.setAttribute($ctrl.srcAttr, $ctrl.src);
        $ctrl.viewer = new Viewer($ctrl.img, {
            url: $ctrl.srcAttr,
            backdrop: false,
            fullscreen: true,
            container: $ctrl.imgContainerCls,
            keyboard: true,
            inline: true,
            loading: true,
            loop: false,
            zoomable: true,
            movable: true,
            rotatable: true,
            scalable: true,
            zoomRatio: 0.1,
            minZoomRatio: 0.01,
            title: true,
            //toolbar:['zoom-in', 'zoom-out', 'one-to-one', 'reset', 'prev', 'play', 'next', 'rotate-left', 'rotate-right', 'flip-horizontal', 'flip-vertical']
            toolbar: {
                zoomIn: true,
                oneToOne: true,
                zoomOut: true,
                rotateLeft: true,
                rotateRight: true,
                flipHorizontal: true,
                flipVertical: true,
                download: function () {
                    var a = document.createElement('a');
                    a.href = $ctrl.viewer.image.src;
                    a.download = $ctrl.viewer.image.alt;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                },
            },

        });

        $ctrl.viewer.show();
    }

    function destroyViewer() {
        if ($ctrl.viewer) {
            $ctrl.viewer.destroy();
        }
    }
}
