angular.module('user.dashboardPage.myActivity.component', [
    'user.dashboardPage.widget.component.service',
    'apiConstants.myActivity.services',
    'user.dashboardPage.myActivityGroup.component'
])
.component('myActivity', {
    bindings: getDashboardWidgetGroupBindings(),
    controller: 'MyActivityCtrl'
})
.controller('MyActivityCtrl', MyActivityCtrl);
MyActivityCtrl.$inject = ['DashboardWidgetCtrlService', 'MyActivityConstantsService', 'BlocksSetupService', '$element'];
function MyActivityCtrl(DashboardWidgetCtrlService, constantsService, BlocksSetupService,$element) {
    console.log('MyActivityCtrl');
    var $ctrl = this;

    $ctrl.DashboardWidgetCtrlService = DashboardWidgetCtrlService;
    $ctrl.BlocksSetupService = BlocksSetupService;

    $ctrl.preInitOther = preInitOther;
    $ctrl.getOtherParams = getOtherParams;
    $ctrl.preProcessGroupItems = preProcessGroupItems;
    $ctrl.onPreloadedService = onPreloadedService;

    $ctrl = new $ctrl.DashboardWidgetCtrlService($ctrl, constantsService, $element);

    function preInitOther(constantsService) {
        var c = angular.copy(constantsService);
        //on the my team page
            c.GroupSettings = _.extend({}, c.GroupSettings, {
                dragHandleOnTheSide: false,
                withoutGroupSorting: true,
                showSortingColumns: false
            }, $ctrl.isFullItem ? {
                hideGridHeader: false,
                noBorderGridHeader: true,
            } : {
                withoutBorderBottom: true
            });

        $ctrl.constantsService = c;
    }

    function preProcessGroupItems(item) {
        item.product = _.find($ctrl.products, {_id: item.productId});

        item.productName = item.product ? item.product.name : '';
        if(item.pageId) {
            item.todoPage = $ctrl.BlocksSetupService.getTodoPageByName(item.pageId);
        }
        item.todoPageId = item.pageId;
       // item.itemTitle = getItemTitle(item);
        return item;
    }

    function getItemTitle(item){
         switch(item.objectType) {
             case 'products':
                 return 'project';
         }
    }

    function getOtherParams() {
        return {teamId: $ctrl.CPS.teamId};
    }

    function onPreloadedService(err, result){
        $ctrl.other = result;
        $ctrl.products = $ctrl.other ? $ctrl.other.products : null;
    }
}

angular.module('user.dashboardPage.myActivityGroup.component', [
    'user.dashboardPage.myActivityGroup.component.service',
    'apiPagination.Activities',
    'user.dashboardPage.myActivity.item.grid.component',
    'product.workflow.item.init.controller.service'
])
.component('myactivityGroup', groupBlockComponentParams('MyActivityGroupCtrl', {
    onListItemsQuery: '&',
    preProcessGroupItems: '&',
    other: '<',
    nestedLevel: '@'
}))
.controller('MyActivityGroupCtrl', MyActivityGroupCtrl);
MyActivityGroupCtrl.$inject = ['ActivitiesPagination', 'TodoCardGridItemInitCtrlService', 'MyActivityGroupCtrlService', '$injector', '$element'];
function MyActivityGroupCtrl(Pagination, TodoCardGridItemInitCtrlService, MyActivityGroupCtrlService, $injector, $element) {
    console.log('MyActivityGroupCtrl');
    var $ctrl = this;
    $ctrl.$injector = $injector;
    $ctrl.Pagination = Pagination;
    $ctrl.TodoCardGridItemInitCtrlService = TodoCardGridItemInitCtrlService;
    $ctrl.MyActivityGroupCtrlService = MyActivityGroupCtrlService;

    $ctrl.UploadImageProp = 1115;
    $ctrl.AddEmptyFiles = 1116;
    $ctrl.AddOneEmptyFile = 11116;

    var inlistStr = 'in list';

    $ctrl.getAction = getAction;
    $ctrl.getContent = getContent;
    $ctrl.getGridItemTemplate = getGridItemTemplate;
    $ctrl.getProductPageParams = getProductPageParams;
    $ctrl.getBottomActions = getBottomActions;
    $ctrl.goToCallsheet = goToCallsheet;
    $ctrl.getColumnForPageByProp = getColumnForPageByProp;
    $ctrl.viewImage = viewImage;
    $ctrl.goToLocations = goToLocations;

    $ctrl = new $ctrl.MyActivityGroupCtrlService($ctrl, $element);

    function getItemService(item) {
        var name = SBApiNames[item.objectType];
        return name ?  $ctrl.$injector.get(name + 'Service') : null;
    }

    function getImgProp(item) {
        return item.affectedFields && item.affectedFields.length > 0 ? item.affectedFields[0] : null;
    }
    function getVersionInfo(imageId, imgProp, withV) {
        if(!imageId){return null;}
        var p = {};
        p.hasId = imageId && imageId.id;
        p[imgProp] = imageId ? imageId.path : null;
        p[imgProp + 'Id'] = p.hasId ? imageId.id : (withV ? 1 : null);
        return p;
    }

    function viewImage(item, param, e) {
        var el = e.currentTarget,
            withImg = $ctrl.LCS.hasClass(el, 'with-img'),
            id = el.getAttribute('data-id'),
            vId = el.getAttribute('data-vid'),
            src, path;
        if (withImg) {
            var img = el.querySelector('img');
            src = img ? img.getAttribute('src') : null;
        } else { //bg img
            src = el.style.backgroundImage.replace(/^url\(["']?/, '').replace(/["']?\)$/, '');
        }

        try {
            path = src.split('?')[1].split('&')[0].split('=')[1];
        } catch (e) {
        }

        if (!id || !vId || !path) {
            return;
        }
        var imgProp = getImgProp(item),
            v = getVersionInfo({path: path, id: vId}, imgProp);
        if (!v) {
            return;
        }
        v._id = id;
        v.productId = item.productId;

        console.log('sbResizableImg: view material popup');
        var listId = item.listIds ? item.listIds[0] : null,
            list = listId && $ctrl.lists && item.tableLists ? $ctrl.lists[item.tableLists] : null,
            listItems = list ? list.items : null,
            currentList = listItems ? _.find(listItems, {_id: listId}) : null,
            c = imgProp ? $ctrl.getColumnForPageByProp(item, imgProp) : null,
            withComments = c && c.withCommentsOnItem === true;

        currentList = _.extend({}, currentList, {
            todoPage: item.todoPage,
            withLikesOnItem: c && c.withLikesOnItem,
            withCommentsOnItem: withComments
            // withCommentsCount: $ctrl.withCommentsCountS === true
        }, $ctrl.security.getImageExtraInfo(v, imgProp));

        var canUpload = false,
            onImageEdited = null,
            params = _.extend({
                imgProp: imgProp,
                withComments: withComments,
                canComment: withComments ? $ctrl.canComment : false,
                withNext: false,
                canUpload: canUpload,
                currentList: currentList,
            }, canUpload ? {
                editorOptions: {
                    isAvatar: c && c.isAvatar,
                    isPoster: false,
                    startWithEditor: false
                },
                onImageEdited: onImageEdited
            } : {});

        // return $ctrl.item ? $ctrl.item[imgProp + 'Id'] : null;
        $ctrl.popupsService.open(vId, $ctrl.popupsService.operations.materialViewer, params, null, null, function (result) {
            console.log('onSuccess');
        });
    }

    function getContent(item) {
        if (!item) {
            return '';
        }
        var imgProp = getImgProp(item),
            moreThanOne = (item.affectedIds && item.affectedIds.length >0 ? item.affectedIds.length : 0)>1,
           isAddEmptyFiles = item.type === $ctrl.AddEmptyFiles ||
               item.type === $ctrl.AddOneEmptyFile;              //only one file
        if (item.type === $ctrl.UploadImageProp ||
            isAddEmptyFiles &&  !moreThanOne) {
            var img = item.imageIds && item.imageIds.length > 0 ? getImg(item.imageIds[0], -1) : null;
            return img ? ('<div class="activity-images-wrapper" >' + img + '</div>') : '';
        } else if(isAddEmptyFiles && moreThanOne){
            //each affectedid has a corresponding uId.//'path|id;path|id
            var img = item.imageIds ? item.imageIds.map(getImg).join('') : null;
            return img ?( '<div class="activity-images-wrapper grid" >' + img + '</div>') : '';
        } else {
            switch (item.objectType) {
                case 'todoCards':
                    return $ctrl.TodoCardGridItemInitCtrlService.getCommentCard(item, $ctrl, 'margin-top-quarter');

                default:
                    return '';
            }
        }
//'path|id'
        function getImg(imageId, i) {
            var isMulti = true, w= 400;
            if (i === -1) {
                i = 1;
                isMulti = false;
                w = 800;
            }
            try {
                var v = getVersionInfo(imageId, imgProp, true);
                if (!imgProp || !v) {
                    return '';
                }
                var src = $ctrl.security.getLogoPath(v, imgProp, w);
                return '<div class="single ' + (isMulti ? '' : 'with-img ') +
                    (v.hasId ? ('with-cursor ' + $ctrl.getClickEventName('viewImage')) : '') + '" ' +
                    (i >= 0 ? ('data-id="' + (isMulti ? imageId._id : item.affectedIds[0]) + '" ') : '') +
                    'data-vid="' + v[imgProp + 'Id'] + '" ' +
                    (isMulti ? ('style="background-image:url(' + src + ')"') : '') +
                    '>' +
                    (isMulti ? '' : ('<img src="' + src + '"/>')) +
                    '</div>';
            } catch (e) {
            }

            return '';

        }
    }

    function getProductPageParams(item, listId) {
        if (item) {
            switch (item.objectType) {
                case 'todoCards':
                    var p = {};
                    p[item.isOnlyComment ? 'comment' : 'card'] = item._id;
                    return p;
                default:
                    var service = getItemService(item);
                    if(service) {
                        if (service.listType === 'isList') {
                            var listField = item.todoPage.uId;
                            if(listField) {
                                var p = {};
                                if (item.affectedIds && item.affectedIds.length > 0 && listField) {
                                    p[listField] = item.affectedIds[0];
                                }
                                return p;
                            }
                        } else if (service.listType === 'isGroup' && service.listField) {
                            var p = {};
                            if (item.listIds && item.listIds.length > 0) {
                                p[service.listField] = listId === undefined ? item.listIds[0] : listId;
                            }
                            return p;
                        }
                        return '';
                    }
            }
        }
        return '';
    }

    function goToCallsheet(item, isHref, e){
        return $ctrl.redirectToPage(e, 'user.product.callsheet.view',
            $ctrl.CPS.currentPathParams({productId: item.productId, callsheetId: item.callsheetId
            //    , mode: 'design'
            }, isHref)
        );
    }

    function getColumnForPageByProp(item, prop) {
        var c = getColumnsForPage(item);
        return c ? _.find(c, function (item){return item.prop === prop;}) : null;
    }

    function getColumnsForPage(item) {
            var page = item.pageId.replace('user.product.', '').replace('user.', '');

            if(page === 'callsheet.edit' && item.objectType !== 'callsheets'){
                page = 'callsheet.edit.' + item.objectType;
            }

            var prop = 'GridColumns' + page;

            if (!$ctrl[prop] && page && SBApiGridColumns[page]) {
                $ctrl[prop] = SBApiGridColumns[page]($ctrl.SBFieldTypesService.PropTypes);
            }
            return $ctrl[prop];
    }

    function goToLocations(item, isHref, e) {
        return $ctrl.redirectToPage(e, 'user.product.locations',
            $ctrl.CPS.currentPathParams({
                productId: item.productId
            }, isHref)
        );
    }

    function getAction(item) {
        //[USER] updated the [COLUMN] for [ITEM] on [LIST] in [PROJECT] / [FEATURE]
        var updated = '',

            action = item.action,
            hasList = action.indexOf(inlistStr) !== -1,

            isUpdateAction = item.type === 2,
            isInsertAction = item.type === 1,
            //if updated get the fields
            l = item.affectedFields ? item.affectedFields.length : 0;


        if(item.callsheetId && $ctrl.callsheets) {
            var p = $ctrl.callsheets && $ctrl.callsheets.items ? _.find($ctrl.callsheets.items, function (el) {
                    return item.callsheetId === el._id;
                }) : null, str = '';

            if(item.pageId && item.pageId.indexOf('callsheet.edit')!==-1 && item.objectType === 'locations'){
                str =  'to the ' +
                (p ? ('<a class="' + $ctrl.getClickEventName('goToLocations') + '"' +
                    //' data-list="' + item.affectedIds[0] + '"' +
                    //'analytics-on analytics-action="Dashboard Activity"' +
                    '>Locations Library</a>') : '')
            } else {
                str = 'in ' + ($ctrl.callsheets.itemTitle ? ($ctrl.callsheets.itemTitle + ' ') : '') +
                    (p ? ('<a class="' + $ctrl.getClickEventName('goToCallsheet') + '" data-list="' + item.callsheetId + '"' +
                        //'analytics-on analytics-action="Dashboard Activity"' +
                        '>' + p.title + '</a>') : '');
            }
            action = action.replace(inlistStr, str);
        }

        var service = getItemService(item), isRemoveImage;

        var isUploadImage = item.type === $ctrl.UploadImageProp,
            withFields = isUpdateAction || isUploadImage;

        if (service) {
            if (service.listType === 'isList') {
                if (isUpdateAction && l > 0 && item.affectedFields.length === 1 && item.affectedFields[0] === 'name') {
                    item.affectedFields = ['name'];
                }
            } else if (service.listType === 'isGroup') {
                var v = 'user.product.';
                if (withFields && l > 0 && item.pageId && item.pageId.indexOf(v) !== -1) {//productpage
                    var columns = getColumnsForPage(item);
                    if (columns) {
                        item.affectedFieldsMapped = item.affectedFields.map(function (prop) {
                            var c = columns ? _.find(columns, {prop: prop}) : null;
                            if(c && c.type === $ctrl.SBFieldTypesService.PropTypes.Picture){
                                isRemoveImage = true;
                            }
                            return c ? (c.longName ? c.longName : (c.name ? c.name : c.shortName)) : prop
                        });
                    }
                }

                if (hasList) {
                    var rep = '';
                    if ($ctrl.lists && item.listIds && item.listIds.length > 0) {
                        var list = item.tableLists ? $ctrl.lists[item.tableLists] : null,
                            listItems = list ? list.items : null;
                        if (listItems) {
                            rep = _.filter(item.listIds.map(function (id) {
                                var p = _.find(listItems, {_id: id});
                                //get links
                                return p ?
                                    ('in ' + (list.itemTitle ? (list.itemTitle + ' ') : '') +
                                        ('<a class="' + $ctrl.getClickEventName('goListPage') + '" data-list="' + id + '"' +
                                            //'analytics-on analytics-action="Dashboard Activity"' +
                                            '>' + p.name + '</a>')
                                    ) : null;
                            }), function (item) {
                                return item;
                            }).join(', ');
                        }
                    }
                    action = action.replace(inlistStr, rep);
                }
            }
        }

        if(withFields) {
            updated = (item.affectedFieldsMapped ? item.affectedFieldsMapped : item.affectedFields).join(l === 2 ? ' and ' : ', ');
            if (l > 2) {
                updated = replaceLast(updated, ', ', ', and ');
            }
            if (updated) {
                updated = (isUploadImage ? '' : ' the ') + updated.toLowerCase();
            }
            action = action.replace('{{fields}} ', updated ? (updated + ' ') : '');
            if(isRemoveImage){
                action = action.replace('updated', 'removed');
            }
        }

        if(hasList){
            action = action.replace(inlistStr, '');
        }

        var name = (item.description ? (' <b>' + item.description + '</b>') : '');
        if(item.type === $ctrl.UploadImageProp ||
            item.type === $ctrl.AddOneEmptyFile ||
            isUpdateAction || isInsertAction){
            action = action.replace('{{name}}', name);
            if(name && isInsertAction){
                action = action.replace(' a new', ' ');
            }

        } else {
            action += ' ' +
                ($ctrl.isProduct(item) ?
                        (item.affectedIds ? _.filter(item.affectedIds.map(function (id) {
                            var p = _.find($ctrl.products, {_id: id});
                            return p ? $ctrl.getProductLink(item.productId, p.name, p.active) : '';
                        }), function (item) {
                            return item && item !== '';
                        }).join(', ') : '') :
                        name
                );
        }

        return action;

        function replaceLast(str, pattern, replacement) {
            const lastIndex = str.lastIndexOf(pattern);

            if (lastIndex === -1) {
                return str; // Pattern not found
            }

            const before = str.slice(0, lastIndex);
            const after = str.slice(lastIndex + pattern.length);

            return before + replacement + after;
        }


    }

    function getGridItemTemplate(item) {
        return $ctrl.getGridItemTemplateInit(item);
    }

    function getBottomActions() {
        return '<div class="ng-hide hide-print spacing text-center empty-state" ng-show="$ctrl.list.items.length===0">' +
            '<div class="empty-img my-activity">&nbsp;</div>'+
            '<p class="empty-txt">No recent activity</p>' +
            '</div>';
       // background-image: url('@{images-path}email/studiobinder-logo-gray.png?v=@{cache-version}'); }
    }
}

angular.module('user.dashboardPage.myActivityGroup.component.service', [
    'groupBlock.controller.service'
])
.service('MyActivityGroupCtrlService', MyActivityGroupCtrlService);
MyActivityGroupCtrlService.$inject = ['GroupBlockInitCtrlService'];
function MyActivityGroupCtrlService(GroupBlockInitCtrlService) {
    return function($ctrl, $element){
        $ctrl.GroupBlockInitCtrlService = GroupBlockInitCtrlService;
        $ctrl.ViewProjectAction = 127;
        $ctrl.productOverviewStateName = 'user.product.overview';
        $ctrl.replyPictureClass = 'small24';

        $ctrl.styles = {borders: 0};

        $ctrl.getGridItemTemplateInit = getGridItemTemplateInit;
        $ctrl.goListPage = goListPage;
        $ctrl.goToProduct = goToProduct;
        $ctrl.goToProductPage = goToProductPage;
        $ctrl.getProductLink = getProductLink;
        $ctrl.onInitActivities = onInitActivities;
        $ctrl.isProduct = isProduct;
        $ctrl.getIcon = getIcon;
        $ctrl.redirectToPage = redirectToPage;

        if(!$ctrl.$onInit){
            $ctrl.$onInit = $ctrl.onInitActivities;
        } else{
            $ctrl.onInitActivities();
        }

        return $ctrl;

        function onInitActivities() {
            $ctrl.customButtons = true;
            $ctrl.hideRemoveBtn = true;
            $ctrl.options = $ctrl.constantsService.Options;
            $ctrl.withCustomSettings = $ctrl.constantsService.CompOptions.withCustomSettings;

            if(!$ctrl.other){
                $ctrl.other = {};
            }
            _.each(['callsheets', 'lists', 'products'], function (p) {
                $ctrl[p] = $ctrl.other[p];
            });

            if($ctrl.onInitActivatedItemOther){
                $ctrl.onInitActivatedItemOther();
            }
            $ctrl = new $ctrl.GroupBlockInitCtrlService($ctrl, $element, $ctrl.Pagination, $ctrl.constantsService, null);
        }

        function isProduct(item){
            return item.objectType === 'products' && item.affectedIds && item.affectedIds.length > 0 ? (item.affectedIds[0] === item.productId) : false;
        }

        function getProductLink(id, name){
            return id ? ('<a class="semibold gray ' + $ctrl.getClickEventName('goToProduct') + '" ' +
                'analytics-on analytics-action="Overview Tasks: ' + $ctrl.productOverviewStateName + '">' + name + '</a>') : '';
        }

        function getIcon(item) {
            return isProduct(item) ? {
                    icon: 'project',
                    iconLevel: 2
                } :
                {
                    icon: (item.todoPage ? item.todoPage.icon : 'bell'),
                    iconLevel: (item.todoPage ? item.todoPage.iconLevel : 2)
                };
        }

        function getGridItemTemplateInit(item) {
            var collection = item.objectType,
                todoPage = item.todoPage,
                isGeneralPage = item.pageId ? item.pageId.indexOf('user.product.') === -1 : true,

                ic = $ctrl.getIcon(item),
                icon = ic.icon,
                iconLevel = ic.iconLevel,
                iconDiv = $ctrl.LCS.getISBDiv(icon, iconLevel, 'sbf14 pull-left padding-top-3 ' + ((isGeneralPage || icon === 'project' || icon === 'bell') ? 'blue':'colored')),
                action = $ctrl.getAction(item),
                isproduct = isProduct(item),
                product = isproduct ? null : $ctrl.getProductLink(item.productId, item.productName),
                page = todoPage ? ('<a class="' + $ctrl.getClickEventName('goToProductPage') + '" ' +
                    'analytics-on analytics-action="Dashboard Tasks: ' + (todoPage.name || 'Page') + '">' + (todoPage.text || 'Page') + '</a>') : '',
                user = item.createdBy ? ('<b>' + item.createdBy.name + '</b>') : ('<b>A user</b>');

         return '<div class="activity-picture text-center vtop hide-mobile ">' + getPicture() + '</div>' +
                '<div class="activity-item vtop"><div>' +
                    '<div class="info">' +
                        iconDiv + user + (' ' + action + ' ') + //('replied to ' + item.todoPage.name + ' ' +) +
                        ((product || page) ? ((item.type === $ctrl.ViewProjectAction ?  '/' : 'in') + ' ') : '') +
                        (product || '') + (product && page ? ' / ' : '') +
                        page +
                        //Sarah Haley commented in Touring Man / Screenplay
                        '<div class="full-width date">on ' + $ctrl.SBFieldMethods.getTime(item.updatedAt, $ctrl.CPS.dateTimeFormat) + '</div>' +
                    '</div>' +
                    ($ctrl.getContent ? $ctrl.getContent(item) : '') +
                '</div></div>';

            function getPicture() {
                return (item.createdBy ? $ctrl.security.getUserImageComponent('$ctrl.item.createdBy', 'small30') : '');
            }
        }

        function goToProduct(item, isHref, e) {
            if (!item) {
                return;
            }
            if (isHref) {
                return process();
            }
            $ctrl.popupsService.teamAccess(process);

            function process() {
                redirectToPage(e, $ctrl.productOverviewStateName, {
                    productId: item.productId
                });
            }
        }

        function goToProductPage(item, isHref, e) {
           // var item = _.find($ctrl.list.items,{_id:id});
            if(!item){return null;}
            if(isHref){
                return process();
            }
            $ctrl.popupsService.teamAccess(process);

            function process() {
                if(!item.todoPage){
                    return;
                }
                var p = {
                    productId: item.productId,
                };

                if(item.todoPage.uId) {
                    p[item.todoPage.uId] = item.uId;
                }

                if(item.callsheetId) {
                    p.callsheetId = item.callsheetId;
                }


                //  uIdList ? uIdList.currentItemId : null
                //  ('comment=' + id + (currentItemId ? (
                //      '&item=' + currentItemId) : ''))

                var listId =e && e.currentTarget ? e.currentTarget.getAttribute('data-list') : undefined;
                if(listId === 'null'){
                    listId = null;
                }
               return redirectToPage(e, item.todoPage.name, _.extend(p, $ctrl.getProductPageParams(item, listId)), isHref);
            }
        }

        function goListPage(item, isHref, e) {
            console.log('goListPage');
           return item.productId ? goToProductPage(item, isHref, e) : redirectToPage(e, '', params, isHref);
        }

        function redirectToPage(e, name, params, isHref) {
            var p = $ctrl.CPS.currentPathParams(params);
            if (isHref) {
                return $ctrl.CPS.getStateHref(name, p);
            }

            if (e && e.shiftKey) {
                $ctrl.CPS.openInNewWindow(name, p);
            } else {
                $ctrl.CPS.transitionTo(name, p);
            }
        }
    }
}

