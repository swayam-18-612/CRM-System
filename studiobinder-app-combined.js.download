angular.module('sb.fields.popovers.assignProjectsMenu.component',[
    'sb.fields.selectize.service',
    'product.selectors.searchonlist.controller.service'
])
.component('sbAssignProjectsMenu', {
    bindings: {
        isAssign: '@', //isAssign = true on task caard
        canEdit: '<',
        drpClass: '@?',
        teamLabel: '@',
        headerSelected: '@',
        showMemberType:'@',
        displayDefaultMembers:'@',

        membersCount: '<?',
        team : '<?',
        value:'<',

        currentId: '@',
        canRemoveCurrent: '@',
        removeMessage:'<',

        onSelect: '&',
        onAction: '&',
        onDefaultMember:'&'
    },
    controller: 'AssignProjectsMenuCtrl'
})

.controller('AssignProjectsMenuCtrl',AssignProjectsMenuCtrl);
AssignProjectsMenuCtrl.$inject =['TemplateCompileCompCtrlService', 'SBSelectizeCtrlService', 'SearchOnListCtrlService', 'CompileService', '$element'];

function AssignProjectsMenuCtrl(TemplateCompileCompCtrlService, SBSelectizeCtrlService, SearchOnListCtrlService, CompileService, $element) {
    console.log('AssignProjectsMenuCtrl');
//use different approach for assign project team members vs assign team to card
    var $ctrl = this,
        withoutTemplateScope = true,

        defaultMembersName = 'defaultMembers';

    $ctrl.CompileService = CompileService;

    $ctrl.searchCls = 'search-grp';
    $ctrl.selectizeCls = 'selectizeEl';
    $ctrl.btnRemoveCls = 'btnRemove';
    $ctrl.btnAddCls = 'btnAdd';
    $ctrl.emptyItemTitle = 'project';
    $ctrl.emptyIcon = 'user';
    $ctrl.itemTitle = 'project';
    $ctrl.removeFrom = 'this user';
    $ctrl.showAdd = false;
    $ctrl.showAddTxt = 'Add Project';
    $ctrl.addBtnState = 'projects';

    $ctrl.getSmallHeader = getSmallHeader;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;
    $ctrl.addItem = addItem;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        if(!$ctrl.value) {
            $ctrl.value = [];
        }

        //dont consider null items
        $ctrl.value = _.filter($ctrl.value, function (id){return id;})

        $ctrl.prevValue = angular.copy($ctrl.value);


        if(!$ctrl.teamLabel) {
            $ctrl.teamLabel = 'Project Team';
        }

        $ctrl.defaultMembers = _.filter($ctrl.team, function (item) {
            return isDefaultMember(item);//MemberTypes.Owner && Admin
        });

        //don t consider the team mates that must have been removed previously
        $ctrl.members = _.filter($ctrl.value.length ? _.filter($ctrl.value.map(getMemberById), function(item){return item !== null && item !== undefined;}) : [], function (item){
            return !isDefaultMember(item);
        });

        $ctrl.unselected = _.filter($ctrl.team, function (item) {
            return !isDefaultMember(item) && (!$ctrl.value || $ctrl.value.indexOf(item._id) === -1);
        });

        $ctrl.withInlineBlock = $ctrl.isAssign;

        if(!$ctrl.withInlineBlock){
            $ctrl.listBottomName = defaultMembersName;
        }

        $ctrl.dontHideSearch = $ctrl.withInlineBlock;

        if(!$ctrl.headerSelected) {
            $ctrl.headerSelected = 'Assigned '+$ctrl.itemTitle+'s';
        }

        if($ctrl.withInlineBlock) {
            $ctrl = new SearchOnListCtrlService($ctrl);
            $ctrl.getSearchPlaceholder = getSearchPlaceholder;
        }
    }

    function getSearchPlaceholder(){
        return 'Filter by '+$ctrl.itemTitle+'…';
    }

    function onDestroy() {
        bind(false);
    }

    function onLoaded() {
        bind(true);

        if (!$ctrl.canEdit) {
            return;
        }
        if($ctrl.withInlineBlock){

            //dont set focus on searc
            // $ctrl.setFocusOnSearch(100);
        } else {
            loadSelectize();
        }
    }

    function bind(isBind) {
        bindAdd(isBind);
        if ($ctrl.canEdit) {
            if ($ctrl.withInlineBlock && $ctrl.bindSearch) {
                $ctrl.bindSearch(isBind);
            }

            bindLists(isBind);
        } else if($ctrl.currentId && $ctrl.canRemoveCurrent){
            $ctrl.LCS.bindElementsClick(isBind, getWrapperByType('members').querySelector('li[data-id="' + $ctrl.currentId + '"]'), updateItem);
        }
    }

    function addItem(id) {
        console.log('addItem');
        if(id && $ctrl.value.indexOf(id) === -1){
            $ctrl.value.push(id);
            $ctrl.members.push(angular.copy(getMemberById(id)));
            var index = getIndexForId($ctrl.unselected, id);
            if(index !==-1){
                $ctrl.unselected.splice(index, 1);
            }

            onChanged(id, false);
        }
    }

    function removeItem(id){
        console.log('removeItem');
        var index = $ctrl.value.indexOf(id);
        if(index === -1) {
            return;
        }

        $ctrl.value.splice(index, 1);
        index = getIndexForId($ctrl.members, id);
        $ctrl.members.splice(index, 1);
        $ctrl.unselected.push(angular.copy(getMemberById(id)));

        onChanged(id, true);
    }

    function onChanged(id, isRemove) {

        updateListVisibility();

        $ctrl.selectedItem = 'sb-clear';
        if(!$ctrl.withInlineBlock){
            $ctrl.selectizeService.setSelectizeOptions($ctrl.unselected, $ctrl.selectedItem);
            if (!isRemove) {
                addMemberToWrapper('members', id, !isRemove);
            }
        }
        //send update to parent
        $ctrl.prevValue = angular.copy($ctrl.value);
        var result =  {e: null, value: $ctrl.prevValue};
        if(isRemove && $ctrl.currentId && $ctrl.canRemoveCurrent) {
            result.removeCurrent = true;
        }
        $ctrl.onSelect({result: result});
    }

    function add(e) {
        onAction(e, $ctrl.addBtnState);
    }
    
    function onAction(e, type) {
        $ctrl.preventDefault(e);
        $ctrl.onAction({type: type});
    }

    function getItemTemplate() {
return '<div class="dropdown-menu selector-dropdown with-overflow selectabledropdown addteammate '+ ($ctrl.drpClass ? $ctrl.drpClass : '')+ '"><div>' +
            ($ctrl.withInlineBlock ? '' : ('<div class="header-small clearfix margin-top-half"><span class="count"></span> People have '+ ($ctrl.isAssign ? 'been assigned' : 'access')+'</div>')) +
            '<div>' +
                ($ctrl.canEdit ? getSearch() : '') +
                '<div class="show-scrollbar-on-hover">' +
                    '<div class="fancy-scrollbar vertical ultrathin">' +
                        '<div>' +
                            '<div class="select-choices with-teams display-block' + ($ctrl.withInlineBlock  ? '' : ' without-hover') + '">' + processLists(false) + '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
            ($ctrl.showAdd && $ctrl.canEdit ? ('<div class="spacing-half-top clearfix with-border-top margin-top-half" xmlns="http://www.w3.org/1999/html">' +
                '<a id="'+$ctrl.btnAddCls+'" class="smaller-font small inline-block semibold">' +
                $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left') +
                '<span class="hide-mobile with-margin-left">'+$ctrl.showAddTxt+'</span></a>' +
            '</div>') : '') +
        '</div></div>';

        function getSearch(){
            return '<div class="' +
                ($ctrl.withInlineBlock ? 'margin-top-half' : '') + ' without-padding search-field withSearch sbfgroup field last ' + $ctrl.searchCls + ' ' +
                    ($ctrl.dontHideSearch ? '' : ($ctrl.unselected && $ctrl.unselected.length > 0 ? '' : 'sb-hide ')) +
                      ($ctrl.withInlineBlock ? '' : ' form-group') +
                '">' +
                    ($ctrl.withInlineBlock ? $ctrl.getSearchContent() : getSelectizeSearch()) +
                '</div>';
        }

        function getSelectizeSearch(){
            return $ctrl.LCS.getISBDiv('search') + '<div class="' + $ctrl.selectizeCls + '"></div>';
        }
    }

    function processLists(isReload) {
        var m = isReload ? reloadList : loadlist,
            withoutSelect = true,
            hasDefault = $ctrl.listBottomName !== defaultMembersName && $ctrl.displayDefaultMembers;
        return (hasDefault ? getHeader('members', true) : '') +
            m('members', true, false, hasDefault) +
            (hasDefault ? m(defaultMembersName, false, withoutSelect, true) : '') +
            (!$ctrl.canEdit && $ctrl.withInlineBlock ? '' : m($ctrl.listBottomName, false));

        function reloadList() {

        }

        function loadlist(type, withRemove, withoutSelect, withoutHeader) {
            var list = $ctrl[type],
                cls = ($ctrl.withInlineBlock ? ' with-inline-block' : '') + (!$ctrl.withInlineBlock && !withRemove ? ' no-last-border' : ''),
                content = getListContent(list, withRemove, withoutSelect);
            return '<div class="' + getBlockName(type) + (content ? '' : ' sb-hide') + '">' +
                (!withoutSelect && !withoutHeader && $ctrl.getSmallHeader ? getHeader(type, withRemove) : '') +
                '<ul' + (cls ? (' class=" ' + cls + '"') : '') + '>' + content + '</ul>' +
                '</div>';
        }

        function getHeader(type, withRemove) {
            return $ctrl.getSmallHeader ? ('<div class="header-small clearfix margin-top-half">' + $ctrl.getSmallHeader(type, withRemove) + '</div>') : '';
        }

        function getListContent(list, withRemove, withoutSelect) {
            return list ? _.map(list, function (item) {
                return getListItem(item, withRemove, withoutSelect);
            }).join('') : '';
        }
    }

    function getSmallHeader(type, withRemove){
        return $ctrl.isAssign ? (withRemove ? $ctrl.headerSelected : $ctrl.teamLabel) : (withRemove ? 'Members' : 'Admins');
    }

    function getBlockName(type){
        return 'block' + type;
    }

    function addMemberToWrapper(type, id, withRemove){
        addItemToWrapper(getWrapperByType(type), getMemberContent(type, id), withRemove, id);

        function getMemberContent(type, id){
            return getListItem(_.find($ctrl[type], {_id: id}), withRemove);
        }
    }

    function addItemToWrapper(wrapper, el, withRemove, id) {
        if(wrapper) {
            $ctrl.LCS.appendChildFragment(wrapper, el);
            bindItemClicks(wrapper.querySelector('li[data-id="' + id + '"]'), true, withRemove);
        }
    }

    function getListItem(item, withRemove, withoutSelect) {
        if(!item){return '';}
          withRemove = $ctrl.canEdit && withRemove ||
              item._id === $ctrl.currentId && $ctrl.currentId && $ctrl.canRemoveCurrent;
    return '<li class="' + $ctrl.itemClass + ' ' +
        (withRemove && $ctrl.withInlineBlock ? ($ctrl.btnRemoveCls + ' ') : '') +
         ' ui-select-choices-group ' + ((withoutSelect || !$ctrl.canEdit) ? 'without-hover' : 'with-hover with-easein') + '" data-id="' + item._id + '">' +
                '<div class="select-choices-row-inner table-div fixed-layout  ' + ((withoutSelect || !$ctrl.canEdit) ? '' : 'with-easein') + '">' +
                    '<div class="col30 vtop">' + getImage(item, 'small30') + '</div>' +
                    '<div class="centered">' +
                        '<div class="with-ellipsis name ' + ($ctrl.withUppercase ? ' uppercase' : '') +'">' + item.name + '</div>' +
                        //not confirmed
                        (!$ctrl.withInlineBlock && item.memberType!== $ctrl.security.MemberTypes.Owner && item.status !== 2 ? '<div class="smaller-orange">Invited and pending…</div>' : '') +
                        ($ctrl.showMemberType ? ('<div class="email">' + getMemberType(item.memberType) + '</div>') : '') +
                    '</div>' +
(withRemove ? (
                    '<div class="centered col30 text-right">' +
                        '<a class="display-block body-color with-hover with-transition ' + ($ctrl.withInlineBlock ? '' : $ctrl.btnRemoveCls) + '">' + $ctrl.LCS.getISBDiv('cancel', 2) + '</a>' +
                    '</div>') : '') +
                '</div>' +
            '</li>';

        function getMemberType(memberType) {
            switch (memberType) {
                case $ctrl.security.MemberTypes.Owner: return 'Owner';
                case $ctrl.security.MemberTypes.Admin: return 'Admin';
                case $ctrl.security.MemberTypes.Member: return 'Member';
            }
            return '';
        }
    }

    function bindItemClicks(parent, isBind, withRemove) {
        if(!parent){
            return;
        }
        var el = ($ctrl.withInlineBlock || !$ctrl.withInlineBlock && !withRemove) && parent.tagName === 'LI' ? parent : parent.querySelectorAll('.' + (withRemove ? $ctrl.btnRemoveCls : $ctrl.itemClass));
        $ctrl.LCS.bindElementsClick(isBind, el, updateItem);
    }

    function updateItem(e) {
        $ctrl.preventDefault(e);

        console.log('updateItem');
        var el = e.currentTarget,
            isRemove = $ctrl.LCS.hasClass(el, $ctrl.btnRemoveCls);

        if(isRemove && el.tagName !== 'LI'){
            el = $ctrl.LCS.findClosestParent(el, 'li');
        }
        var id = el.getAttribute('data-id'),
            type = 'members',
        //if is member can be removed
        //otherwise if is not with inline can be added
            blockMembers = $ctrl.LCS.findClosestParent(el, '.' + getBlockName(type));

        if(isRemove && $ctrl.removeMessage){
            var item = _.find($ctrl[type], {_id: id}),
                txt = $ctrl.canEdit ? (item ? item.name : 'Selected ' + $ctrl.itemTitle) : 'Yourself';
            $ctrl.popupsService.openConfirmPopup({
                next: process,
                props: {
                    btn: 'Remove ' + ($ctrl.canEdit ? $ctrl.itemTitle : 'Yourself'),
                    icon: 'info-unfilled',
                    title: 'Are you sure?',
                    pageClass: $ctrl.pageClass,
                    message: '<p class="text-center font-size-14 line-height-2">Are you sure you want to remove <span class="semibold">'+txt+'</span> from '+$ctrl.removeFrom+'. '+$ctrl.removeMessage+'</p>',
                }
            });
        } else{
            process();
        }

        function process() {
            bindItemClicks(el, false, isRemove);
            $ctrl.LCS.removeElement(el);

            if (isRemove) {
                removeItem(id);
            } else {
                $ctrl.addItem(id);
            }

            if ($ctrl.withInlineBlock) {
                addMemberToWrapper(blockMembers ? $ctrl.listBottomName : type, id, !isRemove);
            }
        }
    }

    function getImage(item, cls) {
        return $ctrl.security.getImage(item, cls, 'profilePictureURL', 50);
    }
    
    function showSearch() {
        if($ctrl.dontHideSearch){return;}
        if(!$ctrl.searchEl) {
            $ctrl.searchEl = $ctrl.element.querySelector('.' + $ctrl.searchCls);
        }
        $ctrl.LCS[$ctrl.unselected && $ctrl.unselected.length > 0 ? 'removeClass' : 'addClass']($ctrl.searchEl, 'sb-hide');
    }

    function getIndexForId(list, id) {
        return _.findIndex(list, function (item) {
            return item&&item._id === id;
        });
    }

    function updateListVisibility(){
        var mC = set('members'),
            bC = set($ctrl.listBottomName),
            c = mC + bC,
        countEl = $ctrl.element.querySelector('.count');
        if(countEl){countEl.innerHTML = c;}
        setProp( $ctrl.displayDefaultMembers ? true : (c !== 1), 'header-small');

        showSearch();

        function set(type, prop){
            var list = $ctrl[type],
                count = list ? list.length : 0;
            setProp(count > 0, prop, type);
            return count;
        }

        function setProp(show, prop, type){
            $ctrl.LCS[show ? 'removeClass' : 'addClass']($ctrl.element.querySelector('.' + (prop ? prop : getBlockName(type))), 'sb-hide');
        }
    }

    function getWrapperByType(type){
        var name = getBlockName(type);
        if(!$ctrl[name]){
            var el = $ctrl.element.querySelector('.' + name);
            if(el){
                $ctrl[name] = el.querySelector('ul');
            }
        }
        return $ctrl[name];
    }

    function bindLists(isBind, type) {
        bindList('members', true);
        if($ctrl.withInlineBlock) {
            bindList($ctrl.listBottomName, false);
        }

        if(isBind) {
            updateListVisibility();
        }

        function bindList(type, withRemove){
            bindItemClicks(getWrapperByType(type), isBind, withRemove);
        }
    }

    function bindAdd(isBind) {
        if(!$ctrl.btnAdd){
            $ctrl.btnAdd = $ctrl.element.querySelector('#' + $ctrl.btnAddCls);
        }
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnAdd, add);
    }


    function getMemberById(id) {
        return _.find($ctrl.team, function (item) {
            return item._id === id //MemberTypes.Member
        });
    }

    function isDefaultMember(item) {
        return $ctrl.onDefaultMember({item: item});
    }

    function loadSelectize() {
        $ctrl.selectizeEl = $ctrl.element.querySelector('.' + $ctrl.selectizeCls);

        $ctrl.selectedItem = null;
        $ctrl.config = {
            valueField: '_id',
            labelField: 'name',
            placeholder: 'Assign more members…',
            searchField: ['name'],
            inputClass: 'selectize-input selected-text',
            render: {
                item: function (i, e) {
                    return renderItem(i, e, 'item');
                },
                option: function (i, e) {
                    return renderItem(i, e, 'option');
                }
            },
            onChange: $ctrl.addItem
        };

        if ($ctrl.selectizeEl) {
            $ctrl.selectizeService = new SBSelectizeCtrlService(angular.element($ctrl.selectizeEl),  {}, {
                ngModel: $ctrl.selectedItem,
                config: $ctrl.config,
                initList: $ctrl.unselected
            });

            showSearch();
        }

        function renderItem(item, escape, type) {
           var el = '<li class="table-div full-width with-cursor h50">' +
                        '<div class="col40 centered">' + getImage(item, 'smaller') + '</div>' +
                        '<div class="centered"><div class="with-ellipsis">' + item.name + '</div></div>' +
                    '</li>';

            $ctrl.CompileService.addCompiledTemplateWatcher($ctrl.watchers, el, item._id, type);

            return el;
        }
    }
}

angular.module('sb.fields.popovers.assignProjects.component',[
    'sb.fields.popovers.assignProjectsMenu.component',
    'dropdowns.drpnonclosed.controller.service',
    'ctrl.popups.service',
    'user.share.collaborators.service'
])
.component('sbAssignProjects', sbFieldComponentParams('AssignProjectsCtrl', {
    canChangeEdit: '<',
    withoutDefaultFocus:'@',
    headerSelected: '@',
    teamLabel: '@',
    showMemberType: '@',
    displayDefaultMembers: '@',

    canRemoveCurrent: '@',
    currentId: '@',
    removeMessage: '<',
    productId: '<',

    isAssign: '@',
    showAllTeam: '@',
    showOnlyCounter: '@?',
    withCount: '@?',
    maxCount: '@?',
    circleSize: '@',
    withoutDefaultMembers: '@?',
    initList: '<?'
}, getSBDropdownTemplate('teamSelector')))
.controller('AssignProjectsCtrl', AssignProjectsCtrl);
AssignProjectsCtrl.$inject =['SBDrpNonClosedCtrlService', 'SBFieldTypesService', 'PopupsService', 'RouteCollaboratorsService', '$element', '$attrs'];
function AssignProjectsCtrl(SBDrpNonClosedCtrlService, SBFieldTypesService, PopupsService, RouteCollaboratorsService, $element, $attrs) {
    //console.log('AssignTeamCtrl');

    var withoutTemplateScope = false;

    var $ctrl = this;

    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
    $ctrl.PopupsService = PopupsService;

    $ctrl.menuTag = 'sb-assign-projects-menu';
    $ctrl.propType = SBFieldTypesService.PropTypes.Projects;
    $ctrl.changedFieldsOther = ['canChangeEdit'];

    $ctrl.generateDrpMenuContent = generateDrpMenuContent;
    $ctrl.initDrp = initDrp;
    $ctrl.onChangesOther = onChangesOther;
    $ctrl.getCanEdit = getCanEdit;

    $ctrl = new SBDrpNonClosedCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

    function getCanEdit(){
        $ctrl.canEdit = $ctrl.canChangeEdit;
        if($ctrl.canChangeEdit){
            $ctrl.col.canEdit = true;
        }
    }

    function onChangesOther(changes) {
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i],
                change = changes[field];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                if (field === 'canChangeEdit') {
                    getCanEdit();
                    break;
                }
            }
        }
    }

    function setInitList() {
        if ($ctrl.isProductTeam) {
            $ctrl.initList = $ctrl.CPS.SessionService.getSetting('team');
            var value = $ctrl.productId && $ctrl.CPS.product._id === $ctrl.productId ? $ctrl.RouteCollaboratorsService.getProjectTeam($ctrl.CPS.product, $ctrl.initList) : null;
            $ctrl.value = value ? value.map(function (item) {
                return item ? item._id : null;
            }) : null;
            // $ctrl.value = $ctrl.CPS.productId && $ctrl.CPS.product.teamIds ? $ctrl.CPS.product.teamIds : null;
        }
    }

    function initDrp() {

        setInitList();

        getCanEdit();
        $ctrl.showOnlyCounter = $ctrl.showOnlyCounter === true || $ctrl.showOnlyCounter === 'true';
        $ctrl.showAllTeam = $ctrl.showAllProjects === true || $ctrl.showAllTeam === 'true';
        if (!$ctrl.circleSize) {
            $ctrl.circleSize = 'smaller';
        }
        if ($ctrl.maxCount === undefined || $ctrl.maxCount === 'undefined') {
            $ctrl.maxCount = 100;
        }
        $ctrl.LCS.addClass($ctrl.element, 'sb-assign-team');
    }
    
    function onAction(type, e) {
        if(type === 'projects'){
            $ctrl.popupsService.teamAdminAccess(process);

            function process() {
                var isOpen = $ctrl.PopupsService.isOpen;
                if(isOpen) {
                    for (var type in isOpen) {
                        $ctrl.PopupsService.closePopupByType(type);
                    }
                }
                $ctrl.CPS.transitionTo('user.projects', $ctrl.CPS.currentPathParams());
            }
        }
    }

    function generateDrpMenuContent() {
        var l = $ctrl.initList ? $ctrl.initList.length : 0;
        if ($ctrl.value && $ctrl.value.length) {
            l += $ctrl.value.length;
        }
        if ($ctrl.isProductTeam) {
            $ctrl.elementId = $ctrl.elementId.replace('elementid', $ctrl.productId);
            $ctrl.getItemId();
        }

        return {
            $ctrl: {
                team: $ctrl.initList,
                value: $ctrl.value,
                removeMessage: $ctrl.removeMessage,
                canEdit: $ctrl.canEdit,

                onSelect: $ctrl.onSelect,
                onAction: onAction,
                onDefaultMember: onDefaultMember
            },

            template:
                ($ctrl.isAssign ?  'is-assign="true" ' : '')+
                'drp-class="' + ($ctrl.showOnlyCounter ? 'toleftless' : (l > $ctrl.maxCount ? 'toleft' : '')) +
                    ($ctrl.drpClassAttr ? (' ' + $ctrl.drpClassAttr) : '') +
                '" ' +
                "can-edit='::" + $ctrl.canEdit + "' " +
                ($ctrl.currentId ?( "current-id='" + $ctrl.currentId + "' ") : '') +
                ($ctrl.canRemoveCurrent ? 'can-remove-current="true" ' : '') +
                 'remove-message="::$ctrl.removeMessage" ' +
                ($ctrl.teamLabel ? ('team-label="' + $ctrl.teamLabel + '"') : '') +
                ($ctrl.headerSelected ? ('header-selected="' + $ctrl.headerSelected + '"') : '') +
                ($ctrl.showMemberType ? ('show-member-type="' + $ctrl.showMemberType + '"') : '') +
                ($ctrl.displayDefaultMembers ? ('display-default-members="' + $ctrl.displayDefaultMembers + '"') : '') +
                "team='::$ctrl.team' " +
                "value='::$ctrl.value' " +

                "on-select='$ctrl.onSelect(result)' " +
                "on-action='$ctrl.onAction(type)' " +
                "on-default-member='$ctrl.onDefaultMember(item)' "
        }
    }

    function onDefaultMember(item) {
        if($ctrl.withoutDefaultMembers === 'true' || $ctrl.withoutDefaultMembers === true){
            return false;
        }
        return item && (item.memberType === $ctrl.security.MemberTypes.Owner || item.memberType === $ctrl.security.MemberTypes.Admin);
    }
}

angular.module('sb.fields.popovers.assignTeamMenu.component',[
    'sb.fields.selectize.service',
    'product.selectors.searchonlist.controller.service'
])
.component('sbAssignTeamMenu', {
    bindings: {
        isAssign: '@', //isAssign = true on task caard
        canEdit: '<',
        drpClass: '@?',
        teamLabel: '@',
        headerSelected: '@',
        showMemberType:'@',
        displayDefaultMembers:'@',

        membersCount: '<?',
        team : '<?',
        value:'<',

        currentId: '@',
        canRemoveCurrent: '@',
        removeMessage:'<',

        onSelect: '&',
        onAction: '&',
        onDefaultMember:'&'
    },
    controller: 'AssignTeamMenuCtrl'
})

.controller('AssignTeamMenuCtrl',AssignTeamMenuCtrl);
AssignTeamMenuCtrl.$inject =['TemplateCompileCompCtrlService', 'SBSelectizeCtrlService', 'SearchOnListCtrlService', 'CompileService', '$element'];

function AssignTeamMenuCtrl(TemplateCompileCompCtrlService, SBSelectizeCtrlService, SearchOnListCtrlService, CompileService, $element) {
    console.log('AssignTeamMenuCtrl');
//use different approach for assign project team members vs assign team to card
    var $ctrl = this,
        withoutTemplateScope = true,
        defaultMembersName = 'defaultMembers';

    $ctrl.CompileService = CompileService;

    $ctrl.searchCls = 'search-grp';
    $ctrl.selectizeCls = 'selectizeEl';
    $ctrl.btnRemoveCls = 'btnRemove';
    $ctrl.btnAddCls = 'btnAdd';
    $ctrl.emptyItemTitle = 'team member';
    $ctrl.emptyIcon = 'user';
    $ctrl.itemTitle='name';
    $ctrl.removeFrom = 'this task board';
    $ctrl.showAddTxt = 'Invite Users';
    $ctrl.showAdd = true;
    $ctrl.addBtnState = 'team';

    $ctrl.getSmallHeader = getSmallHeader;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;
    $ctrl.addItem = addItem;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        if(!$ctrl.value) {
            $ctrl.value = [];
        }

        //dont consider null items
        $ctrl.value = _.filter($ctrl.value, function (id){return id;})

        $ctrl.prevValue = angular.copy($ctrl.value);


        if(!$ctrl.teamLabel) {
            $ctrl.teamLabel = 'Project Team';
        }

        $ctrl.defaultMembers = _.filter($ctrl.team, function (item) {
            return isDefaultMember(item);//MemberTypes.Owner && Admin
        });

        //don t consider the team mates that must have been removed previously
        $ctrl.members = _.filter($ctrl.value.length ? _.filter($ctrl.value.map(getMemberById), function(item){return item !== null && item !== undefined;}) : [], function (item){
            return !isDefaultMember(item);
        });

        $ctrl.unselected = _.filter($ctrl.team, function (item) {
            return !isDefaultMember(item) && (!$ctrl.value || $ctrl.value.indexOf(item._id) === -1);
        });

        $ctrl.withInlineBlock = $ctrl.isAssign;

        if(!$ctrl.withInlineBlock){
            $ctrl.listBottomName = defaultMembersName;
        }

        $ctrl.dontHideSearch = $ctrl.withInlineBlock;

        if(!$ctrl.headerSelected) {
            $ctrl.headerSelected = $ctrl.withInlineBlock ? 'Assigned to card' : 'Assigned team';
        }

        if($ctrl.withInlineBlock) {
            $ctrl = new SearchOnListCtrlService($ctrl);
            $ctrl.getSearchPlaceholder = getSearchPlaceholder;
        }
    }

    function getSearchPlaceholder(){
        return 'Filter by '+$ctrl.itemTitle+'…';
    }

    function onDestroy() {
        bind(false);
    }

    function onLoaded() {
        bind(true);

        if (!$ctrl.canEdit) {
            return;
        }
        if($ctrl.withInlineBlock){

            //dont set focus on searc
            // $ctrl.setFocusOnSearch(100);
        } else {
            loadSelectize();
        }
    }

    function bind(isBind) {
        bindAdd(isBind);
        if ($ctrl.canEdit) {
            if ($ctrl.withInlineBlock && $ctrl.bindSearch) {
                $ctrl.bindSearch(isBind);
            }

            bindLists(isBind);
        } else if($ctrl.currentId && $ctrl.canRemoveCurrent){
            $ctrl.LCS.bindElementsClick(isBind, getWrapperByType('members').querySelector('li[data-id="' + $ctrl.currentId + '"]'), updateItem);
        }
    }

    function addItem(id) {
        console.log('addItem');
        if(id && $ctrl.value.indexOf(id) === -1){
            $ctrl.value.push(id);
            $ctrl.members.push(angular.copy(getMemberById(id)));
            var index = getIndexForId($ctrl.unselected, id);
            if(index !==-1){
                $ctrl.unselected.splice(index, 1);
            }

            onChanged(id, false);
        }
    }

    function removeItem(id){
        console.log('removeItem');
        var index = $ctrl.value.indexOf(id);
        if(index === -1) {
            return;
        }

        $ctrl.value.splice(index, 1);
        index = getIndexForId($ctrl.members, id);
        $ctrl.members.splice(index, 1);
        $ctrl.unselected.push(angular.copy(getMemberById(id)));

        onChanged(id, true);
    }

    function onChanged(id, isRemove) {

        updateListVisibility();

        $ctrl.selectedItem = 'sb-clear';
        if(!$ctrl.withInlineBlock){
            $ctrl.selectizeService.setSelectizeOptions($ctrl.unselected, $ctrl.selectedItem);
            if (!isRemove) {
                addMemberToWrapper('members', id, !isRemove);
            }
        }
        //send update to parent
        $ctrl.prevValue = angular.copy($ctrl.value);
        var result =  {e: null, value: $ctrl.prevValue};
        if(isRemove && $ctrl.currentId && $ctrl.canRemoveCurrent) {
            result.removeCurrent = true;
        }
        $ctrl.onSelect({result: result});
    }

    function add(e) {
        console.log('invite users');
        onAction($ctrl.addBtnState, e);
    }
    
    function onAction(type, e,) {
        $ctrl.preventDefault(e);
        $ctrl.onAction({type: type});
    }

    function getItemTemplate() {
return '<div class="dropdown-menu selector-dropdown with-overflow selectabledropdown addteammate '+ ($ctrl.drpClass ? $ctrl.drpClass : '')+ '"><div>' +
            ($ctrl.withInlineBlock ? '' : ('<div class="header-small clearfix margin-top-half"><span class="count"></span> People have '+ ($ctrl.isAssign ? 'been assigned' : 'access')+'</div>')) +
            '<div>' +
                ($ctrl.canEdit ? getSearch() : '') +
                '<div class="show-scrollbar-on-hover">' +
                    '<div class="fancy-scrollbar vertical ultrathin">' +
                        '<div>' +
                            '<div class="select-choices with-teams display-block' + ($ctrl.withInlineBlock  ? '' : ' without-hover') + '">' + processLists(false) + '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
            ($ctrl.showAdd && $ctrl.canEdit ? ('<div class="spacing-half-top clearfix with-border-top margin-top-half">' +
                '<a id="'+$ctrl.btnAddCls+'" class="smaller-font small inline-block semibold">' +
                $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left with-margin-right') +
                ' '+$ctrl.showAddTxt+'</a>' +
            '</div>') : '') +
        '</div></div>';

        function getSearch(){
            return '<div class="' +
                ($ctrl.withInlineBlock ? 'margin-top-half' : '') + ' without-padding search-field withSearch sbfgroup field last ' + $ctrl.searchCls + ' ' +
                    ($ctrl.dontHideSearch ? '' : ($ctrl.unselected && $ctrl.unselected.length > 0 ? '' : 'sb-hide ')) +
                      ($ctrl.withInlineBlock ? '' : ' form-group') +
                '">' +
                    ($ctrl.withInlineBlock ? $ctrl.getSearchContent() : getSelectizeSearch()) +
                '</div>';
        }

        function getSelectizeSearch(){
            return $ctrl.LCS.getISBDiv('search') + '<div class="' + $ctrl.selectizeCls + '"></div>';
        }
    }

    function processLists(isReload) {
        var m = isReload ? reloadList : loadlist,
            withoutSelect = true,
            hasDefault = $ctrl.listBottomName !== defaultMembersName && $ctrl.displayDefaultMembers;
        return (hasDefault ? getHeader('members', true) : '') +
            m('members', true, false, hasDefault) +
            (hasDefault ? m(defaultMembersName, false, withoutSelect, true) : '') +
            (!$ctrl.canEdit && $ctrl.withInlineBlock ? '' : m($ctrl.listBottomName, false));

        function reloadList() {

        }

        function loadlist(type, withRemove, withoutSelect, withoutHeader) {
            var list = $ctrl[type],
                cls = ($ctrl.withInlineBlock ? ' with-inline-block' : '') + (!$ctrl.withInlineBlock && !withRemove ? ' no-last-border' : ''),
                content = getListContent(list, withRemove, withoutSelect);
            return '<div class="' + getBlockName(type) + (content ? '' : ' sb-hide') + '">' +
                (!withoutSelect && !withoutHeader && $ctrl.getSmallHeader ? getHeader(type, withRemove) : '') +
                '<ul' + (cls ? (' class=" ' + cls + '"') : '') + '>' + content + '</ul>' +
                '</div>';
        }

        function getHeader(type, withRemove) {
            return $ctrl.getSmallHeader ? ('<div class="header-small clearfix margin-top-half">' + $ctrl.getSmallHeader(type, withRemove) + '</div>') : '';
        }

        function getListContent(list, withRemove, withoutSelect) {
            return list ? _.map(list, function (item) {
                return getListItem(item, withRemove, withoutSelect);
            }).join('') : '';
        }
    }

    function getSmallHeader(type, withRemove){
        return $ctrl.isAssign ? (withRemove ? $ctrl.headerSelected : $ctrl.teamLabel) : (withRemove ? 'Members' : 'Admins');
    }

    function getBlockName(type){
        return 'block' + type;
    }

    function addMemberToWrapper(type, id, withRemove){
        addItemToWrapper(getWrapperByType(type), getMemberContent(type, id), withRemove, id);

        function getMemberContent(type, id){
            return getListItem(_.find($ctrl[type], {_id: id}), withRemove);
        }
    }

    function addItemToWrapper(wrapper, el, withRemove, id) {
        if(wrapper) {
            $ctrl.LCS.appendChildFragment(wrapper, el);
            bindItemClicks(wrapper.querySelector('li[data-id="' + id + '"]'), true, withRemove);
        }
    }

    function getListItem(item, withRemove, withoutSelect) {
        if(!item){return '';}
          withRemove = $ctrl.canEdit && withRemove ||
              item._id === $ctrl.currentId && $ctrl.currentId && $ctrl.canRemoveCurrent;
    return '<li class="' + $ctrl.itemClass + ' ' +
        (withRemove && $ctrl.withInlineBlock ? ($ctrl.btnRemoveCls + ' ') : '') +
         ' ui-select-choices-group ' + ((withoutSelect || !$ctrl.canEdit) ? 'without-hover' : 'with-hover with-easein') + '" data-id="' + item._id + '">' +
                '<div class="select-choices-row-inner table-div fixed-layout  ' + ((withoutSelect || !$ctrl.canEdit) ? '' : 'with-easein') + '">' +
                    '<div class="col30 vtop">' + getImage(item, 'small30') + '</div>' +
                    '<div class="centered">' +
                        '<div class="with-ellipsis name ' + ($ctrl.withUppercase ? ' uppercase' : '') +'">' + item.name + '</div>' +
                        //not confirmed
                        (!$ctrl.withInlineBlock && item.memberType!== $ctrl.security.MemberTypes.Owner && item.status !== 2 ? '<div class="smaller-orange">Invited and pending…</div>' : '') +
                        ($ctrl.showMemberType ? ('<div class="email">' + getMemberType(item.memberType) + '</div>') : '') +
                    '</div>' +
(withRemove ? (
                    '<div class="centered col30 text-right">' +
                        '<a class="display-block body-color with-hover with-transition ' + ($ctrl.withInlineBlock ? '' : $ctrl.btnRemoveCls) + '">' + $ctrl.LCS.getISBDiv('cancel', 2) + '</a>' +
                    '</div>') : '') +
                '</div>' +
            '</li>';

        function getMemberType(memberType) {
            switch (memberType) {
                case $ctrl.security.MemberTypes.Owner: return 'Owner';
                case $ctrl.security.MemberTypes.Admin: return 'Admin';
                case $ctrl.security.MemberTypes.Member: return 'Member';
            }
            return '';
        }
    }

    function bindItemClicks(parent, isBind, withRemove) {
        if(!parent){
            return;
        }
        var el = ($ctrl.withInlineBlock || !$ctrl.withInlineBlock && !withRemove) && parent.tagName === 'LI' ? parent : parent.querySelectorAll('.' + (withRemove ? $ctrl.btnRemoveCls : $ctrl.itemClass));
        $ctrl.LCS.bindElementsClick(isBind, el, updateItem);
    }

    function updateItem(e) {
        $ctrl.preventDefault(e);

        console.log('updateItem');
        var el = e.currentTarget,
            isRemove = $ctrl.LCS.hasClass(el, $ctrl.btnRemoveCls);

        if(isRemove && el.tagName !== 'LI'){
            el = $ctrl.LCS.findClosestParent(el, 'li');
        }
        var id = el.getAttribute('data-id'),
            type = 'members',
        //if is member can be removed
        //otherwise if is not with inline can be added
            blockMembers = $ctrl.LCS.findClosestParent(el, '.' + getBlockName(type));

        if(isRemove && $ctrl.removeMessage){
            var item = _.find($ctrl[type], {_id: id}),
                txt = $ctrl.canEdit ? (item ? item.name : 'Selected ' + $ctrl.itemTitle) : 'Yourself';
            $ctrl.popupsService.openConfirmPopup({
                next: process,
                props: {
                    btn: 'Remove ' + ($ctrl.canEdit ? $ctrl.itemTitle : 'Yourself'),
                    icon: 'info-unfilled',
                    title: 'Are you sure?',
                    pageClass: $ctrl.pageClass,
                    message: '<p class="text-center font-size-14 line-height-2">Are you sure you want to remove <span class="semibold">'+txt+'</span> from '+$ctrl.removeFrom+'. '+$ctrl.removeMessage+'</p>',
                }
            });
        } else{
            process();
        }

        function process() {
            bindItemClicks(el, false, isRemove);
            $ctrl.LCS.removeElement(el);

            if (isRemove) {
                removeItem(id);
            } else {
                $ctrl.addItem(id);
            }

            if ($ctrl.withInlineBlock) {
                addMemberToWrapper(blockMembers ? $ctrl.listBottomName : type, id, !isRemove);
            }
        }
    }

    function getImage(item, cls) {
        return $ctrl.security.getImage(item, cls, 'profilePictureURL', 50);
    }
    
    function showSearch() {
        if($ctrl.dontHideSearch){return;}
        if(!$ctrl.searchEl) {
            $ctrl.searchEl = $ctrl.element.querySelector('.' + $ctrl.searchCls);
        }
        $ctrl.LCS[$ctrl.unselected && $ctrl.unselected.length > 0 ? 'removeClass' : 'addClass']($ctrl.searchEl, 'sb-hide');
    }

    function getIndexForId(list, id) {
        return _.findIndex(list, function (item) {
            return item&&item._id === id;
        });
    }

    function updateListVisibility(){
        var mC = set('members'),
            bC = set($ctrl.listBottomName),
            c = mC + bC,
        countEl = $ctrl.element.querySelector('.count');
        if(countEl){countEl.innerHTML = c;}
        setProp( $ctrl.displayDefaultMembers ? true : (c !== 1), 'header-small');

        showSearch();

        function set(type, prop){
            var list = $ctrl[type],
                count = list ? list.length : 0;
            setProp(count > 0, prop, type);
            return count;
        }

        function setProp(show, prop, type){
            $ctrl.LCS[show ? 'removeClass' : 'addClass']($ctrl.element.querySelector('.' + (prop ? prop : getBlockName(type))), 'sb-hide');
        }
    }

    function getWrapperByType(type){
        var name = getBlockName(type);
        if(!$ctrl[name]){
            var el = $ctrl.element.querySelector('.' + name);
            if(el){
                $ctrl[name] = el.querySelector('ul');
            }
        }
        return $ctrl[name];
    }

    function bindLists(isBind, type) {
        bindList('members', true);
        if($ctrl.withInlineBlock) {
            bindList($ctrl.listBottomName, false);
        }

        if(isBind) {
            updateListVisibility();
        }

        function bindList(type, withRemove){
            bindItemClicks(getWrapperByType(type), isBind, withRemove);
        }
    }

    function bindAdd(isBind) {
        if(!$ctrl.btnAdd){
            $ctrl.btnAdd = $ctrl.element.querySelector('#' + $ctrl.btnAddCls);
        }
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnAdd, add);
    }


    function getMemberById(id) {
        return _.find($ctrl.team, function (item) {
            return item._id === id //MemberTypes.Member
        });
    }

    function isDefaultMember(item) {
        return $ctrl.onDefaultMember({item: item});
    }

    function loadSelectize() {
        $ctrl.selectizeEl = $ctrl.element.querySelector('.' + $ctrl.selectizeCls);

        $ctrl.selectedItem = null;
        $ctrl.config = {
            valueField: '_id',
            labelField: 'name',
            placeholder: 'Assign more members…',
            searchField: ['name'],
            inputClass: 'selectize-input selected-text',
            render: {
                item: function (i, e) {
                    return renderItem(i, e, 'item');
                },
                option: function (i, e) {
                    return renderItem(i, e, 'option');
                }
            },
            onChange: $ctrl.addItem
        };

        if ($ctrl.selectizeEl) {
            $ctrl.selectizeService = new SBSelectizeCtrlService(angular.element($ctrl.selectizeEl),  {}, {
                ngModel: $ctrl.selectedItem,
                config: $ctrl.config,
                initList: $ctrl.unselected
            });

            showSearch();
        }

        function renderItem(item, escape, type) {
           var el = '<li class="table-div full-width with-cursor h50">' +
                        '<div class="col40 centered">' + getImage(item, 'smaller') + '</div>' +
                        '<div class="centered"><div class="with-ellipsis">' + item.name + '</div></div>' +
                    '</li>';

            $ctrl.CompileService.addCompiledTemplateWatcher($ctrl.watchers, el, item._id, type);

            return el;
        }
    }
}

angular.module('sb.fields.popovers.assignTeam.component',[
    'sb.fields.popovers.assignTeamMenu.component',
    'dropdowns.drpnonclosed.controller.service',
    'ctrl.popups.service',
    'user.share.collaborators.service'
])
.component('sbAssignTeam', sbFieldComponentParams('AssignTeamCtrl', {
    canChangeEdit: '<',
    withoutDefaultFocus:'@',
    headerSelected: '@',
    teamLabel: '@',
    showMemberType: '@',
    displayDefaultMembers: '@',

    canRemoveCurrent: '@',
    currentId: '@',
    removeMessage: '<',
    productId: '<',
    isProductTeam: '@',

    isAssign: '@',
    showAllTeam: '@',
    showOnlyCounter: '@?',
    withCount: '@?',
    maxCount: '@?',
    circleSize: '@',
    withoutDefaultMembers: '@?',
    initList: '<?'
}, getSBDropdownTemplate('teamSelector')))
.controller('AssignTeamCtrl', AssignTeamCtrl);
AssignTeamCtrl.$inject =['SBDrpNonClosedCtrlService', 'SBFieldTypesService', 'PopupsService', 'RouteCollaboratorsService', '$element', '$attrs'];
function AssignTeamCtrl(SBDrpNonClosedCtrlService, SBFieldTypesService, PopupsService, RouteCollaboratorsService, $element, $attrs) {
    //console.log('AssignTeamCtrl');

    var withoutTemplateScope = false;

    var $ctrl = this;

    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
    $ctrl.PopupsService = PopupsService;

    $ctrl.menuTag = 'sb-assign-team-menu';
    $ctrl.propType = SBFieldTypesService.PropTypes.Team;
    $ctrl.changedFieldsOther = ['canChangeEdit', 'productId'];

    $ctrl.generateDrpMenuContent = generateDrpMenuContent;
    $ctrl.initDrp = initDrp;
    $ctrl.onChangesOther = onChangesOther;
    $ctrl.getCanEdit = getCanEdit;

    $ctrl = new SBDrpNonClosedCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

    function getCanEdit(){
        $ctrl.canEdit = $ctrl.canChangeEdit;
        if($ctrl.canChangeEdit){
            $ctrl.col.canEdit = true;
        }
    }

    function onChangesOther(changes) {
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i],
                change = changes[field];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                if (field === 'canChangeEdit') {
                    getCanEdit();
                    break;
                } else if ($ctrl.isProductTeam && field === 'productId') {
                    setInitList();
                    break;
                }
            }
        }
    }

    function setInitList() {
        if ($ctrl.isProductTeam) {
            $ctrl.initList = $ctrl.CPS.SessionService.getSetting('team');
            var value = $ctrl.productId && $ctrl.CPS.product._id === $ctrl.productId ? $ctrl.RouteCollaboratorsService.getProjectTeam($ctrl.CPS.product, $ctrl.initList) : null;
            $ctrl.value = value ? value.map(function (item) {
                return item ? item._id : null;
            }) : null;
            // $ctrl.value = $ctrl.CPS.productId && $ctrl.CPS.product.teamIds ? $ctrl.CPS.product.teamIds : null;
        }
    }

    function initDrp() {

        setInitList();

        getCanEdit();
        $ctrl.showOnlyCounter = $ctrl.showOnlyCounter === true || $ctrl.showOnlyCounter === 'true';
        $ctrl.showAllTeam = $ctrl.showAllTeam === true || $ctrl.showAllTeam === 'true';
        if (!$ctrl.circleSize) {
            $ctrl.circleSize = 'smaller';
        }
        if ($ctrl.maxCount === undefined || $ctrl.maxCount === 'undefined') {
            $ctrl.maxCount = 100;
        }
        $ctrl.LCS.addClass($ctrl.element, 'sb-assign-team');
    }
    
    function onAction(type) {
        if(type === 'team'){
            $ctrl.popupsService.teamAdminAccess(onAccess);
            function onAccess() {
                var quotaType = 'team',
                    qt = $ctrl.SessionService.getSubscriptionParams(quotaType);
                if ($ctrl.CPS.currentPlan.name === 'Free') {
                    $ctrl.CPS.loadQuotaPopup(quotaType, function (){}, qt.total, qt.total-(qt.remaining||0), $ctrl.compOptions, {e:e});
                }//is free plan doesn't have teams
                else {
                    process();
                }
            }

            function process() {
                var isOpen = $ctrl.PopupsService.isOpen;
                if(isOpen) {
                    for (var type in isOpen) {
                        $ctrl.PopupsService.closePopupByType(type);
                    }
                }
                $ctrl.LCS.timeout(function (){
                    goToTeam();
                }, 100);
            }
        }
    }

    function generateDrpMenuContent() {
        var l = $ctrl.initList ? $ctrl.initList.length : 0;
        if ($ctrl.value && $ctrl.value.length) {
            l += $ctrl.value.length;
        }
        if ($ctrl.isProductTeam) {
            $ctrl.elementId = $ctrl.elementId.replace('elementid', $ctrl.productId);
            $ctrl.getItemId();
        }

        return {
            $ctrl: {
                team: $ctrl.initList,
                value: $ctrl.value,
                removeMessage: $ctrl.removeMessage,
                canEdit: $ctrl.canEdit,

                onSelect: $ctrl.onSelect,
                onAction: onAction,
                onDefaultMember: onDefaultMember
            },

            template:
                ($ctrl.isAssign ?  'is-assign="true" ' : '')+
                'drp-class="' + ($ctrl.showOnlyCounter ? 'toleftless' : (l > $ctrl.maxCount ? 'toleft' : '')) +
                    ($ctrl.drpClassAttr ? (' ' + $ctrl.drpClassAttr) : '') +
                '" ' +
                "can-edit='::" + $ctrl.canEdit + "' " +
                ($ctrl.currentId ?( "current-id='" + $ctrl.currentId + "' ") : '') +
                ($ctrl.canRemoveCurrent ? 'can-remove-current="true" ' : '') +
                 'remove-message="::$ctrl.removeMessage" ' +
                ($ctrl.teamLabel ? ('team-label="' + $ctrl.teamLabel + '"') : '') +
                ($ctrl.headerSelected ? ('header-selected="' + $ctrl.headerSelected + '"') : '') +
                ($ctrl.showMemberType ? ('show-member-type="' + $ctrl.showMemberType + '"') : '') +
                ($ctrl.displayDefaultMembers ? ('display-default-members="' + $ctrl.displayDefaultMembers + '"') : '') +
                "team='::$ctrl.team' " +
                "value='::$ctrl.value' " +

                "on-select='$ctrl.onSelect(result)' " +
                "on-action='$ctrl.onAction(type)' " +
                "on-default-member='$ctrl.onDefaultMember(item)' "
        }
    }

    function onDefaultMember(item) {
        if($ctrl.withoutDefaultMembers === 'true' || $ctrl.withoutDefaultMembers === true){
            return false;
        }
        return item && (item.memberType === $ctrl.security.MemberTypes.Owner || item.memberType === $ctrl.security.MemberTypes.Admin);
    }
    function goToTeam() {
        $ctrl.popupsService.teamAdminAccess(function () {
            $ctrl.CPS.transitionTo('user.team', $ctrl.CPS.currentPathParams());
        });
    }
}

angular.module('sb.fields.popovers.simpleLocationsMenu.component',[
    'sb.fields.selectize.service'
])
.component('sbSimpleLocationsMenu', {
    bindings: {
        canEdit: '<',
        drpClass: '@?',

        membersCount: '<?',
        team : '<?',
        value:'<',
        onSelect: '&',
        onAction: '&',
        onDefaultMember:'&'
    },
    controller: 'SimpleLocationsMenuController'
})

.controller('SimpleLocationsMenuController',SimpleLocationsMenuController);
SimpleLocationsMenuController.$inject =['TemplateCompileCompCtrlService', 'SBSelectizeCtrlService', 'CompileService', '$element'];

function SimpleLocationsMenuController(TemplateCompileCompCtrlService, SBSelectizeCtrlService, CompileService, $element) {
    console.log('SimpleLocationsMenuController');

    var $ctrl = this,
    withoutTemplateScope = true;
    $ctrl.CompileService = CompileService;

    $ctrl.selectizeCls = 'selectizeEl';
    $ctrl.btnRemoveCls = 'btnRemove';
    $ctrl.btnAddCls = 'btnAdd';
    $ctrl.membersListCls = 'membersList';


    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        if(!$ctrl.value) {
            $ctrl.value = [];
        }
        $ctrl.prevValue = angular.copy($ctrl.value);

        $ctrl.defaultMembers = _.filter($ctrl.team, function (item) {
            return isDefaultMember(item);//MemberTypes.Owner && Admin
        });

        $ctrl.members = $ctrl.value.length ? _.filter($ctrl.value.map(getMemberById), function(item){return item !== null && item !== undefined;}) : [];

        $ctrl.unselected = _.filter($ctrl.team, function (item) {
            return !isDefaultMember(item) && (!$ctrl.value || $ctrl.value.indexOf(item._id) === -1);
        });
    }

    function onDestroy() {
        bind(false);
    }

    function getMemberById(id) {
        return _.find($ctrl.team, function (item) {
            return item._id === id //MemberTypes.Member
        });
    }

    function onLoaded() {
        if (!$ctrl.canEdit) {
            return;
        }
        loadSelectize();
        bind(true);
    }

    function loadSelectize(){
        $ctrl.selectedItem = null;
        $ctrl.config = {
            valueField: '_id',
            labelField: 'name',
            placeholder: 'Assign team members…',
            searchField: ['name'],
            inputClass: 'selectize-input selected-text',
            render: {
                item: function (i, e) {
                    return renderItem(i, e, 'item');
                },
                option: function (i, e) {
                    return renderItem(i, e, 'option');
                }
            },
            onChange: onSelectChanged
        };

        $ctrl.selectizeEl = $ctrl.element.querySelector('.'+$ctrl.selectizeCls);
        if($ctrl.selectizeEl){
            $ctrl.SelectizeService = new SBSelectizeCtrlService(angular.element($ctrl.selectizeEl), {}, {
                ngModel: $ctrl.selectedItem,
                config:$ctrl.config,
                initList: $ctrl.unselected
           });

            showSearch();
        }
    }

    function isDefaultMember(item) {
        return $ctrl.onDefaultMember({item: item});
    }

    function onSelectChanged(id) {
        console.log('onSelectChanged'); 
        if($ctrl.value.indexOf(id) === -1){
            $ctrl.value.push(id);
            $ctrl.members.push(angular.copy(getMemberById(id)));
            var index = getIndexForId($ctrl.unselected, id);
            if(index !== -1){
                $ctrl.unselected.splice(index, 1);
            }

            onChanged();
        }
    }

    function remove(e) {
        console.log('removeItem');

        $ctrl.preventDefault(e);
        var id = e.currentTarget.getAttribute('data-id');
        var index = $ctrl.value.indexOf(id);
        if(index !== -1){
            $ctrl.value.splice(index, 1);
            index = getIndexForId($ctrl.members, id);
            $ctrl.members.splice(index, 1);
            $ctrl.unselected.push(angular.copy(getMemberById(id)));

            showSearch();

            onChanged(e);
        }
    }

    function onChanged(e) {
        $ctrl.selectedItem = 'sb-clear';
        $ctrl.SelectizeService.setSelectizeOptions($ctrl.unselected, $ctrl.selectedItem);
        reloadMembers();

        //send update to parent
        $ctrl.prevValue = angular.copy($ctrl.value);
        $ctrl.onSelect({result: {e: null, value: $ctrl.prevValue}});
    }

    function renderItem(item, escape, type) {
var el = '<li class="table-div full-width with-cursor h50">' +
                '<div class="col30 centered">' + getImage(item, 'smaller pull-left') + '</div>' +
                '<div class="centered">' +
                    '<div class="with-ellipsis">' + item.name + '</div>' +
                '</div>' +
            '</li>';

        $ctrl.CompileService.addCompiledTemplateWatcher($ctrl.watchers, el, item._id, type);

        return el;
    }

    function add(e) {
        onAction(e, 'team');
    }
    
    function onAction(e, type) {
        $ctrl.preventDefault(e);
        $ctrl.onAction({type: type});
    }

    function getItemTemplate() {
return '<div class="dropdown-menu selector-dropdown with-overflow selectabledropdown addteammate '+ ($ctrl.drpClass?$ctrl.drpClass:'')+ '">' +
            '<div>' +
                ($ctrl.canEdit?('<div class="sb-hide form-group sbfgroup field last withSearch margin-top-half">' +
                     $ctrl.LCS.getISBDiv('search')+
                    '<div class="'+$ctrl.selectizeCls+'"></div>' +
                '</div>'):'') +
                //'<div class="header no-underline">Assigned Team</div>' +
                '<div class="show-scrollbar-on-hover">' +
                    '<div class="fancy-scrollbar vertical" style="max-height: 224px;margin-right: -20px;padding-right: 10px; margin-top: 20px">' +
                        '<div>' +
                            '<div class="select-choices with-teams display-block">' +
                                loadlist($ctrl.members, true) +
                                loadlist($ctrl.defaultMembers)+
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
            ($ctrl.canEdit ? ('<div class="with-side-padding spacing-half clearfix with-border-top">' +
                '<a id="'+$ctrl.btnAddCls+'" class="pull-left smaller-font with-hover">' +
        $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left with-margin-right') +
     ' Invite Users</a>' +
            '</div>') : '') +
        '</div>';
    }

    function loadlist(list, checked) {
        return '<ul class="'+(checked? $ctrl.membersListCls : 'adminsList no-last-border')+'">' + getListEls(list, checked) + '</ul>';
    }

    function getListEls(list, checked) {
        var el = '';
        if(!list.length){return '';}
        _.each(list, function (item, i) {
            el += getListItem(item, checked);
        });
        return el;
    }

    function reloadMembers() {
        bindList();
        if ($ctrl.membersList) {
            $ctrl.LCS.appendChildFragment($ctrl.membersList, getListEls($ctrl.members, true), true);
            bindList(true);
        }
    }
    
    function showSearch() {
        var searchEl = $ctrl.element.querySelector('.search');
        $ctrl.LCS[$ctrl.unselected && $ctrl.unselected.length > 0 ? 'removeClass' : 'addClass'](searchEl, 'sb-hide');
    }

    function getListItem(item, checked) {
        if(!item){return '';}
return '<li class="ui-select-choices-group ' + (checked ? 'with-cursor' : '') + '">' +
            '<div class="select-choices-row-inner table-div fixed-layout">' +
                '<div class="col30 vtop">' + getImage(item, 'smaller pull-left' ) +  '</div>' +
                '<div>' +
                    '<div class="with-ellipsis name">'+item.name+'</div>' +
    //not confirmed
    (item.memberType!== $ctrl.security.MemberTypes.Owner && item.status !== 2 ? '<div class="smaller-orange">Invited and pending…</div>' : '') +
                '</div>' +
    (checked ? ('<div class="col20 with-padding-left">' +
                    ($ctrl.canEdit ? ('<a class="'+$ctrl.btnRemoveCls+' display-block" data-id="'+item._id+'">'+$ctrl.LCS.getISBDiv('delete-circle')+'</a>') : '') +
                '</div>') :'') +
            '</div>' +
        '</li>';
    }

    function getImage(item, cls) {
        return $ctrl.security.getImage(item, cls + ' pull-left', 'profilePictureURL', 100);
    }

    function getIndexForId(list, id) {
        return _.findIndex(list, function (item) {
            return item&&item._id === id;
        });
    }

    function bind(isBind) {
        bindList(isBind);
        bindAdd(isBind);
    }

    function bindList(isBind) {
        if (!$ctrl.membersList) {
            $ctrl.membersList = $ctrl.element.querySelector('.' + $ctrl.membersListCls);
        }

        if (!$ctrl.membersList) {
            return;
        }

        if (isBind) {
            $ctrl.btnRemove = $ctrl.membersList.querySelectorAll('.' + $ctrl.btnRemoveCls);
        }
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnRemove, remove);
    }

    function bindAdd(isBind) {
        if(isBind){
            $ctrl.btnAdd = $ctrl.element.querySelector('#' + $ctrl.btnAddCls);
        }
        $ctrl.LCS.bindElementsClick(isBind,$ctrl.btnAdd, add);
    }
}

angular.module('sb.fields.popovers.simpleLocations.component',[
    'sb.fields.popovers.simpleLocationsMenu.component'
])
.component('sbSimpleLocations', sbFieldComponentParams('SimpleLocationsCtrl', {
    canEdit: '<',
    showAllTeam: '@',
    showOnlyCounter: '@?',
    withCount:'@',
    maxCount: '@?',
    circleSize: '@',
    withoutDefaultMembers: '@?',
    initList: '<?'
}, getSBDropdownTemplate('teamSelector')))
.controller('SimpleLocationsCtrl', SimpleLocationsCtrl);
SimpleLocationsCtrl.$inject =['SBDrpNonClosedCtrlService', 'SBFieldTypesService', '$element', '$attrs'];

function SimpleLocationsCtrl(SBDrpNonClosedCtrlService, SBFieldTypesService, $element, $attrs) {
    console.log('SimpleLocationsCtrl');
var withoutTemplateScope = false;

    var $ctrl = this;
    $ctrl.menuTag = 'sb-assign-simple-locations-menu';

    $ctrl.propType = SBFieldTypesService.PropTypes.Team;
    $ctrl.generateDrpMenuContent = generateDrpMenuContent;
    $ctrl.initDrp = initDrp;

    $ctrl = new SBDrpNonClosedCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

    function initDrp() {
        if($ctrl.canEdit){
            $ctrl.col.canEdit = true;
        }

        $ctrl.showOnlyCounter = $ctrl.showOnlyCounter===true||$ctrl.showOnlyCounter==='true';
        $ctrl.showAllTeam = $ctrl.showAllTeam===true||$ctrl.showAllTeam === 'true';
        if (!$ctrl.circleSize) {
            $ctrl.circleSize = 'smaller';
        }
        if ($ctrl.maxCount === undefined || $ctrl.maxCount === 'undefined') {
            $ctrl.maxCount = 100;
        }
    } 
    
    function onAction(type) {
        if(type === 'team'){
            goToTeam();
        }
    }

    function generateDrpMenuContent() {
        var l = $ctrl.initList ? $ctrl.initList.length : 0;
        if ($ctrl.value && $ctrl.value.length) {
            l += $ctrl.value.length;
        }

        return {
            $ctrl: {
                team: $ctrl.initList,
                value: $ctrl.value,
                onSelect: $ctrl.onSelect,
                onAction: onAction,
                onDefaultMember: onDefaultMember
            },
            template: 'drp-class="' + ($ctrl.showOnlyCounter ? 'toleftless' : (l > $ctrl.maxCount ? 'toleft' : '')) + '" ' +

                "can-edit='::" + $ctrl.canEdit + "' " +

                "team='::$ctrl.team' " +
                "value='::$ctrl.value' " +

                "on-select='$ctrl.onSelect(result)' " +
                "on-action='$ctrl.onAction(type)' " +
                "on-default-member='$ctrl.onDefaultMember(item)' "
        }
    }


    function onDefaultMember(item) {
        if($ctrl.withoutDefaultMembers === 'true' || $ctrl.withoutDefaultMembers === true){
            return false;
        }
        return item && (item.memberType === $ctrl.security.MemberTypes.Owner || item.memberType === $ctrl.security.MemberTypes.Admin);
    }
    function goToTeam() {
        $ctrl.popupsService.teamAdminAccess(function () {
            $ctrl.CPS.transitionTo('user.team', $ctrl.CPS.currentPathParams({addSeats: true}));
        });
    }
}

angular.module('sb.fields.popovers.simpleSelector.component',[
    'fields.popovers.simpleSelector.controller.service'
])
.component('sbSimpleSelector', {
    bindings: {
        pageClass: '@',
        elemtype: '@',
        withSquareImg: '@',
        itemTitle: '@',
        emptyItemTitle: '@',
        tableType: '@',
        withEllipsis: '@',
        withUppercase: '@',
        multipleSelection: '@',
        withImage: '@',
        withScroll: '@',
        icon:'@',
        iconLevel: '<',
        hideIconCircle: '<',

        value: '<',
        list: '<',

        onSelect: '&',
        onSearch: '&'
    },
    controller: 'SimpleSelectorCtrl'
})
.controller('SimpleSelectorCtrl',SimpleSelectorCtrl);
SimpleSelectorCtrl.$inject =['SBSimpleSelectorCtrlService', '$element'];

function SimpleSelectorCtrl(SBSimpleSelectorCtrlService, $element) {
    console.log('SimpleSelectorCtrl');
    var $ctrl = this;

    $ctrl.withoutTemplateCompile = true;
    $ctrl.withoutSeparatedLists = true;

    $ctrl.onChange = onChange;

    $ctrl = new SBSimpleSelectorCtrlService($ctrl, $element, $ctrl.withoutTemplateCompile);

    return $ctrl;

    //todo reassess where to add these
    function onChange(result) {
        if (!result) {
            console.log('onchange: result is undefined');
            return;
        }
        console.log('onchange');
        var selected = result.selected;
        if (selected) {

            var s = selected.field.split('.');
            if (s.length === 1) {
                $ctrl.item[selected.field] = selected.val;
            } else if (s.length === 2) {
                if (!$ctrl.item[s[0]]) {
                    $ctrl.item[s[0]] = {};
                }
                $ctrl.item[s[0]][s[1]] = selected.val;
            }
        }
        setEditFocus(result.tabNextIndex);
    }

    function setEditFocus(tabIndex) {
        if (tabIndex !== undefined) {
            $ctrl.broadcastRoot('SET_FIELD_FOCUS_' + tabIndex);
        }
    }
}


angular.module('sb.fields.stripLocation.component', [
    'sb.fields.selectize.service',
    'sb.fields.popovers.assignElements.init.controller.service.component'
])
.component('sbStripLocation', {
    bindings: {
        // config: '<?',

        scriptLoadingService: '<',
        stripId: '<',
        initList: '<?',

        elementId: '@',

        value: '<',
        onChange: '&',
        onAdd: '&',
        onCancel: '&'
    },
    template: '<div class="selectizer"></div><div class="selectinit"></div>',
    controller: SbStripLocationCtrl
})
.controller('SbStripLocationCtrl', SbStripLocationCtrl);

SbStripLocationCtrl.$inject = ['AssignElementsInitCtrlService', 'SBSelectizeCtrlService', '$element', '$attrs'];

function SbStripLocationCtrl(AssignElementsInitCtrlService, SBSelectizeCtrlService, $element, $attrs) {
    var $ctrl = this;
    $ctrl.$attrs = $attrs;
    $ctrl.elemtype = 'stripLocation';
    $ctrl.elementType = 3;
    $ctrl.tableType = 'taggingScenes';
    $ctrl.categoryId = "5a69235fdf0fbc89a637c1c1";
    $ctrl.selectizeCls = '';
    var startNew = false;
    //$ctrl.keyDownEvent = keyDownEvent;
    //$ctrl.onFieldFocus = onFieldFocus;
    // $ctrl.onFieldBlur = onFieldBlur;
    $ctrl.onSelect = onSelect;

    $ctrl.getDefaultParams = getDefaultParams;
    $ctrl.getElementFromCache = getElementFromCache;
    $ctrl.getNew = getNew;
    $ctrl.initOthers = initOthers;
    $ctrl.getList = getList;

    $ctrl.$onInit = $onInit;

    $ctrl.onOtherError = onOtherError;
    $ctrl.setReqField = setReqField;
    $ctrl.postCustomSelectorInitSave = postCustomSelectorInitSave;

    $ctrl = new AssignElementsInitCtrlService($ctrl, getElementByClass('selectinit'));

    function $onInit() {
        $ctrl.withoutStripId = $ctrl.$attrs.withoutStripId === 'true';
        $ctrl.stripIds = [$ctrl.stripId];
        $ctrl.assignElementsInit();
        initSelectize();
    }

    function getElementByClass(cls){
        return angular.element($element[0].querySelector('.' + cls));
    }
    function getElementFromCache (elementId) {
        return elementId ? $ctrl.scriptLoadingService.getTaggingElementById(elementId) : null;
    }

    function postCustomSelectorInitSave(withChange, isCreate) {
        console.log('postCustomSelectorInitSave');
        if(withChange) {
            if (isCreate) {
                $ctrl.isSaving = false;
                $ctrl.SelectizeService.setSelectizeOptions($ctrl.initList, $ctrl.value);
            } else {
                $ctrl.SelectizeService.setSelectizeValue($ctrl.value);
            }
        }
    }

    function onOtherError(err, type, mess, name) {
        $ctrl.isSaving = false;
    }

    function initOthers() {
        $ctrl.getNew = getNew;
        $ctrl.service = $ctrl.scriptLoadingService.getObjectService($ctrl.scriptLoadingService.TblTypes.TaggingScenes);
    }

    function getNew() {
        return $ctrl.service.convertResource(_.extend({
                _id: new ObjectId().toString(),
                order: $ctrl.getOrder($ctrl.initList),
                name: null,
                type: $ctrl.elementType,
                allScenes: false,
                searchPosition: true,
                count: 1
            },
            $ctrl.withoutStripId ? {withoutStripId: true} : null,
            $ctrl.getDefaultParams()
        ));
    }

    function setReqField(n, isClear,withEmpty ) {

    }

    function getList() {
        return $ctrl.initList;
    }

    function initSelectize() {
        $ctrl.config = {
            valueField: '_id',
            labelField: 'name',
            placeholder: $ctrl.$attrs.placeholder || "Assign set…",
            searchField: ['name'],
            inputClass: 'selectize-input selected-text changecolor uppercase with-underline ' + $ctrl.pageClass,
            create: function(name) {
                if($ctrl.initList && $ctrl.initList.length> 0 && _.find($ctrl.initList, function (item) {
                    return item.name && name && item.name.toLowerCase() === name.toLowerCase();
                })){
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.objectType + '.Create.duplicate', 'error');
                    return false;
                }
                return {
                    _id : new ObjectId().toString(),
                    name: name.toUpperCase(),
                    isNew: true,
                    isFromSelectize: true
                };
            },
            render: {
                option_create: onOptionCreate
            },
            onChange: onOptionChange,
            onOptionAdd: onOptionAdd
        };

        $ctrl.selectizeEl =  getElementByClass('selectizer');//$ctrl.element.querySelector('.'+$ctrl.selectizeCls);
        if($ctrl.selectizeEl){
            $ctrl.SelectizeService = new SBSelectizeCtrlService(angular.element($ctrl.selectizeEl), {}, {
                ngModel: $ctrl.value || null,
                config:$ctrl.config,
                initList: angular.copy($ctrl.initList),
                onChange: $ctrl.onChange
            });
        }
    }

    function onOptionCreate(data, escape) {
        return '<div class="create">Add <strong>' + escape(data.input) + '</strong>&hellip;</div>';
    }

    function onOptionAdd(value, $item) {
        console.log('onAddStripLocation');
        if ($ctrl.isSaving) {
            return;
        }
        var el = $ctrl.initList ? _.find($ctrl.initList, function (el){
            return el[$ctrl.config.labelField] === $item[$ctrl.config.labelField];
        }) : null;
        if(!el){
            if(!startNew) {
                $ctrl.startNew(true);
                startNew = true;
            }
            //create new strip location with that name and add it to db
            $ctrl.isSaving = {val: $item._id};
            $ctrl.item =_.extend($ctrl.getNew(), $item);
            delete $ctrl.item.isFromSelectize;
            $ctrl.save();

            startNew = false;
        }else if($ctrl.value !== el._id){
            $ctrl.value = el._id;
            onOptionChange($ctrl.value);
        }
    }

    function onOptionChange(id) {
        console.log('onChangedStripLocation');
        if (!$ctrl.isSaving && id) {

            $ctrl.value = id;

            if(!$ctrl.withoutStripId) {
                $ctrl.applyChangesInit(null, [id], $ctrl.prevValue ? [$ctrl.prevValue] : []);
            }
        }
    }

    function getDefaultParams(type) {
        return _.extend({
            categoryId: $ctrl.categoryId
        }, $ctrl.getDefaultInitParams(type));
    }

    function onSelect(result) {//used on create
        console.log('SbStripLocationCtrl.onselect');
        if (!result) {return;}
        if(result.result){result = result.result;}
        var res,
            strip = result.stripIds && result.stripIds.length > 0 ? $ctrl.scriptLoadingService.getStripById(result.stripIds[0]) : null;
        if (strip) {
            var str = $ctrl.elementId ? $ctrl.elementId.split(['_']) : null,
                id = str && str[0] ? str[0] : null,
                prop = $ctrl.elemtype + 'Id',
                editchanges = {
                    _id: id,
                    elements: strip.elements
                };
            editchanges[prop] = strip[prop];
            editchanges[$ctrl.elemtype] = strip[$ctrl.elemtype];
            res = {
                id: id,
                prop: prop,
                editchanges: editchanges,
                selected: {
                    field: prop,
                    val: $ctrl.value
                },
                newRes: {updatesG: {}},//to trigger allstrips reload
                close: true
            };
        }

        $ctrl.setNewValue(result.e, result.value);
        $ctrl.onChange({result: res});
    }
}

