})
.controller('CallsheetConfirmPageCtrl', CallsheetConfirmPageCtrl);
CallsheetConfirmPageCtrl.$inject =  ['CallsheetPageInitCtrlService', '$element'];
function CallsheetConfirmPageCtrl(CallsheetPageInitCtrlService, $element) {
    console.log('CallsheetConfirmPageCtrl');
    var $ctrl = this;
    $ctrl.getPageTemplate = getPageTemplate;
    $ctrl = new CallsheetPageInitCtrlService($ctrl, $element);

    $ctrl.$onInit = $onInit;
    $ctrl.$onDestroy = $ctrl.onPageDestroy;

    function $onInit() {
        $ctrl.initPage($element);
    }

    function getPageTemplate() {
        return '<callsheet-view page-type="confirm" info="::$ctrl.info" pre-loading-service="::$ctrl.preLoadingService"></callsheet-view>';
    }
}

