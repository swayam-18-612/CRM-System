angular.module('user.dashboardPage.myCallsheets.component', [
    'user.dashboardPage.widget.component.service',
    'apiConstants.myCallsheets.services',
    'user.dashboardPage.myCallsheetsGroup.component',
])
.component('myCallsheets', {
    bindings: getDashboardWidgetGroupBindings(),
    controller: 'MyCallsheetsCtrl'
})
.controller('MyCallsheetsCtrl', MyCallsheetsCtrl);
MyCallsheetsCtrl.$inject = ['DashboardWidgetCtrlService', 'MyCallsheetsConstantsService', '$element'];
function MyCallsheetsCtrl(DashboardWidgetCtrlService, constantsService, $element) {
    console.log('MyCallsheetsCtrl');
    var $ctrl = this;

    $ctrl.DashboardWidgetCtrlService = DashboardWidgetCtrlService;

    $ctrl.preInitOther = preInitOther;
    $ctrl.onPreloadedService = onPreloadedService;
    $ctrl.getOtherParams = getOtherParams;
    $ctrl.preProcessGroupItems = preProcessGroupItems;

    $ctrl = new $ctrl.DashboardWidgetCtrlService($ctrl, constantsService, $element);

    function preInitOther(constantsService){
        var c = angular.copy(constantsService);
        c.GroupSettings = _.extend({}, c.GroupSettings, {
            dragHandleOnTheSide: false,
            withoutGroupSorting: true,
            showSortingColumns: false,
            gridItemClass: ' ',
        }, $ctrl.isFullItem ? {
            gridItemClass: ' ',
            hideGridHeader: false,
            noBorderGridHeader: true,
        } : {
            isMyCallsheets: true,
            isLightMode: true
        });

        if($ctrl.isFullItem){
            c.Options = _.extend({}, c.Options, {
                showHeader: true,
                columns: ['1', '2' , '3', '3.1', '4', '5', '6', '7', '10']
            });
        } else{
            _.each(c.Columns, function (id) {
                c.Columns [id].canEdit = false;
            });
        }

        $ctrl.constantsService = c;
    }

    function preProcessGroupItems(item) {
        item.product = _.find($ctrl.products, {_id: item.productId});

        if(!item.product){
            return null;
        }

        item.productName = item.product.name;

        return item;
    }

    function getOtherParams() {
        return {teamId: $ctrl.CPS.teamId};
    }

    function onPreloadedService(err, result){
        $ctrl.team = $ctrl.SessionService.getSetting('team');
        $ctrl.other = result;
        $ctrl.products = $ctrl.other && $ctrl.other.products ? $ctrl.other.products.map(function (p){
            p.teamIds = [];
            p.team = _.filter(_.unique(p.teamIds).map(function (id){
                return _.find($ctrl.team, {_id: id});
            }), function (el){
                if(el){
                    p.teamIds.push(el._id);
                }
                return el;
            });
            return p;
        }) : null;
    }
}

angular.module('user.dashboardPage.myCallsheetsGroup.component', [
    'groupBlock.controller.service',
    'user.dashboardPage.myCallsheets.item.grid.component',
    'product.callsheets.group.component.service'
])
.component('mycallsheetsGroup', groupBlockComponentParams('MyCallsheetsGroupCtrl', {
    onListItemsQuery: '&',
    preProcessGroupItems: '&',
    nestedLevel: '@'
}))
.controller('MyCallsheetsGroupCtrl', MyCallsheetsGroupCtrl);
MyCallsheetsGroupCtrl.$inject = ['CallsheetsGroupCtrlService', 'GroupBlockInitCtrlService', '$element'];
function MyCallsheetsGroupCtrl(GroupCtrlService, GroupBlockInitCtrlService, $element) {
    console.log('MyCallsheetsGroupCtrl');
    var $ctrl = this;
    $ctrl.productOverviewStateName = 'user.product.overview';

    $ctrl.GroupCtrlService = GroupCtrlService;
    $ctrl.GroupBlockInitCtrlService = GroupBlockInitCtrlService;

    $ctrl.styles = {borders: 0};
    $ctrl.callsheetsFilter = 0;
    $ctrl.goToProduct = goToProduct;
    $ctrl.getBottomActions = getBottomActions;

    $ctrl.hasMobileDetails = hasMobileDetails;
    $ctrl.$onInit = $onInit;
    //$ctrl.processListItemColumn = processListItemColumn;
    //item methods
    if(!$ctrl.hasClick) {
        $ctrl.hasClick = hasClick;
    }

    // $ctrl.onListItemsQuery = onListItemsQuery;

    $ctrl = new $ctrl.GroupCtrlService($ctrl);

    function $onInit() {
        $ctrl.isFullItem = $element[0].getAttribute('is-full-item') === 'true';

        $ctrl.canEdit = false;

        $ctrl.customButtons = true;
        $ctrl.hideRemoveBtn = true;
        $ctrl.options = $ctrl.constantsService.Options;
        $ctrl.withCustomSettings = $ctrl.constantsService.CompOptions.withCustomSettings;

        $ctrl.onInit();

        $ctrl = new $ctrl.GroupBlockInitCtrlService($ctrl, $element, $ctrl.Pagination, $ctrl.constantsService, null);
    }

    function hasMobileDetails(){
        return false
    }

    function goToProduct(productId, e) {
        $ctrl.popupsService.teamAccess(function () {
            redirect($ctrl.productOverviewStateName, {
                productId: productId
            });
        });
    }

    function redirect(e, name, params){
        var p = $ctrl.CPS.currentPathParams(params);
        if (e && e.shiftKey) {
            $ctrl.CPS.openInNewWindow(name, p);
        } else {
            $ctrl.CPS.transitionTo(name, p);
        }
    }

    function onListItemsQuery() {
        console.log('onListItemsQuery');
        return function (item) {
            if (!item) {
                return false;
            }
            return $ctrl.callsheetsFilter === 0 || //return all
                $ctrl.callsheetsFilter === 1 && item.completed || //return completed
                $ctrl.callsheetsFilter === 2 && !item.completed; //return uncompleted
        }
    }

    function hasClick(item){
        return $ctrl.isActiveFilter() && $ctrl.isActiveItem(item);
    }

    function getName(item, prop, cls, event, other) {
        var hasclick = event && $ctrl.hasClick(item),
            tag = 'div',//(hasclick ? 'a' : 'div'),
            withclick = hasclick ? (' no-drag with_underline with-cursor" '
               //+ 'href="' + $ctrl.CPS.getStateHref('user.product.overview', currentPathParams(item))
          ) : '';
        return '<' + tag + ' class="' + (cls||'') + ' display-block ' +
            $ctrl.getViewEditElemSelector(prop, false, $ctrl.canEdit) + ' ' +
            $ctrl.getClickEventName(event) +
            (hasclick ? withclick : '') + '">' + (other || '') + $ctrl.LCS.convertHtmlToText(item[prop]) +
            '</' + tag + '>';
    }

    function getBottomActions(item) {
        return '<div class="ng-hide hide-print spacing text-center empty-state" ng-show="$ctrl.list.items.length===0">' +
            '<div class="empty-img my-callsheets">&nbsp;</div>'+
            '<p class="empty-txt">No upcoming callsheets</p>' +
            '</div>';
    }
}

