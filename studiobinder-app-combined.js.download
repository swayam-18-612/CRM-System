addMoSePa('Documents', 'documents', TempDocumentsService, {
    modelMethod: DocumentsFactory,
    serviceInjectList: ['DocumentVersions', 'Collaborators'],
    serviceInjectMod: [
        'resources.DocumentVersions',
        'resources.Collaborators',
        'product.material.fileStats.service']
});

function DocumentsFactory(ApiResource ) {
    var model = ApiResource(SBApiCollections.Documents);

    model.getType = function  () {
        return 'note';
    };
    model.prototype.getType = function  () {
        return this.isFolder ? 'folder' : 'note';
    };

    return model;
}

function TempDocumentsService(ApiService, model, DocumentVersions, Collaborators) {

    var documentTypes = {
        2: {
            name: "Screenplay",
            color: "#FFB53D",
            icon: "screenplay",
            type: 2,
            tooltip: "",
            ext: 'SBX'
        },
        1: {
            name: "Document",
            color: "#D8E0E6",
            icon: "freestyle",
            type: 1,
            tooltip: "",
            ext: 'SBDOC'
        },  3: {
            name: "AV Script",
            color: "#66D4FF",
            icon: "avScript",
            type: 3,
            tooltip: "",
            ext: 'SBAV'
        }
     };

    var service = ApiService(model, {
        listType: 'isListRecursive',
        convertOtherResources: convertOtherResources,
        fieldsUpdatedOnOrderChanged: ['epNo'],
        materialProps: ['logo']
    });

    service.documentTypes = [
        documentTypes['2'],
        documentTypes['1'],
        //documentTypes['3']
    ];

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.getEditableFields = getEditableFields;
    service.getBreadcrumbs = getBreadcrumbs;
    service.duplicate = duplicate;

    //service.getAll = getAll;

    return service;

    function getEditableFields() {
        return ['name', 'collaborators',
            'description', 'prefix', 'logo', 'logoId', 'epNo', 'customEpNo'];
    }

    function getChangedFieldForUpdateOther() {
        return ['name', 'parentId',  'order', 'updatedAt', 'updatedById',
            'scratchPad', 'version.updatedAt', 'version.updatedById', 'version.contentVersionId', 'version.description', 'version.name', 'version.scratchPad',
            'description', 'prefix', 'logo', 'logoId', 'epNo', 'customEpNo'];
    }

    function convertOtherResources(item) {
        if(!item.updatedAt && item.createdAt){
            item.updatedAt = item.createdAt;
        }
        if(!item.updatedById && item.createdById){
            item.updatedById = item.createdById;
        }

        if (item.versionId && typeof(item.versionId) === 'object') {
            item.version = new DocumentVersions(item.versionId);
            item.versionId = item.versionId._id;
        }

        if (item.parentId && typeof(item.parentId) === 'object') {
            item.parent = new model(item.parentId);
            item.parentVersionId = item.parentId._id;
        }

        if (item.collaborators && item.collaborators.length > 0) {
            item.collaborators = item.collaborators.map(function (item) {
                if (item && typeof(item.getType) !== 'function') {
                    item = new Collaborators(item);
                }

                return item;
            });
        }
        return item;
    }

    function getBreadcrumbs(data, successcb, errorcb) {
        return service.postUrl('/breadcrumbs/' + data.id, data, successcb, errorcb);
    }

    function duplicate(params, successcb, errorcb) {
        return service.postUrl('/duplicate', params, function (res) {
            if (res.addded && res.addded.length > 0) {
                var total = 0;
                res.addded = res.items.map(function (item) {
                    if (item && item.total) {
                        total += item.total;
                    }
                    return item ? service.convertResource(item) : null;
                });
                if (res.item) {
                    res.item.count = total;
                }
            }
            return successcb(res);
        }, errorcb);
    }

    function getAll(query, pageSize, populate, successcb, errorcb) {
        return service.$getAll(query, pageSize, populate, function (result) {
            var docs = result.docs,
                users = result.users;
            if (users) {
                docs = docs.map(function (item) {
                    if (item.collaborators) {
                        item.collaborators = item.collaborators.map(function (el) {
                            var userId = el ? el.userId : null;
                            if (userId) {
                                var user = _.find(users, function (el1) {
                                    return el1._id === userId;
                                });
                                if (user) {
                                    el.user = new service.Users(user);
                                    el.userId = userId;
                                }
                            }

                            return el;
                        });
                    }
                    return item;
                });
            }
            return successcb(docs);
        }, errorcb);
    }
}

