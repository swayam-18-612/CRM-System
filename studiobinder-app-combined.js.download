SBIconDrpMenuCtrl.$inject = ['SBDrpMenuCtrlService', '$element'];
function SBIconDrpMenuCtrl( SBDrpMenuCtrlService, $element) {
    console.log('SBIconDrpMenuCtrl');
    var $ctrl = this;

    $ctrl.withChecks = true;

    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new SBDrpMenuCtrlService($ctrl, $element);

    function getItemTemplate() {
        var el = "<div class='dropdown-menu custom-drp-ul custom-icon " +
            ($ctrl.fixedHeight ? "fixedHeight " : '') +
            ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '') +
            "'>";
        if($ctrl.header) {
            el += "<div class='header clearfix'>" + $ctrl.header + "</div>";
        }
        el += "<div class='custom-wrapper'>";
            var i = 0;
            _.each($ctrl.list, function (item) {
                var v = item[$ctrl.valueField],
                    l = item[$ctrl.labelField];
        el += "<div class='custom-checkbox inrow ' data-id='" + v + "' data-index='" + (i++) + "'>" +
                "<label class='sbf text-center customitem "+v+"'><input type='checkbox'/><span></span><span></span></label>" +
            "</div>";
            });

        return el + "</div>" +
        "</div>" +
          $ctrl.getSaveBtns();
    }
}

angular.module('dropdowns.sbIconDropdown.component', [
    'dropdowns.sbIconDropdown.menu.component',
    'dropdowns.sbDropdown.controller.service'
])
.component('sbIconDropdown', sbFieldComponentParams('SBIconDropdownCtrl', sbDefaultDrpComponentParams({
    header: '@',
    longer: '@?',
    withUncheck: '@?',
}), "<div class='selected'><div class='dropdown-sel-text drp-icon'></div></div>"))

.controller('SBIconDropdownCtrl', SBIconDropdownCtrl);

SBIconDropdownCtrl.$inject = ['SBFieldTypesService', 'SBFieldInitCtrlService', 'SBDrpInitCtrlService', '$element', '$attrs'];
function SBIconDropdownCtrl(SBFieldTypesService, SBFieldInitCtrlService, SBDrpInitCtrlService, $element, $attrs ) {
var withoutTemplateScope = true;

    var $ctrl = this;
    $ctrl.menuTag = 'sb-icon-dropdown-menu';
var prevValue = null;
    $ctrl.propType = SBFieldTypesService.PropTypes.Icon;
    $ctrl.$onDestroy = $onDestroy;

    $ctrl = new SBFieldInitCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

    $ctrl.getInputText = getInputText;
    $ctrl.setDisplayValueDrpOther = setDisplayValueDrpOther;

    $ctrl.onInitFieldLoaded = onInitFieldLoaded;
    $ctrl.generateDrpMenuContent = generateDrpMenuContent;

    $ctrl.initDrp = initDrp;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.initDrp();
        $ctrl.withRepeatFromDrp = true;
        $ctrl = new SBDrpInitCtrlService($ctrl, $element);
    }

    function initDrp() {
        $ctrl.setInputField = false;
        $ctrl.valueField = 'id';

        $ctrl.longer = $ctrl.longer === 'true' || $ctrl.longer === true;
        $ctrl.withUncheck = $ctrl.withUncheck === 'true' || $ctrl.withUncheck === true;


        if (!$ctrl.header) {
            $ctrl.header = 'Change Icon';
        }
        if (!$ctrl.placeholder) {
            $ctrl.placeholder = 'Change Icon';
        }
        if ($ctrl.value === undefined) {
            $ctrl.value = null;
        }
    }

    function onInitFieldLoaded(){
        $ctrl.elSelText = $ctrl.element.querySelector('.dropdown-sel-text');
        $ctrl.selectModel = _.find($ctrl.list, function (item) {
            return item[$ctrl.valueField] === $ctrl.value;
        });


        if ($ctrl.longer){
            $ctrl.elLongText = document.createElement('span');
            setLongText();
            $ctrl.elSelText.appendChild($ctrl.elLongText);
        }

        $ctrl.LCS.addClass($ctrl.elSelText, 'sbf');

        if ($ctrl.drpName) {
            $ctrl.elSelText.setAttribute('name',  $ctrl.drpName);
        }

        $ctrl.LCS.addClass($ctrl.element, $ctrl.element.tagName.toLowerCase() +
            ' display-block clearfix wrap-dd-select custom-drp-selector ' +
            //'custom-icon-selector ' +
            ($ctrl.longer ? 'longer without-underline ' : 'without-arrow smaller '));

        $ctrl.onRepeatFieldLoaded();
    }

    function setDisplayValueDrpOther(){
        if ($ctrl.value !== prevValue) {
            if (prevValue) {
                $ctrl.LCS.removeClass($ctrl.elSelText, prevValue);
            }
            $ctrl.LCS.addClass($ctrl.elSelText, $ctrl.value);
            prevValue = $ctrl.value;
        }

        setLongText();
    }

    function getInputText(el) {
        console.log('getInputText');
        $ctrl.selectModel = el;
    }

    function setLongText() {
        if ($ctrl.longer) {
            $ctrl.elSpan.textContent = $ctrl.value ? 'Change Icon' : 'Select Icon';
            $ctrl.LCS [$ctrl.value ? 'removeClass' : 'addClass']($ctrl.elSelText, 'selected-text');
        }
    }

    function $onDestroy() {
        if($ctrl.onInitDestroy){
            $ctrl.onInitDestroy();
        }
    }

    function generateDrpMenuContent() {
        return {
            $ctrl: {
                fixedHeight: $ctrl.fixedHeight,
                labelField: $ctrl.labelField,
                valueField: $ctrl.valueField,
                list: $ctrl.initList,
                value: angular.copy($ctrl.value),
                onSelect: $ctrl.onSelect
            },
            template: ($ctrl.fixedHeight ? ("fixed-height='true' ") : '') +
                "list='$ctrl.list' " +
                "value='::$ctrl.value' " +

                "label-field='::$ctrl.labelField' " +
                "value-field='::$ctrl.valueField' " +

                "on-select='$ctrl.onSelect(result)' "
        };
    }
}

angular.module('dropdowns.sbDropdown.likesComments.menu.component', [
    'dropdowns.drpMenu.controller.service'
])
.component('sbLikesCommentsDropdownMenu', {
    bindings: {
        elementId:'@',
        fixedHeight: '@',
        withLikes: '@',
        withComments: '@',
        labelField: '@',
        valueField: '@',
        value: '<',
        onSelect: '&',
    },
    controller: 'LikesCommentsDrpMenuCtrl',
})
.controller('LikesCommentsDrpMenuCtrl', LikesCommentsDrpMenuCtrl);

LikesCommentsDrpMenuCtrl.$inject = ['SBDrpMenuCtrlService', 'SBFieldTypesService', '$element'];
function LikesCommentsDrpMenuCtrl( SBDrpMenuCtrlService, SBFieldTypesService, $element) {
    console.log('LikesCommentsDrpMenuCtrl');
    var $ctrl = this;
    $ctrl.SBFieldTypesService = SBFieldTypesService;

    var types = ['likes', 'commentsCount'],
        activeCls = 'md-checked',//'active';
        radioCls='md-radio-button'; //'';

    $ctrl.withChecks = true;
    $ctrl.header = 'Filter';

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitOther = preInitOther;
    $ctrl.onPredefinedSelect = onPredefinedSelect;
    $ctrl.getWithClose = getWithClose;
    $ctrl.getJustSave = getJustSave;
    $ctrl.check = check;
    $ctrl.onLoadedOther = onLoadedOther;

    $ctrl = new SBDrpMenuCtrlService($ctrl, $element);

    function onLoadedOther() {
        $ctrl.addRootWatcher('CLEAR_FILTERS_' + $ctrl.element.getAttribute('element-id'), clearFilters);
    }

    function clearFilters(){
        //console.log('CLEAR_FILTERS');
        $ctrl.select({currentTarget: $ctrl.element.querySelector('.' + $ctrl.itemClass + '[data-index="' + 0 + '"]')});//All
    }

    function getWithClose() {
        return false;
    }

    function getJustSave(){
        return true;
    }

    function onPredefinedSelect(item, index, e) {
        //console.log('onPredefinedSelect');
        if(item.v) {
            if (!$ctrl.valueTemp) {
                $ctrl.valueTemp = {};
            }
            $ctrl.valueTemp[item.t] = item.v ? item.v : null;
        } else{
            $ctrl.valueTemp = null;
        }
        return _.extend({}, item, {id: getValue()});
    }

    function getValue() {
        return $ctrl.valueTemp && !_.isEmpty($ctrl.valueTemp) ? $ctrl.valueTemp : null;
    }

    function preInitOther() {
        //console.log('preInitOther');
        $ctrl.valueTemp = $ctrl.value ? _.extend({}, $ctrl.value) : null;
    }

    function getItemTemplate() {
        return '<div class="dropdown-menu custom-drp-ul custom-likes-comments custom-border' +
            ($ctrl.fixedHeight ? 'fixedHeight ' : '') +
            ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '') + '">  ' +
            '<div class="full-width">' +
            ($ctrl.header ? ('<div class="header-small clearfix">' + $ctrl.header + '</div>') : '') +
            check(true) + '</div>' +
            '</div>';
    }

    function check(isFirst) {
        var el = '';
        _.each(getListInit(), function (item, i) {
            var v = item.t,
                cls = getCls();
            if (isFirst) {
                el += (item.header ? ('<div class="header clearfix full-width">' + item.header + '</div>') : '') +
                    '<div class="' + $ctrl.itemClass +
                    (item.hide ? ' sb-hide' : '') +
                    ' with-cursor inrow table-div full-width' + cls + '" data-t="' + v + '" data-id="' + item.id + '" data-index="' + i + '">' +
                    '<div class="col30 checkmark centered ' + radioCls + '">' + getMd() + '</div>' +
                    '<div class="semibold text-left centered">' + item.n + '</div>' +
                    '</div>';
            } else {
                var el1 = $ctrl.element.querySelector('.' + $ctrl.itemClass + '[data-t="' + v + '"][data-index="' + i + '"]' + (radioCls ? (' .' + radioCls) : ''));
                if (el1) {
                    $ctrl.LCS.replaceClass(el1, activeCls + ' border-bottom sb-hide', cls);
                }
            }

            function getMd() {
                return '<div class="md-container md-ink-ripple">' +
                    '<div class="md-off"></div>' +
                    '<div class="md-on"></div>' +
                    '<div class="md-ripple-container"></div>' +
                    '</div>';
            }

            function getCls() {
                var isActive = item.v && $ctrl.valueTemp && item.v === $ctrl.valueTemp[v] || !item.v && !$ctrl.valueTemp;
                var c = (isActive ? (' ' + activeCls) : '') + (item.border ? ' border-bottom' : '');
                return c && c.trim() ? c : '';
            }
        });

        return el;
    }

    function getListInit() {
        if (!$ctrl.list) {
            var username = 'me';//$ctrl.security.getCurrentUser().name;
            $ctrl.list = [
                {
                    hide:true,
                    id: 1,
                    v: 0,
                    n: 'All',
                   // border: $ctrl.withLikes ||   $ctrl.withComments
                }
                ];

            if ($ctrl.withLikes) {
                $ctrl.list = $ctrl.list.concat([
                    {
                        header: 'Likes',
                        id: 1,
                        v: 1,
                        n: 'Not liked',
                        t: types[0]
                    },
                    {
                        id: 2,
                        v: 2,
                        n: 'Liked',
                        t: types[0]
                    },
                    {
                        id: 3,
                        v: 3,
                        n: 'Liked by ' + username,
                        t: types[0],
                        border: $ctrl.withComments
                    }
                ]);
            }

            if ($ctrl.withComments) {
                $ctrl.list = $ctrl.list.concat([
                    {
                        header: 'Comments',
                        id: 5,
                        v: 1,
                        n: 'No comments',
                        t: types[1]
                    },
                    {
                        id: 6,
                        v: 2,
                        n: 'Has comments',
                        t: types[1]
                    },
                    /*{
                        id: 7,
                        v: 3,
                        n: 'Commented by ' + username,
                        t: types[1]
                    }*/
                ]);
            }
        }

        return $ctrl.list;
    }
}

angular.module('dropdowns.sbDropdown.likesComments.component', [
    'dropdowns.sbDropdown.likesComments.menu.component',
    'dropdowns.sbDropdown.controller.service'
])
.component('sbLikesCommentsDropdown', sbPageDrpComponentParams('LikesCommentsDrpCtrl', {
}))
.controller('LikesCommentsDrpCtrl', LikesCommentsDrpCtrl);
LikesCommentsDrpCtrl.$inject = ['SBFieldTypesService', 'SBFieldInitCtrlService', 'SBDrpInitCtrlService', '$element', '$attrs'];
function LikesCommentsDrpCtrl(SBFieldTypesService, SBFieldInitCtrlService, SBDrpInitCtrlService, $element, $attrs) {

    var withoutTemplateScope = true;

    var $ctrl = this;
    $ctrl.menuTag = 'sb-likes-comments-dropdown-menu';
    $ctrl.SBFieldMethods = SBFieldTypesService.SBFieldMethods;
   // $ctrl.propType = SBFieldTypesService.PropTypes.LikesComments;
    $ctrl.btnClearCls = 'btnClear';
    $ctrl.$onDestroy = $onDestroy;

    $ctrl = new SBFieldInitCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

    $ctrl.onInitFieldLoaded = onInitFieldLoaded;
    $ctrl.generateDrpMenuContent = generateDrpMenuContent;

    $ctrl.setDisplayValue = setDisplayValue;
    $ctrl.$onInit = $onInit;
    $ctrl.clearFilters = clearFilters;
    $ctrl.preSelect = preSelect;

    function $onInit() {
        $ctrl.labelField = 'n';
        $ctrl.valueField = 'id';
        $ctrl.filtersProp = $attrs.filtersProp;
        $ctrl.withLikes = $attrs.withLikes && ($attrs.withLikes === 'true'||$attrs.withLikes === true);
        $ctrl.withComments = $attrs.withComments && ($attrs.withComments === 'true'||$attrs.withComments === true);

        $ctrl.setInputField = false;
        $ctrl.withRepeatFromDrp = true;
        $ctrl = new SBDrpInitCtrlService($ctrl, $element);
    }

    function onInitFieldLoaded() {
        $ctrl.LCS.addClass($ctrl.element.querySelector('.with-span-text'), 'without-text col30 btn btn-small primary-faded without-text');

        $ctrl.spanText = $ctrl.element.querySelector('#spanItemText');
        $ctrl.spanText.innerHTML = $ctrl.LCS.getISBDiv('filter');

        $ctrl.LCS.addClass($ctrl.element, $ctrl.element.tagName.toLowerCase() +
            ' table-div clearfix ' +
            ($ctrl.cClassAttr ? $ctrl.cClassAttr : ''));
        $ctrl.onRepeatFieldLoaded();
    }

    function preSelect(result){
        //console.log('preSelect');
        var id = result.item.id;
        setClearFilters(id ? true : false);
    }

    function setClearFilters(isAdd) {
        if (isAdd) {
            if(!getBtnClear()) {
                var txt = 'Clear Filters';
                $ctrl.LCS.appendChildFragment($ctrl.element, '<button type="button" class="' + $ctrl.btnClearCls + ' btn btn-small primary-faded hide-print table-div" analytics-on analytics-action="' + txt + '"><div>' + $ctrl.LCS.getISBDiv('cancel', 2) + '</div><div class="col100 hide-ipad">' + txt + '</div></button>');
                $ctrl.LCS.timeout(function () {
                    bind(true);
                }, 200);
            }
        } else {
            bind(false);
            $ctrl.LCS.removeElement(getBtnClear());
        }
    }

    function getBtnClear(){
        return $ctrl.element.querySelector('.' + $ctrl.btnClearCls);
    }

    function bind(isBind) {
        $ctrl.LCS.bindElementsClick(isBind, getBtnClear(), $ctrl.clearFilters);
        $ctrl.LCS[isBind ? 'addClass' : 'removeClass']($ctrl.element, 'with-btn');
    }

    function $onDestroy() {
        if($ctrl.onInitDestroy){$ctrl.onInitDestroy();}
        bind(false);
    }

    function clearFilters(){
        if($ctrl.isSOpen) {
            $ctrl.broadcastRoot('CLEAR_FILTERS_' + $ctrl.id);
        }else {
            $ctrl.onSelect({item: {id: null}, withClose: true, $index: 0, justClose: true});
        }
    }

    function setDisplayValue() {
        if($ctrl.preDisplayValue){
            $ctrl.preDisplayValue();
        }
    }

    function generateDrpMenuContent() {
        return {
            $ctrl: {
                value: angular.copy($ctrl.value),
                onSelect: $ctrl.onSelect,
                drpClassAttr: $ctrl.drpClassAttr
            },
            template: "list='::$ctrl.list' " +
                "value='::$ctrl.value' " +
'element-id="'+$ctrl.id+'"' +
                ($ctrl.fixedHeight ? ("fixed-height='true' ") : '') +
                ($ctrl.labelField ? ("label-field='" + $ctrl.labelField + "' ") : '') +
                ($ctrl.valueField ? ("value-field='" + $ctrl.valueField + "' ") : '') +
                ($ctrl.withLikes ? ("with-likes='" + $ctrl.withLikes + "' ") : '') +
                ($ctrl.withComments ? ("with-comments='" + $ctrl.withComments + "' ") : '') +

                "on-select='$ctrl.onSelect(result)' "
        };
    }
}

