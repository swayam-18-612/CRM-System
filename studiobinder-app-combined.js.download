    $ctrl = new pageCtrlService($ctrl, $element);
}

angular.module('product.workflow.page.controller.service', [
    'product.workflowBoard.controller.service'
])
.service('WorkflowPageCtrlService', WorkflowPageCtrlService);
WorkflowPageCtrlService.$inject = ['WorkflowBoardCtrlService'];
function WorkflowPageCtrlService(WorkflowBoardCtrlService) {
    return function ($ctrl, $element, printPageParams) {

        $ctrl.isOnProduct = true;
        $ctrl = new WorkflowBoardCtrlService($ctrl, $element, printPageParams);
        return $ctrl;
