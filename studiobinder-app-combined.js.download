        Filters = [
            {value: true, text: 'Active'},
            {value: false, text: 'Archived'}
        ],

        TasksFilters = [
            {value: 0, text: 'All'},
            {value: 1, text: 'Completed'},
            {value: 2, text: 'Uncompleted'}
        ],

        TabTasks = [
          //  {value: 'filters', text: 'Filters'},
            {value: 'tasks', text: 'Tasks'},
           // {value: 'comments', text: 'Comments'},
           // {value: 'archived', text: 'Archived'},
        ],

        Colors = ['#FFAA01', '#F87117', '#E73535', '#FA1971', '#C413A7', '#595CFF', '#19A9F7', '#00BD7E', '#546685', '#CDDDE8'],

        CompOptions = {//to ensure they re not overwritten by page
            hasSearch: true,
            tableClass: '.scenetable.workflow',
            nameForList: 'Column',
            hideAddList: true,
            withoutLoadDirectory: true,
            objectType: 'taskCard',
            itemTitle: 'Card',
            treeType: 6,
            elemType: 'TASKCARD',
            withActiveTree: false,
         //   withAddUnder: true,
            withCreateInlineGroup: true,
            withRenamePredefTreeItem: true,
            withRemovePredefTreeItem:true,
            withCustomSettings: true,
            canDragPredefTreeItem: true,
            manySortableGroups: true,
            withDeleteInActiveGroup: true,
            emptyIcon: 'scriptoutline',
            pageClass: 'page-class scriptoutlinePage',
            itemIcon: 'task',
            quotaType: 'scriptOutline',
            overviewBlockType: 'scriptOutline',
            maxFreeItemsCount: 10,

            codeName: 'scriptoutline',
        addListOnEmptyState: true
        },

        ListTreeServiceParams = {
            addListOnEmptyState: true,

            maxLevel: 1,

            displayAllTreeLists: true,

            hideLevel0: true,
            withHarcodedAll: false,
            dontStartTreeWithAll: false, //for workflow and sidebar
            clickOnGroup: false,

            level0Name: 'All Task Cards',
            // preLoadingTableName: $ctrl.preLoadingTableName,
            withoutLoadDirectory: true,
            updateChangedFields: ['color'],
            treeEditName: 'Edit'
        },

        ListParams = {
            includeFields: ['name', 'createdById', 'createdAt', 'teamIds', 'subscribedIds', 'startDate', 'dueDate', 'color', 'stats', 'active', 'description', 'todoPageId', 'todoColumnId', 'id', 'type', 'isOnlyComment', 'productId', 'completedAt', 'completedById', 'completed'],
            searchFields: ['name', 'description'],
            orderFields: ['order'],
            populate: 'createdById',
            addListOnEmptyState: true
        },

        KeyboardServiceParams = {
            canCopy: true,
            canMove: true
        },

        PopupOperations = {
            createTodoColumn: {
                type: 'Create',
                template: getBasePopupTemplateByTag('todo-column-edit'),
                size: 'medium'
            },

            updateTodoColumn: {
                type: 'Edit',
                template: getBasePopupTemplateByTag('todo-column-edit'),
                size: 'medium'
            },

        },

        Hotkeys = null,

        SidebarOptions = {
            addGroupPopupName: 'createTodoColumn',
            editGroupPopupName: 'updateTodoColumn',
            removeAdditionalMessage: ' and all the elements within it',
        };

    return {
        Settings: Settings,
        Options: Options,
        Filters: {
            Filters: Filters,
            TasksFilters: TasksFilters,
            TabTasks: TabTasks
        },
        ViewProp: 'scriptOutlineView',
        Colors: Colors,

        CompOptions: CompOptions,
        ListTreeServiceParams: ListTreeServiceParams,
        ListParams: ListParams,
        KeyboardServiceParams: KeyboardServiceParams,

        PopupOperations: PopupOperations,
        Hotkeys: Hotkeys,
        SidebarOptions: SidebarOptions,
    };
}

