        function afterProcessUpdates(result) {

        }

        function onPreProcessGroupItems(item) {
            //console.log('onPreProcessGroupItems');
            return $ctrl.preProcessGroupItems({item: item});
        }
        function currentProductPathParams(data, item) {
            return $ctrl.CPS.currentPathParams(_.extend({
                productId: $ctrl.CPS.productId ? $ctrl.CPS.productId : (item ? item.productId : null)
            }, data ? data : {}));
        }

        function getFirstLevelNodesCount(treeType){
            return $ctrl.listTreeService && $ctrl.listTreeService.getFirstLevelNodesCount(treeType);
        }

        function getGroupHeader() {
            if($ctrl.isPrintLayout){
                return $ctrl.getPrintGroupHeader();
            }
            var txt = '';
            if($ctrl.cantSortGroupHeaders){
                txt = '<span ng-if="::!c.hideTitle">{{::c.name}}</span>';
            } else {
                txt = ($ctrl.isPrintLayout ? '' : ('<a ng-if="::c.canSort&&!c.hideTitle" ng-click="$ctrl.changeOrder(c.sortField ? c.sortField : c.prop, c.sortType ? c.sortType : c.type)">{{::c.name}} ' +
                        '<div ng-if="::c.headerTooltip" class="hide-print inline-block row-tooltip" tooltip="{{::c.headerTooltip}}" tooltip-placement="bottom">' + $ctrl.LCS.getISBDiv('info-circle', 4, 'gray') + '</div>' +
                        '<div class="sbf inline-block hide-print pull-right" ng-if="$ctrl.getOrderArrow(c.sortField? c.sortField : c.prop)" ng-class="$ctrl.getOrderArrow(c.sortField? c.sortField : c.prop)"></div></a>')) +
                    '<span ng-if="::' + ($ctrl.isPrintLayout ? '' : '!c.canSort&&') + '!c.hideTitle">{{::c.name}}</span>';
            }

            return '<div ng-show="$ctrl.showColumn(null, c, true, undefined, true)" class="position-relative" ng-class="::$ctrl.getClsCol(c, false, true)" ng-repeat="c in $ctrl.filtersService.listCols">' + txt + '<span class="profeature gridpro inline-block with-cursor" ng-show="$ctrl.showProForCol(c)" ' +
                'ng-click="$ctrl.openProForCol(c, $event)" ' +
                'data-type="openProForCol"' +
                ' analytics-on analytics-action="{{::c.name}}"'+
                '>PRO</span></div>';
        }

        function getItemSelectorCls(){
            return $ctrl.itemSelector.replace('.', ' ');
        }

        function getItemEl(id, cls, parent) {
            return (parent ? parent : $ctrl.element).querySelector('.' + $ctrl.itemSelector + '[data-id="' + id + '"]' + (cls || ''));
        }

        function selectRows(id, e){
            $ctrl.selectAllRows();
            updateSelectedRowsCheck(e? e.currentTarget : null);
        }

        function clearSelectedRowsOther(el){
            updateSelectedRowsCheck( $ctrl.element.querySelector('.btnSelectAllRows'));
        }

        function updateSelectedRowsCheck(el){
            if(!el){return;}
            var selected = $ctrl.allRowsSelected();
            $ctrl.LCS[selected ? 'addClass' : 'removeClass'](el, 'checked');
            var input = el.querySelector('input');
            if(input){
                if (selected) {
                    input.setAttribute('checked', 'checked');
                } else {
                    input.removeAttribute('checked');
                }
            }
        }

        function setGridViewClsOther(){
            setGroupTreeCls();
            /* $ctrl.LCS.replaceClass($ctrl.element.querySelector('.sb-scrolling-monitor'),
                 $ctrl.isGridView ? 'with-white-bg' : 'with-no-bg', $ctrl.isGridView ? 'with-no-bg' : 'with-white-bg');
             */
            $ctrl.setInitWrapperCls();

        }

        function setGroupTreeCls(){
            var el = $ctrl.element.querySelector('.' + $ctrl.groupListCls.split(' ').join('.'));
            if(el) {
                el.className = $ctrl.getGroupTreeCls();
            }
        }

        function getColumnsCount(o){
            if(!o) {
                o = $ctrl.filtersService ? $ctrl.filtersService.options : null;
            }
            var max = $ctrl.isPrintLayout ? 0 : ($ctrl.maxGridItemWidth === 0 ? 0 : Math.floor($ctrl.element.getBoundingClientRect().width/($ctrl.maxGridItemWidth || 360))),
                c = o && o.column ? parseInt(o.column, 10) : 1;
            if(max > 0 && max < c){
                c = max;
            }
            return c;
        }

        function getGroupTreeCls(){
            var isPosterSize = $ctrl.gridBlockType && $ctrl.gridBlockType.indexOf('postersize') !== -1,
                o = $ctrl.filtersService ? $ctrl.filtersService.options : null;

            return $ctrl.groupListCls + ' ' + (typeof($ctrl.getGridItemWidthCls)==='function' ? $ctrl.getGridItemWidthCls() : '') +
                ($ctrl.isGridView ? ('gridview ' +  (!isPosterSize ? (' columns-' + getColumnsCount(o)) : '')) : '') +
                ($ctrl.isMasonary ? (' is-masonary')  : '') +
                ($ctrl.noItemRadius ? (' no-item-radius')  : '') +
                ($ctrl.withoutOverlayBorders ? ' without-overlay-borders' : '') +
                ' imageRatio-' + (o && o.ratio ? parseInt(o.ratio) : 0).toString() +
                ($ctrl.gridNested ? ' grid-nested' : '') +

                ($ctrl.getGridCls && !$ctrl.isPrintLayout ? (' ' + $ctrl.getGridCls()) : '');
        }

        function getViewEditElemSelector(prop){
            return $ctrl.SBFieldTypesService.getViewEditElemSelector(prop, true, $ctrl.canEdit);
        }

        function getLikesFilterDrp(){
            return '<div class="pull-right wrapper-outer wrapper-tasks-filter with-arrow with-bgcolorgray" ng-show="!$ctrl.canEdit&&$ctrl.list.totalCount||$ctrl.canEdit">' +
                '<sb-dropdown ' +
                //'class="col130" ' +
                'drp-class-attr="drpTasksFilter" '+
                'without-close="true" ' +
                'c-class-attr="without-underline without-arrow opendrp auto-width thinner" ' +
                'init-list="::$ctrl.Filters" ' +
                'value="::$ctrl.filtersService.selectedFilter" ' +
                'on-change="$ctrl.changeFilter(result)" ' +
                'field-class="selected-text  ">' +
                '</sb-dropdown>' +
                '</div>';
        }

        function cloneItem(item){
            return item;
        }

        function createNonNg(type, e) {
            //console.log('createNonNg');
            $ctrl.createItemWithEvent(null, type, e);
        }

        function createItemWithEvent(after, type, e){
            //console.log('createItemWithEvent');
            try{
                if(typeof(type) === "string"){type = parseInt(type, 10);}
            }catch (ex){}
            return $ctrl.create(after, type, null, null, false, e);
        }

        function canDuplicate(item){
            return $ctrl.withDuplicateGroupItem || $ctrl.keyboardService.canCopy;
        }

        function getBtnActionCls(){
            return 'btnAction' + $ctrl.compInitId;
        }

        function getGroupQuota(){
            return $ctrl.quotaType;
        }

        function getInnerContent(v){
    return ($ctrl.isGroupBlock ? '' : $ctrl.getGridHeader() + (!$ctrl.isPrintLayout && typeof($ctrl.getGroupAdd) === 'function' ? $ctrl.getGroupAdd() : '')) +
           (typeof($ctrl.getGroupAdd) === 'function' ? $ctrl.getGroupAdd() : '') +
           '<div class="' + $ctrl.getGroupTreeCls() + '"' +
                ($ctrl.nestedLevel ? (' style="--masonary-columns: ' + getColumnsCount() + '"') : '') +
            '>' +
                '<div>' +
                    '<div class="dd ' + $ctrl.groupWrapperName + ' clearfix">' +
                        '<div class="flex-wrap ' + ($ctrl.isGroupBlock ? '' : $ctrl.groupContentCls) + '">' +
                            (v || '') + //$ctrl.getGroupItemsInit() +
                        '</div>' +
                        '<loading-more class="load-more sb-hide"></loading-more>' +
                        //'<loading-more ng-if="$ctrl.list.busy"></loading-more>' +
                        ($ctrl.canEdit && typeof($ctrl.getGridFooter)==='function' ?   $ctrl.getGridFooter() : '') +
                    '</div>' +
                    (typeof($ctrl.getInitGroupButtons)==='function' ? $ctrl.getInitGroupButtons() : '') +
                '</div>' +
            '</div>';
        }

        function getCompiledGroupContentTemplateInit() {
            if (typeof ($ctrl.sortGroupTemplate) === 'function') {
                $ctrl.sortGroupTemplate();
            }
            return typeof ($ctrl.getCompiledGroupContentTemplate) === 'function' ? $ctrl.getCompiledGroupContentTemplate() : '';
        }

        function cancel(item, data, e){
            console.log('cancel popover');
            try {
                $ctrl.broadcastRoot('CLOSE_POPOVER_' + $ctrl.LCS.findClosestParent(e.currentTarget, '.group-item-more-popover').id);
            }catch (e){}
        }

        function getGroupItemsInit(isLeft, halfwidth){
            if(halfwidth === undefined){halfwidth = false;}
            return typeof ($ctrl.getLoadedListWithDeps) === 'function' ? $ctrl.getLoadedListWithDeps(isLeft === undefined ? true : isLeft, halfwidth) :
                (halfwidth ? $ctrl.getLoadedList2Cols(isLeft, halfwidth) : $ctrl.getGroupItems());
        }

        function getLoadedList2Cols(isLeft, halfwidth){
            var indexes = [],
                t = $ctrl.list.items.length,
                h = Math.round(t / 2),
                start = isLeft ? 0 : h,
                end = isLeft ? (halfwidth ? h : t) : t;
            for (var i = start; i < end; i++) {
                indexes.push(i);
            }
            return $ctrl.processD(indexes, null);
        }

        function processD(indexes, d) {
            return getDepHeader(d) + $ctrl.getGroupItems(indexes, d ? d.depId : null);
            function getDepHeader(d) {
                return d ? ('<div dep-id="' + d.depId + '" class="grid-header dep-header">' + d.name + '</div>') : '';
            }
        }

        function getStartOrder(){
            var maxOrder = 0;
            _.each($ctrl.list.items, function (item){
                if(item.order > maxOrder){
                    maxOrder = item.order;
                }
            });
            return maxOrder > 0 ? (maxOrder + 1) : null;
        }

        function getGroupOrder(id) {
            var o = {};
            o[$ctrl.defaultOrder] = $ctrl.defaultOrderDir;
            return o;
        }

        function getCounterBlock(hideCounter, otherCls) {
            return hideCounter ? '' : ('<div class="' + (otherCls ? otherCls : '') + ' ' + $ctrl.counterTextCls + '">' + $ctrl.getCount().counterText + '</div>');
        }

        function getListParams(){
            var orders = {};
            orders[$ctrl.defaultOrder] = $ctrl.defaultOrderDir;
            var params = {
                preloadAll: true,
                withNoOrderChange: $ctrl.withNoOrderChange ? $ctrl.withNoOrderChange : false,
                orders: orders,
                defaultOrder: $ctrl.defaultOrder,
                defaultOrderDir: $ctrl.defaultOrderDir,
                getAllIds: getAllIds,
                afterProcessUpdates: $ctrl.afterProcessUpdates,
                onAllLoaded: $ctrl.onAllLoaded
            };

            if (typeof ($ctrl.update) === 'function') {
                params.update = $ctrl.update;
            }

            if (typeof ($ctrl.getNewPopupParams) === 'function') {
                params.getNewPopupParams = $ctrl.getNewPopupParams;
            }

            if (typeof ($ctrl.create) !== 'function') {
                $ctrl.create = create;
            }

            if (typeof ($ctrl.create) === 'function') {
                params.create = $ctrl.create;
            }
            $ctrl.createInit = create;

            params.createInit = $ctrl.createInit;

            if (typeof ($ctrl.getNew) !== 'function') {
                $ctrl.getNew = getNew;
            }
            if (typeof ($ctrl.getNew) === 'function') {
                params.getNew = $ctrl.getNew;
            }

            if (typeof ($ctrl.withProperty) !== 'function') {
                $ctrl.withProperty = withProperty;
            }

            if (typeof ($ctrl.withProperty) === 'function') {
                params.withProperty = $ctrl.withProperty;
            }

            if ($ctrl.preProcessGroupItem) {
                params.preProcessGroupItem = $ctrl.preProcessGroupItem;
            }
            return params;
        }

        function setKeyboardService() {
            if (!$ctrl.keyboardService) {
                //console.log('keyboardService defined in group ' + $ctrl.currentListId);
                $ctrl.keyboardService = new $ctrl.KeyboardListService({
                    itemSelector: $ctrl.itemSelector,
                    itemTitle: $ctrl.itemTitle,
                    elemType: $ctrl.elemType,
                    objectType: $ctrl.objectType,
                    // treeClass: $ctrl.treeClass,
                    tableClass: $ctrl.tableClass,
                    addInitItems: $ctrl.addInitItems,
                    //disable multi select for now. needs more testing
                    withMultiSelect: false, //!($ctrl.withoutMultiSelect === true)
                    cantBeDraggedLast: $ctrl.cantBeDraggedLast === true,
                    isCommentsSidebar: $ctrl.isCommentsSidebar
                });

                var keyboardServiceParams = _.extend({}, $ctrl.constantsService ? $ctrl.constantsService.KeyboardServiceParams: null, $ctrl.keyboardServiceParams);
                if (keyboardServiceParams) {
                    $ctrl.keyboardService = _.extend($ctrl.keyboardService, keyboardServiceParams);
                }
                $ctrl.triggerSetSortable = true;
            }
        }

        function addWatchers() {
            if (!$ctrl.isPrintLayout) {
                if ($ctrl.canAddGroupEvents()) {
                    $ctrl.processGroupEvent = processGroupEvent;

                    if (!$ctrl.onInitAddFromTop) {
                        $ctrl.onInitAddFromTop = onInitAddFromTop;
                    }

                    $ctrl.addRootWatcher($ctrl.GroupEvents.Added, onInitAdded);
                    $ctrl.addRootWatcher($ctrl.GroupEvents.AddedMultiple, onInitAddedMultiple);
                    $ctrl.addRootWatcher($ctrl.GroupEvents.AddFromTop, $ctrl.onInitAddFromTop);
                }

                $ctrl.addRootWatcher($ctrl.GroupEvents.Updated, onInitUpdated);
                $ctrl.addRootWatcher($ctrl.GroupEvents.Archived, onInitArchived);
                $ctrl.addRootWatcher($ctrl.GroupEvents.Removed, onInitRemoved);
                $ctrl.addRootWatcher($ctrl.GroupEvents.RemoveMirror, onInitRemoveMirror);
                $ctrl.addRootWatcher($ctrl.GroupEvents.ArchiveMirror, onInitArchiveMirror);
                $ctrl.addRootWatcher($ctrl.GroupEvents.Move + $ctrl.currentListId, onInitMove);

                //from top buttons
                $ctrl.addRootWatcher($ctrl.GroupEvents.ProcessSelected, function (result){
                    if(result) {
                        onProcessSelectedGroup(result.action, result.item, result.e);
                    }
                });

                $ctrl.addRootWatcher($ctrl.GroupEvents.ProcessSearch, onProcessSearchGroup);

                $ctrl.addRootWatcher($ctrl.GroupEvents.LikesFilter, onLikesFilter);

                $ctrl.addRootWatcher($ctrl.GroupEvents.HideMobileDetails, $ctrl.hideMobileItemDetails);

                if ($ctrl.withExportCSV && $ctrl.onExportCSV) {
                    $ctrl.addRootWatcher($ctrl.GroupEvents.ExportCSV, $ctrl.onExportCSV);
                }

                if ($ctrl.currentListId !== undefined) {
                    $ctrl.addRootWatcher('SELECTED_CUSTOM_BTNS_' + $ctrl.elemType + '_' + $ctrl.currentListId, onSelectCustomBtns);
                }

            }

            if (typeof ($ctrl.onPostloadGroup) === 'function') {
                $ctrl.onPostloadGroup();
            }
        }

        function onLikesFilter(result){
            var v  = result && result.selected ? result.selected.val : null,
                p = {};
            p[result.prop] = v;

            onProcessSearchGroup(p, {
                prop : result.prop,
                searchFields: ['likes', 'commentsCount'],
                isAnd: true //has all filters
            });
        }

        function openItemImageInPopup(){
            //console.log('openItemImageInPopup');
            if($ctrl.isPrintLayout){return;}
            var isCard = $ctrl.isCommentsSidebar || $ctrl.isLikeWorkflow;
            var id = $ctrl.CPS.getSearchFilter(isCard ? 'card' : 'item');
            if (!id) {
                return;
            }
            var item = $ctrl.list.getElementById(id);
            if (!item) {
                return;
            }
            $ctrl.LCS.timeout(function () {
                if(isCard){
                    $ctrl.edit(item);
                } else{
                    viewNextImagePopup(null, item, true);
                }
            }, 500);
        }

        function hideMobileItemDetails() {
            $ctrl.LCS.setItemDetailsVisibility(true, false, $ctrl.element);
        }

        function isall(){
            return $ctrl.listTreeService && $ctrl.listTreeService.ungroupOnTreeDelete && $ctrl.currentList && $ctrl.currentListId === 'All';
        }

        function getMoveName(title) {
            return isall() ?
                ('Assign ' +
                    //title+' '+
                    'to Group') : ('Move ' + (title ? title : ''));
        }

        function getMoveIcon() {
            return isall() ? 'group-folders' : 'transition';
        }

        function showSelectCondition() {
            return !$ctrl.withoutCheckbox && !$ctrl.isMobileView() && $ctrl.isActiveTree();
        }

        function canAddGroupEvents() {
            return $ctrl.canEdit && $ctrl.isActiveFilter();
        }

        function getEditPopupColumns(isNew, item) {
            var columns = [],
                columnImg = null,
                sortedForPopup = true;
            _.each(_.filter($ctrl.getColumnsList(sortedForPopup, false), function (c) {
                return !c.notInModal && !c.isHeader;
            }), processColumn);

            return {columnsList: columns, columnImg: columnImg};

            function processColumn(c1) {
                if (c1) {
                    var isImg = c1.type === $ctrl.SBFieldTypesService.PropTypes.Picture;
                    if (isImg) {
                        if (!isNew && ($ctrl.isMobileSize || !$ctrl.isMobileSize && !c1.hideDesktopModal)) {
                            columnImg = _.extend({}, c1, {imgSize: c1.isAvatarAttr ? 'intermedium' : $ctrl.getImgSizeInit()},
                                typeof ($ctrl.getPicturePopupOtherProps) === 'function' ? $ctrl.getPicturePopupOtherProps(item) : null);
                        }
                    } else {
                        if (!(typeof ($ctrl.getEditPopupColumnsCond) === 'function' && !$ctrl.getEditPopupColumnsCond(c1, item))) {
                            columns.push(_.extend({}, c1));
                        }
                    }
                }
            }
        }

        function getImgSizeInit(){
            return $ctrl.isMasonary ? ' ' : 'storyboard1';
        }

        function hasElements() {
            return $ctrl.list.totalCount > 0;
        }

        function processListHeaderColumn(item, canEdit, c, cls, isFirst, isLast, textOnly) {
            var h = $ctrl.getHeaderColumnText(false, c);
            return textOnly ? h : ('<div '+(cls?('class="' + cls.replace('vtop', 'centered') + '"'):'')+'>' + (c.headerIcon ? ($ctrl.LCS.getISBDiv(c.headerIcon, null, 'with-margin-right gray sbf14') + '&nbsp;') : '') +
                h +
                '</div>');
        }

        function onExportCSV() {
            if (!$ctrl.hasElements()) {
                return;
            }
            var rows = [];

            add(null, true);

            if ($ctrl.list.items) {
                _.each($ctrl.list.items, function (item) {
                    add(item, false);
                });
            }

            $ctrl.DownloadExportService.exportRowsToCsv(rows, 'csv');

            return rows;

            function add(item, isHeader) {
                rows.push($ctrl.processListItemColumns(item, isHeader, true, false, undefined, null).content);//each row contains an array of the available cols
            }
        }

        function getDefaultIndexes( ){
           var indexes = [];
            for (var i = 0 ; i < $ctrl.list.items.length;i++) {
                indexes.push(i);
            }
            return indexes;
        }

        function getGroupItems(indexes, depId) {
            //todo see if prev is necessary
            var canEdit = $ctrl.canEdit && !$ctrl.isPrintLayout,
                isEdit = !$ctrl.isPrintLayout;
            return (!canEdit || $ctrl.withPageLoading || $ctrl.sortedDeps) ? loadIndexes() : loadItems(canEdit, isEdit, null, depId);

            function loadIndexes() {
                if (!indexes) {
                    indexes = getDefaultIndexes();
                }

                /* todo: if with pagination select a subset of indexes based on page
                   if ($ctrl.withPageLoading && max > $ctrl.PAGE_LENGTH) {
                    var max = $ctrl.PAGE_LENGTH - 1;
                    //set indexes ;
                }*/

                return (indexes.length ? (indexes.length - 1) : -1) > -1 ? loadItems(canEdit, false, indexes, depId) : '';
            }
        }

        //todo remove the ngrepeat and item="item" to get rid of 4 watchers . for 1000 scenes is 4000 watchers
        function loadItems(canEdit, isEdit, indexes, depId) {
            //console.log('loadItems ' + $ctrl.elemType);
            var opts = {},
                info = $ctrl.getGroupItemInfo(canEdit, isEdit, depId, opts);

            return isEdit ? p(isEdit) : indexes.map(function(i){
               return p(false, i);
            }).join('');

            function p(isEdit, i){
                return $ctrl.getGroupItemComponent(canEdit, isEdit, depId, i, info, opts);
            }
        }

        function bindLoadMore(isBind) {
            return;
            getLoadMoreEl();
            $ctrl.LCS.bindElementListeners(isBind, $ctrl.loadMoreEl, onScroll, 'scroll', {
                passive: true
            });
        }

        function onScroll(e) {
            //console.log('onScroll')
            var padding = 5;
            if ($ctrl.element.scrollTop + $ctrl.element.clientHeight >= $ctrl.element.scrollHeight - padding) {
                loadNewPage();
            }
        }

        function getLoadMoreEl() {
            if (!$ctrl.loadMoreEl) {
                $ctrl.loadMoreEl = $ctrl.element.querySelector('.loading-more');
            }
        }

        function showMoreLoader(show) {
            getLoadMoreEl();
            $ctrl.LCS[show ? 'removeClass' : 'addClass']($ctrl.loadMoreEl, 'sb-hide');

            $ctrl.isLoadingPage = show;
        }

        function hasMorePages(page, max) {
            return $ctrl.currentPage < ($ctrl.list.items.length / $ctrl.PAGE_LENGTH);
            return $ctrl.list.items.length === 0 || ((page - 1) * max + 1) < $ctrl.list.items.length;
        }

        function loadNewPage() {//todo needs work
            if ($ctrl.isLoadingPage || hasMorePages()) {
                return;
            }

            showMoreLoader(true);

            if (!$ctrl.newPageCompile) {
                $ctrl.newPageCompile = new $ctrl.TemplateCompileService($ctrl.$element.querySelector('.' + $ctrl.sortableContainerCls), getNewPageTemplate, $ctrl);
            }

            $ctrl.newPageCompile.loadTemplate(function () {
                console.log('new group page loaded');
                $ctrl.currentPage = $ctrl.currentPage + 1;
                showMoreLoader(false);
            });

            function getNewPageTemplate() {
                //todo
               // var indexes = [];
               // return loadItems($ctrl.canEdit, false, indexes, depId)
                //return loadItems($ctrl.currentPage, $ctrl.currentPage + ($ctrl.PAGE_LENGTH - 1), false);
            }
        }

        function hasSortableInit() {
            //return $ctrl.currentListId !== 'All' &&
            return $ctrl.canEdit && $ctrl.isActiveTree() &&
                (!$ctrl.listTreeService || $ctrl.listTreeService && (typeof ($ctrl.listTreeService.hasGroupSortable) === 'function' ? $ctrl.listTreeService.hasGroupSortable() : true));
        }

        function getPopupLogo(item){
            var c =  $ctrl.getColumnByPropType($ctrl.SBFieldTypesService.PropTypes.Picture, true);
            return c ? $ctrl.ImageUploaderService.generateDisplayImage(item, _.extend({}, c, {imgSize: 'intermedium centered'})) : null;
        }

        function openProPopup(item, param, e) {
            $ctrl.CPS.openProPopup(e);
        }

        function viewNotes(item, param, e) {
            console.log('viewNotes');
            process();
            function process() {
                $ctrl.popupsService.open(item, $ctrl.popupsService.operations.viewNotes,
                    _.extend({
                        canEdit: $ctrl.canEdit && (!$ctrl.withActiveGroup || $ctrl.withActiveGroup && item.active),
                        service: $ctrl.service
                    }, typeof ($ctrl.viewNotesParams) === 'function' ? $ctrl.viewNotesParams(item) : {
                        itemName: item.name ? item.name : $ctrl.itemTitle,
                        field: 'note',
                        imgHtml: $ctrl.getPopupLogo(item)
                    }),
                    $ctrl.compOptions, null);
            }
        }

        /*
            case 'depBg':
            .medium-template .depRow {
                    background-color: #383e42; */

        function onSelectCustomBtns(result) {
            if (result) {
                $ctrl.processGroupEvent(result.action, result.e);
            }
        }

        function processGroupEvent(action, e) {
            // $ctrl.processActionEvent('action', {currentListId: $ctrl.currentListId}, $ctrl.getTreePopupParams());
            var ids = $ctrl.getKeyboardSelectedRows();
            if (ids.length === 0) {
                return;
            }
            var method = $ctrl[action];
            if (typeof (method) === 'function') {
                return method(ids, e);
            } else if (typeof ($ctrl.processEventOther) === 'function') {
                $ctrl.processEventOther(ids, action, e);
            }
        }

        function getPhone(phone) {
            return phone ? $ctrl.CPS.displayPhone(phone) : ($ctrl.isGridView ? '' : '–');
        }

        function getSortHandle(isHeader) {
            //var withSortable = $ctrl.withSortable;
            var withSortable = $ctrl.hasSortableForItem();
            return withSortable ? ('<div ' +
                (isHeader ? 'ng-show="$ctrl.showHandleCol()" ' : '') +
                'class="handle-col with-hover hide-print ' +
                ($ctrl.noSideColumnBorders && !$ctrl.isMobileView() ? 'no-borders ' : '') +
                ($ctrl.withShortHandleCol ? ($ctrl.withShortHandleCol + ' ') : '') +
                (isHeader ? '' : (' ' + $ctrl.itemHandleCls)) + ' ' +
                ($ctrl.alignHandle === 'left' ? 'text-left' : ($ctrl.alignHandle === 'right' ? 'text-right' : 'text-center')) +
                 ($ctrl.rowVTop?' vtop':' centered') +
                '">' +
                (isHeader ? '' : $ctrl.LCS.getISBDiv('dd3-handle', 0,
                    ($ctrl.withSmallHandle ? ' small' : '') +
                    ($ctrl.alignHandle === 'left' ? ' margin-left-0' : ($ctrl.alignHandle === 'right' ? ' margin-right-0' : 'centered')))) +
                '</div>') : '';
        }

        function showHandleCol() {
            return !$ctrl.isGridView && $ctrl.isActiveTree() &&
                (($ctrl.withSortable && (($ctrl.dragHandleOnTheSide || $ctrl.dragOnlyFromHandle) || $ctrl.LCS.isTouchScreen || $ctrl.isMobileView())) ||
                    ($ctrl.canEdit && $ctrl.withoutGroupSorting && $ctrl.withHandlePlaceholder)
                );
        }

        function getCustomCheckbox(item) {
            if (!$ctrl.showSelectCondition()) {
                return '';
            }
           var withCheck = !item.isPredef && $ctrl.withSelectAll();
            return $ctrl.canEdit ? ('<div class="check hide-print '+($ctrl.withoutCheckHover ? '' : 'with-hover') + ($ctrl.rowVTop ? ' vtop' : ' centered') + '">' +
                (withCheck ? ('<div class="custom-checkbox inrow selectmark not-disabled no-drag"><label><input type="checkbox" disabled="disabled"><span></span></label></div>') : '') +//usually for is predef
                    (typeof($ctrl.getCustomNextToCheckbox) === 'function' ? $ctrl.getCustomNextToCheckbox(item) : '') +
                '</div>') : '';
        }

        function getSortAndCheck(item) {
            return $ctrl.getSortHandle(false) +
                $ctrl.getCustomCheckbox(item);
        }

        function loadCompOptions() {
            if ($ctrl.compOptions) {
                var compOptions;
                try {
                    compOptions = JSON.parse($ctrl.compOptions);
                    if (compOptions) {
                        $ctrl = $.extend($ctrl, compOptions);
                    }
                } catch (e) {
                }
            }
        }

        function loadGroupTemplate(result) {
            console.log('loadGroupTemplate ' + $ctrl.elemType);

            if(result && result.updatePreloadSettings && typeof($ctrl.preloadSettings) === 'function'){
                $ctrl.preloadSettings();
            }
            beforeLoadGroup();

            addFiltersWatchers();

            $ctrl.onInitListChanged($ctrl.getInitList() || [],  result && result.forceReload);

            function beforeLoadGroup(){
                if ($ctrl.griditemloaded) {
                    $ctrl.removeWatcher($ctrl.griditemloaded);
                }
                if ($ctrl.griditempreloaded) {
                    $ctrl.removeWatcher($ctrl.griditempreloaded);
                }
                $ctrl.bindItems = 1;
                $ctrl.triggerSetSortable = true;
                $ctrl.sortableSet = false;
            }

            function addFiltersWatchers() {
                if(!$ctrl.addWatchersLoaded) {
                    setGridView();

                    if(typeof($ctrl.preSetOtherFilters) === 'function'){
                        $ctrl.preSetOtherFilters();
                    }

                    if ($ctrl.withGridView) {
                        //LIST_FILTERS_VIEW_
                        addFilterOption('VIEW', 'isGridView');

                        //LIST_FILTERS_COLUMN_
                        addFilterOption('COLUMN', 'column');

                        //LIST_FILTERS_RATIO_
                        //addFilterOption('RATIO', 'ratio');
                    }

                    if ($ctrl.withDynamicCols) {
                        //LIST_FILTERS_COLUMNS_
                        addFilterOption('COLUMNS', 'columns');
                    }

                    if($ctrl.otherListFilters){
                        _.each($ctrl.otherListFilters, function (item){
                            addFilterOption(item.prop, item.value);
                        })
                    }
                    if ($ctrl.options) {
                        for (var trigger in $ctrl.options) {
                            if (trigger.indexOf('LIST_FILTERS_') !== -1) {
                                addWatcher(trigger, $ctrl.options);
                            }
                        }
                    }

                    $ctrl.addWatchersLoaded = true;
                }

                function addWatcher(trigger, options) {
                    var prop = trigger && options ? options[trigger] : null;
                    if (prop) {
                        $ctrl.addRootWatcher(trigger, function (newVal) {
                           // console.log('group: addRootWatcher trigger ' + trigger);
                            onPropChanged(prop, newVal);
                        });
                    }
                }

                function addFilterOption(prop, val) {
                    if (!$ctrl.options) {
                        $ctrl.options = {};
                    }
                    $ctrl.options['LIST_FILTERS_' + prop + getFilterElemType()] = val;
                }
            }
        }

        function getInitList() {
            console.log('getInitList ' + $ctrl.preLoadingTableName);
            if (!$ctrl.preLoadingTableName) {
                return [];
            }

            var orderProp = {};
            orderProp[$ctrl.defaultOrder] = $ctrl.defaultOrderDir;
            return $ctrl.preLoadingService.getObjectList($ctrl.preLoadingTableName, getF($ctrl.listItemsQuery), orderProp);

            function getF(method) {
                if (typeof (method) !== 'function') {
                    return null;
                }
                var f = method();
                if (typeof (f) !== 'function') {
                    return method;
                }
                return f;
            }
        }

        function toggleMobileRow(id) {
            p(false);
            $ctrl.list.items.isOpened = $ctrl.list.items.isOpened === id ? null : id;
            p(true);

            function p(isOpened) {
                if ($ctrl.list.items.isOpened) {
                    $ctrl.broadcastRoot('MOBILE_ROW_TOGGLE_' + $ctrl.elemType + '_GROUP_' + $ctrl.list.items.isOpened, isOpened);
                }
            }
        }

        function getViewMobileDetailsHeader(item) {
    return '<div ' +
        //' class="' + $ctrl.itemSelector + '" ' +
        'style="margin: -32px ' + ($ctrl.noSideMarginMobile ? '-15px' : '0') + '">' +
                '<div class="clearfix dd-item strip-item-grid medium-template productitemcolumn ' + $ctrl.getItemSelectorCls() + '">' +
                    '<div class="row-schedule ' + ($ctrl.withColoredHeader ? ' colored-col ' : '') +
        $ctrl.getMobileColoredHeader(item) + '"' +
                     //(isCls ? '' : (' style="background-color:' + v + '"'))+
                '>' +
        //side border for shot
        (item.type === 1 && item.color ? ('<div class="cant-shrink color-column6 prefront '+$ctrl.getViewEditElemSelector('color')+'" style="background-color:' + item.color + '"></div>') : '') +
        $ctrl.processListItemColumns(item, false, false, true, undefined, null).content + '</div>' +
                '</div>' +
          '</div>';
        }

        function openMobileItemDetails(item) {
            console.log('openMobileItemDetails');
            var withTopHeader = true;
            var result = getProcessListItemsColumns(item);
        return '<div class="modal-window modal-no-padding display-block modal fade in white-bg" tabindex="-1" style="z-index: 10000009">' +
                    '<div class="modal-dialog modal-medium">' + $ctrl.getModalItemContent(item, withTopHeader, result) + '</div>' +
               '</div>';
        }

        function getProcessListItemsColumns(item){
            return $ctrl.processListItemColumns(item, false, false, true, true, null);
        }

        function getModalItemHeader(item, result) {
            if(!result){
                result = getProcessListItemsColumns(item);
            }

            var img = result && result.img ? result.img : getPopupLogo(),
                title = result && result.title ? result.title : ('Details for ' + $ctrl.itemTitle),
                subtitle = result ? result.subtitle : '';

            //shot list & stripboard
            if (typeof ($ctrl.getMobileColoredHeader) === 'function') {
                return getViewMobileDetailsHeader(item);
            } else {
                return '<div class="form-wrapper">' +
                    (img||'') +
                    (title?('<h3>' + title + '</h3>'):'') +
                    (subtitle ? ('<div class="viewdetails-subtitle">' + subtitle + '</div>') : '') +
                    ($ctrl.isActiveTree() && typeof ($ctrl.getRowMobileActions) === 'function' ? ('<div class="mobile-actions">' + getBtnsInfo($ctrl.getRowMobileActions(item)) + '</div>') : '') +
                    '</div>';
            }
        }

        function getModalItemContent(item, withTopHeader, result) {
            if(!result){result = getProcessListItemsColumns(item);}
            var content = result ? result.content : '';
            var clsModal = 'sb-modal-content-w fancy-scrollbar ultrathin';
            return '<div class="modal-content show-scrollbar-on-hover">' +
                    '<div class="' + clsModal + '">' +
                        '<div class="modal-header mobile-header with-gray-bottom clearfix hide-print">' + getModalItemHeader(item, result) + '</div>' +
                        '<div class="modal-body clearfix centered font-general font-general-16"><div class="form-wrapper long">' + content + '</div></div>' +
                    '</div>' +
                    (withTopHeader ? topHeaderBar() : '') +
                '</div>';

            function topHeaderBar(){
                return '<div class="modal-header with-gray-bottom mobile-nav-header table-div hide-print">' +
                    '<div class="centered">' +
                    '<div class="table-div full-width with-cursor ' + $ctrl.getClickEventName('hideMobileItemDetails') + '">' +
                    '<div class="centered col30">' + $ctrl.LCS.getISBDiv('back', null, 'pull-left') + '</div>' +
                    '<div class="semibold text-left">Back</div>' +
                    '</div>' +
                    '</div>' +
                    ($ctrl.canEdit ? ('<div class="centered text-right">' +
                        ($ctrl.isActiveFilterItem(item) ? ('<button class="uppercase btn btn-primary ' + $ctrl.getClickEventName($ctrl.modalMethodForEdit ? $ctrl.modalMethodForEdit : 'modalEdit') + ' ' + $ctrl.pageClass + '" type="button">Edit</button>') : '') +
                        getMoreBtn() +
                        '</div>') : '') +
                    '</div>';
            }
        }

        function hasMobileActions() {
            return typeof ($ctrl.getRowMobileActions) === 'function' || $ctrl.canEdit ||
                $ctrl.withMobileDetails;
        }

        function isToggleMobileRow(id) {
            if ($ctrl.hasMobileActions()) {
                return $ctrl.list.items.isOpened === id;
            } else {
                console.log('open the details page');
            }
        }

        function getRowMobile(item) {
            console.log('getRowMobile');
            var el = $ctrl.hasMobileActions() ? ('<div class="grow-column">' +
                (typeof ($ctrl.getRowMobileActions) === 'function' && $ctrl.isActiveTree() ? getBtnsInfo($ctrl.getRowMobileActions(item)) : '') +
                getBtnsInfo([{type: 'openMobileItemDetails', icon: 'details', action: 'Details'}]) +
                '</div>' +
                $ctrl.getMoreBtnInit()
            ) : null;
            if (!$ctrl.withMobileDetails) {
                return el;
            }

            var details = $ctrl.getRowMobileOther ? $ctrl.getRowMobileOther(item) : null;
            if (!details) {
                return el;
            }

            return '<div class="grow-column">' +
                '<div class="table-div full-width">' + el + '</div>' +
                '<div class="table-div full-width">' + details + '</div>' +
                '</div>';
        }

        function getBtnsInfo(l) {
            if (!l || l.length === 0) {
                return '';
            }
            var el1 = '';
            _.each(l, function (el) {
                el1 += '<button type="button" class="btn btn-small transparent2 ' + $ctrl.getClickEventName(el.type) + '" analytics-on analytics-action="Open Mobile ' + el.action + '"' +
                    (el.param!==null && el.param!==undefined ? ('data-param="'+el.param+'"'):'')+
                    '>' +
                    $ctrl.LCS.getISBDiv(el.icon, el.iconLevel, 'centered gray') +
                    '</button>';
            });
            return el1;
        }

        function getMoreBtn() {
            return $ctrl.canEdit && $ctrl.isActiveTree() ? ('<div class="btn-group actions with-sb-popover" popover-type="more-actions"><button type="button" class="btn btn-default dropdown-toggle dots">' +
                $ctrl.LCS.getISBDiv('vertical-dots', 2, $ctrl.isNotGrayMore ? '' : 'gray') +
                '</button></div>') : '';
        }

        function showMobileDetailsForItem(item){
            return $ctrl.expandMobileRowWithDetails;
        }

        function getMobileRowActionName(item){
            return ($ctrl.showMobileDetailsForItem(item)) ? 'openMobileItemDetails' : 'toggleMobileRow';
        }

        function getMoreBtnTemplate(isHeader, item, isMobile) {
            if ($ctrl.isPrintLayout) {
                return '';
            }

            if (isMobile === undefined) {
                isMobile = $ctrl.isMobileView();
            }

            return $ctrl.hasMobileDetails(item) ? getMobileToggleAndRow() : getNonMobileBtns();

            function getNonMobileBtns() {
                return (typeof ($ctrl.getInlineActions) === 'function' && $ctrl.showInlineActionBtns(isHeader) && $ctrl.isActiveFilter() ? $ctrl.getInlineActions(isHeader, item) : '') +
                    $ctrl.getNonMobileBtns(isHeader, isMobile, item);
            }

            function getMobileToggleAndRow() {
                return '<div class="item-drp show-ipad hide-print no-drag  text-center col-last ' + ((typeof ($ctrl.getMobileToggleAndRowCls) === 'function') ? $ctrl.getMobileToggleAndRowCls(item) : '') +
                    //($ctrl.alignHandle === 'left' ? 'text-right ' : ($ctrl.alignHandle === 'right' ? 'text-left ' : 'text-center ')) +
                    (isHeader ? '' : (' dropdown-mobile ' + $ctrl.getClickEventName($ctrl.getMobileRowActionName(item)))) +
                    '"> ' + (isHeader ? '' : $ctrl.LCS.getISBDiv('forward-arrow', null, 'with-arrow')) + '</div>';
            }
        }

        function getNonMobileBtns(isHeader, isMobile, item) {
            var mb = $ctrl.getMoreInfoBtnTemplate(isHeader, item);
            return $ctrl.canEdit && !$ctrl.hideRemoveBtn ? ('<div ' + (isHeader ? 'ng-if="!$ctrl.isGridView" ' : '') + ' class="side-actions hide-print no-drag ' + (
                    (isMobile ? (mb.count === 3 ? 'col80 ' : (mb.count === 2 ? 'col50 ' : '')) : 'col30 ') +
                    ($ctrl.block ? ' unchangedcolor ' : '') +
                    (!isHeader && typeof ($ctrl.getMoreBtnCls) === 'function' ? $ctrl.getMoreBtnCls(item) : '') +
                    ($ctrl.noSideColumnBorders && !isMobile ? 'no-borders ' : '')) +
                ($ctrl.rowVTop ? ' vtop' : '') +
                '">' + mb.content + '</div>') : '';
        }

        function showInlineActionBtns(isHeader) {
            return (!$ctrl.isGridView || isHeader);
        }

        function getMoreInfoBtnTemplate(isHeader, item) {
            return {
                count: 1,
                content: isHeader ? '' : ('<div class="with-dots with-hover with-transition">' + getMoreBtn() + '</div>')
            };
        }

        function onDestroy() {

            if (typeof ($ctrl.onInitGroupDestroy) === 'function') {
                $ctrl.onInitGroupDestroy();
            }
        }

        function getTableClass() {
            return $ctrl.tableClass ? $ctrl.tableClass.replace(/\./g, ' ') : '';
        }

        function cantSetSortable(){
           // if manySortableGroups keyboardservice is set in tree
            return $ctrl.withoutGroupSorting;
        }

        //currentItemId isPrevious

        function hasLogoImg(item){
            return true;
        }

        function canLikeItems(){
            var u = $ctrl.security.getCurrentUser();
            return $ctrl.withLikesOnItem && ($ctrl.CPS.isAuthenticated || $ctrl.CPS.isCollaborator && u && !u.isGeneral); //if is a user or collab not general
        }

        function viewNextImagePopup(params, item, isCurrent) {
            console.log('viewNextImagePopup');
            // $ctrl.LCS.timeout(process, 200);
            if (!params && $ctrl.hasItemImages && item) {
                $ctrl.withComments = true;

                var imgProp = $ctrl.service.materialProps ? $ctrl.service.materialProps[0] : null,
                    c = imgProp ? _.find($ctrl.filtersService.listCols, {prop: imgProp}) : null;
                if (c) {
                    var canComment = $ctrl.withComments ? $ctrl.canComment : false,
                        withCommentsCount = c.withCommentsCount === true,
                        withLikesOnItem = c.withLikesOnItem && $ctrl.canLikeItems(),
                        withCommentsOnItem = c.withCommentsOnItem === true;
                    params = {
                        imgProp: imgProp,
                        withComments: $ctrl.withComments,
                        canComment: canComment,
                        withCommentsOnItem: withCommentsOnItem,
                        withLikesOnItem: withLikesOnItem,
                        withCommentsCount: withCommentsCount,
                        withNext: c.withNext,
                        canUpload: canEditImage(item)
                    };
                    params.currentList = _.extend({}, getCurrentListWithParams(), {
                        withCommentsOnItem: withCommentsOnItem,
                        withLikesOnItem: withLikesOnItem,
                        withCommentsCount: withCommentsCount
                    }, $ctrl.security.getImageExtraInfo(item, imgProp));

                    /*  editorOptions: _.extend(c.isAvatar ? {
                isSquare: c.prop !== 'productionLogo',
                isCircleMask: c.areaType === 'circle',
                maxWidth: 600
            } : {}, {
                isAvatar: c.isAvatar,
                startWithEditor: c.isAvatar || $ctrl.startWithEditor
            });*/
                }
            }
            var currentItemId = params && params.currentList ? params.currentList.currentItemId : null;
            if (!currentItemId) {
                return;
            }

            if(isCurrent){
                get(item);
            } else {
                getNext(currentItemId);
            }

            function getNext(currentItemId) {
                var list = _.filter($ctrl.list.items, $ctrl.hasLogoImg);
                if(list.length > 0){

                }
                var index = _.findIndex(list, {_id: currentItemId});
                if (index === -1) {
                    return;
                }

                var isPrevious = params.isPrevious === true,
                    max = list.length - 1,
                    selIndex = getNextIndex(index),
                    selIndexInit = selIndex,
                    notFirst;

                getItem(selIndex);

                /*while (!notFirst && selIndex !== selIndexInit) {
                    if (getItem(selIndex)) {
                        break;
                    }
                }*/

                function getItem(selIndex) {
                    if (selIndex >= 0) {
                        var item = list[selIndex];
                        if (item) {
                            if ($ctrl.hasLogoImg(item)) {
                                get(item);
                                return true;
                            } else {
                                return getItem(selIndex);
                            }
                        }
                    }
                }

                function getNextIndex(index) {
                    var selIndex = -1;
                    if (max > 0) {
                        if (isPrevious) {
                            selIndex = index - 1;
                            if (selIndex < 0) {
                                selIndex = max;
                            }
                        } else {
                            selIndex = index + 1;
                            if (selIndex > max) {
                                selIndex = 0;
                            }
                        }
                        /*if (selIndex === selIndexInit) {
                            notFirst = true;
                        }*/
                    }
                    return selIndex;
                }
            }

            function get(el){
               var id = el ? el._id : undefined;
                if (id) {
                    var propId = el[$ctrl.security.getImgPropIdName(params.imgProp)];
                    if (propId) {
                        $ctrl.popupsService.open(propId, $ctrl.popupsService.operations.materialViewer, params, null, null, function (result) {
                            if (result && result.withNext) {
                                $ctrl.viewNextImagePopup(_.extend({}, params, {
                                    currentList: _.extend({}, params.currentList, $ctrl.security.getImageExtraInfo(el, params.imgProp))
                                }));
                            }
                        });
                    } else {
                        //getNext(index)
                        console.log('next item has no image');
                    }
                }
            }
        }

        function getCurrentListWithParams() {
            return $ctrl.currentList ? _.extend($ctrl.currentList, {
                collectionName: $ctrl.service.collectionName,
                itemTitle: $ctrl.itemTitle,
                nameForList: $ctrl.nameForList,
                elemType: $ctrl.elemType
            }) : null;
        }

        function reloadGroupTemplate(onReloadGroupTemplate) {
            console.log(getSBTimestamp() + ' GroupInitCtrlService.reloadGroupTemplate: currentListId=' + $ctrl.currentListId);
            $ctrl.broadcastRoot('CLEAR_SEARCH');

            if ($ctrl.groupCompile) {
                onGroupCompileTemplateLoaded($ctrl.groupCompile.templateCompileTempEl);
            }else {
                //destroyImgObserver();
                if (($ctrl.hasItemImages || $ctrl.isMasonary) && !$ctrl.imgObserverService) {
                    $ctrl.imgObserverService = new $ctrl.ImgObserverCtrlService($ctrl.watchers);
                    $ctrl.imgObserverService.currentList = getCurrentListWithParams();
                    $ctrl.imgObserverService.viewNextImagePopup = $ctrl.viewNextImagePopup;
                }
                if($ctrl.isMasonary && $ctrl.canEdit && $ctrl.keyboardService) {
                    $ctrl.imgObserverService.keyboardService = $ctrl.keyboardService;
                }

                $ctrl.groupCompile = new $ctrl.TemplateCompileService($ctrl.$element, getCompiledGroupTemplate, $ctrl);

                if ($ctrl.groupCompile) {
                    $ctrl.groupCompile.loadTemplate(onGroupCompileTemplateLoaded);
                }
            }

            function getCompiledGroupTemplate() {
                //console.log('GroupSimpleInitCtrlService.getCompiledGroupTemplate');
                if (!$ctrl.allLoaded) { return ;}

                $ctrl.bindItems = 1;
                return $ctrl.getGroupTemplate();
            }

            function onGroupCompileTemplateLoaded(result) {
                //console.log('GroupSimpleInitCtrlService.onGroupCompileTemplateLoaded');

                setSortable();

                $ctrl.setGroupObserver();

                if($ctrl.isPrintLayout){
                    return onGroupContentTemplateLoaded();
                }

                if($ctrl.groupContentCompile) {
                    $ctrl.groupContentCompile.destroyNewScope();
                }

                $ctrl.groupContentCompile = new $ctrl.TemplateCompileService($ctrl.element.querySelector('.' + $ctrl.groupContentCls), $ctrl.getCompiledGroupContentTemplateInit, $ctrl);

                $ctrl.groupContentCompile.delay = -1;
                if ($ctrl.groupContentCompile) {
                    $ctrl.groupContentCompile.loadTemplate(onGroupContentTemplateLoaded);
                }

                $ctrl.LCS.timeout(function () {
                    if (!$ctrl.groupContentCompile.isLoadedAgain) {
                        onGroupContentTemplateLoaded();
                    }
                }, 0);

                $ctrl.LCS.timeout(function (){
                    $ctrl.bindActions(true);
                }, 200);

                function onGroupContentTemplateLoaded() {
                    //console.log('GroupSimpleInitCtrlService.onGroupContentTemplateLoaded');

                    if($ctrl.groupContentCompile) {
                        $ctrl.groupContentCompile.isLoadedAgain = true;
                    }

                    if ($ctrl.bindItems === 1) {
                        //console.log('onInitGroupLoaded: currentListId=' + $ctrl.currentListId);
                        initIds();
                        var dd = $ctrl.element.querySelector('.' + $ctrl.groupWrapperName);
                        if (dd) {
                            dd.setAttribute('id', $ctrl.sortableGrid);
                            if ($ctrl.tableClass) {
                                $ctrl.LCS.addClass(dd, $ctrl.tableClass.replace(/\./g, ' '));
                            }
                        }

                        $ctrl.setCounterOther(300);

                        if($ctrl.isPrintLayout){
                            $ctrl.griditemloaded = $ctrl.addRootWatcher('GRID_ITEM_LOADED_' + $ctrl.currentListId, onGridItemLoaded);
                        }
                        if($ctrl.isMasonary) {
                            $ctrl.griditempreloaded = $ctrl.addRootWatcher('GRID_ITEM_PRELOADED_' + $ctrl.currentListId, onGridItemPreloaded);
                        }
                    }

                    if ($ctrl.isPrintLayout) {
                        $ctrl.broadcastRoot('GRID_PRINT_LOADED_INIT', $ctrl.currentListId);
                    }

                    if (typeof(onReloadGroupTemplate) === 'function') {
                        onReloadGroupTemplate(result);
                    }
                }

                function setSortable(){
                    if (!$ctrl.isPrintLayout) {
                        if ($ctrl.triggerSetSortable) {
                            //defined in tree
                            if (!$ctrl.keyboardService.definedInPageTree) {
                                $ctrl.keyboardService.setSortable($ctrl);
                            }
                            $ctrl.triggerSetSortable = false;
                            $ctrl.bindTableEvents(true, $ctrl.getTreePopupParams());//add new table events
                        }
                    }
                }
            }
        }

        function getInitWrapperCls(hasElements) {
            if (hasElements === undefined) {
                hasElements = $ctrl.hasElements() > 0;
            }
            return (!hasElements ? 'with-no-bg ' : ($ctrl.withGroupGrayBg ? 'with-gray-bg ' : 'with-white-bg ')) +
                (hasElements ? 'with-fancy-scrollbar' : 'is-empty');
        }

        function setInitWrapperCls(p, hasElements) {

            set('.group-template .row-header.list-header');
            set('.row-schedule.header .check');

            var cls = $ctrl.getInitWrapperCls(hasElements);
            $ctrl.LCS.replaceClass(p ? p : $ctrl.element.querySelector('.' + $ctrl.initWrapperCls), 'with-gray-bg with-white-bg with-no-bg with-fancy-scrollbar is-empty', cls);

            function set(elCls) {
                $ctrl.LCS[$ctrl.isGridView ? 'addClass' : 'removeClass']($ctrl.element.querySelector(elCls), 'gridview');
            }
        }

        function setCounterOther(delay) {
            $ctrl.LCS.timeout(function () {
                var p = $ctrl.element.querySelector('.' + $ctrl.initWrapperCls);
                if (p) {
                    var hasElements = $ctrl.hasElements() > 0;
                    $ctrl.setInitWrapperCls(p, hasElements);
                }
                if (typeof ($ctrl.setGroupCounter) === 'function') {
                    $ctrl.setGroupCounter();
                }
            }, delay);
        }

        function onGridItemPreloaded(result) {
            //console.log('onGridItemPreloaded');
            checkAllLoaded('mids', result.id, next);

            function next() {
                reloadMasonaryLayout({items: $ctrl.list.items, grid: $ctrl.element});
            }
        }

        function onGridItemLoaded(result) {
            if($ctrl.isPrintLayout) {
                $ctrl.broadcastRoot('GRID_ITEM_PRINT_LOADED', result);
               // console.log('onGridItemLoaded: ' + id);
                checkAllLoaded('ids', result.id, next);
            }

            if(typeof($ctrl.onGridItemLoadedOther) === 'function') {
                $ctrl.onGridItemLoadedOther();
            }

            function next() {
                $ctrl.broadcastRoot('GRID_PRINT_ITEMS_LOADED', $ctrl.currentListId);
            }
        }

        function checkAllLoaded(prop, id, next){
            $ctrl[prop]['i_' + id] = true;
            var loaded = true;
            for (var p in $ctrl.ids) {
                if (!$ctrl[prop][p]) {
                    loaded = false;
                    break;
                }
            }

            if (loaded && next) {
                next();
            }
        }

        function onInitGridItemActions(result) {
            try {
                //console.log('onGridItemActions: ' + result.type);
                var method = $ctrl[result.type],
                item = $ctrl.cloneItem(result.item);
                if (method) {
                    return method(item, result.field, result.e);
                } else if ($ctrl.processItem) {
                    return $ctrl.processItem(item, result.type, result.field);
                } else {
                    console.warn('onGridItemActions: must define method $ctrl.' + result.type);
                }
            } catch (e) {
                console.error(e);
            }
        }

        function getNew(after, type) {
            //console.log('getNew');
            var params = $ctrl.getParams();
            if(type && typeof(type) === 'string'){type = parseInt(type,10);}
            if($ctrl.listField){
                params[$ctrl.listField] = $ctrl.listTreeService && $ctrl.listTreeService.withHarcodedAll && $ctrl.currentListId === 'All' ? null : $ctrl.currentListId ;
            }
            if($ctrl.withActiveGroup) {
                params.active = true;
            }
            if (!after) {
                after = $ctrl.getFirstSelectedId();
            }
            params.afterId = null;
            var afterId = null,
                items = $ctrl.list.items;
            if (after) {
                afterId = after._id;
                var exists = _.find(items, {_id: afterId});
                if (!exists) {
                    after = null;
                }
            }
            params.afterId = afterId;
            params.order = $ctrl.list.getNewItemOrder();

            if(typeof($ctrl.getNewParams) === 'function'){
                params = $.extend(params, $ctrl.getNewParams(after, type, items));
            }
            return $ctrl.service.convertResource(params);
        }

        function getParams() {
            var params = {
                companyId: $ctrl.CPS.companyId,
            };
            if ($ctrl.CPS.productId) {
                params.productId = $ctrl.CPS.productId;
            }
            return params;
        }

        function withProperty() {
            var params = $ctrl.getParams();
            if ($ctrl.withActiveGroup) {
                params.active = ($ctrl.filtersService && $ctrl.filtersService.selectedFilter || !$ctrl.filtersService);
            }
            return params;
        }

        function setKeyEvents() {
            var other = typeof ($ctrl.getKeyEvents) === 'function' ? $ctrl.getKeyEvents() : [];
            if ($ctrl.keyboardService) {
                $ctrl.keyboardService.setKeyEvents($ctrl.currentListId, getKeyEvents(other).concat(other));
            }
        }

        function getKeyEvents(other) {
            var keys = [{
                type: 'Edit',
                keys: [$ctrl.keyboardService.keys.EKey, $ctrl.keyboardService.keys.eKey],
                method: onEditKey
            }];

            if ($ctrl.withActiveGroup) {
                keys.push({
                    type: 'Archive',
                    keys: [$ctrl.keyboardService.keys.AKey, $ctrl.keyboardService.keys.aKey],
                    method: onAKey
                });
            }

            if(!other){
                keys.push({
                    type: 'Create',
                    keys: [$ctrl.keyboardService.keys.NKey, $ctrl.keyboardService.keys.nKey],
                    method: onCreateKey
                });

            }

            return keys;

            // im not sure what isthis below for. thows error due to recursive
            /*return keys.map(function (key){
                key.method = function (sId, item){
                    //trigger on ctrl
                    console.log('getKeyEvents.method');
                    return key.method(sId, item);
                }
                return key;
            });*/

            function onCreateKey(sId, item) {
                if ($ctrl.currentListId !== sId) {
                    return;
                }
                $ctrl.create(item);
            }

            function onEditKey(sId, item) {
                $ctrl.edit(item);
            }

            function onAKey(sId, item) {
                item.active ?  $ctrl.archive(item) : $ctrl.activate(item);
            }
        }

        function getCreateInlineGroup(type){
            return $ctrl.withCreateInlineGroup && !$ctrl.isMobileView();
        }

        function getEditInlineGroup(type){
            return $ctrl.withEditInlineGroup && !$ctrl.isMobileView();
        }

        function getMoreNewItem(moreNewItemData){
            var isEvent = moreNewItemData && (moreNewItemData instanceof Event);
            if(isEvent){return null;}
            var s = moreNewItemData ? moreNewItemData.toString() : null;
            return (s && (s.indexOf('PointerEvent') !== -1 || s.indexOf('TouchEvent') !== -1)) ? null : moreNewItemData;
        }

        function computeNewItem(after, type, moreNewItemData){
            //when called from onMorePopoverInitUpdate
            var isEvent = moreNewItemData && (moreNewItemData instanceof Event);
            if(!isEvent) {
                var s = moreNewItemData ? moreNewItemData.toString() : null;
                if (s && (s.indexOf('PointerEvent') !== -1 || s.indexOf('TouchEvent') !== -1)) {
                    isEvent = true;
                }
            }
            if(type && typeof(type) === 'string'){type = parseInt(type,10);}
            return _.extend($ctrl.getNew(after, type), (isEvent || !moreNewItemData) ? {} : moreNewItemData);
        }

        function create(after, type, moreNewItemData, addInline, isDuplicate, e) {
            console.log('groupsimple create');
            var item = $ctrl.computeNewItem(after, type, moreNewItemData),
                quotaType = $ctrl.getGroupQuota(type);

            if(quotaType) {
                $ctrl.checkQuota(quotaType, next, {
                    maxAddedCount: 1,
                    type: type,
                    e: e
                });
            } else{
                next();
            }

            function next(maxAddedCount) {
                return ((addInline || $ctrl.getCreateInlineGroup(type)) ? createInline : createForPopup)(maxAddedCount);
            }

            function createInline(maxAddedCount) {
                $ctrl.service.insert(item, onSuccess, onError);

                function onSuccess(result) {
                    console.log('on create inline');
                    var nitem = result ? result.item : null;
                    if (!nitem) {
                        return onError();
                    }
                    $ctrl.broadcastRoot($ctrl.GroupEvents.Added, result);

                    if (!addInline && !$ctrl.getEditInlineGroup(type)) {
                        $ctrl.LCS.timeout(function () {
                            $ctrl.edit($ctrl.getItemToEdit(nitem), 1);
                        }, 100);
                    }
                }

                function onError(err) {
                    //  $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.' + $ctrl.elemType + '.' + method + '.error', 'error');
                }
            }

            function createForPopup(maxAddedCount) {
                var p = $ctrl.getNewPopupParams(item);
                if (!p) {
                    p = {};
                }

                p.maxAddedCount = maxAddedCount;

                if (!p.columnsList) {
                    p = _.extend(p, $ctrl.getEditPopupColumns(true, item));
                }

                p.withLabel = $ctrl.withLabel; // for labels on predef new / edit popup
                p.isDuplicate = isDuplicate;

                $ctrl.createNew($ctrl.getPopupNameForCreate(item, true), quotaType, item, p);
            }
        }

        function getPopupNameForCreate(item, isNew){
return isNew ? 'create' : 'update';
        }

        function getItemToEdit(item) {
            return item ? _.find($ctrl.list.items, {_id: item._id}) : null;
        }

        function editInit(item, field) {
            if(!item){return;}
            console.log('groupsimple edit');
            var p = typeof($ctrl.getEditPopupParams) === 'function' ? $ctrl.getEditPopupParams(item, field) : $ctrl.getNewPopupParams(item);

            if(!p.columnsList){
                p = _.extend(p, $ctrl.getEditPopupColumns(false, item));
            }

            //customNote for moodboards
            if(field !== undefined &&!$ctrl.withoutFieldInit){p.field = field;}

            if($ctrl.imgObserverService){
                p.imgObserverService = $ctrl.imgObserverService;
            }
            p.canEdit = $ctrl.canEdit;
            $ctrl.getOperationPopup(item, $ctrl.getPopupNameForCreate(item, false), p);
        }

        function duplicate(item, info, e) {
            console.log('duplicate');
            var afterId = item._id,
                newItem = angular.copy(item);
            delete newItem._id;
            newItem.afterId = afterId;
            if($ctrl.listField){
                newItem[$ctrl.listField] = $ctrl.currentListId === 'All' ? null : $ctrl.currentListId;
            }

            $ctrl.create(item, item.type, newItem, false, true, e);
        }

        function destroyImgObserver(){
            if($ctrl.imgObserverService && $ctrl.imgObserverService.destroy) {
                $ctrl.imgObserverService.destroy();
            }
            if($ctrl.rowObserverService && $ctrl.rowObserverService.destroy) {
                $ctrl.rowObserverService.destroy();
            }
        }


        function setDrag(el, isBind) {
            if (el && $ctrl.keyboardService && $ctrl.keyboardService.sortableService && $ctrl.keyboardService.sortableService.isMasonary && typeof($ctrl.keyboardService.sortableService.bindDraggabilly) === 'function') {
                $ctrl.keyboardService.sortableService.bindDraggabilly(el, isBind);
            }
        }

        function setGroupObserver() {
            $ctrl.destroyGroupObserver();

            if (!$ctrl.sortableContainerCls) {
                return;
            }
            var parent = $ctrl.element.querySelector('.' + $ctrl.sortableContainerCls);
            if (parent) {
                $ctrl.groupObserver = new MutationObserver(onGroupObserver);
                $ctrl.groupObserver.observe(parent, observerOptions);
            }

            function onGroupObserver(mutations) {
                //console.log('GroupSimpleInit.onGroupObserver');

                if (!$ctrl.isMasonary) {
                    return;
                }

                for (var m of mutations) {
                    //console.log('G '+ group.id + ' Mutation Detected: ' + m.type);
                    if (m.type === 'childList') {
                        var isAdd = m.addedNodes && m.addedNodes.length > 0,
                            isRemove = m.removedNodes && m.removedNodes.length > 0;
                        if(isAdd || isRemove) {
                            var el = m[isAdd ? 'addedNodes' : 'removedNodes'][0];
                            if(el && el.className && el.className.indexOf($ctrl.getItemSelectorCls().split(' ')[0]) !== -1){
                                setItem(el);
                                //setDrag(el, isAdd);
                            }
                        }
                    }
                    //  el.scrollIntoView({block: "end"});
                }

                function setItem(el) {
                    if (!el) {
                        return;
                    }
                    var id = el.getAttribute ? el.getAttribute('data-id') : null;
                    if(!id){
                        return;
                    }
                    var item = $ctrl.list.getElementById(id);
                    if (!item) {
                        return;
                    }
                    if(item.type === 2){//isbanner
//console.log('banner');
                    } else {
                        var imgCol = _.find($ctrl.columnsList, {type: $ctrl.SBFieldTypesService.PropTypes.Picture}).prop,
                            r = imgCol ? item[imgCol + 'Ratio'] : null,
                            prop = '--masonary-rev-ratio';
                        if (r) {
                            if (!el.style) {
                                el.style = {};
                            }

                           // el.style.setProperty(prop, r ? (1 / r) : 1);
                            el.style.setProperty(prop, r ? r : 1);
                            //   height: calc(var(--masonary-width) * 1px * var(--masonary-rev-ratio)) !important;
                            //  el.style.setProperty('height', ((el.width ? el.width : el.getBoundingClientRect().width) / r) + 'px');
                        } else {
                            if (el.style) {
                                el.style.removeProperty(prop);
                                el.style.setProperty('height', 'auto');
                            }
                        }
                    }
                }
            }

        }

        function destroyGroupObserver(){
            if($ctrl.groupObserver) {
                $ctrl.groupObserver.disconnect();
            }
        }

        function onInitGroupDestroy() {
            $ctrl.bindActions(false);

           // console.log('onInitGroupDestroy');
            if ($ctrl.canEdit && $ctrl.keyboardService) {
                $ctrl.keyboardService.removeKeyEvents($ctrl.currentListId);
                removeSortable();
            }

            if($ctrl.bindTableEvents) {
                $ctrl.bindTableEvents();
            }

            $ctrl.onListDestroy();

            if (!withoutPopover) {
                if ($ctrl.onPopupEventsDestroy) {
                    $ctrl.onPopupEventsDestroy();
                }
            }else if ($ctrl.onListPopoverDestroy) {
                $ctrl.onListPopoverDestroy();
            }

            destroyImgObserver();

            if($ctrl.groupCompile && typeof($ctrl.groupCompile.destroyNewScope) === 'function') {
                $ctrl.groupCompile.destroyNewScope();
            }
            $ctrl.destroyGroupObserver();

            bindLoadMore(false);

            if($ctrl.onDestroyGroupOther){
                $ctrl.onDestroyGroupOther();
            }
        }

        function getInitGroupList(els){
           return $ctrl.listTreeService && $ctrl.listTreeService.isRecursiveTree  && $ctrl.currentListId === 'All' ? _.filter(els, {isFolder: false}) : els;
        }

        function onInitListChanged(els, forceReload) {
            console.log('start onInitListChanged - reloading ' + $ctrl.elemType + ': ' + $ctrl.currentListId + ' selectedFilter: ' + $ctrl.selectedFilter);
            $ctrl.selectedFilter = $ctrl.filtersService.selectedFilter;
            if (forceReload ||
                els !== undefined && !$ctrl.isProcessing && ($ctrl.initList ===undefined ||
                $ctrl.prevSelectedFilter !== $ctrl.selectedFilter ||
                !isSameList(els)
            )) { //if there are changes reload
//todo figure out why doesnt load
//            if (!$ctrl.isProcessing && difIds(els)) { //if there are changes reload
                console.log('onInitListChanged - reloading ' + $ctrl.elemType + ': ' + $ctrl.currentListId + ' selectedFilter: ' + $ctrl.selectedFilter);
                $ctrl.prevSelectedFilter = $ctrl.selectedFilter;
                if (els === undefined) {return;}
                $ctrl.isProcessing = true;
                els = $ctrl.getInitGroupList(els);

                $ctrl.initList = _.filter(
                    typeof($ctrl.preProcessGroupItems) === 'function' ?  els.map($ctrl.onPreProcessGroupItems) : els, function (item){return item;});
               // console.log(els);
                  $ctrl.list.setList($ctrl.initList);
               // $ctrl.list.setList([]);

                $ctrl.broadcastRoot($ctrl.keyboardService.CLEAR_SELECTED);

                if (typeof ($ctrl.onListChanged) === 'function') {
                    $ctrl.onListChanged();
                }

                //$ctrl.afterProcessUpdates();
                setWithSortable($ctrl.withSortable);
                $ctrl.allLoaded = true;

                console.log('GroupInitCtrlService.reloadGroupTemplate');
                $ctrl.reloadGroupTemplate(onReloadGroupTemplate);

                function onReloadGroupTemplate() {
                    //console.log('GroupInitCtrlService.onReloadGroupTemplate');
                    if(!$ctrl.allLoaded){return;}
                    setGridViewCls();
                    bindLoadMore(true);
                    onReloadInitTemplate();

                    if(typeof($ctrl.onReloadGroupTemplate) === 'function') {
                        $ctrl.onReloadGroupTemplate();
                    }

                    onSortableChanged();
                    $ctrl.isProcessing = false;

                    function onReloadInitTemplate() {
                        var dd = $ctrl.element.querySelector('.' + $ctrl.groupWrapperName);
                        if (dd) {
                            dd.setAttribute('data-currentlistid', $ctrl.currentListId);
                            if ($ctrl.selectedIdFieldIsNumber) {
                                dd.setAttribute('data-isnumber', 'true');
                            }
                        }
                    }

                    function onSortableChanged() {
                        if($ctrl.sortableChanged) {
                            if ($ctrl.withSortable) {
                                initSortable();
                            } else {
                                removeSortable();
                            }
                            $ctrl.sortableChanged = false;
                        }

                        function initSortable() {
                            console.log('initSortable');
                            set(true, $ctrl.element,  {
                                sortableGrid: $ctrl.sortableGrid,
                            });
                        }
                    }
                }
            }

            function isSameList(els){
                var isSame = angular.equals($ctrl.initList.map(function(item){return item._id;}), els.map(function(item){return item._id;}));
                if(!isSame){return isSame;}
                if($ctrl.initList.length > 0 && typeof ($ctrl.isSameList) === 'function'){
                    return $ctrl.isSameList($ctrl.initList, els);
                }
                return isSame;
            }
        }

        function difIds(els) {
            var elsIds = els && els.length > 0 ? els.map(function (item) {
                return item._id;
            }) : null;

            if (!$ctrl.initListIds === undefined && elsIds || !angular.equals($ctrl.initListIds, elsIds)) {
                $ctrl.initListIds = elsIds;
                return true;
            }

            return false;
        }

        function updateGridViewMode() {
            console.log('updateGridViewMode');
            if (!$ctrl.filtersService || !$ctrl.filtersService.options) {
                return;
            }

            if ($ctrl.isGridView !== $ctrl.filtersService.checkGridView()) {
                setGridView();
                return true;
            }

            return false;
        }

        function getFilterName(prop) {
            var el = prop.split('.')[0], split = el.match(/(^[a-z]+)|([A-Z][a-z]+)/g),
                res = (split ? split.join(' ') : el);
            return res.substring(0, 1).toUpperCase() + res.substring(1);
        }

        function setGridView() {
            if (!$ctrl.filtersService || !$ctrl.filtersService.options) {
                return;
            }

            $ctrl.isGridView = $ctrl.filtersService.checkGridView();

            setGridViewCls();
        }

        function getFilterElemType(block) {
            return getPrefix() + '_' + $ctrl.elemType + (block ? ('_' + block) : '');
        }

        function getPrefix(){
            return ($ctrl.isPrintLayout ? '_PRINT_LAYOUT' : '') +
                ($ctrl.isInTreeModal ? '_TREE_MODAL' : '');
        }

        function broadcastListFiltersCols(value, block){
            $ctrl.broadcastRoot('LIST_FILTERS_COLUMNS' + getFilterElemType(block), value);
        }

        function broadcastListFiltersColumn(value, block){
            $ctrl.broadcastRoot('LIST_FILTERS_COLUMN' + getFilterElemType(block), value);
        }
        function initIds() {
            //console.log('initIds ' + $ctrl.currentListId);
            if ($ctrl.isPrintLayout) {
                set('ids');
            }
            if ($ctrl.isMasonary) {
                set('mids');
            }

            function set(prop) {
                $ctrl[prop] = {};
                _.each($ctrl.list.items, function (item) {
                    $ctrl[prop]['i_' + item._id] = false;
                });
            }
        }

        function onPropChanged(prop, newVal) {
            //console.log('GroupSimpleInitCtrlService.onPropChanged ' +$ctrl.elemType +': ' + prop + '=' + newVal);
            if (!angular.equals($ctrl[prop], newVal)) {
                initIds();

                if (angular.equals(prop, 'isGridView')) {
                    updateGridViewMode(newVal);
                    reloadMasonaryLayout(null, true);
                } else {
                    $ctrl.options[prop] = newVal;

                    if (prop === 'column' || prop === 'ratio') {
                        if(!updateGridViewMode()){
                            setGridViewClsOther();
                        }

                        if (prop === 'column'){
                            reloadMasonaryLayout(null, true);
                        }
                    }

                    if ($ctrl.onPropChangedOther) {
                        $ctrl.onPropChangedOther(prop, newVal);
                    }
                }

                if($ctrl.isPrintLayout && (prop === 'columns' || prop === 'isGridView') && typeof($ctrl.getPrintGroupHeader) === 'function'){
                    var el = $ctrl.element.querySelector('.row-header.list-header .row-schedule.header');
                    if(el) {
                        el.innerHTML = $ctrl.getPrintGroupHeader();
                    }
                }
            }
        }

        function setGridViewCls(){
            $ctrl.LCS[$ctrl.isGridView ? 'addClass' : 'removeClass']($ctrl.element, 'is-grid-view');
            setGridViewClsOther();
        }

        function changeOrderInit(prop, type, sortOrder) {
            $ctrl.list.changeOrder(prop, type, sortOrder, $ctrl.SBFieldMethods.itemSort, $ctrl);
            setWithSortable();
        }

        function getOrderArrow(prop) {
            var val = $ctrl.list.orders[prop];
            return val === 1 ? 'arrow-filled-up' : (val === -1 ? 'arrow-filled-down': '');
        }

        function resetOrder() {
            $ctrl.list.orders = null;
            setWithSortable();
        }

        function setWithSortable(initVal) {
            var withSortable = cantSetSortable() ? false :
         ($ctrl.canEdit === true && $ctrl.isActiveTree() && !hasOtherFilter() && !$ctrl.hasSearchOrFilters() &&
             ($ctrl.currentListId !== 'All' || $ctrl.withGroupSortingForAll));
            if (initVal !== undefined) {
                withSortable = initVal && withSortable;
            }
            if ($ctrl.withSortable !== withSortable) {
                $ctrl.withSortable = withSortable;
                $ctrl.sortableChanged = true;
                return true;
            }
            return false;
        }

        function removeSortable() {
            set(false, $ctrl.sortableGrid);
        }

        function set(isAdd, el, params){
            if ($ctrl.keyboardService && $ctrl.keyboardService.sortableService) {
                $ctrl.keyboardService.sortableService[isAdd ? 'addContainer': 'removeContainer'](el, params);
            }
        }

        function hasOtherFilter() {
            //todo adjust based on current default filte. order is not always default prop for sorting
            for (var prop in $ctrl.list.orders) {
                if (prop !== 'order') {
                    return true;
                }
            }
            return false;
        }

        function processEvent(action, item, e) {
            $ctrl.processActionEvent($ctrl.keyboardService.ActionTypes[action], {
                currentListId: $ctrl.currentListId,
                item: item
            }, $ctrl.getTreePopupParams(), e);
        }

        function archive(item, param, e) {
            $ctrl.processSelectedGroupItem(item, 'Archive', e);
        }

        function activate(item, param, e) {
            $ctrl.processSelectedGroupItem(item, 'Activate', e);
        }

        function remove(item, param, e) {
            $ctrl.processSelectedGroupItem(item, 'Delete', e);
        }

        function move(item, param, e) {
            $ctrl.processSelectedGroupItem(item, 'Move', e);
        }

        function processSelectedGroupItem(item, action, e){
            $ctrl.selectKeyboardItem(item);
            onProcessSelectedGroup(action, item, e);
        }

        function onProcessSelectedGroup(action, item, e) {
            console.log($ctrl.GroupEvents.ProcessSelected);
            if(action){
                $ctrl.processEvent(action, item, e);
            }
        }
        
        function onProcessSearchGroup(result, other) {
            console.log($ctrl.GroupEvents.ProcessSearch);
            var prop = other && other.prop ? other.prop : 'search';

            $ctrl.searchProp = prop;

            var searchFields = other && other.searchFields ? other.searchFields : $ctrl.listParams.searchFields,
                isAnd = other && other.isAnd ? other.isAnd : false,
                hasresults = false,
                deps = {},
                propValue = $ctrl[prop];

            if(result && !_.isEqual(result[prop], propValue)) {
                $ctrl[prop] = getV(result[prop]);

                var list = [],
                    initL = $ctrl.list && $ctrl.list.items ? $ctrl.list.items.length : 0;
                if (initL > 0) {
                    _.each($ctrl.list.items, function (item) {
                        var show = searchItemFilter($ctrl[prop], searchFields, item);
                        if (show) {
                            hasresults = true;
                            list.push(item);
                        }
                        //$ctrl.toggleRowById(item._id, show);
                        var newdeps = $ctrl.toggleRowsById(item._id, show);
                        for (var depId in newdeps) {
                            //if was not added or is show for that row
                            if (deps[depId] === undefined || newdeps[depId] === true) {
                                deps[depId] = newdeps[depId];
                            }
                        }
                    });

                    //update departments
                    if (Object.keys(deps).length !== 0) {
                        _.each($ctrl.element.querySelectorAll('.grid-header.dep-header'), function (dep) {
                            $ctrl.LCS[deps[dep.getAttribute('dep-id')] ? 'removeClass' : 'addClass'](dep, 'sb-hide');
                        });
                    }
                }

                process(hasresults);

                var searchedCount = list.length;
                try {
                    var el = $ctrl.LCS.findClosestParent($ctrl.element, '.side-table').parentElement.querySelector('.keyboard-filters .selectedfilterscount');
                    if (el) {
                        $ctrl.LCS[hasresults ? 'removeClass' : 'addClass'](el, 'sb-hide');
                        el.innerText = initL === searchedCount ? '' : (searchedCount + ' of ');
                    }
                } catch (e){
                    console.log(e);
                }
            }

            function process(hasresults) {
                var el = $ctrl.element.querySelector('.sb-scrolling-monitor'),
                    parent = $ctrl.element.querySelector('.scrollable-content');
                if (el && parent) {
                    $ctrl.LCS[hasresults ? 'removeClass' : 'addClass'](el, 'sb-hide');
                    if(hasresults){
                        reloadMasonaryLayout({items: $ctrl.list.items, grid: $ctrl.element}, true);
                    }
                    //in case is in search

                    var s = parent.querySelector('.' + $ctrl.emptySearchGroup);
                    if (s) {
                        $ctrl.LCS.removeElement(s);
                    }

                    if (!hasresults) {
                        $ctrl.LCS.appendChildFragment(parent, getSearchEmpty());
                    }
                }
            }

            function searchItemFilter(propValue, searchFields, item) {
                if (!searchFields) {
                    return true;
                }

                if (!item) {
                    return false;
                }

                var defaultV = isAnd === true,
                    s = isAnd ? null : getProcessed(propValue);

                var val = true;
                for (var i = 0, l = searchFields.length; i < l; i++) {
                    var v = p(searchFields[i]);
                    if(isAnd) {
                        val = val && v;
                    } else {
                        return v;
                    }
                }

                return val;

                function p(f){
                    if (isAnd && propValue) {
                        s = propValue[f];
                    }
                    var r = isAnd ? (s ? processCol(f, s) : null) : processCol(f, s);
                    if(isAnd){
                        if(!s){
                            return defaultV;
                        }else if(!r){
                            return !defaultV;
                        }
                    } else {
                        if (r) {
                            return !defaultV;
                        }
                    }
                    return defaultV;
                }

                function processCol(f, search) {
                    var c = $ctrl.getColumnByProp(f, true),
                        type = c ? c.type : null;
                    return !!(type && $ctrl.searchItemField(search, item, f, type));
                }
            }

            function getV(v) {
                return v ? _.clone(v) : v;
            }
        }

        function getProcessed(v){
            return v ? v.toLowerCase().replace(/’/g, '\'') : v;
        }

        function searchItemFieldInit(search, item, field, type) {
            if(search === null ){return true;}
            var val = item[field];
            if (val === null || val === undefined) {
                return false;
            }

            switch (type) {

                case $ctrl.SBFieldTypesService.PropTypes.Html:
                    return val && isValid(val.replace(/(<([^>]+)>)/ig, ''));

                case $ctrl.SBFieldTypesService.PropTypes.Rate:
                case $ctrl.SBFieldTypesService.PropTypes.ContactRate:
                    return val && val.v && (val.v.toString() === search);

                case $ctrl.SBFieldTypesService.PropTypes.Locations:
                    return isInList(item.locations);

                case $ctrl.SBFieldTypesService.PropTypes.Characters:
                    return isInList(item.characters);

                case $ctrl.SBFieldTypesService.PropTypes.StripLocation:
                    return item.stripLocation && isValid(item.stripLocation.name);

                case $ctrl.SBFieldTypesService.PropTypes.Position:
                    var list = $ctrl.SBFieldMethods.getListOfRoles($ctrl, item);
                    var l = list ? list.length : 0;
                    if (!l) {
                        return false;
                    }
                    for (var i = 0; i < l; i++) {
                        if (isValid(list[i])) {
                            return true;
                        }
                    }
                    return false;

                case $ctrl.SBFieldTypesService.PropTypes.CommentsCount:
                    switch (search) {
                        case 1:
                            return !val; //no comments
                        case 2:
                            return val > 0; //>0
                        default:
                            return true;
                    }

                case $ctrl.SBFieldTypesService.PropTypes.Likes:
                    switch (search) {
                        case 1:
                        case 2:
                            var likes = $ctrl.SBFieldTypesService.SBFieldMethods.getItemLikes(item),
                                count = likes && likes.length > 0 ? likes.length : 0;
                            return search === 1 ? !count : count > 0;
                        case 3:
                            return $ctrl.SBFieldTypesService.SBFieldMethods.isItemLikedByUser(item, $ctrl.CPS.security.getCurrentUserId()); //at least 1 of mine
                        default:
                            return true;
                    }

                default:
                    return isValid(val);
            }

            function isInList(list) {
                return list && list.length > 0 ? _.find(list, function (el) {
                    return el && isValid(el.name);
                }) : false;
            }

            function isValid(val) {
                return val && getProcessed(val).indexOf(search) !== -1;
            }
        }

        function selectKeyboardItem(item) {
            var id = item ? item._id : null;
            if (id) {
                //trigger select row
                $ctrl.selectItemForProcessing(id, ($ctrl.currentListId === 'All' || $ctrl.currentListId === 'Archived') ? ($ctrl.listField ? item[$ctrl.listField] : null) : $ctrl.currentListId);
            }
        }

        function getAllIds(list) { //load all items in current list
            if ($ctrl.isAllSelected === false) { //select all
                _.each($ctrl.list.items, function (item) {
                    var id = item._id;
                    if (!$ctrl.hasCastId(list, id)) {
                        list.push(id);
                    }
                });
                $ctrl.isAllSelected = true;
            } else {  //unselect all
                while (list.length > 0) {
                    list.pop();
                }
                $ctrl.isAllSelected = false;
            }
        }

        function onAllLoaded() {
            $ctrl.onAllLoadedInit(true);
        }

        function onAllLoadedInit(isCurrentList) {
            console.log('onAllLoaded: ' + $ctrl.elemType + ': '+ $ctrl.currentListId);

            $ctrl.keyboardService.currentListId = isCurrentList ? $ctrl.currentListId : null;
            if(isCurrentList && !$ctrl.isPrintLayout && !$ctrl.isCommentsSidebar){
                $ctrl.broadcastRoot('START_INTRO');
            }

            if($ctrl.keyboardService) {
                $ctrl.keyboardService.broadcastGroupLoaded($ctrl, $ctrl.currentListId);
            }

            if (typeof ($ctrl.displayList) === 'function') {
                $ctrl.displayList();
            }

            openItemImageInPopup();
        }

        function onInitAddFromTop(result) {//type, e
            console.log($ctrl.GroupEvents.AddFromTop);
            var l = $ctrl.keyboardService.currentListId;
            if (!$ctrl.currentListId && !l || l && l === $ctrl.currentListId) {
                $ctrl.create(null, result.type, null, null, null, result ? result.e : null);
            }
        }

        function isNotCurrentList(item) {
            return $ctrl.currentListId !== 'All' && $ctrl.listField && (item && item[$ctrl.listField] !== $ctrl.currentListId);
        }

        function onInitAdded(result) {
            console.log($ctrl.GroupEvents.Added);
            var item = result.item,
                resultInit = _.extend({}, result);
                isNotCurrentList = $ctrl.isNotCurrentList(item);
            //used for ex in strips/scheduling to add the tags/strips before
            if (!isNotCurrentList && typeof ($ctrl.onPreAdded) === 'function') {
                $ctrl.onPreAdded(result);
            }
            if (item) {
                $ctrl.addInitItems([item], isNotCurrentList);
            }

            if(!isNotCurrentList){
                onInitAddedMultiple(result);
            }

            $ctrl.processUpdates(result, true, true, false, false);

            if (typeof ($ctrl.onAdded) === 'function') {
                $ctrl.onAdded(result, resultInit);
            }

            if (!isNotCurrentList) {
                //for shot list in case of presentation mode
                if ($ctrl.selectItem) {
                    $ctrl.selectItem(item.order);
                }

                if(!$ctrl.noNotificationOnNew || $ctrl.noNotificationOnNew&&$ctrl.noNotificationOnNew(item)) {
                    $ctrl.getNotification(null, 'Create', true, $ctrl.getNotificationParams(item));
                }
                if(!$ctrl.isPrintLayout && !$ctrl.isCommentsSidebar) {
                    $ctrl.broadcastRoot('START_INTRO');
                }
            }

            updatecounter();
        }

        function getNotificationParams(item){
            return item && item.name ? {name: item.name} : null;
        }

        function updatecounter() {
            $ctrl.LCS.timeout(function () {
                $ctrl.broadcastRoot('COUNTER_CHANGED_' + $ctrl.elemType + '_TREE', {ids: [$ctrl.currentListId]});
            }, 100);
        }

        function onInitAddedMultiple(result) {
            if (result.processMultipleDelayed) {
                $ctrl.LCS.timeout(function () {
                    process();
                }, 300);
            } else {
                process();
            }

            function process() {
                if (result.processMultiple) {
                    console.log('onInitAddedMultiple');
                    var table = $ctrl.table ? $ctrl.table : $ctrl.service.collectionName;
                    var u = result && result.updatesG ? result.updatesG[table] : null,
                        t = u ? _.extend({}, u) : null;
                    if (t) {
                        delete result.updatesG[table];
                        if (t.add) {
                            result.added = t.add;
                        }
                        if (t.del) {
                            result.removed = t.del;
                        }
                    }
                }

                $ctrl.processElementsInit(result, result.table);

                updatecounter();
            }
        }

        function onInitUpdated(result) {
            if (!result) {
                return;
            }

            console.log('groupsimple ' + $ctrl.currentListId + ': '  + $ctrl.GroupEvents.Updated);
            if(!result.resultInit){
                result.resultInit = _.extend({}, result);
            }

            $ctrl.processUpdates(result, true, true, false, false);

            if($ctrl.withCustomSettings) {
                if ($ctrl.preloadSettings) {
                    $ctrl.preloadSettings();
                }
                $ctrl.broadcastRoot('PRELOADED_SETTINGS_CHANGED_' + $ctrl.elemType + '_GROUP', $ctrl.Settings);
            }

            var editchangesList = result.editchangesList;
            if(editchangesList){
                _.each(editchangesList, function (editchanges){
                    process({editchanges: editchanges});
                });
            }else{
                process(result);
            }

            if (typeof ($ctrl.onUpdated) === 'function') {
                $ctrl.onUpdated(result);
            }

            var item = result ? result.item : null;
            if (item && $ctrl.listTreeService && $ctrl.listTreeService.isRecursiveTree) {//update name in tree
                $ctrl.broadcastRoot('NAME_CHANGED_' + $ctrl.elemType + '_GROUP', item);
               // $ctrl.getNotification(null, 'NameChanged', true, item.name ? {name: item.name} : null);
            }

            function process(result) {
                var getUpdatedChanges = $ctrl.getUpdatedChanges ? $ctrl.getUpdatedChanges(result, $ctrl.Settings) : null,
                    editchanges = getUpdatedChanges ? getUpdatedChanges : result.editchanges;
                if (editchanges) {
                    $ctrl.replaceElementProps(editchanges._id, editchanges);
                }
            }
        }

        function onInitArchived(result) {
            console.log($ctrl.GroupEvents.Archived);
            if (typeof ($ctrl.onBeforeArchived) === 'function') {
                $ctrl.onBeforeArchived(result);
            }
            removed(result, 'ARCHIVED');
            if (typeof ($ctrl.onArchived) === 'function') {
                $ctrl.onArchived(result);
            }

            updatecounter();
        }

        function onInitRemoved(result) {
            console.log($ctrl.GroupEvents.Remove);
            if (typeof ($ctrl.onBeforeRemoved) === 'function') {
                $ctrl.onBeforeRemoved(result);
            }
            removed(result, 'REMOVED');
            if (typeof ($ctrl.onRemoved) === 'function') {
                $ctrl.onRemoved(result);
            }

            updatecounter();
        }

        function removed(result, type) {
            $ctrl.processUpdates(result);

            var id = result.item ? result.item : result;
            id = id._id ? id._id : null;
            $ctrl.unselectItemById(id);

            //remove in tree
            if ($ctrl.listTreeService) {
                $ctrl.broadcastRoot(type + '_' + $ctrl.elemType + '_TREE', result);
            }
        }

        //for recursive tree
        function onInitRemoveMirror(result) {
            console.log($ctrl.GroupEvents.RemoveMirror);
            var item = result ? result.item : null;
            if (item) {
                var found = $ctrl.list.removeElement(item);
                onInitRemoved(result);
            }
        }

        //for recursive tree
        function onInitArchiveMirror(result) {
            console.log($ctrl.GroupEvents.ArchiveMirror);
            var item = result ? result.item : null;
            if (item) {
                var found = $ctrl.list.removeElement(item);
                onInitArchived(result);
            }
        }

        function onInitMove(data) {
             console.log($ctrl.GroupEvents.Move + $ctrl.currentListId);
            var item = data.item,
                updates = data.updates,
                el = $ctrl.list.getElementById(item._id);
            if (el) {
                var u = {}, ids = [$ctrl.currentListId];
                updates = _.extend(updates ? updates : {}, getOrderChangeServerSideUpdates());
                if ($ctrl.listField) {
                    if (data.sourceListId !== $ctrl.currentListId) {
                        if($ctrl.listField){el[$ctrl.listField] = $ctrl.currentListId;}
                        var it = {_id: item._id};
                        if($ctrl.listField){
                            it[$ctrl.listField] = $ctrl.currentListId;
                        }
                        u.item = it;

                        ids.push(data.sourceListId);
                    }
                    u.listIds = {};
                    u.listIds[$ctrl.listField] = ids;
                }
                u.updates = updates;
                $ctrl.changeOrderServerSide(u, ids);
            }
        }

        function getOrderChangeServerSideUpdates() {
            console.log('getOrderChangeServerSideUpdates');
            var updates = {};
            for (var i = 0, n = $ctrl.list.items.length; i < n; i++) {
                var el = $ctrl.list.getElementByIndex(i);
                if (el && el._id && el.order !== i) {
                    updates[el._id] = i;
                }
            }
            return updates;
        }

        function setCounter() {
            console.log('GroupInit.setCounter');
            var res = $ctrl.getCount(),
                total = res.totalCount;
            _.each($ctrl.element.querySelectorAll('.' + $ctrl.totalCountCls), function (el) {
                el.innerHTML = total > 0 ? ($ctrl.LCS.hasClass(el, 'with-text') ? res.counterText : total) : '0';
            });

            $ctrl.setCounterOther(300);

            return res;
        }

        function getCount() {
            console.log('GroupInit.getCount');
            var c = 0,
                prop = $ctrl.withTreeDisplayCount ? 'displayCount' : 'count';
            list = $ctrl.list.items;
            if($ctrl.listTreeService && $ctrl.listTreeService.isRecursiveTree) {
                _.each(_.filter(list, {isFolder: true}), function (item) {
                    if (item[prop]) {
                        c += item[prop];
                    }
                });
                var lists = _.filter(list, {isFolder: false});
                c += lists.length;
            } else {
                c = list.length;
            }
            return $ctrl.getCountItem(c);
        }

        function getCountItem(c) {
            var last = $ctrl.itemTitle[$ctrl.itemTitle.length - 1];
            return {
                totalCount: c,
                counterText: c + ' ' + $ctrl.itemTitle + ((c === 1 || last === 's') ? '' : 's')
            }
        }


        function getMorePopoverTemplateInit(item, isMobile) {
            if(isMobile === undefined) {
                isMobile = $ctrl.isMobileView();
            }
            var template = (typeof($ctrl.getMorePopoverTemplate) === 'function' ? $ctrl.getMorePopoverTemplate(item, isMobile) : getMorePopoverTemplate(item, isMobile));
                return template ? template.replace('</ul>',
                    $ctrl.getSideMenuLi({
                        type: 'cancel',
                        action: 'Cancel',
                        liClass: 'hide-desktop',
                        icon: 'cancel',
                        withTopBorder: true
                    }) + '</ul>') : '';
        }

        function canShowShareInMore(item, isMobile){
            return false;// $ctrl.LCS.isDebugMode;
        }

        function canMove(){
            return $ctrl.keyboardService.canMove;
        }

        function canRemove(item){
            return true;
        }

        function canDownload(item){
           return item&&$ctrl.withDownload && !item.isFolder;
        }


        function getListShare(item, isMobile){
            //todo share folder
            if(!$ctrl.canShowShareInMore(item, isMobile)){return false;}
            if ($ctrl.listTreeService.hasTreeShare &&
                //share files if recursive
               ($ctrl.listTreeService.isRecursive && !item.isFolder ||
                   //share lists if non recursive and test mode
               !$ctrl.listTreeService.isRecursive && !item.isFolder)) {
                return $ctrl.getSideMenuLi({
                    type: 'share',
                    action: 'Share ' + $ctrl.itemTitle,
                    icon: 'link'
                });
            }
        }

        function getGroupName(){
            return $ctrl.nameForGroup;
        }
        function getGroupIcon() {
            return $ctrl.iconForGroup;
        }

        function getMorePopoverTemplate(item, isMobile) {
            var title = item.isFolder ? $ctrl.getGroupName(item) : $ctrl.itemTitle,
                template = '<ul class="dropdown-menu side-menu display-block ' + ($ctrl.elemType.toLowerCase() + 's-sidemenu') + '">',
                above = 0,
                hasPermission = $ctrl.hasUserPermissionToEdit(item),
                isActive = ($ctrl.withActiveGroup && item.active || !$ctrl.withActiveGroup);

                if(isActive) {
                    if ($ctrl.canShowShareInMore(item, isMobile)) {
                        //todo bring back share list
                        //todo share folder
                        if ($ctrl.listTreeService.hasTreeShare &&
                            //share files if recursive
                            ($ctrl.listTreeService.isRecursiveTree && !item.isFolder ||
                                //share lists if non recursive and test mode
                                !$ctrl.listTreeService.isRecursiveTree && !item.isFolder)) {
                            template += $ctrl.getSideMenuLi({
                                type: 'share',
                                action: 'Share ' + $ctrl.itemTitle,
                                icon: 'link'
                            });
                            above++;
                        }
                    }

                    if ($ctrl.canDownload(item)) {
                        template += $ctrl.getSideMenuLi({
                            type: 'getDownloadLink',
                            target: '_self',
                            action: 'Download ' + title,
                            icon: 'download',
                            iconLevel: 3
                        });
                        above++;
                    }
                }

            var isActiveTree = $ctrl.isActiveTree();
            if (isActiveTree && typeof ($ctrl.getMorePopoverTemplateOther) === 'function') {
                var el1 = $ctrl.getMorePopoverTemplateOther(item, isMobile);
                template += el1;
                if(el1){above++;}
            }

            if (!item.isPredef) {
                var active = ($ctrl.withActiveGroup && item.active || !$ctrl.withActiveGroup) && isActiveTree;
                if ((isMobile && $ctrl.withMobileGroupEdit || !isMobile) && !$ctrl.withoutGroupEdit && active && hasPermission) {
                    template += $ctrl.getSideMenuLi({
                        type: $ctrl.groupEditMethod ? $ctrl.groupEditMethod : 'edit',
                        action: ($ctrl.nameForEdit ? $ctrl.nameForEdit : 'Edit') + ' ' + title,
                        icon: 'pencil'
                    });
                    above++;
                }

                if ((active || $ctrl.filtersService.selectedFilter === 'All') && $ctrl.withAddUnder && hasPermission) {
                    template += $ctrl.getSideMenuLi({
                        type: 'create',
                        action: 'Add ' + title + ' Under',
                        icon: 'plus'
                    });
                    above++;
                }

                if (active && hasPermission && ($ctrl.canDuplicate(item))) {
                    template += $ctrl.getSideMenuLi({
                        type: 'duplicate',
                        action: 'Duplicate ' + title,
                        icon: 'copy',
                        aClass: 'a-duplicate'
                    });
                }

                var l = $ctrl.getFirstLevelNodesCount($ctrl.treeType);
                if (active && hasPermission && $ctrl.canMove(item) &&
                   (!item[$ctrl.listField]  && l > 1 || item[$ctrl.listField] && l > 2)) {
                    template += $ctrl.getSideMenuLi({
                        type: 'move',
                        action: $ctrl.getMoveName(title),
                        icon: $ctrl.getMoveIcon(),
                        iconLevel: 5
                    });
                }

                if (isActiveTree && $ctrl.withActiveGroup && $ctrl.hasArchivePermissions(item) || $ctrl.withArchiveInActiveGroup) {
                    if (item.active) {
                        template += $ctrl.getSideMenuLi({
                            type: 'archive',
                            action: ($ctrl.nameForArchived ? $ctrl.nameForArchived : 'Archive') + ' ' + title,
                            icon: 'box',
                            withTopBorder: above > 0,
                            aClass: 'accent'
                        });
                    } else {
                        template += $ctrl.getSideMenuLi({
                            type: 'activate',
                            action: 'Restore ' + title,
                            icon: 'restore',
                        });
                        above++;
                    }
                }

                if ($ctrl.hasRemovePermissions(item)) {
                    if (isActiveTree &&
                        ($ctrl.withActiveGroup && !item.active || !$ctrl.withActiveGroup || $ctrl.withDeleteInActiveGroup) &&
                        $ctrl.canRemove(item)
                    ) {
                        template += $ctrl.getSideMenuLi({
                            type: 'remove',
                            action: 'Remove ' + title,
                            withTopBorder: above > 0,
                            icon: 'trash',
                            aClass: 'accent'
                        });
                    }
                }
            }
//console.log(template);
            template += '</ul>';
            return template;
        }

        function hasRemovePermissions(item) {
            return item && ($ctrl.CPS.isOwnerOrAdmin || item.createdById === $ctrl.CPS.userId);
        }

        function hasArchivePermissions(item){
            return ($ctrl.mustBeAdminToEdit ? $ctrl.CPS.memberType >= $ctrl.security.MemberTypes.Admin : true) ||
                $ctrl.hasRemovePermissions(item);
        }

        function isActiveFilterItem(item) {
            return $ctrl.isActiveFilter() && ($ctrl.withActiveGroup && item.active || !$ctrl.withActiveGroup);
        }

        function isActiveGroup(){
            return $ctrl.withActiveGroup && $ctrl.filtersService.selectedFilter && $ctrl.currentListId !== 'Archived' ||
                !$ctrl.withActiveGroup;
        }

        function isActiveTree(){
            return !$ctrl.withActiveTree || $ctrl.withActiveTree && $ctrl.currentList.active ||
                $ctrl.listTreeService && $ctrl.listTreeService.isRecursiveTree;
        }

        function getGridItemDescriptions(listCols, item, canEdit, textOnly, isMobile, isMobileRowDetails, othercls) {
            var gridCls;
            var isStacked = othercls === 'stacked';

            switch (othercls){
                case 'linedesc':
                    gridCls = ' grid';
                    othercls = null;
                    break;

                case 'onelinedesc':
                    gridCls = ' grid oneline';
                    othercls = null;
                    break;

                case 'onelinedesc1':
                    gridCls = ' grid oneline field-description';
                    othercls = null;
                    break;
            }

            var el = '';
            _.each(listCols, function (c) {
                if (c.type !== $ctrl.SBFieldTypesService.PropTypes.Picture && !c.notInList) {
                    var dontShowLabel = othercls && othercls.indexOf('nolabel') !== -1, //dont show label unless in grid unless
                        v = c.type === $ctrl.SBFieldTypesService.PropTypes.Address && $ctrl.isProcessing ? $ctrl.getAddress(item, c) :
                            $ctrl.getDisplayItemCol(item, _.extend({}, c, {
                                    editableContainerClass: 'without-height-padding'
                                },
                                (c.prop !== 'shotNo' && c.prop !== 'customShotNo') &&
                                (c.type === $ctrl.SBFieldTypesService.PropTypes.Field || c.type === $ctrl.SBFieldTypesService.PropTypes.Html) && !isMobile ? {
                                    openPopup: true,
                                    eClassAttr: ''
                                } : null), null, canEdit, textOnly, isMobile, isMobileRowDetails); //colCls

                    if (!(!$ctrl.canEdit && v === '–' && !isMobileRowDetails)) {
                        var cls = 'fieldprop'
                            // + ((othercls || isStacked) ? '' : ' inline-flex')
                            ,
                            l = dontShowLabel ? '' : ('<div class="labelTextField ' + cls + '">' +
                                (othercls ? c.name.replace(' Time', '') : c.name) + (isStacked ? '' : ':') + '</div> '),
                            d = '<div class="' + cls + (c.name === 'name' ? ' semibold' : '') + '">' + v + '</div>';
                        el += '<div class="shortfield ' + (othercls ? othercls : (gridCls ? '' : 'full-width display-flex clearfix')) + '">' +
                            (isStacked ? (d + l) : (l + d)) +
                            '</div>';
                    }
                }
            });
            return el ? (othercls ? el : ('<div class="full-width' + (gridCls || '') + '">' + el + '</div>')) : '';
        }

        function processGridViewItem(item){
            var listCols = $ctrl.filtersService.listCols,
                canEdit = $ctrl.canEdit && $ctrl.canEditItem(item),
                isMobile = $ctrl.isMobileView();
            $ctrl.imageProp = _.find($ctrl.filtersService.listCols, function(el){return el.type === $ctrl.SBFieldTypesService.PropTypes.Picture;});
            var d = $ctrl.getGridItemDescriptions(listCols, item, canEdit);
        return '<div class="img-col no-drag ' + ($ctrl.getImageClsOther ? $ctrl.getImageClsOther(item) : '') + '">' +
                    '<div class="stretchy-wrapper imageRatio-0">' +
                        '<div class="imgcont">' +
                            $ctrl.getImageTemplate(item, $ctrl.imageProp) +  //2 watchers
                        '</div>' +
                    '</div>' +
                '</div>' +
                '<div>' +
                    '<div class="table-div fixed-layout full-width height10P">' +
                        ($ctrl.isPrintLayout ? '' : ('<div class="side-col">' + $ctrl.getSortHandle(false)+'</div>')) +
                        '<div class="grow-column center-cont-text">' +
                           (($ctrl.isPrintLayout || !$ctrl.getGridViewItemContent)?
                               (!d && !canEdit ? '' : ('<div class="descriptions full-width">' + d+ '</div>')) :
                               $ctrl.getGridViewItemContent(listCols, item)
                           ) +
                        '</div>'+
                        ($ctrl.isPrintLayout ? '' : ('<div class="side-col">' +
                            $ctrl.getCustomCheckbox(true) +
                            $ctrl.getMoreBtnTemplate(false, item, isMobile)  +
                        '</div>'))+
                    '</div>'+
                '</div>';
        }

        function getMobileTitleAndSubtitle(item, c, c1Txt, cls, canEdit, textOnly, isMobile, isMobileRowDetails) {
            return c1Txt ? ('<div ' + (cls ? ('class="without-height-padding ' + cls + '  "') : '') + '>' +
                get('name' + ($ctrl.hasBigNameInList ? '' : ' smaller')) +
                //_.extend({}, c, {hideEmptyContent: true})
                '<div class="full-width subname ' +
                (c.subtitleColProp ? $ctrl.getViewEditElemSelector(c.subtitleColProp) : '') + '">' + c1Txt + '</div>' +
                '</div>') : get(cls);


            function get(cls) {
                return c ? $ctrl.getDisplayItemCol(item, c, cls, canEdit, textOnly, isMobile, isMobileRowDetails) : '';
            }
        }

        function hasMobileDetails(item) {
            return $ctrl.isMobileView() && $ctrl.expandMobileRow;
        }

        function share(item, param, e) {
            console.log('share');
            if (!item) {return;}
            $ctrl.RouteCollaboratorsService.share(item._id, {
                    type: item.isFolder ? $ctrl.getGroupName() : $ctrl.nameForList,
                    name: item.name,
                    isItemShare: !item.isFolder
                }, $ctrl.compOptions,
                $ctrl.listTreeService && $ctrl.listTreeService.isRecursiveTree ? item : null,
                e
            );
        }

        function getEmptyStateLogo(icon, iconLevel) {
            var path = 'emptystate/' + $ctrl.overviewBlockType + '/emptystate-group';
            return $ctrl.withVideoForEmptyGroup ?
                ('<video class="video-anime" muted playsinline autoplay="autoplay" loop="loop" poster="' + $ctrl.LCS.getImgUrl(path + '.jpg') + '">' +
                    '<source src="' + $ctrl.LCS.getVideoUrl(path + '.mp4') + '" type="video/mp4">' +
                    '</video>')
                : ('<div class="centered circled-svg-colored small150 ' +
                    ($ctrl.pageClass ? $ctrl.pageClass : '') +
                    '">' + $ctrl.LCS.getISBDiv(icon ? icon : ($ctrl.emptyIcon ? $ctrl.emptyIcon : $ctrl.itemIcon), (iconLevel ? iconLevel : ($ctrl.emptyIconLevel ? $ctrl.emptyIconLevel : $ctrl.iconLevel))) +
                    '</div>');
        }

        function getSearchEmpty(){
        return '<div class="' + $ctrl.emptySearchGroup + ' h-full full-width spacing-half with-body-padding table-div">' +
                    '<div class="no-product with-white-bg centered text-center">' +
                        $ctrl.getEmptyStateLogo('search') +
                        '<h3 class="text-center">No ' + $ctrl.itemTitle.toLowerCase() + 's match '+$ctrl.getSearchValueTxt()+'.</h3>' +
                    '</div>' +
                '</div>';
        }

        function hasSearchOrFilters(){
            return $ctrl.search || $ctrl.searchFilters;
        }

        function getSearchValueTxt() {
            return $ctrl.searchFilters ? (' the selected filters') : ($ctrl.search ? ('“' + $ctrl.search + '”') : 'that search');
        }

        function setEditableField(data) {
            //console.log('setEditableField');
            closeField($ctrl.editableField, 'set');
            $ctrl.editableField = data;
            //console.log('current editableField = ' + $ctrl.editableField.id + ', ' + $ctrl.editableField.prop);
        }

        function closeEditableField(data) {
            //console.log('closeEditableField');
            if (data && $ctrl.editableField &&
                data.id === $ctrl.editableField.id &&
                data.prop === $ctrl.editableField.prop) {
                $ctrl.editableField = null;
            }
        }

        function closeField(field, type){
            if(field) {
                //console.log('closing editableField = '+field.id+', ' + field.prop);
                $ctrl.broadcastRoot('CLOSE_ROW_EDITABLE_FIELD_' + field.id, field.prop);
            }
        }

        function getBtnUpload(showTitle, cls, cond, isA) {
            return "<upload-files-btn " + (cond ? ('ng-if="' + cond + '"') : '') +
                (isA ? ('is-a="true"') : '') +
                "btn-class='" + ((cls ? cls : '') + ' btn ' + $ctrl.pageClass) + "' " +
                "icon-class='upload' " +
                "icon-level='3' " +
                'btn-text="::$ctrl.btnUploadText" ' +
                (showTitle ? 'show-title="true" ' : '') +
                "images-only='::true' " +
                "multiple-files='::true' " +
                ($ctrl.codeName ? ('code-name="' + $ctrl.codeName + '" ') : '') +
                (typeof ($ctrl.onFileUploaded) === 'function' ? "on-file-uploaded='$ctrl.onFileUploaded(result)'" : '') +
                (typeof ($ctrl.onBeforeFilesUploaded) === 'function' ? "on-before-files-uploaded='$ctrl.onBeforeFilesUploaded(result)'" : '') +
                "></upload-files-btn>";
        }

        function getFileUploadedParams(result) {
            console.log('getFileUploadedParams');
            var params = {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                logoId: result.item.versionId._id//todo: logo should be set as imgProp
            }
            var order = result.item.order;
            if (order) {
                params.order = order;
            }
            params[$ctrl.listField] = $ctrl.currentListId;

            return params;
        }

        function onFileUploaded(result) {
            console.log('GroupSimpleInitCtrlService.onFileUploaded');
            var p = $ctrl.getFileUploadedParams(result),
                id = result.bindToItemId; //shotId

            //material
            var version = result.item.versionId,
                prop = 'logo',
                logo = version.path,
                logoId = version._id;

            if (id) {
                p = {
                    _id: id,
                    companyId: p.companyId,
                    productId: p.productId
                };

                p[prop] = logo;
                p[prop + 'Id'] = logoId;

                if (result.activityId) {//upload many files to shots
                    p.activityId = result.activityId;
                    if (result.activityType) {
                        p.activityType = result.activityType;
                    }
                   // p.updateActivityWithItems = true;
                }
                if (result.dontShowActivity) {
                    p.dontShowActivity = true;
                }
            } else{ //create a shot and set the logo image
                p[prop] = logo;
                p.withFileUpload = true;
                p.uploadOneFile = true;
            }


            $ctrl.service[id ? 'update' : 'insert'](p, onSuccess, onError);

            function onSuccess(result1) {
                $ctrl.isUpdating = false;
                result1.item.logo = logo;
                $ctrl.broadcastRoot((id ? 'UPDATED' : 'ADDED') + '_' + $ctrl.elemType + '_ITEM', result1);
            }

            function onError(error) {
                $ctrl.isUpdating = false;
                if (error) {
                    if (error.name === 'LimitExceededError'  ) {
                        $ctrl.CPS.loadQuotaPopup($ctrl.quotaType, function (){
                            $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.' + $ctrl.objectType + '.validationForPlan.error', 'error');
                        }, $ctrl.maxFreeItemsCount, error.count, $ctrl.compOptions);

                    } else if (error.name !== 'ValidationError') {
                        $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.' + $ctrl.objectType + '.update.error', 'error');
                    }
                }
            }
        }

        function uploadItems(e) {
            //console.log('uploadItems');
            $ctrl.preventDefault(e);
            process();
            // $ctrl.CPS.loadQuotaPopup($ctrl.quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});
            function process() {
                var params = {
                    service: $ctrl.service,
                    uploadBtnText: $ctrl.getBtnUpload(),
                    onFileUploaded: $ctrl.onFileUploaded,
                    startOrder: $ctrl.getStartOrder(),
                    addEmptyShots: $ctrl.addEmptyShots,
                    quotaType: $ctrl.quotaType
                };

                if (typeof ($ctrl.onBeforeFilesUploaded) === 'function') {
                    params.onBeforeFilesUploaded = $ctrl.onBeforeFilesUploaded;
                }
                $ctrl.popupsService.open($ctrl.currentList, $ctrl.popupsService.operations.shotUploads, params, $ctrl.compOptions);
                $ctrl.toggleUpload = false;
            }
        }

        function canEditImage(item){
            return $ctrl.canEditItem(item) && !$ctrl.isMobileView() && (typeof ($ctrl.canEditImage) !== 'function' ||
              typeof ($ctrl.canEditImage) === 'function' && $ctrl.canEditImage(item, $ctrl.isGridView === true));
        }



        function onImageLoaded(result) {
            //console.log('GroupSimpleInitCtrlService.onImageLoaded');
            if (!result || !result._id) {
                return;
            }

            layoutMasonaryItems([result._id], true);
        }

        function layoutMasonaryItems(itemIds, isAdd) {
            if($ctrl.isMasonary && $ctrl.keyboardService.sortableService){
              //  $ctrl.keyboardService.sortableService.fitItems(itemIds);
                $ctrl.keyboardService.sortableService.layoutItems(itemIds, isAdd);
            }
        }

        function reloadMasonaryLayout(result, startOnTop, delay){
            if($ctrl.isMasonary){
                $ctrl.LCS.timeout(function () {
                    if($ctrl.keyboardService.sortableService) {
                        $ctrl.keyboardService.sortableService.layout(result, startOnTop);
                    }
                }, delay !== undefined ? delay : 500);
            }
        }

        function onListElementsUpdated(id, isAdd, delay) {
            $ctrl.LCS.timeout(function (){
                 layoutMasonaryItems([id], isAdd);
            }, delay ? delay : 500);
        }

        function updateRatio(result){

        }
    }
}

function itemGridComponentParams(bindings, controllerName, template) {
    return itemSimpleGroupGridComponentParams(_.extend({

        /*  elemType:'@',
          itemTitle: '@',
          block: '@',
      */
    }, bindings || {}), controllerName || 'GridItemGroupInitCtrl', template, 'with-white-bg');
}

function treeGroupComponentParams(controllerName, bindings) {
    return groupSimpleComponentParams(controllerName, _.extend({
        listTreeService: '<',
        keyboardService: '<',

        treeType: '<',

        //variables
        currentList: '<',
        selectedItems: '<',

        getParams: '&',
        createFromTop:'&',
        onGetListItemIcon: '&'
    }, bindings || {}));
}

angular.module('group.controller.service', [
    'groupSimple.controller.service',
    'item.grid.group.controller'
])

.service('TreeGroupInitCtrlService', TreeGroupInitCtrlService);
TreeGroupInitCtrlService.$inject = ['GroupSimpleInitCtrlService'];
function TreeGroupInitCtrlService(GroupSimpleInitCtrlService) {
    return function ($ctrl, $element, Pagination, withoutPopover) {
        $ctrl.currentListId = $ctrl.currentList ? $ctrl.currentList[getSelectedIdField()] : null;

        $ctrl.initWrapperCls = 'group-init-wrapper';
        $ctrl.onReloadGroupTemplate = onReloadGroupTemplate;

        $ctrl.withNoOrderChange = true;
        if($ctrl.hasHeader === undefined){$ctrl.hasHeader = true;}

        if(!$ctrl.createMethodName) {
            $ctrl.createMethodName = 'createNonNg';
        }

        $ctrl.showSelectAll = showSelectAll;
        if(!$ctrl.withSelectAll) {
            $ctrl.withSelectAll = withSelectAll;
        }
        $ctrl.getTreePopupParams = getTreePopupParams;
        if(!$ctrl.afterProcessUpdates) {
            $ctrl.afterProcessUpdates = afterProcessUpdates;
        }else{
            $ctrl.afterProcessUpdatesInit = afterProcessUpdates;
        }
        if(!$ctrl.onAllLoaded) {
            $ctrl.onAllLoaded = onAllLoaded;
        }

        $ctrl.insertElementAfter = true;

        if($ctrl.listTreeService){
            $ctrl.insertElementAfter = $ctrl.listTreeService.insertElementAfter;
            if($ctrl.keyboardService) {
                $ctrl.keyboardService.parentLoadingService = $ctrl.listTreeService.parentLoadingService;
                $ctrl.keyboardService.childLoadingService = $ctrl.listTreeService.childLoadingService;
            }

            $ctrl.filtersService = $ctrl.listTreeService.filtersService;

            if (!$ctrl.filtersService && !$ctrl.withoutFilterService) {
                console.warn('define $ctrl.filtersService in parent for TreeGroupInitCtrlService');
            }
        }

        if(typeof($ctrl.createNewGroup) !== 'function') {
            $ctrl.createNewGroup = createNewGroup;
        }

        if (!$ctrl.displayLowFilters) {
            $ctrl.displayLowFilters = displayLowFilters;
        }

        if (!$ctrl.getGroupTemplate) {
            $ctrl.getGroupTemplate = getGroupTemplate;
        }

        if(!$ctrl.getGroupEmpty){
            $ctrl.getGroupEmpty = getGroupEmpty;
        }

        if(!$ctrl.getGroupEmptyButtons){
            $ctrl.getGroupEmptyButtons = getGroupEmptyButtons;
        }

        $ctrl.getGroupEmptyButtonsInit = getGroupEmptyButtons;

        if(!$ctrl.getGroupEmptyText){
            $ctrl.getGroupEmptyText = getGroupEmptyText;
        }

        $ctrl.getGroupTreeHeader = getGroupTreeHeader;

        if(!$ctrl.getGridHeader) {
            $ctrl.getGridHeader = getGridHeader;
        }

        if(!$ctrl.hasElements) {
            $ctrl.hasElements = hasElements;
        }

        $ctrl.getGridItemWidthCls = getGridItemWidthCls;

        if(!$ctrl.getInitList) {
            $ctrl.getInitList = getInitList;
        }

        if(!$ctrl.getNewPopupParams){
            $ctrl.getNewPopupParams = getNewPopupParams;
        }

        if(!$ctrl.showBottomButtons) {
            $ctrl.showBottomButtons = showBottomButtons;
        }

        $ctrl.showBottomButtonsInit = showBottomButtons;

        if(!$ctrl.getListItemIcon) {
            $ctrl.getListItemIcon = getListItemIcon;
        }

        if(!$ctrl.hasTwoSidebars) {
            $ctrl.hasTwoSidebars = hasTwoSidebars;
        }
        if(!$ctrl.isSidebarLeft) {
            $ctrl.isSidebarLeft = isSidebarLeft;
        }

        if(!$ctrl.loadInsideBar) {
            $ctrl.loadInsideBar = loadInsideBar;
        }

        if(!$ctrl.getGroupEmptyHeader) {
            $ctrl.getGroupEmptyHeader = getGroupEmptyHeader;
        }

        if(!$ctrl.getCompiledGroupContentTemplate) {
            $ctrl.getCompiledGroupContentTemplate = getCompiledGroupContentTemplate;
        }

        if(!$ctrl.addNewOnEmptyGroup) {
            $ctrl.addNewOnEmptyGroup = addNewOnEmptyGroup;
        }

        if(!$ctrl.toggleInnerSidebar){
            $ctrl.toggleInnerSidebar = toggleInnerSidebar;
        }

        if(!$ctrl.showDescBlock){
            $ctrl.showDescBlock = showDescBlock;
        }
        $ctrl.getPrintGroupHeader = getPrintGroupHeader;

        $ctrl.getArchivedClass = getArchivedClass;

        if(!$ctrl.getSidebarTwoInit) {
            $ctrl.getSidebarTwoInit = getSidebarTwoInit;
        }

        if(!$ctrl.showProForCol) {
            $ctrl.showProForCol = showProForCol;
        }

        $ctrl.getInitGroupButtons = getInitGroupButtons;
        $ctrl.openProForCol = openProForCol;
        if(!$ctrl.showSelectAllText) {
            $ctrl.showSelectAllText = showSelectAllText;
        }
        $ctrl = new GroupSimpleInitCtrlService($ctrl, $element, Pagination, withoutPopover);

        console.log(getSBTimestamp()+' TreeGroupInitCtrlService' + $ctrl.elemType);

        if ($ctrl.hasTree || $ctrl.canSetList){
            if(!$ctrl.listTreeService) {
                console.warn('define $ctrl.listTreeService in parent for InitGroupCtrl ' + $ctrl.elemType);
            }

            $ctrl.addRootWatcher('TREE_SERVICE_SET_LIST_' + $ctrl.elemType + '_' + $ctrl.currentListId, function (els){
                $ctrl.onInitListChanged(els);
            });

            if ($ctrl.canEdit) {
                $ctrl.addRootWatcher('NAME_CHANGED_' + $ctrl.elemType + '_TREE', onListNameChanged);
            }
        }

        return $ctrl;

        function getSidebarTwoInit() {
            return '<div class="clearfix hide-print h-full side-nav long scriptsize position-relative full-width">' +
                $ctrl.getSidebarTwo() + getToggle() +
                '</div>';


            function getToggle() {
                return '<div class="sidebar-toggle no-padding">' +
                    '<a class="btn btn-small transparent noborder smaller inline-block" ng-click="$ctrl.toggleInnerSidebar($event)">' + $ctrl.LCS.getISBDiv('angle-double-left', 2, 'centered gray') + '</a>' +
                    //todo bring back expand Script
                    /*'<a class="btn btn-small transparent noborder smaller inline-block with-margin-left one-line-tooltip" ng-click="$ctrl.openScene(null, \'PREVIEW\')"' +
                       'tooltip-placement="bottom" tooltip="Expand Script">' +
                       $ctrl.LCS.getISBDiv('resize-expand', 2, 'centered gray') +
                   '</a>' +*/
                    '</div>';
            }
        }

        function getArchivedClass() {
            return $ctrl.listTreeService && $ctrl.listTreeService.withActiveTree && $ctrl.currentList && $ctrl.currentList.active === false ? ' archived-group' : ''
        }

        function getListItemIcon(item) {
            return $ctrl.onGetListItemIcon({item: item});
        }

        function getNewPopupParams(item) {
            return _.extend({
                treeType: $ctrl.treeType,
                parent: $ctrl.currentList,
            }, $ctrl.getNewPopupParamsInit(item));
        }

        function getInitList() {
            var list = $ctrl.listTreeService ? (typeof ($ctrl.listTreeService.getList) === 'function' ? $ctrl.listTreeService.getList($ctrl.currentListId) : null) : $ctrl.getInitListGroupSimple();

            if (list && $ctrl.commentGroup) {
                list = _.filter(list, {uIdComment: $ctrl.commentGroup._id});
            }

            if(list){
                list = $ctrl.getSortedList(list);
            }

            if (!list || !list.length || !$ctrl.selectedItems) {
                return list;
            }

            return list;
        }

        function hasElements() {
            return ($ctrl.listTreeService ? $ctrl.listTreeService.isNotEmptyGroupState($ctrl.currentList) : false) ||
                $ctrl.list.totalCount > 0;
        }

        function getGroupTemplatePrint(){
            return '<div class="group-template clearfix display-block tab-content no-side-padding full-width">' + $ctrl.getCompiledGroupContentTemplateInit() + '</div>';
        }

        function loadInnerSidebar(){
            var prev = $ctrl.LCS.PersistenceService.get(getInnerSidebarProp());
            $ctrl.showInsideBar = prev !== undefined ? prev : false;
        }

        function toggleInnerSidebar(e) {
            $ctrl.preventDefault(e);
            $ctrl.showInsideBar = $ctrl.showInsideBar ? false : true;
            $ctrl.LCS.PersistenceService.set(getInnerSidebarProp(), $ctrl.showInsideBar);
        }

        function getInnerSidebarProp(){
            return 'showInsideBar_' +$ctrl.elemType;
        }

        function getGroupTemplate(){
            //console.log('TreeGroupInitCtrlService.getGroupTemplate');
            if($ctrl.isPrintLayout){//dont load later
                return getGroupTemplatePrint();
            }

            if(!($ctrl.hasTwoSidebars && $ctrl.hasTwoSidebars())){
                return getGroupTreeTemplate();
            }
            var withSidebarLeft = $ctrl.isSidebarLeft();

            loadInnerSidebar();

            return '<div class="sbresizer_wrapper h-full">' +
                        (withSidebarLeft ? getSidebarLeft(true) : '') + //sidebarLeft
                        '<div class="sbresizer_wrapper_'+(withSidebarLeft ? 'right' : 'left')+' sbresizer_wrapper_main">' +
                            //getSidebarLeft(false) + //sidebarTop
                             '<div class="sbresizer_wrapper_bottom"><div class="full-width h-full">' +
                                 getGroupTreeTemplate() + //group
                             '</div></div>' +
                        '</div>' +
                        (withSidebarLeft ? '' : getSidebarLeft(false)) + //sidebarRight
                    '</div>';

            function getSidebarLeft(isLeft) {
                var val = '$ctrl.loadInsideBar(' + (isLeft === true) + ')',
                    show = 'ng-show="' + val + '"';
                return (isLeft ? '' : getResizer( ))  +
                    '<div ' + show + ' class="hide-print sbresizer_wrapper_' + (isLeft ? 'left' : 'right') + '"><div ng-if="' + val + '" class="full-width h-full position-relative">' +
                        ($ctrl.getSidebarTwo ? $ctrl.getSidebarTwoInit() : '') +
                    '</div></div>' +
                    (isLeft ? getResizer( ) : '');
                function getResizer( ){
                    return  '<div ' + show + ' class="sbresizer" data-direction="horizontal' +
                        //(isLeft ? 'horizontal' : 'vertical') +
                        '"></div>';
                }
            }

            function getGroupTreeTemplate(){
                //console.log('TreeGroupInitCtrlService.getGroupTreeTemplate');
                var withcontentwrapper = true;
    return '<div class="' + ($ctrl.initWrapperCls || '') + ' full-content h-full show-scrollbar-on-hover ' +
                ($ctrl.withoutGroupSidePadding ?' without-side-padding ' : '') +
                $ctrl.getInitWrapperCls($ctrl.hasElements()) +
            '">' +
                '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper">' +
                    '<div>' +
                        '<div class="clearfix display-block tab-content with-padding with-radius with-side-margin padding-bottom-80 sb-scrolling-monitor with-no-bg ' +
                            // ($ctrl.isGridView ? ' with-no-bg' : ' with-white-bg') +
                            ($ctrl.noSideMarginMobile ? ' no-side-margin-xs' : '') + ' ' +
                            (withcontentwrapper ? 'withcontentwrapper' : '') + '" sb-scrolling-monitor-id="group" ' +
                            ($ctrl.getTabContentAttributes ? $ctrl.getTabContentAttributes() : '') +
                        '>' +
                            getContent(withcontentwrapper) +
                            //(typeof($ctrl.otherGroupInfo) === 'function' ? $ctrl.otherGroupInfo() : '') + //used on contacts
                        '</div>' +
                        getEmptyWrapper() +
                    '</div>' +
                '</div>' +
            '</div>';
            }

            function getEmptyWrapper(){
                return '<div class="empty-group-wrapper with-white-bg table-div h-full spacing-half with-body-padding"' +
                    //' ng-show=\'!$ctrl.list.busy&& !$ctrl.hasElements()&&$ctrl.bindItems===1\'' +
                    '><div class="centered text-center">' + $ctrl.getGroupEmpty() + '</div></div>';
            }

            function getContent(withcontentwrapper){
                var c = getLowerFilters($ctrl.hideSidebar, ($ctrl.hideCounter|| $ctrl.hideGroupCounter), false) +
                    (typeof($ctrl.getLowerFiltersDesktop) === 'function' ? $ctrl.getLowerFiltersDesktop() : '') +
                        getBannerInit() +
                        '<div class="group-content' + ($ctrl.withTextBlock ? ' with-text-block' : '') + '">' + $ctrl.getInnerContent() +'</div>';
                return (withcontentwrapper ? ('<div class="contentwrapper">' + c +  '</div>') : c);
            }

            function getBannerInit() {
                $ctrl.CPS.withBanner = $ctrl.CPS.setPageBanner($ctrl.CPS.withBanner,
                    $ctrl.showBannerProp, $ctrl.bannerFeatureProp);
                if (!$ctrl.CPS.withBanner || typeof ($ctrl.getBanner) !== 'function') {
                    return '';
                }
                var banner = typeof($ctrl.getBanner) === 'function' ?  $ctrl.getBanner() : null;
                return banner ? ('<div class="spacing-half-top hide-print margin-top-0">' + banner + '</div>') : '';
            }
        }

        function getInitGroupButtons() {
            return ($ctrl.canEdit && typeof ($ctrl.getGroupButtons) === 'function') ?
                ('<div ng-show="$ctrl.showBottomButtons() && $ctrl.allLoaded" class="hide-ipad form-group field last spacing-half-top hide-print full-width">' + $ctrl.getGroupButtons() + '</div>') : '';
        }

        function getCompiledGroupContentTemplate(){
            //console.log('TreeGroupInitCtrlService.getCompiledGroupContentTemplate');
            var items = $ctrl.getGroupItemsInit() +
                (!$ctrl.isPrintLayout && typeof($ctrl.getGroupItemsOthers) === 'function' ? $ctrl.getGroupItemsOthers() : '');
            return $ctrl.isPrintLayout ? $ctrl.getInnerContent(items) : items;
        }

        function loadInsideBar(isLeft) {
            var isSidebarLeft = $ctrl.isSidebarLeft();
            return $ctrl.showInsideBar && (isLeft ? isSidebarLeft : !isSidebarLeft);
        }

        function isSidebarLeft(){
            return true;
        }

        function hasTwoSidebars(){
            return false;
        }

        function displayLowFilters(){
            return $ctrl.displaySidebar();
        }

        function getGroupEmptyHeader() {
            var tag = 'h3',
            t = $ctrl.itemTitle.toLowerCase();
            return '<' + tag + ' ng-if="$ctrl.isActiveGroup()" class="text-center">' +
                'No ' + t + 's in “<span class="sb-prop-list-name">' + $ctrl.currentList.name + '</span>” ' +
                //($ctrl.currentList.isFolder ? $ctrl.getGroupName() : $ctrl.nameForList).toLowerCase()+
                '</' + tag + '>' +
                '<' + tag + ' ng-if="!$ctrl.isActiveGroup()" class="text-center"> No ' + t + 's have been ' +
                ($ctrl.nameForArchived ? ($ctrl.nameForArchived === 'Omit' ? 'omitted' : ($ctrl.nameForArchived + 'd').toLowerCase()) : 'archived') +
                '</' + tag + '>';
        }

        function getLowerFilters(hideSidebar, hideCounter, isEmpty) {
            if (hideSidebar && hideCounter) {
                return '';
            }

            return '<div class="lower-filters' + (hideSidebar ? '' : (' with-list-header' +
                    ($ctrl.loweFilterClass ? (' ' + $ctrl.loweFilterClass) : '') +
                    ($ctrl.centerListTitle ? ' center-list-title' : ''))) +
                (isEmpty || !isEmpty && !$ctrl.showLowerFiltersOnDesktop ? ' hide-desktop hide-print' : '') + '" ' +
                //'ng-show="$ctrl.displaySidebar()"' +
                '>' + getTable() + '</div>';

            function getTable() {
                if (!$ctrl.showGroupPoster || $ctrl.currentListId === 'All' || $ctrl.currentListId === 'Archived' ||
                    !$ctrl.canEdit && !$ctrl.currentList.logo) {
                    return getContent();
                }
                return '<div class="table-div"><div class="col200' + ($ctrl.canEdit && !$ctrl.currentList.logo ? ' sb-hide' : '') + '">' + getImg() + '</div><div>' + getContent() + '</div></div>';
            }

            function getImg() {
                return '';
            }

            function getContent() {
                return (hideSidebar ? '' : ('<div class="listname table-div">' +
                                $ctrl.getListItemIcon($ctrl.currentList, 'with-margin-right') +
                                '<div class="title ' + (hideCounter ? 'centered' : '') + ' sb-prop-list-name" >' + $ctrl.currentList.name + '</div> ') +
                            '</div>'
                    ) +
                    $ctrl.getCounterBlock(hideCounter, 'subtitle ') +
                    ($ctrl.showDescBlock() && typeof ($ctrl.getDescBlock) === 'function' ? $ctrl.getDescBlock() : '');
            }
        }

        function showDescBlock(){
            return true; //$ctrl.CPS.isCollaborator;
        }

        function getGroupEmpty() {
        return '<div class="no-product with-white-bg centered text-center">' +
                    $ctrl.getEmptyStateLogo($ctrl.currentList.icon, $ctrl.currentList.iconLevel) +
                    getLowerFilters(false, true, true) +
                    '<div class="centering text-center" ng-show="!$ctrl.hasSearchOrFilters()">' +
                        $ctrl.getGroupEmptyHeader() +
                        (isPredefList() ?  '<div><p class="text-center">This folder will be autofilled by the application.</p></div>' :
    (($ctrl.canEdit ? ('<div ng-if="$ctrl.addNewOnEmptyGroup()">' +
                            '<p class="empty-subtitle text-center">'+$ctrl.getGroupEmptyText()+'</p>' +
                            '<div class="spacing-half-top text-center">' + $ctrl.getGroupEmptyButtons()+ '</div>' +
                        '</div>') :''))) +
                        '<h3 ng-if="$ctrl.hasSearchOrFilters()" class="text-center">No '+$ctrl.itemTitle.toLowerCase()+'s match '+$ctrl.getSearchValueTxt()+'.</h3>' +
                    '</div>' +
                '</div>';
        }

        function addNewOnEmptyGroup(){
            return $ctrl.isActiveFilter();
        }

        function getGroupEmptyText() {
            return 'Create a new ' + $ctrl.itemTitle.toLowerCase() + ' below.';
        }

        function getGroupEmptyButtons(text, params) {
            if (!text) {
                text = $ctrl.addNewItemText ? $ctrl.addNewItemText : ('New ' + $ctrl.itemTitle);
            }
            var group = $ctrl.getGroupName($ctrl.currentList, true),
                icon = $ctrl.getGroupIcon($ctrl.currentList, true),
                methodGroup = 'createNewGroup',
                withNgClick = true;
            return '<button class="btn btn-primary page-class ' + ($ctrl.withDocumentInline ? 'smallbtn' : '') + ' ' +
                (withNgClick ? '' : ( ' ' + $ctrl.getBtnActionCls())) +
                ($ctrl.pageClass ? $ctrl.pageClass : '') + '" ' +
                (withNgClick ? ('ng-click="$ctrl.' + $ctrl.createMethodName + '(' +
                    ($ctrl.createMethodName === 'createNonNg' ? ((params || 'null') + ', $event') : ((params || 'null') + ', null')) +
                (($ctrl.createMethodName === 'create' || $ctrl.createMethodName === 'createNonNg') ? '' : ', $event') + ')" ') : '') +
                    'data-type="' + $ctrl.createMethodName + '" analytics-on analytics-action="' + text + '">' +
                $ctrl.LCS.getISBDiv($ctrl.addNewItemIcon ? $ctrl.addNewItemIcon : 'plus-circled', $ctrl.addNewItemIconLevel ? $ctrl.addNewItemIconLevel : 2, 'pull-left') +
                '<div class="with-padding-left">' + text + '</div></button>' +
                (($ctrl.listTreeService && $ctrl.listTreeService.isRecursiveTree && !isPredefList() && $ctrl.currentList.isFolder && $ctrl.currentList.l < $ctrl.listTreeService.maxLevel && !$ctrl.hideAddList) ?
                    ('<button class="btn btn-small transparent big with-margin-left' +
                        (withNgClick ? '' : ( ' ' + $ctrl.getBtnActionCls())) +
                        '" ' +
                        (withNgClick ? ('ng-click="$ctrl.' + methodGroup + '(info, $event)" ') : '') +
                    'data-type="' + methodGroup + '" analytics-on analytics-action="Create ' + group + '">' +
                        $ctrl.LCS.getISBDiv(icon, 2, 'pull-left') + ' <div>New ' + group + '</div></button>') : '');
        }

        function isPredefList() {
            return !$ctrl.addItemInPredef && $ctrl.currentList.isPredef && !isAllFolder();
        }

        function isAllFolder(){
            return $ctrl.currentList.isPredef && $ctrl.currentListId === null && $ctrl.currentList.isFolder;
        }

        function createNewGroup(info, e) {
            $ctrl.broadcastRoot('ADD_FROM_EMPTY_STATE_' + $ctrl.elemType + '_TREE', {
                treeType: $ctrl.treeType,
                data: {
                    item: $ctrl.currentList,
                    addFolder: true,
                    isParent: true,
                    useSelected: false,
                    e: e
                }
            });
        }

        function getGridHeader(cls, otherCond) {
            //var isMobile = false;

    return getP()+
           ($ctrl.hasHeader ? get(null, $ctrl.getGroupTreeHeader(), '') : '');

            function get(id, c, cls2) {
                return (typeof($ctrl.getTopOfHeader) === 'function' ? $ctrl.getTopOfHeader() : '') +
                    '<div' + (id ? (' id="' + id + '"') : '') + ' class="row-header list list-header ' + (cls || '') +
                    ($ctrl.getArchivedClass ? $ctrl.getArchivedClass() : '') +
                    '" ' + (otherCond || '') + '>' + //cause crew is off on one side
                        '<div class="row-schedule full-width header ' + (cls2 || '') + '">' + c + '</div>'  +
                    '</div>';
            }

            function getP(){
                return $ctrl.isPrintLayout && $ctrl.currentList.name !== 'General' ? ('<div id="topHeader-' + $ctrl.currentList._id+'" class="topHeader list list-header clearfix">' +
                        '<div class="header-row thinner full-width">' +
                            '<div class="full-width sb-prop-list-name bold">' + $ctrl.currentList.name + '</div>' +
                            ($ctrl.currentList.description ? ('<div class="full-width sb-prop-list-description">' + $ctrl.currentList.description + '</div>') : '') +
                        '</div>' +
                    '</div>') : '';
            }
        }

        function showSelectAll(){
           // return (!$ctrl.withoutCheckbox||$ctrl.isGridView) && $ctrl.isActiveTree();
            return (!$ctrl.withoutCheckbox || $ctrl.showSelectAllInHeader) && $ctrl.isActiveTree() &&
                //if is not admin dont allow bulk actions
                !($ctrl.mustBeAdminToEdit && $ctrl.CPS.memberType < $ctrl.security.MemberTypes.Admin);
        }

        function getGroupTreeHeader() {
    return  ($ctrl.canEdit ? $ctrl.getSortHandle(true) : '') +
            (typeof($ctrl.getPreRowFront) === 'function' ? $ctrl.getPreRowFront(true) :'') +
            ($ctrl.canEdit ? getSelectAll()  : '') +
            $ctrl.getGroupHeader() +
            $ctrl.getMoreBtnTemplate(true, null) +
            ($ctrl.getTopNavBtns ? $ctrl.getTopNavBtns() : '');

        function getSelectAll() {
            return '<div ng-show="$ctrl.showSelectAll()" class="check hide-print no-drag text-left hide-ipad' + ($ctrl.withoutCheckHover ? '' : ' with-hover') + ($ctrl.isGridView ?  ' gridview' : '') + '">' +
                    '<div class="selectallcheck" ng-hide="$ctrl.hideSelectAllCheck()"><div data-type="selectRows" class="btnSelectAllRows custom-checkbox inrow selectmark ' + $ctrl.getBtnActionCls() +' ' + // ($ctrl.pageClass||'') +
    '"  ng-style="$ctrl.hasSmall1&&{\'line-height\':\'30px\'}"><label><input type="checkbox" analytics-on analytics-action="Select All Rows"><span></span>' +
                            ' <span ng-show="$ctrl.showSelectAllText()" class="ctext">Select All</span>' +
                        '</label></div></div>' +
                    '</div>';
            }
        }

        function withSelectAll(){
            return true;
        }

        function showSelectAllText(){
            return $ctrl.showSelectAllTxt || $ctrl.isGridView && $ctrl.withSelectAll();
        }


        function showProForCol(c) {
            return c.quotaType && !c.quotaTypeHidePro && !$ctrl.CPS.hasQuotaType(c.quotaType);
        }

        function openProForCol(c, e) {
            console.log('openProForCol');
            //planFeatures testmode
            var quotaType = c ? c.quotaType : null;
            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});

            function process() {

            }
        }

        function getPrintGroupHeader() {
            var txt = '';
            _.each($ctrl.filtersService.listCols, function (c) {
                if ($ctrl.showColumn(null, c, true, undefined, true)) {
                    txt += '<div class="' + $ctrl.getClsCol(c, false, true) + '" print-id="'+c.id.replace('.','')+'">' + (c.hideTitle ? '' : ('<span>' + (c.namePrint || c.name) + '</span>')) + '</div>';
                }
            });
            return txt;
        }

        function getGridItemWidthCls() {
            if (!$ctrl.isGridView || !$ctrl.withGridView) {
                return '';
            }
            var o = '';
            switch ($ctrl.gridBlockType) {
                case 'docs':
                    o = 'docs ';//bigpadding columns-' + ($root.windowWidth > 1900?51:($root.windowWidth > 1800?4:($root.windowWidth > 1300?3:($root.windowWidth>767?2:1))))";
                    break;
                case 'profile':
                    o = 'profile ';//bigpadding columns-' + ($root.windowWidth > 1450?51:($root.windowWidth > 1300?4:($root.windowWidth > 850?3:($root.windowWidth>560?2:1))))";//bigpadding columns-' + ($root.windowWidth > 2500?51:($root.windowWidth > 2000?4:($root.windowWidth > 1700?3:($root.windowWidth>767?2:1))))";
                    break;
                case 'docs postersize':
                    o = 'docs postersize ';//bigpadding columns-' + ($root.windowWidth > 1900?51:($root.windowWidth > 1800?4:($root.windowWidth > 1300?3:($root.windowWidth>767?2:1))))";
                    break;
            }

            return (o || '');
        }

        function showBottomButtons() {
            return !$ctrl.list.busy && $ctrl.hasElements() && $ctrl.isActiveFilter();
        }

        function onListNameChanged(item) {
            if (item.item) {
                item = item.item;
            }
            var up;
            if (item && item._id === $ctrl.currentListId) {
                up = updatePropsFromList(item, true);
                if (up && $ctrl.currentList) {
                    $ctrl.currentList = _.extend($ctrl.currentList, up);
                }
            } else if ($ctrl.list.getElementById(item._id)) {
                up = updatePropsFromList(item);
                $ctrl.replaceElementProps(item._id, up);
            }

            if ($ctrl.onListNameChangedOher) {
                $ctrl.onListNameChangedOher(item);
            }
        }

        function updatePropsFromList(item, isParent) {
            var l = ['name'], up = {};
            _.each(l.concat($ctrl.onListChangedProps || []), function (p) {
                var v = item[p];
                up[p] = v;
                var els = $ctrl.element.querySelectorAll((isParent ? '' :
                    ('.' + $ctrl.itemSelector + '[data-id="' + item._id + '"] ')) +
                    '.sb-prop-' + (isParent ? 'list-' : '') + p);
                if (els) {
                    _.each(els, function (el) {
                        el.innerHTML = v;
                    });
                }
            });
            return up;
        }

        function getTreePopupParams() {
            if (!$ctrl.listTreeService) {
                return null;
            }
            return _.extend({
                listTreeService: $ctrl.listTreeService,
                treeType: $ctrl.treeType
            }, $ctrl.listTreeService.popupTreeParams)
        }

        function afterProcessUpdates(result, initResult) {
            console.log('grouptree.afterProcessUpdates');
            if (result.eventType === 'CHANGED_FIELD') {
                return;
            }
            var res = $ctrl.setCounter();
            if ($ctrl.totalCount !== res.totalCount) {
                $ctrl.totalCount = res.totalCount;
            }
            console.log('afterProcessUpdates: ' + $ctrl.totalCount + ' ' + getSBTimestamp());
            if ($ctrl.listTreeService) {
                //$ctrl.listTreeService.computeAllNodesCount();
                if (result.eventType === 'UPDATE_LIST_COUNTER') {
                    //add empty items
                    //clipboard processing with one list -> delete / add /duplicate
                    $ctrl.listTreeService.updateCountForNodeId($ctrl.currentListId, $ctrl.totalCount + (res.dif || 0), $ctrl.totalCount);

                } else if (result.eventType === 'UPDATE_MULTI_LIST_COUNTER') {
                    //clipboard processing with two lists ->  duplicate / move
                    if (initResult) {
                        updateCounter(initResult.sIds);
                    }
                }

                if (res.type !== 1) {
                    var ids = []
                    if ($ctrl.listTreeService.withHarcodedAll) { //if is not move
                        ids.push('All');
                    }
                    // Activate         Archive
                    if (result.type === 11 || result.type === 12) {
                        ids.push('Archived');
                    }
                    updateCounter(ids);
                }

                if (typeof ($ctrl.afterProcessUpdatesOther) === 'function') {
                    $ctrl.afterProcessUpdatesOther(result, initResult);
                }
            }

            function updateCounter(ids) {
                if (ids && ids.length > 0) {
                    $ctrl.LCS.timeout(function () {
                        $ctrl.broadcastRoot('COUNTER_CHANGED_' + $ctrl.elemType + '_TREE', {ids: ids});
                    }, 100);
                }
            }
        }

        function getSelectedIdField() {
            return $ctrl.listTreeService && $ctrl.listTreeService.selectedIdField ? $ctrl.listTreeService.selectedIdField : '_id';
        }

        function onAllLoaded() {
            //console.log('onAllLoaded: ' + $ctrl.currentListId);
            var t = true;
            if ($ctrl.listTreeService) {
                var active = $ctrl.listTreeService.active ? $ctrl.listTreeService.active.selectedList : null;
                t = active && active[getSelectedIdField()] === $ctrl.currentListId;
            }

            $ctrl.onAllLoadedInit(t);
            /*
                //todo do we need this???
                {
                    var nodes = active.nodes;
                    if (nodes && nodes.length > 0) {
                        $ctrl.keyboardService.currentListId = nodes[0]._id;
                    } else {
                        if (active._id === $ctrl.currentListId) {
                            $ctrl.keyboardService.currentListId = $ctrl.currentListId;
                        }
                    }
             //for shot list in case of presentation mode
            // if ($ctrl.selectItem) {
//                     $ctrl.selectItem(0);
            //                 }
               }*/
        }

        function processFieldEditMode(editedId, withRemove) {
            if (editedId === undefined) {
                return;
            }
            if (withRemove) {
                $ctrl.onDestroyEdit();
            }
            var method = withRemove ? $ctrl.LCS.removeClass : $ctrl.LCS.addClass,
                el = getEl(editedId);
            if (el) {
                method(el.querySelector('.list-item-name'), 'sb-hide');
                method(el.querySelector('.counter-col'), 'sb-hide');
                method(el.querySelector('.btn-col'), 'sb-hide');
                method(el.querySelector('.list-edit-item'), 'sb-hide');
            }
            $ctrl.editedId = withRemove ? undefined : editedId;
            //todo
            //data-nodrag="$ctrl.isEdit(item)" class="list-edit-item
        }

        function getEl(editedId) {
            return $ctrl.element.querySelector('.inline-tree-item[data-id="' + editedId + '"]');
        }

        function editItemField(item) {// when called from the sidebar dropdown  menu or when editing
            cancelItemFieldEdit();
            if (!item) {
                return;
            }
            var editedId = item ? $ctrl.listTreeService.getSelectedFieldFromItem(item) : undefined,
                el = getEl(editedId);
            $ctrl.compiledItemEdit.getItemTemplate = function () {
                var tag = $ctrl.treeItemTag + '-item-edit';
                return '<' + tag + ' is-semibold="::' + ($ctrl.isSemibold === true) + '" with-font-small="::' + ($ctrl.isSmallFont === true) + '" item="::$ctrl.item" service="::$ctrl.service" cancel-edit="$ctrl.canceFieldEdit()" on-update="$ctrl.onUpdate(item)" ></' + tag + '>'; //font-size="::'+(item.isFolder?'15px':'13px')+'
            };
            $ctrl.compiledItemEdit.loadTemplate(function (clonedElement) {
                //remove the object from previous editable item place
                processFieldEditMode(editedId);
            }, {
                item: angular.copy(item),
                service: $ctrl.listTreeService ? $ctrl.listTreeService.listsService : $ctrl.service,
                canceFieldEdit: cancelItemFieldEdit,
                onUpdate: onUpdate
            }, angular.element(el));
        }

        function cancelItemFieldEdit() {
            if ($ctrl.editedId) {
                console.log('sidebar cancelItemFieldEdit ');
                processFieldEditMode($ctrl.editedId, true);
            }
        }

        function canceFieldEdit() {
            editItemField(null);
        }

        function onItemFieldUpdate(item) {
            console.log('sidebar onUpdate');
            if ($ctrl.listTreeService) {
                $ctrl.listTreeService.onInitUpdateName(item);
            }
            $ctrl.broadcastRoot('NAME_CHANGED_' + $ctrl.elemType + '_TREE', item);//update in group
            //i18nNotifications.pushForCurrentRoute (null, 'crud.shotsLists.Edit.success', 'success', item.name );
            //call it from inside the editable item on blur or enter
            cancelItemFieldEdit();
        }

        function onReloadGroupTemplate() {
            if(typeof($ctrl.onReloadGroupTemplateOther)==='function') {
                $ctrl.onReloadGroupTemplateOther();
            }

            if($ctrl.hasTwoSidebars && $ctrl.hasTwoSidebars()){
                onReloadResizableTemplate();
            }
        }

        function onReloadResizableTemplate(){
            var resizable = function (sbresizer) {
                var direction,
                    prevSibling = sbresizer.previousElementSibling,
                    nextSibling = sbresizer.nextElementSibling;

                if(!$ctrl.reloadResizableSecondTime){
                    var info = $ctrl.LCS.PersistenceService.get('sbresizer');
                    if(info){
                        if(info.direction){
                            direction = info.direction;
                            sbresizer.setAttribute('data-direction', direction);
                        }else{
                            direction = getDirection();
                        }

                        prevSibling.style[direction === 'horizontal' ? 'width' : 'height'] = (info.size || '25') + '%';
                    }

                    $ctrl.reloadResizableSecondTime = true;
                }else{
                    direction = getDirection();
                }
                    // The current position of mouse
                var x = 0,
                    y = 0,
                    prevSiblingHeight = 0,
                    prevSiblingWidth = 0,

                    // Handle the mousedown event
                    // that's triggered when user drags the sbresizer
                    mouseDownHandler = function (e) {
                        // Get the current mouse position
                        x = e.clientX;
                        y = e.clientY;
                        const rect = prevSibling.getBoundingClientRect();
                        prevSiblingHeight = rect.height;
                        prevSiblingWidth = rect.width;

                        // Attach the listeners to `document`
                        $ctrl.LCS.bindElementListeners(true, $ctrl.LCS.$document[0], mouseMoveHandler, 'mousemove');
                        $ctrl.LCS.bindElementListeners(true, $ctrl.LCS.$document[0], mouseUpHandler, 'mouseup');
                    },

                    mouseMoveHandler = function (e) {
                        // How far the mouse has been moved
                        const dx = e.clientX - x;
                        const dy = e.clientY - y;

                        switch (direction) {
                            case 'vertical':
                                const h =
                                    ((prevSiblingHeight + dy) * 100) /
                                    sbresizer.parentNode.getBoundingClientRect().height;
                                prevSibling.style.height = h + '%';
                                break;
                            case 'horizontal':
                            default:
                                const w =
                                    ((prevSiblingWidth + dx) * 100) / sbresizer.parentNode.getBoundingClientRect().width;
                                prevSibling.style.width = w + '%';
                                break;
                        }

                        const cursor = direction === 'horizontal' ? 'col-resize' : 'row-resize';

                        sbresizer.style.cursor = cursor;
                        document.body.style.cursor = cursor;

                        style(prevSibling);
                        style(nextSibling);

                        function style(el){
                            el.style.userSelect = 'none';
                            el.style.pointerEvents = 'none';
                        }
                    },

                    mouseUpHandler = function () {
                        sbresizer.style.removeProperty('cursor');
                        document.body.style.removeProperty('cursor');

                        remove(prevSibling);
                        remove(nextSibling);

                        // Remove the handlers of `mousemove` and `mouseup`
                        $ctrl.LCS.bindElementListeners(false, $ctrl.LCS.$document[0], mouseMoveHandler,'mousemove');
                        $ctrl.LCS.bindElementListeners(false, $ctrl.LCS.$document[0], mouseUpHandler, 'mouseup');

                        setPersistance();
                        $ctrl.broadcastRoot('SBRESIZER_CHANGED', );

                        function remove(el){
                            el.style.removeProperty('user-select');
                            el.style.removeProperty('pointer-events');
                        }
                    };

                // Attach the handler
                $ctrl.LCS.bindElementListeners(true, sbresizer, mouseDownHandler, 'mousedown');

                function setPersistance(){
                    var d = getDirection();
                    $ctrl.LCS.PersistenceService.set('sbresizer', {
                        direction: d,
                        size: getSize (d)
                    })
                }

                function getDirection(){
                    return sbresizer.getAttribute('data-direction') || 'horizontal';
                }

                function getSize (direction){
                    var s = prevSibling.style[direction === 'horizontal' ? 'width' : 'height'];
                    return s ? s.replace('%', '') : '25';
                }
            };

            // Query all sbresizers
            var els = document.querySelectorAll('.sbresizer');
            if(els && els.length > 0){
                _.each(els, resizable);
            }
        }
    }
}

angular.module('group.container.block.controller.service', [
])

.service('GroupContainerBlockCtrlService', GroupContainerBlockCtrlService);
GroupContainerBlockCtrlService.$inject = ['TemplateCompileCompCtrlService', 'PreLoadingProv'];

function GroupContainerBlockCtrlService(TemplateCompileCompCtrlService, PreLoadingProv) {
    return function ($ctrl, $element, constantsService) {

        $ctrl.PreLoadingProv = PreLoadingProv;
        $ctrl.TemplateCompileCompCtrlService = TemplateCompileCompCtrlService;

        $ctrl.constantsService = _.clone(constantsService);

        if($ctrl.rowLoadNow === undefined) {
            $ctrl.rowLoadNow = true;
        }

        if (!$ctrl.getParams) {
            $ctrl.getParams = getParams;
        }
        if(!$ctrl.getGroupEditParams){
            $ctrl.getGroupEditParams = getGroupEditParams;
        }

        if(!$ctrl.getItemTemplate) {
            $ctrl.getItemTemplate = getItemTemplate;
        }
        $ctrl.preInit = preInit;

        $ctrl.dontAutoloadTemplate = true;

        $ctrl = new $ctrl.TemplateCompileCompCtrlService($ctrl, $element);

        return $ctrl;

        function preInit() {
            console.log('GroupContainerBlockCtrlService.preInit');
            if($ctrl.canEdit !== undefined) {
                $ctrl.constantsService.CompOptions = _.extend({}, $ctrl.constantsService.CompOptions, {canEdit: $ctrl.canEdit});
            }

            $ctrl = _.extend($ctrl, $ctrl.constantsService.CompOptions);
            $ctrl.compOptions = JSON.stringify($ctrl.constantsService.CompOptions);

            if ($ctrl.block === undefined) {
                console.warn('$ctrl.block must be defined in parent for GroupContainerBlockCtrlService');
            }

            if ($ctrl.title === undefined) {
                console.warn('$ctrl.title must be defined in parent for GroupContainerBlockCtrlService');
            }

            if ($ctrl.groupTag === undefined) {
                console.warn('$ctrl.groupTag must be defined in parent for GroupContainerBlockCtrlService');
            }

            if ($ctrl.currentListId === '') {
                $ctrl.currentListId = undefined;
            }

            if($ctrl.preloadingType && !$ctrl.preLoadingService) {
                $ctrl.preLoadingService = $ctrl.PreLoadingProv.getInstance($ctrl.getParams(), $ctrl.PreLoadingProv.PreloadingTypes[$ctrl.preloadingType]);
                if($ctrl.preLoadingService) {
                    $ctrl.reloadTemplate();
                    $ctrl.preLoadingService.load(onload);
                } else {
                    console.log('$ctrl.preLoadingService is not defined');
                    onload();
                }
            } else{
                console.log('$ctrl.preLoadingTableName is not defined');
                onload();
            }

            function onload(err, result) {
                $ctrl.isAllLoaded = true;
                if($ctrl.onPreloadedService){
                    $ctrl.onPreloadedService(err, result);
                }
                $ctrl.reloadTemplate();
            }
        }

        function getItemTemplate() {
            console.log('GroupContainerBlockCtrlService.getItemTemplate');
            if (!$ctrl.isAllLoaded) {
                return '<preloader-center class="clearfix display-block preloader ' + ($ctrl.pageClass || '') + ($ctrl.smallPreloader ? ' small' : '') + '"></preloader-center>';
            }

            return '<div class="tasks-container ' + ($ctrl.withGroupSidePadding? ' with-side-padding30' : '')+ '">' +
                ($ctrl.getGroupHeader ? $ctrl.getGroupHeader() : '') +
                '<' + $ctrl.groupTag + ' class="display-block clearfix ' + $ctrl.groupTag + ' ' + $ctrl.block + 'Section tree-node simple-group ' +
                ($ctrl.isLightMode ? 'lightmode' :'') +
                '" data-id="' + ($ctrl.currentListId ? $ctrl.currentListId : 'null') + '"' +
               ($ctrl.gridNested ? 'nested-level="1"' : '') +
                //groupsimple
                'current-list-id="'+$ctrl.currentListId+'" ' +

                'comp-options="::$ctrl.compOptions" ' +

                'constants-service="::$ctrl.constantsService" ' +
                'pre-loading-service="::$ctrl.preLoadingService" ' +
                'pre-loading-table-name="::$ctrl.preLoadingTableName" ' +

                //group block
                'block="' + $ctrl.block + '" ' +

                'row-observer-service="::$ctrl.rowObserverService" ' +
                'row-load-later="::(!$ctrl.rowLoadNow&&!$ctrl.isPrintLayout?true: false)" ' +
                $ctrl.getGroupEditParams() +
                ($ctrl.getGroupBodyAttrs ? $ctrl.getGroupBodyAttrs():'') +
                '></' + $ctrl.groupTag + '>' +
                '</div>';
        }

        function getGroupEditParams() {
            return 'can-edit="::$ctrl.canEdit" ' +
                (typeof($ctrl.getGroupEditParamsOther) === 'function' ? $ctrl.getGroupEditParamsOther() : '');
        }

        function getParams() {
            console.log('GroupContainerBlockCtrlService.getParams');
            var params = {
                companyId: $ctrl.CPS.companyId
            };
            if ($ctrl.CPS.productId) {
                params.productId = $ctrl.CPS.productId;
            }
            if ($ctrl.listField) {
                params[$ctrl.listField] = $ctrl.currentListId;
            }

            return $ctrl.getOtherParams ? _.extend(params, $ctrl.getOtherParams()) : params;
        }
    }
}

angular.module('group.tree.helper.service', [
])
.service('GroupTreeHelperService', GroupTreeHelperService);

function GroupTreeHelperService(){
    var service = {
        getGroupBody: getGroupBody,
        getGroupsContent: getGroupsContent
    }

    return service;

    function getGroupsContent($ctrl, withRepeat, isFullHeight){
        var fCls = getFCLs(isFullHeight);
        return getLists() +
            //(typeof ($ctrl.getGroupBodyOther) === 'function' ? $ctrl.getGroupBodyOther() : '') +
            getEmptyGroupWrapper();

        function getLists() {
            var item = 'item',
                selected = '$ctrl.listTreeService.active.selectedList',
                list = $ctrl.isPrintLayout ? (selected + '.nodes') : ('[' + selected + ']'),
                type = withRepeat ? 'item' : selected,
                id = '{{::$ctrl.getSelectedFieldFromItem(' + type + ')}}',
                cond = 'ng-if="' + type + '" ' +
                    (withRepeat ? 'ng-repeat="' + item + ' in ' + list + ' track by ' + item + '._id"' : '');
            if( withRepeat) {
                return getList(cond, id);
            }
            var nodes = $ctrl.listTreeService.active && $ctrl.listTreeService.active.selectedList ? $ctrl.listTreeService.active.selectedList.nodes : null;
            return (nodes && nodes.length > 0 ? nodes.map(function (item, i) {
                return item ? getList(cond, $ctrl.getSelectedFieldFromItem(item), '$ctrl.listTreeService.active.selectedList.nodes['+i+']') : '';
            }).join('') : '');
        }

        function getList(cond, id, currentListParam){
    return '<div class="' + fCls + '" ' + cond + '>' +
                '<div class="tree-node tree-node-content '+ fCls + ($ctrl.withoutTopFilters ? ' position-relative':'') + '" ' +
                ((withRepeat ? 'ng-attr-data-id' : 'data-id') + '="' + id + '"') +
                '>' +
                    ($ctrl.withoutTopFilters ? ($ctrl.isPrintLayout ? '' : getGroupNav()) : '') +
                    '<div class="full-width ' + fCls + ($ctrl.withoutTopFilters ? ' with-filters-above' : '')+ '">' + getGroupBodyInit(currentListParam) + '</div>' +
                '</div>' +
            '</div>';
        }

        function getEmptyGroupWrapper(){
            if($ctrl.isPrintLayout || !$ctrl.withActiveTree){return '';}
            return '<div ng-show="$ctrl.listTreeService.active.selectedList.isFolder" class="h-full spacing-half with-body-padding empty-group-wrapper table-div">' +
                '<div class="centered text-center">' + $ctrl.getEmptyGroup() + '</div>' +
                '</div>';
        }

        function getGroupBodyInit(currentListParam){
            return $ctrl.getGroupBody($ctrl.isPrintLayout ? {
                currentListParam: currentListParam
            } : {
                isFullHeight: isFullHeight
            });
        }

        function getGroupNav(){
            console.log('getGroupNav');
            return '<nav class="filters on-top hide-print short"><div class="pull-right display-block">' +
                $ctrl.getSidebarToggle() +
                $ctrl.getSearch() +
                ($ctrl.getLeftButtons ? $ctrl.getLeftButtons() : '')  +
                $ctrl.getSomeBtns() +
                '</div></nav>';
        }

        function getFCLs(isFullHeight){
            return $ctrl.isPrintLayout ? '' : (isFullHeight ? 'h-full ' : '');
        }
    }


    function getGroupBody($ctrl, result) {
        //console.log('PageTreeInitCtrlService.getGroupBody');
        if (!result) {
            result = {};
        }
        var tag = result.groupTag ? result.groupTag : ($ctrl.groupTag ? $ctrl.groupTag : ($ctrl.elemType.toLowerCase() + '-group')),
            add = typeof ($ctrl.getGroupBodyAddon) === 'function' ? $ctrl.getGroupBodyAddon() : {},
            params = _.extend({}, getGroupBodyParams(result.currentListParam), add || {}, result.other || {}),
            txtParams = '';

        for (var prop in params) {
            txtParams += prop + '=' + params[prop] + ' ';
        }

        return '<' + tag + ' class="tree-group ' +
            tag + ' ' +
            ($ctrl.hasTwoSidebars && $ctrl.hasTwoSidebars() ? 'display-flex ' : 'display-block ') +
            'clearfix tree-node simple-group ' +

            (result.isFullHeight ? 'h-full ' : '') + ' ' +
            ($ctrl.groupClass ? $ctrl.groupClass : '') +
            '" ' +
            txtParams +
            '></' + tag + '>';

        function getGroupBodyParams(currentListParam) {
            return {
                'list-tree-service': '"::$ctrl.listTreeService"',
                'tree-type': '"::$ctrl.treeType"',

                'keyboard-service': '"::$ctrl.keyboardService"',
                'comp-options': '"::$ctrl.compOptions"',

                'constants-service': '"::$ctrl.listTreeService.constantsService"',
                'pre-loading-service': '"::$ctrl.listTreeService.preLoadingService"',
                'pre-loading-table-name': '"::$ctrl.listTreeService.preLoadingTableName"',

                'can-edit': '"::'+($ctrl.canEdit===true)+'"',
                'selected-filter': '"::$ctrl.isActiveFilter()"',

                'current-list': currentListParam ? ('"::' + currentListParam + '"') : '"item"',
                'selected-items': '"::$ctrl.selectedItems"',

                'get-params': '"$ctrl.getParams()"',
                'create-from-top': '"$ctrl.createFromTop()"',
                'on-get-list-item-icon': '"$ctrl.getListItemIcon(item)"'
            };
        }
    }
}


