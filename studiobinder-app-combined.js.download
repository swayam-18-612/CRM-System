            getColorName: getColorName,
            isImage: isImage,
            isGradient: isGradient,
        };

    return service;

    function isGradient(url) {
        return url && url.indexOf('-gradient') !== -1;
    }

    function isImage(v) {
        return v && (v.indexOf('#') === -1 && v.indexOf('-gradient') === -1);
    }

    // adopted from: Farbtastic 1.2
    // http://acko.net/dev/farbtastic
    function getHsl(color) {

        var rgb = [parseInt('0x' + color.substring(1, 3)) / 255, parseInt('0x' + color.substring(3, 5)) / 255, parseInt('0x' + color.substring(5, 7)) / 255];
        var min, max, delta, h, s, l;
        var r = rgb[0], g = rgb[1], b = rgb[2];

        min = Math.min(r, Math.min(g, b));
        max = Math.max(r, Math.max(g, b));
        delta = max - min;
        l = (min + max) / 2;

        s = 0;
        if (l > 0 && l < 1)
            s = delta / (l < 0.5 ? (2 * l) : (2 - 2 * l));

        h = 0;
        if (delta > 0) {
            if (max == r && max != g) h += (g - b) / delta;
            if (max == g && max != b) h += (2 + (b - r) / delta);
            if (max == b && max != r) h += (4 + (r - g) / delta);
            h /= 6;
        }
        return [parseInt(h * 255), parseInt(s * 255), parseInt(l * 255)];
    }

    // adopted from: Farbtastic 1.2
    // http://acko.net/dev/farbtastic
    function getRgb(color) {
        return [parseInt('0x' + color.substring(1, 3)), parseInt('0x' + color.substring(3, 5)), parseInt('0x' + color.substring(5, 7))];
    }

    function getImgPath(v, bgFolder) {
        return (bgFolder || 'taskboard-backgrounds') + '/' + v;
    }

    //#hexcode
    function getColorName(color) {
        if (!initColors) {
            service.ColorsWithNames = initColorNames(service.ColorsWithNames);
        }
        return getColor(color, service.ColorsWithNames)[1];

        function getColor(color, colors) {
            color = color.toUpperCase();
            if (color.length < 3 || color.length > 7)
                return ["#000000", "Invalid Color: " + color, false];
            if (color.length % 3 == 0) {
                color = "#" + color;
            }
            if (color.length == 4) {
                color = "#" + color.substr(1, 1) + color.substr(1, 1) + color.substr(2, 1) + color.substr(2, 1) + color.substr(3, 1) + color.substr(3, 1);
            }
            var rgb = getRgb(color);
            var r = rgb[0], g = rgb[1], b = rgb[2];
            var hsl = getHsl(color);
            var h = hsl[0], s = hsl[1], l = hsl[2];
            var ndf1 = 0, ndf2 = 0, ndf = 0;
            var cl = -1, df = -1;

            for (var i = 0; i < colors.length; i++) {
                var c = colors[i];
                if (color == "#" + c[0]) {
                    return ["#" + c[0], c[1], true];
                }

                ndf1 = Math.pow(r - c[2], 2) + Math.pow(g - c[3], 2) + Math.pow(b - c[4], 2);
                ndf2 = Math.pow(h - c[5], 2) + Math.pow(s - c[6], 2) + Math.pow(l - c[7], 2);
                ndf = ndf1 + ndf2 * 2;
                if (df < 0 || df > ndf) {
                    df = ndf;
                    cl = i;
                }
            }

            return (cl < 0 ? ["#000000", null, false] : ["#" + colors[cl][0], colors[cl][1], false]);
        }

        function initColorNames(colors) {
            var color, rgb, hsl;
            for (var i = 0; i < colors.length; i++) {
                color = "#" + colors[i][0];
                rgb = getRgb(color);
                hsl = getHsl(color);
                colors[i].push(rgb[0], rgb[1], rgb[2], hsl[0], hsl[1], hsl[2]);
            }

            return colors;
        }
    }

    function getColorName1(color, colors) {
        const rgb = LCS.hexToRgba(color);
        let closestName = '';
        let minD = Infinity;

        for (var i = 0; i < colors.length; i++) {
            var c = colors[i];
            const v = c.v;
            const d = Math.sqrt(
                (rgb[0] - v[0]) ** 2 +
                (rgb[1] - v[1]) ** 2 +
                (rgb[2] - v[2]) ** 2
            );

            if (d < minD) {
                minD = d;
                closestName = c.n;
            }
        }
        return closestName;
    }
}

angular.module('services.compile', [
])
.service('CompileService', CompileService);
CompileService.$inject = ['RootEventsService', '$compile', '$document'];
function CompileService(RootEventsService, $compile, $document) {
    var _this = this;

    _this.RootEventsService = RootEventsService;
    _this.compileTemplate = compileTemplate;
    //_this.compileNewScope = compileNewScope; //not used
    _this.addCompiledTemplateWatcher = addCompiledTemplateWatcher;
    _this.getNewScope = getNewScope;

    return _this;

    //selector
    function addCompiledTemplateWatcher(watchers, avatar, id, type) {
        _this.compileTemplate(avatar, _this.RootEventsService.$rootScope, onCompiled);

        function onCompiled(compiled) {
            // watcher to see when the element has been compiled
            var destroyWatch = _this.RootEventsService.addToRootObserver(watchers, function () {
                    return compiled ? compiled[0].outerHTML : null;
                },
                function (newValue, oldValue) {
                    var elem = angular.element($document.getElementById('item_'+id));
                    var rendered = elem.scope().selectorCacheUpdate(id, compiled.html(), type);
                    // Update DOM element
                    elem.html(rendered);
                    _this.RootEventsService.removeWatcher(destroyWatch);
                }
            );
        }
    }

    function getNewScope($scope){                                           //isolated scope that does not inherit properties from their parent scope
            return ($scope ? $scope : _this.RootEventsService.$rootScope).$new(true);
    }

    function compileTemplate(template, scope, onCompiled) {
        var destroy = false;
        if(!scope){
            scope = getNewScope();
            destroy = true;
        }
        $compile(template)(scope, function(clonedElement){
            if(onCompiled){
                if(destroy){
                    scope.$destroy();
                }
                onCompiled(clonedElement, destroy ? null : scope);
            }
        });
    }

    function compileNewScope(scope, $ctrl, template, onCompiled) {
        var newScope = scope.$new(true);
        newScope.$ctrl = $ctrl;
        _this.compileTemplate(template, newScope, onCompiled);
    }
}


var tSb = null;
function getSBTimestamp(){
    var d = new Date();
    tSb = d;
    return (d.getMinutes()+':'+d.getSeconds()+':'+d.getMilliseconds());
}

angular.module('sb.console.service', [
    'services.assessWatchers'
])
.service('SBConsoleService', SBConsoleService);
SBConsoleService.$inject = ['$window', 'API_CONFIGS', 'AssessWatchersService'];
function SBConsoleService($window, API_CONFIGS, AssessWatchersService) {
    var _this = this;
    var configs = API_CONFIGS();

    _this.debugOnly = ['log', 'info', 'warn'];
    _this.types = _this.debugOnly.concat('error');
    _this.isDebug = configs.debugger && configs.debugger.enabled
    _this.init = init;

    return _this;

    function init(){
        AssessWatchersService.loadWatchersContainer(_this.isDebug);

        //setConsole();
    }

    function setConsole() {
        $window.console = set($window.console);

        function set(c) {
            var all = {};
            _.each(_this.types, set);

            return all;

            function set(type) {
                all[type] = p(type);
            }

            function p(type) {
                return function (text) {
                    if (_this.debugOnly.indexOf(type) !== -1 && !_this.isDebug) {
                        return;
                    }
                    c[type](getSBTimestamp() +': ' + text);
                }
            }
        }
    }
}

angular.module('sb.darkReader.service', [
])
.service('DarkReaderService', DarkReaderService);
DarkReaderService.$inject = ['LCS'];
function DarkReaderService(LCS) {
    var useDarkReader = false;
    var darkReader = useDarkReader ? LCS.$window.DarkReader : null;
    var prop = 'darkModeOn';
    var service = {
        toggle: toggle,
        isOn: getOn()
    };

    if (useDarkReader && !darkReader) {
        console.warn('DarkReader var missing. Did you forget to include the script js/dark-reader.js?');
        service.isNotLoaded = true;
    }else{
        service.isNotLoaded = false;
    }

    if(service.isOn){
        enable();
    }

    return service;

    function toggle() {
        toggleDarkReader();
        service.isOn = setOn(!service.isOn);
    }

    function toggleDarkReader(){
        if(!darkReader){return;}
        if (service.isOn) {
            darkReader.disable();
        } else{
            enable();
        }
    }

    function enable() {
        if(!darkReader){return;}
        darkReader.setFetchMethod(LCS.$window.fetch);
        darkReader.enable({
            brightness: 100,
            contrast: 90,
            sepia: 10
        });
    }

    function getOn() {
        var val = LCS.PersistenceService.get(prop);
        return val === true;
    }

    function setOn(val) {
        LCS.darkMode = val;
        if(!LCS.hasClass('current-mode-only')) {
            LCS[LCS.darkMode ? 'addClass' : 'removeClass'](LCS.bodyElement, 'dark-mode');
        }
        return LCS.PersistenceService.set(prop, val);
    }
}

angular.module('services.downloadExport', [
    'services.rootEvents'
])
.service('DownloadExportService', DownloadExportService);

DownloadExportService.$inject = ['CPS'];
function DownloadExportService(CPS) {
    var _this = this;
    _this.security = CPS.security;
    _this.MomentService = CPS.MomentService;

    var saveAsJSON = false;
    _this.sbxFileType =   'text/plain'; //'application/json'
    _this.downloadAttachment = downloadAttachment;
    _this.downloadBlobFile = downloadBlobFile;
    _this.exportContentToSbx = exportContentToSbx;
    _this.exportRowsToCsv = exportRowsToCsv;
    _this.createBlobFromContent = createBlobFromContent;
    _this.getSbxFileFromContent = getSbxFileFromContent;

    return _this;

    function downloadAttachment(f) {
        createAndDownloadBlobFile(f, f.name);
    }

    function downloadBlobFile(path, postParams, onSuccess, onError, withCustomLink, otherHeaders) {
        _this.security.sendGeneratorRequest(path, postParams, function (res) {
            downloadResponseAsOctetStream(res, onSuccess, onError, withCustomLink);
        }, onError, true, null, otherHeaders);
    }

    function exportContentToSbx(filename, content) {
        exportContent(filename, _this.sbxFileType, content);
    }

    function exportRowsToCsv(rows, name) {
        var fileType = 'csv',
            timestamp = parseInt(Date.now() / 1000, 10),
            filename = (name ? name : 'export') + moment(timestamp).format('MM-DD-YY_HH-mm') + '.' + fileType;
        var CRLF = "\r\n";

        var processRow = function (cols) {
            var finalVal = '';
            for (var j = 0; j < cols.length; j++) {
                var col = cols[j];
                var innerValue = col === null ? '' : col.toString();
                if (col instanceof Date) {
                    innerValue = col.toLocaleString();
                }
                var result = innerValue.replace(/"/g, '""');
                if (result.search(/("|,|\n|\r\n)/g) >= 0){
                    result = '"' + result + '"';
                }
                if (j > 0){
                    finalVal += ',';
                }
                finalVal += result;
            }
            return finalVal + CRLF;
        };

        var content = '';
        _.each(rows, function (row) {
            content += processRow(row);
        });

        exportContent(filename, content, 'text/csv');
    }

    function createBlobFromContent(filename, content, timestamp, type) {
        if(!type){type = _this.sbxFileType;}
        return _.extend(new Blob([type === 'application/json' ? JSON.stringify(content) : content], {type: type}), {
            createdTimestamp: timestamp ? timestamp : _this.MomentService.getTimestamp(),
            name: getCleanedFileName(filename)
        });
    }

    function getSbxFileFromContent(name, content, note) {
        var fileType = 'sbx',
            timestamp = parseInt(Date.now() / 1000, 10),
            filename = name + moment(timestamp).format('MM-DD-YY_HH-mm') + '.' + fileType,
            blob = _this.createBlobFromContent(filename, content, timestamp);

        var file = new File([blob], filename, {
            lastModified: timestamp,
            type: fileType.toUpperCase()
        });
        if (note) {
            file.note = note;
        }
        return file;
    }


    function exportContent(filename, content, type) {
        createAndDownloadBlobFile(_this.createBlobFromContent(filename, content, _this.MomentService.getTimestamp(), type), filename);
    }

    function getHtmlFromDeltaSBX(content){
       // typeof(content) === JSON
        var ops = [{
            insert: 'hello',
            attributes: {
                color: '#f00'
            }
        },
            {
                "insert": {
                    "customImageBlot": {
                        "height": 150,
                        "width": 150,
                        "url": "https://d35bklnb0uzdnn.cloudfront.net/image/i@Hy81U57G7.png"
                    }
                },
                attributes: {
                    renderAsBlock: true
                }
            },
            {
                insert: 'how r u?'
            }
        ];

        var converter = new QuillDeltaToHtmlConverter(ops);

        converter.renderCustomWith((op, ctxop) => {
            return 'aa';
        })
        return converter.convert();

    }

    function getCleanedFileName(name) {
        var char = '_';
        return name.replace(/[^a-zA-Z0-9-_.]/g, char).replace(/_{2,}/g, char).replace(/_-_/g, char);
    }

    function downloadResponseAsOctetStream(res, onSuccess, onError, withCustomLink) {
        console.log('downloadResponseAsOctetStream');
        //res.setHeader('Content-disposition', 'attachment; filename="' + filename + '"');
        // res.setHeader('Content-type', 'application/pdf');
        var data = res && res.data ? res.data : null;
        if (data) {
            var headers = res.headers(), filename = 'download-file',
                mimetype = 'application/octet-stream';
            try {
                filename = headers['content-disposition'].split('=')[1].replace(/"/g, '');
                mimetype = headers['content-type'].split(';')[0];
            } catch (e) {
            }

            var blob = b64toBlob(data, mimetype);
            createAndDownloadBlobFile(blob, filename, onSuccess, withCustomLink);
        } else {
            onError(data);
        }
    }

    function b64toBlob(b64Data, contentType, sliceSize) {
        if (!contentType) {
            contentType = '';
        }
        if (!sliceSize) {
            sliceSize = 512;
        }

        var byteCharacters = atob(b64Data), byteArrays = [];

        for (var offset = 0, n = byteCharacters.length; offset < n; offset += sliceSize) {
            var slice = byteCharacters.slice(offset, offset + sliceSize);

            var byteNumbers = new Array(slice.length);
            for (var i = 0; i < slice.length; i++) {
                byteNumbers[i] = slice.charCodeAt(i);
            }

            var byteArray = new Uint8Array(byteNumbers);

            byteArrays.push(byteArray);
        }

        return new Blob(byteArrays, {type: contentType});
    }

    function createAndDownloadBlobFile(blob, filename, onSuccess, withCustomLink) {
        if (!blob) {
            return p();
        }
        var url = blob.url ? blob.url : URL.createObjectURL(blob);
        if(withCustomLink){
            return p();
        }
        if (navigator.msSaveBlob) {
            // IE 10+
            navigator.msSaveBlob(blob, filename);
            p();
        } else {
            var link = document.createElement('a');
            // Browsers that support HTML5 download attribute
            if (link.download !== undefined) {
                link.setAttribute('target', '_blank');
                link.setAttribute('href', url);
                link.setAttribute('download', filename);
                link.style = "z-index:-1000;width:0;height:0";
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                p();
                // window.URL.revokeObjectURL(url);
            }
        }

        function p() {
            if (typeof (onSuccess) === 'function') {
                onSuccess(url, filename);
            }
        }
    }
}

angular.module('observer.element.service', [
    'services.rootEvents'
])
.service('ElementObserverInitCtrlService', ElementObserverInitCtrlService);
ElementObserverInitCtrlService.$inject = ['LCS', 'RootEventsService'];
function ElementObserverInitCtrlService(LCS, RootEventsService) {
    return function (prop) {
        //console.log('ElementObserverInitCtrlService');

        var objs = {},
            service = {
                RootEventsService: RootEventsService,
                LCS: LCS,
                watchers: [],
                unobserveEl: unobserveEl,
                isInViewport: isInViewport,
                unobserveAll: unobserveAll,
                destroy: destroy,
                checkIfViewport: checkIfViewport,

                prop: 'VIEWPORT_' + prop,
                MARKER: prop + '_MARKER'
            },
            observer = new IntersectionObserver(callback, {root: null});

        return service;

        function callback(entries, observer) {
            entries.forEach(function (entry) {
                //console.log(entry);
                var id, el = entry.target;
                if(el) {
                    id = el.getAttribute('component-id');
                    if (!id) {
                        id = el.dataset.id;
                    }
                }
                if (entry.isIntersecting && el) {
                    onInViewPort(id);
                    setTimeout(function () {
                        unobserveEl(id);
                    }, 200);
                }
            });
        }

        //info = id, el, ev
        function checkIfViewport(marker, info) {
            return marker === service.MARKER ? true : service.isInViewport(info.id, info.el, info.ev);
        }

        function isInViewport(id, el, method) {
            observeEl(id, el, function (result) {
                method(result);
            });
            return false;
        }

        function unobserveAll() {
            //console.log('unobserve all');
            if(objs) {
                for (var id in objs) {
                    unobserveEl(id, objs[id]);
                }
            }
        }

        function observeEl(id, el, method) {
            if (!objs[id]) {
                objs[id] = _.extend({el: el}, {
                    watcher: getWatcher(id, method)
                });
                observer.observe(el);
                //console.log('observe el ' + id);
            }
        }

        function unobserveEl(id) {
            var obj = objs[id];
            if (obj) {
                observer.unobserve(obj.el);
                removeWatcher(obj.watcher);
                delete objs[id];
                //console.log('unobserve el ' + id);
            }
        }

        function removeWatcher(el) {
            if(el) {
                if (typeof (el.dispose) === 'function') {
                    el.dispose();
                } else {
                    el();
                }
            }
        }

        function onInViewPort(id) {
           // console.log('inViewPort: ' + getId(id));
            service.RootEventsService.broadcastRoot(getId(id), service.MARKER);
        }

        function getWatcher(id, method) {
            return service.RootEventsService.addRootWatcher(service.watchers, getId(id), method);
        }

        function getId(id) {
            return service.prop + '_' + id;
        }

        function destroy() {
            service.RootEventsService.removeWatchers(service.watchers);
        }
    }
}


function SBBindElementListeners(window, isBind, el, handler, event, options){
    if(!el){return;}

    //if tested on laptop should go here ->
    //if is one type of device or (is two 2 one but is not click event) proceed with direct bind
    if(!sbTwoInOneDevice || sbTwoInOneDevice && event !== 'hybrid'){
        return bind(event);
    }

    //if tested on surface should go here ->

    //is 2 in one device with hybrid event
    //set both events on and deal based on if is mouse or if is touch
    //make sure only one of them is called
    bind('touchStart', onlyTouch); // touchstart handler
    bind('click', onlyClick);  // click event handler

    function onlyTouch(e) {
        if (e.pointerType !== 'mouse') {
            handler(e);
        }
    }

    function onlyClick(e) {
        if (e.pointerType === 'mouse') {
            handler(e);
        }
    }

    function bind(event, method){
        //todo: see if o is better for mobile
        var o = options ||  (event === 'touchstart' ? {passive: true} : false);
        el[isBind ? 'addEventListener' : 'removeEventListener'](event, method ? method : handler, o);
    }
}

var EventListenerServiceNamespaces = {};
angular.module('services.eventListener', [
])
.service('ELS', ELS);
ELS.$inject = [];
function ELS() {
    //eventEx = 'keyup paste'
    //keydown.Namespace paste.Namespace2;

    var _this = {
        webPEnabled: webPEnabled,
        isIOS: /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream,
        //default to click event for 2inonedevice
        clickEvent: sbDefaultClickEvent,//sbTwoInOneDevice ? 'hybrid' : (touchScreenDevice ? 'touchstart' : 'click'),
        isTouchScreen: touchScreenDevice === true,
        sbTwoInOneDevice: sbTwoInOneDevice,
        ns: EventListenerServiceNamespaces,
        bindElementsClick: bindElementsClick,
        bindElementListeners: bindElementListeners
    }
    return _this;

    function bindElementsClick(isBind, el, handler, namespace, eventNames, options) {
        if (!el || el && el.length === 0 || !eventNames) {
            return;
        }

        var events = eventNames ? eventNames.split(' ') : [];
        _.each(events, function (ev1) {
            var event = ev1 + (namespace ? ('.' + namespace) : ''),
                exists = _this.ns[event];
            if(exists){//remove the prev bind if exists
                processEvent(false, el, exists.handler, event, exists.options);
            }

            if (isBind) {
                _this.ns[event] = {handler: handler, options: options};
            }

            //_this.off(el, event, handler);
            var ev = _this.ns[event];
            processEvent(isBind, el, getp(ev, 'handler', handler), event, getp(ev, 'options', options));

            if (!isBind) {
                delete _this.ns[event];
            }

            function getp(ev, prop, v){
                return v ? v : (ev ? ev[prop] : null);
            }
        });

        function processEvent(isBind, el, handler, event, options) {
            if(!el){return;}
            var ev = event ? event.split('.')[0] : null;//eventType
            if (el.length > 0) {
                if (el.context) {
                    bind(el[0]);
                } else {
                    try{
                        el.forEach(function (item) {
                            bind(item);
                        });
                    }catch (e){}
                }
            } else if (!el.length) {
                bind(el);
            }

            function bind(el) {
                var o = options ||  (event === 'touchstart' ? {passive: true} : false);
                _this.bindElementListeners(isBind, el, handler, ev, options || false);
            }
        }
    }

    function bindElementListeners(isBind, el, handler, event, options){
        return SBBindElementListeners(window, isBind, el, handler, event ? event : _this.clickEvent, options);
    }
}

angular.module('sb.emoji.service', [
])
