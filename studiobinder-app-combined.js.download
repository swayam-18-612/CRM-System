ProductPageCtrl.$inject = ['ProductScriptUpdateInitCtrlService', '$element'];
function ProductPageCtrl(ProductScriptUpdateInitCtrlService, $element) {
    var $ctrl = this;
    $ctrl.$element = $element;
    $ctrl.element = $ctrl.$element[0];
    $ctrl = new ProductScriptUpdateInitCtrlService($ctrl);
}

angular.module('product.script.updateScript.controller.service', [
    'apiServices.Scripts', 'apiServices.Products',
    'product.preLoading.provider'
])
.service('ProductScriptUpdateInitCtrlService', ProductScriptUpdateInitCtrlService);
ProductScriptUpdateInitCtrlService.$inject = ['CompInitCtrlService','PreLoadingProv', 'ProductsService', 'ScriptsService'];
function ProductScriptUpdateInitCtrlService( CompInitCtrlService, PreLoadingProv, ProductsService, ScriptsService) {

    return function ProductScriptUpdateInitCtrlService($ctrl) {
        console.log('ProductScriptUpdateInitCtrlService');

        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl);
        }
        $ctrl.$onInit = $onInit;

        function $onInit() {
         //   $ctrl.LCS.addClass($ctrl.element, 'display-block clearfix h-full');
            var l = [
                {state: 'user.product.scheduling', filter: 'generateschedule', field: 'withDefaultSchedules'},
                {state: 'user.product.shots', filter: 'updateshots', field: 'withDefaultShots'},
                {state: 'user.product.storyboards', filter: 'updatestoryboards', field: 'withDefaultStoryboards'}
            ];

            var updated = false;
            for(var i = 0; i < l.length; i++){
                updated = updateForBackwards(l[i]);
                if(updated){
                    break;
                }
            }

            if(!updated){
                onInit();
            }

            function updateForBackwards (el) {
                if ($ctrl.SBStateService.currentState.name === el.state && $ctrl.CPS.getSearchFilter(el.filter) === true) {
                    var p = {
                        companyId: $ctrl.CPS.companyId,
                        _id: $ctrl.CPS.productId
                    };
                    p[el.field] = false;
                    ProductsService.update(p, function (result) {
                        console.log('on product updated on ' + el.state);
                        onInit();
                    });
                    return true;
                }
            }

            function onInit() {
                load();
                $ctrl.CurrentProduct.onProductChanged($ctrl.watchers, load);
                $ctrl.addRootWatcher('UPDATE_SCRIPT_VERSION', onUpdateScriptVersion);
                $ctrl.addRootWatcher('NEW_SCRIPT_UPLOADED', onNewScriptUploaded);
            }
        }

        return $ctrl;

        function load(result) {
            console.log('onProductChanged');
            var product = result ? result.item : null,
            changes = result ? result.changes : null;
            var scriptUpdated = $ctrl.product ? $ctrl.product.scriptUpdated : false;
            if(product){
                $ctrl.product = product;
            }
            if(!$ctrl.product){return;}
            $ctrl.product.scriptUpdated = false;

            $ctrl.productId = $ctrl.product._id;
            $ctrl.CPS.productId = $ctrl.productId;

            $ctrl.scriptId = $ctrl.product ? ($ctrl.product.previewScriptId ? $ctrl.product.previewScriptId : $ctrl.product.scriptId) : null;
            $ctrl.CPS.scriptId = $ctrl.scriptId;

            if (!$ctrl.copyProduct || $ctrl.copyProduct && ($ctrl.copyProduct._id !== $ctrl.product._id || $ctrl.copyProduct.scriptId !== $ctrl.product.scriptId)) {
                loadScriptInfo(scriptUpdated);
            }

            $ctrl.copyProduct = angular.copy($ctrl.product);

            if (changes) {
                var preLoadingService = PreLoadingProv.getInstance({companyId: $ctrl.CPS.companyId}, PreLoadingProv.PreloadingTypes.Products);
                preLoadingService.modifyChild('ProductsLists', _.extend(changes, {_id: $ctrl.productId}), preLoadingService.Ops.Edit, preLoadingService.Tbl.Products.loadingService.getObjectService().getChangedFieldForUpdate());
                if(changes.name) {
                    var el = $ctrl.LCS.bodyElement.querySelector('.user-top-nav-menu .projectname-li .with-ellipsis');
                    if (el) {
                        el.innerHTML = changes.name.name ? changes.name.name : '';
                    }
                }
            }
            var el = $ctrl.LCS.bodyElement.querySelector('.tab-content');
            if (el) {
                el.scrollTo(0, 0);
            }
        }

        function loadScriptInfo(scriptUpdated) {
            console.log('loadScriptInfo');
            //check if is collaborator
            if (!canLoadScriptInfo()) {
                return;
            }

            if(scriptUpdated) {
                //todo: should work without refreshing the page
                $ctrl.LCS.timeout(function () {
                     //doesnt trigger the update for shotLists and storyboards Lists -> based on script
                     var hardReload = true;
                      $ctrl.CPS.reloadCurrentState(hardReload);
                 }, 200);
                 return;
            }

            $ctrl.CurrentProduct.scriptLoadingService = null;
            var scriptLoadingService = PreLoadingProv.getScriptPreloader({
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.productId,
                scriptId: $ctrl.scriptId,
            });
            scriptLoadingService.preloadTables(function () {
                $ctrl.CurrentProduct.scriptLoadingService = scriptLoadingService;
                $ctrl.broadcastRoot('SCRIPT_LOADING_PROV', scriptUpdated);
            });
        }

        function canLoadScriptInfo() {
            return ($ctrl.CPS.isCollaborator && $ctrl.SBStateService.getStateDataParams().hasScript !== true) ? false : true;
        }

        function onUpdateScriptVersion(script) {
            console.log('UPDATE_SCRIPT_VERSION');
            reloadScript(script);
            //  i18nNotifications.pushForCurrentRoute (null, 'crud.scriptversion.update.success', 'success');
        }

        function onNewScriptUploaded(result) {
            if (result) {
                console.log('NEW_SCRIPT_UPLOADED');
                reloadScript(result.script);
            }
        }

        function reloadScript(script) {
            console.log('reloadScript');
            if (script) {
                script = ScriptsService.convertResource(script);
                var scriptId = script._id;
                $ctrl.product.script = script;
                $ctrl.product.scriptId = scriptId;
                $ctrl.scriptId = scriptId;

                var scripts = $ctrl.CurrentProduct.getScripts(), exists;
                _.each(scripts, function (item, i) {
                    if(item._id === scriptId) {
                        scripts[i] = script;
                        exists = true;
                    }else{
                        scripts[i].isDefault = false;
                    }
                });

                if (!exists) {
                    scripts.push(script);
                }

                $ctrl.CurrentProduct.setScripts(scripts);
                $ctrl.product.scriptUpdated = true;

                $ctrl.CurrentProduct.broadcastProduct($ctrl.product);
            }
        }
    }
}



angular.module('apiConstants.reports.services', [
    'compOptions.reports.constant'
])
.service('ReportsConstantsService', ReportsConstantsService);

ReportsConstantsService.$inject = ['ReportsCompOptions'];

function ReportsConstantsService(compOptions) {
    var Options = {view: 2},

        Settings = {
        },

        Filters = [],

        CompOptions = angular.copy(compOptions);

    return {
        Settings: Settings,
        Options: Options,
        Filters: {Filters: Filters},
        ViewProp: 'reportView',

        CompOptions: CompOptions
    };
}

angular.module('compOptions.reports.constant', [])
.constant('ReportsCompOptions', {
    overviewBlockType: 'reports',
    hasScript: true,
    showVersions: true,

    objectType: 'strip',
    itemTitle: 'Strip',

    showBannerProp: 'showReportsBanner',
    bannerFeatureProp: 'stripboard',
    pageClass: 'page-class reportsPage',

    showShareInListNav: true,
    showShareInListNavExposed: true,

    withCustomReports: false,//true,
    customReportsParams: {step1: 'custom', multipleSelection: false},
});

addRoutingForType('reports', {
    withCommentsSidebar: true,

    title: 'Reports',
    bodyClass: 'breakdowns-report without-print-header',
    withPrint: true
});

