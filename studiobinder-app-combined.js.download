            backdrop: 'static'
        }
    };


    for(var prop in topSettings) {
        Blocks.top[prop] = prop;
    }

    for(var prop in blocksSettings) {
        Blocks.blocks[prop] = prop;
    }

    return {
        ViewProp: 'callsheetView',
        PopupOperations: PopupOperations,
        CompOptions: CompOptions,
        BorderOptions: BorderOptions,
        blocksSettings: blocksSettings,
        topSettings: topSettings,
        Statuses: Statuses,
        PropTypes: PropTypes,
        Columns: Columns,
        Templates: Templates,
        TemplateOptions: TemplateOptions,
        Types: Types,
        TypesInfo: TypesInfo,
        CallsheetStatuses: CallsheetStatuses,
        CastStatuses: CastStatuses,
        getBlockList: getBlockList
    };


    function getBlockList(options, optionsProp) {
        var list = [];
        if(!optionsProp) {
            optionsProp = 'blocks';
        }
        if(!options||!options[optionsProp]){return list;}
        for (var prop in Blocks[optionsProp]) {
            list.push(_.extend({id: prop}, options[optionsProp][prop]));
        }
        list = _.sortBy(list, 'order');
        return list;
    }
}


angular.module('product.callsheet', [
    'product.callsheet.routing',
    'product.callsheet.calltime.routing',
    'callsheet.approval',
    'product.callsheet.columns.popup.component'
]);

angular.module('product.callsheet.init.controller.service', [
    'apiServices.Positions',
    'apiServices.Callsheets',
    'apiServices.Materials',
    'product.callsheet.templates.component',
    'product.callsheet.sendCallsheet.component',
    'product.preLoading.callsheet.group.service',
    'apiConstants.callsheet.services',
    'product.callsheet.init.actions.controller.service'
])
    .service('CallsheetInitCtrlService', CallsheetInitCtrlService);
CallsheetInitCtrlService.$inject = ['CallsheetsService', 'MaterialsService', 'CallsheetInitActionsCtrlService', 'CallsheetConstantsService', 'CallsheetInfoInitCtrlService'];
function CallsheetInitCtrlService(CallsheetsService, MaterialsService, CallsheetInitActionsCtrlService, CallsheetConstantsService, CallsheetInfoInitCtrlService) {
    return function ($ctrl, $element) {
        console.log('CallsheetInitCtrlService');
        $ctrl.CallsheetsService = CallsheetsService;

        $ctrl = new CallsheetInitActionsCtrlService($ctrl);

        onUpdateSubscription();
        $ctrl = new CallsheetInfoInitCtrlService($ctrl);
        $ctrl.$element = $element;
        $ctrl.element = $ctrl.$element && $ctrl.$element.length>0 ? $ctrl.$element[0] : null;

        $ctrl.defaultParams = {
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId,
            callsheetId: $ctrl.callsheetId
        };

        $ctrl.modelOptions = {
            updateOn: 'default blur',
            debounce: {'default': 350, 'blur': 0}
        };

        $ctrl.todayDate = $ctrl.MomentService.getUtcDateNow();
        $ctrl.popupTitle = 'Call Sheet';
        $ctrl.hidePrint = true;
        $ctrl.cast = [];

        $ctrl.Statuses = CallsheetConstantsService.Statuses;
        $ctrl.TypesInfo = CallsheetConstantsService.TypesInfo;
        $ctrl.isShowTemplatesOpened = false;
        //popup when sending the callsheet
        $ctrl.isSendCallsheetPopupOpened = false;
        //share callsheet
        $ctrl.isShareCallsheetPopupOpened = false;

        $ctrl.loadTablesColumns = loadTablesColumns;
        if (!$ctrl.setCallsheet) {
            $ctrl.setCallsheet = setCallsheet;
        }
        $ctrl.getCallsheetTypeInfo = getCallsheetTypeInfo;
        $ctrl.getCallsheetTypeInfoLong = getCallsheetTypeInfoLong;

        $ctrl.updateCopyCallsheet = updateCopyCallsheet;
        $ctrl.showTemplates = showTemplates;
        $ctrl.shareCallsheet = shareCallsheet;
        $ctrl.setCreatedBy = setCreatedBy;

        return $ctrl;

        function loadTablesColumns(opt) {
            var columns = angular.copy(CallsheetConstantsService.Columns);
            var options = opt && opt.columns ? opt.columns.columns : null;
            for (var prop in columns) {
                var c = columns[prop];
                var op = options ? options[prop] : null;
                for (var i = 0; i < c.length; i++) {
                    var show = true;
                    if (op) {
                        for (var j = 0; j < op.length; j++) {
                            if (op[j] === c[i].id) {
                                show = false;
                                break;
                            }
                        }
                    }
                    columns[prop][i].show = show;
                }
            }
            $ctrl.Columns = columns;
        }

        function getCallsheetTypeInfo(callsheet, withCall) {
            return getCallsheetTypeInfoD('title', callsheet, withCall);
        }

        function getCallsheetTypeInfoLong(callsheet, withCall) {
            return getCallsheetTypeInfoD('subject', callsheet, withCall);
        }

        function getCallsheetTypeInfoD(prop, callsheet, withCall) {
            var type = callsheet && callsheet.type ? callsheet.type : 1,
                el = _.find($ctrl.TypesInfo, function (item) {
                    return item.id === type;
                });
            if(withCall && prop === 'subject'){
                return el[prop] + ' Time';
            }

            return withCall && prop === 'title' ? ((type === 1 ? 'Your Call' : el[prop]) + ' Time') : el[prop];

        }

        function updateCopyCallsheet(updates) {
            for (var prop in updates) {
                var val = updates[prop];
                if (prop.indexOf('.') === -1) {
                    $ctrl.copyCallsheet[prop] = val;
                } else {
                    var p = prop.split('.');
                    var p0 = p[0], p1 = p[1];
                    if (p.length === 2) { //options.hideClients
                        if (!$ctrl.copyCallsheet[p0]) {
                            $ctrl.copyCallsheet[p0] = {};
                        }
                        $ctrl.copyCallsheet[p0][p1] = val;
                    } else if (p.length === 3) { //
                        if (!$ctrl.copyCallsheet[p0]) {
                            $ctrl.copyCallsheet[p0] = {};
                        }
                        if (!$ctrl.copyCallsheet[p0][p1]) {
                            $ctrl.copyCallsheet[p0][p1] = {};
                        }
                        $ctrl.copyCallsheet[p0][p1][p[2]] = val;
                    }
                }
            }

            $ctrl.CurrentProduct.setCallsheet($ctrl.callsheet);
        }

        function setCreatedBy(createdBy){
            $ctrl.createdBy = createdBy;
            $ctrl.createdByImage = $ctrl.createdBy?$ctrl.security.getLogoPath($ctrl.createdBy, 'profilePictureURL', 200):

            $ctrl.createdByInit = $ctrl.createdBy ? $ctrl.security.getInitialsByName($ctrl.createdBy.name) : null;
            $ctrl.createdByEmail = $ctrl.createdBy ? $ctrl.createdBy.email : null;
        }

        function setCallsheet(callsheet) {
            $ctrl.copyCallsheet = angular.copy(callsheet);
            $ctrl.callsheet = callsheet;

            //this is necessary when creating callsheet with passed cast
            if (callsheet && callsheet.cast) {
                $ctrl.cast = callsheet.cast;
            }

            $ctrl.callsheetId = callsheet._id;
            if (!$ctrl.createdBy) {
                $ctrl.createdBy = $ctrl.CPS.user;
            }

            $ctrl.setCreatedBy($ctrl.createdBy);
        }

        function onUpdateSubscription() {
            var features = $ctrl.CPS.currentPlan.features;
            if (features) {
                $ctrl.callsheetBuilder = features.callsheetBuilder;
                $ctrl.callsheetPDFs = features.callsheetPDFs;
                $ctrl.callsheetTemplates = features.callsheetTemplates;
                $ctrl.brandedCallsheets = features.brandedCallsheets;
                $ctrl.callsheetApproval = features.callsheetApproval;
                $ctrl.contactMessage = features.callsheetMessages;
            }
        }

        function showTemplates() {
            if (!$ctrl.isShowTemplatesOpened) {
                $ctrl.isShowTemplatesOpened = true;

                $ctrl.popupsService.open(null, $ctrl.popupsService.operations.shareCallsheet, {
                }, $ctrl.compOptions, null,  function  () {
                    $ctrl.isShowTemplatesOpened = false;
                });
            }
        }

        function shareCallsheet(extraParam, e) {
            $ctrl.CPS.loadQuotaPopup('callsheetApproval', process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});

            function process() {
                $ctrl.popupsService.open($ctrl.callsheet, $ctrl.popupsService.operations.shareCallsheet, extraParam, $ctrl.compOptions, null, onsuccess);
                function onsuccess(el) {
                    $ctrl.isShareCallsheetPopupOpened = false;
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.callsheet.share.success', 'success', {name: 'this'});
                    //send event to load approval grid
                }
            }
        }
    }
}


function getCallsheetBlocksBindings(){
    return {
        showWatermark: '@',
        canEdit: '<',
        info:'<?',
        preLoadingService:'<?',
        positions: '<',
        departments: '<',
        isMobileMode: '<',
        preProcessGroupItems: '&'
    }
}

angular.module('product.callsheet.template.init.controller.service', [
    'apiConstants.callsheet.services',
    'product.callsheet.init.controller.service'
])
.service('CallsheetTemplateInitControllerService', CallsheetTemplateInitControllerService);
CallsheetTemplateInitControllerService.$inject = ['CallsheetInitCtrlService', 'TemplateCompileService'];
function CallsheetTemplateInitControllerService(CallsheetInitCtrlService, TemplateCompileService) {
    return function ($ctrl, $element) {
        $ctrl.reloadTemplate = reloadTemplate;
        $ctrl.$onInit = $onInit;
        $ctrl.$onDestroy = $onDestroy;
        $ctrl.preBroadcastPreload = preBroadcastPreload;
        $ctrl.preProcessGroupItems = preProcessGroupItems;
        $ctrl.getCallsheetBlocksTemplate = getCallsheetBlocksTemplate;

        return $ctrl;

        function $onInit() {
            if($ctrl.preInit){
                $ctrl.preInit();
            }

            if(!$ctrl.getItemTemplate){
                console.warn('Parent for CallsheetTemplateInitControllerService must define method $ctrl.getItemTemplate');
            }

            $ctrl = new CallsheetInitCtrlService($ctrl, $element);
            if($ctrl.postInit){
                $ctrl.postInit();
            }

            $ctrl.reloadTemplate();

            $ctrl.addRootWatcher('RELOAD_ALL_CONTACTS', reloadAll);
        }

        function reloadAll(allContacts) {
            console.log('RELOAD_ALL_CONTACTS');
            $ctrl.allContacts = allContacts;
        }

        function reloadTemplate() {
            if(!$ctrl.templateCompile){
                $ctrl.templateCompile = new TemplateCompileService($ctrl.$element, $ctrl.getItemTemplate, $ctrl);
            }

            $ctrl.preBroadcastPreload();
            $ctrl.templateCompile.loadTemplate(onLoaded);
        }

        function onLoaded() {
            if($ctrl.onPageLoaded){
                $ctrl.onPageLoaded();
            }
        }

        function $onDestroy() {
            $ctrl.removeWatchers();
            $ctrl.templateCompile.destroyNewScope();
            if($ctrl.destroy){
                $ctrl.destroy();
            }
        }

        function preBroadcastPreload() {
            $ctrl.productContactListId = $ctrl.CPS.product ? $ctrl.CPS.product.contactListId : null;
            if (!$ctrl.positions) {
                $ctrl.departments = $ctrl.preLoadingService.getList($ctrl.preLoadingService.TblTypes.Departments);
                $ctrl.positions = $ctrl.preLoadingService.getList($ctrl.preLoadingService.TblTypes.Positions);
            }
            $ctrl.allContacts = $ctrl.preLoadingService.getObjectList($ctrl.preLoadingService.TblTypes.Contacts);
        }

        function preProcessGroupItems(item, contact) {
            //console.log('preProcessGroupItems');

            var index = _.findIndex($ctrl.allContacts, function (el) {
                return el._id === item.castId;
            });

            if (index > -1) {
                if (!contact) {
                    contact = $ctrl.allContacts[index];
                } else {
                    $ctrl.allContacts[index] = contact;
                }
            }
            return contact ? _.extend({}, item, {
                name: contact.name,
                email: contact.email,
                phone: contact.phone,
                profilePictureURL: contact.profilePictureURL,
                profilePictureURLId: contact.profilePictureURLId,
            }) : item;
        }
        
        function getCallsheetBlocksTemplate(other) {
            var isMobileMode = $ctrl.ViewModes && $ctrl.isViewMode ? $ctrl.isViewMode($ctrl.ViewModes.Mobile) : false,
                isMobile = $ctrl.LCS.isMobileSize || isMobileMode;
            return '<callsheet-blocks ' +
                'class="callsheet-blocks inner-wizard font-general ' + (isMobile ? 'font-general-13' : 'font-general-12') + '" ' +
                'can-edit="::' + ($ctrl.canEdit === true) + '" ' +
                'pre-loading-service="::$ctrl.preLoadingService" ' +
                'positions="::$ctrl.positions" ' +
                'departments="::$ctrl.departments" ' +
                'pre-process-group-items="$ctrl.preProcessGroupItems(item)" ' +

                'script-loading-service="::$ctrl.scriptLoadingService" ' +
                'is-mobile-mode="::' + isMobileMode + '"' +
                (other ? other : '') +
                '></callsheet-blocks>';
        }
    }
}

angular.module('product.callsheet.init.actions.controller.service', [

])
.service('CallsheetInitActionsCtrlService', CallsheetInitActionsCtrlService);
CallsheetInitActionsCtrlService.$inject = ['CompInitCtrlService', 'DownloadExportService'];
function CallsheetInitActionsCtrlService(CompInitCtrlService, DownloadExportService) {
    return function ($ctrl) {
        console.log('CallsheetInitActionsCtrlService');

        $ctrl.DownloadExportService = DownloadExportService;

        $ctrl.Modes = {Edit:'design', Preview:'view', Recipients:'recipients'};

        $ctrl.ViewModes = {Desktop: 1, Mobile: 2, Inbox: 3, SMS: 4};

        $ctrl.viewMode = $ctrl.ViewModes.Desktop;


        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl);
        }

        $ctrl.getDownloadLink = getDownloadLink;
        $ctrl.downloadAnonLink = downloadAnonLink;

        $ctrl.goToStats = goToStats;
        $ctrl.goToEdit = goToEdit;
        $ctrl.goToView = goToView;
        $ctrl.goToRecipients = goToRecipients;
        $ctrl.goToPreview = goToPreview;
        $ctrl.goToCallsheets = goToCallsheets;
        $ctrl.onAction = onAction;

        $ctrl.getEditParams = getEditParams;
        $ctrl.hrefStats = hrefStats;
        $ctrl.hrefEdit = hrefEdit;
        $ctrl.hrefCallsheets = hrefCallsheets;
        //for grid items on step 3
        $ctrl.hrefPreview = hrefPreview;
        $ctrl.download = download;
        $ctrl.goToSend = goToSend;
        $ctrl.onDestroy = onDestroy;
        $ctrl.bindActions = bindActions;
        if(!$ctrl.getBtnActionCls){
            $ctrl.getBtnActionCls = getBtnActionCls;
        }
        $ctrl.getSidebarNameOther = getSidebarNameOther;
        $ctrl.hasSidebar = hasSidebar;
        return $ctrl;

        function hasSidebar(){
            return $ctrl.canEdit;
        }
        function getSidebarNameOther(){
            return ($ctrl.mode||'') + '_' + $ctrl.canEdit;
        }

        function getBtnActionCls(){
            return 'btnAction';
        }

        function bindActions(isBind){
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('.' + $ctrl.getBtnActionCls()), $ctrl.onAction);
        }

        function onAction(e){
            //console.log('onAction');
            var el = e.currentTarget,
                type = el ? el.getAttribute('data-type') : null,
                data = el ? el.getAttribute('data-info') : null;

            if(el && type==='close' && $ctrl.LCS.findClosestParent('.close-icon')){ // allow click on btn close

            } else{
                $ctrl.preventDefault(e);
            }
            if(type && typeof($ctrl[type]) === 'function') {
                $ctrl[type](data, e);
            }else{
                console.warn('TemplateCompileActionsService: method ' + type + ' is not defined');
            }
        }

        function onDestroy() {
            console.log('onDestroy');
            $ctrl.bindActions(false);
        }

        function download(data, e) {
           //  $ctrl.preventDefault(e);
            console.log('download callsheet');
            var currentTarget = e.currentTarget;
            if (!$ctrl.callsheetPDFs) {
                $ctrl.CPS.loadQuotaPopup('callsheetPDFs', process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});
            } else {
                process();
            }

            function process() {
                var m = 'crud.callsheet.download.',
                    p = getEditParams();

                $ctrl.i18nNotifications.pushForCurrentRoute(null, m + 'success.general', 'success');

                $ctrl.DownloadExportService.downloadBlobFile($ctrl.CallsheetsService.download(p), p, onsuccess, onerror, false);

                function onsuccess(url, filename) {
                    if (currentTarget) {
                        currentTarget.setAttribute('href', url);
                        currentTarget.setAttribute('download', filename);
                     //   currentTarget.click();
                    }

                    $ctrl.isUpdating = false;

                    if ($ctrl.onClose) {
                        $ctrl.onClose({result: 'cancel'});
                    }
                }

                function onerror(err) {
                    $ctrl.isUpdating = false;
                    console.log("Could not get signed URL.");
                    $ctrl.error = $ctrl.localizedMessages.getFromError(err, m + 'error');
                }
            }
        }

        function getDownloadLink(item) {
            if ($ctrl.callsheetPDFs) {
                return $ctrl.security.getGeneratorUrl() + $ctrl.CallsheetsService.getDownloadLink({
                    callsheetId: item._id,
                    productId: item.productId,
                    companyId: item.companyId
                });
            }
            return '';
        }

        function downloadAnonLink(e) {
            $ctrl.CPS.loadQuotaPopup('callsheetPDFs', process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}));

            function process() {
                if ($ctrl.callsheetPDFs && $ctrl.callsheet.callsheetSentId) {
                    $ctrl.MaterialsService.getDownloadLink({
                        id: $ctrl.callsheet.materialId,
                        versionId: $ctrl.callsheet.callsheetSent.materialVersionId,
                        productId: $ctrl.CPS.productId,
                        companyId: $ctrl.CPS.companyId
                    }, function (link) {
                        $ctrl.SBStateService.assignUrl(link, 500);
                        return false;
                    }, function (err) {
                        console.log(err)
                    });
                }
            }
        }

        function hrefPreview(isTransition, callsheetId) {
            return getHref('view', isTransition, null, callsheetId);
        }

        function hrefEdit(isTransition, callsheetId, mode) {
            return getHref('edit', isTransition, {mode: mode? mode : $ctrl.Modes.Design}, callsheetId);
        }

        function hrefStats(isTransition, callsheetId) {
            return getHref('confirmations', isTransition, null, callsheetId);
        }

        function getHref(page, isTransition, other, callsheetId) {
            return getM(isTransition)('user.product.callsheet.' + page, getEditParams(other, callsheetId));
        }

        function hrefCallsheets(isTransition, callsheetId) {
            return getM(isTransition)('user.product.callsheets-list', $ctrl.CPS.currentProductPathParams());
        }

        function getEditParams(other, callsheetId) {
            return $ctrl.CPS.currentProductPathParams(_.extend({callsheetId: callsheetId ? callsheetId : $ctrl.callsheetId}, other));
        }

        function getM(isTransition) {
            if (isTransition) {
                $ctrl.broadcastRoot('HIDE_MOBILE_DETAILS');
            }
            return $ctrl.CPS[isTransition ? 'transitionTo' : 'getStateHref'];
        }

        function goToStats(e) {
            isIsEdit(e, function () {
                $ctrl.hrefStats(true);
            });
        }

        function goToView(e){
            isIsEdit(e, function () {
                $ctrl.hrefPreview(true);
            });
        }

        function goToEdit(e){
            isIsEdit(e, function () {
                $ctrl.hrefEdit(true, null, $ctrl.Modes.Edit);
            });
        }

        function goToPreview(e){
            isIsEdit(e, function () {
                $ctrl.hrefEdit(true, null, $ctrl.Modes.Preview);
            });
        }

        function goToRecipients(e){
            isIsEdit(e, function () {
                $ctrl.hrefEdit(true, null, $ctrl.Modes.Recipients);
            });
        }

        function goToCallsheets(e){
            isIsEdit(e, function () {
                $ctrl.hrefCallsheets(true);
            });
        }

        function goToSend(e){
            isIsEdit(e, function () {
                $ctrl.broadcastRoot('SEND_CALLSHEET');
            });
        }

        function isIsEdit(e, next){
            $ctrl.preventDefault(e);
            if($ctrl.LCS.editedField){
                $ctrl.broadcastRoot('CLOSE_EDITABLE_FIELD_' + $ctrl.LCS.editedField.id, $ctrl.LCS.editedField.prop);
                $ctrl.LCS.editedField = null;
                $ctrl.LCS.timeout(next, 600);

            } else{
                next();
            }
        }
    }
}

angular.module('product.callsheet.page.init.controller.service', [
    'apiConstants.callsheet.services',
    'product.callsheet.info.init.controller.service'
])
.service('CallsheetPageInitCtrlService', CallsheetPageInitCtrlService);
CallsheetPageInitCtrlService.$inject = ['PageSimpleInitCtrlService', 'CallsheetConstantsService','CallsheetInfoInitCtrlService'];
function CallsheetPageInitCtrlService(PageSimpleInitCtrlService, constantsService, CallsheetInfoInitCtrlService) {
    return function ($ctrl, $element) {
        console.log('CallsheetPageInitCtrlService');
        $ctrl.postponeLoadCheatSheet = true;
        $ctrl.withPreloaderProperty = withPreloaderProperty;

        $ctrl = new PageSimpleInitCtrlService($ctrl, $element, {
            constantsService: _.extend({}, constantsService),
        });

        $ctrl.initPage = initPage;
        $ctrl.reloadCallheetPage = reloadCallheetPage;
        $ctrl.onPageDestroy = $ctrl.onSimplePageDestroy;

        return $ctrl;

        function initPage($templateElement) {
            if (!$ctrl.getPageTemplate) {
                console.warn('parent for CallsheetPageInitCtrlService must define getPageTemplate');
            }

            $ctrl.$templateElement = $templateElement;
            $ctrl = new CallsheetInfoInitCtrlService($ctrl);

            $ctrl.onSimplePageInit({
                withPreloaderProperty: withPreloaderProperty,
                preloadingType: $ctrl.PreloadingTypes.Callsheet,
                loadingParams: {
                    isCollaborator:$ctrl.CPS.isCollaborator
                },
            }, startPreload);

            function startPreload(preLoadingService){
                $ctrl.preLoadingService = preLoadingService;
                $ctrl.preLoadingService.preloadedAbove = true;
                $ctrl.reloadCallheetPage();
            }
        }

        function withPreloaderProperty() {
            return {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                callsheetId: $ctrl.callsheetId
            }
        }

        function reloadCallheetPage() {
            $ctrl.isFirstCSReload = true;
            $ctrl.reloadPageTemplate(false, onPageLoadedInit);

            function onPageLoadedInit() {
                if($ctrl.isFirstCSReload) {
                    $ctrl.emitUpdateCheatsheet();
                    $ctrl.isFirstCSReload = false;
                }
                if($ctrl.onPageLoaded){
                    $ctrl.onPageLoaded();
                }
            }
        }
    }

}

angular.module('product.callsheet.columns.popup.component', [
])
.component('callsheetColumnsPopup', popupComponentParams("CallsheetColumnsPopupCtrl"))
.controller('CallsheetColumnsPopupCtrl',CallsheetColumnsPopupCtrl);

CallsheetColumnsPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', 'CallsheetsService', '$element'];
function CallsheetColumnsPopupCtrl(ItemTemplateCompileCtrlService, service, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.dontAutoloadTemplate = false;
    $ctrl.formName = 'formItem';
    $ctrl.dontShowActivity = true;
    $ctrl.save = save;
    $ctrl.onLoaded = onLoaded;
    $ctrl.preInit = preInit;
    $ctrl.onDestroy = onDestroy;
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInit() {
        $ctrl.withBtnDisabled = true;
        $ctrl.modalBodyFormClass = 'long390';
        $ctrl.optionsProp = 'blocks';

        $ctrl.service = service;
        $ctrl.csBlockColor = $ctrl.LCS.csBlock.color;
        $ctrl.csHexBlockColor = $ctrl.LCS.hexToRgba($ctrl.csBlockColor, 0.1);

        $ctrl.block = $ctrl.extraParam.block;
        $ctrl.callsheetId = $ctrl.extraParam.callsheetId;

        var CallsheetConstantsService = $ctrl.extraParam.CallsheetConstantsService;
        var settings = CallsheetConstantsService[$ctrl.optionsProp + 'Settings'][$ctrl.block];
        $ctrl.hideEditCols = settings && settings.hideEditCols === true;

        var columnType = settings ? settings.columnType : null;
        var columns = CallsheetConstantsService.Columns[columnType ? columnType : $ctrl.block];
        if (columnType) {
            var c = [];
            _.each(settings.columns, function (id) {
                c.push(columns[id]);
            });
            $ctrl.Columns = c.length > 0 ? c : null;
        } else {
            $ctrl.Columns = columns;
        }


        $ctrl.formHolderItem = {};
        $ctrl.prevItem = _.clone($ctrl.item);
        $ctrl.colList = [].concat($ctrl.item.columns);
        $ctrl.colListInit = [].concat($ctrl.colList);
        $ctrl.list = getSortedColumns($ctrl.Columns);
    }

    function getSortedColumns(columns) {
        var list = [];
        for (var prop in columns) {
            processItem(list, columns[prop]);
        }
        return getSortedList(list);
    }

    function compareItem(id1, id2) {
        return id1.toString() === id2.toString();
    }
    function processItem(list, el) {
        if (el && _.find(list, function(item){return compareItem(item.id, el.id);}) === undefined) {
            list.push(el);
        }
    }

    function getSortedList(list) {
        return list && list.length > 0 ? _.sortBy(list, 'order') : null;
    }

    function setTemplateData() {
        $ctrl.withFooterBtns = true;
        $ctrl.withBtnDisabled = true;
        $ctrl.icon = $ctrl.item.icon ? $ctrl.item.icon : 'cog';
        $ctrl.iconLevel = $ctrl.item.iconLevel ? $ctrl.item.iconLevel : 2;
        $ctrl.popupTitle = 'Grid Settings';
        $ctrl.subtitle = '<b>'+$ctrl.item.title+'</b> Grid';
        $ctrl.btnText = '<span>Save</span><span class="hide-ipad"> Settings</span>';
        $ctrl.textAnalytics = 'Update ' + $ctrl.item.title + ' ' + $ctrl.popupTitle;
        $ctrl.itemTilte = 'Grid';
    }

    function getPopupBodyContent() {
        var hasCols = $ctrl.list && $ctrl.list.length > 0;
return '<form name="$ctrl.formHolderItem[$ctrl.formName]" class="formHolderItem auto" novalidate autocomplete="off">' +
            '<div>' +
                '<label class="header thin clearfix spacing-half-top">Header Options</label>' +
                '<div class="form-group field">' +
                    '<input class="form-control with-underline '+$ctrl.pageClass+'" type="text" id="name" name="name" ng-model="$ctrl.item.title" required placeholder="Grid name…">' +
                    '<label ng-show="$ctrl.item.title" class="with-label">Grid name</label>'+
                    '<div ng-show="($ctrl.formHolderItem[$ctrl.formName].name.$dirty || $ctrl.formHolderItem[$ctrl.formName+\'_attempted\']) && $ctrl.formHolderItem[$ctrl.formName].name.$error.required" class="help-inline ng-hide" style="top: 30px;">Grid name is required</div>' +
                '</div>'+

                '<div class="form-group filters-shotlist columns-2">' +
                    '<ul class="listitems-selector with-checked">' +
                        getC('showHeaderIcon', 'Grid Icon', true) +
                    (hasCols ? getC('showHeader', 'Column Labels', false) : '' )+
    ($ctrl.item.canHave2Cols ? getC('twoCols', 'Two-Column Layout', false) : '' )+
                    '</ul>'+
                '</div>' +
            '</div>' +
            getCols() +
    '</form>';

            function getCols(){
                if(!(!$ctrl.hideEditCols && hasCols)){return '';}
                var columnsCount = $ctrl.list.length > 6 ? 3 : ($ctrl.list.length % 3 === 0 ? 3 : 2),
                    t = '',
                    isSwitch = true;
                _.each($ctrl.list, function (col) {
                    var n = col.nameLong ? col.nameLong : (col.shortName ? col.shortName : col.name);
                    if (n.length > 30) {
                        n = n.substring(0, 30) + '…';
                    }
                    if(col.notInFilter){}
                    else {
                        var isDisabled = col.canHide !== true;
                        t += '<li data-id="' + col.id + '" class="table-div with-cursor" ' +
                                (isDisabled ? 'data-disabled="true"' : '') +
                             '>' +
                                '<div class="custom-checkbox ' + $ctrl.pageClass +
                            (isSwitch ? ' switch display-block' :' inrow centered') +
                            (isDisabled ? ' disabled' : '') +
                            '">' +
                                    '<label' + (isSwitch ? ' class="i-switch radiobtn"' : '') + '>' +
                                        '<input type="checkbox" ' +
                                        (isDisabled ? 'disabled="disabled" ' : '') +
                                        (isColumn(col.id) ? 'checked="checked"' : '') +
                                       '>' +
                                        (isSwitch ? ('<i></i>') : ('<span></span>')) +
                                    '</label>' +
                                '</div>' +
                                '<span class="text-left">' + n + '</span>' +
                            '</li>';
                    }
                });
                return '<div class="margin-top-half">'+
                        '<label class="header thin clearfix spacing-half">Display Columns</label>' +
                        '<div class="form-group filters-shotlist columns-'+columnsCount+'">' +
                            '<ul class="columns-ul listitems-selector with-checked">' + t + '</ul>' +
                        '</div>'+
                    '</div>';
            }

    }

    function processList(m, c){
        _.each(['showHeader', 'showHeaderIcon', 'twoCols'], function (i){
            if(!c || c &&c[i]) {
                m(i);
            }
        });
    }
    function getC(prop, name, isLast){
        var isSwitch = true;
return '<li class="table-div with-cursor '+prop+'">' +
            '<div class="form-group field table-div with-cursor '+(isLast?'last':'')+' ' + prop + '">' +
                '<div class="custom-checkbox ' + $ctrl.pageClass +
                        (isSwitch ? ' switch display-block' :' inrow centered') +
                    '">' +
                    '<label' + (isSwitch ? ' class="i-switch radiobtn"' : '') + '>' +
                        '<input type="checkbox" ' +
                            ($ctrl.item[prop]? 'checked="checked"' : '') +
                        '>' +
                        (isSwitch ? ('<i></i>') : ('<span></span>')) +
                    '</label>' +
                '</div>' +
                '<span class="text-left">' + name + '</span>' +
            '</div>' +
        '</li>';
    }

    function onLoaded() {
        $ctrl.layoutEl = $ctrl.element.querySelector('.columns-ul');
        if($ctrl.layoutEl) {
            $ctrl.liEls = $ctrl.layoutEl.querySelectorAll('li');
        }
        $ctrl.element.querySelector('#name').focus();
        bind(true);
    }

    function onDestroy() {
        bind(false);
    }

    function bind(isBind)  {
        if($ctrl.liEls){
            _.each($ctrl.liEls, function(el){
                var isDisabled = el.getAttribute('data-disabled');
                if(isDisabled !== 'true' && isDisabled !== true) {
                    $ctrl.LCS.bindElementsClick(isBind, el, toggleLi);
                }
            });
        }

        processList(set);

        //for recipients grid to support 2 columns on view
        //  $ctrl[prop + 'El'] = $ctrl.element.querySelector('.' + prop);
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.liLayout, toggleLayout);

        function set(prop) {
            $ctrl[prop + 'El'] = $ctrl.element.querySelector('.' + prop);
            $ctrl.LCS.bindElementsClick(isBind, $ctrl[prop + 'El'], get(prop));

            function get(prop) {
                return function(e) {
                    $ctrl.preventDefault(e);
                    var el = e.currentTarget,
                        checkEl = el.querySelector('input');
                    if ($ctrl.item[prop]) {
                        $ctrl.item[prop] = false;
                        checkEl.removeAttribute('checked');
                    } else {
                        $ctrl.item[prop] = true;
                        checkEl.setAttribute('checked', 'checked');
                    }
                }
            }
        }
    }

    function toggleLi(e) {
        console.log('toggleLi');
        $ctrl.preventDefault(e);
        var el = e.currentTarget,
            id =  el.getAttribute('data-id'),
            isDisabled = el.getAttribute('data-disabled'),
            checkEl = el.querySelector('input');

        if (isDisabled === 'true' || isDisabled === true) {
            return;
        }
        if (isColumn(id)) {
            $ctrl.colList = _.reject($ctrl.colList, function (col) {
                return compareItem(col, id);
            });
            checkEl.removeAttribute('checked');
        } else {
            $ctrl.colList.push(id);
            checkEl.setAttribute('checked', 'checked');
        }
    }

    function isColumn(id) {
        return _.find($ctrl.colList, function (el) {
            return compareItem(el, id);
        });
    }

    function iSelectedLayout(prop) {
        return $ctrl.block[prop] === true;
    }

    function toggleLayout(e) {
        $ctrl.preventDefault(e);
        var liEl = e.currentTarget,
            id = parseInt(liEl.getAttribute('data-id'), 10),
            checkEl = liEl.querySelector('input');

        if (iSelectedLayout(id)) {
            $ctrl.block[id] = false;
            checkEl.removeAttribute('checked');
        } else {
            $ctrl.block[id] = true;
            checkEl.setAttribute('checked', 'checked');
        }
    }

    function save(){
        var result;
        if($ctrl.isUpdating){return;}
        $ctrl.error = null;

        $ctrl.formHolderItem[$ctrl.formName + '_attempted'] = true;
        if (!$ctrl.formHolderItem[$ctrl.formName] || !$ctrl.formHolderItem[$ctrl.formName].$valid) {
            return;
        }

        $ctrl.isUpdating = true;
        var lUpdates = {}, sUpdates = {}, lChanged, sChanged;
        if (!$ctrl.hideEditCols && !_.isEqual($ctrl.colListInit, $ctrl.colList)) {
            lUpdates.columns = $ctrl.colList;
            lChanged = true;
        }

        if ($ctrl.item.title !== $ctrl.prevItem.title) {
            lUpdates.title = $ctrl.item.title;
            lChanged = true;
        }

        processList(p);

        if (lChanged || sChanged) {
            result = {};
            if (sChanged) {
                result.sUpdates = sUpdates;
            }
            if (lChanged) {
                result.lUpdates = lUpdates;
            }
        }

        if(result){
            process(result);
        } else{
            $ctrl.isUpdating = false;
            close();
        }

        function p(prop){
            if ($ctrl.item[prop] !== $ctrl.prevItem[prop]) {
                sUpdates[prop] = $ctrl.item[prop];
                sChanged = true;
            }
        }

        function process(info) {
            console.log('onclose openEditSettings');
            var updates = _.extend({}, result.lUpdates, result.sUpdates);
            update(updates, function (options) {
                $ctrl.broadcastRoot('GROUP_BLOCK_' + $ctrl.block + '_CHANGED', updates);
                var info = {};
                info[$ctrl.block]= updates;
                $ctrl.broadcastRoot('CALLSHEET_'+$ctrl.optionsProp.toUpperCase()+'_CHANGED', {info: info});
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.callsheet.columnUpdates.success', 'success');

                close()
            }, 'columnUpdates');
        }

        function close(){
            if (typeof ($ctrl.onClose) === 'function') {
                $ctrl.onClose({result: 'cancel'});
            }
        }

        function update(updates, onSuccess, errorType) {
            var params = {
                _id: $ctrl.callsheetId,
                dontShowActivity: $ctrl.dontShowActivity
            };
            for (var info in updates) {
                params['options.' + $ctrl.optionsProp + '.' + $ctrl.block + '.' + info] = updates[info];
            }

            $ctrl.service.update(params, function(info) {
                $ctrl.isUpdating = false;
                var item = info ? info.item : null;
                if (item) {
                    var options = item.options[$ctrl.optionsProp][$ctrl.block];
                    var callsheet = angular.copy($ctrl.CurrentProduct.getCallsheet());
                    callsheet.options[$ctrl.optionsProp][$ctrl.block] = options;
                    if(item._id === callsheet._id){
                        $ctrl.CurrentProduct.setCallsheet(callsheet);
                    }
                    onSuccess(options);
                }
            }, function (error) {
                $ctrl.isUpdating = false;
                console.log(error);
            });
        }
    }
}

angular.module('product.callsheet.edit.templates.component', [
    'apiServices.CallsheetTemplates',
    'apiConstants.callsheet.services',
    'ctrl.PopupsCtrl.service'
])
.component('callsheetTemplates', {
    bindings: {
        value: '<?',
        pageClass:'<',
        onChange: '&'
    },
    controller: 'CallsheetTemplatesController',
})
.controller('CallsheetTemplatesController', CallsheetTemplatesController);
CallsheetTemplatesController.$inject = ['TemplateCompileCompCtrlService', 'CallsheetTemplatesService', 'CallsheetConstantsService', '$element'];
function CallsheetTemplatesController(TemplateCompileCompCtrlService, service, CallsheetConstantsService, $element) {
    console.log('CallsheetTemplatesController');
    var predefId;
    var $ctrl = this;

    $ctrl.CallsheetConstantsService = angular.copy(CallsheetConstantsService);

    $ctrl.service = service;

    $ctrl.dontAutoloadTemplate = true;
    $ctrl.quotaType = 'callsheetTemplates';
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInit = preInit;
    $ctrl.removeTemplate = removeTemplate;
    $ctrl.setTemplate = setTemplate;
    $ctrl.isTemplate = isTemplate;
    $ctrl.onLoaded = onLoaded;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function getItemTemplate() {
        if (!$ctrl.isLoaded) {
            return '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
        }

        var val =  '';
        var index = 0;
        _.each($ctrl.templates, function (t) {
            var c = t.color ? t.color : '#00BF89',
                icon = t.isPredefined === true ? t.icon : 'calendar-template';
            val += '<li class="'+$ctrl.getBtnActionCls()+ ($ctrl.isTemplate(t) ? ' active' : '') + '" data-type="setTemplate" data-info="' + t._id + '">' +
                '<div class="box centering" style="background-color:' + c + '"><div>' +
                    $ctrl.LCS.getISBDiv(icon, 3, icon === 'sides' ? '':'sbf28', 'style="' +
                        (icon === 'photocamera' ? 'margin-left: -2px;':'') +
                        'color:' + c + '"') +
                '</div></div>' +
                '<div class="info text-center"><span class="with-transition"' +
                //' tooltip="' + (t.name.length > 25 ? t.name : '') + '" tooltip-placement="bottom"' +
                '>' + t.name.substring(0, 23) + '</span></div>' +
            (t.isPredefined ? '' : ('<div class="sbf wrong gray with-transition '+$ctrl.getBtnActionCls()+'" data-type="removeTemplate" data-info="' + t._id + '"></div>')) +
            '</li>';
            index++;
        });
    return '<div class="show-scrollbar-on-hover whitescroll"><ul class="calendar-type spacing-half-type callsheet centering fancy-scrollbar ultrathin text-center max-height-400">' +
        val +
        '</ul></div>';
    }

    function preInit() {
        $ctrl.reloadTemplate();
        $ctrl.service.getAll({companyId: $ctrl.CPS.companyId}, null, null, process, onerror);

        function process(templates) {
            $ctrl.isLoaded = true;

            var temp = $ctrl.CallsheetConstantsService.Templates;
            //simplified for ppl on free
            predefId = $ctrl.CPS.hasQuotaType('callsheetAdvanced') ? temp[0]._id : temp[1]._id;

            if (templates && templates.length > 0) {
                temp = temp.concat(templates);
            }

            $ctrl.templates = temp;
            setTemplate(predefId, null, true);
            $ctrl.reloadTemplate();
        }

        function onerror(err) {
            console.log(err);
            process();
        }
    }

    function onLoaded(){
        if($ctrl.isLoaded) {
            $ctrl.timeoutP = $ctrl.LCS.timeout(function () {
                $ctrl.bindActions(true);
            }, 200);
            if(!$ctrl.isNotFirstTime && $ctrl.template){
                setActive($ctrl.template, true);
                $ctrl.isNotFirstTime = true;
            }
        }
    }

    function removeTemplate(id, e) {
        var target = e.target;
        var item = getItem(id);
        if (!item) {
            return;
        }
        $ctrl.error = null;

        var withconfirm = true;
        if (withconfirm) {
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations.confirmSmall, {
                btn: 'Remove Template',
                icon: 'trash',
                title: 'Are you sure?',
                pageClass: $ctrl.pageClass,
                message: '<p class="text-center">Are you sure you want to permanently remove this template? Removing it will not affect existing call sheets.</p>',
                onConfirm: onConfirm
            });
        } else {
            onConfirm();
        }

        function onConfirm(result) {
            console.log('onConfirm')
            var item = getItem(id);
            if (!item) {
                return;
            }
            $ctrl.error = null;
            $ctrl.service.delete({_id: id}, function (el) {
                if (el.item) {
                    el = el.item;
                }
                for (var i = $ctrl.templates.length - 1; i >= 0; i--) {
                    if ($ctrl.templates[i]._id === id) {
                        $ctrl.templates.splice(i, 1);

                        $ctrl.LCS.removeElement($ctrl.LCS.findClosestParent(target, 'li'));
                        if ($ctrl.value === el._id) {
                            $ctrl.value = predefId;
                        }
                    }
                }
                oncomplete('success');
                $ctrl.LCS.removeElement($ctrl.LCS.findClosestParent(target, 'li'));
            }, function (err) {
                oncomplete('error');
            });
        }
        function oncomplete(type) {
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.callsheetTemplate.Remove.' + type, type, {name: item.name});
        }
    }

    function getItem(id){
        return id ? _.find($ctrl.templates, {_id: id}) : null;
    }

    function setTemplate(id, e, isInit) {
        if (isInit) {
            process();
        } else {
            $ctrl.CPS.loadQuotaPopup($ctrl.quotaType, process, null, null, JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});
        }

        function process() {
            console.log('setTemplate' + id);
            setActive($ctrl.template, false);
            var t = getItem(id);
            setActive(t, true);

            $ctrl.template = t;

            $ctrl.value = id;
            $ctrl.onChange({
                selected: t.isPredefined ? _.extend({}, t, {
                    options: $ctrl.CallsheetConstantsService.TemplateOptions['c_' + id]
                }) : t
            });
        }
    }

    function setActive(item, isActive) {
        $ctrl.LCS[isActive ? 'addClass' : 'removeClass']($ctrl.element.querySelector('li[data-info="' +  (item ? item._id : 'null') + '"]'), 'active');
    }

    function isTemplate(id) {
        return id === $ctrl.value;
    }
}

angular.module('product.callsheet.item.type.component', [
    'product.callsheet.item.step1.popup.controller.service'
])
.component('callsheetTypePopup', popupComponentParams('CallsheetTypeController'))
