GanttRowsManagerFactory.$inject = ['GanttRow', 'ganttArrays', '$filter', '$timeout', 'GanttMoment'];
function GanttRowsManagerFactory(Row, arrays, $filter, $timeout, GanttMoment) {
    var RowsManager = function(gantt) {
