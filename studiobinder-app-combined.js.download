        },

        createListWithBg: getBGItemPopup('Create'),
        updateListWithBg: getBGItemPopup('Edit')
    };
    function getBGItemPopup(type) {
        return _.extend({type: type}, {
            template: getBasePopupTemplateByTag('tree-list-edit'),
            size: '850',
            transp: ' ',
            backdrop: 'static'
        });
    }

    var _this = {
        operations:  $CtrlPopupOperations,
        add: add,
        addList: addList,
        close: close
    };

    return _this;

    function add(key, val) {
        _this.operations[key] = val;
    }

    function addList(list) {
        for(var key in list){
           _this.add(key, list[key]);
        }
    }

    function close(result, modalId) {
        console.log('PopupsOperations.close');
        console.log(result);
        //PopupsService.closePopup(result ? result : 'cancel', modalId);
    }
}

function popupInlineComponentParams(withoutCompOptions) {
    return _.extend({
        modalId: '<?',
        item: '<?',
        type: '<?',
        extraParam: '<?',
        onClose: '&'
    }, withoutCompOptions ? {} : {compOptions: '<'})
}

function popupComponentParams(controllerName, withoutCompOptions) {
    return {
        bindings: popupInlineComponentParams(withoutCompOptions),
        controller: controllerName,
    }
}

angular.module('ctrl.popups.service', [
    'ctrl.popups.defaultPopup.controller',
    'ctrl.popups.operations',
    'services.sessionService',
    'ctrl.popups.confirm.component'
])
.service('PopupsService', PopupsService) ;

PopupsService.$inject = ['$modal', 'PopupsOperations'];

function PopupsService($modal, PopupsOperations ) {
    var modalInstances = [];
    var _this = {
        isOpen: {},
        PopupsConstant: PopupsOperations.operations,
        open: open,
        openPopup: openPopup,
        closePopup: closePopup,
        closePopupByType: closePopupByType,
        closeTopPopup: closeTopPopup
    };

    return _this;

    function addModal(modalId, modalInstance) {
        modalInstances.push({id: modalId, modal: modalInstance});
    }

    function getModalIndex(modalId) {
        if (modalId) {
            var index = _.findIndex(modalInstances, {id: modalId});
            if (index !== -1) {
                return index;
            }
        }
        return modalInstances.length > 0 ? (modalInstances.length - 1) : -1;
    }

    function closePopupByType(type) {
        var popup = _this.isOpen[type];
        if (popup) {
            closePopup('cancel', popup.modalId);
        }
    }

    function closeTopPopup( ) {
        var l = modalInstances ? modalInstances.length : 0;
        if(l > 0){
            closePopupByType(null, modalInstances[l-1].modal.type);
        }
    }
    function closePopup(result, modalId) {
        //console.log('closePopup');
        var index = getModalIndex(modalId);

        if (index !== -1) {
            var modal = get(modalInstances[index]);
            modalInstances.splice(index, 1);
            if (modal && modal.opened.$$state.value) {
                modal.close(result);
            }
        }

        function get(item) {
            return item ? item.modal : null;
        }
    }

    function open(selected, operation, extraParam, compOptions, service, onSuccessPopup, getNotification, closePrevious) {
        var withScope = false,
            isNotCopy = false;

        if (!operation.withService) {
            //console.log('double check if you need to inherit operation.withService to have the service from the parent in the popup');
        }
        if (!extraParam) {
            extraParam = {};
        }
        if (operation.withService) {
            if (!extraParam.service) {
                extraParam.service = service;
            }
        }
        var defaultParams = {
            item: function () {
                return isNotCopy ? (selected || null) : (selected ? _.clone(selected) : null);
            },
            compOptions: function () {
                return compOptions;
            },
            extraParam: function () {
                return extraParam;
            }
        };

        return openPopup(operation, defaultParams, withScope, onSuccessPopup, getNotification, closePrevious);
    }

    function openPopup(operation, defaultParams, withScope, onSuccessPopup, getNotification, closePrevious) {
        //console.log('openPopup');
        var params = loadParams(operation, defaultParams, withScope),
            opType = operation.type;

        if (closePrevious) {
            closePopupByType(opType);
        }

        var popup = openCustomPopup(params, onSuccess, onError);
        _this.isOpen[opType] = popup;
        return popup;

        function onSuccess(result) {
            if (result !== 'cancel' && typeof (onSuccessPopup) === 'function') {
                onSuccessPopup(result, result && result.operationType ? result.operationType : opType);
            }

            delete _this.isOpen[opType];
        }

        function onError(error) {
            if (error !== 'cancel' && error !== 'backdrop click' && error !== 'escape key press') {
                getNotification(error, opType, false);
            }
        }
    }

    function openCustomPopup(params, onSuccess, onError) {
        var modalId = new ObjectId().toString();
        if (!params.controller) {
            params.controller = 'DefaultPopupCtrl';
        }
        params.controllerAs = '$ctrl';
        params.resolve.modalId = function () {
            return modalId;
        };

        var modalInstance = $modal.open(params);
        modalInstance.modalId = modalId;
        modalInstance.result.then(function (success) {
            //console.log('modalInstance closePopup');
            if (typeof (onSuccess) === 'function') {
                onSuccess(success);
            }
            /*  if (success) {
             securityRetryQueue.retryAll();
             } else {
             securityRetryQueue.cancelAll();
             }*/
        }, function (error) {
            if (typeof (onError) === 'function') {
                onError(error);
            }
        });

        addModal(modalId, modalInstance);

        return modalInstance;
    }

    function loadParams(operation, defaultParams, withScope) {
        var params = {
            size: operation.size ? operation.size : 'sm',
        };

        var v = operation.templateUrl ? 'templateUrl' : 'template';
        params[v] = operation[v];

        if (operation.controller) {
            params.controller = operation.controller;
            params.controllerAs = '$ctrl'
        }

        if (withScope) {
            params.scope = withScope;
        } else {
            params.resolve = _.extend({}, defaultParams, {
                type: function () {
                    return operation.type;
                }
            });
        }

        if (operation.transp) {
            params.transp = operation.transp;
        } //transp

        if (operation.backdrop !== undefined) {
            params.backdrop = operation.backdrop;
        }
        if (operation.keyboard !== undefined) {
            params.keyboard = operation.keyboard;
        }
        //static
        if (operation.backdropClass) {
            params.backdropClass = operation.backdropClass;
        }

        if (operation.withGrayBg) {
            params.withGrayBg = operation.withGrayBg;
        }

        if (operation.modalClass) {
            params.modalClass = operation.modalClass;
        }

        return params;
    }
}

angular.module('ctrl.PopupsCtrl.service', [
    'ctrl.popups.service',
    'services.sessionService',
    'ctrl.popups.columnSettings.component',
    'ctrl.PopupsCtrl.service.viewNotesPopup.component',
    'ctrl.PopupsCtrl.generalItemEditPopup.component',
    'ctrl.PopupsCtrl.generalItemEdit.service'
])
.service('PopupsCtrlService',PopupsCtrlService);

PopupsCtrlService.$inject = ['PopupsService', 'SessionService', 'security', 'LCS'];

function PopupsCtrlService(PopupsService, SessionService, security, LCS) {
    var _this = this;
    _this.PopupsService = PopupsService;
    if (!_this.operations) {
        //console.log('load operations in openpopup');
        _this.operations = PopupsService.PopupsConstant;
    }

    _this.open = open;

    _this.removeItem = removeItem;
    _this.loadQuotaPopup = loadQuotaPopup;
    _this.checkQuota = checkQuota;
    _this.collaboratorPermissions = collaboratorPermissions;
    _this.ownerAccess = ownerAccess;
    _this.teamAccess = teamAccess;
    _this.teamAdminAccess = teamAdminAccess;
    _this.openConfirmPopup = openConfirmPopup;

    return _this;

    //{next, props, confirmType, dontShowAgainProp, checkTeamAccess}
    function openConfirmPopup(res, CPS) {
        if (res.checkTeamAccess) {
            _this.teamAccess(process1);
        } else {
            process1();
        }

        function process1() {
            if (res.checkQuota && CPS) {
                CPS.loadQuotaPopup(res.checkQuota, process);
            } else {
                process();
            }
        }

        function process() {
            if (!res.dontShowAgainProp ||
                res.dontShowAgainProp && LCS.getSetting(res.dontShowAgainProp)) {
                continuePopup();
            } else {
                res.next();
            }
        }

        function continuePopup() {
            _this.open(null, _this.operations[res.confirmType || 'confirm'],
                _.extend({}, res.props, {onConfirm: onConfirm},
                    res.dontShowAgainProp ? {dontShowAgain: true} : null), null, null, function (result){
                console.log('continuePopup');
                onConfirm(result);
            });

            function onConfirm(extraParam) {
                if (extraParam && extraParam.dontShowAgain) {
                    LCS.setSetting(res.dontShowAgainProp, false);
                }
                res.next();
            }
        }
    }
    //quotaType, quota, compOptions
    function loadQuotaPopup(callback, res) {
        var quotaType = res.quotaType,
            counter = res.counter,
            operation, item = null, extraParam = null;
        if (quotaType && quotaType.indexOf('requestTeamAccess') !== -1) {
            if (security.isAuthenticated()) {
                return callback();
            } else {
                operation = 'collaboratorAccess';
                item = quotaType === 'requestTeamAccess2' ? 2 : null
            }
        } else if (quotaType === 'requestOwnerAccess') {
            if (security.isCompanyOwner()) {
                return callback();
            } else {
                operation = 'ownerAccess';
            }
        } else if (quotaType === 'requestTeamAdminAccess') {
            if (security.isCompanyAdmin()) {
                return callback();
            } else {
                operation = 'teamAdminAccess';
            }
        } else {
            if (counter) {
                var rem = counter.remaining,
                    hasR = rem >= 0;
                if (!counter.hasCounter ||
                    counter.hasCounter && (counter.total === null ||
                        counter.total === undefined || hasR)) { //maxAddedCount
                    return callback(counter.hasCounter && hasR ? rem : null);
                } else {
                    operation = 'quotaExceeded';
                }
            } else {
                operation = 'featureUnavailable';
            }
            item = counter;
            extraParam = {
                quotaType: quotaType
            };
        }

        if (operation) {
            var c = res.compOptions,
                popupIndex = c && c.popupIndex ? c.popupIndex :null;

            if (c && c.onSubscriptionUpdated) {
                extraParam = _.extend(extraParam, {onSuccess: c.onSubscriptionUpdated});
            }
            if (res && res.hideButton) {
                extraParam.hideButton = true;
            }
            if(popupIndex) {//img editor
                extraParam.popupIndex = popupIndex;
                c = null;
            }

            if (c && c.compOptions) {//pdfbuilder
                c = c.compOptions;
            }

            if(!extraParam){extraParam = {};}
            extraParam.tracking = _.extend({quotaType: quotaType}, res.tracking);
            _this.open(item, _this.operations[operation], extraParam, c);
        }
    }

    function checkQuota(quotaType, callback, compOptions, otherParams) {
        var target = otherParams && otherParams.e ? otherParams.e.currentTarget : null;
        if(!target){
            var t = otherParams && otherParams.e ? otherParams.e.target : null;
            if(t){
                target = LCS.findClosestParent(t, '[data-type]');
            }
        }

       return _this.loadQuotaPopup(callback, {
            quotaType: quotaType,
            counter: otherParams && otherParams.quotaCounter ? otherParams.quotaCounter : SessionService.getSubscriptionParams(quotaType),
            compOptions: compOptions,

            tracking: target ? {
                btn: target.getAttribute('analytics-action'),
                action: target.getAttribute('data-type'),
            } : null
        });
    }

    function collaboratorPermissions() {
        _this.loadQuotaPopup(function () {}, {quotaType: 'requestTeamAccess2'});
    }

    function teamAccess(next) {
        _this.loadQuotaPopup(next, {quotaType: 'requestTeamAccess'});
    }

    function ownerAccess(next) {
        _this.loadQuotaPopup(next, {quotaType: 'requestOwnerAccess'});
    }

    function teamAdminAccess(next) {
        _this.loadQuotaPopup(next, {quotaType: 'requestTeamAdminAccess'});
    }

    function open(selected, operation, extraParam, compOptions, service, onSuccessPopup, getNotification, closePrevious) {
        return PopupsService.open(selected, operation, extraParam, compOptions, service, onSuccessPopup, getNotification, closePrevious);
    }

    function removeItem(el) {
        if (!el) {
            return;
        }
        if (el.subscription) {
            SessionService.broadcastUpdateSubscription(el.subscription);
        }
        if (el.item) {
            el = el.item;
        }
        if (_this.list && _this.list.items) {
            return _this.list.removeElement(el);
        }
        return null;
    }
}

angular.module('ctrl.PopupsCtrl.select.color.popup.component', [
])
.component('selectColorPopup', popupComponentParams('SelectColorPopupCtrl'))
.controller('SelectColorPopupCtrl', SelectColorPopupCtrl);
SelectColorPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', '$element'];
function SelectColorPopupCtrl(ItemTemplateCompileCtrlService, $element) {
    console.log('SelectColorPopupCtrl');

    var $ctrl = this;

    $ctrl.isPopup = true;
    $ctrl.inputCls = 'hexInput';
    $ctrl.pickerCls = 'colorSelector';

    $ctrl.save = save;
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.close = close;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function save(e) {
        $ctrl.preventDefault(e);
        $ctrl.error = null;

        if ($ctrl.extraParam.onConfirm) {
            $ctrl.extraParam.onConfirm({v: $ctrl.hexInput.value.toUpperCase()});
        }

        $ctrl.broadcastRoot('HIDE_MOBILE_DETAILS');
        $ctrl.close();
    }

    function setTemplateData() {
        $ctrl.withCloseBtn = true;
        $ctrl.popupTitle = 'Select Background Color';
        $ctrl.withFooterBtns = true;
        $ctrl.btnText = 'Apply Color';
    }

    function getPopupBodyContent() {
        return '<div class="text-center full-width"><input class="' + $ctrl.inputCls + ' with-transition"/></div><div class="with-transition ' + $ctrl.pickerCls + ' full-width text-center"></div>';
    }

    function close() {
        if ($ctrl.onClose) {
            $ctrl.onClose({result: 'cancel'});
        }
        $ctrl.extraParam.onClose();
    }

    function onLoaded() {
        setPopupIndex();

        $ctrl.colorPicker = new iro.ColorPicker('.' + $ctrl.pickerCls, {
            color: "rgb(255, 0, 0)",
            borderWidth: 2,
            borderColor: "#fff",
            layoutDirection: 'horizontal',
            margin: 30,
            layout: [
                {
                    component: iro.ui.Wheel,
                    options: {
                        width: 200
                    }
                },
                {
                    component: iro.ui.Slider,
                    options: {
                        sliderType: 'value',
                        sliderDirection: 'vertical',
                    }
                }
            ]
        });
        $ctrl.hexInput = $ctrl.element.querySelector('.' + $ctrl.inputCls);

        bind(true);
    }

    function bind(isBind) {
        if ($ctrl.colorPicker) {
            $ctrl.colorPicker[isBind ? 'on' : 'off'](['color:init', 'color:change'], onColorChange);
        }

        if ($ctrl.hexInput) {
            $ctrl.hexInput[isBind ? 'addEventListener' : 'removeEventListener']('change', onInputChange);
        }
    }

    function onColorChange(color) {
        // Show the current color in different formats
        // Using the selected color: https://iro.js.org/guide.html#selected-color-api
        /* values.innerHTML = [
             "hex: " + color.hexString,
             "rgb: " + color.rgbString,
             "hsl: " + color.hslString,
         ].join("<br>");
     */
        $ctrl.hexInput.value = color.hexString.toUpperCase();
        $ctrl.extraParam.onColorChange($ctrl.hexInput.value);
    }

    function onInputChange() {
        $ctrl.colorPicker.color.hexString = this.value;
        $ctrl.extraParam.onColorChange(this.value);
    }

    function onDestroy() {
        bind(false);
    }

    function setPopupIndex() {
        var index = $ctrl.extraParam ? $ctrl.extraParam.popupIndex : null;
        if (!index) {
            return;
        }
        var modal = $ctrl.LCS.findClosestParent($ctrl.element, '.modal');
        if (modal) {
            modal.style.zIndex = index + 1;
        }
    }
}


angular.module('templateCompilePopup.controller.service', [
    'templateCompile.service',
    'item.form.init.controller.service'
])
.service('ItemTemplateCompileCtrlService', ItemTemplateCompileCtrlService);
ItemTemplateCompileCtrlService.$inject = ['TemplateCompileCompCtrlService', 'ItemTemplateFormInitCtrlService'];
function ItemTemplateCompileCtrlService(TemplateCompileCompCtrlService, ItemTemplateFormInitCtrlService) {
    return function ($ctrl, $element, isPopup, withoutTemplateScope) {
        //console.log('ItemTemplateCompileCtrlService');
        $ctrl.isPopup = isPopup ? true : false;

        if($ctrl.isPopup) {
            $ctrl.nonMobileCloseBtn = nonMobileCloseBtn;
            $ctrl.closePopup = closePopup;
        }

        $ctrl = new ItemTemplateFormInitCtrlService($ctrl);
        $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

        return $ctrl;

        function nonMobileCloseBtn(method) {
            return '<div class="close-icon hide-ipad"><a class="' + $ctrl.getBtnActionCls() + ' btnClose close close-popup" data-type="'+(method||'close')+'" data-info="true">' +$ctrl.LCS.getISBDiv('cancel', 2, 'gray sbf24') +'</a></div>';
        }

        function closePopup(result) {
            if (typeof($ctrl.onClose) === 'function') {
                $ctrl.onClose({result: result});
            }
        }
    }
}

angular.module('ctrl.PopupsCtrl.tree.list.popup.component', [
