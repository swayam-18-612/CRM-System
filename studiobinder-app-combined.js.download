angular.module('product.callsheet.addRecipients.group.component',[
    'product.contacts.group.controller.service',
    'apiPagination.Contacts',
    'product.contacts.item.grid.component',
    'product.callsheet.recipients.item.grid.component'
])
.component('addRecipientGroup', treeGroupComponentParams( 'AddCallsheetRecipientsGroupCtrl', {
    isPopup: '@',
    departments: '<',
    positions: '<',
    callsheetId: '<',
    onAddToCallsheet:'&'
}))
.controller('AddCallsheetRecipientsGroupCtrl',AddCallsheetRecipientsGroupCtrl);
AddCallsheetRecipientsGroupCtrl.$inject = ['ContactsGroupCtrlService', 'ContactsPagination', '$element'];
function AddCallsheetRecipientsGroupCtrl(ContactsGroupCtrlService, Pagination, $element) {

    var $ctrl = this;
    $ctrl.ContactsConstantsService = angular.copy(ContactsConstantsService);
    $ctrl.onInitOther = onInitOther;
    $ctrl.getMorePopoverTemplateOther = getMorePopoverTemplateOther;

    $ctrl.getInlineActions = getInlineActions;
    $ctrl.getRowMobileActions = getRowMobileActions;
    $ctrl.addToCallsheet = addToCallsheet;
    $ctrl.getSettingsColumns = getSettingsColumns;

    $ctrl = new ContactsGroupCtrlService($ctrl, $element, Pagination);

    function getSettingsColumns (){
        return $ctrl.service.ContactsConstantsService.Settings.Columns;
    }
    function getInlineActions(isHeader, item) {
        var t = 'Call Sheet';
        return $ctrl.canEdit ? (
     isHeader ? ('<div class="with-btn hide-print">&nbsp;</div>') :
                ('<div class="col-add-rec hide-print no-drag">' +
                    '<a class="btn btn-small primary-faded without-text ' + $ctrl.getClickEventName('addElemToCallsheet') + '" analytics-on analytics-action="Open Add to '+t+' Popup">' +
                       // '<div class="sbf callsheets" tooltip-placement="bottom" tooltip="Add to '+t+'"></div>' +
                    $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left') +
                    ' <span class="hide-ipad">Add to '+t+'</span></div>' +
                    '</a>' +
                '</div>')
        ) : '';
    }

    function getRowMobileActions(item) {
        return $ctrl.canEdit ? [{
                type: 'addElemToCallsheet',
                action: 'Add to Call Sheet',
                icon: 'plus-circled'
            }] : null;
    }

    function onInitOther() {
        if ($ctrl.canEdit) {
            $ctrl.addElemToCallsheet = addElemToCallsheet;
        }
    }

    function getMorePopoverTemplateOther(item, isMobile) {
        return isMobile ? '' : $ctrl.getSideMenuLi({
            type: 'addElemToCallsheet',
            action: 'Add to Call Sheet',
            icon: 'plus'
        });

    }
    function addElemToCallsheet(item, param, e) {
        console.log('addElemToCallsheet');
        $ctrl.processEventOther([{id: item._id}], 'addToCallsheet', e);
    }

    function addToCallsheet(ids, e) {
        console.log('addToCallsheet');
        if($ctrl.onAddToCallsheet) {
            $ctrl.onAddToCallsheet({ids: ids, e: e});
        }
    }
}

angular.module('callsheet.approvals.component', [
    'list.ctrl',
    'apiPagination.Approvals',
    'apiServices.Comments'
])
.component('callsheetApprovals', {
    bindings: {
        isDifferentUser: '<',
        approver: '<',
        callsheetId: '<'
    },
    template: '<div class="preview-callsheet centering without-side-paddings">' +
                   '<div class="headernav"> '+
                        '<div ng-if="::!$ctrl.isDifferentUser" class="header-with-underline">' +
                            '<div ng-if="$ctrl.selected.length>0">' +
                                '<a class="btn btn-small"' +
                                '   ng-click="$ctrl.shareCallsheet({items: $ctrl.selected, exists:true}, $event)" data-type="shareCallsheet" analytics-on analytics-action="Open Share Callsheet Popup">Share with Selected</a>' +
                            '</div>' +
                            '<div >' +
                                '<span class="uppercase" ng-if="$ctrl.selected.length==0">Approvals</span> <span class="dot-separator"></span>' +
                                '<span class="counter" ng-if="$ctrl.callsheetApproval">{{$ctrl.list.totalCount ? $ctrl.list.totalCount :0}} collaborator{{$ctrl.list.totalCount == 1 ? \'\' : \'s\'}}</span>' +
                            '</div>' +
                        '</div>'+

                        '<div ng-if="::$ctrl.isDifferentUser" class="header-with-underline">' +
                            '<div class="uppercase">Request for Approval</div>' +
                        '</div>'+
                    '</div>'+

                    '<div ng-if="::$ctrl.isDifferentUser && $ctrl.approver" ng-include="::\'/user/product/callsheet/approval/approver-view.tpl.html\'"></div>' +
                    '<div ng-if="::!$ctrl.isDifferentUser" ng-show="$ctrl.list.isLoaded" class="spacing-bottom ng-hide" ng-include="::\'/user/product/callsheet/approval/owner-view.tpl.html\'"></div>' +
                '</div>',
    controller: 'CallsheetApprovalsCtrl'
})
.controller('CallsheetApprovalsCtrl', CallsheetApprovalsCtrl);
CallsheetApprovalsCtrl.$inject = ['ApprovalsPagination', 'CommentsService', 'ListInitService', '$element'];
function CallsheetApprovalsCtrl(ApprovalsPagination, CommentsService, ListInitService, $element) {
    console.log('CallsheetApprovalsCtrl');
    var $ctrl = this;
    $ctrl.CommentsService = CommentsService;
    $ctrl.objectType = 'approval';
    $ctrl.showCommments = null;
    $ctrl.formHolder = {};

    $ctrl.getInitials = $ctrl.security.getInitialsByName;
    $ctrl.getLogoPath = getLogoPath;
    $ctrl.isFocus = isFocus;
    $ctrl.hideComments = hideComments;
    $ctrl.loadComments = loadComments;
    $ctrl.toggleComments = toggleComments;
    $ctrl.isShowComments = isShowComments;
    $ctrl.commentCallsheet = commentCallsheet;
    $ctrl.getNotification = getNotification;
    $ctrl.convertResource = convertResource;

    $ctrl.$onInit = $onInit;
    $ctrl.$onDestroy = $onDestroy;

    function $onInit() {
        if (!$ctrl.isDifferentUser) { //load all approvals and their approval
            var list = new ApprovalsPagination(1000,
                ['productId', 'callsheetId', 'name', 'email', 'approved', 'approvedAt', 'type', 'commentsCount', 'emailViewsCount', 'pageViewsCount', 'createdAt', 'createdById', 'comments'],
                [],
                ['approved', 'createdAt'],
                'createdById');
            $ctrl.service = list.service;
            $ctrl = new ListInitService($ctrl, {
                $element: $element,
                list:  new ApprovalsPagination(1000,
                    ['productId', 'callsheetId', 'name', 'email', 'approved', 'approvedAt', 'type', 'commentsCount', 'emailViewsCount', 'pageViewsCount', 'createdAt', 'createdById', 'comments'],
                    [],
                    ['approved', 'createdAt'],
                    'createdById'),
                preloadAll: true,
                orders: {createdAt: -1},
                withProperty: withProperty,
                onAllLoaded: onAllLoaded
            });

            $ctrl.Types = $ctrl.service.CommentTypes;
            $ctrl.hasItem = hasItem;
            $ctrl.changeItem = changeItem;

           // $ctrl.getAll();

            $ctrl.addRootWatcher('SHARE_CALLSHEET', onShareCallsheet);
        } else {
            if ($ctrl.approver) {
                $ctrl.showCommments = $ctrl.approver._id;
            }
        }
    }
    function getLogoPath(logo) {
        return logo ? ($ctrl.API_CONFIGS.server.uploadLogo + logo) : null;
    }

    function isFocus(id) {
        return id === $ctrl.focus;
    }

    function hideComments() {
        $ctrl.showCommments = null;
    }

    function loadComments(item) {
        var id = item._id;
        if (item.commentsCount > 1 && !item.isLoading) {
            if (item.comments) {
                $ctrl.showCommments = id;
            } else {
                item.isLoading = true;
                $ctrl.CommentsService.getForRecipient({
                    productId: $ctrl.CPS.productId,
                    callsheetId: $ctrl.callsheetId,
                    approverId: id
                }, 'createdById', function (comments) {
                    item.isLoading = false;
                    item.comments = comments;
                    $ctrl.showCommments = id;
                }, function (error) {
                    item.isLoading = false;
                    item.comments = null;
                });
            }
        }
    }

    function toggleComments(item) {
        if ($ctrl.isShowComments(item)) {
            $ctrl.hideComments(0);
        }
        else {
            $ctrl.loadComments(item);
        }
    }

    function isShowComments(item) {
        return $ctrl.showCommments === item._id;
    }

    function commentCallsheet(item, type) {
        item.error = null;
        var loading = 'isUpdating' + ((type === 3) ? 'A' : '');

        if (!item[loading]) {
            item[loading] = true;
            if ($ctrl.formHolder['form' + item._id] && $ctrl.formHolder['form' + item._id].$valid) {
                var params = {
                    companyId: $ctrl.CPS.companyId,
                    productId: $ctrl.CPS.productId,
                    callsheetId: $ctrl.callsheetId,
                    type: type,
                    id: item._id,
                    comment: item.comment
                };
                var name = {name: type === 5 ? item.name : item.createdBy.name};
                $ctrl.service.commentCallsheet(params, function (result) {
                    item[loading] = false;
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.callsheet.' + (type === 3 ? 'approve' : 'comment') + '.success', 'success', name);

                    if (!$ctrl.isDifferentUser) {
                        result.comment.createdById = SessionService.getSetting('user');
                    }
                    if (!item.comments) {
                        item.comments = [];
                    }
                    item.comments.push(result.comment);
                    item.commentsCount = result.approver.commentsCount;
                    item.comment = null;
                    $ctrl.focus = item._id;

                    if ($ctrl.isDifferentUser) {
                        $ctrl.showCommments = item._id;
                        item.approved = result.approver.approved;
                        item.approvedAt = result.approver.approvedAt;
                    }
                }, function (error) {
                    item[loading] = false;
                    item.error = $ctrl.localizedMessages.getFromError(error, 'crud.callsheet.' + (type === 3 ? 'approve' : 'comment') + '.error', name);
                });
            }
        }
    }

    function convertResource(item) {
        return $ctrl.service.convertResource(item);
    }

    function withProperty() {
        return {
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId,
            callsheetId: $ctrl.callsheetId
        };
    }

    function onShareCallsheet(type) {
        $ctrl.selected = [];
       // $ctrl.getAll();
    }

    function onAllLoaded() {
        console.log('onAllLoaded');
        $ctrl.isAllLoaded = true;
        var list = _.filter($ctrl.list.items, {approved: true});
        $ctrl.totalApproved = list ? list.length : 0;
    }

    function hasItem(list, item) {
        if (list) {
            if (_.find(list, function (val) {
                return val._id === item._id;
            })) {
                return true;
            }
        }
        return false;
    }

    function changeItem(list, item, e) {
        if (!item) {
            return;
        }
        var checked = $(e.target).is(":checked");
        if (checked) {
            if (!$ctrl.hasItem(list, item)) {
                list.push(item);
            }
        } else {
            _.each(list, function (value, index) {
                if (item._id === value._id) {
                    list.splice(index, 1);
                }
            });
        }
    }

    function getNotification(error, type, isSuccess, params) {
        var success = isSuccess ? 'success' : 'error';
        var message = 'crud.callsheet.share.' + type + '.' + success;
        $ctrl.i18nNotifications.pushForCurrentRoute(error, message, success, params);
    }
    function $onDestroy() {
        $ctrl.onListDestroy();
    }
}

angular.module('callsheet.approval', [
    'callsheet.approvals.component',
    'callsheet.approval.shareCallsheet.component'
]);


function callsheetComponentInitParams(controllerName, bindings) {
    return {
        bindings: _.extend({
            block:'@',
            optionsProp: '@',
            canEdit: '<',
        }, bindings || {}),
        controller: controllerName,
    }
}
function callsheetGroupComponentParams(controllerName, bindings) {
    return callsheetComponentInitParams(controllerName, _.extend({
        currentListId: '@',
        isMobileMode: '<',
        preLoadingService: '<?'
    }, bindings || {}));
}

function callsheetRecipientsGroupComponentParams(controllerName, bindings) {
    return callsheetGroupComponentParams( controllerName, _.extend({
        positions: '<',
        departments: '<',
        preProcessGroupItems: '&',
    }, bindings));
}

angular.module('product.callsheet.blocks.component', [
    'product.callsheet.block.init.controller.service',
    'product.callsheet.break.component',

    'product.callsheet.cast.component',
    'product.callsheet.crew.component',
    'product.callsheet.clients.component',
    'product.callsheet.extras.component',

    'product.callsheet.extras1.component',
    'product.callsheet.advancedSchedules.component',
    'product.callsheet.schedules.component',
    'product.callsheet.departmentNotes.component',
    'product.callsheet.locations.component',
    'product.callsheet.calltime.routing',
    'product.callsheet.files.component',

    'product.callsheet.topSection.component',
    'product.callsheet.blocks.controller.service',
    'apiConstants.product.contacts.services',
    'observer.img.service',
    'observer.row.service'
])
.component('callsheetBlocks', {
    bindings: getCallsheetBlocksBindings(),
    controller: 'CallsheetBlocksCtrl'
})
.controller('CallsheetBlocksCtrl', CallsheetBlocksCtrl);
CallsheetBlocksCtrl.$inject = ['CallsheetBlocksCtrlService', 'ContactsConstantsService', 'RowObserverCtrlService', 'ImgObserverCtrlService', '$element'];
function CallsheetBlocksCtrl(CallsheetBlocksCtrlService, ContactsConstantsService, RowObserverCtrlService, ImgObserverCtrlService, $element) {
    console.log('CallsheetBlocksCtrl');
    var $ctrl = this;

    $ctrl.ImgObserverCtrlService = ImgObserverCtrlService;
    $ctrl.RowObserverCtrlService = RowObserverCtrlService;
    $ctrl.ContactsConstantsService = angular.copy(ContactsConstantsService);

    var dateProp = 'startDate';
    var calltimeTooltip = 'This general call time will be replaced with the recipient’s personalized call time.';
    $ctrl.crewTables = ['cast', 'clients', 'crew', 'extras'];
    $ctrl.listOptions = {};
    $ctrl.editableItemProps = ['type', 'date', 'time', 'generalNote', 'bulletin', 'footerNote', 'dayOfDays', 'header'];

    $ctrl.showTopSection = showTopSection;
    $ctrl.showSection = showSection;

    $ctrl.preInitOther = preInitOther;
    $ctrl.setColumns = setColumns;
    $ctrl.onChangedField = onChangedField;
    $ctrl.updateCallsheet = updateCallsheet;
    $ctrl.postInit  = postInit;
    $ctrl.onDestroyOther = onDestroyOther;

    $ctrl.updateEditableItemPropsAll = updateEditableItemPropsAll;

    $ctrl.getGroupBody = getGroupBody;
    $ctrl.getItemTemplate = $ctrl.getGroupBody;
    $ctrl.getCallsheetTypeInfo = getCallsheetTypeInfo;
    $ctrl.isMobileView = isMobileView;

    $ctrl.gettopPersonsContent = gettopPersonsContent;
    $ctrl.getvipDetailsContent = getvipDetailsContent;

    $ctrl.onPreProcessGroupItems = onPreProcessGroupItems;

    $ctrl = new CallsheetBlocksCtrlService($ctrl, $element);

    if(!$ctrl.imgObserverService){
        $ctrl.imgObserverService = new $ctrl.ImgObserverCtrlService($ctrl.watchers);
    }
    if(!$ctrl.rowObserverService){
        $ctrl.rowObserverService = new $ctrl.RowObserverCtrlService($ctrl.watchers);
    }

    function onPreProcessGroupItems(item){
         console.log('CallsheetBlocksCtrl.onPreProcessGroupItems');
        return $ctrl.preProcessGroupItems({item: item});
    }
    function isMobileView() {
        return $ctrl.LCS.isMobileSize || $ctrl.isMobileMode; //callsheet
    }

    function onImageUploaded(result) {
        if(!result){return;}
        var collection = $ctrl.service ? $ctrl.service.collectionName : null;
        console.log('onImageUploaded: IMAGE_UPLOADED_CALLSHEETS ' + collection);
        //todo test:
        //if(result.collectionProp && collection && result.collectionProp !== collection){return;}
        switch(result.eventType) {
            case 'update':
                onUpdate(result);

                if ($ctrl.preLoadingService) {
                    //todo
                    // $ctrl.preLoadingService.processUpdateInfo($ctrl.preLoadingService.TblTypes.Materials, result.materials, $ctrl.preLoadingService.Ops.Create);
                }
                break;

            case 'remove':
                onRemove(result);
                break;
        }

        function onRemove(result) {
            console.log('onImageRemove in list');
            var data = result ? result.item : null;
            if(!data){return;}
            $ctrl.service.update(data, function(){
                onUpdate(result);
            }, function (error) {
                $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.image.remove.error', 'error' );
            });
        }

        function onUpdate(result) {
            var id = result && result.item ? result.item._id : null;
            if (id && $ctrl.item._id === id) {
                $ctrl.item.getUpdatedImageProps(result.updatedImage);
                var v = {}, p = result.updatedImage.prop;
                v[p] = $ctrl.item[p];
                v[p + 'Id'] = $ctrl.item[p + 'Id'];
                $ctrl.CPS.CurrentProduct.setCallsheet(_.extend($ctrl.CPS.CurrentProduct.getCallsheet(), v));
            }
        }
    }

    function getCallsheetTypeInfo(callsheet, withCall) {
        var prop = 'title',
            type = callsheet && callsheet.type ? callsheet.type : 1,
            el = _.find($ctrl.CallsheetConstantsService.TypesInfo, function (item) {
                return item.id === type;
            });
        return withCall ? ((type === 1 ? 'Call' : el[prop]) + ' Time') : el[prop];
    }

    function preInitOther() {
        getCallsheet();

        setCoordinates();
        //ordered list
        preset($ctrl.item.options);

        if($ctrl.canEdit){
            $ctrl.CurrentProduct.onCallsheetChanged($ctrl.watchers, function () {

            });
        }
    }

    function initDateInfo() {
        var d = $ctrl.item[dateProp];
        if(!$ctrl.item['date']){
            $ctrl.item['date'] = $ctrl.MomentService.getUtcMomentFromDateMoment(d, $ctrl.CPS.startTime);
        }
        if(!$ctrl.item['time']){
            $ctrl.item['time'] = $ctrl.MomentService.getUtcMomentFromTimeMoment(d, $ctrl.CPS.startTime);
        }
    }

    function processDate(dayBreak, prop) {
        if (dayBreak.date || dayBreak.startTime) {
            $ctrl.item[prop] = $ctrl.MomentService.getUtcMomentFromDateMoment(dayBreak.date ? dayBreak.date : $ctrl.MomentService.getUtcDateNow(), dayBreak.startTime ? dayBreak.startTime : $ctrl.CPS.startTime);
            initDateInfo(prop);
        }
    }

    function setColumns() {
        $ctrl.tommorowDate = $ctrl.MomentService.getUtcDateNow();
        $ctrl.columnsList = [
            _.extend({
                type: $ctrl.SBFieldTypesService.PropTypes.Date,
                prop: 'date',
                tabIndex: 2,
                tabNextIndex: 3,
                placeholder: 'Date',

                hasRemove: false,
                enableTime: false,
                dateFormat: 'ddd, MMM D, YYYY',//from moment
                canEdit: true,
                parentContainer: '.preview-callsheet',
                triggerEditOnCol: true,
                withService: false,
                showMobile: true,
                iconLevel: 6,
                defaultDate: "::$ctrl.tommorowDate",
            }, getContentEditableParams('day date_picker')),

            {
                type: $ctrl.SBFieldTypesService.PropTypes.Time,
                placeholder: 'Calltime',
                prop: 'time',
                tabIndex: 3,
                tabNextIndex: 4,

                fieldClass: ' calltime text-center',

                hasRemove: false,
                canEdit: true,
                timeFormat: $ctrl.CPS.timeFormat,
                parentContainer: true,
                triggerEditOnCol: true,
                withService: false,
                showMobile: true
            },

            _.extend({
                name: 'Call sheet name',
                prop: 'header',
                type: $ctrl.SBFieldTypesService.PropTypes.Html,
                colCls: ' spacing-half-top',
                order: 2,
                canEdit: true,
                placeholder: 'Project name, call sheet name',

                triggerEditOnCol: true,
                showMobile: true,
                //withBottomToolbar: true,
                withNoToolbar: true
            }, getContentEditableParams('text-center message projectname')),

            _.extend({
                name: 'Day Of Days',
                prop: 'dayOfDays',
                type: $ctrl.SBFieldTypesService.PropTypes.Field,
                colCls: ' dayOfDays',
                order: 2,
                placeholder: 'ie. Day 2 of 5',

                showMobile: true,
                withNoToolbar: true
            }, getContentEditableParams('dayOfDays')),

            _.extend({
                name: 'General note',
                prop: 'generalNote',
                type: $ctrl.SBFieldTypesService.PropTypes.Html,
                colCls: ' message htmlcontent',
                order: 2,
                placeholder: 'Production notes…',

                withBottomToolbar: true,
                showMobile: true,


                withFullHeight: true,
                saveOnKeydown: true,
                withEditableOuter: true
            }, getContentEditableParams('text-center')),

            _.extend({
                name: 'Enter footer note',
                prop: 'footerNote',
                type: $ctrl.SBFieldTypesService.PropTypes.Html,
                colCls: ' message htmlcontent',
                order: 2,
                placeholder:'Enter footer notes (i.e. walkie channels, other contacts details, or notes)',
                withBottomToolbar: true,
                parentContainer:true,
                showMobile: true,


                withFullHeight: true,
                saveOnKeydown: true,
                withEditableOuter: true
             }, getContentEditableParams()),

            _.extend({
                name: 'Enter bulletin',
                prop: 'bulletin',
                type: $ctrl.SBFieldTypesService.PropTypes.Html,
                colCls: ' message htmlcontent',
                order: 2,
                placeholder:'Enter bulletin',
                withBottomToolbar: true,
                parentContainer:true,
                showMobile: true,

                withFullHeight: true,
                saveOnKeydown: true,
                withEditableOuter: true
            }, getContentEditableParams()),

            {
                canEdit: true,
                tabIndex: 4,
                tabNextIndex: 5,
                formGroupClass: ' form-group field thinner wide-tooltip',
                type: $ctrl.SBFieldTypesService.PropTypes.Drp,
                eClassAttr: 'form-control with-underline ',
                cClassAttr: 'autoheight long-caret',
                //fieldClass: 'form-control with-underline ' + $ctrl.pageClass,
                initListName: 'callsheetTypes',
                prop: 'type',
                parentContainer:true,
                itemLabel: 'title',
                itemValue: 'id',
                otherHtml: '<div class="wide-tooltip hide-ipad full-width position-absolute" style="height: 0;left:100%;top:0"><div style="right:-20px;top: -26px" class="sbf info blueish position-absolute" tooltip-placement="top" tooltip="'+calltimeTooltip+'">'+ $ctrl.LCS.getISBPath(3) +'</div></div>'
            }];


        function getContentEditableParams(fieldClass){
            return {
                canEdit: true,
                triggerEditOnCol: true,
                autofocus: true,
                fieldClass: 'editable-content contenteditable word-wrap ' + (fieldClass || ''),
                editableContainerClass: 'noninlineeditor',
                eClassAttr: 'non-inline-editor noninlineeditor',

                wrapperClass: 'full-width' + ( fieldClass && fieldClass.indexOf('text-center')!==-1 ? ' centered':'')
            }
        }

        function getUnderlinedContentParams(fieldClass){
            return {
                fieldClass: (fieldClass || null),
                //editableContainerClass: 'noninlineeditor',
                eClassAttr: 'form-control hover-underline',
                editableContainerClass: 'without-height-padding'
            }
        }
    }

    function postInit() {
        if ($ctrl.canEdit) {
            $ctrl.addRootWatcher('CALLSHEET_TEMPLATE_CHANGED', onTemplateChanged);
            $ctrl.addRootWatcher('CALLSHEET_VISIBILITY_CHANGED', onVisibilityChanged);
            $ctrl.addRootWatcher('CALLSHEET_ORDER_CHANGED', onOrderChanged);
            $ctrl.addRootWatcher('CALLSHEET_TYPE_CHANGED', onCallsheetTypeChanged);
            $ctrl.addRootWatcher('IMAGE_UPLOADED_CALLSHEETS', onImageUploaded);
        }else{
            $ctrl.addRootWatcher('VIEW_MODE_CHANGED', onViewModeChanged);
        }
    }

    function onDestroyOther() {
        if($ctrl.imgObserverService) {
            $ctrl.imgObserverService.destroy();
        }
        if($ctrl.rowObserverService) {
            $ctrl.rowObserverService.destroy();
        }
    }

    function onViewModeChanged(isMobileMode){
        console.log('onViewModeChanged: ' + isMobileMode);
        $ctrl.isMobileMode = isMobileMode;
    }

    function onCallsheetTypeChanged(result) {
        console.log('onCallsheetTypeChanged');
        var data = result.editchanges;
        if(data && data.type !== undefined) {
            getCallsheet();
            updateType();
        }
    }

    function getCallsheet(){
        $ctrl.item = angular.copy($ctrl.CurrentProduct.getCallsheet());
        initDateInfo();
    }

    function onChangedField(result) {
        var prop = result && result.prop ? result.prop : null,
            updates = {};
        if (!prop) {
            return;
        }
        console.log('onChangedField: ' + prop);
        getCallsheet();

        var newVal = result.selected.val;
        if (prop === 'date' || prop === 'time') {
            var updates1 = {};
            updates1[prop] = newVal;
            updates[dateProp] = prop === 'date' ?
                $ctrl.MomentService.getUtcMomentFromDateMoment(newVal, $ctrl.item.startDate) :
                $ctrl.MomentService.getUtcMomentFromDateMoment($ctrl.item.startDate, newVal);
            $ctrl.broadcastRoot('CALLSHEET_DATE_CHANGED', newVal);
            updateCallsheet(updates, updates1);
        } else {
            updates[prop] = newVal;
            onSuccessUpdated(updates);
        }
    }

    function updateCallsheet(updates, updates1) {
        //console.log('updateCallsheet');

        return $ctrl.service.update(_.extend({
            _id: $ctrl.item._id,
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId
        }, updates),function  (result) {
           onSuccessUpdated(updates, updates1);
        }, function (error) {
            $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.callsheet.item.error', 'error');
        });
    }

    function updateEditableItemPropsAll(changes) {
        //console.log(' : onchanges');
        if ($ctrl.hasPropChanged(changes, 'startTime')) {
            initDateInfo();
            $ctrl.updatePropContent('time');
            $ctrl.updatePropContent('date');
        }
        if($ctrl.hasPropChanged(changes, 'type')) {
            updateType();
        }
    }

    function updateType(){
        var els = $ctrl.element.querySelectorAll('.general .'+$ctrl.SBFieldTypesService.getPropMark('type'));
        if(els) {
            _.each(els, function (el) {
                el.innerHTML = $ctrl.getCallsheetTypeInfo($ctrl.item, true);
            });
        }
    }

    function onSuccessUpdated(updates, updates1) {
        if ($ctrl.onSuccessUpdated(updates, updates1)) {
            $ctrl.CurrentProduct.setCallsheet($ctrl.item);
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.callsheet.item.success', 'success');
        }
    }

    function setCoordinates() {
        var l = $ctrl.preLoadingService.getList($ctrl.preLoadingService.TblTypes.CallsheetLocations);
        if (l && l.length > 0) {
            $ctrl.firstLoc = l[0];
        }
    }

    function onTemplateChanged(options) {
        //console.log('blocks.onTemplateChanged');
        preset(options);
        $ctrl.reloadTemplate();
    }

    function preset(options) {
        _.each(['blocks', 'top'], function (optionsProp) {
            $ctrl.listOptions[optionsProp] = $ctrl.CallsheetConstantsService.getBlockList(options, optionsProp);
        });
    }

    function onVisibilityChanged(result) {
        var hasChanges;
        if (result) {
            //console.log('blocks.onVisibilityChanged');

            getCallsheet();

            var optionsProp = result.optionsProp || 'blocks',
                list = $ctrl.listOptions[optionsProp],
                info = result.info;
            if(info) {
                for (var block in info) {
                    for (var i = 0, l = list.length; i < l; i++) {
                        var item = list[i];
                        if (item.id === block) {
                            var updates = info[block];
                            if (updates) {
                                $ctrl.listOptions[optionsProp][i] = _.extend({}, item, updates);
                                hasChanges = true;
                            }
                            break;
                        }
                    }
                }
            }
        }
        return hasChanges;
    }

    function onOrderChanged(result) {
        //console.log('onOrderChanged');
        if(onVisibilityChanged(result)) {
            $ctrl.reloadTemplate();
        }
    }

    function getWatermark() {
        var template = '';

        //to do save watermark in options
        var watermark = $ctrl.item.options.watermark ? $ctrl.item.options.watermark : 'Prelim';

        if($ctrl.showWatermark && watermark){
template += '<div class="watermark-wrapper overlay h-full hide-ipad">' +
                '<div class="h-full preview-callsheet centering">';
                 for (var i = 0; i < 15; i++) {
        template += '<div class="background clearfix"><div>'+watermark+'</div></div>';
                 }
    template += '</div>' +
            '</div>';
        }
        return template;
    }

    function getGroupBody() {
        var canEdit = !$ctrl.isMobileMode && $ctrl.canEdit;
        return '<div class="medium-template ' + (canEdit ? 'edit-mode-template ' : 'view-mode-on') + '">' +
            getWatermark() +
            getTopSection(canEdit) +
            getBlocks(canEdit) +
            getFooterSection(canEdit) +
            '</div>';
    }


    function getBlocks(canEdit) {
        var t = '';
        _.each(_.sortBy($ctrl.listOptions.blocks, 'order'), function (item) {
            if (canEdit || !canEdit && item.show) {
                var block = item.id;
                t += block === 'bulletin' ? getBulletin(item, canEdit, true) : getGroup(item, canEdit, block, 'blocks', true);
            }
        });
        return t;
    }

    function showTopSection(block) {
       return $ctrl.showSection(block, 'top');
    }

    function showSection(block, optionsProp) {
        var el = _.find($ctrl.listOptions[optionsProp], function (item) {
            return item.id === block;
        });
        return el && el.show === true;
    }

    function getShowSection(canEdit, block, optionsProp, withShow) {
        return canEdit ? (' ng-' + (withShow ? 'show' : 'if') + '="$ctrl.showSection(\'' + block + '\'' + (optionsProp ? (', \'' + optionsProp + '\'') : '') + ')" ') : '';
    }

    function getGroup(item, canEdit, block, optionsProp, largeColPadding) {
        if (!canEdit && !$ctrl.showSection(block, optionsProp)) {
            return '';
        }
        var list = _.find($ctrl.ContactsConstantsService.CastRoles, function (r) {
                return r.block === block;
            }),
            groupTag = 'callsheet-' + block.split(/(?=[A-Z])/).join('-').toLowerCase() + '-group',
            currentListId = list ? list.value.toString() : 'null';

        return '<' + groupTag + ' ' + getShowSection(canEdit, block, optionsProp) +
            'class="display-block clearfix tree-node simple-group ' +
            (item && item.twoCols ? ' two-cols ' : '') +
            (largeColPadding ? ' large-column-padding ' : '') +
            (block === 'topCalls' ? ' with-bottom-xs non-callsheet-table ' : ' ') +
             block + 'Section" data-id="' + currentListId + '" ' +//for sorting
            'current-list-id="' + (block === 'files' ? $ctrl.item._id : currentListId) + '" ' +
            'is-mobile-mode="::' + $ctrl.isMobileMode + '" ' +
            'pre-loading-service="::$ctrl.preLoadingService" ' +
            getAttrInit(block, canEdit, optionsProp) +
            getAddon(block) +
            '></' + groupTag + '>';

        function getAddon(block) {
            if ($ctrl.crewTables.indexOf(block) !== -1) {
                return 'pre-process-group-items="$ctrl.onPreProcessGroupItems(item)" ' +
                    'positions="::$ctrl.positions" ' +
                    'departments="::$ctrl.departments"';
            } else if (block === 'advancedSchedules') {
                return getOnChanged(canEdit);
            } else if (block === 'files') {
                $ctrl.filesOptions = getBlockOptions(block);
                return 'options="::$ctrl.filesOptions"';
                   // 'get-group-template-other="$ctrl.getGroupTemplateOther"';
            } else if (block === 'locations') {
                return 'callsheet-type="' + $ctrl.item.type + '"'
            }
            //update when callsheet type changes
            return '';
        }
    }

    function getBlockOptions(block) {
        return _.extend({styles: $ctrl.item.options.styles}, _.find($ctrl.listOptions.blocks, function(item){return item.id === block;}));
    }

    function getBulletin(item, canEdit, isMobile) {
        var optionsProp = 'blocks',
            block ='bulletin',
            cls = getBlockCls(isMobile) + ' display-block preview-callsheet centering bulletinSection ';
        if(!$ctrl.showSection(block, optionsProp) || !canEdit && !$ctrl.item.bulletin){return '';}
return '<div class="' + cls + '">' +
            '<div class="' + block +  (canEdit ? '' : ' word-wrap') + '" '+
                getShowSection(canEdit, block,optionsProp || 'top', true) + '>' +
                '<div class="table-div full-width">' +
                    '<div class="col60">' +
                        '<div class="centered circled-svg-colored">' + $ctrl.LCS.getISBDiv(item.icon, item.iconLevel) +'</div>' +
                    '</div>' +
                    '<div class="hide-desktop hide-print"><h2 class="grid-title"><div class="text-center spacing-quarter-top">' + item.title + '</div></h2></div>' +
                    '<div class="centered htmlcontent">' + (canEdit ? $ctrl.getColDisplayDiv(block) : $ctrl.item.bulletin) + '</div>'+
                '</div>' +
            '</div>' +
        '</div>';
    }

    function getTopSection(canEdit) {
        var isMobile = $ctrl.isMobileView(),
            hasGeneralNote = canEdit ? false : ($ctrl.showTopSection('generalNote') && $ctrl.item.generalNote),
            c = (isMobile ? (getSecondChild() + getFirstChild()) : (getFirstChild() + getSecondChild())) + getThirdChild();
    return '<section id="topSection" class="preview-callsheet bg-transp centering no-top-padding row-scheduleTemp" data-id="' + $ctrl.item._id + '">' +
                '<div class="top-table-wrapper">' +
                    '<div class="time-table">' +c + '</div>' +
                '</div>' +
           '</section>';

        function getFirstChild(){
            var c;
            if(isMobile){
                var vp = $ctrl.showSection('vipDetails', 'top'),
                    tp = $ctrl.showSection('topPersons', 'top');
                if(canEdit && (vp || tp)){
                    c = getLogoView(true);
                }else {
        var pers =  vp && ($ctrl.item.topProductions || getvipDetailsContent()) ||
                    tp && ($ctrl.item.topPersons || gettopPersonsContent()) ;
                    if (pers) {
                        c = getLogoView();
                    }
                }
            }

            return '<div class="first-child ' + getBlockCls(isMobile) + '">' + (c ? c : getBoth()) + '</div>';

            function getBoth(){
                return getProductionLogo(canEdit) + getVipDetails(canEdit);
            }

            function getLogoView() {
        return '<div class="text-center dropdown-mobile" style="padding-right:24px!important" ng-click="$ctrl.isOpenedLogo=(!$ctrl.isOpenedLogo ? true : false)">' +
                    '<h2 class="grid-title show-ipad position-relative">' +
                        '<div class="full-width margin-bottom-quarter">Production Company</div>' +
                    '</h2>'  +
                    getProductionLogo(canEdit) +
                    '<div class="prod-logo sbf with-arrow hide-print" ng-class="{true:\'down-arrow\', false:\'forward-arrow\'}[$ctrl.isOpenedLogo === true]"></div>' +
                '</div>' +
                '<div class="moreTopInfo" ng-if="$ctrl.isOpenedLogo">' + getVipDetails(canEdit) + '</div>';
            }

            function getVipDetails(canEdit) {
                return get('vipDetails', 'vip-details') +
                       get('topPersons', 'top-persons');

                function get(block, tag){
                    if (!canEdit && !$ctrl.showTopSection(block)) {
                        return '';
                    }
                    return '<' + tag + ' class="topCalls clearfix display-block ' + block + '" ' + getAttr(block, canEdit, 'top') +
                        'on-get-content="$ctrl.get' + block + 'Content()"'+
                         '></' + tag + '>';
                }
            }
        }

        function getSecondChild(){
    return '<div class="second-child text-center '+ getBlockCls(isMobile) + '">' +
                personalized() +
                getProjectLogo(canEdit) +
                (isMobile ? (getDayOfDays(canEdit, true) + getStartDate(canEdit)) :'') +
                getProjectName(canEdit) +
                '<hr class="with-hr h30 visible-xs hide-print"/>' +
                getCalltime(canEdit) +
                getGeneralNote(canEdit, hasGeneralNote) +
            '</div>';
        }

        function personalized(){
           return !$ctrl.canEdit && $ctrl.info ? ('<div class="hidden-xs spacing-half-bottom"><i>Personalized for '+$ctrl.info.cast.name+'</i></div>') : '';
        }

        function getThirdChild(){
        return '<div class="third-child">' +
(isMobile ? '' : ('<div class="day-info">' + getDayOfDays(canEdit, false) + getStartDate(canEdit)) + '</div>') +
                getRight(canEdit) +
                '</div>';

            function getRight(canEdit) {
                return getWeather(canEdit) +
                       getGroup(null, canEdit, 'topCalls', 'top', false);
            }
        }

        function getDate(){
           return $ctrl.CPS.getCreatedAt($ctrl.item.startDate, $ctrl.CPS.dateFormat);
        }

        function getTime(){
            return $ctrl.SBFieldMethods.getTime($ctrl.item.startDate, $ctrl.CPS.timeFormat);
        }

        function getStartDate(canEdit) {
            return canEdit ? $ctrl.getColDisplayDiv('date') : ('<div class="day col30h">' + getDate() + '</div>');
        }

        function getCalltime(canEdit) {
            //$ctrl.info means viewing a persons calltime
        return '<h2 class="general text-center">' +
                ((canEdit || !$ctrl.info) ? 'General' : 'Your') +
                ' <span class="'+$ctrl.SBFieldTypesService.getViewEditElemSelector('type', true, $ctrl.canEdit)+'">' + $ctrl.getCallsheetTypeInfo($ctrl.item, true) + '</span>' +
                '</h2>' +

            '<div class="calltime-container calltime text-center" ' +
                (canEdit ? ('tooltip="'+calltimeTooltip+'" tooltip-placement="top"') : '') +
            '>' +
                (canEdit ? $ctrl.getColDisplayDiv('time') : ($ctrl.info ?
                    //personal time
                    $ctrl.info.getCustomTime($ctrl.info.calltime, $ctrl.CPS.timeFormat, true)
                  : getTime())) +
            '</div>' +
            //the personal calltime is up top. this is the general
           ($ctrl.info ? ('<div class="crew-calltime">General <span class="'+ $ctrl.SBFieldTypesService.getViewEditElemSelector('type', true, $ctrl.canEdit)+'">'+$ctrl.getCallsheetTypeInfo($ctrl.item, true) +'</span>: '+ getTime()+'</div>') : '');
        }

        function getProjectName(canEdit) {
            return canEdit ? $ctrl.getColDisplayDiv('header') : ('<h1 class="projectname">'+($ctrl.item.header ? $ctrl.item.header : ($ctrl.item.title + ', ' +$ctrl.CPS.product.name))+'</h1>');
        }

        function getDayOfDays(canEdit, isMobile) {
            var block = 'dayOfDays',
                v = $ctrl.item[block],
                cls = (isMobile ? ' text-center' : '') + ' col30h dayOfDays word-wrap message ';
            return canEdit ? getBlock(canEdit, block, null,'col30h') :
                ($ctrl.showTopSection(block) && v ? ('<div class="'+cls+'">'+v+'</div>') : '');
        }

        function getGeneralNote(canEdit, hasGeneralNote) {
           return canEdit ? ('<div class="messageSection">' + getBlock(canEdit, 'generalNote') + '</div>') :
                (hasGeneralNote ? ('<div class="message htmlcontent word-wrap text-center ' + ($ctrl.info ? ' spacing-half-top' : '') + '">' + $ctrl.item.generalNote + '</div>') : '');
        }

        function getProductionLogo(canEdit) {
return '<sb-resizable-img class="productionLogo display-block clearfix" ' +
            'img-size="celllong" icon="companylogo" img-prop="productionLogo" ' +
            'default-image="studiobinder-callsheet-logo1.svg" ' +  getImgOther(canEdit) + '></sb-resizable-img>';
        }

        function getProjectLogo(canEdit) {
            return '<sb-resizable-img c-class-attr="production-logo centering" img-size="prodlogocell" icon="project" img-prop="logo" ' +
                (isMobile ? 'with-img-bg="true" ' : '') +
            ($ctrl.CPS.product.logo ? ('default-image="' + $ctrl.CPS.product.logo + '" ') : '') +
            getImgOther(canEdit) + '></sb-resizable-img>';
        }

        function getImgOther(canEdit) {
            return 'area-type="square" without-initials="true" size="::null" ' +
                'item="::$ctrl.item" img-observer-service="::$ctrl.imgObserverService" load-later="true" '+
        (canEdit ? ' can-upload-attr="true" with-collection-broadcasted="true" is-avatar-attr="true" collection-prop="callsheets" ' :'');
        }

        function getWeather(canEdit) {
            var block = 'weather';
            if(!canEdit && !$ctrl.showTopSection(block)){ return '';}
            return '<weather-info class="clearfix with-bottom-xs non-callsheet-table display-block" first-loc="::$ctrl.firstLoc" '+ getAttr(block, canEdit) + '></weather-info>';
        }
    }

    function getFooterSection(canEdit) {
          if(!$ctrl.item.footerNote && !canEdit){return '';}
          var prop = 'footerNote',
              val = $ctrl.item[prop];

          return canEdit ? get ($ctrl.getColDisplayDiv(prop)) : (val ?(get(val)) : '');

          function get(item){
         return '<section class="section-bottom non-callsheet-table preview-callsheet centering">'+
                    '<div class="col20 padding-top-6"><div class="asterisk sbf sbf12 gray"></div></div>' +
                    '<div class="footernote">' + item + '</div>' +
                '</section>';
          }
    }

    function getvipDetailsContent(){
        var item  = $ctrl.item ? $ctrl.item.topProductions : null;
        if (!item) {
            $ctrl.product = $ctrl.CurrentProduct.getProduct();
            if ($ctrl.item && $ctrl.product) {
                if ($ctrl.product.production) {
                    item = (item || '') + '<div class="name strong">' + $ctrl.product.production + '</div>';
                }
                var address = $ctrl.product.address;
                if (address) {
                    item = (item || '') + '<div class="address">' + $ctrl.SBFieldMethods.getAddress(address) + '</div>';
                }
            }
        }
        return item;
    }

    function gettopPersonsContent() {
        var item = $ctrl.item ? $ctrl.item.topPersons : null;
        if (!item) {
            var topPersons = getTopPersons();
            if (topPersons) {
                item = '';
                for (var p in topPersons) {
                    var tp = topPersons[p];
                    item += '<div class="margin-bottom-quarter">';
                    var pos = getPosition(tp.posId);
                    if (pos) {
                        item += '<div class="role semibold">' + pos.shortName + ':</div>';
                    }

                    if (tp) {
                        if (tp.name) {
                            item += '<div class="name">' + tp.name + '</div>';
                        }
                        if (tp.phone) {
                            item += '<div class="phone">' + $ctrl.CPS.displayPhone(tp.phone) + '</div>';
                        }
                    }
                    item += '</div>';
                }
            }
        }

        return item;

        function getPosition(posId) {
            if (!$ctrl.positions) {
                console.log('parent for CallsheetInitCtrlService must have $ctrl.positions');
            }
            var pos = $ctrl.positions;
            if (!pos || pos.length === 0) {
                return null;
            }
            for (var i = 0, l = pos.length; i < l; i++) {
                var el = pos[i];
                if (el.posId === parseInt(posId, 10)) {
                    return el;
                }
            }
            return null;
        }

        function getTopPersons() {
            var invites = $ctrl.preLoadingService.getList($ctrl.preLoadingService.TblTypes.CallsheetInvitations);
            var TopRoles = [10, 11, 2, 9, 1, 13, 18, 19, 32];
            var topPersons = [];
            if (!invites) {
                return topPersons;
            }
            for (var j = 0; j < invites.length; j++) {
                process(invites[j]);
            }
            //sort top persons
            if (topPersons.length > 0) {
                topPersons = _.sortBy(topPersons, 'order');
            }
            return topPersons;

            function process(invite) {
                var roles = invite.roles;
                if (roles) {
                    _.find(roles, function (role) {
                        if (role && role.type === 2) {
                            var i = TopRoles.indexOf(role.posId);
                            if (i !== -1 && _.find(topPersons, function (el) {
                                return el._id === invite._id;
                            }) === undefined) {
                                var cast = $ctrl.preLoadingService.getById($ctrl.preLoadingService.TblTypes.Contacts, invite.castId);

                                topPersons.push({
                                    _id: invite._id,
                                    order: i,
                                    posId: TopRoles[i],
                                    name: cast ? cast.name : null,
                                    phone: cast ? cast.phone : null
                                });
                            }
                        }
                    });
                }
            }
        }
    }

    function getBlock(canEdit, block, optionsProp, cls) {
        return '<div class="' + block + (cls ? (' ' + cls) : '') + '" ' + getShowSection(canEdit, block, optionsProp || 'top', true) + '>' +
            $ctrl.getColDisplayDiv(block) +
            '</div>';
    }

    function getBlockCls(isMobile){
        return isMobile ? 'clearfix with-bottom-xs non-callsheet-table' : '';
    }

    function getOnChanged(canEdit, block) {
        return canEdit ? ('on-change="$ctrl.' +
            ((block === 'topPersons' || block === 'vipDetails') ? 'updateCallsheet' : 'onChangedField') +
            '(updates)" ') : '';
    }


    function getAttrInit(block, canEdit, optionsProp) {
        return 'block="'+block+'" ' +
            'can-edit="::' + canEdit + '" ' +
            'options-prop="' + optionsProp + '" ';
        // + (block === '' ? 'info="::$ctrl.info" ' : '');
    }

    function getAttr(block, canEdit, optionsProp) {
        return getAttrInit(block, canEdit, optionsProp) +
            getOnChanged(canEdit, block) +
            getShowSection(canEdit, block, 'top');
    }
}


angular.module('product.callsheet.blocks.controller.service', [
    'apiConstants.callsheet.services',
    'apiServices.Callsheets',
    'item.grid.edit.group.template.controller.service'
])
.service('CallsheetBlocksCtrlService', CallsheetBlocksCtrlService);
CallsheetBlocksCtrlService.$inject = ['GridItemEditGroupTemplateCtrlService', 'CallsheetConstantsService', 'CallsheetsService'];
function CallsheetBlocksCtrlService(GridItemEditGroupTemplateCtrlService, constantsService, service) {
    return function ($ctrl, $element){
        console.log('CallsheetBlocksCtrlService');

        $ctrl.setExtraProps = setExtraProps;

        $ctrl = new GridItemEditGroupTemplateCtrlService($ctrl, $element);

        return $ctrl;

        function setExtraProps() {
            return {
                elemType: 'CALLSHEET',
                objectType: 'callsheet',
                itemTitle: 'Callsheet',
                service: service,
                CallsheetConstantsService: constantsService
            };
        }
    }
}

angular.module('product.callsheet.break.component', [])
.component('callsheetBreak', {
    bindings: {
        break: '@',
        block: '@',
        onUpdate:'&',
        canEdit: '<'
    }, 
    controller: 'CallsheetBreakController'
}) 
.controller('CallsheetBreakController',CallsheetBreakController);
CallsheetBreakController.$inject =  ['TemplateCompileCompCtrlService', '$element'];
function CallsheetBreakController(TemplateCompileCompCtrlService, $element) {
    var $ctrl = this,
        withoutTemplateScope = true;

    $ctrl.preInit = preInit;
    $ctrl.onLoaded= onLoaded;
    $ctrl.onDestroy= onDestroy;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        console.log('CallsheetBreakController');
        $ctrl.break = $ctrl.break === 'true' || $ctrl.break === true;

        var cls = 'display-block clearfix centering ';
        if ($ctrl.canEdit) {
            cls += 'edit-page-break hide-print ' + ($ctrl.break === true ? 'with-break' : 'no-break');
            bind(true);
        } else {
            cls += 'view-page-break';
        }
        $ctrl.LCS.addClass($ctrl.element, cls);
    }

    function onLoaded(){
        $ctrl.spanSbf = $ctrl.element.querySelector('.content .sbf');
        $ctrl.spanTextBreak = $ctrl.element.querySelector('.content .textBreak');
    }

    function getItemTemplate() {
        if($ctrl.canEdit){
            return '<div>' +
                '<div class="content centering table-div">' +
                    '<div class="col30 with-padding-left">' +
                            $ctrl.LCS.getISBDiv($ctrl.break === true ? 'merge-horizontal' : 'split-horizontal', 3) +
                    '</div>' +
                    '<div class="text-left with-padding-right">' +
                        '<span class="textBreak">'+ ($ctrl.break === true ? 'Remove' : 'Add')+ '</span> PDF Page Break' +
                    '</div>' +
                '</div>';
        }else if($ctrl.break){
            return '<div class="view-page-break hide-ipad centering"></div>';
        }
        return null;
    }

    function onDestroy() {
        bind(false);
    }

    function bind(isBind) {
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.element, toggle, 'callsheetBreak');
    }

    function toggle() {
        $ctrl.break = $ctrl.break ? false : true;
        if($ctrl.break){
            $ctrl.LCS.replaceClass($ctrl.spanSbf, 'split-horizontal', 'merge-horizontal');
            $ctrl.LCS.replaceClass($ctrl.element, 'no-break', 'with-break');
            $ctrl.spanTextBreak.innerText = 'Remove';
        }else{
            $ctrl.LCS.replaceClass($ctrl.spanSbf, 'merge-horizontal', 'split-horizontal');
            $ctrl.LCS.replaceClass($ctrl.element, 'with-break', 'no-break');
            $ctrl.spanTextBreak.innerText = 'Insert';
        }
        //todo figure out how to update
        $ctrl.onUpdate({result:{block: $ctrl.block, break: $ctrl.break}});
    }

    function onChange(item) {
        if(item!==undefined){
            console.log('change title');
            var titleEl =$ctrl.element.querySelector('.gridtitle');
            if(titleEl){
                titleEl.innerText = titleEl;
            }
        }
    }
} 

angular.module('product.callsheet.bulletin.component', [
    'product.callsheet.block.init.controller.service',
    'apiPagination.Bulletin'
])
 
.component('callsheetBulletinGroup', callsheetGroupComponentParams( 'BulletinGroupCtrl'))

.controller('BulletinGroupCtrl', BulletinGroupCtrl);
BulletinGroupCtrl.$inject = ['CallsheetBlockGroupCtrlService', 'BulletinPagination', '$element'];
