                    '<div class=" centering border-bottom border-right">Invite other people</div>' +
                    '<div class="text-center centering border-bottom border-right" style="display:none">' + imgCheckNo + '</div>' +
                    '<div class="text-center centering border-bottom border-right">'+ imgCheckNo +'</div>' +
                    '<div class="text-center centering border-bottom">'+ imgCheckYes +'</div>' +
