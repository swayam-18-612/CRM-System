                    "</div>" +
                "</div>"
})
.controller('LayoutUnloggedCtrl', LayoutUnloggedCtrl);
LayoutUnloggedCtrl.$inject = ['CONFIG_NAV_LOGOUT', 'LayoutCtrlService', 'Angularytics', '$element'];
function LayoutUnloggedCtrl(CONFIG_NAV_LOGOUT, LayoutCtrlService, Angularytics, $element) {
    var $ctrl = this;
    $ctrl.Angularytics = Angularytics;

    $ctrl = new LayoutCtrlService($ctrl, $element);

    $ctrl.onLayoutInit = onLayoutInit;
    $ctrl.onOtherChanges = onOtherChanges;
    $ctrl.onLayoutDestroy = onLayoutDestroy;
    $ctrl.goToLink = goToLink;

    function onLayoutInit() {
        try {
            if (CONFIG_NAV_LOGOUT) {
                $ctrl.LCS.appendChildFragment($ctrl.element.querySelector('.isStaticPage #section-header .sidemenu #topnav'), CONFIG_NAV_LOGOUT.replaceAll( '<a ', '<a analytics-on analytics-category="unlogged-nav" '));
            }
        } catch (e) {
            console.log(e);
        }
        $ctrl.navbar = $ctrl.element.querySelector('.navbar');
        $ctrl.sidebar = $ctrl.element.querySelector('.toggle-sidebar');
        setClass();

        $ctrl.LCS.setTimeout(function() {
            bind(true);
        }, 100);
    }

    function onLayoutDestroy() {
        bind(false);
    }

    function bind(isBind){
        _.each($ctrl.navbar.querySelectorAll('a'), function (el) {
            var list = ['login','register','pricing'];
            if(isBind) {
                //el.setAttribute('analytics-on', '');
                //el.setAttribute('analytics-category', 'unlogged-nav');
                el.setAttribute('analytics-action', 'topnav ' + el.innerText);
                el.setAttribute('analytics-label', 'sb_link');
                _.each(list, function (l) {
                    if (el.href.indexOf('/' + l) !== -1) {
                        //el.removeAttribute('href');
                        el.setAttribute('data-type', l);
                        bindClick(el);
                    }
                });
            } else if(list.indexOf(el.getAttribute('data-type')) !== -1) {
                bindClick(el);
            }
            $ctrl.Angularytics.bindEvent($ctrl.LCS, el,isBind);

            function bindClick(el) {
                $ctrl.LCS.ELS.bindElementsClick(isBind, el, $ctrl.goToLink, 'page', $ctrl.LCS.ELS.clickEvent);
            }
        });
    }

    function goToLink(e) {
        $ctrl.LCS.preventDefault(e);
        var t = e.currentTarget.getAttribute('data-type');
        if (t) {
            $ctrl.CPS.transitionTo('public.' + t);
        }
    }

    function onOtherChanges(field) {
        if(field ==='windowWidth' || field ==='isMobileOpened'){
            setClass();
        }
    }

    function setClass() {
        var isSmallW = $ctrl.LCS._noSidebarGray($ctrl.windowWidth);
        var opened = $ctrl.isMobileOpened && isSmallW;

        $ctrl.LCS[opened ? 'addClass' : 'removeClass']($ctrl.navbar, 'opened');

        if (!isSmallW || $ctrl.isMobileOpened) {
            $ctrl.LCS.replaceClass($ctrl.sidebar, 'indent', 'outdent');
        } else {
            $ctrl.LCS.replaceClass($ctrl.sidebar, 'outdent', 'indent');
        }
    }
}

