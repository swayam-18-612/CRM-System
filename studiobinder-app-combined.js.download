    'page.tree.simple.controller.service.injector'
])
.constant('ElementsPageCtrlServiceInjectors', {
    pageCtrlService: 'PageTreeSimpleCtrlService',
    constantsService: 'ElementsConstantsService',
    listsService: 'TaggingCategoriesService',
    service: 'TaggingElementsService',
    SBFieldMethods: 'SBFieldMethods'
})
.service('ElementsPageCtrlService', ElementsPageCtrlService);

ElementsPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'ElementsPageCtrlServiceInjectors'];
function ElementsPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    console.log('ElementsPageCtrlService');

    return function($ctrl, $element, printPageParams){

        $ctrl.SBFieldMethods = SBFieldMethods;
        $ctrl.hasCustomGridSetting = true;

        $ctrl.onPageLoaded = onPageLoaded;
        $ctrl.getParams = getParams;
        // $ctrl.getLeftButtons = getLeftButtons;
        $ctrl.onPageTreeInitOther = onPageTreeInitOther;
        $ctrl.getListIcon = getListIcon;
        $ctrl.checkShowAddNewItem = checkShowAddNewItem;

        $ctrl.getOtherPrintPageParams = getOtherPrintPageParams;
        $ctrl.getCollabBannerInfo = getCollabBannerInfo;
        $ctrl.canShowShareInMore = canShowShareInMore;

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);

        function canShowShareInMore(item, isMobile) {
            // return  item && !item.isFolder;
            return false;
        }

        function getCollabBannerInfo(){
            return {txt: 'Create and share your own script breakdowns for free.', campaign:'collab-elements'};
        }
        $ctrl.sidebarOptions = _.extend({}, $ctrl.sidebarOptions, {
            getNewTreeItem: getNewTreeItem,
            getNewTreePopupExtraParam: getNewTreePopupExtraParam
        });

        return $ctrl;


        function getOtherPrintPageParams(){
            var val = false,
                otherItem = {};
            if(!$ctrl.ShowToggles) {
                $ctrl.ShowToggles = {
                    toggleScenes: {id: 'toggleScenes', name: 'Show Scenes', show: val},
                    toggleTags: {id: 'toggleTags', name: 'Show Tags', show: val}
                };
            } else{
                for(var prop in $ctrl.ShowToggles) {
                    $ctrl.ShowToggles[prop].show = val;
                    otherItem[prop] = val;
                }
            }
            return {
                customGridSetting: {
                    content: '<div class="customGridSetting display-block full-width column-settings form-wrapper long">' +
                            '<div class="form-group filters-shotlist centered columns-2">' +
                        '<ul class="listitems-selector with-checked">' + getItems() + '</ul>' +
                        '</div>' +
                        '</div>',
                    ShowToggles: $ctrl.ShowToggles
                },
                otherItem: otherItem
            };

            function getItems(){
                var el = '';
                for(var prop in $ctrl.ShowToggles){
                   var item = $ctrl.ShowToggles[prop]
                   el += '<li data-id="'+item.id+'" class="table-div with-cursor">' +
                            '<div class="custom-checkbox '+$ctrl.pageClass+' switch display-block">' +
                                '<label class="i-switch radiobtn">' +
                                    '<input type="checkbox"' + (item.show ?  'checked="checked"' : '')+'><i></i>' +
                                '</label>' +
                            '</div>' +
                            '<span class="text-left active thick ' + (item.show ? 'active thick': '') + '">'+item.name+'</span>' +
                        '</li>';
                }
                return el;
            }
        }

        function checkShowAddNewItem(){
            return $ctrl.listTreeService.active && $ctrl.listTreeService.active.selectedListId !== 'All';
        }

        function getListIcon(item){
            return item.isFolder ? '' : 'categ-icon';
        }

        function onPageTreeInitOther() {
            $ctrl.listTreeService.getGroupOrder = getGroupOrder;
            //if($ctrl.isPrintLayout){
            //    $ctrl.LCS.addClass($ctrl.element, 'hide-toggleTags hide-toggleScenes');
            //}
        }

        function onPageLoaded() {
            var stateParams = $ctrl.CPS.stateParams;
            if (stateParams.withNew === '1' || stateParams.withNew === 1) {

            }

            if(typeof($ctrl.onPageLoadedOther) === 'function') {
                $ctrl.onPageLoadedOther();
            }
        }

        function getGroupOrder(id) {
            var o = {};
            o[(id === 'All' || id === undefined) ? 'categoryId' : 'order'] = 1;
            return o;
        }

        function getParams() {
            return {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                scriptId: $ctrl.CPS.scriptId,
            };
        }

        function getNewTreeItem(item) {
            return {color: '#5d78ff'};
        }

        function getNewTreePopupExtraParam() {
            //for colors
            return {
                Settings: {
                    Colors: $ctrl.SBFieldMethods.Colors
                }
            };
        }

        function getLeftButtons() {
            return '<a ng-if="!$ctrl.isStripLoc && $ctrl.list.items.length>0" class="btn btn-gray btn-small without-text sbf with-margin-left pull-left" ng-class="{false:\'cal-expand\',true:\'cal-collapse\'}[$ctrl.showAll==true]" ng-click="$ctrl.toggleVariants($event)" analytics-on analytics-action="{{($ctrl.showAll ? \'Hide\':\'Show\')+ \' All Variants\'}}" tooltip="{{$ctrl.showAll ? \'Hide\':\'Show\'}} All Variants" tooltip-placement="bottom"></a>' + '</div>';
        }
    }
}

angular.module('product.elements.cast.search.component', [
    'apiServices.Contacts'
])

.component('castListSearchPopup', popupComponentParams('CastSearch1Controller'))
.controller('CastSearch1Controller');
CastSearch1Controller.$inject = ['ContactsService', 'SearchInitCtrlService', 'CompInitCtrlService'];
function CastSearch1Controller(ContactsService, SearchInitCtrlService, CompInitCtrlService) {

    var $ctrl = this;

    $ctrl = new CompInitCtrlService($ctrl);

    $ctrl.search = null;
    $ctrl.placeholder = 'Search existing cast by name…';
    $ctrl.icon = 'user';
    $ctrl.errormessage = 'Please enter a valid name so we can assign talent to this character';

    $ctrl.$onInit = $onInit;

    function $onInit() {
        if($ctrl.compOptions) {
            var compOptions;
            try {
                compOptions = JSON.parse($ctrl.compOptions);
                if (compOptions) {
                    $ctrl = $.extend($ctrl, compOptions);
                }
            } catch (e) {
            }
        }
        $ctrl = new SearchInitCtrlService($ctrl);
        $ctrl.getLogoPath = getLogoPath;
        $ctrl.getDisplayName = getDisplayName;
        $ctrl.removeExisting = removeExisting;
        $ctrl.initList = initList;
        $ctrl.searchItems = searchItems;
    }

    function getLogoPath(item) {
        return $ctrl.security.getLogoPath(item, 'profilePictureURL', 100);
    }

    function getDisplayName(item) {
        return item.name;
    }

    function removeExisting(projects, existing) {
        projects = angular.copy(projects);
        existing = angular.copy(existing);
        if (existing && existing.length > 0 && projects) {
            for (var j = projects.length - 1; j >= 0 && existing.length == 0; j--) {
                for (var i = existing.length - 1; i >= 0; i--) {
                    if (projects[j]._id == existing[i]) {
                        projects.splice(j, 1);
                        existing.splice(i, 1);
                        break;
                    }
                }
            }
        }

        return projects ? projects : [];
    }

    function initList(items) {
        $ctrl.availableItems = items;
        $ctrl.isSearching = false;
        $ctrl.setOpen(true);
    }

    function searchItems(search, productId, onSuccess, onError) {
        ContactsService.searchProjectContacts({
            q: search,
            productId: productId,
            companyId: $ctrl.CPS.companyId
        }, function (cast) {
            $ctrl.initList($ctrl.removeExisting(cast, $ctrl.castIds));
        }, function (error) {
            $ctrl.initList([]);
        });
    }
}

