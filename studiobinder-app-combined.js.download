                        '<a ng-if="$ctrl.defaultMode!==1" id="btnSwitch" class="edit-profile btn btn-small transparent" ng-style="{\'display\':$ctrl.isEditTopCard() || $ctrl.LCS.isMobileSize ? \'block\':\'none\'}" ng-click="$ctrl.setEditTopCard($ctrl.isEditTopCard() ? false : true)" ng-bind="$ctrl.isEditTopCard() ? \'Done\':\'Edit\'"></a>' +
                        '<div ng-if="$ctrl.isEditTopCard()" class="bottom-bar-fixed">' +
                            '<button class="max-width200 btn btn-primary margin-right10" type="submit" ng-click="$ctrl.saveScene()" analytics-on analytics-action="Save ' + $ctrl.itemTitle+'"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Save</button>' +
                            '<button class="width200 btn hallow" type="button" ng-click="$ctrl.closePopup()">Cancel</button>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</form>';
    }
}


angular.module('product.breakdowns.item.edit.controller.service', [
    'sb.fields.types.service',
    'apiServices.Strips',
    'product.breakdowns.item.events.service'
])
.service('StripEditPopupCtrlService', StripEditPopupCtrlService);
StripEditPopupCtrlService.$inject = ['ListItemPopupTemplateCtrlService', 'ScenePopupEventsCtrlService'];
function StripEditPopupCtrlService(ListItemPopupTemplateCtrlService, ScenePopupEventsCtrlService) {
    return function($ctrl, $element){
        console.log('StripEditPopupCtrlService');
        var updates;

        $ctrl.saveScene = saveScene;
        $ctrl.changeItemProp = changeItemProp;

        $ctrl.preInitOther = preInitOther;
        $ctrl.postInitOther = postInitOther;

        $ctrl.onLoaded = onLoaded;
        $ctrl.onDestroy = onDestroy;

        return new ListItemPopupTemplateCtrlService($ctrl, $element);

        function preInitOther() {
            if (!$ctrl.extraParam) {
                $ctrl.extraParam = {};
            }

            if($ctrl.extraParam.canEdit) {
                $ctrl.canEdit = $ctrl.extraParam.canEdit === true;
            }
            $ctrl.isScheduling = $ctrl.extraParam.isScheduling;
            $ctrl.currentListId = $ctrl.extraParam.currentListId;
            $ctrl.service = $ctrl.extraParam.service;
            $ctrl.scenePlaceholder = $ctrl.canEdit ? 'Enter scene content…' : 'There is no content for this scene';

            if ($ctrl.extraParam && $ctrl.extraParam.scriptLoadingService) {
                $ctrl.scriptLoadingService = $ctrl.extraParam.scriptLoadingService;
            }
            if ($ctrl.extraParam.index) {
                $ctrl.index = $ctrl.extraParam.index;
            }

            $ctrl.itemChangedFields = $ctrl.extraParam.changedFields;

            if($ctrl.onInitOther){
                $ctrl.onInitOther();
            }
        }

        function postInitOther(){
            $ctrl.onSave = onSave;
        }

        function onLoaded() {
            if ($ctrl.item.type !== 0) {
                $ctrl.setFocus($ctrl.extraParam.focus ? $ctrl.extraParam.focus : 1);
            }

            $ctrl.getItemById = getItemById;
            $ctrl = new ScenePopupEventsCtrlService($ctrl);
        }

        function changeItemProp(prop, result){
            if(result && result.selected){
                $ctrl.item[prop] = result.selected.val;
            }
        }

        function onDestroy() {
            if(typeof($ctrl.onListPopoverDestroy) === 'function'){$ctrl.onListPopoverDestroy();}
        }

        function getItemById() {
            return $ctrl.item;
        }

        function onSave(result) {
            var item = result ? result.item : null;
            if(item) {
                var strips = {};
                strips.set = {};
                strips.set[item._id] = item;

                result.updatesG = _.extend({}, result.updatesG, {strips: strips});
            }

            delete result.item;

            $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType +'_ITEM', result);

            $ctrl.closePopup();
        }

        function saveScene() {
            console.log('saveScene');
            updates = $ctrl.getDataToUpdate();
            if (!updates) {
                return $ctrl.closePopup();
            }

            updates.contentChanged = true;
            $ctrl.save();
        }
    }
}


angular.module('product.breakdowns.item.remove.popup.component', [
    'product.breakdowns.item.edit.controller.service'
])
.component('stripRemovePopup', popupComponentParams('StripRemovePopupCtrl'))
.controller('StripRemovePopupCtrl',StripRemovePopupCtrl);

StripRemovePopupCtrl.$inject = ['StripEditPopupCtrlService', '$element'];
function StripRemovePopupCtrl(StripEditPopupCtrlService, $element) {
    var $ctrl = this;
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new StripEditPopupCtrlService($ctrl, $element);

    function setTemplateData() {
        $ctrl.withFooterBtns = true;
        $ctrl.withBtnDisabled = true;
        $ctrl.icon = 'trash';
        $ctrl.iconLevel = 4;
        $ctrl.typeS = $ctrl.item.type === 1 ? 'Scene' : ($ctrl.item.type === 2 ? 'Banner' : 'Day Break');
        $ctrl.popupTitle = 'Remove ' + $ctrl.typeS;
        $ctrl.btnText = $ctrl.popupTitle;
    }

    function getPopupBodyContent() {
        return '<p class="text-center">Are you sure you want to remove ' + $ctrl.typeS + ' ' + ($ctrl.item.type === 1 && $ctrl.item.scene ? $ctrl.item.scene : '') + '<br/><span ng-if="$ctrl.item.name"><b>' + $ctrl.item.name.toUpperCase() + '</b>.</span></p>' +
            ($ctrl.item.type === 1 ? ('<p class="text-center">This will remove its stripboard scene, breakdown page, and shot list. Please note this can not be undone.</p>') : '');
    }
}

angular.module('product.breakdowns.item.process.controller.service', [
    'ctrl.PopupsCtrl.generalItemEdit.service'
])

.service('ProcessBreakdownsPopupCtrlService', ProcessBreakdownsPopupCtrlService);

ProcessBreakdownsPopupCtrlService.$inject = ['GeneralItemEditCtrlService', 'GanttMoment'];
function ProcessBreakdownsPopupCtrlService (GeneralItemEditCtrlService, GanttMoment) {
    return function ($ctrl, $element) {

        $ctrl.GanttMoment = GanttMoment;

        $ctrl.isPopup = true;

        $ctrl.onError = onError;
        $ctrl.sortStrips = sortStrips;
        $ctrl.autoBreaks = autoBreaks;
        $ctrl.renumberScenes = renumberScenes;
 
        $ctrl.removeAll = removeAll;

        $ctrl.preSetTemplateData = preSetTemplateData;
        $ctrl.preInitGeneral = preInitGeneral;
        $ctrl.getAutoBreaksDiv = getAutoBreaksDiv;
        $ctrl.getStartDateBlock = getStartDateBlock;
        $ctrl.getChk = getChk;
        $ctrl.initStartDate = initStartDate;
        $ctrl.toggleStartTime = toggleStartTime;

        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

        return $ctrl;

        function preSetTemplateData() {
            $ctrl.withBtnDisabled = false;
            if(typeof($ctrl.preSetTemplateDataOther) === 'function'){
                $ctrl.preSetTemplateDataOther();
            }
            $ctrl.textAnalytics = $ctrl.popupTitle;
        }

        function preInitGeneral() {
            $ctrl.modalBodyClass = 'font-size-16';
            $ctrl.modalBodyFormClass = '  autosortpopup max-fit-content';
            $ctrl.SceneFractions1 = angular.copy($ctrl.SBFieldMethods.SceneFractions);
            $ctrl.SceneFractions1.splice(0, 1);

            $ctrl.SortingTypes = [
                {id: 0, text: '—'},
                {id: 1, text: 'Scene Setting'},
                {id: 2, text: 'Day then Night'},
                {id: 3, text: 'Night then Day'},
                {id: 4, text: 'INT then EXT'},
                {id: 5, text: 'EXT then INT'},
                {id: 6, text: 'Shoot Location'},
                {id: 7, text: 'Scene Number'},
                {id: 8, text: 'Page Count'}
            ];

            $ctrl.Settings = {
                SceneFractions1: $ctrl.SceneFractions1,
                SortingTypes: $ctrl.SortingTypes
            };

            $ctrl.item = {
                autobreaks: false,
                pages: 5,
                estTimeInDay: 10,
                type: 1,
                t1: 1,//Scene Setting
                t2: 2,//Day then Night
                t3: 4//EXT than INT
            };

            $ctrl.errorMargin = 0;//0.5;

            $ctrl.removeOption = {};
            $ctrl.removeOptions = [
                {id: 4, text: 'Entire Stripboard', tooltip: ''},
                {id: 1, text: 'Day Breaks Only', tooltip: ''},
                {id: 2, text: 'Banners Only', tooltip: ''},
                {id: 3, text: 'Elements Only', tooltip: ''}
            ];

            $ctrl.currentListId = $ctrl.extraParam.currentListId;

            $ctrl.params = {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                scriptId: $ctrl.extraParam.scriptId,
                currentListId: $ctrl.currentListId
            };

            $ctrl.columnsList = [{
                formGroupClass: 'col80',
                placeholder: '#',
                prop: 'pages',
                canEdit: true,
                type: $ctrl.SBFieldTypesService.PropTypes.Pages,
                triggerEditOnCol: true,
                parentContainer: true,
                wrapperClass: 'centered',
                initListName: 'SceneFractions1',
                order: 1,
                tabIndex: 1,
                tabNextIndex: 2,
                withoutLabelInPopup: true
            }, {
                formGroupClass: 'col80',
                placeholder: 'Estimated time',
                prop: 'estTimeInDay',
                fieldClass: '  form-control with-underline centering inline-block thinner ',
                canEdit: true,
                type: $ctrl.SBFieldTypesService.PropTypes.Field,
                order: 2,
                tabIndex: 2,
                withoutLabelInPopup: true
            }];

            if(typeof($ctrl.preInitGeneralOther) === 'function'){
                $ctrl.preInitGeneralOther();
            }
        }

        function sortStrips(e) {
            var st1 = $ctrl.item.t1, st2 = $ctrl.item.t2, st3 = $ctrl.item.t3;
            if (!(st1 !== 0 || st2 !== 0 || st3 !== 0)) {return;}

            processMethod(e, 'sortStrips', setParams);
            
            function setParams() {
                var st1 = $ctrl.item.t1, st2 = $ctrl.item.t2, st3 = $ctrl.item.t3;

                if (!(st1 !== 0 || st2 !== 0 || st3 !== 0)) {
                    return false;
                }

                $ctrl.params.sortType = [];
                if (st1 !== 0) {
                    $ctrl.params.sortType.push(st1);
                }

                if (st2 !== 0 && st2 !== st1) {
                    //can't have 4 & 5 or 2&3 for st1 & st2
                    if (!(st2 === 4 && st1 === 5 || st2 === 5 && st1 === 4 ||
                        st2 === 2 && st1 === 3 || st2 === 3 && st1 === 2)) {
                        $ctrl.params.sortType.push(st2);
                    }
                }

                if (st3 !== 0 && st3 !== st1 && st3 !== st2) {
                    //can't have 4 & 5 or 2&3 for st3 & st1 or for st3 & st2
                    if (!(st3 === 4 && st1 === 5 || st3 === 5 && st1 === 4 ||
                        st3 === 2 && st1 === 3 || st3 === 3 && st1 === 2 ||
                        st3 === 4 && st2 === 5 || st3 === 5 && st2 === 4 ||
                        st3 === 2 && st2 === 3 || st3 === 3 && st2 === 2)) {
                        $ctrl.params.sortType.push(st3);
                    }
                }

                return $ctrl.item.autobreaks ? setAutoBreakParams() : true;
            }
        }

        function autoBreaks(e) {
            processMethod(e, 'autoBreaks', setAutoBreakParams);
        }

        function renumberScenes(e) {
            processMethod(e, 'renumberScenes', null);
        }

        function setAutoBreakParams() {
            if ($ctrl.item.type === 1 && $ctrl.item.pages) {
                $ctrl.params.pagesInDay = $ctrl.item.pages + $ctrl.errorMargin;
            }

            if ($ctrl.item.type === 2 && $ctrl.item.estTimeInDay) {
                $ctrl.params.estTimeInDay = parseInt($ctrl.item.estTimeInDay, 10) + $ctrl.errorMargin;
            }

            $ctrl.item.workingDays = $ctrl.workingDays.length > 0 ? $ctrl.workingDays.join('|') : null;

            if ($ctrl.item.withStartTime && $ctrl.item.workingDays) {
                $ctrl.params.date = $ctrl.item['date'];
                $ctrl.params.time = $ctrl.item['time'];
                $ctrl.params.workingDays = $ctrl.item.workingDays;
            }

            return true;
        }

        function processMethod(e, method, setParams) {
            console.log(method);

            $ctrl.preventDefault(e);
            $ctrl.error = null;

            if ($ctrl.isUpdating) {return;}
            if(!((typeof (setParams) === 'function') ? setParams() : true)){
                return;
            }

            $ctrl.isUpdating = true;

            try {
                $ctrl.service[method]($ctrl.params, onSave, function (error) {
                    onError(error, method);
                });
            }catch(e){
                console.log('processMethod: ' + method);
                console.log(e);
            }
        }

        function removeAll(e) {
            $ctrl.preventDefault(e);
            console.log('removeAll');
            if ($ctrl.isUpdating) {return;}
            $ctrl.isUpdating = true;
            $ctrl.error = null;
            var options = [];
            if ($ctrl.removeOption[4]) {
                options.push(4);
            }
            else {
                for (var i = 1; i < 4; i++) {
                    if ($ctrl.removeOption[i]) {
                        options.push(i);
                    }
                }
            }
            $ctrl.params.remove = options;
            $ctrl.service.removeAll($ctrl.params, onSave, function (error) {
                onError(error, 'remove-all');
            });
        }

        function onSave(result) {
            $ctrl.isUpdating = false;
            result.opType = $ctrl.type;
            console.log('broadcast: ' + 'ADDED_MULTIPLE_' + $ctrl.elemType + '_' + $ctrl.currentListId);
            $ctrl.broadcastRoot('ADDED_MULTIPLE_' + $ctrl.elemType + '_' + $ctrl.currentListId, result);
            $ctrl.closePopup();
        }

        function onError(error, type) {
            $ctrl.isUpdating = false;
            $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.strip.' + type + '.error');
        }

        function getAutoBreaksDiv(start) {
            return get(1, 'pages', true) +
                   get(2, 'hours',  false);

            function get(ck, txt, withMargin){
             return '<div class="table-div'+(withMargin ?' margin-bottom-quarter' : '') + '">' +
                        $ctrl.getChk(ck) +
                        '<div ng-class="{\'active\': $ctrl.item.type===' + ck + '}" class="table-div">' +
                            $ctrl.getPopupFormForSelectedCol($ctrl.columnsList[start - 1 + ck]) +
                            '<div class="with-padding-left centered"> ' + txt + '</div>' +
                        '</div>' +
                    '</div>';
            }
        }

        function getChk(val, prop) {
return '<div class="centered col24">' +
            '<div class="md-radio-button with-padding-right '+$ctrl.pageClass+'" ng-class="{\'md-checked\': $ctrl.item.' + (prop? prop : 'type') + '===' + val + '}">' +
                '<div class="md-container md-ink-ripple" ng-click="$ctrl.item.'+(prop? prop : 'type') + '=' + val + '">' +
                    '<div class="md-off"></div>' +
                    '<div class="md-on"></div>' +
                    '<div class="md-ripple-container"></div>' +
                '</div>' +
            '</div>' +
        '</div>';
        }

        function getStartDateBlock(cls, cond) {
            var cls1 = 'custom-checkbox ' + ($ctrl.pageClass || '');
        return '<div class="' + (cls ? cls : '') + ' margin-top-40 margin-bottom-half" ' + (cond ? cond : '') + '>' +
                    '<div class="col160 with-padding-right">' +
                        '<div class="'+$ctrl.getBtnActionCls()+' '+ cls1 +'" data-type="toggleStartTime"><label><input id="withStartTime" type="checkbox" name="withStartTime" ' +
            ($ctrl.item.withStartTime ? ' checked="checked"' : '') + '><span><span class="longer semibold">Set start date</span></span></label></div>' +
                    '</div>' +
                '</div>' +
                '<div class="form-group sb-hide prop-startTime">' +
                    $ctrl.getPopupFormForSelectedCol($ctrl.columnsList[$ctrl.columnsList.length - 1]) +
                '</div>' +
                '<div class="table-div full-width sb-hide prop-startTime">' +
                    '<div class="col120 centered semibold">Working days</div>' +
                    getWorkingDays('centered text-right', cls1) +
                '</div>';
        }

        function toggleStartTime(info, e){
            $ctrl.item.withStartTime = $ctrl.item.withStartTime === true ? false: true;
            var checkbox = e.currentTarget.querySelector('input');
            if($ctrl.item.withStartTime) {
                if(checkbox) {
                    checkbox.setAttribute('checked', 'checked');
                }
            }else {
                if(checkbox) {
                    checkbox.removeAttribute('checked');
                }
            }
            $ctrl.LCS[$ctrl.item.withStartTime ? 'removeClass' : 'addClass']($ctrl.element.querySelectorAll('.prop-startTime'), 'sb-hide');
        }

        function getWorkingDays(cls, cls1) {
            var el = '';
            _.each($ctrl.WeekDays, function (day) {
                var checked = $ctrl.isWorkingDay(day.value);
                el += '<div class="'+$ctrl.getBtnActionCls()+' inrow inline-block col24 custom-checkbox '+(cls1||'')+'" data-type="changeWorkingDay" data-info="' + day.value + '"><label class="text-center"><input type="checkbox"' + (checked ?' checked="checked"' : '') + '><span></span><div class="txt">' + day.name + '</div></label></div>';
            });
            return '<div class="drpWorkingDays ' + (cls || '') + ' ">' + el + '</div>';
        }

        function isWorkingDay(id) {
            return $ctrl.workingDays && $ctrl.workingDays.indexOf(id) !== -1;
        }

        function changeWorkingDay(id, e) {
            if(typeof (id) === 'string'){id = parseInt(id, 10);}
            var index = $ctrl.workingDays.indexOf(id);
            var checkbox = e.currentTarget.querySelector('input');
            if(index === -1) {
                $ctrl.workingDays.push(id);
                if(checkbox) {
                    checkbox.setAttribute('checked', 'checked');
                }
            }else {
                $ctrl.workingDays.splice(index, 1);
                if(checkbox) {
                    checkbox.removeAttribute('checked');
                }
            }
        }

        function initStartDate() {
            $ctrl.startDateProp = 'startDate';
            $ctrl.startWeekOnSunday = false;

            $ctrl.changeWorkingDay = changeWorkingDay;
            $ctrl.isWorkingDay = isWorkingDay;

            $ctrl.workingDays = [1, 2, 3, 4, 5, 6];
            setLocale();

            $ctrl.item.withStartTime = false;
            $ctrl.columnsList.push($ctrl.getColumnDate($ctrl.startDateProp));
        }

        function setLocale() { //val = 0 or 1. 1 for starts monday
            var val = $ctrl.startWeekOnSunday ? 0 : 1;
            moment.locale('en', {
                week: {
                    dow: val, // Monday is the first day of the week.
                    doy: 4 // The week that contains Jan 4th is the first week of the year.
                }
            });

            $ctrl.WeekDays = $ctrl.GanttMoment.getWeekDays(val);
        }
    }
}

angular.module('product.breakdowns.item.process.component', [
    'product.breakdowns.item.process.controller.service'
])
.component('renumberScenesPopup', popupComponentParams('RenumberScenesPopupCtrl'))

.controller('RenumberScenesPopupCtrl', RenumberScenesPopupCtrl);
RenumberScenesPopupCtrl.$inject = ['ProcessBreakdownsPopupCtrlService', '$element'];
function RenumberScenesPopupCtrl(ProcessBreakdownsPopupCtrlService, $element) {
    var $ctrl = this;


    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.preSetTemplateDataOther = preSetTemplateDataOther;

    $ctrl = new ProcessBreakdownsPopupCtrlService($ctrl, $element);

    function preSetTemplateDataOther() {
        $ctrl.icon = 'sort-strips';
        $ctrl.iconLevel = 4;
        $ctrl.popupTitle = 'Renumber Scenes';
        $ctrl.popupSubtitle = 'Are you sure?';
        $ctrl.firstBtnMethod = 'renumberScenes';
        $ctrl.btnText = $ctrl.popupTitle;
    }

