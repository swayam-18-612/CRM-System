angular.module('product.script.compare.component', [
    'apiServices.Scripts',
    'apiServices.Documents',
    'apiServices.DocumentVersions',
    'apiServices.Materials',
    'product.script.versionEdit.component',

    'product.preLoading.provider'
])
.component('scriptComparePopup',  popupComponentParams('ScriptComparePopupCtrl'))
.controller('ScriptComparePopupCtrl',ScriptComparePopupCtrl);
ScriptComparePopupCtrl.$inject = ['PreLoadingProv', 'ScriptsService','DocumentsService','DocumentVersionsService', 'MaterialsService', 'ItemTemplateCompileCtrlService', '$element'];
function ScriptComparePopupCtrl(PreLoadingProv, ScriptsService, DocumentsService,DocumentVersionsService, MaterialsService, ItemTemplateCompileCtrlService, $element) {
    var $ctrl = this;
    $ctrl.DocumentsService = DocumentsService;
    $ctrl.DocumentVersionsService = DocumentVersionsService;
    $ctrl.MaterialsService = MaterialsService;

    $ctrl.isPopup = true;

    $ctrl.withCloseBtn = true;
    $ctrl.wrapperElementClass = 'script-compare-wrapper';
    $ctrl.info = {showDrop: true};
    $ctrl.isJustScript = false;
    $ctrl.sceneTagginsClss = 'scene-taggings';

    var doc, resultComparing = {}, loaded, copyChangedScenes, changedScenes = [], checkboxes, step = 0;

    $ctrl.ImportTypes = {Removed: 1, Added: 2, Same: 3, Changed: 4, Omitted: 11, Activated: 12};
    $ctrl.StripTypes = {Scene: 1, DayBreak: 0, Banner: 2};
    $ctrl.ChangeTypes = {
        characters: 6, taggingElements: 7,
        //    action:8,dialogue:9
    };
    $ctrl.Steps = {Compare: 1, Edit: 2};

    $ctrl.compareScript = compareScript;
    // ng-click="changeCastId(cast, item._id, $event)'
    $ctrl.confirmUpdateScript = confirmUpdateScript;
    $ctrl.setName = setName;
    $ctrl.isStep = isStep;
    $ctrl.editScript = editScript;

    $ctrl.getColorStyle = getColorStyle;
    $ctrl.getColorStyleStr = getColorStyleStr;

    $ctrl.preInit = preInit;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.close = close;

    $ctrl.dontAutoloadTemplate = true;
    $ctrl.setTemplateData = setTemplateData;

    $ctrl.getItemTemplate = getItemTemplate;
    //getItemPopupTemplate ??? instead of getItemTemplate

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function setTemplateData() {
        $ctrl.withFooterBtns = true;
    }

    function preInit() {
        doc = $ctrl.DocumentsService.convertResource($ctrl.extraParam.document);
        $ctrl.documentVersion = doc ? doc.version : null;

        $ctrl.script = $ctrl.extraParam.script;
        $ctrl.scriptId = $ctrl.script ? $ctrl.extraParam.script._id : null;
        $ctrl.productId = $ctrl.script ? $ctrl.script.productId : null;

        $ctrl.syncToProject = $ctrl.extraParam.syncToProject === true;

        $ctrl.syncChanges = $ctrl.extraParam.syncChanges;
        $ctrl.customTagsKey = $ctrl.extraParam.customTagsKey;
        $ctrl.summary = $ctrl.extraParam.summary;

        $ctrl.previousVersionId = !$ctrl.syncToProject && !$ctrl.syncChanges ? null : ($ctrl.script ? $ctrl.script.documentVersionId : null);

        var sceneChanged = $ctrl.extraParam.sceneChanged;
        if(sceneChanged) {
            var isNewStrip = sceneChanged.isNewStrip;
            $ctrl.isNewStrip = _.find(['new', 'archive', 'activate', 'remove'], function (s){
                return s === isNewStrip;
            });

            $ctrl.isEditStrip = isNewStrip === 'edit' ? sceneChanged.id : null;
        }

        downloadContent();
    }

    function getExtendedParams(params){
        return _.extend({
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId
        }, params);
    }
    function onLoaded() {
        onComparingLoaded(true);
    }

    function getItemTemplate() {
        var type = ($ctrl.isEditStrip ? 'Scene' : 'Screenplay');
        $ctrl.setTemplateDataInit();
        if(!$ctrl.isLoaded){return '<preloader-center class="preloader '+($ctrl.pageClass||'')+'"></preloader-center>';}

        onComparingLoaded(false);

        //todo test more and bring back edit script
        var withEdit = false;
        //!$ctrl.syncToProject && !$ctrl.customTagsKey;

        return ($ctrl.withCloseBtn && $ctrl.nonMobileCloseBtn? $ctrl.nonMobileCloseBtn() : '') +
            '<div ms-form class="full-width msform h-full ' + $ctrl.wrapperElementClass + '">' +
            getStepCompare() +
            getStepEdit()  +
            '</div>';

        function getStepCompare() {
            if(!$ctrl.isStep($ctrl.Steps.Compare)){return '';}

            var scenes = initComparing(),
                hasV = $ctrl.previousVersion!==null,
                title = $ctrl.isEditStrip ? 'Sync Scene' :
                    (($ctrl.previousVersion || $ctrl.extraParam.summary.indexOf('sync') === 0) ? 'Sync Script' : 'Scenes to Import');

            return '<fieldset class="fieldset h-full toHide with-no-padding with-no-margin">' +
                '<div class="display-block clearfix compare-script step2 h-full">' +
                '<div class="h-full">' +
                $ctrl.getMobileBack(getBtn(hasV, true)) +
                '<div class="modal-header clearfix hide-ipad">' +
                '<div class="top-table table-div">' +
                '<div class="table-col">' +
                $ctrl.LCS.getISBDiv($ctrl.previousVersion? 'transition':'upload-2', 4, 'gray') +
                '<span class="stronger title with-margin-left">' + title + '</span>' +
                '</div>' +
                getChanges(false) +
                '</div>' +
                $ctrl.LCS.getErrorBlock()  +
                '</div>' +
                '<div class="body-table medium-template h-full '+(hasV?'':'spacing-half-top')+'">' +
                (hasV?getHeader():'') +
                '<div class="show-scrollbar-on-hover body-table-parent-wrapper h-full full-width '+(hasV?'hasv':'new-script')+'">' +
                (hasV?('<div class="column-left-screenplay h-full">' + gets('left', 'currentScript') + '</div>'):'') +
                '<div class="h-full column-right-screenplay" ng-class="{\'single-col\':$ctrl.LCS.isMobileSize||!'+hasV+'}">' + gets('right', 'newScript') + '</div>' +
                '</div>' +
                '</div>' +
                '</div>' +
                '<div class="modal-footer clearfix semi-tall hide-ipad">' +
                '<div class="text-center">' + getBtn(hasV, false) + '</div>' +
                '</div>' +
                '</div>' +
                '</fieldset>';

            function getHeader(){
                return '<div class="tableheader table-div full-width padding-bottom-0">' +
                    '<div class="table-col" ng-show="!$ctrl.LCS.isMobileSize">' + getCurrentTitle ('Current', $ctrl.previousVersion) + '</div>' +
                    '<div class="table-col" ng-style="{\'width\':!$ctrl.LCS.isMobileSize&&' + hasV + '?\'50%\':\'100%\',\'padding-left\':!$ctrl.LCS.isMobileSize&&' + hasV + '?\'24px\':\'0\'}">' +
                    '<div class="table-div">' +
                    '<div class="table-col full-width">' + getCurrentTitle($ctrl.isEditStrip ? 'Updated' : 'New', $ctrl.documentVersion) + '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>';
            }

            function getCurrentTitle (txt, v) {
                return '<span class="uppercase bold">'+txt+ ' ' + type + '</span> ' + getV(v);
            }

            function getV(v) {
                return v.version === 0 ? '' : ('<div class="display-inline col30 with-margin-left">' +
                    '<div class="version" style="' + $ctrl.getColorStyleStr(v) + '">v' + v.version + (v.subversion ? ('.' + v.subversion) : '') + '</div></div>');
            }

            function gets(panel, id) {
                return '<div id="'+panel+'" class="fix-column-height workflow-cards-scroll-wrapper fancy-scrollbar h-full">' +
                    '<div>' +
                    '<div id="'+id+'" class="with-white-bg with-padding">' +
                    '<div class="'+$ctrl.sceneTagginsClss+' list with-padding document-version-wrapper">' + scenes[id] +'</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>';
            }

            function getChanges(isMobile, cls) {
                if(!$ctrl.changes){return '';}
                var txt = '';
                $ctrl.changes.Removed = $ctrl.changes.removedStripsIds ? $ctrl.changes.removedStripsIds.length : 0;
                _.each(['Added', 'Removed', 'Omitted', 'Activated', 'Changed'], function (t){
                    var c = $ctrl.changes[t];
                    if(c){
                        txt += '<span class="circle c' + $ctrl.ImportTypes[t] + '"></span> Scene' + (c === 1 ? '' : 's') + ' ' + t + ' <span class="counter">' + $ctrl.changes[t] + '</span></span>';
                    }
                });
                return '<div class="table-col legend ' + (cls ? cls : '') + '" ng-show="' + (isMobile ? '' : '!') + '$ctrl.LCS.isMobileSize">' + txt + '</div>';
                //'<!--  <span id="script-wrapper" ><a class="edit-profile btn btn-small transparent" ng-click="$ctrl.toggleTagging()" ng-bind="(showTagging ? \'Hide\':\'Show\')+\' Tags\'"></a></span> -->'
                /*
                 '<!-- <span><span class="circle" ng-class="\'c\'+ChangeTypes.characters"></span> Characters</span>' +
                 ' <span><span class="circle" ng-class="\'c\'+ChangeTypes.elements"></span> Elements</span>-->' +
                 '<!--  <div class="custom-checkbox inrow inline-block padding-left10 col40"><label><input type="checkbox" checked="true" id="check-all"><span></span></label></div>-->' +
                 '<!--<span><span class="circle" ng-class="\'c\'+ChangeTypes.action"></span> Actions</span>' +
                 '<span><span class="circle" ng-class="\'c\'+ChangeTypes.dialogue"></span> Dialogue</span>-->' +*/
            }

            function getBtn(hasV, withHideIpad) {
                var scene = $ctrl.isEditStrip ? 'Scene' : 'Script';
                return (withEdit ? ('<button class="max-width200 btn btn-primary with-outline display-inline hide-ipad" type="button" ng-click="$ctrl.editScript($event)" analytics-on analytics-action="Edit Script" data-type="editScript" ng-class="{\'disabled\': $ctrl.isUpdating===true}" ng-disabled="$ctrl.isUpdating===true"><span class="sbf loadingicon animate-spin pull-left" ng-show="$ctrl.isUpdating===true"></span> Edit ' + scene + '</button>') : '') +
                    '<button class="max-width200 btn btn-primary display-inline" type="submit" ng-click="$ctrl.confirmUpdateScript($event)"   data-type="confirmUpdateScript"analytics-on analytics-action="Update Script" ng-class="{\'disabled\': $ctrl.isUpdating===true||$ctrl.cantUpdate===true}" ng-disabled="$ctrl.isUpdating===true||$ctrl.cantUpdate===true"><span class="sbf loadingicon animate-spin pull-left" ng-show="$ctrl.isUpdating===true"></span> ' +
($ctrl.extraParam.summary.indexOf('sync') === 0 ?  'Sync' : (hasV ?  'Update' : 'Import')) +
                    (withHideIpad ? (' <span class="hide-ipad"> ' + scene + '</span>') : (' ' + scene)) +
                    '</button>';
            }
        }

        function getStepEdit() {
            if(!withEdit || !$ctrl.isStep($ctrl.Steps.Edit)){return '';}

            return '<fieldset class="fieldset h-full toHide with-no-padding">' +
                '<div class="display-block clearfix h-full compare-script">' +
                '<div class="h-full" ng-if="$ctrl.isStep($ctrl.Steps.Edit)">' +
                '<div class="modal-header clearfix">' +
                '<div class="top-table table-div">' +
                '<div class="table-col">' +
                $ctrl.LCS.getISBDiv('pencil', 2) +
                '<span class="uppercase strong title with-margin-left">Edit '+($ctrl.syncToProject ? 'Current' : 'Imported')+'Screenplay</span>' +
                '</div>' +
                '</div>' +
                $ctrl.LCS.getErrorBlock()  +
                '</div>' +
                '<div class="h-full">' +
                '<document-compare-step class="body-table medium-template h-full '+($ctrl.previousVersion?'':'spacing-half-top')+'" previous-version="::" document-version="::$ctrl.documentVersion" is-just-script="::'+$ctrl.isJustScript+'"></document-compare-step>' +
                '</div>' +
                '</div>' +
                '<div class="modal-footer clearfix semi-tall hide-ipad" style="background: white; padding-top: 20px; padding-bottom: 20px;margin-bottom: 0;z-index: 1">' +
                '<div class="text-center">' +
                '<button class="btn btn-primary display-inline" type="button" ng-click="$ctrl.compareScript($event, false)" analytics-on analytics-action="Compare Scenes" style="max-width: 410px"><span class="sbf loadingicon animate-spin pull-left" ng-show="$ctrl.isUpdating===true"></span> Compare Scenes</button><button type="button" class="previousbtn btnstep" id="btnPrevStep" ng-disabled="$ctrl.isUpdating===true" ng-class="{\'disabled\': $ctrl.isUpdating===true}"></button>' +
                '</div>' +
                '</div>' +
                '</div>' +
                '</fieldset>';
        }
    }

    function downloadContent() {
        $ctrl.reloadTemplate();

        process($ctrl.documentVersion);

        function process(documentVersion) {
            getDownloadContent(documentVersion, function (v) {
                $ctrl.documentVersion = v;
                if ($ctrl.previousVersionId) {
                    $ctrl.DocumentVersionsService.getById($ctrl.previousVersionId, 'contentVersionId', function (v) {
                        getDownloadContent(v, initUpload);
                    }, initUpload);
                } else { //no prev script imported
                    initUpload(null);
                }

                function initUpload(previousVersion) {
                    console.log('initUpload');
                    $ctrl.previousVersion = previousVersion ? previousVersion : null;
                    $ctrl.compareScript(null, true, function () {
                        if ($ctrl.isNewStrip) {
                            updateScript();
                        } else {
                            $ctrl.reloadTemplate();
                        }
                    });
                }
            });

            function getDownloadContent(v, onComplete) {
                if (!v) {
                    return onComplete(v);
                }
                //check if there is any local version
                //check if there is any uploaded version
                //get the latest of the 2  and set it to content field
                //if local version is newer
                if (!v.contentVersionId) {
                    return onComplete(v);
                }//there is a saved version in s3 . get it and pass it for update

                var materialId = v.contentVersion && v.contentVersion.materialId ? v.contentVersion.materialId : null;
                if (!materialId) {
                    return onComplete(v);
                }

                $ctrl.MaterialsService.getDownloadLink({
                    id: materialId,
                    versionId: v.contentVersionId,
                    companyId: v.companyId,
                    productId: $ctrl.productId,
                }, function (link) {
                    //var headers = security.getHttpHeaders(state, params)
                    $ctrl.security.getRequest(link, null, function (result) {
                        var data = result && result.data !== 'undefined' ? result.data : null,
                            size = parseInt(v.contentVersion.size, 10);
                        if ((data && size > 0 || !data && size === 0) ? data : null) {
                            v.content = data;
                        }
                        onComplete(v);
                    }, function (err) {
                        console.log(err);
                        onComplete(v);
                    })
                }, function (err) {
                    console.log(err);
                    // $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.file.upload.error', 'error');
                    onComplete(v);
                });
            }
        }

    }

    function getColorStyle(item) {
        return $ctrl.DocumentVersionsService.getColorStyle(item);
    }
    function getColorStyleStr(item) {
        return $ctrl.DocumentVersionsService.getColorStyleStr(item);
    }

    function isStep(id) {
        return id === step;
    }

    function editScript(e) {
        $ctrl.preventDefault();
        $ctrl.error = false;
        changeStep( $ctrl.Steps.Edit, false);
    }

    function changeStep(s, dontTriggerBtn) {
        step = s;
        if (!dontTriggerBtn) {
            $ctrl.reloadTemplate();
        }
    }

    function getDefaultParams() {
        return getExtendedParams({
            scriptId: $ctrl.scriptId,
            syncToProject: $ctrl.syncToProject,
            summary: $ctrl.summary,
            notes: $ctrl.extraParam.notes,
            syncChanges: $ctrl.syncChanges,
            customTagsKey: $ctrl.customTagsKey,
            newDocumentVersionId: $ctrl.documentVersion._id,
            documentId: $ctrl.documentVersion.documentId,
            changeElementsSorting: !$ctrl.syncChanges || ($ctrl.previousVersionId === null || $ctrl.previousVersionId === undefined)
        });
    }

    function compareScript(e, dontTriggerBtn, next) {
        console.log('compareScript');
        $ctrl.preventDefault(e);
        if ($ctrl.isUpdating) {return;}

        $ctrl.cantUpdate = false;
        $ctrl.isUpdating = true;
        $ctrl.error = false;

        //previous script can be not in a doc
        $ctrl.syncChanges = $ctrl.extraParam.syncChanges === true;//&& $ctrl.previousVersion && $ctrl.previousVersion.content != null;

        $ctrl.security.sendGeneratorRequest(ScriptsService.getCompareScriptPath(), _.extend({
            customTagsKey: $ctrl.customTagsKey
        }, getDefaultParams()), onSuccess, onError);

        function onSuccess(result) {
            //console.log('onSendGeneratorRequest');
            if (result) {
                resultComparing = result;
                changeStep( $ctrl.Steps.Compare, dontTriggerBtn);
                var hasPrev = false;
                if(result.prevData){
                    for(var p in result.prevData){
                        hasPrev = true;
                    }
                }
                if($ctrl.syncChanges && (hasPrev && !result.changes)){
                    //todo
                    //$ctrl.error = 'There are no changes in the imported script';
                    // $ctrl.cantUpdate = true;
                }
            } else {
                $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.scripts.import.error');
                $ctrl.cantUpdate = true;
            }
            $ctrl.isUpdating = false;
            process();
        }

        function onError(error) {
            console.log('onSendGeneratorRequestError');
            if (error) {
                $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.scripts.import.error');
                $ctrl.cantUpdate = true;
            }
            process();
        }

        function process() {
            $ctrl.isUpdating = false;
            $ctrl.isLoaded = true;
            if(typeof (next) === 'function'){
                next();
            }else{
                $ctrl.reloadTemplate();
            }
        }
    }

    function setName() {
        console.log('setName');
        $ctrl.LCS.addClass( $ctrl.element.querySelectorAll('.fieldset.toHide') , 'sb-hide');
        $ctrl.LCS.removeClass( $ctrl.element.querySelectorAll('.fieldset.divSetName') , 'sb-hide');

        var el = $ctrl.element.querySelector('#scriptName');
        if(el){
            el.focus();
        }
    }

    function confirmUpdateScript(e) {
        $ctrl.preventDefault(e);

        var uploadParams = {};

        console.log('scriptVersionEditPopup');
        setShowDrop(false);

        //display immediately after import modal
        $ctrl.setScriptVersionInfo = false; // $ctrl.isScript && !$ctrl.isJustScript
        if($ctrl.setScriptVersionInfo){
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations.scriptVersionEdit, {
                elemType: $ctrl.elemType,
                itemTitle: 'Script',
                modalTitle: 'Shooting Script Details',
                btnText: 'Save Changes',
                icon: 'upload-2',
                iconLevel: 3
            }, null, null, onSuccessPopup);
        }else{
            onSuccessPopup ({name: 'Imported Script'});
        }

        function onSuccessPopup(result) {
            setShowDrop(true);
            onsuccess(result ? result.item : null);
        }

        function onsuccess(item) {
            console.log('result for onFilesSelected');
            console.log('$ctrl.onFilesSelectedInit');
            if(item){
                var props = ['name', 'color', 'notes', 'summary', 'version'];
                for(var i = 0 ; i < props.length; i ++){
                    var f = props[i], p = item[f];
                    if(p){
                        uploadParams[f] = p;
                    }
                }
            }

            updateScript(uploadParams);
        }
    }

    function setShowDrop(val) {
        if ($ctrl.info.showDrop !== val) {
            $ctrl.info.showDrop = val;
            if (!$ctrl.wrapperElement) {
                $ctrl.wrapperElement = $ctrl.element.querySelector('.' + $ctrl.wrapperElementClass);
            }
            $ctrl.LCS[$ctrl.info.showDrop ? 'removeClass' : 'addClass']($ctrl.wrapperElement, 'sb-hide');
        }
    }

    function updateScript(uploadParams) {
        console.log('updateScript');
        $ctrl.error = false;
        if ($ctrl.isUpdating) {
            return;
        }

        $ctrl.isUpdating = true;

        var unchanged = getUnchanged();
        $ctrl.security.sendGeneratorRequest(ScriptsService.getUpdateScriptPath(), _.extend({
                key: resultComparing.key,
                isNew: resultComparing.isNew
            }, unchanged && unchanged.length > 0 ? {unchanged: unchanged} : null,//list of stripIds
            getDefaultParams(), uploadParams), onsuccess, onerror);

        function onsuccess(result) {
            $ctrl.isUpdating = false;
            if (result) {
                if ($ctrl.syncToProject) {
                    result.syncToProject = true;
                }
                if (result.script) {
                    result.script.documentVersion = {
                        _id: $ctrl.documentVersion._id,
                        documentId: $ctrl.documentVersion.documentId
                    };
                    $ctrl.scriptId = result.script._id;
                }
                $ctrl.broadcastRoot('NEW_SCRIPT_UPLOADED', result);

                if ($ctrl.syncToProject) {
                    $ctrl.broadcastRoot('SCRIPT_SYNCED_TO_PROJECT', result);
                } else {
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.scripts.import.generating', 'success');
                }
                $ctrl.close();
            }
        }

        function onerror(error) {
            if (error) {
                $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.scripts.import.error');
            }
            $ctrl.isUpdating = false;
        }
    }

    function initComparing() {
        console.log('initComparing');
        $ctrl.changes = resultComparing.changes; //{Removed: 2, Changed: 6}
        loaded = {c: false, n: false};
        changedScenes = [];
        var scenes = {};

        scenes['currentScript'] = loadService('currentScript', null);
        scenes['newScript'] = loadService('newScript', resultComparing);
        return scenes;
    }

    function onComparingLoaded(isBind) {
        if(isBind && !$ctrl.isStep($ctrl.Steps.Compare)){return;}
        //if(isBind){$ctrl.rows = null;}
        //if(!$ctrl.rows) {}
        $ctrl.bindElementsClickBySelector(isBind, '.' + $ctrl.sceneTagginsClss + ' .row-schedule', onRowClick);
        $ctrl.bindElementsClickBySelector(isBind, '.' + $ctrl.sceneTagginsClss + " input[type='checkbox']", onCheckBox);
        $ctrl.bindElementClickBySelector(isBind, '#check-all', onCheckAll);

        function onRowClick(e) {
            var row = e.currentTarget,
                elId = row.getAttribute('data-id'),
                parent = $ctrl.LCS.findClosestParent(e.target, '.fix-column-height'),
                parentId = parent ? parent.getAttribute('id') : '',
                //find if is left or right
                panel = $ctrl.element.querySelector('#' + (parentId === 'right' ? 'left' : 'right') + '.fix-column-height'),
                rowId, prop;

            toggleScene(parent, elId);

            if (parentId === 'right') {
                rowId = row.getAttribute('data-prev');
                prop = 'id';
            }
            else {
                rowId = row.getAttribute('data-id');
                prop = 'prev';
            }
            if (rowId) {
                var el = panel.querySelector(".row-schedule[data-" + prop + "='" + rowId + "']");
                if (el) {
                    panel.scrollTop = el.offsetTop; //-el.offsetTop;
                    toggleScene(panel, rowId);
                }
            }
        }

        function onCheckBox(e) {
            console.log('on scriptcomp');
            var elId = e.currentTarget.getAttribute('data-id'),
                index = changedScenes.indexOf(elId),
                isChecked = true;
            if (isChecked && index !== -1) {
                changedScenes.splice(index, 1);
            }
            if (!isChecked && index === -1) {
                changedScenes.push(elId);
            }
        }

        function onCheckAll(e) {
            console.log('on scriptcomp');
            setProp(changedScenes.length > 0);

            function setProp(isChecked) {
                changedScenes = isChecked ? [] : angular.copy(copyChangedScenes);
                for (var i = 0, n = checkboxes.length; i < n; i++) {
                    var ch = checkboxes[i];
                    if (ch.getAttribute('disabled') !== 'true') {
                        if (isChecked) {
                            ch.removeAttribute('checked');
                        } else {
                            ch.setAttribute('checked', 'checked');
                        }
                    }
                }
            }
        }
    }

    function toggleScene(panel, id) {
        var data = "[data-id='" + id + "']",
            scene = panel.querySelector(".tagged-scene" + data),
            isShow = false;
        if (scene) {
            if ($ctrl.LCS.hasClass(scene, 'ng-hide')) {
                $ctrl.LCS.removeClass(scene, 'ng-hide');
                $ctrl.LCS.addClass(scene, 'ng-show');
                isShow = true;
            } else if ($ctrl.LCS.hasClass(scene, 'ng-show')) {
                $ctrl.LCS.removeClass(scene, 'ng-show');
                $ctrl.LCS.addClass(scene, 'ng-hide');
            }
            // update in the panel on the side for the matching scene
            var tag = panel.querySelector(".row-schedule" + data + " .gantt-tree-handle");
            if (tag) {
                $ctrl.LCS.removeClass(tag, 'sort-right sort-down');
                $ctrl.LCS.addClass(tag, isShow ? 'sort-down' : 'sort-right');
            }
            if (isShow) {
                $ctrl.broadcastRoot('HIGHLIGHT_TAGS_' + id);
            }
        }
    }

    function loadService(name, result) {
        var infos,
            taggings = '',
            scriptId = name ==='currentScript' ? $ctrl.scriptId : 'newScript';

        $ctrl['preLoadingService' + name] = PreLoadingProv.getScriptPreloader(getExtendedParams({
            scriptId: scriptId
        }));
        var isNewScript;
        if (result) { //new strips
            isNewScript = true;

            if (result.strips) {
                infos = result.strips ? _.filter(result.strips, function (item) {
                    return item.type !== $ctrl.StripTypes.DayBreak && item.type !== $ctrl.StripTypes.Banner;
                }) : null;
            }
            if (result.parsed) { //the new strips
                $ctrl['preLoadingService' + name].loadTablesFromData(result.parsed);
            }
        }
        $ctrl['strips' + name] = {};
        var l,
            hasQuotaTypeStrips = true,
            strips = $ctrl['preLoadingService' + name].getProcessedStripsTables({
                type: 1
            }, 'scriptPosition', false, hasQuotaTypeStrips ).strips;

        if(infos){
            infos = infos.map(function (info){
                var strip = _.find(strips, function (item) {
                    return item._id === info._id;
                });
                if(!strip && info.tempStripType === 6){ //unlinked
                    strip = _.find($ctrl.prevStrips, function (item) {
                        return item._id === info.prevStripId;
                    });
                }
                return strip ? _.extend({}, strip, info) : null;
            });
        }

        setL();

        if(!isNewScript) { // prev script
            $ctrl.prevStrips = strips;
        } else {
            if(result.changes && result.changes.removedStripsIds) {
                infos = _.sortBy((infos||[]).concat(result.changes.removedStripsIds.map(function (id) {
                    return _.extend({}, _.find($ctrl.prevStrips, function (el) {
                        return el._id === id;
                    }), {tempStripType: 1, prevStripId: id});
                })), 'scriptPosition');
                setL();
            }
        }

        function setL(){
            l = infos && infos.length > 0 ? infos.length : (strips && strips.length > 0 ? strips.length : 0);
        }

        var processStrip = function (i) {
            var item = (infos ? infos : strips)[i],
                id = item._id,
                //id strip is missing use the one from prev script
                changes = item.changes;

            if(!$ctrl.isEditStrip || $ctrl.isEditStrip &&
                (name === 'newScript' && $ctrl.isEditStrip === item.prevStripId ||
                    name !== 'newScript' && $ctrl.isEditStrip === id)) {
                taggings += getEl(item);
            }

            function getEl(item) {
                if(!item){return '';}

                $ctrl['strips' + name][id] = item;

                return ($ctrl.isEditStrip ? '' : getScene()) +
                    getTagging();

                function getScene(){
                    return '<div class="row-schedule with-cursor ' + (i === 0 ? '' : 'border-top') + ' border-bottom" data-id="' + id + '"' +
        (infos ? (' data-prev="' + item.prevStripId + '" data-type="' + item.tempStripType + '"') : '') + '>' +
                        //item.getColorClass()+"' >"+
                        '<div class="gantt-tree-handle comp sbf text-center sort-right"></div>' +
                        '<div class="scene-col text-center">' + $ctrl.SBFieldMethods.getSceneText(item) + '</div>' +
                        getStrip() +
                        getChanges() +
                        getPages() +
                        //getCheckbox();
                        '</div>';

                    function getStrip(){
                        return '<div class="title-col with-padding-left uppercase grow-column smaller-tooltip">' +
                            //display text like on the script
                            (item.contentScript ? $ctrl.LCS.getISBDiv('unlinked', 3, 'pull-left sbf18 margin-right-6', '  tooltip="Scene is not in sync with the screenplay" tooltip-placement="right"') : '') +
                            $ctrl.SBFieldMethods.getMiniTitle(item, item.contentScript ? false : true) +
                            (item.active ? '' : '<div class="omitted">OMITTED</div>') +
                            '</div>';
                    }

                    function getChanges() {
                        var elementNew = '', withChanges;
                        if (infos) {
                            for (var prop in $ctrl.ChangeTypes) {
                                var n = $ctrl.ChangeTypes[prop], c = changes ? changes[n] : null;
                                if (c) {
                                    elementNew += "<div class='col30 col-change' tooltip-placement='bottom' tooltip-html=\"'" + getTooltip(c, prop) + "'\">" +
                                        "<span class='centering circle-small legend" + n + "'></span>" +
                                        '</div>';
                                    withChanges = true;
                                }
                            }
                        }

                        return "<div class='changes-col wide-tooltip border-right'>" + elementNew + (withChanges ? '' : '&nbsp;') + "</div>";

                        function getTooltip(c, prop) {
                            var t = "<strong>Modified " + (prop === 'taggingElements' ? 'elements' : prop) + "</strong><br/>";
                            for (var e in c) {
                                var res = c[e];
                                if (res) {
                                    t += (e === 'a' ? 'Added' : 'Removed') + " (" + res.length + "): " + res.join(', ').replace(/'/g, '’') + "</br>";
                                }
                            }
                            return t;
                        }
                    }

                    function getPages() {
                        var sp = $ctrl.SBFieldMethods.getScenePage({pages: item.pagesCustom ? item.pagesCustom : item.pages});
                        return '<div class="page-col text-center"><div class="selected text-center">' +
(item.pagesCustom ? $ctrl.LCS.getISBDiv('asterisk', 2, 'pull-left sidepin gray with-margin-right hide-print') : '') + (sp.page ? ('<span class="page">' + sp.page + '</span>&nbsp;') : '') + '<span class="fr">' + sp.fr + '</span></div></div>';
                    }
                }

                function getTagging() {
                    return '<div class="tagged-scene ' + ($ctrl.isEditStrip ? '' : 'ng-hide') + '" data-id="' + id + '">' +
                                '<scene-tagging ' +
                                    'class="spacing-bottom clearfix display-block" ' +
                                    'id="scene' + id + '" ' +
                                    'item="::$ctrl.strips' + name + '[\'' + id + '\']" ' +
                                    'script-loading-service="::$ctrl.preLoadingService' + name + '" ' +
                                    'with-tagging="::false" ' +
                                    'load-tags="::true" ' +

                                    //todo: set for faster processing:
                                    'tagging-scenes="::null" ' +
                                    'categories="::null" ' +
                                    'elements="::null" ' +

                                    "max-font-size='::$ctrl.maxFontSize' " +
                                    "min-font-size='::$ctrl.minFontSize' " +
                                    "doc-wrapper-class='::$ctrl.docWrapperClass' " +
                                '></scene-tagging>' +
                            '</div>';
                }

                /* "<div><a id='btnSwitch' class='edit-profile btn btn-small transparent' ng-style=\"{'display':isEditTopCard() || $ctrl.LCS.isMobileSize ? 'block':'none'}\"></a></div>";
             ng-click="setEditTopCard(isEditTopCard() ? false : true)"
             ng-bind="isEditTopCard() ? 'Done':'Edit'"
             */
            }
        };

        if (l) {
            for (var i = 0; i < l; i++) {
                processStrip(i);
            }
        }

        // onScriptTaggingCompleted(scriptId, taggings);

        return taggings;

        function onScriptTaggingCompleted(scriptId, taggings) {
            loaded[scriptId === $ctrl.scriptId ? 'c' : 'n'] = taggings;
            var lc = loaded.c,
                ln = loaded.n;
            if (lc && ln) {
                $ctrl.allStripsLoaded = true;
                var missing = $ctrl.ImportTypes.Removed,
                    m = ln.querySelectorAll('div[data-type=\"' + missing + '\"]'),
                    l = m && m.length > 0 ? m.length : 0;

                var processItem = function (i) {
                    var item = m[i],
                        fragment = document.createDocumentFragment();
                    var process = function (el) {
                        var id = item.getAttribute('data-id'),
                            c = lc.querySelector('.' + el + '[data-id=\"' + id + '\"]');
                        if (c) {
                            var c0 = c.cloneNode(true);
                            if (el === 'row-schedule') {
                                c0.setAttribute('data-type', missing);
                                var ch = c0.querySelector('.check');
                                if (ch) {
                                    $ctrl.LCS.appendChildFragment(ch, getCheckBox(id, false, $ctrl.ImportTypes.Removed));
                                }
                            }
                            fragment.appendChild(c0);
                        }
                    };
                    process('row-schedule');
                    //  process('tagged-scene');
                    item.appendChild(fragment);
                };

                for (var i = 0; i < l; i++) {
                    processItem(i);
                }

                copyChangedScenes = angular.copy(changedScenes);
            }
        }
    }

    function getCheckBox(id, disabled, type) {
        return '<div class="custom-checkbox inrow" ' +
            //"tooltip='" + elt + "Scene' tooltip-placement='bottom'"+
            '><label><input type="checkbox" checked="checked" data-id="' + id + '" '+
            (disabled ? 'disabled="true"' : '') + '><span></span></label></div>';
    }

    function getUnchanged() {
        var res = [];
        var l1 = copyChangedScenes ? copyChangedScenes.length : 0,
            l2 = changedScenes ? changedScenes.length : 0;
        if (l1 === l2) {
            return res;
        }
        for (var i = 0; i < l1; i++) {
            var id = copyChangedScenes[i];
            if (changedScenes.indexOf(id) === -1) {
                res.push(id);
            }
        }
        return res;
    }

    function onDestroy() {
        onComparingLoaded(false);
    }


    function close(e, isCancel) {
        $ctrl.preventDefault(e);

        console.log('close script');
        if(isCancel){
            if($ctrl.documentVersion && $ctrl.documentVersion.hideInInterface) {
                $ctrl.DocumentVersionsService.deleteVersionAndDoc(getExtendedParams({
                    versionId: $ctrl.documentVersion._id,
                    documentId: $ctrl.documentVersion.documentId
                }), onsuccess, onerror);
            } else {
                onsuccess();
            }
        }

        function onsuccess() {
            $ctrl.closePopup(isCancel);
        }

        function onerror(err){
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.version.Remove.error', 'error');
        }
    }
}

angular.module('product.script.scriptEditor.component', [
])
.component('scriptEditor', {
    bindings: {
        withoutRenumber: '<?',
        staticToolbar: '<?',

        htmlContent: '<?',//compiled when preloading scenes

        content: '<?',
        initCharacters:'<',
        initLocations:'<',

        sceneNumber: '<?',
        hideLock: '<',

        placeholder: '<',
        canEdit: '<',
        onContentChanged: '&',
    },
    controller: 'ScriptEditorCtrl'
})
.controller('ScriptEditorCtrl', ScriptEditorCtrl);
ScriptEditorCtrl.$inject = ['TemplateCompileCompCtrlService', 'ScriptConvertService', '$element'];
function ScriptEditorCtrl(TemplateCompileCompCtrlService, ScriptConvertService, $element) {

    var $ctrl = this;

    $ctrl.ScriptConvertService = ScriptConvertService;

    $ctrl.onEditorContentChanged = onEditorContentChanged;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);


    function preInit() {
        if (!$ctrl.htmlContent && $ctrl.content) {
            $ctrl.htmlContent = $ctrl.ScriptConvertService.getHtmlContent($ctrl.content, $ctrl.sceneNumber);
        }
    }

    function getItemTemplate() {
    return "<div class='sceneEditor screenplayeditor screenplay-padding'>" +
                "<sb-editor class='swwysiwyg' " +
                    "with-preloader='true' " +
                    ($ctrl.withoutRenumber ? ('without-renumber="::true" ') : '') +
                    "hide-lock='::$ctrl.hideLock' " +
                    "content='::$ctrl.htmlContent' " +
                    "init-characters='::$ctrl.initCharacters' " +
                    "init-locations='::$ctrl.initLocations' " +
                    "scene-number='::$ctrl.sceneNumber' " +
                    "placeholder='" + $ctrl.placeholder + "' " +
                    "on-content-changed='$ctrl.onEditorContentChanged(editor, html, text, content, delta, oldDelta, source)' " +
                    "editor-type='screenplay' " +
                    ($ctrl.canEdit ? '' : 'read-only="true" ') +
                    'autofocus="true" ' +
                    ($ctrl.element.getAttribute('init-top-margin') ? 'init-top-margin="true"' : '') +
                "></sb-editor>" +
            "</div>";
    }

    function onEditorContentChanged(editor, html, text, content, delta, oldDelta, source) {
        if(typeof($ctrl.onContentChanged) === 'function' && $ctrl.htmlContent !== html){
            $ctrl.onContentChanged({html: html});
        }
    }
}

angular.module('product.scriptVersion.refresh.component', [
