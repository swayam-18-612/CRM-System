            if(has('data-tree-nodrag')){return true;}
            if(has('tree-nodrag')){return true;}
            return !!targetElm.hasClass('tree-nodrag');

            function has(prop) {
                var atr = targetElm.attr(prop);
                if (typeof atr !== 'undefined') {
                    return atr !== 'false';
                }
            }
        },

        /**
         * Get the event object for touches.
