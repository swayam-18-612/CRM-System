angular.module('product.material.fileStats.service',[
])
.service('FileStatsService', FileStatsService);
FileStatsService.$inject = [];
function FileStatsService() {
    var fileTypes = [
        {t: 'image', v: ['jpg', 'jpeg', 'svg', 'png', 'gif', 'tif', 'tiff', 'heif', 'heic', 'bmp', 'ico', 'webp', 'avif']},
        {t: 'video', v: ['avi', 'flv', 'wmv', 'mp4', 'mov', 'ogg', 'webm', 'ogv']},
        {t: 'audio', v: ['wav', 'mp3', 'flac']},
        {t: 'xls', v: ['xls', 'xlsx', 'csv', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet']},
        {t: 'sbdoc', v: ['txt', 'sbdoc']},
        {t: 'sbx', v: ['sbx']},
        {t: 'sbav', v: ['sbav']},
        {t: 'doc', v: ['doc', 'docx']},
        {t: 'fdx', v: ['fdx']},
        {t: 'pdf', v: ['pdf']},
        {t: 'fountain', v: ['fountain']},
        {t: 'archive', v: ['zip', 'x-7z-compressed', 'x-rar-compressed', 'x-gtar', 'x-apple-diskimage', 'x-diskcopy']},
        {t: 'epub', v: ['application/epub+zip']}
    ];

    return {
        getExtension: getExtension,
        getShortExtension: getShortExtension,
        getShortFileName: getShortFileName,
        getTextFileSize: getTextFileSize,
        getFileSize: getFileSize,
        getTextFilesSizes: getTextFilesSizes,
        getIconClass: getIconClass,
        getFileType: getFileType,
        isImageFile: isImageFile,
        isImage: isImage,
        getFilesSize: getFilesSize,
        detectFileType: detectFileType,
    };
    
    function detectFileType(mimeType, name) {
        var ext = getExtension(name);
        try{
            var x = parseInt(mimeType, 10);
            if(x){mimeType = null;}
        }catch (e) {}

        for(var i = 0, n = fileTypes.length; i < n;i++ ) {
            var ft = fileTypes[i],
                v = ft.v.join('|'),
                t = ft.t;
            //match ext || match mimetype
            if (isMatch(ext, v) || isMatch(mimeType, t + '\/('+ v +')')) {return t;}
        }

        return null;

        function isMatch(n, v) {
            return n ? new RegExp('^('+v+')$', 'i').test(n) : false;
        }
    }

    function getFileType(item) {
        var version = item && !item.isFolder ? item.version : null;
        return version ? detectFileType(version ? version.mimeType : null, version ? version.name : item.name) : null;
    }

    function isImage(item) {
        return getFileType(item) === 'image';
    }

    function isImageFile(mimeType, name) {
        if (!mimeType && !name) return false;
        var str = mimeType ? mimeType.toLowerCase().split('/') : [],// list of images that browsers can preview
            isimg = str.length === 2 && ('image' === str[0] || match(str[1]));
        return isimg ? true : matchImg(name);

        function match(name) {
            return name ? /^(jpe?g|gif|png|svg|svg\+xml|bmp|tif?f|heic|heif|webp|ico)$/i.test(name):false;
        }

        function matchImg(name) {
            var str = name ? name.toLowerCase().split('.') : [];
            var l = str.length;
            return l >= 2 && ('image' === str[0] || match(str[l - 1]));
        }
    }

    function getIconClass(item) {
        return 'file-icon-' + getFileType(item);
    }

    function getExtension(fn) {
        var str = fn ? fn.split('.') : [];
        return str && str.length > 1 ? str.pop() : 'FILE';
    }

    function getShortExtension(fn) {
        if (!fn) {
            return null;
        }
        var x = getExtension(fn).toUpperCase();
        if (x && x.length > 4) {
            if (x === 'SBDOC') {
                return x;
            }
            return x.substring(0, 4);
        }
        return x;
    }

    function getShortFileName(name) {
        var max = 44;
        if (!name) {
            return null;
        }
        if (name.length < max) {
            return name;
        }
        var ext = getExtension(name);
        return name.substring(0, max - ext.length) + '…' + ext;
    }

    function getFileSize(file) {
        var size = file ? (file.version ? file.version.size : file.size) : 0;
        try {
            return parseFloat(size);
        } catch (e) {
            return 0;
        }
    }

    function getTextFileSize(size) {
        if (!size) {
            return 0;
        }
        if (size < 1024) {
            return size + ' B';
        } else if (size < 1048576) {
            return (size / 1024).toFixed(2) + ' KB';
        } else {
            return (size / 1048576).toFixed(2) + ' MB';
        }
    }

    function getTextFilesSizes(list) {
        return getTextFileSize(getFilesSize(list.items));
    }

    function getFilesSize(items) {
        if (!items || !items.length) {
            return 0;
        }
        var sum = 0;
        _.each(items, function (item) {
            sum += getFileSize(item);
        });
        return sum;
    }
}


