                                    '<li ng-show="$ctrl.list.items.length>0" class="with-overlay inline-tree-item padding-left-40" ng-repeat="s in item.subversions track by s._id" data-id="{{::s._id}}" ng-class="{\'selected\': $ctrl.active.selectedListId===$ctrl.getSelectedIdFromItem(s)}">' +
                                    '<div class="sidebaritem full-width table-div fixed-layout">' +
