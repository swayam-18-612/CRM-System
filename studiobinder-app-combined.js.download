                                }
                            }
                            return null;
                        }
                    },

                    hasParName: function (domNode, t) {
                        return BlotService.hasClass(domNode, SBScriptEditorClass + ParTypes[t].v)
                    },

                    getHeight: function (domNode, t) {
                        return domNode.offsetHeight;
                    }
                };
                return BlotService;

                function sel(node, isAdd) {
                    var domNode = node ? node.domNode : null;
                    if (domNode) {
                        var index = domNode.className.indexOf('selected');
                        if (isAdd && index === -1 || !isAdd && index !== -1) {
                            domNode.classList[isAdd ? 'add' : 'remove']('selected');
                            node.domNode = domNode;
                        }
                    }
                    return node;
                }
            };
            return new BlotService();
        }

        function loadScriptingModule(BlotService, config) {
            var Pagination = registePagination(BlotService, config);
            var ScriptingModule = /** @class */ (function () {
                function ScriptingModule(quill, options) {
                    //console.log('ScriptingModule constructor');
                    var _this = this;
                    _this.cursorPos = null;
