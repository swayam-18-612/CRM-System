    other: '<',
}))
.controller('MyProjectsGroupCtrl', MyProjectsGroupCtrl);
MyProjectsGroupCtrl.$inject = ['GroupBlockInitCtrlService', 'ProductGroupCtrlService', 'PreLoadingProv', '$element'];
function MyProjectsGroupCtrl(GroupBlockInitCtrlService, GroupCtrlService, PreLoadingProv, $element) {
    console.log('MyProjectsGroupCtrl');
    var $ctrl = this;
    $ctrl.PreLoadingProv = PreLoadingProv;
    $ctrl.GroupCtrlService = GroupCtrlService;
    $ctrl.GroupBlockInitCtrlService = GroupBlockInitCtrlService;

    $ctrl.hasClick = hasClick;
    $ctrl.$onInit = $onInit;
    $ctrl.getBottomActions = getBottomActions;
    $ctrl.hasMobileDetails = hasMobileDetails;
    $ctrl.getInitList = getInitList;
$ctrl.onAdded = onAdded;
    $ctrl = new $ctrl.GroupCtrlService($ctrl);

    function $onInit() {
        $ctrl.isFullItem = $element[0].getAttribute('is-full-item') === 'true';
        $ctrl.customButtons = true;
        $ctrl.hideRemoveBtn = true;

        $ctrl.options = $ctrl.constantsService.Options;
        $ctrl.withCustomSettings = $ctrl.constantsService.CompOptions.withCustomSettings;

        $ctrl.products = $ctrl.other ? $ctrl.other.products : null;

        $ctrl = new $ctrl.GroupBlockInitCtrlService($ctrl, $element, $ctrl.Pagination, $ctrl.constantsService, null);
    }

    function onAdded(result) {
        var item = result ? result.item : null;
        if(!item){return;}
        $ctrl.preLoadingService1 = $ctrl.PreLoadingProv.getInstance({
            companyId: $ctrl.CPS.companyId
        }, $ctrl.PreLoadingProv.PreloadingTypes.Products);

        if ($ctrl.preLoadingService1) {
            $ctrl.preLoadingService1.modify($ctrl.preLoadingService1.TblTypes.Products, item, $ctrl.preLoadingService.Ops.Create);
        }
    }

    function hasMobileDetails(){
        return false
    }

    function hasClick(item){
        return true;
    }

    function getBottomActions() {
        return '<div class="ng-hide hide-print spacing text-center empty-state" ng-show="$ctrl.list.items.length===0">' +
            '<div class="empty-img my-projects">&nbsp;</div>'+
            '<p class="empty-txt">No active projects</p>' +
            '<a type="button" class="btn btn-small transparent navbtn col130 ' + $ctrl.getBtnActionCls() + '" data-type="createNonNg" analytics-on analytics-action="Add ' + $ctrl.itemTitle + '">'+$ctrl.LCS.getISBDiv('plus', 2, 'pull-left centered')+' <div>Create ' + $ctrl.itemTitle + '</div></a>'+
            '</div>';
    }

    function getInitList() {
        //get top maxCount projects
        //todo : implement lazy loading


        var max = 20,
            p = $ctrl.products || [];

        if(!$ctrl.products){return [];}
        var p = _.sortBy($ctrl.products, $ctrl.defaultOrder);
        if ($ctrl.defaultOrderDir < 0) {
            p = p.reverse();
        }

        if (p.length <= max) {
            return p;
        }
        var l = [];
        for (var i = 0; i < max; i++) {
            l.push(p[i]);
        }
        return l; 
    }
}

angular.module('user.dashboardPage.myScratchpad.component', [
])
.component('myScratchpad', {
    bindings: {
        canEdit: '@'
        //onMyScratchpadUpdate:'&',
    },
    controller: 'MyScratchpadCtrl'
})
.controller('MyScratchpadCtrl', MyScratchpadCtrl);

MyScratchpadCtrl.$inject = ['TemplateCompileCompCtrlService', 'CurrentDashboard', '$element'];
function MyScratchpadCtrl(TemplateCompileCompCtrlService, CurrentDashboard, $element) {
    var $ctrl = this;
    //console.log('MyScratchpadCtrl') ;
    var source = 'scratchpad';
    $ctrl.CurrentDashboard = CurrentDashboard;

    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.openProPopup = openProPopup;


    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.service = $ctrl.CurrentDashboard.service;
        $ctrl.item = $ctrl.CurrentDashboard.getDashboard();
        $ctrl.editorType = 'scratchpadshort';
        $ctrl.saveOnKeydown = true;
        $ctrl.withoutRecurringSave = true;
        $ctrl.withoutCustomOnSave = true;
        $ctrl.field = 'notes';
        //$ctrl.editorType = ''
        $ctrl.elemType = 'DASHBOARD';
        $ctrl.placeholder = 'Add private notes here (only you will see this)…';
        $ctrl.popupTitle = 'Dashboard Notes';
        $ctrl.emptyField = 'There are no notes added';

        $ctrl.onItemUpdate = onItemUpdate;
    }

    function postInit(){
        $ctrl.CurrentDashboard.onDashboardChanged($ctrl.watchers, onDashboardChanged);
    }

    function onDashboardChanged(result) {
        var settings = result ? result.settings : {};
        if (!result || (settings && !settings.withoutDBUpdate && settings.source === source)) {
            return;
        }

        console.log('CustomizeDashboardCtrl.loadDashboard');

        if (!$ctrl.isLoaded) {
            $ctrl.item = result.item;
            $ctrl.isLoaded = true;
            $ctrl.reloadTemplate();
        }
    }


    function openProPopup(type, e){
        $ctrl.CPS.openProPopup(e);
    }

    function getItemTemplate() {
        //console.log('MyScratchpad.getItemTemplate');
        var isPro = false;
        return ($ctrl.canEdit || !$ctrl.canEdit && $ctrl.item[$ctrl.field] ? ('<div ng-class="{\'hide-print\':!$ctrl.item[$ctrl.field]}">' +
                //($ctrl.hideHeader ? '' : ('<div class="header-small clearfix spacing-half-bottom">' + $ctrl.popupTitle + ($ctrl.canEdit && isPro ? '<span class="with-margin-left profeature position-relative">PRO</span>' : '') +'</div>')) +
                ($ctrl.canEdit ? ('<div id="scratchpadSection" class="notes '+(isPro ? $ctrl.getBtnActionCls():'') + '"' +
                    (isPro ? (' data-type="openProPopup" anaytics-on="" analytics-action="'+$ctrl.popupTitle+'" '
                    //+ 'data-quota="' + quotaType + '"'
                    ) : '') + '>' +
                    '<content-editor-bubble ' +
                        'class="min-height-264 full-width display-block content-editor-bubble clearfix centered sceneNotesBubble withborderbottom" ' +
                    ($ctrl.editorType ? ('editor-type="'+$ctrl.editorType+'"') : '') +
                    ($ctrl.saveOnKeydown ? (' save-on-keydown="' + $ctrl.saveOnKeydown + '" ') : '') +
                    ($ctrl.withoutRecurringSave ? (' without-recurring-save="' + $ctrl.withoutRecurringSave + '" ') : '') +
                        'placeholder="'+$ctrl.placeholder+'" ' +
                        'can-edit="::' + (isPro ? false : $ctrl.canEdit) + '" ' +
                        'field="'+$ctrl.field+'" ' +
                        'service="::$ctrl.service" ' +
                        'item="::$ctrl.item" ' +
                        'on-item-update="$ctrl.onItemUpdate(result)"' +
                    '></content-editor-bubble>' +
                '</div>') : ('<div class="spacing-half notes view-mode ql-editor full-width">'+$ctrl.item[$ctrl.field] +'</div>')) +
            '</div>') : '') ;
    }

    function onItemUpdate(result) {
        console.log('MyScratchpadCtrl.onItemUpdate');
        if(result && result.editchanges && $ctrl.item._id === result.editchanges._id) {
            var p = {};
            p[$ctrl.field] = result.editchanges[$ctrl.field];
            updateDashboard(p);
        }
    }

    function updateDashboard(changes, otherData) {
        $ctrl.CurrentDashboard.updateDashboard(changes, _.extend({source: source}, otherData));
    }
}

