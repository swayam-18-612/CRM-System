    //update contact list name on update project name
    //ensurte contact list for project is removed when project is removed or archived

    var $ctrl = this;
    $ctrl.GroupCtrlService = GroupCtrlService;
    $ctrl.TreeGroupInitCtrlService = TreeGroupInitCtrlService;

    $ctrl = new $ctrl.GroupCtrlService($ctrl);

    $ctrl.$onInit = $onInit;

