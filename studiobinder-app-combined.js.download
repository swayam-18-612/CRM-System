function TempAvscriptsService(ApiService, model) {
    var service = ApiService(model, {
        listType: 'isGroup',
        //listField: 'avscriptsListId',
        listField: 'documentVersionId',
        materialProps: ['logo'],
        withAutoBreaks: true,
        fieldsUpdatedOnOrderChanged: ['segNo', 'rowNo',  'name', 'setupId', 'avscriptsCount', 'timecode', 'duration', 'runtime', 'wordCount', 'totalWordCount']
    });

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.getEditableFields = getEditableFields;

    return service;

    function getChangedFieldForUpdateOther() {
        return ['avscriptsCount','documentId', 'setupId', 'type', 'order', 'segNo', 'rowNo', 'name', 'color', 'status', 'logo', 'logoId', 'note', 'audio', 'video', 'wordCount', 'commentsCount', 'runtime', 'duration', 'totalWordCount', 'timecode', 'timecodeRange'];
    }

    function getEditableFields(type) {
        var def = ['name', 'note', 'duration', 'runtime'], el;
        switch (type) {
            case 0:
                el = ['wordCount', 'totalWordCount'];
                break;
            case 1:
                el = ['color', 'rowNo', 'segNo', 'status', 'logo', 'audio', 'video', 'wordCount', 'commentsCount', 'timecode', 'timecodeRange'];
                break;
            case 2:
                el = ['color'];
                break;
        }

        return [].concat(el, def);
    }
}

