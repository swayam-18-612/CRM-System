angular.module('user.user-settings.confirmDeleteAccount.component', [
    'apiServices.Users'
])
.component('confirmDeleteAccountPopup', popupComponentParams('ConfirmDeleteAccountCtrl'))
.controller('ConfirmDeleteAccountCtrl', ConfirmDeleteAccountCtrl);
ConfirmDeleteAccountCtrl.$inject = ['ListItemPopupTemplateCtrlService', 'UsersService', '$element'];
function ConfirmDeleteAccountCtrl(ListItemPopupTemplateCtrlService, service, $element) {
    console.log('ConfirmDeleteAccountCtrl');
    var $ctrl = this;

    $ctrl.service = service;
    $ctrl.remove = remove;
    $ctrl.goToPrices = goToPrices;

    $ctrl.preInit = preInit;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ListItemPopupTemplateCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.name = $ctrl.item.name;
    }

    function setTemplateData() {
        $ctrl.icon = 'trash';
        $ctrl.popupTitle = 'Are you sure?';
        $ctrl.withFooterBtns = true;
        $ctrl.firstBtnMethod = 'remove';
        $ctrl.btnText = '<span>Deactivate</span><span class="hide-ipad"> Account</span>';
    }

    function getPopupBodyContent() {
        return '<p class="text-center">If you deactivate your account you will no longer be able to sign in with this email. If you just want to downgrade your plan, please do so via the <a class="'+$ctrl.getBtnActionCls()+'" data-type="goToPrices" analytics-on analytics-action=\'Downgrade Your Plan\'>plans page</a> instead so you keep the option to reuse this email in the future.</p>' +
            '<p class="text-center">Deactivation is <strong>permanent</strong> and can not be undone.</p>';
    }

    function remove(e) {
        $ctrl.preventDefault(e);
        if ($ctrl.isUpdating) {return;}
        $ctrl.isUpdating = true;
        $ctrl.service.delete($ctrl.item, onsuccess, onerror);

        function onsuccess() {
            $ctrl.isUpdating = false;
            $ctrl.broadcastRoot('CONFIRM_DELETE_ACCOUNT');
            $ctrl.closePopup({result: true});
        }

        function onerror(error) {
            $ctrl.isUpdating = false;
            $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.user.remove.error', 'error');
        }
    }

    function goToPrices() {
        $ctrl.CPS.transitionTo('user.pricing', $ctrl.CPS.currentPathParams());
        $ctrl.closePopup({result: true});
    }
}

angular.module('user.settings.profile-settings.page.component', [
    'user.settings.init.controller.service'
])
.component('profileSettingsPage', {
    bindings: {
        item: '<',
    },
    controller: 'ProfileSettingsPageCtrl'
})
.controller('ProfileSettingsPageCtrl', ProfileSettingsPageCtrl);

ProfileSettingsPageCtrl.$inject = ['UserSettingsCtrlService', 'SBFieldTypesService', '$element'];

function ProfileSettingsPageCtrl(UserSettingsCtrlService, SBFieldTypesService, $element){
   var $ctrl = this;

   $ctrl.SBFieldTypesService = SBFieldTypesService;
   $ctrl.getSettingsTemplate = getSettingsTemplate;

    $ctrl.postInitSettings = postInitSettings;
    $ctrl.setTemplateDataSettings = setTemplateDataSettings;
    $ctrl.deactivateAccount = deactivateAccount;

    $ctrl = new UserSettingsCtrlService($ctrl, $element);

    function deactivateAccount() {
        $ctrl.popupsService.open($ctrl.item, $ctrl.popupsService.operations.confirmDeleteAccount, null, $ctrl.compOptions);
    }

    function postInitSettings() {
        //$ctrl.removeWatcher($ctrl.imageUploadedWatcher);$ctrl.imageUploadedWatcher =
        $ctrl.addRootWatcher('IMAGE_UPLOADED', onImageUploaded);

        $ctrl.removeWatcher($ctrl.deleteAccountWatcher);
        $ctrl.deleteAccountWatcher = $ctrl.addRootWatcher('CONFIRM_DELETE_ACCOUNT', onConfirmDelete);
    }

    function setTemplateDataSettings() {
        $ctrl.itemChangedFields = ['name', 'email', 'phone'];
        $ctrl.formName = 'editUserInfo';
        $ctrl.icon = 'user';
        $ctrl.popupTitle = 'My Profile';
        $ctrl.btnText = 'Save';
        $ctrl.textAnalytics = 'Save Project Settings';
        $ctrl.firstBtnCls = 'full-width';

        setColumns();
    }

   function setColumns() {
       $ctrl.columnImg = {
               prop: 'logo',
               type: $ctrl.SBFieldTypesService.PropTypes.Picture,
               order: 1,
               icon:'user',
               loadLater: false,
               collectionProp: 'users',
               imgProp:'profilePictureURL',
               isAvatarAttr: true,
               areaType: 'circle',
               imgSize:  'medium',
               defaultText: 'Upload Logo',
               showLabel : false,
               canUploadAttr: true,
               canChangeName: true,
               cClassAttr: 'centering'
           };
       var formGroupClass = 'form-group field margin-bottom';
       $ctrl.columnsList = [
           {
               formGroupClass: formGroupClass ,
               type: $ctrl.SBFieldTypesService.PropTypes.Field,
               prop: 'name',
               tabIndex: 1,
               tabNextIndex: 2,
               placeholder: 'Full Name…',
               name: 'Name',
               isRequired: true,
               icon: 'user',
               canEdit:true
           }, {
               formGroupClass: formGroupClass ,
               type: $ctrl.SBFieldTypesService.PropTypes.Email,
               prop: 'email',
               tabIndex: 2,
               tabNextIndex: 3,
               placeholder: 'Email Address…',
               name: 'Email',
               isRequired: true,
               icon: 'mail',
               canEdit:true
           }, {
               formGroupClass: formGroupClass ,
               type: $ctrl.SBFieldTypesService.PropTypes.Phone,
               prop: 'phone',
               tabIndex: 3,
               tabNextIndex: 4,
               placeholder: 'Phone…',
               name: 'Phone',
                fieldClass: '  phone-number',
               isRequired: true,
               icon: 'show-flag',
               canEdit:true
           },
       ];
   }

   function getSettingsTemplate() {
        return '<div class="tab-content with-white-bg with-padding margin-half h-full h-full-55">' +
                    $ctrl.getPopupHeader() +
                    '<div class="form-wrapper spacing-half-bottom">' +
                        $ctrl.getErrorBlock() +
                        $ctrl.getPopupForm() +
                        '<div class="form-group field text-center spacing-half-top">' +$ctrl.getPopupFooterBtns() +'</div>'+
                    '</div>' +
                    '<div class="form-wrapper sb-hide">' +
                        '<hr/>' +
                        '<div class="centering spacing-half-top spacing-bottom text-center">' +
                            '<a class="text-center '+$ctrl.getBtnActionCls()+'" data-type="deactivateAccount" analytics-on analytics-action="Open Deactivate Account Popup" style="color: #ee5c67">Deactivate Account</a>' +
                        '</div>' +
                    '</div>' +
                '</div>';
    }

    function onConfirmDelete() {
        $ctrl.i18nNotifications.pushForNextRoute(null, 'crud.user.remove.success', 'success', {id: $ctrl.item._id});
        $ctrl.security.logout();
    }

    function onImageUploaded(result) {
        if(!result){return;}
        var service = $trl.getCollectionServiceForImage(),
        collection = service ? service.collectionName : null;

        console.log('ProfileSettingsPageCtrl.onImageUploaded ' + collection);

        if(resresult.collectionProp && collection && result.collectionProp !== collection){return;}

        switch(result.eventType) {
            case 'update':
                onUpdate(result);

                if ($ctrl.preLoadingService) {
                    //todo
                    // $ctrl.preLoadingService.processUpdateInfo($ctrl.preLoadingService.TblTypes.Materials, result.materials, $ctrl.preLoadingService.Ops.Create);
                }

                break;

            case 'remove':
                onRemove(result);
                break;
        }

        function onRemove(result) {
            console.log('onImageRemove in list');
            var data = result ? result.item : null;
            if(!data){return;}
            $ctrl.service.update(data, function(){
                onUpdate(result);
            }, function (error) {
                $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.image.remove.error', 'error' );
            });
        }

        function onUpdate(result) {
            var id = result && result.item ? result.item._id : null;
            if (id && $ctrl.item._id === id) {
                $ctrl.item.getUpdatedImageProps(result.updatedImage);
                $ctrl.updateCurrentUser($ctrl.item);
            }
        }
    }
}

angular.module('user.settings.init.controller.service', [
    'company.settings.init.service',
    'apiServices.Users',
    'user.user-settings.confirmDeleteAccount.component'
])
.service('UserSettingsCtrlService', UserSettingsCtrlService);
UserSettingsCtrlService.$inject = ['UsersService', 'SettingsInitCtrlService'];

function UserSettingsCtrlService(service, SettingsInitCtrlService) {
    return function ($ctrl, $element) {
        console.log('UserSettingsCtrl');
        var withFormTemplateCompileCtrlService = true;

        $ctrl.updateCurrentUser = updateCurrentUser;
        $ctrl.preInitSettings = preInitSettings;
        $ctrl.setTemplateData = setTemplateData;

        $ctrl.service = service;

        $ctrl.type = 'Edit';
        $ctrl.dontAutoloadTemplate = false;
        $ctrl.templateType = 'user';

        $ctrl = new SettingsInitCtrlService($ctrl, $element, withFormTemplateCompileCtrlService);

        return $ctrl;

        function setTemplateData() {
            $ctrl.withBtnDisabled = true;
            $ctrl.withFooterBtns = true;

            $ctrl.setTemplateDataSettings();
        }

        function preInitSettings() {
            $ctrl.onSaveGeneral = onSaveGeneral;
        }

        function onSaveGeneral(result) {
            var item = result ? result.item : null;
            if (item) {
                $ctrl.item = angular.copy($ctrl.copyItem);
                $ctrl.updateCurrentUser($ctrl.item);
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.user.' + $ctrl.formName + '.success', 'success', {name: $ctrl.item.getFullName()});
            }
        }

        function updateCurrentUser(user) {
            $ctrl.security.updateCurrentUser(user, $ctrl.SessionService);
        }
    }
}

angular.module('company.validateEmail.component', [
     'services.sessionEventsService',
    'apiServices.Users'
])
.component('validateEmail', {
     bindings: {
         onClose: '&',
         inPopup: '@'
     },
     controller: 'ValidateEmailComponentCtrl'
})
.controller('ValidateEmailComponentCtrl', ValidateEmailComponentCtrl);
ValidateEmailComponentCtrl.$inject = ['ListItemTemplateFormCtrlService', 'UsersService', 'SessionEventsService', '$element'];
 function ValidateEmailComponentCtrl(ListItemTemplateFormCtrlService, service, SessionEventsService, $element) {
     console.log('ValidateEmailComponentCtrl');
     var $ctrl = this;

     $ctrl.SessionEventsService = SessionEventsService;

     $ctrl.preInitOther = preInitOther;
     $ctrl.postInitOther = postInitOther;

     $ctrl.setTemplateData = setTemplateData;

     $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

     function preInitOther() {
         $ctrl.type = 'Edit';
         $ctrl.objectType = 'user';
         $ctrl.service = service;
         $ctrl.extraParam = {service: $ctrl.service};

         $ctrl.inPopup = $ctrl.inPopup === 'true' || $ctrl.inPopup === true;

         setColumns();
         $ctrl.onSaveGeneral = onSaveGeneral;
     }

     function postInitOther(){
         $ctrl.service.getById($ctrl.security.getCurrentCompanyId(), 'settingsId logoId', function(company){
             $ctrl.initItem(company ? company : $ctrl.security.getCurrentCompany());

             $ctrl.isLoaded = true;
             $ctrl.reloadTemplate();
         });
     }

     function updateCompany(item) {
         if (item) {
             $ctrl.security.updateCurrentCompany(item, $ctrl.SessionEventsService);
         }
     }

     function setColumns() {
         var columns = [];

         if (!$ctrl.inPopup || $ctrl.inPopup && !$ctrl.item.name) {
             columns.push({
                 type: $ctrl.SBFieldTypesService.PropTypes.Number,
                 prop: 'validationCode',
                 tabIndex: 1,
                 tabNextIndex: 2,
                 placeholder: 'Validation Code…',
                 name: 'Company',
                 isRequired: true,
                 icon:'company',
             });
         }

         columns.push({
             name: 'Avatar',
             prop: 'logo',
             type: $ctrl.SBFieldTypesService.PropTypes.Picture,
             order: 1,
             canEdit: true,
             showMobile: true,
             icon:'company',
             withoutInitials: true,
             loadLater: false,
             collectionProp: 'companies',
             imgProp:'logo',
             isAvatarAttr: true,
             areaType: 'square',
             imgSize:   'medium80',
             defaultText: 'Upload Logo',
             showLabel : true,
             canUploadAttr: true,
         });

         $ctrl.columnsList = columns;
     }

     function setTemplateData() {
         $ctrl.icon = 'email';
         $ctrl.withBtnDisabled = true;
         $ctrl.withFooterBtns = true;
         $ctrl.popupTitle = 'Validate Your Email';
         $ctrl.btnText = 'Save';
         $ctrl.textAnalytics = $ctrl.popupTitle;
         if(!$ctrl.inPopup) {
             $ctrl.firstBtnCls = 'full-width';
         }
         $ctrl.subdesc = 'We sent a validation code to your email address.';
         $ctrl.modalBodyFormClass = 'company-settings-info';
     }

     function onSaveGeneral(result) {
         var item = result ? result.item : null;
         if(item){
             $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.company.Edit.success', 'success');
             updateCompany(item);
             if($ctrl.inPopup){
                 $ctrl.onClose();
             }
         }
     }
 }


angular.module('user.share.access.component',[
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'apiServices.Collaborators',
    'user.share.collaborators.service'
])

.component('collaboratorAccessPopup', popupComponentParams('CollaboratorsAccessPopupCtrl'))
.controller('CollaboratorsAccessPopupCtrl', CollaboratorsAccessPopupCtrl);
CollaboratorsAccessPopupCtrl.$inject = ['GeneralItemEditCtrlService', 'CollaboratorsService', '$element'];
function CollaboratorsAccessPopupCtrl(GeneralItemEditCtrlService, service, $element) {

    var $ctrl = this;
    $ctrl.isPopup = true;

    var collaborator;

    $ctrl.requestAccess = requestAccess;
    $ctrl.preInitGeneral = preInitGeneral;

    $ctrl.preSetTemplateData = preSetTemplateData;
    $ctrl.getItemPopupTemplate = getItemPopupTemplate;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneral(){
        $ctrl.editPerm = $ctrl.security.Permissions.Edit;
        $ctrl.service = service;

        $ctrl.isUpdating = false;
        $ctrl.formHolderItem = {};
        $ctrl.step = $ctrl.item;

        $ctrl.item = {
            companyId: $ctrl.CPS.companyId,
            teamId: $ctrl.CPS.teamId,
            productId: $ctrl.CPS.productId,
            message: null,
            permission: $ctrl.editPerm
        };

        collaborator = $ctrl.SessionService.getSetting('user');
        if (collaborator) {
            $ctrl.item.userId = collaborator._id;
            if ($ctrl.canEdit) {
                $ctrl.item.permission = $ctrl.editPerm + 1;
            }
        }
    }

    function preSetTemplateData() {
        $ctrl.withCloseBtn = true;
        $ctrl.withFooterBtns = true;
    }
    function getItemPopupTemplate() {
        var cls = 'centering without-padding spacing max-width-424',
        permTeam = 'Request to Become a Team Member';
        return $ctrl.getItemPopupMSForm([{
            cls: cls,
            btn: getFirstStepBtn(),
            body: getFirstBody(),
            headerInfo:{
                icon: 'card',
                iconLevel: 3,
                title: 'This is a Premium Feature',
            }
        }, {
           // fCls: ' transparent',
            cls: cls,
            btn: getSecondStepBtn(),
            body: getSecBody(),
            headerInfo: {
                icon: 'paper-plane',
                title: $ctrl.CPS.hasQuotaType('collaborators') ? (collaborator && $ctrl.canEdit ? permTeam  : 'Request Edit Permissions') : permTeam,

                // subtitle: 'Request to become a '+($ctrl.canEdit ? 'team member':'collaborator'),
            }
        }, {
            btn: getThirdStepBtn(),
            body: getThirdBody(),
            bodyCls: 'full-width',
            headerInfo: {
                title: null
            }
        }], null, false, 'step="$ctrl.step"');

        function getFirstBody() {
            return '<div class="text-center medium-size spacing-half-bottom">To access this, you need to be a <a class="nextbtn" sibling="2">teammate or collaborator on the page.</a> To be granted permission, please request access from the account owner.</div>';

                /*'+ <ul class="progressdots">' +
                '<li><button class="with-primary-bg-before active"></button></li>' +
                '<li><button class="nextbtn"></button></li>' +
                '</ul>';*/
        }

        function getFirstStepBtn() {
            //get to next step
            return '<button class="nextbtn btn btn-primary transparent">Request Access</button>';
        }

        function getSecBody() {
            return '<form class="centering auto margin-top-half" name="$ctrl.formHolderItem[$ctrl.formName]" novalidate autocomplete="off">' +
                //if the link is general
                ($ctrl.item.userId ? '' : ('<div class="table-div spacing-half-bottom">' +
                    '<div class="centered col35">' +
                    $ctrl.security.getUserImageComponent('$ctrl.item', 'smaller') +
                    '</div>' +
                    '<div class="centered col140 padding-5">' +
                    '<div class="thinner">' +
                    '<input tabindex="{{$ctrl.getFocus($index, 1)}}" name="{{\'name\' + $index}}" type="text" ng-model="$ctrl.item.name" class="form-control with-underline switch-color" placeholder="Your name…" required/>' +
                    '<div ng-show="($ctrl.formHolderItem[$ctrl.formName][\'name\' + $index].$dirty || $ctrl.formHolderItem[$ctrl.formName+\'_attempted\']) && $ctrl.formHolderItem[$ctrl.formName][\'name\' + $index].$error.required" class="help-inline ng-hide lower">Please enter your name.</div>' +
                    '</div>' +
                    '</div>' +
                    '<div class="centered col160 padding-5 margin-bottom-half">' +
                    '<div class="thinner">' +
                    '<input tabindex="{{$ctrl.getFocus($index, 2)}}" name="{{\'email\' + $index}}" type="email" ng-model="$ctrl.item.email" class="form-control with-underline switch-color" placeholder="Your Email Address…" required/>' +
                    '<div ng-show="($ctrl.formHolderItem[$ctrl.formName][\'email\' + $index].$dirty || $ctrl.formHolderItem[$ctrl.formName+\'_attempted\']) && $ctrl.formHolderItem[$ctrl.formName][\'email\' + $index].$error.required" class="help-inline ng-hide lower">Insert an email address.</div>' +
                    '<div ng-show="($ctrl.formHolderItem[$ctrl.formName][\'email\' + $index].$dirty || $ctrl.formHolderItem[$ctrl.formName+\'_attempted\']) && $ctrl.formHolderItem[$ctrl.formName][\'email\' + $index].$error.email" class="help-inline ng-hide lower">Enter a valid email address.</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>')) +
                '<div class="form-group last">' +
                '<div tabindex="0" ui-focus="true" class="form-control with-underline autogrow contenteditable" placeholder="Custom message for account owner (optional)…" contenteditable="true" contenteditable-html strip-br="true" ng-model="$ctrl.item.message"></div>' +
                '</div>' +
                '</form>';

                /*'<ul class="progressdots spacing-top" ng-show="$ctrl.step !== 2">' +
                '<li><button class="previoustbtn"></button></li>' +
                '<li><button class="with-primary-bg-before active"></button></li>' +
                '</ul>' +

                '<div ng-show="$ctrl.step === 2" class="position-relative"><a class="btnAccessPermission nextbtn">' + $ctrl.LCS.getISBDiv('info', 3, 'pull-left with-margin-right') + ' Learn about sharing</a>' + '</div>';
                */
        }

        function getSecondStepBtn(cls) {
            //get to next step
            return '<button data-type="requestAccess" class="' + $ctrl.getBtnActionCls() + ' btn btn-primary btn-gray transparent ' + (cls ? cls : '') + '" ng-class="{\'disabled\': $ctrl.isUpdating || !$ctrl.formHolderItem[$ctrl.formName].$valid}" ng-disabled="$ctrl.isUpdating || !$ctrl.formHolderItem[$ctrl.formName].$valid">Request Access</button>';
        }

        function getThirdBody() {
            return '<share-permissions class="clearfix permissions-modal"></share-permissions>';
        }

        function getThirdStepBtn() {
            return '<button sibling="{{$ctrl.step===2?1:2}}" class="max-width200 uppercase btn btn-small primary previousbtn">Back</button>'
        }
    }

    function requestAccess(e) {
        $ctrl.preventDefault(e);
        if ($ctrl.isUpdating) {
            return;
        }
        $ctrl.isUpdating = true;
        $ctrl.formHolderItem[$ctrl.formName+'_attempted'] = true;
        $ctrl.error = null;
        $ctrl.service.requestAccess($ctrl.item, onsuccess, onerror);
        function onsuccess() {
            $ctrl.isUpdating = false;
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.collaborator.requestAccess.success', 'success');
            $ctrl.closePopup();
        }
        function onerror(error) {
            $ctrl.isUpdating = false;
            $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.collaborator.requestAccess.error');
        }
    }
}

angular.module('user.share', [
    'user.share.popup.component',
    'user.share.access.component',
    'user.share.permissionsPopup.component'
]);

angular.module('user.share.permissionsBtn.component', [
    'ctrl.PopupsCtrl.service',
    'services.sessionService'
])

.component('requestPermissionsBtn', {
    bindings: {
        canEdit: '<?',
        canComment: '<?',
        withRequestAccess: '<'
    },
    controller: 'RequestPermissionsBtnCtrl'
})

.controller('RequestPermissionsBtnCtrl', RequestPermissionsBtnCtrl);

RequestPermissionsBtnCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];
function RequestPermissionsBtnCtrl(TemplateCompileCompCtrlService, $element) {
    console.log('RequestPermissionsBtnCtrl');
    var $ctrl = this;

    $ctrl.btnRequestAccess = 'btnRequestAccess';
    $ctrl.btnLearn = 'btnLearn';
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function requestAccess(e) {
        $ctrl.popupsService.collaboratorPermissions();
    }

    function sharePermissions(e) {
        $ctrl.popupsService.open(null,$ctrl.popupsService.operations.sharePermissions);
    }

    function onLoaded() {
        bind(true);
    }

    function onDestroy() {
        bind(false);
    }

    function bind(isBind) {
        $ctrl.bindElementClickBySelector(isBind, '.' + $ctrl.btnRequestAccess, requestAccess);
        $ctrl.bindElementClickBySelector(isBind, '.' + $ctrl.btnLearn, sharePermissions);
    }

    function getItemTemplate() {
        var cls = $ctrl.canEdit ? 'pencil': ($ctrl.canComment ? 'note-bubble-filled' : 'eye'),
        txt = $ctrl.canEdit ? 'Edit Access': ($ctrl.canComment ? 'View & Comment' : 'View Only'),
            editPerm = 'To make changes on this page, request "edit" permissions from the company owner.',
            teamPerm ='Ask the company owner to make you a <strong>team member</strong> to have full project access.',
            perm = $ctrl.CPS.hasQuotaType('collaborators') ? editPerm : teamPerm,
            message = $ctrl.canEdit ? ('You can only <strong>edit</strong> this page. ' + teamPerm):
                ($ctrl.canComment ? ('You can only <strong>view and comment</strong> on this page. ' + perm) :
                ('You can only <strong>view</strong> this page.' + perm)) ;
return '<div dropdown class="collaborator-view one-line-tooltip hide-print with-margin-left inline-block">' +
            '<button id="btnCollaboratorView" type="button" class="btn btn-small filtersx white hide-print table-div" dropdown-toggle>' +
        $ctrl.LCS.getISBDiv(cls, 2, 'pull-left hide-desktop hide-print') +
    ' <span class="hide-ipad">'+txt+'</span> '+ $ctrl.LCS.getISBDiv('arrow-filled-down', 2, 'pull-right with-margin-left') +'</button>' +
            '<div class="dropdown-menu side-menu fadeInDownLeft" role="menu">' +
                '<div class="header">You are a '+($ctrl.canEdit ? 'collaborator' : 'reviewer')+'</div>' +
                '<div class="desc">' +
                    '<div>' + message +'</div>'+
                    //'<div class="spacing-half-top"><a class="'+$ctrl.btnLearn+'" analytics-on analytics-action="Open Permissions">Learn about sharing.</a></div>' +
                '</div>' +
    ($ctrl.withRequestAccess ? ('<div class="text-center spacing-half">' +
                    '<a style="border-radius: 2px" class="max-width200 btn primary transparent ' + $ctrl.btnRequestAccess + '">Request Access</a>' +
                '</div>') :'') +
            '</div>' +
        '</div>';
    }
}

angular.module('user.share.collaborators.service', [
    'apiServices.Collaborators',
    'services.blocksSetup'
])
.factory('RouteCollaboratorsService', RouteCollaboratorsService);
//page collabs
//if in a group - > group collabs -> uId = groupId
//if a list in a group - > list Collabs -> uId = listId
// routeCollab s for group -> load page collabs, load group collabs for uId = groupId
// routeCollab s for list -> load page collabs, load group collabs for uId = groupId
RouteCollaboratorsService.$inject = ['RootEventsService', 'SessionService', 'SBStateService', 'security', 'CollaboratorsService','BlocksSetupService'];

function RouteCollaboratorsService(RootEventsService, SessionService, SBStateService, security, CollaboratorsService, BlocksSetupService) {
    var linkedPageCollaborators = {},
        collaborators = {},
        service = {
            RootEventsService: RootEventsService,
            BlocksSetupService: BlocksSetupService,
            SessionService: SessionService,
            CollaboratorsService: CollaboratorsService,

            setListCollaborators: setListCollaborators,
            setParentCollaborators: setParentCollaborators,
            getProjectTeam: getProjectTeam,
            getTeamByIds: getTeamByIds,
            reloadCollaboratorsForState: reloadCollaboratorsForState,

            setListTreeService: setListTreeService,
            getTodoPages: getTodoPages,
            getCollaboratorsInPopup: getCollaboratorsInPopup,
            getUserCollaborators: getUserCollaborators,
            getUIdType: getUIdType,
            getUIdField: getUIdField,
            share: share,
            getShareListInfo: getShareListInfo,
            getListInfoParams: getListInfoParams,
            setListName: setListName,
            getAllCollaborators: getAllCollaborators
        };

    return service;

    function getAllCollaborators() {
        var l = [];
        _.each([collaborators, linkedPageCollaborators], function (lists) {
            if (lists) {
                for (var prop in lists) {
                    l = l.concat(lists[prop] || []);
                }
            }
        });
        return _.unique(l, '_id');
    }

    function getTeamByIds(teamIds){
        var team = service.SessionService.getSetting('team');
        return teamIds ? _.filter(team, function (item){
            var t = item.memberType; // is owner or admin or tema member is the project
            return t >= 1 ||
                t === 0 && teamIds && _.find(teamIds, function (id){return item._id === id;});
        }) : [];
    }

    function getProjectTeam(product, team) {
        if (!team) {
            team = service.SessionService.getSetting('team');
        }
        return product ? (team ? _.filter(team, function (item) {
            var t = item.memberType; // is owner or admin or team member is the project
            return t >= 1 ||
                t === 0 && product && product.teamIds && _.find(product.teamIds, function (id) {
                    return item._id === id;
                });
        }) : []) : team;
    }

    function getShareListInfo(uId, compOptions, fileList) {
        var compOptionsJson;
        if(!compOptions) {compOptions = service.compOptions;}
        //see what to do for breakdowns and calendars
        //which are level 1
        if(compOptions) {
            try {
                compOptionsJson = JSON.parse(compOptions);
            } catch (e) {
            }
        }
        var listTreeService = getListTreeService();

        if(compOptionsJson && service.todoPage.maxLevel > 0 && listTreeService && uId){
            var list = fileList ? fileList : getListInfoForId(listTreeService, uId);
            if (list) {
                return {
                    shareList: {
                        type: list.isFolder ? compOptionsJson.nameForGroup : compOptionsJson.nameForList,
                        name: list.name
                    },
                    compOptionsJson: compOptionsJson,
                    list: list
                }
            }
        }

        return null;
    }

    function getListInfoParams(uId, shareList,compOptions, fileList){
        var params = {}, list,
            info = getShareListInfo(uId, compOptions ? compOptions : service.compOptions, fileList);
        if (info) {
            if (info.compOptionsJson) {
                params.compOptions = info.compOptionsJson;
            }
            list = info.list;
            if (!shareList && info.shareList) {
                shareList = info.shareList;
            }
        }

        params.shareList = shareList;

        var isFolder = list ? list.isFolder : false, childTodoPage, isListShare = false;
        if (!isFolder) {
            childTodoPage = service.todoPage ? service.BlocksSetupService.getChildPage(service.todoPage._id) : null;

            if (childTodoPage && uId) {
                var uIdType = getUIdType(childTodoPage);
                if (uIdType) {
                    params.uId = uId;
                    params.uIdType = uIdType;
                    isListShare = true;
                }
            }
        }

        if (childTodoPage) {
            params.isPageShare = !isListShare;
        } else if (uId) {
            params.uId = uId;
            params.uIdType = 'uId';
        }

        var pageName = (isFolder || !childTodoPage) ? service.todoPage.name : childTodoPage.name;
        if (pageName && pageName !== '') {
            params.pageName = pageName;
        }

        return params;
    }

    function share(uId, shareList, compOptions, fileList, e) {
        broadcastRoot('SHARE_PAGE', {params: getListInfoParams(uId, shareList, compOptions, fileList), e: e});
    }

    function getTodoPages() {
        return service.BlocksSetupService.todoPages;
    }

    function setListTreeService(listTreeService, compOptions) {
        //if(service.todoPage.maxLevel >= 2)
        if(check(listTreeService) || !check(service.listTreeService)){
            service.listTreeService = listTreeService;
        }
        if(compOptions) {
            service.compOptions = compOptions;
        }

        function check(listTreeService){
            return listTreeService && listTreeService.isForShare;
        }
    }

    function getUIdType(todoPage){
        return todoPage ? (todoPage.parentUId ? 'parentUId' : (todoPage.uId ? 'uId' : undefined)) : undefined;
    }

    function getUIdField(todoPage){
        return todoPage ? (todoPage.parentUId ? todoPage.parentUId : (todoPage.uId ? todoPage.uId : undefined)) : undefined;
    }

    function reloadCollaboratorsForState(productId, sn) {
        console.log('reloadCollaboratorsForState: ' +
            '; productId ' + productId +
            '; stateName: ' + sn +
            '; uId: ' + service.uId +
            '; parentUId: ' + service.parentUId +
            '; todoPageId: ' + (service.todoPage ? service.todoPage._id : null));

        if (service.currentState !== sn) {
            setState(sn);
            set();

            if (service.hasShare) {
                reloadPageCollaborators({
                    collabRootId: service.collabRootId,
                    uId: service.uId,
                    parentUId: service.parentUId,
                    todoPageId: service.todoPage ? service.todoPage._id : null
                });
            }
        }

        return service.todoPage ? service.todoPage.text : null;

        function setState(sn) {
            service.treeLists = null;
            service.listTreeService = null;
            service.compOptions = null;

            service.collabRootId = undefined;
            service.parentUId = undefined;
            service.uId = undefined;
            service.uIdType = undefined;

            service.currentState = sn;
            service.productId = productId;
            service.todoPage = service.BlocksSetupService.getCurrentTodoPage(sn);
            service.hasShare = productId && service.BlocksSetupService.todoPageHasShare(sn);

            collaborators = {};
            linkedPageCollaborators = {};
        }

        function set() {
            var stateParams = SBStateService.getCurrentStateParams(),
                todoPage = service.todoPage,
                todoPageUId = todoPage ? todoPage.uId : null;

            service.collabRootId = todoPage ? (security.isCollaborator ? (security.currentCollaborator ? security.currentCollaborator.collabRootId : undefined) :
                (security.isAuthenticated() ? (todoPage.hasTree ? null : service.uId) : null)) : null;
            service.uId = todoPageUId && stateParams ? stateParams[todoPageUId] : undefined;
            if (todoPage && todoPage.parentUId && stateParams) {
                var parentUId = stateParams[todoPage.parentUId];
                if (parentUId) {
                    service.parentUId = parentUId;
                }
            }
            if (service.uId === 'All') {
                service.uId = null;
            }

            service.uIdType = getUIdType(todoPage);
        }
    }

    function getListTreeService(){
        return service.listTreeService;
    }

    function getListInfoForId(listTreeService, listId, treeType) {
        if (!listTreeService.isRecursiveTree) {
            return listTreeService.getNodeById(listId, treeType);
        }

        var list = getRecursiveList(listId, false);

        if(!listId && list && list.length > 0){
            return {
                _id: null, isFolder: true, nodes: list
            }
        }
        //if there are folders
        //need to check if parent is archived
        if (list && list.parentId) {
            var parent = getRecursiveList(list.parentId, true);
            if (!parent) {
                return null;
            }
        }
        return list;

        function getRecursiveList(listId, isFolder) {
            var list = listTreeService.preLoadingService.getObjectList(listTreeService.preLoadingService.parentRel.child, function (item) {
                var exists =  (!listTreeService.withActiveGroup || listTreeService.withActiveGroup && item.active && !item.isFolder) &&
                    (!listTreeService.withActiveTree || listTreeService.withActiveTree && item.active && item.isFolder)
                    //since share folde is not supported
                    && item.isFolder === isFolder;
                //get all lists for null
                return exists && (listId && item._id === listId || !listId);
            });
            return list && list.length > 0 ? (!listId ? list : list[0]) : null;
        }
    }


    function setListName(c, todoPage) {
        var isonparent = !c.uId;
        if(isonparent) {
            return c;
        } else{
            var l = service.treeLists ? service.treeLists[c.uId] : null;
            if (!l && todoPage.filePageId) {
                return c;
            }
            if(l){
                c.listName = l.name;
                return c;
            }
        }
        return null;
    }

    function reloadPageCollaborators(params, next) {
        var collabRootId = params.collabRootId,
            uId = params.uId,
            todoPageId = params.todoPageId,
        productId = service.productId;
        if (!productId || !todoPageId) {
            return null;
        }
        if(getRootCollaborators() !== undefined){
            onfinally();
        }else {
            params = _.extend({
                companyId: security.getCurrentCompanyId(),
                productId: productId
            }, params);
            //todo add more logic for uId

            CollaboratorsService.getAll(params, null, 'userId', onscuccess, error);

            function onscuccess(result) {
                //group collaborators based on groups
                console.log('reloadPageCollaborators');
                if(result) {
                    //for those that have access to multiple pages
                    for (var id in result) {
                        set(id !== todoPageId, result[id]);
                    }

                    function set(isLinked, pageResult) {
                        for(var id in pageResult){
                            setc(isLinked, id,  pageResult[id]);
                        }
                    }
                }
                broadcastRoot('UPDATE_PARENT_COLLABORATORS', getRootCollaborators());
                onfinally();
            }

            function error(err) {
                console.log(err);
                onfinally();
            }
        }

        function getRootCollaborators(){
            return getCollaborators(collabRootId);
        }

        function onfinally(){
            if(typeof(next) === 'function'){
                next();
            }
        }
    }

    function setListCollaborators(uId, c, isLinked) {
        //contains all collaborators for all subfolders/files
        broadcastCollabs('UPDATE_ITEM_COLLABORATORS_' + uId, c, isLinked, uId);
    }

    function setParentCollaborators(parentId, c) {
        //todo: reassess for folders . contains all collaborators for all subfolders/files
        broadcastCollabs('UPDATE_PARENT_COLLABORATORS', c, false, parentId);
    }

    function broadcastCollabs(name, c, isLinked, uId) {
        var l = c ? _.filter(c, function (item) {
            return uId && item.uId === uId || !uId && !item.uId;
        }) : null;
        setc(isLinked, uId, l);
        broadcastRoot(name, l);
    }

    function broadcastRoot(name, v){
        service.RootEventsService.broadcastRoot(name, v);
    }

    function sortCollabstByUidType(userCollabs, todoPage, uId){
        //return {userCollabs: userCollabs, collabs: collabs};
        if(!userCollabs){return userCollabs;}
        var uIdType = getUIdType(todoPage);
        if(uIdType){
            userCollabs =_.sortBy(userCollabs, 'uId');
            if(!uId) {
                userCollabs = userCollabs.reverse();
            }
        }
        return userCollabs;
    }


    function getUserCollaborators(uId, todoPage) {
        //todo double check this
        if(!todoPage){todoPage = service.todoPage;}
        var onlyForPage = true, //for parent page dont display the collabs for sublists
            result = getCollaboratorsInPopup(uId, todoPage, onlyForPage),
            collabs = result.collabs ? _.filter(result.collabs, {isGeneral: false}) : null,
            groups = collabs ? _.groupBy(collabs, 'userId') : null,
            userCollabs = [];

        for(var userId in groups){
            var g = groups[userId];
            userCollabs.push(_.max(g, 'permission'));
        }

        return sortCollabstByUidType(userCollabs, todoPage, uId);
    }

    function getCollaboratorsInPopup(uId, todoPage, onlyForPage) {
        //todo remove reloadPageCollaborators and use the info loaded per page
        // is the root for collaborator for todoPage.type = 2 (could be a folder)
        console.log('getCollaboratorsInPopup');
        //  var uId = params.uId ? params.uId : null;

        if (!uId) {
            uId = null;
        }
        var userCollabs = getListCollaborators(uId, todoPage, onlyForPage);
        return {
            selectedCollabId: service.selectedCollabId,
            collabs: sortCollabstByUidType(userCollabs, todoPage, uId)
        };

        function getListCollaborators(listId, todoPage, onlyForPage) {
            console.log('getListCollaborators: ' + listId);
            var listTreeService = getListTreeService(),
                //if is in the parent
                rootTodoPage = service.todoPage,
                rootType = rootTodoPage ? rootTodoPage.type : null,
                isSamePage = rootTodoPage && todoPage && rootTodoPage._id === todoPage._id,
                couldHaveLists = listTreeService && rootType && (rootType === 2 || rootType === 3 && rootTodoPage.filePageId),
                uId = couldHaveLists ? service.getUIdField(rootTodoPage) : null;

            //get all the lists that the user has permissions to
            service.treeLists = couldHaveLists ? getTreeLists(listTreeService, service.collabRootId) : null;

            //get collabs for listId
            var list = [],
                id = listId ? listId : null,
                type = todoPage ? todoPage.type : null;
            if(type === 2 || type === 3) {
                if (id) {
                    //get collabs for list
                    compileCollabs(id, false);
                    //get collabs for null
                    compileCollabs(null, false);
                } else {//get collabs for all the lists
                    compileCollabs(onlyForPage ? null : 'All', false);
                }

                //get parent page collaborators // for child page
                if (type === 3) {
                    //is in parent page and get all the lists in child page
                    //is in child page and get null list from parent page


                    if(!isSamePage){
                        if(id && rootTodoPage.filePageId){ //we're in parent and we need the collabs for list
                            compileCollabs(id, true);
                        }
                    }
                    if(isSamePage){
                        //if is parent page dont show the lists in the collabs //we re on parent needing the lists for all the children
                        if(!onlyForPage && todoPage.filePageId){
                            compileCollabs( 'All', true);
                        } else if(todoPage.parentPageId) {
                            compileCollabs( null, true);
                        }

                    }
                }
            } else {
                compileCollabs(id, false);
            }

            return list;

            function compileCollabs(listId, isLinked) {
                var cs = getCollaborators(listId, isLinked),
                    l = cs && cs.length > 0 ? cs.length : 0;
                if(l) {
                    for(var i = 0; i< l;i ++) {
                        var c = angular.copy(cs[i]),
                            el = _.find(list, {_id: c._id}) ? null : (uId ? setListName(c, todoPage) : c);
                        if(el){
                            list.push(el);
                        }
                    }
                }
            }

            function getTreeLists(listTreeService, listId) {
                var lists = {};
                if (listId) {
                    var n = getListInfoForId(listTreeService, listId);
                    if (n) {
                        lists[listId] = n;
                    }
                } else {
                    if (listTreeService.treeTypeScriptList) {
                        lists = _.extend(lists, process(listTreeService.treeTypeScriptList));
                    }
                    lists = _.extend(lists, process(listTreeService.treeTypeCustomList ? listTreeService.treeTypeCustomList : null));

                    function process(type) {
                        var lists = {};
                        processN(getListInfoForId(listTreeService, null, type));
                        return lists;

                        function processN(n) {
                            if (n) {
                                if (!n.isFolder) {
                                    lists[n._id] = n;
                                } else {
                                    var no = n.nodes,
                                        l = no ? no.length : 0;
                                    if (no) {
                                        for (var i = 0; i < l; i++) {
                                            processN(no[i]);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                return lists;
            }
        }
    }

    function getCollaborators(uId, isLinked) {
        var collabs = isLinked ? linkedPageCollaborators : collaborators;
        if (uId !== 'All') {
            return get(uId);
        }

        var list = [],
            page = getName(false),
            linkedPage = getName(true);
        for (var id in collabs) {
            if (!isLinked && id !== linkedPage || isLinked && id !== page) {
                var c = get(id);
                if(c && c.length > 0) {
                    list = list.concat(c);
                }
            }
        }
        return list;

        function get(uId) {
            return collabs ? collabs[getUid(uId, isLinked)] : undefined;
        }
    }

    function setc(isLinked, uId, c) {
        (isLinked ? linkedPageCollaborators : collaborators)[getUid(uId, isLinked)] = c ? c : null;
    }

    function getUid(uId, isLinked) {
        return (uId === undefined || uId === 'undefined' || uId === null || uId === 'null') ? getName(isLinked) : uId;
    }

    function getName(isLinked){
        return (isLinked ? 'Linked' : '') + 'Page';
    }
}

