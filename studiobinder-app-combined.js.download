angular.module('product.callsheet.page.view.component', [
    'product.callsheet.page.init.controller.service',
    'product.callsheet.view.component'
])
.component('callsheetViewPage', {
    controller: 'CallsheetPageViewController'
})
.controller('CallsheetPageViewController', CallsheetPageViewController);
CallsheetPageViewController.$inject =  ['CallsheetPageInitCtrlService', '$element'];
function CallsheetPageViewController(CallsheetPageInitCtrlService, $element) {
    console.log('CallsheetPageViewController');
    var $ctrl = this;

    $ctrl.getPageTemplate = getPageTemplate;

    $ctrl = new CallsheetPageInitCtrlService($ctrl, $element);

    $ctrl.$onInit = $onInit;
    $ctrl.$onDestroy = $ctrl.onPageDestroy;

    function $onInit() {
        $ctrl.LCS.addClass($ctrl.element, 'callsheet-view-page');
        $ctrl.isLoaded = true;

        $ctrl.isDifferentUser = true; //belongs to different user

        if ($ctrl.CPS.isAuthenticated && $ctrl.CPS.teamId === $ctrl.security.getCurrentTeamId()) {
            $ctrl.isDifferentUser = false;
        }

        $ctrl.initPage($element);
    }

    function getPageTemplate() {
       return '<callsheet-view show-more-menu-links="::true" with-aproval="::true" get-counters="::false" pre-loading-service="::$ctrl.preLoadingService" is-different-user="::$ctrl.isDifferentUser"></callsheet-view>';
    }
}

angular.module('apiConstants.callsheets.services', [
    'sb.fields.types.service',
    'compOptions.callsheets.constant'
])
.service('CallsheetsConstantsService', CallsheetsConstantsService);
CallsheetsConstantsService.$inject = ['SBFieldTypesService', 'CallsheetsCompOptions'];
function CallsheetsConstantsService( SBFieldTypesService, compOptions) {
    var popupTemplate = getBasePopupTemplateByTag('callsheet-edit');
    var PropTypes = SBFieldTypesService.PropTypes,

        Options = {
            columns: ['1', '2', '3', '4', '5', '6', '7'],
            view: 2
        },

        Settings = {
             Columns: angular.copy(SBApiGridColumns['callsheets'](PropTypes)),
        },

        Filters = [{value: true, text: 'Upcoming'}, {value: false, text: 'Archived'}],

        CompOptions = angular.copy(compOptions),

        ListTreeServiceParams = {
            // cachedListName: 'callsheetsList',

            maxLevel: 1,
            hideLevel0: true,
            withHarcodedAll: true,
            withArchiveGroupAsList: CompOptions.withArchiveGroupAsList, // display archive as a list
            dontStartTreeWithAll: true,

            moveInGroup: true,
            level0Name: 'All Call Sheets',
            //todo > replace db reload with cache reload
             preLoadingTableName: 'CallsheetsLists',

            ungroupOnTreeDelete: true,

            withLabelAfter: compOptions.withLabelAfter ? compOptions.withLabelAfter : (compOptions.nameForList + 's'),

            listCheckerConsidersItemsCount: true,

          //  addListOnEmptyState: true
        },

        ListParams = {
            includeFields: ['createdAt', 'status', 'title', 'productId', 'companyId', 'startDate', 'generalNote', 'callsheetSentId', 'castCount', 'callsheetsListId', 'order'],
            searchFields: ['title'],
            orderFields: ['order', 'createdBy.name', 'createdAt', 'startDate'],
            populate: 'createdById callsheetSentId',
            defaultOrder: compOptions.defaultOrder ? compOptions.defaultOrder : 'startDate',
            defaultOrderDir: compOptions.defaultOrderDir ? compOptions.defaultOrderDir : -1
        },

        KeyboardServiceParams =  {
            canCopy: ListTreeServiceParams.hasTreeCopy,
            canMove: ListTreeServiceParams.moveInGroup,
        },

        PopupOperations = {
            updateCallsheet: {
                type: 'Edit',
                template: popupTemplate,
                size: 'medium',
                transp: 'transparent'
            },
            duplicateCallsheet: {
                type: 'Duplicate',
                template: popupTemplate,
                //template: getBasePopupTemplateByTag('callsheet-duplicate'),
                size: 'fieldset',
                transp: 'transparent',
            }
        },

        Hotkeys = null,

        SidebarOptions = {
            ungroupAdditionalMessage: ' This group\'s call sheets will be moved within <b>All Call sheet</b>',
            removeAdditionalMessage: ' and all the projects within it'
        };

    return {
        PropTypes: PropTypes,
        Settings: Settings,
        Options: Options,
        Filters: {Filters: Filters},
        ViewProp: 'callsheetsView',

        CompOptions: CompOptions,
        ListTreeServiceParams: ListTreeServiceParams,
        ListParams: ListParams,
        KeyboardServiceParams: KeyboardServiceParams,

        PopupOperations: PopupOperations,
        Hotkeys: Hotkeys,
        SidebarOptions: SidebarOptions,
    };
}

angular.module('compOptions.callsheets.constant', [])
.constant('CallsheetsCompOptions', {
    overviewBlockType: 'callsheets',
    objectType: 'callsheet',
    itemTitle: 'Call Sheet',

    hasSearch: true,
    hasTree: true,
    itemIcon: 'callsheets',
    emptyIcon: 'callsheets',
    iconLevel: 6,
    listField: 'callsheetsListId',
    elemType: "CALLSHEET",
    withActiveGroup: true,
    withActiveTree: false,
    pageClass: 'page-class callsheetsPage',
    tableClass: '.scenetable.callsheetslists',
    withoutGroupSorting: true,
    withDuplicateGroupItem: true,

    expandMobileRow: true,
    expandMobileRowWithDetails: true,

    treeType: 6,
    withExportCSV: true,
    nameForList: 'Group',
    alignHandle: 'left',
    withShortHandleCol: 'col20',
    withDownload: true,
    preloadingType: 'Callsheets',
    hasBigNameInList: true,

    withArchiveGroupAsList: true, // display archive as a list


    cantDuplicateTreeOnFree: true,
    quotaTypeList: 'callsheetGroups',
    maxFreeListsCount: 0,
    defaultOrderDir: -1,
    defaultOrder: 'startDate',
});

angular.module('product.callsheets.group.component',[
    'group.controller.service',
    'product.callsheets.item.grid.component',
    'product.callsheets.group.component.service'
])

.component('callsheetGroup', treeGroupComponentParams('CallsheetsGroupCtrl'))

.controller('CallsheetsGroupCtrl', CallsheetsGroupCtrl);
CallsheetsGroupCtrl.$inject = [ 'CallsheetsGroupCtrlService', 'TreeGroupInitCtrlService', '$element'];
function CallsheetsGroupCtrl(CallsheetsGroupCtrlService, TreeGroupInitCtrlService, $element) {
    console.log('CallsheetsGroupCtrl');
    var $ctrl = this;

    $ctrl.$onInit = $onInit;

    $ctrl = new CallsheetsGroupCtrlService($ctrl);

    function $onInit() {
        $ctrl.onInit();
        $ctrl = new TreeGroupInitCtrlService($ctrl, $element, $ctrl.Pagination, false);
    }
}

angular.module('product.callsheets.group.component.service',[
    'apiPagination.Callsheets',
    'list.base.component.service'
])
.service('CallsheetsGroupCtrlService', CallsheetsGroupCtrlService);
CallsheetsGroupCtrlService.$inject = [ 'CallsheetsPagination', 'DownloadExportService', 'CPS'];
function CallsheetsGroupCtrlService(Pagination, DownloadExportService, CPS) {
    return function($ctrl){
        console.log('CallsheetsGroupCtrlService');

        $ctrl.CPS = CPS;
        $ctrl.DownloadExportService = DownloadExportService;
        $ctrl.Pagination = Pagination;

        $ctrl.quotaTracking = 'callsheetTracking';
        $ctrl.additionalMessageRemove = 'You will lose this project’s contacts, call sheets, and files.';
        $ctrl.Modes = {Edit:1, View:2, Recipients:3};

        //views and confirms
        $ctrl.getInlineActions = getInlineActions;
        $ctrl.getRowMobileActions = getRowMobileActions;
        $ctrl.getMorePopoverTemplate = getMorePopoverTemplate;

        $ctrl.processListItemColumn = processListItemColumn;
        $ctrl.process = process;
        $ctrl.viewStats = viewStats;
        $ctrl.viewDraft = viewDraft;
        $ctrl.viewDesign = viewDesign;
        $ctrl.openProPopup = openProPopup;
        $ctrl.getDownloadLink = getDownloadLink;
        $ctrl.send = send;
        $ctrl.onInit = onInit;
        $ctrl.goToProduct = goToProduct;

        return $ctrl;

        function onInit() {
            $ctrl.getItemParams = getItemParams;
            $ctrl.callsheetPDFs = $ctrl.CPS.hasQuotaType('callsheetPDFs');
            $ctrl.hasCallsheetTracking = $ctrl.CPS.hasQuotaType($ctrl.quotaTracking);
        }

        function getInlineActions(isHeader, item) {
            return ($ctrl.isPrintLayout || $ctrl.isMyCallsheets) ? '' : ('<div class="recs-col with-hover text-center hide-print hide-ipad no-drag">' +
                (isHeader ? '' : ('<a class="no-drag btn btn-small primary-faded without-text" analytics-on analytics-action="View Confirmations" ' + ('href="' + getStatsHref(item, false) + '" ') + '>' +
                    $ctrl.LCS.getISBDiv('pie-chart', 2, 'pull-left') +
                    ' <span class="hide-ipad">Confirmations</span>' +
                    '</a>')) +
                '</div>');
        }

        function getRowMobileActions(item) {
            return item.active ? [
                getStatsLi(true, item),
                getDownloadLi(true, item)
            ] : null;
        }

        function send(item, param, e) {
            console.log('send');
            $ctrl.CPS.loadQuotaPopup('callsheetBuilder', process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});
            function process() {
                $ctrl.popupsService.open(item, $ctrl.popupsService.operations.sendCallsheet, {
                }, $ctrl.compOptions, function () {});
            }

            /*  var modalInstance = $modal.open(params);
              modalInstance.result.then(
                  function (el) {
                      $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.callsheet.send.success', 'success', {name: 'this'});
                      // goToCallsheets();
                  },
                  function (error) {
                      if (error !== 'cancel' && error !== 'backdrop click' && error !== 'escape key press') {

                      }
                  }
              );*/
        }

        function getMorePopoverTemplate(item, isMobile) {
            var isDraft = item.status === 0,
                items = [];
            if (item.active) {
                if (!isDraft) {
                    if (!isMobile) {
                        items.push(getStatsLi(isMobile, item));
                    }

                    items.push({
                        type: 'send',
                        action: 'Resend ' + $ctrl.itemTitle,
                        icon: 'paper-plane'
                    });
                }

                items.push(getViewDraftLi(item, isMobile, isDraft));

                if (!isMobile) {
                    items.push(getDownloadLi(true, item));
                }

                items.push(getDesignLi(item, isMobile));

                if (!isMobile) {
                    items.push({
                        type: 'edit',
                        action: 'Rename ' + $ctrl.itemTitle,
                        icon: 'title'
                    });
                }
                if($ctrl.CPS.hasQuotaType('callsheetBuilder')) {
                    items.push({
                        type: 'duplicate',
                        action: 'Duplicate ' + $ctrl.itemTitle,
                        icon: 'copy'
                    });
                }

                items.push({
                    type: 'archive',
                    action: 'Archive ' + $ctrl.itemTitle,
                    icon: 'box',
                    withTopBorder: true,
                    aClass: 'accent'
                });
            } else {
                items.push({
                    type: 'activate',
                    action: 'Restore ' + $ctrl.itemTitle,
                    icon: 'restore'
                });

                items.push({
                    type: 'remove',
                    action: 'Remove ' + $ctrl.itemTitle,
                    icon: 'trash',
                    withTopBorder: true,
                    aClass: 'accent'
                });
            }

            return '<ul class="dropdown-menu side-menu display-block callsheets-sidemenu">' + getList(items) + '</ul>';

            function getList(items) {
                return items.map($ctrl.getSideMenuLi).join('');
            }
        }

        function getDesignLi(item, isMobile) {
            return _.extend({
                action: 'Edit ' + $ctrl.itemTitle,
                icon: 'pencil',
                withTopBorder: !isMobile
            }, isMobile ? {type: 'viewDesign'} : {href: getEditHref(item, 'design') });
        }

        function getViewDraftLi(item, isMobile, isDraft) {
            return _.extend({
                action: 'View ' + $ctrl.itemTitle, // + (isDraft ? 'Draft' : $ctrl.itemTitle),
                icon: 'eye',
                withTopBorder: !isDraft,
                iconLevel: 2
            }, isMobile ? {type: 'viewDraft'} : {href: getDraftHref(item, false)});
        }

        function getStatsLi(isMobile, item) {
            return _.extend({
                action: 'View Confirmations',
                icon: 'pie-chart',
                iconLevel: 2
            }, isMobile ? {type: 'viewStats'} : {href: getStatsHref(item, false)});
        }

        function getDownloadLi(isMobile, item) {
            return $ctrl.withDownload && !item.isFolder ? {
                type: 'getDownloadLink',
                action: 'Download PDF',
                icon: 'download-pdf',
                iconLevel: 5,
                target: '_self'
            } : '';
        }

        function viewDraft(item) {
            console.log('viewDraft');
            getDraftHref(item, true);
        }

        function getDraftHref(item, isTransition) {
            //return item.status === 0 ? getEditHref(item, 'view', isTransition) :
            return getViewHref(item, isTransition);
        }

        function viewStats(item) {
            console.log('viewStats');
            getStatsHref(item, true);
        }

        function viewDesign(item) {
            console.log('viewDesign');
            getEditHref(item, 'design', true);
        }

        function getStatsHref(item, isTransition) {
            return getHref(item, 'confirmations', isTransition);
        }

        function getDownloadLink(item, param, e) {
            console.log('download item');
            var currentTarget = e.currentTarget;
            if (!$ctrl.callsheetPDFs) {
                $ctrl.CPS.loadQuotaPopup('callsheetPDFs', process, null, null, $ctrl.compOptions, {e:e});
            } else {
                process();
            }

            function process() {
                var m = 'crud.'+$ctrl.elemType.toLowerCase() + '.download.',
                    p = $ctrl.getItemParams(item, null);
                $ctrl.i18nNotifications.pushForCurrentRoute(null, m + 'success.general', 'success');
                $ctrl.DownloadExportService.downloadBlobFile($ctrl.service.download(p), p, onsuccess, onerror);

                function onsuccess(url, filename) {
                    if (currentTarget) {
                        currentTarget.setAttribute('href', url);
                        currentTarget.setAttribute('download', filename);
                        currentTarget.click();
                    }

                    $ctrl.isUpdating = false;

                    if ($ctrl.onClose) {
                        $ctrl.onClose({result: 'cancel'});
                    }
                }

                function onerror(err) {
                    $ctrl.isUpdating = false;
                    console.log("Could not get signed URL.");
                    $ctrl.error = $ctrl.localizedMessages.getFromError(err, m + 'error');
                }
            }
        }

        function getViewHref(item, isTransition) {
            return getHref(item, 'view', isTransition);
        }

        function getEditHref(item, type, isTransition) {
            return getHref(item, 'edit', isTransition, {mode: type});
        }

        function getHref(item, page, isTransition, other) {
            return getM(isTransition)('user.product.callsheet.' + page, $ctrl.getItemParams(item, other));
        }

        function getM(isTransition) {
            if(isTransition){
                $ctrl.broadcastRoot('HIDE_MOBILE_DETAILS');
            }
            return $ctrl.CPS[isTransition ? 'transitionTo' : 'getStateHref'];
        }

        function getItemParams(item, other) {
            return $ctrl.currentProductPathParams(_.extend({callsheetId: item._id}, other), item);
        }


        function process(item, type) {
            var params = $ctrl.getItemParams(item),
                isTransition = true;
            switch (type) {
                case 'add-recipients':
                    //todo open popup
                    getM(isTransition)('user.product.callsheet.add-recipients', params);
                    break;

                case 'confirm-invite' :
                    params.invitationId = item.invite._id;
                    params.callsheetId = item.invite.callsheetId;
                    params.role = 'cast';
                    getM(isTransition)('user.product.callsheet.confirm-invite', params);
                    break;
            }
        }

        function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
            //var item = $ctrl.item;
            var withclick = '', href = '',
                castCount = item.castCount ? item.castCount : 0;
            if($ctrl.isActiveFilter() && !$ctrl.isPrintLayout) {
                withclick = 'with-cursor with_underline no-drag ' + $ctrl.getClickEventName('edit');
                href = ' href="' + ((item.callsheetSent || $ctrl.isMyCallsheets) ? getViewHref(item, false) : getEditHref(item, 'design', false)) + '"';
            }
            var hoverConfirms =0, hoverPage=0, $index = 0,
                d = item.startDate;
            switch (c.prop) {
                case 'status':
                    return $ctrl.isMyCallsheets ? '' : getStatus();

                case 'startDate':
                    return getEl(c, function (c) {
                        return '<div class="' + $ctrl.getClsCol(c) + '">' +
                            '<div>' +
                            '<div class="calendar-bottom text-center uppercase '+(d?'':'empty')+'">' + (d ? $ctrl.CPS.getCreatedAt(d, 'MMM') : '—')+ '</div>' +
                            '<div class="calendar-top text-center">' + (d ?$ctrl.CPS.getCreatedAt(d, 'DD'):'') + '</div>' +
                            '</div>' +
                            '</div>';
                    });

                case 'title':
                    var pageViewsCount = 'pageViewsCount';
                    return getEl(c, function (c) {
                            var ct = 'Call Time <span class="date-time">' + $ctrl.CPS.getCreatedAt(item.startDate, $ctrl.CPS.timeFormat) + '</span>',
                        s = '<span class="date-sep">&nbsp;|&nbsp;</span>',
                        pv = getP(pageViewsCount);
                        return '<div class="' + $ctrl.getClsCol(c) + '">' +
                            '<div>' +
                            ($ctrl.isMyCallsheets ? getStatus(true) : '') +
                            '<a class="no-drag title word-wrap with-cursor with_underline ' +
                            $ctrl.getViewEditElemSelector('title') + ($ctrl.isMyCallsheets ?' inline-block':' display-block') + '"' + href + ' analytics-on analytics-action="View Call Sheet">' + (item.title ? item.title : '—') + '</a>' +
                            '<div class="date subname">' +
        ($ctrl.isMyCallsheets ? (
                 getName(item, 'productName', ' inline-block max150 with-ellipsis ', 'goToProduct') + s  +
                ct +
                 ($ctrl.hasCallsheetTracking ? (s +
                    '<span class="with-cursor with_underline ' + $ctrl.getClickEventName('viewStats') + '" analytics-on analytics-action="Confirms Count" data-type="'+pageViewsCount+'">' +
                     pv + ' view' + (pv ===1 ? '' : 's') +'</span>'
                 ) : '')
            ) :
            ('<span class="date-month">'+$ctrl.CPS.getCreatedAt(d, 'MMM DD, YYYY') +'</span>' + s + ct)
        ) +


                            ($ctrl.isMobileView() ? ('<span class="show-ipad" > • ' + (item.castCount ? item.castCount : 0) + ' recipient' + (item.castCount !== 1 ? 's' : '') + '</span>') : '') +
                            '</div>' +
                            '</div>' +
                            '</div>';
                    });

                case 'castCount':
                    return getEl(c, function (c) {
                        return '<div class="' + $ctrl.getClsCol(c) + '">' +
                            '<a class="no-drag rec-count ' + $ctrl.getClickEventName('viewStats') + '" analytics-on analytics-action="View Confirmations">' + (item.castCount ? item.castCount : 0) + '</a>' +
                            '</div>';
                    });

                case 'callsheetSent.pageViewsCount':
                    return $ctrl.isMyCallsheets ? '' :
                        getConf('pageViewsCount', 'Page Views', hoverPage, c, 'optionsView');

                case 'callsheetSent.confirmsCount':
                    return getConf('confirmsCount', 'Confirmations', hoverConfirms, c, 'optionsConfirm');

                case 'productName':
                    return '';
                    var clsOther = $ctrl.getClsCol(c, isLast);
                    return '<div' + (clsOther ? (' class="' + clsOther + '"') : '') + '>' +
                        getName(item, c.prop, ' display-block ', 'goToProduct') +
                        '</div>';
            }
            //dup-col
            /* el +='<div class="with-btn with-hover text-center hide-print one-line-tooltip">'+
                 '<div>'+
                 '<a class="text-center gray-light '+$ctrl.getClickEventName('duplicate')+'" analytics-on analytics-action="Duplicate Call Sheet" tooltip-placement="bottom" tooltip="Duplicate Call Sheet">'+
                   $ctrl.LCS.getISBDiv('copy') +
                 '</a>'+
                 '</div>'+
                 '</div>';*/

            function getStatus(isInline){
                var t = getStatusTooltip(item);
                return '<div class="' + (isInline ? 'inline-block' : $ctrl.getClsCol(c)) + ' smaller-tooltip toggleDetails ' +
                    (item.callsheetSent ? 'callsheetsent' : '') +
                    //(item.status === 0 ? '' : (item.callsheetSent ? 'callsheetsent' : '')) +
                    '">' +
                    '<a class="box-draft with-tooltip"' +
                    ' tooltip="' + t + '" tooltip-placement="bottom" ' +
                    '><span class="label-status"></span>' +
                    ($ctrl.isMyCallsheets ? '' : (item.callsheetSent ? 'Sent' : 'Draft')) +
                    '</a>' +
                    //(($ctrl.canEdit ||t) ? ('<div class="tooltip tooltip-inline bottom"><div class="tooltip-inner' + (t?'':' sb-hide') + '">' + t +'</div></div>') : '')  +
                    '</div>';


                function getStatusTooltip(item) {
                    return item.status === 0 ? ('Draft created ' + $ctrl.CPS.getCreatedAt(item.createdAt, $ctrl.CPS.dateTimeFormat)) :
                        (item.callsheetSent ? ('Call sheet sent ' + $ctrl.CPS.getCreatedAt(item.callsheetSent.createdAt, $ctrl.CPS.dateTimeFormat)) : '');
                }
            }

            function getEl(c, m){
                if(textOnly){
                    var info = $ctrl.SBFieldTypesService.getSBFieldContentView($ctrl, item, c, textOnly);
                    return info.content ? info.content : info.placeholder;
                }
                if (isMobileRowDetails) {
                    return c ? $ctrl.getDisplayItemCol(item, c, cls, false, false, true, true) : '';
                }

                return m(c);
            }

            function getP(prop) {
                return item.callsheetSent && item.callsheetSent[prop] ? item.callsheetSent[prop] : 0;
            }

            function getConf(prop, txt, hover, c, options) {
                return getEl(c, function (c) {
                    var el = '',
                    showConfirm = true ;//item.callsheetSent
                    if(!$ctrl.hasCallsheetTracking){
                        el += '<span class="text-center with-underline with-cursor semibold ' + $ctrl.getClickEventName('openProPopup') + '" data-type="openProPopup" analytics-on analytics-action="Callsheets col '+c.name+'">' +
                            //'<span class="profeature position-relative">PRO</span>' +
                            '<a class="blue display-block margin-top-6">Upgrade</a> <span class="darkgray">to see stats</span></span>';
                    }
                    else if (showConfirm) {
                        var pageViews = getP(prop),
                            isViewed = pageViews !== castCount,
                            percent = item.callsheetSent && castCount ? (pageViews * 100 / castCount) : 0;
                        el += '<div class="no-drag rec-count display-inline with-cursor ' + $ctrl.getClickEventName('viewStats') + '" analytics-on analytics-action="' + txt + '" data-type="'+prop+'">' +
                            //getPie2() +
                            // pageViews +
                            '</div>';
                    } else {
                        el += '<span class="box-draft rec-count">–</span>';
                    }

                    return '<div class="' + $ctrl.getClsCol(c) + '">' + el + '</div>';

                    function getPie2() {
                        return '<div class="easypiechart confirm" percent="::' + percent + '">' +
                            '<div class="inner-pie"><div>' +
                            '<div class="big">' +
                            ((!isViewed || isViewed && hover === $index) ? pageViews : '') +
                            ((isViewed && hover !== $index) ? '<span class="fontello check-mark"></span>' : '') +
                            '</div>' +
                            '<div class="small">' + (hover !== $index && isViewed ? pageViews : '') + 'of ' + castCount + '</div>' +
                            '</div></div>' +
                            '</div>';
                    }
                });
            }
        }

        function openProPopup(item, param, e){
            $ctrl.CPS.loadQuotaPopup($ctrl.quotaTracking, function (){}, null, null, $ctrl.compOptions, {e:e});
        }

        function goToProduct(item) {
            $ctrl.CPS.transitionTo('user.product.overview', $ctrl.CPS.currentPathParams({
                productId: item.productId
                // card: item._id
            }));
        }

        function getName(item, prop, cls, event, other) {
            var hasclick = event && $ctrl.hasClick(item),
                tag = 'div',//(hasclick ? 'a' : 'div'),
                withclick = hasclick ? (' no-drag with_underline with-cursor" '
                    //+ 'href="' + $ctrl.CPS.getStateHref('user.product.overview', currentPathParams(item))
                ) : '';
            return '<' + tag + ' class="' + (cls||'')  +
                $ctrl.getViewEditElemSelector(prop) + ' ' +
                $ctrl.getClickEventName(event) +
                (hasclick ? withclick : '') + '">' + (other || '') + $ctrl.LCS.convertHtmlToText(item[prop]) +
                '</' + tag + '>';
        }
    }
}

angular.module('product.callsheets.item.grid.component', [
    'product.callsheets.item.grid.component.service'
])
.component('callsheetItemGrid', itemGridComponentParams({}, 'CallsheetGridItemCtrl'))

.controller('CallsheetGridItemCtrl',CallsheetGridItemCtrl);
CallsheetGridItemCtrl.$inject = ['GridItemGroupInitCtrlService', 'CallsheetGridItemCtrlService', '$element'];
function CallsheetGridItemCtrl(GridItemGroupInitCtrlService, CallsheetGridItemCtrlService, $element) {
    var $ctrl = this;
    $ctrl = new CallsheetGridItemCtrlService($ctrl, $element);
    $ctrl = new GridItemGroupInitCtrlService($ctrl, $element, {
        LIST_FILTERS_VIEW: 'columns',
        LIST_FILTERS_STYLES: 'styles'
    });
}

angular.module('product.callsheets.item.grid.component.service', [])
    .service('CallsheetGridItemCtrlService',CallsheetGridItemCtrlService);
CallsheetGridItemCtrlService.$inject = ['ProgressBarService'];
function CallsheetGridItemCtrlService( ProgressBarService) {

    return function($ctrl, $element){

        $ctrl.ProgressBarService = ProgressBarService;

        $ctrl.bindingNames = ['viewDraft', 'viewStats', 'viewDesign', 'getDownloadLink', 'send', 'recipients', 'openUpgrade', 'goToProduct'];
        $ctrl.progressBarService = {};

        $ctrl.recipients = recipients;
        $ctrl.updateEditableItemPropsAll = updateEditableItemPropsAll;
        $ctrl.onDestroyGridItemOther = onDestroyGridItemOther;
           // console.log('CallsheetGridItemCtrl: $onInit');

        $ctrl.postInitItem = postInitItem;

        return $ctrl;

        function recipients(e) {
            return $ctrl.triggerAction(e, 'process', 'recipients');
        }

        function updateEditableItemPropsAll(changes) {
            if($ctrl.hasPropChanged(changes, 'title')) {
                var el = $ctrl.element.querySelector('.calendar-name .' + $ctrl.SBFieldTypesService.getPropMark('title'));
                if(el){
                    el.innerHTML = ($ctrl.item.title ? $ctrl.item.title : '—');
                }
            }
            if($ctrl.hasPropChanged(changes, 'startDate')) {
                var d = $ctrl.item.startDate,
                    b, el = $ctrl.element.querySelector('.calendar-box');
                if(el){
                    b = el.querySelector('.calendar-bottom');
                    if(b) {
                        b.innerText = d ? $ctrl.CPS.getCreatedAt(d, 'MMM') : '—';
                    }
                    $ctrl.LCS[d ? 'removeClass': 'addClass'](b, 'empty');
                    el.querySelector('.calendar-top').innerText = d ? $ctrl.CPS.getCreatedAt(d, 'DD') : '';
                }

                el = $ctrl.element.querySelector('.date-month');
                if(el) {
                    el.innerText = d ? $ctrl.CPS.getCreatedAt(d, 'MMM DD, YYYY') : '—';
                }

                el = $ctrl.element.querySelector('.date-time');
                if(el) {
                    el.innerText = d ? $ctrl.CPS.getCreatedAt(d, $ctrl.CPS.timeFormat) : '—';
                }
               // $ctrl.updatePropContent('startDate');
               // $ctrl.updatePropContent('calltime');
            }
        }

        function onDestroyGridItemOther() {
            processProgress(destroyProgressBar);

            function destroyProgressBar(prop) {
                if ($ctrl[prop]) {
                    $ctrl[prop].onDestroyProgressBar();
                }
            }
        }

        function postInitItem() {
            processProgress(initProgressBar);
            processProgress(loadProgressBar);
            processProgress(setProgressBar);

            function initProgressBar(prop) {
                if (!$ctrl[prop]) {
                    $ctrl[prop] = new $ctrl.ProgressBarService({
                        progressType: 'Circle',
                        parentElement: $element[0].querySelector('.rec-count[data-type="' + prop + '"]'),
                        wrapperCls: 'callsheet-progress',
                        strokeWidth: 6,
                        animationTime: 2000,
                        progressText: '{{completed}} / {{total}}',
                        otherColors: {green: '#00BF89'},
                        showEmpty: true,
                        name:  prop
                    });
                }
            }

            function setProgressBar(prop) {
                if ($ctrl[prop]) {
                    $ctrl[prop].setProgressBar(getProgressStats(prop));
                }
            }

            function loadProgressBar(prop) {
                if ($ctrl[prop]){
                    var parent = $ctrl[prop].parentElement;
                    if(parent && !parent.querySelector('.' + $ctrl[prop].progressCls)){
                        $ctrl.LCS.appendChildFragment(parent, $ctrl[prop].getProgressBarContent(hasTasks(prop)));
                    }
                }
            }
        }

        function processProgress(m) {
            _.each(['pageViewsCount', 'confirmsCount'], m);
        }

        function getProgressStats(prop){
            return {
                total: $ctrl.item.castCount ? $ctrl.item.castCount : 0,
                completed: $ctrl.item.callsheetSent && $ctrl.item.callsheetSent[prop] ? $ctrl.item.callsheetSent[prop] : 0
            }
        }
        function hasTasks(prop){
            return getProgressStats(prop).total > 0;
        }
    }
}


