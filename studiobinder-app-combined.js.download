 CSS:-
.watermarked::before {
    position: fixed;
    top: -75%;
    left: -75%;

    display: block;
    width: 300%;
    height: 300%;

    transform: rotate(-45deg);
    content: attr(data-watermark);

    font-size: 30px;
    opacity: 0.15;
    line-height: 4em;
    letter-spacing: 2px;
    color: #ff0523;
    z-index:-1;
}

HTML:-
<div class="watermarked" data-watermark="Watermark.."></div>

SCRIPT:-

<script>
Array.from(document.querySelectorAll('.watermarked')).forEach(function(el) {
        el.dataset.watermark = (el.dataset.watermark + ' ').repeat(10000);
    });
</script>
watermark position should be as fixed and display with & height should be your screen size. Then watermark will be printed in your whole report or something.
https://stackoverflow.com/questions/40853308/watermark-text-repeated-diagonally-css-html/40853561#40853561

function applyWatermarkToPrintedDocument(event) {
        //Remove listener so that the function will not cause problems when mozilla
        //attempts to use the real mozPrintCallback
        window.removeEventListener('beforeprint', this);

        var canvases = document.querySelectorAll('canvas');
        for (var count = 0; count < canvases.length; count++) {
            if (canvases[count].mozPrintCallback && !canvases[count].renderedWatermark) {
                //Override the default moz callback with new one.
                canvases[count].mozPrintCallback = mozCallbackOverride(canvases[count].mozPrintCallback);
                canvases[count].renderedWatermark = true;
            }
        }
    }
window.addEventListener('beforeprint', applyWatermarkToPrintedDocument, false);

function mozCallbackOverride(defaultMozPolyfillCallback) {
        var originalCallback = defaultMozPolyfillCallback;

        function newCallback(obj) {
            //Override the done callback to we are able to determine when rendering is complete. Use closure to retain
            //reference.
            obj.done = (function() {
                //grab the done object, for later calling
                //grab the contextObj
                var contextObj = obj;
                contextObj.done1 = obj.done;
                return function() {
                    isPrinting = true;

                    //Render watermark onto printing canvas
                    var watermarkSizes = calculateWatermarkSizes(contextObj.context.canvas);
                    watermarkSizes.canvas.context.save();
                    layoutRegion(watermarkSizes.canvas.context, watermarkSizes.top);//Here I am adding watermark
                    layoutRegion(watermarkSizes.canvas.context, watermarkSizes.middle);
                    layoutRegion(watermarkSizes.canvas.context, watermarkSizes.bottom);
                    watermarkSizes.canvas.context.restore();
                    isPrinting = false;

                    //Callback done object
                    contextObj.done1();
                };
            })();

            //fire original callback with new overridden object.
            originalCallback(obj);
        }

        return newCallback;
    }

 */

