    _this.onStateChanged = onStateChanged;
    _this.processSidebar = processSidebar;
    _this.onUpdateSidebar = onUpdateSidebar;
    _this.emitUpdateSidebar = emitUpdateSidebar;

    return _this;

    function setOv() {
        _this.ob = BlocksSetupService.overviewBlocks;
        _this.cob = BlocksSetupService.customOverviewBlocks;
    }

    function load(loadSideNavMenuContent) {
        _this.setOv();
        _this.processSidebar(loadSideNavMenuContent);
    }

    function onStateChanged(stateName, loadSideNavMenuContent) {
        console.log('onStateChanged : ' + stateName);
        if (stateName && stateName !== '') {
            var update = false;
            if ((_this.currentStateName === undefined || !_this.currentStateName)) {
                process();
            } else if (stateName !== _this.currentStateName) {
                process();
            }

            function process() {
                _this.currentStateName = stateName;
                update = true;
                console.log('UPDATE_SIDEBAR');
                _this.processSidebar(loadSideNavMenuContent);
            }
        }
    }

    function processSidebar(loadSideNavMenuContent) {
        if (!_this.isProcessing) {
            if (_this.ob) {
                _this.isProcessing = true;
                loadSideNavMenuContent(_this.ob, _this.cob);
                _this.isProcessing = false;
            }
        }
    }

    function onUpdateSidebar(method) {
        return RootEventsService.onDefaultEmitted('UPDATE_SIDEBAR', method);
    }

    function emitUpdateSidebar(val) {
        RootEventsService.broadcastRoot('UPDATE_SIDEBAR', val)
    }
}

