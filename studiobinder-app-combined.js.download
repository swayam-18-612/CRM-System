angular.module('product.contact.item.grid.controller.service', [
    'product.contacts.item.grid.controller.service',
    'item.grid.edit.group.template.controller.service'
])
.service('ContactProfileBlockCtrlService', ContactProfileBlockCtrlService);
ContactProfileBlockCtrlService.$inject = ['GridItemEditGroupTemplateCtrlService',
    'RowObserverCtrlService', 'ImgObserverCtrlService', 'ContactsConstantsService', 'ContactProfileConstantsService', 'ContactsService'];
function ContactProfileBlockCtrlService(GridItemEditGroupTemplateCtrlService, RowObserverCtrlService, ImgObserverCtrlService, constantsService, service) {
    return function ($ctrl, $element) {

        $ctrl.setColumns = setColumns;
        $ctrl.ImgObserverCtrlService = ImgObserverCtrlService;
        $ctrl.RowObserverCtrlService = RowObserverCtrlService;
        $ctrl.ContactsConstantsService = ContactsConstantsService;

        $ctrl.listOptions = {};
        $ctrl.editableItemProps = ['type', 'date', 'time', 'generalNote', 'bulletin', 'footerNote', 'dayOfDays', 'header'];

        $ctrl.setExtraProps = setExtraProps;

        $ctrl = new GridItemEditGroupTemplateCtrlService($ctrl, $element);

        function setExtraProps() {
            return {
                elemType: 'CALLSHEET',
                objectType: 'callsheet',
                itemTitle: 'Callsheet',
                service: service,
                CallsheetConstantsService: CallsheetConstantsService
            };
        }

        function setColumns() {
            if (!$ctrl.columnsList) {
                $ctrl.columnsList = $ctrl.getColumnsList(false, false).map(function (c){
                    return _.extend({}, c , getContentEditableParams(c.fieldClass));
                });
            }
        }

        function getContentEditableParams(fieldClass){
            return {
                canEdit: true,
                triggerOnEditLink: true,
                autofocus: true,
                fieldClass: 'editable-content contenteditable word-wrap ' + (fieldClass || ''),
                editableContainerClass: 'noninlineeditor',
                eClassAttr: 'non-inline-editor noninlineeditor',

                wrapperClass: 'full-width' + ( fieldClass && fieldClass.indexOf('text-center')!==-1 ? ' centered':'')
            }
        }
    }
}

