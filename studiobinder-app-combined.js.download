angular.module('user.teamPage.component', [
    'user.teamPage.component.service'
])
.component('teamPage', {
    bindings: {
        plans: '<',
        features: '<',
    },
    controller: 'TeamCtrl',
})

.controller('TeamCtrl', TeamCtrl);
TeamCtrl.$inject = ['TeamCtrlService', '$element'];
function TeamCtrl(TeamCtrlService, $element) {
    var $ctrl = this;
    $ctrl = new TeamCtrlService($ctrl, $element);
}

angular.module('user.teamPage.component.service', [
    'user.team.group.component',
    'user.products.item.edit.component',
    'user.team.invite.component',
    'user.team.resend-invite.component',
    'user.team.remove-team-popup.component',
    'apiConstants.teams.services',
    'apiServices.Team',
    'apiServices.TeamLists',
    'user.payment.init.controller.service',
    'page.tree.simple.controller.service',
    'page.tree.simple.controller.service.injector'
])
.constant('TeamPageCtrlServiceInjectors', {
    pageCtrlService: 'PageTreeSimpleCtrlService',
    constantsService: 'TeamConstantsService',
    listsService: 'TeamListsService',
    service: 'TeamService',
    PaymentInitCtrlService: 'PaymentInitCtrlService'
})
.service('TeamCtrlService', TeamCtrlService);
TeamCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'TeamPageCtrlServiceInjectors'];
function TeamCtrlService(pageCtrlServiceInjector, pageInjectors) {
    console.log('TeamCtrlService');
    return function ($ctrl, $element, printPageParams) {
        $ctrl.groupClass = 'team-members-group';
        $ctrl.quotaType = 'team';

       // $ctrl.addLoadDirectoryDelay = true;

        $ctrl.getParams = getParams;
        $ctrl.getFiltersTotalCounter = getFiltersTotalCounter;
        $ctrl.getFiltersSelectedCounter = getFiltersSelectedCounter;
        $ctrl.getRightButtons = getRightButtons;
        $ctrl.getGroupBodyAddon = getGroupBodyAddon;
        $ctrl.getGroupFilterButtonsOther = getGroupFilterButtonsOther;
        $ctrl.getGroupFilterButtonsOtherXS = getGroupFilterButtonsOtherXS;
        $ctrl.addTeamSeats = addTeamSeats;
        $ctrl.assignTeam = assignTeam;
        $ctrl.isNotEmptyGroupState = isNotEmptyGroupState;
        $ctrl.canInviteTeam = canInviteTeam;
        $ctrl.isWithSidebar = isWithSidebar;
        $ctrl.onPageTreeInitOther = onPageTreeInitOther;

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);

        $ctrl.withSignup = false;
        $ctrl.onUpdateSubscriptionOther = onUpdateSubscriptionOther;

        return $ctrl;

        function isWithSidebar() {
            return false;
        }

        function isNotEmptyGroupState() {
            return true;
        }

        function onPageTreeInitOther() {
            $ctrl.PaymentInitCtrlService.loadPayment($ctrl, null, false);
            loadRemainingRange();

            if ($ctrl.SBStateService.getSearchFilter('addSeats')) {
                $ctrl.addTeamSeats();
            }

            $ctrl.addRootWatcher('ADD_TEAM_SEATS', function (){$ctrl.addTeamSeats();})
        }

        function onUpdateSubscriptionOther() {
            loadRemainingRange();
        }

        function getParams() {
            return {
                companyId: $ctrl.CPS.companyId
            };
        }

        function getGroupBodyAddon() {
            return {
                'quota-type': '"::$ctrl.quotaType"',
                'count': '"$ctrl.count"'
            };
        }

        function getFiltersTotalCounter() {
            var subFeatures = $ctrl.CPS.subscription ? $ctrl.CPS.subscription.features : null,
                count = subFeatures && subFeatures.team ? subFeatures.team.total : 1;
            if (count === undefined || count === null) {
                count = 1;
            }
            return count;
        }

        function canInviteTeam() {
            return $ctrl.getFiltersTotalCounter() > $ctrl.getDisplayListCount();
        }

        function getFiltersSelectedCounter() {
            var count = $ctrl.getFiltersTotalCounter(),
                existing = $ctrl.getDisplayListCount(),
                canEdit = $ctrl.CPS.isOwnerOrAdmin && $ctrl.canEdit;
            //return existing + ' of ' + count + ' Team Member' + (count === 1 ? '' : 's')+' in <b>' + $ctrl.security.getCurrentCompany().name + '</b>';
            return 'Your account currently has <span class="txtExisting" ' +
                (canEdit ? 'ng-bind="$ctrl.getDisplayListCount()"' :'') +
                '>'+  existing + '</span><span class="txtAll' +
                (canEdit ? ('" ng-show="$ctrl.canInviteTeam()"') : ($ctrl.canInviteTeam() ? '' : ' sb-hide')) +
                '> out of ' + count + '</span> user' + (count === 1 ? '' : 's');
        }

        function getRightButtons() {
            if (!$ctrl.canEdit) {
                return '';
            }
            return (($ctrl.CPS.isOwnerOrAdmin) ? ('<a ng-show="$ctrl.canInviteTeam()" class="btn btn-small primary with-margin-left without-text pull-left ' + $ctrl.getBtnActionCls() +
                    // ($ctrl.pageClass ? $ctrl.pageClass : '') +
                    '" data-type="assignTeam" analytics-on analytics-action="Invite Users"><span class="pull-left sbf mail"></span> <span class="hide-lower1024">Invite Users</span></a>') : '') +
                ($ctrl.CPS.isOwner ? ('<a class="btn btn-small primary-faded with-margin-left without-text pull-left ' + $ctrl.getBtnActionCls() +
                    //($ctrl.pageClass ? $ctrl.pageClass : '') +
                    '" data-type="addTeamSeats" analytics-on analytics-action="Add Seats"><span class="pull-left sbf plus"></span> <span class="hide-lower1024 with-padding-left">Add Seats</span></a>') : '');
        }

        function addTeamSeats(type, e) {
            $ctrl.openAddTeamSeats($ctrl.quotaType, type, e);
        }

        function loadRemainingRange() {
            $ctrl.count = $ctrl.getFiltersTotalCounter();
        }

        function assignTeam(type, e) {
            $ctrl.broadcastRoot('ASSIGN_TEAM', e);
        }

        function getGroupFilterButtonsOther() {
            return ($ctrl.CPS.isOwnerOrAdmin) ? ('<a ng-class="{\'disabled\': $ctrl.keyboardService.SelectedRows.length===0}" class="btn btn-small primary-faded with-margin-left pull-left without-text ' + $ctrl.getBtnActionCls() + '" data-type="processSelectedCustomBtns" data-info="resendInvites" analytics-on analytics-action="Open Resend Invites" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? \'Please select at least one user to reinvite.\' : (\'Send invite to \' + $ctrl.keyboardService.SelectedRows.length + \' user\' +($ctrl.keyboardService.SelectedRows.length === 1 ? \'\':\'s\'))}}" tooltip-placement="bottom">' +
                $ctrl.LCS.getISBDiv('paper-plane', 2, 'pull-left') +
                ' <span class="hide-ipad with-padding-left">Resend Invites</span></a>') : '';
        }

        function getGroupFilterButtonsOtherXS() {
            return ($ctrl.CPS.isOwnerOrAdmin) ? ('<li>' +
                '<a class="table-div full-width ' + $ctrl.getBtnActionCls() + '" ng-class="{\'disabled\': $ctrl.keyboardService.SelectedRows.length===0}" data-type="processSelectedCustomBtns" data-info="resendInvites" analytics-on analytics-action="Open Resend Invites">' +
                '<div class="col30">' + $ctrl.LCS.getISBDiv('paper-plane', 2) + '</div>' +
                '<div>Resend Invites</div>' +
                '</a>' +
                '</li>') : '';
        }
    }
}

