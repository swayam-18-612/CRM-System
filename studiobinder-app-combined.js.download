                addSearchBtn({ intro: "<div class='title'>Search "+itemTitle+"s</div>" +
                        "<p>Search "+listTitle+"s by filename or description.</p>"});
                if (canEdit) {
                    addNewBtn({
                        parent: _this.LCS.bodyElement.querySelector('.' + initWrapperCls),
                        intro: "<div class='title'>Add " + itemTitle + "s</div>" +
                            "<p>You can add images to a mood board here. Either upload new images, or search and select previously uploaded images from your Media Library.</p>"
