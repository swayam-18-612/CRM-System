addMoSePa('Callsheets', 'callsheets', TempCallsheetsService, {
    modelMethod: CallsheetsFactory,
    serviceInjectList: ['ResourcePathsService', 'CallsheetsSent', 'Products', 'CallsheetConstantsService'],
    serviceInjectMod: [
        'apiServices.paths.service',
        'resources.CallsheetsSent',
        'resources.Products',
        'apiConstants.callsheet.services'
    ]
});
function CallsheetsFactory(ApiResource) {
    var model = ApiResource(SBApiCollections.Callsheets);

    model.prototype.getName = function () {
        return this.title ? this.title : this.getUtcMoment(this.startDate).format("MMMM D, YYYY");
    };

    return model;
}

function TempCallsheetsService(ApiService, model, ResourcePathsService, CallsheetsSent, Products, CallsheetConstantsService) {
    var service = ApiService(model, {
        listType: 'isGroup',
        listField: 'callsheetsListId',
        materialProps: ['logo', 'productionLogo'],
        convertOtherResources: convertOtherResources
    });
    service.Statuses = CallsheetConstantsService.Statuses;
    //service.getPostPath = ResourcePathsService.getCallsheetPath;
    service.getCallsheetWithChanges = getCallsheetWithChanges;
    service.send = send;
    service.getSendPath= getSendPath;

    service.share = share;
    service.download = download;
    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.getType = getType;
    service.getStatusColor = getStatusColor;
    service.getListOptions = getListOptions;
    service.setOptions = service.$update;
    service.updateOptions = updateOptions;

    service.duplicate = duplicate;
    service.importSchedules = importSchedules;

    return service;

    function updateOptions(params, successcb, errorcb) {
        return service.postUrl('/update-options', params, successcb, errorcb);
    }

    function duplicate(params, successcb, errorcb) {
        return service.postUrl('/duplicate', params, successcb, errorcb);
    }

    function getListOptions(params, next) {
        service.query(params, function (res) {
            next(res && res.docs && res.docs.length > 0 ? res.docs[0].options : null);
        }, function (error) {
            next(null);
        });
    }

    function getStatusColor() {
        var statuses = service.Statuses;
        for (var i = 0; i < statuses; i++) {
            if (this.status === statuses[i].value) {
                return statuses[i].color;
            }
        }
    }

    function getType() {
        return 'call sheet';
    }

    function getChangedFieldForUpdateOther(){
        return ['title', 'order', 'logo', 'logoId','productionLogo', 'productionLogoId',
        //'options'
         ];
    }

    function convertOtherResources(item) {
        if (item.productId && typeof(item.productId) === 'object') {
            item.product = new Products(item.productId);
            item.productId = item.product._id;
        }
        if (item.callsheetSentId && typeof(item.callsheetSentId) === 'object') {
            item.callsheetSent = new CallsheetsSent(item.callsheetSentId);
            item.callsheetSentId = item.callsheetSentId._id;
        }

        return item;
    }

    function getCallsheetWithChanges(params, successcb, errorcb){
        return service.postUrl('/get-changes', params, function(result){
            if(result){
                var c = service.convertResource(result.callsheet);
                c.changes = result.changes ? result.changes : null;
                c.changedInvites = result.changedInvites ? result.changedInvites : null;
                c.addedInvites = result.addedInvites ? result.addedInvites : null;
                c.totalInvites = result.totalInvites ? result.totalInvites : null;
                c.senderIsRecipient = result.senderIsRecipient ? result.senderIsRecipient : false;
                return successcb(c);
            }else {return successcb(null);}
        }, errorcb, true);
    }

    function send(params, successcb, errorcb) {
        return service.postUrl('/send-callsheet', params,  successcb, errorcb);
    }

    function share(params, successcb, errorcb){
        return service.postUrl('/share', params, successcb , errorcb, true);
    }

    function getSendPath(data){
        return service.getPostPath(data) + '/send-callsheet';
    }

    function importSchedules(params, successcb, errorcb){
        return service.postUrl('/import-schedules', params, successcb , errorcb, true);
    }

    function download(data) {
        return service.getPostPath(data) + '/download';
    }
}


