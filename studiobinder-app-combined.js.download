                $ctrl.onPostInitOther();
            }
        }
    }
}

angular.module('product.callsheet.resendInit.controller.service', [
])
.service('ResendCallsheetPopupInitCtrlService', ResendCallsheetPopupInitCtrlService);

ResendCallsheetPopupInitCtrlService.$inject = ['ListItemPopupTemplateCtrlService'];
function ResendCallsheetPopupInitCtrlService(ListItemPopupTemplateCtrlService) {
    return function ($ctrl, $element) {
        $ctrl.btnToggleCls = 'btnToggle';
        $ctrl.confirmResend = confirmResend;
        $ctrl.toggleCheck = toggleCheck;
        $ctrl.isToggleChecked = isToggleChecked;
        $ctrl.onLoadedResend = onLoadedResend;
        $ctrl.onDestroy = onDestroy;
        $ctrl.openProPopup = openProPopup;

        return ListItemPopupTemplateCtrlService($ctrl, $element);

        function isToggleChecked(p, isReverse){
           return isReverse ? $ctrl.send[p] !== true : $ctrl.send[p] === true;
        }

        function toggleCheck(e) {
            console.log('toggleCheck');
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            var el = e.currentTarget,
                p = el.getAttribute('data-type'),
                isReverse = el.getAttribute('data-reverse') === 'true';
            $ctrl.send[p] = $ctrl.send[p] ? false : true;

            var isChecked = isToggleChecked(p, isReverse);
            var input = el.querySelector('input');
            if(input) {
                if (isChecked) {
                    input.setAttribute('checked', 'checked');
                } else {
                    input.removeAttribute('checked');
                }
            }

            var radio = el.querySelector('.radiobtn');
            if (radio) {
                if (isChecked) {
                    $ctrl.LCS.replaceClass(radio, 'unchecked', 'checked');
                } else {
                    $ctrl.LCS.replaceClass(radio,'checked', 'unchecked');
                }
            }
        }

        function openProPopup(e){
            $ctrl.CPS.openProPopup(e);
        }

        function onLoadedResend() {
            bind(false);
            bind(true);
        }

        function onDestroy() {
            bind(false);
        }

        function bind(isBind) {
            $ctrl.bindElementsClickBySelector(isBind, '.'+$ctrl.btnToggleCls+':not([data-type="openProPopup"])', $ctrl.toggleCheck);
            $ctrl.bindElementsClickBySelector(isBind, '.'+$ctrl.btnToggleCls+'[data-type="openProPopup"]', $ctrl.openProPopup);
        }

        function getInputCheck(type, isReverse, isRadio, quotaType, txt) {
            var noQuota = quotaType && !$ctrl.CPS.hasQuotaType(quotaType);
            if(isReverse && noQuota){
                $ctrl.send[type] = false;
                isReverse = false;
            }
            var isChecked = $ctrl.isToggleChecked(type, isReverse);
            return '<div class="custom-checkbox position-relative pull-right '+ $ctrl.pageClass + ' '+$ctrl.btnToggleCls+'"' + ' data-type="' + (noQuota ? 'openProPopup' : type) + '" ' +
                (noQuota ? (' data-quota="'+quotaType+'"') :'')+
                'analytics-on analytics-action="'+txt+'"' +
                (isReverse ? ' data-reverse="true"' : '') +
                '>' +
                    '<label class="i-switch'+(isRadio? (' radiobtn '+ (isChecked ? 'checked':'unchecked')) : '') + '">' +
                        '<input type="checkbox"' + (isChecked ? ' checked="checked"' : '') + '' +
                        (noQuota ? 'disabled="disabled"' : '') +
                        '><i></i>' +
                    '</label>' +
                '</div>';
        }

        function confirmResend(cls) {
            var quotaType = 'callsheetTracking';
    return '<div class="'+(cls||'spacing-half-top')+'">' +
                '<div class="field border-bottom" ng-show="($ctrl.changedInvitesCount + $ctrl.addedInvitesCount)> 0">' +
                    '<div class="pull-left" ng-show="$ctrl.isToggleChecked(\'sendToAll\')">Send call sheet to {{$ctrl.totalInvites> 1 ? \'all\' : \'\'}} recipient{{$ctrl.totalInvites> 1 ? \'s\':\'\'}} ({{$ctrl.totalInvites}})</div>' +
                    '<div class="pull-left" ng-hide="$ctrl.isToggleChecked(\'sendToAll\')">Send only to updated recipient{{($ctrl.changedInvitesCount + $ctrl.addedInvitesCount)> 1 ? \'s\':\'\'}} ({{$ctrl.changedInvitesCount + $ctrl.addedInvitesCount}})</div>' +
                    getInputCheck('sendToAll') +
                '</div>' +
                ($ctrl.sendTest ? '' : ('<div class="field border-bottom f1">' +
                    '<div class="pull-left">Copy me on emails sent</div>' +
                    getInputCheck('cc') +
                '</div>')) +
                '<div class="field border-bottom f2">' +
                    '<div class="pull-left">Receive email when recipients confirm ' +
        (quotaType &&!$ctrl.CPS.hasQuotaType(quotaType) ? ('<span class="profeature margin-left10">PRO</span>') : '' ) +
        ' <span class="position-relative sbf info hide-print" style="top: 2px; left: 5px" tooltip="Receive email when recipients confirm the call sheet." tooltip-placement="top"></span></div>' +
                      getInputCheck('dontSendConfirmToSender',true,false, quotaType, 'Receive Confirmation Receipts') +
                '</div>' +
                '<div class="field border-bottom f3">' +
                    '<div class="pull-left">Include SMS <span class="position-relative sbf info hide-print" style="top: 2px; left: 5px" tooltip="In addition to emails, text messages will be sent to recipients that have phone numbers." tooltip-placement="top"></span></div>' +
                    getInputCheck('sms') +
                '</div>' +
                '<div class="field border-bottom f4">' +
                    '<div class="pull-left">Reset view counts & confirmation' +
                    '</div>' +
                    getInputCheck('resetConf') +
                '</div>' +
                '<div>' +
                   //'<!-- ng-if="callsheet.callsheetSentId || extraParam.callsheetSentId"-->' +
                    '<div class="field border-bottom f5">' +
                        '<div class="pull-left">Include a message</div>' +
                        getInputCheck('addNote') +
                    '</div>' +
                    '<div class="field" ng-show="$ctrl.isToggleChecked(\'addNote\')">' +
                        '<label class="header thin clearfix spacing-half-top">Message</label>' +
                        '<div class="form-control with-underline autogrow contenteditable with-model '+ $ctrl.pageClass +'" placeholder="Custom message…" contenteditable="true" contenteditable-html strip-br="true" ng-model="$ctrl.send.updateNote" style="padding-left: 0; font-size: 14px"></div>' +
                    '</div>' +
                '</div>' +
            '</div>';
        }
    }
}

angular.module('product.callsheet.sendCallsheet.component', [
    'apiServices.CallsheetInvitations',
    'apiServices.Callsheets',
    'services.sessionService',
    'product.callsheet.resend.controller.service'
])

.component('sendCallsheetPopup', popupComponentParams('SendCallsheetPopupCtrl'))
.controller('SendCallsheetPopupCtrl', SendCallsheetPopupCtrl);
SendCallsheetPopupCtrl.$inject = ['CallsheetInvitationsService', 'CallsheetsService', 'ResendCallsheetPopupCtrlService', '$element'];
function SendCallsheetPopupCtrl(CallsheetInvitationsService, service, ResendCallsheetPopupCtrlService, $element) {

    var i;
    var $ctrl = this;
    $ctrl.icon = 'paper-plane';
    $ctrl.setTemplateDataInit = setTemplateDataInit ;
    $ctrl.onPreInitOther = onPreInitOther;
    $ctrl.onPostInitOther = onPostInitOther;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.onLoaded = onLoaded;

    $ctrl = new ResendCallsheetPopupCtrlService($ctrl, $element);

    function onPreInitOther() {
        $ctrl.service = service;
        if(!$ctrl.extraParam){
            $ctrl.extraParam = {};
        }
        $ctrl.extraParam.service = $ctrl.service;
    }

    function setTemplateDataInit() {
        $ctrl.withFooterBtns = false;
    }

    function onLoaded(){
        $ctrl.callsheetId = $ctrl.item._id;
        if(!$ctrl.isAllLoaded){
            $ctrl.service.getCallsheetWithChanges(getParams(), function (callsheet) {
                oninit(callsheet);
                return callsheet;
            }, function (error) {
                oninit(null);
                return null;
            });
        } else {
            $ctrl.addRootWatcher('CLOSE_POPUP_SEND_CALLSHEET', function (){
                $ctrl.cancelPopup();
            });

            if (typeof ($ctrl.onLoadedResend) === 'function') {
                $ctrl.onLoadedResend();
            }
        }

        function oninit(callsheet) {
            $ctrl.isAllLoaded = true;
            $ctrl.callsheetBuilder = $ctrl.CPS.hasQuotaType('callsheetBuilder');
            if ($ctrl.callsheetBuilder) {
                callsheet.senderIsRecipient = true;
            }
            $ctrl.CurrentProduct.broadcastCallsheet(callsheet);
            initCallsheet(callsheet);

            $ctrl.popupTitle = $ctrl.totalInvites ? 'Send Call Sheet' : 'This call sheet has no recipients';
            $ctrl.reloadListItemTemplate();
        }
    }

    function getParams() {
        return {
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId,
            callsheetId: $ctrl.callsheetId
        };
    }

    function initCallsheet(callsheet) {
        $ctrl.callsheet = callsheet;
        $ctrl.callsheetSent = $ctrl.callsheet.callsheetSent;
        $ctrl.senderIsRecipient = $ctrl.callsheet.senderIsRecipient;
        $ctrl.totalInvites = $ctrl.callsheet.totalInvites;
        if (!$ctrl.totalInvites) {
            $ctrl.totalInvites = 0;
        }

        $ctrl.changes = $ctrl.callsheet.changes;
        $ctrl.changedInvites = $ctrl.callsheet.changedInvites;
        $ctrl.addedInvites = $ctrl.callsheet.addedInvites;
        $ctrl.changedInvitesCount = $ctrl.callsheet.changedInvites ? $ctrl.callsheet.changedInvites.length : 0;
        $ctrl.addedInvitesCount = $ctrl.callsheet.addedInvites ? $ctrl.callsheet.addedInvites.length : 0;

        $ctrl.send = {
            sendToAll: $ctrl.changedInvitesCount + $ctrl.addedInvitesCount <= 0,
            cc: false,
            dontSendConfirmToSender: false,
            resetConf: false,
            sms: true,
            addNote: false,
            note: null
        };

        $ctrl.recipientsInfo = '';
        if ($ctrl.addedInvitesCount > 0) {
            $ctrl.recipientsInfo += "<strong>Newly Added (" + $ctrl.addedInvitesCount + ")</strong><br>";
            for (i = 0; i < $ctrl.addedInvitesCount; i++) {
                $ctrl.recipientsInfo += $ctrl.addedInvites[i].name + (i !== $ctrl.addedInvitesCount - 1 ? ', ' : '');
            }
        }
        if ($ctrl.changedInvitesCount + $ctrl.addedInvitesCount > 0) {
            $ctrl.recipientsInfo += "<br/>";
        }

        if ($ctrl.changedInvitesCount > 0) {
            $ctrl.recipientsInfo += "<strong>Details Modified (" + $ctrl.changedInvitesCount + ")</strong><br/>";
            for (i = 0; i < $ctrl.changedInvitesCount; i++) {
                $ctrl.recipientsInfo += $ctrl.changedInvites[i].name + (i !== $ctrl.changedInvitesCount - 1 ? ', ' : '');
            }
        }
    }

    function onPostInitOther(){
        $ctrl.onSave = onSave;
        $ctrl.onError = onError;
        $ctrl.onSuccess = onSuccess;
        $ctrl.cancelPopup = cancelPopup;
        $ctrl.refresh = refresh;
        $ctrl.sendCallsheet = sendCallsheet;
        $ctrl.sendTestCallsheet = sendCS;
        $ctrl.goToPrices = goToPrices;
    }

    function getPopupBodyContent() {
        if(!$ctrl.isAllLoaded){
            return '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
        }
        return $ctrl.senderIsRecipient ? getSend() : getSendFree();
    }

    function onSave(result) {
        if (result.ok === 1) {//success
            if ($ctrl.onClose) {
                $ctrl.onClose({result:result});
            }
        } else if (result.writeErrors.length) {
            $ctrl.error = '';
            for (var i = 0; i < result.writeErrors.length; i++) {
                $ctrl.error += result.writeErrors[i];
            }
        }
    }

    function onError(error) {
        $ctrl.isUpdating = false;
        $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.callsheetInvitations.send.error');
    }

    function onSuccess(res) {
        $ctrl.broadcastRoot('UPDATE_CALLSHEET_SENT', res.callsheetSent);

        $ctrl.LCS.timeout(process, 5000);

        function process() {
            $ctrl.isUpdating = false;
            if ($ctrl.onClose) {
                $ctrl.onClose({result: res.invites});
            }
        }
    }

    function cancelPopup() {
        $ctrl.refresh();
        if ($ctrl.onClose) {
            $ctrl.onClose({result: 'cancel'});
        }
    }

    function refresh() {
        $ctrl.error = '';
    }

    function sendCallsheet(e) {
        $ctrl.CPS.loadQuotaPopup('callsheetBuilder', process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});

        function process() {
            $ctrl.isUpdating = true;
            var resendSelected = [];
            if ($ctrl.callsheetSent) {
                if (!$ctrl.send.sendToAll) {
                    if ($ctrl.changedInvitesCount) {
                        for (i = 0; i < $ctrl.changedInvitesCount; i++) {
                            resendSelected.push($ctrl.changedInvites[i]._id);
                        }
                    }
                    if ($ctrl.addedInvitesCount) {
                        for (i = 0; i < $ctrl.addedInvitesCount; i++) {
                            resendSelected.push($ctrl.addedInvites[i]._id);
                        }
                    }
                }
            }

            sendCS(resendSelected);
        }
    }

    function sendCS(resendSelected) {
        $ctrl.isUpdating = true;
        var params = getParams ();

        if (resendSelected && resendSelected.length > 0) { //send only to selected
            params.inviteIds = resendSelected;

            CallsheetInvitationsService.resendInvitesBulk($ctrl.security.sendGeneratorRequest, $ctrl.send, params, $ctrl.onSuccess, $ctrl.onError);
        } else {
            _.each(['cc','sms','dontSendConfirmToSender'], function (p){
                params[p] = $ctrl.send[p];
            })
            if ($ctrl.send.addNote && $ctrl.send.updateNote) {
                params.updateNote = $ctrl.send.updateNote;
            }
            if ($ctrl.callsheetSent) {
                params.callsheetSentId = $ctrl.callsheet.callsheetSentId;
                params.v = $ctrl.callsheetSent.v;
                params.resetConf = $ctrl.send.resetConf;
            } else {
                params.firstTime = true;
            }
            params = _.extend(params, getParams ());

            $ctrl.security.sendGeneratorRequest($ctrl.service.getSendPath(params), params, $ctrl.onSuccess, $ctrl.onError);
            //$ctrl.service.send(params, $ctrl.onSuccess, $ctrl.onError);
        }
    }

    function goToPrices(e) {
        $ctrl.SBStateService.openInNewWindow('user.pricing', $ctrl.CPS.currentPathParams());
        $ctrl.close(e);
    }
    
    function getSend() {
  var el = '';

          if(!$ctrl.totalInvites){
              if(!$ctrl.changedInvitesCount  &&  $ctrl.addedInvitesCount) {
                  el += '<p class="text-center">Please select at least one recipient to send this call sheet.</p>';
              }
          }else{
               el += '<p class="text-center wide-tooltip with-t-left">';
               if(!$ctrl.changedInvitesCount && !$ctrl.addedInvitesCount){
                  el += 'This call sheet will be {{$ctrl.callsheetSent ? \'re\':\'\'}}sent to {{$ctrl.totalInvites}} recipient{{$ctrl.totalInvites > 1 ? \'s\':\'\'}}?';
               }else {
                   el +=   'You have updated details for {{$ctrl.changedInvitesCount + $ctrl.addedInvitesCount}} <span style="color:#4C5359 ;text-decoration:underline" tooltip-placement="right" tooltip-html="$ctrl.recipientsInfo">recipient{{$ctrl.changedInvitesCount + $ctrl.addedInvitesCount > 1 ? \'s\' : \'\'}}</span>.';
               }

               el += '</p>' +
                        $ctrl.confirmResend();
            }

            el += '<div class="modal-footer clearfix semi-tall">' +
                '<div class="form-wrapper text-center spacing-half">';

            if($ctrl.totalInvites>0) {
                el += '<button class="btn btn-primary '+$ctrl.pageClass+'" ng-click="$ctrl.sendCallsheet($event)" data-type="sendCallsheet" analytics-on analytics-action="Send Call Sheet" ng-class="{ \'disabled\': $ctrl.isUpdating===true}" ng-disabled="$ctrl.isUpdating===true"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Send to {{$ctrl.send.sendToAll ? $ctrl.totalInvites : ($ctrl.changedInvitesCount + $ctrl.addedInvitesCount)}} recipient{{($ctrl.send.sendToAll ? $ctrl.totalInvites : $ctrl.changedInvitesCount + $ctrl.addedInvitesCount) > 1 ? \'s\' : \'\'}}</button>';

                if (!$ctrl.callsheetBuilder && $ctrl.senderIsRecipient) {
                    el += '<div class="full-width text-center margin-top-half">' +
                        '<a class="btnSendTest semibold '+$ctrl.pageClass+'" ng-click="$ctrl.sendTestCallsheet()" analytics-on analytics-action="Send Test Call Sheet" ng-class="{\'disabled\': $ctrl.isUpdating===true}" ng-disabled="$ctrl.isUpdating===true"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Send Me Test Call Sheet</a>' +
                        '</div>';
                }
            }else  {
                el += '<button class="btn btn-primary '+$ctrl.pageClass+'" ng-click="$ctrl.closePopup()">Close</button>';
            }

            el += '</div>' +
            '</div>';
        return el;

        function getbtns(){
            if(!$ctrl.totalInvites) {
                return '<button class="btn btn-primary ' + $ctrl.pageClass + '" ng-click="$ctrl.closePopup()">Close</button>';
            }
            var el = '<button class="btn btn-primary '+$ctrl.pageClass+'" ng-click="$ctrl.sendCallsheet($event)" data-type="sendCallsheet" analytics-on analytics-action="Send Call Sheet" ng-class="{ \'disabled\': $ctrl.isUpdating===true}" ng-disabled="$ctrl.isUpdating===true"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Send to {{$ctrl.send.sendToAll ? $ctrl.totalInvites : ($ctrl.changedInvitesCount + $ctrl.addedInvitesCount)}} recipient{{($ctrl.send.sendToAll ? $ctrl.totalInvites : $ctrl.changedInvitesCount + $ctrl.addedInvitesCount) > 1 ? \'s\' : \'\'}}</button>';

            if (!$ctrl.callsheetBuilder && $ctrl.senderIsRecipient) {
                return el +
                    '<div class="full-width text-center margin-top-half">' +
                        '<a class="btnSendTest semibold '+$ctrl.pageClass+'" ng-click="$ctrl.sendTestCallsheet()" analytics-on analytics-action="Send Test Call Sheet" ng-class="{\'disabled\': $ctrl.isUpdating===true}" ng-disabled="$ctrl.isUpdating===true"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Send Me Test Call Sheet</a>' +
                    '</div>';
            }
            return el;
        }
    }
    
    function getSendFree() {
        $ctrl.sendTest = true;
        $ctrl.popupTitle = 'Upgrade to Send Call Sheet';
        return '<div class="modal-body clearfix">' +
                '<div class="form-wrapper">' + getInviteInfo() + '</div>' +
            '</div>' +
            '<div class="modal-footer clearfix semi-tall">' +
                '<div class="form-wrapper">' +
        ($ctrl.senderIsRecipient ? ( ($ctrl.totalInvites>0? ('<div class="text-center spacing-bottom">' +
                    '<a class="btnSendTest semibold" ng-click="$ctrl.sendTestCallsheet()" analytics-on analytics-action="Call Sheet\': \'Send Test Call Sheet\'" ng-class="{\'disabled\': $ctrl.isUpdating===true}" ng-disabled="$ctrl.isUpdating===true"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Send Me a Test Call Sheet</a></div>'):'')) : '') +
                    '<div class="text-center spacing-half-bottom '+$ctrl.pageClass+'"><button class="btn btn-primary '+$ctrl.pageClass+' " ng-click="$ctrl.goToPrices($event)">Upgrade Now</button></div>' +
                '</div>' +
            '</div>';

        function getInviteInfo() {
            var el = '';
            if (!$ctrl.totalInvites) {
                if (!$ctrl.changedInvitesCount && !$ctrl.addedInvitesCount) {
                    el += '<p class="text-center">Please select at least one recipient to send this call sheet.</p>';
                }
            } else {
                el += '<p class="text-center  wide-tooltip with-t-left">' +
                    'Please upgrade to send the call sheet to all recipients now, or ' +
                    ($ctrl.senderIsRecipient ? ('send a free test to <strong>' + $ctrl.CPS.user.email + '</strong>') : ('add a recipient with the email <strong>' + $ctrl.CPS.user.email + '</strong> to send a free test.')) +
                    '</p>' +
                    $ctrl.confirmResend('spacing-half');
            }
            return el;
        }
    }
}

