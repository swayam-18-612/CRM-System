angular.module('product.document.notes.controller.service', [
    'product.contentEditorBubblePopup.controller.service'
])
//used for documentVersionTitlePagePopup documentVersionNotesPopup
.service('VersionNoteServiceCtrl', VersionNoteServiceCtrl);
VersionNoteServiceCtrl.$inject = ['DocumentVersionsService', 'ContentEditorBubbleCtrlService'];
function VersionNoteServiceCtrl(service, ContentEditorBubbleCtrlService) {
    return function ($ctrl, $element, isPopup) {
        $ctrl.onAdditionalInit = onAdditionalInit;

        $ctrl = new ContentEditorBubbleCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function onAdditionalInit() {

            $ctrl.withoutCustomOnSave = true;

            $ctrl.customTitle = '  ';
            $ctrl.editorType = 'pagecover';

            //$ctrl.contentEditorCls = 'withborderbottom';

            if ($ctrl.onAdditionalInitOther) {
                $ctrl.onAdditionalInitOther();
            }

            if (!$ctrl.service) {
                $ctrl.service = service;
            }

            if (!$ctrl.dontLoadFromServer) {
                $ctrl.service.getById($ctrl.item._id, '', initVersion, onError);
            }

            function onError(err) {
                initVersion(null);
            }

            function initVersion(item) {
                $ctrl.item = item;
                if($ctrl.onInitVersion) {
                    $ctrl.onInitVersion();
                }
            }
        }
    }
}

angular.module('product.document.versions.component', [
    'apiServices.DocumentVersions',
    'apiPagination.MaterialVersions',
    'services.revisionsPersistanceService'
])

.component('documentRevisionHistoryPopup', popupComponentParams('DocumentVersionsPopupCtrl'))

.controller('DocumentVersionsPopupCtrl', DocumentVersionsPopupCtrl);
DocumentVersionsPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', 'TemplateCompileService', 'DocumentVersionsService','ListInitService', 'MaterialVersionsPagination', 'RevisionsPersistanceService', '$element'];

function DocumentVersionsPopupCtrl(ItemTemplateCompileCtrlService, TemplateCompileService, DocumentVersionsService, ListInitService, MaterialVersionsPagination, RevisionsPersistanceService, $element) {
    console.log('DocumentVersionsPopupCtrl');
    //ListInitService inherits CompInitCtrlService
    var $ctrl = this;

    $ctrl.DocumentVersionsService = DocumentVersionsService;

    $ctrl.isPopup = true;

    $ctrl.formHolder = {};

    $ctrl.Types = {Server: 'items', Local: 'itemsLocal'};
    $ctrl.actions = {};
    $ctrl.actions[$ctrl.Types.Server] = {
        remove: removeServer,
        makeCurrent: makeCurrentServer,
        view: viewServer
    };
    $ctrl.actions[$ctrl.Types.Local] = {
        remove: removeLocal,
        makeCurrent: makeCurrentLocal,
        view: viewLocal
    };

    $ctrl.rename = rename;
    $ctrl.isCurrent = isCurrent;
    $ctrl.setConfirm = setConfirm;
    $ctrl.getDownloadLink = getDownloadLink;
    $ctrl.remove = remove;
    $ctrl.getData = getData;
    $ctrl.makeCurrent = makeCurrent;
    $ctrl.getColorStyle = getColorStyle;
    $ctrl.view = view;

    $ctrl.preInit = preInit;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupHeaderSubtitle = getPopupHeaderSubtitle;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.selectItemType = selectItemType;
    $ctrl.showTable = showTable;
    $ctrl.existsTable = existsTable;
    $ctrl.isSelectItemType = isSelectItemType;
    $ctrl.onLoaded = onLoaded;
    $ctrl.canRemove = canRemove;
    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInit() {
        $ctrl.isLoaded = false;
        $ctrl.contentVersion = $ctrl.item.contentVersion;
        $ctrl.contentVersionId = $ctrl.contentVersion ? $ctrl.contentVersion._id : null;
        $ctrl.documentVersionId = $ctrl.item._id;
        $ctrl.materialVersion = $ctrl.item.materialVersion;
        $ctrl.fileType = $ctrl.item.type;

        if($ctrl.contentVersion) {
            $ctrl.contentVersion.type = $ctrl.fileType;
        }

        $ctrl = new ListInitService($ctrl, {
            list: new MaterialVersionsPagination(1000,
                ['name', 'version', 'createdById', 'createdAt', 'path', 'current', 'materialId', 'size', 'mimeType', 'notes', 'summary'],
                ['name'],
                ['name', 'createdAt', 'createdAtT'],
                ['createdById']
            ),
            preloadAll: true,
            withProperty: withProperty,
            onAllLoaded: onAllLoaded
        });

        getLocalVersions();
    }

    function onLoaded() {
        if($ctrl.contentVersion) {
            $ctrl.getAll();
        } else{
            onAllLoaded()
        }
    }

    function canRemove(v){return !v.isImported;}

    function onAllLoaded() {
        console.log('onAllLoaded');

        var list = $ctrl.list[$ctrl.Types.Server] || [];

        if (list.length) {
            list = _.unique(sortdesc(list),'_id');
        }

        //the initial file has been moved into a different material
        if ($ctrl.materialVersion) {
            var index = _.findIndex(list, {_id: $ctrl.materialVersion._id});
            if (index === -1) {
                $ctrl.materialVersion.isImported = true;
                list.push($ctrl.materialVersion);
            } else {
                list[index].isImported = true;
            }
        }

        $ctrl.list[$ctrl.Types.Server] = list;

        $ctrl.selectItemType(null,
            list.length > 0 ? $ctrl.Types.Server : $ctrl.Types.Local);

        $ctrl.isLoaded = true;

        reloadServerTable();
    }

    function reloadServerTable() {
        if (!$ctrl.compileTemplate) {
            $ctrl.compileTemplate = new TemplateCompileService(angular.element($ctrl.element.querySelector('.table' + $ctrl.Types.Server)), getTableTemplate, $ctrl, false);
        }
        $ctrl.compileTemplate.loadTemplate();
    }

    function existsTable(type) {
        return $ctrl.list[type] && $ctrl.list[type].length > 0;
    }

    function showTable(type) {
        return existsTable(type) && $ctrl.isSelectItemType(type);
    }

    function setTemplateData() {
        $ctrl.popupTitle = 'Revision History';
        $ctrl.icon = 'versions';
        $ctrl.iconLevel = 3;
        $ctrl.withFooterBtns = false;
    }

    function getPopupHeaderSubtitle(){
return '<h4>' +
           '<div class="table-div table-fixed centered">' +
               '<div class="version-col centered text-left"><span class="mark-version" ng-bind="::\'v\'+$ctrl.item.version" ng-style="::$ctrl.getColorStyle($ctrl.item)"></span></div>' +
               '<div class="title-col grow-columm centered with-padding-left">' +
                   '<div class="with-ellipsis"><span ng-bind="::$ctrl.item.name" class="gray"></span></div>' +
               '</div>' +
           '</div>' +
       '</h4>';
    }

    function getTableTemplate(){
        return getContent($ctrl.Types.Server);
    }

    function getPopupBodyContent() {
    return '<div class="header text-center margin-half">' +
                getI($ctrl.Types.Server, 'Server Versions') +
                getI($ctrl.Types.Local, 'Local Versions') +
            '</div>' +
            '<div class="table-rewards scripts">' +
                getTable($ctrl.Types.Server) +
                getTable($ctrl.Types.Local) +
            '</div>';
        function getI(type, name) {
            return '<a class="with-margin-left with-margin-right" ng-show="$ctrl.existsTable(\'' + type + '\')" ng-class="$ctrl.showTable(\'' + type + '\') ? \'semibold underlined\' :\'gray\'" ng-click="$ctrl.selectItemType($event,\'' + type + '\')">' + name + '</a>';
        }
    }

    function getTable(type) {
        return '<div class="table' + type + '" ng-show="$ctrl.showTable(\'' + type + '\')">' +
            getContent(type) +
            '</div>';
    }
    function getContent(type) {
        if($ctrl.isLoaded){
            $ctrl.LCS.emptyElement($ctrl.element.querySelector('.table' + $ctrl.Types.Server));
        }
        return type === $ctrl.Types.Server && !$ctrl.isLoaded ?
                ('<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>') :
                ('<div class="version-row centering with-border-bottom" ng-class="{\'with-border-top\':listIndex===0}" ng-repeat="(listIndex, v) in $ctrl.list.' + type + ' track by v._id">' +
                    '<div class="file table-div full-width">' +
                    '<div class="centered" ng-show="!v.rename">' +
                        '<a class="gray semibold" ng-click="$ctrl.view($event, v)" analytics-on analytics-action="View File"><span ng-bind="v.name"></span></a>' +
                        '<div class="inline-block with-margin-left current" ng-show="$ctrl.isCurrent(v)">Current</div>' +
                    '</div>' +
                    '</div>' +
                    '<div class="uploadedinfo"><span ng-bind="v.isImported ? \'Imported\' : \'Last modified\'"></span> <span ng-if="v.createdBy">by <span ng-bind="::v.createdBy.name"></span></span> on <span ng-bind="::v.createdAt|amDateFormat:$ctrl.CPS.dateTimeFormat"></span></div>' +
                    '<div ng-if="::v.notes" ng-bind-html="::v.notes|unsafe"></div>' +
                    ($ctrl.canEdit ? ('<div ng-show="!$ctrl.isCurrent(v)">' +
                        //'<a ng-click="$ctrl.getDownloadLink($event, v)" analytics-on analytics-action="Download File Version">Download</a>' +
                        //'<div class="dot-container"><span class="dot-separator"></span></div>' +
                            (type === $ctrl.Types.Server ? ('<a ng-show="!$ctrl.isCurrent(v)" ng-click="$ctrl.makeCurrent($event, v)" analytics-on analytics-action="Make Current">Make Current</a>' + '<div class="dot-container" ng-show="$ctrl.canRemove(v) && !$ctrl.isCurrent(v)"><span class="dot-separator"></span></div>') : '') +
                            '<a ng-show="$ctrl.canRemove(v)" ng-click="$ctrl.setConfirm($event, v, true)">Remove </a>' +
                        '</div>' +
                        '<div class="layer" ng-show="v.confirmRemove">' +
                            '<div class="text-center white">Are you sure you want to remove this revision?</div>' +
                            '<div class="text-center">' +
                                '<a class="margin-right-20" ng-click="$ctrl.remove($event, v)">Remove</a>' +
                                '<a ng-click="$ctrl.setConfirm($event, v, false)">Cancel</a>' +
                            '</div>' +
                        '</div>') : '') +
                    '</div>');
    }

    function selectItemType(e, type){
        $ctrl.preventDefault(e);
        if(!$ctrl.isSelectItemType(type)) {
            $ctrl.list.selectedType = type;
        }
    }

    function isSelectItemType(type){
       return $ctrl.list.selectedType === type;
    }

    function sortdesc(l){
        return l && l.length ? _.sortBy(l, 'createdAtT').reverse() : null;
    }

    function getLocalVersions() {
        var list = RevisionsPersistanceService.getAll($ctrl.documentVersionId, null, null),
            l = [];
        if (list) {
            _.each(list, function (v) {
                var id = v.t;
                if (_.find(l, {_id: id}) === undefined) {
                    var m = moment(id)
                    l.push({
                        _id: id,
                        name: $ctrl.DocumentVersionsService.getFilename({type: $ctrl.item.type, name: ''}, id),
                        createdAt: moment(id),
                        createdAtT: $ctrl.MomentService.getTimestamp(m),
                        content: v.c,
                        contentVersionId: v.v
                    });
                }
            });
        }
        $ctrl.list[$ctrl.Types.Local] = sortdesc(l);
    }

    function isCurrent(item) {
        return item && item._id === $ctrl.contentVersionId && !item.isImported;
    }

    function setConfirm(e, item, val){
        $ctrl.preventDefault(e);
        if(item) {
            item.confirmRemove = val;
        }
    }

    function getColorStyle(item) {
        return $ctrl.DocumentVersionsService.getColorStyle(item);
    }

    function remove(e, item) {
        $ctrl.preventDefault(e);
        $ctrl.error = null;
        $ctrl.actions[$ctrl.list.selectedType].remove(item);
    }

    function getData(item) {
        var p = {
            versionId: item._id,
            id: item.materialId,
            type: $ctrl.objectType
        };

        if ($ctrl.extraParam) {
            for (var e in $ctrl.extraParam) {
                p[e] = $ctrl.extraParam[e];
            }
        }

        return p;
    }

    function makeCurrent(e, item) {
        $ctrl.preventDefault(e);
        $ctrl.actions[$ctrl.list.selectedType].makeCurrent($ctrl.getData(item));
    }

    function rename(item) {
        $ctrl.formHolder['form' + item._id + '_attempted'] = true;
        var form = $ctrl.formHolder['form' + item._id];
        if (form && form.$valid) {
            $ctrl.isUpdating = true;

            $ctrl.service.update({
                _id: item._id,
                name: item.name
            }, function (result) {
                $ctrl.isUpdating = false;
                // $ctrl.list.items[index].name  = el.name ;
                item.rename = false;
            }, function (error) {
                $ctrl.isUpdating = false;
                $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.version.Edit.error', 'error');
            });
        }
    }

    function withProperty() {
        return {
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId,
            materialId: $ctrl.contentVersion.materialId
        };
    }

    function getDownloadLink(item, e) {
        console.log('getDownloadLink');
        $ctrl.preventDefault(e);

        processDownload(item, onsuccess, onerror);

        function processDownload(item, onsuccess, onerror) {
            if (item.isDownloading) {
                return;
            }
            item.isDownloading = true;
            item.productId = $ctrl.CPS.productId;
            item.companyId = $ctrl.CPS.companyId;

            $ctrl.service.getDownloadLink( {
                id: item.materialId,

                versionId: item._id,
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
            },  function (link) {
                item.isDownloading = false;
                if(onsuccess){onsuccess(link);}
                return false;
            }, function (err) {
                item.isDownloading = false;
                if(onerror){onerror(err);}
            });
        }

        function onsuccess(link) {
            $ctrl.SBStateService.assignUrl(link, 500);
            return false;
        }

        function onerror(err) {
        }
    }

    function view(e, item) {
        $ctrl.preventDefault(e);
        console.log('viewRevision');
        $ctrl.actions[$ctrl.list.selectedType].view(item);
    }

    function viewLocal(item) {
        $ctrl.popupsService.open(item, $ctrl.popupsService.operations.viewDocument, {
            type: $ctrl.fileType,
            withDownload: true,
            withoutDownloadPDF: true
        }, $ctrl.compOptions, function () {

        });
    }

    function viewServer(item) {
        $ctrl.popupsService.open(item._id, $ctrl.popupsService.operations.materialViewer, {
            // withDownload: true,
            withComments: false,
            canComment: false,
            canUpload: false,
            withoutSidebar: true,
            withHeader: true
        }, null, null, function (result){
            console.log('onSuccess');
        });
    }

    function removeServer(item) {
        $ctrl.service.delete(item, function (el) {
            if (el.item) {
                el = el.item;
            }
            onRemoved(el, $ctrl.Types.Server);
        }, function (err) {
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.version.Remove.error', 'error');
        });
    }

    function onRemoved(item, type){
        if ($ctrl.list && $ctrl.list[type]) {
            $ctrl.list.removeElement(item, type);
            if(!$ctrl.list[type] || !$ctrl.list[type].length){
                var other = $ctrl.isSelectItemType($ctrl.Types.Server) ? $ctrl.Types.Local : $ctrl.Types.Server;
               if($ctrl.list[other] && $ctrl.list[other].length) {
                   $ctrl.selectItemType(null, other);
               }
            }
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.version.Remove.success', 'success');
        }
    }

    function removeLocal(item) {
        RevisionsPersistanceService.remove($ctrl.documentVersionId, item._id);
        onRemoved(item, $ctrl.Types.Local);
    }

    function makeCurrentServer(data){
        $ctrl.service.makeCurrent(data, function (result) {
            var el = result && result.material ? result.material : null;
            if (el) {
                //reset current
                $ctrl.list.replaceAllElementsProps({current: false});
                var v = el.versionId._id;
                el.version = el.versionId;
                el.version.createdById = $ctrl.CPS.user;
                el.versionId = v;
                if (el.version && $ctrl.list && $ctrl.list.items) {
                    $ctrl.list.replaceElement(el.version);
                }
                $ctrl.broadcastRoot('UPDATE_DOCUMENTVERSION_FROM_HISTORY', {
                    versionId: $ctrl.documentVersionId,
                    contentVersion: el.version
                });
                $ctrl.closePopup(result);
            }
        }, function (err) {
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.version.makeCurrent.error', 'error');
        });
    }

    function makeCurrentLocal(data){
        $ctrl.service.makeCurrent(data, function (result) {
            var el = result && result.material ? result.material : null;
            if (el) {
                //reset current
                $ctrl.list.replaceAllElementsProps({current: false});
                var v = el.versionId._id;
                el.version = el.versionId;
                el.version.createdById = $ctrl.CPS.user;
                el.versionId = v;
                if (el.version && $ctrl.list && $ctrl.list.items) {
                    $ctrl.list.replaceElement(el.version);
                }
                $ctrl.broadcastRoot('UPDATE_DOCUMENTVERSION_FROM_HISTORY', {
                    versionId: $ctrl.documentVersionId,
                    contentVersion: el.version
                });
                $ctrl.closePopup(result);
            }
        }, function (err) {
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.version.makeCurrent.error', 'error');
        });
    }
}


