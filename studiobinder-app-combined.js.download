angular.module('product.script.exportButton.component', [
    'product.script.export.component',
    'services.stateService',
    'services.compile'

])
.component('exportScriptButton', {
    bindings: {
        scriptContainer: '<',
        showTitle: '<?',
        scriptId: '<?',
        productId: '<?',
    },
    controller: 'ExportScriptButtonComponentController'
});
ExportScriptButtonComponentController.$inject = ['TemplateCompileCompCtrlService', 'CompileService','$element', '$attrs', '$scope'];
function ExportScriptButtonComponentController(TemplateCompileCompCtrlService, CompileService, $element, $attrs, $scope) {
    var newEl, newScope, body;
    var $ctrl = this;
    $ctrl.CompileService = CompileService;

    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = removeExporter;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        body = angular.element(document.body);
        $ctrl.btnClass = $attrs.btnClass;
        $ctrl.formHolderItem = {};
        $ctrl.exportFromScript = exportFromScript;
    }

    function postInit() {
        $ctrl.addRootWatcher("REMOVE_SCRIPT_EXPORTER", onRemoveScript);
    }

    function getItemTemplate() {
        return '<a data-type="exportFromScript" analytics-on analytics-action="Export Script" ' +
            'class="'+ +$ctrl.getBtnActionCls() + ($ctrl.btnClass ? (' ' + $ctrl.btnClass) : '') +'"'  +
            ($ctrl.showTitle ? '' :'tooltip="Export Script" tooltip-placement="bottom" ') +
                '><span class="sbf export"></span> ' +
            ($ctrl.showTitle ? ('<span class="hide-ipad">Export Script</span>') : '') +
            '</a>'
    }

    function onRemoveScript(result) {
        console.log('REMOVE_SCRIPT_EXPORTER');
        removeExporter();
    }

    function exportFromScript() {
        $ctrl.popupsService.teamAccess(function () {
            createExporter();
        });
    }

    function createExporter() {
        removeExporter();
        $ctrl.CompileService.compileTemplate($scope, {
            scriptContainer: $ctrl.scriptContainer,
            params: {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                scriptId: $ctrl.scriptId
            }
        }, '<export-scriptfile id="exportScriptFile" ' +
            'params="::$ctrl.params" ' +
            'script-container="$ctrl.scriptContainer"' +
            '></export-scriptfile>', newScope, function (clonedElement, scope) {
            newEl = clonedElement;
            body.append(newEl);
            newScope = scope;
        });
    }

    function removeExporter() {
        if (newScope) {
            newScope.$destroy();
            newScope = null;
        }
        if (newEl) {
            body.find('.exporter-wrapper').remove().end();
            newEl = null;
        }
    }
}


