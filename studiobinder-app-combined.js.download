angular.module('dropdowns.contactRate.controller.service', [
    'dropdowns.drpnonclosed.controller.service'
])
.service('SBContactRateCtrlService', SBContactRateCtrlService);
SBContactRateCtrlService.$inject = ['SBFieldTypesService', 'SBDrpNonClosedCtrlService'];
function SBContactRateCtrlService(SBFieldTypesService, SBDrpNonClosedCtrlService) {
    return function($ctrl, $element, $attrs) {
        console.log('SBContactRateCtrlService');
        var withoutTemplateScope = true;
        $ctrl.menuTag = 'sb-rate-dropdown-menu';
        $ctrl.menuCls = 'timepicker-popup';
        $ctrl.setInputField = false;
        $ctrl.propType = $ctrl.isContactRate ? SBFieldTypesService.PropTypes.ContactRate : SBFieldTypesService.PropTypes.Rate;

        $ctrl.generateDrpMenuContent = generateDrpMenuContent;

        $ctrl.initDrp = initDrp;
        $ctrl.preselect = preselect;

        $ctrl = new SBDrpNonClosedCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

        return $ctrl;

        function initDrp() {
            $ctrl.tabIndex = $ctrl.tabIndex ? $ctrl.tabIndex : null;
        }

        function generateDrpMenuContent() {
            return {
                $ctrl: {
                    value: angular.copy($ctrl.value),
                    onSelect: $ctrl.onSelect,
                },
                template: ($ctrl.hasRemove ? ("has-remove='" + $ctrl.hasRemove + "' ") : '') +
                    ($ctrl.labelField ? ("label-field='" + $ctrl.labelField + "' ") : '') +
                    ($ctrl.valueField ? ("value-field='" + $ctrl.valueField + "' ") : '') +
                    "value='::$ctrl.value' " +
                    "on-select='$ctrl.onSelect(result)' " +
                    //if is contact rate && is on project contacts
                    ($ctrl.isContactRate && $ctrl.contactListId ? ("is-contact-rate='true' ") : '')
            };
        }

        function preselect(result) {
            if (result.setDefault) {
                $ctrl.setDefault = result.setDefault;
            }

            $ctrl.setNewValue(result.e, result.value);
        }
    }
}

