angular.module('product.screenplays.page.controller.service', [
    'product.documents.page.init.controller.service',
    'apiConstants.screenplays.services'
])
.service('ScreenplaysPageCtrlService', ScreenplaysPageCtrlService);
ScreenplaysPageCtrlService.$inject = ['DocumentsPageInitCtrlService', 'ScreenplaysConstantsService'];
function ScreenplaysPageCtrlService(DocumentsPageInitCtrlService, constantsService) {
    return function ($ctrl, $element) {
        console.log('ScreenplaysPageCtrlService');
        $ctrl.checkShowAddNewItem = checkShowAddNewItem;
        $ctrl.shouldLoad = shouldLoad;

        $ctrl.showIntro = showIntro;
        $ctrl = new DocumentsPageInitCtrlService($ctrl, $element, constantsService);

        return $ctrl;

        function showIntro(){return false;}
        function checkShowAddNewItem() {
            return $ctrl.CPS.isAuthenticated && $ctrl.CPS.companyId === $ctrl.LCS.API_CONFIGS.SBPredefCompanyId;
        }

        function shouldLoad(list) {
            var l = list ? list.length : 0,
            show = $ctrl.CPS.getSearchFilter('show');
            if (show === true || l !== 1) {
                return true;
            }
            //$ctrl.onLoadDirectory(list[0]);

            var isTransition = true;
            if(isTransition) {
                //get(isTransition); redirect smooth
                $ctrl.LCS.timeout(function () {// full redirect
                    //window.location.reload(false);
                    $ctrl.LCS.$window.location = get(false);
                }, 10);

            }else{
                $ctrl.LCS.$window.location.href = get(isTransition);
            }

            return false;

            function get(isTransition) {
                return $ctrl.CPS[isTransition ? 'transitionTo' : 'getStateHref']('user.product.screenplay', $ctrl.CPS.currentProductPathParams({
                    documentId: list[0]._id
                }));
            }
        }
    }
}


