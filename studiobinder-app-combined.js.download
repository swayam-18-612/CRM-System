    function edit(withPreprocess, blob, opts, onsuccess, oncancel) {

        init(process);
        function process() {
          /*  if(opts.){
                PinturaNav PinturaNavMain
            }*/
            if(!opts){opts = {};}
            var isDisabled = false,//!opts['hasstoryboardArrows'],
                params = {
                    // watermark: 'StudioBinder',
                };

            if (opts.maxWidth) {
                params.outputWidth = opts.maxWidth;

                if (opts.isSquare) {
                    params.outputHeight = opts.maxWidth;
                    if (opts.isCircleMask) {
                        params.willRenderCanvas = onRenderCanvas;
                    }
                }
            }

            if(opts.isSquare){
                params.imageCropAspectRatio = 1;
            }

            // params.imageCropAspectRatio = opts.isSquare ? 1 : (16 / 9);
            params.cropEnableButtonFlipHorizontal = true;
            params.cropEnableButtonFlipVertical = true;
            params.cropAspectRatioOptions = opts.isSquare ? null : [
                {
                    label: 'Free',
                    value: null
                },
                {
                    label: 'Portrait',
                    value: 1.25
                },
                {
                    label: 'Square',
                    value: 1
                },
                {
                    label: 'Landscape',
                    value: .75
                }
            ];
           var imageWriterProps = {
                // Scale all input canvas data to fit a 4096 * 4096 rectangle
                // canvasMemoryLimit: 4096 * 4096,
                // Fix image orientation
                orientImage: true,
                    // Don't retain image EXIF data
                    //copyImageHead: false,
                mimeType: blob.mimeType || 'image/jpeg',
                quality: 94,

                // Post images to API at './upload'
                //store: './upload',

                // Show all output props
                outputProps: [],


                /* renameFile: function(file) {
                     return `output_${name.substr(0, name.lastIndexOf('.'))}.jpeg`,
                 }*/
            };

            // Limit size of output to this size
            if(opts.maxWidth){
               imageWriterProps.targetSize = { 
                   width: opts.maxWidth
               };
               if(opts.isSquare){
                   imageWriterProps.targetSize.height = opts.maxWidth;
               }
                /* targetSize: {
                     width: 640,
                     height: 480,
                     fit: 'contain',
                     upscale: false,
                 },*/
            }

            if (opts.watermark) {
                params.markup = [
                    [
                        'rect',
                        {
                            left: 0,
                            right: 0,
                            bottom: 0,
                            height: '60px',
                            backgroundColor: 'rgba(0,0,0,.5)',
                            canSelect: false
                        },
                    ],
                    [
                        /* 'image',
                         {
                             right: '10px',
                             bottom: '10px',
                             width: '128px',
                             height: '34px',
                             src: './ImgEditor-logo.svg',
                             fit: 'contain',
                             canSelect: false
                         }*/
                        'text', {
                        zIndex: 0,
                        x: 0,
                        y: 0,
                        width: 0,
                        height: 0,
                        fontColor: "#9e9e9e",
                        fontSize: 0.05,
                        fontFamily: "Monaco, 'Lucida Console', monospaced",
                        text: options.watermark,
                        fit: 'contain',
                        canSelect: false
                    }
                    ]
                ];
                function addWatermark(imageData){
                    new Promise((resolve, reject) => {
                        // Create a canvas element to handle the imageData
                        const canvas = document.createElement('canvas');
                        canvas.width = imageData.width;
                        canvas.height = imageData.height;
                        const ctx = canvas.getContext('2d');
                        ctx.putImageData(imageData, 0, 0);

                        // Draw our watermark on top
                        const watermark = new Image();
                        watermark.onload = function(){
                            // how to draw the image to the canvas
                            ctx.globalCompositeOperation = 'screen';

                            // draw the watermark in the top right corner
                            ctx.drawImage(
                                watermark,

                                // the watermark x and y position
                                imageData.width - 100 - 20,
                                20,

                                // the watermark width and height
                                100,
                                40
                            );

                            // Get and return the modified imageData
                            resolve(
                                ctx.getImageData(
                                    0,
                                    0,
                                    imageData.width,
                                    imageData.height
                                )
                            );
                        };
                        watermark.onerror = reject;
                        watermark.crossOrigin = 'Anonymous';
                        watermark.src = './my-watermark.svg';
                    });
                }


                //params.postprocessImageData = addWatermark;
            }

            // This handles complex shapes like arrows / frames
            if(ImgEditor.createDefaultShapePreprocessor) {
                params.shapePreprocessor = ImgEditor.createDefaultShapePreprocessor();
            }

            params = _.extend(params, {
                    //modal:HTMLElement // The root element of the modal. Only available when the editor was created with the openEditor method.
                    src: blob.url,

                    utils: ['crop', 'finetune', 'filter', 'annotate', 'sticker',
                        //'resize',
                        //'decorate'
                       // 'frame',
                       // 'redact',
                        //'fill',
                        //'retouch',
                    ],
                    cropSelectPresetOptions: opts.isSquare ? [] : cropSelectPresetOptions,
                    locale: ImgEditorLocale,

                    imageOrienter: ImgEditor.createDefaultImageOrienter({
                        // Fix image orientation
                        orientImage: true,
                        /*  outputProps: {
                              // the resulting file
                              dest: {
                                  name: 'my-image.jpeg',
                                  lastModified: 1605802185485,
                                  size: 128000,
                                  type: 'image/jpeg',
                              },
                              // the image size
                              size: {
                                  width: 1280,
                                  height: 1024,
                              },
                              // the original source
                              src: './images/my-image.jpeg',
                          }*/
                    }),
                    imageReader: ImgEditor.createDefaultImageReader(), //defaultImageReaderParams as params
                    imageWriter: ImgEditor.createDefaultImageWriter(imageWriterProps),
                    shapePreprocessor: params.shapePreprocessor,
                    stickers: getArrows(isDisabled, blob.width, blob.height),
                    stickerEnableSelectImagePreset:isDisabled,
                    stickerStickToImage: true,
                    stickersEnableButtonFlipVertical: true,
                    stickersEnableButtonFlipHorizontal: true,

                    previewUpscale: true,
                    //imagePreviewScaleMode: 'stage',

                    //square
                    //cropAspectRatio: 1,
                    allowDropFiles: false, //Allow dropping files on the editor window.
                    //  outputQuality: 90, //When not supplied it will use the browser default quality which averages around 94.
                    allowAutoDestroy: true,
                    //save avatars as jpeg
                    outputType: blob.mimeType || 'image/jpeg',
                    outputData: true,
                },
                ImgEditor.plugin_finetune_defaults,
                ImgEditor.plugin_filter_defaults,
                ImgEditor.markup_editor_defaults,
                ImgEditor.plugin_annotate_defaults,

                //ImgEditor.plugin_resize_defaults
                //ImgEditor.plugin_fill_defaults,
                //ImgEditor.plugin_retouchdefaults,
            );

            if (ImgEditor) {
                destroy();
                service.oncancel = oncancel;
                editor = ImgEditor.openEditor(params);
                if (editor) {
                    bind(true);

                    editor.on('load', onLoaded);
                    editor.on('process', onProcess); //Fired when an image has been processed
                    editor.on('processabort', oncanceledit);
                    editor.on('processerror', oncanceledit);
                    editor.on('close', oncanceledit);

                }
            }
            function onLoaded() {
                LCS.timeout(function () {

                    if (editor.layersAdded) {
                        return;
                    }
                    _.each(getPanels(null, true), function (el) {
                        var s = el.getAttribute('id').split('-');
                        process(el, s[s.length - 1]);
                    });

                    editor.layersAdded = true;

                    function process(el, tab) {
                        switch (tab) {
                            case 'annotate':
                                addBanner('imageAnnotations', el);
                                break;
                            case 'finetune':
                                addBanner('imageFinetune', el);
                                break;
                            case 'filter':
                                addBanner('imageFilters', el);
                                break;
                            case 'sticker':
                                addBanner('storyboardArrows', el);
                                break;
                            //case 'sticker': addBanner('storyboardVideos',tab); break;
                            //case 'sticker': addBanner('videoEditor',tab); break;
                        }
                    }
                }, 1000);
            }

            function onRenderCanvas(shapes, state) {
                var utilVisibility = state.utilVisibility, selectionRect = state.selectionRect;
                // shortcuts to selection rect
                var x = selectionRect.x, y = selectionRect.y, width = selectionRect.width,
                    height = selectionRect.height;
                // return updated UI shapes list
                return _.extend({}, shapes, {
                    // add an `ellipse` shape
                    interfaceShapes: __spreadArrays([
                        {
                            x: x + width * 0.5,
                            y: y + height * 0.5,
                            rx: width * 0.5,
                            ry: height * 0.5,
                            opacity: state.opacity,
                            inverted: true,
                            //backgroundColor: [0, 0, 0, 0.5],
                            strokeWidth: 1,
                            strokeColor: [1, 1, 1],
                        }
                    ], shapes.interfaceShapes)
                });
            }

            function addBanner(tab, el) {
                var quota = getQuota(tab),
                hasQuota = CPS.hasQuotaType(quota);
                if (!hasQuota) {
                    setBanner(el,true, quota, tab);
                }
            }
            function getQuota (tab){
                switch(tab){
                    case 'imageAnnotations': return 'imageEditor';
                    case 'imageFinetune': return 'imageEditor';
                    case 'imageFilters': return 'imageEditor';
                    case 'storyboardArrows': return 'storyboardArrows';
                }
            }

            function onProcess(output) {
                //download file
                //downloadFile(imageState.dest);

                // Handle output image here
                console.log('changes have been made');
                editor.onclose = onclose;
                var file = output.dest, //output.blob ->current image
                    fileURL = createObjectURL(file);
                service.downloadImage(fileURL, function (meta) {
                    file = _.extend(file, meta);
                  //  service.revokeObjectURL(fileURL);
                    next(file);
                });

                function next(file) {
                    if (withPreprocess) {
                        preProcessEditedImage(file, process);
                    } else {
                        process(file);
                    }

                    function process(file) {
                        onsuccess(file);
                        destroy();
                    }
                }

                function onclose() {
                    //   handleEditorResponse(true);
                    editor.onclose = null;
                }

                function downloadFile(file) {
                    // Create a hidden link and set the URL using createObjectURL
                    const link = document.createElement('a');
                    link.style.display = 'none';
                    link.href = URL.createObjectURL(file);
                    link.download = file.name;

                    // We need to add the link to the DOM for "click()" to work
                    document.body.appendChild(link);
                    link.click();

                    // To make this work on Firefox we need to wait a short moment before clean up
                    LCS.timeout(() => {
                        URL.revokeObjectURL(link.href);
                        link.parentNode.removeChild(link);
                    }, 0);
                }
            }
        }
    }

    function destroy() {
        bind(false);
        if (editor) {
            //   editor.destroy();
        }
    }

    function getPanels(cls, isAll) {
        return document[isAll ? 'querySelectorAll' : 'querySelector']('.' + imgeditorname +
            ' .' + imgeditornameUppercase + 'TabPanels ' +
            ' .' + imgeditornameUppercase + 'TabPanel' + (cls || ''));
    }

    function bind(isBind) {
        var el = document.querySelector('.' + imgeditorname +' .' + imgeditornameUppercase + 'NavSet .' + imgeditornameUppercase + 'Button.' + imgeditornameUppercase + 'ButtonIconOnly');
        LCS.bindElementListeners(isBind, el, oncanceledit);

        if(!isBind) {
            _.each(getPanels('emptyState', true), function (el,) {
                LCS.bindElementListeners(isBind, el, onPanel);
            });
        }
    }

    function setBanner(el, isBind, quota, tab) {
        LCS[isBind ? 'addClass' : 'removeClass'](el, 'emptystate');
        var add = isBind ? 'setAttribute' : 'removeAttribute';
        if(el) {
            if (isBind) {
                el[add]('data-quota', quota);
                el[add]('data-tab', tab);
            } else {
                el[add]('data-quota');
                el[add]('data-tab');
            }
            LCS.bindElementListeners(isBind, el, onPanel);
        }
    }

    function onPanel(e){
        var panel = e.currentTarget,
            quota = panel.getAttribute('data-quota');
        if(quota) {
            CPS.loadQuotaPopup(quota, function (){
            }, null, null, {
                popupIndex: getPopupIndex(),
                onSubscriptionUpdated: onSubscriptionUpdated
            }, {
                e: e
            });
        }

        function onSubscriptionUpdated(result){
            console.log('onSubscriptionUpdated');
            _.each(['imageEditor', 'storyboardArrows'], function (quota) {
                if (CPS.hasQuotaType(quota)) {
                    var p = getPanels('[data-quota="' + quota + '"]', true);
                    if (p) {
                        _.each(p, function (panel) {
                            setBanner(panel, false);
                        });
                    }
                }
            });
        }

        function getPopupIndex() {
            if (!editor.parentZIndex) {
                editor.parentZIndex = 2147483647;
                try {
                    editor.parentZIndex = parseInt(window.getComputedStyle(document.querySelector('.' + imgeditorname)).zIndex, 10);
                } catch (e) {
                }
            }
            return editor.parentZIndex + 2;
        }
    }
    function oncanceledit() {
        //return _this.props.onclose(output);
        if (service.oncancel) {
            service.oncancel();
        }
        destroy();
    }

    function preProcessEditedImage(file, next) {
        if (!file) {return process();}
        console.log('preProcessEditedImage');
        next({
            file: file,
            props: {
                mimeType: file.type,
                size: file.size,
                lastModified: MomentService.utc(file.lastModifiedDate).toString()
            }
        });
    }


    function downloadImage(url, next) {
        var img = new Image(),
            result = {},
            meta = {};
        img.crossOrigin = 'Anonymous';
        img.onload = onload;
        img.src = url;

        function onload() {
            try {
                meta.width = img.width;
                meta.height = img.height;
                meta = _.extend(meta, getBrightness(this));
                result.metadata = meta;
            }catch (e){}
            cropEXIF.getData(img, function (res) {
                if (res) {
                    if (res.exifdata) {
                        result.exif = res.exifdata;
                    }
                    if (res.iptcdata) {
                        result.iptc = res.iptcdata;
                    }
                }
                next(result);
            });
        }

        function getBrightness(img) {
            if (!img) {
                return null;
            }
            // create canvas
            var colorSum = 0,
                canvas = document.createElement("canvas");
            canvas.width = img.width;
            canvas.height = img.height;

            var ctx = canvas.getContext("2d");
            ctx.drawImage(img, 0, 0);

            var imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
            var data = imageData.data;
            var r, g, b, avg;

            for (var x = 0, len = data.length; x < len; x += 4) {
                r = data[x];
                g = data[x + 1];
                b = data[x + 2];

                avg = Math.floor((r + g + b) / 3);
                colorSum += avg;
            }

            var brightness = Math.floor(colorSum / (img.width * img.height));
            return {
                brightness: brightness,
                isDark: brightness < 127.5
            };
        }
    }

    function createThumbnailForPDFPages(url, next, justFirst) {
        //create thumbnails from all pages and add them on a canvas
        pdfjsLib.getDocument(url).promise.then(function (doc) {
            var pages = [];
            while (pages.length < doc.numPages) pages.push(pages.length + 1);
            return Promise.all(pages.map(function (num) {
                // create a div for each page and build a small canvas for it
                var div = document.createElement("div");
                document.body.appendChild(div);
                return doc.getPage(num).then(makeThumb)
                    .then(function (canvas) {
                        div.appendChild(canvas);
                    });
            }));
        }).catch(function (err) {
            console.error(err);
        });

        function makeThumb(page) {
            var width = 600;
            // draw page to fit into widthxwidth canvas
            var vp = page.getViewport(1);
            var canvas = document.createElement("canvas");
            canvas.width = canvas.height = width;
            var scale = Math.min(canvas.width / vp.width, canvas.height / vp.height);
            return page.render({
                canvasContext: canvas.getContext("2d"),
                viewport: page.getViewport(scale)
            }).promise.then(function () {
                //convert canvas to jpg
                canvas.toBlob(function(blob) {
                    next(createObjectURL(blob));
                }, 'image/jpeg', 0.95); // JPEG at 95% quality
                //convert canvas to ico
                //canvas.toBlob(blobCallback('passThisString'), 'image/vnd.microsoft.icon',
                //               '-moz-parse-options:format=bmp;bpp=32');
            }).catch(function (err) {
                console.error(err);
                next(null);
            });
        }
    }
}

angular.module('components.imgResizedWrapped.init.controller', [
    'components.fileUploader.sbResizableImg.service',
    'services.rootEvents'
])
.service('ImgResizedWrappedInitCtrlService', ImgResizedWrappedInitCtrlService);
ImgResizedWrappedInitCtrlService.$inject = ['security', 'RootEventsService'];
function ImgResizedWrappedInitCtrlService(security, RootEventsService) {
    return function ($ctrl) {
       // console.log(' ImgResizedWrappedInitCtrl - onInit');
        if (!$ctrl.security) {
             console.log('parent for ImgResizedWrappedInitCtrlService must define $ctrl.security');
        }
        $ctrl.security = security;

        $ctrl.RootEventsService = RootEventsService;
        var withImgBg, avatarInitials, avatarClass, nameObs, img, width, logo, size, imgWrapper,existsTextWrapper,sbfWrapper2,sbfWrapper, startCheckSet, startSnitStaticParams,
            devicePixelRatio = window.devicePixelRatio || 1,
            previousFields = {},
            changedFields = ['item'],
            changedItemFields = [];
        $ctrl.preloaderClass = 'centered-preloader';
        $ctrl.reloadImage = reloadImage;
        $ctrl.resizedWrappedInit = resizedWrappedInit;
        $ctrl.onImgResizeChanges = onImgResizeChanges;
        $ctrl.getImage = getImage;
       // $ctrl.loadLaterS = false;
        $ctrl.loadLaterS = getBoolAttribute('loadLater');
        $ctrl.setPreloader = setPreloader;
        $ctrl.setMinHeight = setMinHeight;
        withImgBg = getBoolAttribute('withImgBg');

        return $ctrl;

        function onImgResizeChanges(changes) {
            if (!changes) {
                return;
            }
            //console.log('ImgResizedWrappedInitCtrl.$onChanges');
            //  console.log(changes);
            for (var i = 0, n = changedFields.length; i < n; i++) {
                var field = changedFields[i],
                    change = changes[field];
                if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                    //     console.log('ImgResizedWrappedInitCtrl: onImgResizeChanges');
                    switch (field) {
                        case 'item':
                            _.each(changedItemFields, process);

                            function process(itemField) {
                                var val = $ctrl.item[itemField];
                                if (!angular.equals(val, previousFields[itemField])) {
                                    switch (itemField) {
                                        case $ctrl.imgProp:
                                            console.log('logo changed');

                                            $ctrl.logoChanged = true;
                                            loadImageInfo(val);
                                            /* if ($ctrl.imgWatchS) {
                                                 loadImageInfo(val);
                                             }*/
                                            break;

                                        case 'name':
                                            console.log('name changed');
                                            //todo set new initials
                                            setInitials();
                                            if(existsTextWrapper) {
                                                existsTextWrapper.innerText = avatarInitials;
                                            }
                                            break;
                                    }
                                    previousFields[itemField] = angular.copy(val);
                                }
                            }
                            break;
                        case 'size':
                            console.log('size changed');
                            setSrc();
                            break;
                    }
                }
            }
        }

        function reloadImage(loadWrapper) {
            loadImageInfo(loadWrapper ? loadWrapper : getImgPropId());
        }

        function getImgPropId() {
            return $ctrl.item ? $ctrl.item[getImgPropIdName()] : null;
        }

        function getImgPropIdName() {
            //$ctrl.collectionProp === "materials"
            return $ctrl.security.getImgPropIdName($ctrl.imgProp);
        }

        function resizedWrappedInit(isDelayed) {
            initStaticParams();

            if ($ctrl.radius) {
                $ctrl.LCS.addClass($ctrl.thumbSm, $ctrl.radius);
                $ctrl.LCS.addClass($ctrl.imageContainer, $ctrl.radius);
            }

            if ($ctrl.imgSize) {
                $ctrl.isSmallImg = $ctrl.imgSize && $ctrl.imgSize.indexOf('small')!==-1;
                $ctrl.LCS.addClass($ctrl.thumbSm, $ctrl.imgSize);
            }
            if($ctrl.ratio){
                $ctrl.imgRatio = parseInt($ctrl.ratio);
            }
            $ctrl.setMinHeight($ctrl.element);
            loadImageInfo(true, isDelayed);

            initImgResizeCheck();
        }

        function initImgResizeCheck() {
            if(startCheckSet){return;}
            startCheckSet = true;
            changedItemFields.push($ctrl.imgProp);
            if (!$ctrl.cWithoutInitials && $ctrl.canChangeName) {
                changedItemFields.push('name');
            }
            if (!$ctrl.item) {
                return;
            }
            for (var i = 0, l = changedItemFields.length; i < l; i++) {
                var field = changedItemFields[i];
                previousFields[field] = $ctrl.item[field];
            }

            if (getBoolAttribute('variableSize')) {
                changedFields.push('size');
                addWidthWatcher();
            }
        }

        function initStaticParams() {
            if(startSnitStaticParams){return;} startSnitStaticParams = true;
            $ctrl.cWithoutInitials = $ctrl.withoutInitials === 'true' || $ctrl.withoutInitials === true;

            if (!$ctrl.imgSize) {
                $ctrl.imgSize = "medium";
            }

            if (!$ctrl.areaType) {
                $ctrl.areaType = 'circle';
            }
            $ctrl.radius = $ctrl.areaType === 'circle' ? 'with-radius' : ($ctrl.areaType === 'no-radius' ? '' : 'with-radius-square');
        }

        function loadImageInfo(loadWrapper, isDelayed) {
            logo = getImage();
            if (loadWrapper) {
                loadImageWrapper();
            }

            setSrc(true, isDelayed);
        }

        function loadImageWrapper() {
            //console.log( id +'  postImgResizedWrappedCtrl init: ' + logo);
            if(!$ctrl.thumbSm){return;}
            imgWrapper = $ctrl.thumbSm.querySelector('.imgwrap');
            existsTextWrapper = $ctrl.thumbSm.querySelector('.avatar');

            if ($ctrl.containerClass) {
                $ctrl.LCS.addClass($ctrl.fileUploader, $ctrl.containerClass);
            }

            setInitials();

            setThumb();

            setIcon();

            function setThumb() {
                if (logo) {
                    //add class for child thumb-sm {{::
                    //ng-class="(logo ? ' with-img': '')"
                    $ctrl.LCS.addClass($ctrl.thumbSm, 'with-img');
                    if (!imgWrapper) {
                        imgWrapper = document.createElement('div');
                        if (!withImgBg) {
                            setMinHeight(imgWrapper);
                        }
                        $ctrl.LCS.addClass(imgWrapper, 'imgwrap resized-wrapped' + (withImgBg ? ' withImgBg' : ''));
                        //+(avatarClass ? (' ' + avatarClass) : ''));
                        $ctrl.thumbSm.appendChild(imgWrapper);
                    }
//to do

                    /*  todo see if nec
                         if ($ctrl.imgSize === 'celllong' && typeof ($ctrl.onCelllongImageLoaded === 'function')) {
                          $ctrl.onCelllongImageLoaded();
                      }*/
                } else {
                    $ctrl.LCS.removeClass($ctrl.thumbSm, 'with-img');

                    if (imgWrapper) {
                        removeChild(imgWrapper);
                        imgWrapper = null;
                    }
                }
            }

            function setIcon() {
                if (logo) {
                    removeIcon(existsTextWrapper);
                    if (isLinearGradient(logo)) {
                        var imgwrap = $ctrl.thumbSm ? $ctrl.thumbSm.querySelector('.imgwrap') : null;
                        if(imgwrap) {
                            addIcon(imgwrap);
                        }
                    }
                } else {
                    removeIcon($ctrl.thumbSm);
                    addIconWrapper(existsTextWrapper);
                }

                function removeIcon(existsTextWrapper) {
                    if (existsTextWrapper) {
                        removeChild(existsTextWrapper);
                        existsTextWrapper = null;
                        if (nameObs !== undefined) {
                            $ctrl.disposeWatcher(nameObs);
                        }
                    }
                }

                function addIconWrapper(existsTextWrapper) {
                    if (!existsTextWrapper) {
                        existsTextWrapper = document.createElement('div');
                        $ctrl.LCS.addClass(existsTextWrapper, 'avatar');
                        addRoundBordersClass(existsTextWrapper);
                        $ctrl.thumbSm.appendChild(existsTextWrapper);
                    }

                    if (avatarClass) {
                        $ctrl.LCS.addClass(existsTextWrapper, avatarClass);
                    }

                    if ($ctrl.bgColor) {
                        $ctrl.LCS.setCSSStyle($ctrl.thumbSm, 'background-color', $ctrl.bgColor);
                    }

                    if (!$ctrl.cWithoutInitials) {
                        if (avatarInitials) {
                            existsTextWrapper.innerText = avatarInitials;
                        }
                    } else {
                        addIcon(existsTextWrapper);
                    }
                }

                function addIcon(existsTextWrapper) {
                    if ($ctrl.icon) {
                        var sbfWrapper = existsTextWrapper ? existsTextWrapper.querySelector('.sbf') : null;
                        if (sbfWrapper) {
                            existsTextWrapper.removeChild(sbfWrapper);
                            sbfWrapper = null;
                        }
                        $ctrl.LCS.appendChildFragment(existsTextWrapper, $ctrl.LCS.getISBDiv($ctrl.icon, $ctrl.iconLevel ? parseInt($ctrl.iconLevel, 10) : 3));
                        sbfWrapper = existsTextWrapper.querySelector('.sbf');
                        if ($ctrl.color) {
                            $ctrl.LCS.setCSSStyle(sbfWrapper, 'color', $ctrl.color);
                        }
                    }
                }
            }

            function removeChild(ch) {
                if (ch) {
                    try {
                         $ctrl.thumbSm.removeChild(ch);
                    } catch (e) {
                    }
                }
            }
        }

        function setInitials() {
            if (!$ctrl.item) {
                return;
            }
            var name = $ctrl.item.name;
            var temp = typeof ($ctrl.item.getInitials) === 'function' ? $ctrl.item.getInitials() : $ctrl.security.getInitialsByName(name);
            if (temp !== avatarInitials) {
                avatarInitials = temp;
                var color = ($ctrl.bgColor || $ctrl.withoutBgColor) ? '' :
                    (typeof ($ctrl.item.getNameColor) === 'function' ? $ctrl.item.getColorForInitials(avatarInitials) : $ctrl.security.getColorForInitials(avatarInitials));
                avatarClass = temp ? (color ? color : null) : null;
            }
        }

        function getImage() {
            return $ctrl.item && $ctrl.item[$ctrl.imgProp] ? $ctrl.item[$ctrl.imgProp] : ($ctrl.defaultImage);
        }

        function setPreloader() {
            if($ctrl.isPreloaderSet){return;}
            $ctrl.isPreloaderSet = true;
            //remove prev src
            if (withImgBg) {
                if (imgWrapper && imgWrapper.style && imgWrapper.style['background-image']) {
                    imgWrapper.style['background-image'] = '';
                }
            } else if(img){
                img.src = null;
            }
            //set preloader on top
            if (imgWrapper && !imgWrapper.querySelector('.' + $ctrl.preloaderClass)) {
                $ctrl.LCS.appendChildFragment(imgWrapper, '<div class="h-full table-div full-width ' + $ctrl.preloaderClass + '"><div class="centered"><div>' +
                    '<div class="loading-more loading_indicator relative fadeIn text-center"><div class="sbf loadingicon centering animate-spin '+(($ctrl.imgSize === 'small' || $ctrl.imgSize === 'small18' || $ctrl.imgSize === 'smaller' || $ctrl.imgSize === 'smaller') ? 'smaller' : ($ctrl.imgSize ? 'forimgs' : '')) +'"></div></div>' +
                    //'<div class="loadFacebookWrapper"><div id="loadFacebookG"><div id="blockG_1" class="facebook_blockG"></div><div id="blockG_2" class="facebook_blockG"></div><div id="blockG_3" class="facebook_blockG"></div></div></div>' +
                    '</div></div></div>');
            }
        }

        function setSize() {
            var t = $ctrl.size ? $ctrl.size : null;
            if (t !== size) {
                size = t;
                return true;
            }
            return false;
        }

        function setResizeWidth() {
            var w = getBlockWidth(), c = 100,
                t = devicePixelRatio * (w < c / 2 ? Math.ceil(c / 2) : (w < c ? c : Math.ceil(w / c) * c));
            //console.log(w);
            if (t !== width) {
                width = t;
                return true;
            }
            return false;
        }

        function getBlockWidth() {
            return $ctrl.thumbSm ? parseInt($ctrl.thumbSm.getBoundingClientRect()[withImgBg ? 'height' : 'width'], 10) : 0;
        }

        function getAttribute(name) {
            return $ctrl[name] !== undefined ? $ctrl[name] : null;
        }

        function getBoolAttribute(name) {
            var attr = getAttribute(name);
            return attr === true || attr === 'true';
        }

        function addRoundBordersClass(el) {
            var val = $ctrl.roundBorders === undefined || $ctrl.roundBorders !== undefined && ($ctrl.roundBorders !== 'false' && $ctrl.roundBorders !== false);
            if (val) {
                $ctrl.LCS.addClass(el, 'roundborder');
            }
        }

        function addWidthWatcher() {
            if (!$ctrl.widthWatcher) {
                $ctrl.widthWatcher = $ctrl.LCS.onWindowWidthChanged(setSrc);
                $ctrl.addRootWatcherSimple($ctrl.widthWatcher);
            }
        }

        function setSrc(isUrlChanged, isDelayed) {
            var res = getLogoUrl(isUrlChanged),
            url = res.url;
            if (!res.url) {
                return;
            }
            //$ctrl.element.nodeType !== $ctrl.element. DOCUMENT_FRAGMENT_NODE
            //classList = (el.nodeType === el.DOCUMENT_FRAGMENT_NODE ? el.children[0] : el).classList;
            var el = $ctrl.element && $ctrl.element.nodeType === $ctrl.element. DOCUMENT_FRAGMENT_NODE && $ctrl.element.children ? $ctrl.element.children[0] : $ctrl.element;
            $ctrl.LCS.addClass(el, 'has-img');

            if(res.isGradient){
                onImageLoaded(url);
            } else {
                $ctrl.isImageLoaded = false;
                if (isInViewport(isUrlChanged)) {
                    loadNewImg(url, onImageLoaded);
                }
            }

            function getLogoUrl(isUrlChanged) {
                var logo = $ctrl.item && $ctrl.item[$ctrl.imgProp] ? $ctrl.item[$ctrl.imgProp] : null;
                if(isLinearGradient(logo)){
                    return {url: logo, isGradient: true};
                } else {
                    var r = setResizeWidth(),
                        s = setSize();
                    return {url: (r || s || isUrlChanged) ? $ctrl.security.getLogoPath($ctrl.item, $ctrl.imgProp, width ? width : 570, withImgBg, $ctrl.defaultImage) : null};
                }
            }

            function loadNewImg(src, onsuccess) {
                if( $ctrl.isLoading){return;}
                $ctrl.isLoading = true;
                setPreloader();
                try {
                    $ctrl.security.getSecureResizedImage(src, onSuccess, onError);
                } catch (e) {
                    console.log(e);
                }

                function onSuccess(result) {
                    //console.log('loadNewImg');
                    final(src);
                }

                function onError(err) {
                    //console.log(err);
                    final(null);
                }

                function final(src) {
                    removePreloader();
                    $ctrl.isLoading = false;
                    $ctrl.isImageLoaded = true;
                    onsuccess(src);
                }

                function removePreloader() {
                    $ctrl.LCS.removeElementChild(imgWrapper, '.' + $ctrl.preloaderClass);
                }
            }

            function onImageLoaded(exists) {
                if(!exists){return;}

                process();
                /*if(isDelayed){
                    $ctrl.LCS.timeout(process, 10);
                }else{
                    process();
                }*/
                function process() {
                    if (isDelayed) {
                        imgWrapper = document.querySelector('div[data-id="' + $ctrl.componentId + '"] .imgwrap');
                    }
                    if(imgWrapper) {
                        if (withImgBg) {
                            if (!imgWrapper.style) {
                                imgWrapper.style = {};
                            }
                                                                        //gradient
                            imgWrapper.style['background-image'] =  isLinearGradient(url) ? url : ('url(' + url + ')');
                        } else {
                            img = imgWrapper && imgWrapper.children && imgWrapper.children.length > 0 ? imgWrapper.children[0] : null;
                            if ($ctrl.LCS.hasClass(img, 'centered-preloader')) {
                                $ctrl.LCS.emptyElement(imgWrapper);
                                img = null;
                            }

                            if (!img) {
                                img = document.createElement('img');
                                $ctrl.LCS.addClass(img, 'featured-image');
                                addRoundBordersClass(img);
                                imgWrapper.appendChild(img);
                            }
                            img.src = url;
                            img.onload = onImgLoad;

                            function onImgLoad() {
                                //console.log('onImgLoad');
                                var r = img.width / img.height,
                                    isDif = !$ctrl.item[$ctrl.imgProp + 'Ratio'] ;
                                        //|| $ctrl.logoChanged; //for future should be correctly set
                                if (isDif) {
                                    $ctrl.item[$ctrl.imgProp + 'Ratio'] = r;
                                }

                                setMinHeight($ctrl.element, true);
                                setMinHeight(imgWrapper, true);

                                $ctrl.RootEventsService.broadcastRoot('IMAGE_LOADED_' + $ctrl.parentComponentId, {
                                    parentComponentId: $ctrl.parentComponentId,
                                    componentId: $ctrl.componentId,
                                    updates: isDif ? {
                                        prop: $ctrl.imgProp,
                                        ratio: r
                                    } : null
                                }); //gridevent

                                $ctrl.logoChanged = false;
                            }
                        }
                    }
                    /*else {
                        console.error('imgWrapper is not set yet');
                    }*/
                }
            }
        }
        function isLinearGradient(url){
            return url && url.indexOf('-gradient') !== -1;
        }

        function isInViewport(isUrlChanged) {
            return true;
            //todo
            return $ctrl.imgObserverService ? $ctrl.imgObserverService.checkIfViewport($ctrl.loadLaterS, isUrlChanged, {
                id: $ctrl.componentId,
                el: $ctrl.element,
                ev: setSrc
            }) : true;
        }

        function setMinHeight(el, isReset){
            if(!el){return;}
            var prop = 'height';
            if(isReset){
                if(el.style) {
                    el.style.removeProperty(prop);
                }
            } else if($ctrl.element.offsetWidth){
                var r = $ctrl.item ? $ctrl.item[$ctrl.imgProp + 'Ratio'] : null;
                if (r) {
                    $ctrl.minHeight = ($ctrl.element.offsetWidth / r) + 'px';
                    if (!el.style) {
                        el.style = {};
                    }
                    if(typeof(el.style.setProperty) === 'function'){
                        el.style.setProperty(prop, $ctrl.minHeight, 'important');
                    }
                }
            }
        }
    }
}

angular.module('components.fileUploader', [
    'components.fileUploader.sbResizableImg.component',
    'components.fileUploader.uploader.uploadFilesBtn.component'
]);

angular.module('components.fileUploader.sbResizableImg.service', [
    'components.imgResizedWrapped.init.controller'
])//sb-resizable-img
.service('ImageUploaderService', ImageUploaderService);

ImageUploaderService.$inject =['ImgResizedWrappedInitCtrlService', 'LCS'];

function ImageUploaderService(ImgResizedWrappedInitCtrlService, LCS) {
    var $ctrl = this;
    $ctrl.LCS = LCS;
    $ctrl.thumbSmClass = 'thumb-sm';
    $ctrl.imageContainerClass = 'image-container';
    $ctrl.fileUploaderClass = 'file-uploader';
    $ctrl.imgSideMenuClass = 'img-sidemenu';

    $ctrl = new ImgResizedWrappedInitCtrlService($ctrl);

    $ctrl.generateDisplayImage = generateDisplayImage;

    function generateDisplayImage(item, c) {
        reset();
        $ctrl.item = item;
        $ctrl = _.extend($ctrl, c);
        $ctrl.loadLater = false;

        $ctrl.element = $ctrl.LCS.createFragment(getItemTemplate());
        $ctrl.componentId = new ObjectId().toString();
        $ctrl.setMinHeight($ctrl.element);

        $ctrl.element.firstChild.setAttribute('data-id', $ctrl.componentId);//for lazy loading

        onItemLoaded(true);

        $ctrl.LCS.timeout(function () {})
        return $ctrl.element.firstChild.outerHTML;
    }

    function reset() {
        $ctrl.imgWatch = undefined;
        $ctrl.noOverlay = undefined;
        $ctrl.icon = undefined;
        $ctrl.imgSize = undefined;
        $ctrl.areaType = undefined;
        $ctrl.roundBorders = undefined;
        $ctrl.withImgBg = undefined;
        $ctrl.variableSize = undefined;
        $ctrl.ratio = undefined;
        $ctrl.containerClass = undefined;

        $ctrl.defaultImage = undefined;
        $ctrl.withoutInitials = undefined;

        $ctrl.withoutBgColor = undefined;
        $ctrl.bgColor = undefined;
        $ctrl.canChangeName = undefined;
        $ctrl.itemIdProp = undefined;
        $ctrl.cClassAttr = undefined;

        $ctrl.imgProp = undefined; // the name of the image prop that will be updated

        //image upload props
        $ctrl.canUploadAttr = undefined;
        $ctrl.isAvatarAttr = undefined;
        $ctrl.isPosterAttr = undefined;
        $ctrl.collectionProp = undefined;
        $ctrl.isMaterial = undefined;
        $ctrl.showLabel = undefined;

        $ctrl.defaultText = undefined;
        $ctrl.btnText = undefined;
        $ctrl.btnTooltip = undefined;
        $ctrl.btnLabel = undefined;
        $ctrl.codeName = undefined;

        //variables
        $ctrl.item = undefined; // the item for which the image prop will be updated
        $ctrl.size = undefined; //image size for avatar
        $ctrl.imgObserverService = null;
    }

    function getItemTemplate() {
        //console.log('getItemTemplate');
        var showLabel = $ctrl.showLabel ==='true' || $ctrl.showLabel ===true;
        return $ctrl.templateUrl !== 'image-uploader-with-button' ? ('<div class="' + $ctrl.fileUploaderClass + '">' +
                '<div class="' + $ctrl.thumbSmClass + '"></div>' +
                (($ctrl.noOverlay==='true' || $ctrl.noOverlay===true || !$ctrl.canUpload )? '' : ('<div class="'+$ctrl.imageContainerClass+' overlay black centering"></div>')) +
                (showLabel &&$ctrl.defaultText ? ('<label><span class="with-cursor">'+$ctrl.defaultText+'</span> <span class="italic with-parenthesis">optional</span></label>'):'') +
            '</div>') : (
//  templateUrl = 'image-uploader';
// or image-uploader-with-button image-uploader-button -> for shot-slideshow}
            '<div class="' + $ctrl.fileUploaderClass + ' files custombtnsmall">' +
                    '<label class="input-file with-primary-hover">' +
                    //'<input name="file" id="file" multiple="false" type="file" accept="image/*" onclick="this.value=null"/>' +
                    '<span class="sbf upload-img white" ' + ($ctrl.defaultText ? (' tooltip-placement="top" tooltip="' + $ctrl.defaultText + '"') : '') + '></span>' +
                '</label>' +
            '</div>');
    }

    function onItemLoaded(isDelayed) {
        $ctrl.fileUploader = $ctrl.element.querySelector('.' + $ctrl.fileUploaderClass);
        $ctrl.thumbSm = $ctrl.element.querySelector('.' + $ctrl.thumbSmClass);

        var cls = ($ctrl.imgSize ? $ctrl.imgSize : '') + ' ' + ($ctrl.cClassAttr ? $ctrl.cClassAttr : '');
        cls = cls.trim();
        if (cls !== '') {
            $ctrl.LCS.addClass($ctrl.fileUploader, cls);
        }
        $ctrl.imageContainer = $ctrl.element.querySelector('.' + $ctrl.imageContainerClass);
        if ($ctrl.radius) {
            $ctrl.LCS.addClass($ctrl.imageContainer, $ctrl.radius);
        }

        if ($ctrl.imgSize === 'celllong') {
            var div = document.createElement('div');
            $ctrl.LCS.addClass(div, 'sbf add-img');
        }

        $ctrl.resizedWrappedInit(isDelayed);
    }

    function onCelllongImageLoaded() {
        var img = $ctrl.$element.find('img');
        if (img) {
            img.bind('load', onimgloaded);
            //todo: add unbind
        }
        function onimgloaded() {
            var h = img.height();
            $ctrl.$element.height(h);
            $ctrl.thumbSm.height = h;
            $ctrl.imageContainer.height = h;
            //  $element.find('.image-container label').css('line-height',h+'px');
        }
    }
}

angular.module('components.fileUploader.mediaLibrary.plugins.service', [
])
.service('SBMediaLibraryPluginService', SBMediaLibraryPluginService);
SBMediaLibraryPluginService.$inject =['API_CONFIGS'];
function SBMediaLibraryPluginService (API_CONFIGS) {
    return function (uploaderService, options, sbUploader) {
        if (!options) {
            options = {};
        }
        var Plugins = {},
            dashboardPluginOptions,
            companionOptions = {
                companionUrl: options.companionUrl,
                serverHeaders: options.serverHeaders,
            },
            progressBarClassName = 'UploaderProgress',
            progressBarElement = getProgressBarElement();

        loadPlugins();

        return {
            Plugins: Plugins,
            progressBarElement: progressBarElement
        };

        function loadPlugins() {
            addAwsS3Multipart();
            addDashboardPlugin();
//we wanna save the full img
           // addImageCompressor();

            addplugin('SBCustomLibrary');
            //addplugin('SBMovieStills');
            //addplugin('Dropbox');
            //addplugin('GoogleDrive');
            //addplugin('GoogleImages', {thumbnailWidth: 150, defaultThumbnailDimension: 150, configs:  API_CONFIGS().googleImages,});
            //addplugin('Instagram');
            addWebcamPlugin();
           // addUrlPlugin();

            addStatusBar();
        }

        function getProgressBarElement() {
            var progressBarElement = document.body.querySelector('.' + progressBarClassName);
            if(!progressBarElement) {
                progressBarElement = document.createElement('div');
                progressBarElement.classList.add(progressBarClassName);
                document.body.appendChild(progressBarElement);
            }
            return progressBarElement;
        }
        function addStatusBar() {
            Plugins.StatusBar = sbUploader.StatusBar;
            uploaderService.use(Plugins.StatusBar, {
                target: progressBarElement,
                hideUploadButton: true,
                hideAfterFinish: false
            });
        }

        function addAwsS3Multipart() {
            Plugins.AwsS3Multipart = sbUploader.AwsS3Multipart;
            uploaderService.use(Plugins.AwsS3Multipart, _.extend({
                limit: options.AwsLimit || 5,
            }, companionOptions));
        }

        function addDashboardPlugin() {
            Plugins.Dashboard = sbUploader.Dashboard;
            uploaderService.use(Plugins.Dashboard, {
                id: 'Dashboard',
                //Dashboard is rendered into body, because it is hidden by default and only opened as a modal when trigger is clicked.
                target: options.dashboardTarget,
                note: null,//'Max file size is 10 MB. To upload larger files, <a href="">upgrade plan></a>.',
                onRequestCloseModal: options.onCloseModal,
            });
            setDashboardOptions();

            function setDashboardOptions() {
                dashboardPluginOptions = _.extend({
                    target: Plugins.Dashboard,
                    viewType: 'grid'
                }, companionOptions);
            }
        }

        function addplugin(type, options) {
            Plugins[type] = sbUploader[type];
            uploaderService.use(Plugins[type], _.extend({}, dashboardPluginOptions, options));
        }
        function addWebcamPlugin() {

            Plugins.Webcam = sbUploader.Webcam;
            uploaderService.use(Plugins.Webcam, {
                target: Plugins.Dashboard,
                //A hook function to call before a snapshot is taken. The Webcam plugin will wait for the returned Promise to resolve before taking the snapshot. This can be used to implement variations on the countdown option for example.
                //onBeforeSnapshot: function() {Promise.resolve();},
                //countdown: 3
            });
        }

        function addUrlPlugin() {
            Plugins.Url = sbUploader.Url;
            uploaderService.use(Plugins.Url, dashboardPluginOptions);
        }

        function addImageCompressor() {
            Plugins.ImageCompressor = sbUploader.ImageCompressor;
            // Options from Compressor.js https://github.com/fengyuanchen/compressorjs#options, just don’t set `success` or `error`
            var params = {
                quality: 0.6 //default: 0.8 .The quality of the output image. It must be a number between 0 and 1. Be careful to use 1 as it may make the size of the output image become larger. Check out canvas.toBlob for more detail.
            };
            //The width of the output image. If not specified, the natural width of the original image will be used, or if the height option is set, the width will be computed automatically by the natural aspect ratio
            if (options.width) {
                params.width = options.width;
            }
            //The height of the output image. If not specified, the natural height of the original image will be used, or if the width option is set, the height will be computed automatically by the natural aspect ratio.
            if (options.height) {
                params.height = options.height;
            }
            //The max width of the output image. The value should be greater than 0.
            if (options.maxWidth) {
                params.maxWidth = options.maxWidth;
            }
            //The max height of the output image. The value should be greater than 0
            if (options.maxHeight) {
                params.maxHeight = options.maxHeight;
            }
            //The min width of the output image. The value should be greater than 0 and should not be greater than the maxWidth
            if (options.minWidth) {
                params.minWidth = options.minWidth;
            }
            //The min height of the output image. The value should be greater than 0 and should not be greater than the maxHeight
            if (options.minHeight) {
                params.minHeight = options.minHeight;
            }
            //The mime type of the output image. By default, the original mime type of the source image file will be used.
            if (options.mimeType) {
                params.mimeType = options.mimeType;
            }
            //default 5mb     //PNG files over this value will be converted to JPEGs. To disable this, just set the value to Infinity
            if (options.convertSize) {
                params.convertSize = options.convertSize;
            }

            if (options.watermark) {
                params.drew = addWatermark;
            }

            uploaderService.use(Plugins.ImageCompressor, params);

            //The hook function to execute before draw the image into the canvas for compression.
            //params.beforeDraw = beforeDraw;
            function beforeDraw(context, canvas) {
                context.fillStyle = '#fff';
                context.fillRect(0, 0, canvas.width, canvas.height);
                context.filter = 'grayscale(100%)';
            }

            //The hook function to execute after drew the image into the canvas for compression.
            function addWatermark(context, canvas) {
                context.fillStyle = '#fff';
                context.font = '2rem serif';
                context.fillText(options.watermark, 20, canvas.height - 20);
            }
        }
    }
}

angular.module('components.fileUploader.mediaLibrary.service', [
    'components.sbUploader.service',
    'components.fileUploader.mediaLibrary.plugins.service'
])
.service('SBMediaLibraryService', SBMediaLibraryService);
SBMediaLibraryService.$inject = ['SBMediaLibraryPluginService', 'SBUploaderService', 'LCS'];
function SBMediaLibraryService(SBMediaLibraryPluginService, SBUploaderService, LCS) {
    return function (id, options) {
        if (!options) {
            options = {};
        }

        var configs = LCS.API_CONFIGS,
            sbdebug = configs.debugger,
            sbUploader = SBUploaderService.get();

        options.companionUrl = configs.uploaderServiceCompanion.url;
        if(options.editedFile){
            options.isAlreadyEdited = true;
        }

        var uploaderService = createSBUploader({
            id: id,
            awsUploadPath: options.awsUploadPath,
            ImgEditorService: options.ImgEditorService,
            isAllProjectsSearch: options.isAllProjectsSearch,
            detectFileType: options.detectFileType,
            autoProceed: options.autoproceed === true,
            allowMultipleUploads: options.maxNumberOfFiles === 1 ? false : options.multipleFiles,
            debug: sbdebug && sbdebug.enabled,
            editorOptions: options.editorOptions,
            restrictions: {
                maxFileSize: options.maxFileSize || null,
                maxNumberOfFiles: options.maxNumberOfFiles ? options.maxNumberOfFiles : (options.multipleFiles ? null : 1),
                minNumberOfFiles: null,
                allowedFileTypes: options.imagesOnly ? ['image/*', '.heic', '.heif'] : (options.fileType || null)
            },
            locale: getLocale(),
            canEdit: options.canEdit,
            isAlreadyEdited: options.isAlreadyEdited,
            startOrder: options.startOrder,
            remainingSize: options.remainingSize,
            imagesOnly: options.imagesOnly,
            onBeforeFilesUploaded: options.onBeforeFilesUploaded,
            getCustomLibraryList: options.getCustomLibraryList,
            setCustomLibraryMeta: options.setCustomLibraryMeta,
            setMovieStillsMeta: options.setMovieStillsMeta,
            customLibraryPageSize: configs.customLibraryPageSize || 24,
            getMovieStillsList: options.getMovieStillsList,
            viewMaterialPopup: options.viewMaterialPopup,
            userProjects: options.userProjects,
            folderTypes: options.folderTypes
            //, store: sbUploader.DefaultStore(),
            //  logger: sbUploader.justErrorsLogger,
        });
        var library = new SBMediaLibraryPluginService(uploaderService, options, sbUploader);

        addEvents();

        return {
            Plugins: library.Plugins,
            uploadEditedFile: uploadEditedFile,
            onDestroy: onDestroy,
        };

        function uploadEditedFile() {
            var editedFile = options.editedFile;
            if (editedFile && editedFile.file) {
                addLocalFiles([editedFile.file]);
            }
        }

        function addEvents() {
            onFileAdded();
            onFileUploadComplete();
            onUploadsComplete();
        }

        function onDestroy() {
            if(options.editedFile){
                options.editedFile = null;
                options.isAlreadyEdited = false;
            }
            if(library&&library.progressBarElement&&library.progressBarElement.parentNode) {
                library.progressBarElement.parentNode.removeChild(library.progressBarElement);
            }
        }
        function createSBUploader(options) {
            return sbUploader.Core(options);
        }

        function getLocale() {
            return {
                strings: {
                    youCanOnlyUploadX: {
                        0: 'You can only upload ' + options.maxFileSize + ' file',
                        1: 'You can only upload ' + options.maxFileSize + ' files'
                    },
                    youHaveToAtLeastSelectX: {
                        0: 'You have to select at least %{smart_count} file',
                        1: 'You have to select at least %{smart_count} files'
                    },
                    exceedsSize: 'This file exceeds maximum allowed size of',
                    youCanOnlyUploadFileTypes: options.txtFileType ? 'You can only upload ' + options.txtFileType : ''
                }
            };
        }

        function addLocalFiles(files) {
            console.log('addLocalFiles');
            if(files && files.length>0){
                uploaderService.addLocalFiles(files);
            }
        }

        function removeFile(fileId) {
            uploaderService.removeFile(fileId)
        }

        function getFile(fileId) {
            return uploaderService.getFile(fileId);
            /*
            var file = uploaderService.getFile('uploaderServiceteamkongjpg1501851828779')

    file.id        // 'uploaderServiceteamkongjpg1501851828779'
    file.name      // 'nature.jpg'
    file.extension // '.jpg'
    file.type      // 'image/jpeg'
    file.data      // the Blob object
    file.size      // 3947642 (returns 'N/A' if size cannot be determined)
    file.preview   // value that can be used to populate "src" attribute of an "img" tag
            * */
        }

        function getFiles() {
            return '';
            /*var items = uploaderService.getFiles().map(function (file) {
                return '<li>' + file.name + ' - ' +
                    //getFileSizeText(file.size) +
                    '</li>';
            }).join('');
            //    document.querySelector('.file-list').innerHTML =
            return '<ul>' + items + '</ul>';
            */
        }

        //Start uploading selected files
        function startUpload(fileId) {
            uploaderService.upload().then(function (result) {
                console.info('Successful uploads:', result.successful)

                if (result.failed.length > 0) {
                    console.error('Errors:')
                    _.each(result.failed, function (file) {
                        console.error(file.error)
                    })
                }
            });
        }

        function cancelAllUploads() {
            uploaderService.cancelAll()
        }

        function resetProgress() {
            uploaderService.resetProgress()
        }

        //Fired each time a file is added
        function onFileAdded(next) {
            uploaderService.on('file-added', function (file) {
                console.log('Added file', file);
                if (!file.isRemote && file.type.includes('video')) {
                    var thumbnailCount = 1,
                        thumbnails = new VideoThumbnails({
                        count: thumbnailCount,
                        maxWidth: 400,
                        maxHeight: 400
                    });
                    //Captured a thumb
                    thumbnails.on('capture', function (image) {
                        var videoId = file.id.split('/').slice(-1).pop();
                        $('li[id*="' + videoId + '"]')
                            .find('.sbup-DashboardItem-previewInnerWrap')
                            .html('<img class="sbup-DashboardItem-previewImg" src="' + image + '"/>');
                    });
                    thumbnails.capture(file.data);
                }
                if (next) {
                    next(file);
                }
            });
        }

        //Fired each time a file is removed
        function onFileRemoved(next) {
            uploaderService.on('file-removed', function (file) {
                console.log('Removed file', file);
                next(file);
            });
        }

        //Fired when upload starts
        function onFileUploadStarted(next) {
            uploaderService.on('upload', function (data) {
                // data object consists of `id` with upload ID and `fileIDs` array
                // with file IDs in current upload
                // data: { id, fileIDs }
                console.log('upload-started ' + data.id + ' for files ' + data.fileIDs);
                next(data);
            });
        }

        //Fired each time file upload progress is available
        function onFileUploadProgress(next) {
            uploaderService.on('upload-progress', function (file, progress) {
                // file: { id, name, type, ... }
                // progress: { uploader, bytesUploaded, bytesTotal }
                console.log('upload-progress ' + file.id + ',' + progress.bytesUploaded + ',' + progress.bytesTotal);
                next(file, progress);
            });
        }

        //Fired each time a single upload is successful
        function onFileUploadComplete() {
            uploaderService.on('upload-success', onUploadSuccess);

            function onUploadSuccess(file, response) {
                //response={uploadURL, fileIdsInQueueOrder}
                console.log('SBMediaLibraryService: upload-success for file:' + file.id);
                // response can be for @uploaderService/xhr-upload
                //   status, // HTTP status code (0, 200, 300)
                //   body, // response body
                //   uploadURL // the file url, if it was returned
                //  file.meta['key'] // the S3 object key of the uploaded file
                var f = angular.copy(file);
                if (f.meta) {
                    delete f.meta.size;
                    delete f.meta.mimeType;
                    delete f.meta.name;
                    delete f.meta.relativePath;
                    delete f.meta.id;
                    delete f.meta.path;
                    delete f.meta.exifdata;
                }
                var sbCustomLibrary = response && response.uploadURL ? response.uploadURL.sbCustomLibrary : null;
                if (sbCustomLibrary) {
                    if (!options.multipleFiles) {
                        sbCustomLibrary.isFolder = false;
                    }
                    f.sbCustomLibrary = sbCustomLibrary;
                }

                response.type = 'SBCustomLibrary';
                options.onFileUploadComplete(response, f);
            }
        }
        //Fired when all uploads are complete
        function onUploadsComplete() {
            uploaderService.on('complete', function (result) {
                //  The result parameter is an object with arrays of successful and failed files, just like in uploaderService.upload()’s return value.
                console.log('successful files:' + result.successful);
                console.log('failed files:' + result.failed);
                options.onUploadsComplete(result);
            });
        }

        //Fired each time a single upload has errored
        function onFileUploadError(next) {
            uploaderService.on('upload-error', function (file, error, response) {
                console.log('upload-error for file:' + file.id);
                // response can be for @uploaderService/xhr-upload
                //   status, // HTTP status code (0, 200, 300)
                //   body // response body
                console.log('upload-error for file:' + file.id);
                console.log(error);
                next(file, error, response);
            });
        }

        //Fired when all uploads are complete
        function onUploadError(next) {
            uploaderService.on('error', function (result) {
                //Fired when SBUploaderService fails to upload/encode the entire upload. That error is then set to uploaderService.getState().error
                next(uploaderService.getState().error);
            });
        }

        //Fired when an upload has been retried (after an error, for example):
        function onUploadRetry(fileId, next) {
            uploaderService.on('upload-retry', function (fileId) {
                console.log('upload retried:' + fileId);
                next(fileId);
            });
        }

        //Fired when “info” message should be visible in the UI. By default, Informer plugin is displaying these messages (enabled by default in Dashboard plugin). You can use this event to show messages in your custom UI:
        function onInfoVisible(next) {
            uploaderService.on('info-visible', function () {
                // info: {
                //  isHidden: false,
                //  type: 'error',
                //  message: 'Failed to upload',
                //  details: 'Error description'
                // }
                next(uploaderService.getState().info);
            })
        }

        //Fired when “info” message should be hidden in the UI. See info-visible.
        function onInfoHidden(next) {
            uploaderService.on('info-hidden', function () {
                // info: {
                //  isHidden: false,
                //  type: 'error',
                //  message: 'Failed to upload',
                //  details: 'Error description'
                // }
                next(uploaderService.getState().info);
            })
        }

        //Fired when uploaderService.cancelAll() is called, all uploads are canceled, files removed and progress is reset.
        function onCancelAll(next) {
            uploaderService.on('cancel-all', function () {
                // info: {
                //  isHidden: false,
                //  type: 'error',
                //  message: 'Failed to upload',
                //  details: 'Error description'
                // }
                next(uploaderService.getState().info);
            })
        }

        //Fired when a file violates certain restrictions when added. This event is just providing another choice for those who want to customize the behavior of file upload restrictions.
        function onRestrictionFailed(file, next) {
            uploaderService.on('restriction-failed', function (file, error) {
                console.log('restriction-failed:' + file.id);
                next(file, error);
            })
        }

        //Fired when uploaderService.resetProgress() is called, each file has its upload progress reset to zero.
        function onResetProgress(next) {
            uploaderService.on('reset-progress', function () {

                next(uploaderService.getState().info);
            })
        }
        /**
         * Find all img elements with data-pdf-thumbnail-file attribute,
         * then load pdf file given in the attribute,
         * then use pdf.js to draw the first page on a canvas,
         * then convert it to base64,
         * then set it as the img src.
         */
        function createPDFThumbnails() {
            if (
                LCS.$document[0].readyState === 'complete' ||
                (LCS.$document[0].readyState !== 'loading' && !LCS.$document[0].documentElement.doScroll)
            ) {
                createPDFThumbnails();
            } else {
                LCS.bindElementListeners(true, LCS.$document[0], onCreatePDFThumbnails,'DOMContentLoaded');
            }

            function onCreatePDFThumbnails() {
                if (typeof pdfjsLib === 'undefined') {
                    throw Error("pdf.js is not loaded. Please include it before pdfThumbnails.js.");
                }
                pdfjsLib.disableWorker = true;

                // select all img elements with data-pdf-thumbnail-file attribute
                var nodesArray = Array.prototype.slice.call(document.querySelectorAll('img[data-pdf-thumbnail-file]'));

                nodesArray.forEach(function (element) {
                    var filePath = element.getAttribute('data-pdf-thumbnail-file');
                    var imgWidth = element.getAttribute('data-pdf-thumbnail-width');
                    var imgHeight = element.getAttribute('data-pdf-thumbnail-height');

                    pdfjsLib.getDocument(filePath).then(function (pdf) {
                        pdf.getPage(1).then(function (page) {
                            var canvas = document.createElement("canvas");
                            var viewport = page.getViewport(1.0);
                            var context = canvas.getContext('2d');

                            if (imgWidth) {
                                viewport = page.getViewport(imgWidth / viewport.width);
                            } else if (imgHeight) {
                                viewport = page.getViewport(imgHeight / viewport.height);
                            }

                            canvas.height = viewport.height;
                            canvas.width = viewport.width;

                            page.render({
                                canvasContext: context,
                                viewport: viewport
                            }).then(function () {
                                element.src = canvas.toDataURL();
                            });
                        }).catch(function () {
                            console.log("pdfThumbnails error: could not open page 1 of document " + filePath + ". Not a pdf ?");
                        });
                    }).catch(function () {
                        console.log("pdfThumbnails error: could not find or open document " + filePath + ". Not a pdf ?");
                    });
                });
            }
        }
    }
}

angular.module('components.sbUploader.service', [
])
.service('SBUploaderService', SBUploaderService);
SBUploaderService.$inject = ['$window'];
function SBUploaderService($window) {
