 */angular.module('auth.popup.component', [
])
.component('authPopup', popupComponentParams('AuthPopupCtrl'))
.controller('AuthPopupCtrl', AuthPopupCtrl);
AuthPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', '$element'];
function AuthPopupCtrl(ItemTemplateCompileCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;
    $ctrl.hasPopup = true;

    $ctrl.preInitOther = preInitOther;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitOther() {
        $ctrl.redirectUrl = $ctrl.extraParam ? $ctrl.extraParam.redirectUrl : null;
    }

    function getPopupBodyContent() {
        return $ctrl.nonMobileCloseBtn() +
            '<auth redirect-url="::$ctrl.redirectUrl" has-popup="::$ctrl.hasPopup" modal-type="::$ctrl.item" show-header="::$ctrl.objectType" on-close="$ctrl.onClose(result)"></auth>';
    }
}

angular.module('auth.component', [
    'auth.controller.service'
])
.component('auth', {
    bindings: {
        redirectUrl: '<',
        hasPopup: '<?',
        showHeader: '<?',
        modalType: '<?',
        user: '<?',
        titles: '<?',
        onClose: '&'
    },
    controller: 'AuthCtrl'
})
.controller('AuthCtrl', AuthCtrl);
AuthCtrl.$inject = ['AuthCtrlService', '$element'];
function AuthCtrl(AuthCtrlService, $element) {
    var $ctrl = this;
    $ctrl = new AuthCtrlService($ctrl, $element);
}


angular.module('auth.controller.service', [
    'components.validateEquals',
    'components.passwordStrength',
    'chat.service',
    'angularytics.provider'
])
.service('AuthCtrlService', AuthCtrlService);
AuthCtrlService.$inject = ['ListItemTemplateFormCtrlService', 'ChatService', 'Angularytics'];
function AuthCtrlService(ListItemTemplateFormCtrlService, ChatService, Angularytics) {
    return function ($ctrl, $element) {
        $ctrl.ChatService = ChatService;
        $ctrl.Angularytics = Angularytics;
        $ctrl.minLength = 13;

        $ctrl.dontAutoloadTemplate = false;

        $ctrl.logout = logout;
        // Show the modal   dialog
        $ctrl.clearForm = clearForm;
        $ctrl.reset = reset;
        $ctrl.validateEmail = validateEmail;
        $ctrl.onUnmask = onUnmask;
        $ctrl.checkPassword = checkPassword;
        $ctrl.onPasswordFocus = onPasswordFocus;

        $ctrl.saveLogin = saveLogin;
        $ctrl.onsuccess = onsuccess;
        $ctrl.onerror = onerror;
        $ctrl.onsuccesslogin = onsuccesslogin;
        $ctrl.hasError = hasError;
        $ctrl.isValid = isValid;

        $ctrl.getItemPopupTemplate = getItemPopupTemplate;

        $ctrl.preInitOther = preInitOther;
        $ctrl.onLoaded = onLoaded;
        //$ctrl.postInitOther = postInitOther;
        $ctrl.loadForm = loadForm;
        //$ctrl.setTemplateData = setTemplateData;

        $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

        return $ctrl;

        function preInitOther() {
            if ($ctrl.showHeader === null || $ctrl.showHeader === undefined) {
                $ctrl.showHeader = true;
            }

            // The model for this form
            if (!$ctrl.user) {
                $ctrl.user = {};
            }
            if (!$ctrl.titles) {
                $ctrl.titles = {
                    t1: "Sign in",
                    t2: "Get Started Free",
                    sub2: "All-in-one solution from</br> development through production",
                    t3: "Reset Password",
                    btn1: 'Sign In',
                    btn2: 'Sign Up',
                    logo: 'circled-user',

                    t4: "Change Password",
                    t7: "Password Changed",
                };
            }
            $ctrl.allforms = $ctrl.security.Popups;
            if(!$ctrl.whichForm) {
                $ctrl.whichForm = $ctrl.modalType ? $ctrl.modalType : $ctrl.allforms.Login;
            }
        }

        function isValid() {
            return !$ctrl.isUpdating;
        }

        function onUnmask(e) {
           // console.log('onUnmask');
            $ctrl.preventDefault(e);
            var el = getPasswordEl(e),
                isHidden = el.getAttribute('type') === 'password';
            el.setAttribute('type', isHidden ? 'text' : 'password');
            $ctrl.LCS.replaceClass(e.currentTarget.querySelector('.sbf'), isHidden ? 'eye' : 'eye-hidden', isHidden ? 'eye-hidden' : 'eye');
        }

        function checkPassword(e) {
           // console.log('checkPassword');
            $ctrl.preventDefault(e);
            var parent = e ? $ctrl.LCS.findClosestParent(e.currentTarget, '.passwordgroup') : $ctrl.element.querySelector('.authForm .passwordgroup'),
                value = parent ? parent.querySelector('input.password').value :null,
                passwordIsValid = true;

            check('minchars', value.length >= $ctrl.minLength, true);// More than 8 characters
            check('uppercase', /[A-Z]/);// Contains uppercase
            check('lowercase', /[a-z]/); // Contains lowercase
            check('numbers', /[0-9]/);// Contains numbers
            check('punctuation', /[^\w\s]|_/);// Contains punctuation

            return passwordIsValid;

            function check(id, cond, noTest) {
                passwordIsValid = setCls(id, noTest ? cond : cond.test(value)) && passwordIsValid;
            }

            function setCls(id, cond) {
                if(parent) {
                    $ctrl.LCS[cond && value ? 'addClass' : 'removeClass'](parent.querySelector('#' + id), 'complete');
                }
                return cond;
            }
        }

        function onPasswordFocus(isFocus) {
            //$ctrl.LCS[focus ? 'removeClass':'addClass']($ctrl.LCS.findClosestParent(e.currentTarget, '.passwordgroup').querySelector('.checkp'), 'sb-hide');
            $ctrl.showCheckP = isFocus;
        }

        function getPasswordEl(e) {
            $ctrl.preventDefault(e);
            return $ctrl.LCS.findClosestParent(e.currentTarget, '.passwordgroup').querySelector('input.password');
        }

        function logout(e) {
            var el = e ? e.currentTarget : null;
            $ctrl.preventDefault(e);
            if ($ctrl.isUpdating) {return;}
            $ctrl.isUpdating = true;

            var userId = $ctrl.security.getCurrentUserId();
            var page_name = $ctrl.SBStateService.getCurrentStateName();
            $ctrl.security.logout(onSuccess);
            $ctrl.isUpdating = false;

            function onSuccess(){
                onsuccess();
                $ctrl.ChatService.reset();
                trackEvent('logout', userId, page_name, el);
            }
        }

        function trackEvent(event, userId, page_name, el) {
            $ctrl.Angularytics.trackUserEvent(event, userId, page_name, el);
        }

        function hasError(prop, error, o) {
            return ($ctrl.formHolder[$ctrl.formName][prop].$dirty ||
                    $ctrl.formHolder[$ctrl.formName + '_attempted']) &&
                    $ctrl.formHolder[$ctrl.formName][prop].$error[error];
        }

        function clearForm() {
            $ctrl.user = {};
            $ctrl.password = null;
        }

        function reset() {
            $ctrl.error = null;
        }

        function validateEmail(e) {
            $ctrl.preventDefault(e);
        }

        function saveLogin(e) {
            $ctrl.preventDefault(e);
            var el = e ? e.currentTarget : null;
            if ($ctrl.isUpdating) {return ;}

            var stateParams = $ctrl.SBStateService.getCurrentStateParams();
            $ctrl.form = $ctrl.formHolder[$ctrl.formName];
            $ctrl.error = null;
            $ctrl.mailSent = false;

            $ctrl.formHolder[$ctrl.formName + '_attempted'] = true;
            if (!$ctrl.form || !$ctrl.form.$valid) {return ;}

            $ctrl.isUpdating = true;
            var page_name = $ctrl.SBStateService.getCurrentStateName();
            switch ($ctrl.whichForm) {
                case $ctrl.allforms.Login:
                    $ctrl.security.login($ctrl.user, function (data){
                        onsuccess();
                        trackEvent( 'login', $ctrl.security.getCurrentUserId(), page_name, el);
                        $ctrl.onsuccesslogin(data);
                    }, $ctrl.onerror);
                    break;

                case $ctrl.allforms.SignUp:
                    if (stateParams.invitedBy) {
                        $ctrl.user.invitedBy = stateParams.invitedBy;
                    }
                    if (!$ctrl.user.password){
                        return onError();
                    }
                    if(!checkPassword()){
                        $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'signup.error.invalid_password');
                        return onError();
                    }
                    $ctrl.security.register($ctrl.whichForm, $ctrl.user, function (data){
                        onsuccess();
                        trackEvent( 'sign_up', $ctrl.security.getCurrentUserId(), page_name, el);
                        $ctrl.onsuccesslogin(data);
                    }, $ctrl.onerror);
                    break;

                case $ctrl.allforms.RecoverPassword:
                    $ctrl.security.recoverPassword($ctrl.user.email, function (result) {
                        $ctrl.isUpdating = false;
                        $ctrl.mailSent = $ctrl.user.email;
                        $ctrl.reloadTemplate();
                    }, $ctrl.onerror);
                    break;

                case $ctrl.allforms.ResetPassword:
                    var s = stateParams.resetPasswordToken ? stateParams.resetPasswordToken.split('_') : null;
                    if (s && s.length > 1) {
                        var pars = {
                            _id: s[1],
                            resetPasswordToken: s[0],
                            password: $ctrl.user.password
                        };
                        if ($ctrl.user.name && $ctrl.name !== $ctrl.user.name) {
                            pars.name = $ctrl.user.name;
                        }
                        $ctrl.security.resetPassword(pars, function (result){
                            //result.passwordResetted
                            onsuccess();
                            trackEvent( 'logout', $ctrl.security.getCurrentUserId(), page_name, el);
                            $ctrl.LCS.timeout(function (){
                                if(result && result.email === $ctrl.user.email){
                                    $ctrl.i18nNotifications.pushForCurrentRoute(null,'reset_password.success', 'success', {name: $ctrl.item.name});
                                    //$ctrl.error = $ctrl.localizedMessages.getFromError(null, 'reset_password.success');
                                }
                            }, 500);
                         }, $ctrl.onerror);
                    } else {
                        $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'reset_password.error.invalid');
                    }
                    break;

                case 5: //loginauth
                    var provider = '';
                    $ctrl.security.loginOauth(provider, $ctrl.onsuccesslogin, $ctrl.onerror);
                    break;
            }

            function onError(){
                $ctrl.isUpdating = false;
                $ctrl.mailSent = false;
                $ctrl.formHolderItem[$ctrl.formName + '_attempted'] = false;
            }
        }

        function onsuccess(result) {
            $ctrl.isUpdating = false;
            $ctrl.mailSent = false;
        }

        function onerror(error) {
            var errmess;
            switch ($ctrl.whichForm) {
                case 2:
                    errmess = 'crud.user.register.error';
                    break;
                case 3:
                    errmess = 'reset_password.error';
                    break;
                case 4:
                    errmess = 'recover_password.error';
                    break;
                case 5:
                case 1:
                    errmess = 'login.error.invalidCredentials';
                    break;
            }
            $ctrl.isUpdating = false;
            var mes = error ? error.data : null;
            var erroMes = null;
            if (mes) {
                if (mes.name === 'ValidationError') {
                    erroMes = mes.errors.email;
                }
            }

            $ctrl.error = $ctrl.localizedMessages.getFromError(erroMes ? erroMes : null, erroMes ? null : errmess);
        }

        function onsuccesslogin(result) {
            if (!$ctrl.security.isAuthenticated()) {
                $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'login.error.notUser');
                return;
            }

            var stateParams = $ctrl.SBStateService.getCurrentStateParams();
            if ($ctrl.SBStateService.isCurrentState('public.team-invite')) {
                if ($ctrl.hasPopup && $ctrl.onClose) {
                    $ctrl.onClose();
                }
                $ctrl.SBStateService.assignUrl($ctrl.CPS.getStateHref('public.team-invite', {
                    invitationId: stateParams.invitationId
                }));
            } else if ($ctrl.SBStateService.isCurrentState('public.pricing')) {
                if ($ctrl.hasPopup && $ctrl.onClose) {
                    $ctrl.onClose();
                }
                assignUrl(stateParams, 'user.pricing', null);
            } else {
                if ($ctrl.hasPopup && $ctrl.onClose) {
                    $ctrl.onClose();
                }
                console.log('auth.onsuccesslogin: ' + stateParams.redirectUrl);
                if(stateParams.redirectUrl && stateParams.redirectUrl.indexOf('company')!==-1&&
                    stateParams.redirectUrl.indexOf('company/'+$ctrl.security.companyId)===-1) {
                    delete stateParams.redirectUrl;
                }
                $ctrl.LCS.timeout(function (){
                    $ctrl.SBStateService.goToUrl(stateParams.redirectUrl, $ctrl.security);
                }, 200);
            }

            function assignUrl(stateParams, stateName, params) {
                params = _.extend({
                    companyId: stateParams.companyId,
                    teamId: stateParams.teamId
                }, params);

                //$ctrl.SBStateService.assignUrl($ctrl.CPS.getStateHref(stateName, params));
                $ctrl.CPS.transitionTo(stateName, params);
            }
        }

        function bind(isBind) {
            $ctrl.bindElementsClickBySelector(isBind, '.btnLoad', $ctrl.loadForm);
            $ctrl.bindElementsClickBySelector(isBind, '.btnUnmasked', $ctrl.onUnmask);
            $ctrl.bindElementsClickBySelector(isBind, '.btnSave', $ctrl.saveLogin);
            $ctrl.bindElementClickBySelector(isBind, '.btnLogout', $ctrl.logout);
        }

        function loadForm(e){
            $ctrl.preventDefault(e);

            $ctrl.form = e.currentTarget.getAttribute('data-type');
            $ctrl.mailSent = false;
            $ctrl.whichForm = $ctrl.allforms[$ctrl.form];
            $ctrl.clearForm();

            $ctrl.reloadTemplate();
        }

        function onLoaded(){
            bind(true);
        }

        function getLogout(){
            return '<li><div><button type="button" class="btnLogout btn btn-small primary-faded" analytics-on analytics-action="Sign Out Btn" ng-disabled="$ctrl.isUpdating"><span class="pull-left" ng-class="{false:\'sbf sign-out\', true:\'sbf loadingicon animate-spin\'}[$ctrl.isUpdating===true]"><span class="sbp p1"></span><span class="sbp p2"></span></span> <span>Sign Out</span></button></div></li>';
        }

        function getItemPopupTemplate() {
            bind(false);

            if($ctrl.whichForm === $ctrl.allforms.Logout){
                return getLogout();
            }

            var h3 = $ctrl.titles['t' + $ctrl.whichForm],
                h4 = $ctrl.titles['sub' + $ctrl.whichForm];

            return getStyle() +
                '<div class="login-popup">' +
                    getHeader(h3, h4) +
                    getPanel() +
                '</div>';

            function getPanel() {
        return '<form class="authForm spacing-half-top" name="$ctrl.formHolder.'+$ctrl.formName+'" novalidate ng-keyup="{\'enter\':\'$ctrl.saveLogin()\'}" form-autofill-fix' +
            //' analytics-on analytics-action="' + h3 + '" ' +
            '>' +
                    '<div class="modal-body clearfix">' +
                        '<div class="form-wrapper small">' +
                            $ctrl.LCS.getErrorBlock() +
                            getContent() +
                        '</div>' +
                    '</div>' +
                    '<div class="modal-footer clearfix semi-tall">' +
                        '<div class="form-wrapper small text-center">' +
                            getFooter() +
                        '</div>' +
                    '</div>' +
                '</form>';

                function getContent() {
                    switch ($ctrl.whichForm) {
                        case 1:
                            return getLogin();
                        case 2:
                            return getSignUp();
                        case 3:
                            return resetPassword();
                        case 4:
                            return changePassword();
                        case 7:
                            return passwordChanged();
                        default:
                            return '';
                    }
                }

                function getFooter() {
                    switch ($ctrl.whichForm) {
                        case 1:
                            return getLoginFooter();
                        case 2:
                            return getSignUpFooter();
                        case 3:
                            return resetPasswordFooter();
                        case 4:
                            return changePasswordFooter();
                        case 7:
                            return passwordChangedFooter();
                    }
                }
            }

            function getStyle() {
                return '<style>.password{padding-right:50px}.password+.unmasked{position:absolute;right:0;top:6px;width:36px;height:25px;border-radius:50%;cursor:pointer;line-height:18px;-webkit-appearance:none;outline:0;border:none;z-index:1;background-color:transparent}.password+.unmasked:hover{color:var(--btn-primary-color-hover);border-color:var(--btn-primary-color-hover)}.password[type="text"] + .unmasked,.password[type="text"] + .unmasked .sbp{color:var(--btn-primary-color); border-color:var(--btn-primary-color)}.password+.unmasked .sbf{top: 1px!important;left: 2px!important;width: 24px;height: 24px;font-size: 24px;line-height: 24px}.checkp li,.checkp li:before{height:20px;position:relative}.checkp ul{padding:0;list-style:none}.checkp li{margin:0px 3px .8em 0;-webkit-transition:color .8s cubic-bezier(.19, 1, .22, 1);-moz-transition:color .8s cubic-bezier(.19, 1, .22, 1);-ms-transition:color .8s cubic-bezier(.19, 1, .22, 1);-o-transition:color .8s cubic-bezier(.19, 1, .22, 1);transition:color .8s cubic-bezier(.19, 1, .22, 1);-webkit-backface-visibility:visible}.checkp li:before{top:3px;opacity:1;text-shadow:none;content:"\\e191";width:24px;display:inline-block;font-family:\'sbf\';font-style:normal;font-weight:400;line-height:1;color:@body-color;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;-webkit-transition:-webkit-transform 1.2s cubic-bezier(.19, 1, .22, 1),opacity .1s ease-out;-moz-transition:-moz-transform 1.2s cubic-bezier(.19, 1, .22, 1),opacity .1s ease-out;-ms-transition:-ms-transform 1.2s cubic-bezier(.19, 1, .22, 1),opacity .1s ease-out;-o-transition:-o-transform 1.2s cubic-bezier(.19, 1, .22, 1),opacity .1s ease-out;transition:transform 1.2s cubic-bezier(.19, 1, .22, 1),opacity .1s ease-out;-webkit-transform:scale(1.3);-moz-transform:scale(1.3);-ms-transform:scale(1.3);-o-transform:scale(1.3);transform:scale(1.3);-webkit-backface-visibility:hidden}.checkp li.complete:before{color:#00BF89;opacity:1;}.checkp{background:#fff;padding:20px;position:absolute;z-index:2;width:100%;border-radius:6px;box-shadow:0 0 5px 0 rgb(6 15 26 / 30%);-webkit-box-shadow:0 0 5px 0 rgb(6 15 26 / 30%);top:40px;left:0}</style>';
            }

            function getHeader(h3, h4) {
        return '<div class="modal-header clearfix">' +
                    (($ctrl.whichForm === 1 || $ctrl.whichForm === 2) ? ('<div class="text-center ' + $ctrl.titles.logo + '"><div class="logoTopForm with-bg-image"></div></div>') : ('<div class="centered circled-svg-colored small76">' + $ctrl.LCS.getISBDiv('lock')+'</div>')) +
                    (h3 ? ('<h3 class="text-center bold margin-top-0">' + h3 + '</h3>') : '') +
                    (h4 ? ('<h4 class="text-center">' + h4 + '</h4>') : '') +
                '</div>';
            }

            function getLogin() {
            return '<div class="form-group sbfgroup">' +
                        $ctrl.LCS.getISBDiv('mail') +
                        '<input name="email" id="email" type="email" class="form-control with-underline" placeholder="Email Address" ng-model="$ctrl.user.email" required autocomplete="username">' +
                        '<label ng-show="$ctrl.user.email" class="with-label">Email</label>' +
                        '<div ng-if="$ctrl.hasError(\'email\', \'required\')" class="help-inline">Email address is required.</div>' +
                        '<div ng-if="$ctrl.hasError(\'email\', \'email\')" class="help-inline">Please insert a valid email address.</div>' +
                    '</div>' +
                    '<div class="form-group sbfgroup last passwordgroup position-relative">' +
                        $ctrl.LCS.getISBDiv('lock') +
                        '<input name="password" id="password" class="password form-control with-underline" placeholder="Password" type="password" ng-model="$ctrl.user.password" required autocomplete="current-password">' +
                getUnmaskedBtn() +
                        //'<label ng-show="$ctrl.user.password" class="with-label">Password</label>' +
                        '<div ng-if="$ctrl.hasError(\'password\', \'required\')" class="help-inline">Password is required.</div>' +
                    '</div>';
            }

            function getLoginFooter() {
            return '<button class="btnSave btn btn-primary with-height-radius" type="submit" ng-class="{\'disabled\': $ctrl.isUpdating}" ng-disabled="$ctrl.isUpdating" analytics-on analytics-action="Login Btn"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> <span>'+$ctrl.titles.btn1+'</span></button>' +
                    '<div class="small-font clearfix">' +
                        '<div class="pull-left"><a class="btnLoad" data-type="RecoverPassword" analytics-on analytics-action="Login Form - Switch to Forgot Password">Forgot Password?</a></div>' +
                        '<div class="pull-right"><a class="btnLoad" data-type="SignUp" analytics-on analytics-action="Login Form - Switch to Sign Up"> Create Free Account</a></div>' +
                    '</div>';
            }

            function getSignUp() {
            return '<div class="form-group sbfgroup">' +
                        $ctrl.LCS.getISBDiv('user') +
                        '<input name="name" id="name" class="form-control with-underline" placeholder="Full Name" type="text" ng-model="$ctrl.user.name" required capitalize-first>' +
                        '<label ng-show="$ctrl.user.name" class="with-label">Name</label>' +
                        '<div ng-if="$ctrl.hasError(\'name\', \'required\')" class="help-inline">Full name is required.</div>' +
                    '</div>' +
                    '<div class="form-group sbfgroup">' +
                        $ctrl.LCS.getISBDiv('company', 3) +
                        '<input name="company" id="company" class="form-control with-underline" placeholder="Company Name" type="text" ng-model="$ctrl.user.company" required>' +
                        '<label ng-show="$ctrl.user.company" class="with-label">Company</label>' +
                        '<div ng-if="$ctrl.hasError(\'company\', \'required\')" class="help-inline">Company is required.</div>' +
                    '</div>' +
                    '<div class="form-group sbfgroup">' +
                        $ctrl.LCS.getISBDiv('mail') +
                        '<input name="email" id="email" type="email" class="form-control with-underline" placeholder="Email Address" ng-model="$ctrl.user.email" required autocomplete="username">' +
                        '<label ng-show="$ctrl.user.email" class="with-label">Email</label>' +
                        '<div ng-if="$ctrl.hasError(\'email\', \'required\')" class="help-inline">Email address is required.</div>' +
                        '<div ng-if="$ctrl.hasError(\'email\', \'email\')" class="help-inline">Please insert a valid email address.</div>' +
                    '</div>' +
                    '<div class="form-group sbfgroup last passwordgroup position-relative">' +
                        $ctrl.LCS.getISBDiv('lock') +
                        '<input name="password" id="password" class="password form-control with-underline" placeholder="Password" type="password" ng-model="$ctrl.user.password" required autocomplete="new-password" maxlength="20" ng-keyup="$ctrl.checkPassword($event)" ng-focus="$ctrl.onPasswordFocus(true)" ng-blur="$ctrl.onPasswordFocus(false)">' +
                        getUnmaskedBtn() +
                        // '<label ng-show="$ctrl.user.password" class="with-label">Password</label>' +
                        '<div ng-if="$ctrl.hasError(\'password\', \'required\')" class="help-inline">Password is required.</div>' +
                        getCheckP() +
                    '</div>';
            }

            function getSignUpFooter() {
            return '<div class="italic text-smaller text-center spacing-half-bottom">By clicking "Sign Up", I agree to the <a class="gray_underline" href="https://www.studiobinder.com/tos" target="_blank">Terms</a> & <a class="gray_underline" href="https://www.studiobinder.com/privacy" target="_blank">Privacy</a>.</div>' +

                    '<button class="btnSave btn btn-primary with-height-radius full-width" type="submit" ng-class="{\'disabled\': !$ctrl.isValid()}" ng-disabled="!$ctrl.isValid()" analytics-on analytics-action="Sign Up Btn"><span ng-show="$ctrl.isUpdating===true" class="pull-left sbf loadingicon animate-spin"></span> <span>'+$ctrl.titles.btn2+'</span></button>' +
                    '<div class="spacing-half-top clearfix text-center"><span>Already have an account?</span> <a class="btnLoad" data-type="Login" analytics-on analytics-action="Sign Up Form - Switch to Log In">Sign In!</a></div>' +
                    '<div class="small-font clearfix spacing-half-top text-center">No credit card required • Secure site</div>';
            }

            function resetPassword() {
                return ($ctrl.mailSent ? ('<p class="text-center">We sent a reset password email to <br/><span class="semibold">' + $ctrl.mailSent + '</span>. Please click the reset password link to set your new password.</p>' +
                    '<p class="text-center spacing-half-top">Haven’t received the email?<br/>Please check your spam folder, or <a class="btnLoad" data-type="RecoverPassword" analytics-on analytics-action="Switch to Forgot Password">try again</a>.</p>') : (
                    '<p class="form-group text-center spacing-half-bottom medium-size">Enter the email address you signed up with, and we’ll send you a reset link.</p>' +
                    '<div class="form-group sbfgroup last">' +
                        $ctrl.LCS.getISBDiv('mail') +
                        '<input name="email" id="email" class="form-control with-underline" placeholder="Email address" type="email" ng-model="$ctrl.user.email" required>' +
                        '<label ng-show="$ctrl.user.email" class="with-label">Email</label>' +
                        '<div ng-if="$ctrl.hasError(\'email\', \'required\')" class="help-inline">Email address is required.</div>' +
                        '<div ng-if="$ctrl.hasError(\'email\', \'email\')" class="help-inline">Please insert a valid email address.</div>' +
                    '</div>'));
            }

            function resetPasswordFooter() {
                return '<button class="btnSave btn btn-primary with-height-radius '+($ctrl.mailSent?' sb-hide':'')+'" type="submit" ng-class="{\'disabled\': $ctrl.isUpdating}" ng-disabled="$ctrl.isUpdating===true" analytics-on analytics-action="Request Recover Password"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Reset Password</button>' +
                    getBackToLogin('Reset Password');
            }

            function passwordChanged() {
                return '<p class="text-center">Your password was changed successfully.';
            }

            function passwordChangedFooter() {
                return getBackToLogin('Password Change');

                //return '<button class="btnLoad btn btn-primary with-height-radius '+($ctrl.mailSent?' sb-hide':'')+'" type="button" data-type="Login" analytics-on analytics-action="Switch to Log In"><span class="pull-left sbf loadingicon animate-spin"></span> Sign In</button>';
            }


            function getBackToLogin(p){
                return '<div class="small-font clearfix">' +
                    '<div class="pull-left">' +
                    '<a class="btnLoad" data-type="Login" analytics-on analytics-action="'+(p ? (p + ' - ') : '') + 'Switch to Log In">' + $ctrl.LCS.getISBDiv('builder-back', 2, 'pull-left') + ' Back to Login</a>' +
                    '</div>' +
                    '</div>';
            }

            function changePassword() {
                var maxLength = 100;
            return '<div class="form-group sbfgroup passwordgroup position-relative">' +
                        $ctrl.LCS.getISBDiv('lock') +
                        '<input name="password" id="password" class="password form-control with-underline" placeholder="Password" type="password" ng-model="$ctrl.user.password" required autofocus autocomplete="current-password" maxlength="'+maxLength+'" ng-keyup="$ctrl.checkPassword($event)" ng-focus="$ctrl.onPasswordFocus(true)" ng-blur="$ctrl.onPasswordFocus(false)">' +
                        getUnmaskedBtn()+
                        // '<label ng-show="$ctrl.user.password" class="with-label">New Password</label>' +
                        '<div ng-if="$ctrl.hasError(\'password\', \'required\')" class="help-inline ng-hide">Password is required.</div>' +
                        '<div ng-if="$ctrl.hasError(\'password\', \'equal\')" class="help-inline ng-hide">Passwords do not match.</div>' +
                        getCheckP() +
                    '</div>' +

                    '<div class="form-group sbfgroup last passwordgroup position-relative">' +
                        $ctrl.LCS.getISBDiv('lock') +
                        '<input name="repeatPassword" id="repeatPassword" class="password form-control with-underline" placeholder="Confirm Password" type="password" ng-model="$ctrl.user.passwordRepeat" required validate-equals="$ctrl.user.password" autocomplete="new-password" maxlength="'+maxLength+'">' +
                        getUnmaskedBtn() +
                        '<label ng-show="$ctrl.user.passwordRepeat" class="with-label">Password</label>' +
                        '<div ng-if="$ctrl.hasError(\'repeatPassword\', \'required\')" class="help-inline ng-hide">Confirm password is required.</div>' +
                        '<div ng-if="$ctrl.hasError(\'repeatPassword\', \'equal\')" class="help-inline ng-hide">Passwords do not match.</div>' +
                    '</div>';
            }

            function changePasswordFooter() {
                return '<button class="btnSave btn btn-primary with-height-radius" type="submit" ng-class="{\'disabled\': !$ctrl.isValid()}" ng-disabled="!$ctrl.isValid()" analytics-on analytics-action="Update Password"><span ng-show="$ctrl.isUpdating===true" class="pull-left sbf loadingicon animate-spin"></span> Update Password</button>';
            }

            function getCheckP() {
            return '<div class="checkp" ng-show="$ctrl.showCheckP && $ctrl.user.password">' +
                        '<ul>' +
                            '<li id="minchars">At least ' + $ctrl.minLength + ' characters long.</li>' +
                            '<li id="uppercase">Contains uppercase letters.</li>' +
                            '<li id="lowercase">Contains lowercase letters.</li>' +
                            '<li id="numbers">Contains numbers.</li>' +
                            '<li id="punctuation">Contains punctuation.</li>' +
                        '</ul>' +
                    '</div>';
            }
        }


        function getUnmaskedBtn(){
            return '<button class="btnUnmasked unmasked" type="button">' +
                $ctrl.LCS.getISBDiv('eye', 3, 'gray') +
                '</button>';
        }
    }
}

angular.module('auth.interceptor.factory', [
])
.factory('authInterceptor', AuthInterceptorFactory);

AuthInterceptorFactory.$inject = [ '$q', 'i18nNotifications', 'CookiesService','API_CONFIGS', '$window'];

function AuthInterceptorFactory( $q, i18nNotifications, CookiesService, API_CONFIGS, $window) {
    var configs = API_CONFIGS();
    return {
        // Add authorization token to headers
        request: request,
        response: response,
        // Intercept 401s and redirect you to login
        responseError: responseError
    };

    function request(config) {
        if (!config.url || config.url &&
            config.url.indexOf('amazonaws.com') === -1 &&
            config.url.indexOf('.html') === -1 && config.url.indexOf('.tpl.html') === -1) {
            config.headers = CookiesService.setAuthorizationHeader(config.headers);

            var isImgUrl = config && config.url && config.url.indexOf(configs.imgUrl) === 0;
            if (isImgUrl) {
                //console.log('AuthInterceptorFactory: ' + config.url);
                delete config.headers['x-invitation-id'];
                if (config.headers.Authorization) {
                    config.headers.Authorization += '_split_' + config.headers['x-company-id'];
                }
            }
        }

        return config;
    }

    function response(response) {
        /*add a service
        function onsuccess() {
           // Asynchronous operation succeeded, modify response accordingly
           deferred.resolve(response);
        }
         var deferred = $q.defer();
         someAsyncService.doAsyncOperation().then(onsuccess, onsuccess);
       deferred.resolve(response);
       return deferred.promise; */

        /* This is the code that transforms the response. `res.data` is the  response body
        res.data = { data: data };
        res.data.meta = { status: res.status };
        return res;*/
        return response;
    }

    function responseError(response) {
       //console.log('responseError:');
      //  console.log(response);
        var loginPath = configs.site.loginPath;
        if (!(response.config && response.config.url && response.config.url.indexOf(configs.imgUrl) === 0)) {
            if (response.status === 401) {//unauthorized
                // remove any stale tokens
                CookiesService.removeCookie('token');
                CookiesService.setSessionCookieUser(null);
                var path = $window.location.pathname;
                if (path.indexOf('/team/invite/') === -1 &&
                    path !== '/' &&
                    path !== '/login' &&
                    path !== '/pricing' &&
                    path.indexOf('/resetPassword') === -1 &&
                    path.indexOf('/anon/project/') === -1) {
                    //i18nNotifications.pushForNextRoute(null, 'unauthorized', 'error');
                    $window.location.assign(loginPath);
                }
            }else if(response.status === 403){// authenticated users who aren’t allowed to use a resource
                $window.location.assign('/nonauthorized');
            }
            /*else if (response.status === 404) {//Unprocessable Entity -> if params are invalid
                $window.location.href = '/';
            }*/
              /*
            200 - OK - Everything went fine.

            400 - Bad Request error - The request was malformed or the data supplied by the end user was not valid. This is also used if the user has exceeded their API usage limit.
            401 - Unauthorized - The user is not authorized to access the requested resource. Additional information is typically supplied within the response to tell the end user (API consumer) how to authorize itself (ie. BASIC Authentication).
            403 - Forbidden error - The user has exceeded their post limit
            404 - Not Found error - The requested resource was not found
            405 - Method Not Allowed - The user attempted to use a verb (ex. GET, POST) on a resource that had no support for the given verb.
            406 - Not Acceptable - The user requested a return format (ex. JSON, XML) that is not currently supported.
            419 - Authentication Timeout - denotes that previously valid authentication has expired. It is used as an alternative to 401 Unauthorized in order to differentiate from otherwise authenticated clients being denied access to specific server resources.

            422 - Unprocessable Entity -> if params are invalid

            500 - Internal Server Error
            503 - Service Unavailable error

            -1  - server unresponsive
             dont clear cookies if there is an internal server error
             else if (response.status && response.status === 500) {
                CookiesService.clearCookies();
                $window.location.href = configs.site.absUrl + configs.site.loginPath;
                SessionService.setSessionVars(true);
            }*/

        }

        // Session has expired
        /*else if (response.status == 419){ //if session has expire relogin the user
            var SessionService = $injector.get('SessionService');
            var $http = $injector.get('$http');
            var deferred = $q.defer();

            // Create a new session (recover the session)
            // We use login method that logs the user in using the current credentials and
            // returns a promise
            SessionService.login().then(deferred.resolve, deferred.reject);

            // When the session recovered, make the same backend call again and chain the request
            return deferred.promise.then(function() {
                return $http(response.config);
            });
        }*/
        return $q.reject(response);
    }
}

/*
 .factory('socket',['socketFactory', 'Auth', 'API_CONFIGS',  function(socketFactory, Auth, API_CONFIGS) {

 var socket, ioSocket, isAuthenticated,
 self = {
 getAuthenticated:function(){
 return isAuthenticated;
 }
 };
 // by default the socket property is null and is not authenticated
 self.socket = socket;
 // initializer function to connect the socket for the first time after logging in to the app
 self.initialize = function(){
 console.log('initializing socket');

 isAuthenticated = false;

