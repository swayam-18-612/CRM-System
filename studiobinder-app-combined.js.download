        Settings = {
            Columns: angular.copy(SBApiGridColumns['team'](PropTypes)),

            MemberTypes: [
                {value: 1, text: 'Admin'},
                {value: 2, text: 'Owner', hide:true},
                {value: 0, text: 'Member'}
            ],

            Statuses : {Pending: 1, Approved: 2, Rejected: 3},
        },

        CompOptions = angular.copy(compOptions),

        ListParams = {
            includeFields: ['memberType', 'userId', 'order', 'teamInvitationId'],
            searchFields: ['name', 'email'],
            orderFields: ['order'],
            populate: 'userId teamInvitationId'
        },

        Options = {
            columns: ['1', '2', '5'],
            view: 2,
            column: 4
        },

        GroupSettings = {
            customButtons:true,
            colType: 'myTeam',
           // gridItemClass: 'short-item-grid',
            groupItemTag: 'myteam',
            hideGridHeader: true,
            displaySubtitleUnder: true
        },

        KeyboardServiceParams = {
            canCopy: false,
            canMove: false,
        };

    return {
        ViewProp: 'myTeamView',
        ListParams: ListParams,
        CompOptions: CompOptions,
        PropTypes: PropTypes,
        Options: Options,
        Settings: Settings,
        GroupSettings: GroupSettings,
        KeyboardServiceParams: KeyboardServiceParams
    };
}

