});
function TempProductTypesService(ApiService, model, OverviewBlocks) {
    var service = ApiService(model, {
        listType: 'isGroup',
        convertOtherResources: convertOtherResources
    });

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;

    return service;

    function convertOtherResources(item) {
        var overviewBlockIds = item.overviewBlockIds;
        if (overviewBlockIds && overviewBlockIds.length > 0) {
            var overviewBlocks = [];
            for (var i = 0; i < overviewBlockIds.length; i++) {
                var el = overviewBlockIds[i];
                if (el && typeof(el)==='object' && el._id) {
                    item.overviewBlockIds[i] = el._id;
                    overviewBlocks.push(new OverviewBlocks(el));
                }
            }
            if (overviewBlocks) {
                item.overviewBlocks = overviewBlocks;
            }
        }

        if (item.parentId && typeof(item.parentId) === 'object') {
            item.parent = new model(item.parentId);
            item.parentId = item.parentId._id;
        }
        return item;
    }
    function getChangedFieldForUpdateOther(){
        return ['name', 'order','icon', 'overviewBlockIds', 'parentId'];
    }
}

