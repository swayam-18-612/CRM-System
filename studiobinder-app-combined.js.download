TodoFilesConstantsService.$inject = ['SBFieldTypesService'];
function TodoFilesConstantsService(SBFieldTypesService ) {
    var PropTypes = SBFieldTypesService.PropTypes,
        Settings = {
            Columns: {
                "1": {
                    id: "1",
                    name: 'Name',
                    prop: 'name',
                    type: PropTypes.Field,
                    colCls: 'address vtop',
                    grow: true,
                    isRequired: true,
                    order: 1,
                    placeholder: 'Name…',
                    showMobile: true,
                    isMobileTitle: true,
                    isListTitle: true,
                    canChangeOnEdit: true,
                    canEdit: false,
                    //triggerEditOnCol: true,
                    // openPopup: true,
                },
                "2": {
                    id: "2",
                    name: 'Size',
                    prop: 'size',
                    type: PropTypes.Size,
                    placeholder: 'Size…',
                    canEdit: false,
                    cantEditInPopup: true,
                    showMobile: true,
                    notInModal: true,
                    colCls: 'size',
                    isMobileSubtitle: true,
                    isListSubtitle: true
                }
            }
        },

        CompOptions = {
            withoutMouseHover: true,
            withCreateInlineGroup: true,
            withEditInlineGroup: true,
            dragHandleOnTheSide: true,
            withoutBorderBottom: true,
            noSideColumnBorders: true,
            withoutCheckbox: true,
            listField: 'parentId',
            objectType: 'material',
            itemTitle: 'attachment',
            elemType: 'MATERIAL',
            preLoadingTableName: 'Materials',
            hasTree: false,

            expandMobileRow: false,
            expandMobileRowWithDetails: false
        },

        Options = {
            view: 3,
            columns: [1, 2],
        },

        GroupSettings = {
            groupItemTag: 'todofiles',
            customButtons: true,
            withoutSideBorderCls: true
        },
        KeyboardServiceParams = {
            canCopy: false,
            canMove: false
        } ;

    return {
        Settings: Settings,
        Options: Options,
        ViewProp: 'todofilesView',
        PropTypes: PropTypes,
        GroupSettings: GroupSettings,
        CompOptions: CompOptions,
        KeyboardServiceParams: KeyboardServiceParams,
    };
}

