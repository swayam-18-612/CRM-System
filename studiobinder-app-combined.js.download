addMoSePa('Activities', 'activities', TempActivitiesService,{
    serviceInjectList: ['Products', 'Users','TodoPages'],
    serviceInjectMod: [
        'resources.Products',
        'resources.Users',
        'resources.TodoPages'
    ]
});

function TempActivitiesService(ApiService, model, Products, Users,TodoPages) {
    var service = ApiService(model, {
        listType: 'isGroup',
        convertOtherResources: convertOtherResources
    });

    return service;

    function convertOtherResources(item) {
        if (item.productId && typeof (item.productId) === 'object') {
            item.product = new Products(item.productId);
            item.productId = item.product._id;
        }

        if (item.createdById && typeof (item.createdById) === 'object') {
            item.createdBy = new Users(item.createdById);
            item.createdById = item.createdBy._id;
        }


        if (item.todoPageId && typeof (item.todoPageId) === 'object') {
            item.todoPage = new TodoPages(item.todoPageId);
            item.todoPageId = item.todoPage._id;
        }

        return item;
    }
}



addMoSePa('Answers', 'answers', TempAnswersService, {
    serviceInjectList: ['ResourcePathsService'],
    serviceInjectMod: ['apiServices.paths.service']
});
function TempAnswersService(ApiService, model, ResourcePathsService) {
    var service = ApiService(model, {
        listType: 'isGroup',
        listField: 'parentAnswerId'
    });
    service.getPostPath = ResourcePathsService.getSideBarCommentsPath;
    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.favor = favor;

    return service;

    function getChangedFieldForUpdateOther() {
        return ['answer', 'shortDesc'];
    }

    function favor(params, successcb, errorcb) {
        return service.postUrl('/' + params.answerId + '/favor', params, successcb, errorcb);
    }
}

/**
 * Registers modules and dependencies for a specific resource name, mapping the resource to service modules,
 * model modules, and pagination modules. Sets up AngularJS services, models, and pagination for the provided
 * resource and service method.
 *
 * @param {string} name - The name of the resource to be added.
 * @param {string} collection - The name of the collection associated with the resource.
 * @param {Function} serviceMethod - The service method used for handling API actions.
 * @param {Object} [other] - Additional configuration options.
 * @param {string} [other.collectionType] - The type of the collection to be passed to the model module.
 * @param {Function} [other.modelMethod] - Custom method for the model module's factory.
 * @param {Array<string>} [other.modelInjectList] - List of dependencies to inject into the model module's factory.
 * @param {Array<string>} [other.modelInjectMod] - List of AngularJS module dependencies for the model module.
 * @param {Array<string>} [other.serviceInjectList] - List of dependencies to inject into the service module's factory.
 * @param {Array<string>} [other.serviceInjectMod] - List of AngularJS module dependencies for the service module.
 * @return {void}
 */
function addMoSePa(name, collection, serviceMethod, other) {
    SBApiCollections[name] = collection;
    SBApiNames[collection] = name;

    if (!other) {
        other = {};
    }

    addModelModule(name, collection, other.collectionType, other.modelMethod, other.modelInjectList, other.modelInjectMod);
    addServiceModule(name, serviceMethod, other.serviceInjectList, other.serviceInjectMod);
    addPaginationModule(name);

    function addModelModule(name, collection, collectionType, method, injectList, injectMods) {
        //console.log('addModelModule' + name);
        if (!method) {
            method = function (ApiResource) {
                return ApiResource(collection, collectionType);
            };
        }

        angular.module('resources.' + name, ['resources.ApiResource'].concat(injectMods || []))
            .factory(name, method);

        method.$inject = ['ApiResource'].concat(injectList || []);
    }

    function addPaginationModule(name) {
        //console.log('addPaginationModule' + name);
        var method = function (ApiPagination, service) {
            return ApiPagination(service);
        };
        angular.module('apiPagination.' + name, [
            'apiServices.' + name,
            'apiPagination.ApiPagination'
        ]).factory(name + 'Pagination', method);
        method.$inject = ['ApiPagination', name + 'Service'];
    }

    function addServiceModule(name, method, injectList, injectMods) {
        //console.log('addServiceModule' + name);
        if (!method) {
            method = function (ApiService, name) {
                return ApiService(name);
            }
        }

        angular.module('apiServices.' + name,  [
            'apiServices.ApiService',
            'resources.' + name
        ].concat(injectMods || []))
            .factory(name + 'Service', method);
        method.$inject = ['ApiService', name].concat(injectList || []);
    }
}

angular.module('resources.ApiResource', [
    'apiConstants.shots.services'
])
.factory('ApiResource', ApiResourceFactory);
/**
 * Dependency injection array for the `ApiResourceFactory` function.
 * It specifies the list of dependencies to be injected into the function.
 *
 * This property is typically used with dependency injection frameworks to ensure
 * the proper modules or services are provided to the `ApiResourceFactory`.
 */
ApiResourceFactory.$inject = ['ShotConstantsService', 'MomentService'];
/**
 * Creates and returns an ApiResource constructor function based on the given collection name and type.
 * Configures roles, activity types, comment pages, and relevant method definitions for the resource.
 * Additionally, initializes and processes data from various collection names.
 *
 * @param {Object} ShotConstantsService - Service object handling constants like settings and roles.
 * @param {Object} MomentService - Service object used for date & time manipulation.
 * @return {Function} - A constructor function for creating resource objects tied to the specified collection.
 */
function ApiResourceFactory(ShotConstantsService, MomentService) {
    var Settings = ShotConstantsService.Settings,
        Roles = {Talent: 1, Crew: 2, Extras: 3, Custom: 4, Clients: 5},

        ActivityTypes = {
            Insert: 1, Update: 2, Remove: 3, ShareCallsheet: 4,
            ApproveCallsheet: 5, CommentCallsheet: 6, OwnerCommentCallsheet: 7, Duplicate: 8,
            SendCallsheet: 9
        },
        CommentPages = {Contacts: 1, Stripboard: 2, Characters: 3, Locations: 4};

     var ApiResource = function(collectionName, collectionType) {
        var Resource = function (data) {
            if (data) {
                _.extend(this, data);
            }

            this.runConversions(collectionName);
        };

        Resource.collectionName = collectionName;
        Resource.collectionType = collectionType || null;

        Resource.Roles = Roles;
        Resource.ActivityTypes = ActivityTypes;
        Resource.CommentPages = CommentPages;

        //console.log('ApiResource: '+Resource.collectionName);
        Resource.getCollectionName = getCollectionName;


        Resource.randomString = randomString;

        Resource.getType = getType;
        Resource.prototype.getUtcMoment = getUtcMoment;
        Resource.prototype.getType = function () {
            return Resource.getType();
        };

        Resource.prototype.getName = function () {
            return this.name;
        };

        Resource.prototype.getInitials = function () {
            return Resource.getInitials(this);
        };

        Resource.getInitials = function (item) {
            var init = null;
            var sp = item.name ? item.name.replace('—', '').replace('–', '').replace('-', '').toUpperCase().split(' ') : null;
            if (sp != null) {
                if (sp.length > 1) {
                    init = '';
                    for (var i = 0; i < sp.length; i++) {
                        sp[i] = sp[i].trim();
                        if (sp[i].length > 0) {
                            init += sp[i][0];
                            if (init.length === 2) {
                                break;
                            }
                        }
                    }
                } else if (sp.length === 1) {
                    init = sp[0].substring(0, 2);
                }
            }
            return init;
        };

        Resource.prototype.getNameColor = function () {
            return getNameColor(this.getInitials());
        };
        Resource.prototype.getColorForInitials = getColorForInitials;

        Resource.getRoles = getRoles;

        Resource.prototype.getRoles = function (r, contactListId) {
            var roles = this.getItemRoles(contactListId);

            if (roles) {
                switch (r.type) {
                    case 1: //'Talent'
                    case 3: //'Extras'
                        return r.name ? ('"' + r.name + '"') : '';
                    case 2://'Crew':
                        return roles[r.text] ? roles[r.text].name : '';
                    case 4: // Custom
                        return r.name;
                }
            }

            return null;
        };

        Resource.prototype.getRolesText = getRolesText;
        Resource.prototype.getCustomTime = getCustomTime;
        Resource.prototype.getTime = getTime;
        Resource.loadImageProp = loadImageProp;

        Resource.prototype.loadImageFromProp = function (prop, val) {
            loadImageFromProp(this, prop, val);
        };

        Resource.prototype.loadImageFromObjProp = function (result) {
            loadImageFromProp(this, result.prop, result.val);
        };

        Resource.prototype.getUpdatedImageProps = function (result) {
            var item = {_id: this._id};
            loadImageFromProp(item, result.prop, result.val);
            return item;
        };

        Resource.runConversions = function (_this, collectionName) {
            _this = getCreated(_this);

            if (!collectionName) {
                collectionName = Resource.collectionName;
            }

            switch (collectionName) {
                case 'callsheets':
                    if (! _this.options) {
                        _this.options = {
                            hideClients: false,
                            hideExtras: false,
                            breaks: {}
                        };
                    }
                    if (! _this.templateId) {
                        _this.templateId = '56e4dcf0547dbf2c25b76996';
                    }
                    if (_this.type === undefined) {
                        _this.type = 1;
                    }
                    if (_this.status === undefined) {
                        _this.status = 0;//Draft;
                    }
                    _this.startDate = getUtcMoment(_this.startDate);
                    if (_this.advancedDate) {
                        _this.advancedDate = getUtcMoment(_this.advancedDate);
                    }
                    // if(! _this.address) _this.address={formatted_address:null};

                    /*formatted_address, url, address_components (for(var prop in address_components){if(address_components[prop].types[0] == 'postal_code'){addressGeo.code = address_components[prop].types[0]}})
                     */
                    break;

                case 'callsheetsSent':
                    _this.startDate = getUtcMoment(_this.startDate);
                    if (_this.advancedDate) {
                        _this.advancedDate = getUtcMoment(_this.advancedDate);
                    }
                    break;

                case 'extras':
                    _this = updateTimes(_this, true);
                    break;

                case 'callsheetInvitations':

                    _this = updateTimes(_this, false, true);

                    if (_this.confirmedAt) {
                        _this.confirmedAt = MomentService.getMomentFromString(_this.confirmedAt);
                    }
                    break;

                case 'callsheetInvitationsSent':
                    if (_this.info.calltime &&  _this.info.calltime.isTime) {
                        _this.info.calltime.value = getUtcMoment(_this.info.calltime.value);
                    }

                    _this.info.startDate = getUtcMoment(_this.info.startDate);

                    if (_this.lastPageViewedAt) {
                        _this.lastPageViewedAt = MomentService.getMomentFromString(_this.lastPageViewedAt);
                    }
                    if (_this.lastEmailViewedAt) {
                        _this.lastEmailViewedAt = MomentService.getMomentFromString(_this.lastEmailViewedAt);
                    }

                    if (_this.confirmedAt) {
                        _this.confirmedAt = MomentService.getMomentFromString(_this.confirmedAt);
                    }
                    break;

                case 'collaborators':
                    if (_this.lastPageViewedAt) {
                        _this.lastPageViewedAt = MomentService.getMomentFromString(_this.lastPageViewedAt);
                    }
                    break;


                case 'invoices':
                    _this.startDate = getUtcMoment(_this.startDate);
                    _this.endDate = getUtcMoment(_this.endDate);
                    break;


                case 'plans':
                    if (! _this.features) {
                        _this.features = {};
                    }
                    break;

                case 'planFeatures':
                    break;

                case 'schedulesSent':
                    if (_this.time) {
                        _this.time = getUtcMoment(_this.time);
                    }
                    if (! _this.type) {
                        _this.type = 1;
                    }
                    break;

                case 'temperatures':
                    if (_this.weather) {
                        if (_this.weather.sunset) {
                            _this.weather.sunset = getUtcMoment(_this.weather.sunset);
                        }
                        if (_this.weather.sunrise) {
                            _this.weather.sunrise = getUtcMoment(_this.weather.sunrise);
                        }
                    }
                    break;

                case 'topCalls':
                    _this.time = getUtcMoment(_this.time);
                    break;

                case 'settings':
                    _this.startTime = getUtcMoment(_this.startTime);
                    break;

                case 'shots':
                case 'strips':
                case 'stripSchedules':
                case 'schedules':
                case 'advancedSchedules':
                    if (_this.time) {
                        _this.time = getUtcMoment(_this.time);
                    }
                    if (_this.endTime) {
                        _this.endTime = getUtcMoment(_this.endTime);
                    }
                    _.each(['prepTime', 'shootTime', 'estTime'
                        // , 'duration'
                    ], function (prop){
                        _this[prop] = getEstTime(_this[prop]);
                    });

                    if (_this.date) {
                        _this.date = getUtcMoment(_this.date);
                    }

                    if (collectionName === 'schedules' || collectionName === 'advancedSchedules') {
                        if (! _this.type) {
                            _this.type = 1;
                        }
                    }

                    break;

                case 'shotsListOptions':
                case 'storyboardsListOptions':
                case 'moodboardsListOptions':
                    if (! _this.options) {
                        _this.options = {};
                    }
                    if (! _this.options.columns) {
                        _this.options.columns = Settings.Template;
                    }
                    if (! _this.options.column) {
                        _this.options.column = Settings.ColumnsPerRow[3].id;
                    }
                    if (! _this.options.ratio) {
                        _this.options.ratio = Settings.AspectRatios[1].id;
                    }
                    break;

                case 'todoCards':
                    if (_this.completedAt) {
                        _this.completedAt = MomentService.getMomentFromString(_this.completedAt);
                    }

                    _this.startDate = getDate(_this.startDate, true);
                    _this.dueDate = getDate(_this.dueDate, false);

                function getDate(d, isStart) {
                    if (d && d.value) {
                        if (typeof (d.value) === "string") {
                            d.value = d.hasTime ? getUtcMoment(d.value) : (isStart ? MomentService.getUtcMomentStartDay(d.value) : MomentService.getUtcMomentEndDay(d.value));
                        }
                    } else {
                        d = {value: null, hasTime: false};
                    }

                    return d;
                }

                    break;

                case 'users':
                    if (! _this.subscription) {
                        _this.subscription = {};
                    }
                    break;

                case 'documents':
                case 'materials':
                    _this.version = getCreated(_this.version);
                    break;
            }

            return _this;
        }
        Resource.runConversions = function (_this, collectionName) {
            _this = getCreated(_this);

            if (!collectionName) {
                collectionName = Resource.collectionName;
            }

            switch (collectionName) {
                case 'callsheets':
                case 'callsheetsSent':
                    if(_this.startDate) {
                        _this.startDate = getUtcMoment(_this.startDate);
                    }
                    if (_this.advancedDate) {
                        _this.advancedDate = getUtcMoment(_this.advancedDate);
                    }
                    break;

                case 'extras':
                        _this = updateTimes(_this, true);
                    break;

                case 'callsheetInvitations':

                    _this = updateTimes(_this, false, true);

                    if (_this.confirmedAt) {
                        _this.confirmedAt = MomentService.getMomentFromString(_this.confirmedAt);
                    }
                    break;

                case 'callsheetInvitationsSent':
                    if(_this.info) {
                        if (_this.info.calltime && _this.info.calltime.isTime) {
                            _this.info.calltime.value = getUtcMoment(_this.info.calltime.value);
                        }

                        if (_this.info.startDate) {
                            _this.info.startDate = getUtcMoment(_this.info.startDate);
                        }
                    }

                    if (_this.lastPageViewedAt) {
                        _this.lastPageViewedAt = MomentService.getMomentFromString(_this.lastPageViewedAt);
                    }
                    if (_this.lastEmailViewedAt) {
                        _this.lastEmailViewedAt = MomentService.getMomentFromString(_this.lastEmailViewedAt);
                    }

                    if (_this.confirmedAt) {
                        _this.confirmedAt = MomentService.getMomentFromString(_this.confirmedAt);
                    }
                    break;

                case 'collaborators':
                    if (_this.lastPageViewedAt) {
                        _this.lastPageViewedAt = MomentService.getMomentFromString(_this.lastPageViewedAt);
                    }
                    break;


                case 'invoices':
                    if(_this.startDate) {
                        _this.startDate = getUtcMoment(_this.startDate);
                    }
                    if(_this.endDate) {
                        _this.endDate = getUtcMoment(_this.endDate);
                    }
                    break;

                case 'schedulesSent':
                    if (_this.time) {
                        _this.time = getUtcMoment(_this.time);
                    } 
                    break;

                case 'temperatures':
                    if (_this.weather) {
                        if (_this.weather.sunset) {
                            _this.weather.sunset = getUtcMoment(_this.weather.sunset);
                        }
                        if (_this.weather.sunrise) {
                            _this.weather.sunrise = getUtcMoment(_this.weather.sunrise);
                        }
                    }
                    break;

                case 'topCalls':
                    if(_this.time) {
                        _this.time = getUtcMoment(_this.time);
                    }
                    break;

                case 'settings':
                    if(_this.startTime) {
                        _this.startTime = getUtcMoment(_this.startTime);
                    }
                    break;

                case 'shots':
                case 'strips':
                case 'stripSchedules':
                case 'schedules':
                case 'advancedSchedules':
                    if (_this.time) {
                        _this.time = getUtcMoment(_this.time);
                    }
                    if (_this.endTime) {
                        _this.endTime = getUtcMoment(_this.endTime);
                    }
                    _.each(['prepTime', 'shootTime', 'estTime'
                        // , 'duration'
                    ], function (prop){
                        _this[prop] = getEstTime(_this[prop]);
                    });

                    if (_this.date) {
                        _this.date = getUtcMoment(_this.date);
                    }
                    break;


                case 'documents':
                case 'materials':
                    _this.version = getCreated(_this.version);
                    break;
            }

            return _this;
        }

        function getCreated(item){
            if(item){
                if (item.createdAt) {
                    item.createdAt = MomentService.getMomentFromString(item.createdAt); //converts time to local time
                    item.createdAtT = MomentService.getTimestamp(item.createdAt);
                }

                if (item.updatedAt) {
                    item.updatedAt = MomentService.getMomentFromString(item.updatedAt);
                    item.updatedAtT = MomentService.getTimestamp(item.updatedAt);
                }

                if (!item.updatedAt && item.createdAt) {
                    item.updatedAt = item.createdAt;
                    item.updatedAtT = item.createdAtT;
                }
            }
            return item;
        }

        Resource.prototype.runConversions = function (collectionName) {
            var _this = this;
            _this = getCreated(_this);

            if (!collectionName) {
                collectionName = Resource.collectionName;
            }

            switch (collectionName) {
                case 'callsheets':
                    if (!_this.options) {
                        _this.options = {
                            hideClients: false,
                            hideExtras: false,
                            breaks: {}
                        };
                    }
                    if (!_this.templateId) {
                        _this.templateId = '56e4dcf0547dbf2c25b76996';
                    }
                    if (_this.type === undefined) {
                        _this.type = 1;
                    }
                    if (_this.status === undefined) {
                        _this.status = 0;//Draft;
                    }
                    _this.startDate = getUtcMoment(_this.startDate);
                    if (_this.advancedDate) {
                        _this.advancedDate = getUtcMoment(_this.advancedDate);
                    }
                    // if(! _this.address) _this.address={formatted_address:null};

                    /*formatted_address, url, address_components (for(var prop in address_components){if(address_components[prop].types[0] == 'postal_code'){addressGeo.code = address_components[prop].types[0]}})
                     */
                    break;

                case 'callsheetsSent':
                    _this.startDate = getUtcMoment(_this.startDate);
                    if (_this.advancedDate) {
                        _this.advancedDate = getUtcMoment(_this.advancedDate);
                    }
                    break;

                case 'extras':
                    _this = updateTimes(_this, true);
                    break;

                case 'callsheetInvitations':
                    _this = updateTimes(_this, false, true);


                    if (_this.confirmedAt) {
                        _this.confirmedAt = MomentService.getMomentFromString(_this.confirmedAt);
                    }
                    break;

                case 'callsheetInvitationsSent':
                    if (_this.info.calltime && _this.info.calltime.isTime) {
                        _this.info.calltime.value = getUtcMoment(_this.info.calltime.value);
                    }

                    _this.info.startDate = getUtcMoment(_this.info.startDate);

                    if (_this.lastPageViewedAt) {
                        _this.lastPageViewedAt = MomentService.getMomentFromString(_this.lastPageViewedAt);
                    }
                    if (_this.lastEmailViewedAt) {
                        _this.lastEmailViewedAt = MomentService.getMomentFromString(_this.lastEmailViewedAt);
                    }

                    if (_this.confirmedAt) {
                        _this.confirmedAt = MomentService.getMomentFromString(_this.confirmedAt);
                    }
                    break;

                case 'collaborators':
                    if (_this.lastPageViewedAt) {
                        _this.lastPageViewedAt = MomentService.getMomentFromString(_this.lastPageViewedAt);
                    }
                    break;


                case 'invoices':
                    _this.startDate = getUtcMoment(_this.startDate);
                    _this.endDate = getUtcMoment(_this.endDate);
                    break;


                case 'plans':
                    if (!_this.features) {
                        _this.features = {};
                    }
                    break;

                case 'planFeatures':
                    break;

                case 'schedulesSent':
                    if (_this.time) {
                        _this.time = getUtcMoment(_this.time);
                    }
                    if (!_this.type) {
                        _this.type = 1;
                    }
                    break;

                case 'temperatures':
                    if (_this.weather) {
                        if (_this.weather.sunset) {
                            _this.weather.sunset = getUtcMoment(_this.weather.sunset);
                        }
                        if (_this.weather.sunrise) {
                            _this.weather.sunrise = getUtcMoment(_this.weather.sunrise);
                        }
                    }
                    break;

                case 'topCalls':
                    _this.time = getUtcMoment(_this.time);
                    break;

                case 'settings':
                    _this.startTime = getUtcMoment(_this.startTime);
                    break;

                case 'shots':
                case 'strips':
                case 'stripSchedules':
                case 'schedules':
                case 'advancedSchedules':
                    if (_this.time) {
                        _this.time = getUtcMoment(_this.time);
                    }
                    if (_this.endTime) {
                        _this.endTime = getUtcMoment(_this.endTime);
                    }

                    _.each(['prepTime', 'shootTime', 'estTime'
                       // , 'duration'
                    ], function (prop){
                        _this[prop] = getEstTime(_this[prop]);
                    });

                    if (_this.date) {
                        _this.date = getUtcMoment(_this.date);
                    }

                    if (collectionName === 'schedules' || collectionName === 'advancedSchedules') {
                        if (!_this.type) {
                            _this.type = 1;
                        }
                    }

                    break;

                case 'shotsListOptions':
                case 'storyboardsListOptions':
                case 'moodboardsListOptions':
                    if (!_this.options) {
                        _this.options = {};
                    }
                    if (!_this.options.columns) {
                        _this.options.columns = Settings.Template;
                    }
                    if (!_this.options.column) {
                        _this.options.column = Settings.ColumnsPerRow[3].id;
                    }
                    if (!_this.options.ratio) {
                        _this.options.ratio = Settings.AspectRatios[1].id;
                    }
                    break;

                case 'todoCards':
                    if (_this.completedAt) {
                        _this.completedAt = MomentService.getMomentFromString(_this.completedAt);
                    }

                    _this.startDate = getDate(_this.startDate, true);
                    _this.dueDate = getDate(_this.dueDate, false);

                function getDate(d, isStart) {
                    if (d && d.value) {
                        if (typeof (d.value) === "string") {
                            d.value = d.hasTime ? getUtcMoment(d.value) : (isStart ? MomentService.getUtcMomentStartDay(d.value) : MomentService.getUtcMomentEndDay(d.value));
                        }
                    } else {
                        d = {value: null, hasTime: false};
                    }

                    return d;
                }

                    break;

                case 'users':
                    if (!_this.subscription) {
                        _this.subscription = {};
                    }
                    break;

                case 'documents':
                case 'materials':
                    _this.version = getCreated(_this.version);
                    break;
            }
        };

        function updateTimes(_this, updateCall, updateCalltime ){
            if (updateCalltime && _this.calltime && _this.calltime.isTime) {
                _this.calltime.value = getUtcMoment(_this.calltime.value);
            }
            if(_this.info) {
                if(updateCall) {
                    if (_this.info.call && _this.info.call.isTime) {
                        _this.info.call.value = getUtcMoment(_this.info.call.value);
                    }
                }
                _.each(['pickup', 'onset', 'costumes', 'hmu', 'wrap', 'note'], function (prop) {
                    if (_this.info[prop] && _this.info[prop].isTime) {
                        _this.info[prop].value = getUtcMoment(_this.info[prop].value);
                    }
                });
            }

            return _this;
        }

        Resource.prototype.replaceElementProps = function (props){
            //console.log('Resource.prototype.replaceElementProps');
            var _this = this;
            var changed;
            //set vars
            //props = Resource.runConversions(props);
            for(var prop in props) {
                var str = prop.split('.');
                if(str.length>1){
                    if(!_this[str[0]]){_this[str[0]] = {};}
                    if (!angular.equals(_this[str[0]][str[1]], props[prop])) {
                        _this[str[0]] = _.extend({}, _this[str[0]])
                        _this[str[0]][str[1]] = props[prop];
                        changed=true;
                    }
                }else {
                    if (!angular.equals(_this[prop], props[prop])) {
                        _this[prop] = props[prop];
                        changed=true;
                    }
                }
            }
            _this.runConversions();
            return changed;
        };

        return Resource;


        function getType() {
            if(collectionName.endsWith('ies')){
                return collectionName.substring(0, collectionName.length - 3) + 'y';
            }
            return collectionName.substring(0, collectionName.length - 1);
        }

        function getColorForInitials(initials) {
            return getNameColor(initials);
        }

        function loadImageProp(item, prop) {
            loadImageFromProp(item, prop, item[prop === 'path' ? '_id' : (prop + 'Id')]);
        }

        function loadImageFromProp(item, prop, val) {
            if (val && typeof(val) === 'object') {
                var isPath = prop === 'path',
                    prop1 = isPath ? '_id' : (prop + 'Id'),
                    pId = item[prop1],
                    pP = item[prop],
                    nId = val.id,
                    nP = val.path;
                if(isPath && !nP && pId === nId && pP !== nP){
                    //path not loaded
                }
                {
                    item[prop] = nP;
                    item[prop1] = nId;
                }
            }
        }

        function getCollectionName() {
            return collectionName;
        }
    }

    return ApiResource;

    /**
     * Generates a color code string based on the input string.
     *
     * @param {string} init - The input string used to generate the color code. If null, the function returns null.
     * @return {string|null} A color code string derived from the input string or null if the input is null.
     */
    function getNameColor(init) {
        if (init != null) {
            var c = 'l l', l = init.length;
            for (var i = 0; i < l; i++) {
                var r = parseInt((91 - init.charCodeAt(i)) / 5, 10);
                if(r>5){r=1;}
                c += r;
            }
            if (l === 1) {
                c += '0';
            }
            return c;
        }
        return null;
    }

    /**
     * Retrieves the list of roles.
     *
     * @return {Array|string|Object} The roles data stored in the `Roles` variable.
     */
    function getRoles() {
        return Roles;
    }

    function randomString(length) {
        var s = '';
        var randomchar = function () {
            var n = Math.floor(Math.random() * 62);
            if (n < 10) {
                return n;
            } //1-10
            if (n < 36) {
                return String.fromCharCode(n + 55);
            } //A-Z
            return String.fromCharCode(n + 61); //a-z
        };
        while (s.length < length) {
            s += randomchar();
        }
        return s;
    }

    function getCustomTime(v, timeFormat, withEmpty) {
        if (!v) {
            return withEmpty ? '–' : null;
        }
        if (v.isTime) {
            return v.value.format(timeFormat);
        }
        else {
            return v.value;
        }
    }

    function getRolesText(itemRoles, roleType, depId, getPosition, begining, end) {
        var itemText = '';
        if (!begining) {
            begining = '<div style="float:{be}">';
        }
        if (!end) {
            end = '</div>';
        }
        if (itemRoles) {
            for (var i = 0, m = itemRoles.length; i < m; i++) {
                var r = itemRoles[i], n = '';

                if (roleType != null && roleType !== r.type || depId != null && depId !== 0 && depId !== r.depId || depId === 0 && r.depId !== undefined) {

                } else {
                    if (r.type === 4) {
                        n = r.name;
                    }
                    else if (r.type === 2) {
                        if (r.posId) {
                            var p = getPosition(r.posId);
                            if (p) {
                                n = p.shortName;
                            }
                        }
                        if (!n && r.name) {
                            n = r.name;
                        }
                    } else {
                        n = '"' + r.name + '"';
                    }
                    if (n && n !== '') {
                        itemText += begining.replace('{be}', (i === n - 1 ? 'left' : 'none')) + n + end;
                    }
                }
            }
        }
        return itemText;
    }
    function getTime(v, timeFormat) {
        if (!v) {
            return '–';
        }
        return v.format(timeFormat);
    }

    function getUtcMoment(date, withNull){
        return MomentService.getUtcMoment(date, withNull);
    }

    function getEstTime(v){
        return (v * 100.0) / 100.0;
    }
}

