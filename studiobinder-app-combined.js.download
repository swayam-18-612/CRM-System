angular.module('satellizer.local', [
    'services.sbHttp',
    'services.stateService',
    'satellizer.config',
    'satellizer.shared'
])
    .factory('SatellizerLocal', SatellizerLocal);
SatellizerLocal.$inject = ['SbHttpService', 'SBStateService', 'SatellizerShared', 'SatellizerConfig', 'StateHeadersService'];
function SatellizerLocal(SbHttpService, SBStateService,  SatellizerShared, SatellizerConfig, StateHeadersService) {
    return {
        onSuccessLogin: onSuccessLogin,
        onLogin: onLogin,
        login: login,
        signup: signup
    };

    function onSuccessLogin(user, onsuccess) {
        var res = SatellizerShared.setToken(user);
        onsuccess({user: user, res: res});
        return user;
    }

    function onLogin(response, onsuccess) {
        SatellizerShared.setToken(response);
        onsuccess(response);
        return response;
    }

    function login(user, onSuccess, onError) {
        return SbHttpService.postRequest(SatellizerConfig.loginUrl, user, getHeaders(), function (response) {
            onLogin(response, onSuccess);
        }, onError);
    }

    function signup(isBetaRegister, user, onSuccess, onError) {
        return SbHttpService.postRequest(isBetaRegister ? SatellizerConfig.betaSignupUrl : SatellizerConfig.signupUrl, user, getHeaders(), function (response) {
            if (SatellizerConfig.loginOnSignup) {
                onLogin(response, onSuccess);
            } else {
                SBStateService.$$setUrl(SatellizerConfig.signupRedirect);
            }
            return response;
        }, onError);
    }

    function getHeaders() {
        return StateHeadersService.getHttpHeaders(SBStateService.getCurrentStateName());
    }
}


angular.module('satellizer.oauth', [
    'satellizer.config',
    'satellizer.shared',
    'satellizer.oauth1',
    'satellizer.oauth2'
])
    .factory('SatellizerOauth', SatellizerOauth);
SatellizerOauth.$inject = ['$http', 'SatellizerConfig', 'SatellizerShared', 'SatellizerOauth1', 'SatellizerOauth2'];
function SatellizerOauth( $http, SatellizerConfig, SatellizerShared, SatellizerOauth1, SatellizerOauth2) {
    var oauth = {
        authenticate : authenticate,
        unlink : unlink
    };

    return oauth;

    function authenticate(name, isLinking, userData) {
        var provider = SatellizerConfig.providers[name].type === '1.0' ? new SatellizerOauth1() : new SatellizerOauth2();

        return provider.open(SatellizerConfig.providers[name], userData || {})
            .then(function(response) {
                SatellizerShared.setToken(response, isLinking);
                return response;
            });
    }

    function unlink(provider) {
        return $http.get(SatellizerConfig.unlinkUrl + provider);
    }
}

angular.module('satellizer.oauth1', [
    'satellizer.popup'
])
    .factory('SatellizerOauth1', SatellizerOauth1);
SatellizerOauth1.$inject = [ '$http', 'SatellizerPopup'];
function SatellizerOauth1( $http, SatellizerPopup) {
    return function () {

        var defaults = {
            url: null,
            name: null,
            popupOptions: null
        };

        var oauth1 = {
            open: open,
            exchangeForToken: exchangeForToken,
            buildQueryString: buildQueryString
        };

        return oauth1;

        function open(options, userData) {
            _.extend(defaults, options);
            return SatellizerPopup.open(defaults.url, defaults.popupOptions)
                .then(function (response) {
                    return exchangeForToken(response, userData);
                });
        }

        function exchangeForToken(oauthData, userData) {
            var data = _.extend({}, userData, oauthData);
            var qs = buildQueryString(data);
            return $http.get(defaults.url + '?' + qs);
        }

        function buildQueryString(obj) {
            var str = [];
            _.each(obj, function (value, key) {
                str.push(encodeURIComponent(key) + '=' + encodeURIComponent(value));
            });
            return str.join('&');
        }
    };
}

angular.module('satellizer.oauth2', [
    'satellizer.popup',
    'satellizer.utils'
])
    .factory('SatellizerOauth2', SatellizerOauth2);
SatellizerOauth2.$inject = [ '$http', 'SatellizerPopup', 'SatellizerUtils'];
function SatellizerOauth2( $http, SatellizerPopup, SatellizerUtils) {
    return function () {

        var defaults = {
            url: null,
            name: null,
            scope: null,
            scopeDelimiter: null,
            clientId: null,
            redirectUri: null,
            popupOptions: null,
            authorizationEndpoint: null,
            requiredUrlParams: null,
            optionalUrlParams: null,
            defaultUrlParams: ['response_type', 'client_id', 'redirect_uri'],
            responseType: 'code'
        };

        var oauth2 = {
            open: open,
            exchangeForToken: exchangeForToken,
            buildUrl: buildUrl,
            buildQueryString: buildQueryString
        };

        return oauth2;

        function open(options, userData) {
            _.extend(defaults, options);
            var url = buildUrl();

            return SatellizerPopup.open(url, defaults.popupOptions)
                .then(function (oauthData) {
                    if (defaults.responseType === 'token') {
                        return oauthData;
                    } else {
                        return exchangeForToken(oauthData, userData);
                    }
                });

        }

        function exchangeForToken(oauthData, userData) {
            var data = _.extend({}, userData, {
                code: oauthData.code,
                clientId: defaults.clientId,
                redirectUri: defaults.redirectUri
            });

            return $http.post(defaults.url, data);
        }

        function buildUrl() {
            var baseUrl = defaults.authorizationEndpoint;
            var qs = buildQueryString();
            return [baseUrl, qs].join('?');
        }

        function buildQueryString() {
            var keyValuePairs = [];
            var urlParams = ['defaultUrlParams', 'requiredUrlParams', 'optionalUrlParams'];

            _.each(urlParams, function (params) {
                _.each(defaults[params], function (paramName) {
                    var camelizedName = SatellizerUtils.camelCase(paramName);
                    var paramValue = defaults[camelizedName];

                    if (paramName === 'scope' && Array.isArray(paramValue)) {
                        paramValue = paramValue.join(defaults.scopeDelimiter);

                        if (defaults.scopePrefix) {
                            paramValue = [defaults.scopePrefix, paramValue].join(defaults.scopeDelimiter);
                        }
                    }

                    keyValuePairs.push([paramName, paramValue]);
                });
            });

            return keyValuePairs.map(function (pair) {
                return pair.join('=');
            }).join('&');
        }
    };
}

angular.module('satellizer.popup', [
    'satellizer.utils'
])
    .factory('SatellizerPopup',SatellizerPopup);
SatellizerPopup.$inject = ['$q', '$interval', '$window', 'SatellizerUtils'];
function SatellizerPopup($q, $interval, $window, SatellizerUtils) {
    var popupWindow = null;
    var polling = null;

    var popup = {
        popupWindow: popupWindow,
        open: open,
        pollPopup: pollPopup,
        prepareOptions:prepareOptions,
        stringifyOptions:stringifyOptions
    };

    return popup;

    function open(url, options) {
        var optionsString = stringifyOptions(prepareOptions(options || {}));

        popupWindow = window.open(url, '_blank', optionsString);

        if (popupWindow && popupWindow.focus) {
            popupWindow.focus();
        }

        return pollPopup();
    }

    function pollPopup() {
        var deferred = $q.defer();
        polling = $interval(function() {
            try {
                if (popupWindow.document.domain === document.domain && (popupWindow.location.search || popupWindow.location.hash)) {
                    var queryParams = popupWindow.location.search.substring(1).replace(/\/$/, '');
                    var hashParams = popupWindow.location.hash.substring(1).replace(/\/$/, '');
                    var hash = SatellizerUtils.parseQueryString(hashParams);
                    var qs = SatellizerUtils.parseQueryString(queryParams);

                    _.extend(qs, hash);

                    if (qs.error) {
                        deferred.reject({ error: qs.error });
                    } else {
                        deferred.resolve(qs);
                    }

                    popupWindow.close();
                    $interval.cancel(polling);
                }
            } catch (error) {}

            if (popupWindow.closed) {
                $interval.cancel(polling);
                deferred.reject({ data: 'Authorization Failed' });
            }
        }, 35);
        return deferred.promise;
    }

    function prepareOptions(options) {
        var width = options.width || 500;
        var height = options.height || 500;
        return _.extend({
            width: width,
            height: height,
            left: $window.screenX + (($window.outerWidth - width) / 2),
            top: $window.screenY + (($window.outerHeight - height) / 2.5)
        }, options);
    }

    function stringifyOptions(options) {
        var parts = [];
        _.each(options, function(value, key) {
            parts.push(key + '=' + value);
        });
        return parts.join(',');
    }
}


angular.module('satellizer.shared', [
    'satellizer.config',
    'services.stateService'
])
    .factory('SatellizerShared', SatellizerSharedFactory);
SatellizerSharedFactory.$inject = ['$q', 'SBStateService', 'SatellizerConfig', 'CookiesService'];
function SatellizerSharedFactory($q, SBStateService, SatellizerConfig, CookiesService) {
    var shared = {
        getToken: getToken,
        setToken: setToken,
        getCurrentUser: getCurrentUser,
        logout: logout
    };

    return shared;

    function getToken() {
        return CookiesService.getCookie(SatellizerConfig.tokenName);
        /*var tokenName = SatellizerConfig.tokenPrefix ? SatellizerConfig.tokenPrefix + '_' + SatellizerConfig.tokenName : SatellizerConfig.tokenName;
         return $window.localStorage[tokenName];     */
    }

    function setToken(response, isLinking) {
        var data = response.data;
        var token = response.access_token || data[SatellizerConfig.tokenName];

        if (!token) {
            throw new Error('Expecting a token named "' + SatellizerConfig.tokenName + '" but instead got: ' + JSON.stringify(response.data));
        }
        var user = data.user;
        var u = null;
        if(user) {
            u = {
                _id: user._id,
                name: user.name,
                email: user.email,
                profilePictureURL: user.profilePictureURL,
                profilePictureURLId: user.profilePictureURLId,
                role: user.role,
                intercomHmac: user.intercomHmac,
            };
        }

        CookiesService.setSessionCookieUser(u);
        CookiesService.setCookie(SatellizerConfig.tokenName, token);
        //$window.localStorage[tokenName] = token;

        /*if (SatellizerConfig.loginRedirect && !isLinking) {
         $location.path(SatellizerConfig.loginRedirect());
         }*/
        return {paymentFailed: data.paymentFailed, lowQuota: data.lowQuota, company: data.company};
    }

    function getCurrentUser(){
        if(CookiesService.isAuthenticatedUser()){
            return CookiesService.getSessionCookieUser() ;
        }else{
            CookiesService.setSessionCookieUser(null);
            return null;
        }
    }

    function logout(redirectUrl) {
        CookiesService.clearCookies();
       // CookiesService.removeCookie(SatellizerConfig.tokenName);
        CookiesService.setSessionCookieUser(null);
        SBStateService.loadLogin(redirectUrl);
        //SBStateService.$$setUrl(SatellizerConfig.logoutRedirect ? SatellizerConfig.logoutRedirect: '/');
        //return $q.when();
    }
}


angular.module('satellizer.utils', [])
    .service('SatellizerUtils', SatellizerUtils);
function SatellizerUtils() {
    var utils = {
        camelCase: camelCase,
        parseQueryString: parseQueryString
    };

    return utils;

    function camelCase(name) {
        return name.replace(/([\:\-\_]+(.))/g, function(_, separator, letter, offset) {
            return offset ? letter.toUpperCase() : letter;
        });
    }

    function parseQueryString(keyValue) {
        var obj = {}, key, value;
        _.each((keyValue || '').split('&'), function(keyValue) {
            if (keyValue) {
                value = keyValue.split('=');
                key = decodeURIComponent(value[0]);
                obj[key] = angular.isDefined(value[1]) ? decodeURIComponent(value[1]) : true;
            }
        });
        return obj;
    }
}

// Base64.js Polyfill (@davidchambers)
(function() {
    var object = typeof exports !== 'undefined' ? exports : this;
    var chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';

    function InvalidCharacterError(message) {
        this.message = message;
    }
    InvalidCharacterError.prototype = new Error;
    InvalidCharacterError.prototype.name = 'InvalidCharacterError';

    object.btoa || (
        object.btoa = function(input) {
            var str = String(input);
            for (var block, charCode, idx = 0, map = chars, output = ''; str.charAt(idx | 0) || (map = '=', idx % 1); output += map.charAt(63 & block >> 8 - idx % 1 * 8)) {
                charCode = str.charCodeAt(idx += 3 / 4);
                if (charCode > 0xFF) {
                    throw new InvalidCharacterError("'btoa' failed: The string to be encoded contains characters outside of the Latin1 range.");
                }
                block = block << 8 | charCode;
            }
            return output;
        });

    object.atob || (
        object.atob = function(input) {
            var str = String(input).replace(/=+$/, '');
            if (str.length % 4 === 1) {
                throw new InvalidCharacterError("'atob' failed: The string to be decoded is not correctly encoded.");
            }
            for (var bc = 0, bs, buffer, idx = 0, output = ''; buffer = str.charAt(idx++); ~buffer && (bs = bc % 4 ? bs * 64 + buffer : buffer, bc++ % 4) ? output += String.fromCharCode(255 & bs >> (-2 * bc & 6)) : 0) {
                buffer = chars.indexOf(buffer);
            }
            return output;
        });
}());
// authorization service's purpose is to wrap up authorize functionality
// it basically just checks to see if the principal is authenticated and checks the root state
// to see if there is a state that needs to be authorized. if so, it does a role check.
// this is used by the state resolver to make sure when you refresh, hard navigate, or drop onto a
// route, the app resolves your identity before it does an authorize check. after that,
// authorize is called from $stateChangeStart to make sure the principal is allowed to change to
// the desired state
//todo figure out  how to use authorize instead of  onBeforeStateChange from StateChangeRunBlock
angular.module('security.authorization', [
    'security.principal'
])
.service('SBCurrentState', SBCurrentState)
.service('SBAuthorization', SBAuthorization);

SBAuthorization.$inject = ['SBCurrentState', 'SBStateService', 'SBPrincipal'];

function SBAuthorization(SBCurrentState, SBStateService, SBPrincipal) {
    return {
        authorize: function () {
            var forceIndentity = false;
            return SBPrincipal.identity(forceIndentity)
                .then(onAuthorized);

            function onAuthorized() {
                var isAuthenticated = SBPrincipal.isAuthenticated();
                var fromState = SBStateService.getCurrentState,
                    fromStateName = fromState.name,
                    toState = SBCurrentState.toState,
                    toStateName = toState.name,
                    toParams = Object.assign({}, angular.copy(SBCurrentState.getCurrentStateParams())),
                    data = toState.data;

                if (data.minRole && !SBPrincipal.isInAnyRole(data.roles)) {
                    if (isAuthenticated) {
                        return goToState('user.nonauthorized', undefined, {location: false});
                    } // user is signed in but not authorized for desired state
                    else {
                        // user is not authenticated. store the state they wanted before you
                        // send them to the signin state, so you can return them when you're done
                        SBCurrentState.returnToState = SBCurrentState.toState;
                        SBCurrentState.returnToStateParams = SBCurrentState.toStateParams;

                        return goToState(SBPrincipal.security.loginState, undefined, {location: false});
                    }
                }
            }

            function goToState(stateName, params, options) {
                return $state.target(stateName, params, options);
            }
        }
    };
}

function SBCurrentState() {
    return {
        returnToState: null,
        returnToStateParams: null,
        toState: null,
        toStateParams: null,
    }
}

// principal is a service that tracks the user's identity.
// calling identity() returns a promise while it does what you need it to do
// to look up the signed-in user's identity info. for example, it could make an
// HTTP request to a rest endpoint which returns the user's name, roles, etc.
// after validating an auth token in a cookie. it will only do this identity lookup
// once, when the application first runs. you can force re-request it by calling identity(true)
angular.module('security.principal', [
    'security.service'
])
.service('SBPrincipal', SBPrincipal);

SBPrincipal.$inject = ['$q', 'security', '$timeout'];

function SBPrincipal($q, security, $timeout) {
    var _identity = undefined,
        _authenticated = false;

    return {
        security: security,

        isIdentityResolved: function() {
            return angular.isDefined(_identity);
        },

        isAuthenticated: function() {
            return _authenticated;
        },

        isInRole: function(role) {
            if (!_authenticated || !_identity.roles) return false;

            return _identity.roles.indexOf(role) !== -1;
        },

        isInAnyRole: function(roles) {
            if (!_authenticated || !_identity.roles) return false;

            for (var i = 0; i < roles.length; i++) {
                if (this.isInRole(roles[i])) return true;
            }

            return false;
        },

        authenticate: function(identity) {
            _identity = identity;
            _authenticated = identity != null;
        },

        identity: function(force) {
            var deferred = $q.defer();

            if (force === true) {_identity = undefined;}

            // check and see if we have retrieved the identity data from the server. if we have, reuse it by immediately resolving
            if (angular.isDefined(_identity)) {
                deferred.resolve(_identity);

                return deferred.promise;
            }

            //otherwise, retrieve the identity data from the server, update the identity object, and then resolve.
            $http.get('/svc/account/identity', { ignoreErrors: true })
                .success(function(data) {
                    next(data, true);
                })
                .error(function (err) {
                    console.log(err);
                    next(null, false);
                });
            // for the sake of the demo, fake the lookup by using a timeout to create a valid
            // fake identity. in reality,  you'll want something more like the $http request
            // commented out above. in this example, we fake looking up to find the user is
            // not logged in
            var self = this;
            $timeout(function () {
                self.authenticate(null);
                deferred.resolve(_identity);
            }, 1000);

            return deferred.promise;

            function next(data, isAuth) {
                _identity = data;
                _authenticated = isAuth;
                deferred.resolve(_identity);
            }
        }
    };
}


