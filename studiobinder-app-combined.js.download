angular.module('dropdowns.esttime.controller.service', [
    'dropdowns.drpnonclosed.controller.service',
])
.service('SbEsttimeCtrlService', SbEsttimeCtrlService);
SbEsttimeCtrlService.$inject = ['SBFieldTypesService', 'SBDrpNonClosedCtrlService'];
function SbEsttimeCtrlService(SBFieldTypesService, SBDrpNonClosedCtrlService) {
    //console.log('SbEsttimeCtrl');
    return function ($ctrl, $element, $attrs) {

        var withoutTemplateScope = true;

        $ctrl.SBFieldMethods = SBFieldTypesService.SBFieldMethods;

        $ctrl.setInputField = false;

        $ctrl.generateDrpMenuContent = generateDrpMenuContent;
        $ctrl.initDrp = initDrp;
        if(!$ctrl.preDisplayValue) {
            $ctrl.preDisplayValue = preDisplayValue;
        }

        $ctrl = new SBDrpNonClosedCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

        return $ctrl;

        function initDrp() {
            $ctrl.tabIndex = $ctrl.tabIndex ? $ctrl.tabIndex : null;
        }

        function generateDrpMenuContent() {
            return {
                $ctrl: {
                    time: $ctrl.time,
                    onSelect: $ctrl.onSelect
                },
                template: ($ctrl.hasRemove ? ("has-remove='" + $ctrl.hasRemove + "' ") : '') +
                    ($ctrl.removeText ? ("remove-text='" + $ctrl.removeText + "' ") : '') +
                    "time='::$ctrl.time' " +
                    "on-select='$ctrl.onSelect(result)' "
            };
        }

        function preDisplayValue() {
            //console.log('SbEsttimeCtrlService.preDisplayValue');
            $ctrl.prevValue = angular.copy($ctrl.value);

            $ctrl.defaultTime = $ctrl.isRange ? {from: null, to:null} : ($ctrl.defaultTime ? parseFloat($ctrl.defaultTime) : 0);
            $ctrl.time = $ctrl.isRange ? {
                from: get($ctrl.prevValue ? $ctrl.prevValue.from : null),
                to: get($ctrl.prevValue ? $ctrl.prevValue.to : null)
             } : get($ctrl.prevValue);

            function get(v){
               return $ctrl.SBFieldMethods.getTimeFromSeconds(v ? v : $ctrl.defaultTime, {
                    isDuration: $ctrl.isDuration,
                    isTimecode: $ctrl.isTimecode,
                    isRange: $ctrl.isRange
                }, $ctrl.config);
            }
        }
    }
}

angular.module('dropdowns.nonclosed.controller.service', [
    'dropdowns.sbDropdown.controller.service'
])
.service('SBNonClosedCtrlService', SBNonClosedCtrlService);

SBNonClosedCtrlService.$inject = ['SBFieldInitCtrlService'];
function SBNonClosedCtrlService(SBFieldInitCtrlService) {

    return function (sbNonClosedService, $ctrl, $element, $attrs, withoutTemplateScope) {

        $ctrl.nonClosedDrp = true;
        if (!$ctrl.propType) {
            console.warn('Parent for SBDrpNonClosedCtrlService must define prop $ctrl.propType');
        }

        if (!$ctrl.generateDrpMenuContent) {
            console.warn('Parent for SBDrpNonClosedCtrlService must define method $ctrl.generateDrpMenuContent');
        }

        if ($ctrl.dontClosePopoverOnClick === undefined) {
            $ctrl.dontClosePopoverOnClick = true;
        }

        $ctrl.$onDestroy = $onDestroy;

        $ctrl = new SBFieldInitCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

        if(!$ctrl.onInitFieldLoaded) {
            $ctrl.onInitFieldLoaded = onInitFieldLoaded;
        }

        if(!$ctrl.setDisplayValue) {
            $ctrl.setDisplayValue = setDisplayValue;
        }

        if(!$ctrl.preselect) {
            $ctrl.preselect = preselect;
        }

        $ctrl.$onInit = $onInit;

        return $ctrl;

        function $onInit() {
            $ctrl.withSaveOnTouchScreen = $ctrl.LCS.isTouchScreen;

            if ($ctrl.initDrp) {
                $ctrl.initDrp();
            }

            $ctrl = new sbNonClosedService($ctrl, $element, $attrs, withoutTemplateScope);
        }

        function onInitFieldLoaded() {
            $ctrl.spanText = $ctrl.element.querySelector('#spanItemText');

            $ctrl.LCS.addClass($ctrl.spanText, 'empty');
            if ($ctrl.fieldClass) {
                $ctrl.LCS.addClass($ctrl.inputField, $ctrl.fieldClass);
                $ctrl.LCS.addClass($ctrl.spanText, $ctrl.fieldClass);
            }

            if ($ctrl.minWidth) {
                $ctrl.LCS.setCSSStyle($ctrl.spanText, 'min-width', $ctrl.minWidth);
            }

            $ctrl.LCS.addClass($ctrl.element, $ctrl.element.tagName.toLowerCase() +
                ' display-block clearfix wrap-dd-select ' +
                ($ctrl.cClassAttr ? $ctrl.cClassAttr : '')
            );

            $ctrl.onRepeatFieldLoaded();
        }

        function $onDestroy() {
            if ($ctrl.onInitDestroy) {
                $ctrl.onInitDestroy();
            }
        }

        function preselect(result) {
            if(result){ $ctrl.setNewValue(result.e, result.value);}
        }

        function setDisplayValue() {
            if($ctrl.preDisplayValue){
                $ctrl.preDisplayValue();
            }
            var info = $ctrl.getDisplayValue($ctrl.value);
            $ctrl.spanText.innerHTML = info.content || info.placeholder;
            $ctrl.LCS[info.hasPlaceholderCls ? 'addClass' : 'removeClass']($ctrl.spanText, 'empty');
        }
    }
}

