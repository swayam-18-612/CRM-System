                size: 'medium',
                transp: ' ',
                template: getBasePopupTemplateByTag('shot-specs')
            },

            shotNumbering: {
                type: 'shotNumbering',
                size: 'medium',
                transp: ' ',
                template: getBasePopupTemplateByTag('shot-numbering')
            },

            aspectRatio: {
                type: 'aspectRatio',
                size: '690',
                transp: ' ',
                template: getBasePopupTemplateByTag('aspect-ratio')
            },

            shotViewTypes: {
                type: 'shotViewTypes',
                size: 'medium',
                transp: ' ',
                template: getBasePopupTemplateByTag('shot-view-types')
            },

            shotUploads: {
                type: 'shotUploads',
                size: ' ',
                transp: ' ',
                template: getBasePopupTemplateByTag('shot-uploads')
            },

            createFirstShotList: {
                type: 'Create',
                size: 'fieldset',
                transp: 'transparent',
                template: getBasePopupTemplateByTag('first-shotlist')
            },
            createListOrScript: {
                type: 'CreateList',
                size: 'fieldset',
                transp: ' ',
                template: getBasePopupTemplateByTag('first-list-or-script')
            },
        };
    }
}

angular.module('product.shots.group.component',[
    'apiPagination.Shots',
    'product.shots.group.overloaded.controller.service'
])
.component('shotGroup', treeGroupComponentParams( 'ShotGroupCtrl'))
.controller('ShotGroupCtrl', ShotGroupCtrl);
ShotGroupCtrl.$inject = ['ShotsPagination', 'ShotGroupOverloadedCtrlService', '$element'];
function ShotGroupCtrl(Pagination, ShotGroupOverloadedCtrlService, $element) {
    var $ctrl = this;
    $ctrl = new ShotGroupOverloadedCtrlService($ctrl, $element, Pagination);
}

angular.module('product.shots.group.controller.service', [
    'product.shots.group.init.controller.service',
    'product.shots.item.edit.component',
    'product.shots.item.remove.component',
    'product.shots.item.grid.component'
])
.service('ShotGroupCtrlService', ShotGroupCtrlService);
ShotGroupCtrlService.$inject = ['ShotGroupInitCtrlService'];
function ShotGroupCtrlService(ShotGroupInitCtrlService) {
    return function($ctrl, $element, Pagination){
        if(!$ctrl.createMethodName) {
            $ctrl.createMethodName = 'createItemWithEvent';
        }

        if(!$ctrl.createMethodNameInMore) {
            $ctrl.createMethodNameInMore = $ctrl.createMethodName;
        }

        if(!$ctrl.btnUploadText) {
            $ctrl.btnUploadText = 'Upload Images';
        }

        if(!$ctrl.getGroupEmptyButtons) {
            $ctrl.getGroupEmptyButtons = getGroupEmptyButtons;
        }

        if(!$ctrl.getGroupEmptyText) {
            $ctrl.getGroupEmptyText = getGroupEmptyText;
        }

        $ctrl.onGroupInitOther = onGroupInitOther;
        if(!$ctrl.getGroupButtons) {
            $ctrl.getGroupButtons = getGroupButtons;
        }

        $ctrl.getRowMobileActions = getRowMobileActions;
        $ctrl.getMorePopoverTemplate = getMorePopoverTemplate;
        $ctrl.getMoreBtnCls = getMoreBtnCls;


        $ctrl.getKeyEvents = getKeyEvents;
        $ctrl.getEditPopupParams = getEditPopupParams;
        $ctrl.getNewPopupParamsOther = getNewPopupParamsOther;
        $ctrl.getNewParams = getNewParams;
        $ctrl.createItem = createItem;

        $ctrl.onListChanged = onListChanged;

        $ctrl.getPosition = getPosition;


        $ctrl.getAB = getAB;
        $ctrl.getC = getC;

        if(!$ctrl.getAL){
            $ctrl.getAL = getAL;
        }

        if(!$ctrl.processGridViewItem) {
            $ctrl.processGridViewItem = processGridViewItem;
        }

        if(!$ctrl.processListItemColumn){
            $ctrl.processListItemColumn = processListItemColumn;
        }

        if(!$ctrl.processListItemColumnInit) {
            $ctrl.processListItemColumnInit = processListItemColumn;
        }

        if(!$ctrl.getSidebarTwo) {
            $ctrl.getSidebarTwo = getSidebarTwo;
        }

        if(!$ctrl.hasTwoSidebars) {
            $ctrl.hasTwoSidebars = hasTwoSidebars;
        }

        if(!$ctrl.isSidebarLeft) {
            $ctrl.isSidebarLeft = isSidebarLeft;
        }

        if(!$ctrl.getGroupEmptyHeader) {
            $ctrl.getGroupEmptyHeader = getGroupEmptyHeader;
        }

        if(!$ctrl.isLoadOnlySelected) {
            $ctrl.isLoadOnlySelected = isLoadOnlySelected;
        }

        if(!$ctrl.showColumnCond) {
            $ctrl.showColumnCond = showColumnCond;
        }

        $ctrl.getGroupItemAttributes = getGroupItemAttributes;
        $ctrl.addNewList = addNewList;
        if(!$ctrl.getRowAfter){
            $ctrl.getRowAfter = getRowAfter;
        }

        $ctrl.getAvailableTimeColumns = getAvailableTimeColumns;

        if(!$ctrl.getClipboardProcessingParams) {
            $ctrl.getClipboardProcessingParams = getClipboardProcessingParams;
        }

        $ctrl.setIsComp = setIsComp;

        if(!$ctrl.getNote) {
            $ctrl.getNote = getNote;
        }

        if(!$ctrl.getLogo) {
            $ctrl.getLogo = getLogo;
        }

        $ctrl.isTimeCols = isTimeCols;
        $ctrl.getGridBulletedTimes = getGridBulletedTimes;
        $ctrl.canMove = canMove;

        if(!$ctrl.canRemove) {
            $ctrl.canRemove = canRemove;
        }

        $ctrl.toggleScene = toggleScene;

        if(!$ctrl.createItemWithEvent) {
            $ctrl.createItemWithEvent = createItemWithEvent;
        }

        if(!$ctrl.getNewPopupParamsOtherExt) {
            $ctrl.getNewPopupParamsOtherExt = getNewPopupParamsOtherExt;
        }

        $ctrl.onSuccessPopupNewItem = onSuccessPopupNewItem;

        if(!$ctrl.getDefaultBannerColor) {
            $ctrl.getDefaultBannerColor = getDefaultBannerColor;
        }

        if(!$ctrl.showInlineActionBtns) {
            $ctrl.showInlineActionBtns = showInlineActionBtns;
        }

        if(!$ctrl.getInlineActions) {
            $ctrl.getInlineActions = getInlineActions;
        }

        if($ctrl.showOnlyRemovebBtn && !$ctrl.getNonMobileBtns) {
            $ctrl.getNonMobileBtns = getNonMobileBtns;
        }

        $ctrl = new ShotGroupInitCtrlService($ctrl, $element, Pagination);

        return $ctrl;

        function getNonMobileBtns(isHeader, isMobile, item) {
            return item && !isHeader ? (item.type === $ctrl.ShotTypes.Shot ? get() : $ctrl.getNonMobileBtnsInit(isHeader, item)) : '';

            function get() {
                return $ctrl.canEdit ? ('<button type="button" class="btnRemove sbup-DashboardItem-action with-hover with-transition ' + $ctrl.getClickEventName('remove') + '">' + $ctrl.LCS.getISBDiv('cancel') + '</button>') : '';
            }
        }

        function getInlineActions(isHeader, item) {
            if ($ctrl.isPrintLayout || isHeader || !item || !$ctrl.getColumnByProp('likes', true) ||
                item && item.type !== $ctrl.ShotTypes.Shot) {
                return '';
            }

            var canLike = $ctrl.canLikeItems(); //if is a user or collab not general
            return !canLike ? '' : ('<button type="button" class="sbup-DashboardItem-action btnLike ' + ($ctrl.canEdit ? ' canEdit ' : '') + $ctrl.getClickEventName('applyLike') + '">' + $ctrl.LCS.getISBDiv('heart') + '</button>');
        }

        function showInlineActionBtns(){
            return $ctrl.isGridView;
        }

        function getDefaultBannerColor(){
            return $ctrl.LCS.shotBannerColor;
        }

        function canRemove(item){
            return !$ctrl.ShotTypes ||
                !($ctrl.ShotTypes && (item.type === $ctrl.ShotTypes.Setup && _.filter($ctrl.list.items, {type: $ctrl.ShotTypes.Setup}).length === 1));
        }

        function canMove(item) { //since move between segments
            //move only setups
            return item.type === $ctrl.ShotTypes.Setup &&  _.filter($ctrl.list.items, {type: $ctrl.ShotTypes.Setup}).length > 1;
        }

        function getGridBulletedTimes(listCols, item, canEdit, textOnly, isShot, isStacked) {
            var cols = _.sortBy(_.filter(listCols, function (c) {
                return $ctrl.isTimeCols(c);
            }), 'order').map(function (c) {
                return $ctrl.isComp && (c.prop === 'time' || c.prop === 'endTime' || c.prop === 'estTime') ?
                    _.extend({isComp: true}, c) : c;
            })
            return isShot ? $ctrl.getGridItemDescriptions(cols, item, canEdit, textOnly, false, false, isStacked ? 'stacked' : 'inline-block with-padding-left with-padding-right') : '';
        }

        function isTimeCols(c){
            return c.type === 11 || c.type === 12 || c.type === 44;//EstTime, Time, Duration
        }
        function getLogo(item, prop , cls1, other) {
            var c1 = $ctrl.getColumnByProp(prop || 'logo', false);
            return c1 ? get($ctrl.getImageTemplate(item, _.extend({}, c1, other))) : '';

            function get(c) {
                return $ctrl.isMasonary ? c :
                    ('<div class="storylogo ' + ((cls1 || '') + ' ' +  ($ctrl.isGridView ? '' : c1.colCls)) + ' no-drag"><div class="stretchy-wrapper"><div>' + c + '</div></div></div>');
            }
        }

        function getClipboardProcessingParams(params, extraParam) {
            console.log('getClipboardProcessingParams');
            if($ctrl.currentList && $ctrl.currentList.type === 5){ //script type
                if (params.opType === 1) {//Move
                    //move from script list to custom list
                    if(extraParam && extraParam.selectedList && extraParam.selectedList.type === 6){
                        add();
                    }
                }else if(params.opType === 2) {//Duplicate
                    add();
                }
            }
            return params;

            function add(){
                params.itemUpdates = {
                    listType: 6,
                    scriptId: null,
                    stripId: null
                }
            }
        }

        function getAvailableTimeColumns(){
            return _.filter($ctrl.filtersService.listCols, function (c){
                return c && ['prepTime', 'shootTime', 'estTime', 'duration','runtime', 'time', 'endTime'].indexOf(c.prop) !== -1;
            }).map(function (c){return c.prop;});
        }

        function getRowAfter(item, isMobile, isMobileRowDetails, prop) {
            return (isMobile && !isMobileRowDetails && item.type !== 0 && (!$ctrl.ShotTypes || $ctrl.ShotTypes && item.type === $ctrl.ShotTypes.Shot)) ? (getImg() + getOptions() + getTimes()) : '';

            function getImg() {
                return (item[prop + 'Id'] || item[prop]) ?
                    $ctrl.getLogo(item, prop, 'rowscheduleafter', {
                        imgSize: $ctrl.getImgSizeInit()
                    }) : '';
            }

            function getOptions() {
                var o = $ctrl.getOptions($ctrl.filtersService.listCols, item, false, false, isMobile, isMobileRowDetails, !$ctrl.isStoryboards);
                return o ? ('<div class="full-width shot-options semibold clearfix">' + o + '</div>') : '';
            }

            function getTimes() {
                var c = [], el = '';
                _.each($ctrl.getAvailableTimeColumns(), function (p) {
                    var v = getContent(p);
                    if (v) {
                        c.push({v: v, l: p.replace('Time', '').replace('time', 'start').toUpperCase()});
                    }
                });

                var l = c.length, w = 100 / l;
                if (!l) {
                    return '';
                }

                _.each(c, function (c, i) {
                    el += '<div class="centered ' + (i === l - 1 ? '' : 'b') + '" style="width: ' + w + '%"><div class="v">' + c.v + '</div><div class="l">' + c.l + '</div></div>';
                });
                return '<div class="full-width shot-times"><div class="table-div centered">' + el + '</div>';
            }

            function getContent(name) {
                var c = $ctrl.getColumnByProp(name, $ctrl.isSides),
                    co = c ? $ctrl.SBFieldTypesService.getSBFieldContentView($ctrl, item, _.extend({}, c, {hideEmptyContent: true}), false).content : null;
                return co && co !== '' && co.replace(/(<([^>]+)>)/ig, '') !== '–' ? co.replace('display-block', 'inline-block') : null;
            }
        }

        function getGroupItemAttributes() {
            return 'shot-types="::$ctrl.ShotTypes" ' +
                    'numbering-type="::$ctrl.filtersService.options.type" ' +
            'is-comp="::($ctrl.isComp === true)" ';
        }

        function addNewList(e){
            $ctrl.preventDefault();
            $ctrl.broadcastRoot('ADD_NEW_LIST', $ctrl.treeType);
        }

        function getGroupEmptyHeader() {
            var name = $ctrl.nameForList.toLowerCase();
            return '<h3 class="text-center sb-prop-list-name">' + $ctrl.currentList.name + '</h3>' +
                '<h4 class="text-center" style="font-size: 16px;font-weight: 600">No <span ng-if="!$ctrl.isActiveGroup()">archived </span>' + $ctrl.itemTitle.toLowerCase() + 's ' +
                '<span ng-bind="!$ctrl.isActiveGroup() && !$ctrl.isActiveTree()? \'in this \':\'have been added ' +
                ($ctrl.currentList.isFolder && $ctrl.currentList.id === null ? '' : 'to this ') + '\'"></span>' +
                '<span ng-if="!$ctrl.isActiveTree()">archived </span>' + name + '.</h4>';
        }

        function getGroupEmptyText() {
            //todo bring back the command keys
            return '';

            return '<span class="italic" style="font-size: 16px">' +
                ($ctrl.defaultKey ? ('Click in this area and press ' + '<strong>' + $ctrl.defaultKey + '</strong> to add a new ' + $ctrl.itemTitle.toLowerCase()) : '')  +
                ($ctrl.getDefaultGroupEmptyOther ? $ctrl.getDefaultGroupEmptyOther() : '') +
                '</span>';
        }

        function onGroupInitOther() {

            $ctrl.openScene = openScene;
            //$ctrl.onItemChange = onItemChange;

            //if is archived list disable editing
            if ($ctrl.currentList.active === false) {
                $ctrl.canEdit = false;
            }

            if ($ctrl.onInitOther) {
                $ctrl.onInitOther();
            }

            if ($ctrl.canEdit) {
                $ctrl.getNewItem = getNewItem;
            }

            $ctrl.addRootWatcher('TOP_BTN_' + $ctrl.currentListId, onTopBtn);

            $ctrl.addRootWatcher('PROCESS_TAGGED_SHOT', onTaggedShot);
            if(typeof($ctrl.onGroupSetupInitOther) === 'function'){
                $ctrl.onGroupSetupInitOther();
            }
        }

        function onTopBtn(result){
            var event = result.event;
            switch (event){
                case 'PREVIEW':  $ctrl.openScene();break;
                case 'TOGGLESCSRATCHPAD':
                    if($ctrl.toggleScratchpad) {
                        $ctrl.toggleScratchpad(result);
                    }
                    break;

                case 'TOGGLESCENE':  $ctrl.toggleScene(result ? result.e : null);break;
                case 'ADDITEM':  $ctrl.uploadItems(result ? result.e : null);break;
                case 'ADDSETUP':
                    $ctrl.createItem(null, $ctrl.ShotTypes.Setup, null,result ? result.e : null);break;
                case 'ADDBANNER':
                    $ctrl.createItem(null, $ctrl.ShotTypes.Banner, null, result ? result.e : null);break;
            }
        }

        function toggleScene(e) {
            //planFetatures testmode
            var quotaType = $ctrl.isStoryboards ? 'storyboardTagger' : 'shotTagger';
            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e: e});

            function process() {
                $ctrl.toggleInnerSidebar();
            }
        }

        function getItemUnderlined() {
            return '<span class="underlined">' + $ctrl.itemTitle.substring(0, 1) + '</span>' + $ctrl.itemTitle.substring(1, $ctrl.itemTitle.length) + '</span>'
        }

        function getGroupButtons() {
            if (!$ctrl.canEdit) {
                return '';
            }
            return '<div ng-show="!$ctrl.list.busy && $ctrl.hasElements()" class="form-group field hide-print full-width bottom-buttons-inline">' +
                ($ctrl.withoutAddShot ? '' :(
                    $ctrl.getAddItem ? $ctrl.getAddItem() : $ctrl.getAB('Shot', getItemUnderlined(), 1))) +
                ($ctrl.getBottomButtonsOther ? $ctrl.getBottomButtonsOther() : '') +
                '</div>';
        }

        function getAB(type, txt1, index) {
            var withNgClick = true,
                t = $ctrl.ShotTypes && (type!==undefined||type!==null) ? $ctrl.ShotTypes[type] : null,
                txt = typeof ($ctrl.getShotTypeName) === 'function' ? $ctrl.getShotTypeName(t) : $ctrl.itemTitle,
                create = $ctrl.createMethodName ? $ctrl.createMethodName : 'create';
            // create = '$ctrl.'+($ctrl.createMethodName ? $ctrl.createMethodName : 'create')+'(null, '+t+')';
            return '<a class="small inline-block semibold ' + (withNgClick ? '' : $ctrl.getBtnActionCls()) + '" ' +
                (withNgClick ? (' ng-click="$ctrl.' + create + '(null,' + t + ',$event)"') : '') +
                'data-type="' + create + '" data-info="' + t + '" analytics-on analytics-action="Open Add ' + txt + '" tabindex="{{$ctrl.list.totalCount * 4 + ' + index + '}}" ui-keyup="{enter:\'' + create + '\'}">' +
                $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left with-margin-right') + ' <span>' + txt1 + '</span></a>';
        }

        function createItemWithEvent(after, type, e){
            console.log('createItemWithEvent');
            if($ctrl.isStoryboards && type ===  1){
                $ctrl.addEmptyShots({count: 1, e: e}, function (result) {});
            } else {
                $ctrl.createItem(after, type, null, e);
            }
        }

        function getAL(item) {
            return [{
                // type: 'createItem',
                type: $ctrl.createMethodNameInMore ? $ctrl.createMethodNameInMore : $ctrl.createMethodName,
                action: 'Add ' + $ctrl.itemTitle + ' ' + $ctrl.getPosition(),
                icon: $ctrl.itemIcon,
                iconLevel: $ctrl.iconLevel
            }];
        }

        function getRowMobileActions(item) {
            return $ctrl.getAL(item);
        }

        function getMorePopoverTemplate(item, isMobile) {
            var itemType = $ctrl.getItemType(item), c = 0;
            var el = ''; //fadeInDown

            if ($ctrl.withGroupMoreOrderChanged) {
                addOther();
                addRow(true);
            } else {
                addRow();
                addOther(true);
            }

            if($ctrl.canRemove(item)) {
                el += $ctrl.getSideMenuLi({
                    type: 'remove',
                    action: 'Remove ' + itemType,
                    icon: 'trash',
                    withTopBorder: c > 0,
                    aClass: 'accent'
                });
            }

            return '<ul class="dropdown-menu side-menu display-block shot-sidemenu">' + el + '</ul>';

            function addOther(withTopBorder) {
                if (!$ctrl.withoutAddItemAfter && !$ctrl.isMobileView()) {
                    var l = $ctrl.getAL(item, withTopBorder);
                    _.each(l, function (el1) {
                        el += $ctrl.getSideMenuLi(el1);
                        c++;
                    });
                }
            }

            function addRow(withTopBorder) {
                var has = false;
                if ($ctrl.canEditFromMore ? $ctrl.canEditFromMore(item) : !$ctrl.withoutGroupEdit) {
                    el += $ctrl.getSideMenuLi({
                        type: 'edit',
                        action: 'Edit ' + itemType,
                        icon: 'pencil',
                        withTopBorder: withTopBorder && !has,
                    });
                    c++;
                    has = true;
                }

                if ($ctrl.withMoveGroupItem && $ctrl.canMove(item)) {
                    el += $ctrl.getSideMenuLi({
                        type: 'move',
                        action: 'Move ' + itemType,
                        icon: 'transition',
                        iconLevel: 5
                    });
                }

                if ($ctrl.canDuplicateFromMore ? $ctrl.canDuplicateFromMore(item) : $ctrl.withDuplicateGroupItem !== false) {
                    el += $ctrl.getSideMenuLi({
                        type: 'duplicate',
                        action: 'Duplicate ' + itemType,
                        icon: 'copy',

                        withTopBorder: withTopBorder && !has,
                    })
                    c++;
                }
            }
        }

        function getPosition() {
            return $ctrl.isGridView ? 'After' : 'Under';
        }

        function createItem(after, type, moreNewItemData, e){
            try{
                if(typeof(type) === "string"){type = parseInt(type, 10);}
            }catch (ex){}
            if($ctrl.quotaTypeSetups && (type === 2 || type === 0)){
                $ctrl.CPS.loadQuotaPopup($ctrl.quotaTypeSetups, process, null,  null, $ctrl.compOptions, {e:e});
            } else {
                process();
            }

            function process() {
                return $ctrl.create(after, type, moreNewItemData, null, false, e);
            }
        }

        function getNewPopupParamsOther(item) {
            return _.extend({
                service: $ctrl.service,
                listTreeService: $ctrl.listTreeService,
                scriptLoadingService: $ctrl.preLoadingService,
                Settings: $ctrl.Settings,

                currentListId: $ctrl.currentListId,
                canEdit: $ctrl.canEdit,

            }, $ctrl.getNewPopupParamsOtherExt(item));
        }

        function getNewPopupParamsOtherExt(item) {
            console.log('getNewPopupParamsOtherExt');
            var p = $ctrl.sceneNo ? {
                sceneNo: $ctrl.sceneNo
            } : {};
            if (item.type === 2 && $ctrl.withTextBlock) {
                var el = item && item._id ? $ctrl.getItemEl(item._id) : null;
                return _.extend({
                    FontStyles: $ctrl.FontStyles,
                    contentWidth: el ? el.clientWidth : null,
                    elemType: $ctrl.elemType,
                    field: 'note',
                    fieldClass: 'noteStyle',
                    onSuccessPopup: $ctrl.onSuccessPopupNewItem
                }, p);
            }
            return p;
        }

        function onSuccessPopupNewItem(){
            console.log('onSuccessPopupNewItem');
        }

        function getEditPopupParams(item, field){
            return _.extend({}, $ctrl.getNewPopupParams(item), {
                changedFields: $ctrl.canEdit ? $ctrl.service.getEditableFields(item.type) : null
            });
        }

        function onListChanged() {
            $ctrl.scriptLoadingService = $ctrl.CurrentProduct.scriptLoadingService;
            $ctrl.strip = $ctrl.currentList && $ctrl.currentList.stripId ? $ctrl.scriptLoadingService.getStripById($ctrl.currentList.stripId) : null;
            $ctrl.sceneNo = $ctrl.strip ? $ctrl.SBFieldMethods.getSceneText($ctrl.strip) : null;
        }

        function getKeyEvents() {
            var l = [{
                type: 'Edit',
                keys: [
                    $ctrl.keyboardService.keys.EKey,
                    $ctrl.keyboardService.keys.eKey
                ],
                method: onEKey
            }]

            if($ctrl.defaultKey) {
                l.push({//add item
                    type: $ctrl.itemTitle,
                    keys: [
                        $ctrl.keyboardService.keys[$ctrl.defaultKey + 'Key'],
                        $ctrl.keyboardService.keys[$ctrl.defaultKey.toLowerCase() + 'Key']
                    ],
                    method: onItemKey
                });
            }

            return $ctrl.getOtherKeyEvents ? l.concat($ctrl.getOtherKeyEvents()) : l;

            function onEKey(sId, item) {
                if ($ctrl.currentListId !== sId) {
                    return;
                }
                $ctrl.edit(item);
            }

            function onItemKey(sId, item) {//Add item under
                if ($ctrl.currentListId !== sId) {
                    return;
                }
                $ctrl.createItem(item ? item._id : null, $ctrl.ShotTypes ? $ctrl.ShotTypes.Shot : null);
            }
        }

        function openScene(e) {
            $ctrl.preventDefault(e);
            if ($ctrl.strip) {
                getSceneParams();
                $ctrl.popupsService.open($ctrl.strip, $ctrl.popupsService.operations.tagShots,  $ctrl.extraSceneParams, $ctrl.compOptions);
            }
        }

        //for lists
        function getNewItem(item, addFolder, useSelected) {
            var el = {
                isFolder: addFolder,
                type: item.type,

                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                scriptId: item.type === 5 ? $ctrl.CPS.scriptId : null
            };

            var selectedList = $ctrl.listTreeService.active.selectedList,
                tree = $ctrl.listTreeService.getTree(el.type, selectedList.active);
            return {
                el: el,
                selectedList: useSelected ? (selectedList.type === el.type ? selectedList : (tree && tree.length > 0 ? tree[0] : null)) : item
            };
        }

        function getNewParams(after, type) {
            if (type && typeof (type) === 'string') {
                type = parseInt(type, 10);
            }
            var params = {};

            if (type === undefined) {
                type = $ctrl.ShotTypes ?  $ctrl.ShotTypes.Shot : 1;
            }
            params.type = type;

            if (after) {
                params.afterId = after._id;
            }

            if ($ctrl.listField) {
                params[$ctrl.listField] = $ctrl.currentListId;
            }

            if ($ctrl.getNewParamsOther) {
                params = $ctrl.getNewParamsOther(params, after, type);
            }

            return params;
        }

        function getMoreBtnCls(item) {
            return 'with-btn ' + ($ctrl.fullscreenList ? ' with-border-left' : '')
                // + '" ng-init="$ctrl.withTooltip = true'
                ;
        }

        function isCustomShot() {
            return $ctrl.filtersService.options.type && $ctrl.filtersService.options.type.toString() === '3';
        }

        function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
            switch (c.prop) {
                case 'time':
                case 'endTime':
                    c = $ctrl.setIsComp(c);
                    return getCS(c,null, canEdit);


                case 'color':
                    return ($ctrl.isPrintLayout && typeof($ctrl.getPreRowFront) === 'function') ? $ctrl.getPreRowFront(false, item, true) : '';

                case 'sceneNo':
                    return isMobileRowDetails ? getCS(c, null, canEdit) : getSceneNo();

                case 'shotNo':
                    return (isMobile && !isMobileRowDetails) ? '' : ('<div class="' + c.colCls + ' no-drag">' + getShotNoProp(c, c.prop) + '</div>');

                case 'logo':
                    return (isMobile && !isMobileRowDetails || textOnly) ? '' : getLogo(item, null, cls);

                case 'name':
                    if(!isMobile) {
                        return getCS(c, null, canEdit);
                    }

                    if (!isMobileRowDetails) {
                        var c1 = $ctrl.getColumnByProp('status', true);
                        return getCS(c1, c1.colCls + ' bigger-check', canEdit)  +
                                '<div class="title-cell grow-column">' +
                                    '<div class="full-width display-block shotno">' + getNo('shotNo', false, '') + '</div>' +
                                    '<div class="full-width display-block shot-title">' + getCS($ctrl.getColumnByProp('name', true)) + '</div>' +
                                '</div>';
                    }

                    return c.viewRowDetailsMobile ? getMD(true) : '';

                default:
                    return getCS(c,null, canEdit);
            }

            function getMD(withLogo){
                var time = (typeof ($ctrl.getTimeCol) === 'function' ? $ctrl.getTimeCol(item, textOnly, 'with-fancy-border') : '');

                return $ctrl.getMobileTitleAndSubtitle(item, c, $ctrl.getOptions($ctrl.filtersService.listCols, item, false, false, isMobile, isMobileRowDetails, !$ctrl.isStoryboards), cls, canEdit) +
                    time +
                   (withLogo ? getLogo(item) : '');
            }
            function getNo(prop, hasForward, cls1) {
                var c = $ctrl.getColumnByProp(prop, true);
                return c ? ((hasForward ? sep : '') +
                    '<span class="pull-left">' + c.name + ' &nbsp;</span>' + getShotNoProp(c, prop, cls1) + '</span>') : '';
            }

            function getCS(c, cls1, canEdit) {//to set the status to editable on mobile
                return getC(item, c, cls1||cls, canEdit, textOnly, canEdit ? false : isMobile, isMobileRowDetails);
            }

            function getSceneNo() {
                var props = isMobile ? null : {
                        fieldClass: ' text-center',
                        wrapperClass: 'centered bold',
                        colCls: ' scene-col scene text-center',
                        editableContainerClass: 'without-height-padding'
                    },
                    hasStrip = hasStrips(),
                    sceneNo = hasStrip ? $ctrl.strip.scene : item.sceneNo,
                    item1 = hasStrip ? _.extend({}, item, {sceneNo: sceneNo}) : item,
                    canE = $ctrl.currentList.stripId ? c.canEdit : $ctrl.canEdit && $ctrl.canEditItem(item);
                return getC(item1, _.extend({}, c, props, canE ? {
                        canEdit: true,
                        eClassAttr: 'form-control hover-underline '
                    } : null), cls + ' bold',
                    //allow to edit the scene # for custom lists
                    canEdit,
                    textOnly, isMobile, isMobileRowDetails);
            }

            function getShotNoProp(c, prop, cls) {
                var type = $ctrl.filtersService.options.type,
                    cs = $ctrl.getColumnByProp('customShotNo', true),
                    isCustom = isCustomShot();
                return '<span class="' + (cls || '') + ' shotnoprop bold">' +
                    '<span class="'+$ctrl.getViewEditElemSelector(c.prop) + ' ' + (isCustom ? 'sb-hide' : '') + '">' + $ctrl.SBFieldMethods.getShotNo(item, type, prop) + '</span>' +
                    getEdCol(cs, 'shotnoc ' + (isCustom ? '' : 'sb-hide')) +
                    '</span>';//is custom numeric
            }

            function getEdCol(c, cls) {
                return '<div class="shortfield shot-block pull-left ' + cls + '">' +
                    getC(item, _.extend({}, c, {
                        canEdit: canEdit,
                        fieldClass: c.fieldClass,
                        eClassAttr: (c.eClassAttr || '') + ' bold',
                        editableContainerClass: 'without-height-padding bold',
                    }), null, canEdit, textOnly, isMobile, isMobileRowDetails) +
                    '</div>';
            }
        }

        function setIsComp (c) {
            var c1 = $ctrl.getColumnByProp('estTime');
            if (!c1) {
                c.isComp = true;
            }
            return c;
        }

        function hasStrips(){
            return $ctrl.strip !== null && $ctrl.strip !== undefined;
        }

        function isLoadOnlySelected(item){
            return !($ctrl.ShotTypes && item && (item.type === $ctrl.ShotTypes.Setup || item.type === $ctrl.ShotTypes.Banner));
        }

        function showColumnCond(item){
            return !$ctrl.isGridView;
                //|| $ctrl.isGridView && ($ctrl.ShotTypes && item && (item.type === $ctrl.ShotTypes.Setup || item.type === $ctrl.ShotTypes.Banner));
        }



        function processGridViewItem(item) {
            var shotTypes = $ctrl.ShotTypes,
                isShot = !shotTypes || shotTypes && item.type === shotTypes.Shot,
                showListView = false//;!isShot;// todo

            if(showListView){ //for banner and setup display list view mode
                return $ctrl.processListViewItem(item);
            }

            var isStacked = true,
                isMobile = $ctrl.isMobileView(),
                isMobileRowDetails = false,
                textOnly = false,
                listCols = $ctrl.filtersService.listCols,
                canEdit = $ctrl.canEdit && $ctrl.canEditItem(item),
                times = getTimes(),
                lProp = 'likes',
                likesP = $ctrl.getColumnByProp(lProp, true),
                topCell = (canEdit ?
                    (
                        //(likesP ? ('<div class="with-hover hide-print">' + $ctrl.LCS.getISBDiv('heart', 0, 'with-hover') + '</div>') : '')+
                        ('<div class="handle-col with-hover hide-print">' + $ctrl.LCS.getISBDiv('dd3-handle', 0, 'with-hover') + '</div>')
                    )
                        : '') +
                    (isShot ? getStatus(canEdit, false, item && item.status === true) : '') +
                    getGridTitle() +
                    $ctrl.getMoreBtnTemplate(false, item, isMobile),
                d = ($ctrl.isMoodboards || !isShot) ? '' : getShotGridDesc(),
                hideTopColor =  $ctrl.isPrintLayout && !$ctrl.getColumnByProp('color') && !topCell;

        return (isShot && !$ctrl.isMoodboards && !hideTopColor ? ('<div class="top-color-bar ' + $ctrl.getViewEditElemSelector('color') + '" ' +
                    (item.color ? ('style="background-color:'+item.color+'"') : '') +
                '>&nbsp;</div>') : '') +

                //start table-storyboard-cell
                (topCell ? ('<div class="table-storyboard-cell top">' + topCell + '</div>') : '') +
                //end table-storyboard-cell

                //start body-img
                '<div class="body-img' + ($ctrl.withTextBlock ? ' no-drag' : ' with-cursor') + '">' +
                    (isShot ? getFieldLogo(d === '') :
                        ($ctrl.withTextBlock ? getTextBoxContent : getBannerContent)(item, canEdit, textOnly)) +
                    d +
                    getBottomInfo() +
                '</div>';

            function getBottomInfo() {
                if(item.type !== 1){return '';}

                var hasComments = getComments(),
                    hasLikes = getLikes();
                return (hasComments || hasLikes) ? ('<div class="table-storyboard-cell bottom display-flex hide-print">' + //with-bg
                    (hasLikes || '')  + (hasComments || '') +
                    '</div>') : '';

                function getLikes(){
                    if(!$ctrl.displayLikesCount || !$ctrl.withLikesOnItem){return null;}

                    var likes = likesP ? $ctrl.SBFieldTypesService.SBFieldMethods.getItemLikes(item) : null,
                        likesL = likes && likes.length ? likes.length : 0,
                        hasLikes = $ctrl.canEdit || !$ctrl.canEdit && likesL,

                        lPropMark = $ctrl.SBFieldTypesService.getViewEditElemSelector(lProp, true, $ctrl.canView);

                    return hasLikes ? ('<div class="secLike white semibold with-cursor with-underline ' + $ctrl.getClickEventName('viewImagePopup') +
                        // (likesL > 0 ? '' : ' sb-hide') +
                        '" data-param="true">' + $ctrl.LCS.getISBDiv('like', 2, 'with-margin-right') +
                        '<span class="' + lPropMark + '">' + likesL + '</span> like' +
                        ($ctrl.canEdit ? ('<span class="plural' + lPropMark + '">' + (likesL === 1 ? '' : 's') + '</span>') : (likesL === 1 ? '' : 's')) +
                        '</div>') : null;
                }

                function getComments(){
                    if(!$ctrl.displayCommentsCount){return null;}

                    var cProp = 'commentsCount',
                        commentsP = $ctrl.getColumnByProp(cProp, true),
                        comments = commentsP && item[cProp] ? item[cProp] : 0,
                        hasComments = $ctrl.canEdit || !$ctrl.canEdit && comments,
                        cPropMark = $ctrl.SBFieldTypesService.getViewEditElemSelector(cProp, true, $ctrl.canComment);

                    return hasComments && $ctrl.canComment ? ('<div class="white semibold with-cursor with-underline ' + $ctrl.getClickEventName('viewImagePopup') + (comments ? '' : ' sb-hide')  + '">' + $ctrl.LCS.getISBDiv('conversations', 2, 'with-margin-right') +
                        '<span class="' + cPropMark + '">' + comments + '</span> comment' +
                        ($ctrl.canEdit ? ('<span class="plural' + cPropMark + '">' + (comments === 1 ? '' : 's') + '</span>') : (comments === 1 ? '' : 's')) +
                        '</div>') : null;
                }
            }

            //shot-grid-desc
            function getShotGridDesc() {
                var d = '', o = '',  b = '', a, el;
                if (typeof ($ctrl.getTopDesc) === 'function') {
                    o = $ctrl.getTopDesc(listCols, item, canEdit, textOnly, isShot);
                }

                if (typeof ($ctrl.getGridLinedDesc) === 'function') {
                    //d = $ctrl.isStoryboards ? ' display-flex' : '';
                    b = $ctrl.getGridLinedDesc(listCols, item, canEdit, textOnly, isShot);
                }

                if (typeof ($ctrl.getGridOneLinedDesc) === 'function') {
                    //d = $ctrl.isStoryboards ? ' display-flex'grid oneline : '';
                    a = $ctrl.getGridOneLinedDesc(listCols, item, canEdit, textOnly, isShot);
                }


                var cls = 'field-description';
                if($ctrl.isStoryboards){
                    o = $ctrl.getOptions(listCols, item, canEdit, textOnly, isMobile, isMobileRowDetails, !$ctrl.isStoryboards);
                }
                var oIsEmpty = (!o || o === '')&& !canEdit;
                var c = 'field text-center '+ (isStacked ? '' : 'clearfix ') + cls;
                var t = times ? ('<div class="' + c + ' times no-top-line' +  '">' + times + '</div>') : '';
                var tIsEmpty = (!t || t === '')&& !canEdit;
                var to =  (t || '') + (o || '');

                b = b !== '' ? ('<div class="' + cls + (isShot ? '' : ' no-top-line') + '">' + b + '</div>') : '';
                if ($ctrl.isStoryboards) {
                    o = (oIsEmpty && tIsEmpty ? '' : ('<div class="full-width">' + to + '</div>'));
                    el = (o || '') + (b || '');
                } else {
                    //if is isOneColumn o is first (time is up)
                     o = (isShot ? (oIsEmpty ? '' : ('<div class="' + c + (t ? '' : ' no-top-line')+ '">' + o + '</div>')) : '');
                    if((!t || t === '') && (!o || o === '') && b){
                        b = b.replace(cls, cls + ' no-top-line');
                    }
                    a = a !== '' ? ('<div class="' + cls+ (!t && !o && !b ? ' no-top-line' : '') + '">' + a + '</div>') : '';

                    oIsEmpty = (!o || o === '')  ;
                    el = (!oIsEmpty || b && b !== '' || a && a !== '' || t && t !== '') ? ('<div class="full-width ' + (oIsEmpty ? '' : ' top-not-empty ') + d + '">' +
                        to +
                        (b || '') +
                        (a || '') +
                        '</div>') : '';
                }

                if (el && (!$ctrl.isStoryboards && oIsEmpty && b || $ctrl.isStoryboards && !to)) {
                    el = el.replace(cls, cls + ' no-top-line');
                }

                return !el && !canEdit ? '' : ('<div class="descriptions full-width">' + el + '</div>');
            }

            //field-logo
            function getFieldLogo(dIsEmpty) {
                return '<div class="full-width logoimg">' + $ctrl.getLogo(item, null, dIsEmpty ? ' desc-empty' : '') + '</div>';
            }

            function getTimes(){
                return typeof($ctrl.getGridBulletedTimes) === 'function' ? $ctrl.getGridBulletedTimes(listCols, item, canEdit, textOnly, isShot, isStacked):'' ;
            }
            //shot-grid-title
            function getGridTitle() {
                if ($ctrl.hideItemTitle || (item.type === $ctrl.ShotTypes.Banner && $ctrl.withTextBlock)) {
                    return '';
                }

                var el = '',
                    sep = '<span class="dot-inline pull-left">•</span>',
                    sceneNoCol = $ctrl.getColumnByProp('sceneNo'),
                    hasStrip = hasStrips(),
                    isBanner = shotTypes && item.type === shotTypes.Banner,
                    sceneNo = hasStrip ? $ctrl.strip.scene : item.sceneNo,
                    withSceneNo = sceneNoCol && !(!sceneNo && !canEdit);

                if (withSceneNo) {
                    el += '<span class="pull-left">Sc.&nbsp;</span>' +
                        ((hasStrip || !canEdit) ? ('<span class="pull-left">' + sceneNo + '</span>') : getEdCol(sceneNoCol, 'shotnos '));
                }

                el += isShot ? getNo('shotNo', withSceneNo && el) : ('<span class="pull-left">' + (el ? sep : '') + (isBanner ? $ctrl.bannerTypeName : item.name) + '</span>');

                return el ? ('<div class="with-name">' + el + '</div>') : '';

                function getNo(prop, hasForward, cls1) {
                    var isAll = !$ctrl.isPrintLayout,
                        c = $ctrl.getColumnByProp(prop, isAll);
                    return c ? ((hasForward ? sep : '') +
                        '<span class="pull-left">' + c.name + ' &nbsp;</span>' + getShotNoProp(c, prop, cls1 + ' pull-left', isAll) + '</span>') : '';
                }

                function getShotNoProp(c, prop, cls, isAll) {
                    var type = $ctrl.filtersService.options.type,
                        cs = $ctrl.getColumnByProp('customShotNo', isAll),
                        isCustom = isCustomShot(),
                        canE = canEdit && !isMobile;
                    return '<span class="' + (cls || '') + ' shotnoprop">' +
                        '<span class="' + $ctrl.getViewEditElemSelector((!canE && isCustom) ? 'customShotNo' : c.prop) + ' ' + (canE && isCustom ? 'sb-hide' : '') + '">' + $ctrl.SBFieldMethods.getShotNo(item, type, prop) + '</span>' + (canE ? getEdCol(cs, 'shotnoc ' + (isCustom ? '' : 'sb-hide')) : '') +
                        '</span>';//is custom numeric
                }

                function getEdCol(c, cls) {
                    return '<div class="shortfield shot-block pull-left ' + cls + '">' +
                        getC(item, _.extend({}, c, {
                            canEdit: canEdit,
                            fieldClass: c.fieldClass,
                            eClassAttr: (c.eClassAttr || '') + ' bold',
                            editableContainerClass: 'without-height-padding bold',
                        }), null, canEdit, textOnly, isMobile, isMobileRowDetails) +
                        '</div>';
                }
            }

            function getStatus(canEdit, isBigger, hasStatus) {
                var c = $ctrl.getColumnByProp('status');
                if(!c){return '';}
                var el = canEdit ? getC(item, c, c.cls, canEdit, false, false, false) :
                    ('<div><div class="custom-checkbox shotList inrow not-disabled smallercheck circled ' + (canEdit ? ' with-cursor' : '') +
                   // ($ctrl.isPrintLayout ? ' not-disabled smallercheck circled' : '') +
                    (isBigger ? ' big' : '') + '"><label><input type="checkbox" disabled="disabled"' + (hasStatus ? ' checked="checked"' : '') +
                    '/><span></span></label></div></div>');
return '<div class="statusc ' + (canEdit?'with-cursor':'') +
    //($ctrl.isPrintLayout ? ' medium-check':'')+
    '">' + el + '</div>';
            }

            function getTextBoxContent(item, canEdit, textOnly) {
                var note = $ctrl.getNote(item, textOnly, false, canEdit, true, true);
                return '<div class="banner-content text-block ' + ($ctrl.isMasonary ? '' : ' display-flex h-full') + '">' +
                    //'<span class="' + $ctrl.SBFieldTypesService.getViewEditElemSelector('name', true, $ctrl.canEdit) + (!item.name ? ' hide-print" ' : '') + '">' + (item.name || '') + '</span>' +
                    note +
                    '</div>';
            }

            function getBannerContent(item, canEdit, textOnly){
                var shotTypes = $ctrl.ShotTypes,
                    isSetup = shotTypes && item.type === shotTypes.Setup,
                    isBanner = shotTypes && item.type === shotTypes.Banner,
                    color = isSetup ? '' : ('style="color:' + (isSetup ? 'white' : $ctrl.SBFieldMethods.getBannerColor(item) ) + '"'),
                    note = $ctrl.getNote(item, textOnly, $ctrl.isGridView),
                    c = getContent();
                return '<div class="stretchy-wrapper text-center full-width">' +
                    '<div class="' + $ctrl.getViewEditElemSelector('color') + '" ' +
                    'style="background-color:' + (isSetup ? $ctrl.LCS.setupColor : (item.color ? item.color : $ctrl.getDefaultBannerColor())) + '"' +
                    '>' +
                    '<div class="full-width b-with-border" style="border-color:' + (isSetup ? 'rgba(255,255,255,0.25)' : $ctrl.SBFieldMethods.getBorderColor(item) ) + '">' +
                    '<div class="centered banner-content" ' + color + '>' +
                    $ctrl.LCS.getISBDiv(isSetup ? $ctrl.setupTypeIcon : 'banner', 4, ($ctrl.isGridView ? 'margin-bottom-half' : '')) +
                    '<div class="full-width text-center">' +
                    (canEdit ? ('<div class="with_underline banner-content" ' + color + '>' + c + '</div>') : c) +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>';
                function getContent(){
                    return (isSetup ? ('<span><span style="color: white">' + ($ctrl.setupNameInLine +  (item.name||'')) + '</span>' + note + '</span>') :
                        (isBanner ? (('<span class="' + $ctrl.getViewEditElemSelector('name') +(!item.name ? ' hide-print ' : '') + ' ' +
                            $ctrl.getBtnActionCls() + '" data-type="edit" data-info="' + $ctrl.ShotTypes.Banner + '">' + (item.name||'')+ '</span>') + note): ''));
                }
            }
        }

        function getNote(item, textOnly, isCenter, canEdit, isAll, noWrapper) {
            var n = $ctrl.getColumnByProp('note', isAll);

            if (!n) {
                return '';
            }

            var v = $ctrl.getDisplayItemCol(item, _.extend({}, n, {
                hideEmptyContent: !$ctrl.canEdit,
                canEdit: canEdit,
                openPopup: true,
            }, isCenter ? {wrapperClass: 'centered non-semibold spacing-half-top'} : null), null, textOnly);

            if (!v) {
                return '';
            }

            return (textOnly || noWrapper)? v : (n ? ('<div class="full-width text-italic">' + v + '</div>') : '');
        }

        function getC(item, c, cls, canEdit, textOnly, isMobile, isMobileRowDetails) {
            return $ctrl.getDisplayItemCol(item, c, cls, canEdit, textOnly, isMobile, isMobileRowDetails);
        }

        function getGroupEmptyButtons() {
            console.log('getGroupEmptyButtons');
            var many, method, icon, txt,
            isEmpty = !$ctrl.listTreeService.active.selectedListId ||
                $ctrl.listTreeService.active.selectedListId === 'All';
            if(isEmpty){
                if($ctrl.listTreeService.isCustomList($ctrl.treeType)) {
                    method = '$ctrl.addNewList($event)';
                    icon = 'plus';
                    txt = 'New ' + $ctrl.nameForList;
                }else {
                    return $ctrl.CPS.isAuthenticated ? ('<import-script btn-class="btn btn-primary '+($ctrl.pageClass||'')+'" show-title="true" show-text-on-ipad="true" '  +
                    ($ctrl.pageClass ? ('page-class="'+$ctrl.pageClass+'" ') : '') +
                    '></import-script>') : '';
                }
            } else {
                many = $ctrl.addMultipleItems;
                method = many ? '$ctrl.uploadItems($event)' : '$ctrl.create(null, $ctrl.ShotTypes ? $ctrl.ShotTypes.Shot : null)';
                icon = many ? 'plus' : 'plus-circled';
                txt = (many ? 'Upload ' : 'New ') + $ctrl.itemTitle + (many ? 's' : '');
            }

            return '<button type="button" id="addNewShotLink" ng-click="' + method + '" class="btn btn-primary ' + ($ctrl.pageClass || '') + '">' + $ctrl.LCS.getISBDiv(icon, 2, 'pull-left with-margin-right') + ' <span> ' + txt + '</button>';
        }

        function getSceneParams(){
            $ctrl.extraSceneParams = {
                service: $ctrl.service,
                item: $ctrl.strip,
                canEdit: $ctrl.canEdit && $ctrl.currentList.active,//todo check if should edit???
                scriptLoadingService: $ctrl.scriptLoadingService,
                isEditMode: true,

                listPropId: $ctrl.currentList._id,
                listField: $ctrl.listField, //shotsListId'
                objectType: $ctrl.objectType,
                itemTitle: $ctrl.itemTitle,
                extraColsJson: JSON.stringify(_.filter($ctrl.filtersService.listCols, function (c) {
                    return c.type === 4;
                }).map(function (c) {
                    return {p: c.prop, n: c.name, pl: c.placeholder};
                }))
            };
        }

        function getTagShots(){
            getSceneParams();
            $ctrl.onCloseTagShots = function (result){
                console.log('onCloseTagShots');
            }

            var tag = 'tag-shots';
            return '<'+tag+' class="clearfix '+tag+' ' + ($ctrl.isPopup ? '' : 'inline') + '" ' +
                'item="::$ctrl.strip" type="::$ctrl.type" extra-param="::$ctrl.extraSceneParams"' +
                ' comp-options="::$ctrl.compOptions" on-close="$ctrl.onCloseTagShots(result)"></'+tag+'>';
        }

        function getSidebarTwo(){
            return getTagShots();
        }

        function isSidebarLeft(){
            return true;
        }

        function hasTwoSidebars(){
            //todo :: mobile??
            return $ctrl.has2Sidebars && $ctrl.currentList.stripId;
        }

        function onItemChange(item, field) {
            console.log('onItemChange');
            if(!item||!field || $ctrl.isUpdating){return;}

            $ctrl.isUpdating = true;
            //field = {field: "movement", val: "5"}
            var data = {_id: $ctrl.item._id};
            data[field.field] = field.val;

            $ctrl.service.update(data, onsuccess, onerror);

            function onsuccess(result) {
                $ctrl.isUpdating = false;
                result.editchanges = data;
                $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType+ '_ITEM', result);
            }

            function onerror(error) {
                $ctrl.isUpdating = false;
                $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.'+$ctrl.objectType+'.update.error', 'error' );
            }
        }

        function onTaggedShot(result){
            console.log('onTaggedShot');
            if (result.cancel !== true) {
                if (result.item && result.type === 'Create') {
                    $ctrl.broadcastRoot('ADDED_' + $ctrl.elemType+ '_ITEM', result);
                } else if (result.type === 'Edit' && result.updates) {
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.taggingScenes.' + result.type + '.success', 'success');
                }
            }

            $ctrl.broadcastRoot('RELOAD_TAG_ELEMENT_' + $ctrl.strip._id, result);

            if($ctrl.onPreloadSettings){
                $ctrl.onPreloadSettings(result, false);
            }
            return {
                strip: $ctrl.strip
                //, count: count
            };
        }
    }
}

angular.module('product.shots.group.init.controller.service', [
    'group.controller.service',
    'product.shots.item.grid.component'
])
.service('ShotGroupInitCtrlService', ShotGroupInitCtrlService);
ShotGroupInitCtrlService.$inject = ['TreeGroupInitCtrlService'];
function ShotGroupInitCtrlService(TreeGroupInitCtrlService) {
    return function($ctrl, $element, Pagination){
        $ctrl.gridItemClass = 'shotitemcolumn';
        if(!$ctrl.groupItemTag) {
            $ctrl.groupItemTag = 'shot';
        }
        $ctrl.withMobileDetails = true;
        //LIST_FILTERS_RATIO
        $ctrl.otherListFilters = [
            {prop: 'RATIO', value: 'ratio'}
        ];

        $ctrl.$onInit = $onInit;

        if(!$ctrl.getPreRowFront) {
            $ctrl.getPreRowFront = getPreRowFront;
        }
        $ctrl.getPreRowFrontInit = getPreRowFront;

        if(!$ctrl.getItemType){
            $ctrl.getItemType = getItemType;
        }

        if(!$ctrl.getItemColor) {
            $ctrl.getItemColor = getItemColor;
        }

        if(!$ctrl.getColorClass){
            $ctrl.getColorClass = getColorClass;
        }

        if(!$ctrl.getMobileColoredHeader) {
            $ctrl.getMobileColoredHeader = getMobileColoredHeader;
        }
        $ctrl.getOptions = getOptions;

        $ctrl.getRowMobileOther = getRowMobileOther;
        $ctrl.getGridCls = getGridCls;

        if(!$ctrl.getItemImageSize) {
            $ctrl.getItemImageSize = getItemImageSize;
        }

        $ctrl.addEmptyShots = addEmptyShots;
        $ctrl.onBeforeFilesUploaded = onBeforeFilesUploaded;
        $ctrl.onUpdated = onUpdated;
        if(!$ctrl.getDisplayRootCount) {
            $ctrl.getDisplayRootCount = getDisplayRootCount;
        }

        if(!$ctrl.getNotificationParams) {
            $ctrl.getNotificationParams = getNotificationParams;
        }

        return $ctrl;

        function getNotificationParams(item){
            return {
                itemType: $ctrl.getItemType(item).toLowerCase()
            };
        }

        function getDisplayRootCount(type){
            var c = 0,
                nodes = $ctrl.listTreeService.getTree($ctrl.treeType, ($ctrl.withActiveTree||$ctrl.withActiveGroup) ? $ctrl.selectedFilter : undefined)[0].nodes;
            _.each(nodes, function (n) {
                if (!canAdd(n)) {
                    c += n.count;
                }
            });
            return c;

            function canAdd(el){
                return el.type === 1 || el.type === 3 || el._id === 'All';
            }
        }

        function $onInit() {
            $ctrl = new TreeGroupInitCtrlService($ctrl, $element, Pagination, false);
            $ctrl.SBFieldMethods = $ctrl.SBFieldTypesService.SBFieldMethods;

            //$ctrl.sortableParent = '.scrollable-content';
            //$ctrl.onItemChange = onItemChange;

            //if is archived list disable editing
            if ($ctrl.currentList.active === false) {
                $ctrl.canEdit = false;
            }

            if ($ctrl.canEdit) {
                $ctrl.addRootWatcher('ADD_EMPTY_' + $ctrl.elemType + '_' + $ctrl.currentList._id, addEmptyShots);
                $ctrl.addRootWatcher('BEFORE_IMAGE_UPLOADED_' + $ctrl.elemType, onBeforeFilesUploaded);
            }

            if ($ctrl.onGroupInitOther) {
                $ctrl.onGroupInitOther();
            }
        }

        function onBeforeFilesUploaded(result) {
            console.log('ShotGroupInitCtrlService.onBeforeFilesUploaded');
            var count = result && result.fileIdsInQueueOrder ? result.fileIdsInQueueOrder : 0,
                next = result ? result.next : null;
            if (count) {
                result.count = count;
                result.withFileUpload = true;
                addEmptyShots(result);
            } else {
                next(null, null);
            }
        }

        function addEmptyShots(params) {
            if(!params){
                return;
            }

            var count = params.count, withFileUpload = params.withFileUpload;

            $ctrl.checkQuota($ctrl.quotaType, process, _.extend({maxAddedCount: count},
                params.onQuotaOpen ? {onQuotaOpen: params.onQuotaOpen} : null, params.e ? { e: params.e} : null));

            function process() {
                var next = params.next,
                    item = $ctrl.currentList;

                $ctrl.service.addEmpty(getParams(), onsuccess, next);

                function getParams() {
                    var params = {count: count};
                    if ($ctrl.listField) {
                        params[$ctrl.listField] = item._id;
                    }

                    params.stripId = item.stripId ? item.stripId : null;

                    params.scriptId = item.scriptId ? item.scriptId : null;
                    params.listType = item.type;

                    if(withFileUpload) {
                        params.withFileUpload = withFileUpload;
                    }
                    return _.extend(params, {
                        companyId: $ctrl.CPS.companyId,
                        productId: $ctrl.CPS.productId,
                        type: 1
                    });
                }

                function onsuccess(result) {
                    result.eventType = 'UPDATE_LIST_COUNTER';
                    $ctrl.broadcastRoot('ADDED_MULTIPLE_' + $ctrl.elemType + '_' + item._id, result);
                    var ids = _.sortBy(result.added, 'order').map(function (item) {
                        return item._id;
                    });
                    //  $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.shot.Create.success', 'success');
                    if (next) {
                        next(null, {
                            itemIds: _.sortBy(result.added, 'order').map(function (item) {
                                return item._id;
                            }),
                            activityId: result.activityId,
                            activityType: result.activityType
                        });
                    }
                }
            }
        }

        function getRowMobileOther(item) {
            return item.logo ? getMobileRowImageTemplate(item) : '';
        }

        function getMobileColoredHeader(item){
            return $ctrl.getColorClass(item);
        }

        function getColorClass(item){
            return item ? item.color : null;
        }

        function getItemType(){
            return $ctrl.itemTitle;
        }

        function getItemColor(item) {
            return item && item.color ? item.color : null;
        }

        function getPreRowFront(isHeader, item, force) {
            var prop = 'color',
                c = $ctrl.getColumnByProp(prop);
            if (!force || $ctrl.isGridView || $ctrl.LCS.isMobileSize || !c) {//if is not shot
                return '';
            }
            var color = $ctrl.getItemColor(item);
            return c.hasPrefont ? ('<div class="cant-shrink color-column6 prefront ' + $ctrl.getViewEditElemSelector(prop) + '" ' + (!isHeader && color && (item.type === 1 || !$ctrl.ShotTypes) ? ('style="background-color:' + color + '"') : '') + '></div>') : '';
        }

        function getMobileRowImageTemplate(item) {
            return $ctrl.security.getImage(item, $ctrl.getImgSizeInit() + ' storyboard-mobile', 'logo', 600, {
                imgClass: 'centering ',
                withSquareImg: true,
                avatar: 'project',
                iconPaths: $ctrl.LCS.getISBPath(2)
            });
        }

        function getGridCls() {
            var defaultS = $ctrl.defaultFontSizeGeneral || 13,
                f; //13
            if ($ctrl.LCS.isMobileSize && $ctrl.mobileFontSize) {
                f = $ctrl.mobileFontSize;
            } else {
                if (!$ctrl.filtersService.options || $ctrl.filtersService.options.view === 2) {//list view
                    f = defaultS;
                } else {
                    var c = ($ctrl.filtersService.options && $ctrl.filtersService.options.column ? $ctrl.filtersService.options.column : 1).toString();
                    if ($ctrl.isStoryboards) {
                        switch (c) {
                            case '4':
                                f = 12;
                                break;
                            case '3':
                                f = defaultS;
                                break;
                            case '2':
                                f = 16;
                                break;
                            case '1':
                                f = 16;
                                break;
                        }
                    } else { //shot list
                        f = defaultS;
                    }
                }

                if (!$ctrl.LCS.isMobileSize && $ctrl.filtersService.options) {
                    $ctrl.filtersService.options.fontSize = f;
                }
            }
            /*if (f === 13) {
                f = defaultS;
            }*/
            if ($ctrl.getArchivedClass) {
                f += $ctrl.getArchivedClass();
            }
            return ' font-general font-general-' + f;
        }

        function getOptions(listCols, item, canEdit, textOnly, isMobile, isMobileRowDetails, isDrp) {
            if(!listCols){return '';}
            var el = '', list = [],
                li = _.filter(listCols, function (c) {
                    return !c.notInList && c.prop !== 'sceneNo' && c.prop !== 'shotNo' &&  (isDrp ? (c.type > 0 && c.type < 4) : (c.type === 4));
                });

            if(!li.length){return el;}

            canEdit = canEdit && !($ctrl.isStoryboards && isMobile && !isMobileRowDetails);

            for (var i = 0, n = li.length; i < n; i++) {
                var c = li[i];          // Field ck rd              html
                if(!canEdit && $ctrl.isStoryboards && isMobile){
                    c = _.extend({dontPreserveDiv: true});
                }
                var v = $ctrl.getDisplayItemCol(item, _.extend({}, c, {
                    canEdit: canEdit
                }, canEdit ? {
                    colCls: '',  //+ ' text-center',
                    editableContainerClass: (c.editableContainerClass || '') +
                    ($ctrl.isStoryboards ? ' full-width ' : ' without-height-padding bold ')
                } : {
                    //show empty  for storyboards and on desktop
                    hideEmptyContent: !$ctrl.isStoryboards && !canEdit || isMobile
                }), $ctrl.isStoryboards ? '' : ' pull-left ', canEdit, textOnly, isMobile, isMobileRowDetails);

                if (v) {
                    if ($ctrl.isStoryboards) {
                        v = '<div class="table-div full-width padding-top-10 padding-bottom-10 with-border-bottom1">' +
                                '<div class="vtop icon-col">' + $ctrl.LCS.getISBDiv(c.icon, 3 )+'</div>' +
                                '<div class="txt">' + v + '</div>' +
                            '</div>';
                    }

                    list.push(v);
                }
            }
            var d = isDrp ? '<span class="dot pull-left">•</span>' : '';
            if (canEdit && !isMobile) {
                el += list.join(d);
            } else {
                var nl = _.filter(list, function (it) {
                    return it && it.replace(/(<([^>]+)>)/ig, '')
                });
                if (nl.length > 0) {
                    el += nl.join(d);
                }
            }
            return el;
        }

        function getItemImageSize(isMobile){
            return !$ctrl.filtersService.noListModeOnMobile && isMobile ? 'smaller' : $ctrl.getImgSizeInit();
        }

        function onUpdated(result){
            console.log('onUpdated');
            var item = result.item;
            if(!item || item && item.type !== 1 || result.eventType === 'CHANGED_FIELD') {return;}

            $ctrl.LCS.timeout(function (){
                console.log('SET IMAGE_UPLOADED: ' +
                    'shotId: '+item._id +
                    '; logoId: '+item.logoId +
                    '; path: ' + item.logo);
                $ctrl.broadcastRoot('IMAGE_UPLOADED', {
                    item: item,
                    eventType: 'update',
                    updatedImage: {
                        prop: 'logo',
                        val: {
                            id: item.logoId,
                            path: item.logo
                        }
                    }
                });
            }, 10);
        }
    }
}

angular.module('product.shots.group.overloaded.controller.service', [
    'product.moodboards.note.popup',
    'product.shots.group.controller.service'
])
.service('ShotGroupOverloadedCtrlService', ShotGroupOverloadedCtrlService);
ShotGroupOverloadedCtrlService.$inject = ['ShotGroupCtrlService'];
function ShotGroupOverloadedCtrlService(ShotGroupCtrlService){
    return function($ctrl, $element, Pagination){

        if(!$ctrl.btnUploadText) {
            $ctrl.btnUploadText = 'Upload Images';
        }

        if(!$ctrl.dayBreakColumns) {
            $ctrl.dayBreakColumns = ['date', 'time', 'note'];
        }
        if(!$ctrl.bannerColumns) {
            $ctrl.bannerColumns = ['name', 'estTime', 'note'];
        }

        if($ctrl.defaultKey === undefined) {
            $ctrl.defaultKey = 'S';
        }

        if(!$ctrl.setupTypeName) {
            $ctrl.setupTypeName = 'Setup';
        }
        $ctrl.setupKey = 'T';

        if(!$ctrl.bannerTypeName){
            $ctrl.bannerTypeName = 'Banner';
        }

        if(!$ctrl.setupTypeIcon) {
            $ctrl.setupTypeIcon = 'camera-setup';
        }

        if(!$ctrl.setupNameInLine) {
            $ctrl.setupNameInLine = 'End of ';
        }

        if(!$ctrl.setupCls) {
            $ctrl.setupCls = 'setup';
        }
        $ctrl.addMultipleItems = true;

        if(!$ctrl.ShotTypes) {
            $ctrl.ShotTypes = {Shot: 1, Setup: 0, Banner: 2
            //    , Header:3 -> for av scripts
            };
        }

        $ctrl.getAL = getAL;
        $ctrl.getOtherKeyEvents = getOtherKeyEvents;
        $ctrl.showColumnMobileView = showColumnMobileView;
        if(!$ctrl.getNewParamsOther) {
            $ctrl.getNewParamsOther = getNewParamsOther;
        }

        if(!$ctrl.getCount) {
            $ctrl.getCount = getCount;
        }

        $ctrl.getColorClass = getColorClass;
        $ctrl.getItemColor = getItemColor;
        $ctrl.onInitOther = onInitOther;
        $ctrl.getItemType = getItemType;

        $ctrl.getTimeCol = getTimeCol;
        $ctrl.getBottomButtonsOther = getBottomButtonsOther;

        $ctrl.getListViewReportItem = getListViewReportItem;
        $ctrl.getDefaultGroupEmptyOther = getDefaultGroupEmptyOther;

        $ctrl.getFileUploadedParams = getFileUploadedParams;
        $ctrl.getGridBulletedDesc = getGridBulletedDesc;
        $ctrl.getTopDesc = getTopDesc;
        $ctrl.getGridLinedDesc = getGridLinedDesc;
        $ctrl.getGridOneLinedDesc = getGridOneLinedDesc;
        $ctrl.getListReportTimes = getListReportTimes;

        $ctrl.getMobileColoredHeader = getMobileColoredHeader;
        $ctrl.getListViewReportItemInit = getListViewReportItemInit;
        $ctrl.onPropChangedOther = onPropChangedOther;
        $ctrl.preSetOtherFilters = preSetOtherFilters;

        if(!$ctrl.processListItemColumn) {
            $ctrl.processListItemColumn = processListItemColumn;
        }

        $ctrl.getColInfo = getColInfo;

        if(!$ctrl.getColsBanner) {
            $ctrl.getColsBanner = getColsBanner;
        }

        if(!$ctrl.getColsSetup) {
            $ctrl.getColsSetup = getColsSetup;
        }

        if(!$ctrl.getShotTypeName) {
            $ctrl.getShotTypeName = getShotTypeName;
        }
        //todo
        //$ctrl.getDisplayRootCount = getDisplayRootCount;
        $ctrl.noNotificationOnNew = noNotificationOnNew;
        $ctrl.getPopupNameForCreate = getPopupNameForCreate;
        $ctrl.getCreateInlineGroup = getCreateInlineGroup;
        $ctrl.hasLogoImg = hasLogoImg;

        $ctrl = new ShotGroupCtrlService($ctrl, $element, Pagination);

        return $ctrl;


        function hasLogoImg(item) {
            return item.type !== 0 && item.type !== 2;
        }

        function getCreateInlineGroup(type){
            var isBlock = type === 2 && $ctrl.withTextBlock;
            return !isBlock && $ctrl.getCreateInlineGroupInit() || isBlock;
        }

        function isTextBlock(item){
            return $ctrl.withTextBlock && item && item.type === 2;
        }

        function getPopupNameForCreate(item, isNew) {
            return isTextBlock(item) ? 'customNote' : (isNew ? 'create' : 'update');
        }

        function noNotificationOnNew(item){
            return isTextBlock(item);
        }

        function getShotTypeName(type){
            return type === $ctrl.ShotTypes.Shot ? $ctrl.itemTitle : (type === $ctrl.ShotTypes.Banner ? $ctrl.bannerTypeName: $ctrl.setupTypeName);
        }

        function preSetOtherFilters(){
            if (!$ctrl.filtersService || !$ctrl.filtersService.options) {
                return;
            }
            setComp();
        }

        function setComp(){
            var v = _.find($ctrl.filtersService.listCols, {prop: 'estTime'}) === undefined;
            if($ctrl.isComp !== v){
                $ctrl.isComp = v;
                return true;
            }
        }

        function onPropChangedOther(prop, newVal) {
            if (prop === 'columns' && setComp()){
                $ctrl.broadcastRoot('LIST_FILTERS_COMP' + $ctrl.getFilterElemType(), {isComp: $ctrl.isComp});
            }
        }

        function getDisplayRootCount(type){
            return type === $ctrl.ShotTypes.Shot ? ($ctrl.getStrips(true).length || 0) : 0;
        }

        function getMobileColoredHeader(item) {
            var isBanner = item.type === $ctrl.ShotTypes.Banner;
            if (!(item.type === $ctrl.ShotTypes.Setup || isBanner)) {
                return '';
            }
            return $ctrl.SBFieldMethods.getColorClass(item) +
                (isBanner && item.color ? ('" style="background-color:' + item.color+'"') : '');
        }

        function getDefaultGroupEmptyOther(){
            return ', <strong>T</strong> to add a ' + $ctrl.getShotTypeName($ctrl.ShotTypes.Shot)+', ' +
                ($ctrl.currentList.stripId ? '' : 'or') +
                '<br/><strong>B</strong> to add a banner' +
                ($ctrl.currentList.stripId ? (', or <strong>P</strong> to preview the scene</span>.') : '');
        }

        function getListViewReportItemInit(item, i, isMobile, isMobileRowDetails){

        }

        function getListViewReportItem(item, i, isMobile, isMobileRowDetails) {
            console.log('getListViewReportItem');
            var textOnly = false,
                canEdit = false;

            switch(item.type){
                case $ctrl.ShotTypes.Shot: return $ctrl.getListViewReportItemInit(item, i, isMobile, isMobileRowDetails);
                case $ctrl.ShotTypes.Banner: return getBanner();
                case $ctrl.ShotTypes.Setup: return getSetup();

                function getBanner(){
                 return '<div class="strip-item banner spacing-half margin-top-half" ' + (item.color ? ('style="border-color:' + item.color + '"') : '')+'>' +
                            '<div>' +
                                '<div class="table-div full-width">' +
                                    '<div class="text-center grow-column font-size-14 semibold ' + ($ctrl.lastProp==='name' ? 'grow-column' : '') + '">' +
                                        '<span ' + (item.color ? ('style="color:'+item.color+'"'):'')+ '>' + item.name + '</span>' +
                                    '</div>' +
                                     $ctrl.getNote(item, textOnly, false) +
                                     $ctrl.getTimeCol(item, textOnly ) +
                                '</div>' +
                            '</div>' +
                         '</div>';
                }

                function getSetup(){
                    return '<div class="strip-item banner spacing-half margin-top-half text-center font-size-14 semibold " style="' + (item.color ? ('border-color:' + item.color) : '') + '">' +
                        '<span>' + $ctrl.setupNameInLine + '&nbsp;' + item.name + '</span>' +
                        getColDayBreakInfo(item, false, canEdit, isMobile, isMobileRowDetails) +
                        '</div>';
                }
            }
            return '';
        }

        function getItemType(item){
            return item ? $ctrl.getShotTypeName(item.type) : '';
        }

        function getBottomButtonsOther(){
            var txt = $ctrl.withTextBlock ? 'Text Box' : 'Banner';
            return ($ctrl.withSetup ?  $ctrl.getAB('Setup', replace($ctrl.setupTypeName, $ctrl.setupKey), 2) : '') +
                ($ctrl.withoutAddBanner ? '' : $ctrl.getAB('Banner', replace(txt, 'B'), 3));

            function replace(t, k) {
                return r(r(t, k), k.toLowerCase());
                function r(t, k) {
                    return t.replace(k, '<span class="underlined">' + k + '</span>')
                }
            }
        }

        function getColorClass(item) {
            if (!item) {
                return null;
            }

            switch (item.type) {
                case $ctrl.ShotTypes.Shot:
                    return item.color;

                case $ctrl.ShotTypes.Setup:
                    return $ctrl.setupTypeIcon;

                case $ctrl.ShotTypes.Banner:
                    return 'banner';
            }

            return null;
        }

        function showColumnMobileView(item, c) {
            if (item && item.type === $ctrl.ShotTypes.Shot) {
                return true;
            }

            switch (item.type) {
                case $ctrl.ShotTypes.Setup:
                    return $ctrl.dayBreakColumns.indexOf(c.prop) !== -1;

                case $ctrl.ShotTypes.Banner:
                    return $ctrl.bannerColumns.indexOf(c.prop) !== -1;
            }

            return false;
        }

        function getAL(item, withTopBorder) {
            var position = $ctrl.getPosition(),
                l = [],
                isSetup = $ctrl.withoutAddSetupUnder && item.type === 0,
                type = $ctrl.createMethodNameInMore ? $ctrl.createMethodNameInMore : $ctrl.createMethodName;
            if(!isSetup) {
                l.push({
                    type: type,
                    action: 'Add ' + $ctrl.itemTitle + ' ' + position,
                    icon: $ctrl.itemIcon,
                    iconLevel: $ctrl.iconLevel,
                    param: $ctrl.ShotTypes.Shot,

                    withTopBorder: withTopBorder,
                });
            }

            if(!$ctrl.withoutAddSetup ){
                if(!$ctrl.withoutAddSetupUnder || isSetup){
                    l.push({
                        type: type,
                        param: $ctrl.ShotTypes.Setup,
                        action: 'Add ' + $ctrl.getShotTypeName($ctrl.ShotTypes.Setup) + ' ' + position,
                        icon: $ctrl.setupTypeIcon,
                        iconLevel: $ctrl.setupIconLevel || 2,
                    })
                }
            }

            if (!$ctrl.withoutAddSetupUnder || !isSetup) {
                l.push({
                    type: type,
                    param: $ctrl.ShotTypes.Banner,
                    action: 'Add ' + $ctrl.getShotTypeName($ctrl.ShotTypes.Banner) + ' ' + position,
                    icon: 'banner',
                    iconLevel: 4
                });
            }

            return l;
        }

        function onInitOther(){
            if ($ctrl.canEdit) {
                $ctrl.onUpdate = onUpdate; //for update from drps
            }
        }

        function onUpdate(item, data) {
            console.log('on update');
            if (item.type !== $ctrl.ShotTypes.Setup) {
                recountForSetup(item.setupId);
            }
        }

        function recountForSetup(setupId) {
            if (setupId) {
                var params = $ctrl.withProperty();
                params.setupId = setupId;
                $ctrl.service.updateSetup(params, function (item) {
                    var items = $ctrl.list.items;
                    for (var i = 0, n = items.length; i < n; i++) {
                        var el = items[i], id = el._id;
                        if (id === setupId) {
                            $ctrl.replaceElementProps(id, {
                                estTime: item.estTime,
                                prepTime: item.prepTime,
                                shootTime: item.shootTime,
                                duration: item.duration
                            });
                            break;
                        }
                    }
                }, function (error) {

                });
            }
        }

        function getCount() {
            if(!$ctrl.withTreeDisplayCount){return $ctrl.getCountInit();}

            var d = 0, dif = 0, l = [];
            g($ctrl.ShotTypes.Shot, false, true);

            if(!$ctrl.withoutAddBanner) {
                g($ctrl.ShotTypes.Banner, false, false);
            }

            g($ctrl.ShotTypes.Setup, true, false);

            return {totalCount: d, dif: dif, counterText: l.length > 0 ? l.join('&nbsp;•&nbsp;') : ''};

            function g(type, isLast, set) {
                var c = _.filter($ctrl.list.items, {type: type}).length;
                if (set) {
                    d = c;
                } else {
                    dif += c;
                }

                if (c) {
                    var el = $ctrl.getShotTypeName(type),
                        last = el[el.length - 1];
                    l.push(c + ' ' + el + (c === 1 ? '' : ( (last === 'x' ? 'e' : '') + (last === 's' ? '' : 's'))));
                }
            }
        }

        function getOtherKeyEvents() {
            var l = [{
                type: 'DayBreak',
                keys: $ctrl.SegmentKeys ? $ctrl.SegmentKeys : [$ctrl.keyboardService.keys.TKey, $ctrl.keyboardService.keys.tKey],
                method: onTKey
            },{
                type: 'PreviewScript',
                keys: [$ctrl.keyboardService.keys.PKey, $ctrl.keyboardService.keys.pKey],
                method: onPKey
            }];
            if(!$ctrl.withoutAddBanner){
                l.push({
                    type: 'Banner',
                    keys: [$ctrl.keyboardService.keys.BKey, $ctrl.keyboardService.keys.bKey],
                    method: onBKey
                });
            }
            return l;

            function onBKey(sId, item) {
                if ($ctrl.currentListId !== sId) {
                    return;
                }
                $ctrl.create(item ? item._id : null, $ctrl.ShotTypes.Banner);
            }

            function onTKey(sId, item) {
                if ($ctrl.currentListId !== sId) {
                    return;
                }
                $ctrl.create(item ? item._id : null, $ctrl.ShotTypes.Setup);
            }

            function onPKey(sId, item) {
                $ctrl.viewScene(null);
            }
        }

        function getNewParamsOther(params, after, type) {
            if(type === $ctrl.ShotTypes.Banner){
                if ($ctrl.withTextBlock) {
                    params.note = '<h1>Optional heading here</h1><p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras commodo sapien justo, nec ornare est suscipit ac. Mauris tincidunt ut mauris sit amet congue. Fusce ut ex sit amet ipsum facilisis lobortis.</p>';
                } else{
                    var banner = $ctrl.LCS.getSetting('shotBannerColor');
                    //set av script banner color to dark color av script
                    params.color = banner ? banner : $ctrl.getDefaultBannerColor();
                }
            }else{
                params.time = $ctrl.MomentService.getUtcMomentFromTimeMoment(null, $ctrl.CPS.startTime);
            }

            var p = 'setupId';
            if (after && after[p] && type !== $ctrl.ShotTypes.Setup) {
                params[p] = after[p];
            }

            params.scriptId = $ctrl.currentList.scriptId  || null;
            params.listType = $ctrl.currentList.type;

            return params;
        }

        function getItemColor(item) {
            return item && item.type === $ctrl.ShotTypes.Shot ? item.color : null;
        }

        function getColInfo(item, prop, canEdit, textOnly, isAll, isMobile, isMobileRowDetails, isComp) {
            var c1 = $ctrl.getColumnByProp(prop, isAll);
            return c1 ? getInline(item, c1, prop, textOnly, canEdit, isMobile, isMobileRowDetails, isComp) : '';
        }

        function getInline(item, c, prop, textOnly, canEdit, isMobile, isMobileRowDetails, isComp) {
            return c ? $ctrl.getDisplayItemCol(item, _.extend({}, c, {canEdit: canEdit, isComp: isComp},
                prop === 'name' ? {placeholder: 'Name'} : null), 'inline-block', canEdit, textOnly, isMobile, isMobileRowDetails) : '';
        }

        function getDash(textOnly){
            return textOnly ? ' — ' : ('<span class="long-dash"> — </span>');
        }

        function getSp(textOnly){
            return textOnly ? ' ' : '&nbsp;';
        }

        function getColDayBreakInfo(item, textOnly, canEdit, isMobile, isMobileRowDetails){
            var dash = getDash(textOnly),
                sp = getSp(textOnly),
                isAll = true,
                startTimeInfo = addWithDash('time', null, isAll),
                endTime = getContent(textOnly, item, 'endTime', startTimeInfo!==''? true :false, $ctrl.isComp),
                estTime = g('Est. Time', 'estTime', $ctrl.isComp),
                duration = g('Duration', 'duration', false, true);


            return addWithDash('date', null, isAll) +
                // g('Prep Time', 'prepTime');
                // g('Shoot Time', 'shootTime');

                (estTime ? ('<div class="'+($ctrl.isComp ? 'sb-hide ':'') + 'esttimecol">' + estTime  + '</div>') : '') +
                //(duration ? ('<div class="esttimecol">' + duration  + '</div>') : '') +

                startTimeInfo +
                (endTime ? ('&nbsp;to&nbsp;' + getColInfo(item, 'endTime', false, textOnly, isAll, isMobile, isMobileRowDetails, $ctrl.isComp)) : '') +

                $ctrl.getNote(item, textOnly, true);

            function addWithDash(prop, other, isAll) {
                var date = getColInfo(item, prop, canEdit && true, textOnly, isAll, isMobile, isMobileRowDetails);
                return date && date !== '' ? ((other ? other : dash) + date) : '';
            }

            function g(t, p, isComp, isNotAll) {
                var c1 = $ctrl.getColumnByProp(p, !isNotAll);
                if(c1) {
                    var v = getInline(item, c1, p, textOnly, canEdit && (p!=='estTime'), isMobile, isMobileRowDetails, isComp);
                    return dash + t + ':' + sp +  v;
                }
                return '';
            }
        }

        function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails){
            var withS = isMobile || isMobileRowDetails;

            if(withS && (isMobileRowDetails && c.viewRowDetailsMobile
                //    || !c[withS ? 'isMobileTitle' : 'isListTitle']
            )) {
                return $ctrl.getDisplayItemCol(c.prop === 'sceneNo' ? itemWithSceneNo() : item, c, cls, canEdit, textOnly, isMobile, isMobileRowDetails);
            }

            switch (item.type) {
                case $ctrl.ShotTypes.Header:
                    return (typeof($ctrl.getColsHeader) === 'function') ?
                      $ctrl.getColsHeader(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) : '';

                case $ctrl.ShotTypes.Shot:
                    return $ctrl.processListItemColumnInit(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);

                case $ctrl.ShotTypes.Banner:
                    return $ctrl.getColsBanner(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);

                case $ctrl.ShotTypes.Setup:
                    return $ctrl.getColsSetup(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);
            }

            function itemWithSceneNo() {
                var sceneNo = hasStrips() ? $ctrl.strip.scene : item.sceneNo;
                return sceneNo ? _.extend({}, item, {sceneNo: sceneNo}) : item;

                function hasStrips(){
                    return $ctrl.strip !== null && $ctrl.strip !== undefined;
                }
            }
        }

        function getColsBanner(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
            switch (c.prop) {
                case 'shotNo':
                    return textOnly ? 'NOTE' : ('<div class="stripList '+(isMobile ? 'col60' : 'shot-status-col') +'">' + $ctrl.LCS.getISBDiv('info', 3, 'white centering ' + (isMobile ? 'sbf40' : 'sbf30')) + '</div>');

                case 'name':
                    var isCenter = $ctrl.isGridView,
                    content = $ctrl.getC(item, _.extend({}, $ctrl.getColumnByProp('name', true), isCenter ? {wrapperClass: 'centered '} : null), cls + ' semibold full-width', false, textOnly, isMobile, isMobileRowDetails) +
                        $ctrl.getNote(item, textOnly, isCenter);
                    return (textOnly ? content : ('<div class="title-cell grow-column  ">' + content + '</div>')) +
                        getTimeCol(item, textOnly);

                case 'shootTime':
                case 'prepTime':
                    return getC();

                case 'time':
                case 'endTime':
                case 'estTime':
                    return getC($ctrl.isComp);

                default:
                    return '';
            }

            function getC(isComp){
                return $ctrl.getColumnByProp(c.prop) ? $ctrl.getC(item, isComp ? _.extend({isComp: isComp}, c) : c, cls, $ctrl.canEdit && c.canEdit, textOnly, isMobile, isMobileRowDetails) : '';
            }
        }

        function getColsSetup(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
            switch (c.prop) {
                case 'name':
                    var startTime = getContent(textOnly, item, 'time', false, $ctrl.isComp),
                        endTime = getContent(textOnly, item, 'endTime', false, $ctrl.isComp),
                        estTime = getContent(textOnly, item, 'estTime', false, $ctrl.isComp),
                        duration = item.duration && getContent(textOnly, item, 'duration', false, false),

                        isAll = false,
                        sp = getSp(textOnly),
                        el = (textOnly ? '' : ('<div class="title-cell day-breaks text-center grow-column">' + '<span class="name">')) +
                        ($ctrl.setupNameInLine +sp+ getColInfo(item,'name', false, true, isAll, isMobile, isMobileRowDetails)) +
                        (textOnly ? '' : '</span>'
                        );

                    //(getColInfo('note') + //description
                    //  (item.note ? $ctrl.getSBColContentView($ctrl, item) : '') +
                    if(isMobile) {
                        if (startTime || endTime){
                            el += '<div class="full-width font-small">' +
                                (startTime ? startTime : '') +
                                (startTime ? (sp + 'to' + sp + getColInfo(item, 'endTime', false, true, isAll, isMobile, isMobileRowDetails, $ctrl.isComp)) : '')+
                                '</div>';
                        }


                        el += isMobileRowDetails ? '' : $ctrl.getNote(item, textOnly, true);
                    }else{
                        el += getColDayBreakInfo(item, textOnly, $ctrl.canEdit, isMobile, isMobileRowDetails);
                    }

                    el += textOnly ? '' : '</div>';

                    //last col
                    if(isMobile  ) {
                        gete(estTime, 'Setup');
                        //gete(duration, 'Duration');
                    }

                    function gete(v, n) {
                        if (v) {
                            el += '<div class="stripList col60 text-center font-general font-general-13"><div class="full-width text-center semibold">' + v + '<br/>' + n + '</div></div>';
                        }
                    }

                    return el;

                case 'note':
                    return $ctrl.getColumnByProp(c.prop) && isMobileRowDetails ? $ctrl.getC(item, c, cls, canEdit, textOnly, isMobile, isMobileRowDetails) : '';

                case 'estTime':
                case 'shootTime':
                case 'prepTime':
                case 'duration':
                case 'time':
                case 'endTime':
                    return getC();

                default:
                    return '';
            }

            function getC(){
                return $ctrl.getColumnByProp(c.prop) && isMobile ? ('<div class="'+(isMobile ? 'col60' : c.colCls)+'">&nbsp;</div>') : '';
            }
        }


        function getTimeCol(item, textOnly, colcls) {
            if(!$ctrl.isMobileView()){
                return '';
            }
            var estTime = getContent(textOnly, item, 'estTime', false, $ctrl.isComp),
                startTime = getContent(textOnly, item, 'time', false, $ctrl.isComp);
            return (estTime || startTime) ?
                ('<div class="stripList col60 text-center '+(colcls?colcls:'')+'">' +
                    (startTime ? ('<div class="full-width text-center semibold">' + startTime + '</div>') : '') +
                    (estTime ? ('<div class="full-width text-italic with-parenthesis font-small">' + estTime + '</div>') : '') +
                    '</div>') : '';
        }

        function getListReportTimes(listCols, item, canEdit, textOnly, isShot) {
            var el ='';
            _.each($ctrl.getAvailableTimeColumns(), function (prop){
                el += $ctrl.getContentHorizontal(item, prop, 'col100');
            });
            return el;
        }

        function getGridBulletedDesc(listCols, item, canEdit, textOnly, isShot) {
            return $ctrl.getGridItemDescriptions(_.filter(listCols, function (c) {
                return c.type !== 5 && c.type !== 6 && c.type !== 27 &&
                    (c.type >= 4 && isShot || ($ctrl.isTimeCols(c) && !isShot));
            }), item, canEdit, textOnly );
        }

        function getTopDesc (listCols, item, canEdit, textOnly, isShot){
            return isShot ? $ctrl.getGridItemDescriptions(_.filter(listCols, function (c) {
                return c.prop === 'name' ||  c.prop === 'subject';
            }), item, canEdit, textOnly, false, false, 'onelinedesc1') : '';
        }

        function getGridLinedDesc(listCols, item, canEdit, textOnly, isShot){
            return isShot ? $ctrl.getGridItemDescriptions(_.filter(listCols, function (c) {
                return !($ctrl.isTimeCols(c) || c.type === 4 ||
                    c.type === $ctrl.SBFieldTypesService.PropTypes.HtmlTooltip ||
                    c.prop === 'name' ||  c.prop === 'subject' ||
                    c.prop ==='logo' || c.prop ==='color' || c.prop ==='status' ||
                    c.prop === 'customShotNo' || c.prop === 'shotNo' || c.prop ==='sceneNo');
            }), item, canEdit, textOnly, false, false, 'linedesc') : '';
        }

        function getGridOneLinedDesc(listCols, item, canEdit, textOnly, isShot){
            var notesC;
            var cols = _.filter(listCols, function (c) {
                if(c.type === $ctrl.SBFieldTypesService.PropTypes.HtmlTooltip){
                    notesC = c;
                    return false;
                } else{
                    return (c.type === 4) && !(  c.prop === 'name' ||  c.prop === 'subject');
                }
            });
            if(notesC){
                cols.push(notesC);
            }

            return isShot ? $ctrl.getGridItemDescriptions(cols, item, canEdit, textOnly, false, false, 'onelinedesc') : '';
        }

        function getContent(textOnly, item, name, isAll, isComp) {
            var c = $ctrl.getColumnByProp(name, isAll !== undefined ? isAll : true);
            if(c && isComp){
                c = $ctrl.setIsComp(c);
            }
            var co = c ? $ctrl.SBFieldTypesService.getSBFieldContentView($ctrl, item, _.extend({}, c, {hideEmptyContent: true}), textOnly).content : null;
            return co && co !== '' && co.replace(/(<([^>]+)>)/ig, '') !== '–' ? co.replace('display-block', 'inline-block') : null;
        }

        function getFileUploadedParams(result) {
            console.log('getFileUploadedParams');
            var params = $ctrl.getFileUploadedParamsInit(result);
            if($ctrl.ShotTypes){
                params.type = $ctrl.ShotTypes.Shot;
            }
            params.stripId = $ctrl.currentList.stripId ? $ctrl.currentList.stripId : null;

            params.scriptId = $ctrl.currentList.scriptId ? $ctrl.currentList.scriptId : null;
            params.listType = $ctrl.currentList.type;
            return params;
        }
    }
}

angular.module('product.shots.item.grid.component', [
    'product.shots.item.grid.controller.service'
])
.component('shotItemGrid', itemGridComponentParams( {
    shotTypes: '<',
    numberingType: '<',
    isComp: '<',

}, 'ShotItemCtrl','<div class="row-schedule scene"></div>'))
.controller('ShotItemCtrl', ShotItemCtrl);
ShotItemCtrl.$inject = ['ShotItemCtrlService', '$element'];
function ShotItemCtrl(ShotItemCtrlService, $element) {
    var $ctrl = this;
    $ctrl = new ShotItemCtrlService($ctrl, $element);
}

angular.module('product.shots.item.grid.controller.service', [])
.service('ShotItemCtrlService', ShotItemCtrlService);
ShotItemCtrlService.$inject = ['GridItemGroupInitCtrlService'];
function ShotItemCtrlService( GridItemGroupInitCtrlService) {
    return function ($ctrl, $element){

        //console.log('ShotItemCtrlService');
        var isLast = false;//$ctrl.list.items.length - 1 === $index
        var numberingType = 'numberingType';

        if(!$ctrl.setupRowCls){
            $ctrl.setupRowCls = 'setup';
        }
        $ctrl.changedFields = ['item', 'listOptions'];

        $ctrl.rowClsOther = rowClsOther;
        $ctrl.replaceClsCond = replaceClsCond;
        $ctrl.showRow = showRow;

        $ctrl.updateEditableItemPropsAll = updateEditableItemPropsAll;
        $ctrl.postInitItem = postInitItem;
        $ctrl.onPropChangedOther = onPropChangedOther;

        $ctrl.preInitGridItem = preInitGridItem;
        $ctrl.getColFromProp = getColFromProp;

        $ctrl.loadItemNow = loadItemNow;

        $ctrl = new GridItemGroupInitCtrlService($ctrl, $element, {
            itemId: $ctrl.itemId
        });

        return $ctrl;

        function rowClsOther() {
            return $ctrl.item ? getRowClass($ctrl.item.type) : '';
        }

        function loadItemNow( ) {
            return $ctrl.item.type === 2 || $ctrl.item.type === 0;//isbanner or setup
        }

        function preInitGridItem() {
            //LIST_FILTERS_TYPE
            //LIST_FILTERS_COLUMN
            $ctrl.otherListFilters = [
                {prop: 'TYPE', value: numberingType},
                {prop: 'COMP', value: 'isComp'}
            ];

            $ctrl.isCustom = isCustomNumbering($ctrl.numberingType);

            $ctrl.fullscreenList = false;

            $ctrl.itemId = $ctrl.item._id;
            if ($ctrl.item.type === undefined || $ctrl.item.type === null) {
                $ctrl.item.type = 1;
            }

            setEstTime();

            if($ctrl.isMasonary){
                $ctrl.bindingNames = ['onUpdatedImage'];
            }
        }

        function isCustomNumbering(t){
            return t ? (t.toString() === '3') : false
        }


        function replaceClsCond() {
            return $ctrl.isGridView;
            //todo bring back
                //|| $ctrl.item.type === 0 || $ctrl.item.type === 2;
        }

        function getColFromProp(prop) {
            var c = $ctrl.getColFromPropInit(prop);
            return $ctrl.isComp && (prop === 'time' || prop === 'endTime' || prop === 'estTime') ? _.extend({isComp: true}, c) : c;
        }

        function onPropChangedOther(prop, newVal){
            console.log('onPropChangedOther');
            if(prop === numberingType){
                newVal = newVal ? parseInt(newVal, 10) : null;
                if($ctrl.numberingType !== newVal) {
                    changeShotNumber(newVal);
                }
            } else if(prop === 'isComp'){
                $ctrl.isComp = newVal === true;
                processTimes();
            }
        }

        function setEstTime(){
            if ($ctrl.isComp) {
                $ctrl.item.estTimeComp = ($ctrl.item.prepTime || 0) + ($ctrl.item.shootTime || 0);
            }

        }

        function processTimes() {
            setEstTime();
            _.each(['time', 'endTime', 'estTime'], function (prop) {
                $ctrl.updatePropContent(prop);
            });
        }

        function updateEditableItemPropsAll(changes) {
            postInitItem();

            var el,
                isBanner = $ctrl.shotTypes && $ctrl.item.type === $ctrl.shotTypes.Banner,
                isShot = $ctrl.shotTypes && $ctrl.shotTypes && $ctrl.item.type === $ctrl.shotTypes.Shot,
                prop = 'color';

            if ((isShot || isBanner) && $ctrl.hasPropChanged(changes, prop)) {
                //top-color-bar  color-column6
                el = $ctrl.element.querySelector('.' + $ctrl.SBFieldTypesService.getPropMark(prop));
                if(el) {
                    $ctrl.LCS.setCSSStyle(el, 'background-color', $ctrl.item.color ? $ctrl.item.color :
                        (isBanner ? $ctrl.LCS.shotBannerColor : 'white'));
                    if (isBanner) {
                        $ctrl.LCS.setCSSStyle(el, 'border-color', $ctrl.SBFieldMethods.getBannerColor($ctrl.item));
                    }
                }

                if(isBanner){
                    if(!$ctrl.withTextBlock) {
                        el = $ctrl.element.querySelector('.b-with-border');
                        if (el) {
                            $ctrl.LCS.setCSSStyle(el, 'border-color', $ctrl.SBFieldMethods.getBorderColor($ctrl.item));
                        }

                        _.each($ctrl.element.querySelectorAll('.banner-content'), function (el) {
                            $ctrl.LCS.setCSSStyle(el, 'color', $ctrl.SBFieldMethods.getBannerColor($ctrl.item));
                        });
                    }
                }
            }

            if(isBanner && $ctrl.withTextBlock){
                var styleChanged = $ctrl.hasPropChanged(changes, 'noteStyle');
                if($ctrl.hasPropChanged(changes, 'note') || styleChanged) {

                    if($ctrl.isMasonary) {
                        var height = $ctrl.elRowSchedule ? $ctrl.elRowSchedule.offsetHeight : null;
                        if (height && $ctrl.itemHeight !== height) {
                            $ctrl.itemHeight = height;
                            return $ctrl.triggerAction(null, 'onUpdatedImage', 'heightChanged');
                        }
                    }

                    if(styleChanged) {
                        $ctrl.LCS.addClass($ctrl.elRowSchedule, 'list-view-row');
                    }
                }
            }

            /* //for moodboard
            if(isShot){
                prop = 'likes';
                if($ctrl.hasPropChanged(changes, prop)) {
                    console.log('likes: ');
                }

                prop = 'commentsCount';
                if($ctrl.hasPropChanged(changes, prop)) {
                    console.log('comments Count: ');
                    //  $ctrl.elRowSchedule.querySelector('plural'+sb-prop-commentsCount' )
                }
            }*/

            prop = 'shotNo';
            if ($ctrl.hasPropChanged(changes, prop) &&
                ($ctrl.numberingType && $ctrl.numberingType.toString() !== '1')) {
                changeShotNumber($ctrl.numberingType);
            }

            if($ctrl.isComp) {
                processTimes();
            }
        }

        function changeShotNumber(type){
            console.log('changeShotNumber to ' + type);
            var prop = 'shotNo';
            var isCustom = isCustomNumbering(type),
                el = $ctrl.element.querySelector('.shotnoprop');
            if (el) {
                var el1 = el.querySelector('.'+$ctrl.SBFieldTypesService.getPropMark(prop));
                if(el1 && !isCustom){
                    el1.innerText = $ctrl.SBFieldMethods.getShotNo($ctrl.item, type, prop);
                }
                if(isCustom !== $ctrl.isCustom) {
                    $ctrl.LCS[isCustom ? 'addClass' : 'removeClass'](el1, 'sb-hide');
                    $ctrl.LCS[isCustom ? 'removeClass' : 'addClass'](el.querySelector('.shotnoc'), 'sb-hide');
                }
            }

            $ctrl.numberingType = type;
            $ctrl.isCustom = isCustom;
        }

        function postInitItem() {
            var isAdd = $ctrl.shotTypes && !$ctrl.isGridView && ($ctrl.item.type === $ctrl.shotTypes.Banner),
                isPrint = $ctrl.shotTypes && !$ctrl.isGridView && $ctrl.item.type === $ctrl.shotTypes.Shot && $ctrl.isPrintLayout;

            if((isAdd || $ctrl.isPrintLayout) && $ctrl.elRowScheduleTemp){
                $ctrl.LCS.removeClass($ctrl.elRowScheduleTemp, 'with-white-bg');
            }

            $ctrl.LCS.setCSSStyle($ctrl.elRowSchedule, 'background-color', $ctrl.item.color, !isAdd);
            $ctrl.LCS[isAdd ? 'addClass' : 'removeClass']($ctrl.elRowSchedule, $ctrl.SBFieldMethods.getColorClass($ctrl.item));

            //todo???
            isAdd = !$ctrl.isGridView && isLast;
            $ctrl.LCS[isAdd ? 'addClass' : 'removeClass']($ctrl.elRowSchedule, 'list-view-row' + (isAdd ? '' : ' border'));

            if ($ctrl.shotTypes) {
                set($ctrl.shotTypes.Banner, 'note');
                set($ctrl.shotTypes.Setup, $ctrl.setupCls);
            }

            if($ctrl.elRowSchedule) {
                $ctrl.itemHeight = $ctrl.elRowSchedule.offsetHeight;
            }

            function set(type, cls) {
                $ctrl.LCS[ $ctrl.item.type === type ? 'addClass' : 'removeClass']($ctrl.elRowSchedule, cls);
            }
        }

        //todo bring back
        function postInitItem1() {
            var replace = $ctrl.replaceClsCond(),
                isBanner = $ctrl.shotTypes && ($ctrl.item.type === $ctrl.shotTypes.Banner),
                isPrint = $ctrl.shotTypes &&
                    //!replace &&
                    $ctrl.item.type === $ctrl.shotTypes.Shot && $ctrl.isPrintLayout;

            if((isBanner || isPrint) && $ctrl.elRowScheduleTemp){
                $ctrl.LCS.removeClass($ctrl.elRowScheduleTemp, 'with-white-bg');
            }

            $ctrl.LCS.setCSSStyle($ctrl.elRowSchedule, 'background-color', $ctrl.item.color, !isPrint);

            $ctrl.LCS[isPrint ? 'addClass' : 'removeClass']($ctrl.elRowSchedule, $ctrl.SBFieldMethods.getColorClass($ctrl.item));

            //todo???
            isPrint = !replace && isLast;
            $ctrl.LCS[isPrint ? 'addClass' : 'removeClass']($ctrl.elRowSchedule, 'list-view-row' + (isBanner ? '' : ' border'));

            if ($ctrl.shotTypes) {
                set($ctrl.shotTypes.Banner, 'note');
                set($ctrl.shotTypes.Setup, $ctrl.setupRowCls);
            }

            function set(type, cls) {
                $ctrl.LCS[(replace && $ctrl.item.type === type) ? 'addClass' : 'removeClass']($ctrl.elRowSchedule, cls);
            }
        }

        function getRowClass1(type) {
            return ($ctrl.isGridView ? ('storyboard-row ' + (!$ctrl.canEdit && $ctrl.item.logoId ? 'with-cursor ' : '')) : 'list-view-row ') +
                ($ctrl.shotTypes && !$ctrl.isGridView ?
                    (type === $ctrl.shotTypes.Banner ? 'note ' : type === $ctrl.shotTypes.Setup ? 'setup ' : 'scene ') : '');
        }

        //todo bring back
        function getRowClass (type) {
            var replace = $ctrl.isGridView && $ctrl.item.type !== 0 && $ctrl.item.type !== 2;
            return (replace ? ('storyboard-row ' + (!$ctrl.canEdit && $ctrl.item.logoId ? 'with-cursor ' : '')): 'list-view-row ') +
                ($ctrl.shotTypes && !replace ?
                    (type === $ctrl.shotTypes.Banner ? ( 'note ' + ($ctrl.withTextBlock ? 'with-text-block ' : '')) :  (type === $ctrl.shotTypes.Setup ? 'setup ' : 'scene ')) : '') +
                ( $ctrl.withoutBorderBottom ? '' : 'border-bottom');
        }

        function showRow(item) {
            return $ctrl.isGridView && item.type !== 1;
        }
    };
}


