angular.module('product.documents.page.init.controller.service', [
    'product.foldersindex.page.init.service',
    'apiServices.Documents',
    'services.blocksSetup'
])
.constant('DocumentsPageCtrlServiceInjectors', {
    pageCtrlService: 'PageTreeSimpleCtrlService',
    listsService: 'DocumentsService',
    service: 'DocumentsService'
})
.service('DocumentsPageInitCtrlService', DocumentsPageInitCtrlService);
DocumentsPageInitCtrlService.$inject = ['FolderIndexPageCtrlService', 'DocumentsPageCtrlServiceInjectors', 'BlocksSetupService'];
function DocumentsPageInitCtrlService(FolderIndexPageCtrlService, pageInjectors, BlocksSetupService) {
return function ($ctrl, $element, constantsService) {
    $ctrl.BlocksSetupService = BlocksSetupService;

        $ctrl.withDocumentInline = constantsService.CompOptions.withDocumentInline;

        if($ctrl.withDocumentInline) {
            $ctrl.withoutGroupSorting = true;
            $ctrl.getInlineDocumentContainer = getInlineDocumentContainer;
        }
        if(!$ctrl.getInlineDocumentContainer) {
            $ctrl.getInlineDocumentContainer = getInlineDocumentContainer;
        }

        $ctrl.hideGridViewFilters = hideGridViewFilters;
        $ctrl.onPageLoadedInit = onPageLoadedInit;
        $ctrl.getOperationName = getOperationName;

         $ctrl.getCollabBannerInfo = getCollabBannerInfo;

        $ctrl = new FolderIndexPageCtrlService($ctrl, $element, _.extend({}, pageInjectors, {
            constantsService: constantsService
        }), {
            constantsService: $ctrl.withDocumentInline ? {
                goToOtherNodeIfEmpty: true,
                objectType: 'document',
                elemType: 'DOCUMENT',
            } : null,
            listTreeServiceParams: _.extend({
                maxLevel: $ctrl.BlocksSetupService.getCurrentTodoPage().maxLevel,
            }, $ctrl.withDocumentInline ? {
                sidebarTitle: 'Freeform Documents',
                withoutEmptyState: true,
                addListOnEmptyState: true,
                goToOtherNodeIfEmpty: true,
            } : null)
        });

        return $ctrl;

    function getCollabBannerInfo(){
        return {name: 'notes'};
    }
        function getOperationName(item){
            return item.type === 3 ? 'Avscript' : (item.type === 1 ? 'Document' : 'Screenplay');
        }

        function getInlineDocumentContainer(){
            return '<div ng-show="$ctrl.listTreeService.active.selectedListId" class="inline-document h-full" style="display: flex"><document-page class="document-page display-block clearfix full-width" document-id="::$ctrl.documentId" with-document-inline="::$ctrl.withDocumentInline" is-inside-other-page="true"></document-page></div>';
        }

        function onPageLoadedInit(){
            if($ctrl.allInfoLoaded && $ctrl.withDocumentInline){
                $ctrl.isGridView = false;
                $ctrl.LCS.addClass($ctrl.element, 'with-document-inline display-table');
            }
        }

        function hideGridViewFilters(){
            return $ctrl.withDocumentInline === true;
        }
    }
}

angular.module('product.foldersindex.page.init.service', [
    'product.documents.group.component',
    'product.documents.item.edit.component',
    'page.tree.simple.controller.service',
    'page.tree.simple.controller.service.injector',

])
.service('FolderIndexPageCtrlService', FolderIndexPageCtrlService);
FolderIndexPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', '$injector', 'BlocksSetupService'];
function FolderIndexPageCtrlService(pageCtrlServiceInjector, $injector, BlocksSetupService) {
    return function ($ctrl, $element, pageInjectors, other
         /*{
              compOptions,
              constantsService,
              listTreeServiceParams,
              keyboardServiceParams
          }*/
    ) {
        $ctrl.BlocksSetupService = BlocksSetupService;

        $ctrl.preBroadcastPreload = preBroadcastPreload;
        if(!$ctrl.getGroupBodyAddon) {
            $ctrl.getGroupBodyAddon = getGroupBodyAddon;
        }
        if(!$ctrl.getParams) {
            $ctrl.getParams = getParams;
        }

        $ctrl.onAddItemBtn = onAddItemBtn;
        $ctrl.onPageLoaded = onPageLoaded;

        if(!$ctrl.hideGridViewFilters) {
            $ctrl.hideGridViewFilters = hideGridViewFilters;
        }
        $ctrl.onLoadDirectory = onLoadDirectory;

        if(!$ctrl.getOperationName) {
            $ctrl.getOperationName = getOperationName;
        }
        if(!$ctrl.getInlineDocumentContainer) {
            $ctrl.getInlineDocumentContainer = getInlineDocumentContainer;
        }
        if(!$ctrl.getChildListField){
            $ctrl.getChildListField = getChildListField;
        }
        if(!$ctrl.onLoadDirectoryParams) {
            $ctrl.onLoadDirectoryParams = onLoadDirectoryParams;
        }

        $ctrl.todoPage = $ctrl.BlocksSetupService.getCurrentTodoPage();
        $ctrl.childTodoPage = $ctrl.todoPage ? $ctrl.BlocksSetupService.getChildPage($ctrl.todoPage._id) : null;

        var constantsService1 = _.extend({}, getInj('constantsService'));

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, {
            constantsService: _.extend({}, constantsService1, other.constantsService, {
                ViewProp: constantsService1.ViewProp + $ctrl.todoPage._id,
            }),
            listsService: getInj('listsService'),
            service: getInj('service'),
            listOptionsService: getInj('listOptionsService'),
            otherOptions: {
                compOptions: _.extend({
                    itemTitle: $ctrl.todoPage.text.substring(0, $ctrl.todoPage.text.length - 1),
                    itemIcon: $ctrl.todoPage.icon,
                    pageClass: $ctrl.todoPage.pageClass,
                    childListField: $ctrl.getChildListField(),
                    childListPage: $ctrl.childTodoPage ? $ctrl.childTodoPage.name : null
                }, other.compOptions),
                listTreeServiceParams: other.listTreeServiceParams,
                keyboardServiceParams: other.keyboardServiceParams,
                sidebarOptions: _.extend({
                    getTreeFilters: $ctrl.getTreeFilters
                }, typeof($ctrl.getOtherSidebarOptions) === 'function' ? $ctrl.getOtherSidebarOptions () : null)
            }
        });

        $ctrl.filtersClass = 'small';

        if(typeof ($ctrl.shouldLoad)==='function'){
            $ctrl.listTreeService.shouldLoad = $ctrl.shouldLoad;
        }

        return $ctrl;

        function getChildListField(){
            return $ctrl.childTodoPage ? $ctrl.childTodoPage.uId : null;
        }

        function getInlineDocumentContainer(){
            return '';
        }

        function getInj(v) {
            var val = pageInjectors[v] ;
            return val && typeof(val) === 'string' ? $injector.get(val) : (val ? val : null);
        }

        function onPageLoaded(){
            if($ctrl.onPageLoadedInit) {
                $ctrl.onPageLoadedInit();
            }
            if($ctrl.onPageLoadedOther) {
                $ctrl.onPageLoadedOther();
            }
        }

        function getGroupBodyAddon() {
            return {
                'on-load-directory': '"$ctrl.onLoadDirectory(item)"',
                'document-id': '"$ctrl.documentId"',
                'with-document-inline': '"::$ctrl.withDocumentInline"'
            };
        }

        function onLoadDirectoryParams(item){
            var p =  null;
            if($ctrl.childListField) {
                 p = {};
                p[$ctrl.childListField] = item._id;
            }
            return p;
        }

        function onLoadDirectory(item) {
            if (item) {
                console.log('onLoadDirectory: ' + item._id);
                if (item.isFolder) {
                    $ctrl.broadcastRoot('FOLDER_CHANGED_' + $ctrl.elemType + '_TREE', item);
                }else{
                    if($ctrl.withDocumentInline) {
                        $ctrl.broadcastRoot('FILE_CHANGED', item);
                    }else {
                        var p = _.extend({
                                treeType: $ctrl.treeType,
                                productId: $ctrl.CPS.productId
                            },
                            $ctrl.onLoadDirectoryParams ? $ctrl.onLoadDirectoryParams(item) : null
                        );

                        if($ctrl.CPS.isCollaborator){
                            $ctrl.popupsService.open(null, $ctrl.popupsService.operations['single' + $ctrl.getOperationName(item)], p, $ctrl.compOptions);
                        }else{
                            var params = $ctrl.CPS.currentPathParams(p, $ctrl.CPS.rolePaths.currentUserPath);
                            if(item.firstTime){
                                $ctrl.SBStateService.assignUrl($ctrl.CPS.getStateHref($ctrl.childListPage, params));
                            }else{
                                $ctrl.LCS.timeout(function (){
                                    $ctrl.CPS.transitionTo($ctrl.childListPage, params);
                                }, 300);
                            }
                        }
                    }
                }
            }else{
                console.log('set empty state');
                if($ctrl.withDocumentInline) {
                    $ctrl.broadcastRoot('FILE_CHANGED', {item: {_id:'null', versionId: null}});
                }
            }
        }

        function getParams() {
            return {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                type: $ctrl.treeType,
            };
        }

        function preBroadcastPreload() {
             $ctrl.listTreeService.level0Name = 'All ' + $ctrl.title;
        }

        function onAddItemBtn(e) {
            console.log('onAddItemBtn');
            $ctrl.preventDefault(e);
            $ctrl.addItem($ctrl.treeType, {item: null, addFolder: true, isParent: true, useSelected: true, e:e});
        }

        function hideGridViewFilters(){
            return false;
        }

        function getOperationName(item){
            return $ctrl.itemTitle;
        }
    }
}

angular.module('product.documents.item.edit.component', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'apiServices.Documents',
    'apiServices.DocumentTemplates',
    'apiServices.DocumentVersions'
])
.component('documentEditPopup', popupComponentParams('DocumentEditPopupCtrl'))
.controller('DocumentEditPopupCtrl', DocumentEditPopupCtrl);
DocumentEditPopupCtrl.$inject = ['GeneralItemEditCtrlService', 'DocumentTemplatesService', '$element'];
function DocumentEditPopupCtrl(GeneralItemEditCtrlService, DocumentTemplatesService, $element) {
    var $ctrl = this;
    $ctrl.isPopup = true;
    
    $ctrl.disabledText = '$ctrl.isUpdating===true||$ctrl.isBtnDisabled()';

    $ctrl.templates = null;
    $ctrl.templateField = 'documentTemplateId';
    var screenplayType = 2;

    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl.postInitGeneral = postInitGeneral;
    $ctrl.getItemPopupTemplate = getItemPopupTemplate;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneral() {
        $ctrl.isSeason = $ctrl.item.isFolder && ($ctrl.item.l === 2 || $ctrl.item.parentId !== null);

        $ctrl.modalBodyFormClass = 'long500';
        $ctrl.templateObject = 'documentTemplate';
        $ctrl.documentTypes = $ctrl.service.documentTypes;
        $ctrl.treeType = $ctrl.extraParam.treeType;

        $ctrl.changedFields = ['name'];
        var notesProp = 'description';
        if($ctrl.treeType === 3){
            $ctrl.popupImgCls = 'col120 colh180';
            $ctrl.changedFields = ['name', notesProp];

            if($ctrl.item.isFolder) { //series & season
                $ctrl.changedFields = $ctrl.changedFields.concat(['logo', 'logoId']);

                 if($ctrl.isSeason) {//season
                     $ctrl.columnsList = null;
                     $ctrl.versionProp = 'prefix';
                     $ctrl.changedFields = $ctrl.changedFields.concat([$ctrl.versionProp]);
                     $ctrl.getVersionColumn = function (withoutColor) {
                         return _.extend({}, _.find($ctrl.extraParam.columnsList, {prop: $ctrl.versionProp}), {withoutColor: withoutColor});
                     };

                     $ctrl.setColorWithVersionAndDesc(true, true);
                 }
            } else {//av script
                $ctrl.versionProp = 'customEpNo';
                $ctrl.changedFields = $ctrl.changedFields.concat([$ctrl.versionProp]);
                $ctrl.columnImg = null;
            }
        }
        $ctrl.onSaveGeneral = onSaveGeneral;
    }

    function getIcon(){
                //avscript
        return $ctrl.item.isFolder ? ($ctrl.item.type === 3 ? ($ctrl.isSeason ? $ctrl.iconForList : $ctrl.iconForGroup) : $ctrl.iconForGroup) : $ctrl.itemIcon;
    }

    function getName(){
        //avscript
        return $ctrl.item.isFolder ? ($ctrl.item.type === 3 ? ($ctrl.isSeason ? $ctrl.nameForList : $ctrl.nameForGroup) : $ctrl.nameForGroup) : $ctrl.itemTitle;
    }

    function postInitGeneral() {

        $ctrl.templatesService =  DocumentTemplatesService;

        $ctrl.isFolder = $ctrl.item.isFolder;
        $ctrl.icon = $ctrl.isDuplicate ? 'copy' : getIcon();
        $ctrl.iconLevel = 3;
        $ctrl.itemTitle = getName();

       /* if ($ctrl.isFolder) {
            $ctrl.item.name = null;
        }*/

        $ctrl.saveItem = saveItem;

        if ($ctrl.treeType === screenplayType || !($ctrl.isNew && !$ctrl.isDuplicate)) {
            $ctrl.isLoaded = true;
            return;
        }

        $ctrl.removeTemplate = removeTemplate;
        $ctrl.setTemplate = setTemplate;
        $ctrl.isTemplate = isTemplate;

        loadTemplates();
    }

    function onCustomSave(result, e){
        $ctrl.onCustomSaveInit(result, e);
        $ctrl.onSave(result);
    }

    function saveItem() {
        if (!$ctrl.isNew) {
            if($ctrl.isUpdating){return;}
            $ctrl.isUpdating = true;
            $ctrl.listItemUpdates = $ctrl.service.getChanges($ctrl.changedFields, $ctrl.item, $ctrl.copyItem);
            if ($ctrl.listItemUpdates) {
                $ctrl.listItemUpdates._id = $ctrl.item._id;
                $ctrl.service.update(_.extend({actiontype: 'rename'}, $ctrl.listItemUpdates), function (result) {
                    result.eventType = 'CHANGED_FIELD';
                    result.editchanges = $ctrl.listItemUpdates;
                    result.item = $ctrl.service.convertResource(result.item);
                  //  onCustomSave(result);
                    //doc
                    if($ctrl.item.type === 1) {
                        $ctrl.broadcastRoot('RENAME_GROUP_DOCUMENT_ITEM', result);
                        $ctrl.closePopup();
                    }else{
                        onCustomSave({item: $ctrl.item});
                    }

                }, $ctrl.onCustomError);
            } else {
                onCustomSave({item: $ctrl.item, noUpdates: true});
            }
        } else {
            $ctrl.error = null;
            if ($ctrl.isDuplicate) {
                var p = {
                    documentId: $ctrl.item.afterId,
                    name: $ctrl.item.name,
                    isDuplicate: true,
                    isFolder: $ctrl.item.isFolder
                };
                p[$ctrl.listField] = $ctrl.item[$ctrl.listField];
                p.type = $ctrl.treeType;
                $ctrl.item = p;
            } else {
                $ctrl.item.type = $ctrl.treeType;
                $ctrl.item[$ctrl.templateField] = $ctrl.template ? $ctrl.template._id : null;
            }
            $ctrl.save();
        }
    }

    function onSaveGeneral(result) {
        var item = result.item;
        if ($ctrl.isNew && !$ctrl.isFolder) {
            item.firstTime = true;
            $ctrl.extraParam.onLoadDirectory(item);
        }
        if(!$ctrl.isNew && item.isFolder){
            $ctrl.broadcastRoot('NAME_CHANGED_' + $ctrl.elemType + '_TREE', result);
        }
    }

    function loadTemplates() {
        //todo remove line below to bring back templates: DocumentEditPopupCtrl
        //final(true);return;
        $ctrl.templatesService.getAll({
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId,
            type: $ctrl.treeType
        }, null, null, onsuccess, onerror);

        function onsuccess(templates) {
            try {
                $ctrl.templates = [{
                    _id: null,
                    name: 'Blank',
                    isPredefined: true
                }];
                if(templates && templates.length > 0){
                    $ctrl.templates = _.sortBy($ctrl.templates.concat(templates), 'isPredefined');
                }
            } catch (e) {
                console.log(e);
            }
            final();
        }

        function onerror(err) {
            console.log(err);
            final(true);
        }

        function final(isNull){
            if(isNull){
                $ctrl.templates = null;
            }
            $ctrl.isLoaded = true;
            $ctrl.reloadTemplate();
        }
    }

    function removeTemplate(id, e) {
        var item = getItem(id);
        if (!item) {
            return;
        }
        $ctrl.error = null;

        var withconfirm = false;
        if (withconfirm) {
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations.treeKeyboardActions, {
                btn: 'Apply',
                icon: 'trash',
                title: 'Are you sure?',
                message: 'Are you sure you want to remove this template?',
                itemTitle: 'template',
                onConfirm: onConfirm
            }, $ctrl.compOptions);
        } else {
            onConfirm()
        }

        function onConfirm() {
            $ctrl.templatesService.delete(item, function (el) {
                if (el.item) {
                    el = el.item;
                }
                for (var i = $ctrl.templates.length - 1; i >= 0; i--) {
                    if ($ctrl.templates[i]._id === el._id) {
                        $ctrl.templates.splice(i, 1);
                    }
                }
                oncomplete('success');
                $ctrl.LCS.removeElement($ctrl.LCS.findClosestParent(e.target, 'li'));

            }, function (err) {
                oncomplete('error');
            });
        }

        function oncomplete(type) {
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.templateObject + '.Remove.' + type, type, {name: item.name});
        }
    }

    function setTemplate(id) {
        setActive($ctrl.template, false);
        var t = getItem(id);
        setActive(t, true);
        $ctrl.template = t;
    }

    function setActive(item, isActive) {
        $ctrl.LCS[isActive ? 'addClass' : 'removeClass']($ctrl.element.querySelector('.modal-templates li[data-info="' + (item ? item._id : 'null') + '"]'), 'active');
    }

    function isTemplate(item) {
        return getCurrentTemplateId() === item._id;
    }

    function getCurrentTemplateId(){
        return $ctrl.template ? $ctrl.template._id : null;
    }

    function getItem(id){
        return id ? _.find($ctrl.templates, {_id: id}) : null;
    }

    function getTemplates() {
        if (!$ctrl.templates) {
            return '';
        }
        var els = '', elsP = '';
        _.each($ctrl.templates, function (t, i) {
            var isPredef = t.isPredefined,
                c = t.color ? t.color : '#FFF';
            els += '<li class="' + $ctrl.getBtnActionCls() + ($ctrl.isTemplate(t) ? ' active' : '') + '" data-type="setTemplate" data-info="' + t._id + '">' +
                '<div class="box centering with-transition"' +
                (c ? (' style="background-color:' + c + ';color:white"') : '') +
                '>' +
                $ctrl.LCS.getISBDiv(t.icon ? t.icon : 'star', 2, 'sbf36 gray with-transition') +
                '</div>' +
                '<div class="info text-center">' +
                '<span class=""' + (t.name.length > 15 ? ('tooltip="' + t.name + '" tooltip-placement="bottom"') : '') + '>' + t.name + '</span>' +
                '</div>' +
                (isPredef ? '' : ('<div class="' + $ctrl.getBtnActionCls() + ' remove" data-type="removeTemplate" data-info="' + t._id + '">' + $ctrl.LCS.getISBDiv('wrong', 2, 'gray') + '</div>')) +
                '</li>';
        });

        return '<ul class="modal-templates document-template-type centering">' + els + '</ul>';
    }

    function getItemPopupTemplate() {
        var pageClass = $ctrl.pageClass ? (' ' + $ctrl.pageClass + ' page-class'):'';
        if (!$ctrl.isLoaded) {
            return '<preloader-center class="preloader ' + pageClass + '"></preloader-center>';
        }

        var has2steps = ($ctrl.isNew || $ctrl.isDuplicate) && !$ctrl.item.isFolder && $ctrl.templates && $ctrl.templates.length > 1;
        var l = [{
            btn: getFirstStepBtn(has2steps),
            body: getFirstBody(has2steps),
            headerInfo:{
                icon: $ctrl.icon,
                iconLevel: $ctrl.iconLevel,
                title: ($ctrl.isNew ? 'Name' : 'Rename') + ' Your ' + $ctrl.itemTitle
            }
        }];

        if (has2steps) {
            l.push({
                btn: getSecStepBtn(),
                body: getSecondBody(),
                headerInfo: {
                    icon: $ctrl.icon,
                    title: 'Select a ' + $ctrl.CPS.capitalizeFirst($ctrl.itemTitle) + ' Template'
                }
            });
        }

        return $ctrl.getItemPopupMSForm(l, null, false);

        function getFirstStepBtn(has2Steps) {
            return has2Steps ? ('<button class="max-width200 btn btn-primary nextbtn ' + pageClass + '" type="button" ng-disabled="$ctrl.isBtnDisabled()" ng-class="{\'disabled\':' + $ctrl.disabledText + '}">Next »</button>') :
                ('<button data-required="true" ng-disabled="' + $ctrl.disabledText + '" ng-class="{\'disabled\':' + $ctrl.disabledText + '}" class="' + $ctrl.getBtnActionCls() + ' max-width200 btn btn-primary ' + pageClass+ '" type="submit" data-type="saveItem" analytics-on analytics-action="' + (($ctrl.isNew ? 'Create' : 'Save') + ' ' + $ctrl.itemTitle) + '"> <span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> <span>' + (($ctrl.isNew ? 'Create' : 'Save') + '</span><span class="hide-ipad"> ' + $ctrl.itemTitle + '</span>') + '</button>');
        }

        function getFirstBody(has2steps) {
            return '<div class="centering max-width-424" >' + $ctrl.getPopupForm() + '</div>' +
                (has2steps?('<ul class="progressdots hide-ipad ' + pageClass+'">' +
                    '<li><button class="with-primary-bg-before active"></button></li>' +
                    '<li><button data-required="true" class="nextbtn" ng-disabled="$ctrl.isBtnDisabled()"></button></li>' +
                    '</ul>'):'');
        }

        function getSecStepBtn() {
            return '<button class=" hide-ipad max-width200 btn btn-small transparent big '+pageClass+'-outline previousbtn" type="button">« Previous</button>' +
                '<button ng-disabled="'+$ctrl.disabledText+'" ng-class="{\'disabled\':'+$ctrl.disabledText+'}" class="'+$ctrl.getBtnActionCls()+' max-width200 btn btn-primary ' + pageClass+'" type="submit" data-type="saveItem" analytics-on analytics-action="Create '+$ctrl.itemTitle+'"> <span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> <span>Create</span> <span class="hide-ipad"> '+$ctrl.itemTitle+'</span></button>';
        }

        function getSecondBody() {
            return '<div class="wrapper-templates">' + getTemplates() +  '</div>' +
                '<ul class="progressdots hide-ipad ' + pageClass+'">' +
                '<li><button class="previousbtn"></button></li>' +
                '<li><button class="with-primary-bg-before active"></button></li>' +
                '</ul>';
        }
    }
}

angular.module('product.documents.item.remove.component', [
