    function getItemTemplate(){
return '<form name="$ctrl.formHolderItem[$ctrl.formName]" class="h-full formHolderItem auto row-scheduleTemp" novalidate autocomplete="off" data-id="'+$ctrl.item._id+'">' +
          $ctrl.nonMobileCloseBtn() +
          '<div class="medium-template">' +
                '<div class="with-min-height" style="background-color: white;border-radius:4px;">' +
