EmailSettingsPageCtrl.$inject = ['UserSettingsCtrlService', '$element'];

function EmailSettingsPageCtrl(UserSettingsCtrlService, $element){
   var $ctrl = this;

    $ctrl.getSettingsTemplate = getSettingsTemplate;
    $ctrl.setTemplateDataSettings = setTemplateDataSettings;

    $ctrl = new UserSettingsCtrlService($ctrl, $element);

    function setTemplateDataSettings() {
        $ctrl.itemChangedFields = ['emailSettings'];
        $ctrl.formName = 'editEmailSettings';
        $ctrl.icon = 'mail';
        $ctrl.popupTitle = 'Email Setting';
        $ctrl.subtitle = 'Control when and how often we send emails';
