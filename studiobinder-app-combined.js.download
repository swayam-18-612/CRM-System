PreloaderCenterCtrlService.$inject =['TemplateCompileService'];
function PreloaderCenterCtrlService(TemplateCompileService) {
    return function ($ctrl, $element, type) {
        var withoutTemplateScope = true;

        $ctrl.$element = $element;
        $ctrl.element = $element[0];
        if(!$ctrl.getTemplate) {
            $ctrl.getTemplate = getTemplate;
        }

        $ctrl.$onDestroy = $onDestroy;


        if(!$ctrl.templateCompile) {
            $ctrl.templateCompile = new TemplateCompileService($ctrl.$element, getTemplate, $ctrl, true);
            $ctrl.templateCompile.withoutTimeout = withoutTemplateScope;
            $ctrl.LCS = $ctrl.templateCompile.LCS;
        }

        $ctrl.templateCompile.loadTemplate(onLoaded);

        return $ctrl;

        function getTemplate() {
            return '<div class="circled-img-check' + ($ctrl.cls ? (' ' + $ctrl.cls) : '') + '"><div class="sbAnimLoader centered"></div></div>';
        }

        function onLoaded() {
            $ctrl.animElem = $ctrl.element.querySelector('.sbAnimLoader');
            var configs = $ctrl.LCS.API_CONFIGS;
            $ctrl.path = ('https://'+configs.staticDomain + '/'+configs.distdir + '/') + 'animations/Sb_';
            if (!$ctrl.type) {
                $ctrl.type = type ? type : 'Loader_Circle';// 'Bounce_Medium';
            }

            if(bodymovin) {
                bodymovin.setLocationHref(document.location.href);
                $ctrl.animation = bodymovin.loadAnimation({
                    container: $ctrl.animElem,
                    renderer: 'svg',
                    loop: $ctrl.dontLoop === 'true' ? false : true,
                    autoplay: true,
                    path: $ctrl.path + $ctrl.type + '.json'
                });
            }

            if($ctrl.color){
                bind(true);
            }
            //$ctrl.LCS.bindElementListeners(true, anim, doalert, 'complete');
        }

        // 'Bounce' 'Bounce_Fast' 'Bounce_Med' 'Bounce_Slow' 'Bounce_Medium
        function $onDestroy() {
            if ($ctrl.animation) {
                console.log('remove animation');
                bind(false);
               if(bodymovin) {
                   bodymovin.destroy($ctrl.animation);
               }
            }
            if ($ctrl.templateCompile) {
                $ctrl.templateCompile.destroyNewScope();
            }
        }
        
        function bind(isBind) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.animation, animate, null, 'DOMLoaded');
            function animate(e) {
                // $ctrl.LCS.bindElementsClick(true, $ctrl.animation, 'enterFrame', function(ev){
                console.log('$ctrl.animation DOMLoaded');
                var el = $ctrl.element.querySelector('.sbAnimLoader');
                _.each(el.querySelectorAll('svg path'), function (el) {
                    el.setAttribute('fill', $ctrl.color);
                });
            }
        }
    }
}


angular.module('components.stepper', [])
.component('stepper', {
    bindings : {
        min: '<',
        max: '<',
        value: '<',
        disabled: '<',
        onUpdated: '&'
    },
    controller: 'StepperCtrl'
})
.controller('StepperCtrl', StepperCtrl);
StepperCtrl.$inject = ['TemplateCompileCtrlService', '$element'];
function StepperCtrl(TemplateCompileCtrlService, $element) {
    var  withoutTemplateScope = false;

    var $ctrl = this;

    $ctrl.TemplateCompileCtrlService = TemplateCompileCtrlService;

    $ctrl.changedFields = ['value'];

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.$onChanges = $onChanges;

    $ctrl.increment = increment;
    $ctrl.decrement = decrement;

    $ctrl = new $ctrl.TemplateCompileCtrlService($ctrl, $element, withoutTemplateScope);

    function getItemTemplate() {
        var readonly = true;
    return '<div class="spinner-buttons input-group-btn">' +
                '<button type="button" class="btnDecrement btn spinner-down minus" ' +
                (($ctrl.disabled || isOverMin(false, $ctrl.value))? 'disabled="disabled" ' : '') +
                '></button>' +
            '</div>' +
            '<input type="number" class="col40 form-control' + (readonly ? ' without-underline' : '') + '" ' + (readonly ? 'readonly="readonly"' : '')  +
            ($ctrl.disabled ? 'disabled="disabled" ' : '')+
            'style="text-align: center">' +
            '<div class="spinner-buttons input-group-btn">' +
                '<button type="button" class="btnIncrement btn spinner-down plus" ' +
                (($ctrl.disabled || isOverMax(false, $ctrl.value))? 'disabled="disabled" ' : '')+
                '></button>' +
            '</div>';
    }

    function setFieldValue(){
        $ctrl.prevValue = $ctrl.value;
        $ctrl.inputField.value = $ctrl.value;
    }

    function onLoaded() {
        $ctrl.inputField = $ctrl.element.querySelector('input');
        setFieldValue();

        $ctrl.btnIncrement = $ctrl.element.querySelector('.btnIncrement');
        $ctrl.btnDecrement = $ctrl.element.querySelector('.btnDecrement');

        bind(true);
        // check validity on start, in case we're directly out of bounds
        checkValidity($ctrl.value);
    }

    function setd(){
        setDisabled($ctrl.btnIncrement, isOverMax(false, $ctrl.value));
        setDisabled($ctrl.btnDecrement, isOverMin(false, $ctrl.value));
    }
    function onDestroy() {
        bind(false);
    }

    function bind(isBind){
        if($ctrl.disabled){return;}

        $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnIncrement, $ctrl.increment);
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnDecrement, $ctrl.decrement);

        $ctrl.LCS.bindElementsClick(isBind, $ctrl.inputField, onBlur, null, 'blur');
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.inputField, onKeyUp, null, 'keydown paste');
    }

    function onBlur(e){
        console.log ('onBlur');
        $ctrl.preventDefault(e);
        process();
    }

    function onKeyUp(e){
        console.log ('onKeyUp');
        if (e.type === 'paste') {
            process;
            return;
        }

        switch (e.which) {
            case 13: //enter
            case 9: //tab
            case 27: //esc
                $ctrl.preventDefault(e);
                process();
                break;

            default:
                if(isValid(e)) {
                    $ctrl.LCS.timeout(function () {
                        process();
                    }, 0);
                    e.stopPropagation();
                }
                break;
        }

        function isValid(e) {
            // Handle paste
            if (e.type === 'paste') {
                key = e.clipboardData.getData('text/plain');
            } else {
                // Handle key press
                var key = e.keyCode || e.which;
                key = 96 <= key <= 105 ? parseInt(e.key, 10) : String.fromCharCode(key);
            }
            var regex = /[0-9]|\./;
            if(!regex.test(key) ) {
                e.returnValue = false;
                if(e.preventDefault) {
                    e.preventDefault();
                }
                return false;
            }
            return true;
        }
    }

    function process() {
        var v = $ctrl.inputField.value === '' ? 1 : parseInt($ctrl.inputField.value, 10);
        if(isOverMin(true, v) && isOverMax(true, v)) {
            setModelValue(v);
        }
    }

    function setModelValue(val) {
        $ctrl.value = val;
        setFieldValue();
        onUpdated(val);
    }

    function checkValidity(v) {
        // check if min/max defined to check validity
        if (isOverMin(true, v)) {
            setModelValue($ctrl.min);
        }
        if (isOverMax(true, v)) {
            setModelValue($ctrl.max);
        }
        return true;
    }

    function onUpdated(val){
        if ($ctrl.onUpdated) {
            $ctrl.onUpdated({val: val});
        }
    }


    // update the value when user clicks the buttons
    function increment() {
        updateModel(+1);
        setd();
    }

    function decrement() {
        updateModel(-1);
        setd();
    }

    function updateModel(offset) {
        setModelValue($ctrl.value + offset);
    }


    function isOverMin(strict, v) {
        var offset = strict ? 0 : 1;
        return angular.isDefined($ctrl.min) && (v - offset) < parseInt($ctrl.min, 10);
    }

    function isOverMax(strict, v) {
        var offset = strict ? 0 : 1;
        return angular.isDefined($ctrl.max) && (v + offset) > parseInt($ctrl.max, 10);
    }

    function setDisabled(el, isDisabled){
        if(isDisabled) {
            el.setAttribute('disabled', 'disabled');
        } else{
            el.removeAttribute('disabled');
        }
    }

    function $onChanges(changes) {
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i],
                change = changes[field];
            if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                onChanges(change.currentValue);
                break;
            }
        }
    }

    function onChanges(value){
        setFieldValue();
        checkValidity(value);
    }
}

angular.module('angularytics.directive',[
    'angularytics.provider'
])
.directive('analyticsOn', analyticsOnDirective);

analyticsOnDirective.$inject = ['Angularytics'];
function analyticsOnDirective(Angularytics) {

    function isCommand(el) {
        if(Angularytics.isLink(el)){return 'linkClick';}
        return ['a:', 'button:', 'button:button', 'button:submit', 'input:button', 'input:submit'].indexOf(
            el.tagName.toLowerCase() + ':' + (el.type || '')) >= 0;
    }

    function inferEventType(element) {
        var event = sbDefaultClickEvent || 'click';
        if (isCommand(element)){ return event;}
        return event;
    }

    return {
        restrict: 'A',
        scope: false,
        link: function ($scope, $element, $attrs) {
            var el = $element[0];
            angular.element(el).bind($attrs.analyticsOn || inferEventType(el), function () {
                Angularytics.trackEventWithPars($attrs.analyticsCategory, $attrs.analyticsAction, $attrs.analyticsLabel, $attrs.analyticsValue, el);
            });
        }
    };
}

angular.module('angularytics.ga4', [
    'angularytics.provider'
])
.service('AngularyticsGA4Handler', AngularyticsGA4Handler);
AngularyticsGA4Handler.$inject = ['$window', 'API_CONFIGS'];
function AngularyticsGA4Handler($window, API_CONFIGS) {
    var dataLayer = $window.dataLayer = $window.dataLayer || [],
        app_name = API_CONFIGS().site.appName,
        service = {
            EventTypes: {UserEvents: 'User', SubEvents: 'Sub', QuotaEvents: 'Quota'},
            params: {
                userid: null,
                username: null,
                companyid: null,
                companyname: null,
                productid: null,
                role: null,
                app_name: app_name
            },
            trackPageView: trackPageView,
            trackEvent: trackEvent,
            setUser: setUser
        };

    gtag('js', new Date());

    return service;

    function trackPageView(params, userParams) {
        addToDataLayer('page_view', _.extend(getParams(), {
            date: moment(new Date()).format("DD-MM-YYYY HH:mm:ss"),
        }, params), userParams);
    }

    function trackEvent(category, action, params, userParams) {
        addToDataLayer(action + '_event', _.extend(getParams(category, action, service.EventTypes[category + 'Events']), params), userParams);
    }

    function getParams(category, action, label, value, page_name, page_from){
        return {
            event_category: category || '',
            event_action: action || '',
            event_label: label || '',
            event_value: value || '',

            page_name: page_name || '',
            page_from: page_from || ''
        };
    }

    function setUser(id, params) {
        if (id!== undefined && service.userid !== id) {
            service.userid = id;
            service.params = _.extend(service.params, params);

            dataLayer.push({user_id: id});
            addGtag('config', sbGtag, {user_id: id});
        }
    }

    function addToDataLayer(e, p, up) {
        setUser(up ? up.userId : undefined, up);
        var dl = _.extend({}, service.params, p, up);
        dataLayer.push(_.extend({event: e}, dl));
        if (!service.EventTypes[dl.event_label + 'Events']) {
       //     addGtag('event', e, dl);
        }
    }

function addGtag(ev, e, p){
//return;
try {
    if (gtag) {
        gtag(ev, e, p);
    }
} catch (e) {
    console.log(e);
}
}

function gtag(){
dataLayer.push(arguments);
}
}



angular.module('angularytics.intercomHandler', [
])
    .factory('AngularyticsIntercomHandler',AngularyticsIntercomHandler);
AngularyticsIntercomHandler.$inject = ['$window'];
function AngularyticsIntercomHandler($window) {
    var service = {},
        Intercom = $window.Intercom;
    service.trackEvent = function (category, action, params, userParams) {
        if (typeof(Intercom) === 'function') {
            try {
                Intercom('trackEvent', action, {
                    category: category,
                    action: action,
                    opt_label: params && params.event_label ? params.event_label : null,
                    opt_value: params && params.event_value? params.event_value : null,
                    page_name: params && params.page_name? params.page_name : null
                });
            } catch (e) {
                console.log(e);
            }
        }
    };
    return service;
}

angular.module('angularytics.provider', [
    'services.stateService'
])
    .provider('Angularytics', AngularyticsProvider);
AngularyticsProvider.$inject = [];
function AngularyticsProvider() {
    var eventHandlersNames = ['Google'];
    this.setEventHandlers = function (handlers) {
        if (angular.isString(handlers)) {
            handlers = [handlers];
        }
        eventHandlersNames = [];
        angular.forEach(handlers, function (handler) {
            eventHandlersNames.push(capitalizeHandler(handler));
        });
    };
    var capitalizeHandler = function (handler) {
        return handler.charAt(0).toUpperCase() + handler.substring(1);
    };
    var pageChangeEvent = 'STATE_CHANGED';
    this.setPageChangeEvent = function (newPageChangeEvent) {
        pageChangeEvent = newPageChangeEvent;
    };
    this.$get = ['$injector', 'SBStateService', 'BlocksSetupService', 'security',
        function ($injector, SBStateService, BlocksSetupService, security) {
            var eventHandlers = [];
            angular.forEach(eventHandlersNames, function (handler) {
                eventHandlers.push($injector.get('Angularytics' + handler + 'Handler'));
            });
            var forEachHandlerDo = function (action) {
                angular.forEach(eventHandlers, function (handler) {
                    action(handler);
                });
            };
            var service = {
                EventTypes: {UserEvents: 'User', SubEvents: 'Sub', QuotaEvents: 'Quota'},
                init: init,
                trackEvent: trackEvent,
                trackPageView: trackPageView,
                setUser: setUser,
                onPageChanged: onPageChanged,
                bindEvent: bindEvent,
                trackEventWithPars: trackEventWithPars,
                isLink: isLink,
                trackUserEvent: trackUserEvent,
                trackSubEvent: trackSubEvent,
                trackQuotaEvent: trackQuotaEvent
            };

            return service;

            function init() {
            }

            function isLink(el){
               // return false;
                return el && el.tagName.toLowerCase() === 'a'
                    //&& el.getAttribute('href')
                    ;
            }

            function trackQuotaEvent(event, userId, page_name, el) {
                trackExtraParams(service.EventTypes.QuotaEvents, event, userId, page_name, el)
            }

            function trackUserEvent(event, userId, page_name, el) {
                trackExtraParams(service.EventTypes.UserEvents, event, userId, page_name, el)
            }

            function trackSubEvent(event, userId, page_name, el, extraParams) {
                trackExtraParams(service.EventTypes.SubEvents, event, userId, page_name, el, extraParams)
            }

            function trackExtraParams(l, event, userId, page_name, el, extraParams){
                if (userId){
                    if(el) {
                        el.setAttribute('analytics-label', l);
                    }
                    setTimeout(function () {
                        service.trackEvent(l, l.toLowerCase(), _.extend({
                            event_value: event,
                            //event_action: event,
                            //event_label: l,
                        }, page_name ? {page_name: page_name} : null, extraParams));
                    }, 100);
                }
            }

            function trackEventWithPars(c, a, l, v, el) {
                try {
                    var islink = isLink(el),
                        label = l ? l : ('sb' + (islink ? '_link' : '')),
                        event = 'sb';// label.toLowerCase();
                    if(el) {
                        el.setAttribute('analytics-label', label);
                    }
                    service.trackEvent(c, event, _.extend({}, {
                        event_action: a,
                        event_label: label
                    }, v ? {event_value: v} : null));
                } catch (e) {
                    console.log(e);
                }
            }

            function bindEvent(LCS, el, isBind) {
               // LCS.bindElementsClick(isBind, el, handler
                //    , 'analytics'
               // );

                var ev = sbDefaultClickEvent || 'click';
                if(isBind){
                    process(false);
                }
                process(isBind);

                function process(isBind){
                    el[isBind ? 'addEventListener' : 'removeEventListener'](ev, handler, (ev === 'touchstart' ? {passive: true} : false));
                }
                function handler() {
                    if (el) {
                        console.log(el.getAttribute('analytics-action'));
                        service.trackEventWithPars(el.getAttribute('analytics-category'), el.getAttribute('analytics-action'), el.getAttribute('analytics-label'), el.getAttribute('analytics-value'), el);
                    }
                }
            }

            function trackEvent(category, action, params, userParams) {
                if (!params) {
                    params = {
                        event_label: '',
                        event_value: '',
                        event_noninteraction: ''
                    };
                }
                if (!params.page_name) {
                    params.page_name = SBStateService.getCurrentStateName();
                }
                if (!category) {
                    var todoPage = BlocksSetupService.getCurrentTodoPage();
                    if (todoPage) {
                        category = todoPage.text;
                    }
                    if (!category) {
                        category = params.page_name;
                    }
                }
                forEachHandlerDo(function (handler) {
                    if (action && typeof handler.trackEvent === 'function') {
                        handler.trackEvent(category, action, params, userParams ? userParams : security.getAnalyticsUserParams());
                    }
                });
            }

            function trackPageView(params, userParams) {
                forEachHandlerDo(function (handler) {
                    if (typeof handler.trackPageView === 'function') {
                        handler.trackPageView(params, userParams ? userParams : security.getAnalyticsUserParams());
                    }
                });
            }

            function setUser(id, params) {
                forEachHandlerDo(function (handler) {
                    if (typeof handler.setUser === 'function') {
                        handler.setUser(id, params);
                    }
                });
            }

            function onPageChanged(toState, fromState, userParams) {
                var stateName = toState ? toState.name : null;
                if (service.stateName !== stateName) {
                    service.stateName = stateName;
                    service.trackPageView({
                        page_name: toState ? toState.name : null,
                        from_page: fromState ? fromState.name : null,
                        page_location: SBStateService.getCurrentUrl()
                    }, userParams);
                }
            }
        }
    ];
}

angular.module('components.angularytics',[
    'angularytics.provider',
    'angularytics.intercomHandler',
    'angularytics.ga4',
    'angularytics.directive'
]);

/**
 * @see http://docs.angularjs.org/guide/concepts
 * @see http://docs.angularjs.org/api/ng.directive:ngModel.NgModelController
 * @see https://github.com/angular/angular.js/issues/528#issuecomment-7573166
 */
//in use
angular.module('components.contenteditable', [])
  .directive('contenteditableHtml', contenteditableHtmlDirective);
contenteditableHtmlDirective.$inject = [ 'LCS'];
function contenteditableHtmlDirective(LCS) {
    return {
        restrict: 'A',
        require: '?ngModel',
        scope: {
            'onEnter': '&'
        },
        link: ContentEditableHtmlController
    };

    function ContentEditableHtmlController(scope, $element, attrs, ngModel) {
        var element = $element[0];

        // don't do anything unless this is actually bound to a model
        if (!ngModel) {
            return;
        }

        // options
        var opts = {
            globalRegularExpression: /(https?:\/\/|www\.|mailto:|tel:)[\S]+/gi,
            urlRegularExpression: /(https?:\/\/[\S]+)|(www.[\S]+)|(mailto:[\S]+)|(tel:[\S]+)/i,
            normalizeRegularExpression: /(https?:\/\/[\S]+)|(www.[\S]+)/,
        };
        _.each([
            'pastePlainText',
            'stripBr',
            'stripHtml',
            'oneLine',
            'selectNonEditable',
            'moveCaretToEndOnChange'
        ], function (opt) {
            var o = attrs[opt];
            opts[opt] = o && o !== 'false';
        });


        // model -> view
        var oldRender = ngModel.$render;
        ngModel.$render = $render;
       //todo : come back
        // $element.on('blur', onBlur);

        // view -> model
        $element.on('input', onInput);
        if (opts.selectNonEditable) {
            LCS.bindElementListeners(true, element, onClick);
        }

        if (opts.oneLine) {
            LCS.bindElementListeners(true, element, onKeyPress, 'keypress');
            LCS.bindElementListeners(true, element, onPaste, 'paste');
            //LCS.bindElementListeners(true, element, onBlur, 'blur');
        }

        function onBlur(e, val) {
            scope.$apply(function () {
                setHtml(true);
            });
        }

        function setHtml(isLinkify) {
            var html, html2, rerender;
            html = $element.html().replace(/<\s*script\s*.*>.*<\/\s*script\s*.*>/gi, "");
            rerender = false;
            if (opts.stripBr) {
                html = html.replace(/<br>$/, '');
            }

            if (opts.oneLine) {
                html2 = html.replace(/<div>/g, '').replace(/<br>/g, '').replace(/<\/div>/g, '');
                if (html2 !== html) {
                    rerender = true;
                    html = html2;
                }
            }

            if (opts.stripHtml) {
                html2 = html.replace(/<(?:.|\n)*?>/gm, '');
                if (html2 !== html) {
                    rerender = true;
                    html = html2;
                }
            }

            if (!opts.stripHtml && html && isLinkify) {
                var linked = linkify(html);
                if (linked) {
                    html = linked;
                    rerender = true;
                }
            }

            ngModel.$setViewValue(html);
            if (rerender) {
                ngModel.$render();
            }

            return html;
        }

        function onInput(e) {
            scope.$apply(function () {
                var html = setHtml();
                if (html === '') {
                    // the cursor disappears if the contents is empty
                    // so we need to refocus
                    LCS.timeout(function () {
                        $element[0].blur();
                        $element[0].focus();
                    });
                }
            });
        }

        function $render() {
            var el, el2, range, sel;
            if (!!oldRender) {
                oldRender();
            }
            $element.html(ngModel.$viewValue || '');
            if (opts.moveCaretToEndOnChange) {
                el = $element[0];
                range = document.createRange();
                sel = window.getSelection();
                if (el.childNodes.length > 0) {
                    el2 = el.childNodes[el.childNodes.length - 1];
                    range.setStartAfter(el2);
                } else {
                    range.setStartAfter(el);
                }
                range.collapse(true);
                sel.removeAllRanges();
                sel.addRange(range);
            }
        }

        function onClick(e) {
            var range, sel, target;
            target = e.toElement;
            if (target !== this && angular.element(target).attr('contenteditable') === 'false') {
                range = document.createRange();
                sel = window.getSelection();
                range.setStartBefore(target);
                range.setEndAfter(target);
                sel.removeAllRanges();
                sel.addRange(range);
            }
        }

        function onKeyPress(e) {
            var code = e.keyCode || e.which;
            if (code === 13) {//enter
                e.preventDefault();

                scope.$apply(function () {
                    setHtml();
                    if (scope.onEnter) {
                        scope.onEnter();
                    }
                });
            }
        }

        function onPaste() {
            $('br,p', this).replaceWith(' ');
        }

        function linkify(html) {
            var urlMatch = html.match(opts.globalRegularExpression);
            if (!urlMatch) {
                return false;
            }

            var temp = html.replace(/<a .*>.*<\/a>/gi, "");
            return temp.replace(opts.urlRegularExpression, function(url ) {
                return '<a href="' +normalize(url)+ '" target="_blank">' + url + '</a>';
            }); 
        }

        function normalize(url) {
            if (opts.normalizeRegularExpression.test(url.toLowerCase())) {
                try{
                    return normalizeUrl(url, opts.normalizeUrlOptions);
                }catch(e){return url;} 
            }
            return url;
        }

        function normalizeUrl(urlString, opts1) {
            var opts = Object.assign({
                defaultProtocol: 'http:',
                normalizeProtocol: true,
                forceHttp: false,
                forceHttps: false,
                stripHash: true,
                stripWWW: true,
                removeQueryParameters: [/^utm_\w+/i],
                removeTrailingSlash: true,
                removeDirectoryIndex: false,
                sortQueryParameters: true
            }, opts1);

            urlString = urlString.trim();

            var hasRelativeProtocol = urlString.indexOf('//') === 0;
            var isRelativeUrl = !hasRelativeProtocol && /^\.*\//.test(urlString);

            // Prepend protocol
            if (!isRelativeUrl) {
                urlString = urlString.replace(/^(?!(?:\w+:)?\/\/)|^\/\//, opts.defaultProtocol);
            }

            var urlObj;
            try{
                urlObj = new URL(urlString);
            }catch(e){

            }
            if(urlObj) {
                if (opts.forceHttp && opts.forceHttps) {
                    throw new Error('The `forceHttp` and `forceHttps` options cannot be used together');
                }

                if (opts.forceHttp && urlObj.protocol === 'https:') {
                    urlObj.protocol = 'http:';
                }

                if (opts.forceHttps && urlObj.protocol === 'http:') {
                    urlObj.protocol = 'https:';
                }

                // Remove hash
                if (opts.stripHash) {
                    urlObj.hash = '';
                }

                // Remove duplicate slashes if not preceded by a protocol
                if (urlObj.pathname) {
                    // TODO: Use the following instead when targeting Node.js 10
                    // `urlObj.pathname = urlObj.pathname.replace(/(?<!https?:)\/{2,}/g, '/');`
                    urlObj.pathname = urlObj.pathname.replace(/((?![https?:]).)\/{2,}/g, function (_, p1) {
                        if (/^(?!\/)/g.test(p1)) {
                            return p1;
                        }
                        return '/';
                    });
                }

                // Decode URI octets
                if (urlObj.pathname) {
                    urlObj.pathname = decodeURI(urlObj.pathname);
                }

                // Remove directory index
                if (opts.removeDirectoryIndex === true) {
                    opts.removeDirectoryIndex = [/^index\.[a-z]+$/];
                }

                if (Array.isArray(opts.removeDirectoryIndex) && opts.removeDirectoryIndex.length > 0) {
                    var pathComponents = urlObj.pathname.split('/');
                    var lastComponent = pathComponents[pathComponents.length - 1];

                    if (testParameter(lastComponent, opts.removeDirectoryIndex)) {
                        pathComponents = pathComponents.slice(0, pathComponents.length - 1);
                        urlObj.pathname = pathComponents.slice(1).join('/') + '/';
                    }
                }

                if (urlObj.hostname) {
                    // Remove trailing dot
                    urlObj.hostname = urlObj.hostname.replace(/\.$/, '');

                    // Remove `www.`
                    if (opts.stripWWW && /^www\.([a-z\-\d]{2,63})\.([a-z.]{2,5})$/.test(urlObj.hostname)) {
                        // Each label should be max 63 at length (min: 2).
                        // The extension should be max 5 at length (min: 2).
                        // Source: https://en.wikipedia.org/wiki/Hostname#Restrictions_on_valid_host_names
                        urlObj.hostname = urlObj.hostname.replace(/^www\./, '');
                    }
                }

                // Remove query unwanted parameters
                if (Array.isArray(opts.removeQueryParameters)) {
                    for (var key in urlObj.searchParams.keys()) {
                        if (testParameter(key, opts.removeQueryParameters)) {
                            urlObj.searchParams.delete(key);
                        }
                    }
                }

                // Sort query parameters
                if (opts.sortQueryParameters) {
                    urlObj.searchParams.sort();
                }
                // Take advantage of many of the Node `url` normalizations
                urlString = urlObj.toString();
            }
            else {
                urlString = '';
            }

            // Remove ending `/`
            if (opts.removeTrailingSlash || urlObj.pathname === '/') {
                urlString = urlString.replace(/\/$/, '');
            }

            // Restore relative protocol, if applicable
            if (hasRelativeProtocol && !opts.normalizeProtocol) {
                urlString = urlString.replace(/^http:\/\//, '//');
            }

            function testParameter(name, filters) {
                return filters.some(function (filter) { return filter instanceof (RegExp) ? filter.test(name) : filter === name; });
            }

            return urlString;
        }
    }
}
