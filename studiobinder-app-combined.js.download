addMoSePa('TodoCards', 'todoCards', TempTodoCardsService, {
    modelMethod: TodoCardsFactory,
    serviceInjectList: ['TodoColumns', 'TodoPages', 'TaskBoards', 'SBFieldMethods'],
    serviceInjectMod: [
        'resources.TodoColumns',
        'resources.TaskBoards',
        'resources.TodoPages',
        'sb.fields.methods.service'
    ]
});
function TodoCardsFactory(ApiResource) {
    var model = ApiResource(SBApiCollections.TodoCards);

    model.prototype.rangeToDays = function (type) {
        var val = null;
        if (this.startDate && this.startDate.value && this.dueDate && this.dueDate.value) {
            val = Math.abs(this.dueDate.value.diff(this.startDate.value, 'days')) + 1;
            if (type === 'D') {
                val += ' Day' + (val !== 1 ? 's' : '');
            }
            else if (type === 'd') {
                val = ' (' + val + 'd)';
            }
        }
        return val;
    };
    return model;
}

function TempTodoCardsService(ApiService, model, TodoColumns, TodoPages, TaskBoards, SBFieldMethods) {

    var service = ApiService(model, {
        listType: 'isGroup',
        fieldsUpdatedOnOrderChanged: ['todoColumnId'],
       // listField: 'todoColumnId'  -> set it dynamically in get group prams
        convertOtherResources: convertOtherResources
    });

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.duplicate = duplicate;
    service.notifyTeamMember = notifyTeamMember;
    service.complete = complete;
    service.getIcons = getIcons;
   // service.update = update;

    return service;

    function update(data, successcb, errorcb) {
        //for dates set in date picker
        if(data && data.dates){
            data = _.extend({}, data, data.dates);
            delete data.dates;
        }
        return service.$update(data, successcb, errorcb);
    }

    function getIcons() {
        return SBFieldMethods.ScriptOutlineIcons;
    }

    function convertOtherResources(item) {
        if (item.completedById && typeof(item.completedById) === 'object') {
            item.completedBy = new service.Users(item.completedById);
            item.completedById = item.completedById._id;
        }

        if (item.todoColumnId && typeof(item.todoColumnId) === 'object') {
            item.todoColumn = new TodoColumns(item.todoColumnId);
            item.todoColumnId = item.todoColumnId._id;
        }

        if (item.todoPageId && typeof(item.todoPageId) === 'object') {
            item.todoPage = new TodoPages(item.todoPageId);
            item.todoPageId = item.todoPageId._id;
        }
        if (item.taskBoardId && typeof(item.taskBoardId) === 'object') {
            item.taskBoard = new TaskBoards(item.taskBoardId);
            item.taskBoardId = item.taskBoardId._id;
        }
        if (!item.color) {
            item.color = SBFieldMethods.DefaultTodoCardColor;
        }
        return item;
    }

    function getChangedFieldForUpdateOther() {
        return ['name', 'order', 'active', 'description', 'todoColumnId', 'dueDate', 'startDate', 'color', 'stats', 'type', 'dependencies', 'icon', 'teamIds', 'taskBoardId',
            'completedById', 'completedAt', 'completed'];
    }

    function duplicate(params,successcb, errorcb) {
        return service.postUrl('/duplicate/'+params.todoCardId, params, successcb, errorcb);
    }

    function notifyTeamMember(params, successcb, errorcb){
        return service.postUrl('/notify-team-member/' + params.todoCardId, params, successcb, errorcb);
    }

    function complete(params, successcb, errorcb){
        return service.putUrl('/complete/' + params.id, params, successcb, errorcb);
    }
}

