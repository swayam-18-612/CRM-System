}

angular.module('user.products.group.service.component',[
    'group.controller.service',
    'apiPagination.Products',
    'services.blocksSetup',
    'list.base.component.service',
    'apiPagination.Products'
])
.service('ProductGroupCtrlService',ProductGroupCtrlService);
ProductGroupCtrlService.$inject = ['BlocksSetupService', 'ProductsPagination'];
function ProductGroupCtrlService(BlocksSetupService, ProductsPagination) {
    return function ($ctrl) {
        //todo remove name underlined on archived
        //figure out the contact lists  setup
        //update contact list name on update project name
        //ensurte contact list for project is removed when project is removed or archived
        $ctrl.BlocksSetupService = BlocksSetupService;
        $ctrl.Pagination = ProductsPagination;

        $ctrl.additionalMessageRemove = 'You will lose this project’s contacts, call sheets, and files.';

        //item methods
        if(!$ctrl.hasClick) {
            $ctrl.hasClick = hasClick;
        }
        $ctrl.view = view;

        $ctrl.getNewParams = getNewParams;
        $ctrl.getNewPopupParamsOther = getNewPopupParamsOther;
        $ctrl.getItemImageSize = getItemImageSize;


        $ctrl.preloadSettings = preloadSettings;
        $ctrl.showColumnOther = showColumnOther;

        $ctrl.getGridViewItemContent = getGridViewItemContent;
        $ctrl.processListItemColumn = processListItemColumn;

        $ctrl.canEditImage = canEditImage;
        $ctrl.getImageClsOther = getEvent;
        $ctrl.withSelectAll = withSelectAll;
        $ctrl.canMove = canMove;

        return $ctrl;

        function canMove(){
            return $ctrl.canMoveInit() && $ctrl.CPS.isOwnerOrAdmin;

        }
        function withSelectAll(){
            return $ctrl.CPS.isOwnerOrAdmin;
        }

        function preloadSettings() {
            $ctrl.team = $ctrl.SessionService.getSetting('team');//used to assign team members for project
            $ctrl.Settings = _.extend({}, $ctrl.Settings, {team: $ctrl.team});
        }

        function showColumnOther(item, c, isHeader, isMobile, notTextOnly) {
            if (c && c.prop === "teamIds") {
                return (!$ctrl.team || $ctrl.team.length < 2) ? false : true;
            }
            return true;
        }

        function getNewParams(after, type) {
            var company = $ctrl.security.getCurrentCompany();
            if (company) {
                var params = {};
                if (company.address) {
                    params.address = company.address;
                }

                if (company.name) {
                    params.production = company.name;
                }
            }
            return null;
        }

        function getNewPopupParamsOther() {
            return {
                overviewBlocks: BlocksSetupService.overviewBlocks,
                customOverviewBlocks: BlocksSetupService.customOverviewBlocks
            };
        }

        function view(item) {
            console.log('view project');
            if ($ctrl.filtersService.selectedFilter) {
                $ctrl.CPS.transitionTo('user.product.overview', currentPathParams(item));
            }
        }

        function currentPathParams(item) {
            var params = $ctrl.CPS.currentPathParams();
            if (item) {
                params.productId = item._id;
            }
            return params;
        }

        function getGridViewItemContent(listCols, item) {
            var teamIds = getTeamIds(),
                canEdit = $ctrl.canEdit && $ctrl.canEditItem(item);

            return '<div class="table-div full-width fixed-layout height10P ' + getEvent(item) + '">' +
                '<div>' + getName(item, $ctrl.getColumnByProp('name', true), 'title1 wrap productitem1', false) + '</div>' +
                '</div>' +
                (teamIds ? ('<div class="table-div bottom-table">' +
                    '<div class="sec-col centered grow-column">' +
                    $ctrl.getDisplayItemCol(item, teamIds, null, teamIds.canEdit && canEdit, false, false, false) +
                    '</div>' +
                    '</div>') : '');
        }

        function getEvent(item) {
            return $ctrl.hasClick(item) ? ('with-cursor ' + $ctrl.getClickEventName('goToProduct')) : '';
        }

        function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
            var clsOther = $ctrl.getClsCol(c, isLast);
            switch (c.prop) {
                case 'name':
                    return '<div class="' + clsOther + '">' +
                        '<div class="full-width margin-bottom-8">' + getName(item, $ctrl.getColumnByProp('name', true), 'full-width name', canEdit) + '</div>' +
                        ($ctrl.withTeamUnder ? getTeamDisplay('margin-left-minus-4 min-height-30') : '') +
                        ($ctrl.isMyProjects && !item.active ? '<div class="label-col table-div margin-top-8"><div>Archived</div></div>' : '') +
                        '</div>';

                case 'production':
                    break;

                case 'teamIds':
                    return $ctrl.withTeamUnder ? '' : getTeamDisplay(clsOther);

                default:
                    return get(c, false, clsOther);
            }

            function get(c, canEdit1, clsOther) {
                return $ctrl.getDisplayItemCol(item, c, clsOther, canEdit1 ? canEdit1 : canEdit, textOnly, isMobile, isMobileRowDetails);
            }

            function getTeamDisplay(clsOther) {
                var teamIds = getTeamIds();
                c.currentId = $ctrl.CPS.teamId;
                return teamIds ? get(teamIds, $ctrl.canEdit && c.canEdit, clsOther) : '';
            }
        }

        function hasClick(item){
            return $ctrl.isActiveFilter() && $ctrl.isActiveItem(item);
        }

        function getName(item, c, cls, canEdit) {
            var prop = c.prop,
                canUpdate = $ctrl.canEdit && $ctrl.SBFieldTypesService.canUpdateFieldContent(c),
                hasclick = $ctrl.hasClick(item),
                tag = (hasclick ? 'a' : 'div'),
                withclick = hasclick ? (' no-drag with_underline" ' +
                    'href="' + $ctrl.CPS.getStateHref('user.product.overview', currentPathParams(item))) : '';

            return '<' + tag + ' class="' + cls + ' display-block ' + ($ctrl.teamAvatarCls || '') +
                $ctrl.getViewEditElemSelector(prop, true, canUpdate) + ' ' +
                (hasclick ? withclick : '') + '"' +
                (hasclick ? $ctrl.getAnalytics('goToProject', item._id) : '') +
                '>' + $ctrl.LCS.encodeHTML(item[prop]) +
                '</' + tag + '>' +
                getProduction('production');

            function getProduction(prop) {
                var c = $ctrl.getColumnByProp(prop, true),
                    canUpdate = $ctrl.canEdit && $ctrl.SBFieldTypesService.canUpdateFieldContent(c);                      //for setups like on tasks
                if (c.hide) {
                    return '';
                }
                return (canUpdate ||
                    !canEdit && item[prop]) ? ('<div class="subname ' +
                    '' + //($ctrl.isPrintLayout ? '' : 'with-ellipsis ') +
                    $ctrl.getViewEditElemSelector(prop, true, canUpdate) + '">' + (item[prop] || '') + '</div>') : '';
            }
        }

        function getTeamIds() {
            var teamIds = $ctrl.getColumnByProp('teamIds', true);
            return teamIds && $ctrl.showColumnOther(teamIds) ? teamIds : null;
        }

        function getUserAvatar() {
            return $ctrl.security.getUserImageComponent('$ctrl.item.createdBy', 'smaller');
        }

        function getItemImageSize(isMobile) {
            return isMobile ? 'mediumsmall' : ($ctrl.isGridView ? 'storyboard1 no-item-radius' : 'intermedium');
        }

        function canEditImage(item, isGridView) {
            return !isGridView;
        }
    }
}

