                '</div>' +
            '</div>' +
        '</div>',
    controller: 'DocumentVersionsSidebarCtrl'
})
.controller('DocumentVersionsSidebarCtrl', DocumentVersionsSidebarCtrl);
DocumentVersionsSidebarCtrl.$inject = ['DocumentVersionsCtrlService', '$element'];
function DocumentVersionsSidebarCtrl(DocumentVersionsCtrlService, $element) {
    console.log('DocumentVersionsSidebarCtrl');

    var $ctrl = this;
