angular.module('components.sb-editor.service', [
    'product.scheduling.scriptProcessing.service',
    'services.soundEffects',
    'services.rootEvents',
    'sceneNumber.service',
    'service.scriptConvert'
])
.service('SBEditorService', SBEditorService);
SBEditorService.$inject = ['ScriptProcessingService','soundEffectService', 'CPS', 'RootEventsService', 'SceneNumberService', 'ScriptConvertService'];

function SBEditorService(scriptService, soundEffectService, CPS, RootEventsService, SceneNumberService, ScriptConvertService) {  var _slicedToArray = function () { function sliceIterator(arr, i) { var _arr = []; var _n = true; var _d = false; var _e = undefined; try { for (var _i = arr[Symbol.iterator](), _s; !(_n = (_s = _i.next()).done); _n = true) { _arr.push(_s.value); if (i && _arr.length === i) break; } } catch (err) { _d = true; _e = err; } finally { try { if (!_n && _i["return"]) _i["return"](); } finally { if (_d) throw _e; } } return _arr; } return function (arr, i) { if (Array.isArray(arr)) { return arr; } else if (Symbol.iterator in Object(arr)) { return sliceIterator(arr, i); } else { throw new TypeError("Invalid attempt to destructure non-iterable instance"); } }; }();
    var SBScriptEditorClass = ScriptConvertService.SBScriptEditorClass,
        SBScriptEditorBlockType = ScriptConvertService.SBScriptEditorBlockType;

    var REGEXP_GLOBAL = /(https?:\/\/|www\.|mailto:|tel:)[\S]+/gi;
    var REGEXP_WITH_PRECEDING_WS = /(https?:\/\/[\S]+)|(www.[\S]+)|(mailto:[\S]+)|(tel:[\S]+)/;

    var LCS = CPS.LCS,
        Keys = {
            TAB: 9,
            ENTER: 13,
            ESCAPE: 27,
            UP: 38,
            DOWN: 40,
            LEFT: 37,
            RIGHT: 39,
            SPACE: 32,
            BACKSPACE: 8
        };

    var __extends = (function () {
        var extendStatics = Object.setPrototypeOf ||
            ({__proto__: []}
                instanceof Array && function (d, b) {
                    d.__proto__ = b;
                }) || function (d, b) {
                for (var p in b) {
                    if (window.CP.shouldStopExecution(1)) {
                        break;
                    }
                    if (b.hasOwnProperty(p)) {
                        d[p] = b[p];
                    }
                    window.CP.exitedLoop(1);
                }
            };
        return function (d, b) {
            extendStatics(d, b);

            function __() {
                this.constructor = d;
            }

            d.prototype = b === null ? Object.create(b) : (__.prototype = b.prototype, new __());
        };
    })();

    var mediasb = {'mediasb': ['link', 'image', 'video']}
    var listsb = {'list': ['ordered', 'bullet', 'check']};
    var formatsb = {'formatsb': ['bold', 'italic', 'underline', 'strike']};
    var elssb = {'elssb': [ 'code-block', 'blockquote'
           // , 'divider', 'emoji'
        ]};
    var propArray = ['scene', 'strip', 'omitted'];
    var Sources = Quill.sources;
    var Delta = Quill.import('delta');
    var Block = Quill.import('blots/block');
    var Inline = Quill.import('blots/inline');
    var BlockEmbed = Quill.import('blots/block/embed');
    var Parchment = Quill.import('parchment');
    var ParchmentAttributorClass, StyleAttributor, ParchmentAttribute;

    //in v2
    if(isQuillV2){
        ParchmentAttributorClass = Parchment.ClassAttributor;
        StyleAttributor = Parchment.StyleAttributor;
        ParchmentAttribute = Parchment.Attributor;
    }  else {
        var ParchmentAttributor = Parchment.Attributor;
        ParchmentAttributorClass =  ParchmentAttributor.Class;
        StyleAttributor = ParchmentAttributor.Style;
        ParchmentAttribute = ParchmentAttributor.Attribute;
    }

                //      8px                                             16px                                          //28px
    var sizeWhitelist=['small', '9px', '10px', '11px', '12px', '14px', false, '18px', '20px', '24px', 'large', '30px',  'large', '40px', '48px', '60px', '72px', '96px', 'huge'];

    var loadedModules = {};

    var service = {
        Keys: Keys,
        loadEditorConfigs: loadEditorConfigs,
        getToolbar: getToolbar
    };

    return service;


    function getParchmentAttribute(name, cls, isInline){
        return getParchmentObj(ParchmentAttribute, name, cls, isInline);
    }

    function getParchmentAttributorClass(name, cls, isInline){
        return getParchmentObj(ParchmentAttributorClass, name, cls, isInline);
    }

    function getParchmentObj(type, name, cls, isInline){
        return new type(name, cls, {
            scope: Parchment.Scope[isInline ? 'INLINE' : 'BLOCK']
        });
    }

    function registerBtn(btn) {
        if (!service['btn' + btn]) {
            Quill.register(getParchmentAttributorClass(btn, 'ql-' + btn, true), true);
        }
    }

    function loadEditorConfigs(config, type, withSaveBtn, withCancelBtn) {
        switch (type) {
            case 'doc':
                registerDocEditor(config);
                break;

            case 'screenplay':
                registerScriptBlocks(config);
                break;

            case 'contactmessage':
                registerContactsMessageEditor(config, withSaveBtn, withCancelBtn);
                break;

            case 'bubble':
                registerBubbleEditor(config, withSaveBtn, withCancelBtn);
                break;

            case 'bubblesimple':
                registerBubbleSimpleEditor(config, withSaveBtn, withCancelBtn, false);
                break;

            case 'bubblesimplevideo':
                registerBubbleSimpleEditor(config, withSaveBtn, withCancelBtn, false, true);
                break;

            case 'bubblesimplenolink':
                registerBubbleSimpleEditor(config, withSaveBtn, withCancelBtn, true);
                break;

            case 'editorsimple':
            case 'titlepage':
            case 'pagecover':
            case 'customnote':
            case 'scratchpad':
            case 'scratchpadshort':
            case 'notes':
            case 'pdftitle':
            case 'breakdownscene':
            case 'taskcard':
                registerFullEditor(config, type, withSaveBtn, withCancelBtn);
                break;

            default:
                registerFullEditor(config, null);
                break;
        }

        if (!config.modules.history) {
            config.modules.history = {
                delay: 2000,
                maxStack: 500,
                userOnly: true
            };
        }

        config.modules.clipboard = {
            // toggle to add extra line breaks when pasting HTML:
            matchVisual: false
        };

        return config;

        function keyboardBinding(){
            config.modules.keyboard = {
                bindings: {
                    shift_enter: {
                        key: 13,
                        shiftKey: true,
                        handler: (range, ctx) => {
                            console.log(range, ctx); // if you want to see the output of the binding
                            this.editor.insertText(range.index, '\n');
                        }
                    },
                    enter: {
                        key: 13,
                        handler: () => {
                            // submit form }
                        }
                    }
                }
            };
        }
    }

    function getToolbar(editorType, showSecondaryButtons) {
        //console.log('SBEditorService.getToolbar');
        var showPageBtn = false,
            buttons = getButtons(showPageBtn);
        if(!buttons){return null;}
        var toolbar = '', m = buttons && buttons.length > 0 ? buttons.length : 0;
        if (m) {
            toolbar += '<div class="' + (editorType === 'doc' ? ' ' : 'swWysiwyg-menu') + '  one-line-tooltip">';
            for (var j = 0; j < m; j++) {
                var gr = buttons[j], n = gr.length;
                toolbar += '<span class="btn-group">';
                for (var i = 0; i < n; i++) {
                    var btn = gr[i], drp = btn.drp;
                    if (drp) {
                        toolbar +=
                            "<div class='actions display-inline' dropdown style='float:left'>" +
                            "<button type='button' class='" + btn.name + " btn dropdown-toggle dots' dropdown-toggle aria-haspopup='true' aria-expanded='true'>" +
                            "<div tooltip-placement='bottom' tooltip-html=\"'" + btn.title + "'\">"+getI(btn.icon, btn.iconLevel)+"</div>" +
                            "</button>" +
                            "<ul class='dropdown-menu-right side-menu fadeInDownLeft' role='menu' style='width: 230px;padding: 10px' dropdown-menu>" +
                            "<li><a class='btnLock'>"+  getI('lock', 2, 'pull-left') +" <span id='btnLockLabel'>Lock Screenplay</span></a></li>" +
                            "<li><a class='btnRenumber'>"+getI('renumber', 2, 'pull-left') +"</span> Renumber Scenes</a></li>" +
                            //"<li><a id='btnEditSceneNumber'>"+getI('pencil') +" Edit Scene Number (⌥ + E)</a></li>" +
                            //"<li class='with-top-border'><a id='' class='accent'><span class='sbf'></span> Remove Version</a></li>" +
                            "</ul>" +
                            "</div>";
                    } else {
                        toolbar += "<button class='" + (!btn.notQl ? 'ql-' : '') + btn.name + " btn'>" +
                            //"<span class='sbf " + btn.icon + "' tooltip-placement='bottom' tooltip-html=\"'" + btn.title + (btn.key ? ("<br>⌥ + " + (btn.key === 'A' ? "Shift + " : "") + btn.key) : '') + "'\"></span>" +

                            "<div class='table-div full-width' style='height:100%' tooltip-placement='bottom' tooltip-html=\"'" + btn.title + (btn.key ? ("<br>⌥ + " + btn.key) : '') + "'\">" +
                            "<div class='text-center centered'>" + (btn.icon ? getI(btn.icon, btn.iconLevel) : '') + "</div>"+
                            "</div>" +
                            "</button>";
                    }
                }
                toolbar += '</span>';
            }
            toolbar += '</div>';
        }

        return toolbar;

        function getI(i, l, o){return LCS.getISBDiv(i, l ? l : 2, o);}

        function getButtons(showPageBtn) {
            switch (editorType) {
                case 'screenplay': //editor-type:2
                    var buttons =
                        [[
                            {name: 'scene', title: 'Scene Setting', value: 0, icon: 'scene', key: 'S'},
                            {name: 'action', title: 'Action', value: 2, icon: 'megaphone', key: 'A'},
                            {name: 'character', title: 'Character', value: 3, icon: 'character', key: 'C'},
                            {name: 'parenthetical', title: 'Parenthetical', value: 4, icon: 'parenthetical', key: 'P'},
                            {name: 'dialogue', title: 'Dialogue', value: 5, icon: 'speech-bubble', key: 'D'},
                            //todo bring back dualDialogue
                            //{name: 'dualDialogue', title: 'Dual Dialogue', value: 10, icon: 'conversations'},
                            {name: 'transition', title: 'Transition', value: 6, icon: 'transition', iconLevel: 4, key: 'T'},
                            {name: 'general', title: 'General', value: 1, icon: 'align-justify', key: 'G'},
                          //show page bttun
                            //  {name: 'page', title: 'Page', value: 11, icon: 'align-justify', key: 'P'}
                        ]];
                    if(showPageBtn){
                        buttons.push({name: 'page', title: 'Page', value: 11, icon: 'align-justify', key: 'P'})
                    }
                  //  if(showSecondaryButtons) {
                        buttons = buttons.concat([[
                           // {name: 'script-notes', title: 'Scratch Pad', value: '1', icon: 'postit', notQl: true},
                          //  {name: 'renumber', title: 'Renumber', value: '1', icon: 'renumber', notQl: true},
                        ]]);
                    //}
                    return buttons;

                case 'avscript': //editor-type = 3
                    return [[
                        {name: 'scene', title: 'Scene Setting', value: 0, icon: 'stripboard', iconLevel: 5},
                        {name: 'action', title: 'Action', value: 2, icon: 'megaphone', iconLevel: 2},
                        {name: 'character', title: 'Character', value: 3, icon: 'character', iconLevel: 2},
                        {name: 'parenthetical', title: 'Parenthetical', value: 4, icon: 'parenthetical', iconLevel: 2},
                        {name: 'dialogue', title: 'Dialogue', value: 5, icon: 'speech-bubble', iconLevel: 2},
                        //todo bring back dualDialogue
                        //{name: 'dualDialogue', title: 'Dual Dialogue', value: 10, icon: 'conversations'},
                        {name: 'transition', title: 'Transition', value: 6, icon: 'transition', iconLevel: 4},
                        {name: 'general', title: 'General', value: 1, icon: 'align-justify', iconLevel: 2},
                        //   {name:'fullscreen', title:'Fullscreen', value:20, icon:'resize-expand'},

                    ]];
            }
            return null;
        }
    }

    function addSaveBtns(config, toolbar, withSaveBtn, withCancelBtn, withCommentBtn) {
        if (withSaveBtn || withCancelBtn || withCommentBtn) {
            var save = [];
            if (withSaveBtn) {
                addBtn('save');
            }
            if (withCancelBtn) {
                addBtn('cancel');
            }
            if (withCommentBtn) {
                addBtn('comment');
            }
            toolbar.push(save);
        }
        return toolbar;

        function addBtn(btn) {
            registerBtn(btn);
            save.push(btn);
        }
    }

    function registerBubbleSimpleEditor(config, withSaveBtn, withCancelBtn, noLink, withVideo) {
        registerFullInfo(config);

        //config.theme = 'bubble';
        var toolbar =  [
            [ formatsb,
                {'color': []}
                //, {'background': []}
            ],
            [listsb],
        ];

        var l = [];
        if(!noLink){
            l.push('link');
        }
        if(withVideo){
            l.push('image');
            l.push('video');
        }
        var le = l.length;
        if(le > 0) {
             toolbar.push(le > 1 ? [{mediasb: l}] : l );
            //toolbar.push( l );
        }
        toolbar.push(['clean']); // remove formatting - button

        addSaveBtns(config, toolbar, withSaveBtn, withCancelBtn);

        config.modules.toolbar = toolbar;

    }

    function registerContactsMessageEditor(config, withSaveBtn, withCancelBtn) {
        registerFullInfo(config);
        //config.theme = 'bubble';
        var toolbar = [
            [formatsb],
            [listsb],           // dropdown with defaults from theme
            [mediasb],
            [{'align': []}],
            ['clean']
        ];

        addSaveBtns(config, toolbar, withSaveBtn, withCancelBtn);

        config.modules.toolbar = toolbar;

    }

