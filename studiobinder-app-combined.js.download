        $ctrl.withoutClose = true;
    }
}

angular.module('components.sb-editor.bubble.component', [
])
.component('contentEditorBubble', {
    bindings: {
        isPopup: '@',
        withScrollbar: '@',
        editorType: '@',
        placeholder: '@',
        withNoToolbar:'@',
        withFullHeight: '@',
        withVideo: '@',
        wordCountProp: '@',
        toolbarParentEl:'@',
        withoutRecurringSave: '@',

        savingAt: '@',
        saveOnKeydown:'@',
        saveOnEnter:'@',
        withoutCustomOnSave: '@',

        withScriptFormat: '@',

        field: '@',
        elemType: '@',

        canEdit:'<',
        item: '<',
        service: '<',

        onItemUpdate: '&',

    },
    controller: 'ContentEditorBubbleCtrl',
})  
.controller('ContentEditorBubbleCtrl', ContentEditorBubbleCtrl);

ContentEditorBubbleCtrl.$inject = ['ListItemTemplateFormCtrlService', '$element'];
function ContentEditorBubbleCtrl(ListItemTemplateFormCtrlService, $element) {
    //console.log('ContentEditorBubbleCtrl') ;
    var $ctrl = this;

    var Delta = Quill.import('delta'),
        deltaChanges = new Delta(),
        tempHtml,
        interval;

    $ctrl.dontDebounceUpdates = true;
    $ctrl.dontNotify = true;
    $ctrl.forceSave = true;
    $ctrl.dontAutoloadTemplate = false;

    $ctrl.saveDocChanges = saveDocChanges;
    $ctrl.onContentChanged = onContentChanged;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitOther = preInitOther;
    $ctrl.postInitOther = postInitOther;

    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;

    if (!$ctrl.onSaveDocChanges) {
        $ctrl.onSaveDocChanges = onSaveDocChanges;
    }

    $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

    function preInitOther() {
        //ensure that the item doesnt get updaed
        if (!$ctrl.field) {
            $ctrl.field = 'notes';
        }
        $ctrl.changedFields = [$ctrl.field, 'id'];
        $ctrl.previousItem = _.clone($ctrl.item);

        $ctrl.type = 'Edit';
        if (!$ctrl.extraParam) {
            $ctrl.extraParam = {};
        }
        $ctrl.extraParam.service = $ctrl.service;

        $ctrl.name = 'quillEditor' + ($ctrl.item ? $ctrl.item._id : 'null');
    }

    function postInitOther() {
        $ctrl.onSave = onSave;
    }

    function getItemTemplate() {
        //console.log('ContentEditorBubbleCtrl.getItemTemplate');
        return $ctrl.LCS.getErrorBlock() +
            '<sb-editor ' +
            ($ctrl.withScrollbar ? 'class="with-fancy-scrollbar show-scrollbar-on-hover"' : '') +
            'id="' + $ctrl.name + '" ' +
            'editor-type="' + $ctrl.editorType + '" ' +
            'placeholder="' + $ctrl.placeholder + '" ' +

            ($ctrl.withScrollbar ? ('with-scrollbar="true"') : '') +
            ($ctrl.withFullHeight ? 'with-full-height="true" ' : '') +
            ($ctrl.withNoToolbar ? 'with-no-toolbar="true" ' : '') +
            ($ctrl.saveOnEnter ? 'save-on-enter="true" ' : '') +
            ($ctrl.canEdit ? (($ctrl.autofocus === 'true' || $ctrl.autofocus === true) ? 'autofocus="true" ' : '') : 'read-only="true" ') +
            ($ctrl.toolbarParentEl ? ('toolbar-parent-el="' + $ctrl.toolbarParentEl + '" ') : '') +
            (($ctrl.withScriptFormat === true || $ctrl.withScriptFormat === 'true') ? 'with-script-format="true" ' : '') +

            'content="$ctrl.item[$ctrl.field]" ' +
            'on-content-changed="$ctrl.onContentChanged(editor, html, text, content, delta, oldDelta, source)" ' +
            '></sb-editor>' +

            (!$ctrl.withoutRecurringSave && $ctrl.canEdit && $ctrl.item ? ('<a class="' + $ctrl.getBtnActionCls() +'  onbreakdowns btnsaving btnq btn btn-small with-margin-left" data-type="saveDocChanges" ng-class="$ctrl.SessionService.savingDocChanges?\'floppySaving\':($ctrl.SessionService.hasDocChanges?\'floppyUnsaved\':\'floppySaved\')" analytics-on analytics-action="Save Doc Changes" tooltip-placement="bottom" tooltip="{{$ctrl.SessionService.lastDocChanges ? (\'Saved @ \' + $ctrl.SessionService.lastDocChanges) : null}}">' + $ctrl.LCS.getISBDiv('save') + '</a>') : '');
    }

    function onLoaded() {
        //console.log('ContentEditorBubbleCtrl.onLoaded');
        $ctrl.setFocus($ctrl.name);
        bind(true);
        addIntervals();
    }

    function bind(isBind) {
       // $ctrl.bindElementsClickBySelector(isBind, '.btnsaving', $ctrl.saveDocChanges);

        var popup = $ctrl.LCS.findClosestParent($ctrl.element, '.modal-dialog');
        $ctrl.LCS.bindElementsClick(isBind, popup ? popup : $ctrl.LCS.bodyElement, onClick, 'lastClicked_' + $ctrl.elementId);
    }

    function onClick(e) {
        //console.log('ContentEditorBubbleCtrl.lastClicked');
        $ctrl.LCS.lastElementClicked = e.target;
        if ($ctrl.onBodyClickOther) {
            $ctrl.onBodyClickOther();
        }
    }

    function addIntervals() {
        if (!$ctrl.notFirstTime) {
            var id = getName();
            if (id) {
                //add popop
                //SAVE_DOC_CHANGES_

                console.log('addRootWatcher ' + id);
                if($ctrl.docWatcher){
                    $ctrl.removeWatcher($ctrl.docWatcher);
                }
                $ctrl.docWatcher = $ctrl.addRootWatcher(id, $ctrl.onSaveDocChanges);
            }

            // Save periodically
            if (!$ctrl.withoutRecurringSave) {
                interval = setInterval(processSaving, parseInt($ctrl.savingAt ? $ctrl.savingAt : 20, 10) * 1000);
            }
            $ctrl.notFirstTime = true;
        }
    }

    function processSaving() {
        // //console.log('entering interval');
        if (deltaChanges.length() > 0) {
            saveDocContent();
        }
    }

    function onSaveDocChanges(item) {
        console.log('onSaveDocChanges');
        if (item._id === $ctrl.item._id || item.id === $ctrl.item._id) {
            saveDocContent(item && item.dontSave);
        }
    }

    function saveDocContent(dontSave) {
        //console.log('ContentEditorBubbleCtrl.saveDocContent');
        deltaChanges = new Delta();
        if(tempHtml===undefined){
            return;
        }
        setProp('savingDocChanges', true);
        updateBtnProps();
        saveDoc($ctrl.field, tempHtml, $ctrl.forceSave, dontSave);
    }

    function onSave(result) {
        var noUpdates = result && result.noUpdates;
        if(noUpdates) {
            setProp('savingDocChanges', false);
            setProp('hasDocChanges', false);
        }
        if(!noUpdates && !$ctrl.withoutCustomOnSave){
            return;
        }

        var updatedAt = result && result.item ? result.item.updatedAt : null;
        onDocUpdate(updatedAt);

        console.log('onSave: onItemUpdate');
        onItemUpdate($ctrl.item ? $ctrl.item[$ctrl.field] : undefined, result.updatesG);

        if($ctrl.onSaveOther){
            $ctrl.onSaveOther();
        }
    }

    function onContentChanged(editor, html, text, content, delta, oldDelta, source) {
        //console.log('ContentEditorBubbleCtrl.onContentChanged');
        if (editor.isPopupOpen) {
            return;
        }
        deltaChanges = deltaChanges.compose(delta);
        setProp('hasDocChanges', true);
        updateBtnProps();
        tempHtml = html;//.replace(/ /g, '&nbsp;');

        if ($ctrl.saveOnKeydown === true || $ctrl.saveOnKeydown === 'true'){
            console.log('onSave: onItemUpdate');
            onItemUpdate(tempHtml);
        }
    }

    function onItemUpdate(val, updatesG) {
        if (val === undefined) {
            return;
        }
        if (typeof ($ctrl.onItemUpdate) === 'function') {
            var editchanges = {_id: $ctrl.item._id};
            editchanges[$ctrl.field] = val;
            $ctrl.onItemUpdate({result: {item: $ctrl.item, editchanges: editchanges, updatesG: updatesG}});
        }
    }

    function saveDoc(field, value, forceSave, dontSave) {
        //console.log('ContentEditorBubbleCtrl.saveDoc');
        $ctrl.item[field] = value;
        //console.log('ContentEditorBubbleCtrl.saveDoc - field '+field+' changed');
        if(!dontSave) {
            $ctrl.save(forceSave);
        }
    }

    function onDocUpdate(updatedAt) {
        setProp('savingDocChanges', false);
        setProp('hasDocChanges', false);
        setProp('lastDocChanges',
            updatedAt ? moment(updatedAt).format($ctrl.CPS.timeFormat) : null);
        updateBtnProps();
    }

    function saveDocChanges() {
        //console.log('saveDocChanges');
        var id = getName();
        if (id) {
            //SAVE_DOC_CHANGES_
            console.log('broadcastRoot ' + id);
            $ctrl.broadcastRoot(id, $ctrl.item ? _.extend({}, $ctrl.item) : $ctrl.item);
        }
    }

    function getName() {
        var id = $ctrl.item ? $ctrl.item._id : null;
        if (id) {
            return 'SAVE_DOC_CHANGES_' + id + ($ctrl.isPopup ? '_POPUP' : '');
        }
    }

    function onDestroy() {
        if (interval) {
            clearInterval(interval);
        }

        //save one last time before destroying
        processSaving();
        clearSaving();
        bind(false);
    }

    function clearSaving() {
        onDocUpdate(null);
    }

    function setProp(prop, v) {
        $ctrl.SessionService.setDocChangedProp(prop, v);

    }

    function updateBtnProps() {
        if (!$ctrl.btnSave) {
            $ctrl.btnSave = $ctrl.element.querySelector('.onbreakdowns');
        }
        if ($ctrl.btnSave) {
            $ctrl.LCS.replaceClass('floppySaving floppyUnsaved floppySaved', $ctrl.SessionService.savingDocChanges ? 'floppySaving' : ($ctrl.SessionService.hasDocChanges ? 'floppyUnsaved' : 'floppySaved'));
        }
    }
}

angular.module('product.contentEditorBubblePopup.controller.service', [
])
.service('ContentEditorBubbleCtrlService', ContentEditorBubbleCtrlService);
ContentEditorBubbleCtrlService.$inject = ['ItemTemplateCompileCtrlService'];
function ContentEditorBubbleCtrlService(ItemTemplateCompileCtrlService) {
    return function ($ctrl, $element, isPopup) {

        $ctrl.preInit = preInit;
        $ctrl.onLoaded = onLoaded;
        $ctrl.setTemplateData = setTemplateData;

        if(!$ctrl.getPopupBodyContent) {
            $ctrl.getPopupBodyContent = getPopupBodyContent;
        }

        $ctrl.close = close;
        $ctrl.getContentEditor = getContentEditor;

        if(!$ctrl.processSaving) {
            $ctrl.processSaving = processSaving;
        }

        $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function preInit() {
            $ctrl.withCloseBtn = true;
            if (!$ctrl.editorType) {
                $ctrl.editorType = 'editorsimple';
            }

            if (!$ctrl.extraParam) {
                console.warn('Parent for ContentEditorBubbleCtrlService must define $ctrl.extraParam');
            } else {
                $ctrl = _.extend($ctrl, $ctrl.extraParam);
            }

            if ($ctrl.onAdditionalInit) {
                $ctrl.onAdditionalInit();
            }

            if (!$ctrl.field) {
                console.warn('$ctrl.field = ' + $ctrl.field + '; Parent for ContentEditorBubbleCtrlService must define $ctrl.field');
            } else {
                console.log('ContentEditorBubbleCtrlService $ctrl.field = ' + $ctrl.field);
            }

            if (!$ctrl.service) {
                console.warn('Parent for ContentEditorBubbleCtrlService must define $ctrl.service');
            }

            if (!$ctrl.customTitle) {
                $ctrl.customTitle = 'Notes';
            }

            if (!$ctrl.placeholder) {
                $ctrl.placeholder = 'Enter ' + $ctrl.customTitle.toLowerCase() + '…';
            }

            if (!$ctrl.emptyField) {
                $ctrl.emptyField = 'There are no ' + $ctrl.customTitle.toLowerCase() + ' added';
            }

            if (!$ctrl.customIcon) {
                $ctrl.customIcon = 'bnote';
            }

            $ctrl.onItemUpdate = onItemUpdate;
        }

        function onLoaded() {
            $ctrl.LCS.addClass($ctrl.element, 'notes-popup' + ($ctrl.isFullPageSize ? ' notes-editor ' : '') + ($ctrl.isCustomNotes ? ' cover-page-popup' : ''));
            if(typeof($ctrl.onLoadedOther) === 'function'){
                $ctrl.onLoadedOther();
            }
        }

        function setTemplateData() {
            if($ctrl.isFullPageSize){
                $ctrl.modalBodyFormClass = 'max-width';
                $ctrl.hideHeader = true;
                $ctrl.withCloseBtn = true;
                $ctrl.withScriptFormat = $ctrl.extraParam && $ctrl.extraParam.withScriptFormat ? $ctrl.extraParam.withScriptFormat : false;
                $ctrl.editorCls = 'fixedtop';
            } else{
                $ctrl.icon = $ctrl.customIcon;
                $ctrl.popupTitle = $ctrl.customTitle;
            }
            if(typeof($ctrl.setTemplateDataOther) === 'function'){
                $ctrl.setTemplateDataOther();
            }
        }

        function getPageWidth() {
            return ($ctrl.editorType === 'pagecover' || $ctrl.editorType === 'scratchpad') ? '' : ('style="max-width:'+($ctrl.contentWidth ? $ctrl.contentWidth : 600)+'px!important" ');
        }

        function getContentEditor(){
            return ($ctrl.canEdit ? ('<content-editor-bubble class="content-editor-bubble full-width display-block centered clearfix sceneNotesBubble  ' +
                        ($ctrl.contentEditorCls ? ($ctrl.contentEditorCls + ' ') : '') +
                        ($ctrl.editorCls ? ($ctrl.editorCls + ' ') : '')  +
                        ($ctrl.editorClsOther ? ($ctrl.editorClsOther + ' ') : '') +
                        '" ' +
                        getPageWidth() +
                        (' save-on-keydown="' + ($ctrl.saveOnKeydown === true) + '" ') +
                        ($ctrl.isPopup ? 'is-popup="true" ' : '') +
                        ($ctrl.withScrollbar ? ('with-scrollbar="true"') : '') +
                        ($ctrl.editorType ? ('editor-type="'+$ctrl.editorType+'"') : '') +
                        ($ctrl.placeholder? ('placeholder="' + $ctrl.placeholder + '" ') : '') +
                        ($ctrl.savingAt? ('saving-at="' + $ctrl.savingAt + '" ') : '') +

                        ($ctrl.withNoToolbar ? 'with-no-toolbar="true" ' : '') +
                        ($ctrl.withFullHeight ? 'with-full-height="true" ' : '') +
                        ($ctrl.withVideo ? 'with-video="true" ' : '') +
                        ($ctrl.wordCountProp ? 'word-count-prop="true" ' : '') +

                        ($ctrl.withScriptFormat? 'with-script-format="true" ' : '') +
                        ($ctrl.saveOnEnter ? 'save-on-enter="true" ' : '') +
                        ($ctrl.withoutCustomOnSave ? 'without-custom-on-save="true" ' : '') +
                        ($ctrl.elemType ? ('elem-type="'+$ctrl.elemType+'" ') : '') +

                        ($ctrl.canEdit ? ('autofocus = "true" ') : '') +

                        'can-edit="::$ctrl.canEdit" ' +
                        'field="' + $ctrl.field + '" ' +
                        'item="::$ctrl.item" ' +
                        'service="::$ctrl.service" ' +

                        'on-item-update="$ctrl.onItemUpdate(result)" ' +
                        '></content-editor-bubble>') :

                    ('<div class="margin-half centering document-version-wrapper">' +
                        ($ctrl.popupTitle &&!$ctrl.hideTitle ? ('<div class="header-small clearfix spacing-half-bottom">' + $ctrl.popupTitle + '</div>') : '') +
                        '<div class="notes view-mode ql-editor bg-white">' +
                        ($ctrl.item[$ctrl.field] ? $ctrl.item[$ctrl.field] : $ctrl.emptyField) +
                        '</div>' +
                        '</div>')
            )
        }

        function getPopupBodyContent() {
            console.log('ContentEditorBubbleCtrlService.getPopupBodyContent');
            return $ctrl.getContentEditor()+
                    (typeof($ctrl.getPopupBodyContentOther) === 'function' ? $ctrl.getPopupBodyContentOther() : '');
        }

        function onItemUpdate(result) {
            console.log('ContentEditorBubbleCtrlService.onItemUpdate');
            if (result) {
                var item = result.item;
                if(item && $ctrl.item && $ctrl.item._id === item._id ){
                    var editchanges = {_id: item._id};
                    editchanges[$ctrl.field] = item[$ctrl.field];
                    result.editchanges = editchanges;
                }
                if(!$ctrl.dontTriggeUpdateItem) {
                    $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result);
                }
                if($ctrl.onItemUpdateOther) {
                    $ctrl.onItemUpdateOther(result);
                }
            }
        }

        function close(e) {
            $ctrl.preventDefault(e);
            console.log('ContentEditorBubbleCtrlService.onclose viewNotes');
            $ctrl.processSaving(true);
        }

        function processSaving(withClose) {
            var id = 'SAVE_DOC_CHANGES_' + $ctrl.item._id + ($ctrl.isPopup ? '_POPUP' : '');
            console.log('processSaving broadcastRoot ' + id);
            $ctrl.broadcastRoot(id, _.extend({}, $ctrl.item));
            if(withClose) {
                $ctrl.closePopup();
            }
        }
    }
}


