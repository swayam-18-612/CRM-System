ContactsGroupCtrl.$inject = ['ContactsGroupEnhancedCtrlService', 'ContactsGroupCtrlService', 'ContactsPagination', '$element'];
function ContactsGroupCtrl(ContactsGroupEnhancedCtrlService, ContactsGroupCtrlService, Pagination, $element) {
    var $ctrl = this;
    $ctrl.otherGroupInfo = otherGroupInfo;

    $ctrl = new ContactsGroupEnhancedCtrlService($ctrl, $element, Pagination, ContactsGroupCtrlService);

    function otherGroupInfo() {
        return $ctrl.CPS.productId ? ('<div ng-if="$ctrl.currentListId === \'All\' && $ctrl.list.items[0].contactLists[\'c_\' + $ctrl.product.contactListId].userId === $ctrl.CPS.userId" ng-show="$ctrl.list.items.length===1" class="one-contact centering spacing-half hide-print">' +
            $ctrl.LCS.getISBDiv('bulb', 1, 'text-center') +
            '<p class="text-center">You can send call sheets to the contacts listed on this page. Either search and assign existing StudioBinder Contacts, or add new contacts.<br/> If you are looking to fill in new positions you can always post a job on <a target="_blank" href="https://www.productionbeast.com">ProductionBeast</a></p>' +
            '</div>') : '';
    }
}

angular.module('product.contact.group.enhanced.controller.service',[

])
.service('ContactsGroupEnhancedCtrlService', ContactsGroupEnhancedCtrlService);
function ContactsGroupEnhancedCtrlService() {
    return function ($ctrl, $element, Pagination, groupCtrlService) {

        $ctrl.onInitOther = onInitOther;
        $ctrl.getMorePopoverTemplateOther = getMorePopoverTemplateOther;

        $ctrl.addToList = addToList;

        $ctrl.getInlineActions = getInlineActions;
        $ctrl.getRowMobileActions = getRowMobileActions;
        $ctrl.processEventOther = processEventOther;
        $ctrl.viewSingleItemParams = viewSingleItemParams;

        $ctrl = new groupCtrlService($ctrl, $element, Pagination);

        return $ctrl;

        function viewSingleItemParams(item) {
            var p = {
                productId: $ctrl.CPS.productId
            };
            if($ctrl.childListField) {
                p[$ctrl.childListField] = item._id;
            }
            return p;
        }

        function getInlineActions(isHeader, item) {
            var t = 'List';
            return $ctrl.canEdit ? (
                isHeader ? ( '<div class="with-btn hide-print">&nbsp;</div>'
                    ) :
                    ('<div class="with-btn with-hover text-center one-line-tooltip hide-print no-drag">' +
                        '<a class="display-block text-center gray-light ' + $ctrl.getClickEventName('addElemToContactsList') + '" analytics-on analytics-action="Open Add to '+t+' Popup">' +
                        '<div class="sbf list" tooltip-placement="bottom" tooltip="Add to ' + t + '">'+$ctrl.LCS.getISBPath(2)+'</div>' +
                        '</a>' +
                        '</div>'
                        //+ getViewContact() //to do bring back
                    )) : '';

            function getViewContact(){
                return '<div class="with-btn with-hover text-center one-line-tooltip hide-print no-drag">' +
                    '<a class="display-block text-center gray-light ' + $ctrl.getClickEventName('openSinglePopup') + '" analytics-on analytics-action="Open Add to '+t+' Popup">' +
                    '<div class="sbf eye" tooltip-placement="bottom" tooltip="View Contact">'+$ctrl.LCS.getISBPath(2)+'</div>' +
                    '</a>' +
                    '</div>';
            }
        }

        function getRowMobileActions(item) {
            var l = [];
            if($ctrl.CPS.productId){
                l.push({
                    type: 'sendElemMessage',
                    action: 'Send Message',
                    icon: 'mail'
                });
            }
            l.push({
                type: 'addElemToContactsList',
                action: 'Add to List',
                icon: 'list'
            });
            return l;
        }

        function onInitOther() {
            if ($ctrl.canEdit) {
                $ctrl.addElemToContactsList = addElemToContactsList;
                $ctrl.addElemToProjectList = addElemToProjectList;
            }
        }

        function processEventOther(ids, action, e) {
            switch (action) {
                case 'addToProjectList':
                case 'addToContactsList':
                    return $ctrl.addToList(ids, action === 'addToContactsList');
            }
            $ctrl.processEventOtherInit(ids, action, e);
        }

        function getMorePopoverTemplateOther(item, isMobile) {
            return ((!isMobile && $ctrl.CPS.productId) ? $ctrl.getSideMenuLi({
                    type: 'sendElemMessage',
                    action: 'Send Message',
                    icon: 'mail'
                }) : '') +

                ($ctrl.CPS.productId ? '' : $ctrl.getSideMenuLi({
                    type: 'addElemToProjectList',
                    action: 'Assign to Project',
                    icon: 'project'
                })) +

                (isMobile ? '' : $ctrl.getSideMenuLi({
                    type: 'addElemToContactsList',
                    action: 'Add to List',
                    icon: 'list'
                }));
        }

        function addElemToContactsList(item, param, e) {
            console.log('addElemToContactsList');
            $ctrl.processEventOther([{id: item._id}], 'addToContactsList', e);
        }

        function addElemToProjectList(item, param, e) {
            console.log('addElemToProjectList');
            $ctrl.processEventOther([{id: item._id}], 'addToProjectList', e);
        }

        function addToList(ids, isContactList, e) {
            console.log('addToList');
            var extraParam = {
                contactType: isContactList ? $ctrl.service.ContactTypes.List : $ctrl.service.ContactTypes.Project,
                currentListId: $ctrl.currentListId,
                isCustomList: $ctrl.isCustomList(),
                preLoadingService: $ctrl.preLoadingService
            };//to do -> get the items
            var items = ids.map(function (item) {
                return $ctrl.list.getElementById(item.id);
            });
            if (items.length === 1 && items[0] !== null && typeof (items[0]) === 'object') {
                extraParam.existing = $ctrl.service.getExistingLists(items[0]);
                items[0] = items[0]._id;
            }
            //onbject type = isContactList ? 'List' : 'Project', ;
            $ctrl.popupsService.open(items, $ctrl.popupsService.operations.assignProjects, extraParam,
                $ctrl.compOptions);
        }

    }
}

angular.module('product.contacts.group.controller.service',[
    'group.controller.service',
    'product.contacts.group.inter.controller.service'
])
.service('ContactsGroupCtrlService',ContactsGroupCtrlService);
ContactsGroupCtrlService.$inject = ['TreeGroupInitCtrlService', 'ContactsGroupInterCtrlService'];
function ContactsGroupCtrlService(TreeGroupInitCtrlService, ContactsGroupInterCtrlService) {
    return function ($ctrl, $element, Pagination) {
        //$ctrl.additionalMessageRemove = 'You will lose this project’s contacts, call sheets, and files.';
        //item methods
        if(!$ctrl.getGroupButtons) {
            $ctrl.getGroupButtons = getGroupButtons;
        }

        $ctrl.withExistingBtn = withExistingBtn;

        $ctrl.onPreloadGroupOther = onPreloadGroupOther;

        if(!$ctrl.getGroupEmptyButtons){
            $ctrl.getGroupEmptyButtons = getGroupEmptyButtons;
        }

        $ctrl.$onInit = $onInit;

        return $ctrl;

        function $onInit() {
            $ctrl = new ContactsGroupInterCtrlService($ctrl);
            $ctrl = new TreeGroupInitCtrlService($ctrl, $element, Pagination, false);

            if($ctrl.onInitOther) {
                $ctrl.onInitOther();
            }
        }

        function onPreloadGroupOther() {
            if(!$ctrl.canEdit) {return;}

            if ($ctrl.CPS.productId) {
                $ctrl.createCallsheet = createCallsheet;
            }

            $ctrl.addExistingContacts = addExistingContacts;
            $ctrl.importContacts = importContacts;

            $ctrl.addRootWatcher('ADD_EXISTING_CONTACTS', function(result) {
                $ctrl.addExistingContacts(result ? result.e : null);
            });

            $ctrl.addRootWatcher('IMPORT_CONTACTS', function(result) {
                $ctrl.importContacts(result ? result.e : null);
            });
        }

        function getGroupEmptyButtons() {
            var withNgclick = true,
                create = 'createItemWithEvent',
                btn2 = 'addExistingContacts';
            return '<button class="btn btn-primary ' + ($ctrl.pageClass ? $ctrl.pageClass : '') +
                (withNgclick ? '' : (' ' + $ctrl.getBtnActionCls()))+
                '"' +
                (withNgclick ? (' ng-click="$ctrl.'+create+'(null, null, $event)"') : '') +
                ' data-type="createNonNg" analytics-on analytics-action="Open New ' + $ctrl.itemTitle + 's"><div class="pull-left sbf plus"></div><div class="with-padding-left">New ' + $ctrl.roleText + '</div></button>' +
   ($ctrl.CPS.productId ? ('<button ng-show="$ctrl.withExistingBtn()" class="btn btn-small transparent big with-margin-left ' + (withNgclick ? '' : (' ' + $ctrl.getBtnActionCls())) +
       '" ' +
       (withNgclick ? (' ng-click="$ctrl.'+btn2+'($event)"') : '') +
       'data-type="'+btn2+'" analytics-on analytics-action="Open Existing '+$ctrl.itemTitle+'"><div class="pull-left sbf plus"></div> Existing '+$ctrl.itemTitle+'s</button>'):'');
        }

        function getGroupButtons() {
            var withNgClick = true,
                type = ($ctrl.roleTextS ? $ctrl.roleTextS : $ctrl.roleText),
                create = 'createItemWithEvent',
                btn2 = 'addExistingContacts',
                btn3 = 'importContacts',
                btnCls = 'small inline-block semibold ' + (withNgClick ? '' : $ctrl.getBtnActionCls());

            return '<a class="' + btnCls + '" ' +
                (withNgClick ? ('ng-click="$ctrl.' + create + '(null, null, $event)" ') : '') + 'data-type="createNonNg" analytics-on analytics-action="Open New Contacts" tabindex="5" ui-keyup="{enter:\'$ctrl.' + create + '(null, null, $event)\'}">' +
                $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left') +
                ' <span class="with-margin-left">New ' + type + '</span></a>' +
                '<a ng-show="$ctrl.withExistingBtn()" class="' + btnCls + '" ' +
                (withNgClick ? ('ng-click="$ctrl.' + btn2 + '($event)" ') : '') + 'data-type="' + btn2 + '" analytics-on analytics-action="Open Existing ' + $ctrl.itemTitle + '" tabindex="6" ui-keyup="{enter:\'$ctrl.' + btn2 + '($event)\'}">' +
                $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left') +
                ' <span class="with-margin-left">Existing ' + $ctrl.itemTitle + 's</span></a>' +
                (!$ctrl.CPS.productId && $ctrl.currentListId === 'All' ? ('<a class="' + btnCls + '" ' +
                    (withNgClick ? ('ng-click="$ctrl.' + btn3 + '($event)" ') : '') +
                    'data-type="' + btn3 + '" analytics-on analytics-action="Open Import ' + $ctrl.itemTitle + '" tabindex="6" ui-keyup="{enter:\'$ctrl.' + btn3 + '($event)\'}">' +
                    $ctrl.LCS.getISBDiv('upload-2', 3, 'pull-left') +
                    '<span class="hide-lower-1024 with-margin-left">Import ' + $ctrl.itemTitle + 's</span></a>') : '');
        }

        function withExistingBtn() {
            var isAll = $ctrl.currentListId === 'All',
                isPredef = $ctrl.currentListId !== undefined && $ctrl.currentList ? $ctrl.currentList.isPredef : false;
return $ctrl.CPS.productId ||
    !$ctrl.CPS.productId && (!isPredef && !isAll);
        }

        function createCallsheet(ids, e) {
            console.log('createCallsheet');
            var cast = ids  ? ids.map(function (item) {
                return item.id;
            }) : null;
            if(!cast || cast.length===0){return;}

            $ctrl.popupsService.teamAccess(process);

            function process() {
                var callsheet = $ctrl.CPS.CurrentProduct.getCallsheet(true);
                $ctrl.CPS.CurrentProduct.setCallsheet(callsheet);
                $ctrl.popupsService.open(callsheet, $ctrl.popupsService.operations.createCallsheet, {
                        cast: cast
                    },
                    //$ctrl.compOptions -> use comp options from callsheet
                );
              /*  $ctrl.CPS.transitionTo('user.product.callsheet.edit', $ctrl.CPS.currentProductPathParams({
                    withCast: 'with-cast',
                    mode: 'design'
                }));*/
            }
        }

        function addExistingContacts(e) {
            $ctrl.preventDefault(e);
            console.log('addExistingContacts');
            $ctrl.CPS.loadQuotaPopup($ctrl.quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});
            function process() {
                var isCustomList = $ctrl.isCustomList(),
                    currentListId = isCustomList ? $ctrl.currentListId : $ctrl.productContactListId;
                $ctrl.popupsService.open([currentListId],
                    $ctrl.popupsService.operations.addExistingContacts, {
                        productContactListId: $ctrl.productContactListId,
                        fullCurrentListId: $ctrl.currentListId,
                        isCustomList: isCustomList,
                        currentListId: currentListId,
                        service: $ctrl.service,
                        preLoadingService: $ctrl.preLoadingService
                    }, $ctrl.compOptions, null, onSuccess);
            }
        }

        function importContacts(e) {
            $ctrl.preventDefault(e);

            $ctrl.CPS.loadQuotaPopup($ctrl.quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});
            function process() {
                var contactLists = {};
                contactLists['c_' + $ctrl.productContactListId] = {};
                //contactLists['c_' + $ctrl.productContactListId].roles =
                $ctrl.popupsService.open($ctrl.cast, $ctrl.popupsService.operations.importContacts, {
                    // productContactListId: $ctrl.productContactListId,
                    // selectedListId: $ctrl.listTreeService.active.selectedListId
                    preLoadingService: $ctrl.preLoadingService,
                    currentListId: $ctrl.currentListId
                }, $ctrl.compOptions, null, onSuccess);
            }
        }

        function onSuccess(result) {
            var updatesG = result.updatesG,
                table = 'cast';
            if (updatesG) {
                var items = updatesG && updatesG[table] && updatesG[table].add ? updatesG[table].add : null;
                if (items && items.length > 0) {
                    var currentListId = 'All';
                    $ctrl.LCS.timeout(function () {
                        $ctrl.broadcastRoot('TREE_SERVICE_RELOAD_LIST_' + $ctrl.elemType, currentListId);
                    }, 300);
                }
            }

            function withExistingBtn() {
                var isAll = $ctrl.currentListId === 'All',
                    isPredef = $ctrl.currentListId !== undefined && $ctrl.currentList ? $ctrl.currentList.isPredef : false;
                return $ctrl.CPS.productId ||
                    !$ctrl.CPS.productId && (!isPredef && !isAll);
            }
        }
    }
}

angular.module('product.contacts.group.inter.controller.service',[
    'group.controller.service',
    'product.contacts.group.init.service'
])
.service('ContactsGroupInterCtrlService',ContactsGroupInterCtrlService);
ContactsGroupInterCtrlService.$inject = ['ContactsGroupInitCtrlService'];
function ContactsGroupInterCtrlService(ContactsGroupInitCtrlService) {
    return function ($ctrl) {

        if(!$ctrl.onLoadDirectoryParams) {
            $ctrl.onLoadDirectoryParams = onLoadDirectoryParams;
        }

        $ctrl.getMorePopoverTemplate = getMorePopoverTemplate;
        $ctrl.getNewPopupParamsOther = getNewPopupParamsOther;

        $ctrl.preloadSettings = preloadSettings;

        $ctrl.getColumnListExt = getColumnListExt;

        $ctrl = new ContactsGroupInitCtrlService($ctrl);

        return $ctrl;

        function onLoadDirectoryParams(item){
            var p =  null;
            if($ctrl.childListField) {
                p = {};
                p[$ctrl.childListField] = item._id;
            }
            return p;
        }

        function preloadSettings() {
            $ctrl.Settings = _.extend({}, $ctrl.Settings, {
                departments: $ctrl.departments,
                positions: $ctrl.positions
            });
        }

        function getColumnListExt(c) {
            return ($ctrl.CPS.productId && c && c.prop === 'rate') ? {type: $ctrl.SBFieldTypesService.PropTypes.ContactRate} : null;
        }


        function getMorePopoverTemplate(item, isMobile) {
            var withTopBorder = false,
                el = '<ul class="dropdown-menu side-menu display-block cotacts-sidemenu">'; //fadeInDown

            if($ctrl.canEdit){
                el += $ctrl.getSideMenuLi({
                    type: 'edit',
                    action: 'Edit ' + ($ctrl.roleTextS ? $ctrl.roleTextS : $ctrl.roleText),
                    icon: 'pencil'
                });
                withTopBorder = true;
            }

            if(typeof ($ctrl.getMorePopoverTemplateOther) && $ctrl.getMorePopoverTemplateOther(item, isMobile)){
                el += $ctrl.getMorePopoverTemplateOther(item, isMobile)
                withTopBorder = true;
            }

            el += $ctrl.addRemoveLi(withTopBorder) +
                '</ul>';

            return el;
        }

        function getNewPopupParamsOther() {
            return _.extend({
                positions:$ctrl.positions,
                departments:$ctrl.departments,
                currentListId: $ctrl.currentListId,
                isCustomList: $ctrl.isCustomList()
            }, $ctrl.getNewPopupParamsOther2 ? $ctrl.getNewPopupParamsOther2() : null);
        }
    }
}

angular.module('product.contacts.group.init.service', [
    'product.contacts.assign.component',
    'product.contacts.adjustRoles.popup.component'
])
.service('ContactsGroupInitCtrlService', ContactsGroupInitCtrlService);
ContactsGroupInitCtrlService.$inject = ['FormatPhoneNumberService', 'CompInitCtrlService', 'SBFieldMethods' ];
function ContactsGroupInitCtrlService(FormatPhoneNumberService, CompInitCtrlService, SBFieldMethods) {
    return function ($ctrl) {
        $ctrl.SBFieldMethods = SBFieldMethods;

        if(!$ctrl.quotaTypeMessages){
            $ctrl.quotaTypeMessages = 'contactMessage';
        }

        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl, false, true);
        }

        $ctrl.isNotCurrentList = isNotCurrentList;
        if(!$ctrl.getGroupEmpty){
            $ctrl.getGroupEmpty = getGroupEmpty;
        }
        $ctrl.getContactRate = getContactRate;
        $ctrl.getAdjustRoles = getAdjustRoles;

        $ctrl.onPreloadGroupContacts = onPreloadGroup;
        $ctrl.onPreloadGroup = onPreloadGroup;
        $ctrl.getGroupItemAttributes = getGroupItemAttributes;
        $ctrl.removeElemContact = removeElemContact;
        $ctrl.removeContacts = removeContacts;
        $ctrl.isCustomList = isCustomList;
        $ctrl.hasSortableInit = hasSortableInit;
        $ctrl.addRemoveLi = addRemoveLi;
        $ctrl.getOrderListField = getOrderListField;
        $ctrl.processEventOtherInit = processEventOtherInit;
        $ctrl.isSameList = isSameList;

        if(!$ctrl.processEventOther) {
            $ctrl.processEventOther = processEventOtherInit;
        }
        $ctrl.afterProcessUpdates = afterProcessUpdates;
        $ctrl.isCrewList = isCrewList;

        //set departments
        if($ctrl.isCrewList()) {
            $ctrl.withoutGroupSorting = true;
            $ctrl.sortGroupTemplate = sortGroupTemplate;

            if (!$ctrl.getRolesToSort) {
                $ctrl.getRolesToSort = getRolesToSort;
            }
        }
        $ctrl.getLoadedListWithDeps = getLoadedListWithDeps;

        return $ctrl;

        function removeElemContact(item) {
            console.log('removeElemContact');
            if(!item){return;}
            $ctrl.removeContacts([{id: item.id ? item.id : item._id}]);
        }

        function removeContacts(ids) {
            console.log('removeContacts');

            var isCustomList = $ctrl.isCustomList();
            var extraParam = {
                    contactType: (isCustomList ? 'List' : ($ctrl.CPS.productId ? 'Project' : '')),
                    isCustomList: isCustomList,
                    preLoadingService: $ctrl.preLoadingService,
                    currentListId: $ctrl.currentListId
                },
                items = ids.map(function (item) {
                    return $ctrl.list.getElementById(item.id);
                });

            if (items.length === 1 && items[0] !== null && typeof (items[0]) === 'object') {
                items[0] = items[0]._id;
            }

            //object type = isContactList ? 'List' : 'Project', ;
            $ctrl.popupsService.open(items, $ctrl.popupsService.operations.removeContacts, extraParam, $ctrl.compOptions);
        }

        function isSameList(a, b){
            return false;

            //todo seems like the role gets updated
            for(var i = 0, n = a.length; i < n; i++){
                if(iseq('contactLists')){
                    return false;
                }else if(iseq('roles')){
                    return false;
                }
            }
            return true;

            function iseq(prop){
                return angular.equals(a[i][prop], b[i][prop]);
            }
        }

        function isCrewList() {
            return check($ctrl.currentListId, false) || check($ctrl.currentList, true);

            function check(obj, isObj) {
                var el = obj ? (isObj ? obj._id : obj) : null;
                return el ? el.toString() === '2' : false;
            }
        }

        function afterProcessUpdates(result) {
            console.log('ContactsGroupInitCtrlService.afterProcessUpdates');
            if ($ctrl.afterProcessUpdatesInit) {
                $ctrl.afterProcessUpdatesInit(result);
            }

            if ($ctrl.afterProcessUpdatesOther) {
                $ctrl.afterProcessUpdatesOther(result);
            }
        }

        function getLoadedListWithDeps(isLeft, halfwidth) {
            //0 = isFull, 1 = isLeft, 2 = isRight
            //if (!$ctrl.canEdit && $ctrl.options.twoCols) {
            //                 var list = $ctrl.list.items;
            //
            //                 if (list.length > 0) {
            //                     var len = list.length,
            //                         mid = Math.round(len / 2);
            //                     $ctrl.left = []; $ctrl.right = [];
            //                     _.each(list, function (item, i){
            //                          $ctrl[i < mid ? 'left' : 'right'].push(i);
            //                     });
            //                 }
            //             }

            if (!$ctrl.sortedDeps) {
                return $ctrl.getLoadedList2Cols(isLeft, halfwidth);
            }
            var el = '';
            var list = halfwidth ? (isLeft ? $ctrl.sortedDepsLeft : $ctrl.sortedDepsRight) : $ctrl.sortedDeps;
            _.each(list, function (d) {
                el += $ctrl.processD(d.pos, d);
            });
            return el;

        }

        function getRolesToSort(item){
            return $ctrl.service.getItemRoles(item, $ctrl.productContactListId);
        }

        function sortGroupTemplate() {
            console.log('sortGroupTemplate');
            //get sorted departments
            var deps = {}, indexes = {};
            _.each($ctrl.list.items, function (item, i) {
                var roles = $ctrl.getRolesToSort(item);
                if (!roles) {
                    roles = [{type: 2, depId: 0, posId: 0}];
                } //set the people that have no roles as unassigned crew
                _.each(roles, function (r) {
                    if (r.type === 2) {
                        r = setInt(r, 'posId');
                        r = setInt(r, 'depId');
                        var depId = r.depId, posId = r.posId, dep = deps[depId],
                            p = posId === 0 ? { //consider the unassigned
                                _id: posId,
                                posId: posId,
                                depId: depId,
                                isPredef: true,
                                order: 1000,
                                name: 'Unassigned',
                                shortName: 'Unassigned'
                            } : _.find($ctrl.positions, function (p) {
                                return p.posId === posId;
                            });
                        if (p) {
                            if (!dep) {
                                //consider the unassigned
                                var d = depId === 0 ? {
                                    _id: depId,
                                    depId: depId,
                                    deleted: false,
                                    isFolder: false,
                                    isPredef: true,
                                    name: 'Unassigned',
                                    order: 1000,
                                    parentId: null,
                                    type: 6,
                                } : _.find($ctrl.departments, function (d) {
                                    return d.depId === depId;
                                });
                                if (d) {
                                    deps[depId] = {
                                        depId: d.depId,
                                        order: d.order,
                                        name: d.name,
                                        pos: {}
                                    }
                                    dep = deps[depId];
                                }
                            }

                            if(dep) {
                                var pos = dep.pos ? dep.pos[posId] : null;
                                if (!pos) {
                                    dep.pos[posId] = {posId: posId, order: p.order, items: []};
                                    pos = dep.pos[posId];
                                }
                                //display for each dep only the roles in that dep

                                var exists = false;
                                for (var j = 0; j < pos.items.length; j++) {
                                    var it = pos.items[j];
                                    if (item._id === it._id) {
                                        //pos.items[j].roles.push(r);
                                        exists = true;
                                        break;
                                    }
                                }

                                if (!exists) {
                                    pos.items.push(item);
                                    indexes[item._id] = i;
                                }
                            }
                        }
                    }
                });
            });

            var ld = [], depsRows = 0;
            for(var depId in deps){
                var d = deps[depId], lp = [];
                for(var posId in d.pos){
                    var p = d.pos[posId];
                    //sort alphabetically if they have same position instead of by order
                    //_.sortBy(p.items, 'order')
                    p.items = _.sortBy(p.items, function (item){return item.name?item.name.toLowerCase():'';}).map(function (item){
                        return indexes[item._id];
                    });
                    lp.push(p);
                }
                var items = [];
                //ensure items with multiple positions in same dep dont appear twice
                _.each(_.sortBy(lp, 'order'), function (p){
                    _.each(p.items, function (j){
                        if(_.find(items, function (ind){return ind === j;}) === undefined){
                            items.push(j);
                        }
                    });
                })
                d.pos = items;
                ld.push(d);
                depsRows += items.length + 1;
            }

            $ctrl.sortedDeps = _.sortBy(ld, 'order');
            $ctrl.depsRows = depsRows;

            var h = Math.round($ctrl.depsRows/2), total = 0, addRight = false;
            $ctrl.sortedDepsLeft = [];
            $ctrl.sortedDepsRight = [];
            for(var i = 0, l = $ctrl.sortedDeps.length; i < l; i++) {
                total += 1; // the header
                var d = $ctrl.sortedDeps[i];
                if (addRight) {
                    $ctrl.sortedDepsRight.push(d);
                } else {
                    var pos = d.pos,
                        pl = pos.length,
                        dif = h - total - pl;
                    if (dif >= 0) {
                        $ctrl.sortedDepsLeft.push(d);
                    } else {
                        var c = h - total;
                        if (c < 0) {
                            c = 0;
                        }
                        add(true, 0, c, pos);
                        add(false, c, pl, pos);
                        addRight = true;
                    }
                    total += pl;
                }
            }

            function add(isLeft, start, end, pos) {
                if (end > 0) {
                    var tL = _.clone(d);
                    tL.pos = [];
                    for (var j = start; j < end; j++) {
                        tL.pos.push(pos[j]);
                    }
                    $ctrl[isLeft ? 'sortedDepsLeft' : 'sortedDepsRight'].push(tL);
                }
            }

            function setInt(r, prop){
                try {
                    if(r[prop] && typeof r[prop] === 'string'){
                        r[prop] = parseInt(r[prop],10);
                    }
                }catch (e){ }
                return r;
            }
        }

        function processEventOtherInit(ids, action, e) {
            if ($ctrl[action]) {
                return $ctrl[action](ids, e);
            } else {
                console.warn('Must define methods $ctrl.' + action + ' in parent for contactGroup');
                return null;
            }
        }


        function getOrderListField(){
            return 'roles';
        }

        function getGroupItemAttributes(depId) {
            return (depId !== undefined && depId !== null ? ('dep-id="' + depId + '" ') : '') +
                'on-get-adjust-roles="::$ctrl.getAdjustRoles(item, canUpdate, ' + depId + ')" ' +
                'on-get-contact-rate="::$ctrl.getContactRate(item, canUpdate)" ' +
                ($ctrl.getGroupItemAttributesOther ? $ctrl.getGroupItemAttributesOther(depId) : '');
        }

        function hasSortableInit() {
            //the default method doesnt include the All list
            return $ctrl.canEdit;
        }

        function isNotCurrentList(item) {
            if ($ctrl.currentListId === 'All' || $ctrl.isCustomList()) {
                return false;
            }
            var roles = $ctrl.service.getItemRoles(item, $ctrl.productContactListId);
            if (!roles || !roles.length) {
                return 0;
            }
            var exists = _.find(roles, function (role) {
                try {
                    return role && role.type.toString().toLowerCase() === $ctrl.currentListId.toLowerCase();
                } catch (e) {
                    return false;
                }
            });
            return !(exists);
        }

        function isCustomList() {
            return $ctrl.currentListId && $ctrl.currentListId.length > 12;
        }

        function onPreloadGroup() {
            $ctrl.productContactListId = $ctrl.CPS.product ? $ctrl.CPS.product.contactListId : null;
            $ctrl.roleType = !$ctrl.isCustomList() && $ctrl.currentListId && $ctrl.currentListId !== 'All' ? $ctrl.currentListId : null;
            $ctrl.isNotAll = $ctrl.currentListId === 'All';
            $ctrl.roleTextS = $ctrl.itemTitle;
            $ctrl.roleText = $ctrl.roleTextS +'s';
            switch ($ctrl.currentListId) {
                case "1":
                    $ctrl.roleText = 'Talent';
                    $ctrl.roleTextS = 'Talent';
                    break;
                case "2":
                    $ctrl.roleText = 'Crew';
                    $ctrl.roleTextS = 'Crew';
                    break;
                case "3":
                    $ctrl.roleText = 'Extras';
                    $ctrl.roleTextS = 'Extra';
                    break;
                case "4":
                    $ctrl.roleText = 'Clients';
                    $ctrl.roleTextS = 'Client';
                    break;
            }



            if ($ctrl.canEdit) {
                $ctrl.sendElemMessage = sendElemMessage;
                if(!$ctrl.sendMessage){
                    $ctrl.sendMessage = sendMessage;
                }

                $ctrl.adjustItemRoles = adjustItemRoles;
                //from top buttons
                if($ctrl.onPreloadGroupOther){
                    $ctrl.onPreloadGroupOther();
                }
            }
        }

        function getGroupEmpty() {
            var isCustomList = $ctrl.isCustomList();
            if (!$ctrl.listTreeService.active) {
                return;
            }
            var text1, text2;

            if($ctrl.callsheetId){
                var r = $ctrl.roleText.toLowerCase();
                if($ctrl.isPopup) {//add recipient to callsheet popup
                    text1 = 'No ' + r + ' to add to this call sheet';
                    text2 = 'You must add new contacts to this project first';
                }else{
                    var isHave = r[r.length-1] === 's';
                    text1 = 'No ' + r + ' '+(isHave ? 'have' : 'has') + ' been added to this call sheet';
                    text2 = 'You can add ' + r + ' to this call sheet, and then send it to them';
                }
            } else if (!isCustomList) {
                if (!$ctrl.isNotAll) {
                    text1 = 'No ' + $ctrl.roleText.toLowerCase() + ' have been added yet';
                    text2 = 'You must assign a '+$ctrl.itemTitle.toLowerCase()+' to this role type first';
                } else {
                    if ($ctrl.CPS.productId) {
                        text1 = 'No '+$ctrl.itemTitle.toLowerCase()+'s have been assigned to this project yet.';
                        text2 = 'Search your existing StudioBinder '+$ctrl.itemTitle+'s, or add new ones below';
                    } else {
                        text1 = 'No '+$ctrl.itemTitle.toLowerCase()+'s have been added yet';
                        text2 = $ctrl.itemTitle + 's are the talent, crew, and clients you work with on projects.';
                    }
                }
            } else {
                text1 = 'No '+$ctrl.itemTitle.toLowerCase()+'s have been assigned to this list';
                text2 = 'You can assign new or existing '+$ctrl.itemTitle+'s to this list below.';
            }

            var type = (isCustomList || !isCustomList && $ctrl.isNotAll) ? '' : ('-'+$ctrl.currentListId);

            return '<div class="no-product with-white-bg centered">' +
                '<div class="centering text-center" ng-show="!$ctrl.search">' +
                '<video class="video-anime" muted playsinline autoplay="autoplay" loop="loop" poster="' + $ctrl.LCS.getImgUrl('emptystate/contacts/emptystate' + type + '.jpg') + '"><source src="' + $ctrl.LCS.getVideoUrl('emptystate/contacts/emptystate' + type + '.mp4')+'" type="video/mp4"></video>' +
                    '<h3 class="text-center">' + text1 + '</h3>' +
($ctrl.canEdit ? ('<div ng-if="($ctrl.withActiveGroup&&$ctrl.filtersService.selectedFilter === true)||!$ctrl.withActiveGroup">' +
                        '<p class="text-center">' + text2 + '</p>' +
                        '<div class="spacing-half-top text-center" ng-show="$ctrl.isActiveFilter()">' + $ctrl.getGroupEmptyButtons() + '</div>' +
                    '</div>') : '') +
                '</div>' +
                '<h3 ng-if="$ctrl.search" class="text-center">Sorry, no ' + $ctrl.itemTitle.toLowerCase() + 's match that search.</h3>' +
            '</div>';
        }

        function getContactRate(item, canUpdate, textOnly) {
            //console.log('ContactsGroupInitCtrlService.getContactRate');
            var contactListId = $ctrl.CPS.productId ? $ctrl.CPS.product.contactListId : null,
                val = contactListId ? (item.contactLists && item.contactLists['c_' + contactListId] ? item.contactLists['c_' + contactListId].rate :null) : item.rate;
            return $ctrl.SBFieldMethods.displayRate(val, $ctrl.CPS.getCurrentRate, textOnly);
        }

        function getAdjustRoles(item, canUpdate, depId, textOnly) {
            //console.log('ContactsGroupInitCtrlService.getAdjustRoles');
            return $ctrl.SBFieldMethods.getAdjustRoles($ctrl, item, canUpdate, depId, textOnly);
        }

        function sendElemMessage(item, param, e) {
            console.log('sendElemMessage');
            $ctrl.processEventOther([{id: item._id}], 'sendMessage', e);
        }

        function adjustItemRoles(item, param, e) {
            console.log('adjustItemRoles');
            var p = {
                service: $ctrl.service,
                departments:$ctrl.departments,
                positions:  $ctrl.positions,
                currentListId: $ctrl.currentListId
            };

            //is not in add callsheet recipinets popup
            //but is in recipients grids on callsheets designer step
            if($ctrl.elemType === 'RECIPIENT' && $ctrl.callsheetId) {
                p.cast = $ctrl.preLoadingService.getById( $ctrl.preLoadingService.TblTypes.Contacts, item.castId);
                p.callsheetId = $ctrl.callsheetId;
            }

            if ($ctrl.isEditCallsheet) {
                p.isEditCallsheet = true;
            }
            if ($ctrl.showOverlay) {
                p.showOverlay = true;
            }
            $ctrl.popupsService.open(item, $ctrl.popupsService.operations.adjustRoles, p, $ctrl.compOptions);
        }

        function sendMessage(ids, e) {
            console.log('sendMessage');
            $ctrl.CPS.loadQuotaPopup($ctrl.quotaTypeMessages, process, null, null, $ctrl.compOptions, {e:e});

            function process() {
                var extraParam = {};
                var cast = [], list = $ctrl.list.items, isCrew = list[0].pos != null;
                for (var i = 0; i < ids.length; i++) {
                    var id = ids[i].id;
                    var el = isCrew ? getCrewEl(id) : $ctrl.list.getElementById(id);
                    if (el) {
                        cast.push(el);
                    }
                }

                if (!cast || cast.length === 0) {
                    return;
                }
                extraParam.cast = cast;
                //is a callsheet
                if($ctrl.callsheetId) {
                    extraParam.callsheetId = $ctrl.callsheetId;
                }
                $ctrl.popupsService.open(null, $ctrl.popupsService.operations.sendContactsMessage, extraParam, $ctrl.compOptions);

                function getCrewEl(id) {
                    for (var i = 0, n = list.length; i < n; i++) {
                        var pos = list[i].pos;
                        for (var j = 0, m = pos.length; j < m; j++) {
                            var el = pos[j];
                            if (el && el._id === id) {
                                return el;
                            }
                        }
                    }
                    return null;
                }
            }
        }

        function addRemoveLi(withTopBorder) {
            var isContacts = $ctrl.elemType === 'CONTACT',
                isCustomList = $ctrl.isCustomList();
            return $ctrl.getSideMenuLi({
                type: 'removeElemContact',//($ctrl.CPS.productId || isCustomList) ? 'removeContacts' : 'remove',
                action: 'Remove from ' + (isContacts ? (isCustomList ? 'List' : ($ctrl.CPS.productId ? 'Project' : 'Contacts')) : 'Call sheet'),
                icon: 'trash',
                withTopBorder: withTopBorder,
                aClass: 'accent'
            });
        }
    }
}

angular.module('product.contacts.item.grid.component', [
    'product.contacts.item.grid.controller.service'
])
.component('contactItemGrid', itemGridComponentParams({
