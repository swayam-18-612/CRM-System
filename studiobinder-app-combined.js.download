        $ctrl.withImage = true;
        $ctrl.notAbsoluteTabContent = true;

        $ctrl.setBlocks = setBlocks;
        $ctrl.loadItemsOther = loadItemsOther;
        $ctrl.onPageLoadedOther = onPageLoadedOther;

        $ctrl = new ProfilePageEnhancedCtrlService($ctrl, $element, pageInjectors, printPageParams);

        return $ctrl;

        function onPageLoadedOther() {

        }

        function loadItemsOther(){
            if (!$ctrl.positions) {
                $ctrl.positions = $ctrl.preLoadingService.getPositions();
