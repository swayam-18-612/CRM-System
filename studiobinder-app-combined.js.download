        }

        var t = Object(this.array);
        var len = t.length >>> 0;
        if (typeof fun !== "function"){
            //   throw new TypeError();
            return this.array ;
        }

        var res = [];
        var thisArg = arguments.length >= 2 ? arguments[1] : void 0;
