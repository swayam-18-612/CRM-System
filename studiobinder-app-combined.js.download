angular.module('product.callsheet.topCalls.component', [
    'product.callsheet.block.init.controller.service',
    'apiPagination.TopCalls'

])
.component('callsheetTopCallsItemGrid', itemBlockGroupGridItemParams())
.component('callsheetTopCallsGroup', callsheetGroupComponentParams( 'CallsheetTopCallsGroup'))
.controller('CallsheetTopCallsGroup', CallsheetTopCallsGroup);
CallsheetTopCallsGroup.$inject = ['CallsheetBlockGroupCtrlService', 'TopCallsPagination', '$element'];
function CallsheetTopCallsGroup(CallsheetBlockGroupCtrlService, Pagination, $element) {
    console.log('TopCallsGroupCtrl');
    var $ctrl = this;

    $ctrl.expandMobileRow = false;
    $ctrl.editInlineOnMobile = true;
    $ctrl.SBFieldMethods = SBFieldMethods;
    $ctrl.MomentService = $ctrl.SBFieldMethods.MomentService;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.constantsService = {
            CompOptions: {
                objectType: 'topCalls',
                itemIcon: 'time',
                itemTitle: 'Time',
                elemType: 'TOP_CALL',
                preLoadingTableName: 'TopCalls',
                withoutSpacingForBottomAction: true,
                withShortHandleCol: 'col24',
                withSmallHandle: true,
            },
            ListParams: {
                includeFields: ['companyId', 'productId', 'callsheetId', 'type', 'time', 'order'],
                orderFields: ['order'],
                populate: ''
            },
            GroupSettings: {
                icon: 'plus',
                hideGridHeader: true,
                templateClsOther: '',
                withoutSideBorderCls: true
            }
        };


        $ctrl.alignHandle = 'center';

        $ctrl.onBlockLoaded = onBlockLoaded;
        $ctrl.getGroupTemplateOther = getGroupTemplateOther;//dont add break after
        $ctrl = new CallsheetBlockGroupCtrlService($ctrl, $element, Pagination);
        $ctrl.TopCalls = $ctrl.SBFieldMethods.TopCalls;
        if ($ctrl.canEdit) {
            $ctrl.getNewParams = getNewParams;
        }
    }

    function onBlockLoaded() {
        if ($ctrl.canEdit || !$ctrl.canEdit && $ctrl.list.items.length > 0) {
            var el = '<h2 class="grid-title show-ipad margin-top-quarter"><div class="full-width">Agenda</div><div class="subt full-width">Today\'s Schedule</div></h2>' +
                '<hr class="with-hr margin-bottom-quarter"/>';
            $ctrl.LCS.prependElementFragment($ctrl.element, el);
        }

        if ($ctrl.canEdit && !$ctrl.list.items.length && !$ctrl.isMobileView() &&!$ctrl.noCalltime) {
            $ctrl.create();
            $ctrl.noCalltime = true;
        }
    }

    function getGroupTemplateOther() {
        return '';
    }

    function getNewParams(after, type) {
        if(!type ) {
            var remaining = _.filter($ctrl.TopCalls, function (c) {
                return !_.find($ctrl.list.items, {type: c.id});
            });
            type = (remaining.length > 0 ? remaining[0] : $ctrl.TopCalls[1]).id;
        }
        return {
            _id: new ObjectId().toString(),
            type: type,
            time: $ctrl.list.items.length === 0 ? $ctrl.MomentService.getUtcMomentCopy($ctrl.callsheet.startDate) :
                $ctrl.MomentService.getUtcMomentCopy($ctrl.list.items[$ctrl.list.items.length - 1].time).add(1, 'hours')
        };
    }
}

