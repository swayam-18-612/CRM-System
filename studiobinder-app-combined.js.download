angular.module('product.avscripts', [
    'product.avscriptsPage.component'
])
.config(ProductAvscriptsRouting);
ProductAvscriptsRouting.$inject = ['$uiRouterProvider', 'AvscriptsCompOptions'];
function ProductAvscriptsRouting($uiRouter, compOptions) {
    productPageRouting($uiRouter, compOptions, {
        withCommentsSidebar: true,
        withPrint: true,

        title: 'AV Scripts',
        bodyClass: 'avscripts-page ',
        withDocumentUnload: true
    }, true);
}

angular.module('product.avscriptsPage.component', [
    'product.avscriptsPage.controller.service'
])
.component('avscriptsPage', {
    controller: 'AvscriptsPageCtrl'
})
.controller('AvscriptsPageCtrl', AvscriptsPageCtrl);
AvscriptsPageCtrl.$inject = ['AvscriptsPageCtrlService', '$element'];
function AvscriptsPageCtrl(AvscriptsPageCtrlService, $element) {
    console.log('AvscriptsPageCtrl');
    var $ctrl = this;

    $ctrl = new AvscriptsPageCtrlService($ctrl, $element);
}

angular.module('product.avscriptsPage.controller.service', [
    'product.avscript',
    'product.documents.page.init.controller.service',
    'apiConstants.avscripts.services'
])
.service('AvscriptsPageCtrlService', AvscriptsPageCtrlService);
AvscriptsPageCtrlService.$inject = ['DocumentsPageInitCtrlService', 'AvscriptsConstantsService'];
function AvscriptsPageCtrlService(DocumentsPageInitCtrlService, constantsService) {
    return function ($ctrl, $element) {
        $ctrl.groupTag = 'document-group';

        $ctrl.hasCustomGroupName = true;

        $ctrl.onLoadDirectoryParams = onLoadDirectoryParams;
        $ctrl.canShowShareInMore = canShowShareInMore;
        $ctrl.showIntro = showIntro;

        if(!$ctrl.getGroupName) {
            $ctrl.getGroupName = getGroupName;
        }
        if(!$ctrl.getGroupIcon) {
            $ctrl.getGroupIcon = getGroupIcon;
        }
        $ctrl.getGroupNameFromTop = getGroupNameFromTop;
        $ctrl.getGroupIconFromTop = getGroupIconFromTop;

        $ctrl.getListIcon = getListIcon;
       // $ctrl.showTopFilters = showTopFilters;
        $ctrl.canCopyMulti = canCopyMulti;
        $ctrl.canMoveMulti = canMoveMulti;
        $ctrl.getOtherSidebarOptions = getOtherSidebarOptions;
        $ctrl.getGroupOrder = getGroupOrder;
        $ctrl.onPageTreeInitOther = onPageTreeInitOther;

        $ctrl = new DocumentsPageInitCtrlService($ctrl, $element, constantsService);

        return $ctrl;

        function onPageTreeInitOther() {
            $ctrl.listTreeService.getGroupOrder = $ctrl.getGroupOrder;
            //if($ctrl.isPrintLayout){
            //    $ctrl.LCS.addClass($ctrl.element, 'hide-toggleTags hide-toggleScenes');
            //}
        }

        function getGroupOrder(id) {
            return id !== undefined &&
            $ctrl.listTreeService.active &&
            $ctrl.listTreeService.active.selectedListId === id &&
                                                                     //series
            $ctrl.listTreeService.active.selectedList.l === 1 ? {isFolder: -1, prefix: 1, name: 1} : null;
        }

        function getOtherSidebarOptions (){
            return  {
                getNewTreeItem: getNewTreeItem,
                getEditPopupColumnsCond: getEditPopupColumnsCond
            };
        }

        function getNewTreeItem(item, el) {
            //season
            if(el && el.l === 2 || el.parentId !== null){
                var n = $ctrl.listTreeService.getNodeById(el.parentId, $ctrl.treeType).nodes;
                var max = n && n.length > 0 ? _.max($ctrl.listTreeService.getNodeById(el.parentId, $ctrl.treeType).nodes.map(function (n){
                    var r = n && n.prefix ? n.prefix.match(/\d+/) : null;
                    return r ? parseInt(r[0], 10) : 0;
                })) : 0;//get items from parent
                max += 1;
                return {
                    prefix: 'S' + (max < 10 ? '0' : '') + max,
                    name: 'Season ' + max
                };
            }
            return null;
        }

        function isInSeries(item) {
            return item && item.isFolder && (item.l === 1 || item.parentId === null);
        }

        function getEditPopupColumnsCond(c, item) {
                                                    // series                                               // season
            return isInSeries(item) ? (c.prop !== 'prefix' && c.prop !== 'epNo' &&  c.prop !== 'createdAt') : (c.prop !== 'epNo');
        }

        function canMoveMulti(){
            return $ctrl.listTreeService && $ctrl.listTreeService.getFirstLevelNodesCount($ctrl.treeType);
        }

        function canCopyMulti(){
            return false;
        }
        function showTopFilters(){
            return true;
        }

        function getListIcon(item){
            return item && item.l === 1 ? $ctrl.iconForGroup : $ctrl.iconForList;
        }

        function getGroupNameFromTop(){
            return $ctrl.nameForList;
        }

        function getGroupIconFromTop(){
            return $ctrl.iconForList;
        }

        function showIntro(){return false;}

        function onLoadDirectoryParams(item) {
            return {
                documentVersionId: item.versionId,
                documentId: item._id
            }
        }

        function canShowShareInMore(item, isMobile){
            return item && !item.isFolder;
        }

        function getGroupName(list, inside){
            return getLevel(list, inside) ? $ctrl.nameForList : $ctrl.nameForGroup;
        }

        function getGroupIcon(list, inside){
            return getLevel(list, inside) ? $ctrl.iconForList : $ctrl.iconForGroup;
        }

        function getLevel(list, inside) {
            var l = list ? list : $ctrl.currentList;
            return l && ((l.l ? l.l : (l.parentId === null ? 1 : 2)) + (inside ? 1 : 0)) === 2;
        }
    }
}

angular.module('product.breakdown.element.new.component', [
    'product.breakdown.element.new.controller.service'
])
.component('elementNew',{
    bindings: {
        insertAfter: '@',
        showLabels: '<?',
        showTagAll: '<?',
        item: '<?',
        categoryId: '<',
        withoutClear: '<?',
        btnText: '@',
        showCancel: '<?',
        withNameFocus: '@?',
        bigBtns: '<?',
        elemClass: '@?',
        rowClass: '@?',
        scriptLoadingService: '<?',
        onPopupClosed: '&'
    },
    controller: 'NewSceneElementComponentCtrl'
})
.controller('NewSceneElementComponentCtrl', NewSceneElementComponentCtrl);

NewSceneElementComponentCtrl.$inject = ['NewSceneElementInitCtrlService', 'TaggingScenesService', '$element'];
function NewSceneElementComponentCtrl(NewSceneElementInitCtrlService, TaggingScenesService, $element) {
    var $ctrl = this;

    console.log('Element New');

    $ctrl.getNewSceneTemplate = getNewSceneTemplate;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        if (!$ctrl.elemClass) {
            $ctrl.elemClass = 'form-control with-underline capitalize';
        }
        $ctrl.cantChangeCategory = true;
        $ctrl.objectType = 'taggingElement';
        $ctrl = new NewSceneElementInitCtrlService($ctrl, $element, TaggingScenesService);
    }

    function getNewSceneTemplate() {
        return '<form name="$ctrl.formHolderItem[$ctrl.formName]" class="auto elementnew" novalidate autocomplete="off" ui-keyup="{\'enter\':\'$ctrl.saveNew($event)\'}">' +
            $ctrl.LCS.getErrorBlock() +
            $ctrl.getElementNewFormTemplate() +
            '<div class="text-left clearfix spacing-quarter">' +
                $ctrl.getElementNewButtonsTemplate() +
            '</div>' +
        '</form>';
    }
}

angular.module('product.breakdown.element.new.controller.service', [

])
.service('NewSceneElementInitCtrlService', NewSceneElementInitCtrlService);
NewSceneElementInitCtrlService.$inject = ['CompInitCtrlService', 'ListItemActionCtrlService', 'TemplateCompileService'];
function NewSceneElementInitCtrlService(CompInitCtrlService, ListItemActionCtrlService, TemplateCompileService) {
    return function NewSceneElementInitCtrlService($ctrl, $element, taggingScenesService){

        if(!$ctrl.saveEvent){
            $ctrl.saveEvent = 'PROCESS_SCENE_ELEMENT';
        }

        if(!$ctrl.labelName){
            $ctrl.labelName = 'Element Name';
        }

        if (!$ctrl.$onDestroy) {
            $ctrl.$onDestroy = $onDestroy;
        }

        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl);
        }

        if (!$ctrl.scriptLoadingService) {
            console.warn('NewSceneElementInitCtrl doesn’t have $ctrl.scriptLoadingService');
        }

        if (!$ctrl.getNewSceneTemplate) {
            console.warn('parent for NewSceneElementInitCtrl must define method have $ctrl.getNewSceneTemplate');
        }

        $ctrl.$element = $element;
        $ctrl.element = $ctrl.$element[0];

        //ce = category elements
        //se = scene elements
        //must inherit $ctrl.scriptLoadingService

        var initOtherElementsItem = false;
        $ctrl.info = {otherElementsStr: null};
        $ctrl.closedata = null;
        $ctrl.dontChangeCopyItem = true;
        $ctrl.setCategory = setCategory;

        $ctrl.getClosingParams = getClosingParams;
        $ctrl.onError = onError;
        $ctrl.saveNew = saveNew;
        $ctrl.onChange = onChange;
        $ctrl.passMoreData = passMoreData;
        $ctrl.remove = remove;
        if(!$ctrl.getElementNewFormTemplate) {
            $ctrl.getElementNewFormTemplate = getElementNewFormTemplate;
        }
        $ctrl.getElementNewButtonsTemplate = getElementNewButtonsTemplate;

        $ctrl.isDisabled = isDisabled;
        $ctrl.onTagAllMentions = onTagAllMentions;
        $ctrl.isTagAllMentions = isTagAllMentions;

        $ctrl.getItemToSave = getItemToSave;

        if(!$ctrl.withoutCategories) {
            $ctrl.$onChanges = $onChanges;
            $ctrl.changedFields = ['categoryId'];
            $ctrl.onCategoryChanged = onCategoryChanged;
            $ctrl.item.allScenes = false;
        }

        $ctrl.onTextChanged = onTextChanged;
        //if the new element is not in the tagging selector
        if (!$ctrl.close) {
            $ctrl.close = close;
        }

        initSceneElement();

        reloadTemplate();

        return $ctrl;

        function $onChanges(changes) {
            if (!changes || !$ctrl.changedFields) {
                return;
            }
            console.log(changes);
            for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
                var field = $ctrl.changedFields[i];
                var change = changes[field];
                if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                    console.log('$onChanges: changedField = ' + field + '; val: ' + change.currentValue);
                    if (field === 'field') {
                        $ctrl.setCategory($ctrl.categoryId, true);
                    }
                }
            }
        }

        function onCategoryChanged() {
            initOtherElements($ctrl.categoryId);
        }

        function onTagAllMentions(e) {
            $ctrl.preventDefault(e);
            $ctrl.item.allScenes = $ctrl.item.allScenes ? false : true;
            var input = $ctrl.element.querySelector('.inputTag');
            if(input) {
                if ($ctrl.item.allScenes) {
                    input.setAttribute('checked', 'checked');
                } else {
                    input.removeAttribute('checked');
                }
            }
        }

        function isTagAllMentions() {
            return $ctrl.item.allScenes === true;
        }

        function getTagAllDiv(){
            return ($ctrl.isNew && !$ctrl.withoutCategories) ? ('<div class="form-group text-left clearfix ' +
                ($ctrl.bigBtns ? ('with-side-padding spacing-half-bottom '+ ($ctrl.withoutCategories ? '' : 'with-border-bottom20')) : 'margin-bottom-quarter') +
                '">' +
                '<div ng-click="$ctrl.onTagAllMentions($event)" class="custom-checkbox '+ ($ctrl.pageClass || '' ) +'">' +
                    '<label><input class="inputTag" type="checkbox"' + ($ctrl.item.allScenes ? ' checked="checked"' : '') + '"><span><span class="longer">Tag all mentions in script</span></span></label></div>' +
                '</div>') : '';
        }

        function $onDestroy() {
            $ctrl.removeWatchers();
            if ($ctrl.newSceneCompile) {
                $ctrl.newSceneCompile.destroyNewScope();
            }
        }

        function reloadTemplate() {
            if (!$ctrl.newSceneCompile) {
                $ctrl.newSceneCompile = new TemplateCompileService($ctrl.$element, $ctrl.getNewSceneTemplate, $ctrl);

            }

            if ($ctrl.insertAfter === 'true' || $ctrl.insertAfter === true) {
                $ctrl.newSceneCompile.destroyNewScope();
                $ctrl.newSceneCompile.insertAfter = true;
            }

            $ctrl.newSceneCompile.loadTemplate(function () {
                console.log('template loaded');
                if (typeof ($ctrl.onNewSceneTemplateLoaded) === 'function') {
                    $ctrl.onNewSceneTemplateLoaded();
                }
            });
        }

        function isDisabled(){
            return $ctrl.isUpdating || !$ctrl.withoutCategories && !$ctrl.item.categoryId;
        }

        function getElementNewButtonsTemplate() {
            var btnText = $ctrl.btnText ? $ctrl.btnText : ($ctrl.isNew ? ($ctrl.btnText1?$ctrl.btnText1:'Add Element ') : 'Update');
            return getTagAllDiv() +
                '<div ' + ($ctrl.bigBtns ? 'class="with-side-padding"' : '') + '>' +
                '<button class="btn primary pull-left ' +
                    ($ctrl.showCancel && !$ctrl.bigBtns ? 'smallbtn small-btns' : ('btn-gray ' + ($ctrl.btnText ? 'btn-smaller' : 'btn-small'))) + '" ' +
                    'style="width:' + ($ctrl.bigBtns ? ($ctrl.isNew && !$ctrl.showCancel ? '100%' : '47%') : 'auto') + ';min-width:' + ($ctrl.btnText ? '60px' : '80px') + '" ' +
                    'type="button" ' +
                    'ng-click="$ctrl.saveNew($event)" ' +
                    'analytics-on analytics-action="Save Tagging Element" ' +
                    'ng-disabled="$ctrl.isDisabled()" ' +
                    'ng-class="{\'disabled\': $ctrl.isDisabled()}" ' +
                '>' +
                    '<div class="sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></div> <span>' + btnText + '</span></button>' +
                ($ctrl.showCancel && $ctrl.bigBtns ? ('<button class="edit-profile btn btn-small transparent pull-right" style="width: 48%" ng-click="$ctrl.cancel()" type="button">Cancel</button>') : '') +
                (!$ctrl.isNew && !$ctrl.showCancel ? '<button class="edit-profile btn btn-small transparent pull-right" style="width: 48%" ng-click="$ctrl.remove()" type="button">Remove</button>' : '') +
                ($ctrl.showCancel && !$ctrl.bigBtns ? ('<span class="orsmall">or</span>' +
                    '<a class="cancelsmall" ng-click="$ctrl.cancel()">Cancel</a>') : '') +
                '</div>';
            //  'is-new=\'$ctrl.isNew\' big-btns=\'$ctrl.bigBtns\' on-tag-all-mentions =\'$ctrl.on-tag-all-mentions\' show-cancel=\'$ctrl.showCancel\' btn-text=\'$ctrl.btnText\'' +
            // '$ctrl.onTagAllMentions = function(){$ctrl.item.allScenes=!$ctrl.item.allScenes;}'
        }

        function getElementNewFormTemplate() {
            return getLabels() +
            '<div class="form-group field clearfix last table ' + ($ctrl.rowClass ? $ctrl.rowClass : '') + '">' +
                '<div>' +
                    getAutocompleteElement()+
                    '<div ng-show="($ctrl.formHolderItem.formItem.name.$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem.formItem.name.$error.required" class="help-inline ng-hide text-left">Name is required.</div>' +
                '</div>' +
                getCount() +
            '</div>';

            function getCount() {
                return $ctrl.withoutQty ? '' : ('<div class="col40">' +
                    '<input class="count ' + ($ctrl.elemClass ? $ctrl.elemClass : '') + '" placeholder="#" type="number" id="count" name="count" ng-model="$ctrl.item.count" required ui-focus="$ctrl.isSetFocus(2)">' +
                    '<div ng-show="($ctrl.formHolderItem.formItem.count.$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem.formItem.count.$error.required" class="help-inline ng-hide text-left">Count is required.</div>' +
                    '</div>');
            }

            function getLabels() {
                return $ctrl.showLabels ? ('<div class="clearfix">' +
                    '<label class="elementbold pull-left col120">' + $ctrl.labelName + '</label>' +
                    ($ctrl.withoutQty ? '' : ('<label class="elementbold pull-right col28">Qty</label>')) +
                    '</div>') : '';
            }

            function getAutocompleteElement(){
                var cls = '';// 'capitalize';
                //dont set parent container so that the menu is displayed
                return '<autocomplete-text class="display-block clearfix autocomplete-text '+($ctrl.cantChangeCategory ? '' : 'intagger')+'" ' +
                    'parent-container="false" ' +
                     'element-id="' + $ctrl.item._id + '_name" ' +
                    'search="$ctrl.item.name" ' +
                    'value="::$ctrl.item.elementId" ' +
                    'elem-class="' + $ctrl.elemClass + ' ' + cls + '" ' +
                    'placeholder="Add ' + ($ctrl.cantChangeCategory && $ctrl.category ? $ctrl.category.name.toLowerCase() : 'More Elements') + '…" ' +
                    'init-list-str="$ctrl.info.otherElementsStr" ' +
                    'item-label="name" ' +
                    'item-value="_id" ' +
                    'item-class="' + cls + '" ' +
                    'fixed-height="true" ' +
                    'drp-class-attr="'+($ctrl.cantChangeCategory ? '' : 'intagger')+'" ' +
                    'with-auto-select="'+$ctrl.withAutoSelect+'" ' +
                    'on-change="$ctrl.onChange(result)" ' +
                    'on-text-changed="$ctrl.onTextChanged(value)" ' +
                    // 'service="::$ctrl.service"' +
                    '></autocomplete-text>';
            }
        }

        function onError(err) {
            if (err && err.message === 'overLimit') {
                $ctrl.error = "Please <a target='_blank' href='/pricing'>upgrade</a> to tag more than " + err.count + " elements per project.";
            }
            $ctrl.isUpdating = false;
        }

        function onSave(result) {
            $ctrl.isNew = false;
            $ctrl.item = result.item ? taggingScenesService.convertResource(result.item) : $ctrl.copyItem;

            onclose(false, result);
        }

        function cancel() {
            onclose(true);
        }

        function onclose(isCancel, result) {
if($ctrl.newSceneCompile) {
    $ctrl.newSceneCompile.destroyNewScope();
}
            $ctrl.closedata = getClosingParams(isCancel, result);
            if ($ctrl.close) {
                $ctrl.close();
            }

            $ctrl.isUpdating = false;
        }

        function getClosingParams(cancel, result) {
            var params = {};
            if (result) {
                params = _.extend(params, result);
            }
            params.type = $ctrl.type;//overwrites type from results if there is one
            if (cancel) {
                params.cancel = true;
            } else {
                if ($ctrl.type === 'Edit') {
                    params.oldElementId = $ctrl.copyItem.elementId;
                    params.oldCategoryId = $ctrl.copyItem.categoryId;
                }
            }

            return params;
        }

        function initOtherElements(categoryId) {
            console.log('initOtherElements: ' + categoryId);
            var newels = $ctrl.scriptLoadingService.getElementsNotInStrip(categoryId, $ctrl.item.stripId);
            $ctrl.info.otherElementsStr = newels ? JSON.stringify(newels) : null;
        }
        function initSceneElementOther(){
            if($ctrl.withoutCategories) {return;}

            $ctrl.category = $ctrl.categoryId ? $ctrl.scriptLoadingService.getCategoryById($ctrl.categoryId) : null;

            if ($ctrl.item.isNew) {
                $ctrl.item.categoryId = $ctrl.categoryId;
            }
            initOtherElements($ctrl.categoryId);
        }

        function initSceneElement() {
            if (!(!initOtherElementsItem && $ctrl.item)) {return;}

            if ($ctrl.item.isNew) {
                $ctrl.item = taggingScenesService.convertResource($ctrl.item);
            }

            initSceneElementOther();

            initOtherElementsItem = true;

            $ctrl.type = $ctrl.item.isNew ? 'Create' : 'Edit';
            $ctrl.extraParam = {ce: null, service: taggingScenesService};

            $ctrl = new ListItemActionCtrlService($ctrl);

            $ctrl.cancel = cancel;
            $ctrl.onSave = onSave;

            $ctrl.setFocus();
        }

        function getItemToSave(item){
            return item;
        }

        function saveNew(e) {
       //     $ctrl.LCS.preventDefault(e);
            //console.log('saveNew');
            if ($ctrl.isUpdating) {
                return;
            }

            if (!$ctrl.item.elementId && !$ctrl.item.name) {
                $ctrl.isUpdating = false;
                return $ctrl.cancel();
            }
           // $ctrl.item.name = $ctrl.CPS.capitalizeFirst($ctrl.item.name);

            $ctrl.item = $ctrl.getItemToSave(_.extend({}, $ctrl.item, {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                scriptId: $ctrl.CPS.scriptId
            }));

            $ctrl.save();
        }

        function onTextChanged(val) {
            //console.log('onTextChanged');
            if(!$ctrl.cantChangeCategory && $ctrl.categoryId !== null) {
                $ctrl.setCategory(null, true);
            }
            $ctrl.item.name = val;
        }

        function onChange(result) {
            //console.log('autocomplete changed');
            if (result) {
                var el = $ctrl.scriptLoadingService.getTaggingElementById(result.selected.val);
               if(el) {
                   $ctrl.item.name = el.name;
                   if(!$ctrl.cantChangeCategory) {
                       $ctrl.setCategory(el.categoryId, false);
                   }
               }
            }
        }

        function setCategory(categoryId, changed) {
            //console.log('setCategory: ' + categoryId +'; changed: ' + changed);
            $ctrl.categoryId = categoryId;
            $ctrl.category = $ctrl.categoryId ? $ctrl.scriptLoadingService.getCategoryById($ctrl.categoryId) : null;
            if ($ctrl.categoryId !== $ctrl.item.categoryId) {
                $ctrl.item.categoryId = $ctrl.categoryId;
                if (changed) {
                    $ctrl.item.elementId = null; //if category changes - > set elementId to null
                }
            }
            initOtherElements($ctrl.categoryId);

            if (typeof ($ctrl.onAutocompleteChange) === 'function') {
                $ctrl.onAutocompleteChange();
            }
        }

        function passMoreData(data) {
            console.log('passMoreData');
            if (!data.name) {
                data.name = $ctrl.item.name;
            }
            return data;
        }

        function remove(allScenes) {
            $ctrl.type = 'Remove';
            if (allScenes) {
                $ctrl.item.allScenes = allScenes;
            }
            $ctrl.save();
        }

        function close() {
            console.log('element-new- preclose');
            if ($ctrl.popupAlreadyClosed) {
                return;
            }
            $ctrl.popupAlreadyClosed = true;

            console.log('onClosingNewElement');
            if ($ctrl.isInTaggingSelector) {
                console.log('taggingSelector.onCloseDrp');
                if ($ctrl.closedata) {
                    $ctrl.closedata.range = $ctrl.range;
                } else {
                    $ctrl.closedata = {
                        range: $ctrl.range,
                        type: $ctrl.type,
                        item: $ctrl.copyItem,
                        cancel: true
                    };
                }
            }
            //used to reupdate the element
            $ctrl.closedata.popupAnchor = $ctrl.popupAnchor;
            //used to remove the tagging selector
            var closedata = _.extend($ctrl.closedata, {
                stripId: $ctrl.item.stripId
            });

            $ctrl.broadcastRoot($ctrl.saveEvent, closedata);
            if (typeof ($ctrl.onPopupClosed) === 'function') {
                $ctrl.onPopupClosed(closedata);
            }
        }
    }
}


angular.module('apiConstants.breakdown.services', [
    'sb.fields.types.service'
])
.service('BreakdownConstantsService', BreakdownConstantsService);
BreakdownConstantsService.$inject = ['SBFieldTypesService'];
function BreakdownConstantsService(SBFieldTypesService ) {
    var PropTypes = SBFieldTypesService.PropTypes,
        popupTemplate = getBasePopupTemplateByTag('strip-edit'),

        Options = {
            columns: ['1', '2', '3', '5', '6', '7'],
            view: 2
        },

        Settings = {
            Columns: angular.copy(SBApiGridColumns['breakdown'](PropTypes))
        },

        Filters = [
            {value: 'All', text: 'All Scenes'},
            {value: false, text: 'Omitted Scenes'},
            {value: true, text: 'Active Scenes'}
        ],

        CompOptions = {

            withoutGroupSorting: true,
            hasSearch: true,

            objectType: 'strip',
            itemTitle: 'Scene',
            itemIcon: 'breakdowns',

            listField: undefined,
            withoutListField: true,

            elemType: "BREAKDOWN",
            withActiveGroup: true,
            showBannerProp: 'showBreakdownsBanner',
            bannerFeatureProp: 'breakdowns',
            withDynamicCols: true,

            pageClass: 'page-class breakdownsPage',
            withCreateInlineGroup: true,
            withEditInlineGroup: false,
            tableClass: '.scenetable.breakdown',
            hasTree: true,
            withDrpSettings: true,

            nameForArchived: 'Omit',
            defaultSelectedFilter: 'All',
            withCustomSettings: true,
            showCommentsInListNav: true,

            showShareInListNav: true,

            showShareInListNavExposed: true,
            nameForList: 'Scene',

            maxFreeItemsCount: 10,
            quotaType: 'breakdowns'
        },

        KeyboardServiceParams = null,

        PopupOperations = {
            updateStrip: {
                type: 'Edit',
                template: popupTemplate,
                size: 'medium',
                transp: ' ',
                backdrop: 'static'
            }
        };

    return {
        Settings: Settings,
        Options: Options,
        Filters: {
            Filters: Filters
        },
        ViewProp: 'breakdownView',

        CompOptions: CompOptions,
        KeyboardServiceParams: KeyboardServiceParams,

        PopupOperations: PopupOperations
    };
}

SBApiGridColumns['breakdown'] = function (PropTypes){
    return {
        "1": {
            id: "1",
            name: 'Scene #',
            placeholder: '#',
            prop: 'scene',
            order: 1,
            wrapperClass: 'colored-col side-borders border-top border-bottom',
            fieldClass: 'scene-number text-center',
            colCls: 'stripList scene-col onbreakdowns scene text-center cant-shrink ',
            canSort: true,
            sortField:'scriptPosition',
            canHide: false,
            canEdit: false,
            canChangeOnEdit: true,
            type: PropTypes.Scene,
            showMobile: true
        },
        "2": {
            id: "2",
            name: 'Synopsis',
            placeholder: 'Add Synopsis…',
            prop: 'note',
            order: 2,
            type: PropTypes.Html,
            fieldClass: 'gray note',
            colCls: 'stripList title-cell text-center ',
            canHide: true,
            canEdit: false,
            canChangeOnEdit: true,
            isListSubtitle: true,
            withBottomToolbar: true
        },

        "3": {
            id: "3",
            name: 'Scene Setting',
            placeholder: 'Desc',
            prop: 'miniTitle',
            order: 2,
            fieldClass: 'title gray uppercase ',
            colCls: 'stripList title-cell text-left ' ,
            canHide: false,
            canEdit: false,
            canChangeOnEdit: true,
            canSort: true,
            type: PropTypes.Field,
            grow: true,
            notInFilter: true,
            showMobile: true,
            isMobileTitle: true,
            isListTitle: true
        },


        "7.05": {
            id: "7.05",
            order: 2.1,
            name: 'Script Day',
            placeholder: '#',
            prop: 'storyDay',
            fieldClass: 'text-center stripList',
            colCls: 'stripList elements-col text-center',
            canHide: true,
            canSort: false,
            canEdit: false,
            canChangeOnEdit: true,
            type: PropTypes.Field,
            triggerEditOnCol: true
        },
        "5": {
            id: "5",
            order: 3,
            name: 'Cast ID',
            prop: 'characterIds',
            fieldClass: 'text-center stripList chars',
            colCls: 'stripList char-col text-center one-line-tooltip',
            canHide: true,
            canEdit: true,
            type: PropTypes.Characters,
            triggerEditOnCol: true,
            parentContainer: true,
            initListName: 'characters'
        },

        "6": {
            id: "6",
            order: 4,
            name: 'Shoot Location',
            prop: 'locationIds',
            fieldClass: 'stripList locs withoutunderline',
            colCls: 'loc-col',
            canHide: true,
            canEdit: true,
            type: PropTypes.Locations,
            triggerEditOnCol: true,
            parentContainer: true,
            canSort: true,
            initListName: 'locations',
            wrapperClass: 'full-width',
            icon: 'pin'
        },

        "7": {
            id: "7",
            order: 5,
            name: 'Pages',
            shortName: 'Page Count',
            placeholder: '#',
            prop: 'pagesDisplay',
            fieldClass: 'text-center stripList',
            colCls: 'stripList page-col text-center',
            canHide: true,
            canSort: true,
            canEdit: false,
            canChangeOnEdit: true,
            type: PropTypes.Pages,
            triggerEditOnCol: true,
            parentContainer: true,
            wrapperClass:'centered',
            resetProp: 'pages'
        }
    };
}

angular.module('product.breakdown', [
    'product.breakdownPage.component'
])
.config(BreakdownRouting);
BreakdownRouting.$inject = ['$uiRouterProvider'];
function BreakdownRouting($uiRouter) {
    var other = {
        bodyClass: 'with-sidebar-comments breakdowns settings',
        title: 'Breakdown'
    };

    var path = 'breakdown',
        overviewBlockType = path + 's',
        listField = 'scene',
        params = {},
        pageComponent = path + 'Page';

    if (listField) {
        params[listField] = {
            value: null,
            dynamic: true
        };
    }

    addStates($uiRouter, [{
        name: 'user.product.' + path,
        url: '/' + path + (listField ? ('/:' + listField) : '') +
            '?' + getExtraRouteParams(),
        data: {
            bodyClass: other.bodyClass,
            title: other.title,
            withDocumentUnload: true,
            overviewBlockType: overviewBlockType,
            hasScript: true,
            showVersions: true,
            listField: listField
        },
        views: {
            bodyWrapper: pageComponent
        },
        params: params,
        reloadOnSearch: false
    }]);
}

angular.module('product.breakdownPage.component', [
    'product.breakdown.page.controller.service'
])
.component('breakdownPage', {
    controller: 'BreakdownPageCtrl'
})
.controller('BreakdownPageCtrl', BreakdownPageCtrl);
BreakdownPageCtrl.$inject = ['BreakdownPageCtrlService', '$element'];
function BreakdownPageCtrl(BreakdownPageCtrlService, $element) {
    console.log('BreakdownPageCtrl');
    var $ctrl = this;
    $ctrl = new BreakdownPageCtrlService($ctrl, $element);
}

angular.module('product.breakdown.page.controller.service', [

    'product.breakdown.sceneTagging.component',
    'product.breakdown.taggingSelector.component',
    'product.breakdown.element.new.component',
    'product.breakdown.sceneNotes.edit.controller',
    'product.breakdown.sceneElements.component',
    'product.breakdown.sceneElements.popup.component',

    'product.breakdown.sideBar.component',
    'group.sbPopover.events.service',
    'product.breakdowns.item.events.service',
    'apiConstants.breakdown.services',
    'product.breakdowns.group.init.component.service',
    'product.breakdown.stripSearch.service',
    'profile.page.init.controller.service',
    'page.profile.init.controller.service.injector',
])
.constant('BreakdownPageCtrlServiceInjectors', {
    pageCtrlService: 'ProfilePageInitCtrlService',
    constantsService: 'BreakdownConstantsService',
    service: 'StripsService',
    groupSearchDrpCtrlService: 'SearchStripsCtrlService',
    groupCtrlService: 'BreakdownsGroupInitCtrlService',
    TaggingScenesService: 'TaggingScenesService'
})

.service('BreakdownPageCtrlService', BreakdownPageCtrlService);

BreakdownPageCtrlService.$inject = ['PageProfileInitCtrlServiceInjector', 'BreakdownPageCtrlServiceInjectors'];
function BreakdownPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    return function ($ctrl, $element, printPageParams) {

        $ctrl.quotaType = 'stripboard';
        $ctrl.groupTable = 'strips';
        $ctrl.ALL_NAME = 'Strips'; //$ctrl.allStrips = $ctrl[$ctrl.ALL_ITEMS]
        $ctrl.profileFieldId = 'scene';
        $ctrl.sidebarClass = 'mini-strips breakdownWrapper';

        $ctrl.isScript = true;
        $ctrl.count = 0;

        $ctrl.goToParentPage = $ctrl.goToBreakdowns;
        $ctrl.goToBreakdownsArchive = goToBreakdownsArchive;

        $ctrl.beforeReloadProfileWrapper = beforeReloadProfileWrapper;
        $ctrl.additionalScriptInitOther = additionalScriptInitOther;
        $ctrl.preInitProfile = preInitProfile;
        $ctrl.onPreloadSettingsOther = onPreloadSettingsOther;

        $ctrl.getBanner = getBanner;
        $ctrl.getTopFilters = getTopFilters;
        $ctrl.getSidebarContent = getSidebarContent;
        $ctrl.getProfileContent = getProfileContent;

        $ctrl.onDestroyProfile = onDestroyProfile;
        $ctrl.getGroupSearchPermissions = getGroupSearchPermissions;

        $ctrl.loadItems = loadItems;
        $ctrl.preloadSettings = preloadSettings;
        $ctrl.getCollabBannerInfo = getCollabBannerInfo;

        $ctrl.getSidebarTag = getSidebarTag;
        $ctrl.closeBanner = closeBanner;

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);

        function getCollabBannerInfo(){
            return {txt: 'Create and share your own script breakdowns for free.', campaign:'collab-breakdowns'};
        }

        function preloadSettings() {
            $ctrl.Settings = _.extend({}, $ctrl.Settings, $ctrl.scriptLoadingService.preloadSettings());
        }

        function loadItems() {
            var quotaType = 'stripboard';
            $ctrl[$ctrl.ALL_ITEMS] = $ctrl.scriptLoadingService.getProcessedStripsTables({
                type: 1
            }, $ctrl.groupOrder ? $ctrl.groupOrder : 'order', false, $ctrl.CPS.hasQuotaType(quotaType))[$ctrl.groupTable];
        }

        function getGroupSearchPermissions(){
            return $ctrl.CPS.isAuthenticated || !$ctrl.CPS.isAuthenticated && $ctrl.CPS.isCollaborator && !$ctrl.RouteCollaboratorsService.collabRootId;
        }

        function additionalScriptInitOther(){
            $ctrl.initScenePopupEvents();
        }

        function preInitProfile() {
            $ctrl.groupOrder = 'scriptPosition';
            $ctrl.tagSelectorPopover = 'sb-popover';
            $ctrl.withTagging = true;
            $ctrl.loadTags = true;
            $ctrl.isBreakdown = true;

            $ctrl.StripTypes = {Scene: 1, DayBreak: 0, Banner: 2};

            $ctrl.remove = remove;
            $ctrl.openNewElement = openNewElement;
            $ctrl.openEditElement = openEditElement;
            $ctrl.onSceneChange = onSceneChange;

            $ctrl.goToShotsList = goToShotsList;
            $ctrl.goToBreakdowns = goToBreakdowns;
            $ctrl.updateSceneNotes = updateSceneNotes;
        }

        function onPreloadSettingsOther(result, withTagReload) {
            var changes = $ctrl.getUpdatedChanges ? $ctrl.getUpdatedChanges(result, $ctrl.Settings) : result.editchanges;
            if (changes) {
                $ctrl.item = $ctrl.scriptLoadingService.getExtendedStrip($ctrl.item, _.find($ctrl[$ctrl.ALL_ITEMS], function (el) {
                    return el._id === $ctrl[$ctrl.profileFieldId];
                }), $ctrl.isScheduling, null);

                $ctrl.count = $ctrl.getTaggingScenes($ctrl[$ctrl.profileFieldId]);

                if(withTagReload) {
                    $ctrl.broadcastRoot('HIGHLIGHT_TAGS_' + $ctrl.item._id, true);
                }

                return $ctrl.preLoadingService.processCachedElementInit(changes, $ctrl.preLoadingService.Ops.Edit, null, $ctrl.preLoadingService.TblTypes[$ctrl.ALL_NAME], false);
            }
        }

        function onSceneChange(result) {
            $ctrl.reloadProfileWrapper(result.selected.val);
        }

        function beforeReloadProfileWrapper(id) {
            $ctrl.count = $ctrl.getTaggingScenes(id);

            if ($ctrl.item) {
                $ctrl.popupTitle = 'Scene ' + ($ctrl.item.scene ? $ctrl.item.scene : $ctrl.item.scriptPosition) + ' of ' + $ctrl.item.count;
                $ctrl.stripId = $ctrl.item._id;

                $ctrl.broadcastRoot('START_INTRO');
            }
        }

        function onDestroyProfile() {
            if($ctrl.templateCompileNewElement){
                $ctrl.templateCompileNewElement.destroyNewScope();
            }

            removeCompileTag();
        }

        function goToShotsList(strip) {
            if(strip) {
                $ctrl.onShotsList({scene: strip._id});
            }
        }

        function goToBreakdowns(active) {
            if(active) {
                $ctrl.onBreakdowns({active: active});
            }
        }

        function updateSceneNotes(item) {
           // console.log('updateSceneNotes');
            if (item) {
                $ctrl.scriptLoadingService.modify($ctrl.scriptLoadingService.TblTypes.Strips, {
                    _id: item._id,
                    breakdownNotes: item.breakdownNotes
                }, $ctrl.scriptLoadingService.Ops.Edit);
            }
        }

        function getNew() {
            return {
                stripId: $ctrl[$ctrl.profileFieldId],
                count: 1,
                name: null,
                position: null,
                allScenes: false, // tag all mentions is disabled by default
                isNew: true
            };
        }

        function remove(item, allScenes) {
            if (allScenes) {
                item.allScenes = true;
            }
            $ctrl.TaggingScenesService.delete(item, function (result) {
                result.type = 'Remove';
                result.stripId = item.stripId;
                var updates = $ctrl.onProcessSceneElement(result);
                $ctrl.item = updates.strip;
                $ctrl.count = result.countUpdated;
            }, function (error) {
                console.log(error);
                $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.taggingScenes.Remove'+(allScenes ? 'All' : '')+'.error', 'error', {
                    name: item ? item.name : null
                });
            });
        }

        function openNewElement(e, c) {
            var directivePlaceholder = 'sidebarNewElement',
                eventName = $ctrl.LCS.clickEvent + '.' + directivePlaceholder,
                id = c ? c._id : null,
                parentId = '#newElement' + id;

            var aTarget = e.currentTarget,
                aParent = aTarget.parentElement;
            createTaggingSelector(eventName, onNearbyClick);

            function clearTaggingSelector(eventName, onNearbyClick) {
                method(false, onNearbyClick);
                var pl = angular.element('.' + directivePlaceholder);
                if (pl.length > 0) {//remove
                    pl.remove();
                }

                $ctrl.LCS.removeClass(aParent, 'sb-hide');
            }

            function getNewItemTemplate() {
                return '<element-new ' +
                    'insert-after="true" ' +
                    'class="full-width ' + directivePlaceholder + '" ' +
                    'elem-class="form-control with-underline font-small" ' +
                    'btn-text="Save" ' +
                    'row-class="thinner" ' +
                    'with-name-focus="true" ' +
                    'category-id="::$ctrl.categoryId" ' +
                    'item="$ctrl.sceneElement" ' +
                    'script-loading-service="$ctrl.scriptLoadingService" ' +
                    'on-popup-closed="$ctrl.onPopupClosed()"' +
                    '></element-new>';
            }

            function createTaggingSelector(eventName, onNearbyClick) {

                if(!$ctrl.templateCompileNewElement){
                    $ctrl.templateCompileNewElement = new $ctrl.TemplateCompileService(null, getNewItemTemplate);
                }

                $ctrl.templateCompileNewElement.loadTemplate(onTemplateLoaded, {
                    sceneElement: getNew(),
                    categoryId: id,
                    scriptLoadingService: $ctrl.scriptLoadingService,
                    onPopupClosed: onPopupClosed,
                }, angular.element(parentId));


                function onTemplateLoaded() {
                    $ctrl.LCS.addClass(aParent, 'sb-hide');
                }

                if (eventName) {
                    clearTaggingSelector(eventName, onNearbyClick);
                    method(true, onNearbyClick);
                }

                function onPopupClosed() {
                    console.log('clear new element');
                    clearTaggingSelector(eventName, onNearbyClick);
                }
            }

            function method(isBind, onNearbyClick) {
                if (eventName) {
                    $ctrl.LCS.bindElementsClick(isBind, $ctrl.LCS.bodyElement, onNearbyClick, null, eventName);
                }
            }

            function onNearbyClick(event) {
                console.log('element new nearby click');
                if (!$ctrl.LCS.findClosestParent(event.target, parentId) || !document.querySelector(parentId)) {
                    clearTaggingSelector(eventName, onNearbyClick);
                }
            }
        }

        function openEditElement(e, sceneElement) {
            if(!$ctrl.categoriesTable){
                $ctrl.categoriesTable = document.querySelector('.categories-table');
            }
            var id = 'taggingSelector' +( sceneElement ? sceneElement._id : new ObjectId().toString()),
                target = e.currentTarget,
                anchorElement = sceneElement ? $ctrl.categoriesTable.querySelector('.inline-tree-item[data-id="'+sceneElement._id+'"]'):
                        $ctrl.LCS.findClosestParent(target, '.with-tagging-selector'),
                otherAttrs = sceneElement ? "" : "with-auto-focus='false' show-cancel='true' big-btns='true'",
                withDots = sceneElement ? anchorElement.querySelector('.with-dots') : target;

            var clearTaggingSelector = function clearTaggingSelector(closedata) {
                console.log('clearTaggingSelector: ' + id);

                $ctrl.LCS.removeClass(withDots,'active');
                //aParent.remove(tag).end();
                //tag.remove();

                $ctrl.count = $ctrl.getTaggingScenes($ctrl[$ctrl.profileFieldId]);

                return false;
            };

            createTaggingSelectorForEdit(null,sceneElement ? sceneElement : getNew(), id, clearTaggingSelector, otherAttrs);

            function createTaggingSelectorForEdit(range, sceneElement, id, clearTaggingSelector, otherAttrs) {
                if (!$ctrl.templatePopover) {
                    $ctrl.templatePopover = new $ctrl.TemplateCompileService(null);
                }
                var popoverID =  'popover' + new ObjectId().toString();

                $ctrl.templatePopover.loadTemplate(function (clonedElement) {
                    console.log('uploader loaded');
                    $ctrl.LCS.addClass(withDots, 'active');
                }, getCtrl(), angular.element(anchorElement), getTemplate());


                function onPopupClosed(closedata) {
                    // aParent.remove($('#'+tagId)).end();
                    console.log('onPopupClosed');
                    onCloseDrp();
                    clearTaggingSelector(closedata);
                }

                function getCtrl() {
                    return _.extend( getGenerateContentMethod(), {
                        anchorElement: anchorElement,
                        onCloseDrp: onCloseDrp,
                    });
                }

                function onCloseDrp(){
                    console.log('onpopover closed');
                    if(popoverID){
                        removeCompileTag();
                        $ctrl.LCS.removeElement(document.getElementById(popoverID));
                        popoverID = null;
                    }
                }

                function getTemplate() {
                    return '<'+$ctrl.tagSelectorPopover+ ' '+
                        'id="'+popoverID+'" ' +
                        'parent-container=".side-nav.static .outtercontainer>.innercontainer .breakdown-sidebar" ' +
                        //'parent-container="true" ' +
                        'dont-close-popover-on-click="true" '  +
                        'anchor-element="::$ctrl.anchorElement" ' +
                        'on-close-drp="$ctrl.onCloseDrp()" ' +
                        'on-open-drp="$ctrl.onOpenDrp()" ' +
                        'generate-content="$ctrl.generateContent(drpMenuId)" ' + //is added to the ctrl scope
                        '></'+$ctrl.tagSelectorPopover+'>';
                }

                function getCtrl1() {
                    return {
                        scriptLoadingService: $ctrl.scriptLoadingService,
                        sceneElement: sceneElement ,
                        range: range,
                        onPopupClosed: onPopupClosed,
                    }
                }

                function getTemplate1(drpMenuId) {
                    var taggingClass = 'tagging-selector';
                    return "<" + taggingClass + " " +
                        'parent-container=".side-nav.static .outtercontainer>.innercontainer .breakdown-sidebar" ' +
                        "id='" + drpMenuId + "' " +
                        "popup-anchor='#" + id + "' " +
                        "script-loading-service='::$ctrl.scriptLoadingService' " +
                        "range='::$ctrl.range' " +
                        "scene-element='::$ctrl.sceneElement' " +
                        "on-popup-closed='$ctrl.onPopupClosed()' " +
                        "class='sceneTaggingSelector " + taggingClass + " sb-dropdown-menu parent-dropdown-menu clearfix' " +
                        otherAttrs +
                        "></" + taggingClass + ">";
                }

                function getGenerateContentMethod() {
                    return {
                        generateContent: function (drpMenuId) {
                            return {
                                $ctrl: getCtrl1(),
                                template: getTemplate1(drpMenuId)
                            };
                        }
                    }
                }
            }
        }

        function removeCompileTag() {
            if($ctrl.templatePopover){
                $ctrl.templatePopover.destroyNewScope();
            }
        }

        function getBanner() {
            $ctrl.CPS.withBanner = $ctrl.CPS.setPageBanner($ctrl.CPS.withBanner,
                $ctrl.showBannerProp, $ctrl.bannerFeatureProp);
            if(!$ctrl.CPS.withBanner){return '';}

            var el;

            if($ctrl.CPS.isCollaborator && $ctrl.LCS.collabBannerInside) {
                var txt = 'breakdowns';
                el = '<div class="alert alert-warning alert-stylish '+txt+' table-div full-width">' +
                        '<div class="centered grow-column">' +
                            $ctrl.LCS.getISBDiv(txt, 3, 'icon sbf24 pull-left') +
                            ' <span class="text">Create your own script '+txt+' now.</span>' +
                        '</div>' +
                        '<div class="centered col160">' +
                            '<a href="'+$ctrl.CPS.websiteUrl+'/register?utm_campaign=collab-breakdowns" target="_blank" class="btn btn-primary pull-right">Get Started Free</a>' +
                        '</div>' +
                        getCloseBtn() +
                    '</div>';function getCloseBtn(){
                    return '<div class="centered btn-col text-center col40">' +
                         '<a class="closebtn display-block ' + $ctrl.getBtnActionCls() + '" data-type="closeBanner">' + $ctrl.LCS.getISBDiv('close-bigger', 2) + '</a>' +
                        '</div>';
                }
            }
            if(!$ctrl.CPS.isCollaborator){
                el = get('This plan doesn’t support unlimited tagging. To tag more than '+ $ctrl.maxFreeItemsCount + ' elements')+
                    ($ctrl.CPS.hasQuotaType('stripboard') ? '' : get('<strong>50% of Scenes Displayed</strong> – This plan doesn’t support full screenplay display. To view all the scenes'));

                function get(message,){
                    return '<div class="alert alert-warning"><div class="spacing-quart position-relative">' + message + ' <a href="'+$ctrl.CPS.getStateHref('user.pricing', $ctrl.CPS.currentPathParams())+'">upgrade now!</a>' +
                          '<a class="closebtn close ' + $ctrl.getBtnActionCls() + '" data-type="closeBanner" style="top:7px">&times;</a>' +
                        '</div></div>';
                }
            }
            return el ? ('<div class="spacing-half-top with-no-bg hide-print centering document-version-wrapper">' + el + '</div>') : '';

        }

        function closeBanner() {
            $ctrl.CPS.closeBanner();
        }

        function getTopFilters() {
        //todo must update when changes appear for strip dayTime sceneType scene
            if(!$ctrl[$ctrl.ALL_ITEMS] || $ctrl[$ctrl.ALL_ITEMS].length === 0){
                return '';
            }
         return '<nav class="filters on-top hide-print">' +
                    '<div class="pull-left">' +
                        ($ctrl.hideSidebar ? '' : ('<a class="btn btn-small primary-faded without-text pull-left with-margin-right '+ $ctrl.getBtnActionCls() + '" data-type="toggleInnerSidebar">' + $ctrl.LCS.getISBDiv('sidebar-filled', 2) + '</a>' +
    ($ctrl.hasItems ? $ctrl.getItemSearch($ctrl[$ctrl.ALL_ITEMS]) : ''))) +
                    '</div>' +
                    '<div class="pull-right">' +
                        /*($ctrl.canEdit && $ctrl.hasItems ? ('<import-script show-title="false" btn-class="btn btn-small primary-faded without-text with-margin-left" ' +
                            ($ctrl.pageClass ? ('page-class="'+$ctrl.pageClass+'" ') : '') +
                            '></import-script>') : '') +*/
                         $ctrl.getListNavComments()+
                        //todo bring back share list
                        $ctrl.getListNavShare()+
                    '</div>'+
                '</nav>';
        }

        function getSidebarTag(){
            return 'breakdown-sidebar';
        }

        function getSidebarContent() {
            var tag = $ctrl.getSidebarTag();
            return '<' +tag+ ' class="'+tag+' display-block clearfix" ' +
                'tagging-scenes="$ctrl.taggingScenes" ' +
                'categories="::$ctrl.categories" ' +
                'count="$ctrl.count" ' +
                'on-open-new-element="$ctrl.openNewElement($event, id)" ' +
                'on-open-edit-element="$ctrl.openEditElement($event, sceneElement)" ' +
                'on-remove="$ctrl.remove(item, allScenes)" ' +
                'is-active="::$ctrl.item.active"' +
                '></'+tag+'>';
        }

        function getProfileContent() {
            console.log('getProfileContent');
            var showArrow = $ctrl.CPS.isAuthenticated ||  $ctrl.CPS.isCollaborator && $ctrl.RouteCollaboratorsService.collabRootId === undefined;

         return getArchivedBanner()+
                '<div class="topBreakdownScene document-version-wrapper centering spacing-half">' +
                    (showArrow ? getLeftArrow()  : '') +
                    '<div class="simple-group table-cell stripboard document-version-wrapper medium-template list centering scenetable" component-id="brakdownitemgroup">' + $ctrl.getProfileGroupItem() + '</div>' +
                    (showArrow ? getRightArrow() : '') +
                '</div>' +
                '<div class="breakdown-inner-container">' +
                    getSceneTagging() +
                    getSceneNotes() +
                '</div>';

            function getLeftArrow(){
                return '<div class="side-arrow hide-print one-line-tooltip" ' +
                    'style="cursor:'+($ctrl.item.prevStripId?'hand':'pointer')+'">' +
                    '<a class="left table-div" ' +
                    ($ctrl.item.prevStripId? ('href="' + $ctrl.getItemHref($ctrl.item.prevStripId, true) + '"') : 'disabled="disabled" ') +
                    ' tooltip="Previous Scene" tooltip-placement="right"><div class="text-center centered">'+$ctrl.LCS.getISBDiv('arrow-left-big')+'</div></a>' +
                    '</div>';
            }

            function getRightArrow(){
                return '<div class="side-arrow text-right hide-print one-line-tooltip" ' +
                    'style="cursor:'+($ctrl.item.nextStripId?'hand':'pointer')+'">' +
                    '<a class="right table-div"' +
                    ($ctrl.item.nextStripId? ('href="' + $ctrl.getItemHref($ctrl.item.nextStripId, true) + '"') : 'disabled="disabled" ') +
                    ' tooltip="Next Scene" tooltip-placement="left"><div class="text-center centered">'+$ctrl.LCS.getISBDiv('arrow-right-big')+'</div></a>' +
                    '</div>'
            }
            function getSceneTagging(){
                return  '<scene-tagging class="scene-tagging spacing-double centering with-min-height document-version-wrapper display-block clearfix" ' +
                    'style="background-color:white" ' +
                    'item="::$ctrl.item" ' +
                    'script-loading-service="::$ctrl.scriptLoadingService" ' +
                    'with-tagging="::$ctrl.withTagging&&$ctrl.item.active" ' +
                    'load-tags="::$ctrl.loadTags" ' +

                    "tagging-scenes='::null' " +
                    "categories='::null' " +
                    "elements='::null' " +

                    "max-font-size='::$ctrl.maxFontSize' " +
                    "min-font-size='::$ctrl.minFontSize' " +
                    "doc-wrapper-class='::$ctrl.docWrapperClass' " +
                    "side-margin='true'" +
                    '></scene-tagging>';
            }

            function getSceneNotes(){
                return '<scene-notes ' +
                    'class="scene-notes margin-half centering document-version-wrapper display-block clearfix" ' +
                    'item="::$ctrl.item" ' +
                    'can-comment="::$ctrl.canComment&&$ctrl.item.active" ' +
                    'on-scene-notes-update="$ctrl.updateSceneNotes(item)"' +
                    '></scene-notes>';
            }

            function getArchivedBanner() {
                if($ctrl.item.active !== false){return '';}
                return '<div class="spacing-half-top with-no-bg hide-print centering document-version-wrapper">' +
                    '<div class="alert alert-warning">' +
                    '<div class="spacing-quart position-relative">' +
                    '<div class="table-div full-width">' +
                    '<div class="centered">This scene has been omitted. Its elements will not be displayed in Reports unless the scene is restored.</div>' +
                    '<div class="centered col100 with-padding-left"><a class="btn btn-small orange '+$ctrl.getBtnActionCls()+'" data-type="goToBreakdownsArchive">Go to Omitted Scenes</a></div>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>';
            }
        }

    }

    function goToBreakdownsArchive(){
        $ctrl.goToBreakdowns(false);
    }
}

angular.module('product.breakdown.taggingSelector.component', [
    'product.breakdown.taggingSelector.controller.service'
])
.component('taggingSelector', {
    bindings: {
        scriptLoadingService: '<',
        sceneElement: '<',
        range: '<?',
        dontBindClick: '<?',
        btnText: '<?',
        withoutClear: '<?',
        showCancel: '<?',
        withCategoriesFocus: '<?',
        popupAnchor:'@',
        onPopupClosed: '&'
    },
    controller:'TaggingSelectorCtrl'
})
.controller('TaggingSelectorCtrl', TaggingSelectorCtrl);

TaggingSelectorCtrl.$inject = ['TaggingSelectorCtrlService', 'TaggingScenesService', '$element'];

function TaggingSelectorCtrl(TaggingSelectorCtrlService, TaggingScenesService, $element) {

    var $ctrl = this;

    $ctrl.objectType = 'taggingElement';
    $ctrl.errormessage = 'Please enter a valid name so we can assign element to scene';

    $ctrl.onSearch = onSearch;
    $ctrl.getNewSceneTemplateOther = getNewSceneTemplateOther;
    $ctrl.onNewSceneTemplateLoaded = onNewSceneTemplateLoaded;
    $ctrl.getListItems = getListItems;
    $ctrl.getInitCategories = getInitCategories;
    $ctrl.onDestroyOther = onDestroyOther;
    $ctrl.onAutocompleteChange = onAutocompleteChange;
    $ctrl.preventDefault = preventDefault;

    $ctrl = new TaggingSelectorCtrlService($ctrl, $element, TaggingScenesService);

    function getListItems(){
        return $ctrl.scriptLoadingService.getObjectService($ctrl.scriptLoadingService.TblTypes.TaggingElements);
    }

    function onAutocompleteChange() {
        console.log('tagging selector : onAutocompleteChange');
        var el = checkCategory();
        //todo update category position in list to become first
        if(el){
            var p = $ctrl.categoriesEl.querySelector('.listitems-selector');
            p.insertBefore(el, p.firstChild);
        }
    }

    function getInitCategories(){
        $ctrl.isInit = true;

        if($ctrl.withoutCategories){return [];}

        var stripLocationCategoryId = "5a69235fdf0fbc89a637c1c1";
        var categories = _.filter($ctrl.scriptLoadingService.getTaggingCategories(function (item) {
            return item._id !== stripLocationCategoryId;
        }));

        var list = [];
        _.each(categories, function (cat) {
            var id = cat._id,
                c = {
                    name: cat.name,
                    order: cat.order,
                    color: cat.color,
                    _id: id
                };
            if ($ctrl.type === 'Edit' && $ctrl.categoryId === id) {
                list.unshift(c);
            } else {
                list.push(c);
            }
        });

        return list;
    }

    function onNewSceneTemplateLoaded() {
        $ctrl.categoriesEmpty =$ctrl.element.querySelector('.empty-categories');
        bindCategories(true);

        checkCategory();//set selected category

        if($ctrl.withCategoriesFocus){
            $ctrl.LCS.timeout(function () {
                if($ctrl.searchInput){$ctrl.searchInput.focus();}
            }, 0);
        }
    }

    function onSearch(search){
        console.log('onSearch');
        processList(search);
    }
    function getNewSceneTemplateOther(){
        if($ctrl.withoutCategories){return '';}
var tag = 'btn-search';
    return '<div>' +
                '<div class="with-side-padding header-small clearfix spacing-half-top">' +
                    '<div class="pull-left">Select Category</div>' +
                    '<div class="pull-right search-inline">' +
                        '<'+tag+' class="' + tag +'" placeholder="Search…" on-search="$ctrl.onSearch(search)" is-short="true" is-a="true"></'+tag+'>' +
                    '</div>' +
                '</div>' +
        /* '<div class="pull-right search-inline position-relative">' +
                         '<div class="drpSearch side-menu dropdown-menu display-block">' +
                            '<div class="searchWrapper sb-hide" style="display: grid">' +
                                "<input id='autosearch-field' type='text' autocomplete='off' autocorrect='off' autocapitalize='off' spellcheck='false' class='short form-control search full-length "+$ctrl.searchInputCls+"' placeholder='"+$ctrl.placeholder+"'" +
                                $ctrl.LCS.getISBDiv('search', 2, 'primary') +
                                "<div class='cancel-search'><a class='"+$ctrl.btnClearSearchCls+" gray-lighter no-transition sb-hide'>" + $ctrl.LCS.getISBDiv('delete-circle', 2, 'with-primary-hover') + "</a></div>" +
                            "</div>" +
                        '</div>' +
                        '<a id="btnSearchDrp" type="button" class="transparent btn-small dropdown-toggle" dropdown-toggle=""><div class="pull-left sbf search"> <span class="sbp p1"></span> <span class="sbp p2"></span></div></a> ' +
                    '</div>' +*/
               /* "<div class='search-wide thinner form-group last with-side-padding'>" +
                    "<input id='autosearch-field' type='text' autocomplete='off' autocorrect='off' autocapitalize='off' spellcheck='false' class='form-control with-underline "+$ctrl.searchInputCls+"' placeholder='"+$ctrl.placeholder+"'>" +
                    $ctrl.LCS.getISBDiv('search', 2) +
                    "<div class='cancel-search'><a class='"+$ctrl.btnClearSearchCls+" gray-lighter no-transition sb-hide'>" +
                    $ctrl.LCS.getISBDiv('delete-circle', 2, 'with-primary-hover') + "</a></div>" +
                "</div>" +*/
                "<div class='margin-bottom-quarter'></div>" +
                "<div class='show-scrollbar-on-hover full-width "+($ctrl.selectedClass? $ctrl.selectedClass:'')+"'>" +
                    ($ctrl.list.length >0 ? (getCategories() + getEmptySearchCategs()) : getEmptyCategs()) +
                "</div>" +
            "</div>" +
            "<div class='with-border-bottom'>&nbsp;</div>";

        function getCategories() {
            var el = '';

            _.each($ctrl.list, function (c) {
                if(c.type !== 3){
                  var color = c.color;
                  el += "<li data-id='"+c._id+"' class='with-mouse-hover'>" +
                            "<div class='table-div smaller full-width'>" +
                                "<div class='color-button smaller centered'>" +
                                    "<div " +
                                    (color ? ('style="background-color:' + color + '" '):'')+
                                    " class='with-margin-right "+(color?'':'md-color-picker-checkered-bg') +"'></div>" +
                                "</div>" +
                                "<div class='centered'>"+c.name+"</div>" +
                            "</div>" +
                        "</li>";
                }
            });

          el += "<li class='with-mouse-hover'>" +
                    "<div class='table-div smaller full-width semibold'>" +
                        "<div class='small centered' style='width:16px'>" + $ctrl.LCS.getISBDiv('plus-circled', 2, 'position-relative blue', 'style="left:-4px"') + "</div>" +
                        "<div class='centered'><a id='btnAddCategories' class='smaller-font small with-hover'>Add Category</a></div>" +
                    "</div>" +
                "</li>";

          return "<div class='"+$ctrl.categoriesElCls+" selected-projects fancy-scrollbar vertical'><ul class='listitems-selector with-checked'>" + el + "</ul></div>";
        }

        function getEmptyCategs() {
            return "<div class='no-project withpopover centering spacing-half'>" +
                        '<div class="centered circled-svg-colored small60 elements '+ ($ctrl.pageClass ? $ctrl.pageClass : '') + '">' + $ctrl.LCS.getISBDiv('elements', 4)+ '</div>' +
                        "<div class='text-center h3'>Assign Category</div>" +
                        "<p class='text-center desc'>No categories have been created.</p>" +
                    "</div>";
        }

        function getEmptySearchCategs() {
            return "<div class='no-project withpopover centering spacing-half sb-hide empty-categories'>" +
                        '<div class="centered circled-svg-colored small150 elements '+ ($ctrl.pageClass ? $ctrl.pageClass : '') + '" style=\'margin-bottom:6px\'>' + $ctrl.LCS.getISBDiv('elements', 4)+ '</div>' +
                        "<p class='text-center desc spacing-half-top'>No categories match this search.</p>" +
                    "</div>";
        }
    }

    function bindCategories(isBind) {
        bindClick(isBind);
        bindAddCategory(isBind);
        bindSearch(isBind);

        function bindClick(isBind) {
            if(!$ctrl.categoriesEl){
                $ctrl.categoriesEl = $ctrl.element.querySelector('.' + $ctrl.categoriesElCls);
            }
            if($ctrl.categoriesEl) {
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.categoriesEl.querySelectorAll('li'), selectCategory, 'tagging-select-category');
            }
        }

        function bindAddCategory(isBind) {
            if($ctrl.categoriesEl) {
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.categoriesEl.querySelector('#btnAddCategories'), goToCategories, 'tagging-add-category');
            }
        }

        function bindSearch(isBind) {
            if (isBind && !$ctrl.searchInput) {
                $ctrl.searchInput = $ctrl.element.querySelector('.' + $ctrl.searchInputCls);
            }
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.searchInput, onSearch, 'tagging-search-category', 'blur keyup paste');

            if (isBind && !$ctrl.btnClearSearch) {
                $ctrl.btnClearSearch = $ctrl.element.querySelector('.' + $ctrl.btnClearSearchCls);
            }
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnClearSearch, clearSearch, 'tagging-clear-search-category');
        }

    }

    function goToCategories(e) {
        $ctrl.preventDefault(e);
        $ctrl.popupsService.teamAccess(function () {
            $ctrl.CPS.transitionTo('user.product.elements', $ctrl.CPS.currentProductPathParams({
                withNew: 1
            }));
        });
    }

    function selectCategory(e) {
        console.log('changeCategory');
        $ctrl.preventDefault(e);
        var id = e.currentTarget.getAttribute('data-id');

        changeItemId(_.find($ctrl.list, function (item) {
            return item._id.toString() === id;
        }));

        function changeItemId(c) {
            if(c){
                $ctrl.category = c;
                $ctrl.categoryId = c._id;
                $ctrl.item.categoryId = c._id;
                checkCategory();
            }
        }
    }

    function checkCategory() {
        setCheck($ctrl.prevCategoryId, false);
        var el = setCheck($ctrl.categoryId, true);

        $ctrl.prevCategoryId = angular.copy($ctrl.categoryId);
        if ($ctrl.onCategoryChanged) {
            $ctrl.onCategoryChanged();
        }
        return el;

        function setCheck(id, isAdd) {
            var el;
            if (id) {
                el = $ctrl.categoriesEl.querySelector("li[data-id='" + id + "']");
                if (el) {
                    $ctrl.LCS[isAdd ? 'addClass' : 'removeClass'](el, 'active');
                }
            }
            return el;
        }
    }

    function onSearch1(e) {
        console.log('search');
        if (e.type === 'paste') {
            processSearch();
            return;
        }
        switch (e.which) {
            case 13: //enter
                $ctrl.preventDefault(e);
                processSearch();
                break;
            case 27: //esc
                $ctrl.preventDefault(e);
                clearSearch(e);
                break;
            default:
                processSearch();
                e.stopPropagation();
                break;
        }
    }

    function clearSearch(e) {
        console.log('clearSearch');
        $ctrl.preventDefault(e);
        $ctrl.searchInput.value = null;
        processSearch();
    }

    function processSearch() {
        var search = $ctrl.searchInput.value;
        if (search === '') {
            search = null;
        }
        if ($ctrl.search !== search) {
            $ctrl.search = search ? search.toUpperCase() : null;
        }

        if (!$ctrl.btnClearSearch) {
            $ctrl.btnClearSearch = $ctrl.element.querySelector('.' + $ctrl.btnClearSearchCls);
        }
        if ($ctrl.btnClearSearch) {
            $ctrl.LCS[$ctrl.search ? 'removeClass' : 'addClass']($ctrl.btnClearSearch, 'sb-hide');
        }

        processList($ctrl.search);
    }

    function processList(search1) {
        var count = 0;
        var search = search1 ? search1.toUpperCase() : null;
        console.log('onSearch: ' + search);

        _.filter($ctrl.list, function (item) {
            for (var i = 0; i < $ctrl.searchFields.length; i++) {
                var n = item[$ctrl.searchFields[i]];
                var show = true;
                if (n && (!search || search && n.toUpperCase().indexOf(search) !== -1)) {
                    count++;
                } else {
                    show = false;
                }
                $ctrl.LCS[show ? 'removeClass' : 'addClass']($ctrl.categoriesEl.querySelector('li[data-id="' + item._id + '"]'), 'sb-hide');
            }
        });

        $ctrl.LCS[count > 0 ? 'removeClass' : 'addClass']($ctrl.categoriesEl, 'sb-hide');
        $ctrl.LCS[count > 0 ? 'addClass' : 'removeClass']($ctrl.categoriesEmpty, 'sb-hide');

        return count;
    }

    function onDestroyOther() {
        bindCategories(false);
    }

    function preventDefault(e) {
        $ctrl.LCS.preventDefault(e);
    }
}

angular.module('product.breakdown.taggingSelector.controller.service', [
]) 
.service('TaggingSelectorCtrlService', TaggingSelectorCtrlService);

TaggingSelectorCtrlService.$inject = ['SBSelectorInitCtrlService', 'NewSceneElementInitCtrlService'];

function TaggingSelectorCtrlService(SBSelectorInitCtrlService, NewSceneElementInitCtrlService) {
    return function($ctrl, $element, taggingService){
        console.log('TaggingSelectorCtrlService');
        $ctrl.$onDestroy = $onDestroy;

        $ctrl.isInit = false;
        $ctrl.isInTaggingSelector = true;

        $ctrl.scrollableContainerSelector = '.selected-projects .listitems-selector';

        //must inherit $ctrl.scriptLoadingService
        $ctrl.searchInputCls = 'btnSearchCategs';
        $ctrl.categoriesElCls = 'categories-list';
        $ctrl.showLabels = true;
        $ctrl.bigBtns = true;
        $ctrl.elemClass = 'form-control with-border-around without-underline';
        $ctrl.withAutoSelect = true;
        $ctrl.btnClearSearchCls = 'clear-categ-search';

        $ctrl.anchorElement = '#autosearch-field';
        $ctrl.placeholder = 'Search…';

        $ctrl.getCompareItem = getCompareItem;

        $ctrl.getNewSceneTemplate = getNewSceneTemplate;

        $ctrl.onSBFieldInit = onSBFieldInit;

        $ctrl.$onInit = $onInit;

        return $ctrl;

        function $onInit() {
            $ctrl = new SBSelectorInitCtrlService($ctrl, $ctrl.getListItems(), $element);

            $ctrl.item = angular.copy($ctrl.sceneElement);

            $ctrl.withCategoriesFocus = ($ctrl.withCategoriesFocus === true || $ctrl.withCategoriesFocus === 'true') ? true : false;
            $ctrl.withNameFocus = !$ctrl.withCategoriesFocus;

            $ctrl.type = $ctrl.item.isNew ? 'Create' : 'Edit';

            if ($ctrl.type === 'Edit') {
                $ctrl.categoryId = $ctrl.item.categoryId;
                if($ctrl.categoryId) {
                    $ctrl.category = $ctrl.scriptLoadingService.getTaggingCategoryById($ctrl.categoryId);
                }
            } else {
                $ctrl.categoryId = null;
                $ctrl.category = null;
            }

            console.log('taggingSelector ' + $ctrl.type + ' popup :' + $ctrl.item.name);

            $ctrl.initList = $ctrl.getInitCategories ? $ctrl.getInitCategories() : [];

            $ctrl.initS();

            $ctrl = new NewSceneElementInitCtrlService($ctrl, $element, taggingService);
        }

        function onSBFieldInit() {
            $ctrl.$element = $element;
            $ctrl.element = $ctrl.$element[0];
            $ctrl.attrs = {};
        }

        function getNewSceneTemplate() {
            var isShots = $ctrl.element.classList.contains('tagging-shots-selector');
    return "<div class='dropdown-menu display-block " +
                (isShots ? '' : 'margin-bottom') +
                "'> " +
                "<form name='$ctrl.formHolderItem.formItem' class='auto elementnew display-block' novalidate>" +
                    $ctrl.LCS.getErrorBlock() +
                    "<div class='form-group with-side-padding spacing-half last'>" +
                        $ctrl.getElementNewFormTemplate() +
                    "</div>" +
                    (isShots ? '' : '<div class="with-border-bottom">&nbsp;</div>') +
                    ($ctrl.getNewSceneTemplateOther ? $ctrl.getNewSceneTemplateOther() : '') +
                    "<div class='form-group text-left clearfix last " + (isShots ? 'spacing-half-bottom' : 'spacing-half') + "'>" +
                        $ctrl.getElementNewButtonsTemplate() +
                    "</div>" +
                "</form>" +
            "</div>";
        }


        function getCompareItem(item) {
            return item;
        }

        function $onDestroy() {
            if($ctrl.onDestroyOther){
                $ctrl.onDestroyOther();
            }

            //todo figure out if needed now coalled twice if clicking outsied
            if($ctrl.onInitDestroy){$ctrl.onInitDestroy();}
            $ctrl.removeWatchers();
            console.log('tagging-selector $onDestroy');
            $ctrl.cancel();
        }
    }
}


