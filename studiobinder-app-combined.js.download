        type: PropTypes.Field,
        colCls: ' col140 label-col side-padding-10 col-padding-14 hide-mobile',
        eClassAttr: ' semibold',
        order: 2.1,
        canSort: true,
        canHide: true,
        showMobile: false,
        isMobileSubtitle: true
    };
    Columns["5"] = _.extend({}, Columns["5"], {
        maxCount: 1,
        colCls: 'col100 hide-default hide-ipad',
        tooltipPlacement: 'left'
    });

    Columns["7"].colCls = 'col150 label-col';
    Columns["12"].colCls = 'col150';

    Columns["3"] = _.extend({}, Columns["3"], {
        canEdit: false,
        colCls:   ' col100',
        grow: false,
        canHide: true
    });

    var Settings = {
            Columns: Columns
        },

        CompOptions = angular.copy(compOptions),

        ListParams = {
            includeFields: ['name', 'createdById', 'createdAt', 'teamIds', 'subscribedIds', 'startDate', 'dueDate', 'color', 'stats', 'active', 'description', 'todoPageId', 'todoColumnId', 'id', 'type', 'isOnlyComment', 'productId', 'completedAt', 'completedById', 'completed', 'taskBoardId'],
            searchFields: ['name', 'description'],
            orderFields: ['order'],
            //populate: 'createdById'
        },

        Options = {
            columns: ['11', '2', '2.1', '5'], //with teamIds
           //columns: ['1', '2', '2.1'],// '5'],
            view: 2
        },

        GroupSettings = {
            customButtons: true,
            colType: 'myTasks',
            gridItemClass: 'short-item-grid',
            groupItemTag: 'mytask',
            hideGridHeader: true
        },

        KeyboardServiceParams = {
            canCopy: false,
            canMove: false,
        };

    return {
        ViewProp: 'myTasksView',
        ListParams: ListParams,
        CompOptions: CompOptions,
        PropTypes: PropTypes,
        Options: Options,
        Settings: Settings,
        GroupSettings: GroupSettings,
        KeyboardServiceParams: KeyboardServiceParams
    };
}

