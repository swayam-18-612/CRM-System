angular.module('product.preLoading.locations.service', [
    'product.preLoading.resource.service',
    'apiServices.Locations'
])
 .service('LocationsLoadingService', LocationsLoadingService);

LocationsLoadingService.$inject = ['PreloadingResourceService', 'LocationsService'];
function LocationsLoadingService(PreloadingResourceService, objectService) {

    var _this = new PreloadingResourceService(objectService, {
        name: 'Locations'
    });

    _this.getLocationsForStrip = getLocationsForStrip;

    return _this;

    function getLocationsForStrip(tableParams, item) {
        if (item && item.locationIds && item.locationIds.length > 0) {
            var list = _.filter(item.locationIds.map(function (id) {
                return _this.getById(_this.getLoadTableTaskParams(tableParams), id);
            }), function (item) {
                return item !== undefined;
            });

            item.locationIds = list ? list.map(function (c) {
                return c ? c._id : null;
            }) : null;

            return list;
        }

        return null;
    }
}

