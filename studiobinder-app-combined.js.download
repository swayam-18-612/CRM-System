angular.module('product.overview.component', [
    'apiServices.ProductTypes',
    'services.sidebarConfigService',
    'product.overview.productInfo.component',
    'product.overview.productInfoBoxes.component',
    'product.overview.productOverviewTour.component',
    'apiConstants.productOverview.services',
    'product.overview.customizeOverviewBlocks.component',
    'product.overview.upgradeBanners.component'
])
.component('overviewPage', {
    controller: 'ProductOverviewCtrl',
})

.controller('ProductOverviewCtrl', ProductOverviewCtrl);
ProductOverviewCtrl.$inject = ['ProductTypesService', 'ProductOverviewBoxesService', 'SidebarConfigService', 'PageSimpleInitCtrlService', 'ProductOverviewConstantsService', '$element'];
function ProductOverviewCtrl(ProductTypesService, ProductOverviewBoxesService, SidebarConfigService, PageSimpleInitCtrlService, constantsService, $element) {
    console.log('ProductOverviewCtrl');

    var $ctrl = this;

    var isChanging = false;
    $ctrl.dontShowActivity = true;

    $ctrl.ProductTypesService = ProductTypesService;
    $ctrl.SidebarConfigService = SidebarConfigService;
    $ctrl.BlocksSetupService = SidebarConfigService.BlocksSetupService;
    $ctrl.ProductOverviewBoxesService = ProductOverviewBoxesService;

    $ctrl.getParams = getParams;
    $ctrl.changeBlocks = changeBlocks;

    $ctrl.getPageTemplate = getPageTemplate;

    $ctrl.$onInit = $onInit;

    $ctrl.showIntro = showIntro;

    $ctrl = new PageSimpleInitCtrlService($ctrl, $element,  {
        constantsService: _.extend({}, constantsService),
    });

    function showIntro(){return false;}

    function $onInit() {
        $ctrl.productType = $ctrl.CPS.product && $ctrl.CPS.product.productType ? $ctrl.CPS.product.productType : null;
        $ctrl.overviewBlockIds = _.filter($ctrl.productType ? ($ctrl.productType.overviewBlockIds ? $ctrl.productType.overviewBlockIds : []) : [], function (id) {
            return id !== null && id !== undefined;
        });
        $ctrl.stats = {};
        $ctrl.overviewBlocks = $ctrl.BlocksSetupService.getNonParentBlocks($ctrl.BlocksSetupService.overviewBlocks);
        $ctrl.overviewParentBlocks = $ctrl.BlocksSetupService.getParentBlocks($ctrl.BlocksSetupService.overviewBlocks);
        $ctrl.customOverviewBlocks = $ctrl.BlocksSetupService.customOverviewBlocks ? $ctrl.BlocksSetupService.customOverviewBlocks : {};
        $ctrl.getBanner = $ctrl.LCS.getProductOverviewBanner;
        $ctrl.setBanner = $ctrl.LCS.setProductOverviewBanner;

        $ctrl.onSimplePageInit({}, loadDashboard);
    }

    function getPageTemplate(){
return '<div class="with-fancy-scrollbar h-full show-scrollbar-on-hover">' +
            '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper position-relative">' +
                //getUpdatesBlock() +
                '<product-overview-info class="product-dashboard-info display-block clearfix" ng-style="{\'margin-top\': $ctrl.getBanner() ? \'10px\' : \'20px\'}" item="::$ctrl.CPS.product"></product-overview-info>' +
                '<customize-overview-blocks class="customize-overview-blocks" overview-blocks="::$ctrl.overviewBlocks" custom-overview-blocks="::$ctrl.customOverviewBlocks" on-change-blocks="$ctrl.changeBlocks(ids)"></customize-overview-blocks>' +
                '<product-overview-tour class="display-block clearfix sb-hide" overview-blocks="::$ctrl.overviewBlocks" custom-overview-blocks="::$ctrl.customOverviewBlocks" stats="::$ctrl.stats"></product-overview-tour>' +
                '<product-upgrade-banners class="product-upgrade-banners"></product-upgrade-banners>' +
                '<product-overview-boxes class="display-block clearfix" stats="::$ctrl.stats" overview-blocks="::$ctrl.overviewBlocks" overview-parent-blocks="::$ctrl.overviewParentBlocks" custom-overview-blocks="::$ctrl.customOverviewBlocks"></product-overview-boxes>' +
            '</div>' +
        '</div>';
    }

    function getUpdatesBlock(){
        return '<div class="spacing-quart-top tab-content with-no-bg hide-print" ng-if="$ctrl.getBanner()">' +
            '<div class="alert alert-info" style="margin-bottom: 0px">' +
            '<div style="position: relative" class="spacing-quart">' +
            '<span class="sbf pencil" style="position: relative;top:2px"></span>&nbsp;New! Take a sneak peak at our new <b>Documents</b> and <b>Media Library</b> pages. You can now write scripts, freeform docs, and manage media in StudioBinder.' +
            // '<a class="closebtn close" ng-click="$ctrl.closeBanner()" style="top:7px">&times;</a>' +
            '</div>' +
            '</div>' +
            '</div>';
    }
    function getParams() {
        return {
            productId: $ctrl.CPS.productId,
            companyId: $ctrl.CPS.companyId
        };
    }

    function changeBlocks(ids) {
        if (!isChanging) {
            isChanging = true;
            console.log('changeBlocks: ' + ids.join(', ') )
            var overviewBlockIds = [],
                toRemove = [],
                ob = $ctrl.BlocksSetupService.overviewBlocks,
                cob = $ctrl.BlocksSetupService.customOverviewBlocks;

            _.each(ids, processId);

            checkList(ob);
            checkList(cob);

            if (toRemove.length > 0) {
                overviewBlockIds = _.difference(overviewBlockIds, toRemove);
            }

            var params = {
                _id: $ctrl.productType._id,
                overviewBlockIds: overviewBlockIds
            };
            if($ctrl.dontShowActivity) {
                params.dontShowActivity = true;
            }
            $ctrl.ProductTypesService.update(params, function (result) {
                var productType = result ? result.item : {};
                $ctrl.overviewBlockIds = overviewBlockIds;
                var product = $ctrl.CurrentProduct.getProduct();
                product.productType.overviewBlockIds = productType.overviewBlockIds;
                $ctrl.CurrentProduct.setProduct(product);
                $ctrl.SidebarConfigService.emitUpdateSidebar();
                loadDashboard();
                isChanging = false;
                console.log('changesBlocks: ' +productType.overviewBlockIds.join(', ') );
            }, function (err) {
                isChanging = false;
            });

            function processId(id) {
                overviewBlockIds.push(id);
                overviewBlockIds.sort(function (a, b) {
                    var a1 = ob[a];
                    if (!a1 && cob) {
                        a1 = cob[a];
                    }
                    if (!a1) {
                        if (toRemove.indexOf(a1) === -1) {
                            toRemove.push(a1);
                        }
                        return 0;

                    }
                    var b1 = ob[b];
                    if (!b1 && cob) {
                        b1 = cob[b];
                    }
                    if (!b1) {
                        if (toRemove.indexOf(b1) === -1) {
                            toRemove.push(b1);
                        }
                        return 0;

                    }
                    var ac = a1 && a1.isCustom ? true : false,
                        bc = b1 && b1.isCustom ? true : false;
                    if (ac && !bc) {
                        return -1;
                    } else if (!ac && bc) {
                        return 1;
                    } else {
                        var ao = a1.order, bo = b1.order;
                        if (ao > bo) {
                            return 1;
                        } else if (ao < bo) {
                            return -1;
                        } else {
                            return 0;
                        }
                    }
                });
            }

            function checkList(list) {
                for (var id in list) {
                    process(id);
                }

                function process(id) {
                    //find the overview items that have a parent and check if parent was added
                    if (overviewBlockIds.indexOf(id) !== -1) {
                        var el = list[id];
                        //add unselectable parent
                        addUnselectableParent(el.parentNavId);

                        //check if there was added a parent with no selected children and remove it
                        if (toRemove.indexOf(id) === -1 && isUnsParent(el) && _.find(overviewBlockIds, function (id1) {
                            var el = list[id1];
                            return el && el.parentNavId === id;
                        }) === undefined) {
                            toRemove.push(id);
                        }
                    }
                }

                function addUnselectableParent(parentId) {
                    if (parentId) {
                        var p = list[parentId];
                        if (isUnsParent(p) && overviewBlockIds.indexOf(parentId) === -1) {
                            overviewBlockIds.push(parentId);
                        }
                    }
                }

                function isUnsParent(p) {
                    return p && p.mainNav && (!p.isSelectable&&!p.canBringBack);
                }
            }
        }
    }

    function loadDashboard(){
        console.log('onLoadDashboard');
        $ctrl.ProductOverviewBoxesService.setOverviewBlockIds($ctrl.overviewBlockIds);
        $ctrl.reloadPageTemplate(false, onPageLoaded);
    }

    function onPageLoaded() {
        if(typeof($ctrl.onPageLoadedOther) === 'function') {
            $ctrl.onPageLoadedOther();
        }

        //trigger the import in productOverviewTour
        var search = $ctrl.SBStateService.getSearchFilter('import');
        if (search === true || search === 'true') {
            $ctrl.SBStateService.setSearchFilter(null, 'import');
            $ctrl.LCS.timeout(function (){
                $ctrl.broadcastRoot('OPEN_IMPORT_SCRIPT');
            }, 0);
        }
    }

    function $onDestroy(){
        if(typeof($ctrl.onDestroyImport) === 'function') {
            $ctrl.onDestroyImport();
        }

        $ctrl.onSimplePageDestroy();
    }
}

angular.module('user.product.onboarding.popup.component', [
