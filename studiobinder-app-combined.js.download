angular.module('product.preLoading.schedulesLists.service', [
    'product.preLoading.resource.service',
    'apiServices.SchedulesLists',
    'product.preLoading.stripSchedules.service'
])
.service('SchedulesListsLoadingService', SchedulesListsLoadingService);

SchedulesListsLoadingService.$inject = ['PreloadingResourceService', 'SchedulesListsService', 'StripSchedulesLoadingService'];
function SchedulesListsLoadingService(PreloadingResourceService, objectService, childService) {

    var _this = new PreloadingResourceService(objectService, {
        name: 'SchedulesLists',
        childService: childService,
        tableParamsColsInit: ['companyId', 'productId', 'scriptId']
    });

    _this.removeManyIds = removeManyIds;
    _this.getAllForScheduleLists = getAllForScheduleLists;

    return _this;

    function removeManyIds(tableParams, removedIds) {
        if (!removedIds || removedIds.length === 0) {
            return;
        }

        _this.service.removeManyIds(tableParams, _this.tableType, removedIds);

        var objectIdsKey = _this.service.getObjectIds(tableParams, _this.tableType);
        var ids = _this[objectIdsKey];
        //todo figure put if still needed
        if(ids && ids.length > 0) {
            for (var i = ids.length - 1; i >= 0; i--) {
                var id = ids[i];
                if (_.find(removedIds, function(id1){return id1 === id;}) ) {
                    _this[objectIdsKey].splice(i, 1);
                    var obj = _this.service.getObjectById(id);//  _this[_this.service.getObjectById(_this)][id];
                    if (obj) {
                        removeG(id, obj.isFolder ? _this : _this.childService, obj.isFolder ? 'parentId' : _this.parentId);
                    }
                    remove(_this.tableType, id);
                }
            }
        }

        return removedIds.length;

        //if is group remove lists inside. if is list remove associated schedules
        function removeG(id, serviceS, parentId) {
            var q = {};
            q[obj.isFolder ? 'parentId' : parentId] = id;
            serviceS.removeMany(serviceS.getList(q));
        }
    }

    function getAllForScheduleLists(tableParams, params, next) {
        var ids = _this.getList(tableParams, function (item) {
            return item && !item.isFolder;
        }).map(function (item) {
            return item._id;
        });
        var n = ids && ids.length > 0 ? ids.length : 0;
        if (!n) {return next();}
        var p = {};
        p[_this.parentId] = {$in: ids};
        _this.childService.getObjectService().getAll(_.extend(p, params), null, null, next, next);
    }
}

