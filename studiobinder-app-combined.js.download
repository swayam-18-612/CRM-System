])

.component('calendarFilters', {
    controller: 'CalendarFiltersCtrl'
})
.controller('CalendarFiltersCtrl',CalendarFiltersCtrl);

CalendarFiltersCtrl.$inject = ['TemplateCompileCompCtrlService', 'RouteCollaboratorsService', 'TopNavCalendarService', '$element', '$scope'];
function CalendarFiltersCtrl(TemplateCompileCompCtrlService, RouteCollaboratorsService, TopNavCalendarService, $element, $scope) {
    var $ctrl = this;
    var timesearch = 500;
    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;

    $ctrl.DefaultTodoCardColor = DefaultTodoCardColor;
    $ctrl.temp = {fromDate: null, toDate: null};
    $ctrl.topNavApi = TopNavCalendarService;
    $ctrl.search = TopNavCalendarService.getSearch();

    $ctrl.isFilterEndOpen = false;
    $ctrl.isFilterStartOpen = false;

    $ctrl.checkTaskColor = checkTaskColor;
    $ctrl.clearTaskColors = clearTaskColors;

    $ctrl.checkTaskTeam = checkTaskTeam;
    $ctrl.clearTaskTeam = clearTaskTeam;

    $ctrl.checkTaskStatus = checkTaskStatus;
    $ctrl.clearTaskStatus = clearTaskStatus;

    $ctrl.checkTaskProgress = checkTaskProgress;
    $ctrl.clearTaskProgress = clearTaskProgress;

    $ctrl.checkProject = checkProject;
    $ctrl.checkTodoPage = checkTodoPage;

    $ctrl.clearSearch = clearSearch;

    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.hasCurrentState = $ctrl.SBStateService.hasCurrentState;

        (function (timer, delay) {
            $ctrl.onsearch = function (search) {
                console.log('onsearch');
                if (timer) {
                    $ctrl.LCS.cancelTimeout(timer);
                }
                timer = $ctrl.LCS.timeout(function () {
                    if (search === '') {
                        search = null;
                    }
                    TopNavCalendarService.setSearch(search);
                }, delay);
            };
        })(false, timesearch);

        setTempDate();

        initStatuses();
        initTeam();
    }

    function postInit() {
        _.each(['from', 'to'], function (prop) {
            $ctrl.addToObservable($scope, '$ctrl.topNavApi.' + prop + 'Date', function (newVal, oldVal) {
                setDate(prop + 'Date', newVal, oldVal); //fromDate
            });
            $ctrl.addToObservable($scope, '$ctrl.temp.' + prop + 'Date', updateFromToDate, true);
        });
    }

    function setDate(prop, newVal, oldVal) {
        if ((!$ctrl.temp || $ctrl.temp[prop] !== newVal)) {
            $ctrl.temp[prop] = newVal;
            setTempDate();
        }
    }

    function initStatuses() {
        TopNavCalendarService.setInitStatuses($ctrl.CPS.companyId, $ctrl.CPS.productId);
    }

    function initTeam() {
        var team = $ctrl.RouteCollaboratorsService.getProjectTeam($ctrl.CPS.product);
        if (team) {
            TopNavCalendarService.setInitTeam(team);
        }
    }

    function updateFromToDate(newVal, oldVal) {
        if ($ctrl.temp) {
            var from = $ctrl.temp.fromDate, to = $ctrl.temp.toDate;
            if (from && to && from < to) {
                $ctrl.topNavApi.setFromToDate(getMomentDate(from), getMomentDate(to));
            }
        }
    }

    function getMomentDate(date) {
        var mom = $ctrl.MomentService.getUtcMomentStartDay();
        return mom.date(date.getDate()).month(date.getMonth()).year(date.getFullYear());
    }

    function checkTaskColor(e, id) {
        $ctrl.preventDefault(e);
        TopNavCalendarService.checkTaskColor(id);
    }

    function clearTaskColors(e) {
        $ctrl.preventDefault(e);
        TopNavCalendarService.clearTaskColors();
    }

    function checkTaskTeam(e, id) {
        $ctrl.preventDefault(e);
        TopNavCalendarService.checkTaskTeam(id);
    }

    function clearTaskTeam(e) {
        $ctrl.preventDefault(e);
        TopNavCalendarService.clearTaskTeam();
    }

    function checkTaskStatus(e, id) {
        $ctrl.preventDefault(e);
        TopNavCalendarService.checkTaskStatus(id);
    }

    function clearTaskStatus(e) {
        $ctrl.preventDefault(e);
        TopNavCalendarService.clearTaskStatus();
    }

    function checkTaskProgress(e, id) {
        $ctrl.preventDefault(e);
        TopNavCalendarService.checkTaskProgress(id);
    }

    function checkProject(e, id) {
        $ctrl.preventDefault(e);
        TopNavCalendarService.checkProject(id);
    }

    function checkTodoPage(e, id) {
        $ctrl.preventDefault(e);
        TopNavCalendarService.checkTodoPage(id);
    }

    function clearTaskProgress(e) {
        $ctrl.preventDefault(e);
        TopNavCalendarService.clearTaskProgress();
    }

    function clearSearch(e) {
        $ctrl.preventDefault(e);
        $ctrl.search = null;
        TopNavCalendarService.setSearch(null);
    }

    function setTempDate() { //temp.fromDate & temp.toDate are of type Date while topNavApi.fromDate and topNavApi.toDate are of type Moment
        if ($ctrl.topNavApi.fromDate && $ctrl.topNavApi.toDate) {
            $ctrl.temp.fromDate = getDate($ctrl.topNavApi.fromDate);
            $ctrl.temp.toDate = getDate($ctrl.topNavApi.toDate);
        }
    }

    function getDate(date) {
        return date ? new Date(date.year(), date.month(), date.date(), 0, 0, 0, 0) : null;
    }

    function getItemTemplate() {
return '<div class="tasksFilter" style="padding-bottom:100px;">' +
           getSearchFilter() +
           // getFilterByActive() +
            //todo bring back filter by date
            // getFilterByDate() +
           getFilterByStatus() +
           getFilterByTeam() +
           getFilterByColor() +
           getFilterByProgress() +
           clearFilters() +
        '</div>';

        function getSearchFilter() {
     return '<div class="search-field-width with-border-bottom">' +
                '<input autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" ng-class="{\'full-length\':$ctrl.topNavApi.filter.name}" class="form-control without-underline search" type="text" placeholder="Search by event name…" ng-keyup="$ctrl.onsearch($ctrl.search)" ng-model="$ctrl.search">' +
                 $ctrl.LCS.getISBDiv('search', 2)+
                '<a class="clear-search gray-lighter ng-hide" ng-click="$ctrl.clearSearch($event)" ng-show="$ctrl.topNavApi.filter.name">' +
                    $ctrl.LCS.getISBDiv('delete-circle')+
                '</a>' +
            '</div>';
        }

        function getFilterByDate() {
            return '<div class="dropdown-menu no-menu">' +
                '<div class="table-div">' +
                    '<div class="calendar-drp on-left">' +
                        $ctrl.LCS.getISBDiv('calendar', 2)+
                        '<input validate-lowers="{{$ctrl.temp.toDate}}" class="elemdate dueDate date_picker form-control without-underline" id="filterStartDate" name="filterStartDate" type="text" close-text="Close" show-weeks="false" show-button-bar="false" ng-model="$ctrl.temp.fromDate" ng-click="$ctrl.isFilterStartOpen=!$ctrl.isFilterStartOpen" is-open="$ctrl.isFilterStartOpen" datepicker-popup="MMM d, yyyy"/>' +
                    '</div>' +
                    '<div class="or text-center centered col20 line-height36">-</div>' +
                    '<div class="calendar calendar-drp on-right">' +
                        '<input validate-greaters="{{$ctrl.temp.fromDate}}" class="elemdate dueDate date_picker form-control without-underline" id="filterDueDate" name="filterDueDate" type="text" close-text="Close" show-weeks="false" show-button-bar="false" ng-model="$ctrl.temp.toDate" ng-click="$ctrl.isFilterEndOpen=!$ctrl.isFilterEndOpen" is-open="$ctrl.isFilterEndOpen" datepicker-popup="MMM d, yyyy"/>' +
                    '</div>' +
                '</div>' +
            '</div>';
        }

        function getFilterByStatus() {
            //if($ctrl.hasCurrentState('user.')){return '';}
            return '<div class="dropdown-menu no-menu">' +
                '<div class="header-small">Filter Events by Status</div>' +
                '<div class="selected-items-dropdown" >' +
                    '<div class="selected-projects padding-left-0 padding-right-0 margin-right-0" style="min-height: initial">' +
                        '<ul class="listitems-selector with-checked">' +
                            '<li ng-repeat="item in $ctrl.topNavApi.initStatuses  | orderBy: \'order\' track by item._id" ng-click="$ctrl.checkTaskStatus($event, item._id)" class="with-mouse-hover table-div" ng-class="{\'active\':$ctrl.topNavApi.isTaskStatus(item._id)}" >' +
                                '<div class="col20 with-padding-left"><div class="circle-container-10" ng-style="{\'background-color\': item.color}"></div></div>' +
                                '<div class="name text-left with-padding-left text-left" ng-bind="item.name"></div>' +
                                '<div></div>' +
                            '</li>' +
                        '</ul>' +
                    '</div>' +
                '</div>' +
               // '<div ng-if="$ctrl.topNavApi.hasTaskStatuses()" class="clearfix clear-filter"><a ng-click="$ctrl.clearTaskStatuses($event)">'+ $ctrl.LCS.getISBDiv('delete', 2)+' Clear Status Filter</a></div>' +
            '</div>';
        }

        function getFilterByTeam() {
    return '<div ng-if="$ctrl.topNavApi.getTeam().length>0" class="dropdown-menu no-menu team-popup">' +
                '<div class="header-small">Filter Events by Teammates</div>' +
                '<div class="selected-items-dropdown" >' +
                    '<div class="selected-projects padding-left-0 padding-right-0 margin-right-0" style="min-height: initial">' +
                        '<ul class="listitems-selector with-checked">' +
                            '<li ng-repeat="item in $ctrl.topNavApi.getTeam() | orderBy: \'order\' track by item._id" ng-click="$ctrl.checkTaskTeam($event,item._id)" class="with-mouse-hover table-div" ng-class="{\'active\':$ctrl.topNavApi.isTaskTeam(item._id)}">' +
                                '<div class="col40">' + $ctrl.security.getUserImageComponent('item','smaller') + '</div>' +
                                '<div class="name text-left with-padding-left text-left" ng-bind="::item.name| truncate : 30"></div>' +
                                '<div></div>' +
                            '</li>' +
                            '<li ng-click="$ctrl.checkTaskTeam($event,0)" class="with-mouse-hover table-div" ng-class="{\'active\':$ctrl.topNavApi.isTaskTeam(0)}"  ng-class="{\'active\':$ctrl.topNavApi.isTaskTeam(0)}">' +
                                '<div class="file-uploader smaller"><div class="thumb-sm with-radius smaller"><div class="avatar roundborder"><div class="sbf team"><span class="sbp p1"></span><span class="sbp p2"></span></div></div></div></div>' +
                                '<div class="name text-left with-padding-left text-left">Unassigned</div>' +
                                '<div></div>' +
                            '</li>' +
                        '</ul>' +
                    '</div>' +
                '</div>' +
            '</div>';
   // '<!--<div ng-if="$ctrl.topNavApi.hasTaskTeam()" class="clearfix clear-filter"><a ng-click="$ctrl.clearTaskTeam($event)">'+$ctrl.LCS.getISBDiv('delete', 2)+' Clear Team Filter</a> </div>-->  '
        }

        function getFilterByColor() {
            return'<div ng-if="!$ctrl.hasCurrentState(\'.workflow\') && $ctrl.topNavApi.getColors().length>0" class="dropdown-menu no-menu">' +
                            '<div class="header-small">Filter by Color</div>' +
                            '<div>' +
                                '<div class="table-div">' +
                                    '<div class="custom-drp-ul custom-color">' +
                                        '<div class="custom-wrapper">' +
                                            '<div class="custom-checkbox inrow '+ $ctrl.pageClass +'" ng-class="{\'dark\':item.text!=\'rgba(255,255,255,0.7)\'}" ng-repeat="item in $ctrl.topNavApi.getColors() track by item.id" ng-click="$ctrl.checkTaskColor($event,item.id)">' +
                                                '<div class="customitem" ng-style="{\'background-color\': item.id}"><label class="text-center"><input type="checkbox" ng-checked="$ctrl.topNavApi.isTaskColor(item.id)"><span></span><span></span></label></div>' +
                                            '</div>' +
                                        '</div>' +
                                    '</div>' +
                                '</div>' +
                                //'<div ng-if="$ctrl.topNavApi.hasTaskColors()" class="clearfix clear-filter"><a ng-click="$ctrl.clearTaskColors($event)">'+$ctrl.LCS.getISBDiv(\'delete\', 2)+' Clear Color Filter</a></div>' +
                            '</div>' +
                        '</div>';
        }

        function getFilterByActive() {
            return'<div ng-if="!$ctrl.hasCurrentState(\'.workflow\')" class="dropdown-menu no-menu">' +
                '<div class="header-small">Filter by Active</div>' +
                '<div>' +
                '<div class="table-div">' +
                '<div class="custom-drp-ul custom-color">' +
                '<div class="custom-wrapper">' +
                '<div class="custom-checkbox inrow '+ $ctrl.pageClass +'" ng-class="{\'dark\':item.text!=\'rgba(255,255,255,0.7)\'}" ng-repeat="item in $ctrl.topNavApi.getActive() track by item.id" ng-click="$ctrl.checkTaskActive($event,item.id)" ng-class="{\'active\':$ctrl.topNavApi.isTaskActive(item.id)}">' +
                '<div style="width:0"></div>' +
                '<div class="name text-left with-padding-left text-left" ng-bind="::item.name"></div>' +
                '<div></div>' +
                '</div>' +
                '</div>' +
                '</div>' +
                '</div>' +
                //'<div ng-if="$ctrl.topNavApi.hasTaskColors()" class="clearfix clear-filter"><a ng-click="$ctrl.clearTaskColors($event)">'+$ctrl.LCS.getISBDiv(\'delete\', 2)+' Clear Color Filter</a></div>' +
                '</div>' +
                '</div>';
        }
        function getFilterByProgress() {
            var filters = '<div ng-repeat="cat in $ctrl.topNavApi.MoreDaysFilter track by cat.id" ng-class="{\'margin-top-half\':$index!=0}">' +
                '<ul class="listitems-selector with-checked">' +
                '<li ng-repeat="item in cat.items track by item.id" ng-click="$ctrl.checkTaskProgress($event,item.id)" class="with-mouse-hover table-div" ng-class="{\'active\':$ctrl.topNavApi.isTaskProgress(item.id)}">' +
                '<div style="width:0"></div>' +
                '<div class="name text-left with-padding-left text-left" ng-bind="::item.name"></div>' +
                '<div></div>' +
                '</li>' +
                '</ul>' +
                '</div>';
            return '<div class="dropdown-menu no-menu progress-filer">' +
                '<div class="header-small">Filter Events by Progress</div>' +
                '<div class="selected-items-dropdown">' +
                '<div class="selected-projects">' + filters +
                '</div>' +
                '</div>' +
                '</div>';
        }

         function clearFilters() {
             return '<div class="dropdown-menu no-menu" ng-if="$ctrl.topNavApi.hasTaskFilters()">' +
             '<div class="clearfix margin-half-top"><a class="btnClearFilter" ng-click="$ctrl.topNavApi.clearTaskFilters()">Clear Filters</a></div>' +
             '</div>'
         }
    }
}

angular.module('user.calendar.gantt.component', [
    'calendar.gantt',
    'user.calendar.item.remove.component',
    'user.calendar.item.move.component',
    'user.calendar.item.template.component',
    //'mgcrea.ngStrap',
    'user.calendar.topNav.service',
    'user.calendar.taskPopup.component',
    'user.calendar.item.row.component',
    'user.calendar.item.group.component'
])
.component('sbCalendar', {
    bindings: {
        compOptions: '<',
        isCompany: '<',
        calendarId: '<',
        getEmptyState: '&',
        createFromTop: '&'

    },
    controller: 'CalendarGanttCtrl',
})
.controller('CalendarGanttCtrl',CalendarGanttCtrl);

CalendarGanttCtrl.$inject = ['GanttObjectModel', 'ganttDebounce', 'CalendarApiService','TopNavCalendarService', 'GanttMoment', 'TodoCardsService', 'TemplateCompileCompCtrlService', '$element',  '$scope', '$rootScope', '$log'];
function CalendarGanttCtrl(ObjectModel, debounce, CalendarApiService, TopNavCalendarService, GanttMoment, TodoCardsService,TemplateCompileCompCtrlService, $element,  $scope, $rootScope, $log) {
    //todo: replace number of tasks for free
    var CalendarRowContentService = CalendarApiService.CalendarRowContentService;

    var $ctrl = this;
    $ctrl.TodoCardsService = TodoCardsService;

    var objectModel,   firstLoadFinished, refreshCalendar = false, debug, card;

    $ctrl.changedFields = ['calendarId'];

    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.$onChanges = $onChanges;

    $ctrl.isActiveFilter = isActiveFilter;
    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function isActiveFilter(){return true;}

    function $onChanges(changes) {
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i],
                change = changes[field];
            if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                onCalendarIdChanged(change.currentValue);
                break;
            }
        }
    }

    function preInit() {
        $ctrl.setBanner = setBanner;
        var stateParams = $ctrl.CPS.stateParams;
        debug = stateParams ? stateParams.debug : null;
        card = stateParams ? stateParams.card : null;
        $ctrl.isDebug = debug && (debug === "1" || debug === "true");

        setBanner();

        CalendarApiService.init($ctrl.CPS.companyId, $rootScope.shortDateFormat, $ctrl.isDebug);
        $ctrl.options = _.extend({}, TopNavCalendarService.initOptions(CalendarRowContentService.options));

        $ctrl.options.api = loadCalendarApi;
        $ctrl.options.drawTaskFactory = drawTaskFactory;
        $ctrl.RowTypes = CalendarRowContentService.RowTypes;
        $ctrl.EventTypes = CalendarRowContentService.EventTypes;


        $ctrl.getColumnWidth = TopNavCalendarService.getColumnWidth;
        $ctrl.getTasksOutOfRange = CalendarRowContentService.getTasksOutOfRange;

        $ctrl.checkIfCanAddTasks = checkIfCanAddTasks;

        // Clear data action
        $ctrl.clear = clear;
        // Add data to target row index -> not used
        $ctrl.addOverlapTaskToTargetRowIndex = addOverlapTaskToTargetRowIndex;

        $ctrl.topNavApi = TopNavCalendarService;

        $rootScope.getDBItemOrder = CalendarRowContentService.getDBItemOrder;
        $rootScope.getTaskTooltip = CalendarRowContentService.getTaskTooltip;
        $rootScope.getGroupTooltip = CalendarRowContentService.getGroupTooltip;
        $rootScope.handleRowClick = handleRowClick;
        $rootScope.handleTaskClick = handleTaskClick;

        CalendarApiService.initRootParams($ctrl.CPS.product, 1);
        CalendarApiService.initRootParams($ctrl.CPS.product, 2);
        CalendarApiService.initRootParams($ctrl.CPS.product, 3);
    }

    function setBanner(){
        $ctrl.CPS.withBanner = $ctrl.CPS.setPageBanner($ctrl.CPS.withBanner,
            $ctrl.showBannerProp, $ctrl.bannerFeatureProp);
    }

    function postInit() {
        onUpdatedSubscription();
        setGeneralWatchers();
    }

    function onUpdatedSubscription() {
        $ctrl.setBanner();
    }

    function getBanner() {
        if(!$ctrl.CPS.withBanner){return '';}
        var b = getCollaboratorBanner();

        if($ctrl.CPS.isAuthenticated) {
            return '<div class="tab-content with-no-bg hide-print with-no-margin">' +
                '<div class="alert alert-warning">' +
                '<div class="spacing-quart position-relative">' +
                '<strong>' + $ctrl.maxFreeItemsCount + ' Events Supported</strong> – Your current plan only supports ' + $ctrl.maxFreeItemsCount + ' events. To add unlimited events, <a href="' + $ctrl.CPS.getStateHref('user.pricing', $ctrl.CPS.currentPathParams()) + '">upgrade now!</a>' +
                // '<a class="closebtn close" ng-click="$ctrl.CPS.closeBanner()" style="top:7px">&times;</a>' +
                '</div>' +
                '</div>' +
                '</div>';

        }

        return ($ctrl.CPS.isCollaborator && $ctrl.LCS.collabBannerInside)? getCollaboratorBanner() : '';

        function getCloseBtn(){
            return '<div class="centered btn-col text-center col40">' +
                //'<a class="closebtn display-block" ng-click="$ctrl.CPS.closeBanner()">' + $ctrl.LCS.getISBDiv('close-bigger', 2) + '</a>' +
                '</div>';
        }

        function getCollaboratorBanner(){
           return $ctrl.CPS.isCollaborator && $ctrl.CPS.withBanner
               ? ('<div class="alert alert-warning alert-stylish calendar table-div full-width">' +
                '<div class="centered grow-column">' +
                    $ctrl.LCS.getISBDiv('calendars', 3, 'icon sbf24 pull-left') +
                    ' <span class="text">Create your production calendars now.</span>' +
                    '</div>' +
                '<div class="centered col160">' +
                    '<a href="'+$ctrl.CPS.websiteUrl+'/register/?utm_campaign=collab-calendar" target="_blank" class="btn btn-primary  pull-right">Get Started Free</a>' +
                    '</div>' +
                '<div class="centered btn-col text-center col40">' +
                    '<a class="closebtn" ng-click="$ctrl.CPS.closeBanner()">'+$ctrl.LCS.getISBDiv('close-bigger')+'</a>' +
                    '</div>' +
                '</div>') : '';
        }
    }

    function getItemTemplate () {
        if(!$ctrl.isCompany && !$ctrl.calendarId){
            return $ctrl.getEmptyState();
        }

    return '<div class="full-content with-fancy-scrollbar show-scrollbar-on-hover h-full with-filters padding-left-0">' +
            getBanner() +
            '<div class="fancy-scrollbar vertical scrollable-content h-full first-scrolling-wrapper">' +
                '<div class="h-full" ng-if="$ctrl.isLoaded && $ctrl.options.fromDate && $ctrl.options.toDate">' +
                    '<div class="h-full" ng-show="$ctrl.data.length > 0" ng-class="{true:\'with-radius with-side-margin with-white-bg margin-bottom-half\', false: \'with-no-bg\'}[$ctrl.data.length === 0]">' +
                        '<div class="h-full" ng-class="{\'calendar-editable\': $ctrl.options.sortable}" gantt ' +
                            'data="$ctrl.data" ' +
                            'timespans="$ctrl.timespans" ' +
                            'show-side="$ctrl.options.labelsEnabled" ' +
                            'daily="$ctrl.options.daily" ' +
                            'filter-task="$ctrl.options.filterTask" ' +
                            'filter-row="$ctrl.options.filterRow" ' +
                            'sort-mode="$ctrl.options.sortMode" ' +
                            'view-scale="$ctrl.options.scale" ' +
                            'column-width="$ctrl.getColumnWidth()" ' +
                            'auto-expand="$ctrl.options.autoExpand" ' +
                            'task-out-of-range="$ctrl.getTasksOutOfRange(options.taskOutOfRange)" ' +
                            'from-date="$ctrl.options.fromDate" ' +
                            'to-date="$ctrl.options.toDate" ' +
                            'allow-side-resizing="$ctrl.options.allowSideResizing" ' +
                            'task-content="$ctrl.options.taskContent" ' +
                            'row-content="$ctrl.options.rowContent" ' +
                            'current-date="$ctrl.options.currentDate" ' +
                            'current-date-value="$ctrl.options.currentDateValue" ' +
                            'headers="$ctrl.options.headers" ' +
                            'headers-formats="$ctrl.options.headersFormats" ' +
                            'headers-scales="$ctrl.options.headersScales" ' +
                            'max-height="$ctrl.options.maxHeight" ' +
                            'time-frames="$ctrl.options.timeFrames" ' +
                            'date-frames="$ctrl.options.dateFrames" ' +
                            'time-frames-working-mode="$ctrl.options.timeFramesWorkingMode" ' +
                            'time-frames-non-working-mode="$ctrl.options.timeFramesNonWorkingMode" ' +
                            'time-frames-magnet="$ctrl.options.timeFramesMagnet" ' +
                            'api="$ctrl.options.api" ' +
                            'column-magnet="$ctrl.options.columnMagnet">' +
                            '<gantt-tree enabled="$ctrl.options.sideMode === \'Tree\' || $ctrl.options.sideMode === \'TreeTable\'" ' +
                                'header-content="$ctrl.options.treeHeaderContent" ' +
                                'keep-ancestor-on-filter-row="true" >' +
                            '</gantt-tree>' +
                            '<!-- <gantt-table enabled="$ctrl.options.sideMode === \'Table\' || $ctrl.options.sideMode === \'TreeTable\'"  ' +
                            'columns="$ctrl.options.sideMode === \'TreeTable\' ? $ctrl.options.treeTableColumns : $ctrl.options.columns"  ' +
                            'headers="$ctrl.options.columnsHeaders"  ' +
                            'classes="$ctrl.options.columnsClasses"  ' +
                            'formatters="$ctrl.options.columnsFormatters"  ' +
                            'contents="$ctrl.options.columnsContents"  ' +
                            'header-contents="$ctrl.options.columnsHeaderContents"> ' +
                            '</gantt-table> -->' +
                            '<gantt-corner headers-labels="$ctrl.options.corner.headersLabels" headers-labels-templates="$ctrl.options.corner.headersLabelsTemplates"></gantt-corner>' +
                            '<gantt-groups enabled="$ctrl.options.groupDisplayMode === \'group\' || $ctrl.options.groupDisplayMode === \'overview\' || $ctrl.options.groupDisplayMode === \'promote\'" display="$ctrl.options.groupDisplayMode"></gantt-groups>' +
                            '<gantt-tooltips></gantt-tooltips>' +
                            '<gantt-bounds></gantt-bounds>' +
                            '<gantt-progress></gantt-progress>' +
                            '<gantt-sortable enabled="$ctrl.options.sortable"></gantt-sortable>' +
                            '<gantt-sections></gantt-sections>' +
                            '<gantt-movable enabled="!$ctrl.options.readOnly" allow-row-switching="$ctrl.options.movable.allowRowSwitching" allow-resizing="$ctrl.options.movable.allowresizing"></gantt-movable>' +
                            '<gantt-draw-task enabled="$ctrl.options.canDraw" move-threshold="$ctrl.options.moveThreshold" task-factory="$ctrl.options.drawTaskFactory"></gantt-draw-task>' +
                            '<gantt-overlap></gantt-overlap>' +
                            '<gantt-resize-sensor></gantt-resize-sensor>' +
                            '<gantt-dependencies enabled="$ctrl.options.dependencies" conflict-checker="$ctrl.options.conflicts" read-only="$ctrl.options.readOnly"></gantt-dependencies>' +
                        '</div>' +
                    '</div>' +
                    '<div ng-if="$ctrl.data.length === 0" class="empty-state-wrapper with-side-margin with-margin-top">'+$ctrl.getEmptyState()+'</div>' +
                '</div>' +
                '<preloader-center class="full-width ' + ($ctrl.pageClass ||'') + '" ng-if="!$ctrl.isLoaded"></preloader-center>' +
