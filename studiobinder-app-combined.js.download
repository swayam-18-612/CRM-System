CustomNotePopupCtrl.$inject = ['CoverPageCtrlService', 'ListItemActionCtrlService', 'SBFieldTypesService', '$element'];
function CustomNotePopupCtrl(CoverPageCtrlService, ListItemActionCtrlService, SBFieldTypesService, $element) {
    var $ctrl = this;
    $ctrl.SBFieldTypesService = SBFieldTypesService;

    $ctrl.isPopup = true;
    $ctrl.withoutRecurringSave = true;
    $ctrl.isFullPageSize = true;
    $ctrl.editorType = 'titlepage';
    $ctrl.isCustomNotes = true;
    $ctrl.hiddenCls = 'opacity0';
    $ctrl.withoutListItemOnSave = true;

    $ctrl.onAdditionalInitOther = onAdditionalInitOther;
    $ctrl.onItemUpdateOther = onItemUpdateOther;
    $ctrl.onSaveAfter = onSaveAfter;
    $ctrl.onLoadedOther2 = onLoadedOther2;
    $ctrl.onChangeStyleOther = onChangeStyleOther;
    $ctrl.updateColorAndBgOther = updateColorAndBgOther;
    $ctrl.closePopup = closePopup;
    $ctrl.onSave = onSave;

    $ctrl = new ListItemActionCtrlService($ctrl);
    $ctrl = new CoverPageCtrlService($ctrl, $element, $ctrl.isPopup);

    function onSave(result){
        console.log('CustomNotePopupCtrl.onSave');
        result.eventType = 'CHANGED_FIELD';
        var p = {_id: $ctrl.item._id};
        var prop = $ctrl.styleChanged ? $ctrl.fieldClass : $ctrl.field;
        p[prop] = $ctrl.item[prop];
        result.editchanges = p;
        $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result);
    }

    function closePopup(result) {
        if ($ctrl.triggerClose &&  $ctrl.onClose) {
            $ctrl.onClose({result: result || 'cancel'});
        }
    }

    function updateColorAndBgOther(isLoad){
        if(isLoad){return;}
        $ctrl.styleChanged = true;
        preload();
        processSaving();
    }

    function onChangeStyleOther(styleId, isLoad) {
        console.log('onChangeStyleOther');
        var res = $ctrl.getCustomStyle($ctrl.item, styleId, !isLoad),
            style = res.style,
            Style = res.Style;

        $ctrl.item = _.extend($ctrl.item, res.props);

        $ctrl.getEditorEl();

        if(style!==''){
            $ctrl.editor.style = style;
        } else if(!isLoad) {
            $ctrl.editor.removeAttribute('style');
        }

        $ctrl.editor.setAttribute('data-style', styleId.toString());

        //fonts
        //replace('h1', 'hClass');
        //replace('p', 'pClass');

        if(isLoad){
            $ctrl.LCS.timeout(function (){
                $ctrl.LCS.removeClass($ctrl.element.querySelector('.' + $ctrl.editorClsOther+'[editor-type="'+$ctrl.editorType+'"]'), $ctrl.hiddenCls);
            }, 50);
        }
        $ctrl.prevStyle = Style;

        if(!isLoad) {
            //$ctrl.broadcastRoot('SAVE_DOC_CHANGES_' + $ctrl.item._id + '_POPUP', _.extend({dontSave: true}, $ctrl.item));
        }

        function replace(tag, prop){
            var p =  !isLoad && $ctrl.prevStyle ? $ctrl.prevStyle[prop] : '';
            if (p !== Style[prop]) {
                $ctrl.LCS.replaceClass($ctrl.editor.querySelector(tag), p, Style[prop]);
            }
        }
    }

    function preload(){
        var p = {};
        _.each(['styleId'].concat($ctrl.SBFieldTypesService.getStyleProps()), function (prop){
            if($ctrl.item[prop]) {
                p[prop] = $ctrl.item[prop];
            }
        });
        $ctrl.item[$ctrl.fieldClass] = p;
    }

    function processSaving(withClose) {
        console.log('CoverPageCtrlService.processSaving');
        $ctrl.save();

        if(withClose) {
            $ctrl.closePopup(withClose);
        }
    }

    function onItemUpdateOther(result){
        console.log('CustomNotePopupCtrl.onItemUpdateOther');
        $ctrl.item[$ctrl.field] = $ctrl.editor.innerHTML;
    }

    function onSaveAfter(){
        console.log('CustomNotePopupCtrl.onSaveAfter');
        if(!$ctrl.styleChanged) {
            $ctrl.closePopup(true);
        }else {
            $ctrl.styleChanged = false;
        }
    }

    function onLoadedOther2() {
        $ctrl.onChangeStyleOther($ctrl.item.styleId, true);
    }

    function onAdditionalInitOther() {
        $ctrl.type = 'Edit';
        $ctrl.dontTriggeUpdateItem = false;
        $ctrl.contentEditorCls = ' ' + $ctrl.hiddenCls;
        $ctrl.cover = $ctrl.element;
        $ctrl.withoutCustomOnSave = true;
        $ctrl.triggerProcessSavingOnBtn = true;
        $ctrl.customTitle = '  ';
        $ctrl.editorType = 'customnote';
        $ctrl.hasBorder = true;
        $ctrl.hasStyle = true;

        if(!$ctrl.fieldClass) {
            $ctrl.fieldClass = $ctrl.extraParam.fieldClass ? $ctrl.extraParam.fieldClass : 'noteStyle';
            if($ctrl.fieldClass) {
                $ctrl.field = $ctrl.extraParam.field ? $ctrl.extraParam.field : 'note';
            }
        }

        if(!$ctrl.field) {
            $ctrl.field = $ctrl.extraParam.field ? $ctrl.extraParam.field : 'note';
        }

        $ctrl.itemChangedFields = [$ctrl.field, $ctrl.fieldClass];

        if($ctrl.extraParam.contentWidth) {
            $ctrl.contentWidth = $ctrl.extraParam.contentWidth;
        }

        $ctrl.editorClsOther = 'custom-note';
        $ctrl.service = $ctrl.extraParam.service;
        $ctrl.elemType = $ctrl.extraParam.elemType;

        if(!$ctrl.item[$ctrl.field]){
            $ctrl.item[$ctrl.field] = '<h1>Optional heading here</h1><p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras commodo sapien justo, nec ornare est suscipit ac. Mauris tincidunt ut mauris sit amet congue. Fusce ut ex sit amet ipsum facilisis lobortis.</p>';
        }

        if($ctrl.item[$ctrl.fieldClass]){
            $ctrl.item =_.extend($ctrl.item, $ctrl.item[$ctrl.fieldClass]);
        }

        setMaxWidth();
        $ctrl.onSave = onSave;
    }

    function setMaxWidth(){
        if ($ctrl.extraParam.contentWidth) {
            var el = $ctrl.element.querySelector('.sb-editor');//$ctrl.LCS.findClosestParent($ctrl.element, '.modal-dialog');
            if (el) {
                if (!el.style) {
                    el.style = {};
                }
                el.style.setProperty('max-width', $ctrl.extraParam.contentWidth + 'px', 'important');
            }
        }
    }
}

