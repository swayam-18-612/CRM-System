])
.directive('secureVideoViewer', secureVideoViewer)
.controller('SecureVideoViewerDirectiveController', SecureVideoViewerDirectiveController);

SecureVideoViewerDirectiveController.$inject = ['$rootScope', '$scope', 'i18nNotifications', 'MaterialsService', '$controller'];

function secureVideoViewer() {
    return {
        restrict: 'E',
        replace:'true',
        scope: {
            materialVersion: "=?",
            options: '=?'
        },
        template: '<div class="material-content flex-box preview-video h-full full-width">' +
            '<div class="material-video-wrapper">' +
            '<div class="material-video-aspect-container">' +
            '<div class="material-video-container">' +
            '<div class="video-player h-full" ng-if="options.src">' +
                '<vjs-video-container class="display-block" vjs-ratio="{{options.ratio}}" vjs-media="options.media" vjs-setup="options.setup" vjs-comments="commentsOptions">' +
                    '<video class="video-js vjs-default-skin vjs-big-play-centered vjs-paused vjs-controls-enabled vjs-workinghover vjs-v6 vjs_video_1-dimensions vjs-user-active" controls preload="auto"></video>' +
                '</vjs-video-container>' +
