function CallsheetTypeController(CallsheetStep1PopupCtrlService, $element) {
    var $ctrl = this;
    $ctrl.itemIcon = 'callsheets';
    $ctrl.iconLevel = 8;
    $ctrl.dontShowActivity = true;

    $ctrl.isCallsheetType = isCallsheetType;
    $ctrl.setCallsheetType = setCallsheetType;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.preInitCSP = preInitCSP;

    var isEdit = true;
    $ctrl = new CallsheetStep1PopupCtrlService($ctrl, $element, isEdit);

    function isCallsheetType( val) {
        return $ctrl.item && $ctrl.item.type === val;
    }

    function setCallsheetType( val) {
        $ctrl.item.type = val;
    }

    function preInitCSP() {
        $ctrl.modalBodyFormClass = 'long500';
        $ctrl.popupTitle = 'Call Sheet Type';
        $ctrl.subdesc = 'Automatically updates phrasings throughout the call sheet so you can use it for other purposes.';
    }

    function setTemplateData() {
        $ctrl.withFooterBtns = true;
        $ctrl.withBtnDisabled = false;
        $ctrl.icon = $ctrl.itemIcon;
        $ctrl.modalBodyId = '';
        $ctrl.btnText = 'Save Type';
        $ctrl.firstBtnMethod = 'saveDetails';
        $ctrl.textAnalytics = 'Save Call Sheet Type';
    }

    function getPopupBodyContent() {
        return '<ul class="callsheet-type centering text-center spacing-half">' + getList() + '</ul>';
    }

    function getList() {
        var el = ''
        _.each($ctrl.CallsheetTypes, function (t) {
            var val = t.value;
            el += '<li ng-class="{active:$ctrl.isCallsheetType('+val+')}" ng-click="$ctrl.setCallsheetType('+val+')">' +
                    $ctrl.LCS.getISBDiv(t.icon, t.iconLevel ? t.iconLevel : '', 'centered') +
                    '<div class="text">' + t.text + '</div>' +
                  '</li>';
        });
        return el;
    }
}

