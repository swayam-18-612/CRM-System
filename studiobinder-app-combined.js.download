angular.module('product.workflow.list.tree.component.service', [
    'product.workflow.item.new.component',
    'list.tree.sidebar.controller.service',
    'product.workflow.group.component',
    'product.workflow.tree.item.new.component',
    'product.workflow.list.tree.item.component',

    'sb.kanbanSortable.service',
    'sb.sortable.service'
])

.service('WorkflowSidebarTreeCtrlService', WorkflowSidebarTreeCtrlService);
WorkflowSidebarTreeCtrlService.$inject = ['SidebarTreeCtrlService', 'TopNavCalendarService', 'CompInitCtrlService', 'SBSortableService', 'SBKanbanSortableService'];
function WorkflowSidebarTreeCtrlService(SidebarTreeCtrlService, TopNavCalendarService, CompInitCtrlService, SBSortableService, SBKanbanSortableService) {
    return function ($ctrl, WorkflowConstantsService, $element){
        console.log('WorkflowSidebarTreeCtrlService');

        $ctrl.TopNavCalendarService = TopNavCalendarService;
        $ctrl.WorkflowConstantsService = WorkflowConstantsService;
        $ctrl.SBSortableService = SBSortableService;
        $ctrl.SBKanbanSortableService = SBKanbanSortableService;

        $ctrl.isDragula = true;
        $ctrl.colors = $ctrl.WorkflowConstantsService.Colors;

        $ctrl.$onDestroy = $onDestroy;
        $ctrl = new CompInitCtrlService($ctrl);
        $ctrl.itemSortableCls = 'as-sortable-item';
        $ctrl.addColumnInline = false;
        $ctrl.treeItemTag = 'taskcard-tree';
        $ctrl.isSidebar = true;
        $ctrl.sortableContainmentCls = 'kanban-container';
        $ctrl.sortableKanbanContainmentCls = null;
        $ctrl.sortableKanbanContainerCls = $ctrl.sortableContainmentCls;
        $ctrl.childClass = 'kanban-board';

        // $ctrl.quotaType = 'workflowColumns';
        $ctrl.treeItemClass= 'taskcard-tree-item-grid';
        $ctrl.mirrorContainerCls = 'swimlane-wrapper';
        $ctrl.counters = {};
        $ctrl.fixParentName = '.fancy-scrollbar';

        if(false){
            $ctrl.fixAddBtn = 'inside';
            $ctrl.fixOffset = 60;
        }else {//if is workflow
            $ctrl.fixOffset = 100;
        }

        $ctrl.fixApply = true;

        $ctrl.scrollableParentCls= null;
        $ctrl.todoCardsScrollY = 10;
        $ctrl.todoCardsScrollable = '.workflow-cards-scroll-wrapper';

        $ctrl.topNavApi = $ctrl.TopNavCalendarService;
        $ctrl.filter = $ctrl.topNavApi.filter;

        $ctrl.changedFields = ['compOptions'];

        //for add new todo column
        $ctrl.getNewTreePopupExtraParam = getNewTreePopupExtraParam;
        $ctrl.getNewTodoColumn = getNewTodoColumn;
        $ctrl.addTodoColumnCanceled = addTodoColumnCanceled;
        $ctrl.addTodoColumnSaved = addTodoColumnSaved;
        $ctrl.doesntExistTodoColumnName = doesntExistTodoColumnName;

        $ctrl.isSetFocus = isSetFocus;
        $ctrl.cancelShowColors = cancelShowColors;
        $ctrl.showColors = showColors;
        $ctrl.processColumn = processColumn;

        $ctrl.acceptSortableTree = acceptSortableTree;
        $ctrl.getNewTreeItem = getNewTreeItem;
        $ctrl.addColumn = addColumn;

        $ctrl.checkQuotaOnDelete = checkQuotaOnDelete;

        $ctrl.$onInit = $onInit;

        $ctrl.hasListColumns = hasListColumns;

        return $ctrl;

        function $onInit() {
            getCardsOptions();

            $ctrl.hasQuotaProp = $ctrl.canEdit ? true : false; // $ctrl.CPS.hasQuotaType($ctrl.quotaType) ;

            $ctrl.getEmptyGroup = getEmptyGroup;
            $ctrl.listTreeService.getSidebarTemplate = getSidebarTemplate;
            $ctrl.listTreeService.onSidebarLoaded = onSidebarLoaded;

            $ctrl.sortableGrid = 'sortableTreeGrid' + $ctrl.elemType;
            if($ctrl.isTaskBoards){
                $ctrl.getListIdsForTreeItemsMoved = getListIdsForTreeItemsMoved;
            }
            $ctrl = new SidebarTreeCtrlService($ctrl, $element);

            if ($ctrl.canEdit) {
                $ctrl.addRootWatcher('ADD_COLUMN_' + $ctrl.elemType, function (result) {
                    $ctrl.addColumn(result ? result.e : null);
                });
            }
        }
        function getListIdsForTreeItemsMoved(){
            return null;
        }

        function $onChanges(changes) {
            console.log(changes);
            if (!changes) {
                return;
            }

            for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
                var field = $ctrl.changedFields[i];
                var change = changes[field];
                if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                    if(field ==='compOptions'){
                        getCardsOptions();
                    }
                    break;
                }
            }
        }

        function checkQuotaOnDelete(process){
            return $ctrl.quotaOnDelete ? $ctrl.CPS.loadQuotaPopup($ctrl.quotaOnDelete, process, null, null, $ctrl.compOptions) : process();
        }

        function getCardsOptions() {
            var opts;
            try{
                opts = JSON.parse($ctrl.compOptions);
            }catch(e){}
            if(opts)  {
                $ctrl = _.extend($ctrl, opts);
            }
        }

        function hasListColumns(){
            return $ctrl.tree && $ctrl.tree[0] && $ctrl.tree[0].nodes && $ctrl.tree[0].nodes.length > 0;
        }
        function getSidebarTemplate(isInTreeModal, canEdit) {
            if(isInTreeModal) {
                return '<div class="swimlanes-in-modal">' + getList() + '</div>';
            }

    return '<div class="table-wide h-full">' +
                '<div class="with-padding h-full tab-content" ' +
                    ($ctrl.withoutEmptyStateOnTree ? '' : ('ng-class="{true:\'with-radius with-side-margin spacing-half-bottom\'}[!$ctrl.hasListColumns()]"')) +
                '>' +
                    '<div class="'+$ctrl.mirrorContainerCls+' h-full" data-id="null"' +
                        ($ctrl.withoutEmptyStateOnTree ? '' : (' ng-style="!$ctrl.hasListColumns() &&{\'background-color\':\'white\'}"')) +
                    '>' +
                        '<div class="h-full table-div"' +
                            ($ctrl.withoutEmptyStateOnTree ? '' : (' ng-show="$ctrl.hasListColumns()" ')) +
                            '>' +
                            '<div>' +
                                '<div class="dd h-full" id="'+$ctrl.sortableGrid+'" data-currentlistid="null">' +
                                    '<div class="overflow-statuses h-full '+$ctrl.sortableKanbanContainerCls+'">' +
                                    //'ng-class="{\'no-drag\': $ctrl.hasQuotaProp!==true||$ctrl.canEdit!=true||$ctrl.LCS.isTouchScreen}"
                                        getList() +
                                        (isInTreeModal ? '' :  getAddColumn()) +
                                    '</div>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                        ($ctrl.withoutEmptyStateOnTree ? '' : ('<div ng-if="!$ctrl.hasListColumns()" class="no-product h-full table-div full-width">' + $ctrl.getEmptyGroup()+ '</div>')) +
                    '</div>' +
                '</div>' +
            '</div>';

            function getList(){
                //for kanban - sort columns
                var withSortable = !isInTreeModal && $ctrl.withSortable && $ctrl.hasQuotaProp === true;
                return '<div class="swimlane h-full tree-node tree-node-content ' + $ctrl.childClass + ' ' +
                    'dd-item ' + (withSortable ? $ctrl.itemSortableCls : '') +
                    ' show-scrollbar-on-hover" ' +
                    'ng-repeat="item in '+($ctrl.canEdit?'':'::')+'$ctrl.tree[0].nodes"' +
                    (isInTreeModal ? 'ng-click="$ctrl.selectList(item._id)" ' : '')+
                                    //data-id
                    ' ng-if="item" ng-attr-data-id="{{::item._id?item._id:\'null\'}}" current-list-id="null"' +

                    '>' + getItem() + '</div>';

                function getItem(){
                    return '<div class="lane-wrapper h-full ">' +
                        (isInTreeModal ?  getTreeItemInModal() : getTreeItemInGrid())+
                        getRemaining() +
                        '</div>';

                    function getRemaining(){
                        return isInTreeModal ? '' : ('<div class="swimlane-remaining-height kanban-drag" ng-class="{\'with-colors\':$ctrl.showColors(item)}" >' + $ctrl.getGroupBody({isFullHeight: true}) + '</div>');
                    }

                    function getTreeItemInModal(){
                        return '<div class="taskcard-tree-item-grid clearfix display-block top-height" ng-class="$ctrl.isSelectedList(item._id)?\'selected\':\'\'">' +
                              '<div class="swimlane-header">' +
                            '<div class="swimlane-top-border" ng-style="::{\'background-color\': item.color}"></div>' +
                            '<div class="swimlane-title clearfix thinner table-div">' +
                            '<div class="list-edit-item grow-column centered with-padding-right table-cell">' +
                            '<div class="list-item-name swimlane-title table-div fixed-layout semibold">' +
                            '<div class="with-ellipsis name" ng-bind="::item.name">On Hold</div>' +
                            '</div>' +
                            '</div>' +
                            '</div>' +
                            '</div>' +
                            '</div>';
                    }

                    function getTreeItemInGrid() {
                        return '<taskcard-tree-item-grid class="' +
                            $ctrl.treeItemClass +
                            ' clearfix display-block top-height ' +
                            (withSortable ? 'as-sortable-item-handle' : '') +
                            '" ' +
                            'item="::item" ' +
                            //'item="' + ($ctrl.canEdit ? '' : '::') + 'item" ' +
                            'tree-type="::' + $ctrl.treeType + '" ' +
                            'elem-type="' + $ctrl.elemType + '" ' +
                            'can-edit="::$ctrl.canEdit"' +
                            ($ctrl.canDragPredefTreeItem ? ('can-drag-predef-tree-item="true" ') : '') +
                            (withSortable ? 'as-sortable-item-handle' : '') +
                            '></taskcard-tree-item-grid>';
                    }
                }
            }
        }

        function getEmptyGroup() {
            return '<div class="centered">' +
                '<div class="text-center circled-img big"></div>' +
                '<div>' +
                '<h3 class="text-center">You Have No ' + $ctrl.itemTitle + 's</h3>' +
                ($ctrl.canEdit ? ('<div>' +
                    '<p class="text-center">Click below to get started.</p>' +
                    '<div class="spacing-half-top spacing-bottom text-center">' +
                    '<button class="btn btn-primary" ng-click="$ctrl.create()" analytics-on analytics-action="Create' + $ctrl.itemTitle+'">' +
                    $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left') +
                    ' <div class="with-padding-left">New '+$ctrl.itemTitle+'</div></button>' +
                    '</div>' +
                    '</div>') : '') +
                '</div>' +
                '</div>';
        }

        function getAddColumn() {
            if (!($ctrl.canEdit && $ctrl.isLikeWorkflow)) {
                return '';
            }
    return '<div class="no-drag col284">' +
                ($ctrl.addColumnInline ? (
                '<div class="swimlane new-block" ng-if="$ctrl.addNewColumn">' +
                    '<add-todo-column ' +
                    'service="$ctrl.listsService" ' +
                    'get-item="$ctrl.getNewTodoColumn()" ' +
                    'on-saved="$ctrl.addTodoColumnSaved(result)" ' +
                    'on-canceled="$ctrl.addTodoColumnCanceled()" ' +
                    'doesnt-exist-name="$ctrl.doesntExistTodoColumnName(name)" ' +
                    'type="::\'Create\'"' +
                    '></add-todo-column>' +
                '</div>'
                ) : '') +
                '<div class="add-swimlane-button hide-print" ng-show="!$ctrl.addNewColumn">' +
                    '<div class="one-line-tooltip position-relative">' +
                        '<span class="add-swimlane" tooltip="Add New Column" tooltip-placement="bottom" ' +
                            'ng-click ="$ctrl.addColumn($event)" ' +
                            'data-type="addColumn" analytics-on analytics-action="Add New Column">' + $ctrl.LCS.getISBDiv('plus-circled', 2, 'sbf24') + '</span>' +
                    '</div>' +
                    '<div class="h-full hide-print"><div class="extra-column hide-print"></div></div>' +
                '</div>' +
            '</div>' +
            '<div class="no-drag col284" ng-if="$ctrl.addNewColumn0">' +
                '<div class="swimlane new-block"><input type="text" class="focused" ui-focus="$ctrl.isSetFocus(1000)" tabindex="1000"></div>' +
            '</div>';
        }

        function acceptSortableTree(src, dest, destIndex) {
            return src && dest && src.type === dest.type || src.type === 6 && !dest;
        }

        function getNewTreeItem( item, el, color) {
           // task board columns are of type 4
            var p = {
                color: color ? color : $ctrl.colors[0],
                uId: $ctrl.isScriptPage ? $ctrl.uId : null,
                type: $ctrl.isTaskBoards ? 4 : ($ctrl.isScriptPage ? 3 : 1)
            };
            if($ctrl.isTaskBoards){
                p.taskBoardId = $ctrl.taskBoardId;
            }
            return p;
        }

        function getNewTodoColumn(){
            var color;
            initColor();

            return $ctrl.listsService.convertResource(_.extend({
                isPredef: false,
                active: true,
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.isTaskBoards ? null : $ctrl.CPS.productId
            }, getNewTreeItem(null, null, color)));

            function initColor() {
                var items = $ctrl.tree[0].nodes;
                for (var i = 0; i < $ctrl.colors.length && !color; i++) {
                    color = null;
                    var c = $ctrl.colors[i];
                    var exists = false;
                    for (var j = 0; j < items.length && !exists; j++) {
                        var el = items[j];
                        if (c === el.color) {
                            exists = true;
                        }
                    }
                    if (!exists) {
                        color = c;
                    }
                }
            }
        }

        function addTodoColumnSaved(result) {
            console.log('addTodoColumnSaved');
            var id = result && result.item ? result.item._id : null;
            if (!id) {
                return;
            }
            result.treeType = $ctrl.treeType;
            result.noEditMode = true;
            addTodoColumnCanceled();
            $ctrl.broadcastRoot('ADDED_' + $ctrl.elemType + '_TREE', result);
            //$ctrl.setListTree(id, []);
        }
        function doesntExistTodoColumnName(name) {
            var items = $ctrl.tree[0].nodes;
            return !items ||  !items.length>0 || items.length>0 && _.find(items, function(item){return item && name === item.name;}) === undefined;
        }

        function showColors(item) {
            return item.showColors;
        }

        function cancelShowColors(item) {
            item.showColors = false;
        }

        function getNewTreePopupExtraParam(){
            return {
                itemTitle: $ctrl.nameForList,
                service: $ctrl.listsService,
                getItem: $ctrl.getNewTodoColumn,
                onSaved: $ctrl.addTodoColumnSaved,
                onCanceled: $ctrl.addTodoColumnCanceled,
                doesntExistName: $ctrl.doesntExistTodoColumnName,
                colors: $ctrl.colors
            }
        }

        function addColumn(e) {
            $ctrl.processColumn(null, 'add', e);
        }

        function checkQuota(process, e){
            $ctrl.quotaType = 'workflowColumns';
            if ($ctrl.quotaType) {
                $ctrl.popupsService.checkQuota($ctrl.quotaType, process, $ctrl.compOptions, {e:e});
            } else {
                process();
            }
        }

        function processColumn(item, type, e) {
            checkQuota(process, e);

            function process() {
                switch (type) {
                    case 'color':
                        item.showColors = !item.showColors;
                        break;

                    case 'remove':
                        $ctrl.popupsService.open(item, $ctrl.popupsService.operations.remove, {
                            itemTitle: 'column',
                            listTreeService: $ctrl.listTreeService
                        }, $ctrl.compOptions);
                        break;

                    case 'add':
                        if($ctrl.addColumnInline){
                            $ctrl.addNewColumn0 = true;
                            setFocus(1000);
                            $ctrl.LCS.timeout(function () {
                                $ctrl.addNewColumn = true;
                            }, 10);
                        }else {
                            //if is not inline -> createTodoColumn
                            $ctrl.addItem($ctrl.treeType, {
                                item: {type: $ctrl.treeType},
                                addFolder: false,
                                isParent: false,
                                useSelected: true,
                            });
                        }
                        // {type: $ctrl.treeType}, false, $ctrl.listTreeService.active.selectedList&&$ctrl.listTreeService.active.selectedList.isFolder?true:false, true);
                        break;
                }
            }
        }


        function addTodoColumnCanceled() {
            $ctrl.addNewColumn = false;
            $ctrl.LCS.timeout(function () {
                $ctrl.addNewColumn0 = true;
                setFocus(1000);
            }, 10);
        }


        function setFocus(index) {
            $ctrl.focusIndex = index;
        }

        function isSetFocus(index) {
            return $ctrl.focusIndex === index;
        }

        function onSidebarLoaded() {
            console.log('onSidebarLoaded');
            //the drag for cards doesn't seem to work anymore
            //for column drag
            setColumnsSortable();

            function setColumnsSortable() {
                if (!$ctrl.canEdit) {
                    return;
                }

                var sortableContainmentCls = $ctrl.sortableKanbanContainmentCls ? ('.' + $ctrl.sortableKanbanContainmentCls) : ($ctrl.sortableGrid ? ('#' + $ctrl.sortableGrid) : '');
                //move items between columns
                $ctrl.treeSortableService = new $ctrl.SBKanbanSortableService($ctrl.element, {
                    sortableContainerCls: $ctrl.sortableKanbanContainerCls,
                    scrollableKanbanColumnCls: $ctrl.scrollableKanbanColumnCls,
                    sortableContainmentCls: sortableContainmentCls,
                    containerPositioning: 'relative',//optional param.

                    childClass: $ctrl.childClass,
                    handleClass: $ctrl.treeItemClass,
                    scrollableParentCls: $ctrl.scrollableParentCls ? $ctrl.scrollableParentCls :
                        ($ctrl.isScriptPage ? '.modal-dialog' : ($ctrl.hasTree ? '.scrollable-content' : sortableContainmentCls)),
                    direction: 'horizontal',
                    mirrorContainerCls: $ctrl.mirrorContainerCls,
                    onDragEnd: onDragEnd
                }, $ctrl.isDragula);
            }

            function onDragEnd(items) {
                //onDragEndOtherKanban is called first
                console.log('treesidebar.onDragEnd');
                var currentListId = null;
                if(!items) {
                    items = $ctrl.treeSortableService.getItems();
                }
                if (items && items.length > 0) {
                    $ctrl.onTreeItemsMoved(items, currentListId);
                }
            }
        }

        function $onDestroy(){
            $ctrl.onListTreeInitDestroy();
            if($ctrl.treeSortableService){
                $ctrl.treeSortableService.destroy();
            }
        }
    }
}

angular.module('product.workflow.block.controller.service', [
    'product.workflow.item.edit.popup.component',
    'page.group.controller.service',
    'user.calendar.topNav.service',
    'product.workflow.list.tree.component',
    'services.blocksSetup',
    'list.tree.currentList.service',
    'services.commentsSidebar',
    'apiConstants.product.workflow.services',
])

.service('WorkflowBlockCtrlService', WorkflowBlockCtrlService);
WorkflowBlockCtrlService.$inject = ['PageTreeInitCtrlService', 'TodoColumnsService', 'TodoCardsService', 'BlocksSetupService', 'CompInitCtrlService', 'PreLoadingProv', 'TemplateCompileService', 'FiltersService', 'TodoColumnsConfigsService', 'CommentsSidebarService', 'WorkflowConstantsService', 'CurrentTreeListService'];
function WorkflowBlockCtrlService(PageTreeInitCtrlService, listsService, service, BlocksSetupService, CompInitCtrlService, PreLoadingProv, TemplateCompileService, FiltersService, TodoColumnsConfigsService, CommentsSidebarService, WorkflowConstantsService, CurrentTreeListService) {
    return function ($ctrl, constantsService, params) {

        $ctrl.WorkflowConstantsService = WorkflowConstantsService;
        $ctrl.BlocksSetupService = BlocksSetupService;
        $ctrl.FiltersService = FiltersService;
        $ctrl.CommentsSidebarService = CommentsSidebarService;
        $ctrl.TodoColumnsConfigsService = TodoColumnsConfigsService;
        $ctrl.PreLoadingProv = PreLoadingProv;
        $ctrl.CurrentTreeListService = CurrentTreeListService;

        var initVals = ['tasksFilter', 'tabTasks', 'uId', 'uIdComment', 'uIdList', 'todoPageId',
            'taskBoardId', 'teamIds', 'taskBoard'];

        if (!$ctrl.$onDestroy) {
            $ctrl.$onDestroy = onWorkflowBlockDestroy;
        }

        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl, true);
        }
        $ctrl.rowLoadNow = true;

        $ctrl.sortableContainmentCls = 'kanban-container';
        $ctrl.withoutMultiSelect = true;

        //$ctrl.resetStateDataParams();
        $ctrl.optscompoptions = null;

        $ctrl.constantsService = _.clone(constantsService);

        $ctrl.constantsService.KeyboardServiceParams.canMove = $ctrl.isCommentsSidebar !== true;

        $ctrl.getParams = getParams;
        $ctrl.toggleDarkMode = toggleDarkMode;


        if (!$ctrl.getPageTemplate) {
            console.log('parent for WorkflowBlockCtrlService must define $ctrl.getPageTemplate');
        }

        if(!$ctrl.isScriptPage){
            $ctrl.isScriptPage = false;
        }

        if (params) {
            if ($ctrl.isTaskBoards) {
                var url = '.taskBoards';//'.workflow'
                $ctrl.todoPage = $ctrl.BlocksSetupService.getTodoPageByName(url);
            } else if (params.isCurrentPage) {
                //todo if is in dashboard
                $ctrl.todoPage = $ctrl.BlocksSetupService.getCurrentTodoPage();
            }

            if (params.tasksFilter !== undefined) {
                $ctrl.tasksFilter = params.tasksFilter;
            }

            if (params.tabTasks !== undefined) {
                $ctrl.tabTasks = params.tabTasks;
            }

            if (params.uId !== undefined) {
                $ctrl.uId = params.uId;
            }

            if (params.isWorkflowTree !== undefined) {
                $ctrl.isWorkflowTree = params.isWorkflowTree;
            }
        }

        $ctrl.todoCardsScrollable = '.workflow-cards-scroll-wrapper';
        $ctrl.pictureClass = 'little2';
        $ctrl.colors = $ctrl.WorkflowConstantsService.Colors;

        $ctrl.getSidebarAddon = getSidebarAddon;
        $ctrl.onChangedGroupFilters = onChangedGroupFilters;
        $ctrl.getGroupFilters = getGroupFilters;
        $ctrl.onListItemsQuery = onListItemsQuery;
        $ctrl.reloadWorkflow = reloadWorkflow;
        $ctrl.loadPageGroup = loadPageGroup;
        $ctrl.onWorkflowBlockDestroy = onWorkflowBlockDestroy;
        $ctrl.initDrpParams = initDrpParams;
        $ctrl.onPageLoaded = onPageLoaded1;

        $ctrl.getSelectedFilter = getSelectedFilter;
        if (!$ctrl.onWorkflowInitOther) {
            console.log('parent for WorkflowBlockCtrlService must define $ctrl.onWorkflowInitOther');
        }

        if (!$ctrl.loadPageGroupOther) {
            console.log('parent for WorkflowBlockCtrlService must define $ctrl.loadPageGroupOther');
        }

        if(!$ctrl.getIsArchieved) {
            $ctrl.getIsArchieved = getIsArchieved;
        }
        $ctrl.getIsArchievedInit = getIsArchieved;

        if(!$ctrl.onTreeItemAdded){
            $ctrl.onTreeItemAdded = onTreeItemAdded;
        }

        if($ctrl.isTaskBoards && $ctrl.taskBoard) {
            setTaskBoardParams();

            $ctrl.CurrentTreeListService.addOnTreeListChanged($ctrl.watchers, getTreeChangedParams(), 'BOARDS', onSidebarTreeListChanged);
        }

        setCardsOptions();

        return $ctrl;

        function setTaskBoardParams(){
            $ctrl.taskBoardId = $ctrl.taskBoard ? $ctrl.taskBoard._id : null;
            $ctrl.taskBoardTeamIds = $ctrl.taskBoard ? $ctrl.taskBoard.teamIds : null;
        }

        function getTreeChangedParams() {
            return {
                isCommentsSidebar: false,
                isPrintLayout: $ctrl.isPrintLayout,
                isInTreeModal: $ctrl.isInTreeModal
            }
        }

        function onSidebarTreeListChanged(selectedList){
            console.log('onSidebarTreeListChanged');
            $ctrl.preLoadingService = null;

            setTaskBoardParams();

            if(selectedList && selectedList._id) {
                $ctrl.reloadWorkflow({
                    taskBoardId: selectedList._id,
                    taskBoard: selectedList
                });
            }
        }

        function getGroupOrder(id) {
            return {createdAt: -1};
        }

        function preBroadcastPreload1() {
            console.log('preBroadcastPreload');
            if ($ctrl.loadedFirstTime && $ctrl.prevTodoColumnsForId === getId()) {
                return;
            }
            $ctrl.todoColumns = getTodoColumns();
            if ($ctrl.todoColumns) {
                console.log('setColumns');
                $ctrl.optscompoptions.todoColumns = $ctrl.todoColumns;
                $ctrl.compOptions = JSON.stringify($ctrl.optscompoptions);
            }
            $ctrl.loadedFirstTime = true;
            $ctrl.prevTodoColumnsForId = $ctrl.isTaskBoards ? $ctrl.taskBoardId : $ctrl.productId;

            function getId(){
                return $ctrl.isTaskBoards ? $ctrl.taskBoardId : $ctrl.productId;
            }

            function getTodoColumns() {
                var listTreeService = $ctrl.listTreeService,
                    preLoadingService = listTreeService ? listTreeService.preLoadingService : null;
                return preLoadingService ? preLoadingService.getList(preLoadingService.TblTypes.TodoColumns) : null;
            }
        }

        function getGroupBodyAddon1() {
            var p = {
                'class': '"' + (($ctrl.isLikeWorkflow) ? 'lane-column clearfix' : 'with-side-padding') + '"',
                'comp-options': '"' + ($ctrl.isSidebar ? '' : '::') + '$ctrl.compOptions"',

                'picture-class': '"' + $ctrl.pictureClass + '"',
                'fix-apply': '"{{::$ctrl.fixApply}}"',
                'fix-parent-name': '"{{::$ctrl.fixParentName}}"',
                'fix-offset': '"{{::$ctrl.fixOffset}}"',
                'fix-add-btn': '"{{::$ctrl.fixAddBtn}}"',

                'scrollable-parent': '"::$ctrl.todoCardsScrollable"',
                'scroll-client-y': '"::$ctrl.todoCardsScrollY"',
                'is-child-table': '"::true"',
                'row-load-now': '"::$ctrl.rowLoadNow"'
            };

            if ($ctrl.isTaskBoards) {
                p['is-task-boards'] = '"::$ctrl.isTaskBoards"';
                p['task-board-id'] = '"::$ctrl.taskBoardId"';
                p['task-board'] = '"::$ctrl.taskBoard"';
            }

            if ($ctrl.isScriptPage) {
                p['is-script-page'] = 'true';
            }

            return p;
        }

        function onWorkflowInitOther1() {
            console.log('onWorkflowInitOther1');
            var data = {};


            data['TodoCards'] = $ctrl.listField;
            if($ctrl.listTreeService) {
                $ctrl.listTreeService.listField = $ctrl.listField;
                $ctrl.listTreeService.listFieldForTables = data;
               // $ctrl.listTreeService.preLoadingTableName = $ctrl.isCalendarPage ? 'TodoCards' :
                $ctrl.listTreeService.preLoadingTableName = (($ctrl.listField === 'todoColumnId' || $ctrl.isTaskBoards) ? 'TodoColumns' : 'TodoPages');
            }
            if (!$ctrl.loadedFirstTime) {
                if($ctrl.onPageInit) {
                    $ctrl.onPageInit($ctrl.withPreloaderProperty, null);
                }
            } else {
                if(!$ctrl.preLoadingService){
                    $ctrl.getPreloadingService($ctrl.getOnPageInitParams($ctrl.withPreloaderProperty), function (preLoadingService){
                        $ctrl.startPagePreloadInit(preLoadingService, true, true);
                    } );
                } else{
                    if($ctrl.listTreeService) {
                        $ctrl.listTreeService.preLoadingService.updateListFieldForTables(data);
                    }
                    $ctrl.reloadPageTemplate(false, $ctrl.onPageLoaded);
                }
            }0
        }

        function loadPageGroupOther1() {
            $ctrl.isTasksAllLoaded = true;

            var canCopy = !$ctrl.isCommentsSidebar || $ctrl.isCommentsSidebar && $ctrl.tabTasks === 'tasks',
                params = {
                    constantsService: $ctrl.constantsService,
                    listsService: listsService,
                    service: service,
                    listOptionsService: null,

                    otherOptions: {
                        keyboardServiceParams: {
                            canMove: canCopy,
                            canCopy: canCopy
                        },
                        listTreeServiceParams: {
                            dontStartTreeWithAll: $ctrl.dontStartTreeWithAll
                        },
                        sidebarOptions: {
                            changedFields: ['selectedFilter', 'tasksFilter'],
                            getTreeFilters: $ctrl.getTreeFilters,
                            onTreeItemAdded: $ctrl.onTreeItemAdded
                            //to add todoColumn from modal
                            // getNewTreeItem: getNewTreeItem,
                            // addGroupPopupName: 'createColumn',
                            //  editGroupPopupName: 'updateColumn',
                            // treeAddNotInline: true,
                        },
                        compOptions: JSON.parse($ctrl.compOptions)
                    }
                };

            if($ctrl.tabTasks === 'comments'){
                params.otherOptions.listTreeServiceParams.getGroupOrder = getGroupOrder;
            }

            $ctrl = new PageTreeInitCtrlService($ctrl, $ctrl.$element, params);

            $ctrl.listTreeService.preloadingType =
                $ctrl.isTaskBoards ? $ctrl.PreloadingTypes.TodoCardsBoards :
                    ($ctrl.isCommentsSidebar ? $ctrl.PreloadingTypes.TodoCardsSidebar :
                ($ctrl.isScriptPage ? $ctrl.PreloadingTypes.TodoCardsScripts :
                    $ctrl.PreloadingTypes.TodoCards));
        }

        function onWorkflowBlockDestroyOther1() {
            $ctrl.destroyingWorkflow = true;
            if ($ctrl.onPageGroupDestroy) {
                $ctrl.onPageGroupDestroy();
            }
        }

        function getSelectedIdFromItem2(item, isUndefined) {
            return item ? item[$ctrl.selectedIdField] : (isUndefined?undefined:null);
        }

        function loadPageGroupOther2() {
            onWorkflowInitOther2();

            var p = $ctrl.getParams();
            $ctrl.preLoadingService = $ctrl.PreLoadingProv.getInstance(p, $ctrl.PreLoadingProv.PreloadingTypes.TodoCards);
            $ctrl.TodoColumnsConfigsService.getTodoColumnsForProductAsync($ctrl.CPS.companyId, $ctrl.productId, function (todoColumns) {
                $ctrl.todoColumns = todoColumns;
                $ctrl.preLoadingService.load(function () {
                    $ctrl.isTasksAllLoaded = true;
                    $ctrl.listParams = $ctrl.constantsService.ListParams;
                      $ctrl.listTreeService.loadTreeGroups({
                          companyId: $ctrl.CPS.companyId,
                          productId: $ctrl.productId || null,

                          treeType: $ctrl.treeType,
                          selectedFilter: $ctrl.selectedFilter,

                          withTreeDisplayCount: $ctrl.withTreeDisplayCount,
                          withActiveTree: $ctrl.withActiveTree === true,
                          withActiveGroup: $ctrl.withActiveGroup === true,
                          withArchiveGroupInLists: $ctrl.withArchiveGroupInLists === true,
                          withArchiveGroupAsList: $ctrl.withArchiveGroupAsList === true,

                          getTreeFilters: $ctrl.getTreeFilters,

                          elemType: $ctrl.elemType,
                          service:  service,
                          populate: $ctrl.listParams.populate,
                          includeFields: $ctrl.listParams.includeFields,

                          params: p
                    }, onLoaded, $ctrl.CPS.isCollaborator);
                    /*$ctrl.broadcastRoot('TREE_SERVICE_SET_LIST_' + $ctrl.elemType + '_' + $ctrl.currentListId, $ctrl.preLoadingService.getObjectList($ctrl.preLoadingService.TblTypes.TodoCards, function (item) {
                        return true;
                    }));*/
                    
                    function onLoaded() {
                        onWorkflowInitOther2();
                    }
                });
            });
        }

        function onWorkflowBlockDestroyOther2() {
            $ctrl.destroyingWorkflow = true;
            if($ctrl.templateCompileGroup){
                $ctrl.templateCompileGroup.destroyNewScope();
            }
        }

        function onWorkflowInitOther2() {
            if(!$ctrl.templateCompileGroup) {
                $ctrl.templateCompileGroup = new TemplateCompileService($ctrl.$element, $ctrl.getPageTemplate, $ctrl);
            }
            $ctrl.templateCompileGroup.loadTemplate($ctrl.onPageLoaded);
        }

        function onWorkflowBlockDestroy() {
            if ($ctrl.onWorkflowBlockDestroyOther) {
                $ctrl.onWorkflowBlockDestroyOther();
            }
        }

        function loadPageGroup() {
            onWorkflowBlockDestroy();

            $ctrl.loadPageGroupOther();
            $ctrl.initDrpParams();

            onWorflowInit();
        }
        function initDrpParams() {
            _.each(initVals, function (v){
                initProp(v);
            });
        }

        function initProp(prop) {
            $ctrl[prop + 'Init'] = $ctrl[prop];
        }

        function reloadWorkflow(result) {
            if (result) {
                var changed = false;
                _.each(initVals, function (v){
                    process(v);
                });

                if (changed) {
                    onWorflowInit();
                }

                function process(prop) {
                    var val = result[prop];
                    if (val !== undefined && $ctrl[prop + 'Init'] !== val) {
                        $ctrl[prop] = val;
                        changed = true;
                    }
                }
            }
        }

        function onWorflowInit() {
            console.log('onWorflowInit');
            setCardsOptions();

            setCommentsTreeList();
            $ctrl.onWorkflowInitOther();
        }

        function setCardsOptions() {
            // if(!$ctrl.todoPage){$ctrl.todoPage = $ctrl.BlocksSetupService.getCurrentTodoPage();}
            var pageName = $ctrl.todoPage ? $ctrl.todoPage.name : null;
            console.log('initTaskCardsParams: ' + pageName);
            if (!$ctrl.isInModal) {
                $ctrl.isInModal = false;
            }
            $ctrl.isWorkflow = pageName === 'user.product.workflow' || $ctrl.isTaskBoards;
            $ctrl.isDashboard = pageName === 'user.product.overview';
            $ctrl.isCalendarPage = pageName === 'user.product.calendar' || pageName === 'user.calendar';
            $ctrl.isScriptPage = pageName === 'user.product.script-outline' || $ctrl.isInModal && pageName === 'user.product.script';
            $ctrl.isLikeWorkflow = $ctrl.isWorkflow || $ctrl.isScriptPage;
            $ctrl.withoutCheatSheet = !$ctrl.isWorkflow;
            $ctrl.isCommentsTab =  $ctrl.tabTasks === 'comments';
            $ctrl.isArchivedTab =  $ctrl.tabTasks === 'archived';

            var withActive = !$ctrl.isCommentsSidebar && $ctrl.isLikeWorkflow ||
                $ctrl.isCommentsSidebar && ($ctrl.tabTasks === 'tasks' || $ctrl.isArchivedTab);
            $ctrl.optscompoptions = _.extend({},
                $ctrl.constantsService.CompOptions, {
                    isCalendarPage: $ctrl.isCalendarPage,
                    isScriptPage: $ctrl.isScriptPage,
                    isCommentsSidebar: $ctrl.isCommentsSidebar,

                    withArchiveGroupInLists: withActive,
                    withActiveGroup: withActive
                });

            if($ctrl.isCommentsSidebar && $ctrl.isArchivedTab) {
                $ctrl.optscompoptions.withArchiveInActiveGroup = true;
            }

           //todo -> figure out the tree structure
           $ctrl.isWithColumns = true;// ($ctrl.isLikeWorkflow && $ctrl.isWorkflowTree) || $ctrl.isDashboard;
           $ctrl.optscompoptions.listField = ($ctrl.isCommentsTab || $ctrl.isArchivedTab) ? 'todoPageId' : (($ctrl.isCommentsSidebar && $ctrl.isDashboard || !$ctrl.isCommentsSidebar && ($ctrl.isLikeWorkflow && $ctrl.isWorkflowTree)) ? 'todoColumnId' : 'todoPageId');

            // $ctrl.optscompoptions.listField = ($ctrl.isWithColumns && $ctrl.isCommentsTab) ? 'todoPageId' : ($ctrl.isWithColumns ? 'todoColumnId' : 'uId');
            $ctrl.optscompoptions.withDuplicateGroupItem = $ctrl.tabTasks === 'tasks' && $ctrl.canEdit && !$ctrl.isDashboard;
            /*
                            'tab-tasks': '"'+($ctrl.isLikeWorkflow?'::':'')+'$ctrl.tabTasks"',
                            'tasks-filter': '"'+($ctrl.isLikeWorkflow?'::':'')+'$ctrl.tasksFilter"',
            */
            $ctrl = _.extend($ctrl, $ctrl.optscompoptions);

            $ctrl.optscompoptions = _.extend({}, $ctrl.optscompoptions, {
                tasksFilter: $ctrl.tasksFilter,
                todoPage: $ctrl.todoPage,
                isCalendarPage: $ctrl.isCalendarPage,
                isScriptPage: $ctrl.isScriptPage,
                isCommentsSidebar: $ctrl.isCommentsSidebar,

                isLikeWorkflow: $ctrl.isLikeWorkflow,
                isWorkflow: $ctrl.isWorkflow,
                isDashboard: $ctrl.isDashboard,
                isInModal: $ctrl.isInModal,
                isWithColumns: $ctrl.isWithColumns,

                tabTasks: $ctrl.tabTasks,
                uId: $ctrl.uId,
                uIdList: _.extend({}, $ctrl.uIdList, {currentItemLikes: null}),
                isTaskBoards: $ctrl.isTaskBoards,
                taskBoardId: $ctrl.taskBoardId,
                taskBoard: $ctrl.taskBoard
            });

            if ($ctrl.todoColumns) {
                console.log('setColumns');
                $ctrl.optscompoptions.todoColumns = $ctrl.todoColumns;
            }
            if ($ctrl.isLikeWorkflow && !$ctrl.isCommentsSidebar) {
                $ctrl.treeClass = '.swimlane-wrapper';
            }

            if ($ctrl.isScriptPage) {
                $ctrl.optscompoptions.quotaType = 'scriptOutline';
                $ctrl.optscompoptions.maxFreeItemsCount = 5;
            }

            //todo figure out the rules
            setSelected();

            //initTaskCardsParams
            if ($ctrl.todoPage) {

                //todo what if is in dashboard widget
                var stateParams = $ctrl.SBStateService.getCurrentStateParams();
                $ctrl.optscompoptions.todoPageId = $ctrl.todoPage._id;

                //set uId from the tree list
                if (!$ctrl.optscompoptions.uId && $ctrl.isCommentsSidebar && $ctrl.CommentsSidebarService.isListLevel($ctrl.sidebarType)) {
                    $ctrl.optscompoptions.uId = $ctrl.todoPage.uId && stateParams ? stateParams[$ctrl.todoPage.uId] : null;
                }
                //todo figure out how to not interfere with edit popup
                /* if ($ctrl.canComment ) {
                     var card =  stateParams ? stateParams.card : null;
                     if (card !== null && card !== undefined && !card.isOnlyComment) {
                         //todo replace with value from the client cache
                         $ctrl.service.getById(card, "createdById todoColumnId", function (todoCard) {
                             if (todoCard) {
                                 todoCard.todoPage = $ctrl.todoPage;
                                 if (todoCard && todoCard._id === card) {
                                     $ctrl.tabTasks = card !== undefined && card !== null;
                                     console.log('operations.updateTaskCard: ' + card);
                                     $ctrl.popupsService.open(todoCard, $ctrl.popupsService.operations.updateTaskCard, 'task card', {
                                         compOptions: $ctrl.compOptions,
                                         listTreeService: $ctrl.listTreeService
                                     }, true);
                                 }
                             }
                         });
                     }
                 }*/
            }

            $ctrl.compOptions = JSON.stringify($ctrl.optscompoptions);

            if ($ctrl.isWithColumns) {
                $ctrl.preBroadcastPreload = preBroadcastPreload1;
                $ctrl.getGroupBodyAddon = getGroupBodyAddon1;

                $ctrl.onWorkflowInitOther = onWorkflowInitOther1;
                $ctrl.onWorkflowBlockDestroyOther = onWorkflowBlockDestroyOther1;
                $ctrl.loadPageGroupOther = loadPageGroupOther1;
            } else {
                $ctrl.selectedIdField = '_id';
                $ctrl.preLoadingTableName = 'TodoCards';

                $ctrl.onWorkflowInitOther = onWorkflowInitOther2;
                $ctrl.onWorkflowBlockDestroyOther = onWorkflowBlockDestroyOther2;
                $ctrl.loadPageGroupOther = loadPageGroupOther2;
            }
        }

        function setSelected() {
            $ctrl.selectedFilter = (($ctrl.isLikeWorkflow || $ctrl.isCalendarPage) && $ctrl.isArchivedTab) ? false : true;
            if ($ctrl.filtersService) {
                $ctrl.filtersService.selectedFilter = $ctrl.selectedFilter;
            }
        }

        function setCommentsTreeList() {
            if($ctrl.isWithColumns) {return;}
            $ctrl.filtersService = new $ctrl.FiltersService($ctrl.constantsService, null);
            setSelected();


            $ctrl.currentListId = $ctrl.uId || null;
            $ctrl.currentList = {};
            $ctrl.currentList[$ctrl.selectedIdField] = $ctrl.currentListId;

            $ctrl.listTreeService = {
                filtersService: $ctrl.filtersService,
                active: {
                    selectedListId: $ctrl.currentListId,
                    selectedList:  $ctrl.currentList
                },
                selectedIdField: $ctrl.selectedIdField,
                getSelectedIdFromItem: getSelectedIdFromItem2
            };
        }

        function getIsArchieved(){
            return ($ctrl.isLikeWorkflow||$ctrl.isCalendarPage) && $ctrl.isCommentsSidebar && $ctrl.tabTasks === 'archived';
        }

        function getSidebarAddon() {
            var isArchived = getIsArchieved();
        return 'comp-options="' + ($ctrl.isLikeWorkflow ? '::' : '') + '$ctrl.compOptions" ' +
                'with-add-column="::$ctrl.isLikeWorkflow" ' +
                'with-sortable="::' + (!isArchived || !$ctrl.isCommentsSidebar && $ctrl.canEdit === true) + '" ' +
                (isArchived ? 'selected-filter="::false"' : '') +
                (!isArchived && $ctrl.isLikeWorkflow && $ctrl.constantsService.CompOptions.canDragPredefTreeItem ? ('can-drag-predef-tree-item="true" ') : '') +
                'get-group-body="$ctrl.getGroupBody(result)" ' +
            ($ctrl.getSidebarAddonOther ? $ctrl.getSidebarAddonOther() : '');
        }

        function onChangedGroupFilters(type, val) {
            console.log('onChangedGroupFilters');
            if (initVals.indexOf(type) !== -1) {
                var data = {};
                data[type] = val;
                if(type === 'tasksFilter') {
                    setFilterTasks();
                }
                $ctrl.reloadWorkflow(data);
            }
        }
        
        function setFilterTasks() {
            if($ctrl.element) {
                $ctrl.LCS[$ctrl.isCommentsTab ? 'removeClass' : 'addClass']($ctrl.element.querySelector('drpFilterstasksFilter'), 'sb-hide');
            }
        }

        function getGroupFilters() {
            var res = {};// _.extend({}, $ctrl.getParams());
            var selectedFilter = $ctrl.getSelectedFilter();
            if (selectedFilter) {
                // we dont add based on tree, based on listfield cause we have 3 options
                if ($ctrl.todoPage && !(($ctrl.isLikeWorkflow && $ctrl.isWorkflowTree) || $ctrl.isDashboard)) {
                    res.todoPageId = $ctrl.todoPage._id;
                }

                if($ctrl.todoPage && $ctrl.todoPage.uId && $ctrl.uId && (
                    $ctrl.isWorkflow && !$ctrl.isCommentsSidebar ||
                    $ctrl.fileComments ||
                    $ctrl.isCommentsSidebar &&
                        ($ctrl.sidebarType === $ctrl.LCS.SidebarTypes.ListTasks && $ctrl.isTasksTab || //6
                       $ctrl.sidebarType === $ctrl.LCS.SidebarTypes.ListComments && $ctrl.isCommentsTab || //4
                        $ctrl.sidebarType === $ctrl.LCS.SidebarTypes.ListArchived && $ctrl.isArchivedTab) //9
                ))  {
                    res.uId = $ctrl.uId;
                }
                res.isOnlyComment = ($ctrl.isCommentsTab || $ctrl.fileComments) === true;
            }

            //res.active = $ctrl.filtersService.selectedFilter === true;
           // res.type = ($ctrl.isOnPage || $ctrl.isWorkflow) ? 1 : ($ctrl.isCalendarPage ? 2 : 3); // check based on calendar

            if($ctrl.isCommentsTab) {
                //$ctrl.tasksFilter === 0 -> all (dont include completed filter)
                if ($ctrl.tasksFilter === 1) {//Completed
                    res.completed = true;
                } else if ($ctrl.tasksFilter === 2) {//Uncompleted
                    res.completed = false;
                }
            }else{
                res.active = !($ctrl.isCommentsSidebar && $ctrl.isArchivedTab);
            }

            return res;
        }

        function onListItemsQuery() {
            return function (item) {
                if(!item){return false;}
                var selectedFilter = $ctrl.getSelectedFilter();
                if (selectedFilter) {
                    // we dont add based on tree based on listfield cause we have 3 options
                    if (!(($ctrl.isLikeWorkflow && $ctrl.isWorkflowTree) || $ctrl.isDashboard)) {
                        if(item.todoPageId !== $ctrl.todoPage._id){return false;}
                    }else if($ctrl.todoPage.uId && $ctrl.uId && item.uId !== $ctrl.uId){return false;}

                    if (item.isOnlyComment !== $ctrl.isCommentsTab) {
                        return false;
                    }
                }

                if(item.active !== selectedFilter){return false;}

             /*   if(item.type === 1 && ! ($ctrl.isOnPage || $ctrl.isWorkflow)){ return false;}
                if(item.type === 2 && !$ctrl.isCalendarPage){ return false;}
                if(item.type === 3 && !$ctrl.isScriptPage){ return false;}
*/
                return $ctrl.tasksFilter === 0 || //return all
                     $ctrl.tasksFilter === 1 && item.completed || //return completed
                    $ctrl.tasksFilter === 2 && !item.completed; //return uncompleted
            }
        }

        function getParams() {
            return _.extend({
                companyId: $ctrl.CPS.companyId,

                productId: $ctrl.productId ? $ctrl.productId : null
            }, $ctrl.isTaskBoards ? {
                taskBoardId: $ctrl.taskBoardId
            } : null, getOtherParams());

            function getOtherParams(){
                if($ctrl.isCommentsSidebar && $ctrl.isCalendarPage && $ctrl.tabTasks === 'archived') {
                    return {type: 2, uId: $ctrl.uId, active: false};
                }

                if($ctrl.isWorkflow && !$ctrl.isCommentsSidebar){
                    return _.extend({
                            type: $ctrl.isCalendarPage ? 2 : ($ctrl.isScriptPage ? 3 : 1)//is script outline
                        },
                        ($ctrl.fileComments || $ctrl.todoPage && $ctrl.todoPage.uId) ? {uId: $ctrl.uId || null} : null
                        //$ctrl.isOnlyCommentNot ? null : {isOnlyComment: $ctrl.isCommentsTab}
                    );
                }

                return $ctrl.fileComments ? {
                    type: 1, //all sidebar events should be added to the workflow page
                    isOnlyComment: true
                } : (!($ctrl.isCommentsSidebar && $ctrl.isCommentsTab) && !$ctrl.isScriptPage ? {
                    type: 1, //all sidebar events should be added to the workflow page
                    isOnlyComment: {$ne: true}
                } : {type: $ctrl.isScriptPage ? 3 : 1});
            }

        }

        function onPageLoaded1() {
            console.log('loadAll TodoCards');
            $ctrl.initDrpParams();

            setFilterTasks();
        }

        function toggleDarkMode(){
            $ctrl.isDarkMode = !($ctrl.isDarkMode === true);
        }

        function getSelectedFilter() {
            return $ctrl.filtersService && $ctrl.filtersService.selectedFilter !== false || !$ctrl.filtersService;
        }

        //on new column added
        function onTreeItemAdded(result){
            if($ctrl.isWithColumns){
                $ctrl.preLoadingService = null;
                $ctrl.todoColumns = null;
                onWorflowInit();
            }
        }
    }
}

angular.module('product.workflowBoard.controller.service', [
    'apiConstants.product.workflow.services',
    'product.workflow.page.init.controller.service'
])
.service('WorkflowBoardCtrlService', WorkflowBoardCtrlService);
WorkflowBoardCtrlService.$inject = ['WorkflowPageInitCtrlService', 'WorkflowConstantsService'];
function WorkflowBoardCtrlService(WorkflowPageInitCtrlService, constantsService) {
    return function ($ctrl, $element, printPageParams) {
        $ctrl.onPreInit = onPreInit;
        if(!$ctrl.onPostInit) {
            $ctrl.onPostInit = onPostInit;
        }

        if (printPageParams && printPageParams.constantsService) {
            $ctrl.constantsServiceInit = _.extend({}, printPageParams.constantsService);
        }
        if (!$ctrl.constantsServiceInit) {
            $ctrl.constantsServiceInit = _.extend({}, constantsService);

        }

        $ctrl = new WorkflowPageInitCtrlService($ctrl, $element, $ctrl.constantsServiceInit);

        return $ctrl;

        function onPreInit() {
            if(!$ctrl.treeType) {
                $ctrl.treeType = 1;
            }
            $ctrl.definedInPageTree = true;
            $ctrl.isDarkMode = false;
            if($ctrl.onPreInitOther){
                $ctrl.onPreInitOther();
            }
        }

        function onPostInit() {
            $ctrl.title = $ctrl.todoPage ? $ctrl.todoPage.text : 'Tasks';
        }
    }
}



angular.module('apiConstants.products.services', [
    'sb.fields.types.service',
    'compOptions.products.constant'
])
.service('ProductConstantsService', ProductConstantsService);
ProductConstantsService.$inject = ['SBFieldTypesService', 'ProductCompOptions'];
function ProductConstantsService(SBFieldTypesService, compOptions) {
    var popupTemplate = getBasePopupTemplateByTag('product-edit');
    var PropTypes = SBFieldTypesService.PropTypes,

        Options = {
             columns: ['1', '2', '3', '5', '4'],
            view: 3,
            column: 3
        },

        Settings = {
            Columns: angular.copy(SBApiGridColumns['products'](PropTypes))
        },

        Filters = [{value: true, text: 'Active'}, {value: false, text: 'Archived'}],

        CompOptions = angular.copy(compOptions),

        ListTreeServiceParams = {
            maxLevel: 1,
            hideLevel0: true,
            withHarcodedAll: true,
            withArchiveGroupAsList: true, // display archive as a list
            dontStartTreeWithAll: true,

            level0Name: 'All Projects',
            // cachedListName: 'productsList',
            preLoadingTableName: 'ProductsLists',


            withLabelAfter: CompOptions.withLabelAfter ? CompOptions.withLabelAfter : (CompOptions.nameForLists ? CompOptions.nameForLists : (CompOptions.nameForList + 's')),
            moveInGroup: CompOptions.moveInGroup,
            ungroupOnTreeDelete: true,

            listCheckerConsidersItemsCount: true
        },

        ListParams = {
            includeFields: ['active', 'name', 'logo', 'logoId', 'createdById', 'order', 'orderAll', 'createdAt', 'updatedAt'],
            searchFields: ['name', 'production'],
            orderFields: ['order', 'createdBy.name', 'createdAt', 'createdAtT', 'updatedAt', 'updatedAtT', 'orderAll'],
            populate: 'createdById',

            defaultOrder: 'updatedAtT',
            defaultOrderDir: -1
        },

        KeyboardServiceParams = {
            canMove: ListTreeServiceParams.moveInGroup,
        },

        PopupOperations = {

            companySettings: {
                type: 'Company Settings',
                template: getBasePopupTemplateByTag('company-settings'),
                backdrop: true,
                size: 'sm'
            },

            createProductsGroup: {
                type: 'Create',
                template: getBasePopupTemplateByTag('product-group-item'),
                size: 'medium',
                transp: ' '
            },

            updateProductsGroup: {
                type: 'Edit',
                template: getBasePopupTemplateByTag('product-group-item'),
                size: 'medium',
                transp: ' '
            },
        },

        Hotkeys = null,

        SidebarOptions = {
            removeAdditionalMessage: ' and all the projects within it',
            ungroupAdditionalMessage: ' This group\'s projects will be moved within <b>All Projects</b>',
        };

    return {
        PropTypes: PropTypes,
        Settings: Settings,
        Options: Options,
        Filters: {Filters: Filters},
        ViewProp: 'productView',

        CompOptions: CompOptions,
        ListTreeServiceParams: ListTreeServiceParams,
        ListParams: ListParams,
        KeyboardServiceParams: KeyboardServiceParams,

        SidebarOptions: SidebarOptions,
        PopupOperations: PopupOperations,
        Hotkeys: Hotkeys
    };
}

