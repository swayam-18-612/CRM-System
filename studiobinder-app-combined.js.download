angular.module('product.sidesPage.service', [
    'product.reportsPage.init.controller.service',
    'apiConstants.sides.services',
    'product.sides.scriptSides.component',
    'services.downloadExport'
])

.constant('SidesPageCtrlServiceInjectors', {
    pageCtrlService: 'ReportsPageInitCtrlService',
    constantsService: 'SidesConstantsService',

    //service: 'LocationsService',
    DownloadExportService: 'DownloadExportService'

})
.service('SidesPageCtrlService', SidesPageCtrlService);

SidesPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'SidesPageCtrlServiceInjectors'];
function SidesPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    return function($ctrl, $element, printPageParams) {

        $ctrl.selectedScene = null;
        $ctrl.selected = [];

        $ctrl.scriptSides = {
            showDetails: false,
            showNotes: false,

            showTagging: true,
            withTagging: false,
            loadTags: true,

            withHeader: false,
            withDayHeader: false,
            pageBreak: false,
            dayBreak: false,
            showHeader: true,
            showOmitted: true,
            showBoneyard: false
        };

        $ctrl.scriptSidesJson = JSON.stringify($ctrl.scriptSides);

        $ctrl.DisplayFilters = [
            {_id: 5, name: 'Header', prop: 'showHeader'},
            {_id: 2, name: 'Scene Headers', prop: 'withHeader'},
            {_id: 12, name: 'Day Headers', prop: 'withDayHeader'},

            {_id: 3, name: 'Page Break after Scenes', icon: 'split-horizontal', prop: 'pageBreak'},
            {_id: 4, name: 'Page Break after Shoot Days', icon: 'split-horizontal', prop: 'dayBreak'},

            {_id: 6, name: 'Omitted Scenes', icon: 'box', prop: 'showOmitted' },
            {_id: 7, name: 'Boneyard', icon: 'boneyard', prop: 'showBoneyard'},
            {_id: 8, name: 'Tagged Elements', icon: 'category', prop: 'showTagging'},
        ];

        $ctrl.getPageTemplateOther = getPageTemplateOther;
        $ctrl.additionalScriptInitOther = additionalScriptInitOther;
        $ctrl.getHeaderTitle = getHeaderTitle;
        $ctrl.getEmptyStateButtons = getEmptyStateButtons;
        $ctrl.downloadSBX = downloadSBX;
        $ctrl.getCollabBannerInfo = getCollabBannerInfo;


        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);
        //$ctrl = new ReportsCtrlService($ctrl, constantsService, $element);

        return $ctrl;

        function getCollabBannerInfo(){
            return {txt: 'Generate and share your own script sides for free.', campaign:'collab-sides'};
        }
        function additionalScriptInitOther() {
            if ($ctrl.stripsCount > 0) {
                $ctrl.LCS.PersistenceService.setScriptsViewed($ctrl.CPS.productId, true);
            }
        }

        function downloadSBX(e){
            $ctrl.preventDefault(e);
            var timestamp = $ctrl.MomentService.getTimestamp(),
                script = $ctrl.CPS.product.script,
                filename = script.name + (script.version ? (' v' + script.version) : '') + ' ' + moment(timestamp).format('MM-DD-YY_HH-mm') + '.sbx',
                content = '';
            _.each($ctrl.element.querySelectorAll('.script-sides .scene-tagging-item .scene-content'), function (c){
                content += c.innerHTML;
            });
            $ctrl.DownloadExportService.downloadAttachment($ctrl.DownloadExportService.createBlobFromContent(filename, content, timestamp));
        }

        function getHeaderTitle(type) {
            return $ctrl.LCS.getISBDiv($ctrl.isReports ? 'reports' : 'sides', 6, 'pull-left with-margin-right gray') +
                '<span class="report-name">' + type +
                '<div class="sb-hide ' + $ctrl.Types.Days + ' inline-block">: <span class="name"></span></div>' +
                '</span>';
        }

        function gotoscene(id) {
            $ctrl.selectedScene = id;
            $ctrl.anchorScroll('scene' + id);
        }

        function getEmptyStateButtons() {
            return '<import-script ' +
                ($ctrl.pageClass ? ('page-class="'+$ctrl.pageClass+'" ') : '') +
                'btn-class="btn btn-primary ' + ($ctrl.pageClass || '') + '" show-title="true" show-text-on-ipad="true"></import-script>';
        }

        function getCSSStyle() {
    return '<style>' +
               '@media print{' +
        '.reports-table{margin:0!important}'+
                   'body{zoom: 1; margin:0;padding:0}' +
                   'div.headerSCRIPT {' +
                       'display: block; text-align: center;' +
                       'position: running(headerSCRIPT);' +
                   '}' +
                   'div.footerSCRIPT {' +
                       'display: block; text-align: center;' +
                       'position: running(footerSCRIPT);' +
                   '}' +
                   '@page{' +
                       'size: 8.5in 11in;' +
                        'margin: 1in 0 1in 0;' +
                       /*
                       'counter-increment:page;' +
                       '@bottom-right{content:counter(page) " of " counter(pages)}' +
                       '@top-center{content:element(headerSCRIPT)}' +
                       '@bottom-center{content:element(footerSCRIPT)}'
                       */
                   '}' +
                   '.incrementClass:before {' +
                       'counter-increment: page;' +
                   '}' +
                   '.scene-taggings{padding-top:0!important;padding-bottom:0!important;}' +
               '}' +
           '</style>';
        }

        function getPageTemplateOther() {
            return '<div ' + ($ctrl.scriptSides.showHeader ? '' : 'class="spacing"') + '>' +
                getCSSStyle() +
                '<script-sides ' +
                'class="script-sides display-block clearfix" ' +
                'ng-show="$ctrl.selected.length>0" ' +
                'script-sides-json="$ctrl.scriptSidesJson" ' +
                'strips="$ctrl.selected" ' +
                'day-breaks="$ctrl.FiltersD" ' +
                'script-loading-service="::$ctrl.scriptLoadingService" ' +

                //todo: set for faster processing:
                "tagging-scenes='::$ctrl.taggingScenes' " +
                "categories='::$ctrl.categories' " +
                "elements='::$ctrl.elements'" +
                '></script-sides>' +
                '<div ng-if="$ctrl.selected.length==0" class="centered">' + getTableEmpty() + '</div>' +
                '</div>';
        }

        function getTableEmpty() {
    return '<div class="spacing-top" style="border-bottom:2px solid #EBEFF2">&nbsp;</div>' +
        '<div style="height:300px" class="table-div full-width">' +
            '<div class="text-center centered">' +
                $ctrl.LCS.getISBDiv('sides', 4, ' big text-center gray sbf40 margin-bottom-half') +
                '<div class="text-center">' +
                    '<div class="text-center">There are no scenes that match your filters</div>' +
                    '<div class="text-center margin-top-half min-height-40">' +
                        '<a ng-click="$ctrl.removeFiltersAndReload($event)" class="btn btn-small transparent">' +
        $ctrl.LCS.getISBDiv('cancel', 2, 'pull-left') +
        ' Remove Filters</a>' +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</div>';
        }
    }

}

angular.module('product.sides.scriptSides.component', [
'product.sides.scriptSides.service'
])
.component('scriptSides', {
    bindings: {
        scriptSidesJson: '<', //withTagging, withHeader, withDayHeader, showTagging, loadTags, pageBreak
        strips: '<?',
        scriptLoadingService: '<',

        dayBreaks: '<',
        taggingScenes: '<',
        categories: '<',
        elements: '<',

    },
    template: '<div class="document-version-wrapper"><div class="scene-taggings list with-padding"></div></div>',
    controller: 'ScriptSidesComponentCtrl'
})
.controller('ScriptSidesComponentCtrl',ScriptSidesComponentCtrl);
ScriptSidesComponentCtrl.$inject = ['ScriptSidesCtrlService','TemplateCompileCompCtrlService', '$element'];
function ScriptSidesComponentCtrl(ScriptSidesCtrlService, TemplateCompileCompCtrlService, $element) {

    var $ctrl = this;
    $ctrl.ScriptSidesCtrlService = ScriptSidesCtrlService;

    $ctrl.changedFields = ['strips', 'scriptSidesJson'];
    $ctrl.$onChanges = $onChanges;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new $ctrl.ScriptSidesCtrlService ($ctrl);
    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element.find('.scene-taggings'));

    function preInit() {
        $ctrl.StripsService = $ctrl.scriptLoadingService.getObjectService($ctrl.scriptLoadingService.TblTypes.Strips);

        if($ctrl.scriptSidesJson){
            $ctrl.scriptSides = JSON.parse($ctrl.scriptSidesJson);
        }
        else if (!$ctrl.scriptSides) {
            $ctrl.scriptSides = {
                showDetails: false,
                showNotes: false,

                loadTags: false,
                showTagging: false,
                withTagging: false,

                withHeader: false,
                withDayHeader: false,
                pageBreak: false,
                dayBreak: false,
                showHeader: true,
                showOmitted: true,
                showBoneyard: false
            };
        }
        $ctrl.previousSides = $ctrl.scriptSides || {};
        $ctrl.previousStrips = $ctrl.strips;
        $ctrl.getScenePage = $ctrl.SBFieldMethods.getScenePage;

        console.log('loadScenes');
    }

    function $onChanges(changes) {
        if (!changes) {
            return;
        }

        console.log('ScriptSidesComponentCtrl.$onChanges');
        console.log(changes);

        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i];
            var change = changes[field];
            if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                if(field ==='strips'){
                    console.log('strips changed');
                    processStrips();
                    break;
                }else if(field ==='scriptSidesJson'){
                    console.log('scriptSidesJson changed');
                    $ctrl.scriptSides = $ctrl.scriptSidesJson ? JSON.parse($ctrl.scriptSidesJson) : null;
                    if ($ctrl.scriptSides && !angular.equals($ctrl.previousSides, $ctrl.scriptSides)) {
                        processSides('showTagging', onShowTagging);
                        processSides('showHeader', $ctrl.togglePageHeader);
                        processSides('withHeader', $ctrl.toggleHeaders);
                        processSides('withDayHeader', $ctrl.toggleDayHeaders);
                        processSides('pageBreak', $ctrl.togglePageBreaks);
                        processSides('dayBreak', $ctrl.toggleDayBreaks);
                        processSides('showTagging', $ctrl.toggleShowTagging);
                       // processSides('withTagging', $ctrl.reloadTemplate);
                     //   showHeader: true   ??
                    }
                    break;
                }
            }
        }
    }

    function processSides(prop, method) {
        if($ctrl.previousSides[prop] !== $ctrl.scriptSides[prop]){
            method();
            $ctrl.previousSides[prop] = $ctrl.scriptSides[prop];
        }
    }

    function processStrips() {
        if ($ctrl.previousStrips !== $ctrl.strips) {
            console.log('processStrips');
            $ctrl.reloadTemplate();
            $ctrl.previousStrips = $ctrl.strips;
        }
    }

    function onShowTagging(newVal, oldVal) {
        console.log('onShowTagging');
        if ($ctrl.scriptSides.showTagging !== $ctrl.previousSides.showTagging) {
            $ctrl.toggleShowTagging();
        }
    }

    function getItemTemplate(){
        $ctrl.withTagging = $ctrl.scriptSides.withTagging;
        $ctrl.loadTags = $ctrl.scriptSides.loadTags;
        $ctrl.toggleShowTagging();
        return $ctrl.getStripsTemplate ($ctrl.strips);
    }
}

angular.module('product.sides.scriptSides.service', [
])
.service('ScriptSidesCtrlService', ScriptSidesCtrlService);
function ScriptSidesCtrlService() {
    return function($ctrl){
        var sidePaddingCls = 'screenplay-side-padding';
        $ctrl.setupNameInLine = 'End of ';

        $ctrl.togglePageBreaks = togglePageBreaks;
        $ctrl.toggleDayBreaks = toggleDayBreaks;
        $ctrl.toggleShowTagging = toggleShowTagging;
        $ctrl.toggleHeaders = toggleHeaders;
        $ctrl.toggleDayHeaders = toggleDayHeaders;
        $ctrl.togglePageHeader = togglePageHeader;
        $ctrl.getStripsTemplate = getStripsTemplate;
        $ctrl.getSceneContentInit = getSceneContent;
        $ctrl.getSceneContent = getSceneContent;
        $ctrl.getRowHeader = getRowHeader;
        $ctrl.getRowHeaderPages = getRowHeaderPages;
        $ctrl.getScriptSidesCls = getScriptSidesCls;
        $ctrl.editScene = editScene;

        return $ctrl;

        function togglePageBreaks() {
            return toggle('pageBreak');
        }

        function toggleDayBreaks() {
            toggle('dayBreak');
        }

        function toggleHeaders() {
            toggle('withHeader');
        }

        function toggleDayHeaders() {
            toggle('withDayHeader');
        }

        function toggleShowTagging(){
            //if !show tagging add class hide-taggings
            $ctrl.LCS[(!$ctrl.loadTags || !$ctrl.scriptSides.showTagging) ? 'addClass' : 'removeClass']($ctrl.element, 'hide-taggings');
        }

        function togglePageHeader() {
            $ctrl.broadcastRoot('ON_SHOW_HEADER');
        }
        function toggle(prop) {
            var show = $ctrl.scriptSides[prop];
            var els = $ctrl.element.querySelectorAll('.script-'+prop);
            if (els && show !== $ctrl.previousSides[prop]) {
                $ctrl.LCS[$ctrl.scriptSides[prop] ? 'removeClass' : 'addClass'](els, 'sb-hide');
            }
            return show;
        }

        function getStripsTemplate(list){
            console.log('getStripsTemplate');
            if(!list || !list.length){return '';}
            var el = '',
                days = {},
                dbl = 0;

            if($ctrl.dayBreaks && $ctrl.dayBreaks.length > 0) {
                setDays();
            }

            if(dbl){
                _.each($ctrl.dayBreaks, function(d, i) {
                    el += getDayContent(d, dbl - 1 === i);
                });
            }else {
                _.each(list, function (item, i) {
                    el += get(item, i);
                });
            }

            return el;

            function setDays(){
                _.each(list, function (item, i) {
                    if(!days[item.scheduleDayId]){
                        days[item.scheduleDayId] = [];
                        dbl++;
                    }

                    days[item.scheduleDayId].push(i);
                });
            }

            function getDayContent (d, isLast){
                var els = days[d._id],
                    sl = els ? els.length : 0;

                if(!sl) {return '';}

                var el ='';
                _.each(els, function (index, i) {
                    el += get(list[index], index, sl - 1 === i);
                });

                return getHeader(d, true) + el + getDay(d, isLast);
            }

            function get(item, index, isLast){
                switch (item.type) {
                    case 1: return getScene(item, index,
                        //is last in day break or is last in general
                        $ctrl.scriptSides.dayBreak ? isLast : (list.length - 1 === index));
                    case 0: return getDay(item, isLast);
                    case 2: return getBanner(item);
                }
            }

            function getDay(item, isLast){
                return getDayBreak(item) +
                    (isLast ? '' : getBreak(item, 'dayBreak'));
            }

            function getDayBreak(item) {
                var d = '<span class="long-dash">&nbsp;–&nbsp;</span>';
                return '<div class="strip-item day-break text-center margin-half ' + sidePaddingCls + '">' +
                    '<span class="name">' + $ctrl.setupNameInLine + '&nbsp;' + (item.name || '') + '</span>' +
                    (item.pages.value ? (d +
                        'Pgs: ' + (item.pages.page ? ('<span class="page font-size-12">' + item.pages.page + '</span>&nbsp;') : '') +
                        '<span class="fr">' + item.pages.fr + '</span>') : '') +
                    (item.date ? (d +
                        '<span>' + $ctrl.CPS.getCreatedAt(item.date, $ctrl.CPS.shortDateFormat) + '</span>') : '') +
                    (item.startTime ? (d + (item.date ? ' @ ' : '') + $ctrl.SBFieldMethods.getEstVal(item.startTime)) : '') +
                    (item.estTime ? (d + '<span class="semibold">Est. Time </span>' + $ctrl.SBFieldMethods.getEstVal(item.estTime)) : '') +
                   // (item.duration ? (d + '<span class="semibold">Duration </span>' + $ctrl.SBFieldMethods.getEstVal(item.duration, true)) : '') +

                    (item.note ? ('<div class="full-width">' + item.note + '</div>') : '')+
                    '</div>';
            }

            function getBanner(item){
                var d='<span class="long-dash">&nbsp;–&nbsp;</span>';
                return '<div class="strip-item day-break text-center margin-half">' +
                    (item.name ? ('<span class="name"> '+item.name+'</span>') : '') +
                   // (item.startTime ? $ctrl.SBFieldMethods.getEstVal(item.startTime) : '') +
                    //(item.estTime ? ('<span class="semibold">Est. Time</span>' + $ctrl.SBFieldMethods.getEstVal(item.estTime)) : '') +
                    (item.note ? ('<div class="full-width">' + item.note + '</div>') : '')+
                    '</div>';
            }

            function getHeader(item, isDayBreak){
                return $ctrl.getRowHeader(item, 'scene-wrapper', isDayBreak);
                //return '<div class="document-version-wrapper">' + h + '</div>';
            }

            function getScene(item, i, isLast){
            return getHeader(item, false) +
                    $ctrl.getSceneContent(item, i) +
                (isLast ? '' : getBreak(item, 'pageBreak'));
       // ($ctrl.canEdit ? ('<a id="btnSwitch" class="edit-profile btn btn-small transparent" ng-click="$ctrl.editScene($event, \'' + item._id + '\')"></a>'):'');
            }
        }

        function getBreak(item, prop) {
            return '<div id="break' + item._id + '" class="'+$ctrl.getScriptSidesCls(prop) + '"><div class="view-page-break hide-ipad onsides"></div></div>';
        }

        function getScriptSidesCls(prop) {
            return 'script-' + prop + ' ' + ($ctrl.scriptSides[prop] ? '' : 'sb-hide');
        }

        function getRowHeader(item, cls, isDayBreak){
    return '<div id="sceneH' + item._id + '" class="row-scene centered scene-header ' + $ctrl.getScriptSidesCls(isDayBreak ? 'withDayHeader' : 'withHeader') + '">' +
                '<div class="header-row clearfix margin-top ' + (cls ? cls : '') + '">' +
                    '<div class="pull-left">' +
                        (isDayBreak ? item.name : ('Scene ' + (item.scene ? ('<span>' + $ctrl.SBFieldMethods.getSceneText(item) + '</span>') : ''))) +
                    '</div>' +
                    getRowHeaderPages(item) +
                '</div>' +
            '</div>';
        }

        function getRowHeaderPages(item) {
            var el  = '',
            pagesProp = 'pagesDisplay';
            if (item[pagesProp] || item.estTime || item.startTime) {
                if (item[pagesProp]) {
                    el += $ctrl.SBFieldMethods.getPages(item, 'selected text-center inline-block', false, pagesProp) + ' pages';
                }

                if (item.pages && item.estTime) {
                    el += "<span class='dot-separator small dark'></span>";
                }
                if (item.startTime || item.estTime) {
                    el += (item.estTime ? ('Est Time: ' + $ctrl.SBFieldMethods.getEstVal(item.estTime)) : '') +
                        (item.startTime ? ('Start Time: ' + $ctrl.SBFieldMethods.getEstVal(item.startTime)) : '');
                }

                return '<div class="pull-right pages semibold">' + el + '</div>';
            }
            return el;
        }

        function getSceneContent(item, i) {
            return "<scene-tagging " +
                "class='clearfix display-block' " +
                "id='scene" + (item.stripId ? item.stripId : item._id) + "' " +
                "item='::$ctrl.strips[" + i + "]' " +
                "script-loading-service='::$ctrl.scriptLoadingService' " +

                //should be false. no new tags should be created
                "with-tagging='::$ctrl.withTagging' " +

                //set  load-tags to true and overwrite the style for cls with-highlighted
                //todo: set for faster processing
                 "load-tags='::" + ($ctrl.loadTags === true) + "' " +

                "tagging-scenes='::$ctrl.taggingScenes' " +
                "categories='::$ctrl.categories' " +
                "elements='::$ctrl.elements' " +

                "max-font-size='::$ctrl.maxFontSize' " +
                "min-font-size='::$ctrl.minFontSize' " +
                "doc-wrapper-class='::$ctrl.docWrapperClass' " +
                "side-margin='true'" +
                "></scene-tagging>";
        }

        function editScene(e, id) {
            $ctrl.preventDefault(e);

            if ($ctrl.strip) {
                $ctrl.popupsService.open($ctrl.strip, $ctrl.popupsService.operations.viewScene, {
                    item: $ctrl.strip,
                    canEdit: $ctrl.canEdit && $ctrl.strip.active,//todo check if should edit???
                    scriptLoadingService: $ctrl.scriptLoadingService,
                    isEditMode : false
                }, $ctrl.compOptions);
            }
        }
    }
}



