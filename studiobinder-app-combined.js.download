            {value: 3, text: 'Extras', textinput: "Character or Role", placeholder: "Enter Role Name", block: 'extras'},
            {value: 4, text: 'Clients', textinput: "Client", placeholder: "Client Job Title", block: 'clients'}
        ],

        ContactTypes = {
            General: '',
            List: 'List',
            Project: 'Project',
            Recipient: 'Recipient'
        },

        Options = {
            columns: ['1', '2', '3', '4', '5', '6', '7'],
            view: 2,
            showPrintBgColor: true,
            showPrintBgCardColor: true,
            showPrintFontColor: true,
            showPrintBorderColor: true,
        },

        Settings = {
            Columns: angular.copy(SBApiGridColumns['contacts'](PropTypes))
        },

        Filters = [
            {value: true, text: 'Active Lists'},
            {value: false, text: 'Archived Lists'}
        ],

        CompOptions = angular.copy(compOptions),

        ListTreeServiceParams = {

            preLoadingTableName: 'ContactLists',

            hasTreeCopy: true,
            hasTreeShare: true,
            //moveInGroup: false,

            addListOnEmptyState: true,
            maxLevel: 1,
            hideLevel0: true,
            withHarcodedAll: true,
            dontStartTreeWithAll: true,
            harcodedAllIcon: 'contacts-all',

            withOptionsForList: true,
            withOptionsForListField: 'contactListId',
            withStringOptionsForListField: true
        },

        ListParams = {
            includeFields: ['name', 'email', 'roles', 'profilePictureURL', 'profilePictureURLId', 'phone', 'createdAt', 'orderLists', 'contactLists', 'note', 'rate'],
            searchFields: ['name', 'email', 'roles', 'note'],
            orderFields: ['name', 'email', 'phone','roles', 'note', 'rate'],
            populate: ''
        },

        KeyboardServiceParams = {
            canCopy: false,
            canMove: false,
        },

        PopupOperations = {
            createContactsList: {
                type: 'Create',
                template: getBasePopupTemplateByTag('contact-group-item'),
                size: 'medium',
