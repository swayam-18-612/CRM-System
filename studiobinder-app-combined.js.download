angular.module('tree.item.remove.controller.service', [
])
    .service('TreeItemRemovePopupCtrlService', TreeItemRemovePopupCtrlService);
TreeItemRemovePopupCtrlService.$inject = ['ListItemPopupTemplateCtrlService'];

function TreeItemRemovePopupCtrlService(ListItemPopupTemplateCtrlService) {

    return function ($ctrl, $element){
        $ctrl.setTemplateData = setTemplateData;
        $ctrl.getPopupBodyContent = getPopupBodyContent;

        $ctrl.preInitOther = preInitOther;
        $ctrl.postInitOther = postInitOther;

        $ctrl = new ListItemPopupTemplateCtrlService($ctrl, $element);

        return $ctrl;

        function preInitOther() {
            //remove custom class from popup

            if (!$ctrl.extraParam) {
                $ctrl.extraParam = {};
            }
            $ctrl.nameForGroup = $ctrl.extraParam.nameForGroup;
            $ctrl.type = $ctrl.extraParam.action;
            $ctrl.btnText = '<span>' + $ctrl.type  + '</span><span class="hide-ipad"> ' + $ctrl.nameForGroup + '</span>';
            $ctrl.message = 'Are you sure you want to ' + $ctrl.type.toLowerCase() +' this ' + $ctrl.nameForGroup.toLowerCase();

            switch ($ctrl.type) {
                case 'Remove':
                    $ctrl.icon = 'trash';
                    if ($ctrl.extraParam.ungroup) {
                        $ctrl.extraParam.params = _.extend({
                            ungroup: true
                        }, $ctrl.extraParam.otherParams);
                        $ctrl.btnText = 'Ungroup';
                    }else{
                        $ctrl.icon = 'trash';
                    }
                    $ctrl.message += ($ctrl.extraParam.additionalMessage ? $ctrl.extraParam.additionalMessage : '') + '.';
                    break;

                case 'Archive':
                    $ctrl.icon = 'box';
                    $ctrl.message += '? The archived ' + $ctrl.nameForGroup + 's can be found in the <b>Archived</b> section.';
                    break;

                case 'Activate':
                    $ctrl.icon = 'restore';
                    $ctrl.message += '? The active ' + $ctrl.nameForGroup + 's can be found in the <b>Active</b> section.';
                    break;
            }
            $ctrl.pageClass = 'accent';
            //$ctrl.extraParam.ungroup ? 'Ungroup' : 'Remove';
        }

        function postInitOther(){
            $ctrl.onSave = onSave;
        }

        function onSave(result) {
            result.treeType = $ctrl.extraParam.treeType;
            //ARCHIVED_
            //REMOVED_
            $ctrl.broadcastRoot($ctrl.type.toUpperCase() + 'D_' + $ctrl.elemType + '_TREE', result);
            //ARCHIVE_GROUP_MIRROR_
            //REMOVE_GROUP_MIRROR_
            $ctrl.broadcastRoot($ctrl.type.toUpperCase() + '_GROUP_MIRROR_' + $ctrl.elemType + '_' + $ctrl.item._id, result);
            $ctrl.closePopup();

            if($ctrl.onSaveAfter){
                $ctrl.onSaveAfter();
            }
        }

        function setTemplateData() {
            $ctrl.count = $ctrl.extraParam.params && $ctrl.extraParam.params.selected ? $ctrl.extraParam.params.selected.length : 0;
            $ctrl.popupTitle = 'Are you sure?';
            $ctrl.withFooterBtns = true;
            $ctrl.saveOnEnter = true;
        }

        function getPopupBodyContent() {
            return '<p class="text-center">' + $ctrl.message +'</p>';
        }
    }
}

angular.module('tree.item.edit.component', [
    'tree.item.edit.controller.service'
])
.component('treeItemEdit', {
    bindings: {
        isSemibold: '<',
        item: '<',
        service: '<',
        cancelEdit: '&',
        onUpdate:'&',
        elemType: '@',
        placeholder: '@',
        fontSize: '@',
        paddingRight: '@'

    },
    controller: 'TreeItemEditCtrl',
})
.controller('TreeItemEditCtrl', TreeItemEditCtrl);
TreeItemEditCtrl.$inject = ['TreeItemEditCtrlService', '$element'];

function TreeItemEditCtrl( TreeItemEditCtrlService, $element) {
