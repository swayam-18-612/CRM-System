addMoSePa('Approvals', 'approvals', TempApprovalsService, {
    serviceInjectList: [ 'ResourcePathsService', 'Users','Products','Comments','Callsheets'],
    serviceInjectMod: [
        'apiServices.paths.service',
        'resources.Users',
        'resources.Products',
        'resources.Comments',
        'resources.Callsheets'
    ]
});
function TempApprovalsService(ApiService, model, ResourcePathsService, Users,Products,Comments,Callsheets) {
    var CommentTypes = {Share: 1, RequestForApproval: 2, Approval: 3, ApproverComment: 4};

    var service = ApiService(model, {
        listType: 'isGroup',
        withCallsheetId: true,
        convertOtherResources: convertOtherResources
    });

    service.CommentTypes = CommentTypes;
    service.getPostPath = ResourcePathsService.getCallsheetPath;
    service.commentCallsheet = commentCallsheet;

    return service;

    function commentCallsheet(params, successcb, errorcb) {
        return service.postUrl('/' + (params.type === 3 ? 'approve' : (params.type === 4 ? 'comment' : 'owner-comment')) + '/' + params.id, params, successcb, errorcb);
    }

    function convertOtherResources(item) {
        if(!item){return null;}
        if(item.lastCommentId && typeof(item.lastCommentId) === 'object'){
            item.lastComment = new Comments(item.lastCommentId);
            item.lastCommentId = item.lastCommentId._id;
        }
        if(item.productId !== null && typeof(item.productId) === 'object') {
            item.product = new Products(item.productId);
            item.productId = item.productId._id;
        }
        if(item.callsheetId !== null && typeof(item.callsheetId) === 'object') {
            item.callsheet = new Callsheets(item.callsheetId);
            item.callsheetId = item.callsheetId._id;
        }
        return item;
    }
 }

angular.module('product.preLoading.avscripts.service', [
    'product.preLoading.resource.service',
    'apiServices.Avscripts'
])
    .service('AvscriptsLoadingService', AvscriptsLoadingService);

AvscriptsLoadingService.$inject = ['PreloadingResourceService', 'AvscriptsService'];
function AvscriptsLoadingService(PreloadingResourceService, objectService) {
    var _this = new PreloadingResourceService(objectService, {
        name: 'Avscripts',
        tableParamsColsInit: ['companyId', 'productId', 'documentId']
    });

    _this.getPreById = getPreById;

    return _this;

    function getPreById(tableParams, id, settings) {
        var item = _this.service.getObjectById(tableParams, _this.tableType, id);
        return loadAddons(tableParams, item);
    }

    function loadAddons(tableParams, item) {
        if (!item) {
            return item;
        }

        if (item.setupId && item.type === 1) {
            item.setup = _this.service.getObjectById(tableParams, _this.tableType, item.setupId);
            item.segNo = item.setup ? item.setup.segNo : null;
        }

        return item;
    }
}


