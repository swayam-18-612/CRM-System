SBResizableImgCtrl.$inject =['SBResizableImgCtrlService', '$element'];
function SBResizableImgCtrl(SBResizableImgCtrlService, $element) {
    var $ctrl = this;
    $ctrl.imagesOnly = true;
    $ctrl.withComments = true;
    $ctrl.withDetails = false;
