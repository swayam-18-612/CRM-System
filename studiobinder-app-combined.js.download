removeText: '@?',
    hasRemove: '@?',
    dateFormat: '@?',
    header: '@?',

    minDate: '<',
    maxDate: '<',
    //value [moment , moment]
    defaultDate: '<', //[Date , Date] /range of dates
    enableTime: '@',
}, getSBDropdownTemplate()))
.controller('SbDateRangeCtrl', SbDateRangeCtrl);

SbDateRangeCtrl.$inject = ['SbDateCtrlService', '$element', '$attrs'];
//{from: {value, hasTime}, to:{value, hasTime}}

function SbDateRangeCtrl(SbDatesCtrlService, $element, $attrs) {
    var $ctrl = this;

    $ctrl.dateType = 2;

    $ctrl.process = process;
    $ctrl.getDefault = getDefault;

    $ctrl = new SbDatesCtrlService($ctrl, $element, $attrs);

    function getDefault(today){
        return [
            $ctrl.getDateFromMoment( $ctrl.MomentService.getUtcMomentFromDateMoment(today, $ctrl.CPS.startTime)),
            $ctrl.getDateFromMoment($ctrl.MomentService.getUtcMomentEndDay(today))
        ];
    }

    function process(v, m){
        if (!v) {
            return null;
        }
        if(!m){
            m = function (v){return v;}
        }
        if (v.length === 1) {
            return [m(v[0])];
        }
        if (v.length === 2) {
            return [m(v[0]), m(v[1])];
        }
    }
}

angular.module('dropdowns.sbDates.menu.component', [
    'dropdowns.sbDate.menu.component.service',
