])
    .controller('SBEditorCtrl', SBEditorCtrl);
SBEditorCtrl.$inject = ['TemplateCompileCompCtrlService', 'SBEditorService', 'SBEditorConfig', 'ResizableScriptFontService', '$element', '$attrs'];

function SBEditorCtrl(TemplateCompileCompCtrlService, SBEditorService, SBEditorConfig, ResizableScriptFontService, $element, $attrs) {

    var $ctrl = this,
        content, editorElem,
        textChangeEvent, selectionChangeEvent, watchers = [];

    //allow to set scene numbers automatically
    //$ctrl.withoutRenumber = true;
    var Delta = Quill.import('delta');

    SBEditorService.withoutPagination = true;

    $ctrl.$onChanges = $onChanges;

    $ctrl.validate = validate;
    $ctrl.uiCanExit = uiCanExit;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.triggersave= triggerSave;
    $ctrl.triggercancel= triggerCancel;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {


        $ctrl.canEdit = !isReadOnly();

        $ctrl.LCS.blockPaddingLeft = 3;

        $ctrl.withNoToolbar = $ctrl.withNoToolbar === true || $ctrl.withNoToolbar === 'true';
        $ctrl.withBottomToolbar = $ctrl.withBottomToolbar === true || $ctrl.withBottomToolbar === 'true';
        $ctrl.focusOffset = $ctrl.focusOffset ? parseInt($ctrl.focusOffset, 10) : 0;
        $ctrl.editorWrapperClass = 'editorwrapper';
        $ctrl.toolbarWrapperClass = 'editortoolbar';
        $ctrl.toolbarWrapperClass1 = 'editortoolbar1';

        if($ctrl.editorType === 'taskcard'){
            $ctrl.withExternalSave = true;
        }

        // create quill instance after dom is rendered
        $ctrl.docWrapperClass = 'document-version-wrapper';
        $ctrl.isScript = $ctrl.editorType === 'screenplay';

        content = $ctrl.content;
        $ctrl.withSaveBtn = $attrs.withSave === 'true' || $attrs.withSave === true;
        $ctrl.withCancelBtn = $attrs.withCancel === 'true' || $attrs.withCancel === true;

        if ($ctrl.withBottomToolbar) {
            $ctrl.classToolbar = 'toolbar-bottom';
        }

        $ctrl.toolbarContent = SBEditorService.getToolbar($ctrl.editorType, $ctrl.showSecondaryButtons);
    }

    function set(content, source){
        var format = $ctrl.format && ['text', 'object', 'html'].indexOf($ctrl.format) > -1 ? $ctrl.format : 'html';
        if(source === 'api'){
            $ctrl.editorQ.isInit = true;
        }

        if(SBEditorService.withoutPagination && $ctrl.isScript) {
            content = content ? content.replaceAll('<br/>', '').replaceAll('</br>', '').replaceAll('<br>', '') : content;
        }

      //  console.log('set editor content ' + getSBTimestamp());
        var ops = content ? content.ops : [];
        if(ops){
            format = 'object';
            $ctrl.editorQ.setContents(ops, source);
        } else if (format === 'text') {
            $ctrl.editorQ.setText(content, source);
        } else if (format === 'object') {
            $ctrl.editorQ.setContents(content, source);
        } else {
          //  var c = editor.clipboard.dangerouslyPasteHTML(0, content, 'silent');
             var c = $ctrl.editorQ.clipboard.convert(content);
            $ctrl.editorQ.setContents(c, source);
            //editor.pasteHTML(0, content, 'silent');
        }
       // console.log('end set editor content ' + format + ' ' + getSBTimestamp());
        $ctrl.editorQ.isInit = false;
    }

    function $onChanges(changes) {
        var change = changes.ngModel;
        if (change !== undefined && !angular.equals(change.currentValue, change.previousValue)) {
            content = change.currentValue;

            if ($ctrl.editorQ && !$ctrl.editorQ.editorChanged) {
                console.log('editorChanged');
                set(content);
            }
            $ctrl.editorQ.contentUpdated = true;
            $ctrl.editorQ.editorChanged = true;
        }

        if ($ctrl.editorQ && changes.readOnly) {
            $ctrl.editorQ.enable(!changes.readOnly.currentValue);
        }
    }

    function onDestroy() {
        if($ctrl.config && $ctrl.config.watchers) {
            $ctrl.RootEventsService.removeWatchers($ctrl.config.watchers);
        }

        $ctrl.editorQ = null;

        if($ctrl.templateCompileUploader){
            $ctrl.templateCompileUploader.destroyNewScope();
        }

        if (textChangeEvent) {
            textChangeEvent.removeListener('text-change');
        }

        if (selectionChangeEvent) {
            selectionChangeEvent.removeListener('selection-change');
        }

        ResizableScriptFontService.remove($ctrl.styleParentId);
    }

    function getItemTemplate() {
        //console.log('SBEditController.getItemTemplate');
        if($ctrl.isEditorsLoaded){return;}
        $ctrl.withHide = false;
        var preloader = ($ctrl.withPreloader === true || $ctrl.withPreloader === 'true') ? ('<div class="h-full table-div centered-preloader full-width display-block full-width clearfix"><div class="centered"><div><div class="loadFacebookWrapper"><div class="sbLdsEllipsis"><div class="lds-ellipsis"><div></div><div></div><div></div><div></div></div></div></div></div></div></div>' ):'',
            el = ''+
                 preloader +
                '<div class="' + $ctrl.editorWrapperClass +
                ($ctrl.withScrollbar === 'true' || $ctrl.withScrollbar === true ? ' fancy-scrollbar ultrathin scrollable-content h-full first-scrolling-wrapper' : '') +
                 ' sb-hide' +
                '"></div>';

        if (!$ctrl.canEdit) {
            return el;
        }

        var toolbar = getToolBar(
            //$ctrl.withHide ? ' sb-hide': ''
        );
        $ctrl.isEditorsLoaded = true;
        return  $ctrl.withBottomToolbar ? (el + toolbar) : (toolbar + el) ;
    }

    function getToolBar(cls) {
        //console.log('SBEditController.getToolBar');
        if($ctrl.readOnly){return '';}
        var wrapperCls = getToolbarWrapperClass() + (cls ? (' ' + cls) : '');
        if($ctrl.toolbarParentEl) {
          //  $ctrl.LCS.timeout(function (){
                $ctrl.toolbarWrapper = $ctrl.LCS.bodyElement.querySelector($ctrl.toolbarParentEl);
                if ($ctrl.toolbarWrapper) {
                    if (wrapperCls) {
                        $ctrl.LCS.addClass($ctrl.toolbarWrapper, wrapperCls);
                    }
                    $ctrl.LCS.appendChildFragment($ctrl.toolbarWrapper, get());
                }
           // }, 0);
            return '';
        }

        return '<div class="' + ($ctrl.toolbarWrapperClass ? $ctrl.toolbarWrapperClass : '') + ' ' + wrapperCls + '">' + get() + '</div>';

        function get() {
            return '<div class="' + $ctrl.toolbarWrapperClass1 + '">' + ($ctrl.toolbarContent ? $ctrl.toolbarContent : '') + '</div>';
        }
    }

    function getToolbarWrapperClass(){
        //console.log('SBEditController.getToolbarWrapperClass');
        return ($ctrl.classToolbar ? ($ctrl.classToolbar + ' ') : '') +
            ($ctrl.staticToolbar ? ' fixed-toolbar ' : '') +
            ($ctrl.editorType ? $ctrl.editorType : ' full ') +
            ($ctrl.withNoToolbar ? ' sb-hide ' : '');
    }

    function uiCanExit() {
        if ($ctrl.canExit || !$ctrl.SessionService.hasDocChanges) {
            return true;
        }

        $ctrl.canExit = window.confirm("Are you sure you want to leave this page? There are unsaved changes.");
        return $ctrl.canExit;
    }

    function validate(text) {
        if ($ctrl.maxLength) {
            setValidity('maxlength', (text.length > $ctrl.maxLength + 1) ? false : true);
        }

        if ($ctrl.minLength > 1) {
            // validate only if text.length > 1
            setValidity('minlength', (text.length <= $ctrl.minLength && text.length > 1) ? false : true);
        }
    }

    function setValidity(type, val) {
        //$ctrl.ngModelCtrl.$setValidity(type, val);
    }

    function setViewValue(val){
        //$ctrl.ngModelCtrl.$setViewValue(val);
    }

    function onLoaded() {
        if ($ctrl.isLoaded) {
            return;
        }

        //console.log('SBEditorCtrl.onLoaded');
        var format = $ctrl.format && ['object', 'html', 'text'].indexOf($ctrl.format) > -1 ? $ctrl.format : 'html';
        editorElem = $ctrl.element.querySelector('.' + $ctrl.editorWrapperClass);
        var config = loadConfigs(editorElem);

        // set toolbar to custom one
        if ($ctrl.canEdit && !$ctrl.withNoToolbar) {
            if (!$ctrl.toolbarParentEl) {
                $ctrl.toolbarWrapper = $ctrl.element.querySelector('.' + $ctrl.toolbarWrapperClass1);
            }
            if ($ctrl.toolbarContent && $ctrl.toolbarWrapper) {
                config.modules.toolbar = $ctrl.toolbarWrapper.children[0];
            }
        }

        $ctrl.LCS.addClass($ctrl.element, 'sb-editor' + ($ctrl.readOnly ? ' read-only' : ''));

        $ctrl.editorQ = new Quill(editorElem, config);

        var attr = $ctrl.element.getAttribute('name');
        if (attr) {
            $ctrl.element.removeAttribute('name');
            $ctrl.editorQ.root.setAttribute('name', attr);
        }
        $ctrl.elEditor = $ctrl.element.querySelector('.ql-editor');

        if ($ctrl.canEdit) {
            //don't preserve color style & background color on paste if is not notes
            if (($ctrl.saveOnEnter === true || $ctrl.saveOnEnter === 'true') &&
                $ctrl.editorType && $ctrl.editorType.indexOf('bubble') === 0) {
                addKeyBinding(SBEditorService.Keys.ENTER, triggerSave);
                addKeyBinding(SBEditorService.Keys.ESCAPE, triggerCancel);
            }

            //happens even if is not paste
            adjustStyle();

            function adjustStyle() {
                if ($ctrl.editorType !== 'notes' && $ctrl.editorQ.clipboard) {
                    $ctrl.editorQ.clipboard.addMatcher(Node.ELEMENT_NODE, onpaste);
                }
            }

            function addKeyBinding(key, m) {
                $ctrl.editorQ.keyboard.addBinding({
                    key: key,
                }, m);
                //make it top priority
                $ctrl.editorQ.keyboard.bindings[key].unshift($ctrl.editorQ.keyboard.bindings[key].pop());

            }

            function onpaste(node, delta) {
                return delta.compose(new Delta().retain(delta.length(), //these impact style ->
                    {
                       //color: false,
                       background: false,
                    }
                ));
            }

            function onpaste1(node, delta) {
                console.log('onpaste');
                if($ctrl.editorQ) {
                    $ctrl.editorQ.editorChanged = true;
                    $ctrl.editorQ.isPasteEvent = true;
                }
                if ($ctrl.editorType !== 'screenplay') {
                    var plaintext = node.innerText;
                    var Delta = Quill.import('delta');
                    if (plaintext && plaintext.length) {
                        return new Delta().insert(plaintext);
                    }
                }
                return delta;
            }

            // mark model as touched if editor lost focus
            selectionChangeEvent = $ctrl.editorQ.on('selection-change', function (range, oldRange, source) {
                //console.log('editor.on.selection-changed');

                if ($ctrl.onSelectionChanged) {
                    $ctrl.onSelectionChanged({
                        editor: $ctrl.editorQ,
                        oldRange: oldRange,
                        range: range,
                        source: source
                    });
                }
                $ctrl.isPasteEvent = false;

                if (range) {
                    return;
                }
            }.bind($ctrl));

            // update model if text changes
            textChangeEvent = $ctrl.editorQ.on('text-change', function (delta, oldDelta, source) {
                //console.log('editor.on.text-change');
                /* var emptyModelTag = ['<' + editor.root.firstChild.localName + '>', '</' + editor.root.firstChild.localName + '>'];

                 if (html === emptyModelTag[0] + '<br>' + emptyModelTag[1]) {
                     html = null;
                 }*/

                //$ctrl.validate(text);

                //console.log('editor.on.text-change:' + text);
                //setViewValue(format === 'text' ? text : (format === 'object' ? content : html));
                //if is not first time send updates
                if (source === 'user' && !$ctrl.editorQ.textChanged) {
                    $ctrl.editorQ.textChanged = true;
                    $ctrl.editorQ.editorChanged = true;
                }
                var changed = $ctrl.editorQ.editorChanged && !$ctrl.editorQ.contentUpdated;
                if (changed
                    && $ctrl.element.querySelector('.ql-editor').innerText !== '') {
                    sendUpdates({
                        delta: delta,
                        oldDelta: oldDelta,
                        source: source
                    });
                } else if (source === 'user') {
                    $ctrl.editorQ.editorChanged = true;
                    $ctrl.editorQ.contentUpdated = false;
                }
            }.bind($ctrl));
        }

        //console.log('set initial content');
        set(content, 'api');

        $ctrl.editorQ.history.clear();

        if ($ctrl.isScript || $ctrl.withScriptFormat) {
            $ctrl.styleParentId = ResizableScriptFontService.set($ctrl.editorQ.root, {
                maxFontSize: $ctrl.maxFontSize,
                minFontSize: $ctrl.minFontSize,
                docWrapperClass: $ctrl.docWrapperClass,
                blockPaddingLeft: $ctrl.LCS.blockPaddingLeft
            });

            if ($ctrl.elEditor) {
                $ctrl.LCS.addClass($ctrl.elEditor,
                    ($ctrl.withScriptFormat ? 'script-titlepage' : 'scene-wrapper') +
                    ($ctrl.element.getAttribute('init-top-margin') ? ' init-top-margin' : '') +
                    (content ? '' : ' ql-blank'));
            }
        }

        var toolbar = $ctrl.element.querySelector('.ql-toolbar');
        if ($ctrl.canEdit) {
            if ($ctrl.toolbarWrapper && !$ctrl.toolbarContent) {
                $ctrl.LCS.emptyElement($ctrl.toolbarWrapper);
                $ctrl.toolbarWrapper.appendChild(toolbar);
            }

            if ($ctrl.withNoToolbar) {
                hideToolbar();
            }
            if (toolbar) {
                //todo: custom image handler
                var t = $ctrl.editorQ.getModule("toolbar");
                t.addHandler("image", imageUploader);
                $ctrl.editorQ.imageUploader = imageUploader;

                if ($ctrl.withSaveBtn) {
                    addWatcher('save');
                }
                if ($ctrl.withCancelBtn) {
                    addWatcher('cancel');
                }

                t.addHandler("hr", registerHr);

                t.container.addEventListener('mousedown', function (e) {
                    //console.log('toolbar mousedown');
                    e.preventDefault();
                });

                function addWatcher(btn) {
                    var m = $ctrl['trigger' + btn];
                    if($ctrl.withExternalSave) {
                        if(!$ctrl.config.watchers){$ctrl.config.watchers = [];}

                        $ctrl.RootEventsService.addRootWatcher($ctrl.config.watchers, 'SB_EDITOR_FIELD_' + btn.toUpperCase(), m);
                    } else{
                        t.addHandler(btn, m);
                    }
                }
            }
        } else {
            hideToolbar();
        }

        // provide event to get informed when editor is created -> pass editor object.
        if ($ctrl.onEditorCreated) {
            $ctrl.onEditorCreated({editor: $ctrl.editorQ});
        }

        if (!$ctrl.delayTimeout) {
            $ctrl.delayTimeout = 100;// 210;//for script block
        }

        $ctrl.LCS.timeout(function () {
            $ctrl.LCS.removeChild($ctrl.element, '.centered-preloader');
            $ctrl.LCS.removeClass($ctrl.element.querySelector('.' + $ctrl.editorWrapperClass), 'sb-hide');

            if ($ctrl.withHide && $ctrl.canEdit && !$ctrl.withNoToolbar) {
                //console.log('removeClass');
                $ctrl.LCS.removeClass($ctrl.element.querySelector('.' + $ctrl.toolbarWrapperClass), 'sb-hide');
            }

            if (canSetSelection() && !$ctrl.focusOffset) {
                $ctrl.editorQ.focus();
            }
        }, $ctrl.delayTimeout);

        //set selection needs more time than set focus. give it 100 ms
        $ctrl.LCS.timeout(function () {
            if (canSetSelection() && $ctrl.focusOffset) {
                //console.log('sbeditor focusOffset: ' + $ctrl.focusOffset);
                if ($ctrl.editorQ) {
                    try {
                        $ctrl.editorQ.setSelection(typeof ($ctrl.focusOffset) === 'string' ? parseInt($ctrl.focusOffset, 10) : $ctrl.focusOffset, 0, Quill.sources.API);
                    } catch (e) {
                        $ctrl.editorQ.focus();
                    }
                }
            }
        }, $ctrl.delayTimeout);

        $ctrl.isLoaded = true;

        function hideToolbar() {
            //console.log('hideToolbar');
            $ctrl.LCS.addClass(toolbar, 'sb-hide');
        }

        function canSetSelection() {
            return $ctrl.editorQ && $ctrl.canEdit && ($ctrl.autofocus === true || $attrs.autofocus === 'true' || $attrs.autofocus === true)
        }
    }

    function isReadOnly() {
        return $ctrl.readOnly === true || $ctrl.readOnly === 'true';
    }

    function loadConfigs() {
        //console.log('loadConfigs');
        var readOnly = isReadOnly(),
            hideLock = $ctrl.hideLock === true || $ctrl.hideLock === 'true';

        $ctrl.canEdit = !readOnly;

        $ctrl.config = {
            withoutRenumber: $ctrl.withoutRenumber,
            readOnly: readOnly,
            hideLockL: hideLock,
            theme: angular.copy($ctrl.theme || SBEditorConfig.theme),
            modules: angular.copy($ctrl.modules || SBEditorConfig.modules),
            formats: angular.copy($ctrl.formats || SBEditorConfig.formats),
            bounds: editorElem,
            placeholder: $ctrl.placeholder !== null && $ctrl.placeholder !== undefined ? $ctrl.placeholder : '',
            strict: $ctrl.strict
        };

        if($ctrl.scrollingContainer){$ctrl.config.scrollingContainer = $ctrl.scrollingContainer;}

        $ctrl.config.team = {
            users: [{
                id: 11,
                fullName: 'Aron Hunt',
                username: 'aronhunt'
            },
                {
                    id: 23,
                    fullName: 'Bobby Johnson',
                    username: 'bobbyjohnson'
                },
                {
                    id: 58,
                    fullName: 'Dennis',
                    username: 'dennis'
                }
            ]
        };

        $ctrl.config.user = getUser();

        if ($ctrl.isScript) {
            $ctrl.config.scriptOptions = getScriptOptions($ctrl.config);
        }

        return SBEditorService.loadEditorConfigs($ctrl.config, $ctrl.editorType,
            $ctrl.withExternalSave ? false : $ctrl.withSaveBtn,
            $ctrl.withExternalSave ? false : $ctrl.withCancelBtn);

        function getUser() {
            var user = $ctrl.CPS.user;
            if (!user) {
                user = {};
            }
            user.color = 'transparent';
            return user;
        }

        function getScriptOptions(config) {
            var scriptOptions = {};

            if ($ctrl.changeLock) {
                scriptOptions.changeLock = $ctrl.changeLock;
            }
            if ($ctrl.onRenumberedForSync) {
                scriptOptions.onRenumberedForSync = $ctrl.onRenumberedForSync;
            }
            if ($ctrl.onAddScriptNotes) {
                scriptOptions.onAddScriptNotes = $ctrl.onAddScriptNotes;
            }
            if ($ctrl.onAddTitlePage) {
                scriptOptions.onAddTitlePage = $ctrl.onAddTitlePage;
            }
            if ($ctrl.readOnly) {
                scriptOptions.readOnly = config.readOnly;
            }
            if ($ctrl.hideLock) {
                scriptOptions.hideLock = config.hideLock;
            }
            if ($ctrl.isScriptLocked) {
                scriptOptions.isScriptLocked = $ctrl.isScriptLocked;
            }
            if ($ctrl.isScriptLockedFirst) {
                scriptOptions.isScriptLockedFirst = $ctrl.isScriptLockedFirst;
            }
            if ($ctrl.CPS.isAuthenticated) {
                scriptOptions.isAuthenticated = true;
            }
            if($ctrl.showSecondaryButtons){
                scriptOptions.showSecondaryButtons = $ctrl.showSecondaryButtons;
            }
            if($ctrl.sceneNumber){
                scriptOptions.sceneNumber = $ctrl.sceneNumber;
            }
            if($ctrl.withoutRenumber){
                scriptOptions.withoutRenumber = $ctrl.withoutRenumber;
            }
            if($ctrl.hideLock){
                scriptOptions.hideLock = $ctrl.hideLock;
            }
            scriptOptions.watchers = watchers;

            setList('initCharacters');
            setList('initLocations');

            return scriptOptions;

            function setList(type) {
                if ($ctrl[type] && $ctrl[type].length > 0) {
                    scriptOptions[type] = $ctrl[type].map(function (el) {
                        return el && el.name ? el.name.toUpperCase() : null;
                    });
                }
            }
        }
    }

    function sendUpdates (moreData) {
        if ($ctrl.onContentChanged) {
            $ctrl.onContentChanged(_.extend({}, getHtml(), moreData ? moreData : {
                delta:{},
                oldDelta: {},
                source: Quill.sources.USER
            }));
        }
        if($ctrl.editorQ) {
            $ctrl.editorQ.isPasteEvent = false;
        }
    }

    function getHtml() {
        return {
            editor: $ctrl.editorQ,
            html: $ctrl.editorQ.root.innerHTML,
            text: $ctrl.editorQ.getText(),
            content: $ctrl.editorQ.getContents()
        }
    }


    function imageUploader(value, e) {
        //todo change if nec
        if($ctrl.editorType === 'notes'){
            //planFetatures testmode
            var quotaType = 'notesImages';
            if(e && e.currentTarget) {
                e.currentTarget.setAttribute('data-type', 'imageUploader');
                e.currentTarget.setAttribute('analytics-action', 'Upload Image');
            }
            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});

        } else{
            process();
        }

        function process() {
            $ctrl.codeName = 'documents';
            if (!$ctrl.templateCompileUploader) {
                $ctrl.templateCompileUploader = new $ctrl.TemplateCompileService(null);
                $ctrl.templateCompileUploader.getItemTemplate = getUploaderItemTemplate;
            }
            $ctrl.templateCompileUploader.loadTemplate(function (clonedElement) {
                //console.log('image loaded');
            }, {
                onFileUploaded: onFileUploaded
                //onBeforeFileUploaded: onBeforeFileUploaded
            }, angular.element($ctrl.editorQ.container));
        }

        function getUploaderItemTemplate(){
            return '<upload-files-btn ' +
                'autostart="::true" ' +
                'images-only="::true" ' +
                'multiple-files="::true" ' +
                ($ctrl.codeName ? ('code-name="' + $ctrl.codeName + '" ') : '') +
                'on-file-uploaded="$ctrl.onFileUploaded(result)" ' +
                (typeof ($ctrl.onBeforeFilesUploaded) === 'function' ? "on-before-files-uploaded='$ctrl.onBeforeFilesUploaded(result)'" : '') +
                '></upload-files-btn>';
        }

        function onFileUploaded(result) {
            //console.log('on Img uploaded');
            var item = result ? result.item:null;
            if(item) {
                var version = item ? item.versionId : null;
                if(version){
                    var range = $ctrl.editorQ ? $ctrl.editorQ.getSelection() : null,
                        index = range ? range.index : 0,
                        width = 690,
                        src = $ctrl.security.getLogoPath(version, 'path', width);


                    $ctrl.editorQ.insertEmbed(index, 'image', {
                        'src': src,
                        width: width
                    }, Quill.sources.USER);
                    //$ctrl.editorQ.insertText(index + 1, '&nbsp;', Quill.sources.USER);
                    $ctrl.editorQ.insertText(index + 1, '\n', Quill.sources.User);
                    $ctrl.editorQ.setSelection(index + 1, 0, Quill.sources.SILENT);
                }
                /* security.getSecureResizedImage(path,null, false, null, function (blob) {
                    $ctrl.quill.enable(true);
                    $ctrl.quill.editor.insertEmbed(range.index, 'image', blob);
                    $ctrl.quill.setSelection(range.index + 1, 0, Quill.sources.SILENT);
                   $ctrl.editorQ.insertEmbed(range.index, 'image', "http://localhost:9000${url}");
                });*/
            }
            removeImageUploader();
        }

        function removeImageUploader() {
            if($ctrl.templateCompileUploader){
                $ctrl.templateCompileUploader.destroyNewScope();
            }
            if($ctrl.element) {
                $ctrl.element.removeAttribute('isUploadEvent');
            }
        }
    }

    function triggerSave() {
        //console.log('triggerSave ');
        $ctrl.onSave({result: getHtml()});
    }

    function triggerCancel() {
        //console.log('triggerCancel ');
        if(!$ctrl.onCancel){
            //console.error('onSave method must be defined for ');
            return;
        }
        $ctrl.onCancel();
    }


    function registerHr(value) {
         console.log('registerHr ');

        const selection = $ctrl.editorQ.getSelection((focus = true));
        let position = 0;
        // divider will replace any selected text
        if (!!selection.length) {
            $ctrl.editorQ.deleteText(selection);
        }
        // if last position in editor, add newline after divider (caret will not be after hr otherwise)
        if (selection.index === $ctrl.editorQ.getLength() - 1) {
            $ctrl.editorQ.insertText(selection.index, "\n");
        }
        // if at end of block, insert divider after newline character (quill will add a newline after divider otherwise)
        if (
            JSON.stringify($ctrl.editorQ.getContents(selection.index, 1)) ==
            JSON.stringify({ ops: [{ insert: "\n" }] })
        ) {
            position = selection.index + 1;
        } else {
            position = selection.index;
        }
        $ctrl.editorQ.insertEmbed(position, "hr", true);
        // move selection after divider
        $ctrl.editorQ.setSelection(selection.index + 2);
    }

    function savePeriodicChanges() {
        // Store accumulated changes
        var change = new Delta();
        quill.on('text-change', function(delta) {
            change = change.compose(delta);
        });

        // Save periodically
        setInterval(function() {
            if (change.length() > 0) {
                //console.log('Saving changes', change);
                /*
                Send partial changes
                $.post('/your-endpoint', {
                  partial: JSON.stringify(change)
                });

                Send entire document
                $.post('/your-endpoint', {
                  doc: JSON.stringify(quill.getContents())
                });
                */
                change = new Delta();
            }
        }, 5 *  1000);

        // Check for unsaved data
        $ctrl.LCS.$window.onbeforeunload = function () {
            if (change.length() > 0) {
                return 'There are unsaved changes. Are you sure you want to leave?';
            }
        }
    }
}

//https://github.com/quilljs/quill/pull/2095/commits/95bf0634a769a41e928f26d362b0399ef9a46710
