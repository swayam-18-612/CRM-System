SchedulingGroupCtrl.$inject = ['BreakdownsGroupCtrlService', 'StripsService', 'StripSchedulesPagination', '$element'];
function SchedulingGroupCtrl(BreakdownsGroupCtrlService, StripsService, Pagination, $element) {
    var $ctrl = this;
$ctrl.StripsService = StripsService;
    var dayBreakColumns = ['date', 'time', 'endTime', 'estTime', 'prepTime', 'shootTime', 'duration', 'breakdownNotes'],
        bannerColumns = [ 'estTime', 'note', 'time', 'endTime', 'estTime', 'prepTime', 'shootTime', 'breakdownNotes'];
    $ctrl.isScheduling = true;
    $ctrl.withoutGroupWhiteBg = true;

    $ctrl.onInitAddFromTop = onInitAddFromTop;
    $ctrl.showColumnMobileView = showColumnMobileView;

    $ctrl.getRowMobileActions = getRowMobileActions;
    $ctrl.getMorePopoverTemplate = getMorePopoverTemplate;
    $ctrl.getTabContentAttributes = getTabContentAttributes;
    $ctrl.getGroupEmptyButtons = getGroupEmptyButtons;
    $ctrl.getGroupEmptyText = getGroupEmptyText;
    $ctrl.edit = edit;
    $ctrl.getEditPopupParams = getEditPopupParams;

    $ctrl.getDisplayRootCount = getDisplayRootCount;
    $ctrl.$onInit = $onInit;

    $ctrl.getClipboardProcessingService = getClipboardProcessingService;
    $ctrl.canMove = canMove;
    $ctrl.move = move;
    $ctrl.openTasksReorder = openTasksReorder;

    function $onInit() {
        $ctrl.getKeyEvents = getKeyEvents;
        $ctrl = new BreakdownsGroupCtrlService($ctrl, $element, Pagination, true);
        if($ctrl.canEdit){
            $ctrl.onItemPopoverChanged = onItemPopoverChanged;

            /* $ctrl.onUpdate = onUpdate;
            $ctrl.onRemoved = onRemoved;

            $ctrl.activateFromBoneyard = activateFromBoneyard;
            $ctrl.moveToBoneyard = moveToBoneyard;
*/

            $ctrl.createCallsheet = createCallsheet;
        }
    }

    function move(item, e) {
        $ctrl.openTasksReorder({popupTitle: 'Reorder Day Breaks'});
    }

    function getSetups(list){
        return  list ? _.filter(list, function (item) {
            return item.type === $ctrl.StripTypes.DayBreak;
        }) : null;
    }


    function openTasksReorder(p) {
        $ctrl.popupsService.open(null, $ctrl.popupsService.operations.tasksReorder, _.extend({
            setups: getSetups($ctrl.list.items).map(function (item){
                return {_id: item._id, name: item.name + (item.note ? ('&nbsp;&nbsp;—&nbsp;&nbsp;' + item.note) : '') };
            })
      }, p), $ctrl.compOptions, null, onConfirm);

        function onConfirm(setups) {
            console.log('onclose openTasksReorder');

            var propForOrder = 'order',
                setupId = 'scheduleDayId',
                originalOrder = {};
            _.each($ctrl.list.items, function (item) {
                originalOrder[item._id] = item[propForOrder];
            });
            var ids = [];
            _.each(setups, function (setup) {
                ids = ids.concat(_.sortBy(_.filter($ctrl.list.items, function(item){ return item[setupId] === setup._id && item.type !== 0}), propForOrder).map(function (item) {
                    return item._id;
                }));
                ids.push(setup._id);
            });
            var updates = {}, hasChanges;
            _.each(ids, function (id, i) {
                var newOrder = i + 1;
                if (originalOrder[id] !== newOrder) {
                    updates[id] = newOrder;
                    hasChanges = true;
                }
            });
            if (hasChanges) {
                var lists = [$ctrl.currentListId],
                    listIds = {};
                listIds[$ctrl.listField] = lists;
                $ctrl.changeOrderServerSide({
                    updates: updates,
                    listIds: listIds
                }, lists);
            }
        }
    }
    function canMove(item) { //since move between segments
       // return false; // to do reenable
        //move only setups
        return item.type === $ctrl.StripTypes.DayBreak &&  _.filter($ctrl.list.items, {type: $ctrl.StripTypes.DayBreak}).length > 1;
    }


    function getDisplayRootCount(type){
        return type === $ctrl.StripTypes.Scene ? ($ctrl.getStrips(true).length || 0) : 0;
    }

    function getClipboardProcessingService(opType, extraParam){
        return opType === $ctrl.keyboardService.ActionTypes.Delete && extraParam && extraParam.item && extraParam.item.type === 1 ? $ctrl.StripsService : $ctrl.service;
    }

    function edit(item, field) {
        if(!item){return;}
        $ctrl.editInit(item, field);
    }

    function getEditPopupParams(item, field){
        return _.extend({}, $ctrl.getNewPopupParams(item), {
            changedFields: $ctrl.canEdit ? $ctrl.service.getEditableFields(item.type) : null
        });
    }

    function showColumnMobileView(item, c) {
        if( item && item.type === $ctrl.StripTypes.Scene){return true;}
        switch(item.type){
            case $ctrl.StripTypes.DayBreak: return dayBreakColumns.indexOf(c.prop) !== -1;
            case $ctrl.StripTypes.Banner: return bannerColumns.indexOf(c.prop) !== -1;
        }
        return false;
    }

    function getTabContentAttributes() {
        return 'ng-class="{true:\'with-radius with-side-margin margin-bottom-half\', false: \'margin-bottom with-no-bg\'}[$ctrl.list.items.length == 0]" '
            //+ ' ng-style="{\'padding-left\':$ctrl.list.items.length > 0?\'6px\':\'0\'}"'
            ;
    }

    function getGroupEmptyText() {
        return 'Add new ' + $ctrl.itemTitle.toLowerCase() + 's below';
    }

    function getGroupEmptyButtons() {
return '' +
        //($ctrl.CPS.isAuthenticated ? ('<import-script btn-class="btn btn-primary ' + $ctrl.pageClass + '"  show-title="true" show-text-on-ipad="true"
    // ($ctrl.pageClass ? ('page-class="'+$ctrl.pageClass+'" ') : '') +
    // ></import-script>') : '') +
    '<button class="btn btn-primary ' +
    //'btn-small transparent big with-margin-left '+
     ($ctrl.pageClass ? $ctrl.pageClass : '') +
    '" ng-click="$ctrl.createScene(null, null, $event)" data-type="createScene" analytics-on analytics-action="Add Scene"><span class="pull-left sbf plus with-margin-right"></span> <span>Add Scene</span></span></button>';
    }

    function getRowMobileActions(item) {
        if (item.type !== $ctrl.StripTypes.Scene) {
            return null;
        }

        var l = [ ];
        if($ctrl.StripTypes.Scene) {
            l.push({
                type: 'viewScene',
                action: 'Preview Scene',
                icon: 'sides'
            });
        }
    /*    if($ctrl.canEdit && item.active) {
            l.push({
                type: 'create',
                param: $ctrl.StripTypes.DayBreak,
                action: 'Add Day Break Under',
                icon: 'schedule-break',
            });

            l.push({
                type: 'create',
                param: $ctrl.StripTypes.Banner,
                action: 'Add Banner Under',
                icon: 'banner'
            });
        }*/
        return l;
    }

    function getMorePopoverTemplate(item, isMobile) {
        var  type = item.type,
             itemTitle =  type === $ctrl.StripTypes.DayBreak ? 'Day Break' : (type === $ctrl.StripTypes.Scene ? 'Scene' :'Banner'),

             template =  '<ul class="dropdown-menu side-menu display-block scheduling-sidemenu">'; //fadeInDown

        var count = 0;
        if(type === $ctrl.StripTypes.Scene && isMobile) {
            template +=  $ctrl.getSideMenuLi({
                    type: 'viewScene',
                    action: 'Preview Scene',
                    icon: 'sides'
                });
            count++;
        }

        if($ctrl.canEdit  ) {
            if (!isMobile) {
                template += $ctrl.getSideMenuLi({
                        type: 'create',
                        param: $ctrl.StripTypes.DayBreak,
                        action: 'Insert Day Break Under',
                        icon: 'daybreak',
                    iconLevel: 3,
                        withTopBorder: count > 0
                    }) +
                    $ctrl.getSideMenuLi({
                        type: 'create',
                        param: $ctrl.StripTypes.Banner,
                        action: 'Insert Banner Under',
                        icon: 'banner',
                        iconLevel: 4
                    });
            }

            if (type === $ctrl.StripTypes.Scene) {
                template += $ctrl.getSideMenuLi({
                    type: 'createScene',
                    param: $ctrl.StripTypes.Scene,
                    action: 'Add Scene Under',
                    icon: 'add-scene',
                    iconLevel: 4
                });
            }
            if(item.active) {
                template += $ctrl.getSideMenuLi({
                        type: 'edit',
                        action: 'Edit Details',
                        icon: 'pencil',
                        iconLevel : 2,
                        param: $ctrl.StripTypes.Scene ? 1000 : null,
                        withTopBorder: true
                    });

                    //todo bring back duplicate
                 //Duplicate strip > ensure the times for start end are updated and that the day break times are updated too

                if ($ctrl.withMoveGroupItem && $ctrl.canMove(item)) {
                    template += $ctrl.getSideMenuLi({
                        type: 'move',
                        action: 'Move Day Break',
                        icon: 'transition',
                        iconLevel: 5
                    });
                }

                template +=  $ctrl.getSideMenuLi({
                        type: 'duplicate',
                        action: 'Duplicate ' + itemTitle,
                        icon: 'copy',
                    });
            }
        }

        if(type === $ctrl.StripTypes.Scene) {
            template += (item.contentScript ? $ctrl.getSideMenuLi({
                type: 'viewUnsyncedScene',
                action: 'View Unsynced Scene',
                icon: 'unlinked',
                withTopBorder: count > 0
            }) : '') +
                $ctrl.getSideMenuLi({
                    type: 'goToBreakdown',
                    action: 'View Breakdown',
                    icon: 'breakdowns',
                    withTopBorder: $ctrl.canEdit && item.active
                })
            //todo comment out for now
               /* + $ctrl.getSideMenuLi({
                    type: 'goToShotsList',
                    action: 'View Shot List',
                    icon: 'shots',
                    iconLevel: 6
                })*/
            ;
        }

        if($ctrl.canEdit) {
            if (type === $ctrl.StripTypes.Scene) {
                if (item.active) {
                    template += $ctrl.getSideMenuLi({
                        type: 'archive',
                        action: 'Archive to Boneyard',
                        icon: 'box',
                        withTopBorder: true,
                        aClass: 'accent'
                    });
                } else {
                    template += $ctrl.getSideMenuLi({
                        type: 'activate',
                        action: 'Restore to Stripboard',
                        icon: 'restore',
                        withTopBorder: true,
                    });
                }
            }

            if ( type === $ctrl.StripTypes.Scene && !item.active ||
                type !== $ctrl.StripTypes.Scene) {
                template += $ctrl.getSideMenuLi({
                    type: 'remove',
                    action: 'Remove ' + itemTitle,
                    icon: 'trash',
                    withTopBorder: true,
                    aClass: 'accent'
                });
            }
        }

        template += '</ul>';

        return template;
    }

    function onItemPopoverChanged(result) {
        console.log('scheduling group onItemPopoverChanged: ' + result._id);
        $ctrl.list.replaceElementChildProps(result._id, 'strip', result.props);
    }

    function createCallsheet(item, info, e) {
//planFetatures testmode
        var quotaType = 'stripboardCallsheets';
        $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});
        function process() {
            $ctrl.popupsService.teamAccess(function () {
                var callsheet = $ctrl.CPS.CurrentProduct.getCallsheet(true);
                $ctrl.CPS.CurrentProduct.setCallsheet(callsheet);
                $ctrl.popupsService.open(callsheet, $ctrl.popupsService.operations.createCallsheet, {
                        withDayBreak: {
                            schedulesListId: $ctrl.currentListId,
                            scheduleDayId: item._id
                        }
                    }
                    //$ctrl.compOptions -> use comp options from callsheet
                );
            });
        }
    }

    function getKeyEvents() {
        return[{
            type: 'Create',
            keys: [$ctrl.keyboardService.keys.SKey, $ctrl.keyboardService.keys.sKey],
            method: onSKey
        }, {
            type: 'Banner',
            keys: [$ctrl.keyboardService.keys.BKey, $ctrl.keyboardService.keys.bKey],
            method: onBKey
        }, {
            type: 'DayBreak',
            keys: [$ctrl.keyboardService.keys.DKey, $ctrl.keyboardService.keys.dKey],
            method: onDKey
        }];

        function onSKey(sId, item) {
            if ($ctrl.currentListId !== sId) {
                return;
            }
            $ctrl.create(item, $ctrl.StripTypes.Scene, null);
        }

        function onBKey(sId, item) {
            if ($ctrl.currentListId !== sId) {
                return;
            }
            $ctrl.create(item, $ctrl.StripTypes.Banner, null);
        }

        function onDKey(sId, item) {
            if ($ctrl.currentListId !== sId) {
                return;
            }
            $ctrl.create(item, $ctrl.StripTypes.DayBreak, null);
        }
    }


    function onInitAddFromTop(result) {
        console.log('ADD_FROM_PAGE_TOP_'+ $ctrl.elemType);
        $ctrl.create(null, result.type ? result.type : $ctrl.StripTypes.Scene, null, null, null, result ? result.e : null);
    }
}

