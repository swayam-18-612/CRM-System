BreakdownSideBarCtrl.$inject = ['ExpandableSectionService', 'KeyboardListService','PopoverInitEventsService', 'CompInitCtrlService', '$element'];

function BreakdownSideBarCtrl(ExpandableSectionService, KeyboardListService, PopoverInitEventsService, CompInitCtrlService, $element) {
    var $ctrl = this;

    $ctrl.KeyboardListService = KeyboardListService;
    $ctrl.ExpandableSectionService = ExpandableSectionService;


    $ctrl.$onDestroy = $onDestroy;
    $ctrl = new CompInitCtrlService($ctrl);

    $ctrl.$element = $element;
    $ctrl.element = $ctrl.$element[0];

    $ctrl.closedata = null;
    $ctrl.show = {all: false};

    $ctrl.objectType = 'taggingScene';
    $ctrl.treeClass = '.categories-table';

    $ctrl.toggleShow = toggleShow;
    $ctrl.isShow = isShow;

    $ctrl.openNewElement = openNewElement;
    $ctrl.openEditElement = openEditElement;

    $ctrl.$onInit = $onInit;

    $ctrl.expandableSections = new $ctrl.ExpandableSectionService($ctrl.$element);

    function $onDestroy() {

        if ($ctrl.onPopupEventsDestroy) {
            $ctrl.onPopupEventsDestroy();
        }
    }

    function $onInit() {
        if($ctrl.item){$ctrl.copyItem = _.clone($ctrl.item);}

        if($ctrl.canEdit){
            $ctrl.getItemById = getItemById;
            loadSideMenu();
        }
    }

    function loadSideMenu() {
        $ctrl.keyboardService = new $ctrl.KeyboardListService({
            itemTitle: $ctrl.objectType,
            objectType: $ctrl.objectType,
            treeClass: $ctrl.treeClass,
           isCommentsSidebar: $ctrl.isCommentsSidebar
        });

        //list items must have class inline-tree-item
        $ctrl = new PopoverInitEventsService($ctrl, {
            popupPlacement: 'bottom-end',
            isTree: true,
            onMorePopoverUpdate: onMorePopoverUpdate,
            getMorePopoverTemplate: getMorePopoverTemplate
        });
    }

    function getItemById(id, isAll, e) {
        id = id.replace('aEditElement', '');
        for (var cId in $ctrl.taggingScenes) {
            var els = $ctrl.taggingScenes[cId],
                el = els ?_.find(els, {_id: id}) : null;
            if(el){
                return el;
            }
        }
        return null;
    }

    function getMorePopoverTemplate(item, isMobile) {
        return '<ul class="dropdown-menu side-menu display-block breakdown-sidemenu">' + getList() + '</ul>';

        function getList(){
            return [{
                type: 'openEditElement',
                action: 'Edit Element',
                icon: 'pencil'
            }, {
                type: 'removeFromScenes',
                action: 'Remove From Scene',
                icon: 'trash',
                aClass: 'accent',
                withTopBorder: true,
            }, {
                type: 'removeFromScene',
                action: 'Remove All Mentions',
                icon: 'trash',
                aClass: 'accent'
            }].map($ctrl.getSideMenuLi).join('');
        }
    }

    function onMorePopoverUpdate(result) {
        if(!result){return;}
        var e = result.e,
            item = result.item,
            target = e.currentTarget;
        switch (target.getAttribute('data-type')) {
            case 'openEditElement':
                console.log('openEditElement')
                return $ctrl.onOpenEditElement({$event: e, sceneElement: item});
            case 'removeFromScenes':
                return $ctrl.onRemove({item: item, allScenes: false});
            case 'removeFromScene':
                return $ctrl.onRemove({item: item, allScenes: true});
        }
    }

    function openNewElement($event, categoryId) {
        $ctrl.onOpenNewElement({$event:$event, id:categoryId});
    }

    function openEditElement($event) { //todo $event
        $ctrl.onOpenEditElement({$event:$event, sceneElement:null});
    }

    function isShow(id) {
        return (id !== null ? $ctrl.show['c' + id] : $ctrl.show.all) === true;
    }

    function toggleShow(e, id) {
        $ctrl.preventDefault(e);
        if (id === null) {
            $ctrl.show.all = $ctrl.show.all ? false : true;
            $ctrl.expandableSections.toggleExpandable($ctrl.show.all);
        } else {
            $ctrl.show['c' + id] = $ctrl.show['c' + id] ? false : true;
            $ctrl.expandableSections.openExpandable(id);
        }
    }
}


