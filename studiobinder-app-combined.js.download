}))
.controller('SbAddressCtrl', SbAddressCtrl);
SbAddressCtrl.$inject = ['SBInputFieldCtrlService', 'SBFieldTypesService', 'GooglePlacesApiService', //'TextAreaDynamicResizer',
    '$element' , '$attrs'
];
function SbAddressCtrl(SBInputFieldCtrlService, SBFieldTypesService, GooglePlacesApiService,
                       //TextAreaDynamicResizer,
                       $element, $attrs) {
    //doesnt work cause of g autocomplete
    var withoutTemplateScope = false;

    var interval, debounceTime = 1000;

    var $ctrl = this;
    $ctrl.SBFieldTypesService = SBFieldTypesService;
    $ctrl.GooglePlacesApiService = GooglePlacesApiService;
   // $ctrl.TextAreaDynamicResizer = TextAreaDynamicResizer;


    $ctrl.valueField = 'place_id';
    $ctrl.fieldSelector = 'input';

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitField = preInitField;
    $ctrl.onItemLoaded = onItemLoaded;
    $ctrl.onBeforeClose = onBeforeClose;
    $ctrl.onFieldFocus = onFieldFocus;
    $ctrl.keyDownEvent = keyDownEvent;
    $ctrl.setValue = setValue;
    $ctrl.onFieldBlur = onFieldBlur;

    // $ctrl.getPlacesDetails = $ctrl.GooglePlacesApiService.getPlacesDetails($ctrl.inputField);
    $ctrl.onItemSelected = onItemSelected;

    $ctrl.propType = $ctrl.SBFieldTypesService.PropTypes.Address;
    $ctrl = new SBInputFieldCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

    function getItemTemplate(){
return '<'+$ctrl.fieldSelector+' autocomplete="disabled" {{props}}/>' +

       '<g-places-autocomplete class="g-places-autocomplete" input="{{id}}" ' +
    'value-field="'+$ctrl.valueField+'"' +
    'str-list="$ctrl.strList" ' +
    'value="$ctrl.active" ' +
    'on-select="$ctrl.onItemSelected(result)" ' +
    '></g-places-autocomplete>';
    }

    function preInitField() {
        $ctrl.options = $ctrl.options || {};
        $ctrl.forceSelection = false;
        clearSearch();
    }

    function onItemLoaded() {
        //console.log('onItemLoaded');
        //$ctrl.resizer = new $ctrl.TextAreaDynamicResizer($ctrl, $ctrl.inputField);
    }

    function onFieldFocus(e) {
        $ctrl.preventDefault(e);
        //todo figure out how to destroy places
        if(!$ctrl.placesService){
            $ctrl.placesService = $ctrl.GooglePlacesApiService.getPlacesService($ctrl.inputField);
        }
 
        startAutoParsing();
    }

    function onFieldBlur(e) {
        //console.log('onFieldBlur');
        //if predictions is closed  and last value was not saved cause was typed save it
        if (!($ctrl.isParsing || $ctrl.list && $ctrl.list.length)) {
            console.log('update new val');
            var n1 = $ctrl.getInputValue(),
                n2 = $ctrl.SBFieldTypesService.getSBFieldContentEdit($ctrl, $ctrl.value, _.extend({}, $ctrl.col, {formattedAddress: false}));
            if (n1 !== n2.content) {
                setNewValue(n1, true);
            } else {
                $ctrl.close(e);//dont save and close
            }
        }

        /*if ($ctrl.resizer) {
            $ctrl.resizer.removeAutosize();
        }*/
    }

    function autosize(e) {
    /*    $ctrl.LCS.setCSSStyle($ctrl.inputField, 'height', 'auto');
        //  $ctrl.LCS.setCSSStyle($ctrl.inputField, 'padding', '0');
        // for box-sizing other than "content-box" use:
        $ctrl.LCS.setCSSStyle($ctrl.inputField, '-moz-box-sizing', 'content-box');
        console.log($ctrl.inputField.scrollHeight + '; ' + ($ctrl.inputField.scrollHeight - 31))
        $ctrl.LCS.setCSSStyle($ctrl.inputField, 'height', ($ctrl.inputField.scrollHeight - 12) + 'px');
        $ctrl.LCS.setCSSStyle($ctrl.inputField, 'padding-top', '6px');
        $ctrl.LCS.setCSSStyle($ctrl.inputField, 'padding-bottom', '6px');
*/
        if($ctrl.resizer) {
            $ctrl.resizer.autosize();
        }
    }

    function keyDownEvent(e) {
        //console.log('onAddressKeydown: type: ' + e.type + '; time:' + (new Date()).toString());
        var l = $ctrl.list ? $ctrl.list.length : 0,
            hasItems = l > 0;
        if (e.type === 'paste') {
            //autosize();
            return;
        }
        switch (e.which) {
            case $ctrl.keymap.down:
                //updateActiveInPopover
                if (hasItems) {
                    $ctrl.activeIndex = ($ctrl.activeIndex + 1) % l;
                    $ctrl.active = $ctrl.list[$ctrl.activeIndex][$ctrl.valueField];
                } else {
                    $ctrl.activeIndex = -1;
                    $ctrl.active = null;
                }
                break;

            case $ctrl.keymap.up:
                //updateActiveInPopover
                if (hasItems) {
                    $ctrl.activeIndex = ($ctrl.activeIndex ? $ctrl.activeIndex : l) - 1;
                    $ctrl.active = $ctrl.list[$ctrl.activeIndex][$ctrl.valueField];
                } else {
                    $ctrl.activeIndex = -1;
                    $ctrl.active = null;
                }
                break;

            case $ctrl.keymap.enter:
                if (e.shiftKey) {
                    $ctrl.LCS.pasteIntoInputElement($ctrl.inputField, '\n');
                   // autosize();
                } else {
                    saveonenter();
                }
                break;

            case $ctrl.keymap.tab :
                saveonenter();
                break;

            case $ctrl.keymap.esc:
                $ctrl.selectedId = null;
                $ctrl.close(e);//dont save and close
               // autosize();
                break;

            default:
                $ctrl.stopPropagation(e);
               // autosize();
                break;

            function saveonenter(){
                if ($ctrl.active) {
                    $ctrl.selectedId = $ctrl.active;
                    $ctrl.onItemSelected({
                        selected: $ctrl.selectedId,
                        item: $ctrl.list[$ctrl.activeIndex]
                    });
                }
            }
        }
    }

    function removeDrawer() {
        clearSearch();
        //$ctrl.LCS.removeElementChild($ctrl.element, '.g-places-autocomplete');
    }

    function parse() {
        if ($ctrl.isParsing) {
            var now = new Date().getTime();
            //console.log(now - $ctrl.isParsing);
            if ((now - $ctrl.isParsing) > 1000) {
                $ctrl.isParsing = now;
            } else {
                return;
            }
        }
        var val = $ctrl.getInputValue();
        if ($ctrl.lastParsed === val || !val || val.trim === '') {
            return;
        }
        //console.log('parse');

        $ctrl.isParsing = new Date().getTime();
        $ctrl.GooglePlacesApiService.getPredictions(val, $ctrl.options, getPredictions);

        function getPredictions(predictions) {
            //console.log('$ctrl.getPlacePredictions: '+(new Date()).toString()) +': ' + val;
            clearSearch();

            var newStr = predictions && predictions.length > 0 ? JSON.stringify(predictions) : null;
            if (!angular.equals($ctrl.strList, newStr)) {
                $ctrl.strList = angular.copy(newStr);
                //  console.log(newStr);
                $ctrl.list = predictions;
            }
            $ctrl.lastParsed = val;
            $ctrl.isParsing = null;
        }
    }

    function clearSearch() {
        $ctrl.active = null;
        $ctrl.activeIndex = -1;
        $ctrl.selectedId = null;
        if ($ctrl.list) {
            $ctrl.list.length = 0;
        }
        $ctrl.strList = null;
    }

    function cancelAutoParsing() {
        if (interval) {
            clearInterval(interval);
        }
    }

    function startAutoParsing() {
        cancelAutoParsing();
        interval = setInterval(parse, debounceTime);
    }

    function onItemSelected(result) {
        if (result) {
            if (result.active !== undefined) {
                $ctrl.active = result.active;
                console.log('PLACES_PREDICTIONS_CHANGED hover=' + $ctrl.active);
                $ctrl.activeIndex = result.$index;
            } else if (result.selected !== undefined){
                $ctrl.selectedId = result.item[$ctrl.valueField];
                console.log('PLACES_PREDICTIONS_CHANGED selected=' + $ctrl.selectedId);
                setSelected(result.item);
            }
        }
    }

    function setSelected(prediction) {
        $ctrl.onBeforeClose();
        console.log('close: ' + $ctrl.selectedId);
        if (prediction) { // there is a selected prediction
            $ctrl.GooglePlacesApiService.setNewPlace($ctrl.placesService, prediction, function(addr) {
                setNewValue(addr);
            });
        }
    }

    function onBeforeClose() {
        removeDrawer();
        cancelAutoParsing();
    }

    function setNewValue(value, withClose) {
        if($ctrl.value !== value) {
            $ctrl.value = value;
            $ctrl.setDisplayValue();
            $ctrl.save(null, true);
        }else if(withClose) {
                $ctrl.close();
        }
    }

    function setValue(next) {
        next();
    }

    function geolocate(address) {
        $ctrl.GooglePlacesApiService.geolocate(address, function (address) {
            $ctrl.value = address;
            $ctrl.onChange(address);
        });
    }
}

angular.module('sb.fields.textarea.resizer.service', [
])
.service('TextAreaDynamicResizer', TextAreaDynamicResizer);
function TextAreaDynamicResizer() {
    return function ($ctrl, textareaEl) {
        var paddingTop = 0,
            hiddenDiv,
            content = null,
            classList = textareaEl.classList.value.replace('ng-scope', ''),
            service ={
                autosize: autosize,
                removeAutosize: removeDiv
            };

        initTextarea();
        autosize();
        removeDiv();

        return service;

        function initTextarea() {
            $ctrl.LCS.addClass(textareaEl, 'resize-none autogrow');
        }

        function initDiv() {
            if(hiddenDiv){return;}
            hiddenDiv = document.createElement('div');
            $ctrl.LCS.addClass(hiddenDiv, 'txtareahiddendiv with-padding-top autogrow ' + classList);
            // Append hiddendiv to parent of textarea, so the size is correct
            textareaEl.parentNode.appendChild(hiddenDiv);
            //This removes scrollbars
            //$ctrl.LCS.setCSSStyle($ctrl.inputField, 'overflow', 'hidden');
        }

        function autosize() {
            initDiv();
            content = textareaEl.value;
            hiddenDiv.innerHTML =  content.replace(/\n/g, '<br>') + '<br style="line-height: 3px;">';

            // Briefly make the hidden div block but invisible
            // This is in order to read the height
            hiddenDiv.style.visibility = 'hidden';
            hiddenDiv.style.display = 'block';
            textareaEl.style.height = (hiddenDiv.offsetHeight - 2*paddingTop) + 'px!important';
             textareaEl.style.paddingTop = paddingTop + 'px';
            textareaEl.style.paddingBottom = paddingTop + 'px';

            // Make the hidden div display:none again
            hiddenDiv.style.visibility = 'visible';
            hiddenDiv.style.display = 'none';
            hiddenDiv.innerHTML = null;
        }

        function removeDiv() {
            if(hiddenDiv){
                //textareaEl.parentNode.removeChild(hiddenDiv);
            }
        }
    }
}

angular.module('sb.fields.contenteditable.component', [
    'sb.fields.html.controller.service'
])
.component('sbContenteditable', sbFieldComponentParams('SbContentEditableCtrl',{
}))
.controller('SbContentEditableCtrl', SbContentEditableCtrl);
SbContentEditableCtrl.$inject = ['SbContentEditableCtrlService', '$element', '$attrs'];
