function CallsheetRecipientsConstantsService(SBFieldTypesService, compOptions ) {
    var popupTemplate = getBasePopupTemplateByTag('contact-edit');

    var PropTypes = SBFieldTypesService.PropTypes,

        Options = {
            columns: ['1', '2', '3', '9', '8'],
            view: 2
        },

        Settings = {
            Columns: angular.copy(SBApiGridColumns['callsheetRecipients'](PropTypes))
        },

        // confirmedAt pageViewsCount showDetails status
        Filters = [{value: true, text: 'Active Lists'}],

        CompOptions = angular.copy(compOptions),

        ListTreeServiceParams = {
            preLoadingTableName: 'RecipientLists',

            maxLevel: 0,
            hideLevel0: true,
            withHarcodedAll: false,
            dontStartTreeWithAll: true,
            harcodedAllIcon: 'contacts-all',

            sidebarTitle: '&nbsp;',
            hideSidebarButtons: true,
            noTreeDrag: true,
            noItemEdit: true,
            dontUpdateUrl: true
        },

        ListParams = {
            includeFields: ['companyId', 'productId', 'callsheetId', 'castId', 'calltime', 'status', 'confirmedAt', 'callsheetInvitationSentId', 'emailViewsCount', 'pageViewsCount', 'roles', 'showDetails', 'orderLists', 'updatedAt', 'personalNote'],
            searchFields: ["name", 'email', 'roles', 'phone'],
            orderFields: ["name", 'email', 'phone', 'status'], //['castId.name', 'castId.email'],
            populate: 'castId callsheetInvitationSentId'
        },

        KeyboardServiceParams = {
            canCopy: false,
            canMove: false
        },

        PopupOperations = {
            updateContact: {
                type: 'Edit',
                template: popupTemplate,
                size: 'medium',
                transp: ' ',
            },

            duplicateContact: {
                type: 'Duplicate',
                template: popupTemplate,
                size: 'medium',
                transp: ' ',
            }
        },

        Hotkeys = [
            {key: 'e', desc: 'Edit selected recipients'},
            {key: 'backspace', desc: 'Delete selected recipients'}
        ],

        SidebarOptions = null;

    return {
        PropTypes: PropTypes,
        Settings: Settings,
        Options: Options,
        Filters: {Filters: Filters},
        ViewProp: 'callsheetRecipientsView',

        CompOptions: CompOptions,
        ListTreeServiceParams: ListTreeServiceParams,
        ListParams: ListParams,
        KeyboardServiceParams: KeyboardServiceParams,

        PopupOperations: PopupOperations,
        Hotkeys: Hotkeys,
        SidebarOptions: SidebarOptions,
    };
}

