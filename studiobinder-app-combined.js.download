angular.module('product.preLoading.tasks.service', [
    'product.preLoading.resource.service',
    'apiServices.Tasks'
])
 .service('TasksLoadingService', TasksLoadingService);

TasksLoadingService.$inject = ['PreloadingResourceService', 'TasksService'];
function TasksLoadingService(PreloadingResourceService, objectService) {
    var _this = new PreloadingResourceService(objectService, {
        name: 'Tasks',
        preloadPopulate: 'createdById teamIds',
        tableParamsColsInit: ['companyId', 'todoCardId']
    });

    _this.getPreById = getPreById;

    return _this;

    function getPreById(tableParams, id, settings) {
        var item = _this.service.getObjectById(tableParams, _this.tableType, id);
        return loadAddons(tableParams, item);
    }

    function loadAddons(tableParams, item) {
        if (!item) {
            return item;
        }

        if (item.setupId && (item.type !== 0)) {
            item.setup = _this.service.getObjectById(tableParams, _this.tableType, item.setupId);
            item.segNo = item.setup ? item.setup.segNo : null;
        }

        return item;
    }
}

