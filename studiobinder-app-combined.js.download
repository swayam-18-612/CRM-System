angular.module('product.preLoading.taggingElements.service', [
    'product.preLoading.resource.service',
    'apiServices.TaggingElements',
    'product.preLoading.taggingScenes.service',
    'product.preLoading.locations.service',
    'product.preLoading.contacts.service'
])
    .service('TaggingElementsLoadingService', TaggingElementsLoadingService);

TaggingElementsLoadingService.$inject = ['PreloadingResourceService', 'TaggingElementsService', 'TaggingScenesLoadingService', 'LocationsLoadingService', 'ContactsLoadingService'];
function TaggingElementsLoadingService(PreloadingResourceService, objectService, TaggingScenesLoadingService, LocationsLoadingService, ContactsLoadingService) {
    var _this = new PreloadingResourceService(objectService, {
        name: 'TaggingElements',
        tableParamsColsInit: ['companyId', 'productId', 'scriptId']
    });

    _this.updateItem = updateItem;
    _this.getElementReferences = getElementReferences;
    _this.getElementsCountForStrip = getElementsCountForStrip;
    _this.getElementsNotInStrip = getElementsNotInStrip;
    _this.getCharactersForStrip = getCharactersForStrip;
    _this.getStripLocationForStrip = getStripLocationForStrip;
    _this.setTaggingScenesName = setTaggingScenesName;
    _this.getElementsForStrip = getElementsForStrip;

    return _this;

    function updateItem(tableParams, el) {
        var updated = _this.service.updateItem(tableParams, _this.tableType, el);
        _this.setTaggingScenesName(tableParams);
        return updated;
    }

    function getElementReferences(tableParams, elId) {
        var item = _this.getById(tableParams, elId),
            list = item ? item.currentReferenceIds : null;
        if (list && list.length > 0) {
            return list.map(function (id) {
                return item.type === 3 ? LocationsLoadingService.getById(tableParams, id) : (item.type === 1 ? ContactsLoadingService.getById(tableParams, id) : null);
            });
        }

        return null;
    }

    function getElementsCountForStrip(tableParams, stripId) {
        return getElementsForStrips(tableParams, {stripId: stripId}).length;
    }

    function getElementsForStrips(tableParams, stripQuery) {
        var elsIds = [];
        _.each(TaggingScenesLoadingService.getList(tableParams, stripQuery), function (tag) {
            if (_.find(elsIds, function (id) {
                return id === tag.elementId;
            }) === undefined) {
                elsIds.push(tag.elementId);
            }
        });

        return _this.getList(tableParams, function (item) {
            return elsIds.indexOf(item._id) !== -1;
        });
    }

    function getElementsNotInStrip(tableParams, categoryId, stripId) {
        var idsInStrip = TaggingScenesLoadingService.getElementIdsInStrip(tableParams, categoryId, stripId),
            idsNotInStrip = getElementIds(false),
            ids = idsNotInStrip && idsNotInStrip.length >0 && idsInStrip && idsInStrip.length > 0 ? _.filter(idsNotInStrip, function (id) {
                return idsInStrip.indexOf(id) === -1;
            }) : idsNotInStrip;

        if(!ids || ids.length === 0){return null;}

        return _.filter(ids.map(function (id) {
           return _this.getById(tableParams, id);
        }), function (item) {
            return item;
        });

        function getElementIds(isEqual) {
            var prop = '_id',
                ids = [],
                compare = isEqual ? function  (item) {
                    return item.stripId === stripId;
                } :function  (item) {
                    return item.stripId !== stripId;
                };
            _.each(_this.getList(tableParams), function (item) {
                var match = compare(item) && TaggingScenesLoadingService.hasCategory(item, categoryId);
                if (match) {
                    var elId = item[prop];
                    if (ids.indexOf(elId) === -1) {
                        ids.push(elId);
                    }
                }
            });

            return ids;
        }
    }
    function getCharactersForStrip(tableParams, stripId) {
        return getElementsForStrip(tableParams, stripId, TaggingScenesLoadingService.characterCategoryId);
    }

    function getStripLocationForStrip(tableParams, stripId) {
        var l =  getElementsForStrip(tableParams, stripId, TaggingScenesLoadingService.stripLocationCategoryId);
        return l && l.length > 0 && l[0] ? l[0] : null;
    }

    function getElementsForStrip(tableParams, stripId, categoryId) {
        if (!stripId) {
            return null;
        }

        var l = _.filter(TaggingScenesLoadingService.getList(tableParams, _.extend({stripId: stripId}, categoryId ? {categoryId: categoryId} : null)).map(function (item) {
            return item ? _this.getById(tableParams, item.elementId) : null;
        }), function (item) {
            return item!==undefined;
        });

        return l && l.length > 0 ? l : null;
    }

    function setTaggingScenesName(tableParams, query) {
        var list = TaggingScenesLoadingService.getList(tableParams, query);
        if (list && list.length > 0) {
            _.each(list, function (item) {
                var el = item && item.elementId ? _this.getById(tableParams, item.elementId) : null;
                if (el) {
                    TaggingScenesLoadingService.updateItem(tableParams, {
                        _id: item._id,
                        name: el.name,
                        type: el.type,
                        currentId: el.currentId
                    });
                }
            });
        }
    }

}

addMoSePa('TaggingElements', 'taggingElements', TempTaggingElementsService, {
    serviceInjectList: ['TaggingCategories','Locations', 'Contacts'],
    serviceInjectMod: [
        'resources.TaggingCategories',
        'resources.Locations'
    ]
});
function TempTaggingElementsService(ApiService, model, TaggingCategories, Locations, Contacts) {
    var service = ApiService(model, {
        listType: 'isGroup',
        listField: 'categoryId',
        withScriptId: true,
        materialProps: ['logo'],
        fieldsUpdatedOnOrderChanged: ['currentId'],
        convertOtherResources: convertOtherResources
    });

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.removeSelected = removeSelected;
    service.merge = merge;
    service.unlink = unlink;

    return service;

    function convertOtherResources(item) {
        if (item.categoryId && typeof(item.categoryId) === 'object') {
            item.category = new TaggingCategories(item.categoryId);
            item.categoryId = item.categoryId._id;
        }

        if (item.currentReferenceIds && item.currentReferenceIds.length > 0) {
            if (typeof (item.currentReferenceIds[0]) === 'object') {
                item.currentReferences = [];
                for (var i = 0, l = item.currentReferenceIds.length; i < l; i++) {
                    var el = item.currentReferenceIds[i];
                    item.currentReferences.push((item.type === 1 || item.type === 2) ? new Contacts(el) : item.type === 3 ? new Locations(el) : new ApiResource(el));
                    item.currentReferenceIds[i] = el._id;
                }
            }
        }
        return item;
    }
    function getChangedFieldForUpdateOther() {
        return ['name', 'currentId', 'order', 'currentReferenceIds', 'hideHoldOnDood',  'logo', 'logoId', 'logoRatio', 'commentsCount', 'rate', 'note'];
    }


    function removeSelected(params, successcb, errorcb) {
        return service.postUrl('/remove-selected', params, successcb, errorcb);
    }

    function merge(params, successcb, errorcb) {
        return service.postUrl('/merge-selected', params, successcb, errorcb);
    }

    function unlink(params, successcb, errorcb) {
        return service.postUrl('/unlink-selected', params, successcb, errorcb);
    }
}

angular.module('product.preLoading.taggingScenes.service', [
    'product.preLoading.resource.service',
    'apiServices.TaggingScenes'
])
    .service('TaggingScenesLoadingService', TaggingScenesLoadingService);

TaggingScenesLoadingService.$inject = ['PreloadingResourceService', 'TaggingScenesService'];
function TaggingScenesLoadingService(PreloadingResourceService, objectService) {

    var characterCategoryId = "5a69235edf0fbc89a637c1ab";
    var stripLocationCategoryId = "5a69235fdf0fbc89a637c1c1";

    var _this = new PreloadingResourceService(objectService, {
        name: 'TaggingScenes',
        tableParamsColsInit: ['companyId', 'productId', 'scriptId']
    });

    _this.stripLocationCategoryId = stripLocationCategoryId;
    _this.characterCategoryId = characterCategoryId;
    _this.getElementIdsInStrip = getElementIdsInStrip;

    _this.getTaggingScenesForStrips = getTaggingScenesForStrips;
    _this.hasCategory = hasCategory;

    return _this;

    function getTaggingScenesForStrips(tableParams, stripQuery) {
        var prop = 'elementId',
            elIds = [];
        _.each(_this.getList(tableParams, stripQuery), function (item) {
            var elId = item[prop];
            if (_.find(elIds, function (id) {
                return id === elId;
            }) === undefined) {
                elIds.push(elId);
            }
        });
        return elIds;
    }

    function getElementIds(_this, tableParams, categoryId, stripId, isEqual) {
        var prop = 'elementId',
            ids = [],
            compare = isEqual ? function  (item) {
               return item.stripId === stripId;
            } :function  (item) {
                return item.stripId !== stripId;
            } ;
        _.each(_this.getList(tableParams), function (item) {
            var match = compare(item) && _this.hasCategory(item, categoryId);
            if (match) {
                var elId = item[prop];
                if (ids.indexOf(elId) === -1) {
                    ids.push(elId);
                }
            }
        });

        return ids;
    }

    function getElementIdsInStrip(tableParams, categoryId, stripId) {
        return getElementIds(this, tableParams, categoryId, stripId, true);
    }

    function hasCategory(item, categoryId) {//dont consider strip locations
        return item.categoryId !== stripLocationCategoryId ? (categoryId ? (item.categoryId === categoryId) : true) : false;
    }

}

addMoSePa('TaggingScenes', 'taggingScenes', TempTaggingScenesService, {
    serviceInjectList: ['TaggingElements', 'TaggingCategories', 'Strips'],
    serviceInjectMod: [
        'resources.TaggingElements',
        'resources.TaggingCategories',
        'resources.Strips'
    ]
});
function TempTaggingScenesService(ApiService, model, TaggingElements,TaggingCategories, Strips) {

    var characterCategoryId = "5a69235edf0fbc89a637c1ab";
    var stripLocationCategoryId = "5a69235fdf0fbc89a637c1c1";

    var service = ApiService(model, {
        listType: 'isGroup',
        withScriptId: true,
        convertOtherResources: convertOtherResources
    });

    service.stripLocationCategoryId = stripLocationCategoryId;
    service.characterCategoryId = characterCategoryId;

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.getAllSceneElements = getAllSceneElements;
    service.getAllElementScenes = getAllElementScenes;

    service.updateMultipleForStrip = updateMultipleForStrip;

    service.getNewCurrentId = getNewCurrentId;
    service.sortChars = sortChars;

    return service;

    function getNewCurrentId(elements) {
        var id = 0, temp,
            l = elements && elements.length > 0 ? elements.length : 0;
        for (var i = 0; i < l; i++) {
            temp = getCharId(elements[i]);
            if (temp > id) {
                id = temp;
            }
        }
        return (id + 1).toString();
    }

    function sortChars(a, b){
        var ao = getCharId(a, 10000),
            bo = getCharId(b, 10000);
        return ao > bo ? 1 : (ao < bo ? -1 : 0);
    }

    function getCharId(item, def) {
        if (!def) {
            def = 0;
        }
        var c = item.currentId;
        if (!c) {
            return def;
        }
        var m = (c + '').match(/\d+/);
        if (!m) {
            return def;
        }
        return parseInt(m[0], 10);
    }

    function updateMultipleForStrip(data, successcb, errorcb) {
        return service.putUrl('/update-multiple-for-strip', data, successcb, errorcb, true);
    }

    function convertOtherResources(item) {
        if (item.elementId && typeof(item.elementId) === 'object') {
            item.element = new TaggingElements(item.elementId);
            item.name = item.element.name;
            item.elementId = item.elementId._id;
        }
        if (item.categoryId && typeof(item.categoryId) === 'object') {
            item.category = new TaggingCategories(item.categoryId);
            item.categoryId = item.categoryId._id;
        }
        if (item.stripId && typeof(item.stripId) === 'object') {
            item.strip = new Strips(item.stripId);
            item.stripId = item.stripId._id;
        }

        if(item.type === undefined){
            switch (item.categoryId) {
                case service.stripLocationCategoryId: item.type = 3; break;
                case service.characterCategoryId: item.type = 1; break;
            }
        }
        return item;
    }

    function getChangedFieldForUpdateOther(){
        return ['name', 'order', 'count', 'elementId', 'categoryId'];
    }

    function processElements(params, successcb, errorcb, populate,processItem){
        var pageSize = 20000;
        return service.queryPaged(params, pageSize, 0, null,null,populate,function(result){
            result = result && result.docs ? result.docs : [];
            for(var i = 0 ; i< result.length;i++) {
                result[i] = processItem(service.convertResource(result[i]));
            }

            return successcb (result);
        }, errorcb, true);
    }

    function getAllSceneElements(params, populate, successcb, errorcb) {
        return processElements(params, successcb, errorcb, populate, function(item){
            return item;
        });
    }

    function getAllElementScenes(params, populate, successcb, errorcb) {
        return processElements( params, successcb, errorcb, populate,function(item){
            var ts = service.convertResource(item);
            item  = ts.strip;
            item.elementCount = ts.count;
            return item;
        });
    }
}

