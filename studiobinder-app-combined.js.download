angular.module('user.commentsSidebar.likes.component',[
'user.share.collaborators.service'
])
.component('itemLikes', {
    bindings: {
        uId: '<',
        list: '<',
        isPageShare: '<',
        todoPageId: '@',
        compOptions: '<'
    },
    controller: 'GridItemLikesCtrl'
})
.controller('GridItemLikesCtrl', GridItemLikesCtrl);
GridItemLikesCtrl.$inject =['TemplateCompileCompCtrlService', 'SBFieldMethods', 'RouteCollaboratorsService', '$element'];

function GridItemLikesCtrl(TemplateCompileCompCtrlService, SBFieldMethods, RouteCollaboratorsService, $element) {
    console.log('GridItemLikesCtrl');
    var $ctrl = this;

    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
    $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;

    $ctrl.SBFieldMethods = SBFieldMethods;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.liShare = 'liShare';
        $ctrl.liTeam = 'liTeam';

        //$ctrl.CPS.productId >>>
        $ctrl.team = $ctrl.RouteCollaboratorsService.getProjectTeam($ctrl.CPS.product);
        $ctrl.teamCount = ($ctrl.team ? $ctrl.team.length : 0);

        $ctrl.todoPage = $ctrl.RouteCollaboratorsService.BlocksSetupService.getTodoPageById($ctrl.todoPageId); //todo set it

        addWatcher();

        //when collaborators from the parent get updated propagate : {uId: uId, c:collaborators}
        $ctrl.removeWatcher($ctrl.uPIdRootWatcher);
        $ctrl.uPIdRootWatcher = $ctrl.addRootWatcher('UPDATE_PARENT_COLLABORATORS', onUpdateParentCollaborators);
    }

    function setCollabCount() {
        $ctrl.userCollabs = $ctrl.RouteCollaboratorsService.getUserCollaborators($ctrl.uId, $ctrl.todoPage);
        $ctrl.collabCount = $ctrl.userCollabs ? $ctrl.userCollabs.length : 0;
    }

    function getSharedUrl(item) {
        return item && item._id ? ($ctrl.CPS.websiteUrl + '/shared/' + item._id) : null;
    }

    function addWatcher() {
        if($ctrl.uIdRootWatcher) {
            $ctrl.removeWatcher($ctrl.uIdRootWatcher);
        }
        if ($ctrl.uId) {
            if($ctrl.isDoc) {
                $ctrl.shareListType = $ctrl.itemTitle;
                $ctrl.shareListName = $ctrl.list.name;
            }else {
                var info = $ctrl.RouteCollaboratorsService.getShareListInfo($ctrl.uId, $ctrl.compOptions, $ctrl.isDoc ? $ctrl.list : null ),
                    shareList = info ? info.shareList : null;
                if (shareList) {
                    $ctrl.shareListType = shareList.type;
                    $ctrl.shareListName = shareList.name;
                }
            }

            $ctrl.removeWatcher($ctrl.uIdRootWatcher);
            $ctrl.uIdRootWatcher = $ctrl.addRootWatcher('UPDATE_ITEM_COLLABORATORS_' + $ctrl.uId, onUpdateItemCollaborators);
        }
        setCollabCount();
    }

    function onUpdateItemCollaborators(result) {
        console.log('UPDATE_ITEM_COLLABORATORS');
        $ctrl.reloadTemplate();
    }

    function onUpdateParentCollaborators(result) {
        console.log('UPDATE_PARENT_COLLABORATORS');
        $ctrl.reloadTemplate();
    }

    function share(e) {
        $ctrl.preventDefault(e);
        //todo dont allow collaborators to see the share page
        if (canShare()) {
            if($ctrl.isPageShare){
                $ctrl.broadcastRoot('SHARE_PAGE', {
                    params: {
                        isPageShare: true,
                        uId: $ctrl.uId
                    },
                    e: e
                });
            }else {
                $ctrl.broadcastRoot('SHARE_LIST_FROM_COMMENTS', {uId: $ctrl.uId});

            }
        } else {
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.share.permissions.error', 'error');
        }
    }

    function canShare() {
        return $ctrl.canEdit && !$ctrl.isDashboard && $ctrl.CPS.isAuthenticated &&
            !$ctrl.SBStateService.isProductOverviewState() &&
                $ctrl.BlocksSetupService.todoPageHasShare();
    }

    function onDestroy() {
        bind(false);
    }

    function onLoaded() {
        bind(true);
    }

    function bind(isBind){
        bindOne(isBind, $ctrl.liTeam, goToTeam);
        bindOne(isBind, $ctrl.liShare, share);
    }

    function bindOne(isBind, cls, method) {
        if(isBind){
            $ctrl['btn' + cls] = $ctrl.element.querySelector('.' + cls);
        }

        $ctrl.LCS.bindElementsClick(isBind, $ctrl['btn' + cls], method);
    }

    function getItemTemplate() {
        setCollabCount();
        return '<div>' +
                    getCollabs()+
                    getTeam() +
                '</div>';

        function getCollabs(){
        return '<div class="list-table with-border-bottom">' +
                    '<div class="header">' +
                        $ctrl.LCS.getISBDiv('team', 2, 'pull-left with-margin-right gray') +
                        'Shared with ' + ($ctrl.collabCount + ' collaborator' + ($ctrl.collabCount === 1 ? '' : 's')) +
                    '</div>' +
                    '<div class="select-choices with-teams display-block without-hover clearfix">' +
                        loadlist(true) +
                    '</div>' +
                    getAccess() +
                '</div>';

            function getAccess (){
                return $ctrl.CPS.isAuthenticated ? (
                    '<div>' +
                        '<a class="small inline-block semibold ' + $ctrl.liShare + '" analytics-on analytics-action="Open Share Popup">Manage Access</a>' +
                        '<div class=" padding-right-24 sb-hide">' +
                            '<input class="form-control with-hover font-size-14" id="linkCopy" ng-model="$ctrl.sharedLink" readonly style="min-height: 32px;height:32px">' +
                        '</div>' +
                    '</div>') : '';
            }
        }

        function getTeam(){
     return '<div class="list-table">' +
                '<div class="header">' +
                    $ctrl.LCS.getISBDiv('team', 2, 'pull-left with-margin-right gray') + 'Project Team' +
         //' <span class="with-parenthesis"> ' + ($ctrl.teamCount + ' member' + ($ctrl.teamCount===1?'':'s'))+'</span>' +
                '</div>' +
                '<div class="select-choices with-teams display-block without-hover clearfix">' +
                    loadlist(false)+
                '</div>' +
            '</div>';

        }

        function loadlist(isCollabs) {
            var name = isCollabs ? 'userCollabs' : 'team',
                list = $ctrl[name];
            if(!list){return '';}
            if(isCollabs && !list.length){return '';}

            var el = '';
            _.each(list, function (item, i) {
                el += '<li class="ui-select-choices-group" '+
                    ((isCollabs && (i === 0)) || (!isCollabs && (i === (list.length - 1)))?'style="border-color:transparent"':'')+
                    '>' +
                        '<div class="select-choices-row-inner">' +
                            '<div class="col40 vtop">' + getImage(item, "small34") + '</div>' +
                            '<div class="with-padding-left">' +
                                (item.name ? ('<div class="name">' + item.name + '</div>') : '') +
                                '<div class="email">' + (isCollabs? getAccess(item) : getMemberTypeText(item)) + '</div>' +
                            '</div>' +
                        '</div>' +
                    '</li>';
            });

            return '<ul style="max-height:100%">' + el + '</ul>';
        }

        function getAccess(item) {
            return item.permission === 1 ? 'Viewer' : (item.permission === 2 ? 'Commenter' : 'Editor');
        }

        function getImage(item, cls) {
            return $ctrl.security.getImage(item, cls, 'profilePictureURL', 50);
        }

        function getMemberTypeText(item) {
            var el = _.find($ctrl.SBFieldMethods.MemberTypes, {value: item.memberType});
            return el ? el.text : '';
        }
    }
}

angular.module('item.remove.popup.component', [])
.component('itemRemovePopup', popupComponentParams('ItemRemovePopupCtrl'))
.controller('ItemRemovePopupCtrl', ItemRemovePopupCtrl);
ItemRemovePopupCtrl.$inject = ['ListItemPopupTemplateCtrlService', '$element'];
function ItemRemovePopupCtrl(ListItemPopupTemplateCtrlService, $element) {
    var $ctrl = this;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ListItemPopupTemplateCtrlService($ctrl, $element);

    function setTemplateData() {
        $ctrl.saveOnEnter = true;
        $ctrl.pageClass = 'accent';
        $ctrl.icon = $ctrl.type.indexOf('Remove') !== -1 ? 'trash' : 'box';
        $ctrl.popupTitle = ($ctrl.type.indexOf('Remove') !== -1 ? 'Remove' : $ctrl.type) + ' ' + $ctrl.itemTitle;
        $ctrl.withFooterBtns = true;
        $ctrl.btnText = $ctrl.popupTitle;
    }

    function getPopupBodyContent() {
        return '<p class="text-center medium-size">' +
            ($ctrl.extraParam.noDefault === true ? '' : ('Are you sure you want to ' +
                    ($ctrl.type.indexOf('Remove') !== -1 ? 'remove' : $ctrl.type.toLowerCase()) + ' the ' +
                    ($ctrl.item.getName() ? '' : ' selected ') +
                    ($ctrl.extraParam.withoutType ? '' : $ctrl.itemTitle.toLowerCase()) +
                    ($ctrl.extraParam.withoutName ? '' : ' ') +
                    '<span class="semibold" ng-bind-html="::$ctrl.extraParam.withoutName?\'\':$ctrl.item.getName()|truncate:30"></span>?')
            ) +
            ($ctrl.additionalMessage ? $ctrl.additionalMessage : '') +
            '</p>';
    }
}


angular.module('groupBlock.item.controller', [
    'groupBlock.item.controller.service'
])

.controller('GroupBlockGridItemCtrl',GroupBlockGridItemCtrl);

GroupBlockGridItemCtrl.$inject = ['GridBlockItemGroupInitCtrlService', '$element']
function GroupBlockGridItemCtrl(GridBlockItemGroupInitCtrlService, $element) {
    //console.log('GroupBlockGridItemCtrl: $onInit');
    var $ctrl = this;
    $ctrl = new GridBlockItemGroupInitCtrlService($ctrl, $element);
}


angular.module('groupBlock.item.controller.service', [
    'item.grid.controller.service'
])
.service('GridBlockItemGroupInitCtrlService', GridBlockItemGroupInitCtrlService);
GridBlockItemGroupInitCtrlService.$inject = ['GridItemGroupInitCtrlService'];
function GridBlockItemGroupInitCtrlService(GridItemGroupInitCtrlService) {
    return function ($ctrl, $element) {
       // console.log('GridBlockItemGroupInitCtrlService: $onInit');

        $ctrl.preInitGridItem = preInitGridItem;
        $ctrl.postInitGridItem = postInitGridItem;

        $ctrl = new GridItemGroupInitCtrlService($ctrl, $element);

        return $ctrl;

        function preInitGridItem() {
            if ($ctrl.currentListId === undefined) {
                $ctrl.currentListId = null;
            }
            if ($ctrl.preInitGridItemOther) {
                $ctrl.preInitGridItemOther();
            }
        }

        function postInitGridItem(){
            if (prepItem()) {
                $ctrl.loadItem();
            }

            if ($ctrl.canEdit) {
                $ctrl.addRootWatcher('GROUP_COLS_' + $ctrl.block + '_CHANGED', onColumnsChanged);
            }

            if ($ctrl.postInitGridItemOther) {
                $ctrl.postInitGridItemOther();
            }
        }

        function onColumnsChanged(columns) {
            console.log('onColumnsChanged');
           //todo
            // $ctrl.colList = columns;
            $ctrl.loadItem();
        }

        function prepItem() {
            if (!$ctrl.canEdit) {
                return null;
            }
        }
    }
}


angular.module('item.edit.controller.service', [
    'angularytics.provider'
])
.service('ListItemActionCtrlService', ListItemActionCtrlService);
ListItemActionCtrlService.$inject = ['CPS', 'Angularytics'];
function ListItemActionCtrlService(CPS, Angularytics) { //item, type, objectType, extraParam
    return function($ctrl) { //item, type, objectType, extraParam
        $ctrl.localizedMessages = CPS.localizedMessages;
        $ctrl.SBStateService = CPS.SBStateService;
        $ctrl.LCS = CPS.LCS;

        $ctrl.Angularytics = Angularytics;

        $ctrl.init = init;

        if(!$ctrl.withoutListItemOnSave) {
            $ctrl.onSave = onSave;
        }
        $ctrl.onCustomError = onCustomError;
        $ctrl.cancelPopup = cancelPopup;
        $ctrl.refresh = refresh;
        $ctrl.save = save;
        $ctrl.initItem = initItem;
        $ctrl.getIsNew = getIsNew;
        if(!$ctrl.onCustomSaveInit) {
            $ctrl.onCustomSaveInit = onCustomSaveInit;
        }

        $ctrl.setFocus = setFocus;
        $ctrl.setSelect = setSelect;

        $ctrl.clearForm = clearForm;

        if(!$ctrl.closePopup) {
            $ctrl.closePopup = closePopup;
        }
        if(!$ctrl.isValidForm) {
            $ctrl.isValidForm = isValidForm;
        }

        if(!$ctrl.getDataToUpdate) {
            $ctrl.getDataToUpdate = getDataToUpdate;
        }
        $ctrl.getDataToUpdateInit = getDataToUpdate;

        init();

        return $ctrl;

        function setFocus(name, withSelect) {
            setMethod(name, 'focus', withSelect);
        }

        function setSelect(name) {
            setMethod(name, 'select');
        }

        function setMethod(name, method, withSelect) {
            if (!$ctrl.element) {
                return;
            }
            $ctrl.LCS.timeout(function () {
                if (typeof (name) === "number") {
                    name = null;
                }

                if (!name) {
                    name = $ctrl.defaultFocusField;
                }
                if (typeof (name) !== 'number') {
                    var el = $ctrl.element.querySelector('#' + name);
                    if (!el) {
                        el = $ctrl.element.querySelector('[name="' + name + '"]');
                    }
                }

                if (el) {
                    var selectDiv;
                    if(method === 'select') {
                        if (typeof (el.select) !== 'function') {
                            method = 'focus';
                        }
                    }else if (method === 'focus' && withSelect){
                        var isDiv = (el.tagName === 'DIV' || el.tagName === 'SPAN'),
                            val = isDiv ?  el.innerText : el.value;

                        if( val && val.trim() !== ''){
                            if(isDiv){
                                selectDiv = true;
                            } else{
                                method = 'select';
                            }
                        }
                    }
                    el[method]();

                    if(selectDiv) {try{
                        window.getSelection().selectAllChildren(el);
                    }catch(e){}
                    }
                }
            }, 250);
        }

        function initItem(item) {
            var item1 = item ? item : {};
            $ctrl.item = $ctrl.service ? $ctrl.service.convertResource(item1) : item1;
            $ctrl.copyItem = clone($ctrl.item);

            if($ctrl.item && !$ctrl.objectType && typeof($ctrl.item.getType) === 'function'){
                $ctrl.objectType = $ctrl.item.getType();
            }
        }

        function clone(item){
            return item ? angular.copy(item) : item;
        }

        function init() {
            if(!$ctrl.defaultFocusField) {
                $ctrl.defaultFocusField = $ctrl.defaultProp ? $ctrl.defaultProp : 'name';
            }

            if(!$ctrl.itemTitle){
                $ctrl.itemTitle = $ctrl.extraParam && $ctrl.extraParam.itemTitle ? $ctrl.extraParam.itemTitle : $ctrl.objectType;
            }

            $ctrl.additionalMessage = $ctrl.extraParam && $ctrl.extraParam.additionalMessage ? $ctrl.extraParam.additionalMessage : '';

            if($ctrl.extraParam && $ctrl.extraParam.service) {
                $ctrl.service = $ctrl.extraParam.service;
            }

            if ($ctrl.extraParam && $ctrl.extraParam.scriptLoadingService) {
                $ctrl.scriptLoadingService = $ctrl.extraParam.scriptLoadingService;
            }

            if(!$ctrl.itemChangedFields) {
                $ctrl.itemChangedFields = $ctrl.service ? $ctrl.service.getChangedFieldForUpdate() : [];
            }
/*
            if($ctrl.customBGForList){
                $ctrl.itemChangedFields = $ctrl.itemChangedFields.concat($ctrl.itemChangedFields)
            }*/

            if (!$ctrl.formHolderItem) {
                $ctrl.formHolderItem = {};
            }

            if(!$ctrl.formName) {
                $ctrl.formName = $ctrl.extraParam && $ctrl.extraParam.formName ? $ctrl.extraParam.formName : 'formItem';
            }

            $ctrl.isNew = getIsNew();
            $ctrl.initItem($ctrl.isNew && !$ctrl.item ? {} : $ctrl.item);

            if ($ctrl.type === 'ResendOne') {
                $ctrl.sendToOne = true;
                $ctrl.send = {resetConf: false, cc: false, sms: true, dontSendConfirmToSender: false};
                $ctrl.changes = true;
                $ctrl.name = $ctrl.item.name;
            } else if ($ctrl.type === 'Remove') {
                if ($ctrl.item) {
                    $ctrl.name = $ctrl.item.name;
                }
            }
        }

        function getIsNew() {
            return $ctrl.type && $ctrl.type.indexOf('Create') === 0 || $ctrl.item && !$ctrl.item._id;
        }

        function onSave(result) {
            $ctrl.closePopup(result);
        }

        function onCustomSaveInit(result, e) {
            setUpdating(false, e);

            $ctrl.clearForm();
            var item = result.item;
            if ($ctrl.item && item) {
                if (!$ctrl.item._id) {
                    if(getIsNew()){
                        $ctrl.Angularytics.trackEvent(null, $ctrl.itemTitle + ' ' + (getIsNew() ? 'Created' :  $ctrl.type), {event_value: item._id});
                    }
                    $ctrl.item._id = item._id;
                }
                if (!$ctrl.dontChangeCopyItem) {
                    $ctrl.copyItem = clone($ctrl.item);
                }

                $ctrl.setFocus();
            }
        }

        function onCustomSave(result, e){
            $ctrl.onCustomSaveInit(result, e);
            $ctrl.onSave(result);
        }

        function onCustomError(error, e) {
            setUpdating(false, e);

            if (error && error.name === 'ValidationError') {
                if (error.errors) {
                    for (var prop in error.errors) {
                        var err = error.errors[prop];
                        if (err) {
                            if (prop === 'email' || prop === 'name') {
                                //$ctrl.item[prop] = $ctrl.copyItem[prop];
                                try {
                                    $ctrl.formHolderItem[$ctrl.formName][prop].$error['duplicate'] = err.message;
                                } catch (e) {
                                }
                            } else {
                                $ctrl.error = err.message;
                            }
                        }
                    }
                } else {
                    $ctrl.error = error.message;
                }
            } else {
                $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.' + $ctrl.objectType + '.' + $ctrl.type + '.error', {
                    name: $ctrl.item && typeof ($ctrl.item.getName) === 'function' ? $ctrl.item.getName() : '',
                    itemType: typeof ($ctrl.getItemType) === 'function' ? $ctrl.getItemType() : ($ctrl.itemTitle ? $ctrl.itemTitle.toLowerCase() : '')
                });
            }
            if ($ctrl.onError) {
                $ctrl.onError(error);
            }
        }

        function cancelPopup() {
            $ctrl.refresh();
            $ctrl.closePopup();
        }

        function refresh() {
            $ctrl.error = '';
        }

        function getDataToUpdate() {
            if ($ctrl.item && $ctrl.service) {
                var data = $ctrl.service.getChanges($ctrl.itemChangedFields, $ctrl.item, $ctrl.copyItem, $ctrl.compareWithoutKeys);
                if (data) {
                    data._id = $ctrl.item._id;
                }
                if ($ctrl.passMoreData) {
                    data = $ctrl.passMoreData(data);
                }
                return data;
            }
            return null;
        }

        function save(e) {
            //console.log('ListItemActionCtrlService.save');
            if($ctrl.isUpdating){return;}

            setUpdating(true, e);

            $ctrl.listItemUpdates = null;
            $ctrl.isNew = getIsNew();
            $ctrl.refresh();

            switch ($ctrl.type) {
                case 'Remove':
                    var params = {},
                        t = $ctrl.item && typeof ($ctrl.item.getType) === 'function' ? $ctrl.item.getType() : null;

                    if (t === 'contact') {
                        params = {
                            castIds: [$ctrl.item._id],
                            contactType: $ctrl.item.contactType
                        };

                        if ($ctrl.item.contactListId) {
                            params.contactListId = $ctrl.item.contactListId;
                        }
                    } else if ((t === 'strip' || t === 'shot' || t === 'file' || $ctrl.extraParam.ungroup) && $ctrl.extraParam.params) {
                        params = _.extend(params, $ctrl.extraParam.params);
                    }

                   return $ctrl.service.delete(_.extend(params, {_id: $ctrl.item._id}), oncustomsave, oncustomerror);

                    break;

                case 'ResendOne':   //Resend Calltime
                    $ctrl.send.companyId = $ctrl.CPS.companyId;
                    $ctrl.send.productId = $ctrl.CPS.productId;
                    var stateParams = $ctrl.SBStateService.getCurrentStateParams();
                    $ctrl.send.callsheetId = stateParams ? stateParams.callsheetId : null;
                    $ctrl.send._id = $ctrl.item._id;
                    return $ctrl.service.resendInvite($ctrl.extraParam.security.sendGeneratorRequest, $ctrl.send, oncustomsave, oncustomerror);
                    break;

                case 'Archive':
                    //when archiving a list in a folder set the parent to null so that it will be displayed in archived lists
                    return  $ctrl.service.archive(_.extend({
                        _id: $ctrl.item._id
                    }, $ctrl.service.listType === 'isList' && $ctrl.item.parentId ? {parentId : null} : null), oncustomsave, oncustomerror);
                    break;

                case 'Activate':
                    return $ctrl.service.activate({
                        _id: $ctrl.item._id
                    }, oncustomsave, oncustomerror);
                    break;

                case 'Create':
                case 'Edit':
                case 'Merge':
                case 'Unlink':
                case 'Duplicate':
                    if ($ctrl.isValidForm() &&
(!$ctrl.isValidFormOther || $ctrl.isValidFormOther && $ctrl.isValidFormOther())) {
                        if ($ctrl.isNew) {
                            var method = (
                                $ctrl.type === 'Duplicate' ||
                                $ctrl.type === 'Merge' ||
                                $ctrl.type === 'Unlink'
                            )   ? $ctrl.type.toLowerCase() : 'insert';
                            return  $ctrl.service[method]($ctrl.item, oncustomsave, oncustomerror);
                        } else { //Edit
                            $ctrl.listItemUpdates = $ctrl.getDataToUpdate();
                            if ($ctrl.listItemUpdates) {
                                if($ctrl.item.companyId){
                                    $ctrl.listItemUpdates.companyId = $ctrl.item.companyId;
                                }
                                if($ctrl.item.productId){
                                    $ctrl.listItemUpdates.productId = $ctrl.item.productId;
                                }
                                if($ctrl.item.scriptId){
                                    $ctrl.listItemUpdates.scriptId = $ctrl.item.scriptId;
                                }
                                if($ctrl.item.callsheetId){
                                    $ctrl.listItemUpdates.callsheetId = $ctrl.item.callsheetId;
                                }
                                return  $ctrl.service.update($ctrl.listItemUpdates, oncustomsave, oncustomerror);
                            } else {
                                return onCustomSave({item: $ctrl.item, noUpdates: true}, e);
                            }
                        }
                    } else {
                        return setUpdating(false, e);
                    }
                    break;
            }

            function oncustomsave(result) {
                return onCustomSave(result, e);
            }

            function oncustomerror(result) {
                return $ctrl.onCustomError(result, e);
            }
        }

        function setUpdating(isOn, e){
            $ctrl.isUpdating = isOn;
            if(e && e.currentTarget){
                $ctrl.LCS[$ctrl.isUpdating ? 'removeClass' : 'addClass'](e.currentTarget.querySelector('.animate-spin'), 'sb-hide');
            }
        }

        function closePopup(result) {
            if ($ctrl.onClose) {
                $ctrl.onClose({result: result || 'cancel'});
            }
        }

        function isValidForm() {
            console.log('ListItemActionCtrlService.isValidForm');
            var hasForm = false;
            if($ctrl.formHolderItem && $ctrl.formHolderItem[$ctrl.formName]){
                hasForm = true;
                $ctrl.formHolderItem[$ctrl.formName + '_attempted'] = true;
            }else{
                console.warn('Check if parent for ListItemActionCtrlService requires validation. If does must define $ctrl.formHolderItem.formItem');
            }
            return hasForm && $ctrl.formHolderItem[$ctrl.formName].$valid || !hasForm;
        }

        function clearForm() {
            if(!$ctrl.clean){return;}
            console.log('ListItemActionCtrlService.clearForm');

            if ($ctrl.formHolderItem && $ctrl.formHolderItem[$ctrl.formName]) {
                $ctrl.formHolderItem[$ctrl.formName + '_attempted'] = false;
                $ctrl.formHolderItem[$ctrl.formName].$setPristine();
            }
            $ctrl.validators = {};

            if(typeof($ctrl.clearFormOther) === 'function') {
                $ctrl.clearFormOther();
            }

            console.log('ListItemActionCtrlService.clearForm: reloadTemplate');
            if($ctrl.reloadTemplate) {
                $ctrl.reloadTemplate();
            }
        }
    };
}


angular.module('item.listTemplate.controller.service', [
    'item.edit.listTemplate.init.controller.service',
    'templateCompilePopup.controller.service'
])
.service('ListItemTemplateFormCtrlService', ListItemTemplateFormCtrlService);
ListItemTemplateFormCtrlService.$inject = ['ItemTemplateCompileCtrlService', 'ListItemTemplateInitCtrlService', 'SBFieldTypesService'];
function ListItemTemplateFormCtrlService(ItemTemplateCompileCtrlService, ListItemTemplateInitCtrlService , SBFieldTypesService ) {
    return function ($ctrl, $element, isPopup) { //item, type, objectType, extraParam
        $ctrl.SBFieldTypesService = SBFieldTypesService;
        $ctrl.SBFieldMethods = SBFieldTypesService.SBFieldMethods;

        $ctrl.ItemTemplateCompileCtrlService = ItemTemplateCompileCtrlService;
        $ctrl.ListItemTemplateInitCtrlService = ListItemTemplateInitCtrlService;

        $ctrl.isNameInvalid = isNameInvalid;
        $ctrl.isNameDuplicate = isNameDuplicate;
        $ctrl.getNameInput = getNameInput;
        $ctrl.onListItemSave = onListItemSave;
        $ctrl.onClean = onClean;
        $ctrl.setDefaultColumns = setDefaultColumns;
        $ctrl.getPopupFormForSelected = getPopupFormForSelected;
        $ctrl.getPopupFormForSelectedCol = getPopupFormForSelectedCol;

        $ctrl.getPopupEditRow = getPopupEditRow;
        $ctrl.onValidation = onValidation;
        if(!$ctrl.msFormOnNext) {
            $ctrl.msFormOnNext = msFormOnNext;
        }
        $ctrl.msFormOnNextInit = msFormOnNext;

        if(!$ctrl.getPopupForm) {
            $ctrl.getPopupForm = getPopupForm;
        }

        if(!$ctrl.withFormValidation && !$ctrl.isValidForm) {
            $ctrl.isValidForm = isValidForm;
        }

        if(!$ctrl.listItemTemplateLoaded) {
            if(isPopup && $ctrl.dontAutoloadTemplate === undefined) {
                $ctrl.dontAutoloadTemplate = false;
            }

            $ctrl.preInit = preInit;

            $ctrl = new $ctrl.ItemTemplateCompileCtrlService($ctrl, $element, isPopup);

            $ctrl.listItemTemplateLoaded = true;
        }

        return $ctrl;

        function msFormOnNext(){
            console.log('msFormOnNext');
            return !$ctrl.isValidForm || typeof ($ctrl.isValidForm) === 'function' && $ctrl.isValidForm();
        }

        function preInit() {
            if(isPopup && $ctrl.item){
                $ctrl.item = angular.copy($ctrl.item);
            }

            if($ctrl.saveOnKeydown === undefined){
                $ctrl.saveOnKeydown = true;
            }
            if (!$ctrl.extraParam) {
                $ctrl.extraParam = {};
            }
            $ctrl.isDuplicate = $ctrl.type === 'Duplicate' || $ctrl.extraParam.isDuplicate;
            if($ctrl.extraParam.elemType) {
                $ctrl.elemType = $ctrl.extraParam.elemType;
            }
            if($ctrl.extraParam.itemTitle) {
                $ctrl.itemTitle = $ctrl.extraParam.itemTitle;
            }
            if($ctrl.extraParam.service) {
                $ctrl.service = $ctrl.extraParam.service;
            }
            if($ctrl.extraParam.columnsList && $ctrl.extraParam.columnsList.length > 0) {
                $ctrl.columnsList = $ctrl.extraParam.columnsList;
            }
            if($ctrl.extraParam.withLabel) {
                $ctrl.withLabel = $ctrl.extraParam.withLabel;
            }
            if($ctrl.extraParam.columnImg) {
                $ctrl.columnImg = $ctrl.extraParam.columnImg;
            }

            if($ctrl.extraParam.listTreeService && $ctrl.extraParam.listTreeService.filtersService) {
                $ctrl.filtersService = $ctrl.extraParam.listTreeService.filtersService;
                $ctrl.Settings = $ctrl.filtersService.Settings;
            }

            if($ctrl.extraParam.Settings) {
                $ctrl.Settings = $ctrl.extraParam.Settings;
            }

            if($ctrl.extraParam.imgObserverService) {
                $ctrl.imgObserverService = $ctrl.extraParam.imgObserverService;

                $ctrl.keyboardService = $ctrl.extraParam.imgObserverService.keyboardService;
            }

            if($ctrl.extraParam.with2FooterBtns) {
                $ctrl.with2FooterBtns = $ctrl.extraParam.with2FooterBtns;
            }

            if($ctrl.extraParam.with2FooterBtns) {
                $ctrl.with2FooterBtns = $ctrl.extraParam.with2FooterBtns;
            }

            if($ctrl.extraParam.field) {
                $ctrl.defaultFocusField = $ctrl.extraParam.field;
            }

            if(!$ctrl.defaultProp){
                $ctrl.defaultProp = 'name';
            }

            if($ctrl.preInitOther){
                $ctrl.preInitOther();
            }

            if($ctrl.dontAutoloadTemplate === undefined) {
                $ctrl.dontAutoloadTemplate = true;
            }

            $ctrl = new ListItemTemplateInitCtrlService($ctrl);

            //overwrite on save from ListItemActionCtrlService
            $ctrl.onSave = onSave;
            $ctrl.onSaveEditTemplate = onSave;

            if($ctrl.postInitOther){
                //here can overwrite $ctrl.onSave from above
                $ctrl.postInitOther();
            }
        }

        function setDefaultColumns(isLast, withDescription) {
            $ctrl.columnsList = [setDefaultColumn($ctrl.defaultProp, $ctrl.itemTitle, withDescription ? false : isLast)];
            if(withDescription){
                var field =  'Description';
                $ctrl.columnsList.push({
                    name: field,
                    prop: 'description',
                    type: $ctrl.SBFieldTypesService.PropTypes.Html,
                    colCls: ' note-col',
                    canHide: true,
                    order: 7,
                    canEdit: true,
                    canSort: true,
                    placeholder: 'Enter '+field+'…',
                    buttonsType: 1,
                    withEllipsis: true,
                    withBottomToolbar: true,
                    icon: 'text',
                    iconLevel: 3,
                    tabIndex: 2
                });
            }
        }

        function setDefaultColumn(prop, itemTitle, isLast) {
            return {
                name: itemTitle,
                prop: prop,
                placeholder: itemTitle + ' name…',
                showMobile: true,
                type: $ctrl.SBFieldTypesService.PropTypes.Field,
                isRequired: true,
                icon: 'title',
                isMobileTitle: true,
                order: 1,
                tabIndex: 1,
                tabNextIndex: 2,
                withoutLabelInPopup: true,
                isLastRow: isLast
            } ;
        }

        function getNameInput(prop, inputCls, placeholder) {
            if(!prop){prop = 'name';}
            return '<input placeholder="'+(placeholder ? placeholder : ($ctrl.itemTitle+' name…'))+'" class="' +
                 getEClassAttr() +
                ' '+ (inputCls ? inputCls : '')+'" type="text" id="name" name="name" ng-model="$ctrl.item.'+prop+'" required ui-focus="true">' +
                '<label ng-show="$ctrl.item.'+prop+'" class="with-label">'+prop+'</label>'+
                '<div ng-show="$ctrl.isNameInvalid(\''+prop+'\')" class="help-inline ng-hide">'+prop+' is required.</div>' +
                '<div ng-show="$ctrl.isNameDuplicate(\''+prop+'\')" class="help-inline ng-hide" ng-bind="$ctrl.formHolderItem[$ctrl.formName].'+prop+'.$error.duplicate"></div>';
        }

        function isNameInvalid(prop) {
            return isAtt(prop) && $ctrl.formHolderItem[$ctrl.formName][prop].$error.required;
        }

        function isNameDuplicate(prop) {
            return isAtt(prop) && $ctrl.formHolderItem[$ctrl.formName][prop].$error.duplicate;
        }

        function isAtt(prop) {
            return ($ctrl.formHolderItem[$ctrl.formName][prop].$dirty || $ctrl.formHolderItem[$ctrl.formName + '_attempted']);
        }

        function onListItemSave(result, updates, withoutClose) {
            console.log('ListItemTemplateFormCtrlService.onListItemSave');
            $ctrl.isUpdating = false;
            if(!result){return;}
            result.isPopup = $ctrl.isPopup;

            if(!$ctrl.isNew){
                if($ctrl.type === 'Edit'){
                    console.log('onChangedField');
                    result.eventType = 'CHANGED_FIELD';
                }
                result.editchanges = updates;
            }

            var forceNonClose = false;
            if(typeof($ctrl.onSaveGeneral) === 'function'){
                forceNonClose = $ctrl.onSaveGeneral(result);
            }

            if($ctrl.isTreeAdd){
                result.treeType = $ctrl.extraParam.treeType;
            }

            //dont add template to tree
            //ADDED_  UPDATED_
            if(!result.isTemplate && $ctrl.elemType) {
                var path = //result.processMultiple && $ctrl.isNew ? ('ADDED_MULTIPLE_' + $ctrl.elemType + '_' + $ctrl.currentListId) :
                (($ctrl.type === 'Remove' ? 'REMOVED' :
                    ($ctrl.isNew ? 'ADDED' : 'UPDATED')) + '_' +
                    $ctrl.elemType + '_' +
                    ($ctrl.isTreeAdd ? 'TREE' : 'ITEM'));

                if($ctrl.delayBroadcast){
                    $ctrl.LCS.timeout(process, 100);
                } else{
                    process();
                }

                if($ctrl.isTreeAdd && $ctrl.type === 'Edit'){
                    //$ctrl.broadcastRoot('NAME_CHANGED_' + $ctrl.elemType + '_TREE', result);
                }

                function process() {
                    $ctrl.broadcastRoot(path, result);
                }
            }

            if(typeof($ctrl.onSaveAfter) === 'function'){
                $ctrl.onSaveAfter(result);
            }

            $ctrl.onClean(forceNonClose ? forceNonClose : withoutClose);
        }

        function onClean(withoutClose){
            console.log('onClean');
            if($ctrl.extraParam && $ctrl.extraParam.maxAddedCount > 0) {
                $ctrl.extraParam.maxAddedCount -= 1;
                if ($ctrl.extraParam.maxAddedCount <= 0) {
                    $ctrl.clean = false;
                }
            }

            if ($ctrl.clean) {                //addafter
                $ctrl.item = $ctrl.extraParam.getNew(clone($ctrl.item), $ctrl.cleanParamType);
                $ctrl.copyItem = clone($ctrl.item);
                $ctrl.clearForm();
                $ctrl.setFocus();
            } else if (!withoutClose) {
                $ctrl.closePopup();
            }
        }

        function clone(item){
            return item ? angular.copy(item) : item;
        }

        function getPopupForm(isImg) {
            return $ctrl.getPopupFormForSelected(getcolumns()) +
                (typeof($ctrl.getPopupFormOther) === 'function' ? $ctrl.getPopupFormOther(): '');

            function getcolumns(){
                if(isImg){return [$ctrl.columnImg];}
                if(!$ctrl.columnsList) {
                    setDefaultColumns(true);
                }
                return $ctrl.columnsList;
            }
        }

        function cantEditInPopup(c){
            return c ? (c.cantEditInPopup ? false : (c.forceCanEdit ? c.forceCanEdit : $ctrl.canEdit)) : false;
        }

        function getPopupEditRow(list, width, withLabel, isMobile, params) {
            var type = 'l' + (new ObjectId().toString());
            $ctrl [type] = list;
            var el = '';
            _.each(list, function (c, i) {
                el += addCol(_.extend({}, c,
                    {canEdit: cantEditInPopup(c)},
                    params ? params : null
                ), type, i, width, i < (list.length - 1));
            });
            return el;

            function addCol(c, type, i, width, withPadding) {
                var val = get();
                //if(!val){return '';}
                if(isMobile){
                        return val;
                   }else {
                     return '<div class="' +
                         width + ' ' +
                         (withPadding ? ' padding-right20' : '') + '">' +
                                 '<div class="form-group full-width">' + val + '</div>' +
                            '</div>';
                }

                function get() {
                    return $ctrl.getPopupFormForSelectedCol(c, withLabel,false);
                }
            }
        }

        function getPopupFormForSelectedCol(col, withLabel, withoutEClassAttr) {
            return getPopupFormForSelected([col], withLabel, withoutEClassAttr);
        }
        function getPageClass(){return $ctrl.pageClass ? ('page-class '+$ctrl.pageClass):'';}

        function getEClassAttr() {
            return ' form-control with-underline ' + getPageClass();
        }

        function getPopupFormForSelected(cols, withLabel, withoutEClassAttr) {
            var columns = [],
                eClassAttr = withoutEClassAttr ? '' : getEClassAttr();
            _.each(cols, function (c) {
                if (c) {
                    var m = c.multiDiv;
                    if (m) {
                        var c1 = _.extend({}, c);
                        var columns1 = [];
                        _.each(m, function (c) {
                            var c1 = process(c);
                            if (c1) {
                                columns1.push(c1);
                            }
                        });
                        c1.multiDiv = columns1;
                        if (c1) {
                            columns.push(c1);
                        }

                    } else {
                        var c1 = process(c);
                        if (c1) {
                            columns.push(c1);
                        }
                    }
                }
            });

            var onChangeOther;
            if ($ctrl.getOtherFormParams) {
                onChangeOther = function (result) {
                    for (var prop in $ctrl.getOtherFormParams) {
                        $ctrl.getOtherFormParams[prop](result);
                    }
                }
                $ctrl.onChangeOther = onChangeOther;
            }

            return $ctrl.SBFieldTypesService.getPopupSBForm($ctrl, columns, _.extend({
                //todo: only on tasks
                saveOnKeydown: $ctrl.saveOnKeydown,
                onValidation: $ctrl.onValidation,

                withLabel: $ctrl.withLabel || withLabel,
            }, typeof (onChangeOther) === 'function' ? {onChangeOther: $ctrl.onChangeOther} : null));

            function process(c) {
                if (c && !c.notInModal) {
                    var isImg = c.type === $ctrl.SBFieldTypesService.PropTypes.Picture,
                        canEdit = cantEditInPopup(c),
                        ext;
                    if (isImg) {
                        ext = {
                            //imgSize: 'intermedium',
                            canUploadAttr: canEdit,
                            loadLater: false,
                            withImgBg: false,
                        };
                    } else {
                        ext = {canEdit: canEdit};
                        if(c.type === $ctrl.SBFieldTypesService.HtmlTooltip) {
                            ext.type = $ctrl.SBFieldTypesService.Html;
                        }
                        if (c.customDrpClass) {
                            ext.drpClassAttr = (c.drpClassAttr || '') + ' custom-drp-size';
                        }

                        if (canEdit){
                            if(c.type !== $ctrl.SBFieldTypesService.PropTypes.Color) {
                                ext.eClassAttr = eClassAttr;
                            }
                        }else{
                            if(c.eClassAttr) {
                                ext.eClassAttr = c.eClassAttr.replace('with-underline','').replace('with_underline', '').replace('hover_underline', '');
                            }
                        }
                        if(c.fieldClass) {
                            ext.fieldClass = c.fieldClass.replace('text-center', '').replace('centering', '');
                            if(ext.fieldClass.trim() === ''){ext.fieldClass = null;}
                        }

                        if(c.wrapperClass) {
                            ext.wrapperClass = c.wrapperClass.replace('centered', '');
                            if(ext.wrapperClass.trim() === ''){ext.wrapperClass = null;}
                        }
                    }
                    var apply = true;// !($ctrl.isNew && isImg)
                    if (apply) {
                        return _.extend({}, c, ext);
                    }
                }
                return null;
            }
        }
 
        function onValidation(result) {
            if (!result) {
                return;
            }

            if (!$ctrl.validators) {
                $ctrl.validators = {};
            }

            for (var prop in result) {
                $ctrl.validators[prop] = result[prop];
            }
        }

        function isValidForm() {
            //console.log('ListItemTemplateFormCtrlService.isValidForm');
            if(!$ctrl.validators){return true;}
            for (var prop in $ctrl.validators) {
                if(!$ctrl.validators[prop]){
                    return false;
                }
            }
            return true;
        }

        function onSave(result) {
            console.log('ListItemTemplateFormCtrlService.onSave');
            $ctrl.onListItemSave(result, $ctrl.listItemUpdates ? $ctrl.listItemUpdates : null, result.withoutClosePopup ? true : false);
        }
    };
}

/*for editable field that autosaves */
angular.module('item.edit.listTemplate.init.controller.service', [
    'item.edit.controller.service'
])
.service('ListItemTemplateInitCtrlService', ListItemTemplateInitCtrlService);
ListItemTemplateInitCtrlService.$inject = ['ListItemActionCtrlService', 'SBFieldTypesService'];
function ListItemTemplateInitCtrlService(ListItemActionCtrlService, SBFieldTypesService ) { //item, type, objectType, extraParam
    return function ($ctrl) { //item, type, objectType, extraParam

        $ctrl.SBFieldTypesService = SBFieldTypesService;
        $ctrl.SBFieldMethods = SBFieldTypesService.SBFieldMethods;

        if (!$ctrl.getElementId) {
            $ctrl.getElementId = getElementId;
        }

        $ctrl = new ListItemActionCtrlService($ctrl);

        if (!$ctrl.onChange) {
            $ctrl.onChange = onChange;
        }

        if (!$ctrl.onCancel) {
            $ctrl.onCancel = onCancel;
        }

        if (!$ctrl.setEditFocus) {
            $ctrl.setEditFocus = setEditFocus;
        }

        if (!$ctrl.onLoaded) {
            $ctrl.onLoaded = onLoaded;
        }

        return $ctrl;

        function getElementId(prop) {
            return $ctrl.SBFieldTypesService.getElementIdFromItem($ctrl.item, prop);
        }

        function onLoaded() {
            //console.log('on loaded set focus');
            $ctrl.setSelect();
            bind(true);
        }

        function bind(isBind) {
            //todo
            if($ctrl.saveOnEnter){
                //bind save events
            }
        }

        function onChange(result) {
            //console.log('ListItemTemplateInitCtrlService.onChange');
            if(!result){
                console.log('onchange: result is undefined');
                return;
            }

            //console.log('GridItemEditGroupInitCtrlService.onchange');
            var selected = result.selected;
            if (selected) {
                var s = selected.field.split('.');
                if (s.length === 1) {
                    $ctrl.item[selected.field] = selected.val;
                } else if (s.length === 2) {
                    if (!$ctrl.item[s[0]]) {
                        $ctrl.item[s[0]] = {};
                    }
                    $ctrl.item[s[0]][s[1]] = selected.val;
                }
            }

            if (typeof ($ctrl.onChangeOther) === 'function') {
                $ctrl.onChangeOther(result);
            }

            onCancel(result);
        }

        function onCancel(result) {
            //console.log('ListItemTemplateInitCtrlService.onCancel');
            if(result.close ){
                var prop = result.selected ? result.selected.field : null;
                if(prop) {
                     $ctrl.broadcastRoot('CLOSE_GRID_EDITABLE_FIELD', prop ? {
                        _id: $ctrl.item._id,
                        prop: prop,
                        elementId: $ctrl.getElementId(prop)
                    } : null);
                }
            }
            $ctrl.setEditFocus(result.tabNextIndex);
        }

        function setEditFocus(tabIndex) {
            if (tabIndex !== undefined) {
                $ctrl.broadcastRoot('SET_FIELD_FOCUS_' + tabIndex);
            }
        }
    };
}


angular.module('item.listTemplate.popup.controller.service', [
    'item.listTemplate.controller.service'
])
.service('ListItemPopupTemplateCtrlService', ListItemPopupTemplateCtrlService);
ListItemPopupTemplateCtrlService.$inject = ['ListItemTemplateFormCtrlService'];
function ListItemPopupTemplateCtrlService(ListItemTemplateFormCtrlService ) { //item, type, objectType, extraParam
    return function ($ctrl, $element) { //item, type, objectType, extraParam
        $ctrl.isPopup = true;

        return new ListItemTemplateFormCtrlService($ctrl, $element, $ctrl.isPopup);
    };
}

angular.module('item.field.edit.controller.service', [
    'sb.fields.types.service'
])
.service('ItemFieldEditCtrlService', ItemFieldEditCtrlService);
function ItemFieldEditCtrlService() {
    return function ($ctrl) {
        if(!$ctrl.onCloseEditableField) {
            $ctrl.onCloseEditableField = onCloseEditableField;
        }
        $ctrl.onCloseEditableFieldInit = onCloseEditableField;
        $ctrl.onChangedFieldInit = onChangedFieldInit;

        if(!$ctrl.onChangedField){
            $ctrl.onChangedField = onChangedField;
        }

        return $ctrl;

        function onCloseEditableField(result) {
            //console.log('onCloseEditableField');

            if(typeof($ctrl.closeEditableField) === 'function') {//ingroup
                $ctrl.closeEditableField(result);
            }

            //console.log('onCloseEditableField');
            var id = result ? result.id : null;
            if (!id) {
                return;
            }
            //remove the component element
            var prop = result ? result.prop : null;
            if (!prop) {
                return;
            }

            if($ctrl.onCloseEditableFieldOther) {
                $ctrl.onCloseEditableFieldOther(prop, result);
            }

            return false;
        }

        function onChangedFieldInit(result) {
            //console.log('onChangedFieldInit');
            //item prop withClose
            //todo figure out what to update next
            //call it from inside the editable item on blur or enter
            if (result) {
                if (result.close) {
                    $ctrl.onCloseEditableField(result);
                    //create the next
                }
                $ctrl.onChangedField(result);
            }

            return false;
        }

        function onChangedField(result) {
            //console.log('onChangedField');
            var newres = result.newRes;
            if (newres) {
                newres.eventType = 'CHANGED_FIELD';
                newres.editchanges = result.editchanges;
                if(result.resultInit) {
                    newres.resultInit = result.resultInit;
                }
                $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', newres);
            }
        }
    }
}

angular.module('item.form.init.controller.service', [
])
.service('ItemTemplateFormInitCtrlService', ItemTemplateFormInitCtrlService);
ItemTemplateFormInitCtrlService.$inject = [];
function ItemTemplateFormInitCtrlService(  ) {
    return function ($ctrl) { //item, type, objectType, extraParam
        if (!$ctrl.initFormTemplateS) {
            $ctrl.initFormTemplateS = true;

            if(!$ctrl.getItemPopupFieldset) {
                $ctrl.getItemPopupFieldset = getItemPopupFieldset;
            }
            if(!$ctrl.getItemPopupMSForm) {
                $ctrl.getItemPopupMSForm = getItemPopupMSForm;
            }
            if (!$ctrl.isBtnDisabled) {
                $ctrl.isBtnDisabled = isBtnDisabled;
            }
            if (!$ctrl.getErrorBlock) {
                $ctrl.getErrorBlock = getErrorBlock;
            }
            $ctrl.isBtnDisabledInit = isBtnDisabled;

            $ctrl.setTemplateDataInit = setTemplateDataInit;

            if (!$ctrl.getMobileBack) {
                $ctrl.getMobileBack = getMobileBack;
            }

            if (!$ctrl.getItemTemplate) {
                $ctrl.getItemTemplate = getItemTemplate;
            }

            if (!$ctrl.getItemPopupTemplate) {
                $ctrl.getItemPopupTemplate = getItemPopupTemplate;
            }

            if (!$ctrl.getItemPopupFieldsetContent) {
                $ctrl.getItemPopupFieldsetContent = getItemPopupFieldsetContent;
            }
            if (!$ctrl.getPopupBody) {
                $ctrl.getPopupBody = getPopupBody;
            }

            if (!$ctrl.getPopupFooter) {
                $ctrl.getPopupFooter = getPopupFooter;
            }

            if (!$ctrl.getPopupFooterBtns) {
                $ctrl.getPopupFooterBtns = getPopupFooterBtns;
            }

            if (!$ctrl.getPopupHeader) {
                $ctrl.getPopupHeader = getPopupHeader;
            }

            if (!$ctrl.getPopupBodyContent) {
                $ctrl.getPopupBodyContent = getPopupBodyContent;
            }
            if(!$ctrl.getPopupLogo) {
                $ctrl.getPopupLogo = getPopupLogo;
            }

            $ctrl.getPopupHeaderForInfo = getPopupHeaderForInfo;
            $ctrl.getbtn = getbtn;
            $ctrl.removeHtmlTags = removeHtmlTags;

            $ctrl.cancelPopup = cancelPopup;
            if(!$ctrl.close) {
                $ctrl.close = close;
            }
        }

        return $ctrl;

        function getItemTemplate() {
            $ctrl.setTemplateDataInit();

            if (!$ctrl.modalBodyFormClass) {
                var el = $ctrl.LCS.findClosestParent($ctrl.element, '.modal-dialog.modal-sm');
                if (!el) {
                    $ctrl.modalBodyFormClass = 'long';
                }

                el = $ctrl.LCS.findClosestParent($ctrl.element, '.modal-dialog.modal-medium');
                if (el) {
                    $ctrl.modalBodyFormClass = 'max-width-424';
                }
            }
            if(!$ctrl.parentContainer) {
                $ctrl.parentContainer = '.modal-dialog .modal-content .sb-modal-content-w .modal-body .form-wrapper';
            }

            return $ctrl.getItemPopupTemplate();
        }

        function getItemPopupMSForm(listData, cls, withClose, other) {
            return '<div ms-form class="full-width msform ' + (cls || '') + '" ' + (other || '') + ' on-next="$ctrl.msFormOnNext(e)"' + '>' +
                ($ctrl.isPopup && withClose ? $ctrl.nonMobileCloseBtn() : '') +
                getFieldSets() +
                '</div>';

            function getFieldSets() {
                var l = '';
                _.each(listData, function (data, i) {
                    if (data) {
                        l += getItemPopupFieldset(data, i);
                    }
                });
                return l;
            }
        }

        function getItemPopupFieldset(data, i) {
          /* fCls:
             cls:
             btn: btn,
             icon:icon,
             iconLevel: iconLevel,
             title:title,
             body: body*/

        return '<fieldset data-id="'+i+'" class="fieldset ' + (data.fCls || '') + '" ' + (data.fCond ? (' ng-show="' + data.fCond + '"') : '') + '>' +
                    '<div class="display-block clearfix centered ' + (data.cls || '') + '">' +
                        $ctrl.getItemPopupFieldsetContent(data) +
                    '</div>' +
                '</fieldset>';
        }
        //{data: btn, headerInfo, body, fieldsetCls, bodyCls}
        function getItemPopupFieldsetContent(data) {
            if(!data){data = {};}
            var clsModal = 'sb-modal-content-w centered ' +
            ($ctrl.LCS.isMobileSize ? (' fancy-scrollbar ultrathin ' + 'font-general font-general-16') : '');
            return $ctrl.isPopup ? (
                ($ctrl.withCloseBtn && $ctrl.nonMobileCloseBtn ? $ctrl.nonMobileCloseBtn() : '') +
                $ctrl.getMobileBack(data.btn) +
                '<div class="' + (data.fieldsetCls || clsModal) + '">' + getc() + '</div>'
            ) : getc();

            function getc() {
             return ($ctrl.preTemplate ? $ctrl.preTemplate() : '') +
                    ($ctrl.hideHeader ? '' : (data.headerInfo ? $ctrl.getPopupHeaderForInfo(data.headerInfo) : $ctrl.getPopupHeader()) )+
                    $ctrl.getPopupBody(data.body,null, data.bodyCls) +
                 ($ctrl.hideFooter ? '' :  $ctrl.getPopupFooter(data.btn)) +
                    ($ctrl.postTemplate ? $ctrl.postTemplate() : '');
            }
        }

        function getItemPopupTemplate() {
            return $ctrl.getItemPopupFieldsetContent(
        typeof($ctrl.getItemPopupFieldsetContentParams) === 'function' ? $ctrl.getItemPopupFieldsetContentParams() : null);
        }

        function getMobileBack(footerbtns, backBtn, method) {
            if(!$ctrl.isPopup){return '';}
    return '<div class="modal-header with-gray-bottom mobile-nav-header table-div hide-print">' +
                ($ctrl.withoutBackBtn ? '' : ('<div class="centered">' +
                    '<div class="' + $ctrl.getBtnActionCls() + ' table-div full-width with-cursor"' + (backBtn ? '' : ' data-type="' + (method ? method : 'close') + '"') + '>' +
                        (backBtn ? backBtn : ('<div class="centered col24">'+ $ctrl.LCS.getISBDiv('back', 2, 'pull-back') +'</div> <div class="semibold">' + ($ctrl.txtBack || 'Back') + '</div>')) +
                    '</div>' +
                '</div>')) +
                ($ctrl.withFooterBtns ? ('<div class="centered text-right">' + (footerbtns ? footerbtns : $ctrl.getPopupFooterBtns()) + '</div>') : '') +
            '</div>';
        }

        function getPopupBody(body, modalBodyId, bodyCls) {
            var id = modalBodyId ? modalBodyId : $ctrl.modalBodyId;
            return $ctrl.isPopup ? (
                '<div class="modal-body clearfix centered ' +
                (bodyCls ? bodyCls : ($ctrl.modalBodyClass || '')) +
                '"' + (id ? ('id="' + id + '"') : '') + '>' + getc() + '</div>'
            ) : getc();

            function getc() {
            return '<div class="form-wrapper ' +
                (bodyCls ? bodyCls : ($ctrl.modalBodyFormClass || '')) +
                ($ctrl.modalBodyFormClassOther ? (' ' + $ctrl.modalBodyFormClassOther) : '') +
                '">' +
                        $ctrl.getErrorBlock() +
                        (body ? body : $ctrl.getPopupBodyContent()) +
                   '</div>';
            }
        }

        function getPopupFooter(foorterBtns, cls) {
    return '<div class="modal-footer clearfix semi-tall ' +
            ($ctrl.isPopup ? ' hide-ipad ' : '') +
            ($ctrl.footerClsOther ? (' ' + $ctrl.footerClsOther + ' ') : '') +
           '">' +
                '<div class="form-wrapper text-center long ' + ($ctrl.modalBodyFormClassOther ? (' ' + $ctrl.modalBodyFormClassOther) : '') + ' ' + ($ctrl.with2FooterBtns ? 'long' : (cls||'')) + '">' +
                    (foorterBtns ? foorterBtns : $ctrl.getPopupFooterBtns()) +
                '</div>' +
           '</div>';
        }

        function close(e, isCancel) {
            console.log('ItemTemplateFormInitCtrlService.close');
            $ctrl.preventDefault(e);
            $ctrl.closePopup(isCancel);
        }

        function cancelPopup() {
            $ctrl.refresh();
            $ctrl.closePopup({isCancel : true});
        }


        function getPopupHeader() {
            return getPopupHeaderForInfo({
                topBtns: $ctrl.topBtns,
                icon: $ctrl.icon,
                iconLevel: $ctrl.iconLevel,
                title: $ctrl.popupTitle,
                subtitle: $ctrl.subtitle,
                subdesc: $ctrl.subdesc,
                imgHtml: $ctrl.imgHtml,
            }, true);
        }

        function getPopupLogo(icon, iconLevel){
            return icon ? ('<div class="centered circled-svg-colored small76 page-class ' +
                ($ctrl.pageClass ? (' ' + $ctrl.pageClass) : '') +
                '">' + $ctrl.LCS.getISBDiv(icon, iconLevel) + '</div>') : '';
        }

        function getPopupHeaderForInfo(info, withSubM) {
            var img,
                title = info.title, subtitle,
                cls = 'text-center',
                customImg = $ctrl.columnImg && !$ctrl.isNew;
            if (customImg) {
                img = '<div class="' +
    ($ctrl.columnImg.isAvatarAttr ? 'col75' : ($ctrl.columnImg.isPosterAttr ? 'col120 colh180' : ($ctrl.popupImgCls ?  $ctrl.popupImgCls : 'colh200'))) + ' centered position-relative">' + $ctrl.getPopupForm(true) + '</div>';
            } else if(info.imgHtml ) {
                img = info.imgHtml;
            } else {
                img = $ctrl.getPopupLogo(info.icon ? info.icon : $ctrl.icon, info.iconLevel ? info.iconLevel : $ctrl.iconLevel);
            }

            if (customImg) {
                var c =  _.find($ctrl.columnsList, function (c) {
                    return c.isMobileTitle;
                });
                if (c && !info.title) {
                    title = getContent(c);
                }
                c = _.find($ctrl.columnsList, function (c) {
                    return c.isMobileSubtitle;
                });
                if (c) {
                    subtitle = getContent(c);
                }
            }

            if (!title) {
                title = info.title;
            }

            if (!subtitle) {
                subtitle = info.subtitle;
            }

            var el = (title ? ('<h3 class="' + cls + ($ctrl.isPopup ? '' : ' subtitle') + '">' + title + '</h3>') : '') +
                (subtitle ? ('<h4 class="m ' + cls + ($ctrl.isPopup ? '' : ' subtitle2') +
                    ($ctrl.withMarginBottomForSubtitle ? ' margin-bottom-30' : '')+ '">' + subtitle + '</h4>') : '') +
                (info.subdesc ? ('<div class="' + cls + ' margin-bottom-30 viewdetails-subtitle">' + info.subdesc + '</div>') : '') +
                (withSubM && $ctrl.getPopupHeaderSubtitle ? $ctrl.getPopupHeaderSubtitle() : '') +
                (info.topBtns ? info.topBtns : '');

         return '<div class="modal-header mobile-header clearfix hide-print">' +
                    '<div class="form-wrapper ' + ($ctrl.modalBodyFormClass || '') + '">' + (img||'') + el + '</div>' +
                '</div>';

            function getContent(c) {
                return $ctrl.SBFieldTypesService.getSBFieldContentView($ctrl, $ctrl.item, _.extend({}, c, {
                    hideEmptyContent: true,
                    withoutIcon: true
                })).content;
            }
        }

        function getPopupBodyContent() {
            return $ctrl.getPopupForm();
        }

        function setTemplateDataInit() {

            if ($ctrl.setTemplateData) {
                $ctrl.setTemplateData();
            }

            if (!$ctrl.btnText) {
                $ctrl.btnText = $ctrl.popupTitle;
            }
            if (!$ctrl.firstBtnMethod) {
                $ctrl.firstBtnMethod = 'save';
            }

            if ($ctrl.isPopup && !$ctrl.txtBack) {
                $ctrl.txtBack = 'Back';
            }
        }

        function getPopupFooterBtns() {
            if (!$ctrl.withFooterBtns) {
                return '';
            }
            return getbtn($ctrl.firstBtnMethod, $ctrl.btnText, getan($ctrl.textAnalytics, $ctrl.btnText),
                $ctrl.pageClass + ' ' + ($ctrl.firstBtnCls || '') + ($ctrl.with2FooterBtns ? ' half-width' : ' max-width300'), true) +
                ($ctrl.isNew && $ctrl.with2FooterBtns ? getbtn($ctrl.secBtnMethod, $ctrl.btnText2, getan($ctrl.textAnalytics2, $ctrl.btnText2), 'gray-dark1 half-width with-margin-left', true) : '');

            function getan(an, btn) {
                var x = an ? an : btn;
                return x ? $ctrl.removeHtmlTags(x) : '';
            }
        }

        function removeHtmlTags(txt) {
            return txt ? txt.replace(/(<([^>]+)>)/ig, '') : null;
        }

        function getbtn(method, text, textAnalytics, cls, checkDisabled) {
            var disabled = '$ctrl.isUpdating===true' + (checkDisabled ? '||$ctrl.isBtnDisabled()' : '');
            return '<button class="btn btn-primary ' + (cls ? cls : '') + ' ' + $ctrl.getBtnActionCls() + '" type="submit" ' +
               ' data-type="' + method + '" ' +
                $ctrl.getAnalytics(textAnalytics) +
                'ng-class="{\'disabled\':' + disabled + '}" ng-disabled="' + disabled + '"' +
                '>' +
                '<span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> ' +
                text +
                '</button>'
        }

        function getErrorBlock() {
            return $ctrl.LCS.getErrorBlock();
        }

        function isBtnDisabled() {
            //return !$ctrl.formHolderItem[$ctrl.formName].$dirty || $ctrl.isNameInvalid($ctrl.defaultProp);
            return !$ctrl.isDuplicate && $ctrl.withBtnDisabled &&
                ($ctrl.startsFilled && (typeof ($ctrl.getDataToUpdate) === 'function' && !$ctrl.getDataToUpdate()) ||
                    typeof ($ctrl.isValidForm) === 'function' && !$ctrl.isValidForm());
        }
    };
}

angular.module('item.grid.controller.service', [
    'item.remove.popup.component'
])
.service('GridItemUpdateInitCtrlService', GridItemUpdateInitCtrlService);
GridItemUpdateInitCtrlService.$inject = ['RootEventsService', 'i18nNotifications'];
/*
params:
dontDebounceUpdates
service
elemType
dontNotify
focusIndex
isNew
onErrorItemUpdate
onUpdate
onUpdateAll
* */
function GridItemUpdateInitCtrlService(RootEventsService, i18nNotifications) {
    return function ($ctrl, service) {

        $ctrl.preventDefault = $ctrl.LCS.preventDefault;
        if($ctrl.compOptions && !$ctrl.compOptionsUpdated) {
            var compOptions;
            try {
                compOptions = JSON.parse($ctrl.compOptions);
                if (compOptions) {
                    $ctrl = $.extend($ctrl, compOptions);
                    $ctrl.compOptionsUpdated = true;
                }
            } catch (e) {}
        }

        var debounceTime = 1000;

        if(service){
            $ctrl.service = service;
        }
        if (!$ctrl.service) {
            console.warn('parent for GridItemUpdateInitCtrlService must define $ctrl.service');
        }
        if ($ctrl.elemType === undefined) {
            console.warn('parent for GridItemUpdateInitCtrlService must define $ctrl.elemType');
        }
        if ($ctrl.currentListId === undefined) {
            console.warn('parent for GridItemUpdateInitCtrlService must define $ctrl.currentListId');
        }

        if (!$ctrl.watchers) {
            $ctrl.watchers = [];
        }

        $ctrl.modelOptions = {
            updateOn: 'default blur',
            debounce: {'default': debounceTime, 'blur': 0}
        };

        if (!$ctrl.onErrorItemUpdate) {
            $ctrl.onErrorItemUpdate = null;
        }

        if (!$ctrl.changedFields) {
            $ctrl.changedFields = ['item'];
            //$ctrl.changedFields = _.extend({}, $ctrl.service.getChangedFieldForUpdate());
        }

        $ctrl.getChanges = getChanges;
        $ctrl.save = save;
        $ctrl.onSuccessItemUpdate = onSuccessItemUpdate;
        $ctrl.initGridItem = initGridItem;
        $ctrl.setFocus = setFocus;
        $ctrl.isSetFocus = isSetFocus;
        $ctrl.hasError = hasError;
        $ctrl.$doInitCheck = $doCheck;

        initGridItem();

        return $ctrl;

        function $doCheck() {
            if (!$ctrl.dontDebounceUpdates && $ctrl.canEdit) {
                for (var i = 0; i < $ctrl.changedFields.length; i++) {
                    var field = $ctrl.changedFields[i];
                    if (!angular.equals($ctrl.previousItem[field], $ctrl.item[field])) {
                       // console.log('GridItemUpdateInitCtrlService.$doCheck: ' + field + ' changed');
                        $ctrl.save();
                        break;
                    }
                }
            }
        }

        function getRowId() {
            return $ctrl.item && $ctrl.item._id ? ('form' + $ctrl.item._id.toString()) : 'formItem';
        }

        function duplicateItem() {
            $ctrl.copyItem = clone($ctrl.item);
        }

        function clone(item){
            return item ? angular.copy(item) : item;
        }

        function initGridItem() {
            if (!$ctrl.dontDebounceUpdates) {
                $ctrl.previousItem = _.clone($ctrl.item);
            }

            duplicateItem();
            if (!$ctrl.formHolder) {
                $ctrl.formHolder = {};
            }
            $ctrl.saveInProgress = false;
            $ctrl.isNew = getRowId() === 'formItem';
            $ctrl.focusIndex = -1;
        }

        function onSuccessItemUpdate(result, onUpdate) {
            console.log('onSuccessItemUpdate');
            //to dogetRowId
            /*
             if( $ctrl.onCustomSuccessItemUpdate && typeof($ctrl.onCustomSuccessItemUpdate) == 'function')
             $ctrl.onCustomSuccessItemUpdate(result);
             else  $ctrl.item = result;
             */
            if ($ctrl.isNew) {
                $ctrl.item = result.item ? result.item : result;
            }
            duplicateItem();

            if (!$ctrl.dontNotify) {
                i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.item.getType() + '.' + ($ctrl.isNew ? 'Create' : 'Edit') + '.success', 'success', {name: $ctrl.item.getName()});
            }

            if ($ctrl.isNew) {
                RootEventsService.broadcastRoot('INSERT_' + $ctrl.elemType + '_ITEM_' + $ctrl.currentListId, result);
            } else {
                if (typeof (onUpdate) === 'function') {
                    onUpdate(result);
                } else if (typeof ($ctrl.onUpdate) === 'function') {
                    $ctrl.onUpdate(result);
                }
                if (typeof ($ctrl.onUpdateAll) === 'function') {
                    $ctrl.onUpdateAll(result);
                }
            }
        }

        function saveFinished() {
            $ctrl.saveInProgress = false;
        }

        function onSuccess(result, onUpdate) {
            saveFinished();
            $ctrl.onSuccessItemUpdate(result, onUpdate);
        }

        function onError(error) {
            if (error && error.errors) {
                for (var prop in error.errors) {
                    var err = error.errors[prop];
                    if (err) {
                        if (prop === 'email' || prop === 'name') {
                            //$ctrl.item[prop] = $ctrl.copyItem[prop];
                            try {
                                // form[prop + $ctrl.item._id].$error.duplicate  = err.message ? err.message : err;
                            } catch (e) {
                            }
                        } else {
                            $ctrl.error = err.message;
                        }
                    }
                }
            }

            if ($ctrl.onErrorItemUpdate && typeof ($ctrl.onErrorItemUpdate) === 'function') {
                $ctrl.onErrorItemUpdate(error);
            }

            saveFinished();
        }

        function getChanges(forceUpdate, changedFields) {
            var ch = changedFields ? changedFields : $ctrl.changedFields,
                data = null;
            if($ctrl.service){
                if (forceUpdate) {
                    data = $ctrl.service.getChangesForced(ch, $ctrl.item);
                } else {
                    data = $ctrl.service.getChanges(ch, $ctrl.item, $ctrl.copyItem);
                }
            }
            if (typeof ($ctrl.getAdditionalChanges) === 'function') {
                data = $ctrl.getAdditionalChanges(data);
            }
            return data;
        }

        function save(forceUpdate, changedFields, onUpdate) {
            var rowId = getRowId();
            var form = $ctrl.formHolder[rowId];
            $ctrl.formHolder[rowId + '_attempted'] = true;
            if (!$ctrl.saveInProgress && (form && form.$valid || !form)) {
                var data = $ctrl.getChanges(forceUpdate, changedFields);
                if (data) {
                    $ctrl.saveInProgress = true;

                    if ($ctrl.isNew) {
                        $ctrl.service.insert($ctrl.item, onSuccess2, onError);
                    } else {
                        data._id = $ctrl.item._id;
                        $ctrl.service.update(data, onSuccess2, onError);
                    }
                } else {
                    //  i18nNotifications.pushForCurrentRoute (null, 'crud.gridItem.success.nochanges', 'success' );
                    return false;
                }
            }

            function onSuccess2(result) {
                return onSuccess(result, onUpdate);
            }
        }

        function setFocus(index) {
            $ctrl.focusIndex = index;
        }

        function isSetFocus(index) {
            return $ctrl.focusIndex === index;
        }

        function hasError(prop, error) {
            var name = 'form' + $ctrl.item._id;
            var form = $ctrl.formHolder[name][prop + $ctrl.item._id];
            return (form.$dirty || $ctrl.formHolder[name + '_attempted']) && form.$error[error];
        }
    }
}


angular.module('item.grid.group.controller', [
    'item.grid.group.controller.service'
])
.controller('GridItemGroupInitCtrl', GridItemGroupInitCtrl);
GridItemGroupInitCtrl.$inject = ['GridItemGroupInitCtrlService', '$element'];
function GridItemGroupInitCtrl(GridItemGroupInitCtrlService, $element) {
    var $ctrl = this;
    $ctrl = new GridItemGroupInitCtrlService($ctrl, $element);
}


angular.module('item.grid.group.controller.service', [
    'apiServices.MaterialVersions',
    'group.templatePreloadedCtrl.service',
    'item.grid.edit.group.controller.service'
])
.service('GridItemGroupInitCtrlService', GridItemGroupInitCtrlService);
GridItemGroupInitCtrlService.$inject = ['CompInitCtrlService', 'RouteCollaboratorsService', 'MaterialVersionsService', 'GridItemEditGroupInitCtrlService', 'TemplatePreloadedCtrlService'];
function GridItemGroupInitCtrlService(CompInitCtrlService, RouteCollaboratorsService, MaterialVersionsService, GridItemEditGroupInitCtrlService, TemplatePreloadedCtrlService) {
    return function ($ctrl, $element, options) {
        $ctrl.GridItemEditGroupInitCtrlService = GridItemEditGroupInitCtrlService;
        $ctrl.TemplatePreloadedCtrlService = TemplatePreloadedCtrlService;
        $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
        $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;
        $ctrl.MaterialVersionsService = MaterialVersionsService;

        $ctrl.itemSortableCls = 'as-sortable-item';
        if(!$ctrl.defaultItemClass) {
            $ctrl.defaultItemClass = 'storyboard-row scene';
        }

        $ctrl.$onInit = $onInit;

        if (!$ctrl.replaceClsCond) {
            $ctrl.replaceClsCond = replaceClsCond;
        }

        if(!$ctrl.getElementId){
            $ctrl.getElementId = getElementId;
        }

        if(!$ctrl.getUIdList){
            $ctrl.getUIdList = getUIdList;
        }

        $ctrl.getViewEditElemSelector = getViewEditElemSelector;

        if(!$ctrl.getTemplateWithoutPreloader){
            $ctrl.getTemplateWithoutPreloader = getTemplateWithoutPreloader;
        }

        $ctrl.onLoadedPreloadedTemplate = onLoadedPreloadedTemplate;
        $ctrl.getPreTemplateWithPreloader = getPreTemplateWithPreloader;

        return $ctrl;

        function getViewEditElemSelector(prop){
            return $ctrl.SBFieldTypesService.getViewEditElemSelector(prop, true, $ctrl.canEdit);
        }

        function getElementId(prop) {
            return $ctrl.SBFieldTypesService.getElementIdFromItem($ctrl.item, prop);
        }

        function $onInit() {
            if ($ctrl.preInitGridItem) {
                $ctrl.preInitGridItem();
            }

            onItemInit();

            $ctrl.hasUserId = $ctrl.CPS.security.getCurrentUserId();

            if ($ctrl.postInitGridItem) {
                $ctrl.postInitGridItem();
            }

            function onItemInit() {
                //console.log('GridItemGroupInitCtrlService:onInit ' + getSBTimestamp());


                $ctrl.rowMobileClass = 'row-mobile';
                $ctrl.mobileDetailsViewClass = 'mobile-details-view';
                $ctrl.desktopDetailsViewClass = $ctrl.mobileDetailsViewClass + ' ondesktop';

                $ctrl = new $ctrl.TemplatePreloadedCtrlService($ctrl, $element);

                if (!$ctrl.$onDestroy) {
                    $ctrl.$onDestroy = destroyGridItem;
                }

                if (!$ctrl.compLoaded) {
                    $ctrl = new CompInitCtrlService($ctrl);
                }

                if (!$ctrl.compLoaded) {
                    console.warn('Parent for GridBlockItemGroupInitCtrlService must inherit CompInitCtrlService');
                }

                if ($ctrl.item === undefined) {
                    console.warn('Parent for GridItemGroupInitCtrlService must define $ctrl.item');
                }

                if (typeof ($ctrl.onGetTemplate) !== 'function') {
                    console.warn('Parent for GridItemGroupInitCtrlService must define $ctrl.onGetTemplate');
                }

                if ($ctrl.compOptions && !$ctrl.compOptionsUpdated) {
                    var compOptions;
                    try {
                        compOptions = JSON.parse($ctrl.compOptions);
                        if (compOptions) {
                            $ctrl = $.extend($ctrl, compOptions);
                            $ctrl.compOptionsUpdated = true;
                        }
                    } catch (e) {
                    }
                }

                if ($ctrl.canEdit === undefined) {
                    console.warn('Parent for GridItemGroupInitCtrlService must define $ctrl.canEdit');
                }
                $ctrl.options = options;

                if ($ctrl.listSettings) {
                    $ctrl.Settings = $ctrl.listSettings;
                }

                $ctrl.itemId = $ctrl.options && $ctrl.options.itemId ? $ctrl.options.itemId : ($ctrl.item ? $ctrl.item._id : null);


                $ctrl.toggleMobileRow = toggleMobileRow;
                $ctrl.openMobileItemDetails = openMobileItemDetails;
                $ctrl.openDesktopItemDetails = openDesktopItemDetails;
                $ctrl.hideMobileItemDetails = hideMobileItemDetails;
                $ctrl.hideDesktopItemDetails = hideDesktopItemDetails;
                $ctrl.viewImagePopup = viewImagePopup;
                $ctrl.applyLike = applyLike;
                $ctrl.modalEdit = modalEdit;
                $ctrl.setEditableField = setEditableField;
                $ctrl.closeEditableField = closeEditableField;

                $ctrl.view = view;

                $ctrl.setLiked = setLiked;

                if (typeof ($ctrl.edit) !== 'function') {
                    $ctrl.edit = edit;
                }

                if (typeof ($ctrl.triggerAction) !== 'function') {
                    $ctrl.triggerAction = triggerAction;
                }

                $ctrl.destroyGridItem = destroyGridItem;

                if (typeof ($ctrl.getGridItemTemplate) !== 'function' && typeof ($ctrl.onGetTemplate) === 'function') {
                    $ctrl.getGridItemTemplate = getGridItemTemplate;
                }

                getItemEventBinding();

                init();

                addFiltersWatchers(updateGridViewMode);

                if (!$ctrl.isPrintLayout) {
                    if ($ctrl.withCustomSettings) {
                        $ctrl.addRootWatcher('PRELOADED_SETTINGS_CHANGED_' + $ctrl.elemType + '_GROUP', onPreloadedSettingsChanged);
                    }

                    if (canLikeItems() && $ctrl.columnsList && _.find($ctrl.columnsList, {prop: 'likes'})) {
                        $ctrl.addRootWatcher('UPDATE_' + $ctrl.elemType + '_LIKES_' + $ctrl.currentListId + '_' + $ctrl.item._id, function (uIdList){
                            applyLike(null, uIdList)
                        });
                    }
                }

                function init() {
                    $ctrl = new $ctrl.GridItemEditGroupInitCtrlService($ctrl);

                    if (!$ctrl.isRowScheduleSet) {
                        $ctrl.elRowSchedule = $ctrl.element.querySelector('.row-schedule');
                        $ctrl.rowLoadLaterS = ($ctrl.rowLoadLater === true || $ctrl.rowLoadLater === 'true') &&
                            !$ctrl.forceRowLoadNow && !$ctrl.item.forceRowLoadNow;
                        if ($ctrl.rowLoadLaterS || $ctrl.hasItemImages) {
                            var prop = 'logo',
                                ratioProp = prop +'Ratio';
                            if($ctrl.isMasonary && $ctrl.item[ratioProp] && $ctrl.element.offsetWidth) {
                                $ctrl.minHeight = ($ctrl.element.offsetWidth / $ctrl.item[ratioProp]) + 'px';

                                setMinHeight ($ctrl.elRowSchedule);
                                //setMinHeight ($ctrl.element);
                            }

                            if($ctrl.initItemOther) {
                                $ctrl.initItemOther();
                            }
                        }

                        if ($ctrl.LCS.isTouchScreen || $ctrl.dragHandleAlwaysVisible) {
                            $ctrl.LCS.addClass($ctrl.elRowSchedule, 'without-hover');
                        }

                        $ctrl.elDdItem = $ctrl.LCS.findClosestParent($ctrl.elRowSchedule, '.dd-item');
                        if ($ctrl.elDdItem) {
                            $ctrl.elDdItem.setAttribute('data-id', $ctrl.itemId);

                            if($ctrl.isMasonary) {
                                var prop = 'order';
                                $ctrl.elDdItem.setAttribute('data-' + prop, $ctrl.item[prop]);
                            }

                            $ctrl.elRowScheduleTemp = $ctrl.elDdItem;

                            if(!setAttr()){
                                //reattempted
                                $ctrl.LCS.timeout(function (){
                                    setAttr(true);
                                }, 300);
                            }

                            function setAttr(isReset) {
                                var itemSelectorCls = 'row-scheduleTemp';
                                if ($ctrl.element.parentElement) {
                                    var g = $ctrl.LCS.findClosestParent($ctrl.element, '.simple-group'),
                                        a = g ? g.getAttribute('component-id') : '';
                                    if (a) {
                                        itemSelectorCls += ' ' + a;
                                    }
                                    if (g) {
                                        return set();
                                    } else {
                                       //console.log('simple-group doesnt exist ' + (isReset ? 'isReset' : ''));
                                       //console.log($ctrl.element);
                                    }
                                }
                                if (isReset) {
                                    return set();
                                }

                                function set() {
                                    $ctrl.LCS.addClass($ctrl.elDdItem, itemSelectorCls);
                                    return true;
                                }
                            }
                        }

                        $ctrl.setTemplateCompile($ctrl.elRowSchedule, true);

                        if ($ctrl.item.isPredef && $ctrl.elRowScheduleTemp) {
                            $ctrl.elRowScheduleTemp.setAttribute('data-unselectable', 'true');
                        }

                        if($ctrl.hasItemImages){
                            $ctrl.addRootWatcher('IMAGE_LOADED_' + $ctrl.componentId, onImageLoaded);
                        }

                        $ctrl.isRowScheduleSet = true;
                    }
                }

                function addFiltersWatchers(updateGridViewMode) {
                    if (!$ctrl.addWatchersLoaded) {
                        if ($ctrl.withGridView) {
                            //LIST_FILTERS_VIEW_
                            addFilterOption('VIEW', 'isGridView');

                            //LIST_FILTERS_COLUMN_
                            addFilterOption('COLUMN', 'column');

                            //LIST_FILTERS_RATIO_
                            //addFilterOption('RATIO', 'ratio');
                        }

                        if ($ctrl.withDynamicCols) {
                            //LIST_FILTERS_COLUMNS_
                            addFilterOption('COLUMNS', 'columns', $ctrl.block);
                        }

                        if ($ctrl.otherListFilters) {
                            _.each($ctrl.otherListFilters, function (item) {
                                addFilterOption(item.prop, item.value);
                            });
                        }

                        if ($ctrl.options) {
                            for (var trigger in $ctrl.options) {
                                if (trigger.indexOf('LIST_FILTERS_') !== -1) {
                                    addWatcher(trigger, $ctrl.options);
                                }
                            }
                        }

                        $ctrl.addRootWatcherSimple($ctrl.LCS.onIsMobileSizeChanged(onIsMobileSizeChanged));
                        $ctrl.addRootWatcher('MOBILE_ROW_TOGGLE_' + $ctrl.elemType + '_GROUP_' + $ctrl.itemId, setMobileRow);

                        if ($ctrl.onCloseRowEditableField) {
                            $ctrl.addRootWatcher('CLOSE_ROW_EDITABLE_FIELD_' + $ctrl.itemId, $ctrl.onCloseRowEditableField);
                        }

                        $ctrl.addWatchersLoaded = true;
                    }

                    function addFilterOption(prop, val, block) {
                        if (!$ctrl.options) {
                            $ctrl.options = {};
                        }
                        $ctrl.options['LIST_FILTERS_' + prop + getPrefix() + '_' + $ctrl.elemType +
                        (block ? ('_' + block) : '')] = val;

                        function getPrefix() {
                            return ($ctrl.isPrintLayout ? '_PRINT_LAYOUT' : '') +
                                ($ctrl.isInTreeModal ? '_TREE_MODAL' : '');
                        }
                    }

                    function addWatcher(trigger, options) {
                        var prop = trigger && options ? options[trigger] : null;
                        if (prop) {
                            $ctrl.addRootWatcher(trigger, function (newVal) {
                                //console.log('item: addRootWatcher trigger ' + trigger);
                                onPropChanged(prop, newVal);
                            });
                        }
                    }

                    function onPropChanged(prop, newVal) {
                        //console.log('GridItemGroupInitCtrlService.onPropChanged ' +$ctrl.elemType +': ' + prop + '=' + newVal);
                        if (!angular.equals($ctrl[prop], newVal)) {
                            if (angular.equals(prop, 'isGridView')) {
                                updateGridViewMode(newVal);
                            } else {
                                $ctrl.options[prop] = newVal;
                            }

                            if ($ctrl.LCS.isMobileSize !== $ctrl.isMobileLayout) {
                                $ctrl.isMobileLayout = $ctrl.LCS.isMobileSize;
                            }

                            if ($ctrl.otherListFilters && _.find($ctrl.otherListFilters, {value: prop})) {
                                if (typeof ($ctrl.onPropChangedOther) === 'function') {
                                    $ctrl.onPropChangedOther(prop, newVal);
                                }
                            } else {
                                $ctrl.loadPreloadedItem();
                            }
                        }
                    }

                    function onIsMobileSizeChanged(newVal) {
                        //console.log('onIsMobileSizeChanged');
                        var changed;

                        if ($ctrl.isMobileLayout !== newVal) {
                            $ctrl.isMobileLayout = newVal;
                            changed = true;
                        }

                        if ($ctrl.isMobileMode !== newVal) {
                            $ctrl.isMobileMode = newVal;
                            changed = true;
                        }

                        if (changed) {
                            if (!$ctrl.isMobileLayout && !$ctrl.isMobileMode) {
                                setMobileRow(false);
                                setMobileItemDetails(false);
                            }
                            $ctrl.loadPreloadedItem();
                        }
                    }
                }

                function canLikeItems(){
                    var u = $ctrl.security.getCurrentUser();
                    return $ctrl.CPS.isAuthenticated || $ctrl.CPS.isCollaborator && u && !u.isGeneral; //if is a user or collab not general
                }
            }
        }

        function onImageLoaded (result) {
            //console.log('GridItemGroupInitCtrlService:onImageLoaded ' + getSBTimestamp());
            $ctrl.isImageLoaded = true;
            setMinHeight($ctrl.elRowSchedule, true);

            setImgPreloaderCls(false);
            if($ctrl.CPS.isAuthenticated) {
                var updates = result.updates;
                if (updates) {
                    var id = $ctrl.item[updates.prop + 'Id'];
                    if (id && !$ctrl.item[updates.prop + 'Ratio']) {
                        var u = {_id: id};
                        u['metadata.ratio'] = updates.ratio;
                        $ctrl.MaterialVersionsService.update(u);
                    }
                    /*  var editchanges = {_id: $ctrl.item._id};
                      editchanges[updates.prop +'Ratio'] = updates.ratio;
                      $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', {
                          eventType: 'CHANGED_FIELD',
                          //overwrite id
                          editchanges: editchanges
                      });
*/
                    if($ctrl.onImageLoadedOther) {
                        $ctrl.onImageLoadedOther({result: {_id: $ctrl.item._id}});
                    }
                }
            }

            setDrag(true);
        }

        function setDrag(isBind){
            if(isBind && !$ctrl.keyboardService && $ctrl.imgObserverService && $ctrl.imgObserverService.keyboardService) {
                $ctrl.keyboardService = $ctrl.imgObserverService.keyboardService;
            }
            if ($ctrl.elRowScheduleTemp && $ctrl.keyboardService && $ctrl.keyboardService.sortableService && $ctrl.keyboardService.sortableService.isMasonary && typeof($ctrl.keyboardService.sortableService.bindDraggabilly) === 'function'
            ) {
                $ctrl.keyboardService.sortableService.bindDraggabilly($ctrl.elRowScheduleTemp, isBind);
            }
        }

        function viewImagePopup(e){
            console.log('viewImagePopup');
            $ctrl.preventDefault(e);
            $ctrl.broadcastRoot('VIEW_GRID_ITEM_IMAGE_' + $ctrl.elemType + '_' + $ctrl.currentListIdInherited + $ctrl.item._id,
                e.currentTarget.getAttribute('data-param') === 'true'
            );
        }

        function getUIdList(uIdList){
            var l = {};
            _.each(['_id', 'name', 'collectionName', 'elemType', 'itemTitle', 'nameForList', 'currentItemId', 'currentItemLogoId', 'currentItemLogo','currentItemLikes', 'currentProductId'], function (p) {
                l[p] = uIdList[p] ? uIdList[p] : null;
            });
            return l;
        }

        function getTodoPageId(){
            if (!$ctrl.todoPage) {
                $ctrl.todoPage = $ctrl.BlocksSetupService.getCurrentTodoPage();
            }
            return $ctrl.todoPage ? $ctrl.todoPage._id : null;
        }

        function applyLike(e, uIdList){
            console.log('applyLike');
            var isAnim1 = false,
                m = isAnim1 ? toggleAnim1 : toggleAnim;
            $ctrl.preventDefault(e);

            if($ctrl.hasUserId){
                if(!$ctrl.service){
                    console.warn('parent for must define service');
                }
                var isLike = !isLikedByUser();

                if(isAnim1){
                    if(isLike) {
                        m(isLike, false);
                    }
                } else {
                    m(false);
                }
                var imgProp = 'logo';
                $ctrl.service.like({
                    _id: $ctrl.item._id,
                    like: isLike,
                    companyId: $ctrl.CPS.companyId,
                    productId: $ctrl.CPS.productId,
                    uIdList: uIdList ? uIdList : ($ctrl.imgObserverService && $ctrl.imgObserverService.currentList ? _.extend({}, $ctrl.getUIdList($ctrl.imgObserverService.currentList), $ctrl.security.getImageExtraInfo($ctrl.item, imgProp)) : null),
                    todoPageId: getTodoPageId()
                }, onSuccess, onError);
            }

            function onSuccess(result) {
                if (isAnim1) {
                    if (isLike) {
                        m(isLike, true);
                    }
                } else {
                    m(true);
                }
                var item =  result.item;
                result.editchanges = {
                    _id: item._id,
                    likes: item.likes
                };
                result.item = _.extend({}, $ctrl.item, result.editchanges);

                $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result);
                if (isAnim1) {
                    m(false, isLike ? 4000 : null)
                }

                $ctrl.broadcastRoot('MATERIAL_VIEWER_UPDATE_LIKES_' + $ctrl.elemType + '_' + $ctrl.item._id, item.likes || []);
            }

            function onError(err) {
                console.log(err);
                $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.like.error', 'error');
                toggleAnim(false, null);
            }

            function toggleAnim(on, t) {
                if(!t){process();}
                else{$ctrl.LCS.timeout(process, t);}

                function process() {
                    var el = $ctrl.elDdItem.querySelector('.btnLike .heart'),
                        a ='bounceIn';//'animate__heartBeat'
                    $ctrl.LCS[on ? 'addClass' : 'removeClass'](el, a);
                }
            }

            function toggleAnim1(on, isStarted) {
                var t = on ? (isStarted ? 100 : null) : isStarted;
                if(!t){process();}
                else{$ctrl.LCS.timeout(process, t);}

                function process() {
                    var el = $ctrl.elDdItem.querySelector('.btnLike .heart');
                    if (el) {
                        var cls1 = on ? (isStarted ? '' : 'sbf') : 'heart-animation animate-heart',
                            cls2 = on ? (isStarted ? 'animate-heart' : 'heart-animation') : 'sbf' ;
                        $ctrl.LCS.replaceClass(el, cls1, cls2);
                    }
                }
            }
        }

        function setLiked() {
            if (!$ctrl.withLikesOnItem) {return;}
            // console.log('setLiked');
            var liked = isLikedByUser(),
                el = $ctrl.elDdItem.querySelector('.btnLike');
            if (el) {
                $ctrl.LCS[liked ? 'addClass' : 'removeClass'](el, 'liked');
            }

            el = $ctrl.elDdItem.querySelector('.secLike');
            if (el) {
                process(el);
            } else {
                $ctrl.LCS.timeout(process, 210);
            }

            function process(el) {
                if (!el) {
                    el = $ctrl.elDdItem.querySelector('.secLike');
                }
                if (!el) {return;}

                var count = getLikesCount();

                $ctrl.LCS[count > 0 ? 'removeClass' : 'addClass'](el, 'sb-hide');

                var lPropMark = $ctrl.SBFieldTypesService.getPropMark('likes');
                var el1 = el.querySelector('.' + lPropMark);
                if (el1) {
                    el1.innerText = count;
                }
                el1 = el.querySelector('.plural' + lPropMark);
                if (el1) {
                    el1.innerText = (count === 1 ? '' : 's');
                }
                function getLikesCount(){
                    var likes = $ctrl.SBFieldTypesService.SBFieldMethods.getItemLikes($ctrl.item);
                    return likes && likes.length > 0 ? likes.length : 0;
                }
            }
        }

        function isLikedByUser(){
            return $ctrl.SBFieldTypesService.SBFieldMethods.isItemLikedByUser($ctrl.item, $ctrl.hasUserId);
        }

        function onPreloadedSettingsChanged(settings) {
            // console.log('onPreloadedSettingsChanged');
            $ctrl.Settings = settings;
        }

        function getItemEventBinding() {
             //console.log('getItemEventBinding');

            var list = ['modalEdit', 'edit', 'view', 'remove', 'duplicate', 'viewNotes', 'openProPopup', 'toggleMobileRow', 'hideMobileItemDetails', 'openMobileItemDetails',
                'openDesktopItemDetails', 'hideDesktopItemDetails', 'setEditableField', 'closeEditableField', 'cancel', 'openSinglePopup', 'goToSinglePage'];
            if($ctrl.hasItemImages) {
                list.push('viewImagePopup');
            }
            if($ctrl.withLikesOnItem){
                list.push('applyLike');
            }
            $ctrl.initBindings = generateBindings(list);

            generateOtherBindings($ctrl.bindingNames);

            function generateOtherBindings(list) {
                if (list && list.length > 0) {
                    $ctrl.eventBindings = generateBindings(list);
                }
            }

            function generateBindings(list) {
                var binds = [];
                _.each(list, addBinding);

                return binds;

                function addBinding(name) {
                    if (typeof ($ctrl[name]) !== 'function') {
                        $ctrl[name] = function (e) {
                            console.log('gridItem triggerAction:' + name);
                            return $ctrl.triggerAction(e, name);
                        };
                    }
                    binds.push({name: name, method: $ctrl[name]});
                }
            }
        }

        function setMinHeight(el, isReset){
            if(!el){return;}
            var prop = 'height';
            if(isReset){
                $ctrl.minHeight = 0;
                if(el.style) {
                    el.style.removeProperty(prop);
                }
            } else {
                if(!el.style) {
                    el.style = {};
                }
                if(typeof(el.style.setProperty) === 'function'){
                    el.style.setProperty(prop, $ctrl.minHeight, 'important');
                }
            }
        }

        function setMobileRow(isOpened) {
            //console.log('setMobileRow');
            processItemDetails(isOpened, $ctrl.rowMobileClass, ($ctrl.elRowSchedule.classList || '') + ' more-details', 'getRowMobile');
            setArrow(isOpened);
        }

        function openMobileItemDetails(e) {
            //console.log('openMobileItemDetails');
            $ctrl.preventDefault(e);
            setMobileItemDetails(true);
        }

        function hideMobileItemDetails(e) {
            //console.log('hideMobileItemDetails');
            $ctrl.preventDefault(e);
            setMobileItemDetails(false);
        }

        function setMobileItemDetails(show) {
            //console.log('setMobileItemDetails');
            processItemDetails(show, $ctrl.mobileDetailsViewClass, null, 'openMobileItemDetails');
            $ctrl.LCS.setItemDetailsVisibility(true, show, $ctrl.element);
        }

        function openDesktopItemDetails(e) {
            //console.log('openDesktopItemDetails');
            $ctrl.preventDefault(e);
            setDesktopItemDetails(true);
        }

        function hideDesktopItemDetails(e) {
            //console.log('hideDesktopDetails');
            $ctrl.preventDefault(e);
            setDesktopItemDetails(false);
        }

        function setDesktopItemDetails(show) {
            //console.log('setDesktopItemDetails');
            processItemDetails(show, $ctrl.desktopDetailsViewClass, null, 'openDesktopItemDetails');
            $ctrl.LCS.setItemDetailsVisibility(false, show, $ctrl.element);
        }

        function processItemDetails(isOpened, cls, otherCls, getel, isDesktop) {
            var el = $ctrl.element.querySelector('.' + cls);
            if (isOpened) {
                if (!el) {
                    if (!isDesktop && !$ctrl.isMobileLayout) {
                        return '';
                    }
                    var t = $ctrl.onActions({result: {item: $ctrl.item, type: getel}});

                    if (t) {
                        $ctrl.LCS.appendChildFragment($ctrl.element, '<div class="' + cls + (otherCls ? (' ' + otherCls) : '') + '">' + t + '</div>');
                        el = $ctrl.element.querySelector('.' + cls);
                        if (el) {
                            $ctrl.bindEditableEvents(true, el);
                        }
                    }
                }
            } else {
                if (el) {
                    $ctrl.bindEditableEvents(false, el);
                    $ctrl.LCS.removeElement(el);
                }
            }
        }

        function updateGridViewMode(newVal) {
            $ctrl.isGridView = newVal === 3;
        }

        function getPreTemplateWithPreloader() {
            if($ctrl.isMasonary) {
                if ($ctrl.hasItemImages && !$ctrl.isImageLoaded) {
                    setImgPreloaderCls(true);
                }
                $ctrl.broadcastRoot('GRID_ITEM_PRELOADED_' + $ctrl.currentListIdInherited, {
                    el: $ctrl.element,
                    id: $ctrl.item._id
                });
            }
        }


        function getTemplateWithoutPreloader() {
            var el = $ctrl.getGridItemTemplate();
            $ctrl.LCS[$ctrl.isMobileLayout && el.indexOf('rowschedulelike') !== -1 && $ctrl.isMobileLayout ? 'addClass' : 'removeClass']($ctrl.elRowSchedule, 'with-after');
            return el;
        }

        function setImgPreloaderCls(isPre) {
            var el = $ctrl.elRowSchedule, cls = 'with-preloader';
            if (isPre) {
                el.setAttribute(cls, true);
            } else {
                el.removeAttribute(cls);
            }
            //$ctrl.LCS[isPre ? 'addClass' : 'removeClass']($ctrl.elRowScheduleTemp, cls);
        }

        function replaceClsCond() {
            return $ctrl.isGridView;
        }

        function onLoadedPreloadedTemplate(el) {
            var isReplace = $ctrl.replaceClsCond();
            if (typeof ($ctrl.rowClsOther) === 'function') {
                $ctrl.LCS.addClass($ctrl.elRowSchedule, 'full-width ' + $ctrl.rowClsOther());
            } else {
                //withBorder = ' side-borders border-top border-bottom';
                replace('full-width', $ctrl.defaultItemClass, isReplace);
            }

            if (!$ctrl.withoutMouseHover && !$ctrl.isPrintLayout) {
                replace('with-mouse-hover', '', isReplace);
            }

            //                                      remove border bottom if is grid and not on mobile
            isReplace= $ctrl.withoutBorderBottom || ($ctrl.isGridView && !$ctrl.LCS.isMobileSize);
            replace('border-bottom', '', '', isReplace);

            setSortableClasses();

            if($ctrl.item.type !== 1){
                $ctrl.LCS.setTimeout(function (){
                    setDrag(true);
                }, 300);
            }

            if (typeof ($ctrl.postInitItem) === 'function') {
                $ctrl.postInitItem();
            }

            $ctrl.postInitItemEditable();

            if ($ctrl.isPrintLayout) {
                $ctrl.broadcastRoot('GRID_ITEM_LOADED_' + $ctrl.currentListIdInherited, {el: $ctrl.element, id: $ctrl.item._id});
            }

            function replace(cls, cls1, isReplace) {
                $ctrl.LCS.replaceClass($ctrl.elRowSchedule, isReplace ? cls : cls1, isReplace ? cls1 : cls);
            }
        }

        function getGridItemTemplate() {
            //console.log('getGridItemTemplate');
            var r = $ctrl.onGetTemplate({item: $ctrl.item});
           return $ctrl.getTemplateForPreload(r);
        }

        function setSortableClasses() {
            if (!$ctrl.canEdit) {
                return;
            }

            if ($ctrl.elDdItem) {
                $ctrl.LCS[$ctrl.withSortable ? 'addClass' : 'removeClass']($ctrl.elDdItem, $ctrl.itemSortableCls);
            }

            if ($ctrl.elRowScheduleTemp) {
                var clsHandle = 'as-sortable-item-handle',
                    dragOnlyFromHandle = ($ctrl.LCS.isTouchScreen || $ctrl.isMobileLayout) || $ctrl.dragOnlyFromHandle,
                    itemAsHandle = $ctrl.withSortable && !dragOnlyFromHandle,
                    handleOnSide = $ctrl.withSortable && (dragOnlyFromHandle || $ctrl.dragHandleOnTheSide);
                $ctrl.LCS[itemAsHandle ? 'addClass' : 'removeClass']($ctrl.elRowScheduleTemp, clsHandle);

                $ctrl.elHandleCol = $ctrl.elRowScheduleTemp.querySelector('.handle-col');
                if ($ctrl.elHandleCol) {
                    $ctrl.LCS[(handleOnSide || ($ctrl.canEdit && $ctrl.withoutGroupSorting && $ctrl.withHandlePlaceholder)) ? 'removeClass' : 'addClass']($ctrl.elHandleCol, 'sb-hide');
                    $ctrl.LCS[$ctrl.withSortable && dragOnlyFromHandle ? 'addClass' : 'removeClass']($ctrl.elHandleCol, clsHandle);
                }
            }
        }

        //$ctrl.edit($ctrl.item, $ctrl.operations.confirm)|
        function edit(item, field) {
           // console.log('edit: ' + field);
            return $ctrl.triggerAction(null, 'edit', field);
        }

        function modalEdit(e) {
           // console.log('modalEdit');
            $ctrl.preventDefault(e);
            $ctrl.edit();
        }

        function triggerAction(e, type, field, item) {
            if (typeof ($ctrl.onActions) === 'function') {
                if (e && e.currentTarget && $ctrl.LCS.findClosestParent(e.currentTarget, 'no-trigger')) {
                    return;
                }
                $ctrl.preventDefault(e);

                if (field && field.constructor && field.constructor.name === "TouchEvent") {
                    field = undefined;
                    console.warn('TouchEvent was given as parameter for ' + type + ' triggerAction');
                }
                return $ctrl.onActions({result: {item: item ? item : $ctrl.item, type: type, field: field, e: e}});
            }
        }

        function destroyGridItem() {
            setDrag(false);

            $ctrl.removeWatchers();

            if($ctrl.onDestroyTemplatePreloader) {
                $ctrl.onDestroyTemplatePreloader();
            }

            $ctrl.bindEditableEvents(false, $ctrl.element);

            if ($ctrl.onDestroyEdit) {
                $ctrl.onDestroyEdit();
            }

            if ($ctrl.onDestroyEditMore) {
                $ctrl.onDestroyEditMore();
            }

            if($ctrl.onDestroyGridItemOther){
                $ctrl.onDestroyGridItemOther();
            }
        }

        /*
                             case 'depBg':
                             .medium-template .depRow {
                                     background-color: #383e42; */
        function toggleMobileRow(e, other) {
            $ctrl.preventDefault(e);
            setArrow($ctrl.onIsOpenRow({id: $ctrl.itemId}));
            return $ctrl.onActions({result: _.extend({item: $ctrl.itemId, type: 'toggleMobileRow'}, other)});
        }

        function view(e) {
            console.log('view');
            toggleMobileRow(e, {isDesktop: true});
        }

        function setArrow(isOpened) {
            var arrow = $ctrl.element.querySelector('.sbf.with-arrow');
            if (arrow) {
                if (isOpened) {
                    $ctrl.LCS.replaceClass(arrow, 'forward-arrow', 'down-arrow');
                } else {
                    $ctrl.LCS.replaceClass(arrow, 'down-arrow', 'forward-arrow');
                }
            }
        }

        function setEditableField(prop) {
            onEditableField(prop, 'setEditableField');
        }

        function closeEditableField(prop) {
            onEditableField(prop, 'closeEditableField');
        }

        function onEditableField(prop, type) {
            return $ctrl.onActions({
                result: {
                    item: {id: $ctrl.itemId, prop: prop && prop.prop ? prop.prop : prop},
                    type: type
                }
            });
        }
    }
}

angular.module('item.grid.edit.group.controller.service', [
    'item.field.edit.controller.service',
])
.service('GridItemEditGroupInitCtrlService', GridItemEditGroupInitCtrlService);
GridItemEditGroupInitCtrlService.$inject = ['TemplateCompileService', 'SBFieldTypesService', 'ItemFieldEditCtrlService'];
function GridItemEditGroupInitCtrlService(TemplateCompileService, SBFieldTypesService, ItemFieldEditCtrlService) {
    return function ($ctrl) {
        //by default should be false
        //to debug field set to true
        var dontRemoveOnDebug = false;
        $ctrl.TemplateCompileService = TemplateCompileService;
        $ctrl.SBFieldTypesService = SBFieldTypesService;

        $ctrl.withUncheck = true;
        $ctrl.editedField = null;

        $ctrl.mobileDetailsViewClass = 'mobile-details-view';
        $ctrl.makeFieldEditable = makeFieldEditable;
        $ctrl.openFieldInPopup = openFieldInPopup;

        //initBindings methods must be above
        if(!$ctrl.initBindings){$ctrl.initBindings = [];}

        $ctrl.initBindings.push({name: 'makeFieldEditable', method: $ctrl.makeFieldEditable, type: 'sbEditable'});
        $ctrl.initBindings.push({name: 'openFieldInPopup', method: $ctrl.openFieldInPopup, type: 'sbOpenEditable'});

        $ctrl.onCloseEditableFieldOther = onCloseEditableFieldOther;

        $ctrl.compiledItemEdit = new $ctrl.TemplateCompileService(null);
        $ctrl.onDestroyEdit = onDestroyEdit;

        $ctrl.postInitItemEditable = postInitItemEditable;
        $ctrl.onDestroyEditMore = onDestroyEditMore;
        $ctrl.getClickEventName = getClickEventName;

        $ctrl.bindEditableEvents = bindEditableEvents;
        if(!$ctrl.getEditableColFromProp) {
            $ctrl.getEditableColFromProp = getEditableColFromProp;
        }

        if(!$ctrl.getFieldEditableService){
            $ctrl.getFieldEditableService = getFieldEditableService;
        }

        if(!$ctrl.getColFromProp){
            $ctrl.getColFromProp = getColFromProp;
        }
        if(!$ctrl.getStyleFromProp){
            $ctrl.getStyleFromProp = getStyleFromProp;
        }

        $ctrl.getColFromPropInit = getColFromProp;


        if(!$ctrl.getSBPropForField){
            $ctrl.getSBPropForField = getSBPropForFieldInit;
        }

        $ctrl.getClickEventEditableInit = $ctrl.SBFieldTypesService.getClickEventEditable;
        if(!$ctrl.getClickEventEditable){
            $ctrl.getClickEventEditable = $ctrl.getClickEventEditableInit;
        }

        $ctrl.getSBPropForFieldInit = getSBPropForFieldInit;

        $ctrl.updatePropContent = updatePropContent;
        if (!$ctrl.updateEditableItemProps){
            $ctrl.updateEditableItemProps = updateEditableItemProps;
        }

        if(!$ctrl.getColContentView){
            $ctrl.getColContentView = getColContentView;
        }

        $ctrl.hasPropChanged = hasPropChanged;
        $ctrl.$onChanges = $onChanges;

        $ctrl.onCloseRowEditableField = onCloseRowEditableField;

        if(!$ctrl.canOnlyChangeFieldManually) {
            $ctrl.canOnlyChangeFieldManually = canOnlyChangeFieldManually;
        }

        if (!$ctrl.changedFields) {
            $ctrl.changedFields = ['item'];
        }

        if($ctrl.canEdit){
            $ctrl.addRootWatcher('GRID_ITEM_FIELD_FOCUS_' + $ctrl.elemType + '_' + $ctrl.item._id, onGridItemFocus);
            //console.log('addRootWatcher GRID_ITEM_FIELD_CLOSE_' + $ctrl.elemType + '_' + $ctrl.item._id);
            $ctrl.addRootWatcher('GRID_ITEM_FIELD_CLOSE_' + $ctrl.elemType + '_' + $ctrl.item._id, onGridItemClose);
        }

        $ctrl.toggleViewEditElem = toggleViewEditElem;

        $ctrl = new ItemFieldEditCtrlService($ctrl);

        setEditableFields();

        return $ctrl;

        function onGridItemFocus(tabIndex) {
            //console.log('onGridItemFocus - id:' +$ctrl.item._id + ';tabIndex: '  + tabIndex);
            if ($ctrl.columnsList && tabIndex) {
                var c = _.find($ctrl.columnsList, {tabIndex: tabIndex});
                if (c) {
                    var el = $ctrl.element.querySelector('.'+$ctrl.SBFieldTypesService.SBFieldEditable + '.sb-col-' + c.prop + ' .' + $ctrl.SBFieldTypesService.SBFieldEditableTrigger);
                    if(el) {
                        $ctrl.makeFieldEditable({target: el});
                    }
                }
            }
        }

        function bindEditableEvents(isBind, element) {
            //console.log((isBind?'':'un')+'bind grid item events' );
            if ($ctrl.eventBindings) {
                $ctrl.initBindings = $ctrl.initBindings.concat($ctrl.eventBindings);
            }

            _.each($ctrl.initBindings, function (event) {
                if (!event.method) {
                    console.warn('methods must be defined above $ctrl.eventBindings in parent for GridItemGroupInitCtrlService')
                }

                var elName = (event.type === 'sbEditable' || event.type === 'sbOpenEditable') ? $ctrl.getClickEventEditable(event.type) : $ctrl.getClickEventName(event.name),
                    elements = element.querySelectorAll('.' + elName + ':not(.customedit)');
                //for task card -> the items in tasks are also binded for the name field


                if (elements && elements.length > 0 && typeof ($ctrl.validateEditableFields) === 'function') {
                    elements = $ctrl.validateEditableFields(elements);
                }

                if (elements && elements.length > 0) {
                    $ctrl.LCS.bindElementsClick(isBind, elements, event.method, event.type + '-' + $ctrl.elemType);
                }
            });
        }

        function setEditableFields() {
            if (!withEditableProps()) {
                return;
            }

            if (!$ctrl.editableItemProps) {
                if (typeof ($ctrl.service.getEditableFields) === 'function') {
                    $ctrl.editableItemProps = $ctrl.service.getEditableFields($ctrl.item.type);
                } else {
                    var editableItemProps = [];
                    if ($ctrl.columnsList) {
                        _.each($ctrl.columnsList, function (c) {
                            if ($ctrl.SBFieldTypesService.canUpdateFieldContent(c)) {
                                editableItemProps.push(c.prop);
                            }
                        });
                    }
                    $ctrl.editableItemProps = editableItemProps.length > 0 ? editableItemProps : ['name'];
                }

                updateItemsOrder();
            }

            if (!$ctrl.editableItemProps) {
                console.warn('Parent for GridItemGroupInitCtrlService must define $ctrl.editableItemProps. In interface editable item props must have attached class=\'sb-prop-[propname]\' so they can be updated');
            }
        }

        function updateItemsOrder(){
            if(!$ctrl.isMasonary){return;}
            var prop = 'order';
            if(!$ctrl.editableItemProps || $ctrl.editableItemProps && !_.find($ctrl.editableItemProps, function(item){return item === prop;})) {
                if (!$ctrl.editableItemProps) {
                    $ctrl.editableItemProps = [];
                }
                $ctrl.editableItemProps.push(prop);
            }
        }

        function getClickEventName(name) {
            return 'sb-click-'+name;
        }

        function getFieldEditableService(col) {
            return col && col.service ? $ctrl[col.service] : $ctrl.service;
        }

        function openFieldInPopup(e) {
            //console.log('openFieldInPopup');
            var parent = processEditable(e);
            return $ctrl.triggerAction(null, 'edit', $ctrl.editedField);
        }


        function getSelectionOffsetRelativeTo(p, el) {
            if(!p){return null;}
            var currentSelection, currentRange,
                offset = 0,
                prevSibling,
                nodeContent;

            if (!el) {
                currentSelection = window.getSelection();
                try {
                    currentRange = currentSelection ? currentSelection.getRangeAt(0) : null;
                }catch (e){}
                if(currentRange) {
                    el = currentRange.startContainer;
                    offset += currentRange.startOffset;
                }
            }

            if (el === p) {
                return offset;
            }

            if (!p.contains(el)) {
                return -1;
            }

            while (prevSibling = (prevSibling || el).previousSibling) {
                nodeContent = prevSibling.innerText || prevSibling.nodeValue || "";
                offset += nodeContent.length;
            }

            return offset + getSelectionOffsetRelativeTo(p, el.parentNode);
        }

        function onGridItemClose(result){
            //console.log('onGridItemClose');
            $ctrl.onCloseEditableField(result);
        }

        function getEditableColFromProp(prop){
            return $ctrl.getColFromProp(prop);
        }

        function makeFieldEditable(e) {
            var item = e.item ? e.item : $ctrl.item,
                current = e.currentTarget,
                target = e.target,
                parent = processEditable(e, item), //sets $ctrl.editedField
                col = _.extend({}, $ctrl.getEditableColFromProp($ctrl.editedField), {
                    canEdit: true
                });

            if (!col.quotaType) {
                return process();
            }

            var quotaType = col.quotaType;
            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e: e});

            function process() {
                var link = $ctrl.LCS.findClosestParent( e.target, '.togglesbedit');
                if(link && (col.type === $ctrl.SBFieldTypesService.PropTypes.Html ||
                    col.type === $ctrl.SBFieldTypesService.PropTypes.Contenteditable)){
                    $ctrl.LCS.$window.open(link.getAttribute('href'), link.getAttribute(target) || '_blank');
                    return;
                }

                var focusOffset = e ? getSelectionOffsetRelativeTo(current) : null,
                    //console.log('makeFieldEditable: ' + $ctrl.editedField + ' - offset:' + focusOffset);
                    params = _.extend($ctrl.SBFieldTypesService.getSBContentEditObjectParams($ctrl, col), {
                        value: angular.copy($ctrl.SBFieldTypesService.getValFromProp(item, $ctrl.editedField)),
                        elemType: $ctrl.elemType,
                        service: $ctrl.getFieldEditableService(col),
                        onCancel: $ctrl.onCloseEditableField,
                        onChange: $ctrl.onChangedFieldInit
                    }, e.fieldEditParams),
                    data = {
                        tag: $ctrl.SBFieldTypesService.getSBColContentEditTag($ctrl, col, item),
                        params: params
                    };

                if (focusOffset) {
                    col.focusOffset = focusOffset;
                }

                $ctrl.compiledItemEdit.getItemTemplate = function () {
                    return data.tag;
                };
                $ctrl.compiledItemEdit.insertInFrontOfParent = true;
                $ctrl.compiledItemEdit.loadTemplate(function (clonedElement) {
                    toggleViewEditElem($ctrl.editedField, false);
                }, data.params, angular.element(parent));//<-set the parent for the new component
            }
        }

        function onCloseEditableFieldOther(prop, result){
            $ctrl.toggleViewEditElem(prop, true);
            if (prop === $ctrl.oldEditedField) {
                $ctrl.oldEditedField = null;
            }
            if (prop === $ctrl.editedField) {
                $ctrl.editedField = null;
                $ctrl.onDestroyEdit();
                if (result.tabNextIndex !== undefined && result.tabNextIndex !== null && !$ctrl.LCS.isTouchScreen) {
                    //go to next
                    $ctrl.broadcastRoot('SET_FIELD_FOCUS_' + result.tabNextIndex);
                }
            }
        }

        function processEditable (e, item) {
            if(!item){item = $ctrl.item;}
            $ctrl.preventDefault(e);
            var prop,
                el = $ctrl.LCS.findClosestParent(e.target, '.' + $ctrl.SBFieldTypesService.SBViewEditBlock);

            if (!el) {
                console.log('el doesnt exist');
                return;
            }

            var parent = $ctrl.LCS.findClosestParent(el, '.' + $ctrl.SBFieldTypesService.SBEditableOuter);
            if(!parent){
                parent = $ctrl.LCS.findClosestParent(el, '.' + $ctrl.SBFieldTypesService.SBFieldEditable);
            }
// withEditableOuter = col.withEditableOuter
            _.each(el.classList, function (cls) {
                var p = $ctrl.SBFieldTypesService.getPropFromClass(cls);
                if(p){
                    prop = p;
                }
             });

            if (!prop) {
                return;
            }
            //$ctrl.editedField && $ctrl.editedField === prop
            //send trigger to close the old open field
            //removes the edit element
            if(typeof($ctrl.setEditableField) === 'function') {//ingroup
                $ctrl.setEditableField({id: item._id, prop: prop});
            }else {//in editable popup
                processOldEditable($ctrl.oldEditedField, item._id);
            }

            $ctrl.editedField = prop;
            $ctrl.oldEditedField = $ctrl.editedField;

            return parent;
        }

        function processOldEditable(prop, id){
            if(prop){  //open if in same
                toggleViewEditElem(prop, true);
            }
            $ctrl.broadcastRoot('CLOSE_EDITABLE_FIELD_' + (id !== undefined ? id : $ctrl.item._id), prop ? prop : null);
        }

        function onCloseRowEditableField(prop){
            processOldEditable(prop);
        }


        function toggleViewEditElem(prop, showView) {
            var viewEl = getViewEditElem(prop, true); //view el
            if (!viewEl) {
                return;
            }

            var p = viewEl.parentElement,
                hasOuter = $ctrl.LCS.hasClass(p, $ctrl.SBFieldTypesService.SBEditableOuter);

            if (hasOuter) {
                var editEl = p.querySelector('.' + $ctrl.SBFieldTypesService.SBEditBlock),
                    otherField = showView ? editEl : viewEl,
                    h = otherField ? otherField.offsetHeight : null;
                if (h) {
                    setHeight(p, h);
                    setHeight(showView ? viewEl : editEl, h);
                }
            }

            $ctrl.LCS.timeout(function () {
                $ctrl.LCS[showView ? 'removeClass' : 'addClass'](hasOuter ? p : viewEl, hasOuter ? 'edit-mode' : 'sb-hide');
                if(typeof($ctrl.toggleViewEditElemOther) === 'function') {
                    $ctrl.toggleViewEditElemOther(prop, showView);
                }
            }, 100);

            function setHeight(el, h){
                var prop = 'height';
                if (!el){return;}
                if (!el.style) {
                    el.style = {};
                }
                if (typeof (el.style.setProperty) === 'function') {
                    el.style.setProperty(prop, h + 'px', 'important');

                    $ctrl.LCS.timeout(function () {
                        el.style.removeProperty(prop);
                    }, 200);
                }
            }
        }

        function getColFromProp(prop) {
            //columns is an object
            return $ctrl.columnsList ? _.find($ctrl.columnsList, function (c) {
                return c.prop === prop;
            }) : null;
        }
        function getStyleFromProp(prop) {
            //columns is an object
            return $ctrl.columnsList ? _.find($ctrl.columnsList, function (c) {
                return c.styleProp === prop;
            }) : null;
        }

        function getViewEditElem(prop, canUpdate) {
            var els = _.filter($ctrl.element.querySelectorAll($ctrl.SBFieldTypesService.getViewEditElemSelector(prop, false, canUpdate)), function (el) {
                //for task card popup with task card elements
                if (!isOnRow(prop, el)) {
                    return null;
                }
                return el;
            });
            return els && els.length > 0 ? (els.length === 1 ? els [0] : els) : null;
        }

        function isElemType(){
            return $ctrl.elemType === 'TASKCARD' || $ctrl.elemType === 'CALLSHEET';
        }

        function isOnRow(prop, el){
            if ($ctrl.elemType === 'TASKCARD' && el && prop === 'name' ||
                $ctrl.elemType === 'CALLSHEET' && el && prop === 'time' ) {
                var el1 = $ctrl.LCS.findClosestParent(el, '.row-scheduleTemp'),
                    id = el1 ? el1.getAttribute('data-id') : undefined;
                if ($ctrl.item._id !== id) {
                    return false;
                }
            }
            return true;
        }
        function onDestroyEdit() {
            if ($ctrl.compiledItemEdit && !dontRemoveOnDebug) {
                $ctrl.compiledItemEdit.destroyNewScope();
            }
        }

        function postInitItemEditable() {
            //console.log('postInitItemEditable');
            $ctrl.LCS.timeout(function (){
                _.each(getAllSBViewContent(), function(el){
                    setMoreBtn(el, null)
                });
                $ctrl.bindEditableEvents(true, $ctrl.element);

                if($ctrl.setLiked) {
                    $ctrl.setLiked();
                }

                if (!$ctrl.isInit) {
                    $ctrl.isInit = true;
                }
            //}, 201);//wait for the inner item to be fully loaded
            }, 10);//wait for the inner item to be fully loaded
        }

        function setMoreBtn(el, content) {
            if (!$ctrl.LCS.hasClass(el, $ctrl.SBFieldTypesService.SBViewWithEllipsisCls)) {
                return;
            }

            var parent = el.parentNode,
                moreEl = getMore(),
                withMore = el.clientWidth < el.scrollWidth || el.clientHeight < el.scrollHeight;
            if (withMore) {
                if (!moreEl) {
                    var moreFr = $ctrl.LCS.createFragment('<a class="sbtooltip ' + $ctrl.SBFieldTypesService.SBFieldMoreTrigger + ' gray with-hover display-block" data-sbtooltip="' + content + '"></a>');
                    if (el.nextSibling) {
                        parent.insertBefore(moreFr, el.nextSibling);
                    } else {
                        parent.appendChild(moreFr);
                    }
                    moreEl = getMore();
                    if (moreEl) {
                        /*  if (moreEl.tippy) {
                              moreEl.tippy.setContent(content);
                          } else {
                              moreEl.tippy = tippy(moreEl, {
                                  content: 'test'//content,
                              });
                          }*/
                        bindMore(moreEl, true);
                    }
                }
            } else {
                if (moreEl) {
                    /*
                    if(moreEl.tippy) {
                         moreEl.tippy.destroy();
                    }
                    */
                    bindMore(moreEl, false);
                    parent.removeChild(moreEl);
                }
            }

            function getMore() {
                return parent.querySelector('.' + $ctrl.SBFieldTypesService.SBFieldMoreTrigger);
            }
        }

        function bindAllMore(isBind) {
            _.each(getAllSBViewContent(), function (el) {
                bindMore(el, isBind);
            });
        }

        function getAllSBViewContent() {
            return $ctrl.element.querySelectorAll('.' + $ctrl.SBFieldTypesService.SBViewContentCls);
        }

        function bindMore(el, isBind) {
            $ctrl.LCS.bindElementsClick(isBind, el, onHasMore);

            function onHasMore(e) {
                //console.log('onHasMore');
                $ctrl.preventDefault(e);

                var btn = $ctrl.LCS.findClosestParent(e.target, '.' + $ctrl.SBFieldTypesService.SBFieldMoreTrigger);
                if(btn) {
                    var p = $ctrl.LCS.findClosestParent(btn, '.' + $ctrl.SBFieldTypesService.SBViewBlock);
                    if (p) {
                        var el = p.querySelector('.' + $ctrl.SBFieldTypesService.SBViewContentCls),
                            showMore = $ctrl.LCS.hasClass(el, 'off'),
                            m = $ctrl.LCS[showMore ? 'removeClass' : 'addClass'];
                        m(el, 'display-inline off');
                        m(btn, 'off');
                    }
                }
            }
        }

        function onDestroyEditMore() {
            bindAllMore(false);
        }

        function getSBPropForFieldInit(item, prop) {
            return $ctrl.SBFieldMethods.getValFromProp(item, prop);
        }

        function withEditableProps(){
            return $ctrl.canEdit||$ctrl.withLikesOnItem;
        }

        function updateEditableItemProps(changes) {
            if (!withEditableProps() || !changes) {
                return;
            }

            console.log('updateEditableItemProps');
            _.each($ctrl.editableItemProps, function (prop) {
                if ($ctrl.hasPropChanged(changes, prop)) {
                    //console.log(prop);
                    if($ctrl.isMasonary && prop === 'order') {
                        $ctrl.element.setAttribute('data-' + prop, $ctrl.item[prop]);
                    } else {
                        $ctrl.updatePropContent(prop);
                    }
                }
            });

            if(typeof($ctrl.updateEditableItemPropsAll) === 'function'){
                $ctrl.updateEditableItemPropsAll(changes);
            }
        }

        function $onChanges(changes) {
            //console.log('GridItemEditGroupInitCtrlService.$onChanges');
            if (!$ctrl.isInit || !changes) {
                return;
            }
            $ctrl.LCS.onFieldChanges(changes, $ctrl.changedFields, method);

            function method(field, change){
                if(field === 'item'){
                    if($ctrl.updateEditableItemProps) {
                        $ctrl.updateEditableItemProps(change);
                    }
                }else{
                    if(typeof($ctrl.onOtherChanges) === 'function'){
                        $ctrl.onOtherChanges(changes);
                    }
                }
                return true;
            }
        }

        function canOnlyChangeFieldManually(c){
            return c && c.canOnlyChangeManually;
        }

        function hasPropChanged(changes, prop) {
            return !changes.previousValue || changes.previousValue && changes.currentValue &&
                !angular.equals($ctrl.SBFieldMethods.getValFromProp(changes.previousValue, prop), $ctrl.SBFieldMethods.getValFromProp(changes.currentValue, prop));
        }

        function updatePropContent(prop) {
            var c = $ctrl.getColFromProp(prop);
            if (!c || c && c.isStyleProp) {
                var c1 = $ctrl.getStyleFromProp(prop);
                if (c1) {
                    var el = $ctrl.element.querySelector('.' + $ctrl.SBFieldTypesService.getPropMark(c1.prop) + ' .sbitemstyle');
                    if (el) {
                        console.log('update style for item');
                        var s = $ctrl.SBFieldTypesService.getStyle($ctrl.item, c1);
                        el.style = s ? s : '';
                        var sId = $ctrl.item[c1.styleProp] ? $ctrl.item[c1.styleProp].styleId : null;
                        if (sId) {
                            el.setAttribute('data-style', sId.toString());
                        } else {
                            el.removeAttribute('data-style');
                        }
                        return true;
                    }
                }
            }

            var canUpdate = $ctrl.canEdit && $ctrl.SBFieldTypesService.canUpdateFieldContent(c),
                els = getViewEditElem(prop, canUpdate);

            if (els) {
                if(els.length > 1) {
                    _.each(els, processEl);
                } else{ //one el
                    processEl(els);
                }
            }

            if($ctrl.isMobileLayout){
                processGroup($ctrl.mobileDetailsViewClass, c, prop);
            }

            if(prop === 'likes' && $ctrl.setLiked){
                $ctrl.setLiked();
            }


            function processEl(el1){
                if (!updateContentForCol($ctrl.item)) {
                    var isElem = isElemType();
                    if (isElem && el1 && isOnRow(prop, el1) || !isElem) {
                        processGroup('row-schedule', c, prop);
                    }
                }

                function updateContentForCol() {
                    if (!el1) {
                        return false;
                    }
                    //task card task name for other setups
                    if ($ctrl.LCS.hasClass(el1, 'sb-field-manual') && $ctrl.canOnlyChangeFieldManually(c, el1)) {
                        return false;
                    }

                    var el = el1.querySelector('.' + $ctrl.SBFieldTypesService.SBViewContentCls);
                    if (!el) {
                        return false;
                    }

                    var info = $ctrl.SBFieldTypesService.getSBFieldContentView($ctrl, $ctrl.item, c);
                    if (c.type === $ctrl.SBFieldTypesService.PropTypes.HtmlTooltip) {
                        var hasContent = $ctrl.SBFieldTypesService.extractContentFromHTML(info.content).trim() !== '';
                        var el2 = el.querySelector('.' + $ctrl.getClickEventName('viewNotes'));
                        if (el2) {
                            var ic = el2.querySelector('.sbf');
                            if (ic) {
                                $ctrl.LCS.replaceClass(ic, hasContent ? 'gray' : 'blue', hasContent ? 'blue' : 'gray');
                            }

                        }

                        el2 = el.querySelector('.view-mode.ql-editor.tooltip-content');
                        if (el2) {
                            el2.innerHTML = hasContent ? info.content : '';
                            $ctrl.LCS[hasContent ? 'removeClass' : 'addClass'](el2, 'sb-hide');
                        }
                    } else if (
                        c.type === $ctrl.SBFieldTypesService.PropTypes.BigCheck ||
                        c.type === $ctrl.SBFieldTypesService.PropTypes.SimpleCheck) {
                        return false;
                    } else {
                        $ctrl.LCS.appendChildFragment(el, info.content ? info.content : info.placeholder, true);
                    }

                    $ctrl.LCS[info.hasPlaceholderCls ? 'addClass' : 'removeClass'](el, $ctrl.SBFieldTypesService.SBPlaceholderCls);
                    setMoreBtn(el, info.content);

                    return true;
                }
            }

            function processGroup(elCls, c, prop) {
                var els = $ctrl.element.querySelectorAll('.' + elCls + ' .' + $ctrl.SBFieldTypesService.getPropMark(prop)+
                    ':not(.sb-field-manual)');
                if (els && els.length > 0) {
                    _.each(els, function (el) {
                        setContent(el, $ctrl.getColContentView($ctrl, c, prop));
                    });
                }
            }

            function setContent(el, val) {
                if (el) {
                     if(c && c.type === $ctrl.SBFieldTypesService.PropTypes.Color){
                         if(!el.style){
                             el.style = {};
                         }
                         el.style.backgroundColor = val;
                     }else {
                         var v = el.querySelector('.' + $ctrl.SBFieldTypesService.SBViewContentCls);
                         if (v) {
                             el = v;
                         }
                         el[getProp(el.nodeName)] = val;
                     }
                }
            }

            function getProp(type) {
                switch (type.toLowerCase()) {
                    case 'a':
                    case 'div':
                    case 'p':
                    case 'span':
                        return 'innerHTML';
                }
            }
        }

        function getColContentView($ctrl, c, prop) {
           return c ? $ctrl.SBFieldMethods.getColContentView($ctrl, false, $ctrl.item, c, false).content :
               $ctrl.getSBPropForField($ctrl.item, prop);
        }
    }
}

angular.module('item.grid.edit.group.templatePopup.controller.service', [
    'item.grid.edit.group.templateInit.controller.service'
])
    /*not used*/
.service('GridItemEditGroupTemplatePopupCtrlService', GridItemEditGroupTemplatePopupCtrlService);
GridItemEditGroupTemplatePopupCtrlService.$inject = ['GridItemEditGroupTemplateInitCtrlService','ItemTemplateCompileCtrlService'];
function GridItemEditGroupTemplatePopupCtrlService(GridItemEditGroupTemplateInitCtrlService, ItemTemplateCompileCtrlService) {
    return function ($ctrl, $element) {
        console.log('GridItemEditGroupTemplateCtrlService');
        var withoutTemplateScope = false;
        $ctrl.templateCompileCtrlServiceIsPopup = true;
        $ctrl = new GridItemEditGroupTemplateInitCtrlService(ItemTemplateCompileCtrlService, $ctrl, $element, withoutTemplateScope);
        return $ctrl;
    }
}

angular.module('item.grid.edit.group.template.controller.service', [
    'item.grid.edit.group.templateInit.controller.service'
])
.service('GridItemEditGroupTemplateCtrlService', GridItemEditGroupTemplateCtrlService);
GridItemEditGroupTemplateCtrlService.$inject = ['GridItemEditGroupTemplateInitCtrlService','TemplateCompileCompCtrlService'];
function GridItemEditGroupTemplateCtrlService(GridItemEditGroupTemplateInitCtrlService, TemplateCompileCompCtrlService) {
    return function ($ctrl, $element) {
        console.log('GridItemEditGroupTemplateCtrlService');
        $ctrl = new GridItemEditGroupTemplateInitCtrlService(TemplateCompileCompCtrlService, $ctrl, $element);
        return $ctrl;
    }
}

angular.module('item.grid.edit.group.templateInit.controller.service', [
    'sb.fields.types.service',
    'item.grid.edit.group.controller.service'
])
.service('GridItemEditGroupTemplateInitCtrlService', GridItemEditGroupTemplateInitCtrlService);
GridItemEditGroupTemplateInitCtrlService.$inject = ['GridItemEditGroupInitCtrlService', 'SBFieldTypesService'];
function GridItemEditGroupTemplateInitCtrlService(GridItemEditGroupInitCtrlService, SBFieldTypesService) {
    return function (templateCompileCtrlService, $ctrl, $element, withoutTemplateScope) {
        console.log('GridItemEditGroupTemplateInitCtrlService');

        $ctrl.SBFieldTypesService = SBFieldTypesService;
        $ctrl.GridItemEditGroupInitCtrlService = GridItemEditGroupInitCtrlService;

        var id = new ObjectId().toString();

        if($ctrl.dontAutoloadTemplate === undefined) {
            $ctrl.dontAutoloadTemplate = false;
        }
        $ctrl.preInit = preInit;
        $ctrl.onLoaded = onLoaded;
        $ctrl.onDestroy = onDestroy;
        $ctrl.getColDisplayDiv = getColDisplayDiv;
        $ctrl.getClickEventEditable = getClickEventEditable;
        $ctrl.onSuccessUpdated = onSuccessUpdated;
        $ctrl.onChangedFieldManually = onChangedFieldManually;

        if($ctrl.changeFieldManually) {
            $ctrl.onChangedField = onChangedFieldManually;
        }

        //ItemTemplateCompileCtrlService(($ctrl, $element, isPopup, withoutTemplateScope)) or
        //TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope)
        if($ctrl.templateCompileCtrlServiceIsPopup){
            $ctrl = new templateCompileCtrlService($ctrl, $element, true, withoutTemplateScope);
        } else {
            $ctrl = new templateCompileCtrlService($ctrl, $element, withoutTemplateScope);
        }

        return $ctrl;

        function preInit() {
            if (!$ctrl.extraParam) {
                $ctrl.extraParam = {};
            }

            if($ctrl.service) {
                $ctrl.extraParam.service = $ctrl.service;
            }

            if($ctrl.extraParam.canEdit !== undefined){
                $ctrl.canEdit = $ctrl.extraParam.canEdit;
            }

            if($ctrl.setExtraProps){
                $ctrl = _.extend($ctrl, $ctrl.setExtraProps());
            }

            if ($ctrl.preLoadingService === undefined) {
                console.log('parent for GridItemEditGroupTemplateInitCtrlService must must define field preLoadingService');
            }
            if ($ctrl.editableItemProps === undefined) {
                console.log('parent for GridItemEditGroupTemplateInitCtrlService must define field editableItemProps');
            }
            if ($ctrl.onChangedField === undefined) {
                console.log('parent for GridItemEditGroupTemplateInitCtrlService must must define method onChangedField');
            }

            if ($ctrl.preInitOther) {
                $ctrl.preInitOther();
            }

            if(typeof($ctrl.setColumns) === 'function') {
                $ctrl.setColumns();
            }

            if(!$ctrl.columnsList){
                console.warn('parent for GridItemEditGroupInitCtrlService must define $ctrl.columnsList');
            }

            $ctrl = new $ctrl.GridItemEditGroupInitCtrlService($ctrl);
        }

        function onLoaded() {
            $ctrl.postInitItemEditable();
        }

        function onDestroy() {
            $ctrl.bindEditableEvents(false, $ctrl.element);
            if ($ctrl.onDestroyOther) {
                $ctrl.onDestroyOther();
            }
        }

        function getColDisplayDiv(prop) {
            var c = $ctrl.getColFromProp(prop);
            return c ? $ctrl.SBFieldTypesService.getColDisplayDiv($ctrl, $ctrl.item, c) : null;
        }

        function getClickEventEditable(type) {
            return $ctrl.getClickEventEditableInit(type) + id;
        }

        function onSuccessUpdated(updates, updates1) {
            if(!updates){return false;}
            //onchanges is not gonna be called so we must trigger it
            var changes = {previousValue: _.clone($ctrl.item)};
            $ctrl.item = _.extend({}, _.clone($ctrl.item), updates, updates1);
            changes.currentValue = $ctrl.item;
            $ctrl.$onChanges({item: changes});
            return true;
        }

        function onChangedFieldManually(result) {
            var prop = result && result.prop ? result.prop : null,
                updates = {};
            updates[prop] = result.selected.val;
            if($ctrl.onSuccessUpdated(updates, null)) {
                $ctrl.onChange({updates: updates});
            }
        }
    }
}


angular.module('group.templatePreloadedCtrl.service', [
 'templateCompile.service',
])
.service('TemplatePreloadedCtrlService', TemplatePreloadedCtrlService);
TemplatePreloadedCtrlService.$inject = ['TemplateCompileService'];
function TemplatePreloadedCtrlService(TemplateCompileService) {
    return function ($ctrl, $element) {
        var withoutTemplateScope = true;

        if ($element) {
            $ctrl.$element = $element;
            $ctrl.element = $ctrl.$element[0];
        }

        if (!$ctrl.componentId) {
            $ctrl.componentId = 'gi' + (new ObjectId().toString());
        }

        $ctrl.element.setAttribute('component-id', $ctrl.componentId);

        if(!$ctrl.TemplateCompileService) {
            $ctrl.TemplateCompileService = TemplateCompileService;
        }

        if(!$ctrl.innerTemplatePlcCls){
            $ctrl.innerTemplatePlcCls = 'sb-template-placeholder ';
        }

        if (!$ctrl.innerTemplateTags) {
            $ctrl.innerTemplateTags = ['sb-resizable-img'];
        }

        if(!$ctrl.getPreloader){
            $ctrl.getPreloader = getPreloader;
        }

        $ctrl.getTemplateWithPreloader = getTemplateWithPreloader;
        $ctrl.onDestroyTemplatePreloader = onDestroyTemplatePreloader;

        if(!$ctrl.getTemplateWithoutPreloader) {
            $ctrl.getTemplateWithoutPreloader = getTemplateWithoutPreloader;
        }

        $ctrl.getTemplateForPreload = getTemplateForPreload;

        if(!$ctrl.loadGridItemWithoutScope){
            $ctrl.loadGridItemWithoutScope = loadGridItemWithoutScope;
        }

        $ctrl.loadPreloadedItem = loadPreloadedItem;
        $ctrl.setTemplateCompile = setTemplateCompile;
        $ctrl.onInnerTemplateLoaded = onInnerTemplateLoaded;

        return $ctrl;

        function onDestroyTemplatePreloader(){
            if ($ctrl.templateCompile) {
                $ctrl.templateCompile.destroyNewScope();
            }

            removeTemplateTags();

            function removeTemplateTags() {
                if ($ctrl.innerTemplateCompile && $ctrl.innerTemplateTags) {
                    _.each($ctrl.innerTemplateTags, processTag);
                }

                function processTag(tag) {
                    if ($ctrl.innerTemplateCompile[tag]) {
                        $ctrl.innerTemplateCompile[tag].destroyNewScope();
                    }
                }
            }
        }

        function getTemplateWithPreloader(el,setPreloaderAttr) {
            if(setPreloaderAttr){
                var prop = 'with-preloader';
                if ($ctrl.loadedPreloader) {
                    el.setAttribute(prop, true);
                } else {
                    el.removeAttribute(prop);
                }
            }
            return ($ctrl.loadedPreloader ? $ctrl.getTemplateWithoutPreloader : $ctrl.getPreloader)(el);
        }

        function getTemplateWithoutPreloader(){
            console.warn('getTemplateWithoutPreloader must be defined in parent for TemplatePreloadedCtrlService');
            return 'getTemplateWithoutPreloader must be defined in parent for TemplatePreloadedCtrlService';
        }

        function getPreloader(el) {
            var height = el ? el.clientHeight : null;
            return '<div class="preloader ' + (height && height < 100 ? 'small ' : '') + ($ctrl.pageClass || '') + '" ' +
                ($ctrl.minHeight ? ('style="min-height:'+$ctrl.minHeight+';height:'+$ctrl.minHeight+'"') : (height ? ('style="max-height:' + height + 'px"') : '')) +
                '><div class="h-full table-div centered-preloader full-width clearfix"><div class="centered"><div><div class="loadFacebookWrapper"><div class="sbLdsEllipsis"><div class="lds-ellipsis"><div></div><div></div><div></div><div></div></div></div></div></div></div></div></div>';
            //'<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
        }

        function getTemplateForPreload(r){
            if (!$ctrl.rowLoadLaterS) {
                return r;
            }

            var el = $ctrl.LCS.createFragment('<div>' + r + '</div>'),
                exists = false;

            if ($ctrl.innerTemplateTags) {
                _.each($ctrl.innerTemplateTags, processTag);
            }

            if (!exists) {
                return r;
            }

            return el.querySelector('div').innerHTML;

            function processTag(tag) {
                var innerTemplate = el.querySelector(tag);

                if (!innerTemplate) {
                    return false;
                }

                $ctrl.innerTemplateContent = innerTemplate.outerHTML;
                innerTemplate.replaceWith($ctrl.LCS.createFragment('<div class="' + $ctrl.innerTemplatePlcCls + tag + ' ' + innerTemplate.classList.value + '"></div>'));
                exists = true;
            }
        }

        function loadGridItemWithoutScope() {
            return $ctrl.loadGridItemWithScope ? false : (
                $ctrl.rowLoadLaterS ? withoutTemplateScope : false
            );
        }

        function loadPreloadedItem() {
            //console.log('loadPreloadedItem: ' + $ctrl.elemType + ' ' + $ctrl.componentId);
            var load;
            $ctrl.loadedPreloader = false;
            if (!$ctrl.rowObserverService) {
                console.log('$ctrl.rowObserverService isnull');
                load = true;
            }
            if (!$ctrl.rowLoadLaterS || (typeof($ctrl.loadItemNow)==='function' && $ctrl.loadItemNow())) {
                //console.log('$ctrl.rowLoadLaterS ' + $ctrl.rowLoadLaterS);
                load = true;
            }
            if (load) {
                $ctrl.loadedPreloader = true;
                reload();
            } else {
                checkReload(true);
            }

            function checkReload(isInViewPort) {
                // console.log('checkReload: ' + $ctrl.componentId+'_' + isInViewPort);
                if (checkIfToLoad(isInViewPort)) {
                    $ctrl.loadedPreloader = true;
                    reload();
                } else if (!$ctrl.isNotFirstTime) {
                    $ctrl.isNotFirstTime = true;
                    reload();
                }

                function checkIfToLoad(isInViewPort) {
                    return $ctrl.rowObserverService.checkIfViewport(isInViewPort, {
                        id: $ctrl.componentId,
                        el: $ctrl.element,
                        ev: checkReload
                    });
                }
            }

            function reload() {
                // console.log('reload Item');
                $ctrl.templateCompile.withoutTimeout = $ctrl.loadGridItemWithoutScope();
                $ctrl.templateCompile.loadTemplate($ctrl.onInnerTemplateLoaded);
            }
        }

        function onInnerTemplateLoaded(el){
            if(el) {
                var el1 = el.context ? el.context : el;
                if(el1 && $ctrl.LCS.hasClass(el1, 'preloader')) {
                    return;
                }
            }

            loadInnerTemplates();

            // console.log('GridItemGroupInitCtrlService.onInitItemLoaded');

            if($ctrl.onLoadedPreloadedTemplate){
                $ctrl.onLoadedPreloadedTemplate(el);
            }

            function loadInnerTemplates() {
                if ($ctrl.loadedPreloader && $ctrl.innerTemplateTags) {
                    _.each($ctrl.innerTemplateTags, processTag);
                }

                function processTag(tag) {
                    var innerTemplate = $ctrl.element.querySelector('.' + $ctrl.innerTemplatePlcCls.replace(' ', '.') + tag),
                        withoutTemplateScope = false;
                    if (innerTemplate) {
                        if (!$ctrl.innerTemplateCompile) {
                            $ctrl.innerTemplateCompile = {};
                        }
                        if (!$ctrl.innerTemplateCompile[tag]) {
                            $ctrl.innerTemplateCompile[tag] = new $ctrl.TemplateCompileService(angular.element(innerTemplate), null, $ctrl, withoutTemplateScope);
                            $ctrl.innerTemplateCompile[tag].withoutTimeout = withoutTemplateScope;
                            $ctrl.innerTemplateCompile[tag].insertAfter = true;
                        }
                        $ctrl.innerTemplateCompile[tag].loadTemplate(function (el) {
                            // console.log('onimageloaded');
                            //img.replaceWith(el)

                        }, $ctrl, innerTemplate, $ctrl.innerTemplateContent);
                    }
                }
            }
        }

        function setTemplateCompile(el, setPreloaderAttr) {
            $ctrl.templateCompile = new $ctrl.TemplateCompileService(angular.element(el), getTemplate, $ctrl, $ctrl.loadGridItemWithoutScope());
            function getTemplate(){
                if($ctrl.getPreTemplateWithPreloader){
                    $ctrl.getPreTemplateWithPreloader(el, setPreloaderAttr);
                }
                return $ctrl.getTemplateWithPreloader(el);
            }

            $ctrl.loadPreloadedItem();
        }
    }
}

angular.module('group.keyActions.component', [
    'list.keyActions.controller.service'
])
.component('groupKeyboardActionsPopup', popupComponentParams('GroupKeyboardActionsPopupCtrl'))
.controller('GroupKeyboardActionsPopupCtrl', GroupKeyboardActionsPopupCtrl);

GroupKeyboardActionsPopupCtrl.$inject = ['ProcessKeyActionsPopupCtrlService', '$element'];
function GroupKeyboardActionsPopupCtrl(ProcessKeyActionsPopupCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.isSameList = true;
    $ctrl.selectedClass= 'selected';

    $ctrl.getSidebarContent = getSidebarContent;
    $ctrl.selectItem = selectItem;
    $ctrl.getSelectedListId = getSelectedListId;
    $ctrl.isSameSelectedListId = isSameSelectedListId;
    $ctrl.preInitOther = preInitOther;

    $ctrl = new ProcessKeyActionsPopupCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitOther(){
        $ctrl.active.afterId = $ctrl.selectedId;
    }

    function isSameSelectedListId(){
        return $ctrl.active.afterId === undefined || $ctrl.selectedId === $ctrl.active.afterId;
    }

    function getSelectedListId(){
        return $ctrl.listTreeService.active.selectedListId;
    }

    function selectItem(id) {
        if ($ctrl.active.afterId) {
            add(false);
        }
        $ctrl.active.afterId = id;
        add(true);

        function add(isAdd) {
            $ctrl.LCS[isAdd ? 'addClass' : 'removeClass']($ctrl.element.querySelector('.dd-item[data-info="' + $ctrl.active.afterId + '"] .taskcard-tree-item-grid'), $ctrl.selectedClass);
        }
    }

    function getSidebarContent(){
        var el = '',
        items = $ctrl.extraParam ? $ctrl.extraParam.items : null;
        if(items && items.length>0) {
            _.each(items, function (item){
                el += getItem(item);
            })
        }
        return '<div class="swimlanes-in-modal">' + el + '</div>';

        function getItem(item){
            if(item.active) {
                $ctrl.active.afterId = item._id;
            }
            return '<div class="swimlane h-full tree-node simple-group kanban-board dd-item '+$ctrl.getBtnActionCls()+'" data-type="selectItem" data-info="' + (item._id ? item._id : null)+'">' +
                '<div class="lane-wrapper h-full">' +
                    '<div class="taskcard-tree-item-grid clearfix display-block top-height '+(item.active ? $ctrl.selectedClass : '')+'">' +
                          '<div class="swimlane-header">' +
                '<div class="swimlane-top-border" ng-style="::{\'background-color\': item.color}" style="background-color: rgb(255, 170, 1);"></div>' +
                '<div class="swimlane-title clearfix thinner table-div">' +
                                '<div class="list-edit-item grow-column centered with-padding-right table-cell">' +
                                    '<div class="list-item-name swimlane-title table-div fixed-layout semibold">' +
                                        '<div class="with-ellipsis name">'+item.name+'</div>' +
                                    '</div>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>';
        }
    }
}

angular.module('list.keyActions.component', [
    'list.keyActions.controller.service'
])
.component('treeKeyboardActionsPopup', popupComponentParams('TreeKeyboardActionsPopupCtrl'))
.controller('TreeKeyboardActionsPopupCtrl', TreeKeyboardActionsPopupCtrl);

TreeKeyboardActionsPopupCtrl.$inject = ['ProcessKeyActionsPopupCtrlService', '$element'];
function TreeKeyboardActionsPopupCtrl(ProcessKeyActionsPopupCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;
    $ctrl = new ProcessKeyActionsPopupCtrlService($ctrl, $element, $ctrl.isPopup);
}

angular.module('list.keyActions.controller.service', [
    'filters.init.component'
])
.service('ProcessKeyActionsPopupCtrlService', ProcessKeyActionsPopupCtrlService);
ProcessKeyActionsPopupCtrlService.$inject = ['ItemTemplateCompileCtrlService', 'FiltersService'];
function ProcessKeyActionsPopupCtrlService(ItemTemplateCompileCtrlService, FiltersService) {
    return function($ctrl, $element, isPopup){
        $ctrl.FiltersService = FiltersService;

        $ctrl.isSidebar = true;
        $ctrl.isInTreeModal = true;

        $ctrl.select = select;
        $ctrl.proceed = onConfirm;
        $ctrl.goToList = goToList;
        $ctrl.isSelectedItem = isSelectedItem;

        $ctrl.preInit = preInit;
        $ctrl.setTemplateData = setTemplateData;
        $ctrl.preTemplate = preTemplate;
        $ctrl.postTemplate = postTemplate;
        $ctrl.getPopupBodyContent = getPopupBodyContent;
        if(!$ctrl.getSelectedListId) {
            $ctrl.getSelectedListId = getSelectedListId;
        }
        if(!$ctrl.isSameSelectedListId) {
            $ctrl.isSameSelectedListId = isSameSelectedListId;
        }
        if(!$ctrl.getSidebarContent) {
            $ctrl.getSidebarContent = getSidebarContent;
        }
        $ctrl.bindActionsOthers = bindActionsOthers;

        $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function bindActionsOthers(isBind){
            $ctrl.LCS.bindElementListeners(isBind, $ctrl.LCS.$document[0], onSubmit, 'keyup');
        }

        function onSubmit(e){
            console.log('onSubmit');
            switch (e.which) {
                case 13://enter
                    if($ctrl.methodX && typeof($ctrl[$ctrl.methodX]) === 'function') {
                        $ctrl.preventDefault(e);
                        $ctrl[$ctrl.methodX]();
                    }
                    break;
            }

        }
        function preInit() {
            if(!$ctrl.extraParam){ $ctrl.extraParam = {};}
            if ($ctrl.extraParam.selectedFilter) {
                $ctrl.extraParam.selectedFilter = true;
            }
            if ($ctrl.extraParam.action) {
                $ctrl.action = $ctrl.extraParam.action;
            }
            $ctrl.listTreeService = $ctrl.extraParam.listTreeService;
            if($ctrl.listTreeService) {
                $ctrl.filtersService = new $ctrl.FiltersService($ctrl.listTreeService.filtersService.constantsService, $ctrl.listTreeService.filtersService.listOptionsService, {
                    isInTreeModal: $ctrl.isInTreeModal,
                    onChangeFilter: onChangeFilter
                });
            }
            $ctrl.moveInGroup = $ctrl.extraParam.moveInGroup;

            $ctrl.getListItemIcon = $ctrl.extraParam.getListItemIcon;

            $ctrl.active = {selectedListId: ($ctrl.action === 1 || $ctrl.action === 2) ? $ctrl.getSelectedListId() : undefined};
            $ctrl.product = {};

            setTreeType($ctrl.extraParam.treeType);

            if(isMoveTasks()){
                $ctrl.selectList = selectList;
                $ctrl.isSelectedList = isSelectedList;
            }

            if(typeof($ctrl.preInitOther) === 'function') {
                $ctrl.preInitOther();
            }
        }

        function setTreeType(treeType){
            $ctrl.treeType = treeType;
        }

        function onChangeFilter(info){
            console.log('onChangeFilter');
            if(info.type === 'treeType') {
                setTreeType(info.val);
                $ctrl.reloadTemplate();
            }
        }

        function isMoveTasks(){
            return $ctrl.elemType === 'TASKCARD' && $ctrl.action === 1;
        }

        function isSelectedList(id) {
            return $ctrl.active.selectedListId === id;
        }

        function selectList(id) {
            return $ctrl.active.selectedListId = id;
        }

        function getSelectedListId() {
            if (isMoveTasks()) {//workflow
                return $ctrl.extraParam.currentListId;
            }
            return $ctrl.listTreeService.getSelectedIdFromItem($ctrl.listTreeService.active.selectedList);
        }

        function isModalTree(){
            return $ctrl.type === 'Modal Tree';
        }

        function setTemplateData() {
            $ctrl.modalBodyFormClass = 'long390';
            $ctrl.icon = $ctrl.extraParam.icon;
            $ctrl.iconLevel = $ctrl.extraParam.iconLevel;
            $ctrl.popupTitle = $ctrl.extraParam.title;
            $ctrl.withFooterBtns = true;
            $ctrl.methodX = isModalTree() ? 'select' : 'proceed';
            $ctrl.firstBtnMethod = $ctrl.methodX;
            $ctrl.btnText = $ctrl.extraParam.btn;
            $ctrl.firstBtnCls = 'max-width300';
            if($ctrl.action === 3 || $ctrl.action === 12){
                $ctrl.pageClass = 'accent';
            }
        }

        function preTemplate() {
            return '<form class="auto submitform" novalidate autocomplete="off">';
        }

        function postTemplate() {
            return '</form>';
        }

        function getSidebarContent() {
            if ($ctrl.listTreeService) {
                $ctrl.tree = $ctrl.listTreeService.getTree($ctrl.treeType, $ctrl.extraParam.selectedFilter);
            }
            return $ctrl.listTreeService.getSidebarTemplate($ctrl.isInTreeModal, true);
        }

        function getPopupBodyContent() {
            var message =
                ($ctrl.extraParam.message ? ('<p class="text-center medium-size">' + $ctrl.extraParam.message + '</p>') : '') +
                ($ctrl.extraParam.extraMessage ? $ctrl.extraParam.extraMessage : '');
            return  message + (isModalTree() ?  sidebarContent() : '');

            function sidebarContent() {
                return (($ctrl.action === 1 || $ctrl.action === 2) && !$ctrl.extraParam.hideSidebar) ?
                    ('<div class="margin-top-half margin-right10 show-scrollbar-on-hover">' +
                        '<div class="fancy-scrollbar ultrathin max-height-400">' +
                            '<div class="contentsidebar form-wrapper popup-tree innercontainer with-tree side-nav ' + ($ctrl.pageClass || '') + '">' + $ctrl.getSidebarContent() + '</div>' +
                        '</div>' +
                    '</div>') : '';
            }
        }

        function onLoaded() {
            if(!$ctrl.focusElementName){
                $ctrl.focusElementName = 'name';
            }
            if ($ctrl.focusElementName) {
                $ctrl.LCS.timeout(function () {
                    var el = $ctrl.element.querySelector('#' + $ctrl.focusElementName);
                    if (el) {
                        (el.value || el.innerText !== '') ? el.select() : el.focus();
                    }
                });
            }
        }

        function isSameSelectedListId(){
            var id = $ctrl.active.selectedListId;
            return id === undefined || id === $ctrl.getSelectedListId();
        }

        function select() {
            if ($ctrl.action === 1) {//move
                if ($ctrl.isSameSelectedListId()) {
                    $ctrl.error = "Select a different folder than the current folder to move the selected items";
                    return;
                }
            }

            if(($ctrl.action === 1 || $ctrl.action === 2) && ($ctrl.active.isFolder && !$ctrl.moveInGroup)) {//move or duplicate
                $ctrl.error = "Select a list and not a folder to move the selected items";
                return;
            }
            $ctrl.extraParam.selectedList = $ctrl.active.selectedList;
            onConfirm($ctrl.active ? $ctrl.active.selectedListId : undefined, {afterId: $ctrl.active.afterId});
        }

        function goToList(item){
            console.log('goToList');

            $ctrl.error = null;
            if (item.isPredef) {
                $ctrl.error = "Select a custom folder to move the selected files and folders to.";
                return;
            }

            $ctrl.active.selectedListId = $ctrl.listTreeService.getSelectedIdFromItem(item);
            $ctrl.active.selectedList = item;
            $ctrl.active.isFolder = item.isFolder;
        }

        function isSelectedItem(item) {
            return $ctrl.active.selectedListId === $ctrl.listTreeService.getSelectedIdFromItem(item);
        }

        function onConfirm(param) {
            if ($ctrl.extraParam.onConfirm) {
                $ctrl.extraParam.onConfirm(param, _.extend({}, $ctrl.extraParam, {onConfirm: null, onCheck:null, getListItemIcon: null, listTreeService: null}));
            }
            onclose();
        }

        function onclose(){
            $ctrl.broadcastRoot('HIDE_MOBILE_DETAILS');
            $ctrl.close();
        }
    }
}

angular.module('list.keyboard.init.controller.service', [
'services.sessionService'
])
.service('KeyboardListInitControllerService', KeyboardListInitControllerService);
KeyboardListInitControllerService.$inject = ['i18nNotifications'];
function KeyboardListInitControllerService(i18nNotifications ) {
    return function ($ctrl) {
        console.log('KeyboardListInitControllerService');
        if (!$ctrl) {
            console.warn('parent must pass $ctrl parameter to KeyboardListInitController');
        }

        if (!$ctrl.compLoaded) {
            console.warn('parent for KeyboardListInitController must inherit CompInitCtrlService');
        }
        if ($ctrl.watchers === undefined) {
            console.warn('define $ctrl.watchers in parent for KeyboardListInitController');
        }
        if ($ctrl.service === undefined) {
            console.warn('define $ctrl.service in parent for KeyboardListInitController');
        }

        if ($ctrl.keyboardService === undefined) {
            console.warn('define $ctrl.keyboardService in parent for KeyboardListInitController');
        }
        $ctrl.i18nNotifications = i18nNotifications;

        var ActionTypes = $ctrl.keyboardService.ActionTypes,
            keys = $ctrl.keyboardService.keys,
            itemTitle = $ctrl.keyboardService.itemTitle,
            objectType = $ctrl.keyboardService.objectType,
            itemClass = $ctrl.keyboardService.getRowClass(),
            checkmarkClass = 'selectmark',//make sure the checkmarks have this class
            selectedClassName = $ctrl.keyboardService.getSelectedItemCls() + ' ',
            isAllSelected = false;

        $ctrl.getFirstSelectedId = getFirstSelectedId;
        $ctrl.processActionEvent = processActionEvent;
        $ctrl.selectAllRows = selectAllRows;
        $ctrl.allRowsSelected = allRowsSelected;
        $ctrl.selectItemForProcessing = selectItemForProcessing;
        $ctrl.clearArrays = clearArrays;
        $ctrl.unselectItemById = unselectItemById;
        $ctrl.processDefaultSelectedKeyboard = processDefaultSelected;

        if (!$ctrl.getItemTitleForMovePopup) {
            $ctrl.getItemTitleForMovePopup = getItemTitleForMovePopup;
        }
        if (!$ctrl.getRowById) {
            $ctrl.getRowById = getRowById;
        }

        if (!$ctrl.getRowsById) {
            $ctrl.getRowsById = getRowsById;
        }
        //used in parent
        $ctrl.toggleRowById = toggleRowById;
        $ctrl.toggleRowsById = toggleRowsById;
        $ctrl.onRowClickEvent = onRowClickEvent;
        $ctrl.onKeydownEvent = onKeydownEvent;
        $ctrl.onClipboardProcessing = onClipboardProcessing;
        $ctrl.bindTableEvents = bindTableEvents;
        $ctrl.clearSelectedRows = clearSelectedRows;

        if(!$ctrl.getKeyboardSelectedRows){
            $ctrl.getKeyboardSelectedRows = getKeyboardSelectedRows;
        }

        $ctrl.addRootWatcher($ctrl.keyboardService.CLEAR_SELECTED, $ctrl.clearSelectedRows);

        if ($ctrl.canEdit) {
            $ctrl.addRootWatcher($ctrl.keyboardService.KEYDOWN_EVENT, onKeydown);
            $ctrl.addRootWatcher($ctrl.keyboardService.ROW_CLICK_EVENT + $ctrl.currentListId, onRowClick);
            $ctrl.addRootWatcher($ctrl.keyboardService.CLIPBOARD_PROCESSING + $ctrl.currentListId, $ctrl.onClipboardProcessing);

            function onKeydown(result) {
                if (result.elemType !== $ctrl.elemType) {
                    return;
                }
                var data = result.data;
                data.withoutItemKeyEvents = $ctrl.withoutItemKeyEvents;
                $ctrl.onKeydownEvent(data, result.params);
            }

            function onRowClick(data) {
                if (data.elemType !== $ctrl.elemType) {
                    return;
                }
                $ctrl.onRowClickEvent(data);
            }
        }

        return $ctrl;

        function processKeyboardEvent() {

        }

        function clearSelectedRows(result) {
            //console.log('keyboardService.CLEAR_SELECTED');
            selectAllRows(true);
            if($ctrl.clearSelectedRowsOther) {
                $ctrl.clearSelectedRowsOther();
            }
        }

        function toggleRowById(id, show) {
            showRow(show, $ctrl.getRowById(id));
        }

        function toggleRowsById(id, show) {
            var rows = $ctrl.getRowsById(id),
                deps = {};
            _.each(rows, function (row) {
                if (row) {
                    var depId = row.getAttribute('dep-id');
                    if (depId && depId !== 'undefined' && depId !== 'null') {
                        //if is show or if was not yet set
                        if (deps[depId] === undefined || show) {
                            deps[depId] = show;
                        }
                    }
                    showRow(show, row);
                    if (show) {
                        row.removeAttribute('data-unselectable');
                    } else {
                        row.setAttribute('data-unselectable', 'true');
                    }
                }
            });
            return deps;
        }

        function showRow(show, row){
            if (row) {
                $ctrl.LCS[show ? 'removeClass' : 'addClass'](row, 'sb-hide');
            }
        }

        function bindScrolling(isBind) {
            if (!$ctrl.CPS.isCollaborator) {
                return;
            }
            if (isBind) {
                if (!$ctrl.scrollerEl) {
                    $ctrl.scrollerEl = getScrollingGroup();
                }

                if (!$ctrl.onScroll) {
                    $ctrl.onScroll = onScroll;
                }
            }
            if ($ctrl.scrollerEl) {
                $ctrl.LCS.bindElementListeners(isBind, $ctrl.scrollerEl, $ctrl.onScroll, 'scroll', {
                    passive: true
                });
            }

            function onScroll(e) {
                //console.log('group inint onScroll  ');
                var v = $ctrl.scrollerEl.scrollTop >= 120;
                $ctrl.LCS[v ? 'addClass' : 'removeClass']($ctrl.LCS.bodyElement, 'hide-top-nav');
            }
        }
        function bindTableEvents(isBind, treeParams) {
            //if($ctrl.isCommentsSidebar){return;}

            if (isBind && $ctrl.isBindTableEvents) {
                process(false);
            }

            process(isBind);

            function process(isBind) {
                //console.log('bindTableEvents.process: ' + $ctrl.elemType + ' ' + isBind);
                //bindScrolling(isBind);

                $ctrl.keyboardService.initKeyboardEvents($ctrl.canEdit, isBind, null, treeParams, $ctrl.element);
                if (!isBind) {
                    $ctrl.clearArrays();
                }
                $ctrl.isBindTableEvents = isBind;
            }
        }

        function onRowClickEvent(data) {
            //console.log('onRowClickEvent');
            if (data) {
                if (data.canSelect) {
                    onRowSelect(data.$event);
                } /*else {
                    if(typeof($ctrl.onRowClick) === 'function'){
                        $ctrl.onRowClick(data.$event);
                    }
                }*/
            }
        }

        function allRowsSelected() {
            return isAllSelected;
        }

        function selectAllRows(clear) {
            var sclass = 'clipboard';
            if (clear ? true : isAllSelected) {
                clearArray(sclass);
            } else {
                selectRange($ctrl.currentListId, sclass, null, true, 0, $ctrl.list.items.length - 1);
            }
            isAllSelected = clear ? false : !isAllSelected;
        }

        function processListItemsInRange(min, max, process) {
            if (min >= 0 && max >= 0) {
                var items = $ctrl.list.items, n = max <= items.length - 1 ? max : (items.length - 1);
                for (var i = min; i <= n; i++) {
                    var el = items[i];
                    if (i >= min && i <= max) {
                        process(el);
                    }
                }
            }
        }

        function getRowById(id) {
            return document.querySelector(itemClass + "[data-id='" + id + "']");
        }

        function getRowsById(id) {
            return document.querySelectorAll(itemClass + "[data-id='" + id + "']");
        }

        function setClassForRow(row, sclass, isSet) {
            var c = selectedClassName + sclass;
            if (isSet) {
                $ctrl.LCS.addClass(row, c);
            } else {
                $ctrl.LCS.removeClass(row, 'copied');
                $ctrl.LCS.removeClass(row, c);
            }

            var check = row.querySelector(".custom-checkbox." + checkmarkClass);
            if (check) {
                $ctrl.LCS[isSet ? 'addClass' : 'removeClass'](check, 'checked');
                var checkInput = check.querySelector('input[type=checkbox]');
                if (checkInput) {
                    if (isSet) {
                        checkInput.setAttribute('checked', 'checked');
                    } else {
                        checkInput.removeAttribute('checked');
                    }
                }
            }
        }

        function unselectRow(row, sclass, i) {
            //console.log('unselectRow');
            if (!row) {
                return;
            }
            setClassForRow(row, sclass, false);
            $ctrl.keyboardService.removeSelectedIndex(sclass, i);
        }

        function selectRow(row, sclass, id, sId) {
            if (!row) {
                return;
            }
            var attr = row.getAttribute('data-unselectable');
            if (attr !== true && attr !== 'true') {
                //console.log('selectRow{ id: ' + id + ', sId:' + sId + '}');
                setClassForRow(row, sclass, true);
                var nSid = $ctrl.keyboardService.getAttribute(row, 'current-list-id');
                $ctrl.keyboardService.addSelectedId(sclass, id, ($ctrl.keyboardService.currentListId === 'All' || $ctrl.keyboardService.currentListId === 'Archived') ? nSid : sId);
            }
        }


        function getExtraRowId(){
            var isLastRow = true;
            return isLastRow ? 'BECOME_LAST_ROW' : 'BECOME_FIRST_ROW';
        }
        // clear all selected && remove class selected
        function clearArray(sclass) {
            //console.log('clearArray')
            var list = $ctrl.keyboardService.getList(sclass);
            for (var i = list.length - 1; i >= 0; i--) {
                var id = $ctrl.keyboardService.getId(list[i]);
                if (id === getExtraRowId()) {
                    $ctrl.keyboardService.removeSelectedIndex(sclass, i);
                } else {
                    var row = $ctrl.getRowById(id);
                    unselectRow(row, sclass, i);
                }
            }
            $ctrl.keyboardService.setPreviouslyClickedId(null, null);
        }

        function isctrl() {
            return $ctrl.keyboardService.isCtrl;
        }

        function shouldClearSelected() {
            return !isctrl() &&
                $ctrl.keyboardService.selectOnCtrl && !$ctrl.LCS.isTouchScreen;
        }

        function clearArrays() {
            $ctrl.keyboardService.isCtrl = false;
            $ctrl.keyboardService.isShift = false;
            clearArray('clipboard');
            clearArray('copied');
        }

        function getRowId(row) {
            var id = row ? row.getAttribute('data-id') : null;
            return id === 'null' ? null : (id === 'undefined' ? undefined : id);
        }

        function getRowIndexById(id) {
            if (!id) {
                return null;
            }
            return $ctrl.list.getElementIndexById(id);
        }

        function selectItemForProcessing(id, sId) {
            var sclass = 'clipboard';
            clearArray(sclass);
            $ctrl.keyboardService.addSelectedId(sclass, id, sId);
        }

        //add it to clipboard if it doesnt exist or
        //remove it from clipboard if exists
        function setSelectedRow(e, sId) {
            //console.log('setSelectedRow');
            var target = e.target,
                node = e.target.nodeName.toLowerCase();

            var hasDrpParents = $ctrl.LCS.findClosestParent(target, '.dropdown-menu'),
                hasDrpToggleParents = $ctrl.LCS.findClosestParent(target, '.dropdown-toggle'),
                isEditor = $ctrl.LCS.findClosestParent(target, '.ql-editor'),
                isUploader = $ctrl.LCS.findClosestParent(target, 'image-uploader'),
                isCheck = $ctrl.LCS.findClosestParent(target, '.custom-checkbox:not(.selectmark)');

            if (node === 'a' || node === 'input' || hasDrpParents || hasDrpToggleParents || isUploader || isCheck || isEditor) {
                return;
            }

            checkCtrl(e);
            //console.log('click; isCtrl:' + $ctrl.keyboardService.isCtrl + '; isShift: ' + $ctrl.keyboardService.isShift);

            var sclass = 'clipboard';
            var row = $ctrl.LCS.findClosestParent(target, itemClass);
            var id = getRowId(row);
            if (!id) {
                return;
            }


            if ($ctrl.keyboardService.isShift) {
                selectRange(sId, sclass, row);
            } else {
                var i = $ctrl.keyboardService.isIdInArray(id, sclass);
                var clearFirst = shouldClearSelected();
                if (i === -1) { //is not
                    if (clearFirst) {
                        clearArray(sclass);
                    }
                    selectRow(row, sclass, id, sId);
                } else {
                    if (clearFirst) {
                        var l = $ctrl.keyboardService.getList(sclass).length;
                        clearArray(sclass);
                        if (l > 1) {
                            selectRow(row, sclass, id, sId);
                        }
                    } else {
                        unselectRow(row, sclass, i);
                    }
                }
            }

            $ctrl.keyboardService.setPreviouslyClickedId(id, sId);

        }

        function unselectItemById(id) {
            var sclass = 'clipboard',
                i = $ctrl.keyboardService.isIdInArray(id, sclass);
            unselectRow($ctrl.getRowById(id), sclass, i);
        }

        function selectRange(sId, sclass, row, onlySelect, min, max) {
            var list = $ctrl.keyboardService.getList(sclass);

            var id = getRowId(row);
            var index = getRowIndexById(id);
            if (row && list.length === 0) {
                processRow(row, id);
            } else {
                if (min === undefined && max === undefined) {
                    min = 0;
                    max = 0;
                    var initId = $ctrl.keyboardService.getPreviouslyClickedId(),
                        initIndex = getRowIndexById(initId),
                        isAlreadySelected = $ctrl.keyboardService.isIdInArray(id, sclass) !== -1;

                    if (isAlreadySelected) {// unselect from prevselected till this row
                        if (initIndex > index) {
                            min = index + 1;
                            max = initIndex;
                        } else {
                            min = initIndex;
                            max = index - 1;
                        }
                    } else {//select from initindex to index excluding init index that is already added
                        if (initIndex > index) {
                            min = index;
                            max = initIndex - 1;
                        } else {
                            min = initIndex + 1;
                            max = index;
                        }
                    }
                }
                processListItemsInRange(min, max, function (item) {
                    var rid = item._id, r = $ctrl.getRowById(rid);
                    processRow(r, rid, onlySelect);
                });
            }

            function processRow(r, rid, onlySelect) {
                var i = $ctrl.keyboardService.isIdInArray(rid, sclass);
                if (i === -1) {
                    selectRow(r, sclass, rid, sId);
                } else if (!onlySelect) {
                    unselectRow(r, sclass, i);
                }
            }
        }

        function checkCtrl(e) {
            $ctrl.keyboardService.isCtrl = e.ctrlKey || e.metaKey;
            $ctrl.keyboardService.isShift = e.shiftKey;
        }

        function processSelected(opType, extraParam) {
            var params = _.extend({}, $ctrl.getParams(), typeof ($ctrl.getClipboardProcessingParamsOther) === 'function' ? $ctrl.getClipboardProcessingParamsOther(opType) : null);
            if (opType === ActionTypes.Up || opType === ActionTypes.Down) {//up/down
                var list = $ctrl.getKeyboardSelectedRows(opType);
                if (list.length > 0) {
                    params.updates = [list[list.length - 1]];
                }
            } else { //move duplicate remove
                params.updates = $ctrl.keyboardService.duplicateArrays();
                if (typeof($ctrl.getProcessSelectedParams) === 'function') {
                    params.updates = $ctrl.getProcessSelectedParams(params.updates);
                }
            }

            params.opType = opType;

            setLoadingLayer(true);
            console.log('processSelected ' + opType);
            params = _.extend(params, typeof ($ctrl.getClipboardProcessingParams) === 'function' ? $ctrl.getClipboardProcessingParams(params, extraParam) : null);
            (typeof ($ctrl.getClipboardProcessingService) === 'function' ? $ctrl.getClipboardProcessingService(opType, extraParam) : $ctrl.service).clipboardProcessing(params, clipboardProcessingSuccess, clipboardProcessingError);

            function clipboardProcessingSuccess(result) {
                clipboardProcessing(result);
                reset('success');
                if (typeof ($ctrl.onClipboardProcessingSuccess) === 'function') {
                    $ctrl.onClipboardProcessingSuccess(opType, result, params, extraParam);
                }
            }

            function clipboardProcessingError(error) {
                reset('error', error);
            }

            function reset(success, error) {
                clearArrays();
                setLoadingLayer(false);

                $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.' + success + '.clipboardProcessing', success, {
                    action: getPrintType(opType),
                    name: $ctrl.keyboardService.itemTitle.toLowerCase()
                });
                if (error) {
                    console.log(error);
                }
            }
        }

        function getScrollingGroup(){
            return document.querySelector($ctrl.loadingLayerParentClass ? $ctrl.loadingLayerParentClass : '.first-scrolling-wrapper');
        }

        function setLoadingLayer(isOn) {
            if ($ctrl.withoutLoadingLayer) {
                return;
            }
            var el = getScrollingGroup();
            if (el) {
                if (isOn) {
                    if (!$ctrl.hasLoadingLayer) {
                        $ctrl.hasLoadingLayer = new ObjectId().toString();
                        $ctrl.LCS.appendChildFragment(el, '<div id="c' + $ctrl.hasLoadingLayer + '" style="background-color: rgba(0,0,0,0.5)" class="h-full table-div centered-preloader"><div class="centered"><div><div class="loadFacebookWrapper"><div id="loadFacebookG"><div id="blockG_1" class="facebook_blockG"></div><div id="blockG_2" class="facebook_blockG"></div><div id="blockG_3" class="facebook_blockG"></div>    </div></div></div></div></div>');
                        console.log('setLoadingLayer on');
                    }
                } else {
                    if ($ctrl.hasLoadingLayer) {
                        $ctrl.LCS.removeElementChild(el, '#c' + $ctrl.hasLoadingLayer);
                        $ctrl.hasLoadingLayer = null;
                        console.log('setLoadingLayer off');
                    }
                }


            }
        }

        function getPrintType(opType) {
            switch (opType) {
                case ActionTypes.Duplicate:
                    return 'duplicating';
                case ActionTypes.Move:
                    return 'moving';
                case ActionTypes.Archive:
                    return 'archiving';
                case ActionTypes.Activate:
                    return 'activating';
                default:
                    return 'processing';
            }
        }

        function clipboardProcessing(result) {
            console.log('clipboardProcessing');
            $ctrl.keyboardService.pending = [];
            // $ctrl.keyboardService.mainSId = $ctrl.currentListId;
            $ctrl.keyboardService.sIds = {};
            result.updates = groupUpdatesByList(result.updates);
            var sIds = result.sIds, l = sIds ? sIds.length : 0;
            if (l > 0) {
                $ctrl.keyboardService.mainSId = sIds[l - 1];
                if (sIds.length > 1) {
                    var tasks = [];
                    _.each(sIds, function (sId) {
                        tasks.push(function (c) {
                            broadcastClipboardProcessing(sId, result);
                            c();
                        });
                    });

                    async.series(tasks, function (err, result) {
                        console.log('clipboardProcessing done')
                    });
                } else {
                    broadcastClipboardProcessing($ctrl.keyboardService.mainSId, result);

                }
            }
        }

        function groupUpdatesByList(updates) {
            var gr = {};
            for (var id in updates) {
                var el = updates[id];
                var sId = el[$ctrl.listField];
                if (sId === undefined) {
                    sId = null;
                }
                if (!gr[sId]) {
                    gr[sId] = {};
                }
                gr[sId][id] = el;
            }
            return gr;
        }

        function onClipboardProcessing(result, listDoesntExist, isChildTable) {
            if (!$ctrl.isCommentsSidebar && !$ctrl.keyboardService.sIds) {
                console.error('onClipboardProcessing error');
                return;
            }
            //on move first add is executed then remove so keyboardService.pending is never set
            var sId = listDoesntExist ? result.broadcastedListId : $ctrl.currentListId,
                add, selected, delEl = [], del, delN = 0, addN = 0, processed;
            console.log('onClipboardProcessing ' + sId);
            if ($ctrl.currentListId === 'All' && result.type !== ActionTypes.Move || $ctrl.currentListId === 'Archived') {
                listDoesntExist = false;
            }
            add = result.new ? _.filter(result.new, function (item) {
                return item[$ctrl.listField] === sId;
            }) : null;

            var lx = add && add.length > 0 ? add.length : 0;
            if (lx) {
                addN = lx;
                addElements(add);
            }
            var updates = result.updates ? result.updates[sId] : null,
                changes = result.changes ? result.changes[sId] : null,
                isMoveAdd;
            if (changes) {
                del = changes.del;
                delN = del && del.length > 0 ? del.length : 0;
                if (del && del.length > 0) {
                    //console.log('delete rows');
                    if (result.type === ActionTypes.Move) {
                        processUpdates(updates);
                    }
                    selected = [];
                    _.each(del, function (id) {
                        selected.push($ctrl.list.getElementById(id));
                        if (result.type === ActionTypes.Move && $ctrl.currentListId !== 'All') {
                            $ctrl.removeElementInit(id, result.type, null, listDoesntExist, isChildTable);
                        }
                        delEl.push(id);
                    });
                    if (result.type === ActionTypes.Move) {
                        $ctrl.keyboardService.pending = $ctrl.keyboardService.pending.concat(selected);
                    }
                }

                if (result.type === ActionTypes.Move) {
                    add = changes.add;
                    lx = add && add.length > 0 ? add.length : 0;
                    if (lx) {
                        addN += lx;
                        //console.log('delete rows');
                        selected = angular.copy($ctrl.keyboardService.pending);

                        addElements(selected);

                        isMoveAdd = true;
                    }
                }
            }

            //update tree counters
            var dif = addN - delN;
            if (isMoveAdd && dif !== 0) {
                console.log('UPDATE_CLIPBOARD_PROCESSING_TREE');
                // $ctrl.broadcastRoot('UPDATE_CLIPBOARD_PROCESSING_TREE', {id: sId, dif: dif});
            }

            if (result.type !== ActionTypes.Move) {
                updates = processDeleted(updates);
            }

            processUpdates(updates);

            if ($ctrl.keyboardService.mainSId === sId) {
                $ctrl.keyboardService.sIds = null;
                $ctrl.keyboardService.mainSId = null;
                $ctrl.keyboardService.pending = null;
                clearArrays();
            } else {
                if($ctrl.keyboardService.sIds) {
                    $ctrl.keyboardService.sIds[sId] = true;
                }
            }

            function addElements(els) {
                $ctrl.addInitItems(els, listDoesntExist, null);
            }

            function processDeleted(updates) {
                //remove deleted elements && update the elements index from current list if exist
                if (!delEl || !delEl.length) {
                    return updates;
                }

                _.each(delEl, function (id) {
                    var el1 = $ctrl.removeElementInit(id, result.type, null, listDoesntExist, isChildTable);
                    if (el1 && (result.type === ActionTypes.Activate || result.type === ActionTypes.Archive)) {
                        if (!updates) {
                            updates = {};
                        }
                        if (!updates[id]) {
                            updates[id] = {
                                active: el1.active
                            };
                            //set the parent to null when archiving
                            if (result.type === ActionTypes.Archive && $ctrl.listField && !$ctrl.withArchiveGroupInLists) {
                                updates[id][$ctrl.listField] = null;
                            }
                        }
                    }
                });
                return updates;
            }

            function processUpdates() {
                if (processed) {
                    return;
                }

                var res = {
                    type: result.type,
                    updates: updates
                };
                if (result.eventType) {
                    res.eventType = result.eventType;
                }
                if ($ctrl.keyboardService.mainSId === sId) {
                    res.updatesG = result.updatesG;
                }
                res.onClipboardProcessing = true;
                //on list is changed

                console.log('set eventType');
                if(!res.eventType) {
                    if (result.sIds.length === 1) {                                                     //when archiving elements in group
                        if ((res.type === ActionTypes.Delete || res.type === ActionTypes.Duplicate) || $ctrl.listTreeService.isRecursiveTree && res.type === ActionTypes.Archive) {
                            res.eventType = 'UPDATE_LIST_COUNTER';
                        }
                    } else if (result.sIds.length === 2) {
                        if (res.type === ActionTypes.Duplicate ){
                            if(result.new && result.new.length&& result.new[0][$ctrl.listField] === sId){
                                res.eventType = 'UPDATE_MULTI_LIST_COUNTER';
                                res.sId = sId;
                            }
                        } else if (res.type === ActionTypes.Move) {
                            res.eventType = 'UPDATE_MULTI_LIST_COUNTER';
                            res.sId = result.sId;
                        }
                    }
                }

                $ctrl.processUpdates(res, true, false, listDoesntExist, false, result);
                processed = true;
            }
        }

        function broadcastClipboardProcessing(id, result) {
            console.log('broadcastClipboardProcessing: noninline -> listExistsS');
            if (!$ctrl.broadcastRoot($ctrl.keyboardService.CLIPBOARD_PROCESSING + id, result, true)) {
                //console.log('broadcastClipboardProcessing: inline -> LISTDOENSTEXISTS');
                result.broadcastedListId = id;
                onClipboardProcessing(result, true, false);
            }
        }

        function processFirstSelectedItem(sId, event, id) {
            console.log('processFirstSelectedItem');
            clearArrays();
            var item = null;

            if (id) {
                item = _.find($ctrl.list.items, function (item) {
                    return item._id === id;
                });
                if (!item && event.type === ActionTypes.Edit) {
                    return;
                }
            }

            if (event && typeof (event.method) === 'function') {
                event.method(sId, item);
            }
        }

        function openPopupMessage(onConfirm, params, operation, e) {
            if (!params.icon) {
                params.icon = objectType;
            }
            if (!params.btn) {
                params.btn = 'Apply';
            }
            if (!params.title) {
                params.title = 'Are you sure?';
            }
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations[operation ? operation : 'treeKeyboardActions'], _.extend({
                    itemTitle: $ctrl.keyboardService.itemTitle,
                    currentListId: $ctrl.currentListId,
                    getListItemIcon: $ctrl.getListItemIcon,
                    onConfirm: onConfirm
                }, params,
                params.action === 1 && ($ctrl.listTreeService && $ctrl.listTreeService.ungroupOnTreeDelete && $ctrl.currentList && $ctrl.currentListId === 'All') ? {
                    title: 'Assign ' + $ctrl.keyboardService.itemTitle + ' to Group',
                    message: 'Select a group below',
                    icon: 'group-folders',
                    btn: 'Assign'
                } : null,
            ), $ctrl.compOptions, {e:e});
            //console.log(message);
        }

        function onRowClick(e) { //when rows are being clicked
            console.log('onRowClick: currentListId=' + $ctrl.currentListId);


        }

        function onRowSelect(e) { //when rows are being clicked and selected
            var sId = $ctrl.currentListId;
            $ctrl.keyboardService.currentListId = sId;
            //console.log('onRowSelect: currentListId=' + sId);
            setSelectedRow(e, sId);
        }

        function onKeydownEvent(data, params) {

            //console.log('onKeydownEvent');
            var sId = data.currentListId;
            if ($ctrl.currentListId !== sId) {
                return;
            }

            var e = data.e,
                target = e.target,
                node = target.nodeName.toLowerCase(),
                key = e.keyCode,
                action;

            //console.log($ctrl.keyboardService.KEYDOWN_EVENT + '_' + sId);

            checkCtrl(e);

            if (typeof ($ctrl.additionalTargetCheckings) === 'function') {
                var toReturn = $ctrl.additionalTargetCheckings(e);
                if (toReturn) {
                    return;
                }
            }

            //cmdS
            var isField= target.getAttribute('contenteditable') === "true",
                isCmdS = isField && $ctrl.keyboardService.isCtrl && (e.keyCode === keys.SKey || e.keyCode === e.keyCode === keys.sKey);

            if(isCmdS){
                if(e && typeof(e.preventDefault) === 'function'){
                    e.preventDefault();
                    console.log('isCmdS');
                }
            } else if (node === 'input' && $ctrl.LCS.hasClass(target, checkmarkClass)) {

            } else {
                if (node === 'input' || node === 'button' || node === 'textarea' ||
                    target.getAttribute('contenteditable') === "true") {
                    return;
                }
                if ($ctrl.LCS.findClosestParent(target, '.sb-dropdown-menu') !== null) {
                    return;
                }
                if ($ctrl.LCS.findClosestParent(target, '.wrap-dd-select') !== null) {
                    return;
                } //the popovers
                if ($ctrl.LCS.findClosestParent(target, '.modal-dialog') !== null) {
                    return;
                }
                if ($ctrl.LCS.findClosestParent(target, '.dropdown-menu') !== null) {
                    return;
                }
            }

            var isnotctrl = !isctrl();
            //console.log('keydown:' + key + '; isCtrl:' + $ctrl.keyboardService.isCtrl);
            if (!isCmdS) {
                switch (key) {
                    case keys.cKey: //copy for duplicate
                        if (!$ctrl.keyboardService.canCopy || $ctrl.keyboardService.cantCopyMulti || isnotctrl) {
                            return;
                        }
                        action = ActionTypes.Copy;
                        break;
                    case keys.xKey: //copy for   move
                        if (!$ctrl.keyboardService.canMove || isnotctrl) {
                            return;
                        }
                        action = ActionTypes.Cut;
                        break;

                    case keys.vKey:
                        if (!$ctrl.keyboardService.canCopy || !$ctrl.keyboardService.canMove || isnotctrl) {
                            return;
                        }
                        action = ActionTypes.Paste;
                        break;
                }

                if (!action && !data.withoutItemKeyEvents) {
                    switch (key) {
                        case keys.backspaceKey: //select -> delete : type == 3
                        case keys.deleteKey: //select -> delete : type == 3
                            //for stripboards
                            action = $ctrl.keyboardService.cantDeleteMulti ? ($ctrl.currentList && $ctrl.currentList.active === false ? ActionTypes.Activate : ActionTypes.Archive) : ActionTypes.Delete;
                            break;

                        case keys.eKey:
                        case keys.EKey: //Edit selected shots
                            if (isnotctrl) {
                                return;
                            }
                            action = ActionTypes.Edit;
                            break;

                        default:
                            //console.log('onKeydownEvent.key: ' + key);
                            if (isnotctrl) {
                                return;
                            }
                            action = key;

                        /*  case keys.plusKey:
                          $ctrl.zoom($ctrl.ZoomTypes.In); break;
                          case keys.minusKey:
                          $ctrl.zoom($ctrl.ZoomTypes.Out); break;
                          case keys.zeroKey:
                          $ctrl.zoom($ctrl.ZoomTypes.Reset); break;
                          */
                    }
                }

                $ctrl.processActionEvent(action, data, params, e);
            }
        }

        function processActionEvent(action, data, params, e) {
            //console.log('processActionEvent:' + action);
            var sId = data.currentListId,
                clipboard = $ctrl.getKeyboardSelectedRows(action, data),
            isctrlorshift = e && ((e.ctrlKey || e.metaKey) || e.shiftKey);

            switch (action) {
                //clipboard has the rows to be moved ; copied has the row to be moved to
                case ActionTypes.Duplicate: //copy + paste
                case ActionTypes.Move: //select -> delete : type == 3
                    if(isctrlorshift){$ctrl.preventDefault(e);}
                    return duplicateOrMoveSelected(action, data, params, e);

                case ActionTypes.Copy:
                case ActionTypes.Cut: //copy for duplicate or move
                    if(isctrlorshift){$ctrl.preventDefault(e);}
                    return cutOrCopySelected(action);

                case ActionTypes.Paste:
                    if(isctrlorshift){$ctrl.preventDefault(e);}
                    return pasteSelected(e);

                case ActionTypes.Delete: //select -> delete : type == 3
                    var mess = 'This cannot be undone.';
                    if(isctrlorshift){$ctrl.preventDefault(e);}
                    return processDefaultSelected(ActionTypes.Delete, _.extend({
                        dontConfirm: $ctrl.dontConfirmDelete,
                        action: ActionTypes.Delete,
                        icon: 'trash',
                        iconLevel: 2
                    }, data), {
                        t1: $ctrl.nameForRemove ? $ctrl.nameForRemove : 'Remove',
                        moreMess:  data.item && typeof($ctrl.getMessageForDeleted) === 'function' ? ($ctrl.getMessageForDeleted(data.item) || mess) : 'This cannot be undone.',
                        itemTitle: typeof($ctrl.getItemType) === 'function' && data.item ? $ctrl.getItemType(data.item) : $ctrl.itemTitle
                    });

                case ActionTypes.Archive: //select -> archive : type == 12
                    if(isctrlorshift){$ctrl.preventDefault(e);}
                    return processDefaultSelected(ActionTypes.Archive, {
                        action: ActionTypes.Archive,
                        icon: 'box',
                        iconLevel: 2
                    }, {
                        t1: $ctrl.nameForArchived ? $ctrl.nameForArchived : 'Archive',
                        moreMess: $ctrl.messageForArchived ? $ctrl.messageForArchived :
                            'You can always recover ' + (clipboard && clipboard.length === 1 ? 'it' : 'them') + ' from the ' + ($ctrl.nameForArchived ? ($ctrl.nameForArchived === 'Omit' ? 'Omitted' : ($ctrl.nameForArchived + 'd')) : 'Archived') + ' section.',
                        itemTitle: $ctrl.itemTitle
                    });

                case ActionTypes.Activate: //select -> archive : type == 11
                    if(isctrlorshift){$ctrl.preventDefault(e);}
                    return processDefaultSelected(ActionTypes.Activate, {
                        action: ActionTypes.Activate,
                        icon: 'restore',
                        iconLevel: 2
                    }, {
                        t1: $ctrl.nameForActivate ? $ctrl.nameForActivate : 'Restore',
                        moreMess: $ctrl.messageForActivated ? $ctrl.messageForActivated : '',
                        itemTitle: $ctrl.itemTitle
                    });

                case ActionTypes.Edit: //Edit selected shots
                    var event = $ctrl.keyboardService.getKeyEvent(sId, data.e.keyCode);
                    if (event) {
                        if(isctrlorshift){$ctrl.preventDefault(e);}
                        editSelected({event: event, sId: sId, e: data.e});
                    }
                    return;

                default:
                    if (!data.withoutItemKeyEvents) {
                        //check if is a key in the list and if yes apply the spec event. otherwise apply the other key method
                        var event = $ctrl.keyboardService.getKeyEvent(sId, action);
                        if (event) {
                            if(isctrlorshift){$ctrl.preventDefault(e);}
                            createNew(event);
                        } else {
                            if (typeof ($ctrl.keyboardService.processOtherKey) === 'function') {
                                $ctrl.keyboardService.processOtherKey(action, data);
                            }
                        }
                    }
                    return;
            }

            function cutOrCopySelected(action) {
                if (!clipboard || !clipboard.length) {
                    console.log('Select a row after which the selected row will be ' + (action === ActionTypes.Copy ? 'duplicated' : 'moved'));
                    return;
                }

                //todo disable
                if (action === ActionTypes.Copy && !$ctrl.keyboardService.canCopy) {
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.error.cantCopy', 'error');
                    return;
                }

                var sclass = 'copied';
                clearArray(sclass);
                for (var i = clipboard.length - 1; i >= 0; i--) {
                    var el = clipboard[i], id = el.id, row = $ctrl.getRowById(id);
                    unselectRow(row, 'clipboard', i);
                    selectRow(row, sclass, id, el.sId);
                }
                $ctrl.keyboardService.setPreviousEvent(action);

                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.keyboard' + (action === ActionTypes.Copy ? 'Copy' : 'Cut') + '.success', 'success');
            }

            function duplicateOrMoveSelected(action, data, params, e) {
                var l = clipboard.length;
                if (l === 0) {
                    console.log('Select at least one row to be moved');
                    return;
                }
                var t = action === ActionTypes.Duplicate ? 'duplicate' : (action === ActionTypes.Move ? 'move' : null),
                    x = (action === ActionTypes.Duplicate ? 'Duplicate' : 'Move');
                if (!params.message) {
                    params.message = 'Select '+($ctrl.withMoveBetweenDayBreaks ? ('in which ' + $ctrl.setupTypeName) : 'where') + ' to place the ' + x.toLowerCase() + 'd ' + itemTitle.toLowerCase() + '' + (l !== 1 ? 's' : '') + ':';
                }
                params.icon = action === ActionTypes.Duplicate ? 'copy' : 'transition';
                params.iconLevel = action === ActionTypes.Duplicate ? 2 : 4;

                params.action = action;
                if ($ctrl.hideSidebar) {
                    params.hideSidebar = true;
                }
                params.btn = x;
                params.title = x + ' ' + itemTitle + (l !== 1 ? 's' : '') + '?';

                if ($ctrl.withoutMoveBetweenLists || !params.listTreeService) {
                    if (action === ActionTypes.Move && $ctrl.withMoveBetweenDayBreaks) {
                        //get the day break   and display them on the popup
                        var items = _.filter($ctrl.list.items, {type: 0}) //at least one other day break;
                        if (items && items.length > 1) {
                            var id = data.item ? data.item._id : null;
                            params.items = items.map(function (item) {
                                return $ctrl.getItemTitleForMovePopup(item, id);
                            });

                            openPopupMessage(onConfirm, params, 'groupKeyboardActions', e);
                        }
                    } else {
                        onConfirm(params.listTreeService.active.selectedListId);
                    }
                } else {
                    openPopupMessage(onConfirm, params, null, e);
                }

                $ctrl.keyboardService.setPreviousEvent(null);


                function onConfirm(sId, extraParam) {
                    if (sId === undefined) {
                        console.log('Select a row after which the selected row will be ' + x.toLowerCase() + 'd');
                        return;
                    }

                    var sclass = 'copied';
                    clearArray(sclass);

                    $ctrl.keyboardService.addSelectedId(sclass, getExtraRowId(), sId);

                    duplicateOrMove(t, extraParam, e);
                }
            }

            function pasteSelected(e) {
                //clipboard should have the rows to be moved ; copied should have the row to be moved to
                //so swap clipboard with copied
                $ctrl.keyboardService.swapLists();
                var prevEvent = $ctrl.keyboardService.getPreviousEvent();
                duplicateOrMove(prevEvent === ActionTypes.Copy ? 'duplicate' : (prevEvent === ActionTypes.Cut ? 'move' : null), null, e);
                $ctrl.keyboardService.setPreviousEvent(null);
            }

            function duplicateOrMove(text, extraParam, e) {
                //clipboard should have the rows to be moved ; copied should have the row to be moved to
                if (!text) {
                    return;
                }
                var clipboard = $ctrl.getKeyboardSelectedRows(),
                    copied = $ctrl.keyboardService.CopiedRows;
                if (!clipboard || clipboard.length === 0) {
                    //console.log('Select at least one row to be ' + text + 'd');
                    return;
                }

                if (text === 'move') {//move type ==1
                    if (copied.length === 0) {
                        console.log('Select a row after which the selected row will be ' + text);
                        return;
                    }
                    //console.log('Rows ' + clipboard.join(', ') + ' will be moved after highest index row of ' + copied.join(', '));
                    processSelected(ActionTypes.Move, extraParam);
                } else { // duplicate : type == 2
                    if (copied.length === 0) {
                        copied = $ctrl.keyboardService.duplicateArray(clipboard);
                    }
                    //  console.log('Rows ' + clipboard.join(', ') + ' will be duplicated and added after highest index row of ' + copied.join(', '));
                    $ctrl.checkQuota($ctrl.getGroupQuota(), process, {e: e});

                    // $ctrl.checkQuota($ctrl.quotaType, process, {maxAddedCount: copied.length});
                    function process() {
                        processSelected(ActionTypes.Duplicate, extraParam);
                    }
                }
            }

//event, sId e
            function editSelected(event, sId) {
                processFirstSelectedItem(sId, event, getFirstSelected(sId));
            }

            function createNew(event) {
                editSelected(event, sId);
            }
        }

        function getKeyboardSelectedRows() {
            return $ctrl.keyboardService.SelectedRows;
        }

        function getFirstSelectedId() {
            return getFirstSelected($ctrl.currentListId);
        }

        function getFirstSelected(sId, e) {
            var clipboard = $ctrl.getKeyboardSelectedRows(),
                clipboardLocal = clipboard ? _.filter(clipboard, {sId: sId}) : [],
                l = clipboardLocal && clipboardLocal.length > 0 ? $ctrl.keyboardService.getId(clipboardLocal[0]) : null;
            return l && l.length > 0 ? $ctrl.keyboardService.getId(clipboardLocal[0]) : undefined;
        }

        function processDefaultSelected(action, params, info, e) {
            var clipboard = $ctrl.getKeyboardSelectedRows(action, params);
            var l = clipboard.length;
            if (l === 0) {
                return;
            }
            var itemTitle = info.itemTitle ? info.itemTitle.toLowerCase() : 'item',
                itemTitles = itemTitle + (l === 1 ? '' : 's');
            params.title = info.t1 + ' ' + $ctrl.CPS.capitalizeFirst(itemTitles);
            params.message = 'Are you sure you want to ' + info.t1.toLowerCase() + ' ' + (l === 1 ? ('this ' + itemTitle) : ('the selected ' + itemTitles)) + '? ' +
                (info.moreMess ? ('<br/>' + info.moreMess) : '');
            params.btn = '<span>' + info.t1 + '</span><span class="hide-ipad"> ' + $ctrl.CPS.capitalizeFirst(itemTitles) + '</span>';

            if (typeof ($ctrl.processDefaultSelectedParams) === 'function') {
                params = _.extend(params, $ctrl.processDefaultSelectedParams(action, params));
            }
            if (params.dontConfirm) {
                processSelected(action);
            } else {
                openPopupMessage(function (param, extraParam) {
                    processSelected(action, _.extend(extraParam, params));
                }, params, null, e);
            }
            $ctrl.keyboardService.setPreviousEvent(null);
        }

        function getItemTitleForMovePopup(item, id){
            return {name: item.name, _id: item._id, active: item._id === id};
        }
    }
}

angular.module('list.keyboard.service', [
    'sb.sortable.service'
])
.service('KeyboardListService', KeyboardListService);
KeyboardListService.$inject = ['LCS', 'SBFieldTypesService', 'RootEventsService', 'SBSortableService'];
function KeyboardListService(LCS, SBFieldTypesService, RootEventsService, SBSortableService) {
    /*{
        itemTitle,
        objectType,
        tableClass,
        itemClass,
        treeClass,
        treeItemClass
    }*/

    return function (data) {
        var lastClicked = -1,
            prevEvent,
            keys = {
                ctrlKey: 17,
                cmdKey: 91,
                shiftKey: 16,
                deleteKey: 127,
                backspaceKey: 8,
                xKey: 88,
                vKey: 86,
                cKey: 67,
                CKey: 99,
                AKey: 65,
                aKey: 97,
                EKey: 69,
                eKey: 101,
                FKey: 70,
                fKey: 102,
                NKey: 78,
                nKey: 110,
                BKey: 66,
                bKey: 98,
                SKey: 83,
                sKey: 115,
                TKey: 84,
                tKey: 116,
                PKey: 80,
                pKey: 112,
                DKey: 68,
                dKey: 100,
                RKey: 82,
                rKey: 114,
                plusKey: 43,
                minusKey: 46,
                zeroKey: 48,
                leftKey: 37,
                upKey: 38,
                rightKey: 39,
                downKey: 40,
                escKey: 27
            },
            ActionTypes =  {Create:0, Move: 1, Duplicate: 2, Delete: 3, Up: 4, Down: 5, Copy:6, Cut: 7, Paste: 9, Edit: 10, Activate: 11, Archive:12, Merge:13 };

        var service = {
            LCS: LCS,
            sbPopoverClass: '.with-sb-popover',
            SBNoTableClick: SBFieldTypesService.SBNoTableClick,
            SBFieldEditable: SBFieldTypesService.SBFieldEditable,
            canCopy: false,
            canMove: false,

            isCtrl: false,
            isShift: false,

            selectOnCtrl: false,
            hasOverlayClass:false,
            hasSelectedClass:true,
            selectOnlyOnCheckmark: true,

            currentListId: null,
            keys: keys,
            keyEvents: {},
            ActionTypes: ActionTypes,
            SelectedRows: [], 
            CopiedRows: [],
            getPreviouslyClickedId: getPreviouslyClickedId,
            setPreviouslyClickedId: setPreviouslyClickedId,
            removeSelectedIndex: removeSelectedIndex,
            addSelectedId: addSelectedId,
            duplicateArrays: duplicateArrays,
            setPreviousEvent: setPreviousEvent,
            getPreviousEvent: getPreviousEvent,

            isIdInArray: isIdInArray,
            getList: getList,
            setList:setList,
            getId: getId,
            duplicateArray: duplicateArray,

            initKeyboardEvents: initKeyboardEvents,
            removeKeyEvents: removeKeyEvents,
            setKeyEvents: setKeyEvents,
            swapLists: swapLists,
            getKeyEvent: getKeyEvent,
            getRowClass: getRowClass,
            setSortable: setSortable,
            getSelectedItemCls: getSelectedItemCls,
            getAttribute: getAttribute,
            reloadSortable: reloadSortable
        };

        if(data) {
            for (var prop in data) {
                service[prop] = data[prop];
            }
        }

        if(!service.treeClass){
            service.treeClass = '.side-nav';
        }

        if(!service.itemClass){
            service.itemClass = '.row-scheduleTemp';
        }

        if(!service.treeItemClass){
            service.treeItemClass = '.inline-tree-item';
        }

        var ot = service.objectType.toUpperCase() +
            (service.isCommentsSidebar ? '_COMMENTS_SIDEBAR' : '');
        service.ROW_CLICK_POPOVER = ot + '_ROW_CLICK_POPOVER';
        service.ROW_CLICK_EVENT = ot + '_ROW_CLICK_EVENT';
        service.TREE_CLICK_POPOVER = ot +'_TREE_CLICK_POPOVER';
        service.KEYDOWN_EVENT = ot + '_KEYDOWN_EVENT';
        service.POPUP_SELECTED = ot + '_POPUP_ITEMS_SELECTED';
        service.CLIPBOARD_PROCESSING = ot + '_CLIPBOARD_PROCESSING';
        service.CLEAR_SELECTED = ot +'_CLEAR_SELECTED_ROWS';
        service.SORTABLE_LOADED = ot + '_SORTABLE_TREE_GROUP_LOADED';

        service.broadcastGroupLoaded = broadcastGroupLoaded;
        service.loadGroupLoaded = loadGroupLoaded;

        return service;

        function broadcastGroupLoaded($ctrl, currentListId){
            if(service.definedInPageTree) {
                $ctrl.broadcastRoot(service.SORTABLE_LOADED, {
                    currentListId: currentListId,
                    elemType: service.elemType
                });
            }
        }

        function loadGroupLoaded($ctrl, nodes){
            //console.log('KeyboardListService.loadGroupLoaded ' + service.elemType);
            if(!service.definedInPageTree) {return;}
            removeKeyboardServiceWatchers($ctrl);

            service.groupIds = {};
            $ctrl.RootEventsService.addRootWatcher(service.sortableWatchers, service.SORTABLE_LOADED, onGroupLoaded);

            _.each(nodes, function (n){
                service.groupIds[n._id] = false;
            });

            function onGroupLoaded(result){
                if(result.elemType !== service.elemType){
                    return;
                }
                var id = result.currentListId;
                if(!service.definedInPageTree){return;}
                //console.log('onGroupLoaded');
                if(service.groupIds) {
                    service.groupIds[id] = true;
                    for (var gId in service.groupIds){
                        if(!service.groupIds[gId]) {
                            return false;
                        }
                    }
                }

                //console.log('KeyboardListService. onGroupLoaded. setSortable' + service.elemType);
                //for trees and for workflow. wait for groups to be loaded

                service.setSortable($ctrl);
             }
        }

        function removeKeyboardServiceWatchers($ctrl){
            if(service.sortableWatchers){
                $ctrl.RootEventsService.removeWatchers(service.sortableWatchers);
            }
            service.sortableWatchers = [];
        }

        function setSortable($ctrl) {
            //masonary needs sortable
            var canDrag = ($ctrl.canEdit || !$ctrl.withSortable || $ctrl.sortableSet),
                shouldSet = $ctrl.isMasonary || !$ctrl.isMasonary && canDrag;
            if (!shouldSet){
                return;
            }

            //console.log('setSortable');
            var sortableContainmentCls = $ctrl.sortableContainmentCls ? ('.' + $ctrl.sortableContainmentCls) : ($ctrl.sortableGrid ? ('#' + $ctrl.sortableGrid) : ''),
                sortableOptions = {
                    sortableContainerCls: $ctrl.sortableContainerCls,
                    scrollableKanbanColumnCls: $ctrl.scrollableKanbanColumnCls,
                    containerPositioning: 'relative',//optional param.
                    sortableContainmentCls: sortableContainmentCls,

                    elemType: $ctrl.elemType,
                    currentListId: $ctrl.currentListId,

                    scrollableParentCls: $ctrl.scrollableParentCls ? $ctrl.scrollableParentCls :
                        ($ctrl.hasTree ? '.scrollable-content' : sortableContainmentCls),
                    selectedItemCls: service.getSelectedItemCls(),
                    withMultiSelect: service.withMultiSelect,
                    cantBeDraggedLast: service.cantBeDraggedLast,
                    definedInPageTree: service.definedInPageTree
                };
            if(service.sortableDirection) {
                sortableOptions.direction = service.sortableDirection;
            }
            if(service.sortableService){
                service.sortableService.destroy();
            }

            $ctrl.isDragula = true;
            service.sortableService = new SBSortableService($ctrl.element, sortableOptions, {
                isMasonary: $ctrl.isMasonary,
                isDragula: !$ctrl.isMasonary && $ctrl.isDragula,
                canDrag: canDrag,
                itemSelector: $ctrl.itemSelector,
                itemHandleCls: $ctrl.itemHandleCls
            });
            $ctrl.sortableSet = true;
        }

        function reloadSortable(){
            if(service.sortableService){
                service.sortableService.reload();
            }
        }

        function getSelectedItemCls(){
            return (service.hasOverlayClass ? 'overlay-row' : 'overlay-selected') +
                   (service.hasSelectedClass ? ' selected' : '');
        }

        function getRowClass(isTree) {
            return isTree ? (service.treeClass + ' ' + service.treeItemClass) : (service.tableClass + ' ' + service.itemClass);
        }

        function hase(list, castId) {
            if (list) {
                var res = _.filter(list, function (val) {
                    return val === castId;
                });

                if (res && res.length > 0) {
                    return true;
                }
            }
            return false;
        }

        function setKeyEvents(sId, list) {
            var keys = {}, event, type;
            for (var i = 0, n = list.length; i < n; i++) {
                event =list[i];
                type = event ? event.type : null;
                if (type && !keys[type]) {
                    keys[type] = event;
                }
            }
            service.keyEvents[sId] = keys;
        }

        function getKeyEvent(sId, key) {
            var keys = service.keyEvents[sId];
            for (var type in keys) {
                var event = keys[type];
                if (event.keys.indexOf(key) !== -1) {
                    return event;
                }
            }
            return null;
        }

        function removeKeyEvents(sId) {
            delete service.keyEvents[sId] ;
        }

        function getId(el) {
            return el ? el.id : null;
        }

        function setId(id, sId) {
            if(sId === '' || sId === 'null'){sId = null;}
            if(sId === 'All'){sId = null;}
            return {id: id, sId: sId};
        }

        function swapLists() {
            var temp = duplicateArray(service.SelectedRows);
            service.SelectedRows = duplicateArray(service.CopiedRows);
            service.CopiedRows = temp;
        }

        function isIdInArray(id, sclass) {
            var list = getList(sclass);
            for (var i = list.length - 1; i >= 0; i--) {
                if (getId(list[i]) === id) {
                    return i;
                }
            }
            return -1;
        }

        function setPreviousEvent(type) {
            prevEvent = type;
        }

        function getPreviousEvent() {
            return prevEvent;
        }

        function getPreviouslyClickedId() {
            return getId(lastClicked);
        }

        function setPreviouslyClickedId(id, sId) {
            lastClicked = setId(id, sId);
        }

        function getListName(sclass){
            return sclass ==='copied' ? 'CopiedRows' : 'SelectedRows';
        }

        function setList(sclass, val) {
            service[getListName(sclass)] = val;
        }

        function getList(sclass) {
            return service[getListName(sclass)];
        }

        function addSelectedId(sclass, id, sId) {
            if (getList(sclass).indexOf(id) === -1) {
                getList(sclass).push(setId(id, sId));
            }
        }

        function removeSelectedIndex(sclass, i) {
            if (i > -1) {
                getList(sclass).splice(i, 1);
            }
        }

        function duplicateArrays() {
            return {
                clipboard: duplicateArray(service.SelectedRows),
                copied: duplicateArray(service.CopiedRows)
            };
        }

        function duplicateArray(list) {
            var nl = [];
            _.each(list, function (el) {
                var ne = {};
                for (var prop in el) {
                    ne[prop] = el[prop];
                }
                nl.push(ne);
            });
            return nl;
        }

        //bind keyboard events 
        function initKeyboardEvents(canEdit, isBind, treeClass, treeParams, element, selectedFilter) {
            var tableClass = treeClass ? treeClass : service.tableClass,
                ev = 'keyboardEvents' + tableClass.replace(/\./g, '_');

            process(isBind);

            function process(isBind) {
                //console.log('initKeyboardEvents ' + (isBind ? 'isBind' : 'isUnBind') + getSBTimestamp());
                LCS.bindElementsClick(isBind, element, onClickEvent, ev);
                //dont have keydown event on callsheet page sicne there are many grids
                if(!treeClass && !LCS.isTouchScreen && !service.withoutKeydownEvent) {//only for groups
                    LCS.bindElementsClick(isBind, LCS.bodyElement, onKeydownEvent, ev, 'keydown');
                }
            }

            function onClickEvent(e) {
                var el = e.target;
                if (tableClass) {
                    var table = LCS.findClosestParent(el, tableClass),
                        cantClick = LCS.findClosestParent(el, '.' + service.SBNoTableClick);
                    if (table &&!cantClick) {
                        try {
                            var currentListId = getAttribute(table, 'data-currentlistid');

                            //console.log('table: onClickEvent: ' + currentListId);
                            var anchorElement = LCS.findClosestParent(el, service.sbPopoverClass),
                                popoverEventType = treeClass ? service.TREE_CLICK_POPOVER : (service.ROW_CLICK_POPOVER + currentListId),
                                rowEventType = service.ROW_CLICK_EVENT + currentListId;

                            if (anchorElement) {//popovers in rows
                                RootEventsService.broadcastRoot(popoverEventType, {
                                    e: e,
                                    anchorElement: anchorElement
                                });
                                try {
                                    e.preventDefault();
                                    e.stopPropagation();
                                }catch (er){console.log('onClickEvent:' + er);}
                            }
                           else if (!treeClass && service.itemClass && canEdit) {
                                //can select on entire row (not only on checkmark) - stripboard shot
                                var canSelect = !service.selectOnlyOnCheckmark
                                    //on mobile can select on check mark if exists
                                //    && !LCS.isTouchScreen
                                ;
                                canSelect = canSelect || !canSelect && LCS.findClosestParent(el, '.row-schedule .check');
                                if (currentListId !== undefined && currentListId !== service.currentListId) {
                                    service.currentListId = currentListId;
                                }

                                RootEventsService.broadcastRoot(rowEventType, {
                                    elemType: service.elemType,
                                    $event: e,
                                    canSelect: canSelect
                                });
                                //e.preventDefault();
                                //e.stopPropagation();
                            }
                        } catch (er) {
                        }
                    }
                }
            }

            function onKeydownEvent(e) {
                //console.log('onKeydownEvent');
                var active = document.activeElement;
                if(active.tagName !== 'BODY' && !element.contains(active)){
                    //return;
                }else {
                    var currentListId = service.currentListId;
                    if (currentListId !== undefined) {
                        RootEventsService.broadcastRoot(service.KEYDOWN_EVENT, {
                            elemType: service.elemType,
                            data: {
                                e: e,
                                currentListId: currentListId
                            },
                            params: treeParams
                        });
                    }
                }
            }
        }

        function getAttribute(el, attr) {
            var id = el.getAttribute(attr);
            if (id === 'null') {
                id = null;
            }
            if (id === 'undefined') {
                id = undefined;
            }
            if (el.getAttribute('data-isnumber') === 'true') {
                id = parseInt(id, 10);
            }
            return id;
        }
    };
}

angular.module('imgupload.init.service', [
])
.service('ImgUploadInitService', ImgUploadInitService);
function ImgUploadInitService() {
    return function ($ctrl, isUploadedInList) {
        $ctrl.isUploadedInList = isUploadedInList === true;
        //$ctrl.removeWatcher($ctrl.imageUploadedWatcher); $ctrl.imageUploadedWatcher =

        //dont set image events for comments sidebar
        if(!$ctrl.isCommentsSidebar) {
            $ctrl.addRootWatcher('IMAGE_UPLOADED', onImageUploaded);
        }

        if(!$ctrl.getCollectionServiceForImage){
            $ctrl.getCollectionServiceForImage = getCollectionServiceForImage;
        }

        if(!$ctrl.onImageUploadedRemove){
            $ctrl.onImageUploadedRemove = onImageUploadedRemove;
        }

        if(!$ctrl.onImageUploadedUpdate){
            $ctrl.onImageUploadedUpdate = onImageUploadedUpdate;
        }

        return $ctrl;

        function onImageUploaded(result) {
            if(!result){return;}
            var service = getServiceForImage(result);
            if(!service){return;}
            console.log('ImgUploadInitService.onImageUploaded ' + service.collectionName + '; isUploadedInList:' + $ctrl.isUploadedInList);

            if($ctrl.withBgImg) {
                result.withBgImg = true;
            }
            switch(result.eventType) {
                case 'update':
                    $ctrl.onImageUploadedUpdate(result);

                    /*if ($ctrl.preLoadingService) {
                        //todo
                        // $ctrl.preLoadingService.processUpdateInfo($ctrl.preLoadingService.TblTypes.Materials, result.materials, $ctrl.preLoadingService.Ops.Create);
                    }*/

                    break;

                case 'remove':
                    $ctrl.onImageUploadedRemove(result);
                    break;
            }
        }

        function onImageUploadedRemove(result) {
            var service = getServiceForImage(result);
            if(!service){return;}
            console.log('ImgUploadInitService.onImageUploadedRemove ' + service.collectionName + '; isUploadedInList:' + $ctrl.isUploadedInList);
            var item = result ? result.item : null;
            if (item) {
                if (!result.withBgImg) {//don't trigger update from remove bg popup
                    var r = {}, hasChanges;
                    for (var p in item) {
                        var changedFields = service.getChangedFieldForUpdate();
                        if (p !== '_id' && changedFields && changedFields.indexOf(p) !== -1) {
                            r[p] = item[p];
                            hasChanges = true;
                            break;
                        }
                    }
                    if (hasChanges) {
                        service.update(item, onSuccess, onError);
                    }
                } else {
                    onSuccess();
                }
            } else {
                onComponentId(result);
            }

            function onSuccess() {
                $ctrl.onImageUploadedUpdate(result);
            }

            function onError(error) {
                if (error) {
                    $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.image.remove.error', 'error');
                }
            }
        }

        function onImageUploadedUpdate(result) {
            console.log('ImgUploadInitService.onImageUploadedUpdate isUploadedInList : ' + $ctrl.isUploadedInList);
            var id = result && result.item ? result.item._id : null;
            if (id) {
                var updatedItem;
                if ($ctrl.isUploadedInList) {
                    var cond = {};
                    cond[$ctrl.populatedFieldWithImage ? $ctrl.populatedFieldWithImage : '_id'] = id;
                    var el = _.find($ctrl.list.items, cond);
                    if (el) {
                        var id1 = el._id;
                        $ctrl.replaceElementProps(id1, el.getUpdatedImageProps(result.updatedImage));
                        updatedItem = $ctrl.list.getElementById(id1);
                    }
                } else if ($ctrl.item._id === id) {
                    updatedItem = result.item;
                }

                if (updatedItem && typeof ($ctrl.onImageUpdate) === 'function') {
                    console.log('onImageUpdate in list');
                    $ctrl.onImageUpdate(updatedItem, result);
                }
            } else {
                onComponentId(result);
            }
        }

        function onComponentId(result){
            if(getComponentId(result)){
                //for ex for taskboard there is no $ctrl.item.id created since the prop doesn't yet
                $ctrl.onImageUpdate(null, result);
            }
        }

        function getComponentId(result) {
            var resCompId = result ? result.componentId : null;
            if (!resCompId) {
                return false;
            }
            var img = $ctrl.element ? $ctrl.element.querySelector('.sb-resizable-img') : null,
                componentId = img ? img.getAttribute('data-id') : null;
            return resCompId === componentId;
        }

        function getCollectionServiceForImage(){
            return $ctrl.service;
        }

        function getServiceForImage(result){
            if(!result){return null;}
            var service = $ctrl.getCollectionServiceForImage(),
                collection = service ? service.collectionName : null;
            return (result && result.collectionProp && collection && result.collectionProp !== collection) ? null : service;
        }

    }
}

angular.module('list.ctrl', [
    'item.ctrl',
    'list.init.service',
    'imgupload.init.service',
    'list.keyboard.init.controller.service'
]);

angular.module('list.filters.init.controller', [
])
.controller('ListFiltersInitCtrl',ListFiltersInitCtrl);
ListFiltersInitCtrl.$inject = ['$ctrl'];
function ListFiltersInitCtrl($ctrl) {
    if(!$ctrl){
        console.warn('parent for ListFiltersInitCtrl must define $ctrl');
    }
    if(!$ctrl.watchers){
        $ctrl.watchers = [];
    }
    var changedFields = ['selectedFilter'];
    if (!$ctrl.Filters && !$ctrl.hideFilters) {
        $ctrl.Filters = [{value: true, text: 'Active'}, {value: false, text: 'Archived'}];
    }

    $ctrl.isFilter = isFilter;
    $ctrl.addFilters = addFilters;

    $ctrl.onSelectedFilterChanged = onSelectedFilterChanged;
    $ctrl.$onChanges = $onChanges;

    function $onChanges(changes) {
        console.log(changes);
        if (!changes) {
            return;
        }
        for (var i = 0, l = changedFields.length; i < l; i++) {
            var field = changedFields[i],
                change = changes[field];
            if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                if (field === 'selectedFilter') {
                    $ctrl.onSelectedFilterChanged();
                }
                break;
            }
        }
    }

    function onSelectedFilterChanged(el) {
        if (el.value === $ctrl.selectedFilter) {
            $ctrl.currentFilter = el.text;
        }
        /*
        for (var p in $ctrl.Filters) {
            var el = $ctrl.Filters[p];
            if (el.value === $ctrl.selectedFilter) {
                $ctrl.currentFilter = el.text;
                break;
            }
        }*/
    }

    function isFilter(filter) {
        return $ctrl.selectedFilter === filter;
    }

    function addFilters(filters, selected) {
        $ctrl.Filters = filters;
        $ctrl.selectedFilter = $ctrl.Filters[selected].value;
    }
}

angular.module('list.init.service', [
    'sort.init.service',
    'services.listSorting',
    'ctrl.popups.service'
])
.service('ListInitService', ListInitService);
ListInitService.$inject = ['CompInitCtrlService', 'ImgUploadInitService', 'ListSortingService', 'SortInitService'];
function ListInitService(CompInitCtrlService, ImgUploadInitService, ListSortingService, SortInitService) {
    return function ($ctrl, options) {
        //options should have $element, list,
        //console.log('ListInitCtrl');
        var ActionTypes = {
            Create: 0,
            Move: 1,
            Duplicate: 2,
            Delete: 3,
            Up: 4,
            Down: 5,
            Copy: 6,
            Cut: 7,
            Paste: 9,
            Edit: 10,
            Activate: 11,
            Archive: 12
        };
        $ctrl.ActionTypes = ActionTypes;
        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl);
        }

        if(!options){options = {};}

        if(options.$element) {
            $ctrl.$element = options.$element;
            $ctrl.element = $ctrl.$element && $ctrl.$element.length > 0 ? $ctrl.$element[0] : null;
        }

        if (!$ctrl.element) {
            throw new Error('setup element');
        }

        if (options.list) {
            $ctrl.list = options.list;
        }

        if (!$ctrl.list) {
            throw new Error('setup list');
        }
        $ctrl.service = $ctrl.list.getService();

        if (!$ctrl.service) {
            console.warn('Parent for ListInitService must define service');
        }

        $ctrl.popupsService.service = $ctrl.service;

        if (!$ctrl.CPS.stateParams) {
            console.warn('Parent for ListInitService must define CPS.stateParams');
        }

        if (!options) {
            options = {};
        }
        $ctrl.preProcessGroupItem = options.preProcessGroupItem !== undefined ? options.preProcessGroupItem : null;
        $ctrl.preloadAll = options.preloadAll !== undefined ? options.preloadAll : false;
        $ctrl.indexOrder = options.indexOrder !== undefined ? options.indexOrder : 0;

        if(options.onAllLoaded) {
            $ctrl.onAllLoaded = options.onAllLoaded;
        }

        $ctrl.search = options.search !== undefined ? options.search : null;
        if (options.itemTitle !== undefined) {
            $ctrl.itemTitle = options.itemTitle;
        }
        if (options.withNoOrderChange !== undefined) {
            $ctrl.withNoOrderChange = options.withNoOrderChange;
        }
        $ctrl.defaultOrder = options.defaultOrder !== undefined ? options.defaultOrder : 'order';
        $ctrl.defaultOrderDir = options.defaultOrderDir !== undefined ? options.defaultOrderDir : 1;

        if(options.orders !== undefined){
            $ctrl.orders = options.orders;
        }else{
            $ctrl.orders = {};
            $ctrl.orders[$ctrl.defaultOrder] = $ctrl.defaultOrderDir;
        }

        $ctrl.create = typeof (options.create) === 'function' ? options.create : create;
        $ctrl.createInit = typeof (options.createInit) === 'function' ? options.createInit : create;

        if(!$ctrl.createInit) {
            $ctrl.createInit = create;
        }

        $ctrl.withProperty = typeof (options.withProperty) === 'function' ? options.withProperty : withProperty;
        if (typeof (options.getNewPopupParams) === 'function') {
            $ctrl.getNewPopupParams = options.getNewPopupParams;
        }
        if(!$ctrl.getNewPopupParams){
            $ctrl.getNewPopupParams = getNewPopupParams;
        }

        $ctrl.getNewPopupParamsInit = getNewPopupParams;

        if (typeof (options.getNew) === 'function') {
            $ctrl.getNew = options.getNew;
        }


        $ctrl.processSorting = typeof (options.processSorting) === 'function' ? options.processSorting : processSorting;

        $ctrl.getAll = typeof (options.getAll) === 'function' ? options.getAll : getAll;
        $ctrl.getAllIds = typeof (options.getAllIds) === 'function' ? options.getAllIds : getAllIds;
        $ctrl.replaceElementProps = replaceElementProps;
        $ctrl.insertElementInit = insertElementInit;
        $ctrl.removeElementInit = removeElementInit;
        $ctrl.removeElementsInit = removeElementsInit;

        if (typeof (options.afterProcessUpdates) === 'function') {
            $ctrl.afterProcessUpdates = options.afterProcessUpdates;
        }

        if (typeof (options.afterProcessUpdatesG) === 'function') {
            $ctrl.afterProcessUpdatesG = options.afterProcessUpdatesG;
        }

        $ctrl.processUpdatesG = processUpdatesG;
        $ctrl.addInitItems = addInitItems;

        //to process individual items through select checks
        $ctrl.selected = [];

        $ctrl.tabFocus = -1;
        $ctrl.isObjPlace = false;
        $ctrl.inprogress = false;
        $ctrl.editIndex = -1;
        $ctrl.deleteIndex = -1;
        $ctrl.focusIndex = -1;

        $ctrl.isAllSelected = false;

        $ctrl.popupsService.onSuccessPopup = onSuccessPopup;
        $ctrl.isInTabFocus = isInTabFocus;
        $ctrl.setTabFocus = setTabFocus;
        $ctrl.getTabIndex = getTabIndex;

        $ctrl.createNew = createNew;
        $ctrl.switchAddObjPlace = switchAddObjPlace;
        $ctrl.getLogoPath = $ctrl.security.getLogoPath;
        $ctrl.getInitials = getInitials;
        $ctrl.getNameColor = getNameColor;
        $ctrl.isSelectAll = isSelectAll;
        $ctrl.hasCastId = hasCastId;
        $ctrl.changeCastId = changeCastId;
        $ctrl.processUpdates = processUpdates;

        $ctrl.getNotification = getNotification;

        $ctrl.getFocus = getFocus;
        $ctrl.isSetFocus = isSetFocus;
        $ctrl.setFocus = setFocus;

        $ctrl.setEdit = setEdit;
        $ctrl.isEdit = isEdit;

        $ctrl.setDelete = setDelete;
        $ctrl.isDelete = isDelete;

        $ctrl.isInFieldFocus = isInFieldFocus;
        $ctrl.setFieldFocus = setFieldFocus;
        $ctrl.onInsertGridItem = onInsertGridItem;

        $ctrl.isFieldChangeable = isFieldChangeable;
        $ctrl.getOperationPopup = getOperationPopup;
        $ctrl.checkQuota = checkQuota;
        //to be overritew
        if (!$ctrl.list.onLoaded) {
            $ctrl.list.onLoaded = onLoaded;
        }
        $ctrl.processElementsInit = processElementsInit;

        $ctrl.onListDestroy = onListDestroy;

        $ctrl.processCachedElementInit = processCachedElementInit;
        if(!$ctrl.getInsertElementIndex) {
            $ctrl.getInsertElementIndex = getInsertElementIndex;
        }
        if(options.getOnOrderChangedListIds){
            $ctrl.getOnOrderChangedListIds = options.getOnOrderChangedListIds;
        }

        if(!$ctrl.getDisplayRootCount) {
            $ctrl.getDisplayRootCount = getDisplayRootCount;
        }

        $ctrl.getSortedList =  getSortedList;

        $ctrl.addRootWatcher('INSERT_' + $ctrl.elemType + '_ITEM_' + $ctrl.currentListId, $ctrl.onInsertGridItem);
        $ctrl.addRootWatcher('PROCESS_UPDATES_' + $ctrl.elemType + '_' + $ctrl.currentListId, $ctrl.processUpdates);

        $ctrl.onImageUpdate = onImageUpdate;

        $ctrl = new ImgUploadInitService($ctrl, true);
        $ctrl = new SortInitService($ctrl);

        return $ctrl;

        function onImageUpdate(item, result) {
            if(typeof($ctrl.onUpdatedImage) === 'function'){
                $ctrl.onUpdatedImage(item, result);
            }
        }

        function processCachedElementInit(el, cacheType, changedFields, tableType, isChildTable){
            return $ctrl.preLoadingService ? $ctrl.preLoadingService.processCachedElementInit(el, cacheType, changedFields, tableType || $ctrl.preLoadingTableName, isChildTable || $ctrl.isChildTable) : null;
        }

        function replaceElementProps(id, changes, changedFields, table, isChildTable, dontUpdateInList) {
            //console.log('ListInitService.replaceElementProps: ' + id);
            if (!changes) {return;}

            if(!dontUpdateInList){$ctrl.list.replaceElementProps(id, changes);}

            if ($ctrl.preLoadingService) {
                changes._id = id;
                if(!changedFields) {
                    changedFields = $ctrl.service.getChangedFieldForUpdate();
                }
               return $ctrl.processCachedElementInit(changes, $ctrl.preLoadingService.Ops.Edit, changedFields, table, isChildTable);
            }
        }

        function onListDestroy() {
            $ctrl.removeWatchers();
        }

        function onSuccessPopup(result, type) { //result={item:item, type: collectionName}
            //todo try to move all actions from here
            return;
        }

        function create() {
            var params = typeof ($ctrl.getNewPopupParams) ? $ctrl.getNewPopupParams() : null;
            return $ctrl.createNew('create', $ctrl.quotaType, null, params);
        }

        function createNew(opType, quotaType, item, extraParam, maxFreeItemsCount) {
            console.log('createNew');
            if(extraParam && extraParam.maxAddedCount !== undefined){
                process(extraParam.maxAddedCount);
            }else{
                $ctrl.checkQuota(quotaType, process, _.extend({}, extraParam, maxFreeItemsCount !== undefined ? {maxFreeItemsCount: maxFreeItemsCount} : null));
            }

            function process(maxAddedCount) {
                if (!extraParam) {
                    extraParam = {};
                }
                if (maxAddedCount) {
                    extraParam.maxAddedCount = maxAddedCount;
                }
                $ctrl.getOperationPopup(getItem(), opType, extraParam);

                function getItem() {
                    if (!item) {
                        item = $ctrl.getNew();
                    }
                    if (!item.order) {
                        item.order = $ctrl.list.getNewItemOrder();
                    }
                    if ($ctrl.hasOrderForAll) {
                        item.orderAll = item.order;
                    }
                    return item;
                }
            }
        }

        function getDisplayRootCount(type){
            return $ctrl.listTreeService && typeof ($ctrl.listTreeService.getDisplayRootCount) === 'function' ?
                $ctrl.listTreeService.getDisplayRootCount($ctrl.treeType, type) :
                (type ? _.filter($ctrl.list, {type: type}).length : $ctrl.list.totalCount);
        }

        function checkQuota(quota, process, params) {
            var count = $ctrl.getDisplayRootCount(params ? params.type : undefined) + (params && params.maxAddedCount ? params.maxAddedCount : 1);
            //console.log('checkQuota: maxFreeItemsCount:' + $ctrl.maxFreeItemsCount +'; count:'+ count);
            return $ctrl.CPS.loadQuotaPopup(quota, process,  params && params.maxFreeItemsCount !== undefined ? params.maxFreeItemsCount : $ctrl.maxFreeItemsCount, count, $ctrl.compOptions, params ? {
                onQuotaOpen: params.onQuotaOpen,
                e: params.e
            } : undefined);
        }

        function getNewPopupParams(item) {
            console.log('getNewPopupParams');
            return _.extend({
                service: $ctrl.service,
                getNew: $ctrl.getNew,

            }, $ctrl.getNewPopupParamsOther ? $ctrl.getNewPopupParamsOther(item):{});
        }

        function getOperationPopup(item, opType, extraParam) {
            var opType1 = opType + (
                opType === 'customNote' ? '' :  ($ctrl.objectType.substring(0, 1).toUpperCase() + $ctrl.objectType.substring(1, $ctrl.objectType.length))
                ),
                op = $ctrl.popupsService.operations[opType1];

            if(!op){
                op = $ctrl.popupsService.operations[opType + 'Item'];//createItem updateItem duplicateItem with general-item-edit Popup
            }

            if($ctrl.withCloseBtnOnPopup){
                if(!extraParam){extraParam = {};}
                extraParam.withCloseBtn = true;
                op.backdrop = 'static';
            }

            $ctrl.popupsService.open(item, op, extraParam, $ctrl.compOptions,
                $ctrl.service, extraParam ? extraParam.onSuccessPopup : null, $ctrl.getNotification);
        }

        function withProperty() {
            var f = {};
            if (!$ctrl.hideFilters && !$ctrl.isFilter('All')) {
                f.active = $ctrl.selectedFilter;
            }
            return f;
        }

        function getTabIndex(listIndex, fieldIndex, tableIndex, inputsPerRow) {
            if (!tableIndex) {
                tableIndex = $ctrl.indexOrder;
            }
            if (!inputsPerRow) {
                inputsPerRow = 30;//$ctrl.inputsPerRow;
            }
            return tableIndex * 1000 + (listIndex * inputsPerRow) + fieldIndex;
        }

        function isInTabFocus(listIndex, fieldIndex, tableIndex, inputsPerRow) {
            return $ctrl.tabFocus === getTabIndex(listIndex, fieldIndex, tableIndex, inputsPerRow);
        }

        function setTabFocus(listIndex, fieldIndex, tableIndex, inputsPerRow) {
            $ctrl.tabFocus = getTabIndex(listIndex, fieldIndex, tableIndex, inputsPerRow);
        }

        function switchAddObjPlace(val) {
            $ctrl.isObjPlace = val !== undefined ? val : true;
            if ($ctrl.isObjPlace) {
                $ctrl.setFieldFocus('new', 1);
                $ctrl.setFocus('new');
            } else {
                $ctrl.setFieldFocus(-1);
                $ctrl.setFocus(-1);
            }
        }

        function onInsertGridItem(result) {
            console.log('onInsertGridItem');
            var item = result.item ? result.item : result;
            $ctrl.isUpdating = false;
            $ctrl.switchAddObjPlace(false);
            $ctrl.LCS.timeout(function () {
                $ctrl.addInitItems([item], false);
                if ($ctrl.item) {
                    $ctrl.item.name = null;
                }
               // $ctrl.getNotification(null, $ctrl.objectType, true, $ctrl.item.name);
            }, 10);
        }

        function addInitItems(items, isNotCurrentList, table) {
            console.log('addInitItems');
            var l = items && items.length > 0 ? items.length : 0;
            if (!l) {
                return;
            }
            var hasPreProcess = typeof ($ctrl.preProcessGroupItem) === 'function';
            // $ctrl.afterProcessUpdatesG();
            _.each(items, function (item) {
                item.forceRowLoadNow = true;
                $ctrl.insertElementInit(item, 'insertAt', ActionTypes.Create, table || null, isNotCurrentList, hasPreProcess ? function (item) {
                    return $ctrl.preProcessGroupItem(item);
                } : null);
            });
        }

        function removeElementsInit(removedIds, table) {
            console.log('removeElementsInit');
            var l = removedIds && removedIds.length > 0 ? removedIds.length : 0;
            if (!l) {
                return;
            }
            _.each(removedIds, function (id) {
                $ctrl.removeElementInit(id, ActionTypes.Delete, table, false, false);
            });
        }

        function processElementsInit(result, table) {
            $ctrl.addInitItems(result.added, false, table);
            removeElementsInit(result.removed, table);
            result.table = table;
            $ctrl.processUpdates(result, true, true, false, false);
        }

        function removeElementInit(id, cacheType, table, listDoesntExist, isChildTable) {
            //console.log('removeElementInit');
            var el = {_id: id}, updateCache;
            if (!listDoesntExist) {
                if (!($ctrl.selectedFilter === 'All' && (cacheType === ActionTypes.Activate || cacheType === ActionTypes.Archive))) {
                    onListElementsUpdated(el, false);
                } else {
                    updateCache = true;
                }
            }

            var el1 = listProcessCachedElement(el, cacheType, null, table, isChildTable);
            if (updateCache) {
                $ctrl.list.replaceElementProps(id, {
                    active: el1.active
                });
            }

            return el1;
        }

        function insertElementInit(el, type, cacheType, table, listDoesntExist, preProcessItem) {
            if(!el){return;}
            //console.log('insertElementInit');
            if ($ctrl.list.getElementById(el._id)) {
                return;
            }
            el = $ctrl.service.convertResource(typeof (preProcessItem) === 'function' ? preProcessItem(el) : el);
            //add in cache resource objects with set params
            listProcessCachedElement(el, cacheType, null, table);
            if (!listDoesntExist) {
                onListElementsUpdated(el, true, type);
            }
        }

        function onListElementsUpdated(el, isAdd, type){
            if(isAdd){
                if (type === 'insertAt') {
                    $ctrl.list.insertElementAtIndex(el, $ctrl.getInsertElementIndex(el));
                } else {
                    $ctrl.list.insertElement(el, $ctrl.insertElementAfter);
                }
            } else{
                $ctrl.list.removeElement(el);
            }
            if(typeof($ctrl.onListElementsUpdated) === 'function'){$ctrl.onListElementsUpdated(el._id, isAdd);}
        }

        function getInsertElementIndex(el){
            return $ctrl.list.getInsertElementIndex(el);
            //return el ? el[$ctrl.list.defaultOrder] : undefined;
        }

        function listProcessCachedElement(el, cacheType, changedFields, table, isChildTable) {
            var optype;

            if (cacheType === ActionTypes.Activate || cacheType === ActionTypes.Archive || cacheType === ActionTypes.Delete) {
                switch (cacheType) {
                    case ActionTypes.Activate:
                        optype = $ctrl.preLoadingService.Ops.Activate;
                        break;
                    case ActionTypes.Archive:
                        optype = $ctrl.preLoadingService.Ops.Archive;
                        break;
                    case ActionTypes.Delete:
                        optype = $ctrl.preLoadingService.Ops.Remove;
                        break;
                }
            } else if (cacheType === ActionTypes.Create) {
                optype = $ctrl.preLoadingService.Ops.Create;
            }

            if (optype !== undefined) {
                return $ctrl.processCachedElementInit(el, optype, changedFields, table, isChildTable);
            }
        }

        function getInitials(item) {
            if (!item) {
                return null;
            }
            var init = null, n, sp;
            n = typeof (item) === 'string' ? item : (item.name ? item.name : (typeof (item.getName) === 'function' ? item.getName() : null));
            if (n) {
                sp = n.toUpperCase().split(' ');
            }
            if (sp != null && sp.length > 0) {
                init = '';
                for (var i = 0; i < sp.length; i++) {
                    if (sp[i].length > 0) {
                        init += sp[i][0];
                        if (init.length === 2) {
                            break;
                        }
                    }
                }
            }
            return init;
        }

        function getNameColor(item) {
            var init = $ctrl.getInitials(item).toUpperCase();
            if (init !== null) {
                var c = 'l l', l = init.length;
                for (var i = 0; i < l; i++) {
                    c += parseInt((91 - init.charCodeAt(i)) / 5, 10);
                }
                if (l === 1) {
                    c += '0';
                }
                return c;
            }
            return null;
        }

        function isSelectAll(ids, list) {
            return $ctrl.isAllSelected;
        }

        function hasCastId(list, castId) {
            if (list) {
                var res = _.filter(list, function (val) {
                    return val === castId;
                });

                if (res && res.length > 0) {
                    return true;
                }
            }
            return false;
        }

        function changeCastId(list, castId, event) {
            if (!castId) {
                return;
            }
            var checked = $(event.target).is(":checked");
            if (checked) {
                if (!$ctrl.hasCastId(list, castId)) {
                    if (!list) {
                        list = []
                    }
                    list.push(castId);
                }
            } else {
                if (list) {
                    _.each(list, function (value, index) {
                        if (castId === value) {
                            list.splice(index, 1);
                        }
                    });
                }
            }
        }

        function getAll() {
            //console.log('get all from list.init');
            $ctrl.list.load($ctrl.withProperty(), $ctrl.orders, $ctrl.search);
        }

        function getAllIds(list) {
            if ($ctrl.isAllSelected === false) { //select all
                $ctrl.list.getIds($ctrl.withProperty(), $ctrl.orders, $ctrl.search, function (ids) {
                    _.each(ids, function (castId, index) {
                        if (!$ctrl.hasCastId(list, castId)) {
                            list.push(castId);
                        }
                    });
                    $ctrl.isAllSelected = true;
                });
            } else {  //unselect all
                while (list.length > 0) {
                    list.pop();
                }
                $ctrl.isAllSelected = false;
            }
        }

        function onLoaded(noMoreDataToLoad) {
            if (!noMoreDataToLoad) {
                //console.log('loadmore');
                if ($ctrl.preloadAll) {
                    $ctrl.list.nextPage();
                }
            } else {
                if ($ctrl.onAllLoaded) {
                    $ctrl.onAllLoaded();
                }
                //console.log('all loaded' + getSBTimestamp());
            }
        }
        function getNotification(error, type, isSuccess, params) {
            if (type && $ctrl.objectType) {
                var success = isSuccess ? 'success' : 'error';
                var message = 'crud.' + $ctrl.objectType + '.' + type + '.' + success;
                $ctrl.i18nNotifications.pushForCurrentRoute(error, message, success, params);
            }
        }

        function getFocus() {
            return $ctrl.focusIndex;
        }

        function isSetFocus(index) {
            return $ctrl.focusIndex === index;
        }

        function setFocus(index) {
            $ctrl.focusIndex = index;
        }

        function setEdit(index) {
            $ctrl.editIndex = index;
        }

        function isEdit(index) {
            return $ctrl.editIndex === index;
        }

        function setDelete(index) {
            $ctrl.deleteIndex = index;
        }

        function isDelete(index) {
            return $ctrl.deleteIndex === index;
        }

        function isInFieldFocus(index, field) {
            return $ctrl.focusIndex === index && $ctrl.field === field;
        }

        function setFieldFocus(index, field) {
            if ($ctrl.focusIndex !== index && $ctrl.field !== field) {
                $ctrl.focusIndex = index;
                $ctrl.field = field;
            }
        }

        //todo: used in workflow groups.  onMoveCard . check if still needed
        function processSorting(minIndex, maxIndex) {
            console.log('processSorting');
            for (var i = minIndex; i <= maxIndex; i++) {
                // $ctrl.list.items[i].order = i;
                var el = $ctrl.list.getElementByIndex(i);
                $ctrl.replaceElementProps(el._id, {order: i});
            }
        }

        function isFieldChangeable(changedFields, field) {
            return changedFields.indexOf(field) !== -1;
        }

        function processUpdatesG(result, without) {
            console.log('processUpdatesG');
            if($ctrl.preLoadingService && result && !result.dontProcessG && !$ctrl.dontProcessG){
                $ctrl.preLoadingService.processTablesUpdatesG(result);

                if(!without && typeof($ctrl.afterProcessUpdatesG) === 'function'){
                    $ctrl.afterProcessUpdatesG(result);
                }
                return true;
            }
        }

        function getSortedList(list){
            var orderProp = {};
            orderProp[$ctrl.defaultOrder] = $ctrl.defaultOrderDir;
            //support for sorting by multiple props
            //we assume they re all the same direction
            var props = typeof($ctrl.defaultOrder) === 'string' ? $ctrl.defaultOrder.split(',') : [];
            _.each(props, function (prop) {
                orderProp[prop] = $ctrl.defaultOrderDir;
            });
            return ListSortingService.sortList(list, orderProp);
        }

        function processUpdates(result, withSort, isForAll, listDoesntExist, isChildTable, initResult) {
            console.log('ListInit.processUpdates');
            var updates = result.updates;
            if(result.updateOrder){
                withSort = true;
            }

            var withChanges = false;
            if (updates) {
                withChanges = true;
                var fieldsUpdated = $ctrl.service.getChangedFieldForUpdate();
                if (!fieldsUpdated) {
                    fieldsUpdated = [];
                }
                var props = isForAll ? [].concat(fieldsUpdated).concat($ctrl.service.fieldsUpdatedOnOrderChanged) : $ctrl.service.fieldsUpdatedOnOrderChanged;
                 if($ctrl.withActiveGroup && result && (result.type === ActionTypes.Activate || result.type === ActionTypes.Archive)){
                      if(!_.find(props, function(p){return p === 'active';})){
                          props.push('active');
                      }
                  }

                  var  pl =  props ? props.length : 0,
                    processMore = typeof ($ctrl.processUpdatesMore) === 'function',
                    changes = result.changes ? result.changes[$ctrl.currentListId] : null,
                    changed = {},
                    exists;
                
                if(changes) {
                    var addN = 0, delN = 0,
                        el = changes.add;
                    if (el) {
                        $ctrl.addInitItems([el], listDoesntExist, null);
                        addN = 1;
                        var itemEl = $ctrl.element.querySelector('.flex-wrap [data-id="' + el._id + '"]');
                        if (itemEl && getAttribute(itemEl, 'current-list-id') !== $ctrl.currentListId) {
                            itemEl.setAttribute('current-list-id', $ctrl.currentListId);
                        }

                    } else {
                        var el1 = changes.del;
                        if (el1) {
                            //$ctrl.removeElementInit(el1, ActionTypes.Move, null, listDoesntExist, isChildTable);
                            delN = 1;
                        }
                    }
                    //update tree counters
                    var dif = addN - delN;
                    if (dif !== 0) {
                        console.log('UPDATE_CLIPBOARD_PROCESSING_TREE');
                       //   $ctrl.broadcastRoot('UPDATE_CLIPBOARD_PROCESSING_TREE', {id: $ctrl.currentListId, dif: dif});
                    }
                }

                if (!listDoesntExist) {//update in cache -> for move
                    for (var i = 0, n = $ctrl.list.items.length; i < n; i++) {
                        var el = $ctrl.list.getElementByIndex(i),
                            id = el ? el._id : undefined,
                            itemup = updates[id];
                        if (itemup) {
                            for (var j = 0; j < pl; j++) {
                                var prop = props[j],
                                    val = itemup.hasOwnProperty( prop ) ? itemup[prop] : undefined;
                                if (val !== undefined) {
                                    //$ctrl.list.items[i][prop] = val;
                                    if (!changed[id]) {
                                        changed[id] = {};
                                    }
                                    changed[id][prop] = val;
                                    if (processMore) {
                                        exists = true;
                                    }
                                }
                            }

                            $ctrl.replaceElementProps(id, changed[id], props, null, isChildTable);

                            if (!processMore) {
                                exists = false;
                                delete changed[id];
                            }
                        } else {
                            //console.log('element ' + el._id + ' is not in updates list');
                        }
                    }

                    if (withSort) {
                        $ctrl.list.items = $ctrl.getSortedList($ctrl.list.items);
                    }

                    if (processMore && exists) {
                        $ctrl.processUpdatesMore(changed, result);
                    }
                } else if ($ctrl.preLoadingService) {
                    for (var id in updates) {
                        var ch = updates[id];
                        if (ch) {
                            ch._id = id;
                            $ctrl.processCachedElementInit(ch, $ctrl.preLoadingService.Ops.Edit, props, result.table, isChildTable);
                        }
                    }
                }
            }

           if(processUpdatesG(result)) {
               withChanges = true;
           }

            //todo if list doens't exist for move or duplicate go to the new list so that we can recount
            //reloadItem

            if ((withChanges || $ctrl.dontProcessG) && $ctrl.afterProcessUpdates) {
                $ctrl.LCS.timeout(function () {
                    //console.log('ListInitService.afterProcessUpdates');
                    $ctrl.afterProcessUpdates(result, initResult);
                }, 30);
            }
        }
        function getAttribute(el, attr) {
            var id = el.getAttribute(attr);
            if (id === 'null') {
                id = null;
            }
            if (id === 'undefined') {
                id = undefined;
            }
            if (el.getAttribute('data-isnumber') === 'true') {
                id = parseInt(id, 10);
            }
            return id;
        }
    }
}

angular.module('sort.init.service', [
])
.service('SortInitService', SortInitService);
function SortInitService() {
    return function ($ctrl) {
        $ctrl.DIF = 0;

        if(typeof($ctrl.getOrderListField) !== 'function') {
            $ctrl.getOrderListField = getOrderListField;
        }

        if(typeof ($ctrl.getOnOrderChangedListIds) !== 'function'){
            $ctrl.getOnOrderChangedListIds = getOnOrderChangedListIds;
        }

        if(typeof ($ctrl.getListElemById) !== 'function') {
            $ctrl.getListElemById = getListElemById;
        }

        if(typeof ($ctrl.changeOrderServerSide) !== 'function') {
            $ctrl.changeOrderServerSide = changeOrderServerSide;
        }

        $ctrl.getOrderChangeServerSideUpdates = getOrderChangeServerSideUpdates;

        if($ctrl.orderChangedProp === undefined){
            $ctrl.orderChangedProp = '_id';
        }

        if($ctrl.removeWatcher) {
            $ctrl.removeWatcher($ctrl.listOrderWatcher);
        }

        $ctrl.listOrderWatcher = $ctrl.addRootWatcher('LIST_ORDER_CHANGED_' + $ctrl.elemType + '_' + $ctrl.currentListId, onOrderChanged);

        return $ctrl;

        function getListElemById(id) {
            return $ctrl.list.getElementById(id);
        }

        function getOrderListField(){
            return $ctrl.listField;
        }

        function onOrderChanged(result) {
            console.log('SortInitService.onOrderChanged');
            var listField = $ctrl.getOrderListField(),
                currentListId = result.listId; //$ctrl.currentListId
            console.log('SortInitService.onOrderChanged: ' + currentListId + ' ' + result.step);
            var propForOrder = $ctrl.defaultOrder,
                treeNode = result.step === 1 && result.nextListId === undefined ? result.treeNode : document.querySelector('.tree-node[data-id="' + currentListId + '"]'),
                nodes = treeNode ? treeNode.querySelectorAll('.' + $ctrl.itemSelector) : null,
                item = result.item,
                changed, updates = {}, prop = $ctrl.orderChangedProp;

            if (result.newOrder && $ctrl.isMasonary) {
                nodes = result.newOrder;
                propForOrder = 'order';
            }
            if (nodes && nodes.length > 0) {
                var order = 0;//order starts at 0
                for (var i = 0, n = nodes.length; i < n; i++) {
                    var node = nodes[i],
                        isMoving = $ctrl.LCS.hasClass(node, 'ex-moved') && result.step === 2,
                        id = $ctrl.isMasonary ? nodes[i] : nodes[i].getAttribute('data-id'),
                        elList = $ctrl.getListElemById(id);
                    if (!isMoving) {
                        var val = $ctrl.DIF + order;

                        if (elList) {
                            if (elList[prop] && elList[propForOrder] !== val) {
                                updates[id] = val;
                                changed = true;
                            }
                        } else if (item && item[prop] === id) {
                            item[propForOrder] = val;
                            updates[id] = val;
                            changed = true;
                        }
                        order++;
                    }
                }
            }

            if (result.step === 1) {
                var newResult = {
                    updates: updates,
                    listId: result.nextListId
                };
                newResult = _.extend(newResult, $ctrl.getOnOrderChangedListIds(currentListId));
                if (result.nextListId === undefined) {
                    $ctrl.changeOrderServerSide(newResult, undefined);
                } else {
                    newResult.step = 2;
                    if (item) {
                        if (listField) {
                            item[listField] = currentListId;
                        }
                        newResult.item = item;
                    }

                    $ctrl.broadcastRoot('LIST_ORDER_CHANGED_' + $ctrl.elemType + '_' + result.nextListId, newResult);
                }
            } else {
                var prevListId = result.listIds[listField][0];
                result.listIds[listField].push(currentListId);

                var changes = {},
                    id = item ? item[prop] : null;
                changes[prevListId] = {add: _.extend(angular.copy($ctrl.list.getElementById(id)), item)};
                changes[currentListId] = {del: id};

                newResult = {
                    updates: _.extend(result.updates, updates),
                    listIds: result.listIds,
                    changes: changes,
                    item: result.item
                };

                $ctrl.changeOrderServerSide(newResult, result.listIds[listField]);
            }

            if ($ctrl.keyboardService) {
                $ctrl.broadcastRoot($ctrl.keyboardService.CLEAR_SELECTED);
            }
        }

        function changeOrderServerSide(otherParams, ids, next) {
            console.log('changeOrderServerSide');
            var params = $ctrl.withProperty(), changes;
            if (otherParams) {
                if (otherParams.changes) {
                    changes = _.extend({}, otherParams.changes);
                    delete otherParams.changes;
                }

                params = _.extend(params, otherParams);
            }

            //if there are no changes from one column to another for (item),
            // and no position chnages for the other items (updates)
            if (_.isEmpty(otherParams.updates) && !params.item) {
                return;
            }

            params.dontShowActivity  = true;

            $ctrl.service.updateSelected(params, onSuccess, onError);

            function onSuccess(result) {
                result.updateOrder = true;
                if(next){
                    next(result);
                } else {
                    if (ids && ids.length > 1) {
                        if (changes) {
                            result.changes = changes;
                        }
                        _.each(ids, function (currentListId, i) {
                            if (i !== 0) {
                                result.dontProcessG = true;
                            }
                            $ctrl.broadcastRoot('PROCESS_UPDATES_' + $ctrl.elemType + '_' + currentListId, result);
                        });
                    } else {
                        $ctrl.processUpdates(result, true, false);
                        $ctrl.reloadMasonaryLayout(null, true);
                    }
                }
            }

            function onError (error) {
                console.log(error);
            }
        }

        function getOrderChangeServerSideUpdates() {
            console.log('getOrderChangeServerSideUpdates');
            var updates = {};
            for (var i = 0, n = $ctrl.list.items.length; i < n; i++) {
                var el = $ctrl.list.getElementByIndex(i),
                    val = $ctrl.DIF + i;
                if (el && el._id && el[$ctrl.defaultOrder] !== val) {
                    updates[el._id] = val;
                }
            }
            return updates;
        }

        function getOnOrderChangedListIds(currentListId) {
            var p = {},
                field = $ctrl.getOrderListField();
            if (field) {
                p.listIds = {};
                p.listIds[field] = [currentListId];
            }
            return p;
        }
    }
}


angular.module('page.controller.service.injector', [
])
.service('PageCtrlServiceInjector', PageCtrlServiceInjector);
PageCtrlServiceInjector.$inject = ['$injector'];
function PageCtrlServiceInjector($injector) {
    return function ($ctrl, $element, pageInjectors, printPageParams, otherOptions, predef) {
        $ctrl.pageInjectors = pageInjectors;
        $ctrl.$injector = $injector;

        if(!predef){
            predef = ['constantsService'];
        }

        var setParams = !printPageParams;
        if(setParams) {
            printPageParams = {};
        }

        for(var v in pageInjectors){
            var val = pageInjectors[v];
            if(val){
                var inj = typeof(val) === 'string' ? $ctrl.$injector.get(val) : (val ? val : null);
                if(predef && predef.indexOf(v) === -1){
                    $ctrl[v] = inj;
                } else if(setParams){
                    printPageParams[v] = inj;
                }
            }
        }

        if (setParams && otherOptions) {
            printPageParams.otherOptions = otherOptions;
        }

        //$ctrl.pageCtrlService = $ctrl.$injector.get($ctrl.pageInjectors.pageCtrlService);
        if(!$ctrl.pageCtrlService){
            console.warn('pageCtrlService must be one of the injectors');
        }

        return new $ctrl.pageCtrlService($ctrl, $element, printPageParams);
    }
}

angular.module('page.popup.init.controller.service',[
])
.service('PagePopupInitCtrlService', PagePopupInitCtrlService);
PagePopupInitCtrlService.$inject = ['ItemTemplateCompileCtrlService'];
function PagePopupInitCtrlService(ItemTemplateCompileCtrlService) {
    return function ($ctrl, $element, pageCtrlService, printPageParams) {
        $ctrl.ItemTemplateCompileCtrlService = ItemTemplateCompileCtrlService;

        $ctrl.isPopup = true;
        $ctrl.dontUpdateUrl = true;
        $ctrl.btnCloseId = 'btnClosePagePopup';

        $ctrl.onLoadedOther = onLoadedOther;
        $ctrl.onPageDestroyOther = onPageDestroyOther;
        $ctrl.closeFormTop = closeFormTop;

        $ctrl = new pageCtrlService($ctrl, $element);

        if(!$ctrl.onPageLoaded){
            $ctrl.onPageLoaded = $ctrl.onLoadedOther;
        } else if(!$ctrl.onPageLoadedOther){
            $ctrl.onPageLoadedOther = $ctrl.onLoadedOther;
        }

        if(!$ctrl.onSimplePageDestroy){
            $ctrl.onDestroyOther = $ctrl.onPageDestroyOther;
        }

        return $ctrl;

        function getBtnClose(){
            if(!$ctrl.btnClosePagePopup) {
                $ctrl.btnClosePagePopup = $ctrl.element.querySelector('#'+$ctrl.btnCloseId);
            }
        }

        function onLoadedOther(){
            console.log('onPageLoaded');
            getBtnClose();
            if(!$ctrl.btnClosePagePopup) {
                $ctrl.LCS.insertFragmentBeforeChild($ctrl.element,'<div id="'+$ctrl.btnCloseId+'" class="close-icon hide-ipad"><a class="close close-popup">' + $ctrl.LCS.getISBDiv('cancel', 2, 'gray sbf24') + '</a></div>');

                $ctrl.LCS.timeout(function () {
                    bind(true);
                }, 200);
            }

            $ctrl.LCS.timeout(function (){
                setPopupIndex();
            }, 200);

            if(typeof($ctrl.onLoadedPopup) === 'function'){
                $ctrl.onLoadedPopup();
            }
        }

        function onPageDestroyOther(){
            bind(false);
        }

        function bind(isBind){
            getBtnClose();
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnClosePagePopup, $ctrl.closeFormTop);
        }

        function closeFormTop(e){
            $ctrl.preventDefault(e);

            if($ctrl.closeFormTopOther){
                $ctrl.closeFormTopOther();
            } else{
                $ctrl.onClose();
            }
        }

        function setPopupIndex() {
            if ($ctrl.isPopupSet) {
                return;
            }

            var index = $ctrl.extraParam ? $ctrl.extraParam.popupIndex : null;
            if (!index) {
                return;
            }
            var modal = $ctrl.LCS.findClosestParent($ctrl.element, '.modal');
            if (modal) {
                modal.style.zIndex = index + 1;
            }


            var bg = modal.nextElementSibling;
            while(!bgset(bg)){
                bg = bg.nextElementSibling;
            }

            $ctrl.isPopupSet = true;

            function bgset(bg) {
                if(!bg){return true;}
                if (bg.classList.contains('modal-backdrop')) {
                    bg.style.zIndex = index;
                    return true;
                }
                return false;
            }
        }
    }
}

angular.module('page.simple.controller.service', [
    'templateCompileComp.controller.service',
    'templateCompilePopup.controller.service',
    'item.listTemplate.popup.controller.service',
    'list.base.component.service',
    'services.cheatSheet',
    'ctrl.popups.operations',
    'list.tree.currentList.service',
    'product.print.page.popup.component',
    'product.print.selectlists.popup.component',

    'groupBlock.empty-state.component',
    'product.print.lists.service'
])
.service('PageSimpleInitCtrlService', PageSimpleInitCtrlService);
PageSimpleInitCtrlService.$inject = ['SelectPrintListsService', 'CheatSheetService', 'CompInitCtrlService', 'PreLoadingProv', 'TemplateCompileService', 'PopupsOperations', 'CurrentTreeListService', 'RouteCollaboratorsService'];
function PageSimpleInitCtrlService(SelectPrintListsService, CheatSheetService, CompInitCtrlService, PreLoadingProv, TemplateCompileService, PopupsOperations, CurrentTreeListService, RouteCollaboratorsService) {
    return function ($ctrl, $element, initOptions) {
        $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
        $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;

        $ctrl.PreLoadingProv = PreLoadingProv;
        $ctrl.CheatSheetService = CheatSheetService;
        $ctrl.CurrentTreeListService = CurrentTreeListService;
        $ctrl.PopupsOperations = PopupsOperations;
        $ctrl.TemplateCompileService = TemplateCompileService;
        $ctrl.CompInitCtrlService = CompInitCtrlService;

        if(!$ctrl.serviceName) {
            $ctrl.serviceName = 'PageSimpleInitCtrlService';
        }
        console.log($ctrl.serviceName);

        var options = _.clone(initOptions);

        if (!$ctrl.$onDestroy) {
            $ctrl.$onDestroy = onSimplePageDestroy;
        }

        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl);
        }

        var otherOptions = options.otherOptions || {};
        var compOptions = _.extend({}, options.constantsService ? options.constantsService.CompOptions : null, otherOptions.compOptions);
        $ctrl = _.extend($ctrl, compOptions);
        $ctrl.compOptions = JSON.stringify(compOptions);

        if (!$ctrl.onTemplateLoaded) {
            console.log('define $ctrl.onTemplateLoaded in parent for PageSimpleInitCtrlService');
        }

        $ctrl.PreloadingTypes = $ctrl.PreLoadingProv.PreloadingTypes;
        $ctrl.getPreloadingInstance = $ctrl.PreLoadingProv.getInstance;

        if (!options) {
            console.warn('define options in parent for PageSimpleInitCtrlService');
        }else {

            if (options.constantsService && options.constantsService.PopupOperations) {
                $ctrl.popupOperations = options.constantsService.PopupOperations;
            }

            if ($ctrl.popupOperations) {
                $ctrl.PopupsOperations.addList($ctrl.popupOperations);
            }

            if (options.constantsService && options.constantsService.Hotkeys) {
                $ctrl.hotkeys = options.constantsService.Hotkeys;
            }
        }

        //$ctrl.CurrentTreeListService.clear($ctrl.elemType);

        $ctrl.$element = $element;
        $ctrl.element = $ctrl.$element[0];

        if (!$ctrl.$templateElement) {
            $ctrl.$templateElement = $ctrl.$element;
        }

        $ctrl.allInfoLoaded = false;

        if (!$ctrl.getPageTemplate) {
            console.warn('define getPageTemplate in parent for PageSimpleInitCtrlService');
        }

        $ctrl.reloadPageTemplate = reloadPageTemplate;

        $ctrl.getPreloadingService = getPreloadingService;
        $ctrl.onSimplePageInit = onSimplePageInit;
        $ctrl.onSimplePageDestroy = onSimplePageDestroy;

        $ctrl.getSidebarToggle = getSidebarToggle;

        if (!$ctrl.getTopFiltersTitle) {
            $ctrl.getTopFiltersTitle = getTopFiltersTitle;
        }
        if (!$ctrl.getTopFilters) {
            $ctrl.getTopFilters = getTopFilters;
        }
        if(!$ctrl.getInitTopFilters) {
            $ctrl.getInitTopFilters = getInitTopFilters;
        }
        if (!$ctrl.getEmptyState) {
            $ctrl.getEmptyState = getEmptyState;
        }
        $ctrl.getEmptyStateInit = getEmptyState;

        if(!$ctrl.createFromTop && $ctrl.canEdit){
            $ctrl.createFromTop = createFromTop;
        }
        if(!$ctrl.openComments) {
            $ctrl.openComments = openComments;
        }

        if (!$ctrl.getListNavCollabs) {
            $ctrl.getListNavCollabs = getListNavCollabs;
        }
        if (!$ctrl.getListNavShare) {
            $ctrl.getListNavShare = getListNavShare;
        }

        if (!$ctrl.getListNavComments) {
            $ctrl.getListNavComments = getListNavComments;
        }

        if(!$ctrl.getCurrentList) {
            $ctrl.getCurrentList = getCurrentList;
        }

        if(!$ctrl.isSimpleCurrentList) {
            $ctrl.isSimpleCurrentList = isSimpleCurrentList;
        }

        $ctrl.getDrpZoomFilters = getDrpZoomFilters;

        if (!$ctrl.isNotEmptyGroupState) {
            $ctrl.isNotEmptyGroupState = isNotEmptyGroupState;
        }
        $ctrl.setCompOptions = setCompOptions;

        if(!$ctrl.share) {
            $ctrl.share = share;
        }

        if(!$ctrl.onAddItemBtn){
            $ctrl.onAddItemBtn = onAddItemBtn;
        }

        if(!$ctrl.isActiveGroup) {
            $ctrl.isActiveGroup = isActiveGroup;
        }

        if(!$ctrl.isActiveFilter){
            $ctrl.isActiveFilter = isActiveFilter;
        }

        if(!$ctrl.showTopFilters) {
            $ctrl.showTopFilters = showTopFilters;
        }
        $ctrl.isActiveTree = isActiveTree;
        $ctrl.getEmptyTitleName = getEmptyTitleName;
        $ctrl.generateCustomReport = generateCustomReport;
        $ctrl.generatePDF = generatePDF;
        $ctrl.generatePrint = generatePrint;

        $ctrl.getParamsInit = getParams;

        if(!$ctrl.getTopFiltersTitleInit){
            $ctrl.getTopFiltersTitleInit = getTopFiltersTitle;
        }
        if(!$ctrl.bindActions) {
            $ctrl.bindActions = bindActions;
        }

        if(!$ctrl.onAction) {
            $ctrl.onAction = onAction;
        }

        if(!$ctrl.getBtnActionCls) {
            $ctrl.getBtnActionCls = getBtnActionCls;
        }
        if(!$ctrl.sharePage) {
            $ctrl.sharePage = sharePage;
        }

        if(!$ctrl.toggleInnerSidebar){
            $ctrl.toggleInnerSidebar = toggleInnerSidebar;
        }
        if(!$ctrl.hasInnerSidebar){
            $ctrl.hasInnerSidebar = hasInnerSidebar;
        }

        if(!$ctrl.displaySidebar) {
            $ctrl.displaySidebar = displaySidebar;
        }

        if(!$ctrl.isWithSidebar) {
            $ctrl.isWithSidebar = isWithSidebar;
        }

        if(!$ctrl.getSidebarName) {
            $ctrl.getSidebarName = getSidebarName;
        }

        if(!$ctrl.showLeftSidebar) {
            $ctrl.showLeftSidebar = showLeftSidebar;
        }
        if(!$ctrl.showIntro && !$ctrl.isInsideOtherPage){
            $ctrl.showIntro = showIntro;
        }
        $ctrl.getPdfReports = getPdfReports;
        $ctrl.getDrpSettingsItem = getDrpSettingsItem;
        $ctrl.getWithBorderTop = getWithBorderTop;
        $ctrl.emitUpdateCheatsheet = emitUpdateCheatsheet;

        return $ctrl;

        function getWithBorderTop(withBorderTop){
            return withBorderTop ? 'class="with-top-border without-padding "' : '';
        }

        function getDrpSettingsItem(item, isExposed, hidden, cls1) {
            if (item.hide) {
                return '';
            }
            var cls = 'drp-settings-item ' + (cls1 || ''),
                i = $ctrl.LCS.getISBDiv(item.icon, item.iconLevel ? item.iconLevel : 2),
                s = (item.active ? (' ng-show="$ctrl.isActiveFilter()"') : ''),
                c = item.cond ? ('ng-show="' + item.cond + '"') : '',
                m = 'data-type="' + item.type + '" ' +
                    (item.data !== undefined ? ('data-info="' + item.data + '" ') : '') +
                    (item.callDirectly ? ('data-call="true" ') : '') +
                    'analytics-on analytics-action="' + item.name + '" ',
                isGenPDF = item.type === 'generatePDF';
            return isExposed ? (
                '<a ' + getC((hidden ? 'sb-hide ' : '') +
                    'hide-ipad btn btn-small primary-faded with-margin-left inline-block without-text ' + (isGenPDF?'pull-right':'pull-left')) + ' tooltip="' + item.name + '" tooltip-placement="bottom">' +
                i + //'<span class="hide-lower1024">' + item.name + '</span>' +
                '</a>'
            ) : ('<li ' + (isGenPDF ? 'id="drpGenerateReports" ' : '') +
                ((item.isMobileOnly || isExposed) ?( 'class="'+ (hidden ? 'sb-hide ' : '') + 'hide-desktop hide-print' + (isGenPDF ?' hide-ipad' : '' ) + '"') : '') +
                getWithBorderTop(item.withBorderTop) + s + '>' +
                '<a ' + getC('fixed-layout table-div') + '>' +
                '<div class="col30 with-margin-right">' + i + '</div>' +
                '<div><div class="with-ellipsis">' + item.name + '</div></div>' +
                //      '<!--<div class="checkmark centered"><span class="sbf check-mark primary" ng-if="$ctrl.isColumn(item.id)"></span></div>-->' +
                '</a>' +
                '</li>');

            function getC(cls1) {
                return c + ' class="' + cls + ' ' + cls1 + '" ' + m;
            }
        }

        function getPdfReports(withBorderTop, other, isExposed, cls) {
            var showPDF = $ctrl.withCustomReports;
            //&& ($ctrl.LCS.API_CONFIGS.debugger && $ctrl.LCS.API_CONFIGS.debugger.enabled);
            if(showPDF) {
                return getDrpSettingsItem(_.extend({
                    name: 'Generate PDF',
                    type: 'generatePDF',
                    icon: 'download-pdf',
                    iconLevel: 5,
                    callDirectly: true,
                    active: true,
                    withBorderTop: withBorderTop
                }, other), isExposed, false, cls);
            }
            return '';
        }

        function getBtnActionCls(){
            return 'btnAction' + $ctrl.compInitId;
        }

        function bindActions(isBind) {
            if (isBind) {
                process(false);
            }
            process(isBind);

            function process(isBind) {
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('.' + $ctrl.getBtnActionCls()), $ctrl.onAction);
            }
        }

        function onAction(e){
            $ctrl.preventDefault(e);
            //console.log('onAction');
            var el = e.currentTarget,
                type = el.getAttribute('data-type'),
                data = el.getAttribute('data-info');
            if(type && typeof($ctrl[type]) === 'function') {
                $ctrl[type](data, e);
            } else {
                console.warn('PageSimpleInitCtrlService: method ' + type + ' is not defined');
            }
        }

        function generatePDF(id, e){
            $ctrl.preventDefault(e);
            //$ctrl.CPS.loadQuotaPopup('reports', function () {
            $ctrl.generateCustomReport(e, true);
            //});
        }

        function generatePrint(e){
            $ctrl.preventDefault(e);
            //$ctrl.CPS.loadQuotaPopup('reports', function () {
            $ctrl.generateCustomReport(e, false);
            //});
        }

        function generateCustomReport(e, isDownloadPDF){
            $ctrl.preventDefault(e);

            var printParams = getPrintParams(),
                selectPrintListsService = new SelectPrintListsService(printParams, {
                    withActiveGroup: $ctrl.withActiveGroup,
                    withActiveTree: $ctrl.withActiveTree,
                    icon: $ctrl.icon,
                    iconLevel: $ctrl.iconLevel,
                    radioCheckedCls: $ctrl.radioCheckedCls
                });

            var result = selectPrintListsService.getResultWithoutInterface(null);

            if($ctrl.customReportsParams.step1 !== 'custom') {
                if (result.noItems || result.lists && !result.lists.length) {
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.printPDF.noItems', 'error');
                    return;
                }

                if (selectPrintListsService.isGroupOnly && (!result.lists || result.lists && !result.lists.length)) {
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.printPDF.listsNoItems', 'error');
                    return;
                }

                if(result.isItemsOnly && result.items && result.items.null && result.items.null.length === 1 ||
                    !result.isItemsOnly && result.lists.length === 1){
                    onConfirm(result);
                } else {
                    if (isDownloadPDF) {
                        openSelect();
                    } else {
                        onConfirm(result);
                    }
                }
            } else{
                onConfirm(result);
            }

            function openSelect() {
                $ctrl.popupsService.open(null, $ctrl.popupsService.operations.selectPrintLists, _.extend({}, printParams, {selectPrintListsService:selectPrintListsService}), $ctrl.compOptions, null, onConfirm);
            }

            function getPrintParams(onConfirm){
                var params = {
                    action: 'select',
                    //listTreeService: $ctrl.listTreeService
                };

                if (!params.icon) {
                    params.icon = $ctrl.objectType;
                }

                if($ctrl.listTreeService) {
                    params.listTreeService = $ctrl.listTreeService;
                }
                params.treeType = $ctrl.treeType;
                params.listsInfo = _.extend(getListsInfo(), $ctrl.getPrintListsInfo ? $ctrl.getPrintListsInfo() : null);

                if(typeof(onConfirm) === 'function') {
                    params.onConfirm = onConfirm;
                }

                return params;

                function getListsInfo() {
                    var listsInfo = {};

                    setStep('step1');
                    setStep('step2');

                    return listsInfo;

                    function setStep(step) {
                        var s = $ctrl.customReportsParams[step];
                        if (s) {
                            listsInfo[step] = getStep(s);
                        }

                        function getStep(type) {
                            var info;
                            switch (type) {
                                case 'group': //load the tree ???
                                    info = {
                                        popupTitle: 'Select ' + $ctrl.nameForList + 's for Report',
                                        itemTitle: $ctrl.nameForList,
                                        emptyItemTitle: $ctrl.nameForList,
                                        itemIcon: $ctrl.itemIcon,
                                        iconLevel: $ctrl.iconLevel,
                                        listTreeService: $ctrl.listTreeService,
                                        maxLevel: $ctrl.maxLevel,
                                        multipleSelection: $ctrl.customReportsParams.multipleSelection
                                    };
                                    if (!$ctrl.customReportsParams.multipleSelection) {
                                        info.selectedListId = $ctrl.getCurrentList()._id
                                    }
                                    break;

                                case 'item':
                                case 'group-item':
                                    info = {
                                        popupTitle: 'Select ' + $ctrl.itemTitle + 's for Report',
                                        itemTitle: $ctrl.itemTitle,
                                        emptyItemTitle: $ctrl.itemTitle,
                                        icon: $ctrl.itemIcon,
                                        iconLevel: $ctrl.iconLevel,
                                        multipleSelection: true
                                    };
                                    break;


                                case 'custom': //load the tree ???
                                    info = {};
                                    break;
                            }
                            info.type = type;
                            return info;
                        }
                    }
                }
            }

            function onConfirm(result) {
                if(!result){return;}
                console.log('openReports:');
                 var pageOptions = $ctrl.filtersService ? _.extend({}, $ctrl.filtersService.Options, $ctrl.filtersService.options) : null;
                 //shows error for 1 column
                /* if(pageOptions.printColumnsPerPage){
                    pageOptions.column = pageOptions.printColumnsPerPage;
                    pageOptions.view = 3;
                }*/
                $ctrl.popupsService.open(null,
                    $ctrl.popupsService.operations.printPage, {
                        printPageParams: _.extend({
                            pageOptions:  pageOptions,
                            isDownloadPDF: isDownloadPDF,
                            isPageTree: $ctrl.isPageTree,
                            pageCtrlService: $ctrl.pageCtrlService
                        }, _.extend({}, initOptions)),
                        selectedParams: result
                    },
                    null,//$ctrl.compOptions,
                    null, function (result) { //use compOptions from the constantsService
                        // $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.callsheetInvitations.Add Recipients.success', 'success', {name: 'this'});
                    });
            }
        }

        function getInitTopFilters() {
            return $ctrl.withoutTopFilters ? '' :
                ('<nav class="filters on-top hide-print" ng-show="$ctrl.showTopFilters()">' +
                    $ctrl.getSidebarToggle() +
                    $ctrl.getTopFilters() +
                '</nav>');
        }

        function showTopFilters(){
            return typeof($ctrl.hasLists) === 'function' ? $ctrl.hasLists() : true;
            //$ctrl.withArchiveGroupAsList ? $ctrl.hasLists() : true;
        }

        function getTopFiltersTitle(isList) {
            var isTitle = !($ctrl.CPS.isAuthenticated && isList);
            if($ctrl.RouteCollaboratorsService.collabRootId && $ctrl.CPS.isCollaborator){
                isTitle = false;
                isList = true;
            }
            var t = '(' + isTitle + '?$ctrl.title:$ctrl.listTreeService.active.selectedList.name).length>20?(' + isTitle + '?$ctrl.title:$ctrl.listTreeService.active.selectedList.name):\'\'';
            return '<div class="filter-title pull-left noline table-div h-full filter ' + (isList ? 'hide-lower1024' : 'title with-margin-right') + '">' +
                        '<div class="table-cell centered">' +
                            '<div class="with-ellipsis" tooltip-html="\'{{' + t + '}}\'" tooltip-placement="bottom">' +
                                (isList ? '<span class="' + (isTitle ? 'left-separator ' : '') + 'text-info-count">' : '') +
                                    (isTitle ? $ctrl.title : '{{$ctrl.listTreeService.active.selectedList.name}}') +
                                (isList ? '</span>' : '') +
                            '</div>' +
                        '</div>' +
                    '</div>';
        }

        function getTopFilters() {
            return (typeof($ctrl.getTopFiltersBeforeTitle) === 'function' ? $ctrl.getTopFiltersBeforeTitle() : '') +
            $ctrl.getTopFiltersTitle() +
                (typeof($ctrl.getTopFiltersTitleOther) === 'function' ? $ctrl.getTopFiltersTitleOther() : '') +
                   '<div class="pull-right filter-title-right">' + ($ctrl.getLeftButtons ? $ctrl.getLeftButtons() : '') + '</div>';
        }

        function showLeftSidebar() {
            if ($ctrl.isCommentsSidebar || $ctrl.hideSidebar || $ctrl.isTaskBoards
        //        $ctrl.element.tagName === 'TASK-BOARD'
        ) {
                return;
            }
            p('btnSidebarToggle', $ctrl.isWithSidebar());
            p('side-nav', $ctrl.displaySidebar());

            function p(selector, show) {
                var el = $ctrl.LCS.bodyElement.querySelector('.' + selector);
                if (el) {
                    $ctrl.LCS[show ? 'removeClass' : 'addClass'](el, 'sb-hide');
                }
            }
        }

        function getSidebarToggle() {
            return '<a class="btnSidebarToggle btn btn-small primary-faded without-text pull-left with-margin-right ' +
                ($ctrl.hideSidebarToggleOnDesktop ? 'hide-desktop hide-print ' : '') +
                ($ctrl.withoutTopFilters ? 'fixed ' : '') +
                $ctrl.getBtnActionCls() + '" ' +
                'ng-class="{\'sb-hide\':!$ctrl.isWithSidebar()}" ' +
                'data-type="toggleInnerSidebar" tooltip="Toggle Sidebar" tooltip-placement="bottom">' +
                $ctrl.LCS.getISBDiv('sidebar-filled', 2) + '</a>';
        }

        function toggleInnerSidebar() {
            console.log('toggleInnerSidebar ' + $ctrl.getSidebarName());
            $ctrl.LCS.toggleInnerSidebar($ctrl.getSidebarName());
            $ctrl.showLeftSidebar();
        }

        function hasInnerSidebar(){
            return $ctrl.LCS.hasInnerSidebar($ctrl.getSidebarName());
        }

        function isWithSidebar() {
            return !$ctrl.hideSidebar;
        }

        function displaySidebar(){
            return $ctrl.isWithSidebar() && $ctrl.hasInnerSidebar();
        }

        function getSidebarName(){
            return $ctrl.SBStateService.currentState.name + ($ctrl.isCommentsSidebar ? '_COMMENTS' : '') + ($ctrl.isInTreeModal ? ('_' + $ctrl.isInTreeModal) : '') + ($ctrl.getSidebarNameOther ? ('_' + $ctrl.getSidebarNameOther()) : '');
        }

        function isArchiveAsList(){
            return $ctrl.listTreeService &&
                $ctrl.listTreeService.isArchiveAsList();
        }

        function isActiveFilter() {
            var withActive = $ctrl.withActiveGroup || $ctrl.withActiveTree;
            return !withActive || $ctrl.withActiveGroup && !isArchiveAsList() && $ctrl.filtersService.selectedFilter
        || $ctrl.withActiveTree && $ctrl.filtersService.selectedFilter;
        }

        function isActiveTree(){
            return !$ctrl.withActiveTree || $ctrl.withActiveTree && $ctrl.filtersService.selectedFilter;
        }

        function isActiveGroup(){
            return isActive($ctrl.filtersService.selectedFilter) && !isArchiveAsList();
        }

        function isActive(active){
            return $ctrl.withActiveGroup && active || !$ctrl.withActiveGroup;
        }

        function setCompOptions(otherOptions) {
            var compOptions = _.extend({}, JSON.parse($ctrl.compOptions), otherOptions);
            $ctrl = _.extend($ctrl, otherOptions);
            $ctrl.compOptions = JSON.stringify(compOptions);
        }
        function isNotEmptyGroupState() {
           // console.error('isNotEmptyGroupState: overwrite in parent ')
            return true;
        }

        function getDrpZoomFilters() {
            return '<group-zoom-filters ' +
                'class="group-zoom-filters padding-left20 clearfix display-block with-margin-left position-relative hide-ipad" ' +
                'ng-show="$ctrl.isNotEmptyGroupState()" ' +
                'filters-service="::$ctrl.filtersService" ' +
                'elem-type="' + $ctrl.elemType + '" '+
($ctrl.currentZoomedTable ? ('current-zoomed-table="'+$ctrl.currentZoomedTable+'"') : '') +
                '></group-zoom-filters>';
        }

        function createFromTop(type, e) {
            console.log('createFromTop');
            $ctrl.broadcastRoot('ADD_FROM_PAGE_TOP_' + $ctrl.elemType, {type: typeof(type) === 'string' ? parseInt(type) : type, e: e});
        }

        function setCollabPageBanner() {
            $ctrl.CPS.withBanner = $ctrl.CPS.setPageBanner($ctrl.CPS.withBanner, $ctrl.showBannerProp, $ctrl.bannerFeatureProp);
            if ($ctrl.CPS.isCollaborator && $ctrl.CPS.withBanner && !$ctrl.isPrintLayout && !$ctrl.isCommentsSidebar
                && $ctrl.LCS.collabBannerOnTop && $ctrl.getCollabBannerInfo) {
                    setCollabPageBanner($ctrl.getCollabBannerInfo());
                    $ctrl.LCS.bodyElement.setAttribute('with-collab-banner', true);
            } else {
                $ctrl.LCS.bodyElement.removeAttribute('with-collab-banner');
            }

            function setCollabPageBanner(info) {
                var banner = $ctrl.LCS.getCollabNavBanner();
                if (banner) {
                    var el = banner.querySelector('.text');
                    if(el){
                        el.innerText = info.txt ? info.txt : ('Create your own ' + info.name + ' now.');
                    }
                    el = banner.querySelector('a');
                    if(el) {
                        el.href = $ctrl.CPS.websiteUrl + '/register?utm_campaign=' + (info.campaign ? info.campaign : info.name);
                    }
                }
            }
        }

        function onSimplePageInit(opts, next) {
            console.log('onSimplePageInit');
            setCollabPageBanner();
            if (!$ctrl.getParams) {
                $ctrl.getParams = opts.isScript ? getScriptParams : getParams;
            }

            if(!$ctrl.isCommentsSidebar) {
                if ($ctrl.withActiveGroup || $ctrl.withActiveTree) {
                    var defaultSelectedFilter = $ctrl.defaultSelectedFilter || true,
                        filter = $ctrl.CPS.getSearchFilter('active'),
                        active = $ctrl.CPS.stateParams && $ctrl.CPS.stateParams.active !== undefined ? $ctrl.CPS.stateParams.active : (filter !== undefined ? filter :
                            (options.constantsService.Filters && options.constantsService.Filters.length > 0 ? options.constantsService.Filters[0] : defaultSelectedFilter));
                    $ctrl.selectedFilter = (active === 0 || active === '0' || active === 'false' || active === false) ? false : defaultSelectedFilter;
                    if ($ctrl.filtersService) {
                        $ctrl.filtersService.selectedFilter = $ctrl.selectedFilter;
                    }
                }
            }

            $ctrl.pageCompile = new TemplateCompileService($ctrl.$templateElement, getSimplePageTemplate, $ctrl);

            //load the preloader
            $ctrl.isFirstReload = true;
            console.log('reloadPageTemplate first');
            $ctrl.reloadPageTemplate(true, onReloaded);

            function onReloaded(){
                console.log('onReloaded');
                if($ctrl.isFirstReload){
                    if(!$ctrl.postponeLoadCheatSheet) {
                        $ctrl.emitUpdateCheatsheet();
                    }
                    $ctrl.isFirstReload = false;

                    if(!$ctrl.isCommentsSidebar && !$ctrl.hideSidebar) {
                        if ($ctrl.toggleWatcher) {
                            $ctrl.removeWatcher($ctrl.toggleWatcher);
                        }
                        console.log('add toggleWatcher');
                        $ctrl.toggleWatcher = $ctrl.LCS.onToggleInnerSidebar($ctrl.getSidebarName(), onToggleInnerSidebar);

                        if ($ctrl.toggleWatcher1) {
                            $ctrl.removeWatcher($ctrl.toggleWatcher1);
                        }
                        $ctrl.toggleWatcher1 = $ctrl.addRootWatcher('CLOSE_SIDEBAR_'+$ctrl.getSidebarName(), closeSidebar);
                    }
                }
                console.log('reloadPageTemplate first');
                if(typeof($ctrl.onTemplateLoaded) === 'function'){
                    $ctrl.onTemplateLoaded();
                }

                if( $ctrl.preLoadingService && $ctrl.preLoadingService.preloadedAbove) {
                    next($ctrl.preLoadingService);
                } else {
                    $ctrl.getPreloadingService(opts, next);
                }

                if(!$ctrl.isCommentsSidebar) {
                    $ctrl.addRootWatcher('SHARE_LIST_FROM_COMMENTS', function (info) {
                        var el = $ctrl.RouteCollaboratorsService.getShareListInfo(info.uId, $ctrl.compOptions);
                        $ctrl.RouteCollaboratorsService.share(info.uId, el ? el.shareList : null, $ctrl.compOptions);
                    });
                }
            }
            //not necessary cause comments load on every page
        }

        function closeSidebar(){
            if($ctrl.hasInnerSidebar()){
                $ctrl.toggleInnerSidebar();
            }
        }

        function onToggleInnerSidebar(show) {
            //console.log('onToggleInnerSidebar ' + $ctrl.getSidebarName());
            var sidebar = $ctrl.LCS.bodyElement.querySelector('.side-nav');
            $ctrl.LCS[show ? 'removeClass' : 'addClass'](sidebar, 'sb-hide');
        }

        function getPreloadingService(opts, next) {
            //{withPreloaderProperty, additionalScriptInit, isScript, preloadingType, loadingParams},
            if (!opts) {
                return next();
            }
            if (opts.isScript) {//wait for the scripts tables to be loaded on the ProductScriptUpdateInitCtrlService
                initFromScriptProv();
                $ctrl.addRootWatcher('SCRIPT_LOADING_PROV', initFromScriptProv);

                function initFromScriptProv(scriptUpdated) {
                    console.log('initFromScriptProv');
                    if (scriptUpdated) {
                        $ctrl.allInfoLoaded = false;
                    }
                    if ($ctrl.CurrentProduct.scriptLoadingService) {
                        console.log('on SCRIPT_LOADING_PROV ' + getSBTimestamp());

                        $ctrl.scriptLoadingService = $ctrl.CurrentProduct.scriptLoadingService;

                        if (!opts.additionalScriptInit || !opts.additionalScriptInit()) {
                            return onsuccess();
                        }

                        $ctrl.reloadPageTemplate(false, onsuccess);

                        function onsuccess() {
                            console.log('page loaded');
                            if (typeof (next) === 'function') {
                                var resetPreloaderRun = true;
                                next($ctrl.scriptLoadingService, resetPreloaderRun);
                            }
                        }
                    }
                }
            } else if (opts.preloadingType) {
                console.log('getPreloadingService ' + opts.preloadingType);
                if (!opts.withPreloaderProperty) {
                    opts.withPreloaderProperty = $ctrl.getParams;
                }
                var service = $ctrl.getPreloadingInstance(opts.withPreloaderProperty(), opts.preloadingType, opts.listFieldForTables);
                service.load(function () {
                    next(service);
                }, opts.loadingParams);
            } else {
                next();
            }
        }

        function reloadPageTemplate(first, next) {
            console.log('reloadPageTemplate - first: ' + first +'; allInfoLoaded: ' + $ctrl.allInfoLoaded + getSBTimestamp());
            if (!first) {
                $ctrl.allInfoLoaded = true;
            }
            $ctrl.bindActions(false);
            $ctrl.pageCompile.loadTemplate(onLoaded);

            function onLoaded(el) {
                if (typeof (next) === 'function') {
                    next(el);
                }

                if($ctrl.allInfoLoaded){
                    $ctrl.showLeftSidebar();

                    if($ctrl.timeoutP) {
                        $ctrl.LCS.cancelTimeout($ctrl.timeoutP);
                    }

                    $ctrl.timeoutP = $ctrl.LCS.timeout(function () {
                        $ctrl.bindActions(true);
                    }, 200);

                    if($ctrl.listTreeService && !$ctrl.isCommentsSidebar) {
                        $ctrl.CurrentTreeListService.CommentsSidebarService.nonSidebarPreLoadingService = $ctrl.listTreeService.preLoadingService;
                    }
                }
            }
        }

        function showIntro(){
            return true;
        }

        function emitUpdateCheatsheet() {
            if(!$ctrl.isCommentsSidebar && !$ctrl.isPrintLayout && (!$ctrl.isInsideOtherPage||$ctrl.postponeLoadCheatSheet)) {
                console.log('emitUpdateCheatsheet');
                var p = {overviewBlockType: $ctrl.overviewBlockType};
                if ($ctrl.canEdit && $ctrl.hotkeys) {
                    p.hotkeys = $ctrl.hotkeys;
                }
                if (typeof ($ctrl.showIntro) === 'function') {
                    p.showIntro = $ctrl.showIntro;
                }
                if ($ctrl.withoutCheatSheet) {
                    p.withoutCheatSheet = true;
                }
                p.stateName = $ctrl.SBStateService.getCurrentStateName();

                $ctrl.CheatSheetService.emitUpdateCheatsheet(p);

                if($ctrl.showIntro && $ctrl.showIntro()) {
                    $ctrl.removeWatcher($ctrl.cheatSheetWatcher);
                    $ctrl.cheatSheetWatcher = $ctrl.RootEventsService.addRootWatcherSimple($ctrl.watchers, $ctrl.CheatSheetService.onStartIntro(startIntro));
                }
            }

            function startIntro(forceShow) {
                console.log('startIntro');
                $ctrl.CheatSheetService.startIntro(
                    $ctrl.SessionService.getSetting('isAuthenticated'),
                    $ctrl.SessionService.getSetting('isCollaborator'),
                    $ctrl.SessionService.getSetting('canEdit'),
                    $ctrl.SessionService.getSetting('canComment'),
                    true, forceShow);
            }
        }

        function getSimplePageTemplate() {
            console.log('set getSimplePageTemplate: allInfoLoaded' + $ctrl.allInfoLoaded);
            return $ctrl.allInfoLoaded ?
                $ctrl.getPageTemplate() :
                ('<div class="preloader ' + ($ctrl.pageClass || '') + '">' +
                    '<div class="h-full table-div centered-preloader full-width display-block full-width clearfix"><div class="centered"><div><div class="loadFacebookWrapper"><div class="sbLdsEllipsis"><div class="lds-ellipsis"><div></div><div></div><div></div><div></div></div></div></div></div></div></div>' +
                    '</div>'
                );
                //('<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>');
        }

        function onSimplePageDestroy() {
            console.log('PageSimpleInitCtrlService.onSimplePageDestroy');
            $ctrl.bindActions(false);

            if (typeof ($ctrl.pageCompile) === 'function') {
                $ctrl.pageCompile.destroyNewScope();
            }
            $ctrl.removeWatchers();
            $ctrl.CurrentTreeListService.nonSidebarPreLoadingService = null;
            $ctrl.CurrentTreeListService.clear($ctrl.elemType);

            if(typeof($ctrl.onPageDestroyOther) === 'function') {
                $ctrl.onPageDestroyOther();
            }
        }

        function getParams() {
            return {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId || null
            };
        }

        function getScriptParams() {
            return _.extend({scriptId: $ctrl.CPS.scriptId}, getParams());
        }

        function getEmptyTitleName(){
            return (!$ctrl.isActiveTree() ? $ctrl.nameForList : (!$ctrl.isActiveGroup() ? $ctrl.getGroupName() : $ctrl.itemTitle)) +'s';
        }

        function getEmptyState(checkActive) {
            var canEdit = ($ctrl.canEdit && (checkActive ? ($ctrl.selectedFilter !== false) : true))
            return '<empty-state class="empty-state-component full-width" ' +
                ($ctrl.quotaType && !$ctrl.CPS.hasQuotaType($ctrl.quotaType) ? ('is-pro="true"') : '') +
                'tree-type="' + ($ctrl.withTreeTypes ? '' : '::') + '$ctrl.treeType"  ' +
                'comp-options="::$ctrl.compOptions" ' +
               // 'item-title="' + $ctrl.itemTitle + '" ' +
               // 'page-class="' + $ctrl.pageClass + '" ' +
                'can-edit="::' + canEdit + '" ' +
                'with-buttons="$ctrl.isActiveFilter()" ' +
                'name="$ctrl.getEmptyTitleName()" ' +
                'custom-title="$ctrl.emptyStateTitle" ' +
                'custom-desc="$ctrl.emptyStateDesc" '  +
                'create-from-top="$ctrl.createFromTop()" ' +
                'add-first-list="$ctrl.addFirstList()" ' +
                'add-list-or-script="$ctrl.addListOrScript()" ' +
                'is-custom-list="$ctrl.isCustomList()" ' +
                ($ctrl.listTreeService && $ctrl.listTreeService.addListOnEmptyState && $ctrl.listTreeService && $ctrl.listTreeService.maxLevel > 0 ?
                    'add-list-on-empty-state="true" on-add-item-btn="$ctrl.onAddItemBtn(e)" ' : '') +
                //additem method like for breakdowns
                ($ctrl.getEmptyStateButtons ? 'get-buttons="$ctrl.getEmptyStateButtons(' + checkActive + ')" ' : '') +
                '></empty-state>';
        }

        function onAddItemBtn(e) {
            console.log('onAddItemBtn');
            $ctrl.preventDefault(e);
            return $ctrl.addItem($ctrl.treeType, {item: {type: $ctrl.treeType}, addFolder: false, isParent: true, useSelected: false, e:e});
        }


        function getCurrentList(){
            return $ctrl.listTreeService.active ? $ctrl.listTreeService.active.selectedList : null;
        }

        function isSimpleCurrentList(){
            var l = getCurrentList();
            return l && !l.isFolder;
        }

        function getListNavCollabs(cond) {
            if(!$ctrl.showCollabsInListNav || !$ctrl.CPS.isAuthenticated || !$ctrl.CPS.productId){return '';}
        return '<div class="display-block pull-right collaborators-wrap" ng-if="' +
           (cond ? cond : '$ctrl.isActiveGroup()&& $ctrl.getCurrentList()._id!==\'All\'') +
            '">' +
                    '<sb-assign-collaborators class="hide-ipad clearfix collaborators-faces without-underline without-arrow" circle-size="smaller" max-count="2" parent-container="true" without-close="true" can-edit="$ctrl.canEdit" todo-page-id="$ctrl.RouteCollaboratorsService.todoPage._id" u-id="$ctrl.getCurrentList()._id" list="$ctrl.getCurrentList()" comp-options="::$ctrl.compOptions"></sb-assign-collaborators>' +
                '</div>';
        }


        function getListNavTeam(cond) {
            if(!$ctrl.showCollabsInListNav || !$ctrl.CPS.isAuthenticated || !$ctrl.CPS.productId){return '';}
            return '<div class="display-block pull-right collaborators-wrap" ng-if="' +
                (cond ? cond : '$ctrl.isActiveGroup()&& $ctrl.getCurrentList()._id!==\'All\'') +
                '">' +
                '<sb-assign-collaborators class="hide-ipad clearfix collaborators-faces without-underline without-arrow" circle-size="smaller" max-count="2" parent-container="true" without-close="true" can-edit="$ctrl.canEdit" todo-page-id="$ctrl.RouteCollaboratorsService.todoPage._id" u-id="$ctrl.getCurrentList()._id" list="$ctrl.getCurrentList()" comp-options="::$ctrl.compOptions"></sb-assign-collaborators>' +
                '</div>';
        }

        function getListNavShare() {
            if ($ctrl.LCS.isMobileSize || !$ctrl.showShareInListNav || !$ctrl.showShareInListNavExposed || !$ctrl.CPS.isAuthenticated || !$ctrl.CPS.productId) {return '';}
            return '<a id="btnSh" ng-show="$ctrl.isActiveGroup()" class="' +
                ($ctrl.showShareInListNavExposed ? '' : 'hide-ipad ') +
                $ctrl.getBtnActionCls() +
                ' btn btn-small primary with-margin-left inline-block pull-left side-padding-20 without-text '+$ctrl.pageClass+'" data-type="sharePage" analytics-on analytics-action="Share Page" tooltip-placement="bottom" tooltip="' + getShareBtnTooltip()+'"' +
                '>'+
                ($ctrl.showShareInListNavExposed ? '' : $ctrl.LCS.getISBDiv('link', 2, 'pull-left show-ipad'))+
                '<span class="'+($ctrl.showShareInListNavExposed ? '' : 'hide-lower1024')+'">Share</span>' +
                '</a>';

            function getShareBtnTooltip(){
                return 'Share ' +
                    ($ctrl.hasTree ? ('{{$ctrl.getCurrentList().isFolder?$ctrl.getGroupName():$ctrl.nameForList}}') : $ctrl.itemTitle);
            }
        }

        function sharePage(e){
            $ctrl.share($ctrl.getCurrentList(), e);
        }

        function getListNavComments(cond) {
            if(!$ctrl.showCommentsInListNav || !$ctrl.CPS.productId){return '';}
            return ($ctrl.CPS.isCollaborator || $ctrl.CPS.isAuthenticated) ? ('<comments-button ' +
                ($ctrl.isPopup ? 'is-popup="true" ' : '') +
                'type="comments" ng-if="' + (cond ? cond : '$ctrl.isSimpleCurrentList()') +'" btn-cls="btn btn-small primary-faded without-text with-margin-left pull-right" ' +
                    (typeof($ctrl.onUpdatedCommentsTab) ==='function' ? ('on-updated="$ctrl.onUpdatedCommentsTab(result)"') : '') +
                '></comments-button>') : '';
        }

        function getcls(cls){
            return (cls ? cls : 'hide-ipad') + ' btn btn-small primary-faded without-text with-margin-left pull-right';
        }

        function openComments(){

        }

        function share(list, e) {
            if (!list && $ctrl.currentList) {
                list = $ctrl.currentList;
            }
            console.error('share from page: overwrite in parent ');
            if(list) {
                $ctrl.RouteCollaboratorsService.share(list._id, null, $ctrl.compOptions, list, e);
            }
        }
    }
}


//use with: .component('callsheetGroup', treeGroupComponentParams( 'CallsheetsGroupCtrl', {}))

function getTreeSidebarInitParams(){
    return {
        canEdit: '<',
        isInTreeModal: '<',
        listTreeService: '<',
        keyboardService: '<',
        treeType:'<',

        //variables
        selectedFilter: '<',

        service: '<',
        compOptions: '<',
        getPopoverTemplate: '&',
        onGetListItemIcon: '&',
        sidebarOptions: '<',
        listParams:'<',
        canDragPredefTreeItem: '@'
    }
}
angular.module('page.group.controller.service', [
    'list.base.component.service',
    'filters.init.component',
    'list.keyboard.service',
    'list.tree.sidebar.component',
    'page.simple.controller.service',
    'list.tree.currentList.service',
    'page.group.withbg.controller.service',
    'group.tree.helper.service',
    'dropdowns.sbDropdown.likesComments.component'
])
.service('PageTreeInitCtrlService', PageTreeInitCtrlService);
PageTreeInitCtrlService.$inject = ['PageSimpleInitCtrlService', 'PageWithBgCtrlService', 'KeyboardListService', 'ListTreeService', 'FiltersService', 'GroupTreeHelperService'];
function PageTreeInitCtrlService(PageSimpleInitCtrlService, PageWithBgCtrlService,  KeyboardListService, ListTreeService, FiltersService, GroupTreeHelperService) {
    /*   options =  {
            constantsService: constantsService,
            listsService : listsService,
            service: service,
            listOptionsService: null,

            otherOptions: {
                listTreeServiceParams: {},
                keyboardServiceParams: {}
                sidebarOptions
                compOptions: {}, //also in page.simple
            }
        }*/
    return function ($ctrl, $element, initOptions) {

        var btnCls = 'btn btn-small primary-faded ';
        $ctrl.filtersProp = 'searchFilters';

        if($ctrl.withNgclick === undefined){
            $ctrl.withNgclick = false;
        }
        $ctrl.GroupTreeHelperService = GroupTreeHelperService;
        $ctrl.KeyboardListService = KeyboardListService;
        $ctrl.ListTreeService = ListTreeService;
        $ctrl.FiltersService = FiltersService;

        if(!$ctrl.btnCustomizeColumsTxt) {
            $ctrl.btnCustomizeColumsTxt = 'Customize Columns';
        }
        $ctrl.withCustomPrint = false;
        $ctrl.wrapperGroupsCls = 'wrapper-groups';
        if(!$ctrl.serviceName) {
            $ctrl.serviceName = 'PageTreeInitCtrlService';
        }
        console.log($ctrl.serviceName);
        var options = initOptions ? _.extend({}, initOptions) : null;


        $ctrl.sidebarOptions = options.constantsService.SidebarOptions;
        if(!$ctrl.sidebarOptions){ $ctrl.sidebarOptions = {};}
        if(!$ctrl.sidebarOptions.getParams ){ $ctrl.sidebarOptions.getParams = $ctrl.getParams;}

        if (options.constantsService && options.constantsService.ListParams) {
            $ctrl.listParams = options.constantsService.ListParams;
        }

        if($ctrl.getSidebarNameOther) {
            $ctrl.sidebarOptions = _.extend({}, $ctrl.sidebarOptions, {
                getSidebarNameOther: $ctrl.getSidebarNameOther
            });
        }

        if(options.constantsService.CompOptions && options.constantsService.CompOptions.customBGForList){
            $ctrl.sidebarOptions = _.extend({}, $ctrl.sidebarOptions, {
                addGroupPopupName: 'createListWithBg',
                editGroupPopupName: 'updateListWithBg',
                treeAddNotInline: true,
                treeDuplicateNotInline: $ctrl.treeDuplicateNotInline
            })
            $ctrl = new PageWithBgCtrlService($ctrl);
        }

        if (!$ctrl.listParams) {
            console.warn('define $ctrl.listParams in parent for PageTreeInitCtrlService');
        }

        $ctrl.service = options.service;
        if (!$ctrl.service) {
            console.warn('define $ctrl.service in parent for PageTreeInitCtrlService');
        }

        $ctrl.mergeSelected = mergeSelected;

        if (!$ctrl.getPageTemplate) {
            $ctrl.getPageTemplate = getPageTemplate;
        }

        if (!$ctrl.onTemplateLoaded) {
            $ctrl.onTemplateLoaded = onTemplateLoaded;
        }

        if (!$ctrl.$onDestroy) {
            $ctrl.$onDestroy = onPageGroupDestroy;
        }

        if (!$ctrl.onPageTreeInit) {
            console.warn('define $ctrl.onPageTreeInit in parent for PageTreeInitCtrlService');
        }else if (!$ctrl.$onInit) {
            $ctrl.$onInit = $ctrl.onPageTreeInit;
        }

        if (!$ctrl.getTopFiltersTitle) {
            $ctrl.getTopFiltersTitle = getTopFiltersTitle;
        }
        if (!$ctrl.getTopFilters) {
            $ctrl.getTopFilters = getTopFilters;
        }

        if (!$ctrl.getDisplayListCount) {
            $ctrl.getDisplayListCount = getDisplayListCount;
        }
        $ctrl.getDisplayListCountInit = getDisplayListCount;
        if (!$ctrl.isNotEmptyGroupState) {
            $ctrl.isNotEmptyGroupState = isNotEmptyGroupState;
        }

        if(!$ctrl.getEmptyGroup) {
            $ctrl.getEmptyGroup = getEmptyGroup;
        }
        if(!$ctrl.getGroupsContent){
            $ctrl.getGroupsContent = getGroupsContent;
        }

        if(!$ctrl.canShowShareInMore) {
            $ctrl.canShowShareInMore = canShowShareInMore;
        }

        if(!$ctrl.getGroupName) {
            $ctrl.getGroupName = getGroupName;
        }
        $ctrl.getSelectedFieldFromItem = getSelectedFieldFromItem;

        $ctrl.onPageGroupDestroy = onPageGroupDestroy;

        $ctrl.getOnPageInitParams = getOnPageInitParams;


        if(typeof($ctrl.isWithSidebar)!== 'function') {
            $ctrl.isWithSidebar = isWithSidebar;
        }

        $ctrl.isWithSidebarInit = isWithSidebar;

        $ctrl.isPageTree = true;

        $ctrl.filtersService = new $ctrl.FiltersService(options.constantsService, options.listOptionsService, {
            isInTreeModal: $ctrl.isInTreeModal
        });
        $ctrl.isCustomList = isCustomList;

        $ctrl = new PageSimpleInitCtrlService($ctrl, $element, options);

        if(!$ctrl.printPageParamsInit) {
            $ctrl.printPageParamsInit = _.extend({
                isPageTree: $ctrl.isPageTree,
                pageCtrlService: $ctrl.pageCtrlService,
            }, _.clone(initOptions));
        }

        if (!$ctrl.withoutListField && !$ctrl.listField) {
            console.warn('define $ctrl.listField in parent for PageTreeInitCtrlService');
        }

        $ctrl.preloaderRun = false;

        var otherOptions = options.otherOptions || {},
            o = {};

        o[options.constantsService.ListParams.defaultOrder ? options.constantsService.ListParams.defaultOrder : 'order'] =
          options.constantsService.ListParams.defaultOrderDir ? options.constantsService.ListParams.defaultOrderDir : 1;

        var listTreeServiceParams = _.extend({
                elemType: $ctrl.elemType,
                objectType: $ctrl.objectType,
                groupOrder: o,
                selectedIdField: options.constantsService.CompOptions.selectedIdField,
            },
            options.constantsService.ListTreeServiceParams,
            otherOptions.listTreeServiceParams,
            $ctrl.getGroupFilters ? {getGroupFilters: $ctrl.getGroupFilters} : null
        );
        if($ctrl.dontUpdateUrl){
            listTreeServiceParams.dontUpdateUrl = $ctrl.dontUpdateUrl;
        }

        $ctrl.withArchiveGroupInLists = listTreeServiceParams.withArchiveGroupInLists;
        $ctrl.withArchiveGroupAsList = $ctrl.dynamicWithArchiveGroupAsList ? $ctrl.dynamicWithArchiveGroupAsList() : listTreeServiceParams.withArchiveGroupAsList;

        if(otherOptions.sidebarOptions) {
            $ctrl.sidebarOptions = _.extend({}, $ctrl.sidebarOptions,
                {
                    getGroupName: $ctrl.getGroupName,
                    getGroupIcon: $ctrl.getGroupIcon
                },
                otherOptions.sidebarOptions);
        }

        $ctrl.listTreeService = new $ctrl.ListTreeService(options.constantsService, $ctrl.filtersService, options.listsService, listTreeServiceParams);

        $ctrl.listTreeService.treeListParamId = $ctrl.listField;

        setf('isActiveFilter');
        setf('isActiveGroup');

        $ctrl.onSearchGroup = onSearchGroup;

        setKeyboardService();

        if (!$ctrl.treeTag || $ctrl.useDefaultTreeTag) {
            $ctrl.treeTag = 'tree';
        }

        if (!$ctrl.getTreePopoverTemplate) {
            $ctrl.getTreePopoverTemplate = getTreePopoverTemplate;
        }

        if(!$ctrl.loadDirectory) {
            $ctrl.loadDirectory = loadDirectory;
        }

        $ctrl.listTreeService.loadDirectory = $ctrl.loadDirectory;

        $ctrl.onPreloadTables = onPreloadTables;
        $ctrl.broadcastPreload = broadcastPreload;

        if ($ctrl.canEdit) {
            if (!$ctrl.processSelectedCustomBtns) {
                $ctrl.processSelectedCustomBtns = processSelectedCustomBtns;
            }
            $ctrl.addItem = addItem;
            $ctrl.clearSelected = clearSelected;

            $ctrl.createGroupFromTop = createGroupFromTop;
        }

        $ctrl.getDrpSettings = getDrpSettings;

        if(!$ctrl.hasLists) {
            $ctrl.hasLists = hasLists;
        }

        if (!$ctrl.processSettings) {
            $ctrl.processSettings = processSettings;
        }

        $ctrl.processSettingsInit = processSettings;

        if (!$ctrl.getNewGroupTopButtons) {
            $ctrl.getNewGroupTopButtons = getNewGroupTopButtons;
        }

        if (!$ctrl.getFiltersTotalCounter) {
            $ctrl.getFiltersTotalCounter = getFiltersTotalCounter;
        }

        if (!$ctrl.getFiltersSelectedCounter) {
            $ctrl.getFiltersSelectedCounter = getFiltersSelectedCounter;
        }

        if (!$ctrl.getKeyboardFilters) {
            $ctrl.getKeyboardFilters = getKeyboardFilters;
        }

        if (!$ctrl.getGroupContainer) {
            $ctrl.getGroupContainer = getGroupContainer;
        }

        if (!$ctrl.getGroupContainerInit) {
            $ctrl.getGroupContainerInit = getGroupContainer;
        }

        if (!$ctrl.getGroupBody) {
            $ctrl.getGroupBody = getGroupBody;
        }

        if(typeof($ctrl.getSideMenuLi) !=='function'){
            $ctrl.getSideMenuLi = getSideMenuLi;
        }

        if (!$ctrl.getSidebar) {
            $ctrl.getSidebar = getSidebar;
        }

        $ctrl.getSidebarInit = getSidebar;


        $ctrl.getEmptyStateBlock = getEmptyStateBlock;
        $ctrl.getSidebarAttributes =  getSidebarAttributes;

        $ctrl.processSelectedGroup = processSelectedGroup;
        $ctrl.getDrpSelectedFilters = getDrpSelectedFilters;
        $ctrl.getGroupViewFilters = getGroupViewFilters;

        $ctrl.getSearch = getSearch;
        $ctrl.getLikesFilters = getLikesFilters;
        $ctrl.getGroupFilterButtons = getGroupFilterButtons;

        if(!$ctrl.getGroupFilterButtonsInit){
            $ctrl.getGroupFilterButtonsInit = getGroupFilterButtonsInit;
        }

        if(!$ctrl.getGroupFilterButtonsInitXS){
            $ctrl.getGroupFilterButtonsInitXS = getGroupFilterButtonsInitXS;
        }

        if(!$ctrl.canRenameList) {
            $ctrl.canRenameList = canRenameList;
        }

        $ctrl.canRenameListInit = canRenameList;

        if (!$ctrl.checkShowAddNewItem) {
            $ctrl.checkShowAddNewItem = checkShowAddNewItem;
        }

        $ctrl.checkShowAddNewItemInit = checkShowAddNewItem;
        if (!$ctrl.checkShowAddNewGroup) {
            $ctrl.checkShowAddNewGroup = checkShowAddNewGroup;
        }

        if(!$ctrl.getMoveName) {
            $ctrl.getMoveName = getMoveName;
        }

        if(!$ctrl.getMoveIcon) {
            $ctrl.getMoveIcon = getMoveIcon;
        }

        if(!$ctrl.showFilter) {
            $ctrl.showFilter = showFilter;
        }

        if(!$ctrl.showFilterForCollabs) {
            $ctrl.showFilterForCollabs = showFilterForCollabs;
        }

        if (!$ctrl.elemType) {
            console.warn('define $ctrl.elemType in parent for PageSimpleInitCtrlService');
        }

        if(!$ctrl.getListItemIcon) {
            $ctrl.getListItemIcon = getListItemIcon;
        }

        if(!$ctrl.canMergeMulti) {
            $ctrl.canMergeMulti = canMergeMulti;
        }

        if(!$ctrl.canMoveMulti) {
            $ctrl.canMoveMulti = canMoveMulti;
        }

        if(!$ctrl.canArchive) {
            $ctrl.canArchive = canArchive;
        }

        if(!$ctrl.canArchiveMulti) {
            $ctrl.canArchiveMulti = canArchiveMulti;
        }

        if(!$ctrl.canCopyMulti) {
            $ctrl.canCopyMulti = canCopyMulti;
        }

        if(!$ctrl.canRemoveMulti) {
            $ctrl.canRemoveMulti = canRemoveMulti;
        }

        $ctrl.isArchived = isArchived;
        $ctrl.isActive = isActive;
        $ctrl.shareList = shareList;
        $ctrl.onPageInit = onPageInit;

        if(!$ctrl.getListIcon) {
            $ctrl.getListIcon = getListIcon;
        }

        if(!$ctrl.checkListActiveInit){
            $ctrl.checkListActiveInit = checkListActiveInit;
        }

        if(!$ctrl.startPagePreloadInit){
            $ctrl.startPagePreloadInit = startPagePreloadInit;
        }

        if(!$ctrl.getSidebarTag) {
            $ctrl.getSidebarTag = getSidebarTag;
        }

        if(!$ctrl.getGroupNameFromTop) {
            $ctrl.getGroupNameFromTop = getGroupNameFromTop;
        }

        if(!$ctrl.getGroupIconFromTop) {
            $ctrl.getGroupIconFromTop = getGroupIconFromTop;
        }
        $ctrl.checkIfActiveList = checkIfActiveList;
        $ctrl.checkIfStripList = checkIfStripList;
        $ctrl.getLiInit = getLiInit;
        $ctrl.groupAction = groupAction;

        $ctrl.columnSettings = columnSettings;

        if(!$ctrl.onChangeLikeCommentsFilters) {
            $ctrl.onChangeLikeCommentsFilters = onChangeLikeCommentsFilters;
        }

        if(!$ctrl.getSomeBtns) {
            $ctrl.getSomeBtns = getSomeBtns;
        }
        $ctrl.addRootWatcher('CHANGED_TOP_DRP_FILTERS' + getPrefix(), onChangedGroupFiltersInit);

        $ctrl.isInnerPage = $ctrl.element.getAttribute('is-inner-page') === 'true';
        if($ctrl.isInnerPage) {
            $ctrl.addRootWatcher('UI_PARAMS_CHANGED_' + $ctrl.elemType, uiOnParamsChanged);
        }

        return $ctrl;

        function onChangeLikeCommentsFilters(result){
            console.log('onChangeLikeCommentsFilters');
            $ctrl['filters' + $ctrl.filtersProp] = result;
            $ctrl.broadcastRoot('LIKES_GROUP_FILTERS_' + $ctrl.elemType + '_' + $ctrl.listTreeService.active.selectedListId, result);
        }

        function groupAction(type, e) {
            //$ctrl.preventDefault(e);
            $ctrl.broadcastRoot('TOP_BTN_' + $ctrl.listTreeService.active.selectedListId, {event: type, e: e});
        }

        function getGroupNameFromTop() {
            return $ctrl.nameForGroup;
        }

        function getGroupIconFromTop() {
            return $ctrl.iconForGroup;
        }

        function isCustomList(){
            return $ctrl.treeTypeCustomList ?  $ctrl.treeType === $ctrl.treeTypeCustomList : true;
        }

        function shareList(type, e){
            return $ctrl.share($ctrl.listTreeService.active.selectedList, e);
        }

        function setKeyboardService() {
            console.log('setKeyboardService: keyboardService defined for page');
            //defined here to consider all the groups across the page
            $ctrl.withSortable = $ctrl.withoutGroupSorting !== true && !$ctrl.isCommentsSidebar; //preset it here

            $ctrl.keyboardService = new $ctrl.KeyboardListService({
                itemTitle: $ctrl.itemTitle,
                elemType: $ctrl.elemType,
                objectType: $ctrl.objectType,
                treeClass: $ctrl.treeClass,
                tableClass: $ctrl.tableClass,
                sortableDirection: options.sortableDirection,
                //disable multi select for now. needs more testing
                withMultiSelect: false,//!($ctrl.withoutMultiSelect === true)
                cantBeDraggedLast:  $ctrl.cantBeDraggedLast === true,
                definedInPageTree: $ctrl.withSortable && $ctrl.definedInPageTree,
                isCommentsSidebar: $ctrl.isCommentsSidebar
            });

            var keyboardServiceParams = _.extend({}, options.constantsService.KeyboardServiceParams, otherOptions.keyboardServiceParams);
            if (keyboardServiceParams) {
                $ctrl.keyboardService = _.extend($ctrl.keyboardService, keyboardServiceParams);
            }

            $ctrl.addRootWatcher('CLEAR_SELECTED_ROWS_' + $ctrl.elemType, clearSelected);
        }

        function hasLists(checkActive){
            if(!checkActive) {
                return !!$ctrl.listTreeService.hasLists($ctrl.treeType
                    //    , checkActive ? $ctrl.selectedFilter !== false: undefined
                ) ;
            }


            //todo: if is collaborator & just one list might need to hide the sidebar
            var isNotEmpty = $ctrl.listTreeService.getListCount($ctrl.treeType);
            return isNotEmpty && checkActive ? hasListCount() : isNotEmpty;

            function hasListCount() {
                var preLoadingService = $ctrl.listTreeService && $ctrl.listTreeService.preLoadingService ? $ctrl.listTreeService.preLoadingService : $ctrl.preLoadingService,
                    listTable = preLoadingService && preLoadingService.parentRel ? preLoadingService.parentRel.parent : (
                        ($ctrl.preloadingType ? ($ctrl.preloadingType + 'Lists') : $ctrl.listTreeService ? $ctrl.listTreeService.preLoadingTableName : '')
                    ),
                    lists = listTable ? preLoadingService.getObjectList(preLoadingService.TblTypes[listTable]) : null,
                    count = lists ? _.filter(lists, {
                        type: $ctrl.treeType,
                        active: $ctrl.selectedFilter !== false
                    }).length : 0;
                return count > 0;
            }
        }

        function setf(n){
            if (typeof ($ctrl[n]) === 'function') {
                if(!$ctrl.sidebarOptions){$ctrl.sidebarOptions = {};}
                $ctrl.sidebarOptions[n] = $ctrl[n];
            }
        }

        function canRenameList(item) {
            return (item.withActiveTree && item.active || !item.withActiveTree) &&
                (item.isPredef && $ctrl.withRenamePredefTreeItem || !item.isPredef);
        }

        function getListIcon(){
            return $ctrl.listIcon || '';
        }

        function getListItemIcon(item) {
            if (!item) {
                return null;
            }
            var el = '';
            switch ($ctrl.elemType) {
                case 'TAGGINGELEMENT':
                    el +=item.isFolder ? getDefault() : ('<div class="color-button small ' + (item.color ? '' : 'elementscolor') + '"><div ' + (item.color ? ('style="background-color:' + item.color + '" ') : '') + '>' +
                            get(item.icon ? item.icon : 'elements', item.iconLevel ? item.iconLevel : 6, 'sbf22') +
                            '</div></div>');
                    break;

                case 'DOCUMENT':
                            //avscript
                    el += $ctrl.treeType === 3 ? ((item.l === 2 || item.parentId) ? getImg('logo', $ctrl.getListIcon(item)) : get($ctrl.getListIcon(item))) :
                        getFolder(null, $ctrl.elemType === 'DOCUMENT' ? (($ctrl.treeType === 1 ? 'documents' : 'screenplays') + '-folder') : '');
                    break;
                case 'MATERIAL':
                    el += getFolder(8);
                    break;

                case 'CONTACT':
                case 'RECIPIENT':
                    el += getDefault(item.icon ? item.icon : $ctrl.itemIcon, item.iconLevel);
                    break;

                case 'BOARDS':
                    el += getImg('background', item.icon ? item.icon : $ctrl.itemIcon, item.iconLevel ? item.iconLevel : 2);
                  //  el += getDefault(item.icon ? item.icon : $ctrl.itemIcon, item.iconLevel);
                    break;

                default:
                    el += getDefault();
                    break;
            }
            return '<div class="icon-col centered ' + $ctrl.getListIcon(item) + '">' + el + '</div>';

            function getImg(prop, icon, iconLevel){
                return '<sb-resizable-img img-size="small30" with-img-bg="true" ' +
                    'img-observer-service="::$ctrl.imgObserverService" load-later="true" ' +
                    'icon="' + icon +'" icon-level="' + iconLevel + '" ' +
                    'img-prop="' + prop + '" area-type="square" without-initials="true" img-watch="true" size="::null" item="$ctrl.item"></sb-resizable-img>'
            }
            function getFolder(iconLevel, cls) {
                return '<div class="folder-icon small ' + (cls ? cls : '') + '">' +
                    $ctrl.LCS.getISBDiv(item.icon, iconLevel ? iconLevel : item.iconLevel, 'text-center folder-inner-icon') +
                    '</div>';
            }

            function getDefault(icon, iconLevel) {
                var li = $ctrl.getListIcon(item),
                    listIcon = icon ? icon : (li ? li : (item.type === 5 ? 'stripboard' : (item.icon ? item.icon : $ctrl.itemIcon))),
                    listIconLevel = item.type === 5 ? 5 : (iconLevel ? iconLevel : (item.iconLevel ? item.iconLevel : (item.isFolder ? $ctrl.iconLevel : ($ctrl.listIconLevel || $ctrl.iconLevel))));
                return get(item.isFolder ? $ctrl.iconForGroup : listIcon, listIconLevel);
            }

            function get(icon, iconLevel, c) {
                return $ctrl.LCS.getISBDiv(icon, iconLevel ? iconLevel : 2, c);
            }
        }

        function onChangedGroupFiltersInit(result) {
            var type = result.type, val = result.val;
            if ($ctrl[type] !== val) {
                $ctrl[type] = val;
                console.log('CHANGED_TOP_DRP_FILTERS: PageTreeInitCtrlService.onChangedGroupFiltersInit: type=' + type + ', val: ' + val);
                if (typeof ($ctrl.onChangedGroupFilters) === 'function') {
                    $ctrl.onChangedGroupFilters(type, val);
                }
            }
        }

        function onPageGroupDestroy() {
            bindDrpSettings(false);
            $ctrl.onSimplePageDestroy();
            if ($ctrl.sortableService) {
                $ctrl.sortableService.destroy();
            }
        }

        function processSelectedCustomBtns(action, e) {
            console.log('SELECTED_CUSTOM_BTNS');
            $ctrl.broadcastRoot('SELECTED_CUSTOM_BTNS_' + $ctrl.elemType + '_' +  $ctrl.listTreeService.active.selectedListId, {action: action, e: e});
        }

        function loadDirectory(item, dontRemoveQuery) {
            console.log('loadDirectory ' + $ctrl.elemType);
            if ($ctrl.listTreeService.dontUpdateUrl) {
                console.log('loadDirectory: dont reload the page');
                return broadcastTreeListChanged('PageTreeInitCtrlService: loadDirectory with dontUpdateUrl');
            }

            var params = {
                    productId: $ctrl.CPS.productId
                },
                rolePath = $ctrl.CPS.isCollaborator ? $ctrl.CPS.rolePaths.collabPath : $ctrl.CPS.rolePaths.currentUserPath,
                tp = $ctrl.listTreeService.treeListParamId,
                id = $ctrl.listTreeService.getSelectedIdFromItem(item);


            //same list but archived vs active

            var withReload = $ctrl.withArchiveGroupInLists === true;
            var addDelay = $ctrl.isScheduling || $ctrl.addLoadDirectoryDelay;
            if($ctrl.withArchiveGroupInLists){ //scheduling
                if (hasValue(false)) {
                    params.active = false;
                }
            } else
            if(!$ctrl.withArchiveGroupAsList) {
                if($ctrl.withActiveGroup && $ctrl.withArchiveGroupAsListCustom) {
                    params.active = $ctrl.selectedFilter;
                      id  = $ctrl.selectedFilter ? 'All' : 'Archived';
                }
            } else {
                if (hasValue(false)) {
                    params.active = false;
                }
            }

            if (tp) {
                params[tp] = id;
            }


            //avscript
            if(typeof($ctrl.getParamsRedirect) === 'function'){
                params  = _.extend(params, $ctrl.getParamsRedirect());
            }

            function hasValue(value) {
                return $ctrl.withArchiveGroupInLists && ($ctrl.listTreeService && $ctrl.listTreeService.transitionList && $ctrl.listTreeService.transitionList.active === value || $ctrl.selectedFilter === value);
            }

            //disable for the popups
            if (!$ctrl.isPopup) {
                var pattern = $ctrl.SBStateService.getCurrentState().url.split('?'),
                    q = pattern && pattern.length > 1 ? pattern[1].split('&') : null,
                    $sp = $ctrl.SBStateService.$stateParams,
                    otherParams = {};
                if(q && q.length > 0) {
                    for (var p in $sp) {
                        if(p !== tp && q.indexOf(p)!== -1) {
                            otherParams[p] = $sp[p];
                        }
                    }
                }
                $ctrl.listTreeService.inTransition = {};
                $ctrl.listTreeService.inTransition[tp] = id;
                //remove active = false from url for scheduling
                if(otherParams && otherParams.active === 'false' && hasValue(true)) {
                    delete otherParams.active;
                }
                var p1 = $ctrl.CPS.currentPathParams(_.extend(otherParams, params), rolePath);


                //if is not first change
                console.log('loaddirectory');
                if(!dontRemoveQuery && p1 && !$ctrl.isCommentsSidebar && !$ctrl.isTaskBoards) {
                    console.log('toRemove');
                    _.each(['comment', 'card', 'item'], function (p) {
                         p1[p] = undefined;
                    });
                }
                //on scheduling -> switching from active to boneyard throws error
                //todo test more
              //  var addDelay = $ctrl.SBStateService.getCurrentStateName() !== 'user.taskboards';
                if(addDelay){
                    $ctrl.LCS.timeout(process, 100);
                } else {
                    process();
                }

                function process(){
                    $ctrl.CPS.transitionTo(
                        $ctrl.SBStateService.getCurrentStateName(), p1, {
                            reload: withReload,
                            notify: false,
                            location: true
                        });
                }
            }
        }

        function getGroupFiltersInit(node, method, isDisplay, selectedFilter) {

            var groupFilters = {},
                exists = false;

            if (node && node.withArchiveGroupAsList) {
                groupFilters.active = false;
                exists = true;
            } else if ($ctrl.withActiveGroup && $ctrl.filtersService.selectedFilter !== 'All') {
                groupFilters.active = selectedFilter!== undefined ? selectedFilter : $ctrl.filtersService.selectedFilter;
                exists = true;
            }

            //count only files
           // this doesnt seem to work k
             if (method === 'getListCount' && $ctrl.listTreeService.isRecursiveTree) {
                groupFilters.isFolder = false;
            }

            var extra = typeof ($ctrl.getGroupFilters) === 'function' ? $ctrl.getGroupFilters(isDisplay) : null;
            if (extra) {
                groupFilters = _.extend(groupFilters, extra);
                exists = true;
            }

            return exists ? groupFilters : null;
        }

        function getPrefix(){
            return ($ctrl.isPrintLayout ? '_PRINT_LAYOUT' : '') +
            ($ctrl.isInTreeModal ? '_TREE_MODAL' : '');
        }

        function getOnPreloadName(){
            return 'ON_PRELOAD_TABLES' + getPrefix() + '_' + $ctrl.elemType;
        }

        function uiOnParamsChanged(changedParams){
            console.log('PageTreeInitCtrlService.uiOnParamsChanged');
           // if(!$ctrl.isCommentsSidebar){return;}
            var val = changedParams[$ctrl.listField];
            if($ctrl.selectedIdFieldIsNumber && changedParams.hasOwnProperty($ctrl.listField) &&
                val !== undefined && val !== null && val !== 'undefined' && val !== 'null' && val !== 'All'){
                val = parseInt(val, 10);
                changedParams[$ctrl.listField] = val;
            }

            $ctrl.listTreeService.uiOnParamsChanged(changedParams, $ctrl.treeType);

            var id = $ctrl.listTreeService.transitionList ? $ctrl.listTreeService.transitionList._id : undefined;
            if(id && id !== $ctrl.transitionListId) {
                if($ctrl.listTreeService && $ctrl.listTreeService.inTransition){
                    for(var prop in $ctrl.listTreeService.inTransition){
                        if($ctrl.listTreeService.inTransition.hasOwnProperty(prop) && $ctrl.listTreeService.inTransition[prop] === id) {
                            $ctrl.listTreeService.inTransition = null;
                        }
                    }
                }
                broadcastTreeListChanged('PageTreeInitCtrlService.uiOnParamsChanged');
                $ctrl.transitionListId = $ctrl.listTreeService.transitionList ? $ctrl.listTreeService.transitionList._id : undefined;
            }
        }

        function broadcastTreeListChanged(from){
            var list = $ctrl.listTreeService.transitionList;
            $ctrl.CurrentTreeListService.broadcastTreeListChanged(getTreeChangedParams(), $ctrl.elemType, list, from);

            function getTreeChangedParams() {
                return {
                    isCommentsSidebar: $ctrl.isCommentsSidebar,
                    isPrintLayout: $ctrl.isPrintLayout,
                    isInTreeModal: $ctrl.isInTreeModal,

                    listInfo: {
                        collectionName: $ctrl.service ? $ctrl.service.collectionName : null,
                        itemTitle: $ctrl.itemTitle,
                        nameForList: $ctrl.nameForList,
                        elemType: $ctrl.elemType
                    }
                }
            }
        }

        function getOnPageInitParams(withPreloaderProperty, additionalScriptInit, loadingParams) {
            return _.extend({
                withPreloaderProperty: withPreloaderProperty,
                additionalScriptInit: additionalScriptInit,
                isScript: $ctrl.listTreeService.preloadingType === $ctrl.PreloadingTypes.Scripts,
                preloadingType: $ctrl.listTreeService.preloadingType,
                listFieldForTables: $ctrl.listTreeService.listFieldForTables
            }, loadingParams ? {loadingParams: loadingParams} : null)
        }

        function onPageInit(withPreloaderProperty, additionalScriptInit, loadingParams) {
            console.log('PageTreeInitCtrlService.onPageInit');
            if (!$ctrl.withoutUiOnParamsChanged) {
                $ctrl.uiOnParamsChanged = uiOnParamsChanged;
            }

            if(!$ctrl.preloadTablesWatcher) {
                $ctrl.preloadTablesWatcher = $ctrl.addRootWatcher(getOnPreloadName(), onPreloadTables);
            }
            if (!$ctrl.listTreeService.getGroupFiltersInit) {
                $ctrl.listTreeService.getGroupFiltersInit = getGroupFiltersInit;
            }

            $ctrl.onSimplePageInit($ctrl.getOnPageInitParams(withPreloaderProperty, additionalScriptInit, loadingParams), startPreload);

        }

        function startPreload(preLoadingService, resetPreloaderRun) {
            if (!$ctrl.sidebarOptions) {
                $ctrl.sidebarOptions = {};
            }
            //removeAdditionalMessage: ' and all the projects within it',
            if (!$ctrl.sidebarOptions.getParams) {
                $ctrl.sidebarOptions.getParams = $ctrl.getParams;
            }

            //needs more work> goes in a loop
          /*  if(!$ctrl.isCommentsSidebar && !$ctrl.getTreeFilters && typeof($ctrl.onGetTreeFilters) === 'function'){
                $ctrl.getTreeFilters = function (result){
                    return $ctrl.onGetTreeFilters({result: result});
                }
            }
*/
            //i.e.: function getTreeFilters(item){return item.x === x1;}
            if (typeof ($ctrl.getTreeFilters) === 'function') {
                $ctrl.sidebarOptions.getTreeFilters = $ctrl.getTreeFilters;
            }

            $ctrl.startPagePreloadInit(preLoadingService, resetPreloaderRun, false);
        }

        function startPagePreloadInit(preLoadingService, resetPreloaderRun, force){
            if (force || !$ctrl.listTreeService.preLoadingService) {
                $ctrl.listTreeService.preLoadingService = preLoadingService;
            }

            if (typeof ($ctrl.preBroadcastPreload) === 'function') {
                $ctrl.preBroadcastPreload();
            }

            $ctrl.broadcastPreload(resetPreloaderRun);
        }

        function onPreloadTables(resetPreloaderRun) {
            console.log('onPreloadTables');
            if (resetPreloaderRun) {
                $ctrl.preloaderRun = false;
            }
            if ($ctrl.preloaderRun || !$ctrl.listTreeService.preLoadingService || !$ctrl.pageIsLoaded) {
                return;
            }
            $ctrl.preloaderRun = true;
            var has = typeof ($ctrl.isPreloadTable) === 'function';
            if (has && $ctrl.isPreloadTable() || !has) {
                $ctrl.reloadPageTemplate(false, $ctrl.onTemplateLoaded);
            }
        }

        function onTemplateLoaded() {
            console.log('onGroupPageTemplateLoaded allInfoLoaded=' + $ctrl.allInfoLoaded);
            $ctrl.pageIsLoaded = true;

            bindDrpSettings(true);

            if ($ctrl.onPageLoaded) {
                $ctrl.onPageLoaded();
            }
            $ctrl.broadcastPreload();
        }

        function bindDrpSettings(isBind){
            if(isBind && !$ctrl.isDrpSettingsBinded || !isBind) {
                var els = $ctrl.element.querySelectorAll('.drp-settings-item');
                if (els && els.length > 0) {
                    $ctrl.LCS.bindElementsClick(isBind, els, onDrpSettings);
                   if(isBind) {
                       $ctrl.isDrpSettingsBinded = true;
                   }
                }
            }
        }

        function onDrpSettings(e) {
           // $ctrl.LCS.preventDefault(e);
            console.log('onDrpSettings');
            var el = e.currentTarget,
                type = el.getAttribute('data-type'),
                callDirectly = el.getAttribute('data-call'),
                data = el.getAttribute('data-info');


            //planFetatures testmode
            var item = _.find($ctrl.SettingsActions, {type: type}),
                quotaType = item ? item.quotaType : null;
            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});

            function process() {
                if (callDirectly) {
                    $ctrl[type](data, e);
                } else {
                    $ctrl.processSettings(type, e);
                }
            }
        }

        function broadcastPreload(resetPreloaderRun) {
            $ctrl.broadcastRoot(getOnPreloadName(), resetPreloaderRun);
        }

        function processSelectedGroup(action, e) {
            $ctrl.broadcastRoot('SELECTED_GROUP_' + $ctrl.elemType +'_' + $ctrl.listTreeService.active.selectedListId, {action: action, e:e});
        }

        function clearSelected() {
            $ctrl.broadcastRoot($ctrl.keyboardService.CLEAR_SELECTED);
        }

        function addItem(treeType, data) {
            $ctrl.broadcastRoot('ADD_FROM_EMPTY_STATE_' + $ctrl.elemType + '_TREE', {treeType: treeType, data: data});
        }

        function onSearchGroup(search) {
            $ctrl.broadcastRoot('SEARCH_GROUP_' + $ctrl.elemType +'_' + $ctrl.listTreeService.active.selectedListId, {search: search});
        }
        function isNotEmptyGroupState() {
            return $ctrl.listTreeService.isNotEmptyGroupState();
        }
        function checkListActiveInit(){
            return $ctrl.withActiveTree ? 'true' : '';
        }

        function getPageTemplate() {
            $ctrl.CPS.withBanner = $ctrl.CPS.setPageBanner($ctrl.CPS.withBanner, $ctrl.showBannerProp, $ctrl.bannerFeatureProp);

            var hasLists = '$ctrl.hasLists(' + $ctrl.checkListActiveInit() + ')',//;'$ctrl.hasLists('+($ctrl.withActiveTree ? 'true' : '') + ')',
                cls = $ctrl.withoutTopFilters ? '' : ($ctrl.withArchiveGroupAsList ? '" ng-class="{\'with-filters-above\': ' + hasLists + '}' : 'with-filters-above');

            return $ctrl.getInitTopFilters() +
                '<div ng-show="' + hasLists + '" class="h-full side-table ' + cls + '">' +
                    $ctrl.getSidebar() +
                    $ctrl.getGroupContainer() +
                    ($ctrl.withDocumentInline && typeof ($ctrl.getInlineDocumentContainer) === 'function' ? $ctrl.getInlineDocumentContainer() : '') +
                    ($ctrl.withSidebarRight ? $ctrl.getSidebarRight() : '') +
                '</div>' +
                $ctrl.getEmptyStateBlock(cls);
        }

        function getEmptyStateBlock(cls) {
            var hasLists = '$ctrl.hasLists(' + ($ctrl.withActiveTree ? 'true' : '') + ')';
        return '<div ng-show="!' + hasLists + '" class="empty-state-wrapper with-side-margin with-margin-top ng-hide ' + (cls ? cls : '') + '">' +
                    '<div class="full-width" ng-if="!' + hasLists + '">' + $ctrl.getEmptyState($ctrl.withActiveTree) + '</div>' +
                '</div>' +
                (typeof ($ctrl.otherPageInfo) === 'function' ? $ctrl.otherPageInfo() : '');
        }

        function getSidebarTag(){
            return $ctrl.treeTag + '-sidebar';
        }

        function getSidebar(sidebarClass) {
            var tag = $ctrl.getSidebarTag();
            if (!sidebarClass) {
                //todo add logic for smaller sidebar
                $ctrl.withLongSidebar = true;
                var cls = '';
                if ($ctrl.withShortSidebar && !$ctrl.LCS.isMobileSize) {
                    cls = 'short ';
                } else if ($ctrl.withLongSidebar && !$ctrl.LCS.isMobileSize || $ctrl.LCS.isMobileSize) {
                    cls = 'long ';
                }
                sidebarClass = 'clearfix hide-print h-full side-nav static contacts with-tree ' + cls +
                    ($ctrl.pageClass ? $ctrl.pageClass : '');
            }

            return '<' + tag + ' class="' + tag + ' ' + sidebarClass +
                ($ctrl.treeTag === 'workflow' ? '' : (($ctrl.hideSidebar || !$ctrl.displaySidebar()) ? ' sb-hide' : '')) +
                '" ' +
                // ($ctrl.hideSidebar ? '' : 'ng-show="$ctrl.displaySidebar()" ') +
                $ctrl.getSidebarAttributes() + '></' + tag + '>';
        }

        function isWithSidebar() {
            var isNotArchived = !(($ctrl.withActiveGroup||$ctrl.withActiveTree) && $ctrl.selectedFilter === false) || $ctrl.showSidebarIfArchived;
            if ($ctrl.CPS.isAuthenticated) {
                return ($ctrl.forceShowSidebar || $ctrl.hasLists()) && isNotArchived;
            } else if ($ctrl.CPS.isCollaborator) {
                // if (!$ctrl.listTreeService.collabRootId)
                //if has more levels and the root is folder
                if (!$ctrl.listTreeService.collabRootId) {
                    return true;
                } else if (($ctrl.listTreeService.maxLevel > 1 && !$ctrl.listTreeService.isRecursiveTree ||
                        $ctrl.listTreeService.maxLevel >= 1 && $ctrl.listTreeService.isRecursiveTree) &&
                    $ctrl.listTreeService.collabRoot && $ctrl.listTreeService.collabRoot.isFolder) {
                    return true;
                }
                //when the default page is shared
                return $ctrl.listTreeService.active.selectedList && (
                    $ctrl.listTreeService.active.selectedList.withHarcodedAll && $ctrl.listTreeService.active.selectedList.count > 0);
            }
            return false;
        }

        function showFilter(){
            return $ctrl.CPS.isAuthenticated || $ctrl.CPS.isCollaborator && $ctrl.showFilterForCollabs();
        }

        function showFilterForCollabs(){
            return $ctrl.showFiltersForCollabs;
        }

        function getSidebarAttributes() {
            var addon = typeof ($ctrl.getSidebarAddon) === 'function' ? $ctrl.getSidebarAddon() : '';
            return 'can-edit="::$ctrl.canEdit" ' +
                'list-tree-service="::$ctrl.listTreeService" ' +
                'tree-type="::$ctrl.treeType" ' +
                'is-in-tree-model="::$ctrl.isInTreeModal" ' +

                'keyboard-service="::$ctrl.keyboardService" ' +
                (addon && addon.indexOf('comp-options') !== -1 ? '' : 'comp-options="::$ctrl.compOptions" ') +

                'selected-filter="::$ctrl.selectedFilter" ' +
                'service="::$ctrl.service" ' +
                'sidebar-options="::$ctrl.sidebarOptions" ' +
                'list-params="::$ctrl.listParams" ' +
                'get-popover-template="$ctrl.getTreePopoverTemplate(item, isMobile)" ' +
                'on-get-list-item-icon="$ctrl.getListItemIcon(item)" ' +

                addon;
        }


        function getSelectedFieldFromItem(item){
            var id = $ctrl.listTreeService.getSelectedFieldFromItem(item);
            if(id === null){return 'null';}
            return id;
        }

        function getGroupsContent(withRepeat, isFullHeight){
            return $ctrl.GroupTreeHelperService.getGroupsContent($ctrl, withRepeat, isFullHeight)
        }

        function getGroupBody(result){
           return $ctrl.GroupTreeHelperService.getGroupBody($ctrl, result);
        }

        function getFCLs(isFullHeight){
            return $ctrl.isPrintLayout ? '' : (isFullHeight ? 'h-full ' : '');
        }

        function getGroupContainer() {
            console.log('PageTreeInitCtrlService.getGroupContainer');
            var withRepeat = true,//!$ctrl.isPrintLayout,
                isFullHeight = true,
                fCls = getFCLs(isFullHeight);
            return '<div class="list-tree ' + ($ctrl.isPrintLayout ? ' report-body medium-template printlayout ' : '') + fCls  +
                ($ctrl.withListTreeWhiteBg ? ' with-white-bg' : '') + '" data-scroll-container=".list-tree">' +
                        '<div class="' + $ctrl.wrapperGroupsCls + ' without-padding ' + fCls + '">' + $ctrl.getGroupsContent(withRepeat, isFullHeight) + '</div>' +
                    '</div>';
        }

        function getEmptyGroup(){
            console.log('getEmptyGroup');
            var group = $ctrl.getGroupName();
        return ($ctrl.listIcon ? ('<div class="centered circled-svg-colored small76 page-class ' +
                    ($ctrl.pageClass ? $ctrl.pageClass : '') +
                    '">'+$ctrl.LCS.getISBDiv($ctrl.listIcon, 2) + '</div>'
                ) : '') +
                '<h3 class="text-center">There are no <span ng-if="$ctrl.selectedFilter===false">archived </span><span ng-bind="$ctrl.isCustomList()?(\'custom \'+$ctrl.nameForList.toLowerCase()+\'s\'):\'imported scenes\'"></span> <span ng-if="!$ctrl.hasLists()">in this '+group+'</span></h3>' +

($ctrl.canEdit ? ('<div ng-if="item.active">' +
                    '<div ng-if="$ctrl.isCustomList()" class="text-center">' +
                        '<p class="text-center line-height-2">Create a new '+$ctrl.nameForList.toLowerCase()+'<span ng-if="!$ctrl.hasLists()"> in this '+group+'</span> by clicking the button below.</p>' +
                        '<div data-nodrag class="text-center margin-top-half min-height-40">' +
                            '<div class="with-hover">' +
                            //add shot list to group
                                '<a id="addNewShotLink" ng-click="$ctrl.addItem($ctrl.isCustomList(), {item: {type: $ctrl.isCustomList()}, addFolder: false, isParent: true, useSelected: true})" analytics-on analytics-action="New '+$ctrl.nameForList+'" class="btn btn-primary '+
                                ($ctrl.pageClass ? $ctrl.pageClass : '') +
                                '">' +
                                    $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left with-margin-right') +
                                    '<span>New '+$ctrl.nameForList+'</span>' +
                                '</a>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +

                    //script lists:
                ($ctrl.CPS.isAuthenticated && $ctrl.hasScript ? (
                    '<div ng-if="$ctrl.isScriptList()" class="text-center">' +
                        '<p class="text-center line-height-2">Add imported scenes by clicking the button below.</p>' +
                        '<div data-nodrag class="text-center margin-top-half min-height-40">' +
                            '<div class="with-hover">' +
                                '<import-script ng-if="!$ctrl.hasLists() || $ctrl.isScriptList()" btn-class="btn btn-primary '+($ctrl.pageClass||'')+'" show-title="true" show-text-on-ipad="true" ' + ($ctrl.pageClass ? ('page-class="'+$ctrl.pageClass+'" ') : '') + '></import-script>' +
                            '</div>' +
                        '</div>' +
                    '</div>'
                ) : '') +
                '</div>') : '');
        }


        function getGroupViewFilters() {
            if(!$ctrl.withGridView || typeof ($ctrl.hideGridViewFilters)==='function' && $ctrl.hideGridViewFilters()){return '';}

            //$ctrl.viewFilters = $ctrl.withGridView ? 'printLayout' : null;
        return '<div ng-show="$ctrl.isNotEmptyGroupState()" class="pull-right hide-ipad">' +
                    '<group-view-filters ' +
                         //'is-in-tree-modal="::$ctrl.isInTreeModal" ' +
                         //'is-print-layout="::$ctrl.isPrintLayout" ' +
                        'filters-service="::$ctrl.filtersService" ' +
                        'elem-type="' + $ctrl.elemType + '" '+
                        'view-filters="::$ctrl.viewFilters" ' +
                        'class="pull-left with-margin-left position-relative"' +
                    '></group-view-filters>' +
                '</div>';
        }

        function getDrpSelectedFilters(filter, ext, other) {
            if (!$ctrl.showFilter()) {
                return '';
            }

            if (!other) {
                other = {};
            }

            var isTreeFilter = filter === 'treeType';
            if (isTreeFilter) {
                ext = '&nbsp;';
            }

            var tag = isTreeFilter ? 'group-tree-filters' : 'group-drp-filters';

            return '<' + tag + ' ' +
                'id="drpFilters' + (filter ? filter : '') + '" ' +
                'filters-service="::$ctrl.filtersService" ' +
                'can-edit="::$ctrl.canEdit" ' +
                'elem-type="' + $ctrl.elemType + '" ' +

                'elem-type="' + $ctrl.elemType + '" ' +
                'is-in-tree-modal="::$ctrl.isInTreeModal" ' +
                //'is-print-layout="::$ctrl.isPrintLayout" ' +
                'item-title="' + (!isTreeFilter && $ctrl.withActiveTree ? $ctrl.nameForList : $ctrl.itemTitle) + '" ' +
                (other.drpClassAttr ? ('drp-class-attr="' + other.drpClassAttr + '" ') : '') +
                (other.btnClass ? ('btn-class-attr="' + other.btnClass + '" ') : '') +
                ($ctrl.filtersClass ? ('filters-class="' + $ctrl.filtersClass + '" ') : '') +
                'class="' + (filter === 'treeType' ? 'display-block group-tree-filters ' : 'pull-left ') + (other.cls ? other.cls : '') + '" ' +
                'selected-class="semibold" ' +
                'selected-filter="::$ctrl.' + (filter ? filter : 'selectedFilter') + '" ' +
                (filter ? ('filter-prop="' + filter + '" ') : '') +
                (ext ? ('ext="' + ext + '" ') : '') +
                '></' + tag + '>';
        }

        function getTopFiltersTitle(isList) {
            var hasFilter = $ctrl.CPS.isAuthenticated &&
                    $ctrl.showFilter() && (!$ctrl.withArchiveGroupAsList && ($ctrl.withActiveGroup || $ctrl.withActiveTree)),
                t = getTitle(isList),
                t1 = $ctrl.hideListInfoInNav ? null : getTitle(true);
            return (typeof ($ctrl.getPageTitle) === 'function' ? $ctrl.getPageTitle() : '') +
                (hasFilter ? $ctrl.getDrpSelectedFilters(null, $ctrl.filterTitleExt, _.extend({
                    btnClass: $ctrl.isCommentsSidebar ? null : 'with-bg',
                    //cls: $ctrl.CPS.isAuthenticated ? 'sb-hide' : ''
                }, $ctrl.drpSelectedFiltersClass ? {drpClassAttr: $ctrl.drpSelectedFiltersClass} : null)) : t) +
                (t1 && getText(t) !== getText(t1) ? t1 : '');

            //(sf  ? getTitle(true) : '');

            function getText(html) {
                return $ctrl.LCS.createFragment('<div>' + html + '<div>').children[0].innerText.toLowerCase();
            }

            function getTitle(isList) {
                return $ctrl.LCS.isMobileSize && $ctrl.hideTitleOnMobile ? '' : $ctrl.getTopFiltersTitleInit(isList);
            }
        }

        function getTopFilters() {
            return $ctrl.getTopFiltersTitle() +
                '<div class="' + ($ctrl.hideClearBtn ? 'pull-right' : 'pull-left') + '">' +
                    ($ctrl.getKeyboardFilters ? $ctrl.getKeyboardFilters() : '') +
                    ($ctrl.getLeftButtons ? $ctrl.getLeftButtons() : '') +
                '</div>' +
                '<div ng-show="$ctrl.keyboardService.SelectedRows.length===0" class="pull-right">' +
                    $ctrl.getGroupViewFilters() +
                    $ctrl.getListNavComments()+
                    //$ctrl.getListNavCollabs() +
                    //todo bring back SHARE LIST
                    ($ctrl.enableListShare ? $ctrl.getListNavShare() : '') +
                    $ctrl.getSomeBtns() +
                '</div>' +
                ($ctrl.hideClearBtn ? '' : ('<div class="'+($ctrl.isInTreeModal ? 'pull-left':'pull-right')+' one-line-tooltip"><button ng-show="$ctrl.keyboardService.SelectedRows.length>0" class="btn btn-small transparent3 small without-text ng-hide '+$ctrl.getBtnActionCls()+'" data-type="clearSelected" tooltip-placement="'+($ctrl.isInTreeModal ? 'bottom':'left')+'" tooltip="Clear Selection">'+$ctrl.LCS.getISBDiv('cancel') + '</button></div>')
                );
        }

        function getSomeBtns(){
            return (!$ctrl.hideCreateButtons ? $ctrl.getNewGroupTopButtons() : '') +
                $ctrl.getDrpSettings() +
                ($ctrl.getRightButtons ? $ctrl.getRightButtons() : '')
        }

        function getDrpSettings() {
            if(!$ctrl.withDrpSettings){return '';}
            var exposed = getSettingsActions(true) +
                          $ctrl.getPdfReports(false, {exposeOnDesktop: true}, true),
                above =  getSettingsActions(false)  +
                    (typeof($ctrl.getDrpSettingsOther) === 'function' ?  $ctrl.getDrpSettingsOther(): ''),

                //hide share list
                share = '', //getShareLi(above!==''), //todo bring back share list

                reports = $ctrl.getPdfReports(false, {isMobileOnly: true}, false),
                exports = getExport(),
                customize = $ctrl.withoutCustomize ? '' : getCustomize(above || share || print || exports);

 return exposed +
        '<div dropdown class="position-relative one-line-tooltip dropdown dropdown-wrapper pull-right with-margin-left">' +
           '<button id="btnSettings" type="button" class="btn btn-small primary-faded without-text dropdown-toggle" dropdown-toggle tooltip="Settings" tooltip-placement="bottom" analitycs-on analy>'+$ctrl.LCS.getISBDiv('horizontal-dots', 3, 'centered')+'</button>' +
           '<div class="dropdown-menu side-menu fadeInDownLeft with-overflow drpSettings" role="menu">' +
                '<div class="header-small clearfix spacing-half-top padding-left20">More Options</div>' +
                '<ul class="listitems-selector with-checked">' +
                    above  +
                    //line
                    share +
                    '<print-button-li ' + $ctrl.getWithBorderTop(false) + ' ng-if="$ctrl.hasLists()" show-title="true"   ' + ($ctrl.withCustomPrint ? 'on-print="$ctrl.onPrint()" custom-print="true"' : '') +'></print-button-li>' +
                    reports +
                    //line
 (typeof($ctrl.getDrpSettingsAfter)==='function' ? $ctrl.getDrpSettingsAfter($ctrl.getWithBorderTop(true)): '')+
                    exports +
                    //line
                    customize +
                    '<li>' + $ctrl.getDrpZoomFilters() + '</li>' +
                '</ul>' +
            '</div>' +
        '</div>';

            function getExport(){
                return $ctrl.withExportCSV ? '<export-csv-li></export-csv-li>' : '';
            }

            function getShareLi(withBorderTop) {
                if(($ctrl.showShareInListNav &&
                    !($ctrl.showShareInListNavExposed && !$ctrl.isMobileSize)
                ) && $ctrl.CPS.isAuthenticated && $ctrl.CPS.productId) {
                 return '<li ' + $ctrl.getWithBorderTop(withBorderTop) + ' ng-if="$ctrl.listTreeService.active.selectedListId !== \'All\' && $ctrl.isActiveFilter()">' +
                            '<a class="fixed-layout table-div" ng-click="$ctrl.share($ctrl.listTreeService.active.selectedList)" analytics-on analytics-action="Open Share Popup">' +
                                '<div class="col30 with-margin-right">'+ $ctrl.LCS.getISBDiv('link', 2, 'gray') +'</div>' +
                                '<div><div class="with-ellipsis">' + 'Share '+ ($ctrl.hasTree?('{{$ctrl.listTreeService.active.selectedList.isFolder?$ctrl.getGroupName():$ctrl.nameForList}}'):$ctrl.itemTitle) + '</div></div>' +
                            '</a>' +
                        '</li>';
                }
                return '';
            }

            function getCustomizeItem(withBorderTop){
                return {
                    id: 'btnCustomizeColumns',
                    name: $ctrl.btnCustomizeColumsTxt,
                    icon: 'cog',
                    type: 'columnSettings',
                    active: true,
                    withBorderTop: withBorderTop,
                    callDirectly: true,
                    hide: typeof($ctrl.getCustomizeHideCond) === 'function' ? $ctrl.getCustomizeHideCond() : null,
                    //tooltip: 'Reorder scenes by shooting location or scene number'
                    //quotaType: $ctrl.quotaTypeCustomize
                }
            }

            function getCustomize(withBorderTop) {
                return $ctrl.getDrpSettingsItem(getCustomizeItem(withBorderTop), false);
            }

            function getSettingsActions(isExposed) {
                var isMobile = $ctrl.LCS.isMobileSize;
                if (isExposed && isMobile) {
                    return '';
                }

                if (!$ctrl.SettingsActions && $ctrl.canEdit) {
                    $ctrl.SettingsActions = [];
                }

                var el = '';
                if ($ctrl.SettingsActions) {
                    _.each($ctrl.SettingsActions, function (setting) {
                        var i = (setting.exposeOnDesktop && isExposed || !setting.exposeOnDesktop && !isExposed);
                        if (isMobile || !isMobile && i) {
                            el += $ctrl.getDrpSettingsItem(setting, isMobile ? false : isExposed);
                        }
                    });
                }

                return el;
            }
        }

        function columnSettings(data, e){
            $ctrl.processSettings('columnSettings');
        }

        function processSettings(type) {
            $ctrl.popupsService.open($ctrl.listTreeService.active.selectedList, $ctrl.popupsService.operations[type], {
                listTreeService: $ctrl.listTreeService,
                columnsPerRow: 3
            }, $ctrl.compOptions);
        }

        function getNewGroupTopButtonsWithDrp() {
            if (!$ctrl.canEdit) {
                return getPreviewScene(false);
            }
            var cond = '$ctrl.checkIfActiveList()',
                condInit = cond + '||' + '($ctrl.LCS.isMobileSize'+($ctrl.withoutPreviewScene?'':'&&$ctrl.$ctrl.checkIfStripList()')+')';

            return '<div class="shots-group-buttons pull-left with-hover hide-print">' +
                '<div ng-show="' + condInit + '" dropdown class="pull-left position-relative one-line-tooltip with-margin-left dropdown-wrapper">' +
                //$ctrl.getBtnUpload(false, 'pull-left with-margin-left ' + btnCls, cond) +
                ($ctrl.singleAddBtn ? getAddShotsBtn(cond) : getAddDrp()) +
                '</div>' +
                getPreviewScene(false, false) +
                '</div>';

            function getAddDrp() {
                return '<button id="btnAddDrp" type="button" class="btn btn-small primary without-text ' + $ctrl.pageClass + ' dropdown-toggle" dropdown-toggle>' +
                    $ctrl.LCS.getISBDiv('plus', 3, 'pull-left') +
                    '<span class="hide-ipad with-padding-right">Add New</span>' +
                    '</button>' +
                    '<div class="dropdown-menu side-menu fadeInDownLeft with-overflow drpSettings addNew" role="menu">' +
                    '<ul class="listitems-selector with-checked">' +
                    getAOther(cond) +
                    getPreviewScene(true, true) +
                    '</ul>' +
                    '</div>';
            }

            function getAOther(cond) {
                return addGroupActionBtn(cond, 'Add ' + $ctrl.itemTitle + 's', $ctrl.itemIcon, 'ADDITEM') +
                    ($ctrl.singleAddBtn ? '' : (
                        ($ctrl.withoutAddSetup ? '' : addGroupActionBtn(cond, 'New ' + $ctrl.setupTypeName, $ctrl.setupTypeIcon, 'ADDSETUP', true)) +
                        addGroupActionBtn(cond, 'New '+($ctrl.withTextBlock ? 'Text Box' : 'Banner'), 'banner', 'ADDBANNER')
                    ));
            }

            function addGroupActionBtn(cond, name, icon, method, withBorderTop) {
                return getBtn(true, name, icon, icon === $ctrl.itemIcon ? $ctrl.iconLevel : 4, method, cond, false, true, null, withBorderTop);
            }

            function getAddShotsBtn(cond) {
                return getBtn(false, 'Add ' + $ctrl.itemTitle + 's', 'plus', 2, 'ADDITEM', cond, false, true, 'btn-small btn-primary');

            }

            function getPreviewScene(isLi, showIpadOnly) {
                return getBtn(isLi, 'Preview Scene', 'sides', 2, 'TOGGLESCENE', '$ctrl.checkIfStripList()', showIpadOnly, false,
                    isLi ? '' : btnCls);
            }

            function getBtn(isLi, name, icon, iconLevel, method, cond, showIpadOnly, withText, cls, withBorderTop) {
                return isLi ? getLiInit(name, icon, iconLevel, method, cond, showIpadOnly, withBorderTop) : getBtnInline(name, icon, iconLevel, method, cond, !showIpadOnly, withText, cls);

                function getBtnInline(name, icon, iconLevel, method, cond, hideIpad, withText, cls) {
                    return '<button type="button" ' + (cond ? ('ng-show="' + cond + '" ') : '') + ' class=" pull-left ' + $ctrl.getBtnActionCls() + ' ' +
                        (withText ? ('btn ' + (cls ? cls : 'btn-primary') + ' ' + ($ctrl.pageClass ? $ctrl.pageClass : '')) : ('without-text with-margin-left ' + (cls ? cls : btnCls))) +
                        (hideIpad ? ' hidden-xs' : '') + '" data-type="groupAction" data-info="' + method + '" analytics-on analytics-action="' + name + '"' +
                        (withText ? '' : (' tooltip="' + name + '" tooltip-placement="bottom"')) +
                        '>' + $ctrl.LCS.getISBDiv(icon, iconLevel, 'pull-left'
                            //+' with-margin-right'
                        ) + (withText ? ('<span class="hide-lower1024 with-padding-right">' + name + '</span>') : '') +
                        '</button>';
                }
            }
        }

        function getLiInit(txt, icon, iconLevel, method, cond, showIpadOnly, withBorderTop) {
            return '<li class="' + (showIpadOnly ? 'show-ipad' : (withBorderTop ? '  with-border-top without-padding ' : '')) +'" ' + (cond ? (' ng-show="' + cond + '"') : '') + '>' +
                '<a class="fixed-layout table-div ' + $ctrl.getBtnActionCls() + '" data-type="groupAction" data-info="' + method + '"  analytics-on analytics-action="' + txt + '">' +
                '<div class="col30 with-margin-right">' + $ctrl.LCS.getISBDiv(icon, iconLevel) + '</div>' +
                '<div><div class="with-ellipsis">' + txt + '</div></div>' +
                '</a>' +
                '</li>';
        }


        function getList() {
            var l = $ctrl.listTreeService.active ? $ctrl.listTreeService.active.selectedList : null;
            return l && !l.isFolder && l.active ? l : null;
        }

        function checkIfActiveList() {
            var l = getList();
            return l ? l.count > 0 : false;
        }

        function checkIfStripList() {
            var l = getList();
            return l && l.stripId ? true : false;
        }
        function getNewGroupTopButtons() {
            if (!$ctrl.canEdit) {
                return '';
            }

            if($ctrl.withDrpAdd){
                return getNewGroupTopButtonsWithDrp();
            }

            var text = $ctrl.addNewItemText ? $ctrl.addNewItemText : ('New ' + $ctrl.itemTitle),
                group = $ctrl.getGroupNameFromTop(),
                btnClassInit = 'ng-hide btn btn-small with-margin-left inline-block pull-left without-text ' +
                    ($ctrl.withNgclick ? '' : $ctrl.getBtnActionCls()) + ' ',
                btnCls = 'primary min-width-120 ' + ($ctrl.pageClass ? $ctrl.pageClass : '') + ' ' + btnClassInit,
                btn1 = 'createFromTop',
                btn2 = 'createGroupFromTop';
            return '<a ng-show="$ctrl.checkShowAddNewItem()" class="btnNewFromTop ' + btnCls + '" ' +
                ($ctrl.withNgclick ? ('ng-click="$ctrl.' + btn1 + '(null, $event)" ') : '') +
                'data-type="' + btn1 + '" analytics-on analytics-action="' + text + '">' +
                $ctrl.LCS.getISBDiv(($ctrl.addNewItemIcon ? $ctrl.addNewItemIcon : 'plus-circled'), $ctrl.addNewItemIconLevel ? $ctrl.addNewItemIconLevel : 2, 'pull-left') +
                ($ctrl.withoutTopFilters ? '' : ('<span class="hide-lower1024 with-padding-right">' + text + '</span>')) +
                '</a>' +
                ($ctrl.hideAddNewGroup ? '' : ('<a ng-show="$ctrl.checkShowAddNewGroup()" analytics-on analytics-action="Create ' + group + '" class="' + ($ctrl.showAddNewGroupFull ? btnCls : ('primary-faded ' + btnClassInit)) + '" ' +
                    ($ctrl.withNgclick ? ('ng-click="$ctrl.' + btn2 + '($event)" ') : '') +
                    'data-type="' + btn2 + '"' + ($ctrl.showAddNewGroupFull ? '' : (' tooltip="New ' + group + '" tooltip-placement="bottom"')) +
                    '>' + $ctrl.LCS.getISBDiv($ctrl.getGroupIconFromTop(), null, 'pull-left') + ($ctrl.showAddNewGroupFull ? ('<span class="hide-lower1024">New  ' + group + '</span>') : '') + '</a>'));
        }

        function createGroupFromTop(e){
            $ctrl.addItem($ctrl.treeType, {item: $ctrl.listTreeService.active.selectedList, addFolder: true, isParent: true, useSelected: true, e: e});
        }

        function checkShowAddNewItem() {
            var selectedList = $ctrl.listTreeService.active ? $ctrl.listTreeService.active.selectedList : null;
            return selectedList && !selectedList.withArchiveGroupAsList && $ctrl.isNotEmptyGroupState() &&
($ctrl.addItemInPredef || !$ctrl.addItemInPredef && (
$ctrl.listTreeService.isRecursiveTree && !selectedList.isPredef && !(selectedList.isFolder && selectedList._id ===null) ||
!$ctrl.listTreeService.isRecursiveTree && selectedList.isPredef && selectedList.isFolder === true && selectedList._id === null ||
!selectedList.isPredef
)) && $ctrl.isActiveFilter();
        }

        function checkShowAddNewGroup() {
            var selectedList = $ctrl.listTreeService.active ? $ctrl.listTreeService.active.selectedList : null;
            return selectedList && !selectedList.withArchiveGroupAsList &&
                (
                    ($ctrl.withActiveTree &&
                        $ctrl.listTreeService.active.selectedList !== false // $ctrl.selectedFilter
                        || !$ctrl.withActiveTree) &&
                    ($ctrl.withActiveGroup && $ctrl.selectedFilter || !$ctrl.withActiveGroup)
                )&&
                $ctrl.isNotEmptyGroupState() &&
                (!selectedList.isPredef || selectedList.isPredef && $ctrl.listTreeService.active.selectedListId === null) &&
                selectedList.isFolder && selectedList.l < $ctrl.listTreeService.maxLevel;
        }

        function getLikesFilters() {
            console.log('getLikesFilters');
            var withLikes = canLikeItems(),
                withComments = true;
            if (!$ctrl.hasLikesFilters || !(withLikes || withComments) ) {
                return '';
            }
            $ctrl[$ctrl.filtersProp] = null;

            var tag = 'sb-likes-comments-dropdown',
                cls = 'margin-left-14';
            return '<' + tag +
                ' ng-show="$ctrl.isNotEmptyGroupState() && !$ctrl.keyboardService.SelectedRows.length" ' +
            ' class="' + tag + ' btnTopComments  wrap-dd-select long-caret without-underline without-arrow navbtn pull-left ' + (cls ? cls : '') + '" element-id="' + $ctrl.currentListId + '_'+$ctrl.filtersProp+'_'+$ctrl.objectType+'" ' +
                'on-change="$ctrl.onChangeLikeCommentsFilters(result)" ' +
                //'on-cancel="$ctrl.onChangeLikeCommentsFilters(result)" ' +
                'elem-type="::$ctrl.elemType" without-close="true" autofocus="false" value="$ctrl.searchFilters" field-class="without-underline" c-class-attr="wrap-dd-select long-caret without-underline without-arrow" e-class-attr="form-control without-underline" drp-class-attr=" wrapper-style-drp drp-border" parent-container="true" with-likes="' + withLikes + '" with-comments="' + withComments + '" filters-prop="' + $ctrl.filtersProp + '"></' + tag + '>';

            function canLikeItems(){
                var u = $ctrl.security.getCurrentUser();
                return $ctrl.CPS.isAuthenticated || $ctrl.CPS.isCollaborator && u && !u.isGeneral; //if is a user or collab not general
            }
        }

        function getSearch(isShort) {
            return getSearch() + $ctrl.getLikesFilters();

            function getSearch() {
                if (!$ctrl.hasSearch) {
                    return '';
                }
                var withBtnSearch = true,//($ctrl.LCS.isMobileSize || $ctrl.withBtnSearch),
                    withoutBackground = true,
                    tag = withBtnSearch ? 'btn-search' : 'custom-search',
                    cls = withBtnSearch ? 'margin-left-14' : 'custom-search search-field';

                return '<' + tag + ' ng-show="$ctrl.isNotEmptyGroupState() && !$ctrl.keyboardService.SelectedRows.length" class="' + tag + ' ' + cls + ' pull-left"' +
                    ' placeholder="' + ($ctrl.searchPlaceholder ? $ctrl.searchPlaceholder : ('Search ' + $ctrl.itemTitle) + 's') + '…" on-search="$ctrl.onSearchGroup(search)"' +
                    (isShort ? ' is-short="true" ' : '') + (withoutBackground ? ' without-background="true" ' : '') +
                    '></' + tag + '>';
            }
        }

        function getFiltersTotalCounter(withItem) {
            return gettext($ctrl.getDisplayListCount(), withItem);
        }

        function getDisplayListCount(list){
            var isTotal = true;
            return $ctrl.listTreeService.getDisplayListCount(list ? list : null, isTotal);
        }

        function getFiltersSelectedCounter() {
            return gettext($ctrl.getFiltersTotalCounter(), true);
        }

        function gettext(count, withItem) {
            var txt = $ctrl.withTreeDisplayCount ? 'item' : $ctrl.itemTitle.toLowerCase();
            return count + (withItem ? (' ' + txt + (count !== 1 ? 's' : '')) : '');
        }

        function getKeyboardFilters() {
        return '<span ng-show="$ctrl.isNotEmptyGroupState()" class="keyboard-filters left-separator hide-ipad text-info-count with-line-height pull-left">' +
                    '<span class="selectedfilterscount sb-hide"></span>' +
                    '<span class="nonselectedrowcount" ng-show="!$ctrl.keyboardService.SelectedRows.length"' +
            ($ctrl.counterSetDynamically ? '' : ' ng-bind-html="$ctrl.getFiltersSelectedCounter()"') + '></span>' +
                    '<span ng-if="$ctrl.keyboardService.SelectedRows.length>0">' +
                        '<span ng-bind="$ctrl.keyboardService.SelectedRows.length +\' of \'"></span>' +
                        '<span ng-bind="$ctrl.getFiltersTotalCounter(true)"></span> <span ng-if="$ctrl.keyboardService.SelectedRows.length>0">selected:</span>' +
                    '</span>' +
                '</span>' +
                '<button ng-show="$ctrl.keyboardService.SelectedRows.length>0&&prop!==\'order\'" ng-repeat="(prop, val) in $ctrl.list.orders" class="btn btn-small transparent3 small without-text pull-left '+$ctrl.getBtnActionCls()+'" data-type="resetOrder"><span ng-bind="::$ctrl.getFilterName(prop)"></span> '+ $ctrl.LCS.getISBDiv('cancel') +'</button>' +
                $ctrl.getSearch() +
                $ctrl.getGroupFilterButtons();
        }

        function getGroupFilterButtonsInitXS(){
            return getA('Duplicate', 'copy', null,2, 'canCopyMulti') +
                getA('Move', 'transition', null, 4, 'canMoveMulti') +
                getA('Merge', 'merge', 'mergeSelected', 2, 'canMergeMulti') +

                ($ctrl.withActiveGroup && $ctrl.canArchiveMulti() ? ('<li ng-show="$ctrl.filtersService.selectedFilter === true" class="with-top-border"></li>'+
                    '<li ng-show="$ctrl.filtersService.selectedFilter === true"><a class="table-div full-width accent '+$ctrl.getBtnActionCls()+'" ng-class="{disabled: $ctrl.keyboardService.SelectedRows.length===0}" data-type="processSelectedGroup" data-info="Archive" analytics-on analytics-action="Open Archive Selected items Popup">' +
                    getd('box', ($ctrl.nameForArchived || 'Archive') + ' Selected') + '</a></li>' +
                    '<li ng-show="$ctrl.isArchived()" class="with-top-border"></li>'+
                    '<li ng-show="$ctrl.isArchived()"><a class="table-div full-width '+$ctrl.getBtnActionCls()+'" ng-class="{disabled: $ctrl.keyboardService.SelectedRows.length===0}" data-type="processSelectedGroup" data-info="Restore" analytics-on analytics-action="Open Restore Selected items Popup">' +
                    getd('box', 'Restore Selected') + '</a></li>'
                ) : '') +

            ($ctrl.canRemoveMulti() ? ('<li '+getP()+' class="with-top-border"></li>' +
                '<li '+getR()+'><a class="table-div full-width accent '+$ctrl.getBtnActionCls()+'" ng-class="{disabled: $ctrl.keyboardService.SelectedRows.length===0}" data-type="processSelectedGroup" data-info="Delete" analytics-on analytics-action="Open Remove Selected items Popup">' + getd('trash', 'Remove Selected') + '</a></li>') : '');
        }

        function canRemoveMulti(){
            return true;
        }

        function canArchiveMulti(){
            return true;
        }

        function mergeSelected(info, param, e){
            $ctrl.processSelectedCustomBtns('merge');
        }

        function getGroupFilterButtonsInit() {
            if ($ctrl.mustBeAdminToEdit && $ctrl.CPS.memberType < $ctrl.security.MemberTypes.Admin) {
                return '';
            }
            //$ctrl.filtersService.selectedFilter === true
            var btnCls = $ctrl.getBtnActionCls();
            var cls = 'ng-class="{\'small1\':$ctrl.hasSmall1,\'disabled\':$ctrl.keyboardService.SelectedRows.length===0}" ';
            return ($ctrl.withActiveGroup && $ctrl.canArchiveMulti() ? ('<a ng-show="$ctrl.isActive()" ' + cls + ' class="btn btn-small accent-faded without-text with-margin-left pull-right ' + btnCls + '" data-type="processSelectedGroup" data-info="Archive" analytics-on analytics-action="Open Archive Selected items Popup" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? (\'Please select at least one items.\') : (\'' + ($ctrl.nameForArchived || 'Archive') + ' \' + $ctrl.keyboardService.SelectedRows.length + \' selected item\'+($ctrl.keyboardService.SelectedRows.length==1?\'\':\'s\'))}}" tooltip-placement="bottom">' + getI('box') + '</a>' +

                    '<a ng-show="$ctrl.isArchived()" ' + cls + ' class="btn btn-small primary-faded without-text with-margin-left pull-left ' + btnCls + '" data-type="processSelectedGroup" data-info="Activate" analytics-on analytics-action="Open Restore Selected items Popup" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? (\'Please select at least one items.\') : (\'Restore \' + $ctrl.keyboardService.SelectedRows.length + \' selected item\'+($ctrl.keyboardService.SelectedRows.length==1?\'\':\'s\'))}}" tooltip-placement="bottom">' + getI('restore') + '</a>'
                ) : '') +

                ($ctrl.canRemoveMulti() ? ('<a ' + getR() + cls + ' class="btn btn-small accent-faded without-text with-margin-left pull-right ' + btnCls + '" data-type="processSelectedGroup" data-info="Delete" analytics-on analytics-action="Open Remove Selected items Popup" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? (\'Please select at least one items.\') : (\'Remove \' + $ctrl.keyboardService.SelectedRows.length + \' selected item\'+($ctrl.keyboardService.SelectedRows.length==1?\'\':\'s\'))}}" tooltip-placement="bottom">' + getI('trash') + '</a>') : '') +

                ($ctrl.keyboardService.canMerge ? ('<a ng-show="$ctrl.canMergeMulti()" ng-class="{\'small1\':$ctrl.hasSmall1,disabled: $ctrl.keyboardService.SelectedRows.length<2}" class="btn btn-small primary-faded with-margin-left pull-right ' + btnCls + '" data-type="mergeSelected" analytics-on analytics-action="Open Merge Selected items Popup" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? (\'Please select at least one item.\') : (\'Merge \' + $ctrl.keyboardService.SelectedRows.length + \' selected item\'+($ctrl.keyboardService.SelectedRows.length==1?\'\':\'s\'))}}" tooltip-placement="bottom">' + getI('merge') + ' <span class="hide-ipad with-padding-left">Merge ' + $ctrl.itemTitle + 's</span></a>') : '') +

                ($ctrl.keyboardService.canMove ? ('<a ng-show="$ctrl.canMoveMulti()" ' + cls + ' class="btn btn-small primary-faded without-text with-margin-left pull-right ' + btnCls + '" data-type="processSelectedGroup" data-info="Move" analytics-on analytics-action="Open Move Selected items Popup" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? (\'Please select at least one item.\') : ($ctrl.getMoveName() +\' \' + $ctrl.keyboardService.SelectedRows.length + \' selected item\'+($ctrl.keyboardService.SelectedRows.length==1?\'\':\'s\'))}}" tooltip-placement="bottom">' + getI('transition', 4) + '</a>') : '') +

                ($ctrl.keyboardService.canCopy ? ('<a ng-show="$ctrl.canCopyMulti()" ' + cls + ' class="btn btn-small primary-faded without-text with-margin-left pull-right ' + btnCls + '" data-type="processSelectedGroup" data-info="Duplicate" analytics-on analytics-action="Open Duplicate Selected items Popup" tooltip="{{$ctrl.keyboardService.SelectedRows.length===0 ? (\'Please select at least one item.\') : (\'Duplicate \' + $ctrl.keyboardService.SelectedRows.length + \' selected item\'+($ctrl.keyboardService.SelectedRows.length==1?\'\':\'s\'))}}" tooltip-placement="bottom">' + getI('copy') + '</a>') : '');

            function getI(i, l) {
                return $ctrl.LCS.getISBDiv(i, l ? l : 2, 'pull-left');
            }
        }

       function getR() {
           return ($ctrl.removeGroupOnAll ? '' : ('ng-show="' + $ctrl.withActiveGroup + ' && $ctrl.isArchived() || !' + $ctrl.withActiveGroup + '" '));
       }

        function getA(name, icon, method, iconLevel, action) {
            return $ctrl.keyboardService[action.replace('Multi', '')] ? ('<li ng-show="$ctrl.' + action + '()"><a class="table-div full-width '+$ctrl.getBtnActionCls()+'" ng-class="{\'disabled\': $ctrl.keyboardService.SelectedRows.length' +
                (name === 'Merge' ? '<2' : '===0') +
                '}" data-type="' + (method ? method : 'processSelectedGroup') + '" ' + (name ? ('data-type="'+ name + '"') : '') + ' analytics-on analytics-action="Open ' + name + ' Selected items Popup">' +
                getd(icon, name + ' Selected', iconLevel) + '</a></li>') : '';

        }

        function getP(){
            return $ctrl.withActiveGroup ? ' ng-show="$ctrl.isArchived()"' : '';
        }

        function getd(i, t, l){
            return '<div class="col30">' + $ctrl.LCS.getISBDiv(i, l ? l : 2) + '</div> <div>' + t + '</div>';
        }

       function isActive(){
           return $ctrl.filtersService.selectedFilter === 'All' && $ctrl.archiveGroupOnAll ||
           $ctrl.filtersService.selectedFilter === true &&
               $ctrl.listTreeService.active && $ctrl.listTreeService.active.selectedList &&
               !$ctrl.listTreeService.active.selectedList.withArchiveGroupAsList;
       }

       function isArchived(){
           return $ctrl.withActiveGroup && $ctrl.filtersService.selectedFilter === false ||
               $ctrl.withArchiveGroupAsList && $ctrl.listTreeService.active && $ctrl.listTreeService.active.selectedList && $ctrl.listTreeService.active.selectedList.withArchiveGroupAsList;
       }

       function canArchive(){
            return true;
       }

       function canMergeMulti() {
           return $ctrl.canCopyMulti() && !($ctrl.listTreeService.active.selectedList._id === null && $ctrl.listTreeService.active.selectedList.isFolder) && !$ctrl.listTreeService.active.selectedList.withHarcodedAll;
       }

       function canCopyMulti(){
           return $ctrl.withActiveGroup && isActive() || !$ctrl.withActiveGroup;
       }

       function canMoveMulti(){
            return $ctrl.canCopyMulti() && $ctrl.listTreeService && $ctrl.listTreeService.getFirstLevelNodesCount($ctrl.treeType);
       }

        function isall(){
            return $ctrl.listTreeService && $ctrl.listTreeService.ungroupOnTreeDelete &&
                $ctrl.listTreeService.active.selectedList.isHarcoded && $ctrl.listTreeService.active.selectedList.withHarcodedAll;
        }

        function getMoveName(title) {
            return (isall() ? 'Move ' : 'Move ') + (title ? title : '');
            //   'Group' : 'Move';
        }

        function getMoveIcon() {
            return isall() ? 'group-folders' : 'transition';
        }

        function getGroupFilterButtons() {
            if($ctrl.hideGroupFilters){return '';}
    return '<span ng-show="$ctrl.keyboardService.SelectedRows.length>0" class="with-line-height pull-left hide-ipad">' +
                '<div class="pull-left one-line-tooltip hide-lower1024">' +
                    $ctrl.getGroupFilterButtonsInit() +
                    (typeof ($ctrl.getGroupFilterButtonsOther) === 'function' ? $ctrl.getGroupFilterButtonsOther() : '') +
                '</div>' +

                '<div dropdown class="show-lower1024-inline dropdown one-line-tooltip position-relative">' +
                    '<button type="button" class="btn btn-small primary-faded without-text with-margin-left dropdown-toggle pull-left" dropdown-toggle aria-haspopup="true" aria-expanded="true">' + $ctrl.LCS.getISBDiv('horizontal-dots') + '</button>' +
                    '<div class="dropdown-menu side-menu more fadeInDownSmall group-filters-others" role="menu">' +
                        '<ul>' +
                            (typeof ($ctrl.getGroupFilterButtonsOtherXS) === 'function' ? $ctrl.getGroupFilterButtonsOtherXS() : '') +
                            $ctrl.getGroupFilterButtonsInitXS() +
                        '</ul>' +
                    '</div>' +
                '</div>' +
            '</span>';
        }

        function getGroupName(){
            return $ctrl.nameForGroup;
        }

        //checkHasItems > verify if the dropdown has items
        function getTreePopoverTemplate(item, isMobile, checkHasItems) {
            var group = $ctrl.getGroupName(item),
                type = item.isFolder ? group : $ctrl.nameForList,
                template = '',
                count = 0,
                add;

            if ($ctrl.withActiveTree && item.active || !$ctrl.withActiveTree) {
                getListShare();

                if($ctrl.treePopoverTemplateOtherInFront){
                    processOther();
                }

                if($ctrl.treePopoverTemplateEditInFront){
                    processEdit();
                }

                processAdd();

                if(!$ctrl.treePopoverTemplateEditInFront) {
                    processEdit();
                }

                processDup();

                if(!$ctrl.treePopoverTemplateOtherInFront){
                    processOther();
                }

                function processAdd() {
                    add = !$ctrl.CPS.isCollaborator || $ctrl.CPS.isCollaborator && $ctrl.hideAddNewGroupForCollabs !== item._id;
                    var isAll = item._id === null && item.isFolder || item.withHarcodedAll && !item.isFolder && item.isHarcoded;
                    if (!$ctrl.listTreeService.isRecursiveTree && !$ctrl.hideAddList && !item.isHarcoded) {
                        if (item.isFolder && item.l < $ctrl.listTreeService.maxLevel && (isAll || !item.isPredef)) {
                            template += $ctrl.getSideMenuLi({
                                type: 'add-list-inside',
                                action: 'Add ' + $ctrl.nameForList + ' Inside',
                                icon: 'plus'
                            });
                            count++;
                            if (checkHasItems) {
                                return true;
                            }
                        }
                        if (!item.isPredef && !isAll && add) {
                            template += $ctrl.getSideMenuLi({
                                type: 'add-list-under',
                                action: 'Add ' + $ctrl.nameForList + ' Under',
                                icon: 'plus'
                            });
                            count++;
                            if (checkHasItems) {
                                return true;
                            }
                        }
                    }

                    var parent = $ctrl.listTreeService.getNodeById(item.parentId, $ctrl.treeType);
                    if (!$ctrl.hideAddNewGroup && !item.isHarcoded && add) {
                       var canAdd = item.l - ($ctrl.listTreeService.isRecursiveTree ? 1 : 0) < $ctrl.listTreeService.maxLevel;

                        if (canAdd && !isAll &&
                            !(item._id !== null && parent.isPredef && parent.parentId !== undefined)) {
                            template += $ctrl.getSideMenuLi({
                                type: 'add-group-under',
                                action: 'Add ' + group + ' Under',
                                icon: 'plus'
                            });
                            count++;
                            if (checkHasItems) {
                                return true;
                            }
                        }
                        canAdd = item.l + ($ctrl.listTreeService.isRecursiveTree ? 0 : 1) < $ctrl.listTreeService.maxLevel;
                            //item.l - ($ctrl.listTreeService.isRecursiveTree ? 1 : 0) < $ctrl.listTreeService.maxLevel;
                        if (canAdd && item.isFolder && (isAll || !item.isPredef)) {
                            template += $ctrl.getSideMenuLi({
                                type: 'add-group-inside',
                                action: 'Add ' + $ctrl.getGroupName(item, true) + ' Inside',
                                icon: 'plus'
                            });
                            count++;
                            if (checkHasItems) {
                                return true;
                            }
                        }
                    }
                }

                function processEdit() {
                    if (item._id && !item.isHarcoded && $ctrl.canRenameList(item)) {
                        template += $ctrl.getSideMenuLi({
                            type: 'edit',
                            action: $ctrl.listTreeService.treeEditName + ' ' + type,
                            icon: 'pencil',
                            id: 'aEditElement' + item._id,
                            liClass: count > 0 ? 'with-top-border without-padding' : ''
                        });
                        count++;
                        if (checkHasItems) {
                            return true;
                        }
                    }
                }

                function processDup() {
                    var exists = typeof ($ctrl.canDuplicate) === 'function';
                    if ($ctrl.listTreeService.hasTreeCopy && item._id && add && (!exists || exists && $ctrl.canDuplicate())) {
                        template += $ctrl.getSideMenuLi({
                            type: 'duplicate',
                            action: 'Duplicate ' + (typeof ($ctrl.duplicateTitle) === 'function' ? $ctrl.duplicateTitle(item) : type),
                            icon: 'copy'
                        });

                        count++;

                        if (checkHasItems) {
                            return true;
                        }
                    }
                }

                function processOther(){
                    if( typeof($ctrl.getTreePopoverTemplateOther)==='function') {
                        template += $ctrl.getTreePopoverTemplateOther(item, isMobile, checkHasItems) || '';
                    }

                }
            }

            if ($ctrl.withActiveTree && !item.active) {
                var action = 'activate',
                    actionC = action.substring(0, 1).toUpperCase() + action.substring(1, action.length);
                template += $ctrl.getSideMenuLi({
                    type: action,
                    action: actionC + ' ' + type ,
                    icon: 'box',
                    liClass: count > 0 ? 'with-top-border without-padding' : null
                });
                if(checkHasItems){
                    return true;
                }
            }

            if (item._id && (!item.isPredef||$ctrl.withRemovePredefTreeItem) && !item.isHarcoded &&
                !($ctrl.withActiveTree && $ctrl.hideRemoveList && !item.active && !item.isFolder)) {
                var icon = $ctrl.withActiveTree ? (item.active ? 'box' : 'trash') : 'trash',
                    action = $ctrl.withActiveTree ? (item.active ? 'archive' : 'remove') : 'remove',
                    txt = action,
                    actionC;

                if(action === 'remove' && $ctrl.ungroupOnTreeDelete && item.isFolder) {
                    txt = $ctrl.ungroupOnTreeDeleteTxt ? $ctrl.ungroupOnTreeDeleteTxt : 'ungroup';
                }

                actionC = txt.substring(0, 1).toUpperCase() + txt.substring(1, txt.length);

                if(!$ctrl.withActiveTree || $ctrl.withActiveTree && (!item.active || item.active && $ctrl.canArchive(item))) {
                    template += $ctrl.getSideMenuLi({
                        type: action,
                        action: actionC + ' ' + type,
                        icon: icon,
                        liClass: count > 0 ? 'with-top-border without-padding' : null,
                        aClass: 'accent'
                    });
                }

                if (checkHasItems) {
                    return true;
                }
            }
            //sidebar menu items
            return '<ul class="dropdown-menu side-menu display-block treesidemenu ' + $ctrl.elemType.toLowerCase() + '-treesidemenu">' + template + '</ul>';

            function getListShare(){
                if(!$ctrl.canShowShareInMore(item, isMobile)){return false;}
                //share list
                if ($ctrl.listTreeService.hasTreeShare && $ctrl.CPS.productId) {
                    template += $ctrl.getSideMenuLi({
                        type: 'share',
                        action: 'Share ' + type,
                        icon: 'link',
                        liClass:'with-bottom-border'
                    });
                    count ++;
                    if (checkHasItems) {
                        return true;
                    }
                }
            }
        }

        function canShowShareInMore(item, isMobile){
            return item && !item.isFolder &&
                ($ctrl.CPS.companyId === $ctrl.LCS.API_CONFIGS.SBPredefCompanyId || $ctrl.LCS.isDebugMode);
        }

        function getSideMenuLi(data) {
            return (data.withTopBorder ? ('<li class="with-top-border ' +
                    (data.liClass === 'hide-desktop' ? data.liClass : '') + '"></li>') : '') +
                '<li' +
                    (data.id ? (' id="' + data.id + '"') : '') + ' ' +
                    (data.liClass ? (' class="' + data.liClass + '" ') : '') + '>' +
                    '<a class="table-div full-width' + (data.aClass ? (' ' + data.aClass) : '') + '" ' +
                        'analytics-on analytics-action="Open ' + data.action + '" ' +
                        'data-type="' + data.type + '" ' +
                        (data.param !== null && data.param !== undefined ? ('data-param="' + data.param + '" ') : '') +
                        (data.target ? ('target="' + data.target + '" ') : '') +
                        (data.href ? ('href="' + data.href + '" ') : '') +
                        (data.other ? data.other : '') +
                    '>' +
                        '<div class="centered col30 with-padding-right">' + $ctrl.LCS.getISBDiv(data.icon, data.iconLevel ? data.iconLevel : 2, 'gray') + '</div>' +
                        '<div class="centered ' + (data.hideIpad ? 'hide-ipad' : '')+'">' + data.action + '</div>' +
                    '</a>' +
                '</li>';
        }
    }
}


angular.module('page.tree.simple.controller.service.injector', [
    'page.controller.service.injector'
])
.service('PageTreeSimpleCtrlServiceInjector', PageTreeSimpleCtrlServiceInjector);
PageTreeSimpleCtrlServiceInjector.$inject = ['PageCtrlServiceInjector'];
function PageTreeSimpleCtrlServiceInjector(PageCtrlServiceInjector) {
/*options = {
    constantsService: constantsService,
    listsService : listsService,
    service: service,
    listOptionsService: listOptionsService,

    otherOptions: {
        listTreeServiceParams: {},
        keyboardServiceParams: {}
        sidebarOptions
        compOptions: {}, //also in page.simple
    }
}*/
    return function ($ctrl, $element, pageInjectors, printPageParams, otherOptions) {
        var predef = ['constantsService', 'service', 'listsService', 'listOptionsService'];
        $ctrl = new PageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams, otherOptions, predef);
        return $ctrl;
    }
}


angular.module('page.tree.simple.controller.service', [
    'page.tree.simple.controller.service.injector',
    'page.group.controller.service'
])
.service('PageTreeSimpleCtrlService', PageTreeSimpleCtrlService);
PageTreeSimpleCtrlService.$inject = ['PageTreeInitCtrlService',];
function PageTreeSimpleCtrlService(PageTreeInitCtrlService) {
    /*   options =  {
            constantsService: constantsService,
            listsService : listsService,
            service: service,
            listOptionsService: listOptionsService,

            otherOptions: {
                listTreeServiceParams: {},
                keyboardServiceParams: {}
                sidebarOptions
                compOptions: {}, //also in page.simple
            }
        }*/
    return function ($ctrl, $element, p) {
        console.log('PageTreeSimpleCtrlService');

        if(!$ctrl.onPageTreeInit) {
            $ctrl.onPageTreeInit = onPageTreeInit;
        }

        $ctrl = new PageTreeInitCtrlService($ctrl, $element, p);

        if($ctrl.postInitPageBg) {
            $ctrl.postInitPageBg();
        }

        return $ctrl;

        function onPageTreeInit() {
            $ctrl.listTreeService.preloadingType = $ctrl.PreloadingTypes[$ctrl.preloadingType];

            if(typeof($ctrl.onPageTreeInitOther) === 'function'){
                $ctrl.onPageTreeInitOther();
            }

            $ctrl.onPageInit();
        }
    }
}

angular.module('page.group.withbg.controller.service', [
    'components.imgEditor.service'
])
.service('PageWithBgCtrlService', PageWithBgCtrlService);
PageWithBgCtrlService.$inject = ['ImgEditorService'];
function PageWithBgCtrlService(ImgEditorService) {
    return function ($ctrl) {
        $ctrl.ImgEditorService = ImgEditorService;

        $ctrl.customBGForList = true;

        $ctrl.listParams = ['color', 'sideColors', 'background', 'backgroundId'].concat($ctrl.listParams);

        $ctrl.preInitPageBg = preInitPageBg;
        $ctrl.postInitPageBg = postInitPageBg;

        $ctrl.preInitPageBg();

        return $ctrl;

        function preInitPageBg() {
            $ctrl.getTreePopoverTemplateOther = getTreePopoverTemplateOther;
            if(!$ctrl.changeBackground) {
                $ctrl.changeBackground = changeBackground;
            }
            $ctrl.onUpdateOther = onUpdateOther;
            $ctrl.onCurrentTreeListChangedOther = onCurrentTreeListChangedOther;
            $ctrl.changeListBackground = changeListBackground;

            if(!$ctrl.onPageDestroyOther && !$ctrl.hasOnPageDestroyOther) {
                $ctrl.onPageDestroyOther = onPageWithBgDestroy;
            }
            $ctrl.onPageWithBgDestroy = onPageWithBgDestroy;
        }

        function postInitPageBg() {
            console.log('PageWithBgCtrlService.postInitPageBg');

            //after
            if($ctrl.hasTree) {
                $ctrl.sidebarOptions = _.extend({}, $ctrl.sidebarOptions, {
                    getNewTreePopupExtraParam: getNewTreePopupExtraParam,
                    changeBackground: $ctrl.changeBackground,
                    onCurrentTreeListChangedOther: $ctrl.onCurrentTreeListChangedOther,
                    onUpdateOther: onUpdateOther
                });
            }

            if($ctrl.canEdit) {
                if (!$ctrl.SettingsActions) {
                    $ctrl.SettingsActions = [];
                }
                $ctrl.SettingsActions.push({
                    id: 'btnChangeBackground',
                    name: 'Change Background',
                    icon: 'background-color',
                    iconLevel: 3,
                    type: 'changeListBackground',
                    active: true,
                    callDirectly: true
                });

                console.log('BACKGROUND_COLOR_CHANGED_' + $ctrl.elemType);

                $ctrl.addRootWatcher('BACKGROUND_COLOR_CHANGED_' + $ctrl.elemType, $ctrl.onCurrentTreeListChangedOther);
            }
        }

        function onCurrentTreeListChangedOther(list) {
            console.log('PageWithBgCtrlService.onCurrentTreeListChangedOther');
            if($ctrl.isPrintLayout){return;}
            var currentListId = getCurrentListId(null);

            if($ctrl.onCurrentTreeListChangedOther1){
                $ctrl.onCurrentTreeListChangedOther1();
            }

            if(list.removePreview){
                list = getCurrentList();
            } else {
                var isCurrent = list && currentListId === list._id;
                if (!(isCurrent || !isCurrent && list.isPreview)) {
                    return;
                }
            }

            var bg = 'none',
                bgColor = '',
                isTransp = false;

            if (list) {
                var prop = 'background';
                var url = list[prop];
                if (url) {
                    isTransp = true;
                    if(url !== 'custom') {
                        if (url.indexOf('-gradient') !== -1) { //linear background is set as background-image
                            bg = url;
                        } else if (url.indexOf('#') !== -1) {//bg color is set as background-color
                            //bg = url;
                            bgColor = url;
                        } else {
                            var path = list[prop + 'Id'] ? $ctrl.security.getLogoPath(list, prop, 'fullsize') : ($ctrl.LCS.uploadLogo + url);
                            bg = 'url("' + path + '")';
                        }
                        //for pattern gradients
                        if (list.sideColors && list.sideColors.top) {
                            bgColor = list.sideColors.top.color;
                        }
                    }
                }

                /*  var prop = 'color';
                  if (list[prop]) {
                      if (list[prop].indexOf('#') === 0) { //linear background
                          list[prop] = null;
                      } else {
                          isTransp = true;
                          bg = list[prop];
                      }
                  }*/
            }
            processBodyBG(isTransp, bg, bgColor);
        }

        function processBodyBG(isTransp, bg, bgColor) {
            if($ctrl.isPrintLayout){return;}
            var body = $ctrl.LCS.bodyElement;
            if (!body.style) {
                body.style = {};
            }
            if (isTransp) {
                if (bg && bg.indexOf('url') === 0) {//is background img
                    var src = bg.replace('url(\'', '')
                        .replace('url("', '')
                        .replace('")', '')
                        .replace('\')', '');
                    $ctrl.ImgEditorService.getFromImageUrl(src, 'image/webp', function (blob) {
                        if (blob) {
                            bg = 'url("' + blob.url + '")';
                            processImg();

                            $ctrl.LCS.timeout(function () {
                                $ctrl.ImgEditorService.revokeObjectURL
                                URL.revokeObjectURL(blob.url);
                            }, 1000);
                        }
                    });
                } else if(bgColor && bgColor.indexOf('#') === 0){
                    body.style.removeProperty('--body-bg-img');
                    var p = '--body-bg-gradient';
                    body.style.setProperty(p, bgColor);
                    process(p);
                } else {
                     processImg();
                }
            } else if (body.style) {
                body.style.removeProperty('--body-bg-img');
                process();
            }

            function processImg() {
                body.style.setProperty('--body-bg-img', bg);
                process();
            }

            function process(c) {
                var isColor = bgColor && bgColor.indexOf('#') === 0;
                body.style.setProperty('background-color', c ? c : ((!isTransp || isTransp && !bgColor) ? bgColor : '--body-bg'));

                if(isTransp){
                    set('mode-transparent', true);
                    set('lightmode', isColor && tinycolor(bgColor).isLight());
                } else {
                    set('mode-transparent lightmode');
                }

                function set(cls, isAdd){
                    $ctrl.LCS[isAdd ? 'addClass': 'removeClass'](body, cls);
                }
            }
        }

        function getNewTreePopupExtraParam() {
            //for colors
            return _.extend({
                currentList: getCurrentList(),
                onCurrentTreeListChangedOther: onCurrentTreeListChangedOther
            }, $ctrl.getPageTreeListPopupExtraParam ? $ctrl.getPageTreeListPopupExtraParam() : null);
        }

        function onUpdateOther(item){
            if($ctrl.onCurrentTreeListChangedOther &&
                item && !item.isFolder && item._id === getCurrentListId()) {
                $ctrl.onCurrentTreeListChangedOther(item);
            }
        }

        function getTreePopoverTemplateOther(item, isMobile, checkHasItems) {
            return item && !item.isFolder ? $ctrl.getSideMenuLi({
                type: 'changeBackground',
                action: 'Change Background',
                icon: 'background-color',
                iconLevel: 3,
            }) : '';

            /* + ($ctrl.isCurrent(item) ? '' : $ctrl.getSideMenuLi({
                 type: 'makeCurrent',
                 action: 'Make Current',
                 icon: 'save'
             }));*/
        }

        function changeBackground(item){
            item.step = 'step2';
            $ctrl.broadcastRoot('OPEN_UPDATE_' + $ctrl.elemType + '_TREE', item);
        }

        function changeListBackground(){
            if(getCurrentListId()) {
                changeBackground(getCurrentList());
            }

            // return $ctrl.editItem(item);
        }

        function onPageWithBgDestroy(){
            processBodyBG(false, true);
        }

        function getCurrentListId(defaultValue){
            return $ctrl.listTreeService && $ctrl.listTreeService.active ?
                $ctrl.listTreeService.active.selectedListId : defaultValue;
        }

        function getCurrentList(){
            return $ctrl.listTreeService && $ctrl.listTreeService.active ?
                $ctrl.listTreeService.active.selectedList : undefined;
        }
    }
}

 angular.module('group.sbPopover.controller.service', [
     'group.sbPopover.component'
])
.service('PopoverListInitCtrlService', PopoverListInitCtrlService);
 PopoverListInitCtrlService.$inject = ['CompInitCtrlService', 'TemplateCompileService'];
function PopoverListInitCtrlService(CompInitCtrlService, TemplateCompileService) {
    /*var options = {
        isTree  // popover in trewe
        parentContainer // parent to bind the popover to
        dontClosePopoverOnClick:  //forthose that dont work like dropdowns -> u need to make selectes on popovers first
    }*/
    return function ($ctrl, options) {
        console.log('PopoverListInitCtrlService ' + getSBTimestamp());
        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl);
        }
        $ctrl.hasPopoverListInit = true;
        $ctrl.currentPopoverAnchor = null;
        if(!options){options = {};}
        if(options.parentContainer){$ctrl.parentContainer = options.parentContainer;}
        if(options.popoverContainer){$ctrl.popoverContainer = options.popoverContainer;}

        if (!$ctrl) {
            console.warn('parent for PopoverListInitCtrlService must pass $ctrl parameter to PopoverListInitCtrlService');
        }

        var mustdefine;
        if(typeof($ctrl.getItemById)!=='function'){
            if (options.isTree && $ctrl.listTreeService === undefined) {
                console.warn('parent for PopoverListInitCtrlService must define $ctrl.listTreeService in parent for PopoverListInitCtrlService');
                mustdefine = true;
            }
            if (!options.isTree && $ctrl.list === undefined){
                mustdefine = true;
                console.warn('define $ctrl.getItemById in parent for PopoverListInitCtrlService');
            }
            if(!mustdefine){
                $ctrl.getItemById = getItemById;
            }
        }
        if (typeof($ctrl.getItemById)!=='function') {
            console.warn('define $ctrl.getItemById in parent for PopoverListInitCtrlService');
            //used when there is no list as on the breakdown page. to identify the row
        }

        if (!options.getGenerateContentMethod) {
            console.warn('define $ctrl.getGenerateContentMethod in parent for PopoverListInitCtrlService. The elements that are to open the popover must have class="with-sb-popover" and the prop popover-type="[type-of-popover]")');
        }

        $ctrl.PopoverTypes = {
            MORE: 'more-actions'
        };

        $ctrl.onRowClickPopover = onRowClickPopover;
        $ctrl.onListPopoverDestroy = onListPopoverDestroy;
        $ctrl.bindTreePopoverEvents = bindTreePopoverEvents;
        $ctrl.bindWatcherEvents = bindWatcherEvents;

        $ctrl.bindWatcherEvents(true);
        $ctrl.templatePopover = new TemplateCompileService(null, getCompileItemTemplate);


        if (typeof ($ctrl.getSideMenuLi) !== 'function') {
            $ctrl.getSideMenuLi = getSideMenuLi;
        }
        return $ctrl;

        function getEventType() {
            return (options.isTree ? $ctrl.keyboardService.TREE_CLICK_POPOVER :  ($ctrl.keyboardService.ROW_CLICK_POPOVER + $ctrl.currentListId));
        }

        function getItemById(id) {
            return options.isTree ? $ctrl.listTreeService.getNodeById(id) : $ctrl.list.getElementById(id);
        }

        function getCompileItemTemplate() {

            return '<sb-popover class="display-block clearfix" ' +
                    ($ctrl.withoutOpenedDrp!==undefined ? ('without-opened-drp="'+$ctrl.withoutOpenedDrp+'" ') : '') +
                    ($ctrl.parentContainer ? ('parent-container="'+$ctrl.parentContainer+'" ') : '') +
                    ($ctrl.popoverContainer ? ('popover-container="'+$ctrl.popoverContainer+'" ') : '') +
                    ($ctrl.popupPosition ? ('popup-position="'+$ctrl.popupPosition+'" ') : '') +
                    ($ctrl.popupPlacement ? ('popup-placement="'+$ctrl.popupPlacement+'" ') : '') +
                    ($ctrl.tabNextIndex ? ('tab-next-index="'+$ctrl.tabNextIndex+'" ') : '') +
                    (options.dontClosePopoverOnClick ?  'dont-close-popover-on-click="true"':'')  +

                    'anchor-element="::$ctrl.anchorElement" ' +
                    'on-close-drp="$ctrl.onCloseDrp()" ' +
                    'on-open-drp="$ctrl.onOpenDrp()" ' +
                    'generate-content="$ctrl.generateContent(drpMenuId)" ' + //is added to the ctrl scope
                '></sb-popover>';
        }

        function bindWatcherEvents(isBind) {
            if ($ctrl.popoverWatcher) {
                $ctrl.removeWatcher($ctrl.popoverWatcher);
            }
            if (isBind) {
                $ctrl.popoverWatcher = $ctrl.addRootWatcher(getEventType(), $ctrl.onRowClickPopover);
            }
        }

        function bindTreePopoverEvents(isBind) {
            console.log('bindTreePopoverEvents ' + $ctrl.elemType + ' bind: ' + isBind);
            if(isBind && $ctrl.isBindTreeTableEvents){
                process(false);
            }

            process(isBind);

            function process(isBind) {
                console.log('bindTreePopoverEvents.process: ' + isBind);

                $ctrl.keyboardService.initKeyboardEvents(true, isBind,  $ctrl.keyboardService.treeClass, null, $ctrl.element);
                $ctrl.isBindTreeTableEvents = isBind;
            }
        }

        function onRowClickPopover(result) { //when rows are being clicked
            //console.log('onRowClickPopover: currentListId=' + $ctrl.currentListId);
            var e = result.e,
                row = $ctrl.LCS.findClosestParent(e.target, $ctrl.keyboardService.getRowClass(options.isTree)),
                //import locations actions in the footer
                bottomRow = $ctrl.LCS.findClosestParent(e.target, '.table-bottom-actions'),
                isOnBottom = bottomRow !== undefined && bottomRow !== null;
            if (!row && !isOnBottom) {
                return;
            }

            var id = row ? row.getAttribute('data-id') : null,
                isAll = options.isTree && row ? row.getAttribute('data-isall') === 'true' : false,
                anchorElement = result.anchorElement,
                popoverType = anchorElement.getAttribute('popover-type');
            if (id === 'null') {
                id = null;
            } else if (id === 'undefined') {
                id = undefined;
            }
            if (options.isTree && $ctrl.selectedIdFieldIsNumber) {
                id = parseInt(id, 10);
            }

            if (isOnBottom) {
                id = 'isOnBottom';
            }
            if (id === undefined || !popoverType || $ctrl.currentPopoverAnchor === anchorElement) {
                return;
            }

            $ctrl.currentPopoverAnchor = anchorElement;
            var item = null;
            if (id !== 'isOnBottom') {
                item = $ctrl.getItemById(id, isAll, anchorElement);
                if (!item) {
                    return;
                }
            }
            $ctrl.templatePopover.loadTemplate(null, _.extend(options.getGenerateContentMethod(item, popoverType), {
                //tabNextIndex: '',
                anchorElement: anchorElement,
                onCloseDrp: onCloseDrp,
                //onOpenDrp: $ctrl.onOpenDrp,
            }), angular.element(anchorElement))
        }

        function onCloseDrp() {
            console.log('listPopover onCloseDrp');
            $ctrl.currentPopoverAnchor = null;
            onListPopoverDestroy();
        }

        function onListPopoverDestroy() {
            $ctrl.templatePopover.destroyNewScope();
        }

        function getSideMenuLi(data) {
            return (data.withTopBorder ? ('<li class="with-top-border ' + (data.liClass === 'hide-desktop' ? data.liClass : '') + '"></li>') : '') +
                '<li' + (data.id ? (' id="' + data.id + '"') : '') + ' ' + (data.liClass ? ('class="' + data.liClass + '" ') : '') + '>' +
                    '<a class="table-div full-width' +
                    (data.aClass ? (' ' + data.aClass) : '') + '" ' +
                    'analytics-on analytics-action="Open ' + data.action + '" ' +
                    'data-type="' + data.type + '" ' +
                    (data.param !== null && data.param !== undefined ? ('data-param="' + data.param + '" ') : '') +
                    (data.target ? ('target="' + data.target + '"') : '') +
                    (data.href ? (' href="' + data.href + '"') : '') +
                    '>' +
                        '<div class="col30">' + $ctrl.LCS.getISBDiv(data.icon, data.iconLevel ? data.iconLevel : 2, 'gray') + '</div>' +
                        '<div ' + (data.hideIpad ? 'class="hide-ipad"' : '') + '>' + data.action + '</div>' +
                    '</a>' +
                '</li>';
        }
    }
}


angular.module('group.sbPopover.events.service', [
    'group.sbPopover.controller.service'
])
    .service('PopoverInitEventsService', PopoverInitEventsService);
PopoverInitEventsService.$inject = ['PopoverListInitCtrlService'];
function PopoverInitEventsService(PopoverListInitCtrlService) {
    /*var options = {
        isTree:
        parentContainer: //class
onMorePopoverUpdate,
getMorePopoverTemplate -> must define in parent
onOtherPopoverTypes: onOtherPopoverTypes
    }*/
    return function ($ctrl, options) {

        //console.log('PopoverInitEventsService');
        if(!options){options = {};}

        if (!options.getMorePopoverTemplate) {
            console.warn('parent for PopoverInitEventsService must define $ctrl.getMorePopoverTemplate');
        }
        if (!options.withoutPopover && !$ctrl.hasPopoverListInit) {
                // '.' + $ctrl.tableClass
            $ctrl = new PopoverListInitCtrlService($ctrl, _.extend({}, options, {
                getGenerateContentMethod: getGenerateContentMethod
            }));
            $ctrl.onPopupEventsDestroy = onPopupEventsDestroy;

            bindTreePopoverEventsInit(true);
        }
        //todo
        // if ($ctrl.sTabindex !== undefined) {
        //     $ctrl.addRootWatcher('INPUT_TAB_' + $ctrl.sTabindex, onTab)
        // D D }

        return $ctrl;

        function onPopupEventsDestroy() {
            bindTreePopoverEventsInit();

            $ctrl.bindWatcherEvents(false);

            $ctrl.onListPopoverDestroy();
        }

        function bindTreePopoverEventsInit(isBind) {
            if($ctrl.eventBinded){
                p(false);
            }

            if(isBind) {
                p(true);
            }

            function p(isBind) {
                if (options.isTree) {
                    $ctrl.bindTreePopoverEvents(isBind);
                }
                $ctrl.eventBinded = isBind;
            }
        }

        function getGenerateContentMethod(item, popoverType) {
            if (!$ctrl.canEdit) {
                return;
            }

            return {
                generateContent: function (drpMenuId) {
                    var result = {
                        $ctrl: {
                            item: angular.copy(item),
                        }
                    };

                    //console.log('generateContent' + popoverType);

                    if (popoverType === $ctrl.PopoverTypes.MORE) {
                        result.$ctrl.onUpdate = typeof (options.onMorePopoverUpdate) === 'function' ? options.onMorePopoverUpdate : onMorePopoverInitUpdate;
                        result.$ctrl.getTemplate = options.getMorePopoverTemplate;

                        //tree-item-more-popover group-item-more-popover
                        var tag = options.isTree ? 'tree' : 'group';
                        result.template = '<' + tag + '-item-more-popover class="display-block clearfix" ' +
                            'id="' + drpMenuId + '" ' +
                            'item="::$ctrl.item" ' +
                            'get-template="$ctrl.getTemplate(item)" ' +
                            'on-update="$ctrl.onUpdate(result)" ' +
                            '></' + tag + '>';
                        return result;
                    }else{
                        result.$ctrl.onUpdate = $ctrl.onPopoverUpdate;
                        if (typeof (options.onOtherPopoverTypes) === 'function') {
                            return options.onOtherPopoverTypes(result, popoverType, drpMenuId);
                        }else{
                            console.warn('Must define onOtherPopoverTypes');
                        }
                    }

                    return null;
                }
            };
        }

        function onMorePopoverInitUpdate(result) {
            if (!result) {
                return;
            }
            //console.log('onMorePopoverInitUpdate');
            var e = result.e,
                item = result.item,
                target = e.currentTarget,
                method = target.getAttribute('data-type'),
                param = target.getAttribute('data-param');

            return process(item, method, param);

            function process(item, method, param) {
                if (typeof ($ctrl[method]) === 'function') {
                    return $ctrl[method](item, param, e);
                }
                return null;
            }
        }
    }
}

angular.module('group.sbPopover.component', [
    'group.sbPopover.service'
])
.component('sbPopover', {
    bindings: {
        withoutOpenedDrp:'@',
        anchorElement: '<?',
        tabNextIndex: '@',
        parentContainer: '@?',
        popoverContainer: '@?',
        popupPosition: '@?',
        popupPlacement: '@?',

        dontClosePopoverOnClick:'@',

        onCloseDrp:'&',
        onOpenDrp: '&',
        generateContent: '&',
    },
    controller: 'SbPopoverCtrl',
})
.controller('SbPopoverCtrl', SbPopoverCtrl);
SbPopoverCtrl.$inject = ['SbPopoverService', '$element'];
function SbPopoverCtrl(SbPopoverService, $element) {
    var $ctrl = this;

    $ctrl.$onInit = $onInit;
    $ctrl.$onDestroy = $onDestroy;

    function $onInit() {

        $ctrl.dontClosePopoverOnClick = $ctrl.dontClosePopoverOnClick === 'true' || $ctrl.dontClosePopoverOnClick === true;

        if (!$ctrl.popupPlacement) {
            $ctrl.popupPlacement = 'bottom';
        }
        if ($ctrl.parentContainer === undefined) {
            $ctrl.parentContainer = true;
        } else if($ctrl.parentContainer === 'false'){
            $ctrl.parentContainer = false;
        }

        if(!$ctrl.generateContent) {
            console.log('parent for SbPopoverCtrl must define $ctrl.generateContent');
        }

        $ctrl = new SbPopoverService($ctrl, $element);

        if($ctrl.withoutOpenedDrp !=='true' && $ctrl.withoutOpenedDrp !== true) {
            $ctrl.openDrp();
        }
    }

    function $onDestroy() {
        if ($ctrl.$onSbPopoverInitDestroy) {
            $ctrl.$onSbPopoverInitDestroy();
        }
    }
}

angular.module('group.sbPopoverInit.service', [
])
.service('SbPopoverInitService', SbPopoverInitService);
SbPopoverInitService.$inject = ['TemplateCompileService', 'CompInitCtrlService'];
function SbPopoverInitService(TemplateCompileService, CompInitCtrlService) {
    return function ($ctrl, $element) {
        var popper;

        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl);
        }

        $ctrl.timestamp = new ObjectId().toString();
        $ctrl.body = document.querySelector('body');

        $ctrl.$element = $element;
        $ctrl.element = $element[0];

        if ($ctrl.element === undefined) {
            console.log('parent for SbPopoverInitService must define $ctrl.element');
        }

        if(!$ctrl.getPopoverTemplate) {
            console.log('parent for SbPopoverInitService must define $ctrl.getPopoverTemplate');
        }

        if(!$ctrl.onkeydown) {
            console.log('parent for SbPopoverInitService must define $ctrl.onkeydown');
        }

        if(!$ctrl.getDrpMenu) {
            console.log('parent for SbPopoverInitService must define $ctrl.getDrpMenu');
        }

        if(!$ctrl.existsIn) {
            console.log('parent for SbPopoverInitService must define $ctrl.existsIn');
        }

        $ctrl.drpMenuId = 'drpMenu' + $ctrl.timestamp;

        if(!$ctrl.getAnchor){
            $ctrl.getAnchor = getAnchor;
        }

        if(!$ctrl.getDrpParent){
            $ctrl.getDrpParent = getDrpParent;
        }

        $ctrl.keyDownEvent = keyDownEvent;
        $ctrl.onTab = onTab;
        $ctrl.openDrp = openDrp;
        $ctrl.closeDrp = closeDrp;
        $ctrl.$onSbPopoverInitDestroy = $onSbPopoverInitDestroy;

        if(!$ctrl.getDefaultParent) {
            $ctrl.getDefaultParent = getDefaultParent;
        }

        return $ctrl;

        function getAnchor() {
            return $ctrl.popperAnchor ? $ctrl.popperAnchor : $ctrl.element;
        }

        function openPopper() {
            //console.log('openPopper');
            if($ctrl.withoutPopper){return;}
            if(!$ctrl.popoverContentContainer){
                $ctrl.popoverContentContainer = getPopoverContentContainer();
            }

            if(!$ctrl.popoverTemplateCompile) {
                //withoutTemplateScope is false
                $ctrl.popoverTemplateCompile = new TemplateCompileService(angular.element(getAnchorEl())
                   //, null , null, null, withoutTemplateScope
                );
            }

            var info = $ctrl.getPopoverTemplate();
            info.template = info.template.replace(info.template.split(' ')[0], info.template.split(' ')[0] + ' style="opacity:0!important"');
            var withoutRemove = true;
            $ctrl.popoverTemplateCompile.loadTemplate(onCompiledContainer, info.$ctrl, angular.element($ctrl.popoverContentContainer), info.template, withoutRemove);

            function onCompiledContainer(clonedElement) {
                $ctrl.drpMenuContainer = clonedElement;
                $ctrl.$drpMenuContainer = $ctrl.drpMenuContainer[0];

                $ctrl.getDrpMenu();

                //todo-> figure out when this happens - bind input events if is in poppup
                if (!$ctrl.drpMenu) {
                    //console.error('drpmenu must be defined for popper');
                    return;
                }

                popper = Popper.createPopper($ctrl.getAnchor(), $ctrl.drpMenu, getOptsV2());
                 if(!$ctrl.$drpMenuContainer.style) {
                    $ctrl.$drpMenuContainer.style = {};
                }
                $ctrl.$drpMenuContainer.style.removeProperty('opacity');


                if($ctrl.onPopperCreated){
                    $ctrl.onPopperCreated();
                }

                function getOptsV2() {
                    return {
                        placement: $ctrl.popupPlacement ? $ctrl.popupPlacement : 'bottom',
                        modifiers: [{
                            name: 'flip',
                            options: {
                                fallbackPlacements: 'bottom'
                                //$ctrl.popupPosition ? $ctrl.popupPosition.split(',').join() : ['top', 'bottom'],
                            },
                        },{
                            name: 'preventOverflow',
                            options: {
                                boundary: $ctrl.getDrpParent(),
                                rootBoundary: 'document',
                            },
                        }]
                    };
                }
            }
        }

        function hasParentContainer () {
            return $ctrl.parentContainer === 'true' || $ctrl.parentContainer === true;
        }

        function getDrpParent() {
            //console.log('check if to append to parent');
            if (!$ctrl.parentContainer) {
                return $ctrl.getAnchor();
            }
            var el = $ctrl.parentContainer && !hasParentContainer () ? document.querySelector($ctrl.parentContainer) : null;
            return el ? el : $ctrl.getDefaultParent($ctrl.element);
        }

        function getPopoverContentContainer() {
            var el;
            if($ctrl.popoverContainer){
                el = document.querySelector($ctrl.popoverContainer);
                if(el){return el;}
            }
            el = $ctrl.element.parentElement ? $ctrl.element : getAnchorEl();

           /* var el1 = getForPopover(el, 'popover-container');
            if(el1){
                return el1;
            }*/

            //always display in the container
            if(hasParentContainer ()){
                return $ctrl.getDefaultParent(el);
            }
            return $ctrl.parentContainer ? $ctrl.getDefaultParent(el, $ctrl.parentContainer) : el.parentElement;
        }

        function getAnchorEl() {
            return (typeof($ctrl.anchorElement) === 'string' ? $ctrl.element.querySelector($ctrl.anchorElement) :$ctrl.anchorElement);
        }

        function closePopper() {
            removeDrpMenu();
            if (popper && typeof (popper.destroy) === 'function') {
                popper.destroy();
            }
        }

        function removeDrpMenu() {
            if($ctrl.removeDrpMenuEvents) {
                $ctrl.removeDrpMenuEvents();
            }
            if($ctrl.popoverTemplateCompile){
                $ctrl.popoverTemplateCompile.destroyNewScope();
            }
            if ($ctrl.drpMenu) {
                $ctrl.drpMenu = null;
            }
        }

        function openDrp(e) {
            //console.log('check if to open dropdown');
            $ctrl.LCS.preventDefault(e);

            if (!$ctrl.isSOpen) {
                //console.log('open dropdown');

                $ctrl.isSOpen = true;
                $ctrl.LCS.timeout(function () {//to insure -drp-menu is added in doc
                    //console.log('openDrp: start open popper');
                    openPopper();

                    if ($ctrl.onOpenDrp) {
                        $ctrl.onOpenDrp();
                    }
                }, 10); //to allow for the dropdown object to be added to the page at 100

                $ctrl.LCS.timeout(function () {//to insure -drp-menu is added in doc
                    bindBodyClickInit(true);
                }, 300);
            }
        }

        function closeDrp(e) {
            if ($ctrl.isSOpen) {
                //console.log('close dropdown ' + $ctrl.prop);
                $ctrl.preventDefault(e);

                $ctrl.isSOpen = false;
                if ($ctrl.onCloseDrp) {
                    $ctrl.onCloseDrp(e);
                }
                $onSbPopoverInitDestroy();
            }
        }

        function onBodyClick(e) {
            //console.log('sbPopover.onBodyClick:' + $ctrl.drpMenuId + '; BUBBLING_PHASE ' + e.BUBBLING_PHASE);
            // if user click outside the popover or popover anchor -> close
            //if user clicks inside
            // if     dontClosePopoverOnClick - > close
            // dontClosePopoverOnClick - if user clicks on and makes a selection on the modal still keep it open
            var existsin = $ctrl.existsIn(),
                isInAnchor = processList(existsin.anchorElements),
                isInDrp = processList(existsin.drpMenu),
                isIn = isInAnchor || isInDrp;

            var dontClose;
            if ($ctrl.LCS.findClosestParent(e.target, '#' + $ctrl.drpMenuId)) {
                if ($ctrl.LCS.isMobileSize) {
                    if ($ctrl.LCS.findClosestParent(e.target, '#' + $ctrl.drpMenuId + ' > .dropdown-menu')) {
                        dontClose = true;
                    }
                } else {
                    dontClose = true;
                }
            } else if (isInAnchor) {
                if (!$ctrl.isSOpen || $ctrl.isDRP) {
                    dontClose = true;
                }
            } else if (isInDrp && $ctrl.dontClosePopoverOnClick) {
                //is click inside && dont close popover . process with work on popover
                //  $ctrl.preventDefault(e);
                if ($ctrl.dontClosePopoverOnClick === true || $ctrl.dontClosePopoverOnClick === 'true') {
                    dontClose = true;
                } else { // is a selector in the dropdown on which part if you click it won't close
                    try {
                        var el = existsin.drpMenu[0].querySelector($ctrl.dontClosePopoverOnClick);
                        if (el && isInElement(el)) {
                            dontClose = true;
                        }
                    } catch (ex) {
                    }
                }
            }

            if (!dontClose) {
                //console.log('onCustomDropDownClick:' + $ctrl.drpMenuId + '.closeDrp - isInDrp: ' + isInDrp + '; isInAnchor: ' + isInAnchor + '; dontClosePopoverOnClick: ' + $ctrl.dontClosePopoverOnClick);
                $ctrl.closeDrp(e);
            }

            function processList(ext) {
                if (ext && ext.length > 0) {
                    for (var i = 0, l = ext.length; i < l; i++) {
                        var el = ext[i];
                        if (el) {
                            if (isInElement(el)) {
                                return true;
                            }
                        }
                    }
                }
                return false;
            }

            function isInElement(el) {
                return !el || (e.target === el || $ctrl.LCS.hasChild(el, e.target));
            }
        }

        //becomes keydown for dropdown
        function keyDownEvent(e) {
            //console.log('keyDownEvent');
            $ctrl.onkeydown(e);
        }

        function onTab(e) {
            //console.log('onTab');
            if ($ctrl.tabNextIndex !== undefined) {
                document.querySelector("[tabindex='" + $ctrl.tabNextIndex + "']").focus();
            }
            $ctrl.closeDrp(e);
        }

        function bindBodyClickInit(isBind) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.body, onBodyClick, $ctrl.drpMenuId);
            if($ctrl.bindBodyClick){
                $ctrl.bindBodyClick(isBind);
            }
        }

        function $onSbPopoverInitDestroy() {
            bindBodyClickInit();
            closePopper();
        }

        function getForPopover(child, type){
            var popover = child.parentElement.getAttribute('popover-type');
            if(popover){
                var parentCls = child.parentElement.getAttribute(type ? type : 'parent-container');
                if(parentCls!=='false'){
                    var el = checkParent(child, parentCls);
                    if(el){
                        return el;
                    }
                }
            }
            return null;
        }

        function getDefaultParent(child, parent) {
            //isInModal
            var el;
            if (parent) {
                el = checkParent(child, parent);
                if (el) {
                    return el;
                }
            }
            /* if(!el){
                 el = getForPopover(child);
                 if(el){return el;}
             }*/

            var els = ['modal-dialog.scrollable-content', 'modal-dialog', 'sidebarScrollingContainer', 'form-wrapper',
                'group-init-wrapper .scrollable-content .group-wrapper',
                'group-simple-wrapper .scrollable-content .group-wrapper',
                'sb-scrolling-monitor'];

            for (var i = 0, l = els.length; i < l; i++) {
                el = checkParent(child, '.' + els[i]);
                if (el) {
                    // console.log('getDefaultParent: ' + els[i]);
                    return el;
                }
            }
            return $ctrl.body;
        }

        function checkParent(child, parent){
            return $ctrl.LCS.findClosestParent(child, parent);
        }
    }
}

angular.module('group.sbPopover.service', [
    'group.sbPopoverInit.service'
])
    .service('SbPopoverService', SbPopoverService);
SbPopoverService.$inject = ['SbPopoverInitService'];
function SbPopoverService(SbPopoverInitService) {
    return function ($ctrl, $element) {
        if (!$ctrl) {
            console.warn('parent for SbPopoverService must pass $ctrl parameter to BaseSBDropdownInitCtrl');
        }

        if(!$ctrl.getPopoverTemplate) {
            $ctrl.getPopoverTemplate = getPopoverTemplate;
        }

        if(!$ctrl.onkeydown) {
            $ctrl.onkeydown = onkeydown;
        }

        if(!$ctrl.getDrpMenu) {
            $ctrl.getDrpMenu = getDrpMenu;
        }
        $ctrl.existsIn = existsIn;
        var _this = new SbPopoverInitService($ctrl, $element);

       // _this.bindBodyClick = bindBodyClick;

        if(_this.$element && _this.$element.on) {
            _this.$element.on('$destroy', $onDestroy);
        }else{
            console.log('can not bind "on" for element');
        }

        console.log('addRootWatcher for CLOSE_POPOVER_'+_this.drpMenuId);
        $ctrl.addRootWatcher('CLOSE_POPOVER_'+_this.drpMenuId, function () {
            console.log('CLOSE_POPOVER_'+_this.drpMenuId);
            $ctrl.closeDrp();
        });
        return _this;

        function existsIn() {
            return {
                anchorElement: [_this.anchorElement,_this.element],
                drpMenu: [  _this.drpMenu]
            };
        }

        function bindBodyClick(isBind){
            _this.LCS.bindElementsClick(isBind, _this.body, onClick, _this.drpMenuId, 'keydown');

            function onClick(e){
                _this.LCS.timeout(function (){
                    _this.keyDownEvent(e);
                }, 0);
            }
        }

        function getPopoverTemplate() {
            return _this.generateContent({
                drpMenuId: _this.drpMenuId
            });
        }

        function onkeydown(e) {
            console.log('onkeydown');
            switch (e.which) {

                case 27: //esc
                    _this.closeDrp(e);
                    break;

                case  9: //tab -> make it save first and go next
                case 13: //enter  + tab next index
                    if (!_this.isSOpen) {
                        _this.openDrp(e);
                    } else {
                        _this.onTab(e);
                    }
                    break;

                default:
                    if (_this.onMoreKeys) {
                        _this.onMoreKeys(e);
                    } else {
                        _this.preventDefault(e);
                    }
                    break;
            }
        }

        function getDrpMenu() {
            var tag = 'dropdown-menu';
            get(tag);
            if (!_this.drpMenu) {
                get('parent-dropdown-menu');
            }

            if (!_this.drpMenu && _this.$drpMenuContainer.tagName.toLowerCase().indexOf(tag) !== -1) {
                _this.drpMenu = _this.$drpMenuContainer;
            }

            function get(tag) {
                _this.drpMenu = _this.LCS.hasClass(_this.$drpMenuContainer, tag) ? _this.$drpMenuContainer : _this.$drpMenuContainer.querySelector('.' + tag);
            }
        }

        function $onDestroy() {
            if (_this.$onSbPopoverInitDestroy) {
                _this.$onSbPopoverInitDestroy();
            }
        }
    }
}

angular.module('ctrl.PopupsCtrl.columnSettings.component', [
    'ctrl.columnSettings.controller.service'
])
.component('columnSettings', popupComponentParams('ColumnSettingsCtrl'))
.controller('ColumnSettingsCtrl', ColumnSettingsCtrl);
ColumnSettingsCtrl.$inject = ['ColumnSettingsCtrlService', 'ListItemTemplateFormCtrlService', '$element'];
function ColumnSettingsCtrl(ColumnSettingsCtrlService, ListItemTemplateFormCtrlService, $element) {
    var $ctrl = this;
    $ctrl.dontAutoloadTemplate = false;
    $ctrl.onInitOther1 = onInitOther1;
    $ctrl.getPopupHeader = getPopupHeader;
    $ctrl.getPopupFooter = getPopupFooter;

    $ctrl = new ColumnSettingsCtrlService($ctrl, $element, ListItemTemplateFormCtrlService);

    function onInitOther1() {
        $ctrl.getPopupBodyContent = $ctrl.getColumnsContent;
    }

    function getPopupHeader() {
        return '';
    }

    function getPopupFooter(foorterBtns, cls) {
        return '';
    }
}

angular.module('ctrl.columnSettings.controller.service', [
])
.service('ColumnSettingsCtrlService',ColumnSettingsCtrlService);
ColumnSettingsCtrlService.$inject = ['ListItemPopupTemplateCtrlService', 'FiltersCtrlService'];
//listTreeService, columnsPerRow
function ColumnSettingsCtrlService(ListItemPopupTemplateCtrlService, FiltersCtrlService) {
    return function ($ctrl, $element, listItemTemplateCtrlService) {

        $ctrl.preInitOther = preInitOther;
        $ctrl.setTemplateData = setTemplateData;
        $ctrl.changeColumn1 = changeColumn1;
        if(!$ctrl.openProPopup) {
            $ctrl.openProPopup = openProPopup;
        }

        $ctrl = new listItemTemplateCtrlService($ctrl, $element);

        return $ctrl;

        function setTemplateData(){
            if($ctrl.withBtnDisabled === undefined) {
                $ctrl.withBtnDisabled = true;
            }
            if($ctrl.withFooterBtns === undefined) {
                $ctrl.withFooterBtns = false;
            }
        }

        function openProPopup(type, e){
            $ctrl.CPS.openProPopup(e);
        }

        function preInitOther() {
            $ctrl.listTreeService = $ctrl.extraParam.listTreeService;
            if(!$ctrl.listTreeService){
                console.log('extraParam for parent popup for ColumnSettingsCtrlService must define listTreeService');
            }
            $ctrl.columnsPerRow = $ctrl.extraParam.columnsPerRow ? $ctrl.extraParam.columnsPerRow : 3;
            $ctrl.preChangeColumn = $ctrl.extraParam.preChangeColumn;
            $ctrl = new FiltersCtrlService($ctrl);
            $ctrl.getColumnsContent = getColumnsContent;

            if($ctrl.onInitOther1){
                $ctrl.onInitOther1();
            }
        }

        function changeColumn1(id, e) {
            var el = e.currentTarget;
            if (typeof ($ctrl.preChangeColumn) === 'function') {
                $ctrl.preChangeColumn({next: p});
            } else {
                p();
            }

            function p() {
                var isCol = $ctrl.isColumn(id);
                $ctrl.changeColumn(id, e);
                var checkbox = el.querySelector('input');
                if (checkbox) {
                    if(isCol) {
                        checkbox.removeAttribute('checked');
                    } else {
                        checkbox.setAttribute('checked', 'checked');
                    }
                }
                $ctrl.LCS[isCol ? 'removeClass' : 'addClass'](el.querySelector('.text-left'), 'active thick');
            }
        }

        function getColumnsContent() {
            var isSwitch = true,
                showPro = false,
            basic = processColumns(false),
            advanced = processColumns(true);
        return '<div class="form-group filters-shotlist centered columns-' + $ctrl.columnsPerRow + '">' +
                    getContent(basic, advanced ? 'Basic' : null) +
                    getContent(advanced, 'Advanced', true) +
                '</div>';

            function processColumns(isPro) {
                var cols = $ctrl.ColumnsList && $ctrl.ColumnsList.length > 0 ? _.filter($ctrl.ColumnsList.map(function (col) {
                    if(!col){return '';}

                    var cIsPro = col.quotaType;// && !$ctrl.CPS.hasQuotaType(col.quotaType);

                    if (isPro && !cIsPro || !isPro && cIsPro){
                        return '';
                    }

                    var isColPro = isPro && cIsPro && !$ctrl.CPS.hasQuotaType(cIsPro);
                    if(isColPro && !showPro) {
                        showPro = true;
                    }

                    var n = col.nameLong ? col.nameLong : (col.shortName ? col.shortName : col.name),
                        isDisabled = col.canHide !== true,
                        notInFilter = col.notInFilter;

                    if ($ctrl.isPrintLayout) {
                        if (notInFilter && col.inFilterPrint) {
                            notInFilter = false;
                        }
                        if (col.canHide === true && col.cantHidePrint === false) {
                            isDisabled = true;
                        } else if (col.canHide === false && col.canHidePrint === true) {
                            isDisabled = false;
                        }
                    }

                    if (n.length > 30) {
                        n = n.substring(0, 30) + '…';
                    }

                    if (!(notInFilter || isDisabled)) {
                        var isCol = $ctrl.isColumn(col.id),
                            allowToggleOnPro = true;
                        return '<li class="' + $ctrl.getBtnActionCls() + ' table-div with-cursor ' +
                            (isDisabled ? ' disabled' : '') +
                            (col.hide ? ' sb-hide' : '') + '" ' +
                            (!isDisabled ? (
                                'data-type="' + (isColPro && !allowToggleOnPro ? 'openProPopup' : 'changeColumn1') + '" data-info="' + col.id + '" ' +
                                (isColPro && !allowToggleOnPro ? ('data-quota="' + col.quotaType + '" analytics-on analytics-action="Column Settings col ' + col.name + '"') : '')
                            ) : '') +
                            '>' +
                            '<div class="custom-checkbox ' +
                            ($ctrl.pageClass ? $ctrl.pageClass : '') +
                            (isSwitch ? ' switch display-block' : ' inrow centered') +
                            (isDisabled ? ' disabled' : '') + '">' +
                            '<label' + (isSwitch ? ' class="i-switch radiobtn"' : '') + '>' +
                            '<input type="checkbox" ' +
                            (isCol ? 'checked="checked"' : '') +
                            (isDisabled ? 'disabled="disabled" ' : '') +
                            '>' + (isSwitch ? ('<i></i>') : ('<span></span>')) +
                            '</label>' +
                            '</div>' +
                            '<span class="text-left' + (isCol ? ' active thick' : '') + '">' + n + '</span>' +
                            '</li>';
                    }

                    return '';
                }), function (txt) {
                    return txt !== '';
                }) : null;
                return cols && cols.length > 0 ? cols : null;
            }

            function getContent(cols, label, isPro){
                return cols && cols.length > 0 ? (
                    (label ? ('<label class="header showlabel thin clearfix ' + (isPro? 'margin-top-30 spacing-quarter-bottom spacing-half-top' : 'spacing-quarter-bottom') + '">' + label +
                    (isPro && showPro ? ('<span class="profeature position-absolute margin-left10">PRO</span>') : '') + '</label>') : '') +
                    '<ul class="listitems-selector with-checked">' + cols.join('') + '</ul>'
                ) : '';
            }
        }
    }
}

angular.module('ctrl.popups.columnSettings.controller.service', [
    'ctrl.columnSettings.controller.service'
])
.service('ColumnSettingsPopupCtrlService', ColumnSettingsPopupCtrlService);
ColumnSettingsPopupCtrlService.$inject = ['ColumnSettingsCtrlService', 'ListItemPopupTemplateCtrlService'];

function ColumnSettingsPopupCtrlService(ColumnSettingsCtrlService, ListItemPopupTemplateCtrlService) {
    return function ($ctrl, $element) {
        $ctrl.onInitOther1 = onInitOther1;

        $ctrl = new ColumnSettingsCtrlService($ctrl, $element, ListItemPopupTemplateCtrlService);

        return $ctrl;

        function onInitOther1(){
            $ctrl.icon = 'cog';
            if ($ctrl.onInitOther) {
                $ctrl.onInitOther();
            }else{
                // $ctrl.icon = 'cog';
                 $ctrl.popupTitle = 'Adjust Columns';
                $ctrl.subdesc = 'Show or hide the following columns';

                $ctrl.modalBodyFormClass = $ctrl.columnsPerRow ? '' : 'long500';
                $ctrl.modalBodyFormClass = 'long500 padding-left-30';

                $ctrl.getPopupBodyContent = $ctrl.getColumnsContent;
            }
        }
    }
}

angular.module('ctrl.popups.confirm.component', [])
.component('confirmPopup', popupComponentParams('ConfirmPopupCtrl'))
.controller('ConfirmPopupCtrl', ConfirmPopupCtrl);

ConfirmPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', '$element'];
function ConfirmPopupCtrl(ItemTemplateCompileCtrlService, $element) {

    var $ctrl = this;

    $ctrl.isPopup = true;
    $ctrl.withCloseBtn = true;

    $ctrl.confirm = confirm;

    $ctrl.preInit = preInit;
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getDontShowAgain = getDontShowAgain;

    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.getAccordion = getAccordion;
    $ctrl.donShow = donShow;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInit() {
        if(!$ctrl.extraParam){ $ctrl.extraParam = {};}
    }

    function donShow(data, e){
        $ctrl.dontShowAgain = $ctrl.dontShowAgain === true ? false: true;
       var input = e.currentTarget.querySelector('input');
        if(input) {
            if ($ctrl.dontShowAgain) {
                input.setAttribute('checked', 'checked');
            } else {
                input.removeAttribute('checked');
            }
        }
    }

    function getDontShowAgain (){
       return '<div id="btnDontShow" class="form-group field spacing-half-top last"><div class="custom-checkbox small with-label col200 centered '+ $ctrl.pageClass+ ' ' + $ctrl.getBtnActionCls() + '" data-type="donShow"><label><input type="checkbox"><span><span> Don’t show me this again</span></span></label></div></div>';
    }
    function setTemplateData() {
      //  $ctrl.withCloseBtn = true;
         $ctrl.modalBodyFormClass = 'long380';
        $ctrl.icon = $ctrl.extraParam.icon;
        $ctrl.pageClass = $ctrl.extraParam.pageClass;
        $ctrl.iconLevel = $ctrl.extraParam.iconLevel;
        $ctrl.popupTitle = $ctrl.extraParam.title;
        $ctrl.btnText = $ctrl.extraParam.btn;
        $ctrl.firstBtnMethod = 'confirm';
        $ctrl.withFooterBtns = true;
    }

    function getPopupBodyContent() {
        var accordionParams = $ctrl.extraParam.accordion,
            el = $ctrl.extraParam.message +
                (accordionParams ? $ctrl.getAccordion(accordionParams) : '') +
                ($ctrl.extraParam.dontShowAgain ? $ctrl.getDontShowAgain() : '');

        return accordionParams ? ('<div class="accordion-with-list">' + el + '</div>') : el;
    }

    function getAccordion(res) {
    return '<div class="modal-accordion" uib-accordion close-others="true">' +
                '<div uib-accordion-group>' +
                    '<div class="question-wrap">' +
                        '<div uib-accordion-heading>' + res.title + '</div>' +
                        '<div class="spacing-quarter-top accordion-with-list">' + res.content + '</div>' +
                    '</div>' +
                '</div>' +
            '</div>';
    }

    function confirm(e) {
        $ctrl.preventDefault(e);
        $ctrl.broadcastRoot('HIDE_MOBILE_DETAILS');
        if ($ctrl.extraParam.onConfirm) {
            $ctrl.extraParam.onConfirm($ctrl.dontShowAgain ? {dontShowAgain: true} : null);
        }
        $ctrl.close();
    }
}

