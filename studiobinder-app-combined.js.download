    function onEditorCreated(editor) {

         var room = $ctrl.companyId + '_' + $ctrl.productId + '_' + $ctrl.document._id + '_' + $ctrl.item._id + 'htmlContent';
           console.log(room);
           Y({
               db: {
                   name: 'memory'
               },
               connector: {
                   name: 'websockets-client',
                   room: room,
                   socket: security.getSocket() // Pass socket.io object to use
               },
               // sourceDir: '/bower_components',
               share: {
                   richtext: 'Richtext' // y.share.richtext is of type Y.Richtext
               }
           }).then(function (y) {
               window.yQuill = y;
               window.quill = $ctrl.editorQ;   // create quill element
               y.share.richtext.bind(window.quill);   // bind quill to richtext type
           });
}
