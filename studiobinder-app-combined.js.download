                              '</button>' +
                        '</div>' +
                    '</div>  <!-- secondaryToolbar -->' +

                    '<div ng-if="$ctrl.openedAnnotations" id="annotationsToolbar" class="doorHangerRight annotationsToolbar" style="position: absolute;top:50px">' +
                        '<div style="position: relative">' +
                            '<button class="cursor" type="button" title="Cursor" data-tooltype="cursor">➚</button>' +

