    $ctrl.onPreInitOther = onPreInitOther;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ResendCallsheetPopupCtrlService($ctrl, $element);

    function onPreInitOther() {
        $ctrl.action = $ctrl.firstTime ? 'Send' : 'Resend';
        $ctrl.service = service;
        $ctrl.extraParam.service = $ctrl.service;
