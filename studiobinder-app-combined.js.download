        }

        if (!to) {
            to = this.gantt.options.value('toDate');
        }

        if (!from || (GanttMoment.isMoment(from) && !from.isValid())) {
            from = this.gantt.rowsManager.getDefaultFrom();
            if (!from) {
                return false;
            }
        }

        if (!to || (GanttMoment.isMoment(to) && !to.isValid())) {
            to = this.gantt.rowsManager.getDefaultTo();
            if (!to) {
