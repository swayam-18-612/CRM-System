TodoFilesGroupCtrl.$inject = ['TodoFilesGroupServiceCtrl', 'TodoFilesConstantsService', '$element'];
function TodoFilesGroupCtrl(TodoFilesGroupServiceCtrl, constantsService, $element) {
    console.log('TodoFilesCtrl');

    var $ctrl = this;
    $ctrl.afterProcessUpdatesOther = afterProcessUpdatesOther;

    $ctrl.hideEditBtn = false;

    $ctrl.isCallsheet = $element[0].getAttribute('code-name').indexOf('callsheet') !== -1;
    if($ctrl.isCallsheet){
        $ctrl.withBtnDownloadTxt = true;
        $ctrl.btnDownloadCls = 'co130 btn btn-small primary-faded without-text';
    }

    $ctrl = new TodoFilesGroupServiceCtrl($ctrl, $element, constantsService);

    function afterProcessUpdatesOther(result) {
        console.log('TodoFilesGroupCtrl.afterProcessUpdatesOther');
        if(result.removed && typeof($ctrl.onRemoved) === 'function'){
            $ctrl.onRemoved(result);
        }
        $ctrl.onUpdateStats({result: result});
    }
}

angular.module('product.todoFiles.group.controller.service', [
    'product.materials.page.service',
    'product.todoFiles.item.grid.component'
])
.service('TodoFilesGroupServiceCtrl', TodoFilesGroupServiceCtrl);
TodoFilesGroupServiceCtrl.$inject = ['FileStatsService', 'MaterialsGroupInitCtrlService'];
function TodoFilesGroupServiceCtrl(FileStatsService, MaterialsGroupInitCtrlService) {
     return function ($ctrl, $element, constantsService) {
        console.log('TodoFilesGroupServiceCtrl');

        $ctrl.totalSizeWrapperElCls = 'total-size-wrapper';
        $ctrl.totalSizeElCls = 'total-size';
        $ctrl.$onInit = $onInit;
        $ctrl.listItemsQuery = listItemsQuery;
        $ctrl.processListItemColumn = processListItemColumn;
        $ctrl.getTextFilesSizes = FileStatsService.getTextFilesSizes;
        $ctrl.getMoreBtnCls = getMoreBtnCls;

        $ctrl.getClipboardProcessingParamsOther = getClipboardProcessingParamsOther;
        $ctrl.afterProcessUpdates = afterProcessUpdates;

        $ctrl.getGridHeader = getGridHeader;
        $ctrl.onRemoved = onRemoved;
         $ctrl.viewFile = viewFile;

        return $ctrl;

        function $onInit() {
            $ctrl.parentId = $ctrl.currentListId;
            $ctrl.groupItemTag = 'todofiles';
            if(!$ctrl.btnText) {
                $ctrl.btnText = 'Upload Files';
            }

            $ctrl.recount = recount;
            // $ctrl.getViewTemplate = getViewTemplate;

            if(typeof ($ctrl.getBottomActions)!=='function') {
                $ctrl.getBottomActions = getBottomActions;
            }
            $ctrl.getInlineActions = getInlineActions;
           // var fileParams = {};// params like isParent codeName
            var fileParams = {
                filtersClass: 'small',
                isPredef: true,
                btnText: $ctrl.btnText,

                txtFileType: 'your files',
                multipleFiles: true,
                withShare: false,
                withDownload: true,
                withSubparentId: $ctrl.parentId,
                codeName: $ctrl.codeName,
                awsSignPath: $ctrl.awsSignPath,
                maxSize: $ctrl.maxSize
            };
            $ctrl.onReloadGroupTemplateOther = $ctrl.recount;
            $ctrl.options = constantsService.Settings;
            $ctrl.compOptions = JSON.stringify(constantsService.CompOptions);
            constantsService.ListParams = $ctrl.constantsService.ListParams;
            constantsService.PopupOperations = $ctrl.constantsService.PopupOperations;
            $ctrl = new MaterialsGroupInitCtrlService($ctrl, $element, fileParams, false, constantsService);
        }

         function getInlineActions(isHeader, item) {
             return (isHeader ? ('<div class="with-btn hide-print hide-ipad no-drag">&nbsp;</div>') :
                     ('<div class="btnDownload ' +
                         ($ctrl.btnDownloadCls ? 'col140' : 'with-btn') +
                         ' hide-print text-center one-line-tooltip no-drag">'+
                         '<a class="'+
                         ($ctrl.btnDownloadCls ? ($ctrl.btnDownloadCls +' ') : 'see-breakdown gray-light display-block without-text ') +
                         $ctrl.getClickEventName('getDownloadLink') +
                         '" ' +
                         ($ctrl.withBtnDownloadTxt ? '' : 'tooltip="Download" tooltip-placement="bottom" ')+
                         'analytics-on analytics-action="Download Attachment">' +
                         $ctrl.LCS.getISBDiv('download', 3, 'pull-left ' + ($ctrl.withBtnDownloadTxt? 'sbf18' : 'sbf24')) +
                         ($ctrl.withBtnDownloadTxt ? '<span class="with-margin-left">Download</span>' : '') +
                         '</a>'+
                         '</div>')) +
                      ($ctrl.canEdit && !$ctrl.hideEditBtn ?
                         (isHeader ? ('<div class="with-btn hide-print hide-ipad no-drag">&nbsp;</div>') :
                             ('<div class="with-btn hide-print no-drag text-center one-line-tooltip no-drag">'+
                              '<a class="see-breakdown display-block '+$ctrl.getClickEventName('edit')+'" tooltip="Rename" tooltip-placement="bottom" analytics-on analytics-action="Rename File">' +
                                  $ctrl.LCS.getISBDiv('pencil', 2, 'gray') +
                                 '</a>'+
                                 '</div>')) : '');
         }

         function afterProcessUpdates(result) {
             console.log('afterProcessUpdates');
             if(result) {
                 if(typeof ($ctrl.afterProcessUpdatesOther) === 'function') {
                     $ctrl.afterProcessUpdatesOther(result);
                 }
                 $ctrl.LCS.timeout($ctrl.recount, 100);
             }
         }

         function onRemoved(result) {
             console.log('on removed');
             if (result && result.removed) {
                 $ctrl.removeElementsInit(result.removed);
             }
             $ctrl.recount();
         }

         function getClipboardProcessingParamsOther(opType){ //to ensure the attachments counter will be updated on delete file
            return _.extend({}, $ctrl.getParams(), opType === 3 ? {onlyActive: true} : null);
        }

        function getMoreBtnCls() {
            return ' with-hover ';
        }

        function recount() {
            var count = $ctrl.getTextFilesSizes($ctrl.list);
            if(count === $ctrl.count){return;}
            $ctrl.count = count;
            if (!$ctrl.totalCountEl) {
                $ctrl.totalCountEl = $ctrl.element.querySelector('.' + $ctrl.totalSizeElCls);
            }
            if($ctrl.totalCountEl) {
                $ctrl.totalCountEl.innerHTML = $ctrl.count;
            }
            if (!$ctrl.totalSizeWrapperEl) {
                $ctrl.totalSizeWrapperEl = $ctrl.element.querySelector('.' + $ctrl.totalSizeWrapperElCls);
            }
            if ($ctrl.totalSizeWrapperEl) {
                $ctrl.LCS[$ctrl.list.totalCount > 0 ? 'removeClass' : 'addClass']($ctrl.totalSizeWrapperEl, 'sb-hide');
            }

            if(!$ctrl.canEdit && !count && typeof($ctrl.onGroupEmpty) === 'function'){
                $ctrl.onGroupEmpty();
            }
            if(typeof($ctrl.onRecount) === 'function') {
                $ctrl.onRecount({result: count});
            }
        }

        function listItemsQuery(item) {
            if(!item){return false;}
            return !item.isFolder && item.parentId === $ctrl.parentId;
        }

        function getGridHeader() {
        return '<h2 class="grid-title pull-right ' + $ctrl.totalSizeWrapperElCls + ' ' + ($ctrl.list.totalCount > 0 ? '' : 'sb-hide') + '">' +
                '<div class="subt">Total Size <span class="' + $ctrl.totalSizeElCls + '">' + $ctrl.getTextFilesSizes($ctrl.list) + '</span></div>' +
                '</h2>';
        }

        function getBottomActions() {
       return '<div class="add-more hide-print margin-bottom-half margin-top-30 table-bottom-actions font-general font-general-12">' +
                   '<div class="text-left">' +
                        '<button class="btn btn-small primary-faded ' + $ctrl.getBtnActionCls() + '" data-type="createNonNg" analytics-on analytics-action="' + $ctrl.btnText + '"'+
           '>' + $ctrl.LCS.getISBDiv('upload', 3, 'pull-left with-margin-right') + ' <div class="with-padding-left">' + $ctrl.btnText + '</div></button>' +
                   '</div>' +
               '</div>';
        }

        function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
            var version = item.isFolder ? null : item.version,
                versionId = version ? version.version : null,
                itemName = (item.isFolder ? item.name : (item.isFolder ? item.name : (versionId ? version.name : item.name)));
            if (!itemName) {
                itemName = ' ';
            }
            var itemTooltip = (itemName.length > 40 ? itemName : (item.isFolder ? item.name : (versionId ? version.name : item.name))).replace(/\'/g, "\\'"),
                ext = item.isFolder ? '' : $ctrl.getExtension(itemName),
                shortExt = ext ? $ctrl.getShortExtension(itemName) : '',
                createdAt = item.isFolder ? item.updatedAt : (item.version ? item.version.createdAt : null);
                createdAt = createdAt ? createdAt.format('MMM D, YYYY') : '';

            var el = '',
                size = (item.version ? $ctrl.getTextFileSize(item.version.size) : 0);
            if (c.prop === 'name') {
                 var s = $ctrl.getColumnByProp('size', true),
                 withView = !$ctrl.canEdit || !$ctrl.hideEditBtn,
                 vCls = $ctrl.getClickEventName('viewFile' + ' with-cursor');
             el += '<div class="folder-col no-large-column-padding hide-print ' + ($ctrl.canEdit ? vCls : '') + '">' +
                            $ctrl.getImage(item, $ctrl.isImage(item), ext, shortExt) +
                        '</div>' +
                        '<div class="one-line-tooltip grow-column name-col ' + (withView ? vCls : '') + '">' +
                            $ctrl.getDisplayItemCol(item, c, (withView ? 'with_underline' : ''), canEdit, textOnly, isMobile, isMobileRowDetails) +
((!isMobile &&s && s.isListSubtitle || isMobile) && !item.isFolder ? ('<div class="subname full-width italic">'+size+'</div>') : '') +
                        '</div> ';
            }
            else if (c.prop === 'size' && !isMobile && !c.isListSubtitle) {
                el += '<div class="size">' + size + '</div>';
            }

            return el;
        }

        function viewFile(item, e){
            $ctrl.popupsService.open(item.versionId, $ctrl.popupsService.operations.materialViewer, {
                 withDownload: true,
                withComments: false,
                canComment: false,
                canUpload: false,
                withoutSidebar: false,
                withHeader: true
            }, null, null, function (result){
                console.log('onSuccess');
            });
         }
    }
}


angular.module('product.todoFiles.list.component', [
    'product.todoFiles.init.controller.service'
])
.component('todoFiles', {
    bindings: todoFilesInitBindings(),
    controller: 'TodoFilesListCtrl'
})
.controller('TodoFilesListCtrl', TodoFilesListCtrl);
TodoFilesListCtrl.$inject = ['TodoFilesInitCtrlService', '$element'];

function TodoFilesListCtrl(TodoFilesInitCtrlService, $element) {
    var $ctrl = this;

    $ctrl.onPreInit = onPreInit;

    $ctrl = new TodoFilesInitCtrlService($ctrl, $element);

    function onPreInit() {
        $ctrl.quotaType = 'workflowAdvanced';
        $ctrl.block = 'todofiles';
        $ctrl.statsProp = 'attachments';
        $ctrl.currentListId = $ctrl.tasksCard._id;
        $ctrl.productId = $ctrl.tasksCard.productId;
        $ctrl.codeName = 'workflow';
        $ctrl.groupTable = 'todoCards';
        $ctrl.dontProcessG = true;
    }
}


function todoFilesInitBindings(){
    return {
        canEdit:'<',
        tasksCard: '<',
        isInModal: '<',
        onUpdateStats:'&'
    }
}

angular.module('product.todoFiles.init.controller.service', [
    'product.todoFiles.service.controller'
])
.service('TodoFilesInitCtrlService', TodoFilesInitCtrlService);
TodoFilesInitCtrlService.$inject = ['TodoFilesListServiceCtrl'];
function TodoFilesInitCtrlService(TodoFilesListServiceCtrl) {
   return function ($ctrl, $element){
       $ctrl.withShortHandleCol = 'col20';

        $ctrl.onUpdateGroup = onUpdateGroup;
        $ctrl.updateStats = updateStats;
        $ctrl.getStats = getStats;

        $ctrl = new TodoFilesListServiceCtrl($ctrl, $element);

        return $ctrl;

        function getUpdates(result){
            return result.updatesG && result.updatesG[$ctrl.groupTable] && result.updatesG[$ctrl.groupTable].set ? result.updatesG[$ctrl.groupTable].set[$ctrl.currentListId] : null;
        }

        function onUpdateGroup(result){
            console.log('onUpdateGroup');
            var updates = getUpdates(result)
            if(updates){
                $ctrl.tasksCard = _.extend($ctrl.tasksCard, updates);
                return updates;
            }
            return null;
        }

        function updateStats(result){
            var updates = getUpdates(result);
            if(updates){
                $ctrl.onUpdateStats({
                    result: {
                        custom: true,
                        newRes: result,
                        editchanges: _.extend({_id: $ctrl.currentListId}, updates)
                    }
                });
            }
        }

        function getStats() {
            return $ctrl.tasksCard.stats[$ctrl.statsProp] > 0 ? $ctrl.tasksCard.stats[$ctrl.statsProp] : 0;
        }
    }
}


angular.module('product.todoFiles.service.controller', [
    'apiConstants.materials.services',
    'product.todoFiles.group.component',
    'product.todoFiles.item.grid.component'
])
.service('TodoFilesListServiceCtrl', TodoFilesListServiceCtrl);
TodoFilesListServiceCtrl.$inject = ['PageSimpleInitCtrlService', 'MaterialConstantsService'];

function TodoFilesListServiceCtrl(PageSimpleInitCtrlService, constantsService) {
    return function($ctrl, $element){

        $ctrl.isInsideOtherPage = true;
        $ctrl.withoutCheatSheet = true;

        $ctrl.constantsService = _.clone(constantsService);

        if(!$ctrl.constantsService.GroupSettings){
            $ctrl.constantsService.GroupSettings = {};
        }
        if($ctrl.constantsService.GroupSettings.templateClsOther === undefined){
            $ctrl.constantsService.GroupSettings.templateClsOther = ' ';
        }

        var opts = $ctrl.constantsService.CompOptions;
        $ctrl = _.extend($ctrl, opts);
        $ctrl.compOptions = JSON.stringify(opts);

        $ctrl.$onInit = $onInit;
        $ctrl.$onDestroy = $onDestroy;

        $ctrl.getPageTemplate = getPageTemplate;
        $ctrl.onUpdateGroupInit = onUpdateGroupInit;
        if(!$ctrl.withPreloaderProperty) {
            $ctrl.withPreloaderProperty = withPreloaderProperty;
        }

        if(!$ctrl.getGridHeader){
            $ctrl.getGridHeader = getGridHeader;
        }

        if(!$ctrl.getStats) {
            $ctrl.getStats = getStats;
        }

        if(!$ctrl.updateStats) {
            $ctrl.updateStats = updateStats;
        }

        if(!$ctrl.onUpdateGroup) {
            $ctrl.onUpdateGroup = onUpdateGroup;
        }

        $ctrl = new PageSimpleInitCtrlService($ctrl, $element, {
            constantsService: $ctrl.constantsService
        });

        return $ctrl;

        function $onInit() {
            if(typeof($ctrl.onPreInit) === 'function'){
                $ctrl.onPreInit();
            }

            if(!$ctrl.quotaType) {
                $ctrl.quotaType = 'fileStorage';
            }
            if(!$ctrl.maxSize) {
                $ctrl.maxSize = 1048576 * 10; //10MB
            }
            $ctrl.multipleFiles = true;

            if(!$ctrl.gridTitle) {
                $ctrl.gridTitle = 'Attachments';
            }

            $ctrl.taskStatsCls = 'taskStatsEl';
            $ctrl.preLoadingTableName = 'Materials';
            if($ctrl.currentListId === undefined) {
                console.log('Parent for TodoFilesListServiceCtrl must define property $ctrl.currentListId');
            }

            var productId = $ctrl.productId ? $ctrl.productId : $ctrl.CPS.productId;

            $ctrl.awsSignPath = '/company/' + $ctrl.CPS.companyId + (productId ? ('/products/' + productId) : '') + '/' + $ctrl.codeName + '/' + $ctrl.currentListId + '/sign_s3';

            $ctrl.onSimplePageInit({
                withPreloaderProperty: $ctrl.withPreloaderProperty,
                preloadingType: $ctrl.PreloadingTypes[$ctrl.preLoadingTableName],
            }, startPreload);
        }

        function startPreload(preLoadingService){
            $ctrl.preLoadingService = preLoadingService;
            $ctrl.reloadPageTemplate(false,  function () {

            });
        }

        function updateStats(result){
            console.log('updateStats');
        }

        function getStats() {
            return 1;
        }

        function onUpdateGroup(result){
            console.log('onUpdateGroup');
            return null;
        }

        function $onDestroy() {
            $ctrl.onSimplePageDestroy();
        }

        function getPageTemplate() {
            return $ctrl.getGridHeader() +
                '<div class="todo-files-container side-borders-0">' +
                    '<div class="form-group alert alert-danger position-relative " ng-if="$ctrl.error"><span ng-bind-html="$ctrl.error|unsafe"></span></div>' +

                    '<todo-files-group class="display-block clearfix tree-node simple-group" ' +
                        'can-edit="$ctrl.canEdit" ' +
                        'data-id="' + $ctrl.currentListId + '" ' +
                        'current-list-id="' + $ctrl.currentListId + '" ' +
                        'pre-loading-service="::$ctrl.preLoadingService" ' +
                        'pre-loading-table-name="::$ctrl.preLoadingTableName" ' +
                        'constants-service="::$ctrl.constantsService" ' +
                        'comp-options="::null" ' +
                        'block="todofiles" ' +
                        'aws-sign-path="::$ctrl.awsSignPath" ' +
                        ($ctrl.codeName ? ('code-name="' + $ctrl.codeName + '" ') : '') +
                        'max-size="::$ctrl.maxSize" ' +
                        'btn-text="::$ctrl.btnText" ' +
                        'dont-process-g="::$ctrl.dontProcessG" ' +
                        ($ctrl.quotaType ? ('quota-type="'+$ctrl.quotaType+'" ') : '') +
                        ($ctrl.withShortHandleCol ? ('with-short-handle-col="'+$ctrl.withShortHandleCol+'"') : '') +
                        'on-update-stats="$ctrl.onUpdateGroupInit(result)" ' +
                        (typeof ($ctrl.onRecount) === 'function' ? 'on-recount="$ctrl.onRecount(result)" ' : '') +
                        ($ctrl.onGroupEmpty ? 'on-group-empty="$ctrl.onGroupEmpty()" ' : '') +
                    '></todo-files-group>' +
                '</div>' +
                (typeof ($ctrl.getGroupTemplateOther) === 'function' ? $ctrl.getGroupTemplateOther() : '');

        }
        function getGridHeader() {
            var c = $ctrl.getStats();
            return '<div class="pull-left subitem small-filters table-div">' +
                '<div class="col30 centered icon-absolute">'+ $ctrl.LCS.getISBDiv('attachment', 3) +'</div>' +
                '<div class="centered">' +
                    '<span>'+$ctrl.gridTitle+' </span>' +
                    '<span class="with-padding-left stats '+($ctrl.taskStatsCls ? $ctrl.taskStatsCls : '')+' ' + (c > 0?'':'sb-hide')+'">'+c+'</span>' +
                '</div>' +
            '</div>' +
            ($ctrl.subtitle && $ctrl.canEdit ? ('<p ng-if="$ctrl.getStats()===0" class="text-center">' + $ctrl.subtitle + '</p>') : '');
        }

        function onUpdateGroupInit(result1) {
            console.log('onUpdateGroupInit');
            var result = angular.copy(result1),
                updates = $ctrl.onUpdateGroup(result);
            if (updates) {
                var c = $ctrl.getStats();
                if (!$ctrl.taskStatsEl) {
                    $ctrl.taskStatsEl = $ctrl.element.querySelector('.' + $ctrl.taskStatsCls);
                }

                if ($ctrl.taskStatsEl) {
                    $ctrl.taskStatsEl.innerHTML = c;
                }
                $ctrl.LCS[c > 0 ? 'removeClass' : 'addClass']($ctrl.taskStatsEl, 'sb-hide');

                $ctrl.onUpdateStats({
                    result: {
                        custom: true,
                        newRes: result,
                        editchanges: _.extend({_id: $ctrl.currentListId}, updates)
                    }
                });
            }
        }

        function withPreloaderProperty() {
            return {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.productId//$ctrl.CPS.productId,
            }
        }
    }
}

angular.module('product.workflowPage.component', [
    'product.workflow.page.controller.service'
])

.component('workflowPage', {
    controller: 'WorkflowPageCtrl'
})

.controller('WorkflowPageCtrl', WorkflowPageCtrl);
WorkflowPageCtrl.$inject = ['WorkflowPageCtrlService', '$element'];
function WorkflowPageCtrl(pageCtrlService, $element) {
