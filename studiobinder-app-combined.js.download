function PatternGeneratorService( ) {
    return function () {
        var patterns = ["octogons", "overlappingCircles", "plusSigns", "xes", "sineWaves", "hexagons", "overlappingRings", "plaid", "triangles", "squares", "concentricCircles", "diamonds", "tessellation", "nestedSquares", "mosaicSquares", "chevrons"];
        var color,
            pattern = 0,
            result = GeoPattern.generate(null, {
            color: color || randomColor(),// Specify an exact background color. This is a CSS hexadecimal color value.
            baseColor: '#933c3c', //Controls the relative background color of the generated image. The color is not identical to that used in the pattern because the hue is rotated by the generator. This is a CSS hexadecimal color value, which defaults to #933c3c.
            generator: patterns[pattern !== undefined ? pattern : getRandomNumber(0, patterns.length - 1)] //Determines the pattern. All of the original patterns are available in this port, and their names are camelCased.
        });

       /* toString() //Gets the SVG string representing the pattern
        toSvg() //Gets the SVG string representing the pattern
        toDataUri()//Gets the pattern as a data URI,  i.e. data:image/svg+xml;base64,PHN2ZyB...
        toDataUrl()//Gets the pattern as a data URL suitable for use as a CSS. background-image, i.e. url("data:image/svg+xml;base64,PHN2ZyB...")
*/
        var next = (function () {
            var which = 0;
            return function () {
                return {
                    prev: which,
                    next: which = (which + 1) % 2
                };
            };
        }());

        var canvas = document.createElement('canvas');
        var saveButton = document.getElementById('save');

        var changeEvent = onChange($('#string'), function (val) {
            var pattern = GeoPattern.generate(val);

            var bg = next();

            var fadeOptions = {
                duration: 100,
                queue: false
            };
/*
<div id="bg-0" class="js-geopattern" style="display: none;"></div>
<div id="bg-1" class="js-geopattern" style=" ;"></div>
<input type="text" id="string" value="  start typing...  " autocomplete="off">
* */
            $('#bg-' + bg.next)
                .css('background-image', pattern.toDataUrl())
                .stop()
                .fadeIn(fadeOptions);
            $('#bg-' + bg.prev)
                .stop()
                .fadeOut(fadeOptions);

            prepareDownload(val, pattern);
        });

// Some browsers persist field values between refresh
        $(function () {
            $('#string')
                .val('  start typing...  ')
                .focus();
