angular.module('user.payment.failed.component', [
])
.component('paymentFailedPopup', popupComponentParams('PaymentFailedCtrl'))
.controller('PaymentFailedCtrl', PaymentFailedCtrl);
PaymentFailedCtrl.$inject = ['SettingsInitCtrlService','PaymentInitCtrlService','CompInitCtrlService', '$element'];
function PaymentFailedCtrl (SettingsInitCtrlService, PaymentInitCtrlService, CompInitCtrlService, $element) {
    console.log('PaymentFailedCtrl');
    var $ctrl = this;

    $ctrl = new CompInitCtrlService($ctrl);
    $ctrl.popupTitle = 'Payment Methods';
    $ctrl.updateCard = updateCard;

    $ctrl.close = close;
    $ctrl.getSettingsTemplate = getSettingsTemplate;
    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.isPaymentFailed = true;
        if($ctrl.withSignup === undefined) {
            $ctrl.withSignup = false;
        }

        PaymentInitCtrlService.loadPayment($ctrl, next, true);

        function next() {
            if (!$ctrl.info) {
                $ctrl.info = {};
            }
            $ctrl.info.addCard = true;
            $ctrl.whichForm = 1;

            $ctrl = new SettingsInitCtrlService($ctrl, $element);
        }
    }

    function updateCard(e) {
        $ctrl.changeCard(e, function (result) {
            $ctrl.whichForm = 2;
        });
    }
    
    function getSettingsTemplate() {
return  $ctrl.nonMobileCloseBtn() +
        '<div ng-switch on="$ctrl.whichForm" class="switch-container1">' +
            '<div ng-switch-when="1" class="switch-animation1">' +
                '<div class="modal-header clearfix margin-bottom-quarter">' +
                    '<h3 class="bold text-center font-size-24">Update Billing Details</h3>' +
                    '<p class="medium-size text-center">The last transaction on your card failed.<br/>Please enter a new card to continue.</p>' +
                '</div>' +
                '<div class="modal-body clearfix subscribe">' +
                    '<div class="pull-left">' + $ctrl.getPlanInfoForm() + '</div>' +
                    '<div class="pull-right"><div class="form-wrapper credit-card-section">' + $ctrl.getCreditCardForm(true) + '</div></div>' +
                '</div>' +
                '<div class="modal-footer clearfix semi-tall">' +
                    '<div class="form-wrapper text-center"><a class="btn btn-primary" ng-click="$ctrl.updateCard()" analytics-on analytics-action="Update Card" ng-class="{\'disabled\': !$ctrl.formHolder.card.$valid || $ctrl.isUpdating}" ng-disabled="!$ctrl.formHolder.card.$valid || $ctrl.isUpdating"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Update Card</a></div>' +
                '</div>' +
            '</div>' +
            '<div ng-switch-when="2" class="spacing-big">' +
                '<subscription-confirmation></subscription-confirmation>' +
                '<h3 class="bold">You successfully updated your credit card!</h3>' +
                '<p class="medium-size text-center">We\'ll process your payment shortly.</p>' +
            '</div>' +
        '</div>';
    }

    function close() {
        if (typeof ($ctrl.onClose) === 'function') {
            $ctrl.onClose({result:'cancel'});
        }
    }
}

