angular.module('product.preLoading.taskBoards.group.service', [
    'product.preLoading.init.group.service',
    'product.preLoading.taskBoards.service',
    'product.preLoading.todoCards.service'
])
 .service('TaskBoardsGroupLoadingService', TaskBoardsGroupLoadingService);
TaskBoardsGroupLoadingService.$inject = ['InitGroupLoadingService', 'TaskBoardsLoadingService', 'TodoCardsLoadingService'];
function TaskBoardsGroupLoadingService(InitGroupLoadingService, TaskBoards, TodoCards) {
    var Tbl = {}, TblTypes = {};

    _.each([TaskBoards, TodoCards], function (table){
        var name = table.name;
        TblTypes[name] = table.tableType;
        var tbl = {
            loadingService: table
        };

        if(name === 'TodoCards') {
            tbl.tableParamsColsInit = ['companyId'];
            tbl.withoutLoad = true;
        }
        Tbl[TblTypes[name]] = tbl;
    });

    return new InitGroupLoadingService(Tbl, 'isInitTaskBoards', {
        parent: TblTypes.TaskBoards,
        child: TblTypes.TodoCards
    }, TblTypes);
}

angular.module('product.preLoading.tasks.group.service', [
