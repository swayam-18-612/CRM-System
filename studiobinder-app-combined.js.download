function StoryboardConstantsService(SBFieldTypesService, ShotDefConstantsService, compOptions) {
    var popupTemplate = getBasePopupTemplateByTag('storyboard-edit');
    var PropTypes = SBFieldTypesService.PropTypes,

        CompOptions = angular.copy(compOptions),
        Options = {
            columns: [ '1', '2', '3', '4', '5', '6',
                // '7', '8', '9'
            ],
            view: 3,
            column: 3, ratio: 1, type: 1,
            orientation: 'portrait',
            showPrintBorders: true,
            showPrintIcons: true,
            showPrintBgColor: true,
            showPrintBgCardColor: true,
            showPrintFontColor: true,
            showPrintBorderColor: true,
        },

        Settings = _.extend(  {
            Columns:angular.copy(SBApiGridColumns['storyboards'](PropTypes, CompOptions.withLikesOnItem))
        }, ShotDefConstantsService.getDrps()),

        Filters = [{value: true, text: 'Active'}, {value: false, text: 'Archived'}],

        TreeTypes = [
            {value: compOptions.treeTypeScriptList, text: 'Imported Scenes'},
            {value: compOptions.treeTypeCustomList, text: 'Custom Boards'}
        ],


        ListTreeServiceParams = {
            moveInGroup: CompOptions.moveInGroup,
            hasTreeCopy: CompOptions.hasTreeCopy,
            hasTreeShare: CompOptions.hasTreeShare,

            level0Name: 'All Storyboards',
            preLoadingTableName: 'StoryboardsLists',

            maxLevel: 2,
            startIndent: 0,
            hideLevel0: true,
            withHarcodedAll: false,
            dontStartTreeWithAll: true,
            clickOnGroup: false
        },

        ListParams = {
            includeFields: ['listType', 'scriptId',
                'stripId', 'type', 'order', 'name', 'sceneNo', 'shotNo', 'customShotNo', 'logo', 'logoId', 'logoRatio', 'commentsCount', 'shotId', 'sound', 'video',
                'estTime',
                'status', 'note', 'noteStyle', 'todoColumnId'],
            searchFields: ['name'],
            orderFields: ['order'],
            populate: ''
        },

        KeyboardServiceParams = {
            canCopy: ListTreeServiceParams.hasTreeCopy,
            canMove: ListTreeServiceParams.moveInGroup,

            selectOnlyOnCheckmark: false,
            hasSelectedClass: false,
            hasOverlayClass: true,
           // selectOnCtrl: true,
            fullscreenList: null,
        },


        PopupOperations = _.extend( {
             createStoryboard: {
                type: 'Create',
                template: popupTemplate,
                size: 'medium',
                transp: ' ',
                backdrop: 'static'
            },

            duplicateStoryboard: {
                type: 'Duplicate',
                template: popupTemplate,
                size: 'medium',
                transp: ' ',
                backdrop: 'static'
            },

            updateStoryboard: {
                type: 'Edit',
                template: popupTemplate,
                size: 'medium',
                transp: ' ',
                backdrop: 'static'
            },

            createStoryboardsList: {
                type: 'Create',
                template: getBasePopupTemplateByTag('shot-group-item'),
                size: 'medium',
                transp: ' '
            },

            updateStoryboardsList: {
                type: 'Edit',
                template: getBasePopupTemplateByTag('shot-group-item'),
                size: 'medium',
                transp: ' '
            }
        }, ShotDefConstantsService.getPopups()),

        Hotkeys = [
            {key: 'e', desc: 'Edit selected frames', isCtrl: true},
            {key: 'c', desc: 'Copy selected frames', isCtrl: true},
            {key: 's', desc: 'Add frame under', isCtrl: true},
            {key: 'mod+x', desc: 'Cut selected frames', isCtrl: true},
            {key: 'v', desc: 'Paste selected frames', isCtrl: true},
            {key: 'backspace', desc: 'Delete selected frames', isCtrl: true}
        ],

        SidebarOptions = {
             addGroupPopupName: 'createStoryboardsList',
             editGroupPopupName: 'updateStoryboardsList',
            removeAdditionalMessage: ' and all the frames within it'
        };

    return {
        PropTypes: PropTypes,
        Settings: Settings,
        Options: Options,
        Filters: {Filters: Filters, TreeTypes: TreeTypes},
        ViewProp: 'storyboardView',

        CompOptions: CompOptions,
        ListTreeServiceParams: ListTreeServiceParams,
        ListParams: ListParams,
        KeyboardServiceParams: KeyboardServiceParams,

        PopupOperations: PopupOperations,
        Hotkeys: Hotkeys,
        SidebarOptions: SidebarOptions,
    };
}

