addMoSePa('Team', 'team', TempTeamService, {
    serviceInjectList: ['ResourcePathsService', 'Companies', 'TeamInvitations', 'Users', 'TeamConstantsService'],
    serviceInjectMod: [
        'apiServices.paths.service',
        'resources.Companies',
        'resources.TeamInvitations',
        'resources.Users',
        'apiConstants.teams.services'
    ]
});
function TempTeamService(ApiService, model, ResourcePathsService, Companies, TeamInvitations, Users, TeamConstantsService) {
    var service = ApiService(model, {
        listType: 'isGroup',
       // listField: 'teamListId',
        convertOtherResources: convertOtherResources
    });
    service.MemberTypes = TeamConstantsService.Settings.MemberTypes;
    service.Statuses = TeamConstantsService.Settings.Statuses;
    service.getPostPath = ResourcePathsService.getTeamPath;

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.getCompanyTeam = getCompanyTeam;
    service.inviteTeamMembers = inviteTeamMembers;
    service.getMemberType = getMemberType;
    service.isOwner = isOwner;
    service.isAdmin = isAdmin;
    service.getAll = getAll;

    return service;

    function isOwner(item) {
        return item.memberType === 2;
    }
    function isAdmin(item) {
        return item.memberType === 1;
    }

    function getMemberType(item) {
        if(!item){return null;}
        for (var i = 0, l = service.MemberTypes.length; i < l; i++) {
            var el = service.MemberTypes[i];
            if (el.value === item.memberType) {
                return el.text;
            }
        }
        return null;
    }
    function convertOtherResources(item) {
        if (item.companyId && typeof(item.companyId) === 'object') {
            item.company = new Companies(item.companyId);
            item.companyId = item.companyId._id;
        }

        var teamInvitation = item.teamInvitation;
        if (teamInvitation && typeof(teamInvitation) === 'object') {
            item.teamInvitation = new TeamInvitations(teamInvitation);
        }

        return item;
    }

    function getChangedFieldForUpdateOther() {
        return ['status', 'memberType', 'email', 'order', 'name', 'phone', 'userId', 'profilePictureURL', 'profilePictureURLId', 'teamInvitation'];
    }

    function getCompanyTeam(companyId, successcb, errorcb) {
        return service.getUrl('/company-team', {companyId: companyId}, successcb, errorcb);
    }

    function inviteTeamMembers(params, successcb, errorcb) {
        return service.postUrl('/invite-team-members', params, successcb, errorcb);
    }


    function getAll(data, pageSize, populate, successcb, errorcb) {
        if(pageSize){
            data.l = pageSize;
        }
        if(populate){
            data.populate = populate;
        }
        return service.getUrl('/all', data, successcb, errorcb);
    }
}

