addMoSePa('DocumentVersions', 'documentVersions', TempDocumentVersionsService,{
    serviceInjectList: ['ResourcePathsService', 'Documents', 'MaterialVersions', 'MomentService'],
    serviceInjectMod:[
        'apiServices.paths.service',
        'resources.Documents',
        'resources.MaterialVersions',
        'moment.service'
    ]
});
function TempDocumentVersionsService(ApiService, model, ResourcePathsService, Documents, MaterialVersions, MomentService) {
    var service = ApiService(model, {
        listType: 'isGroup',
        convertOtherResources: convertOtherResources
    });
    service.MomentService = MomentService;
    service.MaterialVersions = MaterialVersions;
    service.Documents = Documents;
    service.Colors = SBScriptColors;

    service.getExtension = getExtension;
    service.getFilename = getFilename;
    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.makeCurrent = makeCurrent;
    service.getDownloadLink = getDownloadLink;
    service.duplicate = duplicate;
    service.getNextColor = getNextColor;
    service.getColorStyle = getColorStyle;
    service.getColorStyleStr = getColorStyleStr;
    service.insertContentFileVersion = insertContentFileVersion;
    service.deleteVersionAndDoc = deleteVersionAndDoc;

    service.getDuplicate = getDuplicate;
    service.getUpdatedInfo = getUpdatedInfo;

    return service;

    function getDuplicate(item, other, items, noupdate){
        var newItem = _.extend({}, angular.copy(item), {
            _id: null,
            version: item.version ? (item.version + 1) : 1,
            subversion: 0
        }, other);


        return noupdate ? newItem : getUpdatedInfo(newItem, items);
    }

    function getUpdatedInfo(item, items){
        if (item.type !== 2) { return item;}
        var prevColor = item.color;
        item.color = getNextColor();
        item.name = (prevColor ? item.name.replace(getSufix(prevColor), '') :
            item.name).substring(0, 150) + getSufix(item.color);

        return item;

        function getSufix(color) {
            return ' - ' + _.find(service.Colors, {id: color}).name + ' Revision';
        }

        function getNextColor() {
            var max = items && items.length > 0 ? _.max(items, function (item) {
                return item.version;
            }) : item;

            return service.getNextColor(max ? max.color : null);
        }
    }

    function getExtension(type) {
        switch (type) {
            case 1:
                return 'SBDOC';
            case 2:
                return 'SBX';
            case 3:
                return 'SBAV';
        }
        return 'FILE';
    }

    function getFilename(cv, timestamp) {
        return getCleanedFilename(cv.name) + (cv.version ? (' v' + cv.version) : '') + ' ' + moment(timestamp).format('MM-DD-YY_HH-mm') + '.' + getExtension(cv.type).toLowerCase();
    }

    function getCleanedFilename(name){
        var char = '_';
        return (name ? (name.replace(/[^a-zA-Z0-9-_]/g, char)
            .replace(/ |@|,|:|–|\/|\\|\(|\)|\[|\]|\"|\|`|'|”|“/g, char)
            .replace(/_{2,}/g, char)) : (new ObjectId().toString()))
            .substring(0, 240);
    }

    function convertOtherResources(item) {
        if (item.lastSyncedScriptId && typeof (item.lastSyncedScriptId) === 'object') {
            item.lastSyncedScript = new model(item.lastSyncedScriptId);
            item.lastSyncedScriptId = item.lastSyncedScriptId._id;
        }

        if (item.lastSyncedContentId && typeof (item.lastSyncedContentId) === 'object') {
            item.lastSyncedContent = new service.MaterialVersions(item.lastSyncedContentId);
            item.lastSyncedContentId = item.lastSyncedContentId._id;
        }

        if (item.lastSyncedById && typeof (item.lastSyncedById) === 'object') {
            item.lastSyncedBy = new service.Users(item.lastSyncedById);
            item.lastSyncedById = item.lastSyncedById._id;
        }

        if (item.lastSyncedAt) {
            item.lastSyncedAt = service.MomentService.getMomentFromString(item.lastSyncedAt);
        }

        if (item.contentVersionId && typeof (item.contentVersionId) === 'object') {
            item.contentVersion = new service.MaterialVersions(item.contentVersionId);
            item.contentVersionId = item.contentVersionId._id;
        }

        if (item.materialVersionId && typeof (item.materialVersionId) === 'object') {
            item.materialVersion = new service.MaterialVersions(item.materialVersionId);
            item.materialVersionId = item.materialVersionId._id;
        }

        if (item.documentId && typeof (item.documentId) === 'object') {
            item.document = new service.Documents(item.documentId);
            item.documentId = item.documentId._id;
        }

        //av script version
        if(item.type === 3){
            item.parentId = null;
        }

        return item;
    }

    function getColorStyleStr(item, withoutBorder) {
        if (!item || item&&!item.color) {
            return null;
        }
        var c = getColor(item.color);
        return 'color:' + c.text + ';background-color:' + c.id + (!withoutBorder && c.border ? (';border:1px solid ' + c.border) : '');
    }

    function getColorStyle(item) {
        if(!item){return null;}
        var c = getColor(item.color),
            style = {'color': c.text, 'background-color': c.id};
        if (c.border) {
            style.border = '1px solid ' + c.border;
        }
        return style;
    }

    function getColor(color) {
        if (!color) {
            return service.Colors[0];
        }
        var c = _.find(service.Colors, function (el) {
            return el.id === color;
        });
        return c ? c : service.Colors[0];
    }

    function getNextColor(color) {
        var d = service.Colors;
        if(!color){return d[1].id;}
        var l = d.length, index;
        for (var i = 0; i < l; i++) {
            if (!color) {
                return d[0].id;
            } else if (d[i].id.toUpperCase() === color.toUpperCase()) {
                index = i;
                break;
            }
        }
        return d[index < l - 1 ? (index + 1) : 0].id;
    }

    function getChangedFieldForUpdateOther() {
        return ['name', 'color', 'version', 'notes', 'summary', 'scratchPad', 'titlePage', 'description'];
    }

    function makeCurrent(data, successcb, errorcb) {
        var path = ResourcePathsService.getDocumentsPath(data);
        return postUrl(path + '/change-version/' + data.id + '/' + data.versionId, data, successcb, errorcb);
    }

    function insertContentFileVersion(data, successcb, errorcb) {
        return postUrl(ResourcePathsService.getDocumentVersionsPath() + '/savefile/' + data.versionId, data, successcb, errorcb);
    }

    function deleteVersionAndDoc(data, successcb, errorcb) {
        return postUrl(ResourcePathsService.getDocumentVersionsPath() + '/delete-version/' + data.versionId, data, successcb, errorcb);
    }

    function getDownloadLink(params) {
        return ResourcePathsService.getDocumentVersionsPath() + '/download/' + params._id;
    }

    function postUrl(url, data, successcb, errorcb, withoutResourceObject) {
        return service.$post(url, data, successcb, errorcb, withoutResourceObject);
    }

    function duplicate(params, successcb, errorcb) {
        return postUrl(ResourcePathsService.getDocumentVersionsPath()+'/duplicate/'+params.versionId, params, successcb, errorcb);
    }
}

addMoSePa('EmailSettings', 'emailSettings', TempEmailSettingsService,{
    modelMethod: EmailSettingsFactory
});

function EmailSettingsFactory(ApiResource) {
    var model = ApiResource(SBApiCollections.EmailSettings);

    model.prototype.getName = function () {
        return this.name ? this.name : '';
    };

    return model;
}

function TempEmailSettingsService(ApiService,model) {
    var service = ApiService(model);

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;

