angular.module('apiServices.dexie.service', [
    'security.crypto.service'
])
.constant('dexie', window.Dexie)
.service('DexieService', DexieService);
//other option to check :https://github.com/mWater/minimongo
DexieService.$inject = ['API_CONFIGS', 'dexie', 'CryptoService'];
function DexieService(API_CONFIGS, dexie, CryptoService) {

    var configs = API_CONFIGS(),
        Configs = configs.indexedDB,
    DexieDB = function (name, key) {
        var _this = this;
        _this.stores = {};
        _this.cryptoService = setCryptoService(_this, key);
        _this.db = new Dexie(Configs.name ? Configs.name : configs.site.appName);
        _this.db.version(Configs.version ? Configs.version : 1);

        _this.openDb = openDb;
        _this.addStore = addStore;

        _this.insertList = insertList;
        _this.insert = insert ;

        _this.updateList = updateList;
        _this.update = update ;

        _this.removeList = removeList;
        _this.remove = remove;

        return _this;

        function openDb() {
            _this.db.stores(_this.stores);
            if (!_this.db.isOpen()) {
                _this.db.open();
            }
        }

        function addStore(name, scheme) {
            _this.stores[name] = scheme;
        }

        //db.people.bulkAdd([{name: "Foo"},{name: "Bar"}]);
        function insertList(collection, list, onSuccess, onError) {
            _this.db[collection].bulkAdd(list).then(onSuccess).catch(function (e) {
                console.log("Error: " + (e.stack || e));
                onError(e);
            });
        }

        function insert(collection, item, onSuccess, onError) {
            insertList(collection, [item], onSuccess, onError);
        }

        //db.friends.bulkPut([{id: 4, name: "Foo2", age: 34}, {id: 5, name: "Bar2", age: 44} ]);
        function updateList(collection, list, onSuccess, onError) {
            list.forEach(function (item) {
                _this.db[collection].put(item._id, item).then(onSuccess).catch(function (e) {
                    console.log("Error: " + (e.stack || e));
                    onError(e);
                });
            });
        }

        function update(collection, item, onSuccess, onError) {
            updateList(collection, [item], onSuccess, onError);
        }

        //db.friends.bulkDelete([1,2,4]);
        function removeList(collection, listIds, onSuccess, onError) {
            _this.db[collection].bulkDelete(listIds).then(onSuccess).catch(function (e) {
                console.log("Error: " + (e.stack || e));
                onError(e);
            });
        }

        function remove(collection, item, onSuccess, onError) {
            removeList(collection, [item], onSuccess, onError);
        }

        function setCryptoService(_this, key) {
            var crypto = CryptoService;
            if (crypto && crypto.isKey(key)) {
            }
            else {
                _this.cryptoService = new CryptoService(key);
            }
        }
    };

    return DexieDB;
}

angular.module('list.base.component.service', [
    'service.currentSettings.service',
    'services.rootEvents'
])
.service('CompInitCtrlService', CompInitCtrlService);
CompInitCtrlService.$inject = ['CPS', 'RootEventsService', 'SBFieldMethods'];
function CompInitCtrlService(CPS, RootEventsService, SBFieldMethods) {
    return function ($ctrl, noStateParams, dontSetDestroy) {
        $ctrl.compInitId = 'c'+(new ObjectId().toString());
        $ctrl.compLoaded = true;
        $ctrl.RootEventsService = RootEventsService;
        $ctrl.SBFieldMethods = SBFieldMethods;
        $ctrl.MomentService = SBFieldMethods.MomentService;
        $ctrl.CPS = CPS;
        $ctrl.LCS = CPS.LCS;
        $ctrl.security = CPS.security;
        $ctrl.API_CONFIGS  = CPS.API_CONFIGS;

        $ctrl.CurrentProduct = CPS.CurrentProduct;
        $ctrl.CurrentLocaleSettings = CPS.CurrentLocaleSettings;

        $ctrl.SBStateService = CPS.SBStateService;
        $ctrl.SessionService = CPS.SessionService;
        $ctrl.localizedMessages = CPS.localizedMessages;
        $ctrl.i18nNotifications = CPS.i18nNotifications;
        $ctrl.popupsService = CPS.popupsService;
        $ctrl.preventDefault = $ctrl.LCS.preventDefault;

        if (!$ctrl.watchers) {
            $ctrl.watchers = [];
        }
        $ctrl.broadcastRoot = RootEventsService.broadcastRoot;
        $ctrl.removeWatcher = RootEventsService.removeWatcher;

        $ctrl.addToObservable = addToObservable;
        $ctrl.addToRootObserver = addToRootObserver;
        $ctrl.addRootWatcher = addRootWatcher;
        $ctrl.addRootWatcherSimple = addRootWatcherSimple;
        $ctrl.removeWatchers = removeWatchers;
        $ctrl.addOnStateChange = addOnStateChange;


        $ctrl.setCompEditValue = setCompEditValue;

        if(!$ctrl.$onDestroy && !dontSetDestroy){
            console.log('$ctrl.$onDestroy = removeWatchers');
            $ctrl.$onDestroy = removeWatchers;
        }

        init();

        return $ctrl;

        function init() {
            $ctrl.companyId = $ctrl.CPS.companyId;
            $ctrl.scriptId = $ctrl.CPS.scriptId;
            setCompEditValue();
            //todo figure out where to set this
            if(!noStateParams) {
                $ctrl = _.extend($ctrl, $ctrl.CPS.loadStateDataParams());
                //in popup title is overwritten by the title from data params
                if($ctrl.initTitle){
                    $ctrl.title = $ctrl.initTitle;
                }
            }
        }

        function setCompEditValue(){
            if($ctrl.cantSetEditValue){return;}
            if ($ctrl.canEdit === undefined) {
                $ctrl.canEdit = $ctrl.CPS.canEdit;
            }
            if ($ctrl.canComment === undefined) {
                $ctrl.canComment = $ctrl.CPS.canComment;
            }
        }

        function addOnStateChange(onStateChanged) {
            $ctrl.addRootWatcherSimple($ctrl.SBStateService.onStateChanged(onWatcher));

            function onWatcher(newState) {
                if (newState && newState !== '') {
                    init();
                }
                console.log('onStateChanged');
                onStateChanged(newState);
            }
        }

        function addRootWatcher(prop, method) {
            //console.log('addRootWatcher: '+prop);
            return RootEventsService.addRootWatcher($ctrl.watchers, prop, method);
        }

        function addRootWatcherSimple(watcher) {
            return RootEventsService.addRootWatcherSimple($ctrl.watchers, watcher);
        }

        function addToRootObserver(prop, onChange, isTrue) {
            return RootEventsService.addToRootObserver($ctrl.watchers, prop, onChange, isTrue);
        }

        function addToObservable(scope, prop, onChange, isTrue) {
            return RootEventsService.addToObservable($ctrl.watchers, scope, prop, onChange, isTrue);
        }

        function removeWatchers(watchers) {
            RootEventsService.removeWatchers(watchers ? watchers : $ctrl.watchers);
        }
    }
}

//https://github.com/indrimuska/angular-selector/blob/master/src/angular-selector.js
//based on angular-dropdowns module by http://github.com/jseppi


function sbDrpMenuComponentParams(controllerName, bindings, template) {
    var el = {
        bindings: _.extend({
            withSaveOnTouchScreen: '@',
            drpClassAttr: '@?',
            fixedHeight: '@?',

            labelField: '<',
            valueField: '<',

            truncate: '<',
            itemClss: '<',
            //variables:

            strList: '<',
            value: '<',
            onSelect: '&'
        }, bindings ? bindings : null)
    };

    if (template) {
        el.template = template;
    }

    if (controllerName) {
        el.controller = controllerName;
    }
    return el;
}

function sbDefaultDrpComponentParams(bindings) {
    return _.extend({
        drpClassAttr: '@?',
        initList: '<',

        placeholder: '@',

        itemLabel: '@',
        itemValue: '@',

        fixedHeight: '@',
        truncate: '@',

        drpName: '<?',

        isRequired: '<?',

        fieldClass: '@',
        elemClass: '@',
        itemClss: '@',
        resetValue: '<',
        startInFocus: '@'
    }, bindings ? bindings : null);
}

function sbDrpComponentParams(controller, bindings, template){
    return sbFieldComponentParams(controller, sbDefaultDrpComponentParams(bindings), template ? template :
            //getSBDropdownTemplate()
        ('<div class="selected"><input class="dropdown-sel-text selected-text with-cursor" readonly="readonly"/></div>')
    );
}

function getSBDropdownTemplate(cls){
    return '<div class="selected with-span-text' + (cls ? (' ' + cls) : '') + '"><div id="spanItemText" class="span-text"></div><input class="dropdown-sel-text selected-text with-cursor" readonly="readonly"/></div>';
}

function sbPageDrpComponentParams(controller, bindings, ) {
    return sbDrpComponentParams(controller, bindings, getSBDropdownTemplate());
}

