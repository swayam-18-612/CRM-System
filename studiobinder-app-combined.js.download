angular.module('components.mentio.highlight.filter', [])
    .filter('mentioHighlight', mentioHighlightFilter);
function mentioHighlightFilter() {
    function escapeRegexp (q) {
        return q.replace(/([.?*+^$[\]\\(){}|-])/g, '\\$1');
    }

    return function (matchItem, query, hightlightClass) {
        if (query) {
            var replaceText = hightlightClass ?
                '<span class="' + hightlightClass + '">$&</span>' :
                '<strong>$&</strong>';
            return ('' + matchItem).replace(new RegExp(escapeRegexp(query), 'gi'), replaceText);
        } else {
            return matchItem;
        }
    };
}

/*http://jeff-collins.github.io/ment.io*/
angular.module('components.mentio', [
    'components.mentio.directive',
    'components.mentio.menu.directive',
    'components.mentio.menuItem.directive',
    'components.mentio.highlight.filter',
    'components.mentio.run'
