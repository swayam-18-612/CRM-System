angular.module('user.dashboardPage.myProjects.component', [
    'user.dashboardPage.widget.component.service',
    'apiConstants.myProjects.services',
    'user.dashboardPage.myProjectsGroup.component'
])
.component('myProjects', {
    bindings: getDashboardWidgetGroupBindings(),
    controller: 'MyProjectsCtrl'
})
.controller('MyProjectsCtrl', MyProjectsCtrl);
MyProjectsCtrl.$inject = ['DashboardWidgetCtrlService', 'MyProjectsConstantsService', 'CPS', '$element'];
function MyProjectsCtrl(DashboardWidgetCtrlService, constantsService, CPS, $element) {
    console.log('MyProjectsCtrl');
    var $ctrl = this;
    $ctrl.CPS = CPS;
    $ctrl.DashboardWidgetCtrlService = DashboardWidgetCtrlService;
    $ctrl.preInitOther = preInitOther;
    $ctrl.getOtherParams = getOtherParams;
    $ctrl.onPreloadedService = onPreloadedService;
    $ctrl.preProcessGroupItems = preProcessGroupItems;

    $ctrl.ViewProjectAction = 127;
    $ctrl = new $ctrl.DashboardWidgetCtrlService($ctrl, constantsService, $element);

    function preInitOther(constantsService) {
        $ctrl.rowLoadNow = true;
        var c = angular.copy(constantsService);
        //on the my comments page
        c.GroupSettings = _.extend({}, c.GroupSettings, {
            teamAvatarCls: 'small20',
            withTeamUnder: true,
            isMyProjects: true,
            dragHandleOnTheSide: false,
            withoutGroupSorting: true,
            showSortingColumns: false,
            gridItemClass: ' '
        });

        c.Settings.Columns = _.extend({}, c.Settings.Columns);

        var id = '5';
        c.Settings.Columns[id] = _.extend({}, c.Settings.Columns[id], {//teamIds
            currentId: $ctrl.CPS.teamId,
            canEdit: false
        });
        id = '1';
        c.Settings.Columns[id] = _.extend({}, c.Settings.Columns[id], {//avatar
            canEdit: false
        });
        $ctrl.constantsService = c;
    }

    function getOtherParams() {
        return {
            teamId: $ctrl.CPS.teamId,
            type: $ctrl.ViewProjectAction//viewproject
        };
    }

    function preProcessGroupItems(item) {
        if (!item || item.active === false) {
            return null;
        }
        var teamIds = [], team = [];
        _.each(_.unique(item.teamIds), function (id) {
            var el = _.find($ctrl.team, {_id: id});
            if (el) {
                if ($ctrl.CPS.teamId === el._id) {
                    teamIds.unshift(el._id);
                    team.unshift(el);
                } else {
                    teamIds.push(el._id);
                    team.push(el);
                }
            }
        });
        item.teamIds = teamIds;
        item.team = team;
        return item;
    }

    function onPreloadedService(err, result) {
        $ctrl.team = $ctrl.SessionService.getSetting('team');
        $ctrl.Settings = _.extend({}, $ctrl.Settings, {team: $ctrl.team});

        $ctrl.other = result;
        $ctrl.products = $ctrl.other ? $ctrl.other.products : null;
    }
}

