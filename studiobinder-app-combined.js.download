                MentionBlot.className = 'mention';

                Quill.register(MentionBlot, true);
            }

            loadedModules.mentions = true;
        }
    }

    function registePagination(BlotService, config) {
        if(!config.modules.toolbar){
            config.modules.toolbar = [];
        }

        config.modules.toolbar.push(['pagination']);
        config.modules.pagination = {
            // userText: "{page}",
            //autoText: '{page}',

        };
       return loadPagination(BlotService);
    }

    function registerWordCount(BlotService, config) {
        config.modules.wordCount = true;
        if (!loadedModules.wordCount) {
            var QuillWordCount = /** @class */ (function () {
                /**
                 * Instantiate the module given a quill instance and any options
                 * @param {Quill} quill
                 * @param {Object} options
                 */
                function WordCount(quill, props) {
                    var _this = this;
                    // save the quill reference
                    _this.elId = 'quill-word-count';
                    _this.elLabel = 'word';
                    _this.quill = quill;
                    _this.props = props;
                    _this.container = this.quill.container;
                    _this.quill.on('text-change', _this.update.bind(this));
                    _this.update();  // Account for initial contents
                }

                WordCount.prototype.calculate= function (){
                    var _this = xthis;
                    let text = _this.quill.getText().trim();
                    // Splitting empty text returns a non-empty array
                    _this.quill.wordCount = text.length > 0 ? text.split(/\s+/).length : 0;
                    return _this.quill.wordCount;
                }

                WordCount.prototype.update = function() {
                    var _this = this;
                    let length = _this.calculate();
                    let label = _this.elLabel;
                    if (length !== 1) {
                        label += 's';
                    }
                    if(!_this.toolbar) {
                        _this.toolbar = _this.quill.getModule('toolbar');
                    }
                    let countView = document.getElementById(_this.elId);
                    if (!countView) {
                        let countView = document.createElement('span');
                        countView.id = _this.elId;
                        _this.toolbar.container.appendChild(countView);
                    }
                    if(countView) {
                        countView.innerHTML = length + ' ' + label;
                    }
                }
                return WordCount;
            }());

            Quill.register('modules/wordCount', QuillWordCount);
            loadedModules.wordCount = true;
        }
    }

    function loadPagination(BlotService){
