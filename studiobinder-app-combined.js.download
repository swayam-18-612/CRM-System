            /*   case 'animal': //categories
              //case 'bulb': //screenwriting outline
                   return 4;
*/
            //case 'warning-circle'://ScriptOutlineIcons
            //case 'info-circle':
            //case 'notes':
            //case 'dollar':
            //case 'contacts-unassigned':
            //case 'versions'://versions popup
            //case 'card':
            //case 'freeform':
            //case 'eye-hidden'://callsheet
            //case 'desktop'://callsheet
            //case 'pdf-break'://callsheet
