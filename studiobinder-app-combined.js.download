            var tagText = getTagText(tag);

            if(!tagText){ return {valid: false, message:'Invalid tag' };}
            if(tagText.length < options.minLength){return {isValid: false, message:'Email must have at least '+options.minLength +' characters' };}
            if(tagText.length > options.maxLength){return {isValid: false, message:'Email must have at most '+options.maxLength +' characters' };}
            if(!options.allowedTagsPattern.test(tagText)){return {isValid: false, message:'This is not a valid email address' };}
            if(tiUtil.findInObjectArray(self.items, tag, options.keyProperty || options.displayProperty)) {return {isValid: false, message:'This email already exists in this list. Please remove.'};}

            return {isValid: true};
