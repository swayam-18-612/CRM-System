])
.component('customizeCallsheetRecipientsPopup', popupComponentParams('CustomizeCallsheetRecipientPopupCtrl'))
.controller('CustomizeCallsheetRecipientPopupCtrl',CustomizeCallsheetRecipientPopupCtrl);
CustomizeCallsheetRecipientPopupCtrl.$inject = ['InvitationsBulkActionPopupCtrlService', '$element'];
function CustomizeCallsheetRecipientPopupCtrl(InvitationsBulkActionPopupCtrlService, $element) {
    var $ctrl = this;

    $ctrl.setTemplateData = setTemplateData;

    $ctrl = new InvitationsBulkActionPopupCtrlService($ctrl, $element);

    function setColumns() {
        var columnsList = [];
        if ($ctrl.editType === 'calltime' || $ctrl.editType === 'both') {
            columnsList.push({
                name: 'Calltime',
                formGroupClass: 'form-group field last',
                type: $ctrl.SBFieldTypesService.PropTypes.Calltime,
                placeholder: 'Calltime',
                prop: 'calltime',
                tabIndex: 1,
                tabNextIndex: 2,
               hasRemove: false,
                parentContainer: true,
                canEdit: true,
                timeFormat: $ctrl.CPS.timeFormat
            });
        }
        if ($ctrl.editType === 'personalNote' || $ctrl.editType === 'both') {
            columnsList.push({
                name: 'Message',
                formGroupClass: 'form-group field margin-top-half last',
                type: $ctrl.SBFieldTypesService.PropTypes.Html,
                prop: 'personalNote',
                tabIndex: 3,
                tabNextIndex: 4,
                isRequired: true,
                canEdit: true,
                placeholder: 'Add Message (optional)…',
                withBottomToolbar: true
                //    capitalizeFirst: true,
            });
        }
        $ctrl.columnsList = columnsList;
    }
    function setTemplateData() {

        $ctrl.withLabel = $ctrl.editType === 'both';
            $ctrl.icon = getIcon($ctrl.editType);
        $ctrl.popupTitle = 'Edit ' + getItem($ctrl.editType);
        $ctrl.btnText = '<span>Save</span><span class="hide-ipad"> ' + getItem($ctrl.editType)+'</span>';
        $ctrl.withFooterBtns = true;
        $ctrl.withBtnDisabled = true;
        $ctrl.textAnalytics = $ctrl.popupTitle;
        setColumns();
    }

    function getIcon(editType) {
        switch (editType) {
            case 'calltime': return 'clock';
            case 'personalNote': return 'bnote';
            case 'both': return 'clock';
        }
    }
    function getItem(editType) {
        switch (editType) {
            case 'calltime': return 'Call Time';
            case 'personalNote': return 'Private Note';
            case 'both': return 'Call Time';
        }
    }
 }

