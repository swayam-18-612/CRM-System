function TaggingelementsMergePopupCtrl(MergeItemsCtrlService, $element) {
    var $ctrl = this;
    $ctrl.isPopup = true;

    $ctrl.preInitMerge = preInitMerge;

    $ctrl = new MergeItemsCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitMerge() {
        $ctrl.table = 'taggingElements';
        $ctrl.name = $ctrl.extraParam.name + 's';
        $ctrl.popupTitle = 'Merge Elements';
        $ctrl.subdesc = 'Are you sure you want to merge '+$ctrl.count+' ' + $ctrl.name+'? The newly merged elements will replace all existing instances of these ' + $ctrl.name+' in the stripboard and breakdowns';

        $ctrl.item = _.extend($ctrl.item, {
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId,
            scriptId: $ctrl.CPS.scriptId,

        });
    }
}

angular.module('product.elements.list.unlink.component', [
    'ctrl.PopupsCtrl.generalItemEdit.service'
])
.component('taggingelementsUnlinkPopup', popupComponentParams('UnlinkElementPopupCtrl'))

.controller('UnlinkElementPopupCtrl', UnlinkElementPopupCtrl);
UnlinkElementPopupCtrl.$inject = ['GeneralItemEditCtrlService', '$element'];
function UnlinkElementPopupCtrl(GeneralItemEditCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;
    
    $ctrl.preSetTemplateData = preSetTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneral() {
        $ctrl.name = $ctrl.extraParam.name + 's';
        $ctrl.item[$ctrl.listField] = $ctrl.extraParam.currentListId;

        $ctrl.item = _.extend($ctrl.item, {
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId,
            scriptId: $ctrl.CPS.scriptId
        });
    }

    function preSetTemplateData() {
        $ctrl.icon = 'delete-link'
        $ctrl.popupTitle = 'Are you sure?';
        $ctrl.btnText = '<span>Unlink</span><span class="hide-ipad"> Element</span>';
    }

    function getPopupBodyContent() {
        return '<p class="text-center">Are you sure you want to unlink <span class="semibold ' + ($ctrl.item.type === 1 ? 'uppercase' : '') + '">' + $ctrl.item.name + '</span>?<br/> A new element will be created and <span class="semibold">' + $ctrl.item.sceneIds.length + '</span> tag' + ($ctrl.item.sceneIds.length !== 1 ? 's' : '') + ' will be associated with it.</p>';
    }
}

angular.module('product.elements.list.viewScenes.component', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'services.downloadExport'
])
.component('viewScenesPopup', popupComponentParams('ViewScenesPopupCtrl'))
.controller('ViewScenesPopupCtrl', ViewScenesPopupCtrl);
ViewScenesPopupCtrl.$inject = ['GeneralItemEditCtrlService', 'DownloadExportService', '$element'];
function ViewScenesPopupCtrl(GeneralItemEditCtrlService, DownloadExportService, $element) {
    var $ctrl = this;

    $ctrl.DownloadExportService = DownloadExportService;

    $ctrl.isPopup = true;

    $ctrl.download = download;

    $ctrl.preSetTemplateData = preSetTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.preInitGeneral = preInitGeneral;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneral() {
        $ctrl.content = '';
        $ctrl.strips = $ctrl.extraParam.strips;
        if ($ctrl.extraParam.scriptLoadingService) {
            $ctrl.scriptLoadingService = $ctrl.extraParam.scriptLoadingService;
        }
        $ctrl.loadTags = true;
        $ctrl.withTagging = false;
    }

    function preSetTemplateData() {
        $ctrl.modalBodyFormClass = 'max-width';
        $ctrl.withBtnDisabled = false;
        $ctrl.withFooterBtns = false;

        $ctrl.icon = 'sides';
        $ctrl.popupTitle = 'View Scenes For Element';
        if($ctrl.item && $ctrl.item.name) {
            $ctrl.subtitle = $ctrl.item.name.toUpperCase();
        }
    }

    function getPopupBodyContent() {
        var el = '';
        _.each($ctrl.strips, function (strip, i) {
            if(strip) {
                el += getViewStep(strip, i);
                $ctrl.content += '';
            }
        });
        return el;
    }

    function getViewStep(strip, i) {
        return '<div class="sceneEditorWrapper document-version-wrapper screenplay-tagging centering"> ' +
            '<scene-tagging ' +
            "class='clearfix display-block' " +
            "id='scene" + strip._id + "' " +
            "item='::$ctrl.strips["+i+"]' " +
            "script-loading-service='::$ctrl.scriptLoadingService' " +
            "with-tagging='::$ctrl.withTagging' " +
            "load-tags='::" + ($ctrl.loadTags === true) + "' " +

            "tagging-scenes='::null' " +
            "categories='::null' " +
            "elements='::null' " +

            "max-font-size='::$ctrl.maxFontSize' " +
            "min-font-size='::$ctrl.minFontSize' " +
            "doc-wrapper-class='::$ctrl.docWrapperClass' " +
        "side-margin='true'" +

            '></scene-tagging>' +
            '</div>';
    }

    function download(e) {
        $ctrl.preventDefault(e);
        var content = $ctrl.content;
        if (content) {
            $ctrl.DownloadExportService.downloadAttachment($ctrl.DownloadExportService.createBlobFromContent('scenes.sbx', content));
        }
    }
}

