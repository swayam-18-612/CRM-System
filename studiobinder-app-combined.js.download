       // registerTableModule(config);


    }

    function registerBubbleEditor(config, withSaveBtn, withCancelBtn) {
        //config.theme = 'bubble';
        registerFullInfo(config);
        var toolbar = [
            [formatsb],
            [listsb],
            [{'color': []}, {'background': []}],          // dropdown with defaults from theme
            [mediasb],
            ['clean']                                         // remove formatting -button
        ];

        addSaveBtns(config, toolbar, withSaveBtn, withCancelBtn);
        config.modules.toolbar = toolbar;
    }

    function registerDocEditor(config) {

        registerFullInfo(config);

        var icons = Quill.import('ui/icons');
        icons['hr'] = '<svg viewBox="0 0 448 512" class="ql-stroke ql-fill"><path d="M432 256c0 17.7-14.3 32-32 32L48 288c-17.7 0-32-14.3-32-32s14.3-32 32-32l352 0c17.7 0 32 14.3 32 32z"/></svg>';


        var toolbar = [
            [{'header': [1, 2, 3, false]}], //4, 5, 6,
            [{'size': sizeWhitelist}],
            [formatsb, {'color': []}, {'background': []}],          // dropdown with defaults from theme
            [mediasb],
            [{'align': []}],
            listsb,

            [{'indent': '-1'}, {'indent': '+1'}],          // outdent/indent
            ['clean'],                                         // remove formatting button

            //  [{ 'font': [] }],
            // [{'header': [1, 2, 3, false]}], //4, 5, 6,
            // [{'size': sizeWhitelist}],
            // ['blockquote', 'code-block'],
            // [{ 'header': 1 }, { 'header': 2 }],               // custom button values
            // [{ 'script': 'sub' }, { 'script': 'super' }],      // superscript/subscript
            //[{ 'direction': 'rtl' }],                         // text direction
            // [{ 'size': ['small', false, 'large', 'huge'] }],  // custom dropdown
            //[{'align': []}],
            //[{'indent': '-1'}, {'indent': '+1'}],          // outdent/indent
        ];

       // addSaveBtns(config, toolbar, false, false, true);
        config.modules.toolbar = toolbar;
    }
 
    function registerFullEditor(config, type, withSaveBtn, withCancelBtn) {
        registerFullInfo(config);

        var isDocs = type === 'notes';


        var toolbar = getToolbarInfo(type);
        addSaveBtns(config, toolbar, withSaveBtn, withCancelBtn);

        config.modules.toolbar = toolbar;

        if(isDocs && LCS.isDebugMode){
            registerTableModule(config);
        }

        function getToolbarInfo(type){
            var isSimplified = type === 'editorsimple',
                isTitle = type === 'titlepage',
                isBreakdowns = type === 'breakdownscene',
                isTaskCard = type === 'taskcard',
                isCover = type === 'pagecover',
                isCustomNote = type === 'customnote',
                isScratchpad = type === 'scratchpad',
                isScratchpadshort = type === 'scratchpadshort',

                header = [{'header': isDocs ? [1, 2, 3, 4, 5, 6, false] : [1, 2, 3, false]}],
                font;

            if(isCustomNote) {
                var fonts = [ 'opensans', 'helvetica', 'arial','arialblack', 'verdana', 'tahoma', 'trebuchet', 'impact', 'gill', 'times','georgia', 'palatino', 'baskerville', 'courier', 'lucida', 'monaco', 'bradley',
                        'brushscript', 'luminari', 'comic'];
                    font = [{ 'font': fonts}];

                // Add fonts to whitelist
                var Font = Quill.import('formats/font');

                Font.whitelist = fonts;
                Quill.register(Font, true)
            }

              var  m = isCustomNote ?  [font, header] :
                    ((isTitle || isCover || isDocs || isScratchpad) ? [
                        header,
                        (isScratchpadshort ? [] : [{'size': ['small', 'normal', 'large', 'huge'] }]),  // custom dropdown
                    ] : ((isBreakdowns||isTaskCard) ? [header]:[])),
                  l = [formatsb];

            m.push(l);
            if(!isCover && !isTaskCard&&!isCustomNote&&!isScratchpadshort) {
               // l = l.concat([{'color': []}, {'background': []}]);
                m.push([{'color': []}, {'background': []}]);
            }
            l = [];
            if(!isSimplified && !isBreakdowns && !isTaskCard&&!isScratchpadshort) {
                l.push({'align': []}); // remove formatting button
            }

            if(isScratchpad && !(isTitle || isCover) || isDocs || isBreakdowns || isTaskCard || isScratchpadshort){
                l.push(listsb);
            }
            if(l.length>0) {
                m.push(l);
            }
            if( isScratchpadshort) {
                m.push([mediasb]);
                m.push(['hr']);
            } else{
                m.push([mediasb, 'emoji', 'hr']);
            }

            if(isDocs){

            }

         //   m.push(['markdown']);
          //  m.push([elssb]);

            m.push(['clean']);

            return m;
        }
    }

    function registerLocalStorageModule(config) {
        config.modules['local-storage'] = {
            timeout: 60, //the number of minutes until the value of the contents in local storage are no longer placed in the editor.
            key: config.user._id, // the key used to store "drafts" in localstorage
        };

        loadModuleLocalStorage();
    }

    function registerAuthorshipModule(config) {
        config.modules.authorship = {
            enabled: true,
            authorId: config.user._id, // Current author id
            color: config.user.color // Current author color
        };

        loadModuleAuthorship();
    }

    function registerCommentsModule(config) {
        var user = config.user;
        config.modules.toolbar.push(['comments-toggle', 'comments-add']);

        config.modules.comment = {
            enabled: true,
            commentAuthorId: user._id,
            commentAddOn: user.name, // any additional info needed
            color: user.color, // comment background color in the text
            commentAddClick: commentAddClick, // get called when `ADD COMMENT` btn on options bar is clicked
            commentsClick: commentsClick, // get called when you click `COMMENTS` btn on options bar for you to do additional things beside color on/off. Color on/off is already done before the callback is called.
            commentTimestamp: commentServerTimestamp,
        };

        loadModuleComment();

        function commentAddClick(callback) {
            var _this = this;
            var quill = _this.quill;
            var containerId ;
            if (!containerId) {
                containerId = 'inline-comment';
            }
            var range = quill.getSelection();
            var text = quill.getText(range.index, range.length);
            if (text.length < 1) {
                return;
            }
            var atSignBounds = 0;
            var containerMask = document.createElement('div');
            containerMask.id = "inline-comment-mask";
            containerMask.style.width = "100%";
            containerMask.style.height = "100%";
            containerMask.style.top = "0px";
            containerMask.style.position = "fixed";
            containerMask.style.display = "block";
            var container = document.createElement('div');
            container.id = containerId;
            container.classList.add('inline-comment');
            quill.container.appendChild(container);
            quill.container.appendChild(containerMask);
            container.style.position = "absolute";
            container.innerHTML = '<textarea class="commentText" placeholder="Type your comment"></textarea><div class="inline-comment-bottom"><span class="inline-send">Send</span> <span class="inline-cancel">Cancel</span>  </div>';
            container.style.left = (0 - 250) + "px";
            if (0 + 250 < quill.container.clientWidth) {
                container.style.left = (atSignBounds.left) + "px";
            }
            container.style.top = 10 + atSignBounds.top + 0 + "px";
            container.style.zIndex = 80;
            document.querySelector('.commentText').focus();
            var inlineCancel = document.querySelector('.inline-cancel');
            var commentToolTip = document.querySelector('.inline-comment');
            LCS.bindElementListeners(true, inlineCancel, onCancel);

            var inlineSend = document.querySelector('.inline-send');
            LCS.bindElementListeners(true, inlineSend, onSend);
            function onCancel() {
                commentToolTip.style.display = "none";
                containerMask.style.display = "none";
            }
            function onSend() {
                var commentId = new ObjectId().toString();
                var commentStatus = 'resolved';
                var commentObj = {};
                var commentText = document.querySelector('.commentText').value;
                commentObj.comment = commentText;
                if (typeof (commentId) !== 'undefined') {
                    commentObj.id = commentId;
                }
                if (typeof (commentStatus) !== 'undefined') {
                    commentObj.resolved = commentStatus;
                }
                commentToolTip.remove();
                containerMask.remove();
                callback(commentText);
            }
        }

        function commentServerTimestamp() {
            // call from server or local time. But must return promise with UNIX Epoch timestamp resolved (like 1507617041)
            return new Promise(function (resolve, reject) {
                window.setTimeout(function () {
                    resolve(thisPromiseCount);
                }, Math.round((new Date()).getTime() / 1000));
            });
        }

        function commentsClick() {
            // comments btn callback
        }
    }

    function registerInlineCommentModule(config) {
        //https://github.com/contentco/quill-inline-comment/blob/master/src/module-inline-comment.js
        config.modules.toolbar.push(['comment']);
        config.modules.inline_comment = true;

        loadModuleInlineComment();
    }

    function registerImageModule(config) {
        loadModuleImage(config);
    }

    function registerCursorsModule(config) {
        //https://github.com/reedsy/quill-cursors
        config.modules.cursors = true;

        loadModuleCursors();
    }

    function addTableToToolbar(){

    }

    function registerTableModule(config) {
        var maxRows = 10, maxCols = 5;
        var tableOptions = [];
        for (var r = 1; r <= maxRows; r++) {
            for (var c = 1; c <= maxCols; c++) {
                tableOptions.push('newtable_' + r + '_' + c);
            }
        }
        if (!config.modules.toolbar) {
            config.modules.toolbar = [];
        }
        config.modules.toolbar.push([{table: tableOptions}, {table: 'append-row'}, {table: 'append-col'}]);
        config.modules.table = true;

        loadModuleTable();
    }

