angular.module('product.elements.group.component',[
    'apiPagination.TaggingElements',
    'group.controller.service',
    'product.elements.list.merge.component',
    'product.elements.list.unlink.component',
    'product.elements.list.viewScenes.component',
    'product.elements.item.edit.component',
    'product.elements.item.grid.component'
])
.component('taggingelementGroup', treeGroupComponentParams( 'TaggingElementGroupCtrl', null))
.controller('TaggingElementGroupCtrl',TaggingElementGroupCtrl);
TaggingElementGroupCtrl.$inject = ['SBFieldMethods', 'TaggingElementsPagination','TreeGroupInitCtrlService', 'TaggingScenesService', '$element', '$rootScope'];
function TaggingElementGroupCtrl(SBFieldMethods, Pagination, TreeGroupInitCtrlService, TaggingScenesService, $element, $rootScope) {
    var  $ctrl = this;
    $ctrl.SBFieldMethods = SBFieldMethods;

    $ctrl.additionalMessageRemove = 'Are you sure you want to remove the selected ' + $ctrl.elemType + ' from ' + ($ctrl.category ? $ctrl.category.name : 'elements') + '?<br/> The element will be also removed from all the scenes it has been tagged in.';

    //$ctrl.getGroupHeader = getGroupHeader;
    $ctrl.onListChanged = onListChanged;

    $ctrl.getNewParams = getNewParams;

    $ctrl.getInlineActions = getInlineActions;
    $ctrl.getRowMobileActions = getRowMobileActions;
    $ctrl.getItemImageSize = getItemImageSize;
    $ctrl.getItemImageArea = getItemImageArea;
    $ctrl.getEditPopupColumnsCond = getEditPopupColumnsCond;
    $ctrl.showColumnOther = showColumnOther;
    $ctrl.showColumnMobileView = showColumnMobileView;

    $ctrl.getPopupLogo = getPopupLogo;
    $ctrl.getEmptyStateLogo = getEmptyStateLogo;


    $ctrl.goToElement = goToElement;
    $ctrl.initReferences = initReferences;
    $ctrl.toggleVariants = toggleVariants;
    $ctrl.toggleScenes = toggleScenes;
    $ctrl.viewScenes = viewScenes;
    $ctrl.getPicturePopupOtherProps = getPicturePopupOtherProps;
    $ctrl.addNewOnEmptyGroup = addNewOnEmptyGroup;
    $ctrl.getDisplayRootCount = getDisplayRootCount;

    $ctrl.$onInit = $onInit;

    function getDisplayRootCount(type) {
        if(canAdd($ctrl.currentList)){
            return 0;
        }
        var c = 0;
        _.each($ctrl.listTreeService.getTree($ctrl.treeType, ($ctrl.withActiveTree || $ctrl.withActiveGroup) ? $ctrl.selectedFilter : undefined)[0].nodes, function (n) {
            if (!canAdd(n)) {
                c += n.count;
            }
        });
        return c;

        function canAdd(el){
            return el.type === 1 || el.type === 3 || el._id === 'All';
        }
    }

    function $onInit() {

        var preLoadingService = $ctrl.preLoadingService.getProcessedStripsTables({
            type: 1
        }, $ctrl.scriptOrder, false, true);
        $ctrl.strips = preLoadingService.strips;

        $ctrl.stripsHeader = {};
        _.each($ctrl.strips, function (s){
            var  mt = $ctrl.SBFieldMethods.getMiniTitle(s),
                st = $ctrl.SBFieldMethods.getSceneText(s);
            $ctrl.stripsHeader[s._id] = (st||'') + (mt ? ('  •  ' + mt) : '');
        });

        $ctrl = new TreeGroupInitCtrlService($ctrl, $element, Pagination, false);

        $ctrl.hideFilters = true;

        if ($ctrl.canEdit) {
            $ctrl.processUpdatesMore = processUpdatesMore;
            $ctrl.onRemoved = onRemoved;
            $ctrl.onAdded = onAdded;
            $ctrl.onUpdated = onUpdated;
            $ctrl.openUnlinkVariant = openUnlinkVariant;
            $ctrl.merge = merge;

            var id = $ctrl.elemType + '_' + $ctrl.currentListId;
            $ctrl.addRootWatcher('REMOVE_SELECTED_' + id, onRemovedSelected);
            $ctrl.addRootWatcher('MERGED_SELECTED_' + id, onMergedSelected);
            $ctrl.addRootWatcher('UNLINK_' + id, onUnlinkVariant);
        }
    }
    
    function addNewOnEmptyGroup() {
        return $ctrl.isActiveFilter() && $ctrl.currentList._id !== 'All';
    }

    function viewScenes(item) {
        $ctrl.popupsService.open(item, $ctrl.popupsService.operations.viewScenes, {
            strips: getStrips(item.taggingScenes.map(function (item) {
return item.stripId;
            })),
            scriptLoadingService: $ctrl.preLoadingService,
        }, $ctrl.compOptions);
    }
    
    function getStrips(stripIds) {
        var order = 'scriptPosition';
        if (!$ctrl.strips) {
            $ctrl.strips = $ctrl.preLoadingService.getProcessedStripsTables({
                type: 1
            }, order, false, $ctrl.CPS.hasQuotaType('stripboard')).strips;
        }
        return stripIds && stripIds.length ? _.sortBy(
                _.filter(stripIds.map(function (id) {
                    return _.find($ctrl.strips, {_id: id});
                }), function (strip) {
                    return strip !== null && strip !== undefined;
                })
            , order) : null;
    }

    function openUnlinkVariant(item, variant) {
        if (item && variant) {
            $ctrl.popupsService.open(_.extend({
                unlinkElementId: item._id,
                type: item.type
            }, $ctrl.withProperty(), variant), $ctrl.popupsService.operations.unlinkElements,  {
                categoryName: $ctrl.categoryName,
                service: $ctrl.service,
            }, $ctrl.compOptions);
        }
    }

    function merge(ids) {
        var selected = [], item = null;
        _.each(ids, function (id) {
            var el = $ctrl.list.getElementById(id.id);
            if (!item) {
                item = _.extend({
                    type: el.type
                }, $ctrl.withProperty());
            }
            _.each($ctrl.service.getChangedFieldForUpdateOther(), function (prop) {
                if (el[prop] && !item[prop]) {
                    item[prop] = el[prop];
                }
            });

            selected.push(el._id);
        });

        if (!selected || selected.length === 0) {
            return;
        }

        $ctrl.popupsService.open(item, $ctrl.popupsService.operations.mergeElements,   {
            selected: selected,
            name: $ctrl.categoryName,
            service: $ctrl.service,
            columnsList: $ctrl.getEditPopupColumns(true).columnsList,
            currentListId: $ctrl.currentListId
        }, $ctrl.compOptions, null);
    }

    function toggleVariants(e) {
        $ctrl.preventDefault();
        $ctrl.showAll = !$ctrl.showAll;
        $ctrl.list.replaceAllElementsProps({show: $ctrl.showAll});
    }

    function toggleScenes(e) {
        $ctrl.preventDefault();
        $ctrl.showAll = !$ctrl.showAll;
        $ctrl.list.replaceAllElementsProps({show: $ctrl.showAll});
    }

    function onUnlinkVariant(result) {
        //result = $ctrl.preLoadingService.processSceneElement(result, 'taggingElements');
        var rem = result ? result.removed : null;
        if (rem) {
            var ids = rem.taggingElements;
            var count = ids && ids.length > 0 ? ids.length : 0;
            if (count) {
                $ctrl.list.removeElementsByIds(ids);
            }

            ids = rem.taggingScenes;
            var scenesCount = ids && ids.length > 0 ? ids.length : 0;
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.'+$ctrl.objectType+'.Unlink.success', 'success', {
                count: count,
                name: $ctrl.categoryName,
                service: $ctrl.service,
                scenesCount: scenesCount
            });
        } else {
            //no items to remove
        }
        $ctrl.processUpdates(result, true);
    }

    function onRemovedSelected(result) {
        result = $ctrl.preLoadingService.processSceneElement(result, 'taggingElements');
        var rem = result ? result.removed : null;
        if (rem) {
            var ids = rem.taggingElements;
            var count = ids && ids.length > 0 ? ids.length : 0;
            if (count) {
                $ctrl.list.removeElementsByIds(ids);
            }

            ids = rem.taggingScenes;
            var scenesCount = ids && ids.length > 0 ? ids.length : 0;
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.'+$ctrl.objectType+'.Remove Selected.success', 'success', {
                count: count,
                category: $ctrl.categoryName,
                scenesCount: scenesCount
            });
        } else {
            //no items to remove
        }
        $ctrl.processUpdates(result, true);
        setListVariants();
    }

    function onMergedSelected(result) {
    /*    result.type = 'Create';
        result = $ctrl.preLoadingService.processSceneElement(result, 'taggingElements');
        var item = result.item;
        if (item) {
            item.scenesCount = $ctrl.preLoadingService.getListCount($ctrl.preLoadingService.TblTypes.TaggingScenes, {elementId: item._id});
            $ctrl.list.insertElementAtIndex(item, item.order);
        }
        var rem = result ? result.removed : null;
        if (rem) {
            var ids = rem.taggingElements;
            var count = ids && ids.length > 0 ? ids.length : 0;
            if (count) {
                $ctrl.list.removeElementsByIds(ids);
            }

            ids = rem.taggingScenes;
            var scenesCount = ids && ids.length > 0 ? ids.length : 0;
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.'+$ctrl.objectType+'.Merged.success', 'success', {
                count: count,
                category: $ctrl.categoryName,
                scenesCount: scenesCount
            });
        }
        //update scene tags
        $ctrl.processUpdates(result, true);*/
        $ctrl.broadcastRoot($ctrl.keyboardService.CLEAR_SELECTED);
        setListVariants();
    }

    function onAdded(result) {
        setListVariants();
    }

    function onUpdated(result) {
        setListVariants();
    }

    function onRemoved(result) {
        setListVariants();
        var item = result.item;
        if (item) {
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.taggingElement.Remove.success', 'success', {
                name: item.name,
                category: $ctrl.categoryName,
                count: result.countUpdated
            });
        }
    }

    function processUpdatesMore(updates) {
        if($ctrl.preLoadingService) {
            $ctrl.preLoadingService.modifyChild($ctrl.preLoadingTableName, updates, $ctrl.preLoadingService.Ops.Edit);
        }
        setListVariants();
    }

    function getNewParams(after, type) {
        var params = {name : null};
        if ($ctrl.isChar) {
            params.type = 1;
            params.currentId = TaggingScenesService.getNewCurrentId($ctrl.list.items);
        }
        if ($ctrl.isStripLoc) {
            params.type = 3;
        }
        return params;
    }

    function onListChanged() {
        console.log('onListChanged');
        $ctrl.isChar = $ctrl.currentListId === '5a69235edf0fbc89a637c1ab';
        $ctrl.isStripLoc = $ctrl.currentListId === '5a69235fdf0fbc89a637c1c1';
        $ctrl.categoryName = $ctrl.currentList.name;
        if ($ctrl.categoryName[$ctrl.categoryName.length - 1] === 's' && $ctrl.categoryName.toLowerCase() !== 'miscellaneous') {
            $ctrl.categoryName = $ctrl.categoryName.substring(0, $ctrl.categoryName.length - 1);
        }
        setListVariants();
    }

    function setListVariants() {
        $ctrl.list.items.map(setItemVariants);
    }

    function setItemVariants(item) {
        if (!item) {
            return null;
        }
        var preLoadingService = $ctrl.listTreeService.preLoadingService,
            taggingScenes = preLoadingService.getSelectedTaggingScenes({elementId: item._id}, $ctrl.strips).map(function (t){
                t.sceneName = $ctrl.stripsHeader[t.stripId];
                return t;
            });

        item.taggingScenes = taggingScenes;
        item.scenesCount = taggingScenes ? taggingScenes.length : 0;

        var variants = [];
        if (taggingScenes) {
            var variantGr = _.groupBy(taggingScenes, function (item) {
                return item.position ? (item.position.variant ? item.position.variant.toLowerCase().trim() : 'Tagged In Sidebar') : (item.name ? item.name.toLowerCase().trim() : '');
            });
            for (var variant in variantGr) {
                var v = variantGr[variant];
                variants.push({
                    name: variant, sceneIds: v ? v.map(function (item) {
                        return item._id;
                    }) : []
                });
            }
        }

        item.variants = variants;

        return item;
    }

    function goToElement(item) {
        /*  $ctrl.CPS.transitionTo('user.product.element', $ctrl.CPS.currentProductPathParams({
              scriptId: $ctrl.scriptId,
              elementId: item._id
          })); */
    }

    function initReferences(field) {
        $ctrl.addRootWatcher('UPDATED_' + field.toUpperCase(), function () {
            updateFields(field);
        });

        function updateFields(field, isMulti) {
            if ($ctrl.list && $ctrl.list.items && $ctrl.list.items.length > 0) {
                var fieldId = field.substring(0, field.length - 1) + 'Id' + (isMulti ? 's' : ''),
                    list = $rootScope[field],
                    listIds = $rootScope[field + 'Ids'];
                console.log('updateFields: ' + field + 'Ids');
                if (list && listIds) {
                    $ctrl.list.items = $ctrl.list.items.map(function (item) {
                        var els = item.currentReferenceIds;
                        var lc = els && els.length > 0 ? els.length : 0;
                        if (lc > 0) {
                            var eln = null;
                            if (els) {
                                eln = [];
                                for (var i = 0; i < lc; i++) {
                                    var ls = list[listIds['c_' + els[i]]];
                                    eln.push(ls ? ls : null);
                                }
                            }
                            item.currentReferences = eln && (isMulti && eln.length > 0 || !isMulti) ? eln : null;
                        }
                        return item;
                    });
                }
            }
        }
    }

    function getInlineActions(isHeader, item) {
        return $ctrl.isPrintLayout ? '' : (viewScript()+ viewTags() + viewScenes());

        function viewScript() {
            var txt = 'Script',
                name = 'viewScenes',
                t = 'View Scenes', p = 'bottom';
            return '<div ' + (isHeader ? 'ng-if="!$ctrl.isGridView" ' : '') + ' class="script-col with-btn one-line-tooltip hide-print hide-ipad text-center no-drag">' +
                (isHeader ? txt :
                        (item.scenesCount ? ('<a class="see-breakdown no-tooltip-arrow gray-light display-block ' + $ctrl.getClickEventName(name) + '" tooltip="' + t + '" tooltip-placement="' + p + '" analytics-on analytics-action="' + t + '">' + $ctrl.LCS.getISBDiv('sides', 2, 'gray') + '</a>') : '')
                ) +
                '</div>';
        }

        function viewScenes() {
            var name = 'Scenes', t = 'View Scenes', p = 'bottom', c = item ? item.scenesCount : 0;
            return '<div ' + (isHeader ? 'ng-if="!$ctrl.isGridView" ' : '') + ' class="scenes-col one-line-tooltip col130 hide-print hide-ipad text-center no-drag">' +
                (isHeader ? name :
                        (c ? ('<a class="' + $ctrl.getClickEventName('toggle'+name) + ' show-more-btn large hide-print display-block" tooltip-placement="' + p + '" analytics-on analytics-action="' + t + '">' +
                            $ctrl.LCS.getISBDiv('forward-arrow', 1, 'txt' + name + 'SBF pull-left') +
                            '<div class="inline-block"><span class="txt'+name+'">Show</span> ' + name + ' ('+c+')</div>' +
                        '</a>') : '')
                ) +
                '</div>';
        }

        function viewTags(){
            var name = 'Tags',
            t = 'A “tag” is any highlighted phrase or manual entry in a script that is assigned to an element. For example, “hammer” and “Thor\'s Hammer” can be assigned to the same element, “Mjölnir.” This avoids redundant phrasings of the same element in reports.', p = 'left';
return '<div '+ (isHeader ? 'ng-if="!$ctrl.isGridView"' : '')+ ' class="tags-col col100 hide-print hide-ipad text-center no-drag">' +
            (isHeader ? name :
                ('<a tooltip="'+t+'" tooltip-placement="'+p+'" class="'+$ctrl.getClickEventName('toggle'+name)+' show-more-btn large hide-print display-block">' +
                 $ctrl.LCS.getISBDiv('forward-arrow', 1, 'txt' + name+'SBF pull-left') +
                '<div class="inline-block"><span class="txt'+name+'">Show</span> '+name+'</div>' +
                '</a>')
            ) +
        '</div>';
        }
    }

    function getRowMobileActions(item) {
        return item.scenesCount ? [{
            type: 'viewScenes',
            action: 'View Scenes',
            icon: 'sides'
        }] : null;
    }


    function getItemImageSize(isMobile) {
        return isMobile ? 'smaller' : ($ctrl.isGridView ? 'medium' : 'small48');
    }

    function getItemImageArea(c) {
        return $ctrl.isStripLoc ? 'square' : 'circle';
    }

    function getPicturePopupOtherProps(item){
        var l = $ctrl.currentList._id === 'All' ? $ctrl.listTreeService.getNodeById(item.categoryId) : $ctrl.currentList;
        return {
            icon : l.icon || $ctrl.itemIcon,
            iconLevel: l.iconLevel?l.iconLevel:6,
            bgColor: $ctrl.LCS.hexToRgba(l.color, 0.1),
            color: l.color
        };
    }

    function getEditPopupColumnsCond(c, item) {
        return c.prop !== 'currentId' || $ctrl.isChar && $ctrl.currentList.type === 1;
    }

    function showColumnOther(item, c, isHeader, isMobile, notTextOnly) {
        return c.prop !== 'currentId' || $ctrl.isChar && c.prop === 'currentId';
    }

    function showColumnMobileView(item, c) {
        return !(item.type === 1 && c.prop === 'currentId');
    }

    function getEmptyStateLogo(){
        return $ctrl.currentList._id === 'All' ? $ctrl.getEmptyStateLogoInit() : getLogo('small150');
    }

    function getPopupLogo(){
        return $ctrl.currentList._id === 'All' ? $ctrl.getPopupLogoInit() : getLogo('small76');
    }

    function getLogo(size){
        return '<div class="centered circled-svg-colored colored ' + size + '"' +
            ' style="background-color:'+ $ctrl.LCS.hexToRgba($ctrl.currentList.color, 0.1) + '">' +
                    $ctrl.LCS.getISBDiv(
                        $ctrl.currentList.icon ? $ctrl.currentList.icon  : $ctrl.itemIcon,
                        $ctrl.currentList.iconLevel?$ctrl.currentList.iconLevel:6,
            null,
            $ctrl.currentList.color ?  ('style="color: ' + $ctrl.currentList.color+'"') : null) +
            '</div>';
    }
}

angular.module('product.elements.item.grid.component', [])

.component('taggingelementItemGrid', itemGridComponentParams( {
}, 'TaggingElementItemCtrl','<div class="row-schedule"></div><div class="references-view-item display-block border-bottom"></div>'))
.controller('TaggingElementItemCtrl',TaggingElementItemCtrl);
TaggingElementItemCtrl.$inject = ['GridItemGroupInitCtrlService', '$element'];
function TaggingElementItemCtrl(GridItemGroupInitCtrlService, $element) {
    //console.log('TaggingElementItemCtrl');
    var $ctrl = this;
    $ctrl.containerClass = 'references-view-item';
    $ctrl.bindingNames = ['viewScenes', 'toggleTags', 'toggleScenes', 'openUnlinkVariant'];

    $ctrl.preloadInitItem = preloadInitItem;
    $ctrl.postInitItem = postInitItem;
    $ctrl.updateEditableItemPropsAll = updateEditableItemPropsAll;
    $ctrl.toggleTags = toggleTags;
    $ctrl.toggleScenes = toggleScenes;
    $ctrl.openUnlinkVariant = openUnlinkVariant;

     $ctrl = new GridItemGroupInitCtrlService($ctrl, $element);

    function updateEditableItemPropsAll(changes) {
        loadDetails($ctrl.item);
    }

    function preloadInitItem() {
        $ctrl.item.currentReferences = $ctrl.preLoadingService.getElementReferences($ctrl.item._id);
    }

    function postInitItem() {
        $ctrl.moreItem = $ctrl.element.querySelector('.' + $ctrl.containerClass);
        var list = ['Tags', 'Scenes'];
        _.each(list, function (n){
            processShow(n, false);
        });

        if($ctrl.isPrintLayout){
            loadDetails($ctrl.item, list);
        } else {
            $ctrl.LCS.addClass($ctrl.moreItem, 'sb-hide');
        }
    }

    function toggleTags(){
        toggle('Tags');
    }

    function toggleScenes(){
        toggle('Scenes');
    }

    function toggle(name) {
        //console.log('toggle ' + name);
        var isShow = $ctrl[getPropName(name)] === true;
        $ctrl.LCS[isShow ? 'addClass' : 'removeClass']($ctrl.moreItem, 'sb-hide');
        processShow(name, !isShow);
        if (!isShow){
            loadDetails($ctrl.item, [name]);
        }
    }

    function getPropName(name) {
        return 'showx' + name;
    }

    function processShow(name, show) {
        //console.log('processShow');
        $ctrl[getPropName(name)] = show;
        var n = '.txt' + name,
            el = $ctrl.element.querySelector(n + 'SBF');
        if (el) {
            $ctrl.LCS.replaceClass(el, show ? 'forward-arrow' : 'down-arrow', show ? 'down-arrow' : 'forward-arrow');
        }
        el = $ctrl.element.querySelector(n);
        if (el) {
            el.innerText = show ? 'Hide' : 'Show';
        }

        $ctrl.LCS[show ? 'removeClass' : 'addClass']($ctrl.moreItem.querySelector('.wrapper' + name), 'sb-hide');
    }

    function openUnlinkVariant() {
    //todo
    }

    function loadDetails(item, names) {
        var el = '', el1 = '';
        if(names) {
            _.each(names, function (name) {
                if (name === 'Tags') {
                    var l = item.variants ? item.variants.length : 0,
                        cls = getCls(l);
                    if (l > 0) {
                        var el2 = '';
                        _.each(item.variants, function (it) {
                            el2 += '<div class="' + cls + '">' +
                                '<div class="content">' +
                                '<span' + (item.type === 1 ? ' class="uppercase"' : '') + '>' + it.name + '</span>' +
                                '<span class="with-parenthesis with-margin-left">' + it.sceneIds.length + ' scene' + (it.sceneIds.length === 1 ? '' : 's') + '</span>' +
                                ($ctrl.canEdit && item.variants.length > 1 ? '<div class="sbf wrong ng-hide" ng-click="$ctrl.openUnlinkVariant(item, it)" tooltip="Unlink" tooltip-placemen="bottom"></div>' : '') +
                                '</div>' +
                                '</div>';
                        });
                    }

                    if($ctrl.isPrintLayout && !el2){}
                    else {
                        el1 += '<div class="tag-title">Tagged Phrases' + (l > 0 ? (' (' + l + ')') : '') + '</div>' +
                                (el2 ? ('<div class="full-width clearfix">' + el2 + '</div>') : ('<div class="content italic">This element has not been tagged in any scenes.</div>'));
                    }
                } else  { //Scenes
                    var l = item.scenesCount,
                        cls = getCls(l);
                    el1 = '';
                    if($ctrl.isPrintLayout && l === 0 ){} else {
                        el1 += '<div class="tag-title">Tagged Scenes' + (l > 0 ? (' (' + l + ')') : '') + '</div>' +
                            (l > 0 ? getC() : '<div class="content italic">This element has not been tagged in any scenes.</div>');
                    }
                    function getC() {
                        var el = '';
                        _.each(item.taggingScenes, function (it) {
                            el += '<div class="' + cls + '">' + it.sceneName + '</div>';
                        });

                        return '<div class="full-width clearfix">' + el + '</div>';
                    }
                }

                if($ctrl.isPrintLayout && !el1){} else{
                    el += '<div class="spacing-quarter full-width wrapper' + name + ' ' +
                        (($ctrl.isPrintLayout || $ctrl[getPropName(name)] === true) ? '' : 'sb-hide') +
                        '">' + el1 + '</div>';
                }
            });
        }

        var wCls = 'tagswrapper';
        $ctrl.LCS.removeElementChild($ctrl.moreItem, '.' + wCls);

        if(el) {
            $ctrl.LCS.appendChildFragment($ctrl.moreItem, '<div class="full-width ' + wCls + '">' + el + '</div>');
        }

        function getCls(l){
            return 'item-details pull-left ' + (l === 1 ? 'col100p' : 'col50p');
        }
    }
}


