TaskcardTreeItemEditCtrl.$inject = ['TaskcardTreeItemGridCtrlService', 'TreeItemEditCtrlService', '$element'];

function TaskcardTreeItemEditCtrl( TaskcardTreeItemGridCtrlService, TreeItemEditCtrlService, $element) {
    var $ctrl = this;

    $ctrl = new TaskcardTreeItemGridCtrlService($ctrl);

    $ctrl.changedFields = ['name', 'color'];
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoadedOther = onLoadedOther;
    $ctrl.colorChanged = colorChanged;
    $ctrl.$onDestroy = $onDestroy;

    $ctrl = new TreeItemEditCtrlService($ctrl, $element);

    function getItemTemplate() {
    return '<form class="no-drag full-width contactlistedit thinner" name="$ctrl.formHolder.form'+$ctrl.item._id+'" novalidate>' +
        $ctrl.LCS.getErrorBlock() +
            '<div class="swimlane-title clearfix thinner">' +
                '<input id="name'+$ctrl.item._id+'" name="name" type="text" ng-model="$ctrl.item.name" placeholder="Column Name…" required class="form-control hover-underline name"/>' +
                '<div ng-if="($ctrl.formHolder[\'form'+$ctrl.item._id+'\'][\'name\'].$dirty || $ctrl.formHolder[\'formItem_attempted\']) && $ctrl.formHolder[\'form'+$ctrl.item._id+'\'][\'name\'].$error.required" class="help-inline with-relative">Column Name is required</div>' +
            '</div>' +
            '<div class="custom-wrapper colors-wrapper circled">' +
                '<div class="custom-checkbox inrow '+ $ctrl.pageClass +'" ng-repeat="c in ::$ctrl.colors">' +
                '<div class="customitem" ng-style="{\'background-color\': c}"><label><input type="checkbox" ng-click="$ctrl.colorChanged($event, c)" ng-checked="$ctrl.item.color===c"><span></span><span></span></label></div>' +
                '</div>' +
            '</div>' +
        '</form>';
    }

    function colorChanged(e, c) {
        $ctrl.item.color=c;
        $ctrl.onItemUpdate(e);
    }

    function onLoadedOther() {
        setWithColors(true);
    }

    function setWithColors(isOn) {
        var el = $ctrl.LCS.findClosestParent($ctrl.element, '.lane-wrapper');
        if(el){
            $ctrl.LCS[isOn?'addClass':'removeClass'](el.querySelector('.swimlane-remaining-height'), 'with-colors');
        }
    }

    function $onDestroy() {
        setWithColors();
        if (!$ctrl.onDestroyTreeItemEdit) {
            $ctrl.onDestroyTreeItemEdit();
        }
    }
}

