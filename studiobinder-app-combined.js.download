angular.module('services.soundEffects', [
    'ngAudio'
])
.factory('soundEffectService', soundEffectServiceFactory);

soundEffectServiceFactory.$inject = ['ngAudio', 'LCS'];
function soundEffectServiceFactory(ngAudio, LCS) {
    var AngularAudio = {
        cache: {},
        defaultVolume: 0.03,
        SOUND_TYPES: {
            ADD_TOAST: 12,
            REMOVE_TOAST: 1,
            NEW_PARTICIPANT: 2,
            PARTICIPANT_DISCONNECTED: 3,
            START_EVENT: 4,
            END_EVENT: 5,
            MUTE: 6,
            UNMUTE: 7,
            SIDEBAR_SWIPE: 8,
            DIALING: 9 ,
            TAKE_CALL:10,
            DROP_CALL:11
        },
        timeout:0
    };

    AngularAudio.typeProps = { };
    AngularAudio.typeProps[  AngularAudio.SOUND_TYPES.ADD_TOAST ] = 'toast-in.wav';
    AngularAudio.typeProps[  AngularAudio.SOUND_TYPES.REMOVE_TOAST ] = 'toast-out.wav';
    AngularAudio.typeProps[  AngularAudio.SOUND_TYPES.NEW_PARTICIPANT ] = 'success.wav';
    AngularAudio.typeProps[  AngularAudio.SOUND_TYPES.PARTICIPANT_DISCONNECTED ] = 'toast-out.wav';
    AngularAudio.typeProps[  AngularAudio.SOUND_TYPES.START_EVENT ] = 'start-event.wav';
    AngularAudio.typeProps[  AngularAudio.SOUND_TYPES.END_EVENT ] = 'end-event.wav';
    AngularAudio.typeProps[  AngularAudio.SOUND_TYPES.MUTE ] = 'mute.wav';
    AngularAudio.typeProps[  AngularAudio.SOUND_TYPES.UNMUTE ] = 'unmute.wav';
    AngularAudio.typeProps[  AngularAudio.SOUND_TYPES.SIDEBAR_SWIPE ] = 'sidebar-swipe.wav';
    AngularAudio.typeProps[  AngularAudio.SOUND_TYPES.DIALING ] = 'dialing.wav';
    AngularAudio.typeProps[  AngularAudio.SOUND_TYPES.TAKE_CALL ] = 'take-call.wav';
    AngularAudio.typeProps[  AngularAudio.SOUND_TYPES.DROP_CALL ] = 'drop-call.wav';


    AngularAudio.getSoundTypes = function () {
        return this.SOUND_TYPES;
    };

    AngularAudio.getUrlForType = function (type) {
        var path = this.typeProps[type];
        if (path){
            return LCS.staticUrl + 'audio/' + path;
        }
        return null;
    };

    AngularAudio.play = function (audioInfo) {
        var type = audioInfo&&audioInfo.type?audioInfo.type:audioInfo;
        if (!this.cache[type]) {
            this.cache[type] = ngAudio.load(this.getUrlForType(type));
        }

        var audio = this.cache[type];
        if (audio) {
            audio.volume = audioInfo.volume ? audioInfo.volume : AngularAudio.defaultVolume;
            $ctrl.LCS.timeout(function () {
                return audio.play();
            }, AngularAudio.timeout);
        }
    };

    return AngularAudio;
}

angular.module('services.stateHeadersService', [
])
    .service('StateHeadersService', StateHeadersService);

StateHeadersService.$inject = ['CookiesService', 'API_CONFIGS'];
function StateHeadersService(CookiesService, API_CONFIGS) {
    var configs = API_CONFIGS();
    var _this = this;

    _this.UserRoles = {Guest: 0, Collaborator: 1, User: 2, Admin: 3};
    _this.stateHeaders = {};

    _this.clearHeaders = function(){
        _this.stateHeaders = {};
    }

    _this.getRoleFromPath = function getRoleFromPath(path) {
        switch (path) {
            case configs.rolePaths.adminPath:
                return _this.UserRoles.Admin;
            case configs.rolePaths.collabPath:
                return _this.UserRoles.Collaborator;
        }
        return _this.UserRoles.User;
    }

    _this.isPagePublic = function(state){
        return state && (state.indexOf('public.') === 0);
    }

    _this.getHttpHeaders = function getHttpHeaders(state, params) {
        var headers = {};
        if (state) {
            if(state === 'user.product.breakdown' || state === 'user.product.document' || state === 'user.product.screenplay'
            //    || state === 'user.product.avscript'
            ) {
                state += 's';
            }
            headers['x-page'] = state;
        }
        if (params) {
            var companyId = params.companyId,
                productId = params.productId,
                scriptId = params.scriptId,

                teamId = params.teamId,
                invitationId = params.invitationId,
                callsheetId = params.callsheetId,
                documentId = params.documentId;
            if (companyId) {
                headers['x-company-id'] = companyId;
            }
            if (productId) {
                headers['x-product-id'] = productId;
            }
            if (scriptId) {
                headers['x-script-id'] = scriptId;
            }
            if (teamId) {
                headers['x-team-id'] = teamId;
            }
            if (invitationId) {
                headers['x-invitation-id'] = invitationId;
            }
            if (callsheetId) {
                headers['x-callsheet-id'] = callsheetId;
            }
            if (documentId) {
                headers['x-document-id'] = documentId;
            }
            var r = setRole(state, params.role);
            if (r === _this.UserRoles.Collaborator) {
                try {
                    if (collabToken) {
                        console.log('getHttpHeaders');
                        var v = teamId + (invitationId ? ('_' + invitationId) : '');
                        var token = angular.copy(collabToken["c" + v]);
                        if (token) {
                            CookiesService.collabToken[v] = token;
                        }
                        collabToken = null;
                    }
                } catch (e) {
                }
            }

        }else{
            setRole(state);
        }

        return headers;

        function setRole(state, role) {
            var r;
            if (role) {
                r = _this.getRoleFromPath(role);
            }
            if (r === undefined) {
                if (_this.isPagePublic(state)) {
                    r = _this.UserRoles.Guest;
                }
                else if (state.indexOf('admin.') === 0) {
                    r = _this.UserRoles.Admin;
                }
                else {
                    r = _this.UserRoles.User;
                }
            }
            if (r) {
                headers['x-role'] = r;
            }
            return r;
        }
    }

    return _this;
}

angular.module('services.stateService', [
    'services.rootEvents'
])
.service('SBStateService', SBStateService);

SBStateService.$inject = ['$state', 'API_CONFIGS', '$timeout', '$window', '$location', 'RootEventsService'];
function SBStateService($state, API_CONFIGS, $timeout, $window, $location, RootEventsService) {
    var configs = API_CONFIGS();
    var _this = this;

    _this.$timeout = $timeout;
    _this.$window = $window;
    _this.$location = $location;
    _this.$state = $state;

    _this.RootEventsService = RootEventsService;

    _this.baseHref = configs.baseHref;
    _this.loginPath = configs.site.loginPath;
    _this.isStaticPage = false;
    _this.currentState = null;
    _this.isRedirecting = false;
    _this.ProductOverviewStateName = 'user.product.overview';


    _this.isProductOverviewState = function () {
       return _this.getCurrentStateName() !== _this.ProductOverviewStateName;
    }

    _this.setShareFilter = function setShareFilter(val) {
        _this.shareFilter = val;
     }

    _this.isFromWWW = function() {
        var l = ['utm_medium', 'utm_campaign'];
        for (var i = 0, n = l.length; i < n; i++) {
            if (get(l[i])) {
                return true;
            }
        }
        return false;

        function get(f) {
            var s = _this.getSearchFilter(f);
            return s === 'app_link' || s === 'sb-app-link';
        }
    }
    _this.getCurrentUrl = function () {
        return _this.$location.url();
    }
    _this.getCurrentPath = function () {
        return _this.$location.path();
    }
    _this.getSearchFilter =  function getSearchFilter(type) {
        var v = getVal();
        if (!type || type === 'filter') {
            _this.setShareFilter(v);
        }

        return v;

        function getVal() {
            try {
                var f = _this.$location.$$search[type ? type : 'filter'];
                var val = f ? decodeURIComponent(f) : null;
                if (!val) {
                    return null;
                }
                try {
                    return JSON.parse(val);
                } catch (e) {
                    return val;
                }
            } catch (e) {
            }
            return null;
        }
    }

    _this.setSearchFilter = function(val, type) {
        if(!type || type === 'filter'){
            _this.setShareFilter(val);
        }else{
            _this.$location.search(type ? type : 'filter', val ? encodeURIComponent(typeof (val) === 'string' ? val : JSON.stringify(val)) : null);
        }
    }

    _this.getActiveClass = function getActiveClass(els, isEqual) {
        return _this.hasState(els, null, isEqual) ? ' active ' : '';
    }

    _this.hasState = function hasState(els, initName, isEqual) {
        var name = initName ? initName : _this.getCurrentStateName();
      //  console.log('hasState: ' + 'initName: ' + initName +'; name: ' + name);
        var n = els && els.length > 0 ? els.length : 0;
        if (n) {
            for (var i = 0; i < n; i++) {
                var ex = els[i];
                var v = isEqual? (ex === name) : (name.indexOf(ex)!==-1);
                if (v) {
                    return true;
                }
            }
        }
        return false;
    }

    _this.getStateDataParams = function getStateDataParams(name) {
        if(name){
            return _this.getStateDataByName(name);
        }
        var state = _this.getCurrentState();
        return state && state.data ? state.data : {};
    }

    _this.getStateDataByName = function getStateDataByName(name) {
        if(!_this.registeredStates){
            _this.registeredStates = _this.$state.get();
        }
        var item = _.find(_this.registeredStates, function (item) {
            return item && item.name === name;
        });

        return item && item.data ? item.data : {};
    }

    _this.setRouteState = function setRouteState(state, params, stateService) {
        console.log('setRouteState');
        console.log(params);
        _this.setCurrentState(state);
        _this.setCurrentStateParams(params);

        _this.$stateService = stateService;
    }

    _this.isCurrentState = function isCurrentState(str, contains) {
        if (!str) {
            return false;
        }
        if (typeof (str) === 'string') {
            str = [str];
        }
        var l = str && str.length > 0 ? str.length : 0;
        var name = _this.getCurrentStateName();
        for (var i = 0; i < l; i++) {
            var s = str[i];
            if (contains ? (name.indexOf(s) !== -1) : (s === name)) {
                return true;
            }
        }
        return false;
    }

    _this.hasCurrentState = function hasCurrentState(str) {
        return _this.isCurrentState(str, true);
    }

    _this.transitionTo = function transitionTo(name, toParams, options) {
        //console.log('transitionTo: ' + name);
        return _this.$stateService.transitionTo(name, toParams, options);
    }
    _this.reloadCurrentState = function reloadCurrentState(hardReload) {
        if(hardReload){
            // To reload the page discarding the POST data (perform a GET request), use:
            _this.$window.location.href = _this.$window.location.href;
        }else {
            //To reload the page keeping the POST data, use:
            _this.$state.go(_this.$state.current, {}, {reload: true});
        }
    }
    _this.getStateHref = function getStateHref(name, params, options) {
        return _this.$state.href(name, params, options);
    }

    _this.openInNewWindow = function (name, params, options) {
        _this.$window.open(_this.$window.location.origin + _this.getStateHref(name, params, options), '_blank');
    }

    _this.isBaseHrefState = function isBaseHrefState(state) {
        return state === _this.baseHref || (state + '/') === _this.baseHref;
    }

    _this.isLoginHrefState = function isLoginHrefState(state) {
        return state === _this.loginPath || (state + '/') === _this.loginPath;
    }

    _this.loadLogin = function(redirectUrl){
        _this.assignUrl(redirectUrl ? redirectUrl :_this.loginPath, redirectUrl ? 200 : null);
    }

    _this.goToLogin = function goToLogin(redirectUrl) {
        if (_this.isRedirecting) {
            return;
        }
        console.log('goToLogin: redirectUrl: ' + redirectUrl);
        var par = {};
        if (redirectUrl && redirectUrl !== null && redirectUrl !== undefined && redirectUrl !== 'undefined' && !(_this.isBaseHrefState(redirectUrl) || _this.isLoginHrefState(redirectUrl) || redirectUrl.indexOf('resetPassword') !== -1)) {
            par = {redirectUrl: redirectUrl};
        }
        if (_this.getCurrentState()) {
            _this.transitionTo('public.login', par);
        } else {
            _this.$$setUrl(_this.loginPath);
        }
    }

    _this.$$setUrl = function(url){
        _this.$location.$$url = url;
    }

    _this.goToUrl = function goToUrl(url, security) {
        if (url) {
            if (url.indexOf('/login') === 0) {
                url = null;
            } else if (url === _this.getCurrentUrl()) {
                return;
            } else {
                _this.assignUrl(url);
            }
        }
        _this.goToDashboard(url, security);
    }

    _this.assignUrl = function(url, timeout) {
        if (timeout >= 0) {
            _this.$timeout(process, timeout);
        } else {
            process();
        }

        function process() {
            _this.$window.location.assign(url);
        }
    }
    _this.reloadPage = function  () {
        _this.$window.location.reload();
    }

    _this.refreshPage = function  (next) {
        _this.$timeout(function () {
            //window.location.reload(false);
            _this.$window.location = self.location;
            if(next){
                next();
            }
        }, 10);
    }

    _this.goToDashboard = function goToDashboard(url, security) {
        security.isCollaborator = false;

        if (_this.isRedirecting) {
            return;
        }
        if (!url) {
            url = configs.baseHref;
        }
        var par = security.currentPathParams();
        var q = [];

        function addVar(name) {
            q.push(name + '=true');
            par[name] = true;
        }

        if (security.paymentFailed) {
            addVar('paymentFailed');
        }
        if (security.lowQuota) {
            addVar('lowQuota');
        }

        var extraparam = (q.length > 0 ? ('?' + q.join('&')) : '');
        var state = _this.getCurrentState();
        if ((_this.isBaseHrefState(url) || _this.isLoginHrefState(url) || url.indexOf('resetPassword') !== -1 || _this.isStaticPage === true) && security.isAuthenticated()) {
            switch (security.getUserRole()) {
                case security.UserRoles.Admin:
                   /* if (state) {
                        _this.transitionTo('admin.dashboard', par);
                    } else {
                        _this.$$setUrl('/' + configs.rolePaths.adminPath + '/dashboard' + extraparam);
                    }
                    break;
                */
                case security.UserRoles.User:
                    if (state) {
                        _this.goToUserDashboard(par);
                    } else {
                        _this.$$setUrl('/company/' + security.getCurrentCompanyId() + '/' + configs.rolePaths.currentUserPath + '/' + security.getCurrentTeamId() + '/dashboard' + extraparam);
                    }
                    break;
            }
        } else {
            if (!extraparam && state) {
                _this.goToUserDashboard({});
            } else {
                _this.$$setUrl(url + extraparam);
            }
        }
    }



    _this.goToUserDashboard = function goToUserDashboard(params){
        _this.transitionTo('user.dashboard', params);
    }

    _this.goToProjects = function goToProjects(params){
        _this.transitionTo('user.projects', params);
    }

    _this.getCurrentStateName = function getCurrentStateName() {
        var state = _this.getCurrentState();
        return state ? state.name : null;
    }

    _this.getCurrentStateData = function getCurrentStateData() {
        var state = _this.getCurrentState();
        return state ? state.data : null;
    }


    _this.getCurrentState = function getCurrentState() {
        return _this.currentState;
    }

    _this.setCurrentState = function setCurrentState(v) {
        if (v !== undefined && _this.getCurrentState() !== v) {
            console.log('setCurrentState: ' + v.name);
            _this.currentState = v;
        }
    }

    _this.getCurrentStateParams = function getCurrentStateParams() {
        return _this.$stateParams;
    }

    _this.setCurrentStateParams = function (params) {
        _this.$stateParams = params ? params:[];
    }

    _this.emitStateChanged = function (state) {
        RootEventsService.broadcastRoot('STATE_CHANGED', state);
    }

    _this.onStateChanged = function (method) {
        return RootEventsService.onDefaultEmitted('STATE_CHANGED', method);
    }

    return _this;
}

//https://github.com/adambisek/string-pixel-width#readme

angular.module('services.stringSize', [
])
.service('stringSizeService', stringSizeService);
function stringSizeService(  ) {

    var cache = {};

    return {
        computeSize: computeSize
    };

    function computeSize(text, options) {
        if (options === void 0) {
            options = {};
        }
        var cacheKey = JSON.stringify({text: text, options: options});
        if (cache[cacheKey]) {
            return cache[cacheKey];
        }
        // prepare options
        options.font = options.font || 'Open Sans';
        options.fontSize = options.fontSize || '16px';
        options.fontWeight = options.fontWeight || 'normal';
        options.lineHeight = options.lineHeight || 'normal';
        options.width = options.width || 'auto';
        options.wordBreak = options.wordBreak || 'normal';

        var element = createDummyElement(text, options);
        var size = {
            width: element.offsetWidth,
            height: element.offsetHeight,
        };
        destroyElement(element);
        cache[cacheKey] = size;
        return size;
    }

    function createDummyElement(text, options) {
        var element = document.createElement('div');
        var textNode = document.createTextNode(text);
        element.appendChild(textNode);
        element.style.fontFamily = options.font;
        element.style.fontSize = options.fontSize;
        element.style.fontWeight = options.fontWeight;
        element.style.lineHeight = options.lineHeight;
        element.style.position = 'absolute';
        element.style.visibility = 'hidden';
        element.style.left = '-9999px';
        element.style.top = '-9999px';
        element.style.width = options.width;
        element.style.height = 'auto';
        element.style.wordBreak = options.wordBreak;
        document.body.appendChild(element);
        return element;
    }

    function destroyElement(element) {
        element.parentNode.removeChild(element);
    }
}
/**
 * @fileoverview syncscroll - scroll several areas simultaniously
 * @version 0.0.3
 *
 * @license MIT, see http://github.com/asvd/intence
 * @copyright 2015 asvd <heliosframework@gmail.com>
 */


(function (root, factory) {
    if (typeof define === 'function' && define.amd) {
        define(['exports'], factory);
    } else if (typeof exports !== 'undefined') {
        factory(exports);
    } else {
        factory((root.syncscroll = {}));
    }
}(this,function (exports) {
    var Width = 'Width';
    var Height = 'Height';
    var Top = 'Top';
    var Left = 'Left';
    var scroll = 'scroll';
    var client = 'client';
    var EventListener = 'EventListener';
    var addEventListener = 'add' + EventListener;
    var length = 'length';
    var Math_round = Math.round;

    var names = {};

    var reset = function() {
        var elems = document.getElementsByClassName('sync'+scroll);

        // clearing existing listeners
        var i, j, el, found, name;
        for (name in names) {
            if (names.hasOwnProperty(name)) {
                for (i = 0; i < names[name][length]; i++) {
                    names[name][i]['remove'+EventListener](
                        scroll, names[name][i].syn, 0
                    );
                }
            }
        }

        // setting-up the new listeners
        for (i = 0; i < elems[length];) {
            found = j = 0;
            el = elems[i++];
            if (!(name = el.getAttribute('name'))) {
                // name attribute is not set
                continue;
            }

            el = el[scroll+'er']||el;  // needed for intence

            // searching for existing entry in array of names;
            // searching for the element in that entry
            for (;j < (names[name] = names[name]||[])[length];) {
                found |= names[name][j++] == el;
            }

            if (!found) {
                names[name].push(el);
            }

            el.eX = el.eY = 0;

            (function(el, name) {
                el[addEventListener](
                    scroll,
                    el.syn = function() {
                        var elems = names[name];

                        var scrollX = el[scroll+Left];
                        var scrollY = el[scroll+Top];

                        var xRate =
                            scrollX /
                            (el[scroll+Width] - el[client+Width]);
                        var yRate =
                            scrollY /
                            (el[scroll+Height] - el[client+Height]);

                        var updateX = scrollX != el.eX;
                        var updateY = scrollY != el.eY;

                        var otherEl, i = 0;

                        el.eX = scrollX;
                        el.eY = scrollY;

                        for (;i < elems[length];) {
                            otherEl = elems[i++];
                            if (otherEl != el) {
                                if (updateX &&
                                    Math_round(
                                        otherEl[scroll+Left] -
                                        (scrollX = otherEl.eX =
                                                Math_round(xRate *
                                                    (otherEl[scroll+Width] -
                                                        otherEl[client+Width]))
                                        )
                                    )
                                ) {
                                    otherEl[scroll+Left] = scrollX;
                                }

                                if (updateY &&
                                    Math_round(
                                        otherEl[scroll+Top] -
                                        (scrollY = otherEl.eY =
                                                Math_round(yRate *
                                                    (otherEl[scroll+Height] -
                                                        otherEl[client+Height]))
                                        )
                                    )
                                ) {
                                    otherEl[scroll+Top] = scrollY;
                                }
                            }
                        }
                    }, 0
                );
            })(el, name);
        }
    }


    if (document.readyState == "complete") {
        reset();
    } else {
        window[addEventListener]("load", reset, 0);
    }

    exports.reset = reset;
}));



angular.module('services.translation', [
