function SbDaterangeDrpMenuCtrl(SbDateDrpMenuCtrlService, $element) {
    console.log('SbDaterangeDrpMenuCtrl');
    var $ctrl = this;
    $ctrl.datetype = 'range';

    $ctrl.onChangeOther = onChangeOther;
    $ctrl.getOtherOptions = getOtherOptions;
    $ctrl.onConfirm = onConfirm;
    $ctrl.onDestroyOther = onDestroyOther;
    $ctrl.onDatePickerLoaded = onDatePickerLoaded;

    $ctrl = new SbDateDrpMenuCtrlService($ctrl, $element);

    function onChangeOther(selectedDates){
        console.log('SbDaterangeDrpMenuCtrl.onChangeOther');
        $ctrl.selectedDates = selectedDates;
        onSelect(false);
    }

    function getOtherOptions() {
        return {
            plugins: [
                new confirmDatePlugin({
                    confirmIcon: '', // your icon's html, if you wish to override
                    confirmText: 'Apply',
                    showAlways: true,
                    theme: 'light' // or "dark"
                })
            ],
        };
    }


    function onDatePickerLoaded(){
        bind(true);
    }

    function bind(isBind){
        $ctrl.bindElementClickBySelector(isBind, '.flatpickr-confirm', $ctrl.onConfirm);
    }

    function onConfirm(e){
        console.log('SbDaterangeDrpMenuCtrl.onConfirm');
        $ctrl.preventDefault(e);
        onSelect(true);
    }

    function onSelect(withClose){
        console.log('SbDaterangeDrpMenuCtrl.onSelect');
        if($ctrl.withClose !== withClose){
            $ctrl.withClose = withClose;
        }
        $ctrl.onSelect({result: {value: angular.clone($ctrl.selectedDates), withClose: $ctrl.withClose}});
    }

    function onDestroyOther(){
        bind(false);
    }
}

