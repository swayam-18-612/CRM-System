angular.module('user.departments.position.edit.component', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
])
.component('positionEditPopup', popupComponentParams('PositionEditPopupCtrl'))
.controller('PositionEditPopupCtrl',PositionEditPopupCtrl);
PositionEditPopupCtrl.$inject = ['GeneralItemEditCtrlService', '$element'];
function PositionEditPopupCtrl(GeneralItemEditCtrlService, $element) {

    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl.postInitGeneral = postInitGeneral;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneral() {
        $ctrl.parent = $ctrl.extraParam.parent;
        $ctrl.onSaveGeneral = onSaveGeneral;
    }

    function postInitGeneral() {
        $ctrl.clean = false;
    }

    function onSaveGeneral(result) {
        result.type = $ctrl.type;
    }

    function x() {
return '<form name="$ctrl.formHolderItem[$ctrl.formName]" class="auto" novalidate autocomplete="off" ui-keyup="{\'enter\':\'$ctrl.save()\'}">' ;
    }
}

angular.module('user.departments.list.reset.component',[
    'list.ctrl'
])
.component('departmentsResetPopup', popupComponentParams('DepartmentsResetPopupCtrl'))
.controller('DepartmentsResetPopupCtrl', DepartmentsResetPopupCtrl);
DepartmentsResetPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', '$element'];
function DepartmentsResetPopupCtrl(ItemTemplateCompileCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.resetDepartments = resetDepartments;
    $ctrl.preInit = preInit;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function setTemplateData() {
        $ctrl.withFooterBtns = true;
        $ctrl.icon = 'departments';
        $ctrl.popupTitle = 'Reset Departments';
        $ctrl.firstBtnMethod = 'resetDepartments';
        $ctrl.btnText = 'Reset';
        $ctrl.textAnalytics = 'Reset ' + ($ctrl.CPS.productId? 'Project' : 'General') + ' Departments';
    }

    function preInit() {
        $ctrl.service = $ctrl.extraParam.service;
    }

    function getPopupBodyContent(){
        return '<p class="text-center">This will reset the default departments and positions {{$ctrl.CPS.product ? \'for this project\' : \'\'}}. This cannot be undone.</p>';
    }

    function resetDepartments(e) {
        $ctrl.preventDefault(e);
        $ctrl.error = null;
        if ($ctrl.isUpdating) {return;}
        $ctrl.isUpdating = true;
        var message = 'crud.department.' + ($ctrl.CPS.productId ? 'project' : 'general') + '.reset';
        $ctrl.service.reset({
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId ? $ctrl.CPS.productId : null,
        }, function (result) {
            $ctrl.isUpdating = false;
            $ctrl.closePopup(result);
            $ctrl.i18nNotifications.pushForCurrentRoute(null, message + '.success', 'success');
        }, function (error) {
            $ctrl.isUpdating = false;
            $ctrl.error = $ctrl.localizedMessages.getFromError(error, message + '.error');
        });
    }
}

angular.module('product.document.versions.controller.service',[
    'apiPagination.DocumentVersions',
    'product.document.list.item.more.component',
    'product.sidebar.items.controller.service'
])
.service('DocumentVersionsCtrlService', DocumentVersionsCtrlService);
DocumentVersionsCtrlService.$inject = ['SidebarItemsCtrlService', 'DocumentVersionsPagination'];
function DocumentVersionsCtrlService(SidebarItemsCtrlService, pagination) {
    console.log('DocumentVersionsCtrlService');
    return function ($ctrl, $element) {

        $ctrl.itemTitle1 = 'Revision';

        $ctrl.itemTitle = 'Document ' + $ctrl.itemTitle1;
        $ctrl.objectType = "documentVersion";
        $ctrl.treeClass = ".versions-list";

        $ctrl.getTooltip = getTooltip;
        $ctrl.onInitOther = onInitOther;
        $ctrl.onPostInitOther = onPostInitOther;
        $ctrl.getPaginationServiceParams = getPaginationServiceParams;
        $ctrl.withProperty = withProperty;
        $ctrl.getMorePopoverTemplateOther = getMorePopoverTemplateOther;
        $ctrl.select = select;


        $ctrl = new SidebarItemsCtrlService($ctrl, $element);

        return $ctrl;

        function getTooltip(item) {
            //return item.lastSyncedAt ? 'Last synced on ' + (item.lastSyncedAt|amDateFormat:$ctrl.CPS.dateTimeFormat) + ' by '' + item.lastSyncedBy.name;
        }

        function onInitOther() {
            $ctrl.Events = _.extend($ctrl.Events, {
                Uploaded: 'UPLOADED_' + $ctrl.elemType + '_ITEM',
                ScriptSynced: 'SCRIPT_SYNCED_TO_PROJECT_SIDEBAR'
            });

            $ctrl.scriptDocumentVersionId = $ctrl.CurrentProduct.getProduct().script.documentVersionId;
        }

        function onPostInitOther() {
            $ctrl.saveAsTemplate = saveAsTemplate;

            $ctrl.addRootWatcher($ctrl.Events.Uploaded, onUploaded);
            $ctrl.addRootWatcher($ctrl.Events.ScriptSynced, onScriptSyncedToProject);
        }

        function onUploaded(result) {
            console.log($ctrl.Events.Uploaded);
            $ctrl.onAdded(result);
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.'+$ctrl.objectType+'.Upload.success', 'success');

            //increment color
            /*var item = result && (result.item ? result.item : (result.document ? result.document : null));
            item = item && item.versionId ? $ctrl.service.convertResource(item.versionId) : null;
            var params = {color:getNextColor() };
            $ctrl.service.update(_.extend({_id:item._id},params), function(result) {
                if(result){
                    insertItem(_.extend(item, params));
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.Upload.success', 'success');
                }
            }, function(err){
                $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.documentVersion.Upload.error', 'error');
            });*/
        }

        function onScriptSyncedToProject(item) {
            console.log($ctrl.Events.ScriptSynced + ': onScriptSyncedToProjectSidebar');
            $ctrl.list.replaceElement(item);
        }

        function saveAsTemplate(item, info, e) {
            //planFetatures testmode
            var quotaType = item.type === 1 ? 'notesTemplates' : null;
            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});

            function process() {
                $ctrl.broadcastRoot('SAVE_DOCUMENTTEMPLATE_ITEM', item);
            }
        }

        function withProperty() {
            return {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.item.productId,
                documentId: $ctrl.item._id
            };
        }

        function getPaginationServiceParams() {
            return {
                list: new pagination(1000,
                    ["name", "version", 'subversion', 'scratchPad', "createdById", "createdAt", 'path', 'current', 'documentId', 'color', 'type',
                        'lastSyncedScriptId', 'lastSyncedContentId', 'lastSyncedAt', 'lastSyncedById', 'isLocked', 'notes', 'summary', 'titlePage', 'hideInInterface', 'scriptVersionId'],
                    ['name'],
                    ['name'],
                    ['createdById lastSyncedScriptId lastSyncedById']
                ),
                orders: {createdAt: -1}
            };
        }

        function getMorePopoverTemplateOther(item, isMobile) {
            var el = '';
            if (item.type === 1) {//for documents only
                el += $ctrl.getSideMenuLi({
                    type: 'saveAsTemplate',
                    action: 'Save as Template',
                    icon: 'star'
                });
            }
            return el;
        }

        function select(item) {
            if ($ctrl.SessionService.hasDocChanges) {
                $ctrl.saveDocChanges({onSuccess: onSuccess});
            } else {
                onSuccess();
            }

            function onSuccess() {
                $ctrl.onSelected(item);
            }
        }
    }
}

