            if (row.model === rowModel) {
                return;
            }

            var toRemoveIds = arrays.getRemovedIds(rowModel.tasks, row.model.tasks);
            for (i = 0, l = toRemoveIds.length; i < l; i++) {
                var toRemoveId = toRemoveIds[i];
