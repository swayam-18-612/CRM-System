angular.module('product.shots.shotUploads.controller.service', [
    'item.listTemplate.controller.service',
    'product.material.init.controller.service'
])
.service('ShotUploadsCtrlService', ShotUploadsCtrlService);
ShotUploadsCtrlService.$inject = ['GeneralItemEditCtrlService'];
function ShotUploadsCtrlService(GeneralItemEditCtrlService) {
    return function($ctrl, $element, isPopup){

        $ctrl.dontShowActivity= true;

        $ctrl.preInitGeneral = preInitGeneral;
        $ctrl.preSetTemplateData = preSetTemplateData;
        $ctrl.getBody = getBody;
        $ctrl.onAddEmptyShots = onAddEmptyShots;
        $ctrl.openProPopup = openProPopup;
        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function openProPopup(quotaType, e){
            $ctrl.openProPopupInit(quotaType, e, 0);
        }

        function preInitGeneral() {
            $ctrl.popupTitle = 'Add ' + $ctrl.itemTitle + 's';
            $ctrl.modalBodyFormClass = 'long540 margin-top-half';

            $ctrl.txtFileType = 'images';
            $ctrl.startOrder = null;
            $ctrl.remainingSize = null;
            $ctrl.imagesOnly = true;

            $ctrl.onFileUploaded = onFileUploaded;
            $ctrl.onBeforeFilesUploaded = onBeforeFilesUploaded;

            $ctrl.uploadBtnText = $ctrl.extraParam.uploadBtnText;

            $ctrl.multipleFiles = true;

            $ctrl.item.count = 6;
            $ctrl.Counter = [];
            for (var i = 1; i <= 20; i++) {
                $ctrl.Counter.push({id: i, text: i + ' ' + $ctrl.itemTitle + (i === 1 ? '' : 's')});
            }

            $ctrl.Settings = {
                Counter: $ctrl.Counter
            };

            $ctrl.items = [{
                icon: 'first-shotlist-1',
                name: 'Start Blank',
                desc: 'Estimate the number of ' + $ctrl.itemTitle.toLowerCase() + 's in this ' + $ctrl.nameForList.toLowerCase() + '.',
                method: 'onAddEmptyShots',
                btnText: 'Add ' + $ctrl.itemTitle + 's',
                withCounter: true
            }, {
                icon: 'first-shotlist-2',
                name: 'Start with Images',
                desc: 'Upload reference images or storyboards to get started.',
                method: 'openUploadFiles',
                btnText: 'Add Images',
                withCounter: false,
                isUploadBtn: true
            }];
        }

        function preSetTemplateData() {
            $ctrl.withFooterBtns = false;
            $ctrl.columnsList = [ {
                /*
                name: 'name',
                // withLabel: 'Shots count',
                prop: 'count',
                placeholder: '#',
                showMobile: true,
                type: $ctrl.SBFieldTypesService.PropTypes.Number,
                isRequired: true,
                order: 1,
                tabIndex: 1,
                tabNextIndex: 2,
                icon: '',
            */


                prop: 'count',
                canEdit: true,
                showMobile: true,
                type: $ctrl.SBFieldTypesService.PropTypes.Drp,
                parentContainer: true,
                itemLabel: 'text',
                itemValue: 'id',
                initListName: 'Counter',
                order: 1,
                tabIndex: 1,
                tabNextIndex: 2,
                icon: '',
                isLastRow: true,
                fixedHeight: true,
                drpMenuCls: 'col200',
                fieldClass: 'text-center',
            } ];
        }

        function getBody() {
            var el =
                '<div class="feature-selector '+$ctrl.pageClass+' product-boxes clearfix tooltip-bigger inline centered" style="max-width: 520px">',
            height=260;

            _.each($ctrl.items, function(item, i){
              el += '<div class="product-box documentTypes shotlist col-xs-6" style="height:'+height+'px">' +
                        '<div class="table-div">' +
                            '<div class="vtop">' +
                                '<div class="margin-top-half">' +
                                    '<div class="font-size-16 stronger spacing-half-bottom text-center">'+item.name+'</div>' +
                                    '<div class="initialcase text-center">'+item.desc+'</div>' +
                                    '<div class="form-group field margin-30 font-general font-general-13">' +
    (item.withCounter ? $ctrl.getPopupForm(): ('<div class="icon text-center docmodal '+item.icon+'"></div>'))+
                                    '</div>' +
                                  '<div class="form-group field margin-top-half" style=" display: flex">'+ getBtn(item) + '</div>'+
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>';
                      if(i === 0){
                   el += '<div class="col40 hidden-xs" style="padding:10px; box-shadow: none; height:'+height+'px">' +
                              '<div style="height:20;display: flex;justify-content: center;align-items: center">' +
                                  '<span class="long-dash" style="line-height: 4px;">–</span>' +
                                  '<span class="uppercase with-padding-left with-padding-right">OR</span>' +
                                  '<span class="long-dash" style="line-height: 4px;">–</span>' +
                              '</div>' +
                          '</div>';
                      }
            });

            el += '</div>';
            return el;

            function getBtn(item){
                var cls = 'with-no-padding full-width btn btn-primary ' +
                    ($ctrl.pageClass||'');
                return item.isUploadBtn ? getBtnUpload(item, cls) :
                    ('<button class="colh36 '+ cls + '" type="button" ng-click="$ctrl.' + item.method + '($event)" ng-disabled="$ctrl.isUpdating'+item.i+ '" data-type="'+item.method+'" analytics-on analytics-action="'+item.btnText+'"> <span class="sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating' + item.i + ' === true"></span> <span style="line-height: 36px;">'+item.btnText+'</span></button>');
            }

            function getBtnUpload(item, btnCls){
                var cls = btnCls+' height36 full-width',
                    hasQuotaType = $ctrl.extraParam.quotaType ? $ctrl.CPS.hasQuotaType($ctrl.extraParam.quotaType) : true;
                return hasQuotaType ? ("<upload-files-btn " +
                    'class="full-width" '+
                    'show-text-on-ipad="true" ' +
                    "btn-class='"+cls+"' " +
                    'btn-text="::\''+item.btnText+'\'" ' +
                    'show-title="true" ' +
                    "start-order='::$ctrl.startOrder' " +
                    "remaining-size='::$ctrl.remainingSize' " +
                    "images-only='::$ctrl.imagesOnly' " +
                    "multiple-files='::$ctrl.multipleFiles' " +
                    "max-number-of-files='::$ctrl.maxNumberOfFiles' " +
                    ($ctrl.dontShowActivity ? 'dont-show-activity="true"' :'') +
                    ($ctrl.codeName ? ('code-name="'+$ctrl.codeName+'" ') : '') +
                     "on-file-uploaded='$ctrl.onFileUploaded(result)' " +
                    (typeof($ctrl.onBeforeFilesUploaded) === 'function' ? "on-before-files-uploaded='$ctrl.onBeforeFilesUploaded(result)'" : '') +
                    "></upload-files-btn>") : ('<button type="button" class="btnUpload ' + cls + ' ' + $ctrl.getBtnActionCls() + '" data-type="openProPopup" analytics-on analytics-action="'+item.btnText+'"><div>'+item.btnText+'</div></button>');
            }
        }

        function onBeforeFilesUploaded(result){
            console.log('ShotUploadsCtrlService.onBeforeFilesUploaded');
//preinsert shots
            //for each shot set the matching file id

            $ctrl.extraParam.onBeforeFilesUploaded(result);
        }

        function onFileUploaded(result){
            console.log('ShotUploadsCtrlService.onFileUploaded');
            if(result && result.item){
                result.dontShowActivity = $ctrl.dontShowActivity;
            }
            $ctrl.extraParam.onFileUploaded(result);
            if(typeof ($ctrl.closePopup) === 'function') {
                $ctrl.closePopup();
            }
        }

        function onAddEmptyShots(e) {
            console.log('ShotUploadsCtrlService.onAddEmptyShots');
            $ctrl.preventDefault(e);

            if ($ctrl.isUpdating) {
                return;
            }

            $ctrl.error = null;
            if ($ctrl.item.count < 0) {
                $ctrl.error = $ctrl.itemTitle+' count must at least 1';
                return;
            }

            if (!$ctrl.isValidForm()) { return;}

            $ctrl.isUpdating = true;

            $ctrl.extraParam.addEmptyShots({
                count: $ctrl.item.count,
                next: next,
                onQuotaOpen: onQuotaOpen,
                e: e
            });

            function onQuotaOpen(){
                $ctrl.isUpdating = false;
            }
            function next(err, result) {
                $ctrl.isUpdating = false;
                if (err) {
                    if (err && err.name === 'ValidationError') {
                        $ctrl.error = err.message;
                    } else if (err && err.name === 'LimitExceededError') {
                        $ctrl.error = err.message;
                        $ctrl.CPS.loadQuotaPopup($ctrl.quotaType, function () {
                        }, $ctrl.maxFreeItemsCount, err.count, $ctrl.compOptions, {e:e});
                    } else {
                        $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.shot.Create.error', 'error');
                        $ctrl.closePopup();
                    }
                } else if (result) {
                    $ctrl.closePopup();
                }
            }
        }
    }
}

