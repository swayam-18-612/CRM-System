                        '551b2066424bbb9d1cc87003', '551b2066424bbb9d1cc87002', '551b2066424bbb9d1cc87012',
                        '551b2066424bbb9d1cc87007', '551b2066424bbb9d1cc87009'
                    ]
                },
                {
                    name: 'Event Coverage or B-roll', id: 4, ids: [
                         '551b2066424bbb9d1cc87667',
                        '551b2066424bbb9d1cc87003', '551b2066424bbb9d1cc87002', '551b2066424bbb9d1cc87012',
                        '551b2066424bbb9d1cc87007', '551b2066424bbb9d1cc87009'
                    ]
                },
                {
                    name: 'How-To, Tutorial, or Explainer', id: 5, ids: [
                         '551b2066424bbb9d1cc87667', '551b2066424bbb9d1cc87b67',
                        '551b2066424bbb9d1cc87003', '551b2066424bbb9d1cc87002', '551b2066424bbb9d1cc87012',
                        '551b2066424bbb9d1cc87007', '551b2066424bbb9d1cc87009'
                    ]
                },
                {
                    name: 'Music Video', id: 6, ids: [
                        '551b2066424bbb9d1cc87667', '551b2066424bbb9d1cc87b67',
                        '58ee8752152efb50dbe0fec9', '551b2066424bbb9d1cc87006', '551b2066424bbb9d1cc87106',
                        '551b2066424bbb9d1cc87003', '551b2066424bbb9d1cc87002', '551b2066424bbb9d1cc87012',
                        '551b2066424bbb9d1cc87007', '551b2066424bbb9d1cc87009'
                    ]
                },
                {
                    name: 'Animation', id: 7, ids: [
                        '58ce8752133efb50dbe0fec9', '551b2066424bbb9d1cc87667',
                        '551b2066424bbb9d1cc87004', '551b2066424bbb9d1cc87008',
                        '551b2066424bbb9d1cc87011', '551b2066424bbb9d1cc87010',
                        '58ee8752152efb50dbe0fec9', '551b2066424bbb9d1cc87006',
                        '551b2066424bbb9d1cc87003', '551b2066424bbb9d1cc87002', '551b2066424bbb9d1cc87012',
                        '551b2066424bbb9d1cc87007'
                    ]
                },
                {
                    name: 'Photo Shoot', id: 8, ids: [
                        '551b2066424bbb9d1cc87667',
                        '58ee8752152efb50dbe0fec9', '551b2066424bbb9d1cc87106',
                        '551b2066424bbb9d1cc87003', '551b2066424bbb9d1cc87002', '551b2066424bbb9d1cc87012',
                        '551b2066424bbb9d1cc87007', '551b2066424bbb9d1cc87009'
                    ]
                },
                {
                    name: 'Video Essay, Commentary, or Trailer', id: 9, ids: [
                          '551b2066424bbb9d1cc87667', '551b2066424bbb9d1cc87b67',
                        '551b2066424bbb9d1cc87003',  '551b2066424bbb9d1cc87012',
                        '551b2066424bbb9d1cc87007',
                    ]
                }
            ];
            if (!$ctrl.Settings) {
                $ctrl.Settings = {};
