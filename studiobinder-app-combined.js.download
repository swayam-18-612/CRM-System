angular.module('app.notifications.item.component', [
])
.component('notification', {
    controller: 'AppNotificationsItemCtrl',
    bindings: {
        notification: '<',
        onRemove: '&'
    }
})
.controller('AppNotificationsItemCtrl', AppNotificationsItemCtrl);

AppNotificationsItemCtrl.$inject = ['TemplateCompileCompCtrlService','$element'];
function AppNotificationsItemCtrl(TemplateCompileCompCtrlService, $element) {
   // console.log('AppNotificationsItemCtrl');
    var $ctrl = this,
        id = 'toast-item-wrapper',
        withoutTemplateScope = true;

    $ctrl.remove = remove;

    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function getItemTemplate() {
        var n = $ctrl.notification;
        return "<div class='"+id+"'>" +
                "<div class='toast-item effect-jelly fade-in "+(n.isSticky ? ('sticky ' + n.type) : '')+"' id='not"+n.id+"'>" +
                    "<div class='inner-wrapper table-div'>" +
                        "<div class='toast-type-success centered'>" +
                            "<div class='toast-item-image'>" + $ctrl.LCS.getISBDiv(n.type, 3, 'sbf20') + "</div>" +
                        "</div>" +
                        "<div class='centered'>" +
                            "<div class='message'>"+n.message+"</div>" +
                        "</div>" +
                    "</div>" +
            $ctrl.LCS.getISBDiv('close-bigger', 2, 'toast-item-close') +
                "</div>" +
            "</div>";
    }

    function onDestroy() {
        //console.log('onDestroy');
        bind(false);
        removeItem();
    }

    function onLoaded() {
        bind(true);
    }

    function bind(isBind) {
        $ctrl.LCS.bindElementListeners(isBind, $ctrl.element.querySelector('.toast-item-close'), $ctrl.remove);
    }

    function remove(e) {
        $ctrl.preventDefault(e);
        //console.log('remove');
        bind(false);
        $ctrl.LCS.removeElementChild($ctrl.element, '.'+id);
        removeItem();
    }

    function removeItem() {
        $ctrl.onRemove({notification: $ctrl.notification});
    }
}

angular.module('app.notifications', [
    'services.rootEvents',
    'app.notifications.item.component'
])
.component('appNotifications', {
    template: '<div ng-if="$ctrl.list" class="toast-container toast-position-top-right">' +
        '<notification id="not{{::notification.id}}" ng-repeat="notification in $ctrl.list" notification="notification" on-remove="$ctrl.remove(notification)"></notification>' +
        '</div>',
    controller: 'AppNotificationsCtrl'
})
.controller('AppNotificationsCtrl', AppNotificationsCtrl);

AppNotificationsCtrl.$inject = ['RootEventsService', 'i18nNotifications', '$scope'];
function AppNotificationsCtrl(RootEventsService, i18nNotifications, $scope) {
    var $ctrl = this,
        watchers = [];

    $ctrl.$onInit = $onInit;
    $ctrl.$onDestroy = $onDestroy;

    $ctrl.setSoundMethod = setSoundMethod;
    $ctrl.remove = remove;

    function $onInit() {
        $ctrl.soundMethod = null;
        i18nNotifications.start();
        RootEventsService.addToObservable(watchers, $scope, getNotifications, load, true);
    }

    function load(list) {
        var l = list && list.length > 0 ? list.length : 0;
        $ctrl.list = l > 0 ? list : null;
    }

    function getNotifications() {
        return i18nNotifications.getCurrent();
    }

    function setSoundMethod(soundMethod) {
        $ctrl.soundMethod = soundMethod;
    }

    function remove(notification) {
        i18nNotifications.removeOne(notification);
    }

    function $onDestroy() {
        // Make sure that the interval is destroyed too
        i18nNotifications.stop();
        RootEventsService.removeWatchers(watchers);
    }
}

angular.module('public.contactUs.email.component', [
    'services.sbHttp',
    'apiServices.ContactEmails'
])
.component('contactUsEmail', {
    controller: 'ContactUsEmailCtrl',
    bindings: {
        close: '&',
        inPopup:'@'
    },
})

.controller('ContactUsEmailCtrl',ContactUsEmailCtrl);
ContactUsEmailCtrl.$inject = ['ListItemTemplateFormCtrlService', 'localizedMessages', 'SbHttpService', 'ContactEmailsService', '$element'];

function ContactUsEmailCtrl(ListItemTemplateFormCtrlService, localizedMessages, SbHttpService, service, $element) {
    console.log('ContactUsEmailCtrl');
    var $ctrl = this;

    $ctrl.canEdit = true;
    $ctrl.dontAutoloadTemplate = false;

    $ctrl.contactUs = contactUs;
    $ctrl.onSuccess = onSuccess;
    $ctrl.onError = onError;
    $ctrl.onFinally = onFinally;

    $ctrl.preInitOther = preInitOther;
    $ctrl.getItemPopupTemplate = getItemPopupTemplate;
    $ctrl.setTemplateData = setTemplateData;

    $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

    function setColumns() {
       var eClassAttr = 'form-control hover-underline ';

        $ctrl.parentContainer = true;
        $ctrl.columnsList = [
            {
                name: 'Name',
                type: $ctrl.SBFieldTypesService.PropTypes.Field,
                prop: 'name',
                placeholder: 'Your name…',
                isRequired: true,
                icon: 'user',
                tabIndex: 1,
                tabNextIndex: 2,
                canEdit: $ctrl.canEdit,
                eClassAttr: eClassAttr
            }, {
                name: 'Email',
                prop: 'email',
                type: $ctrl.SBFieldTypesService.PropTypes.Email,
                canHide: true,
                order: 4,
                canEdit: $ctrl.canEdit,
                isRequired: true,
                placeholder: 'Your email…',
                icon: 'mail',
                tabIndex: 2,
                tabNextIndex: 3,
                eClassAttr: eClassAttr
            }, {
                name: 'Message',
                prop: 'message',
                eClassAttr: eClassAttr,
                type: $ctrl.SBFieldTypesService.PropTypes.Html,
                canEdit: $ctrl.canEdit,
                placeholder: 'Your message…',
                fieldClass: 'gray note',
                withBottomToolbar: true,
                parentContainer: true,
                triggerEditOnCol: true,
                wrapperClass: 'full-width',
                icon: 'notes',
                iconLevel: 3,
                isRequired: true,
                withoutClose:true
            }
        ];
    }

    function preInitOther() {
        $ctrl.canEdit = true;
        $ctrl.service = service;
        $ctrl.isPopup = $ctrl.inPopup === 'true' || $ctrl.inPopup === true;
        $ctrl.item = {name: null, email: null, message: null};
        $ctrl.whichForm = 1;
        $ctrl.formHolder = {};

        setColumns();
    }

    function contactUs(e) {
        $ctrl.preventDefault(e);
        if ($ctrl.isUpdating) {
            return;
        }
        SbHttpService.postRequest('/contact-us', {contact: $ctrl.item}, null, $ctrl.onSuccess, $ctrl.onError, $ctrl.onFinally);
    }

    function onSuccess(result) {
        $ctrl.whichForm = 2;
    }

    function onError(error) {
        var mes = error && error.data && error.data.error ? error.data.error : null;
        $ctrl.error = localizedMessages.getFromError(mes, 'contact_us.error');
    }

    function onFinally() {
        $ctrl.isUpdating = false;
    }

    function setTemplateData() {
        $ctrl.withBtnDisabled = true;
        $ctrl.withFooterBtns = true;
        $ctrl.btnText = 'Send';
        $ctrl.firstBtnMethod = 'contactUs';
        $ctrl.textAnalytics = 'Send Contact Message';
    }

    function getItemPopupTemplate() {
return '<div ng-switch on="$ctrl.whichForm" class="switch-container1">' +
            '<div ng-switch-when="1" class="switch-animation1 auto">' +
                $ctrl.getPopupHeaderForInfo({
                    icon: 'mail',
                    title: 'Contact Us'
                }) +
                '<div class="modal-body clearfix">' +
                    ' <div class="form-wrapper">' +
                        $ctrl.getErrorBlock()+
                        $ctrl.getPopupForm() +
                    '</div>' +
                '</div>' +
                $ctrl.getPopupFooter() +
            '</div>' +
            '<div ng-switch-when="2" class="switch-animation1">' +
                $ctrl.getPopupHeaderForInfo({
                    icon: 'mail',
                    title: 'Cool, you’re squared away!'
                }) +
                '<div class="modal-body clearfix">' +
                    '<p class="text-center spacing-bottom">Thank you for submitting your request. We\'ll be in touch soon. <br/>Please allow 1-2 business days for a response.<p>' +
                '</div>' +
                '<div class="modal-footer clearfix semi-tall"></div>' +
            '</div>' +
        '</div>';
    }
}

angular.module('public.contactUs.popup.component', [
    'public.contactUs.component'
])
.component('contactUsPopup', popupComponentParams('ContactUsPopupCtrl'))
.controller('ContactUsPopupCtrl', ContactUsPopupCtrl);
ContactUsPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', '$element'];
function ContactUsPopupCtrl(ItemTemplateCompileCtrlService, $element) {
    var $ctrl = this;
    $ctrl.isPopup = true;

    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function getPopupBodyContent() {
        return '<contact-email close="$ctrl.closePopup()" in-popup="true"></contact-email>';
    }
}

angular.module('public.contactUs.component', [
