angular.module('tree.item.remove.component', [
    'tree.item.remove.controller.service'
])
.component('treeItemRemovePopup', popupComponentParams('TreeItemRemovePopupCtrl'))
.controller('TreeItemRemovePopupCtrl', TreeItemRemovePopupCtrl);
TreeItemRemovePopupCtrl.$inject = ['TreeItemRemovePopupCtrlService', '$element'];

