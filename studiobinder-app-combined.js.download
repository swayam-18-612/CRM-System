CallsheetRecipientEditPopupCtrl.$inject = ['AddContactCtrlService', '$element'];
function CallsheetRecipientEditPopupCtrl( AddContactCtrlService, $element) {

    var $ctrl = this;
    $ctrl.isPopup = true;

    $ctrl.showDetailsId = 'showDetails';
    $ctrl.getPopupBodyContentOther = getPopupBodyContentOther
    $ctrl.postInitGeneralOther = postInitGeneralOther;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;

    $ctrl = new AddContactCtrlService($ctrl, $element, $ctrl.isPopup);

    function onLoaded(){
        bind(true);
    }

    function onDestroy(){
        bind(false);
    }

    function bind(isBind){
        $ctrl.bindElementClickBySelector(isBind, '#'+$ctrl.showDetailsId, onCheck);
    }

    function onCheck(e){
        $ctrl.preventDefault(e);
        var el = $ctrl.element.querySelector('#'+$ctrl.showDetailsId +' input');
        if(el) {
            if ($ctrl.item.showDetails) {
                el.removeAttribute('checked');
            } else {
                el.setAttribute('checked', 'checked');
            }
            $ctrl.item.showDetails = $ctrl.item.showDetails ? false : true;
        }
    }

    function postInitGeneralOther() {
        $ctrl.callsheetId = $ctrl.extraParam.callsheetId;

    }

    function getPopupBodyContentOther(){
    return '<div id="'+$ctrl.showDetailsId+'" class="custom-checkbox small with-label padding-right-5 position-relative callsheetsPage" style="margin-top: 14px;margin-bottom: 30px">' +
            '<label>' +
                '<input type="checkbox" '+($ctrl.item.showDetails ? 'checked="checked"' : '') +'>' +
                '<span>' +
                    '<span class="padding-left10 with-padding-right">Show email and phone on call sheet</span> ' +
                   /* '<div class="sbf info blueish position-absolute" tooltip-placement="bottom" tooltip="Show email and ">' +
                        '<span class="sbp p1"></span>' +
                        '<span class="sbp p2"></span>' +
                        '<span class="sbp p3"></span>' +
                    '</div>' +*/
                '</span>' +
            '</label>' +
        '</div>';
    }
}

angular.module('product.callsheet.calltime.routing', [
