angular.module('product.breakdown.sceneElements.controller.service', [])
SceneElementsCtrlService.$inject = ['TemplateCompileCompCtrlService'];
function SceneElementsCtrlService(TemplateCompileCompCtrlService) {
    return function ($ctrl, $element) {

        $ctrl.show = {all: true};
        $ctrl.toggleShow = toggleShow;
        $ctrl.isShow = isShow;

        $ctrl.getItemTemplate = getItemTemplate;

        $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);
        return $ctrl;

        function getItemTemplate() {
            return '<div class="outtercontainer show-scrollbar-on-hover">' +
                '<div class="innercontainer fancy-scrollbar">' +
                    '<div class="onloaded h-full">' +
                        '<div class="sidebarScrollingContainer h-full">' +
                            ($ctrl.count>0 ? getEls() : getEmpty()) +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>';

            function getEls() {
                return '<div>' +
                        '<div class="show-ipad text-center" style="height: 8px">&nbsp;</div>' +
                        '<h3 class="sceneElementsHeader text-left with-cursor" ng-click="$ctrl.toggleShow($event, null)">' +
                            '<span class="pull-left drp-arrow sbf sort-down" ng-class="{false:\'sort-right\', true:\'sort-down\'}[$ctrl.isShow(null)]"></span>Scene Elements&nbsp;&nbsp;('+$ctrl.count+')' +
                        '</h3>' +
                        getCategories() +
                    '</div>';
            }

            function getEmpty() {
                return '<div class="todono h-full table-div">' +
                            '<div class="centered text-center">' +
                    '<div class="centered circled-svg-colored small150 breakdown '+
                    ($ctrl.pageClass ? $ctrl.pageClass : '') +
                    '">' + $ctrl.LCS.getISBDiv('breakdowns', 3)+ '</div>' +
                                '<div class="text-center">' +
                                    '<h3 class="text-center">No elements have been tagged <br/>in this scene yet.</h3>' +
                                '</div>' +
                            '</div>' +
                        '</div>';
            }

            function getCategories() {
         var el = '<ul class="categories-table">';
             _.each($ctrl.categories, function (c, i) {
                 if(c.type !== 3 && $ctrl.taggingScenes['c'+c._id]){
            el += '<li class="category" ng-class="{\'active\': $ctrl.isShow(\''+c._id+'\')}">' +
                        '<div class="sidebaritem full-width" ng-click="$ctrl.toggleShow($event, \''+c._id+'\')">' +
                            '<div class="icon-col categ-icon color-button small centered">'+
                                '<div style="background-color:' + c.color + '">' + $ctrl.LCS.getISBDiv(c.icon ? c.icon: 'elements', 6) + '</div>'+
                            '</div>' +
                            '<div class="title-col">' +
                                '<span>'+c.name+'</span>&nbsp;&nbsp;(<span>'+$ctrl.taggingScenes['c'+c._id].length+'</span>)' +
                                '<span class="drp-arrow sbf" ng-class="{false:\'sort-right\', true:\'sort-down\'}[$ctrl.isShow(\''+c._id+'\')]"></span>' +
                            '</div>' +
                        '</div>' +

                        '<ul class="elements" ng-show="$ctrl.isShow(\''+c._id+'\')">';

                            _.each($ctrl.taggingScenes['c'+c._id], function (item) {
                                el += '<li class="element list inline-tree-item" data-id="'+item._id+'">' +
                                    '<div class="full-width table-div sidebaritem clearfix with-tagging-selector">' +
                                        '<div class="title-element centered">' +
                                            '<div class="table-div full-width fixed-layout">' +
                        (item.currentId ?('<div class="centered col30"><div class="numbered-char with-margin-right">'+item.currentId+'</div></div>'):'') +
                                                '<div class="centered with-ellipsis with-padding-right"><span ' +
                                    (item.type===1 ? 'class="uppercase" ':'') +
                                    (item.name.length>20?(' tooltip-placement="top" tooltip="'+item.name+'"') :'')+
                                    '>'+item.name+'</span></div>' +
                                            '</div>' +
                                        '</div>' +
                                        '<div class="counter centered">' + (item.count?item.count:'')+'</div>' +
                                    '</div>' +
                                '</li>';
                            });
                  el += '</ul>' +
                    '</li>';
                }
             });
            el += '</ul>';

            return el;
            }
        }

        function isShow(id) {
            return (id !== null ? $ctrl.show['c' + id] : $ctrl.show.all) === true;
        }

        function toggleShow(e, id) {
            $ctrl.preventDefault(e);
            if (id === null) {
                $ctrl.show.all = $ctrl.show.all ? false : true;
                _.each($ctrl.categories, function (c) {
                    $ctrl.show['c' + c._id] = $ctrl.show.all;
                });
            } else {
                $ctrl.show['c' + id] = $ctrl.show['c' + id] ? false : true;
            }
        }
    }
}


angular.module('product.breakdown.sceneTagging.controller.service', [
    'resizableScriptFont.service'
])
.service('SceneTaggingCtrlService', SceneTaggingCtrlService);
SceneTaggingCtrlService.$inject = ['CompInitCtrlService', 'TemplateCompileService', 'ScriptConvertService', 'ResizableScriptFontService'];

function SceneTaggingCtrlService( CompInitCtrlService, TemplateCompileService, ScriptConvertService, ResizableScriptFontService) {
    return function ($ctrl, $element){
        $ctrl.ScriptConvertService = ScriptConvertService;
        $ctrl.ResizableScriptFontService = ResizableScriptFontService;

        var taggingClass = '.sceneTaggingSelector';
        var sceneWrapperClass = 'scene-wrapper';
        var isLoading = false;

        $ctrl.$onDestroy = $onDestroy;

        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl);
        }

        $ctrl.tagSelectorPopover = 'sb-popover';

        $ctrl.closedata = null;
        $ctrl.$element = $element;
        $ctrl.element = $ctrl.$element[0];
        $ctrl.ranges = {};

        $ctrl.$onInit = $onInit;
        $ctrl.tagSelected = tagSelected;

        return $ctrl;

        function $onInit() {
            console.log('SceneTaggingCtrlService.$onInit');
            $ctrl.LCS.addClass($ctrl.element, 'scene-tagging-item ' +
                ($ctrl.tagOnClick ? 'tag-on-click' : '')
            );
            if (!$ctrl.scriptLoadingService) {
                console.log('sceneTagging doesn’t have $ctrl.scriptLoadingService');
            }

            $ctrl.StripsService = $ctrl.scriptLoadingService.getObjectService($ctrl.scriptLoadingService.TblTypes.Strips);
            $ctrl.compileTemplate = new TemplateCompileService($ctrl.$element, getItemTemplateInit, $ctrl);
            reloadTemplate();
        }

        function setResizableFont(){
            $ctrl.styleParentId = $ctrl.ResizableScriptFontService.set($ctrl.element, {
                maxFontSize: $ctrl.maxFontSize,
                minFontSize: $ctrl.minFontSize,
                docWrapperClass: $ctrl.docWrapperClass,
                //blockPaddingLeft: $ctrl.LCS.blockPaddingLeft,
                fixedPadding: $ctrl.fixedPadding
            })
        }

        function reloadTemplate() {
            console.log('SceneTaggingCtrlService.reloadTemplate: isInit: '+$ctrl.isInit);
            $ctrl.compileTemplate.loadTemplate(onLoaded);
        }

        function getItemTemplateInit() {
            console.log('SceneTaggingCtrlService.getItemTemplateInit');
            if(!$ctrl.isInit) {
                return '<preloader-center class="'+($ctrl.pageClass?('preloader '+$ctrl.pageClass):'')+'"></preloader-center>';
            }
            return getItemTemplate();
        }

        function getItemTemplate() {
            console.log('SceneTaggingCtrlService.getItemTemplate');
            var likeOnScript = true,
                isOmitted = ($ctrl.item.isNotOmitted !== undefined ? $ctrl.item.isNotOmitted : $ctrl.item.active) === false;
            initTags(isOmitted);


            return '<div class="sceneEditor screenplayeditor scene-tagging-content' + ($ctrl.element.getAttribute('side-margin') ? ' screenplay-padding' : '') + '">' +
                        '<div class="scene-content clearfix init-top-margin ' +
                            ($ctrl.clsSceneWrapperOther ? ($ctrl.clsSceneWrapperOther + ' ') : '') +
                            sceneWrapperClass + '"' +
                            (isOmitted ? ' data-omitted="true"' : '') +
                        '>' +
                            ($ctrl.htmlContent ? $ctrl.htmlContent :
                                    $ctrl.ScriptConvertService.getHtmlContent({
                                        type: $ctrl.ScriptConvertService.ParTypes.scene.v,
                                        text: $ctrl.SBFieldMethods.getMiniTitle($ctrl.item, likeOnScript)
                                    }, $ctrl.SBFieldMethods.getSceneText($ctrl.item), isOmitted)
                                // + '<div class="spacing no-scene-content text-center hide-print">There is no content for this scene</div>')
                            ) +
                        '</div>' +
                    '</div>';

            function initTags(isOmitted) {
                console.log('initTags');
                if ($ctrl.item) {
                    $ctrl.scene = $ctrl.item.scene;
                    $ctrl.htmlContent = $ctrl.StripsService.getHtmlContentWithEmpty($ctrl.item, isOmitted, likeOnScript);
                    $ctrl.stripId = $ctrl.item.stripId ? $ctrl.item.stripId : $ctrl.item._id;
                    if ($ctrl.withTagging) {
                        $ctrl.addRootWatcher('RELOAD_TAG_ELEMENT_' + $ctrl.stripId, onReloadTagElement);
                    }
                    $ctrl.addRootWatcher('HIGHLIGHT_TAGS_' + $ctrl.stripId, onHighlightStrip);
                } else {
                    $ctrl.htmlContent = null;
                    $ctrl.scene = null;
                    $ctrl.stripId = null;
                }

                $ctrl.copyItem = _.clone($ctrl.item);
            }
        }

        function onLoaded() {
            console.log('SceneTaggingCtrlService.onLoaded: isInit:'+$ctrl.isInit);
            if(!$ctrl.isInit){
                $ctrl.isInit = true;
                setResizableFont();
                reloadTemplate();
            } else if ($ctrl.htmlContent) {
                $ctrl.elSceneWrapper = $ctrl.element.querySelector('.' + sceneWrapperClass);

                if ($ctrl.withTagging === true && $ctrl.canEdit) {
                    bind(true);
                }

                onHighlightElements();
                $ctrl.addRootWatcher('HIGHLIGHT_ALL_TAGS', highlightTags);
            }
        }

        function bind(isBind) {
            if (!$ctrl.elSceneWrapper) {return;}
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.elSceneWrapper, $ctrl.tagSelected, null, getMethodForTag());
            //  angular.element($ctrl.elSceneWrapper)[m](clickUp, $ctrl.tagSelected);

            function getMethodForTag(){
                return $ctrl.tagOnClick ? null :
                    (($ctrl.LCS.isTouchScreen ? 'touchend' : 'mouseup') + ' keyup paste');
            }
        }


        function addTaggingInfoToSpan(id, span, cls) {
            span.setAttribute("id", id);
            span.setAttribute("class", cls +
                ($ctrl.canEdit && $ctrl.withTagging? ' with-sb-popover' :'')
            );
            if($ctrl.canEdit && $ctrl.withTagging){
                span.setAttribute('popover-type', 'tagging-selector');
            }
        }

        function addTaggingSelector(text, range, sceneElement, content) {
            console.log('addTaggingSelector:' + text);
            var id = sceneElement ? ('el' + sceneElement._id) : null;
            if (id && $ctrl.elSceneWrapper && $ctrl.elSceneWrapper.querySelector('#' + id)) {
                return;
            }
            var hasd = content ? false : hasDivs(range);
            if (!(text !== '' && !hasd)) {
                return;
            }

            var span = document.createElement('span');
            if(!$ctrl.tagOnClick){
                span.appendChild(range.extractContents());
            }

            //existing element
            if (sceneElement) {
                addTaggingInfoToSpan(id, span, 'with-highlight');
                var c = getTaggingCategoryById(sceneElement.categoryId);
                if (c) {
                    var color = c.color;
                    span.style.color = color;
                    span.setAttribute('data-color', color);
                } else {
                    console.log('category doesnt exist:' + sceneElement.categoryId);
                }

                if ($ctrl.canEdit && $ctrl.withTagging) {
                    span.style.cursor = 'pointer';

                    var tagElement = function (e) {
                        console.log('tagged element ');
                        if ($ctrl.LCS.findClosestParent(e.target, taggingClass)) {
                            return;
                        }
                        var data = e.data;
                        if (data.sceneElement) {
                            $ctrl.LCS.addClass(e.target, 'active');
                        }

                        createTaggingSelector(data.range, data.sceneElement, id, clearTaggingSelector);

                        function clearTaggingSelector(closedata) {
                            onReloadTagElement({
                                item: data.sceneElement,
                                range: data.range,
                                type: 'Edit',
                                cancel: true
                            });
                        }
                    }


                    if (!$ctrl.tagsLoaded) {
                        $ctrl.tagsLoaded = {};
                    }

                    $ctrl.tagsLoaded [id] = {
                        result: bindSpan(span, true),
                        m: function (result) {
                            console.log('tagsLoaded ' + id);
                            //unbind the event
                            var span = $ctrl.element.querySelector('#' + id);
                            if(span) {
                                bindSpan(span, false, result);
                                //remove the external tag
                                console.log('remove the external tag for ' + span.innerText);
                                span.outerHTML = span.innerText;
                            }
                        }
                    };

                    function bindSpan(span, isBind, result){
                        var handler = {
                            range: range,
                            sceneElement: _.extend({}, sceneElement, {name: text})
                        }
                        $(span)[isBind ? 'on' : 'off']($ctrl.LCS.clickEvent, isBind ? handler : result.handler, isBind ? tagElement : result.tagElement);

                        if(isBind) {
                            return {
                                handler: handler,
                                tagElement: tagElement
                            }
                        }
                    }
                }

                range.insertNode(span);

                function getTaggingCategoryById(id) {
                    return $ctrl.categories && $ctrl.categories.length>0 ? _.find($ctrl.categories, {_id: id}) : $ctrl.scriptLoadingService.getTaggingCategoryById(id);
                }
            }

            //new tag
            else {
                id = 'newTag' + new ObjectId().toString();
                addTaggingInfoToSpan(id, span, 'new-highlight');

                range.insertNode(span);
                var position = getPosition(range, text);
                console.log(position);
                createTaggingSelector(range, _.extend({
                    productId: $ctrl.CPS.productId,
                    position: position,
                    name: text.trim(),
                    isNew: true,
                    stripId: $ctrl.stripId,
                    scriptId: $ctrl.CPS.scriptId,
                    count: 1,
                    allScenes: false,
                }, $ctrl.getNewElementParams ? $ctrl.getNewElementParams() : null), id, function clearTaggingSelector(closedata) {
                    console.log('clearTaggingSelector');
                    onReloadTagElement({
                        type: 'Create',
                        cancel: true,
                        popupAnchor: id
                    });

                });

                function getPosition(r, text) {
                    var length = text.length;
                    var range = r.cloneRange();
                    range.startContainer.parentNode.normalize();
                    var el = range.startContainer;
                    var divPar = null, tagName = 'div';
                    if (el.tagName && el.tagName.toLowerCase() === tagName && el.id && el.id.indexOf('par') === 0) {
                        divPar = el;
                    } else {

                        var parentNode = getParent(el);
                        while (parentNode) {
                            if (parentNode.tagName && parentNode.tagName.toLowerCase() === tagName) {
                                divPar = parentNode;
                                break;
                            }

                            parentNode = getParent(parentNode);
                        }
                    }

                    // Find first ancestor of el with tagName = div
                    function getParent(el) {
                        return el ? el.parentNode : null;
                    }

                    var endOffset = getOffsetWithinParent(divPar, range);
                    range.detach();
                    var parId = divPar.getAttribute('id');
                    try {
                        parId = parId ? parId.replace('par', '') : '0';
                    } catch (e) {
                    }

                    return {
                        length: length,
                        parId: parId ? parId : null,
                        offset: endOffset !== undefined ? (endOffset - length) : 0,
                        variant: text
                    };

                    function getOffsetWithinParent(el, range) {
                        var preCaretRange = range.cloneRange();
                        preCaretRange.selectNodeContents(el);
                        preCaretRange.setEnd(range.endContainer, range.endOffset);
                        var length = preCaretRange.toString().length;
                        preCaretRange.detach();
                        return length;
                    }
                }
            }

            function createTaggingSelector(range, sceneElement, id, clearTaggingSelector, otherAttrs) {
                var anchorElement = $ctrl.element.querySelector('#' + id);
                if (!$ctrl.templatePopover) {
                    $ctrl.templatePopover = new TemplateCompileService(null);
                }
                loadTemplate('popover' + new ObjectId().toString());

                function loadTemplate(popoverID){
                    $ctrl.templatePopover.loadTemplate(function (clonedElement) {
                        console.log('uploader loaded');
                    }, getCtrl(), angular.element(anchorElement), getTemplate());

                    function getCtrl() {
                        return _.extend( getGenerateContentMethod(), {
                            anchorElement: anchorElement,
                            onCloseDrp: onCloseDrp,
                        });
                    }

                    function getGenerateContentMethod() {
                        return {
                            generateContent: function (drpMenuId) {
                                return {
                                    $ctrl: getCtrl1(),
                                    template: getTemplate1(drpMenuId)
                                };
                            }
                        }
                    }

                    function getCtrl1() {
                        return _.extend({
                                scriptLoadingService: $ctrl.scriptLoadingService,
                                sceneElement: sceneElement,
                                range: range,
                                onPopupClosed: onPopupClosed,
                            }, typeof ($ctrl.getTagSelectorParams) === 'function' ? $ctrl.getTagSelectorParams() : null);
                    }

                    function getTemplate1(drpMenuId) {
                        if(!$ctrl.tagSelector){
                            console.warn('Parent for SceneTaggingInitCtrlService must define tagSelector');
                        }
                        return "<" + $ctrl.tagSelector + " " +
                            "id='" + drpMenuId + "' " +
                            "popup-anchor='#" + id + "' " +
                            "script-loading-service='::$ctrl.scriptLoadingService' " +
                            "range='::$ctrl.range' " +
                            "scene-element='::$ctrl.sceneElement' " +
                            "on-popup-closed='$ctrl.onPopupClosed()' " +
                            "class='" +
                                taggingClass.replace('.', '') +
                                (' ' + $ctrl.tagSelector) +
                                " sb-dropdown-menu parent-dropdown-menu clearfix' " +
                            otherAttrs +
                            (typeof($ctrl.getTagSelectorAttr) === 'function' ? $ctrl.getTagSelectorAttr() : '') +
                            "></" + $ctrl.tagSelector + ">";
                    }

                    function getTemplate() {
                        return '<' + $ctrl.tagSelectorPopover+ ' '+
                            'id="' + popoverID + '" ' +
                            'parent-container="true" ' +
                            'dont-close-popover-on-click="true" '  +
                            'anchor-element="::$ctrl.anchorElement" ' +
                            'on-close-drp="$ctrl.onCloseDrp()" ' +
                            'on-open-drp="$ctrl.onOpenDrp()" ' +
                            'generate-content="$ctrl.generateContent(drpMenuId)" ' + //is added to the ctrl scope
                            '></' + $ctrl.tagSelectorPopover + '>';
                    }

                    function onPopupClosed(closedata) {
                        // aParent.remove($('#'+tagId)).end();
                        console.log('onPopupClosed');
                        onCloseDrp();
                        clearTaggingSelector(closedata);
                    }

                    function onCloseDrp() {
                        console.log('onpopover closed');
                        if(popoverID){
                            removeCompileTag();
                            $ctrl.LCS.removeElement(document.getElementById(popoverID));
                            popoverID = null;
                        }
                    }
                }
            }

            function hasDivs(range) {
                if($ctrl.dontCheckForDivs){return false;}
                var content = $ctrl.LCS.getRangeContent(range, true);
                if (content.indexOf('</div>') !== -1 || content.indexOf('<div ') !== -1) {
                    return true;
                } else if (content.indexOf('</'+$ctrl.tagSelectorPopover+'>') !== -1 || content.indexOf('<'+$ctrl.tagSelectorPopover+' ') !== -1) {
                    return true;
                }
                return false;
            }
        }

        function tagSelected(e) {
            console.log('tagSelected');
            $ctrl.preventDefault(e);
            if (isLoading) {return;}

            var target = e.target;
            //if is click inside an tagging-selector popover or on a span that is already element return
            if ($ctrl.LCS.findClosestParent(target, taggingClass) || $ctrl.LCS.hasClass(target, 'with-highlight')) {
                console.log('already with-highlight');
                return;
            }

            isLoading = true;

            var s = getSelection(e);
            if (s.text) {
                addTaggingSelector($ctrl.CPS.capitalizeFirst(s.text), s.range, null);
            }
            clearSelection(s);

            isLoading = false;

            function getSelection(e) {
                var text = '', selection, range;

                if ($ctrl.tagOnClick) {
                    //div[class*="divtype"]:not([class*="divtype0"]):not([class*="divtype3"]):not([class*="divtype4"])
                    var selector = $ctrl.ScriptConvertService.SBScriptEditorBlockType + getc() + getnotc('0') + getnotc('3') + getnotc('4');
                    console.log(selector);
                    var el = $ctrl.LCS.findClosestParent(e.target, selector);
                    if (el) {
                        selectTextInDiv(el);
                    }

                    function getc(c) {
                        return '[class*="' + $ctrl.ScriptConvertService.SBScriptEditorClass + (c || '') + '"]';
                    }

                    function getnotc(c) {
                        return ':not(' + getc(c) + ')';
                    }
                } else {
                    getDefaultSelection();
                }

                var s = {
                    selection: selection,
                    text: text && text !== '' ? text : null,
                    range: range,
                    t: $ctrl.MomentService.getTimestamp()
                };

                $ctrl.prevSelection = angular.copy(s);
                console.log('text:' + s.text);

                return s;

                function getDefaultSelection() {
                    selection = window.getSelection();
                    if (selection) {
                        if (selection.rangeCount > 0) {
                            range = selection.getRangeAt(0);
                            if (!$ctrl.LCS.isTouchScreen) {
                                // expand range to enclose any word partially enclosed in it
                                var regex = /\b/g, changedLeft, changedRight;
                                if (range && !range.collapsed) {
                                    while (range.startOffset > 0 && range.toString && range.toString().length > 0 && range.toString()[0].match(regex)) {
                                        range.setStart(range.startContainer, range.startOffset - 1);
                                        changedLeft = true;
                                    }
                                    if (changedLeft) {
                                        range.setStart(range.startContainer, range.startOffset + 1);
                                    }
                                    while (range.endOffset < range.endContainer.length && range.toString && range.toString().length > 0 && range.toString()[range.toString().length - 1].match(regex)) {
                                        range.setEnd(range.endContainer, range.endOffset + 1);
                                        changedRight = true;
                                    }
                                    if (changedRight) {
                                        range.setEnd(range.endContainer, range.endOffset - 1);
                                    }

                                   /* var spacesAtTheEnd = (range.toString().length - range.toString().trimRight().length);
                                    if(spacesAtTheEnd > 0) {
                                        range.setEnd(range.endContainer, range.endOffset - spacesAtTheEnd);
                                    } */
                                }
                            }
                            text = range.toString();
                        }
                    }
                    else {
                        selection = document.selection;
                        if (selection && selection.type === "Text") {
                            range = selection.createRange();
                            // expand range to enclose any word partially enclosed in it
                            range.expand("word");
                            text = range.text;
                        }
                    }

                    return s;
                }

                function selectTextInDiv(el){
                    if (window.getSelection && document.createRange) { //Browser compatibility
                        // Clear any current selection
                        selection = window.getSelection();
                        selection.removeAllRanges();

                        // Select paragraph
                        range = document.createRange();
                        range.selectNodeContents(el);
                        selection.addRange(range);

                        try{
                            text = selection.anchorNode.textContent;
                        }catch (e){
                            text = el.innerText;
                        }
                    }
                }
            }

            function clearSelection(s) {
                $ctrl.LCS.clearSelection(s.selection);
                $ctrl.prevSelection = null;
            }
        }

        function addTaggingSelectorForElement(sceneEl) {
            if (!sceneEl) {
                return;
            }
            var el = getTaggingElementById(sceneEl.elementId);

            if (!el) {
                return;
            }

            var position = sceneEl.position;
            if (position && position.length > 0) {
                var range = getRangeFromPosition(position);
                if (range) {
                    addTaggingSelector(el.name, range, sceneEl);
                }
            }

            function getTaggingElementById(id) {
                return $ctrl.elements && $ctrl.elements.length > 0 ? _.find($ctrl.elements, {_id: id}) : $ctrl.scriptLoadingService.getTaggingElementById(id);
            }
        }

        function onReloadTagElement(data) {
            var sceneEl = data.item,
                range = data.range,
                type = data.type,
                cancel = data.cancel;

            if (sceneEl && sceneEl.position && !range) {
                range = getRangeFromPosition(sceneEl.position);
            }
            if (!range) {
                return;
            }

            console.log('RELOAD_TAG_ELEMENT: ' + type + '; isCancel:' + (cancel === true));

            if (type === 'Remove') {
                removeTag();
            } else if (cancel) {
                if (type === 'Edit') {
                    removeTagSelector();
                } else if (type === 'Create') {
                    removeTag();
                }
            } else {// if create or edit succeeded remove tag and tagging-selector and reload tag
                removeTag();
                addTaggingSelectorForElement(sceneEl);
            }

            function removeTag() {
                console.log('removeTag');
                var el = removeTagSelector();
                if (el) {
                    var isBind = false;
                    $ctrl.LCS.bindElementsClick(isBind, el);
                    //$ctrl.LCS.insertElementAfter (el, el.innerHTML); // add text content after el
                    //el.parentNode.removeChild(el);  //remove el

                    var $el = angular.element(el);
                    $el.after($el.html()); // add text content after el
                    $el.detach(); //remove el
                }
            }

            function removeTagSelector() {
                console.log('removeTagSelector');
                var id = type === 'Create' ? (data.popupAnchor ? data.popupAnchor : null) : (sceneEl ? ("#el" + sceneEl._id) : null);

                if (!id) {return null;}

                //var el = $ctrl.elSceneWrapper.find("#el" + sceneEl._id);
                var el = $ctrl.elSceneWrapper ? $ctrl.elSceneWrapper.querySelector(id) : null;
                $ctrl.LCS.removeClass(el, 'active');
                return el;
            }
        }

        function getRangeFromPosition(position) {
            if (!position) {
                return null;
            }
            var variant = position.variant ? position.variant.toLowerCase() : null,
                variantLength = variant ? variant.length : 0,
                parId = position.parId,
                start = position.offset,
                end = start + (variantLength && position.length > variantLength ? variantLength : position.length ) - 1;
            if (start > end || start < 0) {
                return null;
            }
            var pars = $ctrl.elSceneWrapper ? $ctrl.elSceneWrapper.querySelectorAll("#par" + parId) : null,
                l = pars ? pars.length : 0;
            for(var i = 0 ; i < l; i++){
                var range = getRangeForPar(pars[i]);
                if(range){
                    return range;
                }
            }
            return null;

            function getRangeForPar(par) {
                var textNodeList = initTree(par);
                if (!textNodeList || textNodeList.length === 0) {
                    return null;
                }
                var length = 0, startNode, endNode, current = 0, startPos, endPos;

                while (length <= end) {
                    // we'been too far ? return
                    if (current >= textNodeList.length) {
                        return null;
                    }
                    var le = textNodeList[current].textContent.length;
                    // add the length of current node to our total length
                    length += le;
                    // start is less than the actual total length ?
                    if (start < length && !startNode) {
                        // then our startNode is here
                        startPos = start - (length - le);
                        startNode = textNodeList[current];
                    }
                    // same for the end
                    if (end < length && !endNode) {
                        endPos = end - (length - le) + 1;
                        endNode = textNodeList[current];
                    }

                    current++;
                }

                var range = document.createRange();
                range.setStart(startNode, startPos);
                range.setEnd(endNode, endPos);

                /*    var selection = window.getSelection();
                 selection.removeAllRanges();
                 selection.addRange(range);
                 return selection;*/

                if (variant) {
                    var content = $ctrl.LCS.getRangeContent(range, false);
                    return content && content.toLowerCase() === variant ? range : null;
                }

                return range;
            }

            function initTree(par) {
                // the array containing our textNodes
                var textNodeList = [];
                var treeWalker = document.createTreeWalker(par, NodeFilter.SHOW_TEXT, null, false);
                while (treeWalker.nextNode()) {
                    textNodeList.push(treeWalker.currentNode);
                }
                return textNodeList;
            }
        }

        function onHighlightElements(e) {
            if (!$ctrl.loadTags) {
                return;
            }
            //stylize all elements in category.se that have position.length>0
            console.log('onHighlightElements');
            highlightTags();
           // $ctrl.LCS.timeout(highlightTags, 0);
        }

        function onHighlightStrip(resetLoadTags) {
            if (!$ctrl.loadTags || resetLoadTags) {
                $ctrl.loadTags = true;
                highlightTags();
            }
        }

        function highlightTags() {
            var se = getTaggingScenes();

            removeUnexistingTags(se);
            addNewTags(se);

            function addNewTags(se){
                if (se && se.length > 0) {
                    for (var i = 0, n = se.length; i < n; i++) {
                        addTaggingSelectorForElement(se[i]);
                    }
                }
            }

            function removeUnexistingTags(se){
                var els = $ctrl.element.querySelectorAll('.with-highlight');
                if(els) {
                    _.each(els, function (t) {
                        var attr = t.getAttribute('id'),
                            id = attr.replace('el', '');
                        if(!se || se && !_.find(se, {_id: id})){
                            var tag = $ctrl.tagsLoaded ? $ctrl.tagsLoaded [attr] : null;
                            if(tag && typeof(tag.m) === 'function'){
                                tag.m(tag.result);
                            }
                        } // the el is not in the list of fb sceneTags anymore but is tagged in the script
                    });
                }
            }

            function getTaggingScenes() {
                return $ctrl.taggingScenes && $ctrl.taggingScenes.length > 0 ? _.filter($ctrl.taggingScenes, filtering) : $ctrl.scriptLoadingService.getTaggingScenes(filtering);

                function filtering(item) {
                    var stripLocationCategoryId = '5a69235fdf0fbc89a637c1c1';
                    return item.stripId === $ctrl.stripId && item.categoryId !== stripLocationCategoryId && item.position;
                }
            }
        }

        function removeCompileTag() {
            if($ctrl.templatePopover){
                $ctrl.templatePopover.destroyNewScope();
            }
        }

        function $onDestroy() {
            bind(false);
            removeCompileTag();
            $ctrl.removeWatchers();
            $ctrl.ResizableScriptFontService.remove($ctrl.styleParentId);
        }
    }
}

