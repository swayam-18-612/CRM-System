                                            '<div class="btn-group actions hide-print with-sb-popover with-cursor" popover-type="more-actions"><button type="button" class="col30 btn btn-default dropdown-toggle dots"><span class="sbf vertical-dots"></span></button></div>' +
                                        '</div>' +
