angular.module('services.layoutEventsService', [
    'services.layoutEventsService'
])
.service('LayoutEventsService', LayoutEventsService);

LayoutEventsService.$inject = ['RootEventsService'];
function LayoutEventsService(RootEventsService) {
    var _this = this;

    _this.onSettingsChanged = function (list, method) {
        var w = [];
        _.each(list, function (el) {
            w.push(_this.onSettingChanged(el, method));
        });
        return w;
    }

    _this.onSettingChanged = function (name, method) {
        return RootEventsService.onDefaultEmitted('LAYOUT_' + name, method);
    }

    _this.emitSettingChanged = function (name, val) {
        RootEventsService.broadcastRoot('LAYOUT_' + name, val);
    }

    return _this;
}



angular.module('services.layoutConfigsService', [
    'services.layoutEventsService',
    'services.persistenceService',
    'fullscreen.service'
])
.service('LCS', LCS);

LCS.$inject = ['FullscreenService', 'ELS', 'PersistenceService','LayoutEventsService', 'API_CONFIGS', '$timeout', '$window', '$document'];
function LCS(FullscreenService, ELS, PersistenceService, LayoutEventsService, API_CONFIGS, $timeout, $window, $document) {
    var resizeTimeout;
    var _this = this;

    _this.FullscreenService = FullscreenService;
    _this.ELS = ELS;
    _this.PersistenceService = PersistenceService;
    _this.collabBannerInside = !_this.collabBannerOnTop;

    _this.collabBannerOnTop = true;

    _this.$document = $document;
    _this.$timeout = $timeout;
    _this.$window = $window;

    _this.bannerColor = DefaultBannerColor;
    _this.shotBannerColor = DefaultShotBannerColor;
    _this.darkBannerColor = DefaultDarkBannerColor;
    _this.setupColor = DefaultSetupColor;

    _this.bindElementListeners = _this.ELS.bindElementListeners;

    _this.API_CONFIGS = API_CONFIGS();
    _this.isDebugMode = _this.API_CONFIGS.debugger && _this.API_CONFIGS.debugger.enabled;

    var configs = _this.API_CONFIGS;
    if (configs.oauth.enabled) {
        OAuth.initialize(configs.oAuthPublicKey, {cache: true});
    }
    _this.staticUrl = 'https://'+configs.staticDomain + '/'+configs.distdir + '/';
    _this.uploadLogo = configs.server.uploadLogo;
    _this.shortUrl = configs.site.shortUrl;
    _this.isSB = configs.site.appName.indexOf('StudioBinder') !== -1;
    _this.imgUrl = configs.imgUrl;
    _this.wwwUrl = configs.site.wwwUrl;
    _this.imgPaths = _this.staticUrl + 'img/';
    _this.timestamp = '?v=' + new Date().getTime();

    _this.settings = ['showComments', 'showProductBanner7',
        'showStripboardBanner', 'showStripboardBannerCollab',
        'showBreakdownsBanner', 'showBreakdownsBannerCollab',
        'showScriptBanner', 'showScriptBannerCollab',
        'showReportsBanner', 'showReportsBannerCollab',
        'showShotsBanner', 'showStoryboardsBanner', 'showShotsBannerCollab',
        'showCalendarBanner', 'showCalendarBannerCollab',
        'isFullscreen', 'isComments',
        'isTasks', 'isFilter',
        'showCompanySettings', 'showUseSceneNumbers', 'showDocumentsBanner1', 'showMaterialsBanner1', 'showScriptBanner1', 'showOnboarding', 'newsFeed',
        'callsheetSideBar', 'innerSideBar', 'mainSideBar', 'showsync'];

    _this.minWidthForSideFilters = 1199;
    _this.minWidthForSideBarGray = 768;
    _this.minWidthForSideBarComments = 768;

    //hasTouch = 'ontouchstart' in window,
    _this.isIOS = _this.ELS.isIOS;
    _this.webPEnabled = _this.ELS.webPEnabled;
    _this.isTouchScreen = _this.ELS.isTouchScreen && !_this.ELS.sbTwoInOneDevice;
    _this.clickEvent = _this.ELS.clickEvent;

    _this.hexToRgba = hexToRgba;


    _this.cloneAngularItem =  function cloneAngularItem(item){
        return item ? angular.copy(item) : item;
    }
     _this.setItemDetailsVisibility = function(isMobile, show, el){
         if(_this.findClosestParent(el, '.preview-simulation')){
             return;
         }

        _this[show ? 'addClass' : 'removeClass'](_this.bodyElement, 'mobile-details-modal');
         var method = _this[show ? 'addClass': 'removeClass'];
         setHide('#section-header');
         setHide('nav.filters');
         setHide('nav.callsheet-wizard');
         setHide('.user-top-nav');
         setPadding('.board-wrapper #body-wrapper');
         setPadding('.with-filters-above.side-table');

         function setHide(sel) {
             var el = _this.bodyElement.querySelector(sel);
             if(el){
                 method(el, 'ng-hide');
             }
         }
         function setPadding(sel) {
             var el = _this.bodyElement.querySelector(sel);
             if (el) {
                 if (show) {
                     if (!el.style) {
                         el.style = {};
                     }
                     el.style.paddingTop = '0px'
                 } else {
                     if (el.style) {
                         el.style.removeProperty('padding-top');
                     }
                 }
             }
         }
     };

    _this.getImgUrl = function(img, withoutImgPath, withoutWebp) {
        var path = img, ext = 'webp' ;
        if(!withoutWebp && img.indexOf('.svg') === -1 && img.indexOf('.gif') === -1 && (_this.webPEnabled&& img.indexOf('.'+ext) === -1)){
            path = withoutImgPath ? (img+'.'+ext) : img.replace(getExtension(img), ext);
        }
        return withoutImgPath ? path : (_this.imgPaths + path + _this.timestamp);
    }
    _this.getVideoUrl = function(img, withoutImgPath) {
        return withoutImgPath ? img : (_this.imgPaths + img + _this.timestamp);
    }

    _this.preventDefault = function (e) {
        if(e) {
            if(e.type === _this.clickEvent){
                //console.log('LCS.setLastClicked');
                _this.lastElementClicked = e.target;
            }

            try {
                //if is not touch screen preventdefaua
                if (!_this.isTouchScreen && e.preventDefault) {
                    e.preventDefault();
                }
            } catch (e) {
            }

            try {
                if (e.stopPropagation) {
                    e.stopPropagation();
                }
            } catch (e) {
            }
        }
    }
    function getExtension(fn) {
        var str = fn ? fn.split('.') : [];
        return str && str.length > 1 ? str.pop() : '';
    }


    _this.clearSelection = function clearSelection(selection) {
        if (!selection) {
            return;
        }
        if (typeof selection.empty === 'function') {
            selection.empty();
        } else if (typeof selection.removeAllRanges === 'function') {
            selection.removeAllRanges();
        }
    }
    _this.capitalizeFirst = function(v) {
        return v && v.length > 0 ? (String(v).charAt(0).toUpperCase() + String(v).slice(1)) : v;
    }
    _this.getRangeContent = function getRangeContent(range, isHtml) {
        var clonedSelection = range.cloneContents();
        var div = document.createElement('div');
        div.appendChild(clonedSelection);
        return isHtml ? div.innerHTML : div.textContent;
    }

    _this.autoselectElText = function(el) {
        if(!el){return;}
        el.focus();
        if (!$window.getSelection().toString()) {
            // Required for mobile Safari
            el.setSelectionRange(0, el.value.length);
        }
    }

    _this.getSetting = function getSetting(name) {
        return _this.getSettings(name);
    }

    _this.setSetting = function setSetting(name, val) {
        if (!name) {
            return;
        }
        if (PersistenceService.setProp('settings', name, val)) {
            LayoutEventsService.emitSettingChanged(name, val);
        }
    }

    _this.getSettings = function getSettings(name) {
        return PersistenceService.getProp('settings', name);
    }

    _this.isFullscreen = function isFullscreen(withSet) {
        var isOn =_this.getSetting('isFullscreen') === true;
        if(withSet) {
            _this.setFullscreen(isOn);
        }
        return isOn;

    }

    _this.onFullscreenChanged = function onFullscreenChanged(evt, isFullscreenEnabled) {
        _this.setSetting('isFullscreen', isFullscreenEnabled === true);
    }

    _this.setMainSideBar = function setMainSideBar(value) {
        var setting = 'mainSideBar',
            v = _this.getSetting(setting),
            isDif = false;
        if (value === undefined) {
            value = !v;
            isDif = true;
        } else if (v !== value) {
            isDif = true;
        }
        if (isDif) {
            _this.setSetting(setting, value);
        }
        if (_this.isMobileSize && value) {
            _this.toggleMobileOpened(true);
        }
    }

    _this.getMainSideBar = function getMainSideBar() {
        return _this.getSetting('mainSideBar');
    }

    _this.toggleMobileOpened = function toggleMobileOpened(val) {
        console.log('toggleMobileOpened');
        if(val !== undefined){_this.isMobileOpened = val}
        _this.isMobileOpened = _this.isMobileOpened ? false : true;
        if (!_this.isMobileOpened && _this.isMobileSize) {
            _this.closeInnerSidebar();
        }
        LayoutEventsService.emitSettingChanged('isMobileOpened', _this.isMobileOpened);
    }

    _this.closeInnerSidebar = function() {
        closeInnerSidebarInit(getInnerSidebarProp('innerSideBar'));
    }

    _this.toggleInnerSidebar = function(p, val) {
        toggleInnerSidebarInit(getInnerSidebarProp(p), val);
    }

    _this.hasInnerSidebar = function(p) {
       return hasInnerSidebarInit(getInnerSidebarProp(p));
    }

    function toggleInnerSidebarInit(prop, val){
        if(val === undefined){
            val = hasInnerSidebarInit(prop) ? false : true;
        }
        _this.setSetting(prop, val);
        return val;
    }

    function hasInnerSidebarInit(prop) {
        var v = _this.getSetting(prop);
        if(v === undefined){
            //start closed on mobile
            v = (_this.isMobileSize ? false : true);
            _this.setSetting(prop, v);
        }
        return v;
    }

    function closeInnerSidebarInit(prop) {
        if (hasInnerSidebarInit(prop)) {
            toggleInnerSidebarInit(prop, false);
        }
    }

    function getInnerSidebarProp(prop){
        return 'innerSideBar' + (prop ? prop : '') + (_this.isMobileSize ? '_mobile' : true);
    }

    _this.toggleCallsheetSidebar = function() {
        _this.toggleInnerSidebar('callsheetSideBar');
    }

    _this.hasCallsheetSidebar = function() {
        return _this.hasInnerSidebar('callsheetSideBar');
    }

    _this.onToggleInnerSidebar = function(prop, method){
        return LayoutEventsService.onSettingChanged(getInnerSidebarProp(prop), method);
    }

    _this._noSidebarFilters = function () {
        return _this.windowWidth > _this.minWidthForSideFilters;
    }
    _this._isMobileSize = function (windowWidth) {
        return (windowWidth ? windowWidth : _this.windowWidth) <= _this.minWidthForSideBarGray;
    }

    _this._noSidebarGray = function (windowWidth) {
        return (windowWidth ? windowWidth : _this.windowWidth) <= _this.minWidthForSideBarGray;
    }

    _this.noSidebarComments = function () {
        return _this.windowWidth <= _this.minWidthForSideBarComments;
    }


    _this.onToggleOnboarding = function (method) {
        return LayoutEventsService.onSettingChanged('showOnboarding', method);
    }

    _this.onToggleComments = function (method) {
        return LayoutEventsService.onSettingChanged('isComments', method);
    }
    _this.onToggleNewsFeed = function (method) {
        return LayoutEventsService.onSettingChanged('newsFeed', method);
    }

    _this.onToggleTasks = function (method) {
        return LayoutEventsService.onSettingChanged('isTasks', method);
    }
    //not used
    _this.onIsFullScreenChanged = function (method) {
        return LayoutEventsService.onSettingChanged('isFullscreen', method);
    }
    _this.onIsSideBarCollapsedChanged = function (method) {
        return LayoutEventsService.onSettingChanged('mainSideBar', method);
    }
    _this.onInnerSidebarChanged = function (method) {
        return LayoutEventsService.onSettingChanged('innerSideBar', method);
    }

    _this.onIsMobileOpenedChanged = function (method) {
        return LayoutEventsService.onSettingChanged('isMobileOpened', method);
    }

    _this.onIsMobileSizeChanged = function (method) {
        return LayoutEventsService.onSettingChanged('isMobileSize', method);
    }

    _this.onWindowWidthChanged = function (method) {
        return LayoutEventsService.onSettingChanged('windowWidth', method);
    }

    _this.onWindowHeightChanged = function (method) {
        return LayoutEventsService.onSettingChanged('windowHeight', method);
    }

    _this.initAppSettings = function initAppSettings(next) {
        //console.log('initAppSettings');
        getBodyElement();

        onResizeWindow();
        init();

        if(typeof (next) === 'function') {
            next();
        }

        angular.element($window).bind('resize', _this.resizeWindow);

        function init() {
            var settings = _this.settings, l = settings.length;
            _this.settings.forEach(function (s) {
                if (_this.getSetting(s) === undefined) {
                    var val = true;
                    if (s === 'isArchived' || s === 'isFullscreen') {
                        val = false;
                    } else if (s === 'innerSideBar' || s === 'callsheetSideBar') {
                        if (_this.noSidebarFilters) {
                            val = false;
                        }
                    }

                    _this.setSetting(s, val);
                }
            });

            var cls = '';
            if (_this.isTouchScreen) {
                cls += 'is-touch-screen ';
            }
            if (_this.sbTwoInOneDevice) {
                cls += 'is-two-in-one-device ';
            }
            if (_this.webPEnabled) {
                cls += 'webp ';
            }
            if (cls !== '') {
                _this.addClass(_this.bodyElement, cls);
            }

            var backgroundObserver = lozad('.lozad-background', {threshold: 0});
            backgroundObserver.observe();
        }
    }

    _this.resizeWindow = function resizeWindow() {
        //console.log('resizeWindow');
        if(resizeTimeout){clearTimeout(onResizeWindow);}
        resizeTimeout = setTimeout(onResizeWindow, 100);
    }

    function onResizeWindow() {
        var height = $window.innerHeight;
        if (_this.getWindowHeight() !== height) {
            _this.setWindowHeight(height);
        }

        var width = $window.innerWidth;
        if (_this.getWindowWidth() !== width) {
            _this.setWindowWidth(width);
            setBody(width);
        }
        //LCS.togglefullscreen();

        function setBody(width) {
            if (getBodyElement()) {
                if (width > _this.minWidthForSideBarGray) {
                    _this.addClass(_this.bodyElement, 'withInnerSidebar');
                    _this.removeClass(_this.bodyElement, 'withOutsideSidebar');
                } else {
                    _this.addClass(_this.bodyElement, 'withOutsideSidebar');
                    _this.removeClass(_this.bodyElement, 'withInnerSidebar');
                }

                if (!_this.bodyElement.style) {
                    _this.bodyElement.style = {};
                }
                _this.bodyElement.style.width = width + 'px';
            }
        }
    }

    _this.resizePage = function resizePage() {
        console.log('resizePage');
        $window.scrollTo(0, 0);    //scroll to top of page after each route change
        _this.resizeWindow();
    }

    _this.toggleFullscreen = function () {
        if (_this.FullscreenService.isEnabled()) {
            _this.FullscreenService.cancel();
        } else {
            _this.FullscreenService.all();
        }
    }

    _this.togglefullscreen = function () {
        _this.setFullscreen(_this._isMobileSize());
    }

    _this.setFullscreen = function setFullscreen(setOn) {
        console.log('setFullscreen:' + setOn);

        var isOn = _this.FullscreenService.isEnabled();
        if (setOn && !isOn) {
        } else if (!setOn && isOn) {
            _this.FullscreenService.cancel();
        }
    }


    _this.getWindowWidth = function getWindowWidth() {
        return _this.windowWidth;
    }

    _this.setWindowWidth = function setWindowWidth(w) {
        //console.log('setWindowWidth');
        _this.windowWidth = w;
        _this.noSidebarFilters = _this._noSidebarFilters();
        _this.noSidebarGray = _this._noSidebarGray();

        LayoutEventsService.emitSettingChanged('windowWidth', w);

        var isMobileSize = _this._isMobileSize();
        if(_this.isMobileSize !== isMobileSize) {
            _this.isMobileSize = isMobileSize;
            LayoutEventsService.emitSettingChanged('isMobileSize', _this.isMobileSize);
        }
    }
    _this.getWindowHeight = function getWindowHeight() {
        return _this.windowHeight;
    }

    _this.setWindowHeight = function setWindowHeight(h) {
        _this.windowHeight = h;
        LayoutEventsService.emitSettingChanged('windowHeight', h);
    }

    _this.updateBody = function (SBStateService, data) {
        //console.log('updateBody: ' + data.isAuthenticated);
        if(!data){data={};}
        var isCollab = data.isCollaborator,
            remove = (data.fromClass || '') + ' collaborator-auth authenticated non-authenticated ',
            add = (data.toClass || '') + (isCollab ? ' no-sidebar ' : '') +
                (data.isAuthenticated ? ' authenticated ' : ' non-authenticated ') +
                (isCollab ? (' collaborator-auth '
                   //+ (SBStateService.isFromWWW() ? 'sb-collab-page' : '')
                ) : '');

        set(getBodyElement());

        function set(body) {
            if (body) {
                _this.replaceClass(body, remove, add);
               // body.removeAttribute('with-collab-banner');
            }
        }
    }

    _this.getCollabNavBanner = function(){
        if(!_this.collabNavBanner){
            _this.collabNavBanner = document.querySelector('.collab-alert-nav');
        }
        return _this.collabNavBanner;
    }

    function getBodyElement(){
       if(!_this.bodyElement){
           _this.bodyElement = document.querySelector('body');
       }
       return _this.bodyElement;
    }

    _this.addClass = function addClass(el, cls, isRemove) {
        if (!el || !cls || typeof(cls.trim) === 'function' && !cls.trim()) {
            return;
        }
        if (el.length === 0) {
            return;
        }
        if (el.length > 0) {
            _.each(el, process);
        } else {
            process(el);
        }

        function process(el) {
            var str = typeof (cls) === 'string' ? cls.trim().split(' ') : cls;
            for (var i = 0, n = str.length; i < n; i++) {
                var name = str[i];
                if (name) {
                    var contains = el.classList && el.classList.contains(name);
                    if (isRemove && contains) {
                        el.classList.remove(name);
                    } else if (!isRemove && !contains) {
                        el.classList.add(name);
                    }
                }
            }
        }
    }
    _this.getHideCompanySettings = function getHideCompanySettings(companyId) {
        return _this.getSetting(companyId + 'hideCompanySettings');
    }
    _this.setHideCompanySettings = function setHideCompanySettings(companyId, val) {
        _this.setSetting(companyId + 'hideCompanySettings', val);
    }
    _this.getShowOnboarding = function getShowOnboarding() {
        return _this.getSetting(  'showOnboarding');
    }
    _this.setShowOnboarding = function setShowOnboarding(val) {
        _this.setSetting('showOnboarding', val);
    }
    _this.getShowScriptBanner = function getShowScriptBanner() {
        return _this.getSetting('showScriptBanner1');
    }
    _this.setShowScriptBanner = function setShowScriptBanner(val) {
        _this.setSetting('showScriptBanner1', val);
    }
    _this.getProductOverviewBanner = function getProductOverviewBanner() {
        return _this.getSetting('showProductBanner7');
    }
    _this.setProductOverviewBanner = function setProductOverviewBanner(val) {
        _this.setSetting('showProductBanner7', val);
    }
    _this.getDocumentAutosavings = function getDocumentAutosavings() {
        return _this.getSetting('autosaveSec');
    }
    _this.setDocumentAutosavings = function setDocumentAutosavings(val) {
        _this.setSetting('autosaveSec', val);
    }
    _this.hasClass = function hasClass(el, cls) {
        return (cls && el && el.classList && el.classList.contains(cls)) ? true : false;
    }

    _this.removeClass = function removeClass(el, cls) {
        if (!el) {
            return;
        }
        if (el.length === 0) {
            return;
        }
        if (el.length > 0) {
            _.each(el, process);
        } else {
            process(el);
        }

        function process(el) {
            _this.addClass(el, cls, true);
        }
    }

    _this.replaceClass = function replace(el, removed, added) {
        if (!el) {
            return;
        }
        if (el.length === 0) {
            return;
        }
        if (el.length > 0) {
            _.each(el, process);
        } else {
            process(el);
        }

        function process(el) {
            _this.removeClass(el, removed);
            if(added) {
                _this.addClass(el, added);
            }
        }
    }

    _this.removeElement = function removeElement(el) {
        if (el && el.parentNode) {
            el.parentNode.removeChild(el);
        }
    }
    _this.removeElementChild = function removeElementChild(parent, childClass) {
        if(!parent){return false;}
        var el = parent.querySelector(childClass);
        if (el && el.parentNode) {
            el.parentNode.removeChild(el);
            return true;
        }
        return false;
    }
    _this.removeAllElementChildren = function removeAllElementChildren(parent) {
        while (parent.hasChildNodes()) {
            parent.removeChild(parent.firstChild);
        }
    }
    _this.removeElementChildren = function removeElementChildren(parent, childClass) {
        if(!parent){return false;}
        var els = parent.querySelectorAll(childClass), removed = false;
        _.each(els, function (el) {
            if (el && el.parentNode) {
                el.parentNode.removeChild(el);
                removed = true;
            }
        });
        return removed;
    }

    //find closest ancestor that matches the query
    _this.findClosestParent = function findClosestParent(el, sel, notCurrent) {
        if (!el || !sel) {
            return null;
        }
        if (typeof (el.closest) === 'function' && !notCurrent) {
            return el.closest(sel);
        } else {
            while ((el = el.parentElement) && !((el.matches || el.matchesSelector).call(el, sel))) ;
            return el;
        }
    }

    _this.removeChildrenByClass =  function(node, cls){
        const elements = node.getElementsByClassName(cls);
        while(elements.length > 0){
            elements[0].parentNode.removeChild(elements[0]);
        }
    }
    _this.createFragment = function createFragment(htmlStr) {
        var frag = document.createDocumentFragment(),
            temp = document.createElement('div');
        temp.innerHTML = htmlStr;
        while (temp.firstChild) {
            frag.appendChild(temp.firstChild);
        }
        return frag;
    }
    _this.emptyElement = function emptyElement(el) {
        if(!el){return;}
        while (el.firstChild) {
            el.removeChild(el.firstChild);
        }
    }

    _this.prependElement = function (parent, el) {
        var fc = parent.childNodes && parent.childNodes.length > 0 ? parent.childNodes[0] : null;
        if(fc) {
            parent.insertBefore(el, fc);
        }else{
            parent.appendChild(el);
        }
    }

    _this.prependElementFragment = function (parent, html) {
        return _this.prependElement(parent, _this.createFragment(html));
    }

    _this.insertFragmentBeforeChild = function (parent, html, child) {
        if(!parent || !html){return ;}
        return parent.insertBefore(_this.createFragment(html), child ? child : parent.firstChild);
    }

    _this.appendChildFragment = function (parent, html, emptyFirst) {
        if(!parent){
            console.log('LCS.appendChildFragment: parent is not defined');return;
        }
        if(emptyFirst){
            _this.emptyElement(parent);
        }
        return parent.appendChild(_this.createFragment(html));
    }

    _this.setCSSStyle = function (el, name, val, isRemove) {
        if (!el) {
            return;
        }
        if(isRemove) {
            return _this.removeCSSStyle(el, name);
        }
        if (el.length && el.length > 0) {
            _.each(el, process);
        } else {
            process(el);
        }

        function process(el) {
            if (!el.style) {
                el.style = {};
            }
            if(val && typeof(val) !== 'string'){val = val.toString();}
            var str = val ? val.split('!') : val;
            if(str) {
                if (typeof (el.style.setProperty) === 'function') {
                    el.style.setProperty(name, str[0], str.length > 1 ? str[1] : undefined);
                } else {
                    el.style[name] = val;
                }
            }
        }
    }

    _this.removeChild = function (parent, childClass){
        var el = parent.querySelector(childClass);
        if(el && el.parentNode) {
            el.parentNode.removeChild(el);
            return true;
        }
        return false;
    }

    _this.removeCSSStyle = function (el, name) {
        if (!el) {
            return;
        }
        if (el.length === 0) {
            return;
        }
        if (el.length > 0) {
            _.each(el, process);
        } else {
            process(el);
        }

        function process(el) {
            if (el.style && el.style[name]) {
                delete el.style[name];
            }
        }
    }

    _this.hasChild = function (node, child) {
        while (child && (child.nodeType !== Node.ELEMENT_NODE)) {
            child = child.parentNode;
        }
        return (node.contains(child));
    }

    _this.pasteIntoInputElement = function (el, text) {
        el.focus();
        if (typeof el.selectionStart == "number"
            && typeof el.selectionEnd == "number") {
            var val = el.value;
            var selStart = el.selectionStart;
            el.value = val.slice(0, selStart) + text + val.slice(el.selectionEnd);
            el.selectionEnd = el.selectionStart = selStart + text.length;
        } else if (typeof document.selection != "undefined") {
            var textRange = document.selection.createRange();
            textRange.text = text;
            textRange.collapse(false);
            textRange.select();
        }
    }

    _this.addStyleBlock =  function addStyleBlock(id, wrapper, css, prepend, type) {
        var style = wrapper.querySelector('#' + id), tag = 'style';
        if (!style) {
            if (type) {
                style = wrapper.querySelector(tag + '[data-type="' + type + '"]');
            }
            if (!style) {
                style = document.createElement(tag);
                style.type = 'text/css';
                style.id = id;
                style.setAttribute('data-type', type);
                prepend ? wrapper.insertBefore(style, wrapper.firstChild) : wrapper.appendChild(style);
            }
        }
        style.innerHTML = css;
    }

    _this.insertElementAfter = function (node, newNode) {
        if(node && node.parentNode){
            if(node.nextSibling){
                node.parentNode.insertBefore(newNode, node.nextSibling);
            }else{
                node.parentNode.appendChild(newNode);
            }
        }
    }
    _this.insertElementBefore = function (node, newNode) {
        if(node && node.parentNode){
            node.parentNode.insertBefore(newNode, node);
        }
    }

    _this.getErrorBlock = function (cls) {
        return '<div class="error-block form-group alert alert-danger position-relative '+(cls?cls:'')+'" ng-if="$ctrl.error">'+
                _this.getISBDiv('exclamation-circle', 3) +
                '<span class="txt" ng-bind-html="$ctrl.error|unsafe"></span>' +
            '</div>';
    }

    _this.getISBDiv = function (i, m, cls, other) {
        return '<div class="'+(cls?(cls + ' '):'')+'sbf '+(i?i:'')+'" '+(other? other :'')+'>'+ _this.getISBPath(m ? m : 2) +'</div>';
    }

    _this.getMoreBtn = function (icon, iconLevel, cls) {
return '<button type="button" class="btn btn-default dropdown-toggle dots" dropdown-toggle aria-haspopup="true" aria-expanded="true">' +
             _this.getISBDiv(icon ? icon : 'vertical-dots-bold', iconLevel ? iconLevel : 2, cls) +
            '<span class="sr-only">Toggle Dropdown</span>' +
       '</button>';
    }

    _this.getISBStripboard = function (cls, other) {
        return _this.getISBDiv ('stripboard', 5, cls, other);
    }

    _this.getISBPath = function (max) {
        return (new Array(max ? max : 2)).fill(null).map(function (el, i){return ' <span class="sbp p'+(i+1)+'"></span>';}).join('');
    }

    function getMax(){
        switch(icon){
            //case 'callsheets':
            //    return 8;

            //case 'meeting'://callsheet
            //case 'shots':
            //    return 7;

            // case 'day-of-days': //callsheet
