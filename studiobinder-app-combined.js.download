])
.service('MasonaryService', MasonaryService);
MasonaryService.$inject = ['$window'];
function MasonaryService($window) {
    if (!$window.Packery) {
        console.warn('packery var missing. Did you forget to include the script js packery.js?');
    }
    return $window.Packery;

}

angular.module('sceneNumber.service', [
])
    .service('SceneNumberService', SceneNumberService);
SceneNumberService.$inject = [];
function SceneNumberService() {

    var _this = {
        getSceneNumber: getSceneNumber,
        compareBasedOnScene: compareBasedOnScene,
        getNewSceneNumber: getNewSceneNumber
    }
    return _this;

    function getNewSceneNumber(list, afterId) {
        if (!list || list.length === 0) {
            return 1;
        }
        var scenes = [], index = -1;
        _.each(list, function (item, i) {
            var isobj = typeof(item) === 'object';
            if ((isobj ? item._id : item) === afterId) {
                index = i;
            }
            scenes.push(getSceneNumber(isobj ? item.scene : item));
        }); //get the scene for all items
        scenes = sortScenes(scenes);//sort in case they're not in order
        var after = (index > -1 && index < (list.length - 1)) ? scenes[index] : null,
            maxScene = _.max(scenes, 'n').n,
            comp = after ? after.n : maxScene,
            sel = sortScenes(_.filter(scenes, function (s) {
                return s && s.n === comp; //GET SCENES WITH AFTER
            })), //get SELECTED scenes sorted by scene letters
            selEl = sel.length > 0 ? sel[sel.length - 1] : null;//has max letter

        return after ? getSceneWithChar(selEl.n, selEl.a ? (getCharFromScene(selEl.a) + 1) : 0) : (maxScene + 1);

        function getCharFromScene(scene) {
            return scene ? (scene.toString().toUpperCase().charCodeAt(0) - 'A'.charCodeAt(0)) : 0;
        }

        function getSceneWithChar(scene, letter) {
            return (scene ? scene.toString() : '1') + String.fromCharCode('A'.charCodeAt(0) + letter);
        }

        function sortScenes(l) {
            return l && l.length > 0 ? l.sort(function (a1, b1) {
                if (!a1 && !b1) {
                    return 0;
                } else if (!a1) {
                    return -1;
                } //a1<b1
                else if (!b1) {
                    return 1;
                } //a1>b1
                return _this.compareBasedOnScene(_this.getSceneNumber(a1.scene), _this.getSceneNumber(b1.scene), false);
            }) : l;
        }
    }

    function getSceneNumber(s) {
        if (!s) {
            return -1;
        }
        var m = s.toUpperCase().match(/\d+/);
        if (m) {
            var ns = m[0], index = m.index, n, a, b;
            if (index > 0) {
                b = s.substring(0, index - 1);
            }
            if (index + 1 < s.length) {
                a = s.substring(index + ns.length);
            }
            n = parseInt(ns, 10);
            if (n !== null || n !== undefined) {
                var res = {n: n};
                if (a) {
                    res.a = a;
                }
                if (b) {
                    res.b = b;
                }
                return res;
            }
        }

        return null;
    }

    function compareBasedOnScene(a, b, isDesc) {
        var multiply = isDesc ? -1 : 1;
        return comp(a && a.n ? a.n : 0, b && b.n ? b.n : '0', multiply, function () {
            return comp(a && a.a ? a.a : '0', b && b.a ? b.a : '0', multiply);
        });
    }

    function comp(a, b, multiply, next) {
        if (multiply === undefined) {
            multiply = 1;
        }
        if (a > b) {
            return 1 * multiply;
        } else if (a < b) {
            return -1 * multiply;
        } else {
            return next ? next() : 0;
        }
    }
}

angular.module('service.scriptConvert', [
])
.service('ScriptConvertService', ScriptConvertService);
function ScriptConvertService(   ) {
    var service = {
        SBScriptEditorClass: 'divtype',
        SBScriptEditorBlockType: 'div',
        ParTypes:  {
            scene: {v: 0, t: 'scene', k: 'S', d: 'Scene'},
            action: {v: 2, t: 'action', k: 'A', d: 'Action'},
            character: {v: 3, t: 'character', k: 'C', d: 'Character'},
            parenthetical: {v: 4, t: 'parenthetical', k: 'P', d: 'Parenthetical'},
            dialogue: {v: 5, t: 'dialogue', k: 'D', d: 'Dialogue'},
            transition: {v: 6, t: 'transition', k: 'T', d: 'Transition'},
            general: {v: 1, t: 'general', k: 'G', d: 'General'},
            // dualDialogue: {v: 10, t: 'dualDialogue', k: 'x', d:'Dual Dialogue'},
            //shot: {v: 7, t: 'dualDialogue', k: 'h'},
            page: {v: 11, t: 'page', k: 'B', d: 'Page Break'},
        },
        DataProps: ['data-scene', 'data-strip', 'data-omitted', 'data-page'],
        getHtmlContent : getHtmlContent,
        parseContent : parseContent,
        getElementPosition: getElementPosition,
        getHtmlFromPar: getHtmlFromPar,
        getSimpleHtmlPar: getSimpleHtmlPar,
        getScriptTitlePageInit: getScriptTitlePageInit
     };

    return service;

    function getScriptTitlePageInit(item, CPS){
        var name = item.name ? item.name.toUpperCase() : 'SCRIPT TITLE',
            createdBy = item.createdBy,
            writer = createdBy && createdBy.name ? createdBy.name : 'Name of First Writer',
            phone = createdBy && createdBy.phone ? CPS.displayPhone(createdBy.phone) : 'Phone Number';

        var i = 0, el = '';

        addEmpty(true, 15);

        add(true, '<u>' + name + '</u>');
        addEmpty(true, 3);

        add(true, 'Written by');
        addEmpty(true, 2);

        add(true, writer);
        addEmpty(true, 4);

        if(CPS.hasQuotaType('scriptTitlePage')){
            add(true, 'Based on, If Any');
            addEmpty(true, 22);

            add(false, 'Address');
            add(false, phone);
        }

        return el;

        //add c empty lines
        function addEmpty(center, c) {
            for (var j = 0; j < c; j++) {
                add(center);
            }
        }

        //add content
        function add(center, content) {
            el += getSimpleHtmlPar(content, center ? 'ql-align-center' : '', 'par3292c' + (i < 9 ? ('00' + i) : (i < 99 ? ('0' + i) : '')) + i);
            i++;
        }
    }

    function getHtmlContent(con, scene, isOmitted) {
        if (!con || con.length === 0) {
            return null;
        }
        var nc = '';
        var isDualDialog = false, dualEl = null;
        for (var i = 0; i < con.length; i++) {
            var el = con[i];
            if (el) {
                if (el.isDualDialog) {
                    if (!isDualDialog) {
                        isDualDialog = true;
                        dualEl = {left: [], right: [], isDualDialog: true};
                    }
                    if (el.isLeft) {
                        dualEl.left.push(el);
                    } else {
                        dualEl.right.push(el);
                    }
                } else if (isDualDialog) {
                    isDualDialog = false;
                    nc += processDual(dualEl);
                } else {
                    nc += getHtmlFromPar(el, scene, isOmitted);
                }
            }
        }

        return nc;

        function processDual(c) {
            return '<div class="dual">' +
                '<div class="left">' +
                processSide(c.left) +
                '</div><div class="right">' +
                processSide(c.right) +
                '</div>' +
                '</div>';
        }

        function processSide(side) {
            var nc = '';
            for (var i = 0; i < side.length; i++) {
                var c1 = side[i];
                nc += getHtmlFromPar(c1);
            }
            return nc;
        }
    }

    function getHtmlFromPar(c, scene, isOmitted) {
        //is page break
        var isPageBreak = c.type === service.ParTypes.page.v;
        if (!c.text && !isPageBreak) {
            return '';
        }
        var o = c.type === service.ParTypes.scene.v && isOmitted,
            blockType = service.SBScriptEditorBlockType;
        return '<' + blockType + ' class="' + service.SBScriptEditorClass + c.type +
            (c.otherClass ? (' '+ c.otherClass) : '') + '" '+
            (c.parId ? (' id="par' + c.parId + '" ') : '') +
            (c.type === 0 ? (
                        scene ? (' data-scene="' + scene + '"') : '') +
                    (o ? ' data-omitted="true"' : '') : ''
            ) +
            (isPageBreak && c.page ? ' data-page="' + c.page + '"' : '') +
            '>' +
            c.text +
            //(c.withoutReplacement ? c.text : c.text.replace(/</g, '&lt;').replace(/>/g, '&gt;')) +
            (o ? ('<div class="omitted">OMITTED</div>') : '') +
            '</' + blockType+  '>';
    }

    function getSimpleHtmlPar(content, cls, parId){
        return  getHtmlFromPar(_.extend({
            type:2,
            otherClass: cls,
            text: content || '&nbsp;',
            withoutReplacement: true
        }, parId ? {parId: parId} : null));
    }

    function parseContent(html) {
        if (!html) {
            return {};
        }
        var pars = $(html),
            l = pars && pars.length > 0 ? pars.length : 0;
        //if(!l){ pars = pars.prevObject; l = pars && pars.length > 0 ? pars.length : 0;}
        if (!l) {
            return {};
        }

        var content = [],
            allText = '',
            desc = [],
            scene, page, stripId;
        for (var i = 0; i < l; i++) {
            var par = pars[i],
                c = par.getAttribute('class').split(' ');
            if (c.indexOf('dual') !== -1) {
                //todo support dual
                var children = $(c).find('div'),
                    cl = children.length;
                if (cl > 1) {
                    content.push({
                        left: processPar(children[0]),
                        right: processPar(children[1]),
                        isDualDialog: true
                    });
                } else if (cl > 0) {
                    content.push(processPar(children[0]));
                }
            } else {
                content.push(processPar(par));
            }
        }

        function processPar(par) {
            var id = par.id && par.id.indexOf('par') === 0 ? par.id.replace(/^par/, '') : null,
                textContent = par.textContent ? par.textContent.trim() : '',
                con = {
                    parId: id ? id : shortGuidGenerator(),
                    text: textContent
                };

            if (getAttribute(par, 'omitted') === 'true') {
                con.isOmitted = true;
            }

            for (var j = 0, n = c.length; j < n; j++) {
                var el = c[j],
                    index = el.indexOf(service.SBScriptEditorClass);

                if (index !== -1) {
                    con.type = parseInt(el.substring(index + 7, el.length), 10);
                    if (con.type === 0) {
                        scene = getAttribute(par, 'scene');
                        stripId = getAttribute(par, 'strip');
                    } else {
                        desc.push(con.text);
                    }

                    if (con.type === service.ParTypes.page.v) {
                        try {
                            page = getAttribute(par, 'page');
                        } catch (e) {
                        }
                    }
                    break;
                }
            }

            if (con.text && (con.type === service.ParTypes.action.v || con.type === service.ParTypes.dialogue.v || con.type === service.ParTypes.parenthetical.v)) {
                var text = '';
                con.text = getText(text, par);
            }

            if (textContent && textContent !== '') {
                allText += textContent + ' ';
            }

            return con;


            function getText(text, node) {
                var ch = node.childNodes;
                if (!ch || !ch.length) {
                    return node.textContent;
                }
                _.each(ch, function (c) {
                    var tag = c.tagName,
                        isTag = tag === 'STRONG' || tag === 'U' || tag === 'I' || tag === 'B' || tag === 'EM';
                    text += isTag ? ('<' + tag.toLowerCase() + '>' + getText('', c) + '</' + tag.toLowerCase() + '>') : c.textContent;
                });
                return text;
            }
        }

        function getAttribute(par, attr){
            var v = par.getAttribute('data-' + attr);
            if(v && attr === 'page'){
                try {
                    v = parseInt(v, 10);
                }catch (e){}
            }
            return v;
        }

        function getSub(desc){
            return desc ? (desc.length > 65 ? desc.substring(0, 65) + '…' : desc) : null;
        }

        return {
            stripId: stripId,
            scene: scene ? scene.toString().toUpperCase() : null,
            page: page ? page : null,
            content : content.length > 0 ? content : null,
            allText : allText.trim() !== '' ? allText : null,
            description: getSub(desc.join(' '))
        };
    }

    //not used
    function getElementPosition(pars, variant, isChar) {
        if (!variant) {
            return null;
        }
        var pl = pars && pars.length > 0 ? pars.length : 0;
        if (pl > 0) {
            if (isChar) {// keep the char paragraphs at the beginning
                pars = _.sortBy(pars, function (par) {
                    return ScriptUtils.isParType(par, 'Character') ? 0 : 1;
                });
            }
            var i = 0;
            while (i < pl) {
                var par = pars[i];
                if (par.type !== 0) {
                    var text = par.text;
                    if (text) {
                        var match = utils.getWordMatch(text, variant);
                        if (match) {
                            return {
                                parId: par.parId,
                                offset: match.index,
                                length: variant.length,
                                variant: variant
                            };
                        }
                    }
                }
                i++;
            }
        }
        return null;
    }
}

angular.module('services.ScriptLoader', [])
.service('ScriptLoaderService', ScriptLoaderService);
ScriptLoaderService.$inject = ['LCS'];
function ScriptLoaderService(LCS) {
    var configs = LCS.API_CONFIGS,
        staticUrl = LCS.staticUrl,
        Types = {Script: 1, Style: 2};
    return {
        Types :Types,
        configs: configs,
        loadScript: loadScript,
        loadScripts: loadScripts,
        loadAll: loadAll,
        loadFile: loadFile
    };

    function loadScript(name, params, next) {
        addScript(_.extend({name: name}, params), next);
    }

    function addScript(f, c) {
        loadFile(Types.Script, f, c);
    } 

    function addStyle(f, c) {
        loadFile(Types.Style, f, c);
    }

    function loadAll(scripts, css, next, isSync) {
        var tasks = [];

        if (css && css.length > 0) {
            _.each(css, function (f) {
                tasks.push(function (c) {
                    addStyle(f, c);
                })
            });
        }
        if (scripts && scripts.length > 0) {
            _.each(scripts, function (f) {
                tasks.push(function (c) {
                    addScript(f, c);
                })
            });
        }

        if (!tasks.length) {
            return next();
        }

        async[isSync?'series':'parallel'](tasks, function (err, result) {
            if (typeof (next) === 'function') {
                next();
            }
        });
    }

    function loadScripts(files, next) {
        var tasks = [];
        if (files && files.length > 0) {
            _.each(files, function (f) {
                tasks.push(function (c) {
                    addScript(f, c);
                })
            });

            if (tasks.length === 1) {
                add(files[0], process);
            } else {
                async.parallel(tasks, function (err, result) {
                    process();
                });
            }
        } else {
            process();
        }

        function process() {
            console.log('all files downloaded');
            if (typeof (next) === 'function') {
                next();
            }
        }
    }


    function loadFile(type, params, next) {
        if(!params.type){
            params.type = type === Types.Style ? 'text/css' : 'text/javascript';
        }
        if(!params.id){
            params.id = params.name + '-' + (type === Types.Style ? 'style' : 'script');
        }
        var id = params.id;
        if (!id) {
            console.warn('ScriptLoaderService.loadScript method must define params.id');
        }

        var head = type === Types.Style ? document.head : document.body;
        head.querySelector('#' + id);
        if (head.querySelector('#' + id)) {
            return onsuccess();
        }
        var f = document.createElement(type === Types.Style ?(params.content ? 'style':'link'):'script' );
        f.setAttribute('type', params.type );
        f.setAttribute('id', params.id);

        if(params.content){
            f.innerHTML= params.content;
            onsuccess();
        }else {
            var attr  = 'src'
            if(type === Types.Style){
                f.setAttribute('rel', 'stylesheet');
                attr = 'href';
            }
            f.setAttribute(attr, getSrc());

            if (params.charset) {
                f.setAttribute('charset', params.charset);
            }
            LCS.bindElementListeners(true, f, onsuccess, 'load');
        }

        if (type === Types.Style) {
            head.appendChild(f);
        } else {
            var el = head.querySelector('#vendor-script');
            if (el) {
                el.parentNode.insertBefore(f, el.nextSibling);
            }
        }

        function getSrc() {
            var ext = type === Types.Style ? 'css' : 'js',
                src = params.url || (params.name + '.' + ext),
                key = params.key;
            if (!src) {
                console.warn('ScriptLoaderService.loadScript method must define params.url');
                return '';
            }
            if (src.indexOf('http') !== 0) {
                src = staticUrl + ext + '/' + src + LCS.timestamp;
            }

            if (key) {
                if (!configs) {
                    configs = API_CONFIGS();
                }
                var str = key.split('.'), res;
                for (var i = 0; i < str.length; i++) {
                    res = (i === 0 ? configs : res)[str[i]];
                }
                src = src.replace('{{key}}', res);
            }

            return src;
        }

        function onsuccess(content) {
            console.log('onload file');
            if (typeof (next) === 'function') {
                next();
            }
        }
    }
}

angular.module('services.sessionStorage', [
])
.factory('SessionStorageService', SessionStorageService);

SessionStorageService.$inject = ['$window'];
function SessionStorageService($window) {
    var _this = this,

        session = $window.session;

    _this.setSession = function setSession(key,val){
        try{
            session.setItem(key, val ? JSON.stringify(val) : null);
        }catch (e){
            console.error('Error saving to localStorage', e);
        }
    }

    _this.getSession = function getSession(key) {
        var el =session.getItem(key);
        if(!el){return null;}
        return JSON.parse(el);
    }

    return _this;
}

angular.module('services.socketIO', [
    'service.currentPageSettings.service'
])
.factory('SocketIO', SocketIOService);

SocketIOService.$inject = ['CPS'];
function SocketIOService(CPS) {
    return function (namespace, headers, onSuccess, onError) {
        var configs = CPS.API_CONFIGS,
            transports = ['websocket'],
            _this = this;

        //_this.socket =  io.connect(configs.address+':'+configs.port+'/sockets/'+namespace);// 'http://localhost:9000');
        _this.auth = false;
        _this.socket = {};

        if (configs.sockets.enabled) {
            init(headers, onError);
        }

        function init(headers, onSuccess, onError) {
            _this.socket = io(CPS.websiteUrl,
                {
                    path: '/sockets',
                    forceNew: true,
                    transports: transports
                }
            );
            _this.room = headers['x-product-id'];
            _this.teamId = headers['x-team-id'];
            _this.socket.on('connect', onConnect);
            _this.forceDisconnect = forceDisconnect;
            //console.log(_this.room);
        }

        function forceDisconnect(room) {
            if (_this.socket) {
                _this.socket.emit('forceDisconnect', room);
            }
        }

        function onConnect() {
            _this.socket.emit('authentication', headers)   //send the jwt
                .on('authenticated', function () {
                    onSuccess();
                })
                .on('unauthorized', onError)
                .on(_this.room, function (res) {
                    console.log(res.collection);
                    console.log(res.message);
                    console.log(res.type);
                })
                // on reconnection, reset the transports option, as the Websocket
                // connection may have failed (caused by proxy, firewall, browser, ...)
                .on('reconnect_attempt', function () {
                    if (!_this.socket.opts) {
                        _this.socket.opts = {};
                        _this.socket.opts.transports = transports;
                    }
                });
        }
    };
}
//var clients = io.sockets.clients('room'); // all users from room `room`

angular.module('services.sortedArray', [])
.factory('CustomSortedArray', CustomSortedArrayFactory);

function CustomSortedArrayFactory() {

    var sortedArray = function(array, sortField, orderType, keyProperty){
        var index = 0;
        this.array = [];
        this.sortField = sortField;
        this.orderType = orderType;
        this.keyProperty = keyProperty;
        var length = array.length;
        while (index < length) {
            this.insert(array[index++]);
        }
    };

    sortedArray.orderType = {ASC:'asc', DESC:'desc'};

    sortedArray.prototype.compare = function (element1, element2) {
        if(element1[this.sortField] < element2[this.sortField]){
            return this.orderType === sortedArray.orderType.ASC ? -1 : 1;
        }
        else if (element1[this.sortField] > element2[this.sortField])  {
            return this.orderType === sortedArray.orderType.ASC ? 1 : -1;
        }
        else {return 0;}
    };

    sortedArray.prototype.insertArray = function (elements){
        if(!elements || elements.length === 0) {return;}
        for (var i = 0; i < elements.length; i++) {
            this.insert(elements[i]);
        }
    };

    sortedArray.prototype.insert = function (element) {
        var array = this.array;
        var index = array.length;
        array.push(element);

        while (index) {
            var i = index, j = --index;

            if (this.compare(array[i], array[j]) === -1 ) {
                var temp = array[i];
                array[i] = array[j];
                array[j] = temp;
            }
        }

        return this;
    };

    sortedArray.prototype.search = function (element) {
        var index =-1;
        for(var i = 0; i < this.array.length; i++){
            if(this.array[i][this.keyProperty] === element[this.keyProperty]){
                index = i;
                break;
            }
        }
        return index;
    };

    sortedArray.prototype.remove = function (element) {
        var index = this.search(element);
        if (index >= 0){ this.array.splice(index, 1);}
        return this;
    };

    sortedArray.prototype.replaceById = function (newElement) {
        var index = this.search(newElement);
        if (index >= 0){
            var element = this.array[index];
            if(this.compare(newElement, element) === 0 ){ //same order - just replace elem
                this.array[index] = newElement;
            }else{ //different order - do reinsert
                this.remove(element);
                this.insert(newElement);
            }
            return true;
        }
        return false;
    };

    sortedArray.prototype.hasElements = function (element) {
        return this.array && this.array.length > 0;
    };

    sortedArray.prototype.filter = function(fun /*, thisArg */)
    {
        if (this === void 0 || this === null){
            //   throw new TypeError();
