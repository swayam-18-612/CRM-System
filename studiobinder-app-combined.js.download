 angular.module('services.videoService', [])
.service('VideoService', VideoService);
VideoService.$inject = ['LCS'];
function VideoService(LCS) {
    return {
        playVideo: playVideo,
        bindVideo: bindVideo
    };

    function bindVideo($ctrl, isBind) {
        if (!$ctrl.onVideoCanPlay) {
            $ctrl.onVideoCanPlay = onVideoCanPlay;
        }
        if (!$ctrl.onVideoPlays) {
            $ctrl.onVideoPlays = onVideoPlays;
        }
        var els = $ctrl.element ? $ctrl.element.querySelectorAll('.video-anime') : null;
        if (els) {
            _.forEach(els, function (v) {
                LCS.bindElementListeners(isBind, v, $ctrl.onVideoCanPlay, 'canplay');
         //       LCS.bindElementListeners(isBind, v, $ctrl.onVideoPlays, 'play');
            });
        }
    }

    function playVideo(v){
        if (v){
            if(!v.loadedSB) {
                console.log('Video can start, but not sure it will play through.');
                v.muted = true;
                // v.play();

                v.pause();
                v.playsSB = false;
                v.currentTime = 0;
                v.onplay = function(e){
                    console.log('Video playing.');
                    v.loadedSB = true;
                };
                v.load();
            }
            v.play();
        }
        return v;
    }
    function onVideoCanPlay(e) {
        playVideo();
    }
    function onVideoPlays(e) {
        console.log('Video plays.');
        var v = e.currentTarget;
        if (v) {
            v.playsSB = true;
        }
    }
}

