    onGetContactRate: '&'
}, 'ContactGridItemCtrl'))
.controller('ContactGridItemCtrl',ContactGridItemCtrl);
ContactGridItemCtrl.$inject = ['CastGridItemCtrlService', '$element'];
function ContactGridItemCtrl(CastGridItemCtrlService, $element) {
    var $ctrl = this;

    $ctrl.bindingNamesOther = ['addElemToCallsheet','addElemToProjectList', 'addElemToContactsList'];

    $ctrl = new CastGridItemCtrlService($ctrl, $element);
}

angular.module('product.contacts.item.grid.controller.service', [
    'product.contacts.item.grid.init.controller.service'
])
.service('CastGridItemCtrlService',CastGridItemCtrlService);
CastGridItemCtrlService.$inject = ['CastGridItemInitCtrlService', 'GridItemGroupInitCtrlService', 'ContactsService'];
function CastGridItemCtrlService(CastGridItemInitCtrlService, GridItemGroupInitCtrlService, ContactsService) {
    return function ($ctrl, $element) {
        $ctrl.ContactsService = ContactsService;

        $ctrl = new CastGridItemInitCtrlService($ctrl);

        $ctrl.updateEditableItemPropsAll = updateEditableItemPropsAll;

        $ctrl = new GridItemGroupInitCtrlService($ctrl, $element);

        return $ctrl;

        function updateEditableItemPropsAll(changes) {
            //console.log('updateEditableItemPropsAll');
            if ($ctrl.hasPropChanged(changes, 'contactLists')) {
                $ctrl.updatePropContent('roles');
                $ctrl.updatePropContent('rate');
            }
        }
    }
}

angular.module('product.contacts.item.grid.init.controller.service', [])
.service('CastGridItemInitCtrlService',CastGridItemInitCtrlService);
CastGridItemInitCtrlService.$inject = [];
function CastGridItemInitCtrlService() {
    return function ($ctrl) {

        $ctrl.bindingNames = ['removeElemContact', 'sendElemMessage', 'adjustRoles'].concat($ctrl.bindingNamesOther || []);

        $ctrl.adjustRoles = adjustRoles;
        $ctrl.getAdjustRoles = getAdjustRoles;
        $ctrl.getContactRate = getContactRate;
        $ctrl.getSBPropForField = getSBPropForField;

        return $ctrl;

        function adjustRoles() {
            return $ctrl.triggerAction(null, 'adjustItemRoles');
        }

        function getSBPropForField(item, prop) {
            if (prop === 'roles' || prop === 'contactLists') {
                return $ctrl.getAdjustRoles($ctrl.item, $ctrl.canEdit, $ctrl.depId);
            }else if(prop === 'rate'){
                return $ctrl.getContactRate($ctrl.item, $ctrl.canEdit);
            }

            return $ctrl.getSBPropForFieldInit(item, prop);
        }

        function getAdjustRoles(item, canUpdate, depId){
            return $ctrl.onGetAdjustRoles({item: item, canUpdate: canUpdate, depId: depId});
        }

        function getContactRate(item, canUpdate){
            return $ctrl.onGetContactRate({item: item, canUpdate: canUpdate});
        }
    }
}

