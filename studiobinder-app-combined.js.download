        },

        ListParams = {
            includeFields: ['companyId', 'productId', 'callsheetId', 'castId', 'calltime', 'status', 'confirmedAt', 'callsheetInvitationSentId', 'emailViewsCount', 'pageViewsCount', 'roles', 'showDetails', 'orderLists', 'updatedAt', 'personalNote'],
            searchFields: ['name', 'email', 'roles', 'phone'],
            orderFields: ['name', 'email', 'phone', 'status', 'calltime', 'pageViewsCount'], //['castId.name', 'castId.email'],
            populate: 'castId callsheetInvitationSentId'
        },

        KeyboardServiceParams = {
