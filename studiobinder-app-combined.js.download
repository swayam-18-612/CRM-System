angular.module('chat.intercom.service', [
])
.service('IntercomChatService', IntercomChatService);
IntercomChatService.$inject = ['$intercom', 'API_CONFIGS'];
function IntercomChatService($intercom, API_CONFIGS) {

    var configs = API_CONFIGS();
    var service = {
        $intercom: $intercom,
        setData: setData,
        reset: reset
    };
    service.enabled = configs.intercom.enabled && $intercom;
    return service;

    function reset(user) {
        if (service.enabled) {
            service.$intercom.shutdown();
            service.$intercom.boot(_.extend(getInfo(user), {
                app_id: configs.intercom.appId,
                widget: {
                    activator: '#IntercomDefaultWidget'
                }
            }));
        }
    }

    function setData(user, toStateName) {
        if (service.enabled) {
            service.$intercom.update(_.extend(getInfo(user), {
                hitDashboard: toStateName === 'user.dashboard',
                currentPage: toStateName
            }));
        }
    }

    function getInfo(user) {
        return {
            user_id: user ? user._id : null,
            email: user ? user.email : null,
            user_hash: user ? user.intercomHMAC : null//"INSERT_HMAC_VALUE_HERE" // an Identity Verification user hash for your user
        };
    }
}


angular.module('chat.service', [
    'chat.intercom.service'
])
.service('ChatService', ChatService);
ChatService.$inject = ['$window', 'IntercomChatService'];
function ChatService($window, IntercomChatService) {

    var service = {
        intercom: IntercomChatService,

        currentEmail: null,
        currentUserId: null,

        setData: setData,
        load: load,
        reset: reset
    };

    return service;

    function load(crispTokenId, next) {
        next();
    }

    function reset(userId) {
        service.intercom.reset(userId);
    }

    function setData(userId, toStateName) {
        var updateUserId;
        if (service.currentUserId !== userId) {
            service.currentUserId = userId;
            updateUserId = true;
        }
        service.intercom.setData(updateUserId ? userId : null, toStateName);
    }
}

angular.module('services.cheatSheetEvents', [
])
    .service('CheatSheetEventsService',CheatSheetEventsService);
CheatSheetEventsService.$inject = ['RootEventsService'];
function CheatSheetEventsService(RootEventsService) {
    var _this = this;
    _this.RootEventsService = RootEventsService;

    _this.emitUpdateCheatsheet = function emitUpdateCheatsheet(cheatSheetInfo) {
        //console.log('emitUpdateCheatsheet');
        RootEventsService.broadcastRoot('UPDATE_CHEATSHEET', cheatSheetInfo);
    }

    _this.onUpdateCheatsheet = function onUpdateCheatsheet(method) {
        return RootEventsService.onDefaultEmitted('UPDATE_CHEATSHEET', method);
    }

    _this.emitStartIntro = function emitStartIntro(val) {
        RootEventsService.broadcastRoot('START_INTRO', val);
    }

    _this.onStartIntro = function onStartIntro(method) {
        return RootEventsService.onDefaultEmitted('START_INTRO', method);
    }

    return _this;
}


