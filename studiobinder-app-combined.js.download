function MoodboardGroupCtrl(Pagination, ShotGroupOverloadedCtrlService, $element) {
    console.log('MoodboardGroupCtrl');

    var $ctrl = this;
    $ctrl.isNotGrayMore = true;
    $ctrl.withoutFieldInit = true;
    $ctrl.btnUploadText = 'Add Images';
    $ctrl.gridItemClass = 'shotitemcolumn';
    $ctrl.defaultKey = 'M';
    $ctrl.addMultipleItems = true;

    //list updates
    $ctrl.onListChangedProps = ['description'];
    $ctrl.hideItemTitle = true;
    $ctrl.showOnlyRemovebBtn = true;

    $ctrl.getGroupEmptyButtons = getGroupEmptyButtons;
    $ctrl.getDescBlock = getDescBlock;
    $ctrl.canEditFromMore = canEditFromMore;
    $ctrl.canDuplicateFromMore = canDuplicateFromMore;
    $ctrl.getAddItem = getAddItem;
    $ctrl.onUpdatedImage = onUpdatedImage;
    $ctrl.getTopNavBtns = getTopNavBtns;
    $ctrl.addBanner = addBanner;

    $ctrl = new ShotGroupOverloadedCtrlService($ctrl, $element, Pagination);

    function addBanner(){
        console.log('addBanner')
        $ctrl.createItem(null, 2, null,   null);
    }

    function onUpdatedImage(item, result){
        console.log('onUpdatedImage');

        if($ctrl.reloadMasonaryLayout) {
            $ctrl.reloadMasonaryLayout(null, false, 700);
        }
    }

    function getAddItem(){
        return $ctrl.getBtnUpload(true, 'btnBottomUpload small blue', null, true);
    }

    function canEditFromMore(item){ //can edit banner
        return $ctrl.canEdit && item && item.type === 2;
    }

    function canDuplicateFromMore(item){//can duplicate banner
        return $ctrl.canEdit && item && item.type === 2;
    }

    function getGroupEmptyButtons() {
        return $ctrl.getBtnUpload(true, 'min-width-180 btn-primary');
    }

    function getTopNavBtns() {
        var sClass = (showPDF() ? ' with-show-pdf' : '');
        return ($ctrl.canEdit ? $ctrl.getBtnUpload(true, 'btnTopUpload btnNewFromTop btn btn-small primary hide-print' +
            sClass, '$ctrl.keyboardService.SelectedRows.length===0') : '');
    }


    function showPDF() {
        return $ctrl.withCustomReports;
    }

    function getDescBlock() {
        var prop = 'description';
        return !$ctrl.currentList[prop] && !$ctrl.canEdit ? '' : ('<div class="display-block desc sb-prop-list-description">' + ($ctrl.currentList[prop] || '') + '</div>');
    }
}

//<video width="640" height="360" controls preload="none" data-src="video.mp4" poster="thumbnail.jpg"></video>
document.addEventListener("DOMContentLoaded", function () {
    var prop = 'data-sb-src';
    var videos = document.querySelectorAll('.sb-autoplay video');
    videos.forEach(function(video){
        if(!video.SBSrc){
            video.setAttribute(prop, video.getAttribute('src'));
            video.src = null;
            video.SBSrc = 1;
        }
    });

    if ("IntersectionObserver" in window) {
        var observer = new IntersectionObserver(function (entries, observer) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    var video = entry.target;
                    if (video.SBSrc === 1) {
                        video.isSBLoadedSet = true;
                        video.autoplay = true;
                        video.muted = false;
                        video.loop = true;
                        video.src = video.getAttribute(prop); // Move URL from data-src to src
                        video.load(); // Trigger video loading
                        video.SBSrc = 2;
                        observer.unobserve(video); // Stop observing this video as it’s now loaded
                    }
                }
            });
        });
        videos.forEach(function (video) {
            observer.observe(video);
        });
    }
});

