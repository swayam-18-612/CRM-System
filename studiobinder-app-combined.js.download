.component('sbDatesDropdownMenu', {
    bindings: {
        dateFormat: '@',
        header: '@?',
        hasRemove: '@?',
        removeText: '@?',
        enableTime: '@',
        timeFormat: '@',
        quotaType: '@',
        minDate: '<',
        maxDate: '<',
        value: '<',

        initList: '<',
        onSelect: '&'
    },
    controller: 'SbDatesDrpMenuCtrl'
})
.controller('SbDatesDrpMenuCtrl', SbDatesDrpMenuCtrl);
SbDatesDrpMenuCtrl.$inject = ['SbDateDrpMenuCtrlService', 'SbDatesProcessingService', '$element'];
function SbDatesDrpMenuCtrl(SbDateDrpMenuCtrlService, SbDatesProcessingService, $element) {
    console.log('SbDatesDrpMenuCtrl');
    var $ctrl = this;
    $ctrl.SbDatesProcessingService = SbDatesProcessingService;

    $ctrl.invalid = true;
    $ctrl.placeholder ={from: 'Select Date', to: 'Select Date'};
    $ctrl.currentDate = {from: null, to: null}; //date format in moment
    $ctrl.datetype = 'single';


    $ctrl.onChangeOther = onChangeOther;
    $ctrl.onConfirm = onConfirm;
    $ctrl.onDestroyOther = onDestroyOther;
    $ctrl.getHeader = getHeader;
    $ctrl.getBottom = getBottom;
    $ctrl.onLoadedOther = onLoadedOther;
    $ctrl.onDatePickerLoaded = onDatePickerLoaded;

    $ctrl = new SbDateDrpMenuCtrlService($ctrl, $element);

    function setMode(prop) {
        var mode = getChecked('from') && getChecked('to')  ? 'range' : 'single';
        if (mode !== $ctrl.datetype) {
            $ctrl.datepicker.set('mode', mode);
            $ctrl.datetype = mode;
        }
       // setInputFpOmit(prop);
    }

    function onLoadedOther(){
        //on load due date is active
        var prop = 'to';
        setActiveDateIndex(prop);

        if($ctrl.value){
            setCurrentDate('from');
            setCurrentDate('to');
        }

        if(!$ctrl.value || !$ctrl.value[prop] || !$ctrl.value[prop].value){
            setMoment(getNextDayMoment(), prop);
        }

        setChecked(prop, true);
        setMode(prop);

        bindInit(true);
    }

    function onDatePickerLoaded() {
        //console.log('onDatePickerLoaded');
        var els = $ctrl.element.querySelectorAll('.numInput');
        if (els && els.length > 0) {
            _.each(els, function (el) {
                $ctrl.LCS.addClass(el, 'form-control without-underline');
            });
        }

        //display date and time if exists
        showTime($ctrl.value && (hasTime('from') || hasTime('to')));
        updateDatePickerDate($ctrl.activeProp);

        function hasTime(prop) {
            return $ctrl.value[prop] && $ctrl.value[prop].hasTime;
        }
    }

    function bind(isBind){
        $ctrl.bindElementsClickBySelector(isBind, '.flatpickr-confirm', $ctrl.onConfirm);
        $ctrl.bindElementsClickBySelector(isBind, '.flatpickr-calendar.hasTime', checkTime);
    }

    function bindInit(isBind){
        $ctrl.bindElementClickBySelector(isBind, '.btnClear', onClear);
        $ctrl.bindElementClickBySelector(isBind, '.btnAdd', onAddTime);
        $ctrl.bindElementsClickBySelector(isBind, '.elinput', onSelectInput);
        $ctrl.bindElementsClickBySelector(isBind, '.custom-checkbox', checkDate);

    }

    function showTime(show) {
        if (!$ctrl.enableTime || show === $ctrl.hasTime) {
            return;
        }
        $ctrl.hasTime = show;
        $ctrl.LCS[show ? 'removeClass' : 'addClass']($ctrl.element.querySelectorAll('.flatpickrtime'), 'sb-hide');

        if(show){
            loadTime('from');
            loadTime('to');
        }

        if (!$ctrl.btnAdd) {
            $ctrl.btnAdd = $ctrl.element.querySelector('.btnAdd');
        }
        if($ctrl.btnAdd) {
            $ctrl.btnAdd.innerText = show ? 'Remove Time' : 'Add Time';
        }// $ctrl.LCS[show ? 'addClass' : 'removeClass']($ctrl.btnAdd, 'sb-hide');
    }

    function showClear(show) {
        if(!$ctrl.btnClear){
            $ctrl.btnClear = $ctrl.element.querySelector('.btnClear');
        }
        $ctrl.LCS[show ? 'removeClass' : 'addClass']($ctrl.btnClear, 'sb-hide');
    }

    function onClear(e) {
        //console.log('onClear');
        $ctrl.preventDefault(e);

        var dontTriggerUpdate = true;

        //clear both dates and hide time;
        emptyDateAndTime('from', dontTriggerUpdate);
        emptyDateAndTime('to', dontTriggerUpdate);
        $ctrl.datepicker.clear(false, false);

        $ctrl.datepicker.close();
        onSelect(true);

    }

    function processQuota(process, e) {
        if($ctrl.quotaType) {
            $ctrl.CPS.loadQuotaPopup($ctrl.quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});
        } else{
            process();
        }
    }

    function onAddTime(e) {
        //console.log('onAddTime');
        $ctrl.preventDefault(e);
        processQuota(process, e);

        function process() {
            showTime(!$ctrl.hasTime);

            p('from');
            p('to');

            function p(prop) {
                var date = setTime(prop, !$ctrl.hasTime);
                if (date) {
                    var el = $ctrl.element.querySelector('.error');
                    if (el) {
                        el.innerText = 'Set ' + (date === 'from' ? 'start' : 'due') + ' date first';
                    }
                }
            }

            function setTime(prop) {
                if (!prop) {
                    prop = getActiveProp();
                }

                if (hasDate(prop)) {
                    updateValue(prop);
                } else {
                    return prop;
                }
            }
        }
    }

    //set value in datepicker
    function updateDatePickerDate(prop) {
        var v = $ctrl.value[prop];
        var d;
        if($ctrl.datetype === 'range'){
            d = [];
            var val = getV('from');
            if(val){
                d.push(val);
            }
            val = getV('to');
            if(val){
                d.push(val);
            }
        } else{
            d = getV(prop);
        }
        $ctrl.datepicker.setDate(d);
        showClear(v);

        function getV(prop){
            var v = $ctrl.value[prop];
            return v && v.value ? $ctrl.getDateFromMoment(v.value) : null;
        }
    }

    function onSelectInput(e) {
        console.log('onSelectInput');
        $ctrl.preventDefault(e);
        var prop = e.currentTarget.getAttribute('data-prop');
        selectInput(prop);
    }

    function selectInput(prop, isOther){
        if(isOther) {
            prop = getOtherProp(prop);
        }

        setInputCls(prop, true);
        setInputCls(getOtherProp(prop), false);

       // setInputFpOmit(prop);
        updateDatePickerDate(prop);
    }

    function setInputFpOmit(prop){
        if($ctrl.inputField){
            if(prop === 'to' && $ctrl.datetype === 'range'){
                $ctrl.inputField.setAttribute('data-fp-omit', '');
            } else {
                $ctrl.inputField.removeAttribute('data-fp-omit');
            }
        }
    }

    function getOtherProp(prop){
        return prop === 'from' ? 'to' : 'from';
    }

    function setActiveDateIndex(prop){
        $ctrl.activeProp = prop;
        $ctrl.datepicker.activeDateIndex = prop ==='from' ? 0 : 1;
    }

    function setInputCls(prop, isActive) {
        if (isActive) {
            setActiveDateIndex(prop);
        }
        var name = 'wrapper' + prop,
            cls = getActiveClass(isActive, getChecked(prop));
        if (!$ctrl[name]) {
            $ctrl[name] = $ctrl.LCS.findClosestParent($ctrl.element.querySelector('.elinput[data-prop="' + prop + '"]'), '.wrapperinfo').querySelectorAll('.wrapper-outer');

        }
        if ($ctrl[name]) {
            $ctrl.LCS.removeClass($ctrl[name], 'active' + (isActive ? ' inactive' : ''));
            if (cls !== '') {
                $ctrl.LCS.addClass($ctrl[name], cls);
            }
        }
    }

    function getActiveClass(isActive, isChecked){
        return !isChecked ? get(isChecked) :  (isActive ? get(isActive) : '');

        function get(isActive) {
            return isActive ? 'active' : 'inactive';
        }
    }

    function getActiveProp(){
        return $ctrl.activeProp;
        //return $ctrl.element.querySelector('.elinput.active').getAttribute('data-prop');
    }

    //on change date
    function onChangeOther(selectedMoments, timeProp){
        console.log('SbDatesDrpMenuCtrl.onChangeOther');
        if($ctrl.checkingDate){return;}
        //propagate selected date to the drp
        var prop = timeProp ? timeProp : getActiveProp();
        $ctrl.withClose = false;
        //selectedDates contains utc moment objects
        var l = selectedMoments ? selectedMoments.length : 0,
            m0 = l > 0 ? selectedMoments[0] : null;
        if(!timeProp && $ctrl.datetype === 'range' && l > 1){
            setMoment(m0, 'from', false, true);
            setMoment(selectedMoments[1], 'to'); //trigger update here
        } else {
            setMoment(m0 ? m0 : null, prop, timeProp);
        }
        //update the date with string value in input
    }

    function emptyDateAndTime(prop, dontTriggerUpdate){
        var hasTime = false;
        showTime(hasTime);
        setMoment(null, prop, false, dontTriggerUpdate);
    }

    function setMoment(moment, prop, isTime, dontTriggerUpdate){
        if(!prop) {
            prop = getActiveProp();
        }
        //currentdate always has time
        if(isTime){
            if($ctrl.currentDate[prop]) {
                $ctrl.currentDate[prop].hours(moment.hours());
                $ctrl.currentDate[prop].minutes(moment.minutes());
            }
        } else{
            $ctrl.currentDate[prop] = moment;
        }
        updateValue(prop, dontTriggerUpdate);
    }

    function hasDate(prop) {
        return $ctrl.currentDate && $ctrl.currentDate[prop];
    }

    function updateValue(prop, dontTriggerUpdate){
        var m = $ctrl.currentDate[prop],
            hasTime = $ctrl.hasTime;
        if(!$ctrl.value){
            $ctrl.value = {};
            if(!hasTime){hasTime = false;}
        }
        //if time is set now update it in value
        if(hasTime !== undefined){
            $ctrl.value[prop].hasTime = hasTime;
        } else{ //otherwise use time from value
            hasTime = $ctrl.value[prop].hasTime;
        }
        if(m){
            $ctrl.value[prop].value = new moment.utc({
                year: m.year(),
                month: m.month(),
                date: m.date(),
                hours: hasTime ? m.hours() : 0,
                minutes: hasTime ? m.minutes() : 0,
                seconds: 0,
                milliseconds: 0
            });
        } else{
            $ctrl.value[prop].value = null;
            $ctrl.value[prop].hasTime = false;
        }

        setInputText(prop);

        if(!dontTriggerUpdate) {
            onSelect($ctrl.withClose);
        }
    }

    function onConfirm(e){
        //console.log('onConfirm');
        $ctrl.preventDefault(e);
        onSelect(true);
    }

    function onSelect(withClose) {
        if ($ctrl.invalid) {
            return;
        }
        if ($ctrl.withClose !== withClose) {
            $ctrl.withClose = withClose;
        }
        console.log('$ctrl.onSelect');
        $ctrl.onSelect({result: {value: duplicateValue($ctrl.value), withClose: $ctrl.withClose}});
    }

    function duplicateValue(value) {
        //console.log('SbDateCtrlService.duplicateValue ' + $ctrl.prop);

        if (!value) {
            return  value;
        } else if (value.from || value.to) {
            return {
                from: set(value.from),
                to: set(value.to)
            }
        } else {
            return set(value);
        }

        function set(v) {
            return $ctrl.MomentService.getUtcMomentCopyWithTime(v);
        }
    }

    function onDestroyOther(){
        bindInit(false);
        bind(false);

        $ctrl.destroyPicker('timepicker' + 'from');
        $ctrl.destroyPicker('timepicker' + 'to');
    }

    function setChecked(prop, isChecked) {
        $ctrl['ck' + prop] = isChecked;
    }

    function getChecked(prop) {
        return $ctrl['ck' + prop] === true;
    }
    function getHeader() {
    return '<div class="clearfix values table-div full-width" >' +
                getInput('from', 'Start', false, false) +
                '<div class="col24 centered text-center">&nbsp;</div>' +
                getInput('to', 'Due', true, true) +
            '</div>' +
            '<div class="error full-width"></div>';

        function getInput(prop, txt , isActive, isLeft) {
            var props = getInputProps(prop),
                isChecked = (hasValue(prop)||isActive) ? true : false;
            setChecked(prop, isChecked);
            //if is not checked -> outer should be inactive
            //if is  checked:
            //if date is selected -> outer should be active
            //if date is not selected -> outer should be default
            var cls ='wrapper-outer with-transition with-bgcolorgray withborder col130 ' + getActiveClass(isActive, isChecked);
return '<div class="centered col170 ' + (isLeft ? 'text-left' : 'text-right') + '">' +
            '<div class="header-small clearfix">' + txt + '</div>' +
            '<div class="wrapperinfo full-width text-left"> ' +
                '<div class="custom-checkbox aligntop inline-block" data-prop="' + prop + '"><label><input type="checkbox" ' + (isChecked ? ' checked="checked"' : '') + '><span><span></span></span></label></div>' +
                '<div class="inline-block">' +
                    '<div class="' + cls + ' with-arrow">' +
                        '<div data-prop="' + prop + '" class="elinput with-cursor with-sb-view with-sb-view-edit form-control without-underline">' +
                            '<div class="sb-wrapper"><div class="sb-view-content ' + props.cls + '">' + props.txt + '</div></div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="' + cls + ' without-padding margin-top-quarter flatpickrtime ' + ($ctrl.hasTime ? '' : 'sb-hide') + '">' +
                        '<input class="timeinput' + prop + '" data-prop="'+prop+'" type="text" readonly="readonly" style="display: none">' +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</div>';

            function hasValue(prop) {
                return $ctrl.value && $ctrl.value[prop] && ($ctrl.value[prop].value || $ctrl.value[prop].hasTime);
            }
        }
    }

    function getBottom() {
        var cls = ' semibold btn-small transparent',
            el = ($ctrl.enableTime ? '<a class="btnAdd' + cls + ' pull-left" tabindex="1003">' + $ctrl.LCS.getISBDiv('plus', 2, 'pull-left') + ' Add Time</a>' : '') +
            ($ctrl.hasRemove ? '<a class="btnClear' + cls + ' sb-hide pull-right" tabindex="1004">Remove</a>' : '');
        return ($ctrl.enableTime || $ctrl.hasRemove) ? ('<div class="bottom-btns clearfix">' + el + '</div>') : el;
    }

    function getInputProps(prop){
        var val = getStringValue(prop);
        return {
            cls: (val ? '' : 'sb-placeholder'),
            txt: val ? val : $ctrl.placeholder[prop]
        }
    }

    function setInputText(prop){
        var props = getInputProps(prop),
            name = 'inputcontent'+ prop;
        if(!$ctrl[name]){
            $ctrl[name] = $ctrl.element.querySelector('.elinput[data-prop="' + prop + '"] .sb-view-content');
        }
        $ctrl[name].innerText = props.txt;
        $ctrl.LCS[props.cls ? 'addClass' : 'removeClass']($ctrl[name], props.cls);

        setInvalid(prop);
    }

    function setInvalid(prop){
        $ctrl.invalid = ($ctrl.currentDate.from && $ctrl.currentDate.to ) ?
            ($ctrl.currentDate.from > $ctrl.currentDate.to) : false;
        var errorTxt = $ctrl.element.querySelector('.error');
        if(errorTxt) {
            errorTxt.innerText = $ctrl.invalid ?
                (prop === 'from' ? 'Start date must be before due date' : 'Due date must be after start date') : '';
        }
    }

    function getStringValue(prop){
        var hideTime = true;
        return $ctrl.value ? $ctrl.SbDatesProcessingService.getStringForSide($ctrl, $ctrl.value[prop], hideTime) : null;
    }

    function checkTime(e) {
        //console.log('checkTime');
        var el = e.currentTarget,
            prop = el.previousSibling.getAttribute('data-prop'),
            isActive =  prop === getActiveProp(prop);

        if(!isActive){
            selectInput(prop);
        }
    }

    function checkDate(e) {
        //console.log('checkDate');
        if (e) {
            e.preventDefault();
        }
        var el = e.currentTarget,
            prop = el.getAttribute('data-prop');

        if(prop === 'from'){
            processQuota(process);
        } else{
            process();
        }
        function process() {
            selectCheck(el, prop, !getChecked(prop));
        }
    }

    function selectCheck(el, prop, val){
        var checkbox = $ctrl.LCS.findClosestParent(el, '.wrapperinfo').querySelector('.custom-checkbox input'),
            isChecked = getChecked(prop);

        if(val === isChecked){return;}

        $ctrl.checkingDate = true;
        if(isChecked) {
            var m = $ctrl.currentDate[prop];
            $ctrl['prev' + prop] = m ? m.clone() : null;
            setMoment(null, prop);
            if(checkbox) {
                checkbox.removeAttribute('checked');
            }
        } else {
            var m = prop === 'to' ? $ctrl['prev' + prop] : null;
            if(m && $ctrl.currentDate.from && $ctrl.currentDate.from > m) {
                m = null;
            }
            if(!m){
                m = getDefaultMom(prop);
            }
            if(m){
                setMoment(m, prop);
            }
            if(checkbox) {
                checkbox.setAttribute('checked', 'checked');
            }
        }
        setChecked(prop, !isChecked);
        setMode(prop);

        selectInput(prop, isChecked);
        $ctrl.checkingDate = false;
    }

    function loadTime(prop) {
        if ($ctrl['timeloaded' + prop]) {
            return;
        }
        $ctrl['timeloaded' + prop] = true;

        var m = $ctrl.currentDate[prop];
        if(!m){
            m = getDefaultMom(prop);
        }

        $ctrl.createTimePicker('timepicker' + prop, 'timeinput' + prop, {
            defaultHour: m.hour(),//Initial value of the hour element.
            defaultMinute: m.minute(),//Initial value of the minute element.
        });

        bind(false);
        $ctrl.LCS.timeout(function (){
            bind(true);
        }, 100);
    }

    function getDefaultMom(prop){
        return prop === 'to' ? getNextDayMoment() : getPrevDayMoment($ctrl.currentDate.to);
    }

    function getNextDayMoment(){
        var m = $ctrl.MomentService.getUtcMomentFromDateMoment($ctrl.MomentService.getMomentNow().add(1, 'day'));
        return new moment.utc({
            date: m.date(),
            month: m.month(),
            year: m.year(),

            hours: 23,
            minutes: 59,

            seconds: 0,
            milliseconds: 0
        });
    }

    function getPrevDayMoment(m){
        return $ctrl.MomentService.getUtcMomentFromDateMoment(m ? m.clone().add(-1, 'day') : $ctrl.MomentService.getMomentNow(), $ctrl.CPS.startTime);
    }

    function setCurrentDate(prop){
        var v = $ctrl.value[prop];
        if(v) {
            var m = v.value;
            $ctrl.currentDate[prop] = m ? new moment.utc({
                date: m.date(),
                month: m.month(),
                year: m.year(),

                hours: v.hasTime ?  m.hours() : 0,
                minutes: v.hasTime ?  m.minutes() : 0,

                seconds: 0,
                milliseconds: 0
            }) : null;
        }
    }
}

angular.module('sb.fields.dates.component', [
    'sb.fields.dates.controller.service',
    'dropdowns.sbDates.menu.component'
])
.component('sbDates', sbFieldComponentParams('SbDatesCtrl',{
    removeText: '@?',
    hasRemove: '@?',
    dateFormat: '@?',
    emptyIsCircle: '@?',
    header: '@?',
    minDate: '<',
    maxDate: '<',
    //value: //{from: {hasTime(boolean), value(moment)}, to:{hasTime(boolean), value(moment)}}
    defaultDate: '<', //{from: Date , to:Date}
    enableTime: '@',
    propFrom:'@',
    propTo:'@',
}, getSBDropdownTemplate()))
.controller('SbDatesCtrl', SbDatesCtrl);

SbDatesCtrl.$inject = ['SbDatesCtrlService', '$element', '$attrs'];

//value: value
function SbDatesCtrl(SbDatesCtrlService, $element, $attrs) {
    var $ctrl = this;
    $ctrl.dateType = 3;

    $ctrl.setUpdatePropValue = setUpdatePropValue;

    $ctrl = new SbDatesCtrlService($ctrl, $element, $attrs);

    function setUpdatePropValue(item) {
        if ($ctrl.propFrom || $ctrl.propTo) {
            set($ctrl.propFrom, 'from');
            set($ctrl.propTo, 'to');
        } else {
            item[$ctrl.prop] = $ctrl.value ? _.extend({}, $ctrl.value) : null;
        }

        function set(prop, p){
            if (prop) {
                item[prop] = $ctrl.value && $ctrl.value[p] ? angular.copy($ctrl.value[p]) : null;
            }
        }
    }
}

angular.module('sb.fields.date.component.service', [
    'sb.fields.inputfield.service'
])
.service('SbDateCtrlService', SbDateCtrlService);

SbDateCtrlService.$inject = ['SBDrpNonClosedCtrlService', 'SBFieldTypesService'];

function SbDateCtrlService(SBDrpNonClosedCtrlService, SBFieldTypesService) {
    return function($ctrl, $element, $attrs) {
        var withoutTemplateScope = true;

        $ctrl.DateTypes = {Date: 1, Range:2, Dates: 3};
        $ctrl.SBFieldMethods = SBFieldTypesService.SBFieldMethods;
        $ctrl.MomentService = SBFieldMethods.MomentService;

        $ctrl.menuCls = 'datepicker-popup';
        $ctrl.setPreviousValue = setPreviousValue;

        switch ($ctrl.dateType) {
            case $ctrl.DateTypes.Date:
                $ctrl.menuTag = 'sb-date-dropdown-menu';
                $ctrl.propType = SBFieldTypesService.PropTypes.Date;
                break;

            case $ctrl.DateTypes.Dates:
                $ctrl.menuTag = 'sb-dates-dropdown-menu';
                $ctrl.propType = SBFieldTypesService.PropTypes.Dates;
                break;

            case $ctrl.DateTypes.Range:
                $ctrl.menuTag = 'sb-daterange-dropdown-menu';
                $ctrl.propType = SBFieldTypesService.PropTypes.DateRange;
                break;
        }

        $ctrl.setInputField = false;

        $ctrl.preDisplayValue = preDisplayValue;

        $ctrl.generateDrpMenuContent = generateDrpMenuContent;
        $ctrl.initDrp = initDrp;
        $ctrl.getDateFromMoment = getDateFromMoment;
        $ctrl.getStringToMoment = getStringToMoment;
        $ctrl.duplicateValue = duplicateValue;

        $ctrl = new SBDrpNonClosedCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

        return $ctrl;


        function setPreviousValue() {
            //console.log('SbDateCtrlService.setPreviousValue ' + $ctrl.prop);
            $ctrl.previousValue = $ctrl.duplicateValue($ctrl.value);
        }

        function duplicateValue(value) {
            //console.log('SbDateCtrlService.duplicateValue ' + $ctrl.prop);

            if (!value) {
                return  value;
            } else if (value.from || value.to) {
                return {
                    from: set(value.from),
                    to: set(value.to)
                }
            } else {
                return set(value);
            }

            function set(v) {
                return $ctrl.MomentService.getUtcMomentCopyWithTime(v);
            }
        }

        function initDrp() {
            $ctrl.tabIndex = $ctrl.tabIndex ? $ctrl.tabIndex : null;

            if($ctrl.initDrpOther) {
                $ctrl.initDrpOther();
            }
        }

        function generateDrpMenuContent() {
            return {
                $ctrl: {
                    value: $ctrl.getMenuDrpValue(),
                    minDate: $ctrl.minDate,
                    maxDate: $ctrl.maxDate,
                    initList: $ctrl.initList,
                    onSelect: $ctrl.onSelect,
                },
                template: ($ctrl.hasRemove ? ("has-remove='" + $ctrl.hasRemove + "' ") : '') +
                    ($ctrl.removeText ? ("remove-text='" + $ctrl.removeText + "' ") : '') +

                    ($ctrl.enableTime ? ("enable-time='" + $ctrl.enableTime + "' ") : '') +
                    ($ctrl.timeFormat ? ("time-format='" + $ctrl.timeFormat + "' ") : '') +
                    ($ctrl.dateFormat ? ("date-format='" + $ctrl.dateFormat + "' ") : '') +
                    ($ctrl.quotaType ? ("quota-type='" + $ctrl.quotaType + "' ") : '') +

                    "min-date='::$ctrl.minDate' " +
                    "max-date='::$ctrl.maxDate' " +
                    "value='::$ctrl.value' " +
                    "init-list='::$ctrl.initList' " +
                    "on-select='$ctrl.onSelect(result)' "
            };
        }

        function preDisplayValue() {
            $ctrl.prevValue = _.extend({}, $ctrl.value);
        }

        function getDateFromMoment(mom) {
            if (!mom) {
                return null;
            }
            //var defaultTimeTemp = getDefaultTime();
            return new Date(mom.year(), mom.month(), mom.date(),
        $ctrl.enableTime ? mom.hour() : 0,
                $ctrl.enableTime ? mom.minute() : 0,
      0, 0);
        }

        function getStringToMoment(d){
            return d ? (d._isAMomentObject ? d : moment.utc([d.getFullYear(), d.getMonth(), d.getDate(), 0,0,0])) : null;
        }
    }
}

angular.module('dropdowns.sbDate.menu.component.service', [
    'sb.fields.dates.processing.service'
])
.service('SbDateDrpMenuCtrlService', SbDateDrpMenuCtrlService);
SbDateDrpMenuCtrlService.$inject = ['TemplateCompileCompCtrlService', 'SbDatesProcessingService'];
function SbDateDrpMenuCtrlService(TemplateCompileCompCtrlService, SbDatesProcessingService) {
    return function ($ctrl, $element) {
        //console.log('SbDateDrpMenuCtrlService');
        var withoutTemplateScope = true;
        var pickerName = 'datepicker';
        $ctrl.SbDatesProcessingService = SbDatesProcessingService;

        $ctrl.preInit = preInit;
        $ctrl.getItemTemplate = getItemTemplate;
        $ctrl.onLoaded = onLoaded;
        $ctrl.onDestroy = onDestroy;
        $ctrl.getDateFromMoment = getDateFromMoment;
        $ctrl.destroyPicker = destroyPicker;
        $ctrl.createTimePicker = createTimePicker;

        $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

        return $ctrl;

        function preInit() {
            $ctrl.element.id = $ctrl.componentId;
            if (!$ctrl.value) {
                $ctrl.value = [];
            }

            $ctrl.enableTime = $ctrl.enableTime === true || $ctrl.enableTime === 'true';
            $ctrl.inputType = 'text';

            $ctrl.options = {
                mode: $ctrl.datetype || 'single',//"single", "multiple", or "range"
                disableMobile: true,
                allowInput: false, //Allows the user to enter a date directly into the input field. By default, direct entry is disabled.
                allowInvalidPreload: false,//Allows the preloading of an invalid date. When disabled, the field will be cleared if the provided date is invalid
                clickOpens: false,//Whether clicking on the input should open the picker. You could disable this if you wish to open the calendar manually with.open()

               /* enableTime: $ctrl.enableTime,//Enables time picker
                noCalendar: false,//Hides the day selection in calendar.  Use it along with enableTime to create a time picker.
                enableSeconds: false, //Enables seconds in the time picker.
                hourIncrement: 1,//Adjusts the step for the hour input (incl. scrolling)
                minuteIncrement: 30,	//Adjusts the step for the minute input (incl. scrolling)
                */

                inline: true,//Displays the calendar inline

                altInput: false, //Show the user a readable date (as per altFormat), but return something totally different to the server.
                dateFormat: 'Z',//A string of characters which are used to define how the date will be displayed in the input box. The supported characters are defined in the table below.
                //   disable: disableDates,//	See Disabling dates
                //    enable: undefined, //Array	undefined	See Enabling dates
                //altFormat: 'Z',//"F j, Y",//Exactly the same as date format, but for the altInput field
                //    altInputClass: ($ctrl.eClassAttr ? ($ctrl.eClassAttr + ' ') : '') + ($ctrl.fieldClass ? $ctrl.fieldClass : ''), //This class will be added to the input element created by the altInput option.  Note that altInput already inherits classes from the original input.

                parseDate: parseDate,//Function that expects a date string and must return a Date object
                formatDate: formatDate,//function that Allows using a custom date formatting function instead of the built-in handling for date formats using dateFormat, altFormat, etc.
                //position	String	"auto"	Where the calendar is rendered relative to the input vertically and horizontally. In the format of "[vertical] [horizontal]". Vertical can be auto, above or below (required). Horizontal can be left, center or right.  e.g. "above" or "auto center"
                //positionElement: null,//The element off of which the calendar will be positioned.

                shorthandCurrentMonth: false,//Show the month using the shorthand version (ie, Sep instead of September).
                static: true,//Position the calendar inside the wrapper and next to the input element*.
                showMonths: 1,//The number of months to be shown at the same time when displaying the calendar.
                weekNumbers: false,//Enables display of week numbers in calendar.
                wrap: false,//Custom elements and input groups
                monthSelectorType: "dropdown",//How the month should be displayed in the header of the calendar. "dropdown" or "static" If showMonths has a value greater than 1, the month is always shown as static.


                minDate: $ctrl.minDate ? $ctrl.minDate : null,//The minimum date that a user can start picking from (inclusive). String/Date
                maxDate: $ctrl.maxDate ? $ctrl.maxDate : null,//The maximum date that a user can pick to (inclusive). String/Date
                //defaultDate: $ctrl.temp,//Sets the initial selected date(s). If you're using mode: "multiple" or a range calendar supply an Array of Date objects or an Array of date strings which follow your dateFormat. Otherwise, you can supply a single Date object or a date string.

               // onChange: onChange, //Function(s) to trigger on every date selection. See Events API -> doesnt get triggered when time changes
                onValueUpdate: onValueUpdate,//gets triggered when the input value is updated with a new date string
                onDayCreate: onDayCreate, //Take full control of every date cell with the onDayCreate()hook.
            };
            $ctrl.options.clearBtn = $ctrl.hasRemove === true || $ctrl.hasRemove === 'true';
            if ($ctrl.header) {
                $ctrl.options.title = $ctrl.header;
            }
            if ($ctrl.enableTime) {
                $ctrl.options = _.extend($ctrl.options, {
                    time_24hr: $ctrl.timeFormat !== 'h:mma',//Displays time picker in 24 hour mode without AM/PM selection when enabled.\

                    //todo: should load the default time here

                    defaultHour: 7,//Initial value of the hour element.
                    defaultMinute: 0,//Initial value of the minute element.
                    //minTime: "16:00", //todo: set minTime maxTime
                    //maxTime: "22:00"
                });
            }

            if(typeof($ctrl.onDatePickerLoaded) === 'function') {
                $ctrl.options.onReady = function() {
                    $ctrl.LCS.timeout(function (){
                        $ctrl.onDatePickerLoaded();
                    }, 100);
                }
            }

            if(typeof($ctrl.onDatePickerClose) === 'function') {
                $ctrl.options.onClose = $ctrl.onDatePickerClose;
            }

            if (typeof ($ctrl.getOtherOptions) === 'function') {
                $ctrl.options = _.extend($ctrl.options, $ctrl.getOtherOptions());
            }
        }

        function getItemTemplate() {
            //Instead of body, appends the calendar to the specified node instead.  HTMLElement
            return '<div class="dropdown-menu selectabledropdown selector-dropdown ' + ($ctrl.fixedHeight ? 'fixedHeight ' : '') + ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '') + '"><div class="position-relative">' +
                 ($ctrl.getHeader ? $ctrl.getHeader() : '') +
                '<input class="inputField" type="text" style="width: 1px;height: 1px!important;opacity: 0;position: absolute"/>' +
                ($ctrl.getBottom ? $ctrl.getBottom() : '') +
                '</div></div>';
        }

        function onLoaded() {
            createPicker(pickerName, 'inputField', _.extend({},$ctrl.options,{
                dontClearRange: true
            }));
            if($ctrl.onLoadedOther) {
                $ctrl.onLoadedOther();
            }
        }

        function onDestroy() {
            destroyDatePicker();
        }

        function destroyDatePicker() {
            if (typeof ($ctrl.onDestroyOther) === 'function') {
                $ctrl.onDestroyOther();
            }
            $ctrl.destroyPicker(pickerName);
        }

        function createTimePicker(name, selector, options){
            var is24H = $ctrl.timeFormat !== 'h:mma';
            createPicker(name, selector, _.extend({}, options, {
                inline: true,
                noCalendar: true,
                enableTime: true,
                enableSeconds: false, //Enables seconds in the time picker.
                hourIncrement: 1,//Adjusts the step for the hour input (incl. scrolling)
                minuteIncrement: 30,	//Adjusts the step for the minute input (incl. scrolling)
                dateFormat: is24H ? 'H:i' : 'h:i K',
                time_24hr: is24H,
                onValueUpdate: onTimeUpdate,//gets triggered when the input value is updated with a new date string
            }));
        }

        function onTimeUpdate(selectedDates, dateStr, instance) {
            //console.log('onTimeUpdate');
            if (selectedDates && selectedDates.length > 0) {
                $ctrl.onChangeOther(selectedDates.map($ctrl.SbDatesProcessingService.getMomentFromDate), instance.element.getAttribute('data-prop'));
            }
        }

        function createPicker(name, selector, options) {
            $ctrl[selector] = $ctrl.element.querySelector('.' + selector);

            if ($ctrl[selector]) {
                $ctrl[name] = new flatpickr($ctrl[selector], options);
            }
        }

        function destroyPicker(name){
            $ctrl.LCS.timeout(function (){
                var picker = $ctrl[name];
                if (picker && typeof (picker.destroy) === 'function') {
                    picker.destroy();
                }
            }, 100);
        }

        function onValueUpdate(selectedDates, dateStr, instance) {
            //console.log('onValueUpdate dateStr' + dateStr);
            if (selectedDates && selectedDates.length > 0) {
                $ctrl.onChangeOther(selectedDates.map($ctrl.SbDatesProcessingService.getMomentFromDate));
            }
        }

        function onDayCreate(dObj, dStr, fp, dayElem) {
            // Utilize dayElem.dateObj, which is the corresponding Date
            // dummy logic
            if (Math.random() < 0.15) {
                dayElem.innerHTML += "<span class='event'></span>";
            } else if (Math.random() > 0.85) {
                dayElem.innerHTML += "<span class='event busy'></span>";
            }
        }

        function parseDate(datestr, format) {
            return moment(datestr, format, true).toDate();
        }

        function formatDate(date, format, locale) {
            // locale can also be used
            return moment(date).format(format);
        }

        function disableDates(date) {
            // return true to disable
            return $ctrl.minDate && date >= $ctrl.minDate || $ctrl.maxDate && date > $ctrl.maxDate;
        }

        function getDateFromMoment(mom) {
            if (!mom) {
                return null;
            }
            //var defaultTimeTemp = getDefaultTime();
            return new Date(mom.year(), mom.month(), mom.date(),
                $ctrl.enableTime ? mom.hours() : 0,
                $ctrl.enableTime ? mom.minutes() : 0,
                0, 0);
        }
    }
}

angular.module('sb.fields.dates.controller.service', [
    'sb.fields.date.component.service'
])
.service('SbDatesCtrlService', SbDatesCtrlService);

SbDatesCtrlService.$inject = ['SbDateCtrlService'];

//value: value
function SbDatesCtrlService(SbDateCtrlService) {
    return function ($ctrl, $element, $attrs){

        $ctrl.DateTypes = {Date: 1, Range:2, Dates: 3};

        $ctrl.process = process;

        $ctrl.getMenuDrpValue = getMenuDrpValue;
        $ctrl.preselect = preselect;
        $ctrl.initDrpOther = initDrpOther;
        $ctrl.getDefault = getDefault;

        $ctrl = new SbDateCtrlService($ctrl, $element, $attrs);

        return $ctrl;

        function initDrpOther(){
            //{from: Date, to: Date}
            if(!$ctrl.timeFormat) {
                $ctrl.timeFormat = $ctrl.CPS.timeFormat;
            }
            if(!$ctrl.defaultDate) {
                var today = $ctrl.getDateFromMoment($ctrl.MomentService.getMomentNow());
                $ctrl.defaultDate = $ctrl.getDefault(today);
            }
        }

        function getMenuDrpValue() { //{from, to}
            return $ctrl.duplicateValue($ctrl.value);
        }

        function preselect(result) {
            if (result) {
                $ctrl.setNewValue(result.e, result.value);
            }
        }

        function process(v, m){
            if (!v) {
                return null;
            }
            if(!m){
                m = function (v){return v;}
            }
            return {
                from: m(v.from),
                to: m(v.to)
            };
        }

        function getDefault(today){
            return {
                from: {value: $ctrl.getDateFromMoment($ctrl.MomentService.getUtcMomentFromDateMoment(today, $ctrl.CPS.startTime)), hasTime: false},
                to:  {value: $ctrl.getDateFromMoment($ctrl.MomentService.getUtcMomentEndDay(today)), hasTime: false}
            }
        }
    }
}

angular.module('sb.fields.dates.processing.service', [
])
.service('SbDatesProcessingService', SbDatesProcessingService);

SbDatesProcessingService.$inject = ['MomentService'];
//value: value
function SbDatesProcessingService(MomentService) {
    return {
        getStringForSide: getStringForSide,
        getMomentFromDate: getMomentFromDate
    }

    function getStringForSide($ctrl, v, hideTime) {
        if (!v || !v.value) {
            return null;
        }
        return $ctrl.CPS.getCreatedAt(v.value, $ctrl.dateFormat + ($ctrl.enableTime && v.hasTime &&!hideTime ? (' @ ' + $ctrl.timeFormat) : ''));
    }
    function getMomentFromDate(d){
        return d ? MomentService.utc([d.getFullYear(), d.getMonth(), d.getDate(),
            d.getHours(), d.getMinutes(), 0, 0]) : null;
    }
}

angular.module('dropdowns.sbCheck.menu.component', [
])

.component('sbCheckDropdownMenu', {
    bindings: {
        withSaveOnTouchScreen:'@',
        hasCustom:'<',
        drpClassAttr: '@?',
        fixedHeight: '@',
        labelField: '<',
        valueField: '<',
        header: '<',
        showColorName: '<',
        onSelect: '&',
        //variables:

        list: '<',
        value: '<',
        withUncheck: '<'
    },
    controller: 'SBCheckDrpMenuCtrl',
})
.controller('SBCheckDrpMenuCtrl', SBCheckDrpMenuCtrl);

SBCheckDrpMenuCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];

function SBCheckDrpMenuCtrl(TemplateCompileCompCtrlService, $element) {
    console.log('SBCheckDrpMenuCtrl');
    var $ctrl = this,
        withoutTemplateScope = true;

    $ctrl.itemClass = 'select-row';

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        if (!$ctrl.value) {
            $ctrl.value = [];
        }
    }
    function onLoaded() {
        setSelected();
        bind(true);
    }

    function getItemTemplate() {
        var body = "<div class='dropdown-menu selectabledropdown selector-dropdown " + ($ctrl.fixedHeight ? "fixedHeight " : '') + ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '') + "'><div>";

        if($ctrl.list) {
            body += "<div class='clearfix'>";
            for (var prop in $ctrl.list) {
                body += "<div class='column'>";

                _.each($ctrl.list[prop], function (item) {
                    var lab=item[$ctrl.labelField].substring(0,$ctrl.truncate);
                    if(item.isHeader) {
                        //class: (prop<$ctrl.columns && !item.withoutPadding?'with-margin-right':'')
                        body += "<div class='header'>"+lab+"</div>";
                    } else {
                        body += "<div class='item with-cursor table-div " + $ctrl.itemClass + "' data-id='" + item[$ctrl.valueField] + "'>" +
                            "<div class='custom-checkbox inrow centered not-disabled'><label><input type='checkbox' disabled='disabled'><span></span></label></div>" +
                            "<div class='namex text-left " + (prop < $ctrl.columns && !item.withoutPadding ? 'with-padding-right' : '') + "'>" + lab + "</div>" +
                            "</div>";
                    }
                });

                body += "</div>";
            }
            body += "</div>";
        }

        if($ctrl.hasCustom){
        body += "<div class='separatorline clearfix spacing-half margin-top-half'>" +
                    "<div class='table-div full-width'>" +
                        "<div class='centered col30 "+$ctrl.itemClass+"' data-id='custom'>" +
                            "<div class='custom-checkbox special not-disabled'><label><input type='checkbox' disabled='disabled'><span></span></label></div>" +
                        "</div>" +
                        "<div>" +
                            "<input id='customItemText' class='form-control thin with-underline font-size-12' placeholder='Custom " + ($ctrl.placeholder?$ctrl.placeholder:'')+"'/>" +
                        "</div>" +
                    "</div>" +
                "</div>";
        }

        body += getSaveBtns() +  '</div></div>';

        return body;
    }

    function bind(isBind) {
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('.' + $ctrl.itemClass), select);

        if ($ctrl.hasCustom) {
            var el = $ctrl.element.querySelector('#customItemText');
            if (el) {
                $ctrl.LCS.bindElementsClick(isBind, el, onCustom, 'cstmbtn', 'focus');
                $ctrl.LCS.bindElementsClick(isBind, el, onCustomKey, 'cstmbtn', 'keyup paste');
                if (isBind) {
                   // el.focus();
                }
            }
        }
    }

    function select(e) {
        selectRow(e, e.currentTarget.getAttribute('data-id'));
    }

    function onCustom(e) {
        //  console.log('onCustomKeydown: ' + this.value);
        selectRow(e, 'custom');
    }

    function onCustomKey(e) {
        selectRow(e, 'custom', true);
    }

    function selectRow(e, id, isTyping) {
        var isCustom = id === 'custom', exists = false, item;
        for (var i = $ctrl.value.length - 1; i >= 0; i--) {
            item = $ctrl.value[i];
            if ((isCustom && item && item.id === 'custom') || (!isCustom && item === id)) {
                exists = true;
                if (isCustom && isTyping) {
                    $ctrl.value[i] = getCustomValue();
                    break;
                }
                if ($ctrl.withUncheck) {
                    $ctrl.value.splice(i, 1);
                    setClass(item, false);
                }
                break;
            }
        }
        if (!exists) {
            item = isCustom ? getCustomValue(true) : id;
            $ctrl.value.push(item);
            setClass(item, true);
        }
        $ctrl.prevValue = angular.copy($ctrl.value);

        $ctrl.onSelect({result: {e: e, value: $ctrl.prevValue}});
        e.stopPropagation();

        function getCustomValue(withfocus) {
            var el = $ctrl.element.querySelector('#customItemText');
            if (withfocus && el) {
                el.focus();
            }
            return {id: 'custom', name: el.value ? el.value : null};
        }
    }

    function setSelected() {
        if ($ctrl.value) {
            _.each($ctrl.value, function (item) {
                setClass(item, true);
            });
        }
        $ctrl.prevValue = angular.copy($ctrl.value);
    }

    function setClass(item, isAdd) {
        var isCustom = item && item.id === 'custom',
            el = $ctrl.element.querySelector(('.' + $ctrl.itemClass + '[data-id="' + (isCustom ? 'custom' : item) + '"] ') + ' input');
        if (isAdd) {
            el.setAttribute('checked', 'checked');
        } else {
            el.removeAttribute('checked');
        }
        if (isCustom) {
            el = $ctrl.element.querySelector('#customItemText');
            if (el) {
                el.value = item.name;
            }
        }
    }

    function onDestroy() {
        bind(false);
    }

    function getSaveBtns() {
        return ($ctrl.withSaveOnTouchScreen ? ('<div class="divBtnSave spacing-half full-width">' +
            '<button id="btnSaveDrp" class="btn primary smallbtn small-btns" type="button" analytics-on analytics-action="Save">Save</button>' +
            //'<span class="orsmall">or</span>' +
            //'<a id="btnCloseDrp" class="cancelsmall">Cancel</a>' +
            '</div>') : '');
    }
}

angular.module('dropdowns.sbCheck.component', [
    'dropdowns.sbCheck.menu.component',
    'dropdowns.drpnonclosed.controller.service'
])
.component('sbCheckDropdown', sbFieldComponentParams('SBCheckDrpCtrl', {
    initList: '<',
    withUncheck: '@?',
    hasCustom:'@?',
    minWidth:'@?'
}, getSBDropdownTemplate()))
.controller('SBCheckDrpCtrl', SBCheckDrpCtrl);
SBCheckDrpCtrl.$inject = ['SBFieldTypesService', 'SBDrpNonClosedCtrlService', '$element', '$attrs'];
function SBCheckDrpCtrl(SBFieldTypesService, SBDrpNonClosedCtrlService, $element, $attrs) {

    var withoutTemplateScope = true;

    var $ctrl = this;

    $ctrl.menuTag = 'sb-check-dropdown-menu';
    $ctrl.propType = SBFieldTypesService.PropTypes.Check;
    $ctrl.generateDrpMenuContent = generateDrpMenuContent;
    $ctrl.initDrp = initDrp;
    $ctrl.isSameValue = isSameValue;

    $ctrl.setInputField = false;

    $ctrl = new SBDrpNonClosedCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

    function initDrp() {
        $ctrl.valueField = 'id';

        $ctrl.withUncheck = $ctrl.withUncheck === 'true' || $ctrl.withUncheck === true;
        $ctrl.hasCustom = $ctrl.hasCustom === 'true' || $ctrl.hasCustom === true;
    }

    function isSameValue(a1, a2) {
        if (!a1 && !a2) {
            return true;
        }
        if (!a1 && a2 || !a2 && a1 || a1 && a2 && a1.length !== a2.length) {
            return false;
        }
        return a1.every(function (element, index) {
            var pos = a2.indexOf(element);
            if (pos > -1) {
                return element === a2[pos];
            }
        });
    }

    function generateDrpMenuContent() {
        return {
            $ctrl: {
                withUncheck: $ctrl.withUncheck,
                hasCustom: $ctrl.hasCustom,
                labelField: $ctrl.labelField,
                valueField: $ctrl.valueField,
                list: $ctrl.colListItems,
                value: angular.copy($ctrl.value),
                onSelect: $ctrl.onSelect,
            },

            template: ($ctrl.fixedHeight ? ("fixed-height='true' ") : '') +
                "label-field='::$ctrl.labelField' " +
                "value-field='::$ctrl.valueField' " +
                "list='::$ctrl.list' " +
                "has-custom='::$ctrl.hasCustom' " +
                "with-uncheck='::$ctrl.withUncheck' " +
                "value='::$ctrl.value' " +
                "on-select='$ctrl.onSelect(result)' "
        };
    }
}

angular.module('dropdowns.contactRate.component', [
    'dropdowns.rate.dropdown.component',
    'dropdowns.contactRate.controller.service'
])
.component('sbContactRateDropdown', sbFieldComponentParams('SbContactRateCtrl', {
    removeText:'@?',
    hasRemove: '@?',
    minWidth:'@?',
    labelField:'@?',
    valueField:'@?',
    contactLists: '<', // if in project contacts
    contactListId:'<'
}, getSBDropdownTemplate()))
.controller('SbContactRateCtrl', SbContactRateCtrl);
SbContactRateCtrl.$inject = ['SBContactRateCtrlService', '$element', '$attrs'];
function SbContactRateCtrl(SBContactRateCtrlService, $element, $attrs) {
    console.log('SbContactRateCtrl');
    var $ctrl = this,
        prop = 'rate';

    $ctrl.setUpdatePropValue = setUpdatePropValue;
    $ctrl.getExtendedEditChanges = getExtendedEditChanges;
    $ctrl.getContactRate = getContactRate;
    $ctrl.preInitField = preInitField;

    $ctrl.isContactRate = true;
    $ctrl = new SBContactRateCtrlService($ctrl, $element, $attrs);

    function preInitField() {
        if($ctrl.contactListId) {
            var contactLists = _.deepClone($ctrl.contactLists);

            if (!contactLists) {
                contactLists = {};
            }

            if (!contactLists['c_' + $ctrl.contactListId]) {
                contactLists['c_' + $ctrl.contactListId] = {};
            }
            $ctrl.item.contactLists = contactLists;
            $ctrl.value = getRate($ctrl.item);
            //$ctrl.forceSave = true;
        }
    }

    function setUpdatePropValue(item) {
        var val = angular.copy($ctrl.value);
        if($ctrl.contactListId) {
            item.contactLists['c_' + $ctrl.contactListId][prop] = val;
        }
        if($ctrl.contactListId && $ctrl.setDefault || !$ctrl.contactListId) {
            item[prop] = val;
        }
    }

    function getExtendedEditChanges(item) {
        var e = {};
        if (item) {
            if ($ctrl.contactListId) {
                if (item.contactLists) {
                    e.contactLists = angular.copy(item.contactLists);
                    $ctrl.item.contactLists = angular.copy(item.contactLists);
                }
            }

            e[prop] = angular.copy(item[prop]);
            $ctrl.item[prop] = angular.copy(item[prop]);
        }else{
            //todo for when value is not saved
            console.warn('contact rate getExtendedEditChanges: item is not defined');
        }
        return e;
    }

    function getContactRate(item, canUpdate) {
        return $ctrl.SBFieldMethods.displayRate(getRate(item), $ctrl.CPS.getCurrentRate);
    }

    function getRate(item) {
        return $ctrl.contactListId ? ($ctrl.item.contactLists && $ctrl.item.contactLists['c_' + $ctrl.contactListId] ? $ctrl.item.contactLists['c_' + $ctrl.contactListId][prop] :null) : item[prop];
    }
}

