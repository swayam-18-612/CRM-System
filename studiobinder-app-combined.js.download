angular.module('user.payment.quotaExceeding.component', [
    'apiServices.Plans',
    'apiServices.Subscriptions'
])
.component('downgradeQuotaExceededPopup', popupComponentParams('DowngradeQuotaExceededPopupCtrl'))
.controller('DowngradeQuotaExceededPopupCtrl', DowngradeQuotaExceededPopupCtrl);

DowngradeQuotaExceededPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', '$element'];
function DowngradeQuotaExceededPopupCtrl (ItemTemplateCompileCtrlService, $element) {
    console.log('DowngradeQuotaExceededPopupCtrl');
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.goToProperty = goToProperty;

    $ctrl.preInit = preInit;
    $ctrl.getPopupFooterBtns = getPopupFooterBtns;
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInit() {
        $ctrl.overQuota = $ctrl.extraParam.overQuota[0];
        var upgradePlan = $ctrl.extraParam.upgradePlan;
        $ctrl.upgradePlanName = upgradePlan.plans[upgradePlan.showMonthly ? 'month' : 'year'].name;
    }

    function setTemplateData() {
        $ctrl.icon = 'card';
        $ctrl.iconLevel = 3;
        $ctrl.popupTitle = 'Before You Downgrade';
    }

    function getPopupBodyContent() {
        return '<p class="text-center">You currently have '+$ctrl.overQuota.used+ ' ' + $ctrl.overQuota.shortDesc +
            ', while the limit for the '+$ctrl.upgradePlanName+' plan is '+$ctrl.overQuota.total+'.</p>' +
            '<p class="text-center">To downgrade to '+$ctrl.upgradePlanName+', you must first remove '+($ctrl.overQuota.used - $ctrl.overQuota.total)+' '+$ctrl.overQuota.shortDesc+'.</p>';
    }

    function getPopupFooterBtns() {
    return '<a class="'+$ctrl.getBtnActionCls()+' btn btn-primary medium" data-type="goToProperty" data-info="'+$ctrl.overQuota.name+'" analytics-on analytics-action="Payment Before You Downgrade">View ' + $ctrl.overQuota.shortDesc+'</a>';
    }

    function goToProperty(property, e) {
        if (property) {
            $ctrl.CPS.transitionTo('user.' + property, $ctrl.CPS.currentPathParams());
        }

        $ctrl.closePopup(e);
    }
}

angular.module('user.payment.feature-unavailable.component',[
