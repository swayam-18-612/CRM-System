                type: 'Edit',
                template: popupTemplate,
                size: 'medium',
                transp: ' ',
            }
        },

        Hotkeys = [
            {key: 'e', desc: 'Edit selected recipients'},
            {key: 'backspace', desc: 'Delete selected recipients'}
        ],

        SidebarOptions = null;

    return {
        PropTypes: PropTypes,
        Settings: Settings,
        Options: Options,
        Filters: {Filters: Filters},
        ViewProp: 'callsheetConfirmationsView',

        CompOptions: CompOptions,
        ListTreeServiceParams: ListTreeServiceParams,
