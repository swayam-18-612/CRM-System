})
.controller('PdfjsViewerController', PdfjsViewerController);
PdfjsViewerController.$inject = ['TemplateCompileCompCtrlService', 'PdfAnnotationsControllerService', '$interval','$element', '$attrs', '$scope'];
function PdfjsViewerController(TemplateCompileCompCtrlService, PdfAnnotationsControllerService, $interval ,$element, $attrs,  $scope) {
    var $ctrl = this;

    var initialised = false, loaded = {}, poller, numLoaded = 0;
    // watch pdf source
    $ctrl.PDFJS = window.PDFJS;
    $ctrl.changedFields = ['src', 'data'];

    $ctrl.withAnnotations = false;
    $ctrl.pdfViewer = null;

    $ctrl.printMethod = printMethod;

    $ctrl.$onChanges = $onChanges;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        if($ctrl.$element && $ctrl.$element.on) {
            $ctrl.$element.on('$destroy', onDestroy);
        }

        $ctrl.HOSTED_VIEWER_ORIGINS = [$ctrl.CPS.websiteUrl];
        if($ctrl.CPS.awsOrigin) {
            $ctrl.HOSTED_VIEWER_ORIGINS.push($ctrl.CPS.awsOrigin);
        }
    }

    function validSrc(src) {
        if($ctrl.HOSTED_VIEWER_ORIGINS.indexOf(new URL(window.location.href).origin || 'null') ===-1){return false;}
        return _.find($ctrl.HOSTED_VIEWER_ORIGINS, function (val) {
            return src.indexOf(val) >= 0;
        });
    }

    function onLoaded() {
        $ctrl.$element.children().wrap('<div class="pdfjs full-width " style=" height: 100%;"></div>');
        if (!$ctrl.PDFJS) {
            return console.warn("PDFJS is not set! Make sure that pdf.js is loaded before.");
        }
        console.log('sbPdfViewer loaded');
         // initialize the pdf viewer with (with empty source)
        if(!validSrc($ctrl.src)){
            return console.warn("invalid file.");
        }
        $ctrl.PDFJS.webViewerLoad($ctrl.src);
        bind(true);

        poller = $interval(pdfPoller, 200);

        // watch other attributes
        $ctrl.addToObservable($scope, function () {
            return $attrs;
        }, onAttrsChange);
    }

    function $onChanges(changes) {
        console.log(changes);
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i], change = changes[field];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                if (field === 'src' || field === 'data') {
                    onGroupChange();
                }else if(field === 'download'){
                    var hide = $ctrl.download === 'false'||$ctrl.download === false;
                    hideElement('download', hide);
                    hideElement('secondaryDownload', hide);
                }else if(field === 'print'){
                    var hide = $ctrl.print === 'false'||$ctrl.print === false;
                    hideElement('print', hide);
                    hideElement('secondaryPrint', hide);
                }
                break;
            }
        }
    }

    function hideElement(el, hide) {
        document.getElementById(el).setAttribute('hidden', hide);
    }

    function bind(isBind) {
        if(!$ctrl.btnPrint){
            $ctrl.btnPrint = $ctrl.element.querySelector('#secondaryPrint');
        }
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnPrint, $ctrl.printMethod);
        if(!$ctrl.btnToggleAnnotations){
            $ctrl.btnToggleAnnotations = $ctrl.element.querySelector('#annotationsToolbarToggle');
        }
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnToggleAnnotations, $ctrl.toggleAnnotations);
    }

    function pdfPoller() {
        if (!window.PDFViewerApplication) {
            return;
        }

        $ctrl.pdfViewer = window.PDFViewerApplication.pdfViewer;

        if ($ctrl.pdfViewer) {
            if ($ctrl.scale !== $ctrl.pdfViewer.currentScale) {
                loaded = {};
                numLoaded = 0;
                $ctrl.scale = $ctrl.pdfViewer.currentScale;
            }
        } else {
            console.warn("PDFViewerApplication.pdfViewer is not set");
        }

        $ctrl.pages = getPages();
        $ctrl.pagesCount = $ctrl.pages ? $ctrl.pages.length : 0;
        _.each($ctrl.pages, function (page) {
            var element = angular.element(page);
            var pageNum = element.attr('data-page-number');

            if (!element.attr('data-loaded')) {
                delete loaded[pageNum];
                return;
            }

            if (pageNum in loaded) {
                return;
            }

            if (!initialised) {
                onPdfInit();
            }

            if ($ctrl.loadPageAnnotations) {
                $ctrl.loadPageAnnotations(pageNum);
            }

            if ($ctrl.onPageLoad) {
                if ($ctrl.onPageLoad({page: pageNum}) === false) {
                    return;
                }
            }


            loaded[pageNum] = true;
            numLoaded++;
        });
    }

    function printMethod(e) {
        $ctrl.preventDefault(e);
        //todo
    }

    function toggleAnnotations(e) {
        $ctrl.preventDefault(e);
        $ctrl.openedAnnotations = $ctrl.openedAnnotations ? false : true;
    }

    function getPages() {
        return document.querySelectorAll('.page');
    }

    function onPdfInit() {
        console.log('onPdfInit');
        initialised = true;
        removeMouseListeners();
        if ($ctrl.onInit) {
            $ctrl.onInit();
        }

        //initAnnotations();
    }

    function initAnnotations() {
        if ($ctrl.withAnnotations) {
            var $ctrl = this;
            $ctrl = new PdfAnnotationsControllerService($ctrl);
            $ctrl.loadPdfAnnotations($ctrl.materialId);
        }
    }

    function removeMouseListeners() {
        if ($attrs.removeMouseListeners === 'true') {
            $ctrl.LCS.bindElementListeners(false, window, handleMouseWheel,'DOMMouseScroll');
            $ctrl.LCS.bindElementListeners(false, window, handleMouseWheel,'mousewheel');

            var pages = getPages();
            if(pages && pages.length > 0) {
                _.each(getPages(), function (page) {
                    angular.element(page).children().css('pointer-events', 'none');
                });
            }
        }
    }

    function handleMouseWheel(e){

    }

    function onGroupChange(values) {
        var src = values[0];
        var data = values[1], path;

        if (!src && !data) {
            return;
        }

        if ($ctrl.isSrc) {
            if (!src) {
                return;
            } else {
                path = src;
            }
        } else {
            if (!data) {
                return;
            } else {
                path = data;
            }
        }

        window.PDFViewerApplication.open(path);
    }

    function onAttrsChange() {
        if ($attrs.open === 'false') {
            document.getElementById('openFile').setAttribute('hidden', 'true');
            document.getElementById('secondaryOpenFile').setAttribute('hidden', 'true');
        }
        set('width');
        set('height');

        function set(prop){
            var v = $attrs[prop];
            if (v) {
                var el = document.getElementById('outerContainer');
                if(el){
                    if(!el.style){el.style = {};}
                    el.style[prop] = v;
                }
            }
        }
    }

    function onDestroy() {
        bind(false);
        if(poller){
            $interval.cancel(poller);
        }
    }

    function getItemTemplate() {
        return '<pdfjs-wrapper class="pdfjs">' +
                '<div id="outerContainer" class=" one-line-tooltip">' +
                  '<div id="sidebarContainer">' +
                    '<div id="toolbarSidebar">' +
                        '<div class="splitToolbarButton toggled">' +
                          '<button id="viewThumbnail" class="toolbarButton sbf group toggled thumbnails" tabindex="2" data-l10n-id="thumbs">' +
                            ' <span data-l10n-id="thumbs_label" tooltip-placement="bottom" tooltip="Show Thumbnails"></span>' +
                          '</button>' +
                          '<button id="viewOutline" class="toolbarButton sbf group outline" tabindex="3" data-l10n-id="document_outline">' +
                            ' <span data-l10n-id="document_outline_label" tooltip-placement="bottom" tooltip="Document Outline"></span>' +
                          '</button>' +
                          '<button id="viewAttachments" class="toolbarButton sbf group attach" tabindex="4" data-l10n-id="attachments">' +
                            ' <span data-l10n-id="attachments_label" tooltip-placement="bottom" tooltip="Show Attachments"></span>' +
                          '</button>' +
                        '</div>' +
                    '</div>' +
                    '<div id="sidebarContent">' +
                        '<div id="thumbnailView"></div>' +
                        '<div id="outlineView" class="hidden"></div>' +
                        '<div id="attachmentsView" class="hidden"></div>' +
                    '</div>' +
                  '</div>  <!-- sidebarContainer -->' +
                  '<div id="mainContainer">' +
                    '<div class="findbar hidden doorHanger hiddenSmallView" id="findbar">' +
                        '<input id="findInput" class="toolbarField" tabindex="91" placeholder="Find in document">' +
                        '<div class="splitToolbarButton with-margin-left with-margin-right">' +
                              '<button class="toolbarButton sbf findPrevious arrow-left-filled" id="findPrevious" tabindex="92" data-l10n-id="find_previous">' +
                                '<span data-l10n-id="find_previous_label" tooltip-placement="bottom" tooltip="Previous"></span>' +
                              '</button>' +
                              '<div class="splitToolbarButtonSeparator"></div>' +
                              '<button class="toolbarButton sbf findNext arrow-right-filled" id="findNext" tabindex="93" data-l10n-id="find_next">' +
                                '<span data-l10n-id="find_next_label" tooltip-placement="bottom" tooltip="Next"></span>' +
                              '</button>' +
                            '</div>' +
                        '<div class="custom-checkbox inrow toolbarCheckbox"><label><input type="checkbox" id="findHighlightAll" tabindex="94"><span></span></label></div>' +

                        '<label for="findHighlightAll" class="toolbarLabel" data-l10n-id="find_highlight">Highlight all</label>' +
                        '<div class="custom-checkbox inrow toolbarCheckbox"><label><input type="checkbox" id="findMatchCase" tabindex="95"><span></span></label></div>' +
                        '<label for="findMatchCase" class="toolbarLabel with-margin-right" data-l10n-id="find_match_case_label">Match case</label>' +
                        '<span id="findResultsCount" class="toolbarLabel hidden"></span>' +
                        '<span id="findMsg" class="toolbarLabel"></span>' +
                    '</div>  <!-- findbar -->' +
                    '<div id="secondaryToolbar" class="secondaryToolbar hidden doorHangerRight">' +
                        '<div id="secondaryToolbarButtonContainer">' +
                          '<button id="secondaryPresentationMode" class="secondarytoolbarButton visibleLargeView fit-to-width with-margin-right" tabindex="51" data-l10n-id="presentation_mode">' +
                           $ctrl.LCS.getISBDiv('presentationMode', 0, 'pull-left') +
                            '<span data-l10n-id="presentation_mode_label" tooltip-placement="bottom" tooltip="Presentation Mode"></span>' +
                          '</button>' +
                          '<button id="secondaryOpenFile" class="ng-hide secondarytoolbarButton visibleLargeView with-margin-right" tabindex="52" data-l10n-id="open_file">' +
            $ctrl.LCS.getISBDiv('openFile', 0) +
                            '<span data-l10n-id="open_file_label" tooltip-placement="bottom" tooltip="Open File"></span>' +
                          '</button>' +
                            '<button id="secondaryPrint" class="secondarytoolbarButton visibleMediumView with-margin-right" tabindex="53">' +
            $ctrl.LCS.getISBDiv('print', 2) +
                                '<span tooltip-placement="bottom" tooltip="Print"></span>' +
                            '</button>' +
                          '<button id="secondaryDownload" class="secondarytoolbarButton visibleMediumView with-margin-right" tabindex="54" data-l10n-id="download">' +
            $ctrl.LCS.getISBDiv('download', 3) +
                            '<span data-l10n-id="download_label" tooltip-placement="bottom" tooltip="Download"></span>' +
                          '</button>' +
                          '<a href="#" id="secondaryViewBookmark" class="ng-hide secondarytoolbarButton visibleSmallView with-margin-right" tabindex="55" data-l10n-id="bookmark">' +
            $ctrl.LCS.getISBDiv('bookmark', 2) +
                            '<span data-l10n-id="bookmark_label" tooltip-placement="bottom" tooltip="Current view"></span>' +
                          '</a>' +
                          '<div class="horizontalToolbarSeparator visibleLargeView"></div>' +
                          '<button id="firstPage" class="secondarytoolbarButton go-to-start-filled" tabindex="56" data-l10n-id="first_page">' +
            $ctrl.LCS.getISBDiv('go-to-start-filled', 2, 'pull-left with-margin-right') +
                            '<span data-l10n-id="first_page_label">Go to First Page</span>' +
                          '</button>' +
