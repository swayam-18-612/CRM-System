angular.module('product.preLoading.callsheet.group.service', [
    'product.preLoading.callsheets.service',
    'product.preLoading.callsheetAdvancedSchedules.service',
    'product.preLoading.callsheetSchedules.service',
    'product.preLoading.callsheetLocations.service',
    'product.preLoading.departmentNotes.service',
    'product.preLoading.topCalls.service',
    'product.preLoading.extras.service',
    'product.preLoading.locations.service',

    'product.preLoading.callsheetInvitations.service',

    'product.preLoading.contacts.group.init.service'
])
 .service('CallsheetGroupLoadingService', CallsheetGroupLoadingService);
CallsheetGroupLoadingService.$inject = ['ContactsGroupInitLoadingService', 'CallsheetsLoadingService', 'CallsheetAdvancedSchedulesLoadingService', 'CallsheetSchedulesLoadingService', 'CallsheetLocationsLoadingService', 'DepartmentNotesLoadingService', 'TopCallsLoadingService', 'ExtrasLoadingService', 'LocationsLoadingService', 'RecipientListsLoadingService', 'CallsheetInvitationsLoadingService'];
function CallsheetGroupLoadingService(ContactsGroupInitLoadingService, Callsheets, CallsheetAdvancedSchedules, CallsheetSchedules, CallsheetLocations, DepartmentNotes, TopCalls, Extras, Locations, RecipientLists, CallsheetInvitations) {
    var Tbl = {}, TblTypes = {};

    _.each([CallsheetAdvancedSchedules, CallsheetSchedules,
    CallsheetLocations, DepartmentNotes, TopCalls, Extras, CallsheetInvitations,
        Locations, Callsheets, RecipientLists], function (table){
        var name = table.name,
            withoutLoad = name === 'Locations' || name === 'Callsheets' || name === 'RecipientLists';
        TblTypes[name] = table.tableType;
        Tbl[TblTypes[name]] = {loadingService: table, withoutLoad: withoutLoad};
    });

    var Resource = new ContactsGroupInitLoadingService('isInitCallsheet', Tbl, TblTypes);

    Resource.prototype.loadCallsheetSchedules = function (force, table, next) {
        var _this = this;
        if(force){
            Resource.isCSLoaded = false; Resource.isCSLoading = false;
        }
        if (!Resource.isCSLoaded && !Resource.isCSLoading) {
            Resource.isCSLoading = true;
            _this.loadAndInitTable(_this.TblTypes[table], null, null, c, 'getAll');
        } else {
            next();
        }

        function c() {
            Resource.isCSLoaded = true;
            Resource.isCSLoading = false;
            return next();
        }
    };

    Resource.prototype.load = function (next, otherParams) {
        var _this = this;

      /*  var isCollaborator = otherParams && otherParams.isCollaborator === true;
        if(isCollaborator){
            _this.Tbl[_this.TblTypes.CallsheetInvitations].withoutLoad = true;
        }*/
        _this.preloadTables(onLoaded);

        function onLoaded() {
             var tasks = {};
            add('RecipientLists', 'getAllPredef');
            add('ContactLists', 'getAll');

            async.parallel(tasks, function (err, res) {
                next();
            });

            function add(table, m, pageSize, populate){
                tasks[table] = function (c) {
                    _this.loadAndInitTable(_this.TblTypes[table], pageSize, populate, c, m);
                };
            }

            /*if(isCollaborator){
                tasks.callsheetInvitations = function (c) {
                    var params = _this.getTableParams(_this.Tbl[CallsheetInvitations.tableType]);
                    CallsheetInvitations.objectService.getAll(params, null, 'castId', function (invites) {
                        var contacts = [];
                        if(invites && invites.length>0){
                            _.each(invites, function (invite, i) {
                                var cast = invite.castId;
                                if(cast){
                                    var id = cast._id;
                                    invites[i].castId = id;
                                    if(_.find(contacts, function (item) {return item._id === id}) === undefined){
                                        contacts.push(cast);
                                    }
                                }
                            });
                        }
                        CallsheetInvitations.initTable(params , invites);
                        return c();
                    }, function (err) {
                        console.log(err);
                        return c();
                    }, true);
                };
            }
            async.parallel(tasks, function (err, res) {
                next();
            });*/
        }
    };

    return Resource;
}

