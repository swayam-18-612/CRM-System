        Hotkeys = null,

        SidebarOptions = {
            removeAdditionalMessage: ' and all the elements within it',
            addGroupPopupName: 'createTaggingCategory',
            editGroupPopupName: 'updateTaggingCategory',
            treeAddNotInline: true,
        };

    return {
        Settings: Settings,
