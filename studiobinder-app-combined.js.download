        departments: '<',
        positions: '<',

        callsheetId: '<',
        preProcessGroupItems: '&',

        addCallsheetRecipients: '&',
        sendCallsheetRecipients: '&'
    });
}

angular.module('product.callsheet.recipients.group.extended.controller.service',[
    'product.contacts.group.init.service',
    'apiServices.Contacts'
])
    .service('CallsheetRecipientsGroupExtendedCtrl',CallsheetRecipientsGroupExtendedCtrl);
CallsheetRecipientsGroupExtendedCtrl.$inject = ['ContactsGroupInitCtrlService', 'ContactsService'];
function CallsheetRecipientsGroupExtendedCtrl(ContactsGroupInitCtrlService, ContactsService) {
    return function ($ctrl) {

        $ctrl.ContactsService = ContactsService;

        $ctrl.quotaTypeMessages = 'callsheetMessages';
        $ctrl.populatedFieldWithImage = 'castId';

        $ctrl.getUpdatedChanges = getUpdatedChanges;
        $ctrl.preProcessGroupItem = preProcessGroupItem;
        $ctrl.afterProcessUpdatesG = afterProcessUpdatesG;
        $ctrl.edit = edit;
        $ctrl.getEditPopupParams = getEditPopupParams;
        $ctrl.showColumnMobileView = showColumnMobileView;
        $ctrl.onClipboardProcessingSuccess = onClipboardProcessingSuccess;
        $ctrl.onUpdatedImage = onUpdatedImage;

        $ctrl.getProcessSelectedParams = getProcessSelectedParams;
        $ctrl.getCollectionServiceForImage = getCollectionServiceForImage;

        $ctrl = new ContactsGroupInitCtrlService($ctrl);

        if($ctrl.isCrewList() || $ctrl.isEditCallsheet) {
            $ctrl.afterProcessUpdatesOther = afterProcessUpdatesOther;
        }

        return $ctrl;

        function getCollectionServiceForImage(){
            return $ctrl.ContactsService;
        }

        function onUpdatedImage(item, result){
            console.log('CallsheetRecipientsGroupExtendedCtrl.onUpdatedImage');
            //check if item is in list -> on the callsheet editor the methods is called in multiple grids

            var exists = $ctrl.list.getElementById(item._id);
            if(!exists) {return;}
            var c = $ctrl.preLoadingService.getById($ctrl.preLoadingService.TblTypes.Contacts, item[$ctrl.populatedFieldWithImage]);
            if(c) {
                var changes = $ctrl.ContactsService.convertResource(c).getUpdatedImageProps(result.updatedImage),
                    changedFields = [];
                for(var p in changes) {
                    changedFields.push(p);
                }
                if(changedFields) {
                    $ctrl.processCachedElementInit(changes, $ctrl.preLoadingService.Ops.Edit, changedFields, $ctrl.preLoadingService.TblTypes.ContactLists, true);

                    afterProcessUpdatesG();
                }
            }
        }

        function afterProcessUpdatesG() {
            console.log('afterProcessUpdatesG');
            $ctrl.allContacts = $ctrl.preLoadingService.getObjectList($ctrl.preLoadingService.TblTypes.Contacts);
            $ctrl.broadcastRoot('RELOAD_ALL_CONTACTS', $ctrl.allContacts);

            return $ctrl.allContacts;
        }

        function getProcessSelectedParams(updates){
            if(updates && updates.clipboard){
                updates.clipboard = updates.clipboard.map(function (el){
                    el.sId = null;
                    return el;
                });
            }

            return updates;

        }

        function afterProcessUpdatesOther(result) {
            console.log('afterProcessUpdatesOther');

           var u = result ? (result.editchanges || result.updates) : null,
                //edit roles or edit contact
                reload = ($ctrl.isEditCallsheet && result && result.type === 3) ||
                    result.isPopup && u && (u.hasOwnProperty('roles') || u.hasOwnProperty('contactLists'));
            if (reload) {
                $ctrl.loadGroupTemplate(result);
            }

            if(typeof ($ctrl.onPostloadGroup) === 'function') {
                $ctrl.onPostloadGroup(result);
            }
        }

        function onClipboardProcessingSuccess(opType, result){
            console.log('onClipboardProcessingSuccess');
            //trigger reload for update all the grids
            //when remove selected happens; -> goes to afterProcessUpdatesOther
            result.type = 3;
            $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result);

            if(typeof($ctrl.onClipboardProcessingSuccessOther) === 'function'){
                $ctrl.onClipboardProcessingSuccessOther(result);
            }
        }

        function showColumnMobileView(item, c) {
            return item.showDetails || !item.showDetails && (c.prop !== 'email' && c.prop !== 'phone');
        }

        function edit(item, field) {
            console.log('groups callsheet recipients edit');
            if(!item){return;}
            $ctrl.editInit(item, field);
        }

        function getEditPopupParams(item, field){
            return _.extend({
                positions: $ctrl.positions,
                departments: $ctrl.departments,
                callsheetId: $ctrl.callsheetId

            }, $ctrl.getNewPopupParams(item), null);
        }

        function preProcessGroupItem(item) {
            //console.log('preProcessGroupItem');
            var allContacts = $ctrl.afterProcessUpdatesG();

            var contact;
            if (item.castId) {
                contact = _.find(allContacts, {_id: item.castId});
            }
            if (!contact) {
                return null;
            }

            return contact ? _.extend({}, item, {
                name: contact.name,
                email: contact.email,
                phone: contact.phone,
                profilePictureURL: contact.profilePictureURL,
                profilePictureURLId: contact.profilePictureURLId,
            }) : item;
        }

        function getUpdatedChanges(result, Settings) {
            //console.log('getUpdatedChanges');
            return result ? result.editchanges : {};
        }
    }
}

