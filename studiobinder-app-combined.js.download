angular.module('product.elements.item.edit.component', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'item.edit.controller.service',
    'apiServices.TaggingElements'
])
.component('taggingelementItemPopup', popupComponentParams('TaggingelementItemPopupCtrl'))
.controller('TaggingelementItemPopupCtrl',TaggingelementItemPopupCtrl);
TaggingelementItemPopupCtrl.$inject = ['GeneralItemEditCtrlService', '$element'];
function TaggingelementItemPopupCtrl(GeneralItemEditCtrlService, $element) {

    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.withLabel = true;

    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl.postInitGeneral = postInitGeneral;
    $ctrl.preSetTemplateData = preSetTemplateData;
    $ctrl.getPopupLogo = getPopupLogo;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneral() {
        $ctrl.parent = $ctrl.extraParam.parent;
        $ctrl.withUncheck = true;
        $ctrl.onSaveGeneral = onSaveGeneral;
        $ctrl.addGeneral = addGeneral;
    }

    function getPopupLogo(icon) {
        return '<div class="centered circled-svg-colored colored small76 ' +
            ($ctrl.pageClass ? $ctrl.pageClass : '') +
            '"' +
            ($ctrl.parent._id === 'All' ? '' : (' style="background-color:' + $ctrl.LCS.hexToRgba($ctrl.parent.color, 0.1) +'"')) +
            '>'+$ctrl.LCS.getISBDiv($ctrl.icon, 4, null, 'style="color: ' + $ctrl.parent.color + '"') + '</div>';
    }

    function preSetTemplateData() {
        $ctrl.icon = $ctrl.parent.icon ? $ctrl.parent.icon : $ctrl.itemLogo;
        $ctrl.iconLevel = 6;
        $ctrl.withCloseBtn = true;
        $ctrl.with2FooterBtns = true;
        $ctrl.popupTitle = ($ctrl.isNew ? 'Add New ' : 'Rename') + ' Element';
        $ctrl.btnText = $ctrl.popupTitle;
        $ctrl.subtitle = 'in "' + $ctrl.itemTitle +'"';
    }

    function onSaveGeneral(result) {
        result.type = $ctrl.type;

        if (!$ctrl.isNew) {
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.objectType + '.' + ($ctrl.isNew ? 'Add' : 'Edit') + '.success', 'success', {
                category: $ctrl.itemTitle,
                name: $ctrl.item.name
            });
        }
    }

    function addGeneral() {
        $ctrl.item.name = $ctrl.parent.type === 1 ? $ctrl.item.name.toUpperCase() : $ctrl.CPS.capitalizeFirst($ctrl.item.name);
    }

    function postInitGeneral(){
        $ctrl.itemTitle = $ctrl.parent.name;
    }
}

