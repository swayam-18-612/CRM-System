angular.module('product.callsheet.recipients.group.controller.service',[
    'group.controller.service',
    'product.callsheet.recipients.group.extended.controller.service',
    'apiPagination.CallsheetInvitations'
])
.service('CallsheetRecipientsGroupInitCtrl',CallsheetRecipientsGroupInitCtrl);
CallsheetRecipientsGroupInitCtrl.$inject = ['CallsheetRecipientsGroupExtendedCtrl', 'TreeGroupInitCtrlService', 'CallsheetInvitationsPagination'];
function CallsheetRecipientsGroupInitCtrl(CallsheetRecipientsGroupExtendedCtrl, TreeGroupInitCtrlService, Pagination) {
    return function ($ctrl, $element) {
        $ctrl.withoutGroupEdit = true;
        $ctrl.orderChangedListId = 'contactListId';

        $ctrl.editCalltime = editCalltime;
        $ctrl.editPrivateMessage = editPrivateMessage;

        $ctrl.sendCallsheet = sendCallsheet;

        $ctrl.getGroupEmptyButtons = getGroupEmptyButtons;

        $ctrl.getMorePopoverTemplateOther = getMorePopoverTemplateOther;
        $ctrl.$onInit = $onInit;

        $ctrl.onClipboardProcessingSuccessOther = onClipboardProcessingSuccessOther;

        return $ctrl;

        function $onInit() {
            $ctrl = new CallsheetRecipientsGroupExtendedCtrl($ctrl);
            $ctrl = new TreeGroupInitCtrlService($ctrl, $element, Pagination, false);

            if ($ctrl.canEdit) {
                $ctrl.editElemCalltime = editElemCalltime;
            }

            if($ctrl.onInitOther) {
                $ctrl.onInitOther();
            }
        }

        function onClipboardProcessingSuccessOther(){
            console.log('onClipboardProcessingSuccessOther');
            //clears the grid of recipients on delete
            var currentListId = $ctrl.currentListId || 'All';
            $ctrl.LCS.timeout(function () {
                $ctrl.broadcastRoot('TREE_SERVICE_RELOAD_LIST_' + $ctrl.elemType, currentListId);
            }, 300);
        }

        function sendCallsheet(ids, e){
            console.log('CallsheetRecipientsGroupInitCtrl.sendCallsheet');
            $ctrl.CPS.loadQuotaPopup('callsheetBuilder', process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e: e});

            function process() {
                $ctrl.sendCallsheetRecipients({ids: ids});//from callsheet/init.controller.service
            }
        }

        function getGroupEmptyButtons() {
            return '<button class="btn btn-primary ' + $ctrl.getBtnActionCls()+ ' ' + ($ctrl.pageClass ? $ctrl.pageClass : '') + '" data-type="addCallsheetRecipients" analytics-on analytics-action="Open Add ' + $ctrl.itemTitle + 's to Call sheet">' +
                $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left') +
                ' Add Recipients</button>'
        }

        function editElemCalltime(item, param, e) {
            console.log('editElemCalltime');
            openEditInfo([{id: item._id}], 'both', e);
        }

        function editCalltime(ids ,e ) {
            openEditInfo(ids, 'calltime', e);
        }

        function editPrivateMessage(ids, e) {
            $ctrl.CPS.loadQuotaPopup('callsheetPrivateNotes', process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});

            function process() {
                openEditInfo(ids, 'personalNote', e);
            }
        }

        function openEditInfo(ids, editType) {
            console.log('addToList');
            var extraParam = {
                callsheetId : $ctrl.callsheetId,
                editType: editType,
                preLoadingService: $ctrl.preLoadingService,
                inviteIds: ids
            };//to do -> get the items
            if(!ids || ids.length === 0){
                console.warn('Please select at least one recipient');
                return;
            }
            var item = ids.length === 1 ? $ctrl.list.getElementById(ids[0].id) : null;
            $ctrl.popupsService.open(item, $ctrl.popupsService.operations.customizeCallsheetRecipients, extraParam,
                $ctrl.compOptions, null, function () {
                    if($ctrl.clearArrays){$ctrl.clearArrays();}
                });
        }

        function getMorePopoverTemplateOther(item, isMobile) {
            return ($ctrl.getMorePopoverTemplateOther2 ? $ctrl.getMorePopoverTemplateOther2(item, isMobile) :'') +
            ($ctrl.isMobileView() ? '' : (
                /*$ctrl.getSideMenuLi({
                    type: 'editElemCalltime',
                    action: 'Edit Calltime',
                    icon: 'clock'
                }) +*/
                $ctrl.getSideMenuLi({
                type: 'edit',
                action: 'Edit Contact',
                icon: 'user'
            })));
        }
    }
}

