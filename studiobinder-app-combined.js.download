}

angular.module('product.calendar.item.withtemplate.controller.service', [
    'ctrl.PopupsCtrl.generalItemEdit.service'
])
.service('CalendarItemWithTemplateCtrlService', CalendarItemWithTemplateCtrlService);
CalendarItemWithTemplateCtrlService.$inject = ['GeneralItemEditCtrlService'];
function CalendarItemWithTemplateCtrlService(GeneralItemEditCtrlService) {
    return function($ctrl, $element, isPopup) {

        $ctrl.disabledText = '$ctrl.isUpdating===true||$ctrl.isBtnDisabled()';

        $ctrl.getItemPopupTemplate = getItemPopupTemplate;
        $ctrl.preloadTemplates = preloadTemplates;

        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function preloadTemplates(){
            //create new with template
            if ($ctrl.isNew && !$ctrl.isDuplicate) {
                loadTemplates();
            }else{
                $ctrl.isLoaded = true;
                $ctrl.reloadTemplate();
            }
        }

        function loadTemplates() {
            $ctrl.removeTemplate = removeTemplate;
            $ctrl.setTemplate = setTemplate;
            $ctrl.isTemplate = isTemplate;

            if ($ctrl.templatesService) {
                $ctrl.templatesService.getAll($ctrl.getTemplatesCond(), null, null, setLoaded, onError);
            } else {
                setLoaded();
            }

            function setLoaded(templates) {
                $ctrl.templates = templates || null;
                if (templates) {
                    var predef = _.find(templates, {isPredefined: true});
                    $ctrl.item.template = predef ? predef : templates[0];
                }
                $ctrl.isLoaded = true;
                $ctrl.reloadTemplate();

                function getFirst(isPredefined) {
                    var predef = _.find(templates, {isPredefined: isPredefined});
                    return predef ? predef : templates[0];
                }
            }

            function onError(err) {
                console.log(err);
                setLoaded();
            }

            function removeTemplate(id, e) {
                var target = e.target;
                var item = getItem(id);
                if (!item) {
                    return;
                }
                $ctrl.error = null;

                var withconfirm = true;
                if (withconfirm) {
                    $ctrl.popupsService.open(null, $ctrl.popupsService.operations.treeKeyboardActions, {
                        btn: 'Apply',
                        icon: 'trash',
                        title: 'Are you sure?',
                        message: 'Are you sure you want to remove this template?',
                        itemTitle: 'template',
                        onConfirm: onConfirm
                    }, $ctrl.compOptions);
                } else {
                    onConfirm();
                }

                function onConfirm() {
                    $ctrl.templatesService.delete(item, function (el) {
                        if (el.item) {
                            el = el.item;
                        }
                        for (var i = $ctrl.templates.length - 1; i >= 0; i--) {
                            if ($ctrl.templates[i]._id === el._id) {
                                $ctrl.templates.splice(i, 1);
                            }
                        }
                        oncomplete('success');
                        $ctrl.LCS.removeElement($ctrl.LCS.findClosestParent(target, 'li'));

                    }, function (err) {
                        oncomplete('error');
                    });
                }

                function oncomplete(type) {
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.templateObject + '.Remove.' + type, type, {name: item.name});
                }
            }

            function setTemplate(id, e) {
                setActive($ctrl.item.template, false);
                var t = getItem(id);
                setActive(t, true);
                $ctrl.item.template = t;
            }

            function isTemplate(item) {
                return getCurrentTemplateId() === item._id;
            }

            function setActive(item, isActive) {
                if(item) {
                    $ctrl.LCS[isActive ? 'addClass' : 'removeClass']($ctrl.element.querySelector('.modal-templates li[data-info="' + item._id + '"]'), 'active');
                }
            }

            function getCurrentTemplateId(){
                return $ctrl.item.template ? $ctrl.item.template._id : null;
            }

            function getItem(id){
                return id ? _.find($ctrl.templates, {_id: id}) : null;
            }
        }

        function getItemPopupTemplate() {
            if (!$ctrl.isLoaded) {
                return '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
            }

            var l = [{
                btn: getFirstStepBtn(),
                body: typeof($ctrl.getFirstBody) === 'function' ? $ctrl.getFirstBody() : getFirstBody(),
                headerInfo:{
                    icon: $ctrl.icon,
                    iconLevel: $ctrl.iconLevel,
                    title: 'Name Your ' + $ctrl.itemTitle
                }
            }];

            if (hasTemplates()) {
                l.push({
                    btn: getSecStepBtn(),
                    body: getSecBody(),
                    headerInfo: {
                        icon: $ctrl.icon,
                        iconLevel: $ctrl.iconLevel,
                        title: 'Select a Template'
                    }
                });
            }

            l.push({
                fCond: hasOptions(),
                btn: getThirdStepBtn(),
                body: getThirdBody(),
                headerInfo:{
                    icon: $ctrl.isDuplicate ? 'copy' : $ctrl.itemIcon,
                    iconLevel: $ctrl.isDuplicate ? 2 : $ctrl.iconLevel,
                    title: ($ctrl.isDuplicate ? 'Duplicate' : 'Template') + ' Options'
                }
            });

            return $ctrl.getItemPopupMSForm(l, null, false);


            function getFirstStepBtn() {
                return (hasTemplates() || hasOptions())?
                    ('<button class="max-width300 btn btn-primary nextbtn page-class ' + ($ctrl.pageClass || '') + '" ng-disabled="' + $ctrl.disabledText + '" ng-class="{\'disabled\':' + $ctrl.disabledText + '}" type="button" sibling="1">Next</button>') :
                    ('<button class="'+$ctrl.getBtnActionCls()+' max-width300 btn btn-primary ' + ($ctrl.pageClass || '') + '" type="submit" ng-disabled="' + $ctrl.disabledText + '" ng-class="{\'disabled\':' + $ctrl.disabledText + '}" data-type="'+$ctrl.saveBtn+'" analytics-on analytics-action="Save ' + $ctrl.itemTitle + '"> <span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> <span>Save</span><span class="hide-ipad"> ' + $ctrl.itemTitle + '</span></button>');
            }

            function getFirstBody() {
                return null;//getFirstBodyProgress();
            }

            function getFirstBodyProgress() {
                return '<ul class="progressdots hide-ipad ' + $ctrl.pageClass + '">' +
                    '<li><button class="with-primary-bg-before active"></button></li>' +
                    '<li><button class="nextbtn" ng-disabled="!$ctrl.isBtnDisabled()"></button></li>' +
                    '<li ng-show="$ctrl.isDuplicate || !$ctrl.isDuplicate && $ctrl.item.template.hasTasks"><button></button></li>' +
                    '</ul>';
            }

            function getSecStepBtn() {
                return '<button ng-show="$ctrl.item.template.hasTasks" ng-disabled="' + $ctrl.disabledText + '" ng-class="{\'disabled\':' + $ctrl.disabledText + '}" class="max-width300 btn btn-primary nextbtn page-class ' + ($ctrl.pageClass || '') + '" type="button">Next</button>' +
                    '<button ng-show="!$ctrl.item.template.hasTasks" ng-disabled="' + $ctrl.disabledText + '" ng-class="{\'disabled\':' + $ctrl.disabledText + '}" class="'+$ctrl.getBtnActionCls()+' max-width300 btn btn-primary ' + ($ctrl.pageClass || '') + '" type="submit" data-type="'+$ctrl.saveBtn+'" analytics-on analytics-action="Create ' + $ctrl.itemTitle + '"> <span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> <span>Create</span><span class="hide-ipad"> ' + $ctrl.itemTitle + '</span></button>';
            }

            function getSecBody() {
                return '<div class="modal-templates clearfix">' + getTemplates() + '</div>' +
                    '<ul class="progressdots hide-ipad ' + $ctrl.pageClass + '">' +
                    '<li><button class="previousbtn"></button></li>' +
                    '<li><button class="with-primary-bg-before active"></button></li>' +
                    '<li ng-show="$ctrl.isDuplicate || !$ctrl.isDuplicate && $ctrl.item.template.hasTasks"><button class="nextbtn"></button></li>' +
                    '</ul>';
            }

            function getThirdStepBtn() {
                return '<button data-type="'+$ctrl.saveBtn+'" ng-disabled="' + $ctrl.disabledText + '" ng-class="{\'disabled\':' + $ctrl.disabledText + '}" class="'+$ctrl.getBtnActionCls()+' btn btn-primary max-width300 ' + ($ctrl.pageClass || '') + '" type="submit" analytics-on analytics-action="' + ($ctrl.isDuplicate ? 'Duplicate' : 'Create') + ' ' + $ctrl.itemTitle + '"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> <span>' + ($ctrl.isDuplicate ? 'Duplicate' : 'Create') + '</span>' + '<span class="hide-ipad"> ' + $ctrl.itemTitle + '</span></button>';
            }

            function getThirdBody() {
                var ev = '';
                _.each($ctrl.tasksEvents, function (t){
                    ev += getCheck(t[0], t[1], t[2]);
                });
                return (ev ? ('<div class="form-wrapper clearfix margin-bottom-half">' +
                        getCheck('loadEvents', 'Include events', null) +
                        '<div ng-if="$ctrl.temp.loadEvents">' + ev + '</div>' +
                        '</div>') : '') +
                    '<ul class="progressdots '+$ctrl.pageClass+'">' +
                    '<li><button></button></li>' +
                    ($ctrl.isNew && !$ctrl.isDuplicate ? '<li><button class="previousbtn"></button></li>' : '')+
                    '<li><button class="with-primary-bg-before active"></button></li>' +
                    '</ul>';

                function getCheck(field, name,  cond){
                    return '<div class="field border-bottom" ' +(cond? ('ng-if="'+cond+'"'):'')+'>' +
                        '<div class="pull-left">'+name+'</div>' +
                        '<div class="custom-checkbox pull-right '+ $ctrl.pageClass +'">' +
                        '<label class="i-switch">' +
                        '<input type="checkbox" ng-checked="$ctrl.temp.'+field+'" ng-click="$ctrl.temp.'+field+'=!$ctrl.temp.'+field+'" ><i></i></label>' +
                        '</div>' +
                        '</div>';
                }
            }

            function hasTemplates(){
                return $ctrl.isNew && !$ctrl.isDuplicate && $ctrl.templates && $ctrl.templates.length > 0;
            }

            function hasOptions() {
                return $ctrl.item.template && $ctrl.item.template.hasTasks;
            }

            function getTemplates() {
                if(!$ctrl.templates){return '';}
                var els = '', elsP = '';
                _.each($ctrl.templates, function (t, i){
                    var isPredef = t.isPredefined,
                        c = t.color ? t.color : '#4FD1A2',
                        el = '<li class="'+$ctrl.getBtnActionCls()+ ($ctrl.isTemplate(t) ? ' active' : '') + '" data-type="setTemplate" data-info="' + t._id + '">' +
                            '<div class="box centering" style="color:' + c+';background-color:'+ c+'">' +
                            $ctrl.LCS.getISBDiv(isPredef ? t.icon.replace('-filled','') : 'calendar-template', 2) +
                            '</div>' +
                            '<div class="info text-center">'+
                            '<span class=""' + (t.name.length>15 ? ('tooltip="'+t.name+'" tooltip-placement="bottom"') : '') +'>'+ t.name + '</span>'+
                            '</div>' +
                            (isPredef ? '' : ('<div class="'+$ctrl.getBtnActionCls()+' remove" data-type="removeTemplate" data-info="' + t._id + '">' +
                                    $ctrl.LCS.getISBDiv('wrong', 2, 'gray')+ '</div>')
                            ) +
                            '</li>';
                    if(isPredef){
                        elsP += el;
                    }else{
                        els += el;
                    }
                });
                return '<div class="calendartemplates form-wrapper long" style="width:fit-content"><ul class="calendar-type centering">' +
                    elsP +
                    els +
                    '</ul></div>';
            }
        }
    }
}

angular.module('product.calendar.item.edit.component', [
    'apiServices.CalendarTemplates',
    'product.calendar.item.edit.controller.service'
])
.component('calendarEditPopup', popupComponentParams( 'CalendarEditPopupCtrl'))
.controller('CalendarEditPopupCtrl', CalendarEditPopupCtrl);
CalendarEditPopupCtrl.$inject = ['CalendarItemEditCtrlService', 'CalendarTemplatesService', '$element'];
function CalendarEditPopupCtrl(CalendarItemEditCtrlService, CalendarTemplatesService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.otherListField = 'calendarId';

    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl.getTemplatesCond = getTemplatesCond;
    $ctrl.getDuplicateParams = getDuplicateParams;

    $ctrl = new CalendarItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneral() {
        $ctrl.templatesService = CalendarTemplatesService;

        $ctrl.tasksEvents = [
            ['loadTasks', 'Include tasks', null],
            ['loadTeam', 'Include teammates', null],
            ['loadFiles', 'Include uploaded files', null],
            ['loadComments', 'Include comments', null],
            ['loadProgress', 'Include task progress', '$ctrl.temp.loadTasks']
        ];

        $ctrl.templateObject = 'calendarTemplate';
        $ctrl.itemTitle = 'Calendar';
        $ctrl.templateIdField = 'calendarTemplateId';
        $ctrl.temp = {
            loadEvents: true,
            loadTasks: true,
            loadTeam: true,

            loadFiles: $ctrl.isDuplicate,
            loadComments: $ctrl.isDuplicate,
            loadProgress: $ctrl.isDuplicate
        };

        setColumns();

        function setColumns() {
            var dateProp = 'from';
            $ctrl.setDefaultColumns(!$ctrl.isDuplicate);
            if ($ctrl.isDuplicate) {
                $ctrl.columnsList.push($ctrl.getColumnDate(dateProp, 'Start', false, {isLastRow: true}));
            }
        }
    }

    function getTemplatesCond(){
        return {
            $or: [
                {$and: [{isPredefined: true}, {companyId: null}]},
                {$and: [{isPredefined: false}, {companyId: $ctrl.CPS.companyId}]}
            ]
        };
    }

    function getDuplicateParams(item){
        var p = {};
        p[$ctrl.otherListField] = item._id;
        return p;
    }
}

angular.module('product.calendar.item.edit.controller.service', [
    'product.calendar.item.withtemplate.controller.service'
])
.service('CalendarItemEditCtrlService', CalendarItemEditCtrlService);
CalendarItemEditCtrlService.$inject = ['CalendarItemWithTemplateCtrlService'];
function CalendarItemEditCtrlService(CalendarItemWithTemplateCtrlService) {
    return function ($ctrl, $element, isPopup) {
        $ctrl.postInitGeneral = postInitGeneral;
        $ctrl.preSetTemplateData = preSetTemplateData;
        $ctrl.duplicate = duplicate;

        $ctrl.saveBtn = 'saveItem';

        $ctrl = new CalendarItemWithTemplateCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function preSetTemplateData() {
            $ctrl.modalBodyFormClass = 'long';
        }

        function onError(error) {
            if (error && error.name === 'ValidationError') {
                $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.' + $ctrl.objectType + '.Duplicate.name.error');

            }
        }

        function onSave(result) {
            console.log('onitem save');
            $ctrl.onListItemSave(result, null, false);
        }

        function postInitGeneral() {
            $ctrl.onError = onError;
            $ctrl.onSave = onSave;
            $ctrl.saveItem = saveItem;

            if ($ctrl.isDuplicate) {
                $ctrl.icon = 'copy';
                $ctrl.iconLevel = 2;
            }

            //create new with template
            $ctrl.preloadTemplates();

            if (typeof ($ctrl.postInitGeneralOther) === 'function') {
                $ctrl.postInitGeneralOther();
            }
        }

        function saveItem(data, e) {
            if ($ctrl.isDuplicate) {
                if ($ctrl.extraParam[$ctrl.otherListField]) {
                    $ctrl.item[$ctrl.otherListField] = $ctrl.extraParam[$ctrl.otherListField];
                }
                getParams();
            } else { // new calendar
                var template = $ctrl.item.template;
                if (template) {
                    if (template.hasTasks) {
                        getParams();
                    }
                    $ctrl.item[$ctrl.templateIdField] = template._id;
                }
            }

            $ctrl.save();

            function getParams() {
                if ($ctrl.temp && $ctrl.temp.loadEvents) {
                    $ctrl.item.loadEvents = $ctrl.temp.loadEvents;
                    if ($ctrl.temp.loadTasks) {
                        $ctrl.item.loadTasks = $ctrl.temp.loadTasks;
                        if ($ctrl.temp.loadProgress) {
                            $ctrl.item.loadProgress = $ctrl.temp.loadProgress;
                        }
                    }
                    if ($ctrl.temp.loadTeam) {
                        $ctrl.item.loadTeam = $ctrl.temp.loadTeam;
                    }
                    if ($ctrl.temp.loadComments) {
                        $ctrl.item.loadComments = $ctrl.temp.loadComments;
                    }
                    if ($ctrl.temp.loadFiles) {
                        $ctrl.item.loadFiles = $ctrl.temp.loadFiles;
                    }
                }
            }
        }

        function duplicate(item, e) {
            $ctrl.preventDefault(e);

            var name = $ctrl.originalName,
                p = {
                    productId: item.productId,
                    companyId: $ctrl.CPS.companyId,
                };

            $ctrl.service.duplicate(_.extend(p, $ctrl.getDuplicateParams(item)), function (result) {
                if (result) {
                    var el = result.item;
                    if ($ctrl.list && $ctrl.list.items) {
                        $ctrl.list.addElement(el);
                        $ctrl.makeCurrent(el, true);
                        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.objectType + '.Duplicate.success', 'success', {name: name});
                    }
                } else $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.objectType + '.Duplicate.error', 'error', {name: name});
            }, function (err) {
                $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.' + $ctrl.objectType + '.Duplicate.error', 'error', {name: name});
            });
        }
    }
}

angular.module('user.calendar.item.move.component', [
    'ctrl.PopupsCtrl.generalItemEdit.service'
])
.component('calendarMovePopup', popupComponentParams('CalendarItemMoveController'))
.controller('CalendarItemMoveController', CalendarItemMoveController);
CalendarItemMoveController.$inject = ['GeneralItemEditCtrlService', '$element'];
function CalendarItemMoveController(GeneralItemEditCtrlService, $element) {
    var dateProp = 'startDate';

    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl.postInitGeneral = postInitGeneral;
    $ctrl.preSetTemplateData = preSetTemplateData;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneral() {
        $ctrl.itemChangedFields = [dateProp];
        $ctrl.isFolder = $ctrl.item.isFolder;
    }

    function postInitGeneral(){
        $ctrl.save = save;
    }

    function save(e) {
        $ctrl.preventDefault(e);
        var p = {
            _id: $ctrl.item._id,
            isProduct: $ctrl.extraParam.type === 'product',
            calendarId: $ctrl.item.calendarId,
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.item.productId
        };

        p[dateProp] = $ctrl.item[dateProp];

        $ctrl.service.move(p, function (result) {
            $ctrl.broadcastRoot('MOVE_CALENDARMILESTONE_ITEM', result);
            $ctrl.closePopup(result);
        }, function (err) {
            if (!err) {
                $ctrl.closePopup();
            }
        });
    }

    function preSetTemplateData() {
        $ctrl.icon = 'transition';
        $ctrl.iconLevel = 4;
        $ctrl.popupTitle = 'Change Start Date of ' + ($ctrl.isFolder ? 'Group' : 'Row');
        $ctrl.subdesc = $ctrl.isFolder ? 'Shift this group and its events to start on another date' : 'Shift all events in this row to start on a different date';
        $ctrl.firstBtnCls = 'prod-calendar col294';
        $ctrl.btnText = '<span>Change</span><span class="hide-ipad"> Start Date</span>';
        $ctrl.textAnalytics = $ctrl.popupTitle;
        $ctrl.columnsList = [$ctrl.getColumnDate(dateProp, 'Start', false, {isLastRow: true})];
    }
}

