angular.module('product.print.options.controller.service', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'expandableSection.controller.service'
])
.service('PrintOptionsCtrlService', PrintOptionsCtrlService);
PrintOptionsCtrlService.$inject = ['GeneralItemEditCtrlService', 'ExpandableSectionService'];
function PrintOptionsCtrlService(GeneralItemEditCtrlService, ExpandableSectionService) {
    return function ($ctrl, $element) {

        $ctrl.ExpandableSectionService = ExpandableSectionService;

        var colCls= 'col220';
       
        $ctrl.isPopup = true;

        $ctrl.dontAutoloadTemplate = false;

        $ctrl.preInitGeneral = preInitGeneral;
        $ctrl.preSetTemplateData = preSetTemplateData;
        $ctrl.getLayoutWrapper = getLayoutWrapper;
        $ctrl.getStyleWrapper = getStyleWrapper;
        $ctrl.getPageMarginsWrapper = getPageMarginsWrapper;
        $ctrl.getSecurityWrapper = getSecurityWrapper;
        $ctrl.getCoverSection = getCoverSection;
        $ctrl.getViewType = getViewType;
        $ctrl.bindOther = bindOther;

        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

        return $ctrl;

        function preSetTemplateData() {
            if(typeof ($ctrl.preSetTemplateDataOther) === 'function') {
                $ctrl.preSetTemplateDataOther();
            }
        }

        function preInitGeneral() { 
            
            $ctrl.expandableSections = new $ctrl.ExpandableSectionService($element, {
                compOptions: $ctrl.compOptions
            });
            $ctrl.eClassAttr = 'form-control without-underline editable-content'
            //+ ($ctrl.pageClass || '')
            ;

            setColumns();

            $ctrl.itemCopy = _.clone($ctrl.item);
            if ($ctrl.preInitGeneralOther) {
                $ctrl.preInitGeneralOther();
            }

            $ctrl.addRootWatcher('UPDATE_PRO_LABELS', onUpdateProLabels);
        }

        function onUpdateProLabels(){
            console.log('updateProLabels');
            $ctrl.expandableSections.updateQuotaInfo(['pdfBuilder', 'advancedPdfBuilder'], function (){
                var field = 'watermark';
                $ctrl.item[field] = $ctrl.CPS.hasQuotaType('pdfBuilder') ? '' : 'StudioBinder Trial';
                //$ctrl.onSidebarChanges({field: field, item: _.extend({}, $ctrl.item)});
            });
        }

        function setColumns() {
            var bgcls = 'grayc';
            if(!$ctrl.item) {
                $ctrl.item = {};
            }

            if(!$ctrl.Settings){
                $ctrl.Settings = {};
            }

            if (!$ctrl.columnsList) {
                $ctrl.columnsList = [];
            }
            var formGroupClass = 'form-group field thinner last centered ' + colCls;

            $ctrl.drpL = -1;

            addDrp('Orientation', 'Orientation', [
                {id: 'portrait', text: 'Portrait'},
                {id: 'landscape', text: 'Landscape'}
            ], 'orientation');

            addDrp('Paper Size', 'FormatTypes', PrintingFormat, 'format');

            if($ctrl.item.showViewModes) {
                addDrp('View Mode', 'ViewModes', [
                    {id: 2, text: 'List View', icon: 'storyboard-list'},
                    {id: 3, text: 'Grid View', icon: 'storyboard-grid'}
                ], 'view', null, !$ctrl.item.showViewModes);
            }

            var isGridView = checkGridView($ctrl.item.view);
            var rowCls = 'whenGridView' +  (isGridView  ? '' : ' sb-hide') ;
            addDrp('Columns', 'ColumnsPerPage', getNumberDrp(1, 8), 'column', null, false, rowCls);
          //  addDrp('Rows', 'RowsPerPage', getNumberDrp(0, 8), 'rowsPerPage', null, false, rowCls);
            addDrp('Spacing', 'GridGap', getDrpFromNumberArray([5, 10, 15, 20, 25, 30]), 'gridGap', null,false, rowCls);


            //show/hide page number
            addDrp('Page Number', 'WithPageNumbers', [
                {id: true, text: 'Show Page Numbers'},
                {id: false, text: 'Hide Page Numbers'}
            ], 'withPageNumbers');

            $ctrl.drpLayout = $ctrl.drpL + 1;

            addDrp('Print Color', 'ColorsType', [
                {id: true, text: 'Color'},
                {id: false, text: 'Black and White'}
            ], 'isColor');

            addDrp('Font Size', 'FontSizes', getFontSizes(), 'fontSize', null, $ctrl.item.hideFontSizes);

            addDrp('Borders', 'ItemsBorder', [
                {id: false, text: 'Without Borders'},
                {id: true, text: 'With Borders'},
            ], 'itemsBorder', null, !$ctrl.item.showBorders);

            //addField('Scale', 'scale', true);

            addDrp('Icons', 'WithIcons', [
                {id: true, text: 'Show Icons'},
                {id: false, text: 'Hide Icons'}
            ], 'withIcons', null, !$ctrl.item.showIcons);

            addDrp('Page Breaks', 'WithPageBreakAfterList', [
                {id: true, text: 'Add Page Break After List'},
                {id: false, text: 'Don\'t Add Page Break After List'}
            ], 'withPageBreakAfterList', null, !$ctrl.item.showPageBreakAfterList);

            addColor('Text Color', 'ColorsFonts',  'fontColor', null, !$ctrl.item.showFontColor);
            addColor('Background Color',  'ColorsBg','bgColor', null, !$ctrl.item.showBgColor);
            addColor('Border Color',  'ColorsBorders','borderColor', null, !$ctrl.item.showBorderColor);
            addColor('Background Card Color',  'ColorsCardBg','bgCardColor', null, !$ctrl.item.showBgCardColor);

            $ctrl.drpStyle = $ctrl.drpL + 1;
            addNumber('Margin Top', 'marginTop', false);
            addNumber('Margin Bottom', 'marginBottom', false);
            addNumber('Margin Left', 'marginLeft', false);
            addNumber('Margin Right', 'marginRight', false);

            $ctrl.drpMargins = $ctrl.drpL + 1;
            _.each(['Front Cover', 'Back Cover'], function (prop1) {
                var prop = prop1.replace(/ /g, '');
                addDrp(prop1, 'Has' + prop, [
                    {id: true, text: 'Show ' + prop1},
                    {id: false, text: 'Hide ' + prop1}
                ], 'has' + prop, null);


                if($ctrl['docWatcher'+prop]){
                    $ctrl.removeWatcher($ctrl['docWatcher'+prop]);
                }
                $ctrl['docWatcher' + prop] = $ctrl.addRootWatcher('SAVE_DOC_CHANGES_'+prop + '_POPUP', onSave);

                function onSave(item) {
                    console.log('SAVE_DOC_CHANGES_'+prop + '_POPUP');
                    if(!item){return;}
                    //remove default values
                    _.each(['fontColor', 'bgColor'], function (p) {
                        if(item[p].toLowerCase() === $ctrl.item[p].toLowerCase()){
                            delete item[p];
                        }
                    });
                    if(item.content === undefined){
                        return;
                    }
                    updatePage(item._id, item);
                }
            });

            $ctrl.secCount = 0;
            addField('Watermark', 'watermark', false, 40);
            $ctrl.secCount++;

            //addField('Password', 'password', false);
            //$ctrl.secCount ++;

            //addField('Filename', 'filename', true);
           // $ctrl.secCount++;

            addDrp('Show Header', 'ShowHeaders', [
                {id: true, text: 'Show Header'},
                {id: false, text: 'Hide Header'}
            ], 'withHeader', null);
            $ctrl.secCount++;

            addTextArea('Title', 'title', false);
            $ctrl.secCount++;

            addTextArea('Left Header', 'leftHeader', false);
            $ctrl.secCount++;

            addTextArea('Right Header', 'rightHeader', false);
            $ctrl.secCount++;

            addTextArea('Footer', 'footer', false);
            $ctrl.secCount++;

            //show/hide icons
            addDrp('Column Header', 'HeadersOnTopOfPage', [
                    {id: false, text: 'On First Page Only'},
                    {id: true, text: 'On All Pages'}
                ], 'groupHeadersOnTopOfPage', null, !$ctrl.item.showGroupHeadersOnTopOfPage);

            $ctrl.secCount++;

            /*  addDrp('Page Margins', 'PageMargins', [
                  {id: 2, text: 'Default'},
                  {id: 0, text: 'None'},
                  {id: 1, text: 'Half'}
              ], 'pageMargins');

              addDrp('Column Margins', 'ColumnMargins', [
                  {id: 1, text: 'Normal'},
                  {id: 0, text: 'Compact'}
              ], 'columnMargins');*/

            function getNumberDrp(from, to){
                var l = [];
                for(var i = from; i<=to;i++){
                    l.push({id: i, text: i===0?'Auto':i});
                }
                return l;
            }
            function getDrpFromNumberArray(list){
                var l = [];
                _.each(list, function (i){
                    l.push({id: i, text: i});
                });
                return l;
            }

            function getFontSizes() {
                return  PrintFontSizes;
                /*for (var i = 8; i <= 30; i += 4) {
                    l.push({id: i, text: i + 'px'});
                }*/
            }

            function addDrp(name, drp, drpVal, prop, col, dontshow, rowCls) {
                $ctrl[drp] = drpVal;
                $ctrl.Settings[drp] = drpVal;
                if (!$ctrl.item[prop]) {
                    $ctrl.item[prop] = $ctrl[drp][0].id;
                }
                $ctrl.columnsList.push(_.extend({
                    prop: prop,
                    name: name,
                    eClassAttr: $ctrl.eClassAttr,
                    cClassAttr: 'autoheight long-caret with-arrow ',
                    formGroupClass: formGroupClass,
                    fieldClass: 'editable-content ' + bgcls,
                    editableContainerClass: 'noninlineeditor',
                    type: $ctrl.SBFieldTypesService.PropTypes.Drp,
                    initListName: drp,
                    itemLabel: 'text',
                    itemValue: 'id',
                    parentContainer: '.print-sidebar .sidebarScrollingContainer',
                    drpMenuCls: colCls,
                    dontshow: dontshow,
                    rowCls: rowCls
                }, col));
                $ctrl.drpL++;
            }

            function addColor(name, drp, prop, col, dontshow ){
                if(!$ctrl[drp]) {
                    $ctrl[drp] = $ctrl.SBFieldMethods.Colors;
                }
                if(!$ctrl.Settings[drp]) {
                    $ctrl.Settings[drp] = $ctrl[drp];
                }

                $ctrl.columnsList.push(_.extend({
                    type: $ctrl.SBFieldTypesService.PropTypes.Color,
                    prop: prop,
                    name: name,
                    initListName: drp,
                    formGroupClass: 'col40 vbottom',
                    //square: true,
                    withoutLabelInPopup: true,
                    withUncheck: false,
                    icon: prop==='bgColor' ? 'background-color' : 'text-color',
                    header: 'Change ' + name,

                    drpMenuCls: colCls,
                    dontshow: dontshow,
                }, col));
                $ctrl.drpL++;
            }

            function addField(name, prop, isRequired, maxLength) {
                getField($ctrl.SBFieldTypesService.PropTypes.Field, name, prop, isRequired, maxLength);
            }

            function addNumber(name, prop, isRequired) {
                getField($ctrl.SBFieldTypesService.PropTypes.Number, name, prop, isRequired);
            }

            function getField(type, name, prop, isRequired, maxLength){
                $ctrl.columnsList.push(_.extend({
                    prop: prop,
                    name: name,
                    eClassAttr: $ctrl.eClassAttr,
                    fieldClass: bgcls,
                    formGroupClass: formGroupClass,
                    type: type,
                    placeholder: name + '…',
                    isRequired: isRequired,
                    withLabel: null,
                    forceCanEdit: true
                }, maxLength ? {isMaxLength: maxLength} : null));
                $ctrl.drpL++;
            }

            function addTextArea(name, prop){
                $ctrl.columnsList.push({
                    name: name,
                    prop: prop,

                    eClassAttr: $ctrl.eClassAttr,
                    fieldClass: bgcls,
                    formGroupClass: formGroupClass,

                    type: $ctrl.SBFieldTypesService.PropTypes.Html,
                    forceCanEdit: true,
                    placeholder: 'Custom ' + name.toLowerCase() + '…',

                    parentContainer: '.print-sidebar .sidebarScrollingContainer',
                    triggerEditOnCol: true,
                    editableContainerClass: 'noninlineeditor',
                    withBottomToolbar: true,
                    autofocus: true,
                    buttonsType: 1,
                    withoutClose: true,
                    editorType: 'bubblesimplenolink'
                });
                $ctrl.drpL++;
            }
        }

        function getCoverSection(name, skip){
            var n = name.replace(/ /g, ''),
                btn = 'btn' + n;
            if(!$ctrl.coverBtns){
                $ctrl.coverBtns = [];
            }

            if($ctrl.coverBtns.indexOf(btn) === -1) {
                $ctrl.coverBtns.push(btn);
            }

            var el = addRow($ctrl.drpMargins + skip, null) +
                '<a class="blue '+btn+ ($ctrl.item['has' + btn] ? '' : ' sb-hide')+'">Update ' + name + '</a>';
            return getWrapper(el, 'wrapper' + n);
        }

        function bindOther(isBind) {
            if ($ctrl.coverBtns) {
                _.each($ctrl.coverBtns, function (cls) {
                    $ctrl.bindElementClickBySelector(isBind, '.' + cls, function (e) {
                        console.log('coverBtns click ' + cls);
                        $ctrl.preventDefault(e);
                        var prop = cls.replace('btn', ''),
                            item = $ctrl.item[prop];
                        _.each(['fontColor', 'bgColor'], function (prop) {
                            if (!item[prop]) {
                                item[prop] = $ctrl.item[prop];
                            }
                        });
                        $ctrl.popupsService.open(item, $ctrl.popupsService.operations.coverPage, {
                            forceCanEdit: true,
                            createdBy: $ctrl.CPS.user,
                            //ColorsFonts: $ctrl.ColorsFonts,
                            //ColorsBg: $ctrl.ColorsBg,
                            title: $ctrl.title,

                            format: $ctrl.item.format,
                            orientation: $ctrl.item.orientation,
                            withScriptFormat: $ctrl.item.withScriptFormat
                        }, $ctrl.compOptions, null, function (result) {
                            //console.log('onsuccess');
                        });
                    });
                });
            }
            if ($ctrl.customGridSetting) {
                if ($ctrl.customGridSetting.ShowToggles && !$ctrl.ShowToggles) {
                    $ctrl.ShowToggles = $ctrl.customGridSetting.ShowToggles;
                }
                if ($ctrl.ShowToggles) {
                    for (var id in $ctrl.ShowToggles) {
                        $ctrl.bindElementClickBySelector(isBind, '.customGridSetting li[data-id="' + id + '"]', function (e) {
                            $ctrl.preventDefault(e);
                            var el = e.currentTarget,
                                id = el.getAttribute('data-id');
                            console.log('onShowToggles ' + id);

                            var val = !$ctrl.item[id];

                            $ctrl.LCS[val ? 'addClass' : 'removeClass'](el.querySelector('.text-left'), 'active thick');
                            var input = el.querySelector('input');
                            if (input) {
                                if (val) {
                                    input.setAttribute('checked', 'checked');
                                } else {
                                    input.removeAttribute('checked');
                                }
                            }
                            updatePage(id, val);
                        });
                    }
                }
            }
        }

        function updatePage(field, val){
            $ctrl.item[field] = val;
            $ctrl.onSidebarChanges({
                result: {
                    field: field,
                    item: _.extend({}, $ctrl.item)
                }
            });
        }

        function getLayoutWrapper() {
            return getRows(0, $ctrl.drpLayout, 'layout');

            // el += getDrpZoomFilters();
            function getDrpZoomFilters() {
                return '<group-zoom-filters ' +
                        'class="group-zoom-filters margin-bottom-60 clearfix display-block" ' +
                        'filters-service="::$ctrl.listTreeService.filtersService" ' +
                        'elem-type="' + $ctrl.elemType + '" '+
                        'scale="::$ctrl.item.scale" ' +
                    //'scale="::$ctrl.item.scale" ' +
                        '></group-zoom-filters>';
            }
        }
        function getStyleWrapper() {
            return getRows($ctrl.drpLayout, $ctrl.drpStyle, 'style');
        }
        function getPageMarginsWrapper() {
            return getRows($ctrl.drpStyle, $ctrl.drpMargins, 'style');
        }
        function getSecurityWrapper() {
            return getRows($ctrl.columnsList.length - $ctrl.secCount, $ctrl.columnsList.length, 'security');
        }

        function getRows(from, to, wrapperName){
            var  el ='';
            for (var i = from; i < to; i++) {
                el += addRow(i, null);
            }
            return getWrapper(el, wrapperName);
        }

        function getWrapper(el, cls) {
            return '<div class="' + cls + ' form-wrapper font-general font-general-12">' + el + '</div>';
        }

        function getViewType() {
            return ''; //Orientation
            return $ctrl.withPrintPanels ? addRow(0, null) : ''; //Orientation
        }

        function addRow(index, cond, skip){
            var c = $ctrl.columnsList[index];

            if(c.prop === skip || c.dontshow){return '';}
            return '<div class="table-div field spacing-half-bottom position-relative full-width '+(c.rowCls||'')+'"' + (cond? (' ng-if="' + cond + '"') : '') + '>' +
                        '<div class="label-cell semibold grow-column centered vtop padding-top-6">' + c.name + ':</div>' +
                        $ctrl.getPopupFormForSelectedCol(c) +
                   '</div>';
        }

        function checkGridView(view){
            return view === 3;
        }
    }
}

angular.module('product.print.selectlists.popup.component', [
    'product.print.selectlists.popup.service'
])
.component('selectPrintListsPopup', popupComponentParams('SelectPrintListsPopupCtrl'))
.controller('SelectPrintListsPopupCtrl', SelectPrintListsPopupCtrl);

SelectPrintListsPopupCtrl.$inject = ['SelectPrintListsCtrlService', '$element'];
function SelectPrintListsPopupCtrl(SelectPrintListsCtrlService, $element) {
    console.log('SelectPrintListsPopupCtrl');

    var $ctrl = this;
    $ctrl.isPopup = true;
    $ctrl = new SelectPrintListsCtrlService($ctrl, $element, $ctrl.isPopup);
}

angular.module('product.print.selectlists.popup.service', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'expandableSection.controller.service',
    //'product.print.lists.service'
])
.service('SelectPrintListsCtrlService', SelectPrintListsCtrlService);
SelectPrintListsCtrlService.$inject =['GeneralItemEditCtrlService', 'ExpandableSectionService'
    //, 'SelectPrintListsService'
];
function SelectPrintListsCtrlService(GeneralItemEditCtrlService, ExpandableSectionService
     //, SelectPrintListsService
) {
    return function ($ctrl, $element, isPopup) {
        $ctrl.ExpandableSectionService = ExpandableSectionService;

        $ctrl.onGroupsSelect = onGroupsSelect;
        $ctrl.onItemsSelect = onItemsSelect;
        $ctrl.onNext = onNext;
        $ctrl.isBtnDisabled = isBtnDisabled;
        $ctrl.onSearch = onSearch;

        $ctrl.getItemPopupTemplate = getItemPopupTemplate;
        $ctrl.preInitGeneral = preInitGeneral;
        $ctrl.postInitGeneral = postInitGeneral;
        $ctrl.preSetTemplateData = preSetTemplateData;
        $ctrl.onLoaded = onLoaded;
        $ctrl.onDestroy = onDestroy;

        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function preInitGeneral() {
            $ctrl.withCheckInGroupHeader = true;
            $ctrl.onConfirm = $ctrl.extraParam.onConfirm;

            $ctrl.selectPrintListsService = $ctrl.extraParam.selectPrintListsService;
            /*? $ctrl.extraParam.selectPrintListsService : new SelectPrintListsService($ctrl.extraParam, {
                withActiveGroup: $ctrl.withActiveGroup,
                withActiveTree: $ctrl.withActiveTree,
                icon: $ctrl.icon,
                iconLevel: $ctrl.iconLevel,
            });
*/
            $ctrl.ckCls = $ctrl.selectPrintListsService.ckCls;
            $ctrl.radioCheckedCls = $ctrl.selectPrintListsService.radioCheckedCls;

            if($ctrl.preInitGeneralOther) {
                $ctrl.preInitGeneralOther();
            }
        }

        function postInitGeneral(){
            $ctrl.save = save;
        }

        function preSetTemplateData() {
            $ctrl.modalBodyFormClass = 'longest';
        }

        function getItemPopupTemplate() {
            return $ctrl.getItemPopupMSForm([
                get(1, $ctrl.element),
                get(2, $ctrl.element)
            ], 'with-small', false);

            function get(step, element) {
                var info = $ctrl.selectPrintListsService.listsInfo['step' + step];
                if (!info) {
                    return null;
                }
                var type = info.type,
                    stepcontent = getStep(step, element);

                $ctrl.popupTitle = getTitle();

                return {
                    btn: getStepBtn(),
                    icon: $ctrl.icon,
                    title: getTitle(),
                    body: '<div class="centering max-width-424 print-type-' + info.type +
                        (getWithExpandable(step, type) ? ' callsheet-sidebar bg-white right' : '') + '">' +
                        (info.withSelectAll && info.multipleSelection ?
                            ('<div class="select-all-top">' + getSelectAllGroups() + '</div>') : '') +
                        '<div id="step' + step + '">' + (step === 1 ? stepcontent : '') + '</div>' +
                        getProgress() +
                        '</div>'
                };

                function getItemTitle(){
                    return info.multipleSelection && $ctrl.nameForLists && step === 1 ? $ctrl.nameForLists :
                        (info.itemTitle + (info.multipleSelection || step === 2 ? 's' : ''));
                }

                function getTitle() {
                    return info.title ? info.title : ('Select ' + getItemTitle());
                }

                function getStepBtn() {
                    var txt = (type === 'group' ? 'Groups' : 'Items') + '_' + step,
                        disabledText = '$ctrl.isUpdating===true||$ctrl.isBtnDisabled(\'' + txt + '\')';

                    return step === 1 && $ctrl.selectPrintListsService.has2Steps ? ('<button class="max-width300 btn btn-primary nextbtn page-class ' + ($ctrl.pageClass || '') + '" ng-disabled="' + disabledText + '" ng-class="{\'disabled\':' + disabledText + '}" type="button" ng-click="$ctrl.onNext($event)" data-type="' + txt + '">Next</button>') :
                        getSecStepBtn();

                    function getSecStepBtn() {
                        var action, txtBtn1;
                        if (type === 'item') {
                            action = 'Generate';
                            txtBtn1 = ' Report';
                        } else {
                            action = 'Add';
                            txtBtn1 = ' Selected ' + getItemTitle();
                        }

                        return ('<button data-type="' + txt + '" class="max-width300 btn btn-primary submitbtn ' + ($ctrl.pageClass || '') + '" type="button" ng-click="$ctrl.save($event)" data-type="save" analytics-on analytics-action="' +
                            action + txtBtn1 +
                            '" ng-disabled="' + disabledText + '" ng-class="{\'disabled\':' + disabledText + '}"> <span class="sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> ' +
                            '<span>' + action + '</span><span class="hide-ipad"> ' +
                            ($ctrl.withRadioCheck ? '' : '<span class="btnSelectedCount"></span>') +
                            txtBtn1 + '</span></button>');
                    }
                }

                function getProgress() {
                    if (!$ctrl.selectPrintListsService.has2Steps) {
                        return '';
                    }

                    var a = 'with-primary-bg-before active';
            return '<ul class="progressdots margin-top-half hide-ipad ' + ($ctrl.pageClass||'') + '">' +
                        '<li><button class="' + (step === 1 ? a : 'previousbtn') + '"></button></li>' +
                        '<li><button class="' + (step === 1 ? 'nextbtn' : a) + '"></button></li>' +
                    '</ul>';
                }

                function getSelectAllGroups() {
                    var type = 'Groups';
                    return getCheck({checked: $ctrl.selectPrintListsService['all' + type + 'Selected']}, 'Select All', 'selectmark');
                }
            }
        }

        function updateBtnSelectedCount(element){
            if(!element){return;}
            _.each(element.querySelectorAll('.btnSelectedCount'), function (el){
                el.innerText = $ctrl.selectPrintListsService.getSelectedCount();
            });
            console.log('counter updated');
        }

        function getWithExpandable(step, type){
            return type === 'group' || type === 'group-item' || type === 'item' && step === 2;
        }

        function getStep(step, element) {
            var result = $ctrl.selectPrintListsService.getStepInfo(step, element);
            if(!result){
                return '';
            }

            var info = result.info;
            if(result.Groups){
                $ctrl.Groups = result.Groups;
            }
            if(result.Items){
                $ctrl.Items = result.Items;
            }

            if(element) {
                var content = '';
                switch (info.type) {
                    case 'group':
                        content = setExpandable(result.type);
                        break;

                    case 'item'://breakdowns
                        $ctrl.withCheckInGroupHeader = false;
                        content = getGroupsWithItems(step === 1, step !== 1);
                        break;

                    case 'group-item'://contacts/locations
                        content = getGroupsWithItems(true, true);
                        break;

                    case 'custom':
                        content = '';
                        break;
                }

                $ctrl.LCS.timeout(function (){
                    updateBtnSelectedCount(element);
                }, 0);
                return content;
            }

            return null;

            function getGroupsWithItems(isLoad, loadAll){
                return loadAll ? setExpandable(result.type) : getContent(result.type, info);
            }

            function setExpandable(type) {
                var withCheckForAll = !$ctrl.selectPrintListsService.isGroupWithItems,
                    withCheckForGroup = info.multipleSelection,
                    type1 = 'Groups',
                    expandable = 'expandable' + type1,
                    expandableOther = [add(type1)];

                if(withCheckForAll) {
                    expandableOther.push({
                        selector: '.' + $ctrl.ckCls + '.selectmark',
                        method: function (e) {
                            return selectAllGroups(element, e, type);
                        }
                    });
                }

                if($ctrl.selectPrintListsService.isGroupWithItems && withCheckForGroup && !$ctrl.withRadioCheck){
                    expandableOther.push(add(type));
                }

                var p = {
                    expandItemCls: type1,
                    startCollapsed: true,
                    allExpandable: type === 'Items',
                    getExpandableHeader: getExpandableHeader,
                    expandableOther: expandableOther
                };

                if($ctrl.withRadioCheck) {
                    p.notExpandableMethod = function (e){
                        console.log('notExpandableMethod');
                        selectGroupItem(e, type);
                    }
                }

                $ctrl[expandable] = new $ctrl.ExpandableSectionService($ctrl.$element, p);

                return $ctrl[expandable].getExpandableContent($ctrl[type], function (el, i) {
                    return ''+
                        (withCheckForGroup && !$ctrl.withCheckInGroupHeader
                            ? addCheck(el) : '') +
                        getContent(type, info, i, 'with-select-all'
                            //    , 'font-small'
                        );
                });

                function addCheck(el){
                    return '<div class="full-width centered check gridview position-relative margin-left-20 margin-top-60 padding-left-4" style="min-height: 18px">' +
                    getCheck(el, 'Select All', $ctrl.selectPrintListsService.getCheckSelector(type)) +
                    '</div>';
                }

                function add(type){
                   return {
                        withExpandCls: true,
                        selector: '.' + $ctrl.ckCls + '.' + $ctrl.selectPrintListsService.getCheckSelector(type),
                        method: function (e) {
                            selectGroupItem(e, type);
                        }
                    };
                }

                function selectGroupItem(e, type){
                    console.log('select' + type);
                    $ctrl.preventDefault(e);

                    findGroupByEvent(e, element, {type: type, toggle: true});
                }

                function getExpandableHeader(el) {
                    var check = withCheckForGroup && $ctrl.withCheckInGroupHeader ? getCheck(el, null, $ctrl.selectPrintListsService.getCheckSelector(type), $ctrl.withRadioCheck) : '';//scheduling -> one at a time
                    return '<div class="col30 centered">' + (check ? check : $ctrl.LCS.getISBDiv(el.icon, el.iconLevel, 'gray')) + '</div>' +
                        '<div class="centered grow">' + el.name + '</div>';
                }
            }

            function getContent(type, info, i, cls) {
                var el = '$ctrl.' + type + '[' + (i||0) + '].';
                info.withScroll = info.type === 'item';//!isItem; //onGroupsSelect //breakdowns
                return getSelector(info, el + 'value', el + 'list', 'on' + type + 'Select', cls);
            }

            function getSelector(info, value, list, method, cls) {
                var tag = 'sb-simple-selector';
                return '<'+tag+' ' +
                    'class="sb-simple-selector display-block clearfix multiple-locations-menu ' + (cls || '') + '" ' +

                    (info.elemtype ? ('elemtype="' + info.elemtype + '" ') : '') +
                    (info.withSquareImg ? ('with-square-img="' + info.withSquareImg + '" ') : '') +

                    (info.itemTitle ? ('item-title="' + info.itemTitle + '" ') : '') +
                    (info.emptyItemTitle ? ('empty-item-title="' + info.emptyItemTitle + '" ') : '') +
                    (info.tableType ? ('table-type="' + info.tableType + '" ') : '') +
                    (info.withEllipsis ? ('with-ellipsis="' + info.withEllipsis + '" ') : '') +
                    (info.withUppercase ? ('with-uppercase="' + info.withUppercase + '" ') : '') +
                    (info.multipleSelection ? ('multiple-selection="' + info.multipleSelection + '" ') : '') +
                    (info.withImage ? ('with-image="' + info.withImage + '" ') : '') +
                    'hide-icon-circle="true" ' +
                    ($ctrl.pageClass ? ('page-class="' + $ctrl.pageClass + '" ') : '') +
                    'icon="' + ((info.itemIcon ? info.itemIcon : $ctrl.icon)) + '" ' +
                    (info.iconLevel ? ('icon-level="::' + info.iconLevel + '" ') : '') +

                    (info.withScroll ? ('with-scroll="' + true + '" ') : '') +

                    'value="' + value + '" ' +
                    'list="::' + list + '" ' +
                    'on-select="$ctrl.' + method + '(result)" ' +
                    'on-search="$ctrl.onSearch(result)" ' +
                    '></'+tag+'>';
            }
        }

        function onSearch(result) {
            console.log('onSearch');
            var el, w = $ctrl.LCS.findClosestParent(result.el, '.expitemGroups');
            if (w) {
                el = w.querySelector('.check.gridview ' + $ctrl.ckCls);
            }
            if (el) {
                var isE = result.isEmpty || !result.search
                if (isE) {
                    $ctrl.LCS[result.search ? 'addClass' : 'removeClass'](el, 'sb-hide');
                }
                var input = el.querySelector('input');
                if (input) {
                    if (isE) {
                        input.removeAttribute('disabled');
                    } else {
                        input.setAttribute('disabled', 'disabled');
                    }
                }
            }
        }

        function getCheck(el, ctext, cls, isRadio){
            var cls1 = ($ctrl.ckCls||'') + ($ctrl.pageClass ? (' ' + $ctrl.pageClass) : '') + (cls ? (' ' + cls) : '') + ' ' + ' font-general font-general-12';
            return isRadio ? ('<div class="' + cls1 + ' select-row item md-radio-button' + (el.checked ? (' ' + $ctrl.radioCheckedCls + ' ') : '') + '"' +
                //' data-id="1"' +
                '><div class="md-container md-ink-ripple "><div class="md-off"></div><div class="md-on"></div><div class="md-ripple-container"></div></div>'+
           // '<div class="md-label name">'+ctext+'</div>' +
            '</div>') : ('<div class="' + cls1 + ' custom-checkbox inrow"><label><input type="checkbox" ' + (el.checked ? 'checked="checked"' : '') + '><span></span>' + (ctext ? ('<span class="ctext">' + ctext + '</span>') : '') + '</label></div>');
        }

        function onLoaded() {
            console.log('SelectPrintListsCtrlService.onLoaded');
            if ($ctrl.expandableGroups) {
                $ctrl.expandableGroups.onExpandableLoaded();
            }
            if ($ctrl.expandableItems) {
                $ctrl.expandableItems.onExpandableLoaded();
            }
            bind(true);
        }

        function bind(isBind) {
            if($ctrl.selectPrintListsService.has2Steps && $ctrl.element){
                var el = $ctrl.element.querySelector('.nextbtn');
                if (el) {
                    //$ctrl.LCS.bindElementsClick(isBind, el, $ctrl.onNext);
                }
            }
        }

        function onDestroy(){
            var isBind = false;
            _.each(['Groups', 'Items'], function (type){
                if($ctrl['expandable' + type]) {
                    $ctrl['expandable' + type].bindExpandable(isBind);
                }
            });
            bind(isBind);
        }

        function selectAllGroups(element, e, type) {
            console.log('selectAllGroups');
            $ctrl.preventDefault(e);
            $ctrl[type] = $ctrl.selectPrintListsService.selectAllGroups(element, type, getExpandableClass());
            updateBtnSelectedCount(element);
        }

        function save(e) {
            $ctrl.preventDefault(e); 
            $ctrl.onClose({result: $ctrl.selectPrintListsService.getResult()});
        }

        function loadStep2(element) {
            if (!$ctrl.step2El) {
                $ctrl.step2El = element.querySelector('#step2');
            }

            if ($ctrl.step2El) {
                if (!$ctrl.compileStep2) {
                    $ctrl.compileStep2 = new $ctrl.TemplateCompileService($ctrl.step2El, getStep2Template, $ctrl);
                }
                $ctrl.compileStep2.loadTemplate(onLoaded);
            }

            function getStep2Template() {
                return getStep(2, element);
            }

            function onLoaded() {
                if ($ctrl.expandableItems) {
                    $ctrl.expandableItems.onExpandableLoaded();
                }
            }
        }

        function onGroupsSelect(result) {
            onSelect(result, 'Groups');
        }

        function onItemsSelect(result){
            onSelect(result, 'Items');
        }

        function onSelect(result, type){
            console.log('on' + type + 'Select');
            findGroupByEvent(result.e, $ctrl.element, {
                type: type,
                value: result.value
            });
        }

        function findGroupByEvent(e, element, other){
            var clsExp =  '.openExpandable',
                grCls = getExpandableClass() + clsExp,
                input = e.currentTarget.querySelector('input');

            if(!other || input && input.getAttribute('disabled')==='disabled'){return;}

            var el = $ctrl.LCS.findClosestParent(e.currentTarget, grCls);
            if(!el){
                el = getEl(grCls);
            }
            if(!el){
                el = getEl(clsExp);
            }

            if(!el) {return;}

            $ctrl[other.type] = $ctrl.selectPrintListsService.findByEvent(element, input, el, other, grCls, other.type);

            updateBtnSelectedCount(element);

            function getEl(cls){
                var el = $ctrl.LCS.findClosestParent(e.currentTarget, '.expitem');
                return el ? el.querySelector(cls) : null;
            }
        }

        function getExpandableClass(){
            var g = $ctrl['expandableGroups'];
            return (g ? (g.getExpandItemCls() + ' ') : '');
        }

        function isBtnDisabled(txt) {
            var result = $ctrl.selectPrintListsService.getSelectedLists(false),
                str = txt.split('_'),
                type = str[0],
                step = str[1];
            return !(type === 'Groups' && result.lists.length) &&
                   !(type === 'Items' && result.items);
        }

        function onNext(e){
            //$ctrl.preventDefault(e);
            if(!isBtnDisabled(e.currentTarget.getAttribute('data-type'))){
                loadStep2($ctrl.element);
            }
        }

        /* group:
         * Storyboards / Shots Lists 'group'
             * step 1 - select Lists (should show the tree)
         * Elements group
             * step 1 - select categories
         * Stripboard group
             * step 1 - select one schedule
             * step 2 - select day breaks < - postpone this step for now
----
         * group-item:
         * Contacts
             * step 1 - select Lists
             * step 1 - select contacts
         * Locations
             * step 1 - select Lists
             * step 1 - select locations
----
         * items:
         * Breakdowns
             * step 1 - select one schedule
             * step 2 - select day breaks   */

        //groups isFolder -> value = all selected lists
        //groups !isFolder -> value = selected items
        //items
        //group with items
    }
}

angular.module('product.print.lists.service', [
])
.service('SelectPrintListsService', SelectPrintListsService);
SelectPrintListsService.$inject =[];
function SelectPrintListsService() {
    return function (params, other) {

        var listsInfo = params ? params.listsInfo : {},
            type = listsInfo['step' + 1].type,
            service = params ? {
                ckCls: 'ckcls',
                radioCheckedCls: 'md-checked',

                listsInfo: listsInfo,
                treeType: params.treeType,
                listTreeService: params.listTreeService,


                isGroupOnly: type === 'group', //2 levels
                isGroupWithItems: type === 'group-item',
                isItemsOnly: type === 'item',
                has2Steps: listsInfo['step' + 2],

                getSelectedCount: getSelectedCount,
                getSelectedLists: getSelectedLists,
                getResult: getResult,
                getStepInfo: getStepInfo,
                selectAllGroups: selectAllGroups,
                getCheckSelector: getCheckSelector,
                findByEvent: findByEvent,
                getResultWithoutInterface: getResultWithoutInterface
            } : {};

        if(other) {
            service = _.extend(service, other);
        }
        return service;

        function getResultWithoutInterface(element){
            for(var i = 1; i <= 2; i++){
                service.getStepInfo(i, element);
            }
            return getResult();
        }

        function getItemTitle(count){
            return service.isItemsOnly ? (' ' + service.listsInfo.step1.itemTitle + (count > 1 ? 's' : '')) : '';
        }
        function getSelectedCount(){
            var result = service.getSelectedLists(false),
                l = result.lists,
                it = result.items,
                count = 0;
            if(service.isGroupOnly  ){
                if(l && l.length){
                    count = l.length;
                }
            }else{
                if(it){
                    for(var prop in it){
                        if(it[prop]) {
                            count += it[prop].length;
                        }
                    }
                }
            }
            return count + getItemTitle(count);
        }

        function getSelectedLists(isLoad) {
            var lists = [],
                hasItems,
                items = {},
                result = {};

            if (service.Groups) {
                _.each(service.Groups, function (g) {
                    if(g) {
                        if (g.isFolder) {
                                    //g.nodes ???
                            _.each(g.value, setList);
                        } else if (g.checked) {
                            setList(g.id);
                        }
                    }
                });
            }

            if (hasItems) {
                result.items = {};
                for(var id in items){
                    var l = items[id].value;
                    if(l && l.length>0){
                        result.items[id] = l;
                    }
                }
                result.lists = _.filter(lists, function (listId){
                    return result.items[listId];
                });
            } else{
                result.lists = lists;
            }

            return result;

            function setList(id) {
                lists.push(id);
                if(!isLoad) {
                    var it = _.find(service.Items, function(list){
                        return list.id === id && list.value && list.value.length > 0;
                    });
                    if (it) {
                        items[id] = it;
                        hasItems = true;
                    }
                }
            }
        }

        function getResult(){
            var result = service.getSelectedLists(false);
            if (service.isItemsOnly) {
                result.isItemsOnly = true;
                result.lists = null;
                if(!result.items){
                    result.noItems = true;
                }
            }
            return result;
        }

        function getStepInfo(step, element) {
            var info = service.listsInfo['step' + step];
            if(!info){
                return null;
            }

            var result = {info: info};

            if (info.type === 'group') {//shot lists
                service.withRadioCheck = !info.multipleSelection;
                service.allGroupsSelected = info.multipleSelection === true;
                info.withSelectAll = !service.withRadioCheck;
                result.type = 'Groups';
                result[result.type] = setGroups(element);
            } else if(info.type === 'item' || info.type === 'group-item') {
                //get all the items for the current list
                service.allGroupsSelected = true;
                info.withSelectAll = info.type !== 'item';
                result.Groups = setGroups(element);
                setGroupsWithItems(info.type === 'item' ? (step === 1) : 1, service.allGroupsSelected);
            } else {
                //'custom'
            }

            return result;

            function setGroups(element) {
                if (service.withRadioCheck) {
                    service.firstIsChecked = true;
                }

                var nodes = getNodeById().nodes,
                    g = simpleFilter(nodes),
                    rootFolder = _.find(g, {isFolder: true});

                if (rootFolder) {
                    var files = _.sortBy(_.filter(g, function (f) {
                        return !f.isFolder && f.count;
                    }), 'order');
                    if (files.length > 0 && _.reduce(files.map(function (n){return n.count;}), function(memo, num){ return memo + num; }, 0) > 0) {
                        var s = 0;
                        _.each(files, function (f) {
                            s += f.count;
                        });
                        if (s) {
                            g.push(_.extend({}, rootFolder, {
                                count: s,
                                name: 'Ungrouped',
                                nodes: files,
                                order: 1000,
                                _id: 'ungrouped'
                            }));
                            //select only folders
                            for (var i = g.length - 1; i >= 0; i--) {
                                if (!g[i].isFolder) {
                                    g.splice(i, 1);
                                }
                            }
                        }
                    }
                }

                service.Groups = g.map(getNode);

                return service.Groups;

                function getNode(n) {
                    if(n.isFolder && (!n.count || !n.nodes.length)){return null;}
                    var p = _.extend(getNodeInit(n), {
                        notExpandable: !n.isFolder,
                        list: filterNodes(n.nodes)
                    });

                    /*  if(!p.isFolder){
                          p.items = service.listTreeService.onInitLists(p);
                      }*/
                    //if has radio select the first group
                    var checked = service.allGroupsSelected ||
                        service.withRadioCheck && (info.selectedListId ? n._id === info.selectedListId : service.firstIsChecked);
                    service.firstIsChecked = false;

                    return setGroupValue(element, p, {
                        checked: checked
                    }, null);

                    function filterNodes(l){
                        return simpleFilter(l).map(getNode);
                    }
                }

                function simpleFilter(l){
                    return _.sortBy(_.filter(l, function (el) {
                        return !(service.withActiveGroup && el.active === false ||
                            service.withActiveTree && el.active === false ||
                            !el.count && (el.isFolder && (!el.nodes || !el.nodes.length) || !el.isFolder));
                    }), 'order');
                }
            }

            function setGroupsWithItems(isLoad, checked){
                result.type = 'Items';
                service[result.type] = setItems(isLoad, checked);
                result[result.type] = service[result.type];

                function setItems(isLoad, checked){
                    var litems = [],
                        listIds = getSelectedLists(isLoad).lists;
                    info.checked = checked;
                    _.each(listIds.map(getNodeById), function (n) {
                        if(service.isItemsOnly){
                            n = n.nodes[0]; //general
                        }
                        litems.push(getNode(n, info));
                    });
                    return litems;


                    function getNode(n, info){
                        var g = _.extend(getNodeInit(n), {
                            init: true,
                            list: service.listTreeService.onInitLists(n).map(function (n){
                                n.id = n._id;
                                return n;
                            }),
                            checked: info.checked
                        });
                        g.value = getListInit(g, info);
                        return g;
                    }
                }
            }

            function getNodeById(id){
                return service.listTreeService.getNodeById(id, service.treeType);
            }

            function getNodeInit(n){
                return _.extend({}, n, {
                    id: n._id,
                    icon: n.isFolder ? 'folder' : (info.itemIcon ? info.itemIcon : service.icon),
                    iconLevel: n.isFolder ? 'folder' : (info.iconLevel ? info.iconLevel : service.iconLevel),
                });
            }
        }

        function setGroupValue(element, g, info, grCls, type) {
            if(info.checked !== undefined) {
                g.checked = info.checked;
            }
            if(!g.init){
                g.init = true;
                g.value = getListInit(g, info);
            }else{
                g.value = info.value || [];
            }

            if(element && info.checked !== undefined) {
                setGroupChecked(element, g, info.el);
            }

            return g;

            function setGroupChecked(element, g, el){
                if(!el){el = element.querySelector(grCls + "[data-id='" + getId(g) + "']");}
                if(!el){return;}

                var checked = g.checked;
                setElChecked(el, false);

                //uncheck all selected if a group becomes false
                //check all selected if all groups are checked
                if( checked !== service['all' + type + 'Selected'] &&
                    (!checked || checked && _.find(service[type], {checked: !checked}) === undefined)){
                    service['all' + type + 'Selected'] = checked;
                    setElChecked(element, true);
                }

                function setElChecked(el, isAll){
                    var input = el.querySelector(getCls(type));
                    if (service.withRadioCheck) {
                        //$ctrl.LCS[checked ? 'addClass' : 'removeClass'](input, service.radioCheckedCls);
                        if(input) {
                            input.classList[checked ? 'add' : 'remove'](service.radioCheckedCls);
                        }
                    } else {
                        process(input);
                        if (!input || service.isGroupWithItems) {
                            //var cls = '.expandable ' + getCls(service.isGroupWithItems ? 'Items' : type);
                            var cls = getCls(service.isGroupWithItems ? 'Items' : type);
                            _.each(el.parentElement.querySelectorAll(cls), process);
                        }
                    }

                    function process(input) {
                        if (input) {
                            if (checked) {
                                input.setAttribute('checked', 'checked');
                            } else {
                                input.removeAttribute('checked');
                            }
                        }
                    }

                    function getCls(type){
                        return '.' + service.ckCls + '.' + (isAll ? 'selectmark' : service.getCheckSelector(type)) +
                            (service.withRadioCheck ? '' : ' input');
                    }
                }
            }
        }

        function selectAllGroups(element, type, expandableClass){
            var type1 = 'Groups',
                checked = !service['all' + type1 + 'Selected'];
            _.each(service[type], function(g, i){
                var info = {checked: checked};
                info.value = checked ? getListInit(g, info) : [];
                service[type][i] = setGroupValue(element, g, info, expandableClass, type1);
            });

            return service[type];
        }

        function getListInit(g, info){
            var l = g.list;
            return l && info.checked ? l.map(function (item) {
                return item.id;
            }) : [];
        }

        function getCheckSelector(type){
            return 'select' + type;
        }

        function findByEvent(element, input, el, other, grCls, type){
            _.each(service[type], function (g, i) {
                var attr = el.getAttribute('data-id'),
                    info;
                if(attr === 'null'){attr = null;}
                if (g.id === attr) {
                    info = {
                        el: el
                    };
                    if (other.toggle) {
                        info.checked = !g.checked;
                        info.value = getListInit(g, info);
                    } else if (other.value) {
                        info.checked = other.value.length === g.list.length && g.list.length > 0;
                        info.value = [].concat(other.value);
                    }
                } else if (service.withRadioCheck && other.toggle) {
                    info = {
                        el: el.parentElement.querySelector('.openExpandable[data-id="' + getId(g) + '"]'),
                        checked: false,
                        value: []
                    };
                }
                if(info){
                    //uncheck prev checked
                    service[type][i] = setGroupValue(element, g, info, grCls, type);
                }
            });

            return service[type];
        }

        function getId(g){
            return g.id === null ? 'null' : g.id.toString();
        }
    }
}

angular.module('profile.page.controller.service', [
    'services.sidebarConfigService',
])
 .service('ProfilePageCtrlService', ProfilePageCtrlService);
ProfilePageCtrlService.$inject = ['TemplateCompileCompCtrlService', 'ListItemTemplateFormCtrlService', 'SidebarConfigService'];

function ProfilePageCtrlService(TemplateCompileCompCtrlService, ListItemTemplateFormCtrlService, SidebarConfigService) {
    return function($ctrl, $element, withFormTemplateCompileCtrlService, isNotPopup) {
        console.log('ProfilePageCtrlService');
        $ctrl.SidebarConfigService = SidebarConfigService;
        $ctrl.profileContainerCls = 'profileContainer';

        //console.log('ProfilePageCtrlService');
        $ctrl.isPopup = isNotPopup ? false : true;

        if(!$ctrl.getItemTemplate) {
            $ctrl.getItemTemplate = getItemTemplate;
        }

        $ctrl.getItemTemplateProfile = getItemTemplate;
        $ctrl.nonMobileCloseBtn = nonMobileCloseBtn;
        $ctrl.onSidebarLink = onSidebarLink;

        if(!$ctrl.isWithSidebar) {
            $ctrl.isWithSidebar = isWithSidebar;
        }
        if(!$ctrl.displaySidebar) {
            $ctrl.displaySidebar = displaySidebar;
        }

        if(!$ctrl.hasInnerSidebar) {
            $ctrl.hasInnerSidebar = hasInnerSidebar;
        }

        if(!$ctrl.toggleInnerSidebar) {
            $ctrl.toggleInnerSidebar = toggleInnerSidebar;
        }

        if(!$ctrl.getSidebarName){
            $ctrl.getSidebarName = getSidebarName;
        }
        if(!$ctrl.getSettingsTemplateWrapper) {
            $ctrl.getSettingsTemplateWrapper = getSettingsTemplateWrapper;
        }

        if(!$ctrl.getSettingsTemplate) {
            $ctrl.getSettingsTemplate = getSettingsTemplate;
        }

        if(!$ctrl.getSidebarLinks) {
            $ctrl.getSidebarLinks = getSidebarLinks;
        }
        if(!$ctrl.getSidebarContent) {
            $ctrl.getSidebarContent = getSidebarContent;
        }

        if(!$ctrl.onSidebarLinkOther) {
            $ctrl.onSidebarLinkOther = onSidebarLinkOther;
        }
        if(!$ctrl.isSelectedTab){
            $ctrl.isSelectedTab = isSelectedTab;
        }

        if(withFormTemplateCompileCtrlService) {
            $ctrl.customTemplateCompileCtrlService = ListItemTemplateFormCtrlService;
            $ctrl.preInitOther = preInit;
            $ctrl.postInitOther = postInit;
        }else{
            $ctrl.customTemplateCompileCtrlService = TemplateCompileCompCtrlService;
            $ctrl.preInit = preInit;
            $ctrl.postInit = postInit;
        }

        if(!$ctrl.postInitProfile) {
            $ctrl.postInitProfile = postInitProfile;
        }
        return new $ctrl.customTemplateCompileCtrlService($ctrl, $element);


        function displaySidebar(){
            return $ctrl.isWithSidebar() && $ctrl.hasInnerSidebar();
        }

        function isWithSidebar() {
            return !$ctrl.withLinksInFilters && !$ctrl.hideSidebar;
        }

        function getSettingsTemplate() {
            console.log('getSettingsTemplate');
        return  '<div class="h-full side-table show-scrollbar-on-hover">' +
                    '<div class="full-content with-fancy-scrollbar h-full">' +
                        '<div class="fancy-scrollbar vertical scrollable-content h-full first-scrolling-wrapper '+$ctrl.profileContainerCls+'" fix-scrolling-height"></div>' +
                    '</div>' +
                '</div>';
        }

        function nonMobileCloseBtn(method){
            return '<div class="close-icon hide-ipad"><a class="' + $ctrl.getBtnActionCls() + ' close close-popup" data-type="' + (method || 'close') + '" data-info="true">' + $ctrl.LCS.getISBDiv('cancel', 2, 'gray sbf24') + '</a></div>';
        }

        function preInit() {
            if ($ctrl.preInitProfile) {
                $ctrl.preInitProfile();
            }
            $ctrl.currentPathParams = $ctrl.CPS.currentPathParams();

            $ctrl.hidePrint = true;

            $ctrl.setMainSideBar = setMainSideBar;

            if ($ctrl.getSettingsTemplate === undefined) {
                console.log('parent for SettingsInitCtrlService must define method getSettingsTemplate');
            }
        }

        function sidebarWatcher(){
            if(!$ctrl.isCommentsSidebar && !$ctrl.hideSidebar) {
                if ($ctrl.toggleWatcher) {
                    $ctrl.removeWatcher($ctrl.toggleWatcher);
                }
                console.log('add toggleWatcher');
                $ctrl.toggleWatcher = $ctrl.LCS.onToggleInnerSidebar($ctrl.getSidebarName(), onToggleInnerSidebar);

                if ($ctrl.toggleWatcher1) {
                    $ctrl.removeWatcher($ctrl.toggleWatcher1);
                }
            }
        }

        function onToggleInnerSidebar(show) {
            console.log('onToggleInnerSidebar ' + $ctrl.getSidebarName());
            var sidebar = $ctrl.LCS.bodyElement.querySelector('.side-nav');
            $ctrl.LCS[show ? 'removeClass' : 'addClass'](sidebar, 'sb-hide');
        }

        function postInit() {
            sidebarWatcher();
            if($ctrl.postInitProfile){
                $ctrl.postInitProfile();
            }
        }

        function postInitProfile() {
            $ctrl.bindActions(true);
            if($ctrl.postInitSettings){
                $ctrl.postInitSettings();
            }
        }

        function getItemTemplate() {
            if (typeof ($ctrl.setTemplateDataInit) === 'function') {
                $ctrl.setTemplateDataInit();
            }
            return getTopFilters() + $ctrl.getSettingsTemplateWrapper();
        }

        function getSettingsTemplateWrapper(){
            return  '<div class="h-full side-table ' + ($ctrl.withoutFiltersAbove ? '' : 'with-filters-above') + '">' +
                getSidebarTemplate($ctrl.isInTreeModal, $ctrl.canEdit) +
                '<div class="full-content with-fancy-scrollbar show-scrollbar-on-hover h-full">' +
                '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper not-absolute-tab-content" fix-scrolling-height>' + $ctrl.getSettingsTemplate() + '</div>' +
                '</div>' +
                '</div>';
        }

        function getTopFilters() {
            return $ctrl.withoutFiltersAbove ? '' : ('<nav class="filters on-top hide-print with-side-margin one-line-tooltip">' + getLinks() + '</nav>');

            function getLinks() {
                return $ctrl.withLinksInFilters ? (
                    '<ul class="top-subnav display-flex h-full">' + $ctrl.getSidebarLinks('semibold margin-right20', true) + '</ul>'
                ) : ('<div class="pull-left" ng-show="$ctrl.isWithSidebar()">' +
                    '<a class="btnToggleSidebar btn btn-small primary-faded without-text pull-left with-margin-right ' + $ctrl.getBtnActionCls() + '" data-type="toggleInnerSidebar" tooltip="Toggle Sidebar" tooltip-placement="bottom">' + $ctrl.LCS.getISBDiv('sidebar-filled', 2) + '</a>' +
                    '</div>' +
                    '<span class="pull-left title with-margin-right">' + $ctrl.title + '</span>');
            }
        }

        function getSidebarTemplate(isInTreeModal, canEdit) {
            if($ctrl.withLinksInFilters){return '';}
        return "<div class='hide-print side-nav static h-full " +
            ($ctrl.withLinksInFilters ? '' : ($ctrl.displaySidebar() ? '' : ' sb-hide')) +
            "'>" +
                    '<div class="outtercontainer show-scrollbar-on-hover">' +
                        '<div class="innercontainer fancy-scrollbar sb-scrolling-monitor ultrathin">' +
                            (isInTreeModal ? '' : ('<div class="sidebar-toggle"><a class="btn btn-small transparent noborder smaller inline-block ' + $ctrl.getBtnActionCls() + '" data-type="toggleInnerSidebar">' + $ctrl.LCS.getISBDiv('angle-double-left', 2,'centered gray') + '</a></div>')) +
                            '<div class="sidebarScrollingContainer">' + $ctrl.getSidebarContent() + '</div>' +
                        '</div>' +
                    '</div>'+
                '</div>';
        }

        function getSidebarContent(){
            return  '<h3 class="text-left side-padding spacing-half-top">' + $ctrl.sidebarTitle + '</h3>' +
                ($ctrl.getSidebarDesc ? $ctrl.getSidebarDesc() : '') +
                '<ul class="sidebarlinks display-block">' + $ctrl.getSidebarLinks() + '</ul>';
        }


        function getAnalytics(url, cls){
            return 'analytics-on analytics-label="sb_link" analytics-action="'+cls+' ' + url + '" data-type="onSidebarLink" ';
        }

        function getSidebarLinks(cls, isTop) {
            return $ctrl.sidebarLinks.map(function(item) {
                var isActive = $ctrl.isSelectedTab(item);
                if (isActive) {
                    $ctrl.selectedTab = parseInt(item.id, 10);
                }
                $ctrl.SBStateService.getActiveClass([getType(item.url, item.withProd)], true);
                return hasPermission(item) ? ('<a ' + getAnalytics(item.url, isTop ? 'submenu' : 'sidebar') + ' class="' + $ctrl.getBtnActionCls() +
                    (isActive ? ' active' : '') + (cls ? ('  ' + cls) : '') + '" data-info="' + item.id + '">' +
                    '<div class="li bulletted side-padding">' + item.name + '</div>' +
                    '</a>') : '';
            }).join('');

            function hasPermission(item) {
                switch (item.minMemberType) {
                    case $ctrl.security.MemberTypes.Owner:
                    case $ctrl.security.MemberTypes.Admin:
                        return $ctrl.CPS.memberType >= item.minMemberType;
                    default:
                        return true;
                }
            }
        }

        function isSelectedTab(item) {
            return $ctrl.SBStateService.getActiveClass([getType(item.url, item.withProd)], true).trim() === 'active';
            // return $ctrl.SBStateService.getActiveClass([getType(item.url, item.withProd)], true);
        }

        function onSidebarLink(id, e) {
            var elCls  ='a', cls ='active';
            $ctrl.LCS.removeClass($ctrl.element.querySelector('.sidebarlinks '+elCls+'.active'), cls);
            $ctrl.LCS.addClass(e.currentTarget.querySelector(elCls), cls);
            $ctrl.selectedTab = parseInt(id, 10);

             $ctrl.onSidebarLinkOther(id, e);
        }

        function onSidebarLinkOther(id, e) {
            var item = _.find($ctrl.sidebarLinks, {id: parseInt(id,10)});
            if (item) {
                getHref(getType(item.url, item.withProd), item.withProd, true);
                return $ctrl.LCS.setMainSideBar(true);
            }
        }

        function loadContainer(item){

        }

        function getHref(type, withProd, isTransition) {
            return $ctrl.CPS[isTransition ? 'transitionTo' : 'getStateHref'](type, withProd ? $ctrl.CPS.currentProductPathParams() : $ctrl.currentPathParams);
        }

        function getType(url, isProduct) {
            if(!url || url && url.indexOf('http') === 0){return url;}
            var x = 'user.' + (isProduct ? 'product.' : '');
            return url.indexOf(x) === 0 ? url : (x + url);
        }

        function setMainSideBar(e, val) {
            return $ctrl.LCS.setMainSideBar(val);
        }

        function toggleInnerSidebar(){
            $ctrl.LCS.toggleInnerSidebar($ctrl.getSidebarName());
        }

        function hasInnerSidebar(){
            return $ctrl.LCS.hasInnerSidebar($ctrl.getSidebarName());
        }

        function getSidebarName() {
            return $ctrl.SBStateService.currentState.name + ($ctrl.isInTreeModal ? ('_' + $ctrl.isInTreeModal) : '') +
                 ($ctrl.getSidebarNameOther ? ('_' + $ctrl.getSidebarNameOther()) : '');
        }
    }
}

angular.module('profile.page.enhanced.controller.service',[
    'page.profile.init.controller.service.injector'
])
    .service('ProfilePageEnhancedCtrlService', ProfilePageEnhancedCtrlService);
ProfilePageEnhancedCtrlService.$inject = ['PageProfileInitCtrlServiceInjector'];
function ProfilePageEnhancedCtrlService(pageCtrlServiceInjector) {
    return function ($ctrl, $element, pageInjectors, printPageParams) {

        $ctrl.ProfileTabs = {Details: 1, Messages: 2, Media: 3, Documents: 4};

        $ctrl.getBanner = getBanner;
        $ctrl.getTopFilters = getTopFilters;
        $ctrl.getProfileContent = getProfileContent;

        $ctrl.onDestroyProfile = onDestroyProfile;
        $ctrl.getGroupSearchPermissions = getGroupSearchPermissions;

        $ctrl.goToParentPage = goToParentPage;

        $ctrl.beforeReloadProfileWrapper = beforeReloadProfileWrapper;
        //$ctrl.onPreloadSettingsOther = onPreloadSettingsOther;
        $ctrl.onSidebarLinkOther = onSidebarLinkOther;
        $ctrl.onInitOther = onInitOther;
        $ctrl.getSimplePageInitParams = getSimplePageInitParams;
        $ctrl.getProfileInfo = getProfileInfo;
        $ctrl.loadItems = loadItems;
        $ctrl.reloadProfileTabOther = reloadProfileTabOther;
        $ctrl.getProfileImage = getProfileImage;
        $ctrl.onUpdateStats = onUpdateStats;
        $ctrl.getTopFilterLeftBtns = getTopFilterLeftBtns;
        $ctrl.getSidebarDesc = getSidebarDesc;
        $ctrl.closeBanner = closeBanner;
        $ctrl.openEdit = openEdit;

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);

        return $ctrl;

        function loadItems() {
            //  if($ctrl.CPS.hasQuotaType($ctrl.quotaType)){}
            //todo -> if in list on open loo through the contacts for the list
            $ctrl[$ctrl.ALL_ITEMS] = $ctrl.preLoadingService.getObjectList($ctrl.preLoadingTableName);

            if($ctrl.loadItemsOther){$ctrl.loadItemsOther();}
        }

        function getSimplePageInitParams(constantsService) {
            return {preloadingType: $ctrl.PreloadingTypes[constantsService.CompOptions.preloadingType]};
        }

        function getProfileInfo(id, next) {
            if (!id) {
                return next();
            }

            if(!$ctrl.profileService){
                console.log('Must define $ctrl.profileService in parent for ProfilePageEnhancedCtrlService');
            }
            $ctrl.profileService.getById(id, null, function (result) {
                next(result);
            }, onError);

            function onError(err) {
                console.log(err);
                next(null);
            }
        }

        function onInitOther() {
            $ctrl.blocks = $ctrl.setBlocks();

            $ctrl.withProd = $ctrl.CPS.productId !== null && $ctrl.CPS.productId !== undefined;

            $ctrl.sidebarTitle = 'Contact Profile';
            $ctrl.sidebarLinks = [
                getItem($ctrl.ProfileTabs.Details, 'details', 'Contact Details', 'contacts'),

                getItem($ctrl.ProfileTabs.Messages, 'messages', 'Message', 'message'),
                getItem($ctrl.ProfileTabs.Media, 'media', 'Media', 'folder'),
                getItem($ctrl.ProfileTabs.Documents, 'documents', 'Documents', 'document'),
            ];


            function getItem(id, url, name, icon) {
                return {id: id, url: url, name: name, icon: icon, withProd: $ctrl.withProd, minMemberType: 0};
            }
        }

        function onSidebarLinkOther(id, e) {
            $ctrl.reloadProfileTab();
        }

        function getSidebarDesc(){
            return  '<div class="' + $ctrl.profileDetailsCls + '"></div>';
        }

        function getTopFilters() {
            //todo must update when changes appear for strip dayTime sceneType scene

            return '<nav class="filters on-top hide-print">' +
                '<div class="pull-left">' +
                '<a class="btn btn-small primary-faded without-text pull-left with-margin-right ' + $ctrl.getBtnActionCls() + '" data-type="toggleInnerSidebar">' + $ctrl.LCS.getISBDiv('sidebar-filled', 2) + '</a>' +
                ($ctrl.hasItems ? $ctrl.getItemSearch($ctrl[$ctrl.ALL_ITEMS]) : '') +
                ($ctrl.getTopFilterLeftBtns ? $ctrl.getTopFilterLeftBtns() : ' ') +
                '</div>' +
                '<div class="pull-right">' +
                $ctrl.getListNavComments() +
                //$ctrl.getListNavShare()+
                '</div>' +
                '</nav>';
        }

        function getGroupSearchPermissions() {
            return $ctrl.CPS.isAuthenticated || !$ctrl.CPS.isAuthenticated && $ctrl.CPS.isCollaborator && !$ctrl.RouteCollaboratorsService.collabRootId;
        }

        function onDestroyProfile() {
            if ($ctrl.templateCompileProfileSidebar) {
                $ctrl.templateCompileProfileSidebar.destroyNewScope();
            }
        }

        function beforeReloadProfileWrapper(id) {
        }

        function goToParentPage() {

        }

        function getBanner() {
            if(!$ctrl.CPS.withBanner || !$ctrl.LCS.collabBannerInside){return '';}
            $ctrl.CPS.withBanner = $ctrl.CPS.setPageBanner($ctrl.CPS.withBanner,
                $ctrl.showBannerProp, $ctrl.bannerFeatureProp);


            var txt = 'profile';
            return '<div class="spacing-half-top with-no-bg hide-print centering document-version-wrapper">' +
                '<div class="alert alert-warning alert-stylish ' + txt + ' table-div full-width">' +
                '<div class="centered grow-column">' +
                $ctrl.LCS.getISBDiv(txt, 3, 'icon sbf24 pull-left') +
                ' <span class="text">Create your own contact profiles now.</span>' +
                '</div>' +
                '<div class="centered col160">' +
                '<a href="' + $ctrl.CPS.websiteUrl + '/register?utm_campaign=collab-'+$ctrl.elemType+'" target="_blank" class="btn btn-primary pull-right">Get Started Free</a>' +
                '</div>' +
                getCloseBtn() +
                '</div>' +
                '</div>';

            function getCloseBtn() {
                return '<div class="centered btn-col text-center col40">' +
                    //'<a class="closebtn display-block '+$ctrl.getBtnActionCls()+'" data-type="closeBanner">' + $ctrl.LCS.getISBDiv('close-bigger', 2) + '</a>' +
                    '</div>';
            }
        }

        function closeBanner(){
            $ctrl.CPS.closeBanner()
        }
        function getProfileImage() {
            return $ctrl.security.getUserImageComponent('$ctrl.item', 'medium');
        }

        function getBlockIndex(id){
            return $ctrl.item && $ctrl.item.blocks ? $ctrl.item.blocks.indexOf(id): -1;
        }

        function showBlock(id){
            return getBlockIndex(id) !== -1;
        }

        function reloadProfileTabOther() {
            if ($ctrl.currentId !== $ctrl.item._id) {
                loadProfileDetails();
                setUrls();

                $ctrl.currentId = $ctrl.item._id;
            }

            function loadProfileDetails() {
                if (!$ctrl.elProfileDetails) {
                    $ctrl.elProfileDetails = $ctrl.element.querySelector('.sidebarScrollingContainer .' + $ctrl.profileDetailsCls);
                }
                if ($ctrl.elProfileDetails) {
                    if (!$ctrl.templateCompileProfileSidebar) {
                        $ctrl.templateCompileProfileSidebar = new $ctrl.TemplateCompileService(angular.element($ctrl.elProfileDetails), getProfileDetails, $ctrl);
                    }

                    $ctrl.templateCompileProfileSidebar.loadTemplate(function () {
                        console.log('template loaded');
                    }, $ctrl);
                }

                function getProfileDetails() {
                    return getContentWrapper({
                        columnsListName: 'columnsListSidebar',
                        columnsListVal: getColumns([1, 2, 3])
                    });
                }
            }

            function setUrls() {
                setArrow(true);
                setArrow(false);

                function setArrow(isLeft) {
                    var type = (isLeft ? 'left' : 'right'),
                        name = 'arrowEl' + type;
                    if ($ctrl[name]) {
                        $ctrl[name] = $ctrl.element.querySelector('.top-arrows a.' + type);
                    }
                    if ($ctrl[name]) {
                        var val = $ctrl.item[isLeft ? 'prevStripId' : 'nextStripId'],
                            attr = 'data-id'; //href
                        if (val) {
                            $ctrl[name].setAttribute(attr, val);// $ctrl.getItemHref(val, true));
                        } else {
                            $ctrl[name].removeAttribute(attr);
                            $ctrl[name].setAttribute('disabled', 'disabled');
                        }
                    }
                }
            }
        }

        function getProfileContent() {
            console.log('getProfileContent');
            switch ($ctrl.selectedTab) {
                case $ctrl.ProfileTabs.Details:
                    return getBlocks();

                case $ctrl.ProfileTabs.Messages:
                    return getMessages();

                case $ctrl.ProfileTabs.Media:
                    return getMedia();

                case $ctrl.ProfileTabs.Documents:
                    return getDocuments();
            }
            return '';


            function getBlocks(){
                /* - General
                  Name
                  Credited As
                  Positions (in this project)
                  Positions (default)

                  Company Name
                  Address
                  Phone
                  Website

                  Notes

                 - Contact
                  Phone
                  Other Phones (mobile home work manager)
                  Email
                  Other Emails
                  Address (home) -
                  Address (office) -
                  Address (during production) -*/
                return getBlockWrapper() + getBottomBtns();

                function getBottomBtns() {
                    var content = getContentFromList($ctrl.blocksHidden, function (id) {
                        return getBtn(id, $ctrl.blocks[id]);
                    });
                    return getWrapper('bottombtns', null, content, $ctrl.blocksHidden.length === 0);

                    function getBtn(id, block) {
                        return '<a class="btn btn-small primary-faded with-margin-left inline-block pull-left without-text with-padding-left" data-type="openEdit" data-info="' + id + '" analytics-on analytics-action="Add Block">' +
                            (block.icon ? $ctrl.LCS.getISBDiv(block.icon, 2) : '') +
                            '<span>' + block.name + '</span>' +
                            '</a>';
                    }
                }

                function getBlockWrapper() {
                    return getContentFromList(getDetails(), function (table) {
                        console.log(table);
                        /* - General
                          Name
                          Credited As
                          Positions (in this project)
                          Positions (default)

                          Company Name
                          Address
                          Phone
                          Website

                          Notes

                         - Contact
                          Phone
                          Other Phones (mobile home work manager)
                          Email
                          Other Emails
                          Address (home) -
                          Address (office) -
                          Address (during production) -*/
                        return getWrapper(table.id, table.name, getContentWrapper({
                            id: table.id,
                            columnsListName: 'columnsList' + table.id,
                            columnsListVal: getColumns(table.columnsListVal)
                        }), !table.show);
                    });
                }

                function getContentFromList(list, m){
                    return _.map(list, m).join('');
                }

                function getDetails() {
                    $ctrl.blocksHidden = [];
                    var list = [];
                    for(var id in $ctrl.blocks){
                        list.push(get(id));

                    }
                    return _.sortBy(list, 'order');

                    function get(id){
                        var block = $ctrl.blocks[id],
                            show = block.show,
                            index = show ? id : getBlockIndex(id);
                        if(!show) {
                            show = index !== -1;
                        }
                        if(!show) {
                            $ctrl.blocksHidden.push(id);
                        }
                        return _.extend({}, block, {
                            order: show ? index : 10
                        })
                    }
                }
            }

            function getMessages() {
                return getWrapper(22, 'Messages',  '');
            }

            function getMedia() {
                return getWrapper(21, 'Images', '<profile-files class="display-block clearfix full-width" '+
                    'current-list-id="$ctrl.item._id" ' +
                    'code-name="' + $ctrl.codeName + '" ' +
                    'task-card="' + $ctrl.item.profile + '" ' +
                    'with-subparent-id="' + ($ctrl.item.name.length > 50 ? $ctrl.item.name.substring(0, 50) : $ctrl.item.name) + '"' +
                    ($ctrl.canEdit ?  ('can-edit="true" ') : '') +
                    'on-update-stats="$ctrl.onUpdateStats(result)" ' +
                    '</profile-files>');
            }

            function getDocuments() {
                return getWrapper(20,'Documents', '<profile-files class="display-block clearfix full-width" '+
                    'current-list-id="$ctrl.item._id" ' +
                    'code-name="' + $ctrl.codeName + '" ' +
                    'task-card="' + $ctrl.item.profile + '" ' +
                    'with-subparent-id="' + ($ctrl.item.name.length > 50 ? $ctrl.item.name.substring(0, 50) : $ctrl.item.name) + '"' +
                    ($ctrl.canEdit ?  ('can-edit="true" ') : '') +
                    'on-update-stats="$ctrl.onUpdateStats(result)" ' +
                    '</profile-files>');
            }

            function getWrapper(id, name, content, hide) {
                if (!$ctrl.canEdit && hide) {
                    return '';
                }

                return '<div class="clearfix display-block tab-content not-absolute-tab-content with-padding with-radius with-side-margin with-no-bg no-side-margin-xs withcontentwrapper' +
                    (hide ? ' sb-hide' : '') + '" ' +
                    (id ? 'data-type="' + id + '"' : '') +
                    '>' +
                        '<div class="contentwrapper">' +
                    (name ? ('<div class="group-title">' +
                                '<span>' + name + '</span>' +
                                getBtns() +
                            '</div>'
                    )  : '')+
                            '<div class="group-content clearfix">' + content + '</div>' +
                        '</div>' +
                    '</div>';

                function getBtns() {
                    return ($ctrl.canEdit ? ('<div class="pull-right">' +
                        '<a class="btn btn-small primary-faded with-margin-left inline-block pull-left without-text" data-type="openEdit" data-info="' + id + '" analytics-on analytics-action="Edit Block">' +
                        $ctrl.LCS.getISBDiv('pencil', 2) +
                        '</a>' +
                        '</div>') : '');
                }
            }
        }

        function onUpdateStats(result){

        }

        function getContentWrapper(opts) {
            console.log(opts.columnsListName);
            return $ctrl.getProfileGroupItem(getRowItemOptions(opts));
        }

        function getRowItemOptions(opts) {
            return _.extend({
                isMobileLayout: true
            }, opts);
        }

        function getColumns(ids){
            return _.map(ids, function (i){
                return _.extend({}, $ctrl.Settings.Columns[i]);
            });
        }

        function getAnalytics(url){
            return 'analytics-on analytics-label="sb_link" analytics-action="submenu ' + url + '" data-type="onSidebarLink" ';
        }

        function getTopFilterLeftBtns() {
            return '<span class="top-arrows hide-ipad">' + getLeftArrow() + '&nbsp;/&nbsp;' + getRightArrow() + '</span>';

            function getLeftArrow() {
                return '<div class="side-arrow hide-print one-line-tooltip with-cursor" ' +
                    //'style="cursor:' + ($ctrl.item.prevStripId ? 'hand' : 'pointer') +
                    '">' +
                    '<a class="left table-div" ' +
                    //   ($ctrl.item.prevStripId? ('href="' + $ctrl.getItemHref($ctrl.item.prevStripId, true) + '"') : 'disabled="disabled" ') +
                    //' tooltip="Previous Scene" tooltip-placement="right"' +
                    ' data-type="onSidebarLink"><div class="text-center centered">' + $ctrl.LCS.getISBDiv('arrow-left-big') + ' Previous</div></a>' +
                    '</div>';
            }

            function getRightArrow() {
                return '<div class="side-arrow text-right hide-print one-line-tooltip" ' +
                    // 'style="cursor:' + ($ctrl.item.nextStripId ? 'hand' : 'pointer') +
                    '">' +
                    '<a class="right table-div"' +
                    // ($ctrl.item.nextStripId? ('href="' + $ctrl.getItemHref($ctrl.item.nextStripId, true) + '"') : 'disabled="disabled" ') +
                    //' tooltip="Next Scene" tooltip-placement="left"' +
                    ' data-type="onSidebarLink"><div class="text-center centered">Next ' + $ctrl.LCS.getISBDiv('arrow-right-big') + '</div></a>' +
                    '</div>';
            }
        }

        function openEdit(id, e) {
            var block = _.clone($ctrl.blocks[id]);

            $ctrl.getNewPopupParamsOther2 = getNewPopupParamsOther2;
            $ctrl.popupsService.open(block, $ctrl.popupsService.operations.callsheetColumns, {
                service: $ctrl.service,
                block: block,
            }, $ctrl.compOptions, null, function (result) {
                console.log('onEditPopup');
                var index = $ctrl.blocksHidden.indexOf(id);
                if (index !== -1) {
                    $ctrl.LCS.removeClass($ctrl.element.querySelector('.withcontentwrapper[data-type="' + id + '"]'), 'sb-hide');
                    $ctrl.blocksHidden.splice(index, 1);
                }
            });

            function getNewPopupParamsOther2() {
                return {columnsList: block.cols};
            }
        }
    }
}


angular.module('page.profile.init.controller.service.injector', [
    'page.controller.service.injector'
])
.service('PageProfileInitCtrlServiceInjector', PageProfileInitCtrlServiceInjector);
PageProfileInitCtrlServiceInjector.$inject = ['PageCtrlServiceInjector'];
function PageProfileInitCtrlServiceInjector(PageCtrlServiceInjector) {
/*options = {
    constantsService: constantsService,
    service: service,
    groupCtrlService : listsService,
    groupSearchDrpCtrlService: listOptionsService,

    otherOptions: {
    }
}*/
    return function ($ctrl, $element, pageInjectors, printPageParams, otherOptions) {
        var predef = ['constantsService'
           // , 'service', 'groupCtrlService', 'groupSearchDrpCtrlService'
        ];

        $ctrl = new PageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams, otherOptions, predef);

        return $ctrl;
    }
}

angular.module('profile.page.init.controller.service', [
    'page.simple.controller.service',
    'list.keyboard.service',
    'templateCompile.service',
    'page.profile.init.controller.service.injector'
])
.service('ProfilePageInitCtrlService', ProfilePageInitCtrlService);

ProfilePageInitCtrlService.$inject =  ['PageSimpleInitCtrlService','FiltersService', 'SBFieldTypesService', 'KeyboardListService'];
function ProfilePageInitCtrlService(PageSimpleInitCtrlService, FiltersService, SBFieldTypesService, KeyboardListService) {
    return function ($ctrl, $element, p) {

        var constantsService = _.extend({}, p ? p.constantsService : null);

        $ctrl.FiltersService = FiltersService;
        $ctrl.KeyboardListService = KeyboardListService;
        $ctrl.SBFieldTypesService = SBFieldTypesService;
        $ctrl.SBFieldMethods = SBFieldTypesService.SBFieldMethods;

        $ctrl.isProfile = true;

        $ctrl.RELOAD_ALL =  'RELOAD_ALL_' + $ctrl.ALL_NAME.toUpperCase();
        $ctrl.ALL_ITEMS = 'all' + $ctrl.ALL_NAME;

        $ctrl.dontNotify = true;

        $ctrl.showShareInListNav = true;
        $ctrl.showCollabsInListNav = true;
        $ctrl.hasItems = false;
        $ctrl.profileWrapperCls = 'profile-wrapper';
        $ctrl.profileImgId = 'profileImgWrapper';

        $ctrl.getItemHref = getItemHref;

        if(typeof($ctrl.preInitProfile) === 'function') {
            $ctrl.preInitProfile();
        }

        $ctrl.getProfileGroupItem = getProfileGroupItem;

        $ctrl.getPageTemplate = getPageTemplate;
        $ctrl.uiOnParamsChanged = uiOnParamsChanged;
        $ctrl.getColumnByProp = getColumnByProp;
        $ctrl.getClsCol = getClsCol;
        $ctrl.onPreloadSettings = onPreloadSettings;
        $ctrl.reloadProfileWrapper = reloadProfileWrapper;

        if(!$ctrl.$onInit) {
            $ctrl.$onInit = onInitProfile;
        }

        $ctrl.onInitProfile = onInitProfile;

        if(!$ctrl.reloadProfileTab) {
            $ctrl.reloadProfileTab = reloadProfileTab;
        }

        $ctrl.onPageDestroyOther = onPageDestroyOther;
        if(!$ctrl.isSelectedTab) {
            $ctrl.isSelectedTab = isSelectedTab;
        }

        $ctrl.filtersService = new $ctrl.FiltersService(constantsService, null);

        $ctrl = new PageSimpleInitCtrlService($ctrl, $element, {
            constantsService: constantsService,
        });

        initForPage();

        return $ctrl;

        function isSelectedTab(item) {
            return $ctrl.selectedTab === item.id;
            // return $ctrl.SBStateService.getActiveClass([getType(item.url, item.withProd)], true);
        }
        function initForPage() {
            $ctrl.editSection =null;
            $ctrl.todoPage = $ctrl.BlocksSetupService.getCurrentTodoPage();

            $ctrl.isActiveGroup = isActiveGroup;

            $ctrl.listTreeService = {
                active: null,
                getNodeById: getNodeById,
                getBreadcrumbs: getBreadcrumbs,
                isArchiveAsList: isArchiveAsList,
                maxLevel: $ctrl.todoPage.maxLevel,
                filtersService: $ctrl.filtersService
            };

            $ctrl.RouteCollaboratorsService.setListTreeService($ctrl.listTreeService);

            $ctrl.keyboardService = new $ctrl.KeyboardListService({
                itemTitle: constantsService.CompOptions.itemTitle,
                objectType: constantsService.CompOptions.objectType,
                tableClass: constantsService.CompOptions.tableClass,
            });

            /* for(var prop in $ctrl.filtersService.Settings.Columns){
                 $ctrl.filtersService.Settings.Columns[prop].canEdit = false;
             }*/
            $ctrl.Settings = $ctrl.filtersService.Settings;
            $ctrl.columnsList = $ctrl.filtersService.listCols;
            // $ctrl.filtersService.Options.columns =  ["1", "2", "3", "5", "6", "7"];
            $ctrl.filtersService.setOptions(null);
        }

        function getItemHref(id, isHref) {
            if (!id) {
                return null;
            }
            var p = _.extend({}, $ctrl.SBStateService.getCurrentStateParams());
            p[$ctrl.profileFieldId] = id;
            return $ctrl.CPS[isHref ? 'getStateHref' : 'transitionTo']($ctrl.SBStateService.getCurrentStateName(), p);
        }

        function onInitProfile() {
            console.log('onInit ProfilePageInitCtrlService');
            $ctrl.listField = $ctrl.CPS.SBStateService.getCurrentStateData().listField;

            if (typeof ($ctrl.onInitOther) === 'function') {
                $ctrl.onInitOther();
            }

            $ctrl.hasGroupSearchDrp = $ctrl.getGroupSearchPermissions();

            if ($ctrl.groupSearchDrpCtrlService) {
                $ctrl = new $ctrl.groupSearchDrpCtrlService($ctrl, $ctrl.hasGroupSearchDrp);
            }

            $ctrl.onSimplePageInit(_.extend({
                isScript: $ctrl.isScript,
                additionalScriptInit: additionalScriptInit,
            }, $ctrl.getSimplePageInitParams ? $ctrl.getSimplePageInitParams(constantsService) : null), function (preLoadingService){
                $ctrl.preLoadingService = preLoadingService;

                if($ctrl.isScript){
                    onLoaded();
                } else {
                    additionalScriptInit();
                    $ctrl.reloadPageTemplate(false, onLoaded);
                }
            });

            function additionalScriptInit() {
                console.log('additionalScriptInit');
                if(!$ctrl.itemsLoaded) {
                    $ctrl.itemsLoaded = true;
                    $ctrl.loadItems();

                    if ($ctrl.groupCtrlService) {
                        $ctrl = new $ctrl.groupCtrlService($ctrl, $element);
                    }

                    if (!_.isEmpty($ctrl[$ctrl.ALL_ITEMS])) {
                        $ctrl.hasItems = true;
                    }

                    if (typeof ($ctrl.additionalScriptInitOther) === 'function') {
                        $ctrl.additionalScriptInitOther();
                    }
                }

                return $ctrl.isScript;
            }

            function onLoaded() {
                console.log('ProfilePageInitCtrlService.onLoaded');
                if (typeof ($ctrl.onPageLoadedOther) === 'function') {
                    $ctrl.onPageLoadedOther();
                }

                if($ctrl.canEdit && $ctrl.withImage) {
                    $ctrl.onImageUploaded = onImageUploaded;
                    //$ctrl.removeWatcher($ctrl.imageUploadedWatcher);$ctrl.imageUploadedWatcher =
                    $ctrl.addRootWatcher('IMAGE_UPLOADED', $ctrl.onImageUploaded);
                }

                if (!$ctrl.elProfileWrapper) {
                    $ctrl.elProfileWrapper = $ctrl.element.querySelector('.' + $ctrl.profileWrapperCls);
                }

                $ctrl.templateCompileProfile = new $ctrl.TemplateCompileService(angular.element($ctrl.elProfileWrapper), $ctrl.getProfileContent, $ctrl);

                if ($ctrl.hasItems) {
                    setInitialId();

                    if (typeof ($ctrl.preloadSettings) === 'function') {
                        $ctrl.preloadSettings();
                    }

                    addWatchers();

                    $ctrl.reloadProfileWrapper($ctrl[$ctrl.profileFieldId]);
                    $ctrl.bindItemsSearch(true);
                }

                function addWatchers() {
                    if ($ctrl.canEdit) {
                        $ctrl.addRootWatcher('UPDATED_' + $ctrl.elemType + '_ITEM', onInitUpdated);
                        $ctrl.addRootWatcher('CREATED_' + $ctrl.elemType + '_ITEM', onInitUpdated);
                        $ctrl.addRootWatcher($ctrl.RELOAD_ALL, reloadAll);
                    }
                }
            }
        }

        function getClsCol(c) {
            return c.colCls + (c.grow && c.colCls.indexOf('grow-column') === -1 ? ' grow-column ' : '') + cantShrinkOnPrint(c);

            function cantShrinkOnPrint(c) {
                return c.type !== $ctrl.SBFieldTypesService.PropTypes.Picture &&
                c.type !== $ctrl.SBFieldTypesService.PropTypes.Locations &&
                c.type !== $ctrl.SBFieldTypesService.PropTypes.Characters &&
                c.type !== $ctrl.SBFieldTypesService.PropTypes.StripLocation &&
                c.type !== $ctrl.SBFieldTypesService.PropTypes.SimpleCheck ? '' : ' cant-shrink';
            }
        }

        function getNodeById(listId) {
            return $ctrl.item;
        }

        function getBreadcrumbs(list) {
            return [];
        }

        function onPageDestroyOther() {
            $ctrl.bindItemsSearch(false);

            if($ctrl.templateCompileProfile){
                $ctrl.templateCompileProfile.destroyNewScope();
            }

            if(typeof($ctrl.onDestroyProfile) === 'function'){
                $ctrl.onDestroyProfile();
            }
        }

        function uiOnParamsChanged(changedParams) {
            console.log('ProfilePageInitCtrlService.uiOnParamsChanged');
            if(changedParams) {
                var profileFieldId = changedParams[$ctrl.profileFieldId];
                if (profileFieldId !== undefined && profileFieldId !== $ctrl[$ctrl.profileFieldId]) {
                    $ctrl[$ctrl.profileFieldId] = profileFieldId;
                    $ctrl.reloadProfileWrapper($ctrl[$ctrl.profileFieldId]);
                }
            }
        }

        function reloadAll(items) {
            console.log($ctrl.RELOAD_ALL);
            $ctrl[$ctrl.ALL_ITEMS] = items;
        }

        function onInitUpdated(result) {
            if (!result) {
                return;
            }
            $ctrl.onPreloadSettings(result, true);
        }

        function onPreloadSettings(result, withTagReload) {
            if (typeof($ctrl.preloadSettings) === 'function') {
                $ctrl.preloadSettings();
            }
            $ctrl.broadcastRoot('PRELOADED_SETTINGS_CHANGED_' + $ctrl.elemType + '_GROUP', $ctrl.Settings);

            $ctrl.LCS.timeout(function () {
                $ctrl.loadItems();

                if($ctrl.onPreloadSettingsOther) {
                    $ctrl.onPreloadSettingsOther(result, withTagReload);
                }
            }, 100);
        }

        function getItemById(id) {
            return $ctrl[$ctrl.ALL_ITEMS] ? _.find($ctrl[$ctrl.ALL_ITEMS], {_id: id}) : null;
        }


        function setInitialId() {
            var stateParams = $ctrl.CPS.stateParams;
            var profileFieldId = $ctrl.CPS.getSearchFilter($ctrl.profileFieldId); //for backwards compatibility
            if(profileFieldId){
                $ctrl.CPS.setSearchFilter(null, $ctrl.profileFieldId);
            }else{
                profileFieldId = stateParams ? stateParams[$ctrl.profileFieldId] : null;
            }
            if(profileFieldId){//check if is still available
                var s = getItemById(profileFieldId);
                profileFieldId = s ? s._id : ($ctrl[$ctrl.ALL_ITEMS].length > 0 ? $ctrl[$ctrl.ALL_ITEMS][0]._id : null);
            }
            $ctrl[$ctrl.profileFieldId] = profileFieldId;
        }

        function reloadProfileTab(){
            $ctrl.templateCompileProfile.loadTemplate(function () {
                console.log('template loaded');
            }, $ctrl);
            if($ctrl.reloadProfileTabOther){
                $ctrl.reloadProfileTabOther();
            }
        }

        function reloadProfileWrapper(id) {
            console.log('reloadProfileWrapper');
            if ($ctrl[$ctrl.profileFieldId] !== id) {
                $ctrl[$ctrl.profileFieldId] = id;
                $ctrl.goToBreakdown(id);
            }
            if(typeof($ctrl.getProfileInfo) === 'function'){
                $ctrl.getProfileInfo(id, process);
            } else{
                process();
            }
            function process(profile) {
                $ctrl.item = getItemWithNextById(id, profile);
                $ctrl.item.profile = profile;
                $ctrl.item.profileId = id;

                if (!$ctrl.item) {
                    return $ctrl.goToParentPage(true);
                }

                $ctrl.listTreeService.active = {
                    selectedList: $ctrl.item,
                    selectedListId: $ctrl[$ctrl.profileFieldId]
                }

                if (!$ctrl.columnsList) {
                    $ctrl.columnsList = getColumnsList(false);
                }

                if (typeof ($ctrl.beforeReloadProfileWrapper) === 'function') {
                    if($ctrl.withImage){
                        $ctrl.onImageUploaded($ctrl.item);
                    }
                    $ctrl.beforeReloadProfileWrapper(id);
                }

                $ctrl.reloadProfileTab();
            }
        }

        function onImageUploaded(result){
            if(!$ctrl.item || !result){return;}

            console.log('ProfilePageInitCtrlService.onImageUploaded');

            var id = result && result.item ? result.item._id : null;
            if (id && $ctrl.item._id === id) {
                $ctrl.item.getUpdatedImageProps(result.updatedImage);

                var wr = $ctrl.element.querySelector('#' + $ctrl.profileImgId);
                if (wr) {
                    $ctrl.LCS.removeElementChild(wr, '.featured-image' );
                    $ctrl.LCS.removeElementChild(wr, '.avatar' );
                    $ctrl.LCS.appendChildFragment(wr, $ctrl.getProfileImage());
                }
            }
        }

        function getColumnsList(sortedForPopup) {
            var columns = $ctrl.Settings.Columns;
            if (!columns) {
                return null;
            }
            var list = [];
            for (var prop in columns) {
                var c = columns[prop];
                list.push(c);
            }

            return _.sortBy(list, function (c) {
                return sortedForPopup && c.orderModal ? c.orderModal : c.order;
            });
        }

        function getItemWithNextById(id, profile) {
            var el = null;
            if (id) {
                for (var index = 0, n = $ctrl[$ctrl.ALL_ITEMS].length; index < n; index++) {
                    el = $ctrl[$ctrl.ALL_ITEMS][index];
                    if (el._id === id) {
                        el.prevStripId = null;
                        el.nextStripId = null;
                        el.count = n;
                        if (index !== -1) {
                            el.prevStripId = $ctrl[$ctrl.ALL_ITEMS][(index > 0 ? index : el.count) - 1]._id;
                            el.nextStripId = $ctrl[$ctrl.ALL_ITEMS][(index < el.count - 1) ? (index + 1) : 0]._id;
                        }
                        return el;
                    }
                }
            }
            return null;
        }

        function getPageTemplate() {
            console.log('getPageTemplate');
        if(!$ctrl.hasItems){
            return '<div class="empty-state-wrapper with-margin-top with-side-margin">' + $ctrl.getEmptyState() + '</div>';
        }
        return '<div class="h-full side-table profile-page ' + ($ctrl.withoutFiltersAbove?'':'with-filters-above ') + '">' +
                    ($ctrl.withoutFiltersAbove ? '' : $ctrl.getTopFilters()) +
                    getSidebar() +
                    '<div class="full-content with-fancy-scrollbar show-scrollbar-on-hover h-full">' +
                        '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper' +
            ($ctrl.notAbsoluteTabContent ? ' not-absolute-tab-content with-white-bg' : '' ) +
            '" fix-scrolling-height>' +
                            '<div class="clearfix display-block with-side-padding centering sb-scrolling-monitor" sb-scrolling-monitor-id="group">' +
                                '<div>' +
                                    (typeof($ctrl.getBanner) === 'function' ? $ctrl.getBanner() : '') +
                                    '<div class="'+$ctrl.profileWrapperCls+'"></div>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>';

            function getSidebar(){
                return '<div class="clearfix hide-print h-full side-nav static long ' +
                    ($ctrl.displaySidebar() ? '' : 'sb-hide ')  +
                    ($ctrl.sidebarClass || '') + ' profile-sidebar" ' + '>'+
                            '<div class="outtercontainer">' +
                                '<div class="innercontainer fancy-scrollbar sb-scrolling-monitor ultrathin">' +
                                    '<div class="sidebarScrollingContainer">' +
                                        '<div class="sidebar-toggle no-padding"><a class="btn btn-small transparent noborder smaller inline-block ' + $ctrl.getBtnActionCls() + '" data-type="toggleInnerSidebar">'+$ctrl.LCS.getISBDiv('angle-double-left', 2,'centered gray')+'</a></div>' +
                //($ctrl.withImage && $ctrl.getProfileImage ? ('<div class="full-width centered margin-half">' + $ctrl.getProfileImage() + '</div>') : '') +
                                        $ctrl.getSidebarContent() +
                                    '</div>' +
                                '</div>' +
                            '</div>' +
                        '</div>';
            }
        }

        function getColumnByProp(prop, searchAllColumns) {
            return $ctrl.filtersService.getColumnByProp(prop, searchAllColumns);
        }

        function isArchiveAsList(){
            return false;
        }

        function isActiveGroup(){
            return $ctrl.item && $ctrl.item.active;
        }

        function getProfileGroupItem(opts) {
            return $ctrl.getGroupItemComponent(opts && opts.id && opts.id === $ctrl.editSection, true, null, null, null, _.extend({
                currentListId: null,
                withSortable: false,
                selectedFilter: '::null',
                rowLoadLater: false,
                getGroupItemAttributes: $ctrl.getGroupItemAttributes(),
                groupItemCls: 'display-block',
                groupItemInfo: 'item="' + ($ctrl.canEdit ? '' : '::') + '$ctrl.item"'
            }, opts));
        }
    }
}


