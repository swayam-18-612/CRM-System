angular.module('dropdowns.timepicker.controller.service', [
    'dropdowns.drpnonclosed.controller.service'
])
.service('SBTimepickerCtrlService', SBTimepickerCtrlService);

SBTimepickerCtrlService.$inject = ['SBFieldTypesService', 'SBDrpNonClosedCtrlService', 'MomentService'];

function SBTimepickerCtrlService(SBFieldTypesService, SBDrpNonClosedCtrlService, MomentService) {
    return function ($ctrl, $element, $attrs, propType, initListName) {

        var withoutTemplateScope = true;

        $ctrl.MomentService = MomentService;
        $ctrl.menuTag = 'sb-timepicker-dropdown-menu';
        $ctrl.menuCls = 'timepicker-popup custom-drp-size';

        $ctrl.SBFieldMethods = SBFieldTypesService.SBFieldMethods;
        $ctrl.propType = SBFieldTypesService.PropTypes[propType];
        if(initListName) {
            $ctrl.initListName = initListName;
            $ctrl.initList = $ctrl.SBFieldMethods[$ctrl.initListName];
        }
        $ctrl.generateDrpMenuContent = generateDrpMenuContent;
        $ctrl.initDrp = initDrp;
        $ctrl.preDisplayValue = preDisplayValue;

        $ctrl.setInputField = false;
        $ctrl = new SBDrpNonClosedCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

        return $ctrl;

        function initDrp() {
            $ctrl.tabIndex = $ctrl.tabIndex ? $ctrl.tabIndex : null;
            $ctrl.timeFormat = $ctrl.timeFormat || 'h:mma';
        }

        function generateDrpMenuContent() {
            return {
                $ctrl: {
                    time: $ctrl.time,
                    initList: $ctrl.initList,
                    onSelect: $ctrl.onSelect,
                },
                template: ($ctrl.hasRemove ? ("has-remove='" + $ctrl.hasRemove + "' ") : '') +
                    ($ctrl.removeText ? ("remove-text='" + $ctrl.removeText + "' ") : '') +

                    ($ctrl.timeFormat === 'h:mma' ? 'show-meridian="true" ' : '')+
                    ($ctrl.hasMoreVals? ( "has-more-vals='true' ") : '') +

                    "time='::$ctrl.time' " +
                    "init-list='::$ctrl.initList' " +
                    "on-select='$ctrl.onSelect(result)' "
            };
        }

        function preDisplayValue() {
            $ctrl.value = $ctrl.MomentService.stringToUTCMoment($ctrl.value, $ctrl.hasMoreVals);
            $ctrl.prevValue =  angular.copy($ctrl.value);

            if (!$ctrl.defaultTime) {
                $ctrl.defaultTime = $ctrl.defaultTime ? $ctrl.MomentService.getUtcMoment($ctrl.defaultTime) : $ctrl.MomentService.getUtcMomentDefaultStartDay();
            }

            var tempModel = (!$ctrl.value && !$ctrl.hasMoreVals) ? $ctrl.defaultTime : $ctrl.prevValue;

            var d = new Date();
            var isset = false;

            if (tempModel) {
                var newVal;

                if ($ctrl.hasMoreVals) {
                    if (tempModel.isTime === true) {
                        newVal = tempModel.value;
                    }
                } else {
                    if (tempModel.isTime === undefined) {
                        newVal = tempModel;
                    }
                }

                if (newVal) {
                    set(newVal);
                    isset = true;
                }
            }

            if (!isset) {
                set($ctrl.defaultTime);
            }

            $ctrl.time = d;

            function set(val) {
                if (val) {
                    d.setHours(val.hours());
                    d.setMinutes(val.minutes());
                    d.setSeconds(0);
                    d.setMilliseconds(0);
                }
            }
        }
    }
}

angular.module('dropdowns.timepicker.dropdownmenu.controller.service', [
])
.service('SBTimepickerDrpMenuCtrlService', SBTimepickerDrpMenuCtrlService)
SBTimepickerDrpMenuCtrlService.$inject = ['TemplateCompileCompCtrlService', 'SBFieldMethods', '$locale'];
function SBTimepickerDrpMenuCtrlService(TemplateCompileCompCtrlService, SBFieldMethods,  $locale) {
    return function ($ctrl, $element) {

        var withoutTemplateScope = true;

        $ctrl.preInit = preInit;
        $ctrl.getItemTemplate = getItemTemplate;
        $ctrl.onDestroy = onDestroy;
        $ctrl.onLoaded = onLoaded;

        $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

        var meridians;

        // 12H / 24H mode

        function preInit() {
            setDurationMethods();

            $ctrl.hasMoreVals = $ctrl.hasMoreVals === true || $ctrl.hasMoreVals === 'true';
            meridians = $ctrl.meridians ? $ctrl.meridians : $locale.DATETIME_FORMATS.AMPMS;

            $ctrl.tabIndex = 10000;
            $ctrl.showMeridian = $ctrl.showMeridian === 'true' || $ctrl.showMeridian === true;
            // $ctrl.hasMoreVals = $ctrl.initList && $ctrl.initList.length > 0; <- set in parent

            $ctrl.hasRemove = $ctrl.hasRemove === 'true' || $ctrl.hasRemove === true;
            if (!$ctrl.removeText) {
                $ctrl.removeText = 'Remove';
            }

            setListProp();
        }

        function setListProp() {
            $ctrl.listProp = [];
            $ctrl.hasProp = {};
            if (!$ctrl.config.hideHours) {
                addProp('hours');
            }
            addProp('minutes');

            if($ctrl.config.showSeconds) {
                addProp('seconds');
            }

            if ($ctrl.config.showMilliseconds) {
                addProp('milliseconds');
            }

            if ($ctrl.showMeridian) {
                addProp('meridian');
            }

            function addProp(prop){
                $ctrl.listProp.push(prop);
                $ctrl.hasProp[prop] = true;
            }
        }

        function getPrevProp(prop){
            var v = getIndex(prop) - 1;
            return $ctrl.listProp[v < 0 ? ($ctrl.listProp.length - 1) : v];
        }

        function getNextProp(prop){
            var v  = getIndex(prop) + 1;
            return $ctrl.listProp[v >= $ctrl.listProp.length ? 0 : v];
        }

        function getIndex(prop){
           return  _.findIndex($ctrl.listProp, function (p){return prop === p;})
        }

        function onDestroy() {
            bindClick();
            setupMousewheelEvents();
            setupInputEvents();
            clearStopwatchInterval();
        }

        function processMethodsRange(m){
            if($ctrl.isRange){
                m('from');
                m('to');
            } else{
                m();
            }
        }

        function onLoaded() {
            createInputs();
            updateInputs();
            setupInputEvents(true);

            setupMousewheelEvents(true);

            bindClick(true);

            $ctrl.LCS.timeout(function () {
                //select default field
                selectEl($ctrl[$ctrl.listProp[$ctrl.isDuration && $ctrl.listProp.length > 1 ? 1 : 0] + getInputEl($ctrl.isRange ? 'from' : '')]);
            }, 100);

            function createInputs() {
                processMethodsRange(process);

                function process(from) {
                    _.each($ctrl.listProp, function (prop) {
                        var cls = getTableCls(from);
                        $ctrl[prop + getInputEl(from)] = $ctrl.element.querySelector(cls + '#input' + prop);
                        $ctrl[prop + getColEl(from)] = $ctrl.element.querySelector(cls + '.col' + prop);
                    });
                }
            }
        }

        function getTableCls(from){
            return (from ? ('.' + from +' ') : '');
        }

        function getInputEl(from){
            return (from||'') + 'InputEl';
        }

        function getColEl(from){
            return (from||'') + 'ColEl';
        }

        function getProp(prop, from){
            return prop + (from||'');
        }

        function setupInputEvents(isBind) {
            var evname = 'keydown paste';

            processMethodsRange(process);

            function process(from) {
                _.each($ctrl.listProp, function (prop) {
                    var el = $ctrl[prop + getInputEl(from)];
                    if (el) {
                        $ctrl.LCS.bindElementsClick(isBind, el, function (e) {
                            onBlurInputEl(e, prop, from);
                        }, null, 'blur');

                        $ctrl.LCS.bindElementsClick(isBind, el, function (e) {
                            onKeydownInputEl(e, prop, from);
                        }, null, evname);
                    }
                });
            }

            function onKeydownInputEl(e, prop, from) {
                var inputEl = getInputEl(from),
                    p = getProp(prop, from);
                //h m s m
                //console.log('onKeydown' + prop + inputEl);
                if (e.which === 37) {  // left
                    onnext(e);
                    selectEl($ctrl[getPrevProp(prop) + inputEl]);
                } else if (e.which === 39 || e.which === 9) {  //right or tab
                    onnext(e);
                    selectEl($ctrl[getNextProp(prop) + inputEl]);
                } else if (e.which === 13 || e.which === 27) {//enter or esc
                    onnext();
                    onEnter(e);
                } else if (e.which === 38 || e.which === 40) { // up down
                    $ctrl.preventDefault(e);
                    increment(prop, e.which === 38, from);
                } else if (e.which === 8) {//delete
                    if (prop === 'minutes') {
                        process(e);
                    }
                } else if (prop === 'meridian' && (e.which === 65 || e.which === 97 || e.which === 80 || e.which === 112)) {//aApP
                    $ctrl.preventDefault(e);
                    setMeridian(e.which, from);

                } else if (isValid(e)) {
                    process(e);
                    if (e) {
                        e.stopPropagation();
                    }
                }

                function onEnter(e) {
                    $ctrl.preventDefault(e);
                    refresh(null, true, null, from);
                }

                function process(e) {
                    $ctrl.LCS.timeout(function () {
                        var v = $ctrl[prop + inputEl].value;
                        if (prop !== 'meridian') {
                            $ctrl[p] = v === '' ? 0 : parseInt(v, 10);
                            updateHAndM(prop[0], from);
                        }
                    }, 0);
                }

                function onnext() {
                    $ctrl.preventDefault(e);
                    var el = $ctrl[prop + inputEl];
                    if (el) {
                        el.blur();
                    }
                }
            }

            function onBlurInputEl(e, prop, from) {
                var p = getProp(prop, from);
                if (prop !== 'meridian') {
                    var key = prop[0];
                    if (modelIsEmpty()) {
                        makeValid(from);
                    } else if ($ctrl[p] === null || $ctrl[p] === '') {
                        var invalid = {};
                        invalid[prop] = true;
                        invalidate(invalid, from);
                    } else if (!$ctrl['invalid' + p] && $ctrl[p] < 10) {
                        $ctrl[p] = padMinutes($ctrl[p], prop === 'hours' ? !$ctrl.showMeridian : false);
                        updateHAndM(key, from);
                    }
                }

                function modelIsEmpty() {
                    var isEmpty = 0;
                    _.each($ctrl.listProp, function (prop) {
                        var p = getProp(prop, from)
                        if ($ctrl[p] === null || $ctrl[p] === '') {
                            isEmpty ++;
                        }
                    });
                    return $ctrl.listProp.length === isEmpty;
                }
            }

            function setMeridian(type, from) {
                var hours = getTimeVar().hours;
                if (type === '65' && hours >= 12 ||//am
                    type === '80' && hours < 12) { //pm
                    toggleMeridian(from);
                }
            }

            function isValid(e) {
                // Handle paste
                if (e.type === 'paste') {
                    key = e.clipboardData.getData('text/plain');
                } else {
                    // Handle key press
                    var key = e.keyCode || e.which;
                    key = 96 <= key <= 105 ? parseInt(e.key, 10) : String.fromCharCode(key);
                }
                var regex = /[0-9]|\./;
                if (!regex.test(key)) {
                    e.returnValue = false;
                    $ctrl.preventDefault(e);
                    return false;
                }
                return true;
            }
        }

        function setupMousewheelEvents(isBind) {
            //disable for now
            return ;


            var event = 'mousewheel wheel';
            processMethodsRange(process);

            function process(from) {
                _.each($ctrl.listProp, function (prop) {
                    var el = $ctrl[prop + getInputEl(from)];
                    if (el) {
                        $ctrl.LCS.bindElementsClick(isBind, el, function (e) {
                            increment(prop, isScrollingUp(e), from);
                            $ctrl.preventDefault(e);
                        }, null, event);
                    }
                });
            }

            function isScrollingUp(e) {
                if (e.originalEvent) {
                    e = e.originalEvent;
                }
                //pick correct delta variable depending on event
                var delta = (e.wheelDelta) ? e.wheelDelta : -e.deltaY;
                return (e.detail || delta > 0);
            }
        }

        function getItemTemplate() {
            if ($ctrl.isDuration) {
                $ctrl.resetDuration();
            }

            $ctrl.stopwatchEl = {};

            var cls = $ctrl.getBtnActionCls();

            $ctrl.selectedTab = 1;

            return '<div class="dropdown-menu selectabledropdown selector-dropdown ' + ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '') + '"><div>' + getContent() + '</div></div>';

            function getContent() {
                if (!$ctrl.isDuration) {
                    return getCustom();
                }

                return '<div class="customheader text-center">' + getTabHeader(1, 'Custom') + getTabHeader(2, 'Stopwatch') + '</div>' +
                    getTab(1, getCustom()) +
                    getTab(2, getStopwatch());


                function getTab(tab, content) {
                    return '<div class="customtab full-width ' + ($ctrl.selectedTab === tab ? '' : 'sb-hide') + '" data-info="' + tab + '">' + content + '</div>';
                }

                function getTabHeader(tab, name) {
                    return '<a class="' + (cls + ($ctrl.selectedTab === tab ? ' active' : '')) + '" data-type="swapTab" data-info="' + tab + '">' + name + '</a>';
                }

                function getCustom() {
                    var content = getTableContent();
            return ($ctrl.isRange ? ('<div class="full-width spacing-half-top">' + getTable('from') + getTable('to') + '</div>') : getTable()) +
                    getBtns();

                    function getTable(from){
                        return '<table class="timepicker centered' + ($ctrl.isEstTime ? ' esttime' : '') + ($ctrl.isDuration ? ' duration' : '') + (from ? (' inline-block ' + from) : '') + '">' + content + '</table>';
                    }

                    function getTableContent() {
                       return getArrows(true) +
                        getInputs() +
                        getArrows(false) +
                        getLabels();

                        function getInputs() {
                            var el = '';
                            _.each($ctrl.listProp, function (prop, i) {
                                el += '<td class="text-center col form-group col' + prop + '">' +
                                    '<input autocomplete="off" autocorrect="off" id="input' + prop + '" class="time-control with-underline text-center" tabindex="' + ($ctrl.tabIndex + i + 1) + '" type="text" maxlength="2' +
                                    //(prop === 'minutes' && $ctrl.isDuration ? 3 : 2) +
                                    '" ' +
                                    //'readonly="readonly"' +
                                    '>' +
                                    getSep(prop) +
                                    //(($ctrl.isDuration || $ctrl.listProp.length - 1 === i) ? '' : ('<div class="separator"><div class="text-center">' + ($ctrl.isEstTime ? prop[0] : ':') + '</div></div>')) +
                                    '</td>';
                            });
                            return '<tr>' + el + '<tr>';

                            function getSep(prop) {
                                return ($ctrl.isEstTime || prop === 'hours' || $ctrl.isDuration || $ctrl.isDuration) ? ('<div class="separator"><div class="text-center">' + (
                                    $ctrl.isEstTime ? (isDur() ? getSemicolumn(prop) : prop[0]) : getSemicolumn(prop)
                                ) + '</div></div>') : '';
                            }

                            function hasSemicolumnAfter(prop) {
                                return (prop === 'hours' && $ctrl.hasProp.minutes ||
                                    prop === 'minutes' && $ctrl.hasProp.seconds ||
                                    prop === 'seconds' && $ctrl.hasProp.milliseconds)
                            }

                            function getSemicolumn(prop) {
                                return hasSemicolumnAfter(prop) ? ':' : '';
                            }
                        }

                        function getArrows(isUp) {
                            return '<tr class="text-center">' + $ctrl.listProp.map(function (prop) {
                                return '<td><a class="' + (prop === 'meridian' ? 'toggle' : (isUp ? 'increment' : 'decrement')) + prop + ' btn btn-link">' + getI('arrow-' + (isUp ? 'up' : 'down')) + '</a></td>';
                            }).join('') + '<tr>';
                        }

                        function getI(i) {
                            return $ctrl.LCS.getISBDiv(i, 2, 'sbf24 centered');
                        }

                        function getLabels() {
                            return ($ctrl.config.showMilliseconds || $ctrl.isRange) ? ('<tr class="text-center">' + $ctrl.listProp.map(function (prop) {
                                return '<td class="text-center font-size-12 semibold spacing-quarter-top">' +
                                    (prop === 'milliseconds' && $ctrl.isTimecode ? 'Frames' : $ctrl.CPS.capitalizeFirst(prop)) +
                                    '</td>';
                            }).join('') + '<tr>') : '';
                        }
                    }

                    function getBtns() {
                        if (!$ctrl.hasMoreVals && !$ctrl.hasRemove) {
                            return '';
                        }

                        var add = $ctrl.tabIndex + 4,
                            cls = 'btn btn-small transparent',
                            el = '',
                            l = $ctrl.initList ? $ctrl.initList.length : 0;

                        if (l && $ctrl.hasMoreVals) {
                            _.each($ctrl.initList, function (v, listIndex) {
                                el += '<a id="btnCustom' + listIndex + '" tabindex="' + (add + listIndex) + '" class="group-btns ' + cls + ' ' + (listIndex === 0 && (l > 1 || $ctrl.hasRemove) ? 'btn-left ' : '') + (listIndex !== 0 && ($ctrl.hasRemove || !$ctrl.hasRemove && l > 2) ? 'btn-center-hor ' : '') + (!$ctrl.hasRemove && listIndex === l - 1 ? 'btn-right ' : '') + ($ctrl.value && !$ctrl.value.isTime && $ctrl.value.value.toString() === v.val.toString() ? 'active' : '') + '" data-v="' + v.val + '">' + v.text + '</a>';
                            });
                        }

                        if ($ctrl.hasRemove) {
                            var tag = $ctrl.hasMoreVals ? 'a' : 'button';
                            el += '<' + tag + ($ctrl.hasMoreVals ? '' : ' type="button"') + ' id="btnRemove" tabindex="' + (add + ($ctrl.hasMoreVals ? l : 0)) + '" class="' + cls + ($ctrl.hasMoreVals ? ' group-btns btn-right' : ' full-width') + '">' + $ctrl.removeText + '</' + tag + '>';

                        }

                        return '<div class="margin-top-half btns-section text-center'+($ctrl.isRange ? ' margin-bottom-quarter' : '') +
                            ($ctrl.hasMoreVals && $ctrl.initList.length>4 ? ' lines-2' :'') +
                                '">' + el + '</div>';
                    }
                }

                function getStopwatch() {
                return '<div class="text-center stopwatch-wrapper">' +
                            '<span class="minutes">00</span>' +
                            ':<span class="seconds">00</span>' +
                            //':<span class="tens">00</span>' +
                        '</div>' +
                        '<div class="note-stopwatch">' + getItalicTextByState() + '</div>' +
                        '<div class="btns-section text-center">' +
                            '<button class="disabled reset ' + cls + '" data-type="resetDuration">Reset</button>' +
                            '<button class="start ' + cls + '" data-type="startDuration">Start</button>' +
                            '<button class="disabled apply ' + cls + '" data-type="applyDuration">Apply</button>' +
                        '</div>';
                }
            }
        }

        function getItalicTextByState(state) {
            if (state === 1) {// runs
                return 'Read the script now (only this row).</br>Press <b>Stop</b> when done.';
            } else if (state === 2) { //stopped
                return 'Great job! <b>Apply</b> this duration,<br/> or try it again.';
            }
            return 'Press <b>Start</b> and read your script aloud to estimate duration.';
        }

        function setItalicText(state) {
            var isStopped = state !== 1;
            var el = $ctrl.element.querySelector('.note-stopwatch');
            if(el) {
                el.innerHTML = getItalicTextByState(state);
            }
            el = $ctrl.element.querySelector('.btns-section button.start');
            if(el){
                el.innerText = isStopped ? 'Start' : 'Stop';
            }

            setBtn(state !== 2, 'reset', 'disabled');
            setBtn(state !== 2, 'apply', 'disabled');
            setBtn(!isStopped, 'start', 'stop');

            function setBtn(add, btn, cls) {
                $ctrl.LCS[add ? 'addClass' : 'removeClass']($ctrl.element.querySelector('button.' + btn), cls);
            }
        }

        function setDurationMethods() {
            if ($ctrl.isDuration) {
                $ctrl.startDuration = startDuration;
                $ctrl.applyDuration = applyDuration;
                $ctrl.resetDuration = resetDuration;
                $ctrl.swapTab = swapTab;
            }

            function swapTab(tab) {
                setTab(tab, true);
                setTab(tab.toString() === '1' ? 2 : 1, false);
                if (tab === 1) {//moving from stopwatch
                    resetDuration();
                }

                function setTab(tab, isActive) {
                    $ctrl.LCS[isActive ? 'addClass' : 'removeClass']($ctrl.element.querySelector('.customheader [data-info="' + tab + '"]'), 'active');
                    $ctrl.LCS[isActive ? 'removeClass' : 'addClass']($ctrl.element.querySelector('.customtab[data-info="' + tab + '"]'), 'sb-hide');
                }
            }

            function startDuration() {
                if (clearStopwatchInterval()) { //stop
                    setItalicText(2);
                } else { //start
                    $ctrl.stopWatchStarted = true;
                    $ctrl.stopwatchInterval = setInterval(startTimer, 10);

                    setItalicText(1);
                }

                function startTimer() {
                    setStopWatchVal('tens', ++$ctrl.stopwatch.tens);

                    if ($ctrl.stopwatch.tens > 99) {
                        setStopWatchVal('tens', 0);
                        setStopWatchVal('seconds', ++$ctrl.stopwatch.seconds);
                    }

                    if ($ctrl.stopwatch.seconds > 59) {
                        setStopWatchVal('seconds', 0);
                        setStopWatchVal('minutes', ++$ctrl.stopwatch.minutes);
                    }
                }
            }

            function applyDuration() {
                $ctrl.value = $ctrl.stopwatch.minutes * 60 + $ctrl.stopwatch.seconds;
                $ctrl.onSelect({result: {value: $ctrl.value, withClose: true}});

                clearStopwatchInterval();
            }

            function resetDuration() {
                $ctrl.stopwatch = {
                    tens: 0,
                    seconds: 0,
                    minutes: 0
                }
                for (var prop in $ctrl.stopwatch) {
                    setStopWatchVal(prop, 0);
                }
                clearStopwatchInterval();
                setItalicText();
            }

            function setStopWatchVal(prop, v) {
                if (!$ctrl.stopwatchEl) {
                    $ctrl.stopwatchEl = {};
                }
                $ctrl.stopwatch[prop] = v;
                if (!$ctrl.stopwatchEl[prop]) {
                    $ctrl.stopwatchEl[prop] = $ctrl.element.querySelector('.stopwatch-wrapper .' + prop);
                }
                if ($ctrl.stopwatchEl[prop]) {
                    $ctrl.stopwatchEl[prop].innerHTML = (v < 10 ? '0' : '') + v;
                }
            }
        }

        function clearStopwatchInterval() {
            if ($ctrl.stopWatchStarted) {
                $ctrl.stopWatchStarted = false;
                clearInterval($ctrl.stopwatchInterval);
                $ctrl.stopwatchInterval = null;

                return true;
            }
        }

        function updateInputs() {
            processMethodsRange(updateInputsSide);
        }

        function updateInputsSide(from) {
            updateTemplate(null, from);
            _.each($ctrl.listProp, function (prop){
                var p = getProp(prop, from),
                    el = $ctrl[p + 'InputEl'];
                if (el) {
                    el.value = $ctrl[p];
                }
            });
        }

        function bindClick(isBind) {
            bindInputs();

            set('#btnRemove', remove);

            _.each($ctrl.initList, function (v, listIndex) {
                set('#btnCustom' + listIndex, selectCustom);
            });

            function bindInputs() {
                processMethodsRange(process);

                function process(from) {
                    _.each($ctrl.listProp, function (prop) {
                        // only on non range
                        if (prop === 'meridian') {
                            setMethod($ctrl.element.querySelectorAll('.togglemeridian'), function (e){
                                toggleMeridian(from);
                            });
                        } else {
                            var cls = getTableCls(from);
                            set(cls + '.increment' + prop, function () {
                                increment(prop, true, from);
                            });
                            set(cls + '.decrement' + prop, function () {
                                increment(prop, false, from);
                            });
                        }
                    });
                }
            }

            function set(cls, m) {
                if (cls) {
                    setMethod($ctrl.element.querySelector(cls), m);
                }
            }

            function setMethod(el, m) {
                $ctrl.LCS.bindElementsClick(isBind, el, m);
            }
        }

        function selectCustom(e) {
            $ctrl.preventDefault(e);
            var el = e.target,
                v = el.getAttribute('data-v');
            el.setAttribute('disabled', 'disabled');
            refresh(null, true, {value: v, isTime: false});
        }

        function remove(e) {
            $ctrl.preventDefault(e);
            var el = e.target;
            el.setAttribute('disabled', 'disabled');
            refresh(null, true, {value: null});
        }

        function getValueFromTemplate(from){
            var v = {};
            _.each($ctrl.listProp, function (prop){
                if(prop !== 'meridian'){
                    if(prop === 'hours'){
                        // Get hours in 24H mode if valid
                        var hours = parseInt($ctrl.hours, 10),
                            valid = $ctrl.showMeridian ? (hours > 0 && hours < 13) : (hours >= 0 && hours < 24);
                        if (!valid || $ctrl.hours === '') {
                            return undefined;
                        }

                        if ($ctrl.showMeridian) {
                            if (hours === 12) {
                                hours = 0;
                            }
                            if ($ctrl.meridian === meridians[1]) {
                                hours = hours + 12;
                            }
                        }

                        v[prop] = hours;
                    } else {
                        var max = prop === 'minutes' && $ctrl.isDuration ? 100 : 60;
                        v[prop] = get60($ctrl[getProp(prop, from)], max);
                    }
                }
            });
            return v;

            function get60(v, max) {
                var m = parseInt(padMinutes(v), 10);
                return (m >= 0 && m < max) ? m : undefined;
            }
        }

        function isDefined(v, from) {
            if (!v) {
                v = getValueFromTemplate(from);
            }
            for (var prop in v) {
                if (!angular.isDefined(v[prop])) {
                    return false;
                }
            }
            return true;
        }

        function pad(value, noPad) {
             //var str = value && angular.isDefined(value) ? value.toString() : '';
             //return str && str.length < 2 && !noPad ? ('0' + str) : str;
            return value === null ? '' : (angular.isDefined(value) && value.toString().length < 2 && !noPad ? ('0' + value) : (value ? value.toString() : '0'));
        }

        function padMinutes(m) {
            if (!m && m !== 0) {
                return null;
            }
            return m.toString().length < 2 ? pad(m) : m;
            // return m.toString().length < 2 ? (m > 6 ? pad(m) :( m + '0')) : m;
        }

        function getTimeProps(){
            return ['hours', 'minutes', 'seconds', 'milliseconds'];
        }

        function getTimeVar(time, from) {
            var t = {};
            if (!time) {
                time = $ctrl.isRange ? $ctrl.time[from] : $ctrl.time;
            }
            if(time) {
                _.each(getTimeProps(), function (prop) {
                    t[prop] = _.find($ctrl.listProp, function (v) {
                        return v === prop;
                    }) ? getTimeProp(prop) : 0; //getHours
                });

                function getTimeProp(prop) {
                    return isDur() ? (time[prop]||0) : time['get' + $ctrl.CPS.capitalizeFirst(prop)]();//getHours
                }
            }
            return t;
        }

        function isDur(){
            return  $ctrl.isDuration || $ctrl.isTimecode;
        }

        function setTimeProp(prop, t, from) {
            var v = t[prop] || 0;
            if (isDur()) {
                if($ctrl.isRange && from){
                    $ctrl.time[from][prop] = v;
                } else{
                    $ctrl.time[prop] = v;
                }
            } else {
                $ctrl.time['set' + $ctrl.CPS.capitalizeFirst(prop)](v); //setHours
            }
        }


        function setViewValue() {
            var v = null;
            if ($ctrl.time) {
                if ($ctrl.isEstTime) {
                    if($ctrl.isRange){
                        var from = $ctrl.time.from ? getTimeToEstTime($ctrl.time.from) : null,
                            to = $ctrl.time.to ? getTimeToEstTime($ctrl.time.to) : null;
                        v = (from || to) ? {from: from, to : to} : null;
                    } else{
                        v = getTimeToEstTime($ctrl.time);

                    }
                } else {
                    var t = getTimeVar();
                    v = getTimeValue($ctrl.MomentService.getUTCMomentByFields(t.hours || 0, t.minutes || 0, t.seconds || 0, t.milliseconds || 0), true);
                }
            }

            if ($ctrl.hasRemove) {
                var el1 = $ctrl.element.querySelector('#btnRemove');
                if (el1) {
                    el1.removeAttribute('disabled');
                }
            }

            $ctrl.value = v ? v : null;
        }

        function getTimeToEstTime(time) {
            if (isDur()) {//in seconds(for duration) or ms (for timecode)
                var s = (time.hours || 0) * 3600 + (time.minutes || 0) * 60 + (time.seconds || 0);
                return  $ctrl.isDuration ? s : (s * 1000 + (time.milliseconds || 0)); //for timecode get in ms
            } else {//in hours ex: 1.5 = 1h 30m
                var p = time.getMinutes() / 60;
                if (p) {
                    p = Number((Math.round(p * 1000) / 1000).toFixed(3));
                }
                return time.getHours() + p;
            }
        }

        function setTimeValue(value, isTime) {
            $ctrl.value = getTimeValue(value, isTime);
        }

        function getTimeValue(value, isTime) {
            return value ? ($ctrl.hasMoreVals ? {isTime: isTime, value: value} : value) : null;
        }

        function updateHAndM(key, from) {
            var v = getValueFromTemplate(from);
            if (isDefined(v, from)) {
                setTimeVar(v);
                refresh(key, false, null, null, from);
            } else {
                var invalid = {};
                _.each($ctrl.listProp, function (prop) {
                    invalid[prop] = prop === 'meridian' ? undefined : (key === prop[0] ? true : undefined);
                });
                invalidate(invalid, from);
            }


            function setTimeVar(t) {
                if (!t) {return;}
                _.each($ctrl.listProp, function (prop) {
                    if (prop !== 'meridian') {
                        setTimeProp(prop, t, from);
                    }
                });
            }
        }

        function invalidate(invalid, from) {
            _.each($ctrl.listProp, function (prop, i){
                set(prop, invalid[prop]);
            });

            function set(prop, v) {
                var p = 'invalid' + getProp(prop, from);
                if (angular.isDefined(v) && $ctrl[p] !== v) {
                    $ctrl[p] = v;
                    setValidField($ctrl[prop + getInputEl(from)], $ctrl[p]);
                    setValidField($ctrl[prop + getColEl(from)], $ctrl[p], 'has-error');
                }
            }
        }

        function setValidField(field, isValid, cls) {
            $ctrl.LCS[isValid ? 'removeClass' : 'addClass'](field, cls ? cls : 'ng-invalid');
        }

        function selectEl(el) {
            if(el) {
                if (el.getAttribute('readonly')) {
                    el.removeAttribute('readonly');
                }
                el.select();
            }
        }

        // Call internally when we know that model is valid.
        function refresh(key, withClose, predef, from) {
            if (predef) {
                setTimeValue(predef.value, predef.isTime);
            } else {
                setViewValue();
            }

            var noFrom = $ctrl.isRange && !from;
            set(noFrom ? 'from' : from);
            if(noFrom) {
                set('to');
            }

            $ctrl.onSelect({result: {value: $ctrl.value, withClose: withClose}});

            function set(from) {
                makeValid(from);
                updateTemplate(key, from);
            }
        }


        function makeValid(from) {
            var invalid = {};
            _.each($ctrl.listProp, function (prop){
                invalid[prop] = true;
            });
            invalidate(invalid, from);
        }

        function updateTemplate(key, from) {
            var t = getTimeVar(null, from),
                h = $ctrl.isTimecode ? pad(t.hours) : t.hours;

            if ($ctrl.showMeridian) {
                h = h === 0 || h === 12 ? 12 : h % 12;
            }
            // Convert 24 to 12 hour system

            $ctrl[getProp('hours', from)] = key === 'h' ? h : pad(h, !$ctrl.showMeridian);
            if (key !== 'm') {
                $ctrl[getProp('minutes', from)] = pad(t.minutes);
            }
            if($ctrl.hasProp.seconds) {
                if (key !== 's') {
                    $ctrl[getProp('seconds', from)] = pad(t.seconds);
                }
            }
            $ctrl[getProp('meridian', from)] = t.hours < 12 ? meridians[0] : meridians[1];


            if($ctrl.hasProp.milliseconds) {
                $ctrl[getProp('milliseconds', from)] = pad(t.milliseconds);
            }
        }


        function addSeconds(v, from, prop) {
            var s, isDuration = isDur(),
               mult = getMSForProp(prop);
            if(isDuration) {
                var time = $ctrl.isRange ? $ctrl.time[from] : $ctrl.time;
                s = getTimeToEstTime(time) + ($ctrl.isTimecode && v < 0 && Math.abs(v) > time[prop] ? -time[prop] : v) * mult;
            } else {
                s = new Date($ctrl.time.getTime() + v * 1000 * mult);
            }
            var t = isDuration ? $ctrl.SBFieldMethods.getTimeFromSeconds(s, {
                    isDuration: $ctrl.isDuration,
                    isTimecode: $ctrl.isTimecode,
                    isRange: $ctrl.isRange,
                }, $ctrl.config) : getTimeVar(s, from); //getTime is in milliseconds

            _.each(getTimeProps(), function (prop) {
                $ctrl[getProp(prop, from)] = t[prop];
                setTimeProp(prop, t, from);
            });

            refresh(null, false, null, from);
            updateInputsSide(from);
        }

        function increment(prop, isUp, from) {
            if (prop === 'meridian') {
                toggleMeridian(from);
            } else {
                //console.log('increment ' +  prop +  (isUp?'up':'down'));
                addSeconds((isUp ? 1 : (-1)) * $ctrl.config[prop + 'Step'], from, prop);
            }
        }

        function getMSForProp(prop){
            var ms = $ctrl.isTimecode ? 1000 : 1;
                                        //12*60*60
           return prop === 'meridian' ? 43200 * ms : (prop === 'hours' ? 3600 * ms : (prop === 'minutes' ? 60 * ms : (prop === 'seconds' ? ms : 1)));
        }

        function toggleMeridian(from) {
            if (isDefined(getValueFromTemplate(from), from)) {
                addSeconds(getTimeVar(null, from).hours < 12 ? 1 : -1, from, 'meridian');
            }
        }
    }
}

angular.module('dropdowns.customInputDropdownMenu.component', [
])
//Location Name…
.component('sbInputDropdownMenu', {
    bindings: {
        drpClassAttr: '@?',
        fieldClass:'@?',
        fixedHeight: '@',
        header: '@',
        longer:'@?',
        type: '@?',
        placeholder: '@?',
        required: '@?',
        //variables:
        value: '<',
        onUpdate: '&',
    },
    controller: 'SBInputDrpMenuCtrl',
})
.controller('SBInputDrpMenuCtrl', SBInputDrpMenuCtrl);

SBInputDrpMenuCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];
function SBInputDrpMenuCtrl(TemplateCompileCompCtrlService, $element) {
    console.log('SBInputDrpMenuCtrl');
    var withoutTemplateScope = false;
    var $ctrl = this;

    $ctrl.save = save;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        $ctrl.formHolderItem = {};
        $ctrl.initVal = $ctrl.value;

        $ctrl.LCS.addClass($ctrl.element, 'dropdown-menu add-locations-popup display-block ' + ($ctrl.fixedHeight ? 'fixedHeight ' : '') + ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : ''));
        $ctrl.element.setAttribute('ui-keyup', "{'enter':'$ctrl.save()'}");
    }

    function getItemTemplate() {
        return ($ctrl.header ? ('<div class="header-small clearfix">'+$ctrl.header+'</div>') : '') +
                    '<form class="form-group field last" name="$ctrl.formHolderItem[$ctrl.formName]" class="formHolderItem auto" novalidate autocomplete="off">' +
                        '<input type="'+($ctrl.type?$ctrl.type:'text')+'" ' +
                        ($ctrl.placeholder?('placeholder="'+$ctrl.placeholder+'" '):'') +
                        ($ctrl.fieldClass?('class="'+$ctrl.fieldClass+'"'):'') +
                        ' name="name" ng-model="$ctrl.value" '+($ctrl.required==='true'?'required ':'')+'>' +
                        '<div ng-show="($ctrl.formHolderItem[$ctrl.formName].name.$dirty || $ctrl.formHolderItem[$ctrl.formName + \'_attempted\']) && $ctrl.formHolderItem[$ctrl.formName].name.$error.required" class="help-inline ng-hide" style="top: 30px;">This field is required</div>' +
                        '<button class="small-blue-btn btn primary with-margin-left" type="submit" ng-click="$ctrl.save(e)" ng-disabled="$ctrl.isUpdating">' +
                            '<div class="col20 pull-left" ng-show="$ctrl.isUpdating===true"><span class="sbf smaller loadingicon animate-spin"></span></div>' +
                            '<div>Save</div>' +
                        '</button>' +
                    '</form>';
    }

    function onLoaded() {
        $ctrl.element.querySelector('input').focus();
        $ctrl.btnSave =  $ctrl.element.querySelector('button.btn');
    }

    function save(e){
        $ctrl.preventDefault(e);
        if ($ctrl.isUpdating) {return;}

        $ctrl.error = null;
        $ctrl.formHolderItem[$ctrl.formName + '_attempted'] = true;
        if (!$ctrl.formHolderItem[$ctrl.formName] || !$ctrl.formHolderItem[$ctrl.formName].$valid) {
            return;
        }

        $ctrl.isUpdating = true;
        $ctrl.onUpdate({item: $ctrl.value, $event: e});
        $ctrl.isUpdating = false;
    }
}

angular.module('dropdowns.customInput.component', [
    'dropdowns.customInputDropdownMenu.component',
    'dropdowns.sbDropdown.controller.service'
])

.component('sbInputDropdown',  {
    bindings: {

        setInputField: '@?',
        minWidth:'@?',

        elementId: '@',
        text: '<',
        service: '<',
        onChange: '&',
        onCancel: '&',
    },
    template: getSBDropdownTemplate(),
    controller: 'SBInputDropdownCtrl',
})
.controller('SBInputDropdownCtrl', SBInputDropdownCtrl);
SBInputDropdownCtrl.$inject = ['SBFieldTypesService', 'SBFieldInitCtrlService', 'SBDrpInitCtrlService', '$element', '$attrs'];
function SBInputDropdownCtrl(SBFieldTypesService, SBFieldInitCtrlService, SBDrpInitCtrlService, $element, $attrs) {

    var withoutTemplateScope = true;


    var $ctrl = this;
    $ctrl.menuTag = 'sb-input-dropdown-menu';
    $ctrl.propType = SBFieldTypesService.PropTypes.InputDrp;
    $ctrl.$onDestroy = $onDestroy;

    $ctrl = new SBFieldInitCtrlService($ctrl, $element, $attrs, withoutTemplateScope);
    $ctrl.onInitFieldLoaded = onInitFieldLoaded;
    $ctrl.setDisplayValue = setDisplayValue;
    $ctrl.generateDrpMenuContent = generateDrpMenuContent;

    $ctrl.$onInit = $onInit;

    $ctrl.preselect = preselect;

    function $onInit() {
        $ctrl.inputText = null;
        $ctrl.withRepeatFromDrp = true;
        $ctrl = new SBDrpInitCtrlService($ctrl, $element);
    }

    function onInitFieldLoaded() {
        $ctrl.spanText = $ctrl.element.querySelector('#spanItemText');

        $ctrl.LCS.addClass($ctrl.spanText, 'empty');

        if ($ctrl.fieldClass) {
            $ctrl.LCS.addClass($ctrl.inputField, $ctrl.fieldClass);
            $ctrl.LCS.addClass($ctrl.spanText, $ctrl.fieldClass);
        }

        if ($ctrl.minWidth) {
            $ctrl.LCS.setCSSStyle($ctrl.spanText.style, 'min-width', $ctrl.minWidth);
        }

        $ctrl.LCS.addClass($ctrl.element, $ctrl.element.tagName.toLowerCase() +
            ' display-block clearfix wrap-dd-select ' +
            ($ctrl.cClassAttr ? $ctrl.cClassAttr : ''));

        $ctrl.onRepeatFieldLoaded();
    }

    function $onDestroy() {
        if ($ctrl.onInitDestroy) {
            $ctrl.onInitDestroy();
        }
    }

    function setDisplayValue() {
        console.log('setDisplayValue: input drp');
        $ctrl.spanText.innerHTML = $ctrl.value ? $ctrl.value : $ctrl.placeholder;
        $ctrl.LCS[$ctrl.value ? 'removeClass' : 'addClass']($ctrl.spanText, 'empty');
    }

    function preselect(result) {
        if(result){ $ctrl.setNewValue(result.e, result.value);}
    }

    function generateDrpMenuContent() {
        return {
            $ctrl: {
                value: angular.copy($ctrl.value),
                onSelect: $ctrl.onSelect,
            },
            template: ($ctrl.fixedHeight ? ("fixed-height='true' ") : '') +
                "value='::$ctrl.value' " +
                "on-select='$ctrl.onSelect(result)'>"
        };
    }
}

angular.module('dropdowns.sbDropdown.init.controller.service', [
    'group.sbPopoverInit.service'
])
.service('SBBaseDrpInitCtrlService', SBBaseDrpInitCtrlService);
SBBaseDrpInitCtrlService.$inject = ['SbPopoverInitService'];
function SBBaseDrpInitCtrlService(SbPopoverInitService) {
    return function ($ctrl, $element) {
            //get popover template
        if(!$ctrl.getPopoverTemplate) {
            $ctrl.getPopoverTemplate = getPopoverTemplate;
        }

        if(!$ctrl.onkeydown) {
            $ctrl.onkeydown = onkeydown;
        }

        if(!$ctrl.getDrpMenu) {
            $ctrl.getDrpMenu = getDrpMenu;
        }

        if(!$ctrl.getDrpMenu) {
            $ctrl.getAnchor = getAnchor;
        }

        if(!$ctrl.setDisplayValue) {
            $ctrl.setDisplayValue = setDisplayValue;
        }

        if(!$ctrl.onItemSelected) {
            $ctrl.onItemSelected = onItemSelected;
        }

        $ctrl.onBeforeClosePopover = onBeforeClosePopover;

        //overwrite the default from SBFieldInitCtrlService

        if(!$ctrl.nonClosedDrp && $ctrl.withRepeatFromDrp) {
            $ctrl.onRepeatFieldLoaded = onRepeatFieldLoaded;
        }

        $ctrl.removeDrpMenuEvents = removeDrpMenuEvents;

        $ctrl.existsIn = existsIn;

        $ctrl.onSBFieldInit();

        $ctrl.withoutOpenedDrp = true;
        $ctrl.active = null;
        $ctrl.activeIndex = -1;
        $ctrl.selectedId = null;

        if ($ctrl.parentContainer === undefined) {
            $ctrl.parentContainer = true;
        }else if($ctrl.parentContainer === 'false'){
            $ctrl.parentContainer = false;
        }

        $ctrl = new SbPopoverInitService($ctrl, $element);

        $ctrl.popperFieldClass = 'ank' + new ObjectId().toString();
        $ctrl.imgPaths = $ctrl.LCS.imgPath;

        if ($ctrl.multipleSelection === undefined) {
            $ctrl.multipleSelection = false;
        }

        $ctrl.selectModel = null;

        if(!$ctrl.labelField) {
            $ctrl.labelField = $ctrl.attrs.itemLabel ? $ctrl.attrs.itemLabel : 'text';
        }
        if(!$ctrl.valueField) {
            $ctrl.valueField = $ctrl.attrs.itemValue ? $ctrl.attrs.itemValue : 'value';
        }

        $ctrl.truncate = $ctrl.attrs.truncate ? parseInt($ctrl.attrs.truncate, 10) : 1000;

        $ctrl.underlineSelected = false;
        $ctrl.cols = {};
        $ctrl.isNotCustom = false;
        $ctrl.isLoaded = false;
        $ctrl.fieldSelector = $ctrl.anchorElement;

        $ctrl.getFromList = getFromList;
        $ctrl.setSelected = setSelected;
        $ctrl.setNewValue = setNewValue;

        $ctrl.getColumnsItems = getColumnsItems;

        $ctrl.onFieldFocus = onFieldFocus;

        if (!$ctrl.select) {
            $ctrl.select = select;
        }

        if(!$ctrl.preselect) {
            $ctrl.preselect = preselect;
        }

        if(!$ctrl.onSelect){
            $ctrl.onSelect = onSelect;
        }

        if (!$ctrl.getInputText) {
            $ctrl.getInputText = getInputText;
        }

        if (!$ctrl.getCompareItem) {
            $ctrl.getCompareItem = getCompareItem;
        }

        if (!$ctrl.getItems) {
            $ctrl.getItems = getItems;
        }

        if (!$ctrl.initMore) {
            $ctrl.initMore = initMore;
        }

        if(!$ctrl.onCloseDrp){
            $ctrl.onCloseDrp = onCloseDrp;
        }


        $ctrl.bindInitEvents = bindInitEvents;
        $ctrl.inputContentProp  = 'input';

        if($ctrl.preLoadList){
            $ctrl.preLoadList();
        }

        if($ctrl.onFieldTemplateLoaded){
            $ctrl.onFieldTemplateLoaded();
        }

        if($ctrl.additionalInit){
            $ctrl.additionalInit();
        }

        $ctrl.$onBaseInitDestroy = $onBaseInitDestroy;
        $ctrl.$element.on('$destroy', $onBaseInitDestroy);

        return $ctrl;

        function onRepeatFieldLoaded() {
            //console.log('onRepeatFieldLoaded from SBBaseDrpInitCtrlService');
            var l = $ctrl.list && $ctrl.list.length ? $ctrl.list.length : 0;
            if(!l){return;}
            var index = -1, selected = undefined;
            for (var i = 0; i < l; i++) {
                var el = $ctrl.list[i];
                if (el && el[$ctrl.valueField] === $ctrl.value) {
                    index = i; selected = el; break;
                }
            }
            $ctrl.setDisplayValue(selected, index);
        }

        function existsIn() {
            return {
                anchorElements: [$ctrl.inputField, $ctrl.element],
                drpMenu: [  $ctrl.drpMenu]
            };
        }

        function getPopoverTemplate() {
            var info = $ctrl.generateDrpMenuContent();
            return {
                $ctrl: info.$ctrl,
                template: '<'+$ctrl.menuTag+' ' +
                    'class="' + ($ctrl.menuTag && $ctrl.menuTag !== 'sb-dropdown-menu' ? $ctrl.menuTag : '') +
                        ' sb-dropdown-menu clearfix '+($ctrl.menuCls||'')+' ' +
                        ($ctrl.drpMenuCls ? $ctrl.drpMenuCls : '')+
                        //($ctrl.withSaveOnTouchScreen?'with-save-on-touch-screen' : '') +
                    '" ' +
                    ($ctrl.withSaveOnTouchScreen ? 'with-save-on-touch-screen="true" ' : '') +
                    'id="' + ($ctrl.drpMenuId ? $ctrl.drpMenuId : '') + '" ' +
                    ($ctrl.header ? ('header="' + $ctrl.header + '" ') : '') +
                    ($ctrl.subheader ? ('header="' + $ctrl.subheader + '" ') : '') +
                    ($ctrl.drpClassAttr ? ('drp-class-attr="' + $ctrl.drpClassAttr + '" ') : '') +

                    info.template +

                    '></'+$ctrl.menuTag+'>'
            };
        }

        function onItemSelected(result) {
            if (result) {
                if (result.active !== undefined) {
                    $ctrl.active = result.active;
                    $ctrl.activeIndex = result.$index;
                   // console.log('DRPHOVER_CHANGED hover=' + $ctrl.active + '; index=' + $ctrl.activeIndex);
                } else if (result.selected !== undefined) {
                    $ctrl.selectedId = result.item[$ctrl.valueField];
                  //  console.log('DRPHOVER_CHANGED selected=' + $ctrl.selectedId);
                    $ctrl.onSelect(result);
                }
            }
        }

        function onkeydown(e) {
            var l = $ctrl.list ? $ctrl.list.length : 0,
                hasItems = l > 0;
            switch (e.which) {
                case 27: //esc
                    $ctrl.closeDrp(e);//dont save and close
                    break;

                case  9: //tab -> make it save first and go next
                case 13: //enter  + tab next index
                    $ctrl.preventDefault(e);
                    if (!$ctrl.isSOpen) {
                        $ctrl.openDrp(e);
                    } else {
                        if ($ctrl.active) {
                            $ctrl.selectedId = $ctrl.active;
                        }
                        if (l && $ctrl.selectedId !== undefined) {
                //            $ctrl.select($ctrl.list[$ctrl.activeIndex], null, e);
                            $ctrl.onSelect({
                                item: $ctrl.list[$ctrl.activeIndex],
                                $index: $ctrl.activeIndex,
                                $event: e,
                                withClose: true
                            });
                        } else {
                            $ctrl.onTab(e);
                        }
                    }
                    break;

                case 40: // down
                    move(e, false);
                    break;

                case 38: // up
                    move(e, true);
                    break;


                default:
                    if ($ctrl.onMoreKeys) {
                        $ctrl.onMoreKeys(e);
                    } else {
                        $ctrl.preventDefault(e);
                    }
                    break;
            }

            function move(e, isUp){
                $ctrl.preventDefault(e);
                if (!$ctrl.isSOpen) {
                    $ctrl.openDrp(e);
                } else {
                    e.stopPropagation();
                    if (hasItems) {
                        if(isUp) {
                            $ctrl.activeIndex = ($ctrl.activeIndex ? $ctrl.activeIndex : l) - 1;
                        }else{
                            $ctrl.activeIndex = ($ctrl.activeIndex + 1) % l;
                        }
                        $ctrl.active = $ctrl.list[$ctrl.activeIndex][$ctrl.valueField];
                    } else {
                        $ctrl.activeIndex = -1;
                        $ctrl.active = null;
                    }
                    scrollToHighlighted($ctrl.activeIndex);
                }
            }
        }

        function scrollToHighlighted(i) {
            var sc = $ctrl.drpMenu;
            if (i > -1 && sc) {
                var option = sc.querySelectorAll('li');
                if (option && option.length > 0) {
                    option = option[i];
                    if (option) {
                        var styles = $ctrl.LCS.getElementStyles(option),
                            marginTop = parseFloat(styles.marginTop || 0),
                            marginBottom = parseFloat(styles.marginBottom || 0);

                        if (option.offsetTop + option.offsetHeight + marginBottom > sc.scrollTop + sc.offsetHeight) {
                            sc.scrollTop = option.offsetTop + option.offsetHeight + marginBottom - sc.offsetHeight;
                        }

                        if (option.offsetTop - marginTop < sc.scrollTop) {
                            sc.scrollTop = option.offsetTop - marginTop;
                        }
                    }
                }
            }
        }

        function removeDrpMenuEvents(){
            if (!$ctrl.inputField && $ctrl.drpMenu) {
                $ctrl.bindInitEvents(false);
            }
        }
        function getDrpMenu() {
            var tag = 'dropdown-menu';
            get(tag);
            if (!$ctrl.drpMenu) {
                get('parent-dropdown-menu');
            }
            if (!$ctrl.inputField && $ctrl.drpMenu) {
                $ctrl.inputField = $ctrl.drpMenu.querySelector($ctrl.anchorElement);
                $ctrl.bindInitEvents(false);
                $ctrl.bindInitEvents(true);
            }
            if (!$ctrl.drpMenu && $ctrl.$drpMenuContainer && $ctrl.$drpMenuContainer.tagName.toLowerCase().indexOf(tag) !== -1) {
                $ctrl.drpMenu = $ctrl.$drpMenuContainer;
            }

            function get(tag) {
                $ctrl.drpMenu = $ctrl.LCS.hasClass($ctrl.$drpMenuContainer, tag) ? $ctrl.$drpMenuContainer : $ctrl.$drpMenuContainer.querySelector('.'+tag);
            }
        }

        function getAnchor() {
            if (!$ctrl.popperAnchor) {
                $ctrl.popperAnchor = $ctrl.attrs.popupAnchor ? document.querySelector($ctrl.attrs.popupAnchor) : null;
                if ((!$ctrl.popperAnchor || !$ctrl.popperAnchor) && $ctrl.inputField) {
                    $ctrl.popperAnchor = $ctrl.element.querySelector('.' + $ctrl.popperFieldClass);
                }
            }

            return $ctrl.popperAnchor ? $ctrl.popperAnchor : $ctrl.element;
        }

        function bindInitEvents(isBind) {
            //console.log('bindDrpInitEvents: ' + $ctrl.elementId + ': ' + isBind);
            if ($ctrl.inputField) {
                $ctrl.LCS[isBind ? 'addClass' : 'removeClass']($ctrl.inputField, $ctrl.popperFieldClass);
                var ns = $ctrl.drpMenuId;
                if($ctrl.inputField.tagName === 'DIV') {
                    method($ctrl.onFieldFocus, ns);
                }else {
                    method($ctrl.onFieldFocus, ns, 'focus');
                }

                method($ctrl.keyDownEvent, ns, 'keyup paste');

                if ($ctrl.tabIndex) {
                    $ctrl.addRootWatcher('SET_FIELD_FOCUS_' + $ctrl.tabIndex, $ctrl.setFieldFocus);
                }
            }

            function method(m, nm, eventName){
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.inputField, m, nm, eventName);
            }
        }

        function onFieldFocus(e){
            //console.log('drp: on input focus ' );
            $ctrl.preventDefault(e);
            $ctrl.openDrp(e);
        }

        function select(selected, index, e) {
            var value = selected ? selected[$ctrl.valueField] : null;
            if ($ctrl.withUncheck && $ctrl.value === value) {
                value = null;
                selected = null;
                index = -1;
            }
            return setNewValue(e, value, selected, index);
        }

        function onSelect(result) {
            //console.log('SBBaseDrpInitCtrlService.onSelect');
            if (result) {
                var v = $ctrl.preselect(result);
                if (result.withClose || result.justSave) {
                    $ctrl.onCloseDrp(result.e, result.justSave );
                }
                return v;
            }
        }

        function preselect(result) {
            if($ctrl.preSelect){
                $ctrl.preSelect(result);
            }
           return $ctrl.select(result.item, result.$index, result.$event);
        }

        function setNewValue(e, value, selected, index) {
            if($ctrl.value !== value) {
                $ctrl.value = value;
                $ctrl.setDisplayValue(selected, index);
                return $ctrl.value;
            }
        }

        function setDisplayValue(selected, index) {
            //console.log('setDisplayValue: base drp');
            if (selected !== undefined && index !== undefined) {
                $ctrl.setSelected(selected, index);
            }
            if ($ctrl.setDisplayValueDrpOther) {
                $ctrl.setDisplayValueDrpOther(selected);
            }
        }

        function onCloseDrp(e, justSave) {
            //console.log('SBBaseDrpInitCtrlService.onCloseDrp');
            if($ctrl.save){
                var withClose = justSave ? false : true;
                $ctrl.save(e, withClose);
            }else{
                console.warn('parent for SBBaseDrpInitCtrlService must define $ctrl.save');
            }
        }

        function setSelected(el, i) {
            if(el) {
                $ctrl.getInputText(el);
                $ctrl.activeIndex = i;
                $ctrl.active = el[$ctrl.valueField];
            } else{
                $ctrl.activeIndex = null;
                $ctrl.active = null;
            }
        }

        function getFromList(list, id) {
            var f = [];
            for (var i = 0, l = list.length; i < l; i++) {
                var el = list[i];
                if (el._id === id) {
                    f.push(f);
                }
            }
            return f.length === 0 ? null : f;
        }

        function getInputText(el) {
            if ($ctrl.setInputField) {
                $ctrl.selectModel = el;
                var t = el ? el[$ctrl.labelField] : null;
                if (t && t.length > $ctrl.truncate) {
                    t = t.substring(0, $ctrl.truncate);
                }
                if (!t && $ctrl.search) {
                    t = $ctrl.search;
                }
                $ctrl.inputText = t;
                $ctrl.inputField.value = $ctrl.inputText;
                setInputWidth($ctrl.inputField, $ctrl.inputText);
            }
        }

        function setInputWidth(input, txt) {
            if ($ctrl.LCS.hasClass($ctrl.element, 'auto-width') && $ctrl.LCS.hasClass($ctrl.element, 'opendrp')) {
                var body = $ctrl.LCS.bodyElement,
                    temp = getResizer();
                if(!temp) {
                    $ctrl.LCS.appendChildFragment(body, '<div class="txtResizer sb-hide">' + (txt ? txt : '&nbsp;') + '</div>');
                       process(getResizer());
                } else {
                    temp.innerText = txt ? txt : '';
                    process(temp);
                }

                function process(temp) {
                    if (temp) {
                        var p = $ctrl.element.parentElement,
                            padding = 16 + ($ctrl.LCS.hasClass(p, 'without-padding') ? ($ctrl.LCS.hasClass(p, 'with-arrow') ? 36 : 24) : 0),
                            width = (temp.clientWidth + padding)  + 'px';
                        if (!input.style) {
                            input.style = {};
                        }
                        input.style.setProperty('width', width);
                       $ctrl.LCS.removeElement(temp);
                    }
                }

                function getResizer() {
                    var el = body.querySelector('.txtResizer');

                    if (el && $ctrl.LCS.hasClass(el, 'sb-hide')){
                        if(!el.style) {
                            el.style = {};
                        }
                        el.style.setProperty('opacity', '0');
                        el.style.setProperty('z-index', '-2');
                        el.style.setProperty('position', 'absolute');
                        el.style.setProperty('white-space', 'nowrap');
                        el.style.setProperty('word-break', 'keep-all');
                        $ctrl.LCS.removeClass(el, 'sb-hide');
                    }
                    return el;
                }
            }
        }

        function getCompareItem(item) {
            return item;
        }

        function getColumnsItems(list) {
            var colListItems = null, columns = 0, col;
            if (list && list.length > 2) {
                for (var i = 0, n = list.length; i < n; i++) {
                    var el = list[i];
                    if(el) {
                        if (el && el.isHeader && col !== el.col) {
                            col = el.col;
                        }
                        if (!colListItems) {
                            colListItems = {};
                        }
                        if (!colListItems[col]) {
                            colListItems[col] = [];
                            columns++;
                        }
                        colListItems[col].push(el);
                        if ($ctrl.value && el[$ctrl.valueField] === $ctrl.value) {
                            $ctrl.isNotCustom = true;
                        }
                    }
                }
            } else {
                columns = 1;
                colListItems = {1: list};
            }

            $ctrl.colListItems = colListItems;
            $ctrl.columns = columns;
        }

        function getItems(search) {
            $ctrl.isLoaded = false;
            $ctrl.active = null;
            $ctrl.activeIndex = -1;
            if (search) {
                var s = search.toLowerCase();
                var hasActive, index = -1;
                $ctrl.list = _.filter($ctrl.initList, function (item) {
                    for (var i = 0; i < $ctrl.searchFields.length; i++) {
                        var n = $ctrl.getCompareItem(item)[$ctrl.searchFields[i]];
                        if (!n) {
                            continue;
                        }
                        n = n.toLowerCase();

                        if (n && n.indexOf(s) !== -1) {
                            index ++;
                            if (!hasActive || (n === s && !$ctrl.multipleSelection)){
                                $ctrl.active = item[$ctrl.valueField];
                                $ctrl.activeIndex = index;
                                scrollToHighlighted($ctrl.activeIndex);
                                hasActive = true;
                            }
                            return true;
                        }
                    }
                    return false;
                });
            } else {
                $ctrl.list = $ctrl.dontShowEmptySearch ? null : $ctrl.initList;
            }

            var newStr = $ctrl.list && $ctrl.list.length > 0 ? JSON.stringify($ctrl.list) : null;
            if (!angular.equals($ctrl.strList, newStr)) {
                $ctrl.strList = newStr ? angular.copy(newStr) : null;
            }

            $ctrl.getColumnsItems($ctrl.list);
            $ctrl.search = search;
            $ctrl.isLoaded = true;
        }

        function initMore() {
            if (!$ctrl.list || $ctrl.list.length === 0) {
                return;
            }
            if ($ctrl.value !== undefined && !$ctrl.multipleSelection) {
                for (var i = 0, n = $ctrl.list.length; i < n; i++) {
                    var el = $ctrl.list[i];
                    if (el && el[$ctrl.valueField] === $ctrl.value) {
                        $ctrl.setSelected(el, i);
                        break;
                    }
                }
            }
            //else $ctrl.setSelected( $ctrl.list[0], 0, true);

            if($ctrl.startInFocus === 'true' || $ctrl.startInFocus === true ){
                $ctrl.openDrp();
            }
        }

        function onBeforeClosePopover(force){
            if(force || !$ctrl.nonClosedDrp){
                $ctrl.closeDrp();
            }
        }

        function $onBaseInitDestroy() {
            if ($ctrl.$onSbPopoverInitDestroy) {
                $ctrl.$onSbPopoverInitDestroy();
            }

            if($ctrl.onSBFieldDestroy){
                $ctrl.onSBFieldDestroy();
            }
        }
    }
}

angular.module('dropdowns.sbDropdown.controller.service', [
    'dropdowns.sbDropdown.init.controller.service'
])

.service('SBDrpInitCtrlService', SBDrpInitCtrlService);
SBDrpInitCtrlService.$inject = ['SBBaseDrpInitCtrlService', 'LCS'];
function SBDrpInitCtrlService(SBBaseDrpInitCtrlService, LCS) {
    return function($ctrl, $element) {

        $ctrl.isDRP = true;
        $ctrl.anchorElement = '.selected .dropdown-sel-text';
        $ctrl.scrollableContainerSelector = '.dropdown-menu';

        if ($ctrl.setInputField === undefined) {
            $ctrl.setInputField = true;
        }

        if(!$ctrl.setValue){
            $ctrl.setValue = setValue;
        }
        $ctrl.preLoadList = preLoadList;
        $ctrl.additionalInit = additionalInit;
        $ctrl.onInitDestroy = onInitDestroy;

        $ctrl.withSaveOnTouchScreen = LCS.isTouchScreen;

        /*if($ctrl.withSaveOnTouchScreen && $ctrl.dontClosePopoverOnClick === undefined ){
            $ctrl.dontClosePopoverOnClick = true;
        }*/

        $ctrl = new SBBaseDrpInitCtrlService($ctrl, $element);

        return $ctrl;

        function preLoadList() {
            $ctrl.getItems($ctrl.search);
        }

        function additionalInit() {
            $ctrl.initMore();
        }

        function onInitDestroy() {
            if ($ctrl.$onBaseInitDestroy) {
                $ctrl.$onBaseInitDestroy();
            }
        }

        function setValue(next) {
            if($ctrl.value && (
                (isArray($ctrl.value) && $ctrl.value.length === 0)
               //|| (typeof($ctrl.value) === 'string' && $ctrl.value.length === 0)
            )){
                $ctrl.value = null;
            }
            next();
        }
    }
}

angular.module('dropdowns.drpMenu.controller.service', [
])
.service('SBDrpMenuCtrlService', SBDrpMenuCtrlService);

SBDrpMenuCtrlService.$inject = ['TemplateCompileCompCtrlService'];
function SBDrpMenuCtrlService(TemplateCompileCompCtrlService) {
    //withoutTemplateScope removed
    return function ($ctrl, $element) {

        if(!$ctrl.getWithClose) {
            $ctrl.getWithClose = getWithClose;
        }
        if(!$ctrl.getJustSave) {
            $ctrl.getJustSave = getJustSave;
        }
        $ctrl.closePopover = closePopover;
        $ctrl.saveAndClosePopover = saveAndClosePopover;
        $ctrl.getSaveBtns = getSaveBtns;
        $ctrl.bindEl = bindEl;
        $ctrl.bindSave = bindSave;
        $ctrl.getItemById = getItemById;
        $ctrl.bindClick = bindClick;

        $ctrl.getIdFromEl = getIdFromEl;
        $ctrl.getIndexFromEl = getIndexFromEl;

        if(!$ctrl.onDefinedSelect) {
            $ctrl.onDefinedSelect = onDefinedSelect;
        }
        $ctrl.updateChecks = updateChecks;

        if(!$ctrl.select) {
            $ctrl.select = select;
        }

        if(!$ctrl.check) {
            $ctrl.check = check;
        }

        if(!$ctrl.preInit) {
            $ctrl.preInit = preInit;
        }

        if(!$ctrl.onLoaded) {
            $ctrl.onLoaded = onLoaded;
        }

        if(!$ctrl.onDestroy) {
            $ctrl.onDestroy = onDestroy;
        }

        var withoutTemplateScope = true;
        $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

        return $ctrl;

        function preInit() {
            $ctrl.withSaveOnTouchScreen = $ctrl.LCS.isTouchScreen;
            $ctrl.drpMenuId = $ctrl.element.getAttribute('id');

            $ctrl.itemClass = 'custom-checkbox';

            if($ctrl.preInitOther){
                $ctrl.preInitOther();
            }
        }

        function onLoaded() {
            //console.log('SBDrpMenuCtrlService.onLoaded');
            $ctrl.check();
            bindClick(false);
            $ctrl.LCS.timeout(function (){
                bindClick(true);
            }, 200);
            if ($ctrl.onLoadedOther) {
                $ctrl.onLoadedOther();
            }
        }

        function onDestroy() {
            bindClick(false);

            if($ctrl.onDestroyOther) {
                $ctrl.onDestroyOther();
            }
        }

        function getItemById(id, withIn) {
            return $ctrl.element.querySelector('.' + $ctrl.itemClass + '[data-id="' + id + '"]' + (withIn ? ' input' : ''));
        }

        function getIdFromEl(el) {
            return el.getAttribute('data-id');
        }

        function getIndexFromEl(el) {
            return parseInt(el.getAttribute('data-index'), 10);
        }

        function bindClick(isBind) {
            if(isBind){
                $ctrl.liEls = $ctrl.element.querySelectorAll('.' + $ctrl.itemClass);
            }
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.liEls, $ctrl.select, 'SBDrpMenu');
            //console.log('bindClick : ' + ($ctrl.liEls?$ctrl.liEls.length:0));
            $ctrl.bindSave(isBind);

            if($ctrl.bindOthers) {
                $ctrl.bindOthers(isBind);
            }
        }

        function select(e) {
            //console.log('select item');
           var target = e.currentTarget,
               index = $ctrl.getIndexFromEl(target),
               item = $ctrl.list[index];
            if (item) {
                var v = $ctrl.onDefinedSelect(item, index, e);
                if (v) {
                    $ctrl.value = v;
                }
                $ctrl.check();
            }
        }

        function getWithClose(){
            return $ctrl.withSaveOnTouchScreen ? false : ($ctrl.isCustom ? false : true);
        }

        function getJustSave(){
            return false;
        }

        function onDefinedSelect(item, index, e, onSuccess) {
            if($ctrl.onPredefinedSelect) {
                item = $ctrl.onPredefinedSelect(item, index, e);
            }
            var withClose = $ctrl.getWithClose();
            return $ctrl.onSelect({result: {
                item: item,
                $index: index,
                $event: e,
                withClose: withClose,
                    justSave: withClose ? false : $ctrl.getJustSave(),
            }});
        }

        function bindEl(isBind, el, select) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector(el), select);
        }

        function check() {
            $ctrl.updateChecks($ctrl.prevValue, $ctrl.value);
            $ctrl.prevValue = angular.copy($ctrl.value);
        }

        function updateChecks(previousId, id, cls) {
           /* if (!cls) {
                cls = $ctrl.activeClass;
            }*/
            if (previousId !== undefined) {
                var el = $ctrl.getItemById(previousId, $ctrl.withChecks);
                if (el) {
                    if ($ctrl.withChecks) {
                        el.removeAttribute('checked');
                    } else if(cls){ // dropdown change selected
                        $ctrl.LCS.removeClass(el, cls);
                    }
                }
            }
            if (id !== undefined) {
                var el = $ctrl.getItemById(id, $ctrl.withChecks);
                if (el) {
                    if ($ctrl.withChecks) {
                        el.setAttribute('checked', 'checked');
                    } else if(cls){ // dropdown change selected
                        $ctrl.LCS.addClass(el, cls);
                    }
                }
            }
        }

        function getSaveBtns() {
return $ctrl.withSaveOnTouchScreen ? ('<div class="divBtnSave spacing-half full-width">' +
    '<button id="btnSaveDrp" class="btn primary smallbtn small-btns" type="button" analytics-on analytics-action="Save"> Save</button>' +
    //'<span class="orsmall">or</span>' +
    //'<a id="btnCloseDrp" class="cancelsmall">Cancel</a>' +
    '</div>') : '';
        }

        function bindSave(isBind) {
            if($ctrl.withSaveOnTouchScreen) {
                $ctrl.bindEl(isBind, '#btnSaveDrp', $ctrl.saveAndClosePopover);
                //$ctrl.bindEl(isBind, '#btnCloseDrp', $ctrl.closePopover);
            }
        }

        function closePopover(e) {

        }

        function saveAndClosePopover(e) {

        }
    }
}

angular.module('dropdowns.autocompleteMenu.component', [
    'dropdowns.drpMenuWithHover.controller.service'
])
.component('autocompleteTextMenu', {
    bindings: {
        withSaveOnTouchScreen:'@',
        drpClassAttr: '@?',
        fixedHeight: '@',

        labelField: '@',
        valueField: '@',

        truncate: '@',
        itemClss: '@',

        //variables:
        strList: '<',
        value: '<',
        onSelect: '&',

        getItemDesc: '&',
    },
    template: '<ul class="dropdown-menu custom-dropdown-menu autocomplete-dropdown"></ul>',
    controller: 'AutocompleteTextMenuCtrl',
})
.controller('AutocompleteTextMenuCtrl', AutocompleteTextMenuCtrl);
AutocompleteTextMenuCtrl.$inject = ['SBDrpMenuWithHoverCtrlService', '$element'];

function AutocompleteTextMenuCtrl(SBDrpMenuWithHoverCtrlService, $element) {
    console.log('AutocompleteTextMenuCtrl');
    var $ctrl = this;

    $ctrl.preInitOtherHover = preInitOtherHover;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl.elementWrapper = $element[0].querySelector('.dropdown-menu');
    $ctrl = new SBDrpMenuWithHoverCtrlService($ctrl, angular.element($ctrl.elementWrapper));

    function preInitOtherHover() {
        $ctrl.itemClass = 'select-row';
        var cls =  ($ctrl.fixedHeight ? "fixedHeight " : '') +
            ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '');
        if(cls){
            $ctrl.LCS.addClass($ctrl.elementWrapper, cls);
        }
    }

    function getItemTemplate() {
        $ctrl.bindClick(false);
        if(!$ctrl.list ||!$ctrl.list.length){return '';}

        var el = '';
        var i = 0;
        _.each($ctrl.list, function (item) {
            var val = item[$ctrl.labelField];
            el += "<li class='dropdown-item " +
                    (item.hide ? 'sb-hide ' : '') +
                    (item.isHeader ? 'header-li' : $ctrl.itemClass)+
                "' "+
    (item.isHeader?'':("data-id='" + item[$ctrl.valueField] + "' data-index='" + (i++) + "'"))+
                ">";
            if (item.isHeader) {
                el += "<div class='header dropdown-item font-size-12 semibold'><span class='with-ellipsis'>" + val + "</span></div>"
            } else {
                el += "<a><div><span class='with-ellipsis'>" + getItemDesc(item) + "</span></div></a>";
            }

            el += "</li>";
        });
        return el;
    }

    function getItemDesc(item) {
        var nv = $ctrl.getItemDesc({item:item});
        return nv ? nv : item[$ctrl.labelField];
    }
}

angular.module('dropdowns.autocomplete.component', [
    'dropdowns.selector.controller.service',
    'dropdowns.autocompleteMenu.component'
])

.component('autocompleteText', sbFieldComponentParams('AutocompleteTextCtrl', sbDefaultDrpComponentParams({
    initListStr: '<',
    withAutoSelect: '@',
    withoutClear: '<?',
    search: '<',
    onTextChanged: '&'
}),'<div class="selected">' +
        '<input class="autocomplete-control {{::$ctrl.elemClass}}" type="text" id="{{::$ctrl.did}}" name="{{::$ctrl.did}}" required autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" placeholder="{{::$ctrl.placeholder}}" tabindex="{{::$ctrl.tabIndex}}">' +
        '<div class="cancel-search" ng-hide="::$ctrl.withoutClear"><a class="clear-search gray-lighter no-transition" ng-click="$ctrl.clearSearch($event)" ng-show="$ctrl.search"><span class="sbf delete-circle with-primary-hover"><span class="sbp p1"></span><span class="sbp p2"></span></span></a></div>' +
        '</div>'))
    .controller('AutocompleteTextCtrl', AutocompleteTextCtrl);
AutocompleteTextCtrl.$inject = ['SBSelectorInitCtrlService', 'SBFieldTypesService', 'SBFieldInitCtrlService', '$element', '$attrs'];

function AutocompleteTextCtrl(SBSelectorInitCtrlService, SBFieldTypesService, SBFieldInitCtrlService, $element, $attrs) {
  var withoutTemplateScope = false;

    var $ctrl = this;
    $ctrl.menuTag = 'autocomplete-text-menu';
    $ctrl.drpMenuCls = 'display-block position-relative';
    $ctrl.checkFields = 'initList';
    $ctrl.propType = SBFieldTypesService.PropTypes.Drp;
    $ctrl.dontShowEmptySearch = true;

    $ctrl.changedFieldsOther = ['initListStr'];
    $ctrl.$onDestroy = $onDestroy;

    $ctrl.preSelect = preSelect;

    $ctrl.onClear = onClear;
    $ctrl.onChangesOther = onChangesOther;

    $ctrl = new SBFieldInitCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

    $ctrl.anchorElement = '.autocomplete-control';
    $ctrl.scrollableContainerSelector = '.dropdown-menu';
    $ctrl.multipleSelection = false;

    $ctrl.onInitFieldLoaded = onInitFieldLoaded;
    $ctrl.generateDrpMenuContent = generateDrpMenuContent;

    $ctrl.onMoreKeysFinished = onMoreKeysFinished;
    $ctrl.onLoaded = onLoaded;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        console.log('AutocompleteText: $onInit');
        $ctrl.focusDelay = 402;
        if (!$ctrl.elemClass) {
            $ctrl.elemClass = 'form-control with-underline';
        }
        $ctrl.setInputField = true;
        $ctrl.withInitS = true;
        $ctrl.withAutoSelect = $ctrl.withAutoSelect === true || $ctrl.withAutoSelect === 'true';
        $ctrl.searchFields = [$ctrl.itemLabel];

        setList();

        $ctrl = new SBSelectorInitCtrlService($ctrl, null, $element);
    }

    function setList(){
        try{$ctrl.initList = JSON.parse($ctrl.initListStr);}catch(e){$ctrl.initList = [];}
    }

    function onInitFieldLoaded(){
        if($ctrl.search) {
            $ctrl.inputField.value = capitalizeFirstInEachWordFilter($ctrl.search);
        }
    }

    function capitalizeFirstInEachWordFilter(input){
        if(!input){return input;}

        var str = input.split(' ');

        for (var i = 0; i < str.length ;i ++){
            var res = str[i];
            str[i] = res.substring(0, 1).toUpperCase() + res.substring(1).toLowerCase();
        }
        return str.join(' ');
    }

    function onLoaded() {
        console.log('AutocompleteTextCtrl.onLoaded');
        $ctrl.initS();
    }

    function $onDestroy() {
        if($ctrl.onInitDestroy){$ctrl.onInitDestroy();}
        $ctrl.removeWatchers();
    }

    function onMoreKeysFinished(val) {
        $ctrl.search = val;
        $ctrl.onTextChanged({value: val});
    }

    function onClear() {
        $ctrl.onTextChanged({value: null});
    }

    function preSelect(result)  {
        if(result && result.item) {
            $ctrl.inputField.value = result.item.name;
        }
    }

    function generateDrpMenuContent() {
        return {
            $ctrl: $ctrl,
            template: ($ctrl.truncate ? "truncate='true' " :'')+
                ($ctrl.fixedHeight ? "fixed-height='true' " :'')+
                ($ctrl.itemClss?("item-clss='"+$ctrl.itemClss+"' "):'') +
                "label-field='"+$ctrl.labelField+"' " +
                "value-field='"+$ctrl.valueField+"' " +

                "str-list='$ctrl.strList' " +
                "value='$ctrl.active' " +
                'on-select="$ctrl.onItemSelected(result)" '
        };
    }

    function onChangesOther(changes) {
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i];
            if (field === 'initListStr') {
                var change = changes[field];
                if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                    setList();
                    $ctrl.search = $ctrl.element.querySelector('input').value;
                    if($ctrl.search === ''){
                        $ctrl.search = null;
                    }
                    $ctrl.getItems($ctrl.search);
                    break;
                }
            }
        }
    }
}

angular.module('dropdowns.selector.controller.service', [
    'dropdowns.sbDropdown.init.controller.service'
])
.service('SBSelectorInitCtrlService', SBSelectorInitCtrlService);
SBSelectorInitCtrlService.$inject = ['ListItemActionCtrlService', 'SBBaseDrpInitCtrlService'];
function SBSelectorInitCtrlService(ListItemActionCtrlService, SBBaseDrpInitCtrlService) {
    return function($ctrl, service, $element) {
        if (!$ctrl) {
            console.warn('parent for SelectorInitCtrl must define $ctrl');
        }

        if(!service){
            console.warn('parent for SelectorInitCtrl must define $ctrl.service');
        }else{
            $ctrl.service = service;
        }
        if (!$ctrl.anchorElement) {
            $ctrl.anchorElement = '.assignTalent';
        }
        if (!$ctrl.scrollableContainerSelector) {
            $ctrl.scrollableContainerSelector = '.selected-items-dropdown .selected-projects';
        }
        if (!$ctrl.searchFields) {
            $ctrl.searchFields = ['name'];
        }

        $ctrl.setInputField = false;

        if(!$ctrl.setValue){
            $ctrl.setValue = setValue;
        }
        $ctrl.preLoadList = preLoadList;
        $ctrl.additionalInit = additionalInit;
        $ctrl.onInitDestroy = onInitDestroy;
        $ctrl.initS = initS;

        if(!$ctrl.onSaveInit) {
            $ctrl.onSaveInit = onSaveInit;
        }

        $ctrl = new SBBaseDrpInitCtrlService($ctrl, $element);

        return $ctrl;

        function preLoadList() {
            $ctrl.id = $ctrl.objectType + 'Selector' + $ctrl.did;
            $ctrl.selectedClass = "selected-items-dropdown";
            $ctrl.hasAutoFocus = true;
            $ctrl.avatarSize = 'smaller';

            if(!$ctrl.onsearch){
                $ctrl.onsearch = onsearch;
            }
            $ctrl.onMoreKeys = onMoreKeys;
            $ctrl.clearSearch = clearSearch;

            if ($ctrl.addNew) {
                $ctrl.showNew = false;
                $ctrl.startNew = startNew;
            }
            $ctrl.initS();
        }

        function additionalInit() {
            if ($ctrl.initMore) {
                $ctrl.initMore();
            }

            capitalizeFirst();
        }

        function onInitDestroy() {
            if ($ctrl.$onBaseInitDestroy) {
                $ctrl.$onBaseInitDestroy();
            }
        }

        function clearSearch(e) {
            $ctrl.preventDefault(e);
            $ctrl.search = null;
            $ctrl.inputField.value = null;
            $ctrl.selectedId = null;
            $ctrl.activeIndex = -1;
            $ctrl.active = null;
            $ctrl.getItems();
            if($ctrl.onClear){
                $ctrl.onClear();
            }
            $ctrl.setFieldFocus();
        }

        function onsearch(e, search) {
            console.log('onsearch');
            if (!$ctrl.isSOpen) {
                $ctrl.openDrp(e);
            }
            $ctrl.getItems(search);
        }

        function onSaveInit(result) {
            console.log('onSaveInit');
            return typeof ($ctrl.onCustomSelectorInitSave) === 'function' ? $ctrl.onCustomSelectorInitSave(result) : onSave(result);
        }

        function startNew(val, e) {
            $ctrl.preventDefault(e);
            $ctrl.showNew = val;
            if ($ctrl.showNew) {
                $ctrl.item = $ctrl.getNew();
                $ctrl.extraParam = {service: $ctrl.service};
                if ($ctrl.scriptLoadingService) {
                    $ctrl.extraParam.scriptLoadingService = $ctrl.scriptLoadingService;
                }
                $ctrl.type = 'Create';
                $ctrl = new ListItemActionCtrlService($ctrl);

                $ctrl.setFocus();

                $ctrl.onSave = $ctrl.onSaveInit;
            }

            function onSave(result) {
                var item = result ? result.item : null;
                if (item) {
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.objectType + '-selector.Create.success', 'success', {name: item.name});

                    if (!_.find($ctrl.initList, {_id: item._id})) {
                        $ctrl.initList.push(item);
                        $ctrl.initS();
                    }
                }else {
                    $ctrl.item = $ctrl.getNew();
                }
                if ($ctrl.onAddNew) {
                    $ctrl.onAddNew(result);
                }
                $ctrl.showNew = false;
               // var div = $ctrl.element.querySelector('.listitems-selector');
              //  div.animate({scrollTop: div[0].scrollHeight}, 400);
            }
        }

        function initS() {
            if (!$ctrl.initList) {
                $ctrl.initList = [];
            }
            $ctrl.getItems($ctrl.search);
            if ($ctrl.addNew) {
                $ctrl.item = $ctrl.getNew();
            }
        }

        function capitalizeFirst() {
            if ($ctrl.attrs.capitalize) {
                var val = $ctrl.inputField.value;
                if (val) {
                    $ctrl.inputField.value = $ctrl.capitalizeFirst(val);
                }
            }
        }

        function onMoreKeys(e) {
            console.log('onMoreKeys');
            var val = e.currentTarget.value;
            capitalizeFirst();

            if ($ctrl.onMoreKeysFinished) {
                $ctrl.onMoreKeysFinished(val);
            }
            $ctrl.onsearch(e, val);
        }

        function setValue(next) {
            next();
        }
    }
}


angular.module('dropdowns.dayTimeDropdown.component', [
    'dropdowns.pageDropdown.controller.service'
])
.component('sbDayTimeDropdown', sbPageDrpComponentParams('DayTimeDrpCtrl'))
