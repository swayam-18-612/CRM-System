             case 'vfx':
             case 'makeup':
             case 'costumes':
             case 'wrap':
             case 'extras':
                 return 3;*/

            default:
                return 2;
        }
    }

    _this.isRetina = function isRetina(){
        var mediaQuery = "(-webkit-min-device-pixel-ratio: 1.5),\
            (min--moz-device-pixel-ratio: 1.5),\
            (-o-min-device-pixel-ratio: 3/2),\
            (min-resolution: 1.5dppx)";
        return ((window.devicePixelRatio > 1 || window.matchMedia && window.matchMedia(mediaQuery).matches)) ? true : false;
    }

    _this.convertHtmlToText = function (html){
        // Create a new div element
        var d = document.createElement("div");

        // Set the HTML content with the given value
        d.innerHTML = html;

        // Retrieve the text property of the element
        return d.textContent || d.innerText || "";
    }

    _this.setElementText = function(el, val, isHidden){
        if(el){
            el[isHidden ? 'innerText' : 'textContent'] = val;
        }
        //textContent is faster then innerText
        //Using "textContent" will return the complete text content, including the hidden text.
        //However, using "innerText" will only return the visible text content, excluding the hidden text.
    }

    _this.getElementStyles = function (el) {
        if (el instanceof HTMLElement) {
            if (el.ownerDocument && el.ownerDocument.defaultView.opener) {
                return el.ownerDocument.defaultView.getComputedStyle(el);
            } else {
                return window.getComputedStyle(el);
            }
        } else {
            return {};
        }
    }

    _this.onFieldChanges = function(changes, changedFields, method){
        for (var i = 0, l = changedFields && changedFields.length; i < l; i++) {
            var field = changedFields[i],
                change = changes[field];
            if (shouldChange(change) && method(field, change)) {
                break;
            }
        }

        function shouldChange(change) {
            var isFirstChange = change && typeof (change.isFirstChange) === 'function' ? change.isFirstChange() : false;
            return change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !isFirstChange;
        }
    }

    _this.setTimeout = function(m, ms){
        setTimeout(m, ms || 0);

    }

    _this.encodeHTML = function (v){
        return v ? v.replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;') : '';
    }

    _this.timeout = function(m, ms) {
        return ms !== undefined ? _this.$timeout(m, ms) : _this.$timeout(m);
    }

    _this.cancelTimeout = function(timer){
        _this.$timeout.cancel(timer);
    }

    _this.bindElementsClick = function(isBind, el, method, namespace, events, options) {
        return _this.ELS.bindElementsClick(isBind, el, method, namespace,  (events ? events : _this.clickEvent), options);
    }


    _this.FullscreenService.$on('FBFullscreen.change', _this.onFullscreenChanged);

    _this.getPreloaderCenter = function(){
       return '<div class="h-full table-div centered-preloader full-width display-block full-width clearfix"><div class="centered"><div><div class="loadFacebookWrapper"><div class="sbLdsEllipsis"><div class="lds-ellipsis"><div></div><div></div><div></div><div></div></div></div></div></div></div></div>';
    }
    _this.SidebarTypes = {
        News: 1,
        PageFilters: 2,  ListFilters:8,
        PageTasks: 3, ListTasks: 6,
        PageComments: 5, ListComments: 4,
        PageArchived: 7, ListArchived:9,
    }
    return _this;

    function hexToRgba(hex, opacity) {
        var result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
        return result ? ('rgb' + (opacity ? 'a' : '') + '(' +
            parseInt(result[1], 16) + ',' +
            parseInt(result[2], 16) + ',' +
            parseInt(result[3], 16) +
            (opacity ? (',' + opacity) : '') +
            ')') : null;
    }
}

angular.module('services.listSorting', [
    'sceneNumber.service'
])
.service('ListSortingService', ListSortingService);
ListSortingService.$inject = ['SceneNumberService'];
function ListSortingService(SceneNumberService) {
    var _this = this;
    _this.sortList = sortList;
    _this.compareBasedOnScene = SceneNumberService.compareBasedOnScene;
    _this.getSceneNumber = SceneNumberService.getSceneNumber;
    return _this;

    function sortList(list, orderProp) {
        var order = 'order', order1, multiply = 1, multiply1, multiply2,order2;
        var i = 0;
        if(!orderProp){orderProp = {order:1};}
        if(orderProp) {
            for (var prop in orderProp) {
                if(i === 0){
                    order = prop;
                    multiply = orderProp[prop];//1
                } else if (i === 1) {
                    order1 = prop;
                    multiply1 = orderProp[prop];//2
                }else{
                    order2 = prop;
                    multiply2 = orderProp[prop];//3
                }
                i++;
            }
        }
        if(i === 3){
            //ex season + name
            list = list.map(function (item){
                  item.order2 = (item[order1] || '') + (item[order2] || '');
                return item;
            });
            order1 = 'order2';
            i = 2;
        }

        var s = order.split('.'),
            l = s.length;

        return list.sort(i === 2 ? sortBy2Props : sortDefault);

        function sortDefault(a, b) {
            return sortDefaultByProp(a, b, order, multiply);
        }

        function sortDefaultByProp(a, b, order, multiply) {
            return comp(defaultMethod(a, order), defaultMethod(b, order), multiply);
        }

        function sortBy2Props(x, y) {
            var rx = x[order],
                ry = y[order];
            if (rx !== ry) {
                return sortDefaultByProp(x, y, order, multiply);
            }
            return sortDefaultByProp(x, y, order1, multiply1);
        }

        function defaultMethod(a, order) {
            var v;
            if (l <= 1) {
                v = a && a[order] !== undefined && a[order] !== null ? a[order] : 1000;
            } else {
                v = a && a[s[0]] ? a[s[0]][s[1]] : null;
            }
            if (typeof (v) === 'string') {
                v = v.toLowerCase();
            }
            return (v === null || v === undefined) ? 1000 : v;
        }

        function getIntFromString(c) {
            if (c === undefined || c === null) {
                return 0;
            }
            var m = (c + '').match(/\d+/);
            if (!m) {
                return 0;
            }
            return parseInt(m[0], 10);
        }
    }

    function comp(a, b, multiply, next) {
        if (multiply === undefined) {
            multiply = 1;
        }
        if (a > b) {
            return 1 * multiply;
        } else if (a < b) {
            return -1 * multiply;
        } else {
            return next ? next() : 0;
        }
    }

    function sortList1(list, order, isDesc) {
        var sortingMethod, s, l,
            multiply = isDesc ? -1 : 1;
        if (order === 'scriptPosition') {
            sortingMethod = sortingByScene;
        } else {
            s = order.split('.');
            l = s.length;
            sortingMethod = sortDefault;
        }

        return list.sort(sortingMethod);

        function sortDefault(a, b) {
            return comp(defaultMethod(a, order), defaultMethod(b, order), multiply);
        }

        function sortingByScene(a1, b1) {
            return _this.compareBasedOnScene(_this.getSceneNumber(a1.scene), _this.getSceneNumber(b1.scene), isDesc);
        }

        function defaultMethod(a, order) {
            var v;
            if (l <= 1) {
                v = a && a[order] !== undefined && a[order] !== null ? (order === 'scriptPosition' ? getIntFromString(a[order]) : a[order]) : 1000;
            } else {
                v = a && a[s[0]] ? a[s[0]][s[1]] : null;
            }
            if (typeof (v) === 'string') {
                v = v.toLowerCase();
            }
            return (v === null || v === undefined) ? 1000 : v;

            function getIntFromString(c) {
                if (c === undefined || c === null) {
                    return 0;
                }
                var m = (c + '').match(/\d+/);
                if (!m) {
                    return 0;
                }
                return parseInt(m[0], 10);
            }
        }
    }
}

angular.module('services.localizedMessages', [])
.factory('localizedMessages', localizedMessagesFactory);

localizedMessagesFactory.$inject = ['$interpolate', 'I18N.MESSAGES'];
function localizedMessagesFactory($interpolate, i18nmessages) {
    var handleNotFound = function (msg, msgKey) {
        return msg || '?' + msgKey + '?';
    };

    var messages =  {
        get : function (msgKey, interpolateParams) {
            var msg =  i18nmessages[msgKey];
            if (msg) {
                return $interpolate(msg)(interpolateParams);
            } else {
                return handleNotFound(msg, msgKey);
            }
        },

        getFromError : function (error, msgKey, interpolateParams) {
            var message = messages.get(msgKey, interpolateParams),field;
            if(error){
                if(typeof(error) === "string"){
                    message =  error ;
                } else if(error.fieldValidationMessages){
                    message = '';
                    for( field in error.fieldValidationMessages){
                        message += error.fieldValidationMessages[field] + '; ' ;
                    }
                    if(message.length > 0){
                        message = message.substring(0, message.length-2);
                    }
                } else if(error.name === 'ValidationError') {
                    for ( field in error.errors) {
                        var er = error.errors[field];
                        message +=  ' ' + (typeof(er) ==='string' ? er : er.message);
                    }
                }else if(error.message){
                    message +=  ': ' + error.message ;
                }
            }
            return message;
        }
    };
    return messages;
}
angular.module('moment.service', [
])
.service('MomentService', MomentService);
MomentService.$inject = [];
function MomentService() {

    var service = {
        utc: moment.utc,
        getMomentNow: getMomentNow,
        getUtcMomentNow: getUtcMomentNow,
        getUTCMomentByFields: getUTCMomentByFields,
        getUtcMomentDefaultStartDay: getUtcMomentDefaultStartDay,
        getUtcMoment: getUtcMoment,
        getUtcMomentStartDay: getUtcMomentStartDay,
        getUtcMomentEndDay: getUtcMomentEndDay,
        getUtcDateNow: getUtcDateNow,
        getMomentFromDate: getMomentFromDate,
        getUtcDateNowNextYear: getUtcDateNowNextYear,
        getUtcMomentFromTimeMoment: getUtcMomentFromTimeMoment,
        getUtcMomentFromDateMoment: getUtcMomentFromDateMoment,
        getUtcMomentNowFromTimeMoment: getUtcMomentNowFromTimeMoment,
        getDateISOFromMoment: getDateISOFromMoment,
        stringToUTCMoment: stringToUTCMoment,
        isUpcomingDate: isUpcomingDate,
        getUTCMomentNextDay:getUTCMomentNextDay,
        getUtcMomentCopy: getUtcMomentCopy,
        getDateFromMoment: getDateFromMoment,
        getMomentFromString: getMomentFromString,
        getTimestamp: getTimestamp,
        getNextHourTimestamp: getNextHourTimestamp,
        getUtcMomentCopyWithTime: getUtcMomentCopyWithTime
    };

    return service;

    function getMomentNow() {
        return new moment();
    }
    function getTimestamp(momentDate) {
        return parseInt((momentDate ? moment.utc(momentDate) : moment.utc()).format('x'),10);
    }
    function getNextHourTimestamp() {
        var d = moment().add(1, 'h');
        return parseInt(d.utc().format('x'),10);
    }

    function isUpcomingDate(date){
        return moment.utc().isBefore(date);
    }

    function getDateISOFromMoment(date){
        var hours = date.hours().toString();
        if (hours.length === 1) {
            hours = '0' + hours;
        }
        var minutes = date.minutes().toString();
        if (minutes.length === 1) {
            minutes = '0' + minutes;
        }
        return date.format('YYYY-MM-DD') + 'T' + hours + ':' + minutes + ':00Z'; //2016-01-30T08:00:00Z

    }
    function getUtcMomentNow(){
        return new moment.utc();
    }
    function getMomentFromString(val){
        return val._isAMomentObject ? val : (typeof(val) ==='string' ? moment(val) : val);
    }

    function getUtcMomentCopy(m) {
        if(!m){return null;}
        return new moment.utc({
            date: m.date(),
            month: m.month(),
            year: m.year(),

            hours: m.hours(),
            minutes: m.minutes(),

            seconds: m.seconds(),
            milliseconds: 0
        });
    }

    function getUtcMomentCopyWithTime(v) {
        if (!v) {
            return null;
        }
        var m = v.value, t = v.hasTime;
        return {
            value: m ? new moment.utc({
                year: m.year(),
                month: m.month(),
                date: m.date(),
                hours: t ? m.hours() : 0,
                minutes: t ? m.minutes() : 0,
                seconds: 0,
                milliseconds: 0
            }) : null,
            hasTime: t
        }
    }
    function getUTCMomentNextDay(dateMoment) {
        if(dateMoment){
            dateMoment = stringToUTCMoment(dateMoment);
        } 
        return new moment.utc({
            date: dateMoment.date(),
            month: dateMoment.month(),
            year: dateMoment.year(),

            hours: dateMoment.hours(),
            minutes: dateMoment.minutes(),

            seconds: 0,
            milliseconds: 0
        });
    }
    function getMomentFromDate(d) {
       return getUtcMomentNow().date(d.getDate()).month(d.getMonth()).year(d.getFullYear()).hours(0).minutes(0).seconds(0).milliseconds(0);
    }

    function getUtcDateNow() {
        return getDateFromMoment(getUtcMomentNow());
    }

    function getUtcDateNowNextYear(){
        return getDateFromMoment( getUtcMomentNow().add(1, 'years'));
    }
    
    function getDateFromMoment(m, format) {
        return m ? (format ? m.toDate(format) : m.toDate()) : null;
    }

    function getUTCMomentByFields(h, m, s, ms){
        return new moment.utc().hours(h).minutes(m).seconds(s||0).milliseconds(ms||0);
    }

    function getUtcMomentDefaultStartDay(date){
        var mom = date ? new moment.utc(date) : new moment.utc();
        return mom.hours(7).minutes(0).seconds(0).milliseconds(0);
    }

    function getUtcMoment(date, withNull){
        return date ? (new moment.utc(date).milliseconds(0)) : (withNull ? null : getUtcMomentDefaultStartDay());
    }

    function getUtcMomentStartDay(date){
        var mom = date ? new moment.utc(date) : new moment.utc();
        return mom.startOf('day');
        //.hours(0).minutes(0).seconds(0).milliseconds(0);
    }

    function getUtcMomentEndDay(date){
        var mom = date ? new moment.utc(date) : new moment.utc();
        return mom.endOf('day');
        //.add(1, 'day');
        //hours(23).minutes(59).seconds(59).milliseconds(999); //
    }

    function getUtcMomentFromTimeMoment(timeMoment, defaultTimeMoment) {
        if(timeMoment){
            timeMoment = stringToUTCMoment(timeMoment);
        }
        return new moment.utc({
            hours: timeMoment ? timeMoment.hours() : (defaultTimeMoment ? defaultTimeMoment.hours() : 7),
            minutes: timeMoment ? timeMoment.minutes() : (defaultTimeMoment ? defaultTimeMoment.minutes() : 0),

            seconds: 0,
            milliseconds: 0
        });
    }

    function getUtcMomentNowFromTimeMoment(timeMoment, defaultTimeMoment) {
        if(timeMoment){
            timeMoment = stringToUTCMoment(timeMoment);
        }
        var m = getUtcMomentNow();
        return new moment.utc({
            date: m.date(),
            month: m.month(),
            year: m.year(),

            hours: timeMoment ? timeMoment.hours() : (defaultTimeMoment ? defaultTimeMoment.hours() : 7),
            minutes: timeMoment ? timeMoment.minutes() : (defaultTimeMoment ? defaultTimeMoment.minutes() : 0),

            seconds: 0,
            milliseconds: 0
        });
    }

    function getUtcMomentFromDateMoment(dateMoment, defaultTimeMoment) {
        if(!dateMoment){return null;}
        if(defaultTimeMoment){
            defaultTimeMoment = stringToUTCMoment(defaultTimeMoment);
        }
        if(dateMoment){
            dateMoment = stringToUTCMoment(dateMoment);
        }
        return new moment.utc({
            month: dateMoment.month(),
            year: dateMoment.year(),
            date: dateMoment.date(),

            hours: defaultTimeMoment ? defaultTimeMoment.hours() : 7,
            minutes: defaultTimeMoment ? defaultTimeMoment.minutes() : 0,

            seconds: 0,
            milliseconds: 0
        });
    }

    function stringToUTCMoment(value, hasMoreVals) {
        if (!value) {
            return null;
        }
        if(!hasMoreVals){
            if (!value._isAMomentObject) {
                value = getUtcMoment(value);
            }
        }else if(value.isTime){
            if (value.value && !value.value._isAMomentObject) {
                try {
                    value.value = getUtcMoment(value.value);
                }catch (e) {

                }
            }
        }
        return value;
    }
}

angular.module('services.notifications', [
    'services.soundEffects'
])
.factory('NotificationsService', NotificationsService);
NotificationsService.$inject = ['RootEventsService', 'soundEffectService', '$interval'];
function NotificationsService(RootEventsService, soundEffectService, $interval) {
    var lists = {
        'STICKY': [],
        'ROUTE_CURRENT': [],
        'ROUTE_NEXT': []
    };
    var interval, isProcessing = false, watchers = [];
    var service = {
        ttl: 3000,
        soundEffectsTypes: soundEffectService.getSoundTypes(),
        NOTES_TYPES: {
            ERROR: 'error',
            SUCCESS: 'success',
            WARNING: 'warning',

            ONLINE: 'online',
            OFFLINE: 'offline',
        }
    };
 
    service.playSound = playSound ;
    service.getCurrent = getCurrent ;
    service.pushSticky = pushSticky ;
    service.pushForCurrentRoute = pushForCurrentRoute ;
    service.pushForNextRoute = pushForNextRoute ;
    service.remove = remove ;
    service.removeOne = removeOne ;
    service.removeAll = removeAll ;
    service.start = start ;
    service.stop = stop ;

    RootEventsService.addRootWatcher(watchers, '$routeChangeSuccess', onRouteChangesSuccess);

    return service;
     
    function addNotification (listsArray, notificationObj) {
        if (!angular.isObject(notificationObj)) {
            throw new Error("Only object can be added to the notification service");
        }
        notificationObj.id = new Date().getTime();
        //service.playSound (notificationObj, true);
        listsArray.push(notificationObj);

        return notificationObj;
    } 

    function onRouteChangesSuccess() { 
        lists.ROUTE_CURRENT.length = 0;
        lists.ROUTE_CURRENT = angular.copy(lists.ROUTE_NEXT);
        lists.ROUTE_NEXT.length = 0;
    }

    function playSound(notificationObj, isAdd) {
        var soundType = {};
        switch (notificationObj.type) {
            case service.NOTES_TYPES.ERROR:
            case service.NOTES_TYPES.SUCCESS :
            case service.NOTES_TYPES.WARNING :
                soundType.type = isAdd ? service.soundEffectsTypes.ADD_TOAST :
                    service.soundEffectsTypes.REMOVE_TOAST;
                break;
        }
        if (soundType.type !== null) {
            return soundEffectService.play(soundType);
        }
    }

    function getCurrent() {
        return [].concat(lists.STICKY, lists.ROUTE_CURRENT);
    }

    function pushSticky(notification) {
        notification.isSticky = true;
        return addNotification(lists.STICKY, notification);
    }

    function pushForCurrentRoute(notification) {
        return addNotification(lists.ROUTE_CURRENT, notification);
    }

    function pushForNextRoute(notification) {
        return addNotification(lists.ROUTE_NEXT, notification);
    }

    function remove() {
        if(isProcessing){return;}
        isProcessing = true;
        var now = new Date().getTime(), empty;
        for (var prop in lists) {
            empty =  processList(lists[prop], prop);
        }
        if(empty){isProcessing = false;}

        function processList(listsByType, prop) {
            var l = listsByType.length;
            if(!l){return true;}
            for (var i = l-1; i >= 0; i--) {
                process(listsByType[i], i);
              /*  if(l>1&&i!==l-1){
                    process(listsByType[i], i);
                }*/
            }

            function process(notification, i) {
                if (notification && (now - notification.id > service.ttl)) {//remove all lists older than 3s ttl
                    //console.log('service:remove by ttl');
                    removeNotification(notification, prop, i);
                }
            }
        }
    }

    function removeOne(item) {
        //console.log('service:removeOne start');
        var exists;
        for (var prop in lists) {
            var listsByType = lists[prop];
            var l = listsByType.length;
            if(!l){continue;}
            for (var i = l-1; i >= 0; i--) {
                var notification = listsByType[i];
                if (notification && notification.id === item.id) {
                    //console.log('service:removeOne');
                    exists = true;
                    removeNotification(notification, prop, i);
                    break;
                }
            }
        }
        if(!exists){isProcessing = false;}
    }

    function removeNotification(notification, prop,i) {
        //console.log('removeNotification ' + notification.id);
        var elem = $('#not' + notification.id);
        if (elem.length > 0) {
            // service.playSound (notification, false);
            elem.css({opacity: 0, transition: 'opacity 0.5s'}).slideUp("slow", n);
        }
        function n() {
            lists[prop].splice(i, 1);
            isProcessing = false;
        }
    }

    function removeAll() {
        _.each(lists, function (listsByType) {
            listsByType.length = 0;
        });
    }

    function start() {
        stop();
        //remove older lists every 100ms
        interval = $interval(function () {
            remove();
        }, 100);
    }

    function stop() {
        if (angular.isDefined(interval)) {
            $interval.cancel(interval);
            interval = undefined;
        }
    } 
}

