angular.module('components.fileUploader.sbResizableImg.controller.service', [
    'components.fileUploader.uploadFiles.controller.service',
    'components.imgResizedWrapped.init.controller'
])//sb-resizable-img
.service('SBResizableImgCtrlService', SBResizableImgCtrlService);
SBResizableImgCtrlService.$inject =['TemplateCompileCompCtrlService', 'UploadFilesCtrlService', 'ImgResizedWrappedInitCtrlService'];
function SBResizableImgCtrlService(TemplateCompileCompCtrlService, UploadFilesCtrlService, ImgResizedWrappedInitCtrlService) {
    return function($ctrl, $element){
        //console.log('SBResizableImgCtrl');
        var popper;

        $ctrl.withoutTemplateScope = false;

        $ctrl.startOrder = null;
        $ctrl.remainingSize = null;
        $ctrl.isPending = true;

        $ctrl.thumbSmClass = 'thumb-sm';
        $ctrl.imageContainerClass = 'image-container';
        $ctrl.fileUploaderClass = 'file-uploader';
        $ctrl.imgSideMenuClass = 'img-sidemenu';

        $ctrl.icons = {View: 4, Upload: 1, Remove: 2, Replace: 3};

        $ctrl.onPreloadCompileTemplate = onPreloadCompileTemplate;
        $ctrl.preInit = preInit;
        $ctrl.getItemTemplate = getItemTemplate;
        $ctrl.onItemLoaded = onItemLoaded;
        $ctrl.onDestroy = onDestroy;

        $ctrl.dontAutoloadTemplate = true;
        $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, $ctrl.withoutTemplateScope);

        return $ctrl;

        function preInit() {
            $ctrl.loadLaterS = $ctrl.loadLater === true || $ctrl.loadLater === 'true';
            $ctrl.element.setAttribute('data-id', $ctrl.componentId);
        }

        function onPreloadCompileTemplate(){
            //console.log('onPreloadCompileTemplate:');
            var load;
            if(!$ctrl.imgObserverService){
                //  console.log('$ctrl.imgObserverService isnull');
                load = true;
            }
            if(!$ctrl.loadLaterS){
                // console.log('$ctrl.loadLaterS ' + $ctrl.loadLaterS);
                load = true;
            }
            if(load){
                reload();
            }else {
                checkIfToLoad(true);
            }
        }

        function checkIfToLoad(isInViewPort){
            return $ctrl.imgObserverService.checkIfViewport(isInViewPort, {
                id: $ctrl.componentId,
                el: $ctrl.element,
                ev: checkReload
            });
        }

        function checkReload(isInViewPort){
            if(checkIfToLoad(isInViewPort)) {
                reload();
            }
        }

        function reload(){
            //console.log('reload: image In Viewport:');
            onPreloadTemplate();
            $ctrl.preInitUpload();
        }

        function onPreloadTemplate(){
            //console.log('onPreloadTemplate');
            if($ctrl.isLoadedFirst){return;}
            $ctrl.isLoadedFirst = true;

            if ($ctrl.imgWatchS === undefined) {
                $ctrl.imgWatchS = ($ctrl.imgWatch === 'true' || $ctrl.imgWatch === true);
            }
            if ($ctrl.withViewS === undefined) {
                $ctrl.withViewS = ($ctrl.withView === 'true' || $ctrl.withView === true);
            }
            if ($ctrl.withViewOnEmptyS === undefined) {
                $ctrl.withViewOnEmptyS = $ctrl.withViewS && ($ctrl.withViewOnEmpty === 'true' || $ctrl.withViewOnEmpty === true);
            }
            if ($ctrl.withoutRemoveS === undefined) {
                $ctrl.withoutRemoveS = ($ctrl.withoutRemove === 'true' || $ctrl.withoutRemove === true);
            }

            if ($ctrl.withNextS === undefined) {
                $ctrl.withNextS = ($ctrl.withNext === 'true' || $ctrl.withNext === true);
            }
            //by default comments are added on item
            $ctrl.isAvatar = $ctrl.isAvatarAttr === 'true' || $ctrl.isAvatarAttr === true;
            $ctrl.isPoster = $ctrl.isPosterAttr === 'true' || $ctrl.isPosterAttr === true;
            if ($ctrl.withCommentsOnItemS === undefined) {
                $ctrl.withCommentsOnItemS = ($ctrl.withCommentsOnItem === 'true' || $ctrl.withCommentsOnItem === true);
            }

            if ($ctrl.withLikesOnItemS === undefined) {
                $ctrl.withLikesOnItemS = ($ctrl.withLikesOnItem === 'true' || $ctrl.withLikesOnItem === true);
            }
            if ($ctrl.withCommentsCountS === undefined) {
                $ctrl.withCommentsCountS = ($ctrl.withCommentsCount === 'true' || $ctrl.withCommentsCount === true);
            }
            $ctrl.canUpload = ($ctrl.canUploadAttr === 'true' || $ctrl.canUploadAttr === true);

            $ctrl.multipleFiles = false;

            $ctrl.startWithEditor = $ctrl.startWithEditorAttr === "true" || $ctrl.startWithEditorAttr === true;
            $ctrl.showMetadaAfter = $ctrl.showMetadaAfterAttr === "true" || $ctrl.showMetadaAfterAttr === true;

            //editor options are needed if is avatar or startWithEditor(not set separately)
            $ctrl.editorOptions = _.extend($ctrl.isAvatar ? {
                isSquare: $ctrl.imgProp !== 'productionLogo',
                isCircleMask: $ctrl.areaType === 'circle',
                maxWidth: 600
            } : ($ctrl.isPoster ? {
                isPoster: true,
                isCircleMask: false,
                maxWidth: 400,
                maxHeight: 800
            } : {}), {
                isAvatar: $ctrl.isAvatar,
                isPoster: $ctrl.isPoster,
                startWithEditor: $ctrl.isAvatar || $ctrl.isPoster || $ctrl.startWithEditor
            });

            if ($ctrl.canUpload) {
                $ctrl.isUploading = true;
                $ctrl.onFileUploadSuccess = onFileUploadSuccess;
                // $ctrl.onFileUploadError = onFileUploadError;
                $ctrl.onCelllongImageLoaded = onCelllongImageLoaded;
                initExtraParams();
            }
            //console.log('SBResizableImgCtrl: ' + $ctrl.imgProp + '; canUpload: ' + $ctrl.canUpload + '; collectionProp: ' + $ctrl.collectionProp);

            $ctrl = new ImgResizedWrappedInitCtrlService($ctrl);
            $ctrl = new UploadFilesCtrlService($ctrl);
            $ctrl.setMinHeight($ctrl.element);
            if ($ctrl.canEdit) {
                //todo
                //   $ctrl.events. Updated = 'IMAGE_UPDATED_' + $ctrl.pr,
                //   $ctrl.addRootWatcher($ctrl.events.Updated, onImageUpdated);
            }

            if($ctrl.imgObserverService && $ctrl.withViewS && $ctrl.withNextS && $ctrl.item && $ctrl.item._id) {
                var l = $ctrl.imgObserverService.currentList;
                if(!l){return;}
                $ctrl.addRootWatcher('VIEW_GRID_ITEM_IMAGE_' + l.elemType + '_' + l._id + $ctrl.item._id, function (isLikes){
                    viewImage(null, isLikes);
                });
            }
        }

        function $onChanges(changes) {
            if (!changes) {
                return;
            }
            if ($ctrl.onImgResizeChanges) {
                $ctrl.onImgResizeChanges(changes);
            }
        }

        function onDestroy() {
            bindImageEvents(false);
            destroyPopper();
            if ($ctrl.onUploadFilesDestroy) {
                $ctrl.onUploadFilesDestroy();
            }
            if($ctrl.imgObserverService){
                $ctrl.imgObserverService.unobserveEl($ctrl.componentId);
            }
        }

        function getItemTemplate() {
            //console.log('getItemTemplate');
            return $ctrl.templateUrl === 'image-uploader-with-button' ? getTemplateWithBtn() : getDefaultTemplate();

            function getDefaultTemplate(){
                var showLabel = $ctrl.showLabel ==='true' || $ctrl.showLabel ===true,
                    noOverlay = $ctrl.noOverlay==='true' || $ctrl.noOverlay===true || !$ctrl.canUpload ;
                return '<div class="' + $ctrl.fileUploaderClass + '">' +
                    '<div class="' + $ctrl.thumbSmClass + '"></div>' +
                    (noOverlay?'': ('<div class="hide-print '+$ctrl.imageContainerClass+' overlay black centering"></div>')) +
                    (showLabel &&$ctrl.defaultText ? ('<label><span class="with-cursor">'+$ctrl.defaultText+'</span> <span class="italic with-parenthesis">optional</span></label>'):'') +
                    '</div>';

                /* <div class="'+' + $ctrl.fileUploaderClass + '+' intermedium">
                     <div class="thumb-sm with-radius-square intermedium"></div>
                 </div>*/
            }

            function getTemplateWithBtn(){
                //  templateUrl = 'image-uploader';
                // or image-uploader-with-button image-uploader-button -> for shot-slideshow}
                return '<div class="' + $ctrl.fileUploaderClass + ' files custombtnsmall">' +
                    '<label class="input-file with-primary-hover">' +
                    //'<input name="file" id="file" multiple="false" type="file" accept="image/*" onclick="this.value=null"/>' +
                    '<div class="sbf upload-img white" ' + ($ctrl.defaultText ? (' tooltip-placement="top" tooltip="' + $ctrl.defaultText + '"') : '') + '>' +
                    '</div>' +
                    '</label>' +
                    '</div>';
            }
        }

        function onItemLoaded() {
            // console.log('onItemLoaded');
            bindImageEvents(false);//unbind events
            $ctrl.isSmallImg = $ctrl.imgSize && $ctrl.imgSize.indexOf('small')!==-1;
            $ctrl.fileUploader = $ctrl.element.querySelector('.' + $ctrl.fileUploaderClass);
            $ctrl.thumbSm = $ctrl.element.querySelector('.' + $ctrl.thumbSmClass);

            var cls = ($ctrl.imgSize ? $ctrl.imgSize : '') + ' ' +
                ($ctrl.cClassAttr ? $ctrl.cClassAttr : '');
            cls = cls.trim();
            if (cls !== '') {
                $ctrl.LCS.addClass($ctrl.fileUploader, cls);
            }
            $ctrl.imageContainer = $ctrl.element.querySelector('.' + $ctrl.imageContainerClass);

            cls = ($ctrl.radius ? $ctrl.radius : '') + ($ctrl.isSmallImg ? ' smallImg' : '');
            if (cls) {
                $ctrl.LCS.addClass($ctrl.imageContainer, cls);
            }

            if ($ctrl.imgSize === 'celllong') {
                var div = document.createElement('div');
                $ctrl.LCS.addClass(div, 'sbf add-img');
            }

            updateImageContainer();

            $ctrl.resizedWrappedInit(false);

            $ctrl.$onChanges = $onChanges;
        }

        function viewImage(e, isLikes) {
            $ctrl.preventDefault(e);
            var id = getImgPropId();
            if(!id){return;}
            console.log('sbResizableImg: view material popup');
            var currentList = $ctrl.imgObserverService ? $ctrl.imgObserverService.currentList : null;
            if(currentList) {
                currentList = _.extend(currentList, {
                    withLikesOnItem: $ctrl.withLikesOnItemS === true,
                    withCommentsOnItem: $ctrl.withCommentsOnItemS === true,
                    withCommentsCount: $ctrl.withCommentsCountS === true
                }, $ctrl.security.getImageExtraInfo($ctrl.item, $ctrl.imgProp));
            }

            var params = _.extend({
                imgProp: $ctrl.imgProp,
                withComments: $ctrl.withComments,
                canComment: $ctrl.withComments ? $ctrl.canComment : false,
                withNext: $ctrl.withNextS === true,

                canUpload: $ctrl.canUpload,
                currentList: currentList,
                startWithLikes: isLikes === true
            }, $ctrl.canUpload ? {
                editorOptions: $ctrl.editorOptions,
                onImageEdited: onImageEdited
            } : {});

            // return $ctrl.item ? $ctrl.item[$ctrl.imgProp + 'Id'] : null;
            $ctrl.popupsService.open(id, $ctrl.popupsService.operations.materialViewer, params, null, null, function (result){
                console.log('onSuccess');
                if(result && result.withNext){
                    $ctrl.imgObserverService.viewNextImagePopup(params);
                }

               /* $ctrl.broadcastRoot('VIEW_GRID_IMAGE_' + $ctrl.elemType + '_' + $ctrl.extraParam.currentListId, {
                    _id: $ctrl.extraParam.currentItemId,
                    isPrevious: isPrevious
                });*/
            });
        }

        function updateImageContainer() {
            if($ctrl.imageContainer) {
                $ctrl.LCS.appendChildFragment($ctrl.imageContainer, loadBtns(false), true);//add new children
            }

            bindImageEvents(true);//bind new events
        }

        function loadBtns(inDrp) {
                var hasImg = getImgProp(),
                    btnsCount = 0,
                    btns = get();

                return (inDrp ? '<div class="' + $ctrl.imgSideMenuClass + '"><ul class="dropdown-menu side-menu display-block">' : '<div '+(btnsCount>1 ? 'class="multibtns"':'')+'>') +
                    btns +
                    (inDrp ? '</ul></div>' : '</div>');

                function get() {
                    return $ctrl.canUpload ? (hasImg ? getO() : getButton($ctrl.icons.Upload)) : '';
                    function getO(){//can upload a new image
                        if(inDrp) {//small - all 3 btns
                            return ($ctrl.withViewS ? getButton($ctrl.icons.View) : '') +
                                getButton($ctrl.icons.Replace) +
                                getButton($ctrl.icons.Remove);
                        }else{//inline
                            return getButton($ctrl.isSmallImg && $ctrl.withViewS ? $ctrl.icons.View : $ctrl.icons.Replace) +
                                ($ctrl.isSmallImg ? '' : getButton($ctrl.icons.Remove));

                        }
                    }
                }

                function getButton(type) {
                    if(type === $ctrl.icons.Remove && $ctrl.withoutRemoveS) {
                        return '';
                    }
                    var svg = '', text, iconLevel;
                    switch (type) {
                        case  $ctrl.icons.View:
                            svg = 'eye';
                            text = 'View';
                            break;

                        case  $ctrl.icons.Replace:
                            svg = 'upload-arrow';//'transition';
                            iconLevel = 3;
                            text = 'Replace';
                            break;

                        case $ctrl.icons.Remove:
                            svg = 'remove';
                            text = 'Remove';
                            break;

                        case $ctrl.icons.Upload:
                            svg = 'upload-arrow';
                            iconLevel = 3;
                            text = 'Upload';
                            break;
                    }
                    if (inDrp) {
                        return '<li id="btn' + type + '"><a class="table-div full-width">' +
                            '<div class="col30">' + getI(svg, iconLevel ? iconLevel : 2) + '</div>' +
                            '<div>' + text + '</div>' +
                            '</a></li>';
                    } else {
                        btnsCount +=1;
                        return '<button id="btn' + type + '" class="sbup-u-reset sbup-DashboardItem-action sbup-DashboardItem-action--edit small" type="button" tooltip-placement="top" tooltip="' + text + '">' +
                            getI(svg, iconLevel, 'centering') +
                            '</button>';
                    }
                    function getI(i, l, o){return $ctrl.LCS.getISBDiv(i, l ? l : 2, o);}
                }
        }

        function loadPopper(e) {
            console.log('loadPopper');
            $ctrl.preventDefault(e);
            var wrapper = getPopperWrapperEl();
            if (!wrapper) {
                $ctrl.LCS.appendChildFragment($ctrl.element, loadBtns($ctrl.isSmallImg));//add new children
                wrapper = getPopperWrapperEl();
            }else{
                bindPopupEvents(wrapper, false);
            }

            bindPopupEvents(wrapper, true);

            popper = Popper.createPopper($ctrl.imageContainer, wrapper,  getOpts());
            function getOpts() {
                return {
                    placement: $ctrl.popupPlacement ? $ctrl.popupPlacement : 'right',
                    modifiers: [{
                        name: 'flip',
                        options: {
                            fallbackPlacements:   'bottom' ,
                        },
                    }, {
                        name: 'preventOverflow',
                        options: {
                            rootBoundary: 'document',
                        },
                    }],
                }
            }
        }

        function getPopperWrapperEl() {
            return $ctrl.element.querySelector('.' + $ctrl.imgSideMenuClass);
        }

        function destroyPopper(e) {
            $ctrl.preventDefault(e);
            var el = getPopperWrapperEl();
            if (el) {
                bindPopupEvents(el, false);
                $ctrl.element.removeChild(el);
            }
            if (popper && typeof (popper.destroy) === 'function') {
                popper.destroy();
            }
        }

        function bindPopupEvents(parent, isBind) {
            if (isBind) {
                $ctrl.drpPoppupEvents = addUploadEvents(parent, getBtn(parent, $ctrl.icons.View));
            }
            if ($ctrl.drpPoppupEvents) {
                _.each($ctrl.drpPoppupEvents, function (el) {
                    $ctrl.LCS.bindElementsClick(isBind, el.element, function (e) {
                        el.method();
                        destroyPopper(e);
                    }, el.nm, el.event);
                });
            }
        }

        function addUploadEvents( parent, viewElement) {
            var events = [];

            if ($ctrl.withViewS) {
                addEv($ctrl.icons.View, viewImage, $ctrl.LCS.isTouchScreen ? null : viewElement);
            }

            if ($ctrl.canUpload) {
                addEv($ctrl.icons.Replace, $ctrl.uploadFiles);
                if (!$ctrl.withoutRemoveS) {
                    addEv($ctrl.icons.Remove, removeFile);
                }
            }

            return events;

            function addEv(nm, method, el) {
                if (!el) {
                    el = getBtn(parent, nm);
                }
                if (el) {
                    events.push({
                        element: el,
                        nm: getImgEvent(nm),
                        method: method
                    });
                }
            }
        }

        function bindImageEvents(isBind) {
            if(isBind) {
                if (getImgPropId()) {
                    $ctrl.imgEvents = addUploadEvents( $ctrl.element, $ctrl.fileUploader);
                    if ($ctrl.imageContainer && $ctrl.isSmallImg) {
                        addEv('mouseenter', loadPopper);
                        addEv('mouseleave', destroyPopper);
                        addEv('focus', loadPopper);
                        addEv('blur', destroyPopper);
                    }
                } else if ($ctrl.canUpload) {
                    $ctrl.imgEvents = [{
                        element: $ctrl.fileUploader,
                        nm: getImgEvent($ctrl.icons.Upload),
                        method: function (e){
                            if(getImgPropId()){
                              return viewImage();
                            }
                            var quotaType = $ctrl.quotaType;
                            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});
                            function process() {
                                $ctrl.uploadFiles(e);
                            }
                        }
                    }];
                }
            }
            if($ctrl.reBind) {
                $ctrl.reBind($ctrl.imgEvents, isBind);
            }

            function addEv(type, method){
                $ctrl.imgEvents.push({
                    element: $ctrl.element,
                    event: type,
                    nm: 'imgLoadPopper',
                    method: method
                });
            }
        }

        function getImgEvent(type){
            return 'imgBtn' + type;
        }

        function getBtn(p, type){
            return p.querySelector('#btn' + type)
        }

        function getImgPropId() {return getp(getImgPropIdName());}

        function getImgProp() {return getp($ctrl.imgProp);}

        function getItemId() {return getp($ctrl.itemIdProp ? $ctrl.itemIdProp : '_id');}

        function getp(p){return $ctrl.item ? $ctrl.item[p] : null}

        function getImgPropIdName() {
            //$ctrl.collectionProp === "materials"
            return $ctrl.security.getImgPropIdName($ctrl.imgProp);
        }

        function onCelllongImageLoaded() {
            var img = $ctrl.$element.find('img');
            if (img) {
                img.bind('load', onimgloaded);
                //todo: add unbind
            }
            function onimgloaded() {
                var h = img.height();
                $ctrl.$element.height(h);
                $ctrl.thumbSm.height = h;
                $ctrl.imageContainer.height = h;
                //  $ctrl.$element.find('.image-container label').css('line-height',h+'px');
            }
        }

        function initExtraParams() {
            //console.log('initExtraParams');
            $ctrl.extraParam = {uploadPropImage: true};

            if (!$ctrl.codeName) {
                $ctrl.codeName = 'avatars';
            }

            $ctrl.extraParam.codeName = angular.copy($ctrl.codeName);

            if ($ctrl.imgProp) {
                $ctrl.extraParam.imgProp = $ctrl.imgProp;
            }

            if ($ctrl.collectionProp) {
                $ctrl.extraParam.collectionProp = $ctrl.collectionProp;
            }

            if ($ctrl.item) {
                $ctrl.extraParam.itemId = getItemId();
            }
        }

        function onFileUploadSuccess(result) {
            console.log('onFileUploadSuccess');
            if(result && result.result){
                result =  result.result;
            }
            $ctrl.isUploading = false;
            $ctrl.editedFile = null;

            updateparams('update', result);

            if($ctrl.showMetadaAfter) {viewImage();}
        }

        function removeFile(e) {
            console.log('removeFile');
            $ctrl.preventDefault(e);
            //confirmRemove(function(){updateparams('remove');}); get confirmation first
            updateparams('remove');
        }

        function confirmRemove(onConfirm){
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations.treeKeyboardActions, {
                btn: 'Apply',
                icon: 'trash',
                title: 'Are you sure?',
                message: 'Are you sure you want to remove this image',
                itemTitle: 'image',
                onConfirm: onConfirm
            }, $ctrl.compOptions);
        }


        function updateparams(eventType, result) {
            var params = {}, val;
            if(eventType === 'remove'){
                val =  {id: null, path: null};
            }else if(result){
                val = result.propItem ? result.propItem[$ctrl.extraParam.imgProp] : null;

                if (result.item) {
                    params.added = {materials: [result.item]};
                }

                if (result.updates) {
                    params.updates = {materials: [result.updates]};
                }
            }
            params.updatedImage = {prop: $ctrl.imgProp, val: val};

            if(val){
                bindImageEvents(false);//unbind events
                $ctrl.item.loadImageFromObjProp(params.updatedImage);
                $ctrl.reloadImage(true);
                updateImageContainer();

                var data = setData(val);
                if (typeof ($ctrl.onUploaded) === 'function') {
                    $ctrl.onUploaded(data);
                }
                params.item = data;
            }

            broadcastupdate(eventType, params);

            function setData(val) {
                var data = {_id: getItemId()};
                data[$ctrl.imgProp] = val ? val.path : null;
                data[getImgPropIdName()] = val ? val.id : null;
                return data;
            }

            function broadcastupdate(eventType, params) {
                //used to update item on edit pages -> like update sidebar profile picture company picture; callsheet info
                $ctrl.broadcastRoot('IMAGE_UPLOADED' +
                    ($ctrl.withCollectionBroadcasted === 'true' ? ('_' + $ctrl.collectionProp.toUpperCase()) : ''),
                    _.extend({
                        eventType: eventType,
                        componentId: $ctrl.componentId,
                        collectionProp: $ctrl.collectionProp
                    }, params));
            }
        }

        function onImageEdited(result) {
            console.log('sbResizableImg.onImageEdited');
            //{
            //                 size: blob.size,
            //                 mimeType: blob.type,
            //                 modifiedDate: moment.utc(blob.lastModifiedDate).toString(),
            //                 url: url,
            //                 width: result.width,
            //                 height: result.height,
            //                 blob: blob
            //             }
            //set a var to know which file is being changed
            // add file to uppy and trigger upload
            if (!result) {
                console.log('error ');
                return;
            }

            $ctrl.editedFile = result;
            $ctrl.uploadFiles(null, {
                processInBg: true,
                versionId: getImgPropId(),
                file: $ctrl.editedFile
            });
            //  $ctrl.service.update(data, onCustomSave, $ctrl.onCustomError);
        }
    }
}

angular.module('components.fileUploader.upload-drop.complex.service', [
    'components.fileUploader.mediaLibrary.service',
    'apiServices.Products',
    'apiServices.Materials'
])
.service('UploadDropComplexCtrlService', UploadDropComplexCtrlService);
UploadDropComplexCtrlService.$inject = ['ProductsService', 'MaterialsService', 'PreLoadingProv', 'UploaderCtrlService', 'ScriptLoaderService', 'TemplateCompileService', 'SBMediaLibraryService', 'CookiesService'];
function UploadDropComplexCtrlService(ProductsService, MaterialsService, PreLoadingProv, UploaderCtrlService, ScriptLoaderService, TemplateCompileService, SBMediaLibraryService, CookiesService) {
    return function ($ctrl) {
        if ($ctrl.setShowDrop === undefined) {
            console.log('Parent for UploadDropSimpleCtrlService must define _this._this.setShowDrop');
        }
        if (!$ctrl.wrapperInnerElement) {
            console.log('Parent for UploadDropSimpleCtrlService must define _this._this.wrapperInnerElement');
        }

        $ctrl = new UploaderCtrlService($ctrl);

        $ctrl.onDestroyDrop = onDestroyDrop;
        $ctrl.loadDrop = loadDrop;

        function loadDrop() {
            var headers = CookiesService.setAuthorizationHeader($ctrl.getServerHeaders());

            $ctrl.options = {
                isAuthenticated: $ctrl.isAuthenticated,
                progressBarClassName: $ctrl.progressBarClassName,
                canEdit: $ctrl.canEdit,
                awsUploadPath: $ctrl.getAWSPath(),
                serverHeaders: headers,
                dashboardTarget: $ctrl.wrapperInnerElement,

                startOrder: $ctrl.startOrder,
                imagesOnly: $ctrl.imagesOnly,
                remainingSize: $ctrl.remainingSize,
                detectFileType: $ctrl.detectFileType,
                txtFileType: $ctrl.txtFileType,
                fileType: $ctrl.fileType,
                multipleFiles: $ctrl.multipleFiles,

                editorOptions: $ctrl.editorOptions,
                //allowedFileTypes null | array of wildcards image/*, exact mime types image/jpeg, or file extensions .jpg: ['image/*', '.jpg', '.jpeg', '.png', '.gif']
                maxFileSize: null, // todo: restriction for the free plan???
                onCloseModal: $ctrl.close,
                onFileUploadComplete: onFileUploadComplete,
                onUploadsComplete: onUploadsComplete,
                onBeforeFilesUploaded: onBeforeFilesUploaded,
                getCustomLibraryList: getCustomLibraryList,
                setCustomLibraryMeta: setCustomLibraryMeta,
                getMovieStillsList: getMovieStillsList,
                viewMaterialPopup: viewMaterialPopup,
                ImgEditorService: $ctrl.ImgEditorService,
                isAllProjectsSearch: true//!($ctrl.productId !== null && $ctrl.productId !== undefined )
            };

            if ($ctrl.extraParam && $ctrl.extraParam.editedFile) {
                var editedFile = $ctrl.extraParam.editedFile;
                $ctrl.processInBg = editedFile.processInBg;
                delete editedFile.processInBg;
                $ctrl.options.editedFile = editedFile;
            }

            if (!$ctrl.isAuthenticated) {
                return process(); //collaborators can access only current project's images for shots
            }

            /*not good cause doesn't check in the lists
            ProductsService.queryPaged(10000, {
                companyId: $ctrl.companyId,
                active: true
            }, 0, {createdAt: -1}, null, '', function (result) {
                next(((!items || items.count < 2 )? null : [{value: 'All', text: 'All Projects'}].concat(items.docs.map(function (item) {
                    return {value: item._id, text: item.name, icon: item.logo};
                }))));
            }, function () {
                next(null);
            }, true);
*/

            var preLoadingService = PreLoadingProv.getInstance({
                companyId: $ctrl.companyId
            }, PreLoadingProv.PreloadingTypes.Products);
            preLoadingService.load(function () {
                var items = preLoadingService.getObjectList(preLoadingService.TblTypes.Products, function (item) {
                            return item.active;
                        }, 'name'),
                    currentProject = $ctrl.productId ? _.find(items, function (item) {
                            return item._id === $ctrl.productId;
                        }) : null,
                    newItems = [];

                //add current project
                if (currentProject) {
                    items = _.without(items, currentProject);
                    newItems.push(processItem(currentProject));
                }

                //add all projects
                newItems.push( {
                    value: 'All',
                    text: 'All Projects',
                    withBordelineBottom: items.length
                });

                if(items.length > 0) {
                    newItems = newItems.concat(items.map(processItem));
                }

                next(newItems);

                function processItem(item) {return {value: item._id, text: item.name, logo: item.logo};}
            });

            function next(items) {
                $ctrl.options.userProjects = {
                    items: items,
                    selectedId: $ctrl.productId ? $ctrl.productId : 'All'
                };

                $ctrl.options.folderTypes = {
                    items: [{
                        value: 'All',
                        text: 'All Images'
                    },{
                        value: ['shots'],
                        text: 'Shots'
                    },{
                        value: ['storyboards'],
                        text: 'Storyboards'
                    },{
                        value: ['moodboards'],
                        text: 'Moodboards'
                    },{
                        value: ['documents'],
                        text: 'Documents'
                    },{
                        value: ['taskBoards'],
                        text: 'Task Boards'
                    },{
                        value: ['avatars'],
                        text: 'Avatars'
                    }],
                    selectedId: 'All'
                };

                process();
            }

            function viewMaterialPopup(versionId) {
                console.log('UploadDropComplexCtrlService: view material popup');
                var index = 2147483002;
                try {
                    index = parseInt(window.getComputedStyle($ctrl.element.querySelector('.file-uploader-wrapper.uploader-wrapper')).zIndex, 10);
                } catch (e) {
                }

                var params = {
                    canUpload: false,
                    canComment: $ctrl.canComment,
                    withBack: true,
                    isPreview: true,
                    popupIndex: index + 1
                };
                if (params.canUpload) {
                    params.editorOptions = $ctrl.editorOptions;
                    params.onImageEdited = onImageEdited;
                }
                $ctrl.popupsService.open(versionId, $ctrl.popupsService.operations.materialViewer, params, $ctrl.compOptions);
            }

            function getCustomLibraryList(query, pageSize, page, next) {
                return getLibraryList(query, pageSize, page, next, false);
            }

            function setCustomLibraryMeta(fileId, meta, next){
                console.log('setCustomLibraryMeta fileId: '+ fileId);
                setMeta(fileId, meta, next, false);
            }

            function setMovieStillsMeta(fileId, meta, next) {
                console.log('setMovieStillsMeta fileId: '+ fileId);
                setMeta(fileId, meta, next, true);
            }

            function setMeta(fileId, meta, next, isMovieStills){
                (isMovieStills ? MaterialsService.updateVersionMeta :  MaterialsService.updateVersionMeta)({
                    companyId: $ctrl.CPS.companyId,
                    productId: $ctrl.CPS.productId,
                    versionId: fileId,
                    metadata: meta
                }, function(res){
                    next(null, res);
                },function (err) {
                    if(err){console.log(err);}
                    next(err, null);
                });
            }
            function getMovieStillsList(query, pageSize, page, next) {
                console.log('getMovieStillsList query: '+ query);
                return getLibraryList(query, pageSize, page, next, true);
            }

            function getLibraryList(q, pageSize, page, next, isSBPredef) {
                var query = angular.copy(q);
                if (!query) {
                    query = { };
                }
                if(isSBPredef){
                    query.isSBPredef = true;
                    delete query.productId;
                }else if(query.productId === 'All'){
                    delete query.productId;
                }
                if(query.folderTypeId === 'All'){
                    delete query.folderTypeId;
                }
                return serverSideSearch();
                //server side search
                function serverSideSearch() {
                    if ($ctrl.imagesOnly) {
                        query.isImage = true;
                    }
                    MaterialsService.search(query, pageSize, page, next,  function (err) {
                        if(err){console.log(err);}
                        next(err);
                    }, true);
                }
            }

            function process() {
                var libraryId = $ctrl.libraryType ? $ctrl.libraryType : ($ctrl.companyId + '_' + $ctrl.productId + '_' + (headers ? headers['x-page'] : null));

                $ctrl.library = new SBMediaLibraryService(libraryId, $ctrl.options);
                $ctrl.library.uploadEditedFile();
            }
        }

        return $ctrl;

        function onUploadsComplete(result) {
            console.log('UploadDropComplexCtrlService.onUploadsComplete');
            if (result.successful && (!result.failed || !result.failed.length)) {
                console.log('Upload complete! We’ve uploaded these files:', result.successful); // if upload succeeds, let's see what we uploaded
                $ctrl.close();
            } else {
                console.log('Upload error: ', result.failed); // if upload failed, let's see what went wrong
            }
        }

        function onFileUploadComplete(response, file) {
            console.log('UploadDropComplexCtrlService.onFileUploadComplete');
            // response can be for @uppy/xhr-upload
            //   status, // HTTP status code (0, 200, 300)
            //   body, // response body
            //   uploadURL // the file url, if it was returned
            //  file.meta['key'] // the S3 object key of the uploaded file
            $ctrl.onFileUploadProcess(file, $ctrl.extraParam, null, null);
        }

        function onBeforeFilesUploaded(fileIdsInQueueOrder, next){
            console.log('UploadDropComplexCtrlService.onBeforeFilesUploaded');
            if(typeof ($ctrl.onBeforeFilesUploaded) === 'function') {
                $ctrl.onBeforeFilesUploaded(fileIdsInQueueOrder, next);
            }else{
                next();
            }
        }

        function onDestroyDrop() {
            if ($ctrl.library) {
                $ctrl.library.onDestroy();
            }
        }
    }
}

angular.module('components.fileUploader.uploader.drop.component', [
    'components.fileUploader.upload-drop.simple.service',
    'components.fileUploader.upload-drop.complex.service'
])

.component('uploadDropFile', {
    bindings: {
        productId: '<',
        startOrder: '<',
        remainingSize: '<',
        imagesOnly: '<',

        txtFileType: '<?',
        fileType: '<?',
        multipleFiles: '<?',
        maxNumberOfFiles: '<?',

        awsSignPath: '<?',
        uploadObjService: '<',
        codeName: '@',
        parentId:'<',
        withSubparentId: '<',

        extraParam: '<',
        closeOnDrop:'<',
        editorOptions: '<',

        onRemoveDrop: '&',
        isSimpleUploader:'<',
        onSuccess: '&',
        onError: '&',
        onBefore: '&',
        dontShowActivity: '@'
    },
    controller: 'UploadDropDirectiveCtrl'
})
.controller('UploadDropDirectiveCtrl', UploadDropDirectiveCtrl);
UploadDropDirectiveCtrl.$inject = ['CompInitCtrlService', 'ScriptLoaderService', 'UploadDropSimpleCtrlService', 'UploadDropComplexCtrlService', '$element',];
function UploadDropDirectiveCtrl(CompInitCtrlService, ScriptLoaderService, UploadDropSimpleCtrlService, UploadDropComplexCtrlService, $element) {
    var $ctrl = this;

    $ctrl.$onDestroy = $onDestroy;
    $ctrl = new CompInitCtrlService($ctrl);

    $ctrl.$element = $element;
    $ctrl.element = $ctrl.$element[0];
    $ctrl.wrapperElementClass = 'uploader-wrapper';
    $ctrl.wrapperInnerElementClass = 'file-uploader-inner-wrapper';

    $ctrl.close = close;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        if(!$ctrl.productId) {
            $ctrl.productId = $ctrl.CPS.productId;
        }
        $ctrl.isAuthenticated = $ctrl.CPS.isAuthenticated;
        $ctrl.sizeError = null;
        $ctrl.keepPopup = true;


        if($ctrl.dontShowActivity === 'true' || $ctrl.dontShowActivity === true) {
            if (!$ctrl.extraParam) {
                $ctrl.extraParam = {};
            }
            $ctrl.extraParam.dontShowActivity = true;
        }

        $ctrl.setShowDrop = setShowDrop;
        $ctrl.onFileUploadComplete = onFileUploadComplete;
        $ctrl.getUploadParams = getUploadParams;
        $ctrl.updateErrorUploading = updateErrorUploading;
        $ctrl.onBeforeFilesUploaded = onBeforeFilesUploaded;
        $ctrl.filesProcessingStarted = $ctrl.closeOnDrop ? filesProcessingStarted : null;

        $ctrl.onFileUploadSuccess = onFileUploadSuccess;
        $ctrl.onFileUploadError = onFileUploadError;

        $ctrl.info = {showDrop: $ctrl.processInBg ? false : true};
        initEl();

        if($ctrl.isSimpleUploader || $ctrl.scriptLoaded || !$ctrl.API_CONFIGS.loadFilesSeparated){
            processLoad();
        }else{
            ScriptLoaderService.loadAll([{name: $ctrl.API_CONFIGS.uploaderFile}],
                null // [{name: file}]
                , function (){
                    $ctrl.scriptLoaded = true;
                    processLoad();
                });
        }
    }

    function processLoad(){
        console.log('processLoad');
        $ctrl = new ($ctrl.isSimpleUploader ? UploadDropSimpleCtrlService : UploadDropComplexCtrlService)($ctrl);
        $ctrl.loadDrop();
    }

    function initEl() {
        $ctrl.LCS.appendChildFragment($ctrl.element,
            '<div class="' + $ctrl.wrapperElementClass + ' file-uploader-wrapper ' + ($ctrl.info.showDrop ? '' : 'sb-hide') + '">' +
            '<div class="' + $ctrl.wrapperInnerElementClass + '"><preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center></div>' +
            '</div>');

        $ctrl.wrapperElement = $ctrl.element.querySelector('.' + $ctrl.wrapperElementClass);
        $ctrl.wrapperInnerElement = $ctrl.wrapperElement.querySelector('.' + $ctrl.wrapperInnerElementClass);
    }

    function setShowDrop(val) {
        if ($ctrl.info.showDrop !== val) {
            $ctrl.info.showDrop = val;
            $ctrl.LCS[$ctrl.info.showDrop ? 'removeClass' : 'addClass']($ctrl.wrapperElement, 'sb-hide');
        }
    }

    function $onDestroy() {
        $ctrl.removeWatchers();
        if ($ctrl.onDestroyDrop) {
            $ctrl.onDestroyDrop();
        }
    }

    function getUploadParams() {
        var p = {
            codeName: $ctrl.codeName
        };
        if ($ctrl.parentId) {
            p.parentId = $ctrl.parentId;
        }
        return p;
    }

    function filesProcessingStarted() {
        $ctrl.uploader.setShowDrop(false);
    }

    function onFileUploadSuccess(result) {
        return $ctrl.onSuccess ? $ctrl.onSuccess({result: result}) : onSuccess(result);
    }

    function onBeforeFilesUploaded(fileIdsInQueueOrder, next) {
        console.log('UploadDropDirectiveCtrl.onBeforeFilesUploaded');
        if (!($ctrl.withoutOnBefore || $ctrl.element.getAttribute('without-on-before') === 'true') && typeof ($ctrl.onBefore) === 'function') {
            return $ctrl.onBefore({
                result: {
                    fileIdsInQueueOrder: fileIdsInQueueOrder,
                    next: next
                }
            });
        } else {
            return next();
        }
    }

    function onSuccess(result) {
        $ctrl.isUploading = false;
        var el = result.item;
        if (el) {
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.file.upload.success', 'success', {name: el.name ? el.name : ''});
        }
    }

    function onFileUploadError(result) {
        return $ctrl.onError ? $ctrl.onError({result: result}) : onError(result);
    }

    function onError(id) {
        $ctrl.isUploading = false;
        var el = $ctrl.uploadObjService.get(id);
        var error = el ? el.error : null;
        if (error) {
            $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.file.upload.error');
        }

        if (!$ctrl.info.showDrop) {
            $ctrl.uploader.setShowDrop(true);
        }
    }

    function onFileUploadComplete(result) {
        if (!$ctrl.uploadObjService || $ctrl.uploadObjService&&!$ctrl.uploadObjService.countUploads()) {
            $ctrl.close(result);
        }
    }

    function updateErrorUploading(error, file) {
        $ctrl.isUploading = false;
        console.log(error);
        $ctrl.error = error;
    }

    function close(result) {
        console.log('onCloseModal');
        $ctrl.onRemoveDrop({result: result});
    }
}

angular.module('components.fileUploader.upload-drop.simple.service', [
    'components.fileUploader.fileUploader.init.controller.service'
])
.service('UploadDropSimpleCtrlService', UploadDropSimpleCtrlService);
UploadDropSimpleCtrlService.$inject = ['TemplateCompileService', 'FileUploaderInitCtrlService'];
function UploadDropSimpleCtrlService(TemplateCompileService, FileUploaderInitCtrlService) {
    return function ($ctrl) {
        $ctrl.preventDefault = preventDefault;
        if ($ctrl.setShowDrop === undefined) {
            console.log('Parent for UploadDropSimpleCtrlService must define _this._this.setShowDrop');
        }
        if (!$ctrl.wrapperInnerElement) {
            console.log('Parent for UploadDropSimpleCtrlService must define _this._this.wrapperInnerElement');
        }

        $ctrl.loadDrop = loadDrop;
        $ctrl.onDestroyDrop = onDestroyDrop;

        return $ctrl;

        function loadDrop() {
            $ctrl.templateCompile = new TemplateCompileService(angular.element($ctrl.wrapperInnerElement), getItemTemplate, $ctrl);
            $ctrl.templateCompile.loadTemplate(onLoaded);

            function onLoaded() {
                $ctrl = new FileUploaderInitCtrlService($ctrl);
                $ctrl.setShowDrop(true);
                bind(true);
            }
        }

        function getItemTemplate() {
    return '<div '+ get('drop')+' ngf-drag-over-class="{accept:\'dragover\', reject:\'dragover-err\', delay:100}" class="drop-box">' +
                '<div class="centered">' +
                    '<div class="circled sbf big-icon upload-copy white"></div>' +
                    '<div class="top-text text-center spacing-half-top">Drag & Drop</div>' +
                    '<div class="lower-text">'+$ctrl.txtFileType+' anywhere, or ' +
    //'<a ngf-capture '+get('select')+'><u>browse</u></a>' +
                        '<div class="inline-block divBrowse" ngf-capture '+get('select')+'>' +
                            '<input id="ngfFile" type="file" '+($ctrl.multipleFiles ? 'multiple="multiple" ' : '')+'>' +
                        '</div>' +
                    '</div>' +
                    '<div ng-if="$ctrl.error" class="form-wrapper centering spacing-half-top">' + $ctrl.LCS.getErrorBlock() + '</div>' +
                    '<div ng-if="$ctrl.isUploading && !$ctrl.error">' +
                        '<div class="uploading-wrapper centering">' +
                            '<div class="lower-text spacing-bottom">Please wait while the ' + ($ctrl.multipleFiles ? 'files are' : 'file is') + ' being uploaded…</div>' +
                            '<div ng-repeat="f in $ctrl.uploadObjService.uploads">' +
                                '<div ng-if="f.progress && f.progress != 100" class="easypiechart" easypiechart options="$ctrl.OptionsUpload" percent="f.progress">' +
                                    '<div class="inner-pie">' +
                                        '<!--<div class="big">{{f.progress | number:0}}%</div>-->' +
                                    '</div>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="spacing-half-top"><a class="btnCancel btn gray cancel"><span class="sbf cancel"></span> Cancel</a></div>' +
                '</div>' +
            '</div>';

            function get(t) {
                return 'ngf-'+t+'="$ctrl.onFilesSelected($files, $ctrl.getUploadParams())" ngf-multiple="'+$ctrl.multipleFiles+'"';
            }
        }

        function bind(isBind) {
            if (!$ctrl.btnCancel) {
                $ctrl.btnCancel = $ctrl.wrapperInnerElement.querySelector('.btnCancel');
            }
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnCancel, cancel);
        }

        function onDestroyDrop() {
            bind(false);
            if($ctrl.templateCompile){
                $ctrl.templateCompile.destroyNewScope();
            }
        }

        function cancel(e) {
            $ctrl.preventDefault(e);
            $ctrl.close();
        }

        function preventDefault(e) {
            $ctrl.LCS.preventDefault(e);
        }
    }
}

angular.module('components.fileUploader.uploader.uploadFilesBtn.component', [
    'components.fileUploader.uploadFiles.controller.service'
])
.component('uploadFilesBtn', {
    bindings: {
        isA:'@',
        parentId:'<',
        codeName: '@',
        withSubparentId: '<',
        productId: '<',

        autostart:'<', //if autostart dont load the button.
        btnClass: '@',
        iconClass: '@',
        iconLevel: '@',
        btnText: '<',
        showTextOnIpad: '@',
        showTitle: '<?',

        txtFileType: '@',
        fileType: '<',
        startOrder: '<',
        remainingSize: '<',
        imagesOnly: '<',
        multipleFiles: '<?',
        maxNumberOfFiles: '<?',

        awsSignPath: '<?',
        uploadObjService: '<',
        onFileUploaded: '&',
        onBeforeFilesUploaded: '&',
        dontShowActivity: '@'
    },
    controller:'UploadFilesCtrl'
}) 

.controller('UploadFilesCtrl', UploadFilesCtrl);

UploadFilesCtrl.$inject = ['TemplateCompileCompCtrlService', 'UploadFilesCtrlService', '$element'];
function UploadFilesCtrl(TemplateCompileCompCtrlService, UploadFilesCtrlService, $element) {
    var $ctrl = this;

    $ctrl.canUpload = true;
    $ctrl.uploaderTriggerClass = 'btnUpload';

    $ctrl.onFileUploadSuccess = onFileUploadSuccess;
    $ctrl.onBeforeFilesUploaded = onBeforeFilesUploaded;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.preInit = preInit;

    $ctrl.dontAutoloadTemplate = true;
    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);
    $ctrl = new UploadFilesCtrlService($ctrl);

    function getItemTemplate() {
        var tag = $ctrl.isA ? 'a' : 'button';
        return '<' + tag +
            ($ctrl.isA ? '' : ' type="button"') +
            ' class="' + $ctrl.uploaderTriggerClass + ' ' + ($ctrl.btnClass ? $ctrl.btnClass : 'display-inline') + '"' +
            ' analytics-on analytics-action="' + $ctrl.btnText + '" ' +
            ($ctrl.showTitle ? '' : 'tooltip="{{::$ctrl.btnText}}" tooltip-placement="bottom"') + '>' +
                ($ctrl.iconClass ? $ctrl.LCS.getISBDiv($ctrl.iconClass, $ctrl.iconLevel ? parseInt($ctrl.iconLevel, 10) : 2, 'pull-left') : '') +
                ($ctrl.showTitle ? ('<div' + ($ctrl.showTextOnIpad ? '' : ' class="with-margin-left hide-ipad '+($ctrl.isA ? 'pull-left':'')+ '"') + '>' +
                $ctrl.btnText + '</div>') : '') +
            '</' + tag + '>';
    }

    function onFileUploadSuccess(result) {
        console.log('UploadFilesCtrl.onFileUploadSuccess');
        if (result && result.result) {
            result = result.result;
        }
        if (typeof ($ctrl.onFileUploaded) === 'function') {
            $ctrl.onFileUploaded({result: result});
        }
    }
    function onBeforeFilesUploaded(result) {
        console.log('onBeforeFilesUploaded');
        if (result && result.result) {
            result = result.result;
        }
        if (typeof ($ctrl.onBefore) === 'function') {
            $ctrl.onBefore({result: result});
        }
    }
    function onDestroy() {
        $ctrl.onUploadFilesDestroy();
    }

    function preInit() {
        $ctrl.preInitUpload();
    }
}

angular.module('components.fileUploader.uploadFiles.controller.service', [
    'components.fileUploader.uploader.drop.component'
])
.service('UploadFilesCtrlService', UploadFilesCtrlService);
UploadFilesCtrlService.$inject = ['TemplateCompileService'];
function UploadFilesCtrlService(TemplateCompileService) {
    return function ($ctrl) {
        var isUploadingF = false;

        if(!$ctrl.templateCompileLoaded){
            console.warn('parent for UploadFilesCtrlService must inherit TemplateCompileCompCtrlService');
        }
        if (!$ctrl.getItemTemplate) {
            console.warn('parent for UploadFilesCtrlService must define $ctrl.getItemTemplate');
        }

        $ctrl.uploadFiles = uploadFiles;
        $ctrl.onUploadFilesDestroy = onUploadFilesDestroy;

        $ctrl.reBind = reBind;
        $ctrl.bind = bind;
        $ctrl.preInitUpload = preInitUpload;
        //for TemplateCompileCompCtrlService
        $ctrl.onLoaded = onLoaded;

        return $ctrl;

        function preInitUpload() {
            if ($ctrl.imagesOnly) {
                $ctrl.fileType = ['image/*', '.jpg', '.jpeg', '.svg', '.png', '.gif', '.tif', '.tiff', '.heic','.heif', '.bmp', '.ico', '.avif', '.webp'];
                $ctrl.txtFileType = 'images';
            }
            //console.log('UploadFilesCtrlService: init');
            //load the dropxzone
            if ($ctrl.autostart) {
                $ctrl.uploadFiles();
            } else {//load the current template for img
                if ($ctrl.onUploadFilesInit) {
                    $ctrl.onUploadFilesInit();
                }
                bind(false);

                if($ctrl.reloadTemplate) {
                    $ctrl.reloadTemplate();
                }
            }
        }

        function uploadFiles(e, editedFile) {
            $ctrl.preventDefault(e);
            if (isUploadingF) {
                return;
            }
            isUploadingF = true;
            console.log('uploadFiles');

            if (!$ctrl.templateCompileDrop) {
                $ctrl.templateCompileDrop = new TemplateCompileService(null);
            }
            $ctrl.templateCompileDrop.getItemTemplate = getDropTemplate;

            if (editedFile) {
                if (!$ctrl.extraParam) {
                    $ctrl.extraParam = {};
                }
                $ctrl.extraParam.editedFile = editedFile;
            }

            var params = {
                startOrder: $ctrl.startOrder,
                imagesOnly: $ctrl.imagesOnly,
                remainingSize: $ctrl.remainingSize,

                txtFileType: $ctrl.txtFileType,
                fileType: $ctrl.fileType,
                multipleFiles: $ctrl.multipleFiles,

                awsSignPath: $ctrl.awsSignPath,
                uploadObjService: $ctrl.uploadObjService,
                codeName: $ctrl.codeName,
                parentId: $ctrl.parentId,
                withSubparentId: $ctrl.withSubparentId,

                editorOptions: $ctrl.editorOptions,

                isSimpleUploader: $ctrl.isSimpleUploader,
                extraParam: $ctrl.extraParam,
                onRemoveDrop: onRemoveDrop,
            };

            if ($ctrl.onFileUploadSuccess) {
                params.onFileUploadSuccess = $ctrl.onFileUploadSuccess;
            }

            if ($ctrl.onFileUploadError) {
                params.onFileUploadError = $ctrl.onFileUploadError;
            }

            params.onBefore = onBefore;//$ctrl.onBeforeFilesUploaded;


            $ctrl.templateCompileDrop.loadTemplate(function () {
                console.log('uploadFiles loaded');
                isUploadingF = false;
            }, params, angular.element($ctrl.LCS.bodyElement));
        }

        function onBefore(result){
            console.log('onBeforeFilesUploaded1');
            if(typeof($ctrl.onBeforeFilesUploaded) === 'function') {
                $ctrl.onBeforeFilesUploaded({result: result});
            }
        }

        function getDropTemplate() {
            console.log('getDropTemplate : isSimpleUploader =' + $ctrl.isSimpleUploader);

            if($ctrl.dontShowActivity === 'true' || $ctrl.dontShowActivity === true) {
                if (!$ctrl.extraParam) {
                    $ctrl.extraParam = {};
                }
                $ctrl.extraParam.dontShowActivity = true;
            }

            return '<upload-drop-file ' +
                'product-id="::$ctrl.productId" ' +
                'class="upload-drop-file" ' +
                'start-order="::$ctrl.startOrder" ' +
                'remaining-size="::$ctrl.remainingSize" ' +
                'images-only="::$ctrl.imagesOnly" ' +

                'txt-file-type="::$ctrl.txtFileType" ' +
                'file-type="::$ctrl.fileType" ' +
                'multiple-files="::$ctrl.multipleFiles" ' +

                'max-number-of-files="::$ctrl.maxNumberOfFiles" ' +


                'aws-sign-path="::$ctrl.awsSignPath" ' +
                ($ctrl.codeName ? ('code-name="'+$ctrl.codeName+'" '):'') +
                'parent-id="::$ctrl.parentId" ' +
                'with-subparent-id="::$ctrl.withSubparentId" ' +

                'editor-options="::$ctrl.editorOptions" ' +

                'is-simple-uploader="::' + ($ctrl.isSimpleUploader === true) + '" ' +
                'extra-param="::$ctrl.extraParam" ' +
                ($ctrl.dontShowActivity ? 'dont-show-activity="true"' :'') +

                'upload-obj-service="$ctrl.uploadObjService" ' +
                'on-remove-drop="$ctrl.onRemoveDrop(result)" ' +
                (typeof($ctrl.onFileUploadSuccess) === 'function' ? 'on-success="$ctrl.onFileUploadSuccess(result)" ' : '') +
                (typeof($ctrl.onBeforeFilesUploaded) === 'function' ? 'on-before="$ctrl.onBefore(result)" ' : 'without-on-before="true"') +
                (typeof($ctrl.onFileUploadError) === 'function' ? 'on-error="$ctrl.onFileUploadError(id)" ' : '') +
                '></upload-drop-file>';
        }

        function onRemoveDrop(result) {
            console.log('REMOVE_FILE_UPLOADER');
            if($ctrl.extraParam && $ctrl.extraParam.editedFile) {
                delete $ctrl.extraParam.editedFile;
            }
            onMaterialInitDestroy();
        }

        function onUploadFilesDestroy() {
            bind(false);
            onMaterialInitDestroy();
        }

        function onMaterialInitDestroy() {
            if ($ctrl.templateCompileDrop) {
                $ctrl.templateCompileDrop.destroyNewScope();
            }
        }

        function onLoaded() {
            //console.log('onLoaded');
            if (!$ctrl.bindEvents) {
                $ctrl.bindEvents = [];
            }
            if ($ctrl.onItemLoaded) {
                $ctrl.onItemLoaded();
            }
            if ($ctrl.canUpload && $ctrl.uploaderTriggerClass) {
                if (!$ctrl.uploaderTrigger) {
                    $ctrl.uploaderTrigger = $ctrl.element.querySelector('.' + $ctrl.uploaderTriggerClass);
                }
                $ctrl.bindEvents.push({
                    element: $ctrl.uploaderTrigger,
                    method: $ctrl.uploadFiles,
                    nm: 'fileUpload'
                });
            }

            bind(true);
        }

        function bind(isBind) {
            if ($ctrl.bindEvents) {
                _.each($ctrl.bindEvents, function (item) {
                    $ctrl.LCS.bindElementsClick(isBind, item.element, item.method, item.nm, item.event);
                });
            }
        }

        function reBind(bindEvents, isBind) {
            $ctrl.bindEvents = bindEvents;
            bind(isBind);
        }
    };
}

angular.module('components.fileUploader.uploader.service', [
    'ngFileUpload',
    'easypiechart',
    'apiServices.MaterialVersions',
    'apiServices.Materials',
    'services.stateHeadersService',
    'components.imgEditor.service'
])
.service('UploaderCtrlService', UploaderCtrlService);

UploaderCtrlService.$inject = ['ImgEditorService', 'Upload', 'ResourcePathsService', 'MaterialVersionsService', 'MaterialsService', 'StateHeadersService', 'FileStatsService', 'LCS'];
function UploaderCtrlService(ImgEditorService, Upload, ResourcePathsService, MaterialVersionsService, MaterialsService, StateHeadersService, FileStatsService, LCS) {
    return function($ctrl) {

        if(!$ctrl.compLoaded){
            console.log('parent for must implement CompInitCtrlService' );
        }

        $ctrl.ImgEditorService = ImgEditorService;
        var AWS_CONFIGS = $ctrl.API_CONFIGS.AWS;
        var options = {
            animate: {
                duration: 1000,
                enabled: true
            },
            scaleLength: 0,
            trackColor: '#DBE2E3',
            lineWidth: 2,
            lineCap: 'round',
            size: $ctrl.customEasyChartSize ? $ctrl.customEasyChartSize : 46
        };

        $ctrl.OptionsUpload = _.extend({}, options, {barColor: DefaultTodoCardColor});

        if (!$ctrl.uploadRightAway) {
            $ctrl.uploadRightAway = true;
        }
        if (!$ctrl.fileId) {
            $ctrl.fileId = 'file';
        }
        $ctrl.getAWSPath = getAWSPath;
        $ctrl.initFile = initFile;
        $ctrl.getServerHeaders = getServerHeaders;
        $ctrl.presignS3Url = presignS3Url;
        $ctrl.getFileSizeText = FileStatsService.getFileSizeText;
        $ctrl.getUploadedFilesSize = FileStatsService.getFilesSize;
        $ctrl.matchFileType = matchFileType;
        $ctrl.onOneFileSelected = onOneFileSelected;
        $ctrl.onUSuccess = onUSuccess;
        $ctrl.onUFail = onUFail;
        $ctrl.onUProgress = onUProgress;
        $ctrl.start = start;
        $ctrl.onFileUploadProcess = onFileUploadProcess;
        $ctrl.onUploadComplete = onUploadComplete;
        if (!$ctrl.insertFileToDb) {
            $ctrl.insertFileToDb = insertFileToDb;
        }
        return $ctrl;

        function matchFileType(file) {
            if ($ctrl.fileType) {
                var valid = false;
                for (var n = 0; n < $ctrl.fileType.length; n++) {
                    var type = $ctrl.fileType[n];
                    if (file.type !== '') {
                        if (file.type.toLowerCase().indexOf(type) > -1) {
                            valid = true;
                        }
                    } else {
                        var str = file.name.toLowerCase().split('.');
                        if (str[str.length - 1] === type) {
                            valid = true;
                        }
                    }
                }

                if (!valid) {
                    return false;
                }
            }

            return true;
        }

        function getServerHeaders() {
            return angular.copy(StateHeadersService.stateHeaders);
        }

        function presignS3Url($file, next) {
            get_signed_request(initFile($file), next);
        }

        function get_signed_request($file, onSuccess) {
            var awsSignPath = $ctrl.awsSignPath || ResourcePathsService.getMaterialsPath() + '/sign_s3';
            $ctrl.security.postRequest(awsSignPath, {
                path: $file.path,
                size: $file.size,
                type: $file.type,
                name: $file.name,
            }, getServerHeaders(), function (res) {
                onSuccess(res.data);
            }, function (err) {
                console.log("Could not get signed URL.");
                onError($file, err);
            });
        }

        function getMetaFields(f) {
            var meta = {}, exists;
            _.each(['note'], function (p) {
                if(f.meta && f.meta[p]){
                    meta[p] = f.meta[p]; // here we pass the 'name' variable to the back end, with 'file.meta['name']' referring to the 'name' from our metaFields id above
                    exists = true;
                }
            });
            return meta;
        }

        function onError($file, err) {
            var error = err.status === 401 ? "You don't have access to upload new files" : (err.responseJSON ? ('Error uploading the file ' + err.responseJSON.error) : (err.data ? (err.data.message ? err.data.message : err.data) : 'Error uploading the selected file'));
            $ctrl.uploadObjService.update($file.id, {error: error});

            if ($ctrl.updateErrorUploading) {
                $ctrl.updateErrorUploading(error, $file);
            }
        }

        function initFile($file) {
            $file.createdAt = new Date();
            if(!$file.id) {
                $file.id = guidGenerator().replace(/-/g, '') + new ObjectId().toString();
            }
            if(!$file.path) {
                $file.path = getAWSPath() + $file.id + ($file.extension ? ('.'+$file.extension):'');
            }
            return $file;
        }

        function getAWSPath() {
            return $ctrl.companyId + '/' + ($ctrl.codeName || 'materials') + '/';
        }

        function onOneFileSelected(f, croppedImage, extraParam) {
            $ctrl.isUploading = true;
            var $file;
            if (croppedImage) {
                $file = window.dataURLtoBlob(croppedImage);
                $file.name = f.name;
            } else {
                $file = f;
            }

            $file = initFile($file);
            var id = $file.id;
            $ctrl.uploadObjService.set(id, {file: $file, progress: -1, error: null, result: null});

            if (!$ctrl.matchFileType($file)) {
                onError($file, {data: 'Invalid format file type'});
            } else {
                if ($ctrl.uploadRightAway) {
                    if (!extraParam) {
                        extraParam = {};
                    }
                    extraParam._id = id;

                    if (AWS_CONFIGS.enabled && !$ctrl.localUpload) {
                        get_signed_request($file, function (response) {
                            $ctrl.uploadObjService.update(id, {AWSInfo: response});
                            $ctrl.start(id, extraParam, true);
                        });
                    } else {
                        $ctrl.start(id, extraParam, false);
                    }
                }
            }
        }

        function onUSuccess(id, data, status) {
            console.log('onUSuccess: ' + id + ', response: ', data);
            var upload = $ctrl.uploadObjService.update(id, {result: data, ended: true});
            $ctrl.onUploadComplete(data, upload);
        }

        function onUFail(id, data, status) {
            console.log('onUFail: ' + id + ', response: ', data);
            if (status) {
                var updates = {ended: true};
                if (data) {updates.error = data.error ? data.error : (data.message ? data.message : data);}
                var upload = $ctrl.uploadObjService.update(id, updates);
                if ($ctrl.onFileUploadError) {
                    $ctrl.onFileUploadError(id);
                }
                if(upload) {$ctrl.uploadObjService.remove(id);}
            }
        }

        function onUProgress(id, evt) {
            // Math.min is to fix IE which reports 200% sometimes
            //console.log('onUProgress: '+ id)
            $ctrl.uploadObjService.update(id, {
                progress: Math.min(100, parseInt(100.0 * evt.loaded / evt.total, 10))
            });
        }

        function onUploadComplete(result, uploadData) {
            var file = uploadData ? uploadData.file : null,
                awsinfo = uploadData ? uploadData.AWSInfo : null,
                extraParam = uploadData ? uploadData.extraParam : null;
            if (AWS_CONFIGS.enabled && !$ctrl.localUpload) {
                file.path = awsinfo.path;
                file.isRemote = false;
                $ctrl.onFileUploadProcess(file, extraParam, onuploadsuccess, $ctrl.onError);
            } else {
                onuploadsuccess(result);
            }
        }

        function onuploadsuccess(result) {
            console.log('onuploadsuccess');
            //onFileUploaded for upload from btnUploads
            $ctrl.onFileUploadSuccess({result: result});
        }

        function onFileUploadProcess(file, extraParam, onSuccess, onError) {
            console.log('onFileUploadProcess');
            if(!file.url && !file.isRemote){
                file.url = file.preview;
            }
            if (!file.url && !file.isRemote) {
                try{
                    $ctrl.ImgEditorService.createFileURL(file.data || file, function (url) {
                        if (url) {
                            file.url = url;
                        }
                        onsuccess(file);
                    });
                }catch(e){
                    onsuccess(file);
                }
            } else {
                onsuccess(file);
            }

            function onsuccess(file) {
                getMetadata(file, process);

                function process(file) {
                    var type = file.type ? file.type.split(';')[0] : null;
                    var editedFile = extraParam && extraParam.editedFile ? extraParam.editedFile.file : null;
                    var info = {
                        size: file.size,
                        type: type,
                        name: file.name,
                        mimeType: type,
                        path: file.path,
                    };
                    if (info.order !== undefined) {
                        info.order = file.order;
                    }
                    //for file attachments and task cards S
                    if ($ctrl.withSubparentId) {
                        info.withSubparentId = $ctrl.withSubparentId;
                    }
                    if (file.notes) {
                        info.notes = file.notes;
                    }

                    if(editedFile && editedFile.metadata){
                        info.metadata = editedFile.metadata;
                    } else if(file.meta){
                        info.metadata = file.meta;
                    }
                    if(editedFile && editedFile.iptc){
                        info.iptc = editedFile.iptc;
                    } else if (file.iptc) {
                        info.iptc = file.iptc;
                    }

                    if(editedFile && editedFile.exif){
                        info.exif = editedFile.exif;
                    } else if (file.exif) {
                        info.exif = file.exif;
                    }
                    if (file.description) {
                        info.description = file.description;
                    }

                    if (file.tags) {
                        info.tags = file.tags;
                    }

                    if (file.createdTimestamp) {
                        info.createdTimestamp = file.createdTimestamp;
                    }

                    if (file.sbCustomLibrary) {
                        info.sbCustomLibrary = file.sbCustomLibrary;
                    } else if (file.sbMovieStills) {
                        info.sbMovieStills = file.sbMovieStills;
                    }
                    if (extraParam) {
                        info.extraParam = angular.copy(extraParam);
                    }

                    $ctrl.insertFileToDb(info, next, onError || $ctrl.onError);

                    function next(result) {
                        (onSuccess || onuploadsuccess)(_.extend(result || {}, {
                            bindToItemId: file.bindToItemId,
                            activityId: file.activityId,
                            activityType: file.activityType
                        }));
                    }
                }
            }
        }

        function insertFileToDb(info, onSuccess, onError) {
            info = angular.copy(info);
            info.companyId = $ctrl.companyId;
            info.productId = $ctrl.productId;
            info.codeName = $ctrl.codeName;
            if ($ctrl.isMaterial) {
                var p = $ctrl.SBStateService.getCurrentStateParams();
                info.materialId = p.materialId;
                MaterialVersionsService.insert(MaterialVersionsService.convertResource(info), onSuccess, onError);
            } else {
                //upload the images into the library for future usage
                var extraParam = info.extraParam;
                if(extraParam){
                    var codeName =  extraParam.codeName;
                    if (codeName) {
                        info.codeName = codeName;
                        delete info.extraParam.codeName;
                    } else {
                        var parentId = extraParam.parentId;
                        info.parentId =parentId || null;
                        delete info.extraParam.parentId;
                    }
                    if(extraParam.editedFile){
                        info.extraParam.editedFile = extraParam.editedFile.versionId;
                    }
                }else if($ctrl.parentId){
                    info.parentId =$ctrl.parentId;
                }

                if(!info.sbCustomLibrary){
                    info.isFolder = false;
                }

                MaterialsService.insert(MaterialsService.convertResource(info), onSuccess, onError);
            }
        }

        function getMetadata(file, done) {

            var type = file.type.toLowerCase();
            // create url to use as the src of the video
            var fileURL = file.url;

            if(!fileURL){
                return next(file);
            }

            if(!file.meta) {file.meta = {};}

            try {
                if (type.indexOf('video') !== -1) {
                    //width height duration
                    var vid = document.createElement('video');
                    vid.src = fileURL;
                    // wait for duration to change from NaN to the actual duration
                    var t = 0;
                    vid.ondurationchange = function () {
                        if (this.duration) {
                            file.meta.duration = this.duration;
                        }
                        onsuccess();
                    };
                    vid.onloadedmetadata = function () {
                        if (vid.videoWidth) {
                            file.meta.width = vid.videoWidth;
                        }
                        if (vid.videoHeight) {
                            file.meta.height = vid.videoHeight;
                        }
                        onsuccess();
                    };

                    function onsuccess() {
                        t++;
                        if (t === 2) {
                            next(file);
                        }
                    }
                } else if (type.indexOf('image') !== -1) {
                    //width height
                    $ctrl.ImgEditorService.downloadImage(fileURL, function (meta) {
                        file = _.extend(file, meta);
                        next(file);
                    });
                } else if (type.indexOf('pdf') !== -1) {
                    var url = null;//todo change
                    if (url) {
                        PDFJS.getDocument(url).then(function (pdf) {
                            pdf.getMetadata()
                                .then(function (meta) {
                                    if (meta) {
                                        file.meta = _.extend(file.meta, metadata);
                                    }
                                    next(file);
                                }).catch(onError);
                        }).catch(onError);
                    } else {
                        next(file);
                    }
                } else {
                    next(file);
                }
            } catch (e) {
                onError(e);
            }

            function onError(e) {
                console.log(e);
                next(file);
            }
            
            function next(file) {
                $ctrl.ImgEditorService.revokeObjectURL(fileURL);
                done(file);
            }
        }

        function start(id, data, isAWSUpload) {
            var up = $ctrl.uploadObjService.get(id);
            up = $ctrl.uploadObjService.update(id, {
                error: null,
                progress: 0,
                abort: abort
            });
            getMetadata(up.file, upload);

            function upload(file) {
                var options = null;
                var uploadFromGenerator = data.uploadFromGenerator;
                if (uploadFromGenerator) {
                    delete data.uploadFromGenerator;
                }
                var headers = getServerHeaders();
                if (isAWSUpload) {
                    up = $ctrl.uploadObjService.update(id, {extraParam: data});
                    //     headers['Cache-Control'] = 'max-age= 31536000, public';
                    //     headers['Expires'] = "access plus 1 year";
                    headers['Content-Type'] = 'application/octet-stream'; // file.type != '' ? file.type : 'application/octet-stream'
                    headers['Content-Disposition'] = 'attachment; filename=' + encodeURIComponent(file.name);
                    options = {
                        url: up.AWSInfo.signed_request,
                        method: 'PUT',
                        headers: headers,
                        data: file,
                        /*  dataType : "text",
                         processData: false,
                         contentType: file.type,
                         cache : false,
                         */
                    };

                    $ctrl.uploadObjService.update(id, {
                        uploading: uploadAWS(id, options)
                    });
                } else {
                    if(uploadFromGenerator){
                        headers = $ctrl.security.getAuthorizeHeaders();
                    }
                    delete data._id;
                    options = {
                        url: (uploadFromGenerator ? $ctrl.security.getGeneratorUrl() : '') + $ctrl.url,
                        method: 'POST',
                        headers: headers,
                        data: data,
                        file: file
                    };

                    $ctrl.uploadObjService.update(id, {
                        uploading: uploadForm(id, options)
                    });
                }
            }

            function uploadAWS(id, options) {
                return Upload.http(options)
                    .progress(function (evt) {
                        $ctrl.onUProgress(id, evt);
                    })
                    .success(function (data, status, headers, config) {
                        $ctrl.onUSuccess(id, data, status);
                    })
                    .error(function (data, status, headers, config) {
                        $ctrl.onUFail(id, data, status);
                    });
            }

            function uploadForm(id, options) {
                var xhr = new XMLHttpRequest();
                xhr.open(options.method, options.url, true);

                if (options.headers) {
                    for (var key in options.headers) {
                        xhr.setRequestHeader(key, options.headers[key]);
                    }
                }

                // Update progress (can be used to show progress indicator)
                LCS.bindElementListeners(true, xhr.upload, onProgress, 'progress');
                LCS.bindElementListeners(true, xhr, onReadyState, 'readystatechange');


                var form = new FormData();
                if (options.data) {
                    for (var prop in options.data) {
                        form.append(prop, options.data[prop]);
                    }
                }
                form.append('file', options.file);
                xhr.send(form);

                return xhr;

                function onProgress(e) {
                    $ctrl.onUProgress(id, e);
                }

                function onReadyState(e) {
                  /*0 UNSENT - open()has not been called yet
                    1 OPENED - send()has not been called yet
                    2 HEADERS_RECEIVED - send() has been called, and headers and status are available
                    3 LOADING Downloading; - responseText holds partial data
                    4 - The operation is complete */

                    if (xhr.readyState === 4) {
                        var response;
                        try{
                            response = JSON.parse(xhr.responseText);
                        }catch (e) {

                        }
                        if(xhr.status.toString() === '200') {
                            $ctrl.onUSuccess(id, response, xhr.status);
                        } else{
                            $ctrl.onUFail(id, response, xhr.status);
                        }
                    }
                }
            }

            function abort(item) {
                if (item.uploading) {
                    item.uploading.abort();
                }
            }

        }
    }
}



angular.module('components.fileUploader.uploads.service', [
])
.service('UploadObjService', UploadObjService);
function UploadObjService() {
    return function () {
        var uploads = {};
        return {
            uploads: uploads,
            set: set,
            get: get,
            update: update,
            remove: remove,
            countUploads: countUploads
        };

        function set(id, val) {
            uploads[id] = val;
        }

        function get(id) {
            return uploads[id];
        }

        function update(id, updates) {
            var item = uploads[id];
            if (!item) {
                return null;
            }
            uploads[id] = _.extend(item, updates);
            return uploads[id];
        }

        function remove(id) {
            delete uploads[id];
        }

        function countUploads() {
            var i = 0;
            if (uploads) {
                for (var prop in uploads) {
                    i++;
                }
            }
            return i;
        }
    }
}


