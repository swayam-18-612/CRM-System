ProductOnboardingPopupCtrl.$inject = ['UserOnboardingPopupCtrlService', '$element'];
function ProductOnboardingPopupCtrl(UserOnboardingPopupCtrlService, $element) {
    var $ctrl = this;

    $ctrl.UserOnboardingPopupCtrlService = UserOnboardingPopupCtrlService;

    $ctrl.getItemPopupTemplate = getItemPopupTemplate;

    $ctrl = new $ctrl.UserOnboardingPopupCtrlService($ctrl, $element);

    function getItemPopupTemplate() {
        $ctrl.isFirstTime = $ctrl.item.isFirstTime;
        return $ctrl.getItemPopupMSForm(getWrappers().map(getWrapper), 'onboarding' + ($ctrl.isFirstTime ? ' many-slides' : ''), false);

        function getWrappers() {
            var btnText = 'Next';
            return $ctrl.isFirstTime ? [
                {id:1, content: getWelcome(null, btnText), bg: '#FA1971', type: 'projects', imgId: 1, btnText: btnText, oneColumn: true},
                {id:1, content: getWrite(), bg: '#FFA600', type: 'screenplays'},
                {id:2, content: getBreakdown(), bg: '#1693F2', type: 'breakdowns'},
                {id:3, content: getCollaborate(), bg: '#F51B79', type: 'materials'},
                {id:4, content: getVisualize(), bg: '#6E3EFF', type: 'storyboards'},
                {id:5, content: getShoot(), bg: '#00C990', type: 'callsheets'},
            ]: [];

            function getWelcome(withIcon, btnText) {
                return $ctrl.getIT('studiobinder', 'Welcome to StudioBinder!', withIcon, true) +
                    '<p>Whether you’re a studio or a filmmaker, StudioBinder takes you from development through production.</p>' +
                    '<div class="table-bottom clearfix">' +
                    '<ul class="progressdots pull-left">' +
                    '<li><button class="with-primary-bg-before active"></button></li>' +
                    '<li><button class="nextbtn" sibling="1"></button></li>' +
                    '<li><button class="nextbtn" sibling="2"></button></li>' +
                    '<li><button class="nextbtn" sibling="3"></button></li>' +
                    '<li><button class="nextbtn" sibling="4"></button></li>' +
                    '</ul>' +
                    $ctrl.getbtnnext(true, btnText) +
                    '</div>';
            }

            function getWrite(withIcon, btnText) {
                return $ctrl.getIT('solution-write', 'Write your script', withIcon) +
                    '<p>Outline and write scripts in standard formats. When you’re done, create your shooting script to begin pre-production.</p>' +
                    $ctrl.getAccordion({
                        title: 'Importing a script?',
                        content: 'Already have a script? Import it and keep writing in StudioBinder. You can import SBX, FDX, PDF, Fountain files.'
                    }) +
                    '<div class="table-bottom clearfix">' +
                    '<ul class="progressdots pull-left">' +
                    '<li><button class="with-primary-bg-before active"></button></li>' +
                    '<li><button class="nextbtn" sibling="1"></button></li>' +
                    '<li><button class="nextbtn" sibling="2"></button></li>' +
                    '<li><button class="nextbtn" sibling="3"></button></li>' +
                    '<li><button class="nextbtn" sibling="4"></button></li>' +
                    '</ul>' +
                    $ctrl.getbtnnext(true, btnText) +
                    '</div>';
            }

            function getBreakdown(withIcon, btnText) {
                return $ctrl.getIT('solution-breakdown', 'Break it down', withIcon) +
                    '<p>Tag script elements like props, wardrobe and set dressing. Create schedules, breakdowns, DOOD reports, and share with your team.</p>' +
                    $ctrl.getAccordion({
                        title: 'What kind of reports?',
                        content: 'Share shooting schedules, breakdown sheets, element reports, and Day out of Days (DOOD) reports.'
                    }) +
                    '<div class="table-bottom clearfix">' +
                    '<ul class="progressdots pull-left">' +
                    '<li><button class="previousbtn"></button></li>' +
                    '<li><button class="with-primary-bg-before active"></button></li>' +
                    '<li><button class="nextbtn" sibling="1"></button></li>' +
                    '<li><button class="nextbtn" sibling="2"></button></li>' +
                    '<li><button class="nextbtn" sibling="3"></button></li>' +
                    '</ul>' +
                    $ctrl.getbtnnext(true, btnText) +
                    '</div>';
            }

            function getCollaborate(withIcon, btnText) {
                return $ctrl.getIT('solution-plan', 'Collaborate with teams', withIcon) +
                    '<p>Production is a team effort. Track progress with tasks and calendars. Build a contact database together, send messages, and share files.</p>' +
                    $ctrl.getAccordion({
                        title: 'How to collaborate with others?',
                        content: 'Invite collaborators to view or edit specific pages. Add team members to manage entire projects.'
                    }) +

                    '<div class="table-bottom clearfix">' +
                    '<ul class="progressdots pull-left">' +
                    '<li><button class="previousbtn" sibling="2"></button></li>' +
                    '<li><button class="previousbtn" sibling="1"></button></li>' +
                    '<li><button class="with-primary-bg-before active"></button></li>' +
                    '<li><button class="nextbtn" sibling="1"></button></li>' +
                    '<li><button class="nextbtn" sibling="2"></button></li>' +
                    '</ul>' +
                    $ctrl.getbtnnext(true, btnText) +
                    '</div>';
            }

            function getVisualize(withIcon, btnText) {
                return $ctrl.getIT('solution-visualize', 'Visualize your shots', withIcon) +
                    '<p>A shared vision is a powerful vision. Create mood boards, storyboards, and shot lists to turn the vision into reality.</p>' +
                    $ctrl.getAccordion({
                        title: 'No artist? No problem.',
                        content: 'Upload photos or take webcam shots of sketches.'
                        //todo bring back
                        //+', or select from 1000’s of free, high-res movie stills.'
                    }) +

                    '<div class="table-bottom clearfix">' +
                    '<ul class="progressdots pull-left">' +
                    '<li><button class="previousbtn" sibling="3"></button></li>' +
                    '<li><button class="previousbtn" sibling="2"></button></li>' +
                    '<li><button class="previousbtn" sibling="1"></button></li>' +
                    '<li><button class="with-primary-bg-before active"></button></li>' +
                    '<li><button class="nextbtn" sibling="1"></button></li>' +
                    '</ul>' +
                    $ctrl.getbtnnext(true, btnText) +
                    '</div>';
            }

            function getShoot(withIcon, btnText) {
                return $ctrl.getIT('solution-shoot', 'Ready to shoot!', withIcon) +
                    '<p>Create, send and track industry-standard call sheets — auto-personalized for every recipient, and sent via email and text.</p><p>Everyone on set… and on time.</p>' +
                    $ctrl.getAccordion({
                        title: 'How are call sheets sent and tracked?',
                        content: 'Call sheets are sent as PDFs and email digests. Track delivery, bounces, views, and RSVPs.'
                    }) +

                    '<div class="table-bottom clearfix">' +
                    '<ul class="progressdots pull-left">' +
                        '<li><button class="previousbtn" sibling="4"></button></li>' +
                        '<li><button class="previousbtn" sibling="3"></button></li>' +
                        '<li><button class="previousbtn" sibling="2"></button></li>' +
                        '<li><button class="previousbtn" sibling="1"></button></li>' +
                        '<li><button class="with-primary-bg-before active"></button></li>' +
                    '</ul>' +
                    $ctrl.getbtnnext(true, btnText) +
                    '</div>';
            }
        }

        function getWrapper(el) {
            return {
                fCls: el.fCls,
                btn: $ctrl.getbtnnext(el.btnText),

                body: '<div id="wrapper' + el.id + '" class="wrapper full-width ' + (el.oneColumn ? 'one-column ' : 'table-div ') + (el.fCls || '') + '">' +
                        '<div class="centered left '+(el.fCls ||  'clearfix ')+'">' + getVideo() + '</div>' +
                        '<div class="right">' + el.content + '</div>' +
                      '</div>'
            };

            function getVideo(){
                var p = 'emptystate/' + (el.type ? el.type : el.img) + '/emptystate' + (el.imgId || '') + '.';
                if(el.type){
                    var poster = el.noPoster ? '' : ('poster="' + $ctrl.LCS.getImgUrl(p + ($ctrl.LCS.webPEnabled ? 'webp' : 'jpg')) + '"');
                    return '<video class="video-anime" style="width:600px;max-width:100%;width:1" muted playsinline autoplay="autoplay" loop="loop" ' + poster +
                            '><source src="' + $ctrl.LCS.getVideoUrl(p + 'mp4') + '" type="video/mp4"></video>';
                } else{
                    return '<img style="max-width: 100%" src="' + $ctrl.LCS.getImgUrl(p + ($ctrl.LCS.webPEnabled ? 'webp' : 'png')) + '"/>';
                }
            }
        }
    }
}

angular.module('product.overview.productInfoBoxes.component',[
    'product.overview.productInfoBoxes.service',
    'sb.fields.methods.service'
])
.component('productOverviewBoxes', {
    bindings: {
        stats: '<?',
        overviewBlocks: '<',
        overviewParentBlocks: '<',
        customOverviewBlocks: '<'
    },
    controller: 'ProductOverviewBoxesCtrl'
})
.controller('ProductOverviewBoxesCtrl', ProductOverviewBoxesCtrl);

ProductOverviewBoxesCtrl.$inject = ['ProductOverviewBoxesService', 'TemplateCompileCompCtrlService', 'TemplateCompileService', '$element'];
function ProductOverviewBoxesCtrl (ProductOverviewBoxesService, TemplateCompileCompCtrlService, TemplateCompileService, $element) {
    console.log('ProductOverviewBoxesCtrl');
    var $ctrl = this;
    $ctrl.id = 'boxes' + new ObjectId().toString();

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInit = preInit;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl.getBlockUrl = ProductOverviewBoxesService.getBlockUrl;
    $ctrl.getOverviewBlockIds = ProductOverviewBoxesService.getOverviewBlockIds;
    $ctrl.clearOverview = ProductOverviewBoxesService.clear;

    $ctrl.goToLink = goToLink;

   var withoutTemplateScope = false;
    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        $ctrl.entries = null;
        $ctrl.title = 'Latest Posts';
        setOverviewBoxesContent();
    }

    function getItemTemplate() {
return '<div id="' + $ctrl.id + '" class="margin-bottom-half tab-content with-no-bg tabbable product-dashboard-boxes">' +
            '<div class="overview-boxes product-boxes"></div>' +
            '<div class="side-posts">' +
                '<div class="product-boxes">' +
    getAcademy()+
    //'<feature-feed-post class="product-box sidepost"></feature-feed-post>' +
    ($ctrl.tutorialSources&&$ctrl.tutorialSources.length>0 ? ('<tutorial-feed-post sources="$ctrl.tutorialSources" class="product-box sidepost tutorialposts"></tutorial-feed-post>'): '') +
                '</div>' +
            '</div>' +
        '</div>';
    }

    function processParents(m){
        return _.sortBy(listToArray($ctrl.overviewParentBlocks), 'order').map(m).join('');
    }

    function listToArray(obj) {
        var l = [];
        for (var id in obj) {
            l.push(obj[id]);
        }
        return l;
    }

    function setOverviewBoxesContent() {
        $ctrl.tutorialSources = [];
        $ctrl. overviewBlockIds = $ctrl.getOverviewBlockIds();
        if ($ctrl.overviewBlockIds) {
            $ctrl.clearOverview();
        }

        $ctrl.overviewBoxesContent = loadOverviewBoxInfo($ctrl.overviewBlocks, $ctrl.overviewBlockIds);

        function loadOverviewBoxInfo(overviewBlocks, oids) {
            if(!oids){return '';}
            return processParents(function (parent) {
                return processParent(listToArray(overviewBlocks), parent);

                function processParent(list, parent) {
                    var max = 1, childrenClass = 'children',
                        parentClass = 'product-box-parent',
                        ch = _.sortBy(_.filter(list, function (item) {
                            return item.parentNavId === parent._id && oids.indexOf(item._id) !== -1;
                        }), 'navOrder');

                    if (ch.length > max) {
                        max = ch.length;
                    }
            return '<div class="' + parentClass + ' h-full table-div full-width ' + (ch.length ? '' : 'sb-hide') + '">' +
                        '<div class="col-sol centered" style="background-color:' + parent.color + '">' +
                            '<div class="text-center">' +
                                '<div class="centered circled-svg-colored small60 white ' + parent.icon + '">' + $ctrl.LCS.getISBDiv(parent.icon + '-white', 6) + '</div>' +
                            '</div>' +
                            '<div class="text-center type semibold">' + parent.name + '</div>' +
                        '</div>' +
                        '<div class="col-children centered">' +
                            '<div class="' + childrenClass + '">' + getChildren(ch) + '</div>' +
                        '</div>' +
                    '</div>';

                    function getChildren(ch) {
                        if (!ch || !ch.length) {
                            return '';
                        }

                        return ch.map(function (item) {
                            item.sType = $ctrl.stats[item.type] || 0;
                            addSources(item.tutorialFeeds);

                            if (!item.isSelectable && !item.canBringBack) {
                                return '';
                            }
                            return '<a class="with-cursor sb-bob-hover" ' +
                                (item.isComingSoon ? '' : getHref(item)) +
                                '>' +
                                '<div class="table-div full-width h-full">' +
                                '<div class="centered">' +
                                '<div class="text-center">' +
                                '<div class="sb-bob centered">' +
                                $ctrl.LCS.getISBDiv(item.icon, item.iconLevel, 'sbf40 colored') +
                                '</div>' +
                                /*    (item.isCustom ? '' : (
                                        '<span class="count">' + item.sType + '</span>' +
                                        '<span class="unit">' + item.unit + (item.sType.withoutPlural ? '' : (item.sType === 1 ? '' : 's')) + '</span>')) +*/
                                '</div>' +

                                '<div class="text-center type semibold spacing-quarter-top" style="color:' + item.color + '">' + item.name + '</div>' +
                                (item.isComingSoon ? '<div class="unit font-size-10">(Coming soon)</div>' : '') +
                                '</div>' +
                                '</div>' +
                                '</a>';


                            function getHref(item) {
                                return 'data-type="' + (item.url || item.type) + '"';
                            }

                            function addSources(feeds) {
                                var l = feeds && feeds.length > 0 ? feeds.length : 0;
                                if (l > 0) {
                                    for (var j = 0; j < l; j++) {
                                        addSource(feeds[j]);
                                    }
                                }

                                function addSource(source) {
                                    if (source && _.find($ctrl.tutorialSources, function (item) {
                                        return (item.category === source.category)
                                    }) === undefined) {
                                        $ctrl.tutorialSources.push(source);
                                    }
                                }
                            }
                        }).join('');
                    }
                }
            });

        }
    }

    function getAcademy(){
return '<div class="product-box sidepost academy">' +
            '<div class="header text-center">' +
                '<div class="centered circled-svg-colored small60 blue">' + $ctrl.LCS.getISBDiv('book-open', 2) + '</div>'+
                '<div class="t1">StudioBinder Academy</div>'+
                '<div class="t2">Watch product tutorials</div>' +
            '</div>' +
            '<div class="body">' +
                m({
                    iconLevel :2,
                    withoutcolor:true,
                    icon:'home-door',
                    name:'Get Started',
                    withouturl: true
                }) + processParents(m) +
            '</div>' +
        '</div>';

        function m(p){
    return '<a class="item" target="_blank" href="https://www.studiobinder.com/tutorials/'+(p.withouturl  ? '' : p.name.toLowerCase())+ '">' +
            '<div class="centered circled-svg-colored small30 ' + p.icon + '">' + $ctrl.LCS.getISBDiv(p.icon + (p.withoutcolor ? '' : '-color'), p.iconLevel ? p.iconLevel : 6) + '</div>' +
            '<div class="type">' + p.name + '</div>'+
        '</a>';
        }
    }
    function onLoaded() {
        $ctrl.overviewBoxesEl = $ctrl.element.querySelector('.overview-boxes');
        //console.log('ProductOverviewBoxesCtrl is reloading');
        /*var rowsX = content.querySelectorAll('.product-box-parent .col-children .children');
        _.each(rowsX, function (row) {
            row.setAttribute('style', 'grid-template-columns: repeat('+max+',1fr)');
        });*/
        //todo test when necessary
        //processList($ctrl.customOverviewBlocks);
        if (!$ctrl.compileTemplate) {
            $ctrl.compileTemplate = new TemplateCompileService($ctrl.overviewBoxesEl, function () {
                return '<div>' + $ctrl.overviewBoxesContent + '</div>';
            }, $ctrl);
        }

        reloadBoxes();

        function reloadBoxes() {
            if ($ctrl.overviewBlockIds) {
                $ctrl.clearOverview();
                $ctrl.compileTemplate.loadTemplate(onLoaded);
            }

            function onLoaded() {
                console.log('onLoaded');
                bind(false);
                $ctrl.LCS.timeout(function () {
                    bind(true);
                }, 100);
            }
        }
    }
    function bind(isBind){
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.element['querySelectorAll']('a.sb-bob-hover'), $ctrl.goToLink);
    }

    function goToLink(e) {
        var t = e.currentTarget.getAttribute('data-type');
        if (t) {
            $ctrl.CPS.transitionTo('user.product.' + t, $ctrl.CPS.currentProductPathParams());
        }
    }

    function onDestroy() {
        bind(false);
    }
}

angular.module('product.overview.productInfoBoxes.service', [
])
.service('ProductOverviewBoxesService', ProductOverviewBoxesService);
ProductOverviewBoxesService.$inject = ['CPS'];
function ProductOverviewBoxesService(CPS) {
    var overviewBlockIds, onboardingf, isChanged;

    var $ctrl = this;
    $ctrl.security = CPS.security;
    $ctrl.SBStateService = CPS.SBStateService;

    $ctrl.clear = clear;

    $ctrl.setChanged = setChanged;
    $ctrl.getChanged = getChanged;

    $ctrl.setOverviewBlockIds = setOverviewBlockIds;
    $ctrl.getOverviewBlockIds = getOverviewBlockIds;

    $ctrl.getOnboardingf = getOnboardingf;
    $ctrl.setOnboardingf = setOnboardingf;
    $ctrl.goToBlockUrl = goToBlockUrl;
    $ctrl.getBlockUrl = getBlockUrl;

    function clear() {
        isChanged = null;
        overviewBlockIds = null;
        onboardingf = null;
    }

    function setChanged(p) {
        isChanged = p;
    }

    function getChanged() {
        return isChanged;
    }

    function setOverviewBlockIds(p) {
        overviewBlockIds = p;
    }

    function getOverviewBlockIds() {
        return overviewBlockIds;
    }

    function setOnboardingf(p) {
        onboardingf = p;
    }

    function getOnboardingf() {
        return onboardingf;
    }

    function getBlockUrl(url) {
        if (!url) {
            return;
        }
        var px = $ctrl.SBStateService.getCurrentStateParams();
        var r = url.split('/'), p = {productId: px.productId ? px.productId : null};
        if (r.length > 1) {
            var p1 = r[1].split(':');
            p[p1[0]] = p1[1];
        }
        return $ctrl.SBStateService.getStateHref( 'user.product.' + r[0], $ctrl.security.currentPathParams(p));
    }

    function goToBlockUrl(e, url) {
        if (!url) {
            return;
        }
        var px = $ctrl.SBStateService.getCurrentStateParams();
        var r = url.split('/'), p = {productId: px.productId ? px.productId : null};
        if (r.length > 1) {
            var p1 = r[1].split(':');
            p[p1[0]] = p1[1];
        }
        var name = 'user.product.' + r[0], params = $ctrl.security.currentPathParams(p);
        if (e && e.shiftKey) {
            $ctrl.SBStateService.openInNewWindow(name, params);
        } else {
            $ctrl.SBStateService.transitionTo(name, params);
        }
    }
}

angular.module('product.overview.productInfo.component',[
    'product.productDetails.list.component'
])
.component('productOverviewInfo',  {
    bindings: {
        item: '<',
        elemType: '@'
    }, 
    controller: 'ProductOverviewInfoCtrl'
})

.controller('ProductOverviewInfoCtrl', ProductOverviewInfoCtrl);

ProductOverviewInfoCtrl.$inject = ['TemplateCompileService','ImgUploadInitService', 'ListItemTemplateFormCtrlService', 'ProductsService', '$element'];
function ProductOverviewInfoCtrl(TemplateCompileService, ImgUploadInitService, ListItemTemplateFormCtrlService, service, $element) {
    var $ctrl = this;

    $ctrl.btnEditClass = 'edit-profile';
    $ctrl.contentElClass= 'contentElement';

    $ctrl.toggleEdit = toggleEdit;
    $ctrl.onUpdateStats = onUpdateStats;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitOther = preInitOther;
    $ctrl.postInitOther = postInitOther;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

    function preInitOther() {
        $ctrl.isOpened = false;
        $ctrl.canEdit = true;

        $ctrl.elemType = 'productinfo';
        $ctrl.currentListId = null;

        $ctrl.type = 'Edit';
        $ctrl.objectType = 'product';
        $ctrl.service = service;

        $ctrl.extraParam = {service: $ctrl.service};

        $ctrl.onChangeOther = onChangeOther;
        $ctrl.onEmpty = onEmpty;
    }

    function postInitOther(){
        $ctrl.reloadListItemTemplate();

        $ctrl.onImageUpdate = onImageUpdate;
        $ctrl = new ImgUploadInitService($ctrl, false);
    }

    function onLoaded() {
        reloadContent();
    }

    function onDestroy() {
        if($ctrl.contentCompile){
            $ctrl.contentCompile.destroyNewScope();
        }
    }

    function toggleEdit(e) {
        $ctrl.preventDefault(e);

        $ctrl.isOpened = !$ctrl.isOpened;
        reloadContent();
    }

    function getItemTemplate() {
        console.log('getItemTemplate');
return '<div class="profile-top-content one-line-tooltip">' +
            '<div class="table-div full-width">' +
                '<div class="top-card-cell left unit-xs centered">' +
                    '<div>'+
                         $ctrl.security.getProjectImageComponent('$ctrl.item', 'large280',
                            'with-img-bg="true" ' +
                            'c-class-attr="centering" ' +
                            'default-text="Project Image" ' +
                            ($ctrl.canEdit?' can-upload-attr="true" is-avatar-attr="true" collection-prop="products" ' : '')
                         ) +
                        '<div class="name text-center hide-desktop hide-print">' + $ctrl.item.getName() + '</div>' +
                    '</div>'+
                '</div>' +
                '<div class="top-card-cell white-bg right unit-xs tree-node" data-id="null">' +
                    '<a class="'+$ctrl.btnEditClass+' hide-print btn btn-small primary-faded-gray without-text" ng-click="$ctrl.toggleEdit($event)" ng-style="{\'display\':($ctrl.LCS.isMobileSize || $ctrl.isOpened) ? \'block\':\'none\'}" ' +
                    'tooltip="{{$ctrl.isOpened?\'Done\':\'Edit\'}}" tooltip-placement="bottom">' +
                        '<div class="sbf {{$ctrl.isOpened?\'cancel\':\'pencil\'}}">'+$ctrl.LCS.getISBPath(2)+'</div>' +
                    '</a>' +
                    '<div class="full-width margin-top-half">' +
                        '<div class="semiheader hide-desktop hide-print">Project Details</div>' +
                        '<div class="'+$ctrl.contentElClass+'"></div>' +
                    '</div>' +
                '</div>' +
             '</div>' +
        '</div>';
    }

    function reloadContent() {
        if (!$ctrl.contentElement) {
            $ctrl.contentElement = $ctrl.element.querySelector('.' + $ctrl.contentElClass);
        }

        if (!$ctrl.contentCompile) {
            $ctrl.contentCompile = new TemplateCompileService(angular.element($ctrl.contentElement), getContent, $ctrl);
        }

        setHeight($ctrl.contentElement.offsetHeight +'px');
        $ctrl.contentCompile.loadTemplate(onLoaded);

        function getContent() {
            return ($ctrl.isOpened ? getEditMode() : getViewMode()) +
                getDetails();
        }

        function getDetails(){
            var isCanEdit = false,// $ctrl.canEdit;
                isEditMode = false; //$ctrl.canEdit && $ctrl.isOpened ? true : false;
            return '<product-details ' +
                'is-can-edit="::' + isCanEdit + '" ' +
                'is-edit-mode="::' + isEditMode + '" ' +
                'class="clearfix table-cell full-width" ' +
                'on-empty="$ctrl.onEmpty()" ' +
                'on-update-stats="$ctrl.onUpdateStats(result)"' +
                '></product-details>';
        }
        function onLoaded() {
            setHeight(0);
        }

        function setHeight(val) {
            if ($ctrl.contentCompile) {
                $ctrl.LCS.setCSSStyle($ctrl.contentElement, 'min-height', $ctrl.contentElement.offsetHeight + 'px');
            }
        }

        function getEditMode() {
            return '<form style="max-width: 100%" name="$ctrl.formHolder.form'+$ctrl.item._id+'" novalidate autocomplete="off" class="form-wrapper full-width" autocomplete="off">' +
                getForm() +
                /*'<div class="form-group field">' +
                    '<input placeholder="Project Name…" class="form-control with-underline name" type="text" id="name{{::$ctrl.item._id}}" name="name{{::$ctrl.item._id}}" ng-model="$ctrl.item.name" required style="height:50px" ng-model-options="$ctrl.modelOptions">' +
                    '<div ng-if="$ctrl.showError(\'name\',\'required\')" class="help-inline">Project name is required.</div>' +
                    '<div ng-if="$ctrl.showError(\'name\',\'duplicate\')" class="help-inline" ng-bind="$ctrl.formHolder[\'form\'+$ctrl.item._id][\'name\' + $ctrl.item._id].$error.duplicate"></div>' +
                '</div>' +*/
                '</form>';

            function getForm() {
                var eClassAttr= 'form-control with-underline ' + $ctrl.pageClass;
                var columns = [{
                        type: $ctrl.SBFieldTypesService.PropTypes.Field,
                        prop: 'name',
                        tabIndex: 1,
                        tabNextIndex: 2,
                        placeholder: 'Project Name…',
                        name: 'Name',
                        eClassAttr: eClassAttr,
                        fieldClass: 'name',
                        isRequired: true,
                        canEdit: true
                    }, {
                        type: $ctrl.SBFieldTypesService.PropTypes.Field,
                        prop: 'production',
                        tabIndex: 1,
                        tabNextIndex: 2,
                        placeholder: 'Production Company…',
                        name: 'Production',
                        eClassAttr: eClassAttr + ' bold',
                        icon: 'company',
                        iconLevel: 3,
                        isRequired: true,
                        canEdit: true
                    }, {
                        type: $ctrl.SBFieldTypesService.PropTypes.Address,
                        prop: 'address',
                        tabIndex: 2,
                        tabNextIndex: 3,
                        placeholder: 'Production Company Address…',
                        name: 'Address',
                        eClassAttr: eClassAttr,
                        fieldClass: 'address',
                        icon: 'pin',
                        canEdit: true,
                        otherHtml: '<div class="wide-tooltip max300 hide-ipad position-absolute" style="height: 0;left:100%;top:0"' +
                            ' tooltip-placement="left" tooltip="The production company address will be displayed on call sheets and reports."' +
                            '><div style="right: 0;top: 0" ' +
                            'class="sbf info blueish position-absolute"' +
                            '>'+$ctrl.LCS.getISBPath(4)+'</div></div>'
                    }];

                return $ctrl.SBFieldTypesService.getPopupSBForm($ctrl, columns, {
                    withService: true,
                    onChangeOther: $ctrl.onChangeOther
                });
            }
        }

        function getViewMode() {
            var el = '<div class="name hide-ipad">' +  $ctrl.LCS.encodeHTML($ctrl.item.getName()) + '</div>';
            if ($ctrl.item.production || $ctrl.item.address) {
                if ($ctrl.item.production) {
                    el += '<div class="form-group sbfgroup last">' +
                            $ctrl.LCS.getISBDiv('company', 3) +
                            '<div class="form-control uneditable without-underline semibold">'+$ctrl.item.production+'</div>' +
                          '</div>';
                }
                if ($ctrl.item.address) {
                    el += '<div class="form-group sbfgroup last">' +
                                $ctrl.LCS.getISBDiv('pin', 2) +
                                '<div class="form-control uneditable without-underline">'+
                                    '<a class="address display-block clearfix" target="_blank" href="' + $ctrl.SBFieldMethods.getMapLink($ctrl.item.address) + '">'+ $ctrl.SBFieldMethods.getAddress($ctrl.item.address) + ' ➚</a>' +
                                '</div>' +
                          '</div>';
                }
            }
            return el;
        }
    }

    function onEmpty(){
        if(!$ctrl.isOpened){
            toggleEdit();
        }
    }

    function onImageUpdate(result) {
        broadcastProduct({
            logo: $ctrl.item.logo,
            logoId: $ctrl.item.logoId
        });
    }

    function onChangeOther(result) {
        var item = result && result.newRes && result.newRes.item ? result.newRes.item : null;
        if(item){
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.productInfo.Edit.success', 'success');
            var changes = {
                 name: item.name,
                 production: item.production,
                 address: item.address
            }
            $ctrl.item = _.extend($ctrl.item, changes);
            broadcastProduct(changes);
        }
    }

    function broadcastProduct(changes){
        $ctrl.CurrentProduct.broadcastProduct($ctrl.item, changes);
    }

    function onUpdateStats(){
        if(!$ctrl.isOpened){
            $ctrl.isOpened = !$ctrl.isOpened;
            $ctrl.reloadTemplate();
        }
    }
}

angular.module('product.overview.productOverviewTour.component',[
    'product.overview.productInfoBoxes.service',
    'product.script.import.controller'
])
.component('productOverviewTour', {
    bindings: {
        stats:'<',
        overviewBlocks: '<',
        customOverviewBlocks: '<',
    },
    controller: 'ProductOverviewTourCtrl'
})
.controller('ProductOverviewTourCtrl',ProductOverviewTourCtrl);

ProductOverviewTourCtrl.$inject = ['TemplateCompileCompCtrlService','ProductOverviewBoxesService', 'ImportScriptComponentCtrlService', '$element'];
function ProductOverviewTourCtrl (TemplateCompileCompCtrlService, ProductOverviewBoxesService, ImportScriptComponentCtrlService, $element) {
    console.log('ProductOverviewTourCtrl');
    var activeFeature;
    var $ctrl = this;

    $ctrl.infoBlocksCls = 'info-blocks';
    $ctrl.isLoaded = false;
    $ctrl.dontAutoloadTemplate = true;

    $ctrl.getOnboardingf = ProductOverviewBoxesService.getOnboardingf;
    $ctrl.getBlockUrl =  ProductOverviewBoxesService.getBlockUrl;
    $ctrl.getOverviewBlockIds = ProductOverviewBoxesService.getOverviewBlockIds;

    $ctrl.isActiveFeature = isActiveFeature;
    $ctrl.changeFeature = changeFeature;
    $ctrl.previousFeature = previousFeature;
    $ctrl.nextFeature = nextFeature;
    $ctrl.toggleOnboarding = toggleOnboarding;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.goToLink = goToLink;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    $ctrl.hideWarning = true;
    $ctrl = new ImportScriptComponentCtrlService($ctrl);

    function onLoaded(){
        $ctrl.bindImport(false);
        $ctrl.bindImport(true);
        bind(false);
        bind(true);
        $ctrl.addRootWatcher('OPEN_IMPORT_SCRIPT', $ctrl.importFromScript);
    }

    function onDestroy(){
        $ctrl.onDestroyImport();
        bind(false);
    }

    function bind(isBind){
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.element['querySelectorAll']('a.table-cell.step'), $ctrl.goToLink);
    }

    function goToLink(e) {
        var t = e.currentTarget.getAttribute('data-type');
        if (t) {
            $ctrl.CPS.transitionTo('user.product.' + t, $ctrl.CPS.currentProductPathParams());
        }
    }

    function getItemTemplate() {
        if(!$ctrl.isLoaded){return '<preloader-center class="preloader '+($ctrl.pageClass||'')+'"></preloader-center>';}
       return '<div class="tab-content tabbable product-dashboard on-boarding container '+($ctrl.hasOnboarding?'':'sb-hide')+'">' +
                '<div class="onboarding unit-xs" ng-class="{\'table-div full-width\':($ctrl.LCS.getWindowWidth()>=1024)}">' +
                    '<div class="sidebar features" ng-class="{\'table-div full-width\':($ctrl.LCS.getWindowWidth()<1024)}">' +
           ($ctrl.onboardingf.length>1 ? (
               '<div class="col24 centered show-lower1024"><a class="bigarrow circled-arrow gray-light sbf arrow-left-circle" ng-click="$ctrl.previousFeature()"></a></div>'
               ):'') +
                    '<div class="feature" ng-class="{\'table-div full-width\':($ctrl.LCS.getWindowWidth()>=1024), \'completed\':feature.completed,\'active\':$ctrl.isActiveFeature(feature)}" ng-repeat="feature in ::$ctrl.onboardingf track by feature.id"><div class="centered" ng-bind="::feature.name" ng-click="$ctrl.changeFeature(feature)" ng-style="$ctrl.LCS.getWindowWidth()>=1024&&{height:((300 + 8)/$ctrl.onboardingf.length - 8)+\'px\'}"></div></div>' +
               ($ctrl.onboardingf.length>1 ? (
                   '<div class="col24 centered"><a class="bigarrow circled-arrow gray-light sbf arrow-right-circle" ng-click="$ctrl.nextFeature()"></a></div>'
               ):'') +
                    '</div>' +

                    '<div class="steps h-full centered">' +
                        '<div class="top-nav full-width text-right">' + getBtn() + '</div>' +
                        '<div class="'+$ctrl.infoBlocksCls+' full-width text-center">' + getSteps() + '</div>' +
                    '</div>' +
                '</div>' +
            '</div>';

        function getBtn(check) {
             return '<a ' + (check ? 'ng-if="::$ctrl.onboardingf.length>0" ' : '') + 'class="btn btn-small primary-faded-gray without-text with-margin-left" ng-click="$ctrl.toggleOnboarding($event, false)" tooltip="Close" tooltip-placement="bottom"><div class="sbf cancel inline-block"></div></a>';
        }
    }

    function getSteps() {
        var el = '', added = false;

        _.each($ctrl.steps, function (step, i) {
            var cls = '';
            if(!step.hideNo) {
               if (i === 0 && $ctrl.steps.length > 1 || i === 1 && $ctrl.steps.length > 2) {
                   cls += 'with-right-line ';
               }

               if (i === 1 && $ctrl.steps.length > 1 || i === 2 && $ctrl.steps.length > 2) {
                   cls += 'with-left-line ';
               }
            }

            el += '<a ' + (step.id ? ('id="' + step.id + '" ') : '') + 'class="table-cell step ' + cls + '"' +
               (step.event ? '' : getHref(step))+
                '><div>' +
                        '<div class="logo centering animation-step ' + (step.img ? step.img : '') + '"></div>' +
                        '<div class="text full-width spacing-quarter-top text-center hide-ipad"><div>' + (step.content ? step.content : '') + '</div></div>' +
                        (step.hideNo ? '' : ('<div class="counter text-center full-width animation-step">' +
                            (step.count > 0 ? ('<span class="sbf success centering"></span>') :
                                ('<div class="stepcounter centering"><span>' + (i + 1) + '</span></div>')) +
                            '</div>')
                        ) +
                        '<div class="text show-ipad">' + (step.content ? step.content : '') + '</div>' +
                    '</div></a>';

            if(step.hideNo && !added){
                el += '<div class="table-cell centered step col30" style="padding-bottom: 40px"><div class="stepcounter centering"><span>or</span></div></div>';
                added = true;
            }
        });

        return el ? ('<div class="cont-steps table-div centering">' + el + '</div>') : '';

        function getHref(item){
            return 'data-type="'+item.name+'"';
            return 'href="' + $ctrl.getBlockUrl(item.url)+ '"' ;
        }
    }

    function preInit() {
        $ctrl.overviewBlockIds = angular.copy($ctrl.getOverviewBlockIds());
        $ctrl.activeOnboarding = $ctrl.LCS.getShowOnboarding();
        var features = [
                {id: 1, name: 'Write or import script', steps: [1, 2]},//  screenplays || import
                {id: 2, name: 'Manage your project', steps: [4, 5, 6]}, //contacts || cal  || worf
                {id: 3, name: 'Break down your script', steps: [2, 8, 9]}, //  brea || reports
                {id: 4, name: 'Plan your shots', steps: [15, 13, 14]}, //moodboards storyboards shots
                {id: 5, name: 'Schedule your shoot', steps: [11, 12]}, //str || callsheet
            ],
            steps = {
                1: {name: 'screenplays', img: 'stepWrite', content: 'Write Your<br class="hide-ipad"/> Script', hideNo:true},//  screenplays
                2: {name: 'sync', img: 'stepSync', content: 'Import<br class="hide-ipad"/> Script', hideNo:true, event: '$ctrl.importFromScript($event)', id: $ctrl.elImportId},

                4: {name: 'contacts', img: 'stepContacts', content: 'Add Talent and <br class="hide-ipad"/>Crew'}, //contacts
                5: {name: 'calendar', img: 'stepCalendar', content: 'Create calendar<br class="hide-ipad"/> events'},//  cal
                6: {name: 'workflow', img: 'stepWorkflow', content: 'Add workflow<br class="hide-ipad"/> tasks'},//  worf

                // 7: {name: 'sync', img: 'stepSync', content: 'Sync Shooting Script'}, //check if there are script versions
                8: {name: 'breakdowns', img: 'stepBreakdowns', content: 'Tag Elements'},//  brea
                9: {name: 'reports', img: 'stepReports', content: 'View Reports'},//    reports

                //   10: {name: 'sync', img: 'stepSync', content: 'Sync Shooting Script'}, //check if there are script versions
                11: {name: 'scheduling', img: 'stepStripboard', content: 'Create a <br class="hide-ipad"/>Shooting Schedule'},//str
                12: {name: 'callsheets', img: 'stepCallSheet', content: 'Generate Call Sheets <br class="hide-ipad"/>for shoot days'},//  callsheet

                13: {name: 'storyboards', img: 'stepStoryboard', content: 'Visualize scenes with <br class="hide-ipad"/> a storyboard'},
                14: {name: 'shots', img: 'stepShotList', content: 'Create a detailed <br class="hide-ipad"/> shot list'},
                15: {name: 'moodboards', img: 'stepMoodboard', content: 'Create a <br class="hide-ipad"/>moodboard'},
            };

        var onboardingf = [], active, f, s, item;

        for (var j = 0, n = features.length; j < n; j++) {
            f = features[j];
            s = f.steps;
            f.count = 0;
            f.steps = [];
            for (var i = 0, m = s.length; i < m; i++) {
                var step = steps[s[i]];
                step.count = 0;
                var name = step.name, isSync = name === 'sync';
                item = _.find($ctrl.overviewBlocks, function (ob) {
                    return ob.type === (isSync ? 'script' : name) && (!isSync && _.find($ctrl.overviewBlockIds, function (id) {
                        return id === ob._id;
                    }) || isSync);
                });

                if (item) {
                    step.url = item.url;
                    if (item.isSelectable && !isSync) {
                        f.available = true;
                    }
                    var count = isSync ? 0 : (item && $ctrl.stats[item.type] ? $ctrl.stats[item.type] : 0);
                    if (name === 'reports' && $ctrl.LCS.PersistenceService.getReportsViewed($ctrl.CPS.productId) ||
                        name === 'script' && $ctrl.LCS.PersistenceService.getScriptsViewed($ctrl.CPS.productId) ||
                        name === 'screenplays'
                       // && syncCount
                    ) { //if there is at least a strip in shooting script consider the writing dobe
                        count = 1;
                    }

                    setCount(count);
                }

                function setCount(count) {
                    step.count = count;
                    if (count) {
                        f.count = f.count ? (f.count + 1) : 1;
                    }
                    f.steps.push(step);
                }
            }

            if (f.available) {
                f.completed = f.count === f.steps.length ? true : false;
                onboardingf.push(f);

                if (!active) {
                    active = f;
                }
            }
        }

        ProductOverviewBoxesService.setOnboardingf(onboardingf);
        $ctrl.onboardingf = $ctrl.getOnboardingf();
        $ctrl.changeFeature(active);


        $ctrl.isLoaded = true;
        genReload();
    }

    function hasOnboarding() {
        return $ctrl.activeOnboarding && $ctrl.onboardingf && $ctrl.onboardingf.length > 0;
    }

    function toggleOnboarding(e, val) {
        $ctrl.preventDefault(e);
        $ctrl.activeOnboarding = val !== undefined ? val : !$ctrl.activeOnboarding;
        $ctrl.LCS.setShowOnboarding($ctrl.activeOnboarding);
        $ctrl.hasOnboarding = hasOnboarding();
        genReload();
    }

    function genReload() {
        $ctrl.hasOnboarding = hasOnboarding();
        $ctrl.reloadTemplate();
    }

    function isActiveFeature(feature) {
        return activeFeature === feature.id;
    }

    function previousFeature() {
        change(true);
    }

    function nextFeature() {
        change(false);
    }

    function change(isPrev) {
        for (var i = 0, n = $ctrl.onboardingf.length; i < n; i++) {
            var el = $ctrl.onboardingf[i];
            if (el.id === activeFeature) {
                $ctrl.changeFeature($ctrl.onboardingf[isPrev ? (i > 0 ? (i - 1) : (n - 1)) : (i < n - 1 ? (i + 1) : 0)]);
                return;
            }
        }
    }

    function changeFeature(feature) {
        activeFeature = feature ? feature.id : null;
        $ctrl.steps = feature ? feature.steps : [];

        if(!$ctrl.infoBlocks){
            $ctrl.infoBlocks = $ctrl.element.querySelector('.' + $ctrl.infoBlocksCls);
        }
        if($ctrl.infoBlocks){
            $ctrl.LCS.appendChildFragment($ctrl.infoBlocks, getSteps(), true);
            onLoaded();
        }
    }
}


