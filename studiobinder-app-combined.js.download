}

angular.module('product.breakdowns.viewUnsynced.component', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'product.script.saveContentToScriptAndSync.controller.service'
])
.component('viewUnsyncedScenePopup',  popupComponentParams('ViewUnsyncedScenePopupCtrl'))
.controller('ViewUnsyncedScenePopupCtrl',ViewUnsyncedScenePopupCtrl);
ViewUnsyncedScenePopupCtrl.$inject = ['GeneralItemEditCtrlService', 'SaveContentToScriptAndSyncCtrlService', '$element'];
function ViewUnsyncedScenePopupCtrl(GeneralItemEditCtrlService, SaveContentToScriptAndSyncCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.wrapperElementClass = 'script-compare-wrapper';
    $ctrl.sceneTagginsClss = 'scene-taggings';

    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl.postInitGeneral = postInitGeneral;
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.syncScene = syncScene;
    $ctrl.getDataToUpdate = getDataToUpdate;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);
    $ctrl = new SaveContentToScriptAndSyncCtrlService($ctrl, $ctrl.CurrentProduct.getProduct().script);

    function setTemplateData() {
        $ctrl.withCloseBtn = true;
        $ctrl.withFooterBtns = true;
    }
    function postInitGeneral(){
        $ctrl.onSave = $ctrl.onSave1;
    }

    function preInitGeneral() {
        $ctrl.withPageReload = 1;
        $ctrl.updateSceneContent = true;

        if (!$ctrl.extraParam) {
            $ctrl.extraParam = {};
        }

        if ($ctrl.extraParam.scriptLoadingService) {
            $ctrl.scriptLoadingService = $ctrl.extraParam.scriptLoadingService;
        }
        $ctrl.placeholder = $ctrl.extraParam.placeholder || 'Enter scene content';
        $ctrl.isScheduling = $ctrl.extraParam.isScheduling;

        $ctrl.Settings = $ctrl.scriptLoadingService.preloadSettings() || {};
        $ctrl.service = $ctrl.scriptLoadingService.getObjectService($ctrl.scriptLoadingService.TblTypes.Strips);
    }

    function getItemTemplate() {
        var title = 'Scene ' + ($ctrl.item.sceneText||'') + ($ctrl.item.miniTitle ? ('  •  ' + $ctrl.item.miniTitle):'');
        $ctrl.setTemplateDataInit();

return '<div class="display-block clearfix compare-script step2 h-full">' +
            '<div class="h-full">' +
                $ctrl.getMobileBack(getBtn( true)) +
                '<div class="modal-header clearfix hide-ipad">' +
                    '<div class="top-table table-div">' +
                        '<div class="table-col">' +
                            $ctrl.LCS.getISBDiv('unlinked', 4, 'gray') +
                            '<span class="stronger title with-margin-left">' + title + '</span>' +
                        '</div>' +
                    '</div>' +
                    $ctrl.LCS.getErrorBlock()  +
                '</div>' +
                '<div class="body-table medium-template h-full spacing-half-top">' +
                     getHeader() +
                    '<div class="show-scrollbar-on-hover body-table-parent-wrapper h-full full-width hasv">' +
                        '<div class="column-left-screenplay h-full">' + gets('left', 'currentScript',  getContent()) + '</div>'  +
                        '<div class="h-full column-right-screenplay" ng-class="{\'single-col\':$ctrl.LCS.isMobileSize}">' + gets('right', 'newScript',  getContentScript()) + '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
            '<div class="modal-footer clearfix semi-tall hide-ipad">' +
                '<div class="text-center">' +
                getBtn(true, false) +
                '</div>' +
            '</div>' +
        '</div>' ;

        function getHeader(){
            return '<div class="tableheader table-div full-width padding-bottom-0">' +
                '<div class="table-col" ng-show="!$ctrl.LCS.isMobileSize">' + getCurrentTitle ('Scene Content') + '</div>' +
                '<div class="table-col" ng-style="{\'width\':!$ctrl.LCS.isMobileSize?\'50%\':\'100%\',\'padding-left\':!$ctrl.LCS.isMobileSize?\'24px\':\'0\'}">' +
                '<div class="table-div">' +
                '<div class="table-col full-width">' + getCurrentTitle('Scene Content in Screenplay') + '</div>' +
                '</div>' +
                '</div>' +
                '</div>';
        }

        function getCurrentTitle (txt) {
            return '<span class="uppercase bold">'+txt + '</span> ';
        }
        function gets(panel, id, content) {
            return '<div id="'+panel+'" class="fix-column-height workflow-cards-scroll-wrapper fancy-scrollbar h-full">' +
                '<div>' +
                '<div id="'+id+'" class="with-white-bg with-padding">' +
                '<div class="'+$ctrl.sceneTagginsClss+' list with-padding document-version-wrapper">' +
                content +
                '</div>' +
                '</div>' +
                '</div>' +
                '</div>';
        }
        function getBtn( withHideIpad) {
            return '<button class="max-width200 btn btn-primary display-inline" type="submit" ng-click="$ctrl.syncScene($event)" analytics-on analytics-action="Sync Scene to Script" ng-class="{\'disabled\': $ctrl.isUpdating===true||$ctrl.cantUpdate===true}" ng-disabled="$ctrl.isUpdating===true||$ctrl.cantUpdate===true"><span class="sbf loadingicon animate-spin pull-left" ng-show="$ctrl.isUpdating===true"></span> Sync' +
                (withHideIpad ? ('<span class="hide-ipad">Scene to Script</span>') : ('Scene to Script')) +
                '</button>';
        }
        function getContent() {
            return "<scene-tagging " +
                "class='clearfix display-block' " +
                "id='scene" + $ctrl.item._id + "' " +
                "item='::$ctrl.item' " +
                "script-loading-service='::$ctrl.scriptLoadingService' " +
                "with-tagging='::false' " +
                "load-tags='::true' " +

                "categories='::null' " +
                "elements='::null' " +

                "max-font-size='::$ctrl.maxFontSize' " +
                "min-font-size='::$ctrl.minFontSize' " +
                "doc-wrapper-class='::$ctrl.docWrapperClass' " +
            "side-margin='true'" +
                "></scene-tagging>";
        }

        function getContentScript() {
            return $ctrl.item.contentScript === ' ' ? '<p class="text-center semibold spacing">This scene is not included in the screenplay.</p>' :
                ("<script-editor " +
                'class="script-editor-popup" ' +
               // "placeholder='::$ctrl.placeholder' " +
                "hide-lock='::true' " +
                "can-edit='::false' " +
                "html-content='::$ctrl.item.contentScript' " +
                "init-characters='::$ctrl.Settings.characters' " +
                "init-locations='::$ctrl.Settings.stripLocations' " +
                //"scene-number='::$ctrl.item.scene' " +
                'without-renumber="true" ' +
                //'on-content-changed="$ctrl.onContentChanged(html)"' +
                "init-top-margin='true'" +
                "></script-editor>");
        }
    }

    function syncScene(){
        console.log('saveScene');

        return $ctrl.save();
    }


    function getDataToUpdate(){
        var page = $ctrl.BlocksSetupService.getCurrentTodoPage().text;
        return {
            _id: $ctrl.isScheduling ? $ctrl.item.stripId : $ctrl.item._id,
            allText: $ctrl.item.allText,
            content: $ctrl.item.content,
            name: $ctrl.item.name,

            contentChanged: true,
            notes: 'A scene was synced on <span class="semibold">' + page + '</span> page: <span class="semibold">' +
                ($ctrl.item.sceneText ? ('Sc. ' + $ctrl.item.sceneText + '. ') : '') + ($ctrl.item.name || '') + '</span>',
            summary: 'edit|' + page,
            syncChanges: true,
            syncToProject: false,
            updateSceneContent: $ctrl.updateSceneContent,
            updateScreenplay: true,
        }
    }
}


angular.module('product.breakdowns.viewScene.controller.service', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'sb.fields.types.service',
    'product.breakdowns.item.events.service'
])
.service('ViewSceneCtrlService', ViewSceneCtrlService);
ViewSceneCtrlService.$inject = ['GeneralItemEditCtrlService', 'StripsService', 'SaveContentToScriptAndSyncCtrlService', 'SBFieldMethods'];
function ViewSceneCtrlService(GeneralItemEditCtrlService, service, SaveContentToScriptAndSyncCtrlService, SBFieldMethods) {
    return function($ctrl, $element, isPopup){

        console.log('ViewSceneCtrlService');

        $ctrl.SBFieldMethods = SBFieldMethods;
        $ctrl.modalBodyFormClassOther = 'h-full';
        $ctrl.modalBodyClass = 'h-full';
        $ctrl.modalBodyFormClass = 'full-width';
        $ctrl.hideHeader = true;

        $ctrl.service = service;
        $ctrl.editIcon = 'pencil';
        $ctrl.viewAction = 'Preview Scene';
        $ctrl.viewIcon = 'sides';
        $ctrl.hideLock = true;
        $ctrl.Steps = {View: 1, Edit: 2};

        $ctrl.objectType = 'strip';

        $ctrl.withTagging = false;
        $ctrl.loadTags = true;

        $ctrl.passMoreData = passMoreData;

        $ctrl.editScript = editScript;
        $ctrl.viewScript = viewScript;

        $ctrl.showTags = showTags;
        $ctrl.onContentChanged = onContentChanged;

        $ctrl.preInitGeneral = preInitGeneral;
        $ctrl.preSetTemplateData = preSetTemplateData;

        $ctrl.getBody = getBody;
        $ctrl.onLoaded = onLoaded;
        $ctrl.onConfirm = onConfirm;
        $ctrl.postInitGeneral = postInitGeneral;
        $ctrl.confirmPopupInit = confirmPopupInit;

        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, isPopup);
        $ctrl = new SaveContentToScriptAndSyncCtrlService($ctrl, $ctrl.CurrentProduct.getProduct().script);

        return $ctrl;

        function postInitGeneral(){
            $ctrl.onSave = $ctrl.onSave1;
        }

        function onContentChanged(html){
            //console.log('onContentChanged');
            $ctrl.contentChanged = true;
            $ctrl.htmlContent = html;
        }

        function preSetTemplateData() {
            $ctrl.isNew = $ctrl.extraParam.isNewStrip;
            $ctrl.withFooterBtns = $ctrl.item.active;
            $ctrl.firstBtnMethod = 'confirmPopupInit';
            $ctrl.btnText = '<span>Apply </span><span class="hide-ipad"> Changes</span>';
            $ctrl.editActionShort = $ctrl.isNew ? 'Add' : 'Edit';
            $ctrl.editAction = 'Script Editor';
            $ctrl.editActionTitle = $ctrl.isNew ? 'Write Scene' : $ctrl.editAction;
        }

        function preInitGeneral() {
            $ctrl.withPageReload = true;
            $ctrl.isNewStrip = $ctrl.extraParam.isNewStrip === true;
            if (!$ctrl.extraParam) {
                $ctrl.extraParam = {};
            }

            $ctrl.extraParam.service = $ctrl.service;

            if ($ctrl.extraParam.scriptLoadingService) {
                $ctrl.scriptLoadingService = $ctrl.extraParam.scriptLoadingService;
            }

            $ctrl.placeholder = $ctrl.extraParam.placeholder || 'Enter scene content';
            $ctrl.isScheduling = $ctrl.extraParam.isScheduling;
            $ctrl.origItem = _.clone($ctrl.item);
            if($ctrl.isScheduling){
                if(!$ctrl.isNewStrip) {
                    $ctrl.item = _.clone($ctrl.item.strip);
                }
                delete $ctrl.origItem.strip;
            }

            $ctrl.Settings = $ctrl.scriptLoadingService.preloadSettings() || {};

            $ctrl.itemChangedFields = $ctrl.extraParam.changedFields;
            $ctrl.canEdit = $ctrl.extraParam.canEdit === true;
            $ctrl.isEditMode = $ctrl.canEdit && $ctrl.extraParam.isEditMode === true;
            $ctrl.withoutViewMode = $ctrl.isEditMode && $ctrl.extraParam.withoutViewMode;
            $ctrl.step = $ctrl.isEditMode ? 2 : 1;

            $ctrl.withoutBackBtn = ($ctrl.isNewStrip && $ctrl.isEditMode);
            $ctrl.initHtmlContent = $ctrl.item.htmlContent;
        }

        function editScript(id, e) {
            $ctrl.step = $ctrl.Steps.Edit;
            $ctrl.popupsService.teamAccess(function () {

                //planFetatures testmode
                var quotaType = 'scriptEditor';
                $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});

                function process() {
                    changeStep();
                }
            });
        }

        function viewScript(id, e) {
            $ctrl.step = $ctrl.Steps.View;
            changeStep();
        }

        function changeStep() {
            $ctrl.isUpdating = false;
            $ctrl.error = false;

            $ctrl.item = $ctrl.service.parseContent($ctrl.item, $ctrl.initHtmlContent);


            $ctrl.reloadTemplate();
        }

        function onLoaded(){
            $ctrl.LCS.replaceClass($ctrl.element,
                'step-' + ($ctrl.step === $ctrl.Steps.Edit ? 'view' : 'edit'),
                'step-' + ($ctrl.step === $ctrl.Steps.Edit ? 'edit' : 'view'));
            if($ctrl.onLoadedScene){
                $ctrl.onLoadedScene();
            }
        }

        function showTags(e) {
            $ctrl.preventDefault(e);
        }

        function getBody() {
            var isView = $ctrl.step === $ctrl.Steps.View,
                btnview = 'viewScript',
                btnedit = 'editScript';

            return getBack() +
                getHeader() +
                getSimpleBody();

            // + getFooter();

            function getSimpleBody() {
                return '<div class="body-table medium-template h-full">' +
                    '<div class="body-table-parent-wrapper h-full full-width">' +
                    '<div class="h-full full-width padding-left-0">' +
                    '<div id="right" class="fix-column-height workflow-cards-scroll-wrapper fancy-scrollbar h-full nopadding">' +
                    '<div>' +
                    '<div class="with-white-bg with-padding column-right-screenplay single-col centered">' +
                    '<div class="sceneEditorWrapper document-version-wrapper screenplay-tagging centering ' + (isView ? 'screenplay-padding' : '') + '"> ' + (isView ? getViewStep() : getEditStep()) + '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>';
            }

            function getViewStep() {
                return "<scene-tagging " +
                    "class='clearfix display-block' " +
                    "id='scene" + $ctrl.item._id + "' " +
                    "item='::$ctrl.item' " +
                    "script-loading-service='::$ctrl.scriptLoadingService' " +
                    "with-tagging='::$ctrl.withTagging' " +
                    "load-tags='::" + ($ctrl.loadTags === true) + "' " +

                    "categories='::null' " +
                    "elements='::null' " +

                    "max-font-size='::$ctrl.maxFontSize' " +
                    "min-font-size='::$ctrl.minFontSize' " +
                    "doc-wrapper-class='::$ctrl.docWrapperClass' " +
                    "side-margin='true'" +
                    "></scene-tagging>";
            }

            function getEditStep() {
                return "<script-editor " +
                    'class="script-editor-popup" ' +
                    "placeholder='::$ctrl.placeholder' " +
                    "hide-lock='::$ctrl.hideLock' " +
                    "can-edit='::$ctrl.canEdit' " +
                    "html-content='::$ctrl.item.htmlContent' " +
                    "init-characters='::$ctrl.Settings.characters' " +
                    "init-locations='::$ctrl.Settings.stripLocations' " +
                    "scene-number='::$ctrl.item.scene' " +
                    'without-renumber="true" ' +
                    'on-content-changed="$ctrl.onContentChanged(html)" ' +
                    'init-top-margin="true"' +
                    "></script-editor>";
            }

            function getHeader() {
                return '<div class="modal-header clearfix hide-ipad">' +
                    '<div class="top-table table-div full-width">' +
                    '<div class="table-col">' +
                    $ctrl.LCS.getISBDiv(isView ? $ctrl.viewIcon : $ctrl.editIcon, 2, 'gray') +
                    '<span class="stronger title with-margin-left">' + (isView ? $ctrl.viewAction : $ctrl.editActionTitle) + '</span>' +
                    '</div>' +
                    (isView ? ('<div class="col120 legend text-right">' + getEditBtn() + '</div>') :
                        ($ctrl.isEditMode ? '' : ('<div class="col60 legend" style="z-index: 2">' + getBackBtn() + '</div>'))) +
                    '</div>' +
                    '</div>';
            }

            function getBack() {
                if (!isView && $ctrl.isPopup) {
                    return '';
                }
                return isView && $ctrl.isPopup ? $ctrl.getMobileBack(getBtn()) :
                    $ctrl.getMobileBack(getApplyBtn(), null, btnview);
            }

            function getFooter() {
                if ($ctrl.item && !$ctrl.item.active) {
                    return '';
                }
                return isView ?
                    ('<div class="modal-footer clearfix semi-tall hide-ipad" style="padding: 0; margin: 0; background: #f2f6f9; height: 6px"><button type="button" class="nextbtn btnstep" id="btnNextStep"></button></div></div>') :
                    ('<div class="modal-footer clearfix semi-tall hide-ipad spacing-half-top spacing-half-bottom" style="background: white; margin-bottom: 0;z-index: 1">' +
                        $ctrl.getErrorBlock() +
                        '<div class="text-center">' + getApplyBtn() + '</div>' +
                        '</div>');
            }

            function getBtn() {
                return $ctrl.canEdit && $ctrl.item.active ? ('<button type="button" ' +
                    getM(btnedit, 'btn ' + $ctrl.pageClass + ' {{$ctrl.LCS.isMobileSize? \'btn-primary\' : \'edit-profile btn-small primary-faded\'}}" ', $ctrl.editAction) +
                    '>' + $ctrl.LCS.getISBDiv($ctrl.editIcon, 2, 'hide-ipad pull-left with-margin-right ') + '<div class="inline-block">' + $ctrl.editActionShort + '<span class="hide-ipad"> Scene</span></div></button>') : '';
            }

            function getApplyBtn() {
                if ($ctrl.item && !$ctrl.item.active) {
                    return '';
                }
                return '<button type="button" ' +
                    getM($ctrl.firstBtnMethod, '{{$ctrl.LCS.isMobileSize? \'\' : \' max-width300\'}} ' + ($ctrl.pageClass || '') + ' btn btn-primary', $ctrl.removeHtmlTags($ctrl.btnText)) +
                    ' ng-disabled="$ctrl.isUpdating===true" ng-class="{\'disabled\': $ctrl.isUpdating===true}"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> ' + $ctrl.btnText + '</button>';
            }

            function getBackBtn() {
                return '<a ' + getM(btnview, 'edit-profile btn btn-small primary with-margin-left') + '>' + ($ctrl.txtBack || 'Back') + '</a>';
            }

            function getEditBtn() {
                return ($ctrl.canEdit && $ctrl.item.active ? ('<a ' + getM(btnedit, 'edit-profile btn btn-small primary', $ctrl.editAction) + '>' +
                    $ctrl.LCS.getISBDiv($ctrl.editIcon, 2, 'pull-left with-margin-right') + '<div class="inline-block">' + $ctrl.editAction + '</div></a>'
                ) : '');
            }

            function getM(m, cls, a) {
                return 'class="' + cls + ' ' + $ctrl.getBtnActionCls() + '" data-type="' + m + '" analytics-on analytics-action="' + (a || m) + '"';
            }
        }

        function isEmpty(){
            $ctrl.item = getContent($ctrl.item);
            if (!$ctrl.item.allText) {
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.objectType + '.empty.error', 'error');
                return true;
            }
            return false;
        }

        function confirmPopupInit( ){
            if ($ctrl.isUpdating || $ctrl.isInserted || isEmpty()) {
                return;
            }
            $ctrl.confirmPopup();
        }

        function onConfirm(e) {
            if ($ctrl.isNewStrip) {
                $ctrl.isUpdating = true;

                $ctrl.service.insert($ctrl.item, onSuccess, onError);

                function onSuccess(result) {
                    $ctrl.isUpdating = false;
                    $ctrl.isInserted = true;
                    var nitem = result ? result.item : null;
                    if (!nitem) {
                        return onError();
                    }
                    $ctrl.item._id = nitem._id;
                    $ctrl.item.scene = nitem.scene;
                    $ctrl.item.scriptPosition = nitem.scriptPosition;
                    $ctrl.updatedResult = result;
                    // $ctrl.broadcastRoot('ADDED_BREAKDOWN_ITEM', result);
                    process();
                }

                function onError(err) {
                    $ctrl.isUpdating = false;
                    //  $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.' + $ctrl.elemType + '.' + method + '.error', 'error');
                }
            }
            else {
                $ctrl.isUpdating = false;
                process();
            }

            function process( ) {
                // $ctrl.scriptNote = extraParam && extraParam.scriptNote ? extraParam.scriptNote : null;

                $ctrl.item = getContent($ctrl.item);

                if (isEmpty()) {
                    return;
                }
                var title = 'Scene ' + ($ctrl.item.sceneText||'') + ($ctrl.item.miniTitle?('  •  ' + $ctrl.item.miniTitle):'');
                $ctrl.scriptNote = title + ' has been ' + ($ctrl.isNew ? 'added ' : 'edited ');
                $ctrl.saveScene();
            }
        }

        function getContent(item) {
            if (!$ctrl.contentChanged || !$ctrl.htmlContent) {
                if (!$ctrl.sceneWrapperElement) {
                    $ctrl.sceneWrapperElement = $ctrl.element.querySelector('.scene-wrapper');
                }
                if ($ctrl.sceneWrapperElement) {
                    item = $ctrl.service.parseContent(item, $ctrl.sceneWrapperElement.innerHTML);
                }
            } else {
                item = $ctrl.service.parseContent($ctrl.item, $ctrl.htmlContent);
            }
            item.miniTitle = $ctrl.SBFieldMethods.getMiniTitle(item);
            item.sceneText = $ctrl.SBFieldMethods.getSceneText(item);
            return item;
        }

        function passMoreData(data) {
            console.log('passMoreData');
            var page = $ctrl.BlocksSetupService.getCurrentTodoPage().text;
            $ctrl.updateSceneContent = $ctrl.contentChanged || ($ctrl.isNewStrip && $ctrl.item.htmlContent);
            $ctrl.scriptId = $ctrl.product && $ctrl.product.scriptId ? $ctrl.product.scriptId : null;
            delete data.miniTitle;

            return _.extend({}, data, $ctrl.getOtherData({
                notes: getNotes(),
                summary: ($ctrl.isNewStrip ? 'new' : 'edit') + '|' + page,
            }));

            function getNotes() {
                var miniTitle = ' on <span class="semibold">' + page + '</span> page: <span class="semibold">' +
                    ($ctrl.item.sceneText ? ('Sc. ' + $ctrl.item.sceneText + '. ') : '') + ($ctrl.item.name || '') + '</span>';
                return $ctrl.isNewStrip ? ('A new scene was added' + miniTitle) : ('A scene was modified' + miniTitle);
            }
        }

//todo -> bring back update without refresh
        function onSave2(result){
             var item = result ? result.item : null;

            if($ctrl.isScheduling) {
                var strips = {};
                strips.set = {};
                strips.set[item._id] = item;

                result.updatesG = _.extend({}, result.updatesG, {strips: strips});

                $ctrl.scriptLoadingService.processTablesUpdatesG(result);
                $ctrl.Settings = _.extend({}, $ctrl.Settings, $ctrl.scriptLoadingService.preloadSettings());
                $ctrl.broadcastRoot('PRELOADED_SETTINGS_CHANGED_' + $ctrl.elemType + '_GROUP', $ctrl.Settings);
            }

            result.item = $ctrl.scriptLoadingService.getExtendedStrip($ctrl.origItem, null, $ctrl.isScheduling, $ctrl.Settings);


            var editchanges = {_id: $ctrl.origItem._id};
            _.each($ctrl.itemChangedFields, function (prop) {
                editchanges[prop] = item[prop];
            });
            editchanges.updateSceneContent = true;

            result.editchanges = editchanges;

            $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType +'_ITEM', result);

            $ctrl.isUpdating = false;
            $ctrl.closePopup();
        }
    }
}

angular.module('ang-drag-drop.service', [])
.service('$dragImage', dragImageService);
dragImageService.$inject = ['$dragImageConfig'];
function dragImageService(defaultConfig) {
    var ELLIPSIS = '…';

    function fitString(canvas, text, config) {
        var width = canvas.measureText(text).width;
        if (width < config.width) {
            return text;
        }
        while (width + config.padding > config.width) {
            text = text.substring(0, text.length - 1);
            width = canvas.measureText(text + ELLIPSIS).width;
        }
        return text + ELLIPSIS;
    }

    this.generate = function (text, options) {
        var config = _.extend({}, defaultConfig, options || {});
        var el = document.createElement('canvas');

        el.height = config.height;
        el.width = config.width;

        var canvas = el.getContext('2d');

        canvas.fillStyle = config.backgroundColor;
        canvas.fillRect(0, 0, config.width, config.height);
        canvas.font = config.font;
        canvas.fillStyle = config.fontColor;

        var title = fitString(canvas, text, config);
        canvas.fillText(title, 4, config.padding + 4);

        var img = new Image();
        img.src = el.toDataURL();

        return {
            image: img,
            xOffset: config.xOffset,
            yOffset: config.yOffset
        };
    };
}

angular.module('ang-drag-drop.constant', [])
.constant('$dragImageConfig',  {
    height: 20,
    width: 200,
    padding: 10,
    font: 'bold 11px Arial',
    fontColor: '#eee8d5',
    backgroundColor: '#93a1a1',
    xOffset: 0,
    yOffset: 0
});
function isDnDsSupported() {
    return 'ondrag' in document.createElement('a');
}

function determineEffectAllowed(e) {
    if(e.originalEvent) {
        e.dataTransfer = e.originalEvent.dataTransfer;
    }

    // Chrome doesn't set dropEffect, so we have to work it out ourselves
    if (typeof e.dataTransfer !== 'undefined' && e.dataTransfer.dropEffect === 'none') {
        if (e.dataTransfer.effectAllowed === 'copy' ||
            e.dataTransfer.effectAllowed === 'move') {
            e.dataTransfer.dropEffect = e.dataTransfer.effectAllowed;
        } else if (e.dataTransfer.effectAllowed === 'copyMove' || e.dataTransfer.effectAllowed === 'copymove') {
            e.dataTransfer.dropEffect = e.ctrlKey ? 'copy' : 'move';
        }
    }
}
angular.module('ang-drag-drop', [
    'ang-drag-drop.uiDraggable',
    'ang-drag-drop.uiOnDrop',
    'ang-drag-drop.constant',
    'ang-drag-drop.service'
]);
angular.module('ang-drag-drop.uiDraggable', [
    'services.rootEvents'
])
.directive('uiDraggable',uiDraggableDirective);
uiDraggableDirective.$inject = ['$parse', '$dragImage', 'RootEventsService'];
function uiDraggableDirective($parse, $dragImage, RootEventsService) {
    return function(scope, element, attrs) {
        var watchers=[],
            isDragHandleUsed = false,
            dragHandleClass,
            draggingClass = attrs.draggingClass || 'on-dragging',
            dragTarget;

        element.attr('draggable', false);
        //todo enable
        //RootEventsService.addToObservable(watchers, scope, attrs.uiDraggable, onObservble);
        //todo remove
        scope.$watch(attrs.uiDraggable, onObservble);

        if (angular.isString(attrs.dragHandleClass)) {
            isDragHandleUsed = true;
            dragHandleClass = attrs.dragHandleClass.trim() || 'drag-handle';

            element.bind('mousedown', function(e) {
                dragTarget = e.target;
            });
        }
        //todo enable
        //scope.$on('$destroy', onDestroy);
        function onObservble(newValue) {
            if (newValue) {
                element.attr('draggable', newValue);
                element.bind('dragend', dragendHandler);
                element.bind('dragstart', dragstartHandler);
            }
            else {
                element.removeAttr('draggable');
                element.unbind('dragend', dragendHandler);
                element.unbind('dragstart', dragstartHandler);
            }
        }
        function dragendHandler(e) {
            if(e.originalEvent) {
                e.dataTransfer = e.originalEvent.dataTransfer;
            }

            setTimeout(function() {
                element.unbind('$destroy', dragendHandler);
            }, 0);
            var sendChannel = attrs.dragChannel || 'defaultchannel';
            broadcastRoot('ANGULAR_DRAG_END', e, sendChannel);

            determineEffectAllowed(e);

            if (e.dataTransfer && e.dataTransfer.dropEffect !== 'none') {
                if (attrs.onDropSuccess) {
                    var onDropSuccessFn = $parse(attrs.onDropSuccess);
                    scope.$evalAsync(function() {
                        onDropSuccessFn(scope, {$event: e});
                    });
                }
            }else if (e.dataTransfer && e.dataTransfer.dropEffect === 'none'){
                if (attrs.onDropFailure) {
                    var onDropFailureFn = $parse(attrs.onDropFailure);
                    scope.$evalAsync(function() {
                        onDropFailureFn(scope, {$event: e});
                    });
                }
            }
            element.removeClass(draggingClass);
        }

        function setDragElement(e, dragImageElementId) {
            var dragImageElementFn;

            if(e.originalEvent) {
                e.dataTransfer = e.originalEvent.dataTransfer;
            }

            dragImageElementFn = $parse(dragImageElementId);

            scope.$apply(function() {
                var elementId = dragImageElementFn(scope, {$event: e}),
                    dragElement;

                if (!(elementId && angular.isString(elementId))) {
                    return;
                }

                dragElement = document.getElementById(elementId);

                if (!dragElement) {
                    return;
                }

                e.dataTransfer.setDragImage(dragElement, 0, 0);
            });
        }

        function dragstartHandler(e) {
            if(e.originalEvent) {
                e.dataTransfer = e.originalEvent.dataTransfer;
            }

            var isDragAllowed = !isDragHandleUsed || dragTarget.classList.contains(dragHandleClass);

            if (isDragAllowed) {
                var sendChannel = attrs.dragChannel || 'defaultchannel';
                var dragData = '';
                if (attrs.drag) {
                    dragData = scope.$eval(attrs.drag);
                }

                var dragImage = attrs.dragImage || null;

                element.addClass(draggingClass);
                element.bind('$destroy', dragendHandler);

                //Code to make sure that the setDragImage is available. IE 10, 11, and Opera do not support setDragImage.
                var hasNativeDraggable = !(document.uniqueID || window.opera);

                //If there is a draggable image passed in, then set the image to be dragged.
                if (dragImage && hasNativeDraggable) {
                    var dragImageFn = $parse(attrs.dragImage);
                    scope.$apply(function() {
                        var dragImageParameters = dragImageFn(scope, {$event: e});
                        if (dragImageParameters) {
                            if (angular.isString(dragImageParameters)) {
                                dragImageParameters = $dragImage.generate(dragImageParameters);
                            }
                            if (dragImageParameters.image) {
                                var xOffset = dragImageParameters.xOffset || 0,
                                    yOffset = dragImageParameters.yOffset || 0;
                                e.dataTransfer.setDragImage(dragImageParameters.image, xOffset, yOffset);
                            }
                        }
                    });
                } else if (attrs.dragImageElementId) {
                    setDragElement(e, attrs.dragImageElementId);
                }

                var offset = {x: e.offsetX, y: e.offsetY};
                var transferDataObject = {data: dragData, channel: sendChannel, offset: offset};
                var transferDataText = angular.toJson(transferDataObject);

                e.dataTransfer.setData('text', transferDataText);
                e.dataTransfer.effectAllowed = 'copyMove';


                if (attrs.onDragStart) {
                    var onDragStartFn = $parse(attrs.onDragStart);
                    scope.$evalAsync(function () {
                        onDragStartFn(scope, {
                            $event: e
                        });
                    });
                }

                broadcastRoot('ANGULAR_DRAG_START', e, sendChannel, transferDataObject);
            }
            else {
                e.preventDefault();
            }
        } 
        
        function broadcastRoot(method, e, channel, data) {
            RootEventsService.broadcastComplex(method, e, channel, data);
        }

        function onDestroy() { 
            RootEventsService.removeWatchers(watchers);
        }
    };
}

angular.module('ang-drag-drop.uiOnDrop', [])
.directive('uiOnDrop', uiOnDropDirective);
uiOnDropDirective.$inject = ['$parse', 'RootEventsService'];
function uiOnDropDirective($parse, RootEventsService) {
    return function(scope, element, attr) {
        var dragging = 0; //Ref. http://stackoverflow.com/a/10906204
        var dropChannel = attr.dropChannel || 'defaultchannel';
        var dragChannel = '';
        var dragEnterClass = attr.dragEnterClass || 'on-drag-enter';
        var dragHoverClass = attr.dragHoverClass || 'on-drag-hover';
        var customDragEnterEvent = $parse(attr.onDragEnter);
        var customDragLeaveEvent = $parse(attr.onDragLeave);
        var watchers = [];

        //todo doesnt seem to work due to the many parameters for the method  onAngularDragEnd
        //RootEventsService.addRootWatcher(watchers, 'ANGULAR_DRAG_START', onAngularDragStart);
        //RootEventsService.addRootWatcher(watchers,'ANGULAR_DRAG_END', onAngularDragEnd);

        var deregisterDragStart = RootEventsService.$rootScope.$on('ANGULAR_DRAG_START', onAngularDragStart);
        var deregisterDragEnd = RootEventsService.$rootScope.$on('ANGULAR_DRAG_END', onAngularDragEnd);

        scope.$on('$destroy', onDestroy);
        attr.$observe('dropChannel', onDropChannel);

        function calculateDropOffset(e) {
            var offset = {
                x: e.offsetX,
                y: e.offsetY
            };
            var target = e.target;

            while (target !== element[0]) {
                offset.x = offset.x + target.offsetLeft;
                offset.y = offset.y + target.offsetTop;

                target = target.offsetParent;
                if (!target) {
                    return null;
                }
            }

            return offset;
        }

        function onDragOver(e) {
            // Necessary. Allows us to drop.
            preventDefault(e);

            var uiOnDragOverFn = $parse(attr.uiOnDragOver);
            scope.$evalAsync(function() {
                uiOnDragOverFn(scope, {$event: e, $channel: dropChannel});
            });

            return false;
        }

        function onDragLeave(e) {
            preventDefault(e);
            dragging--;

            if (dragging === 0) {
                scope.$evalAsync(function() {
                    customDragLeaveEvent(scope, {$event: e, $channel: dropChannel});
                });
                element.addClass(dragEnterClass);
                element.removeClass(dragHoverClass);
            }

            var uiOnDragLeaveFn = $parse(attr.uiOnDragLeave);
            scope.$evalAsync(function() {
                uiOnDragLeaveFn(scope, {$event: e, $channel: dropChannel});
            });
        }

        function onDragEnter(e) {
            preventDefault(e);

            if (dragging === 0) {
                scope.$evalAsync(function() {
                    customDragEnterEvent(scope, {$event: e, $channel: dropChannel});
                });
                element.removeClass(dragEnterClass);
                element.addClass(dragHoverClass);
            }
            dragging++;

            var uiOnDragEnterFn = $parse(attr.uiOnDragEnter);
            scope.$evalAsync(function() {
                uiOnDragEnterFn(scope, {$event: e, $channel: dropChannel});
            });

            RootEventsService.broadcastRoot('ANGULAR_HOVER', dragChannel);
        }

        function onDrop(e) {
            // Necessary. Allows us to drop.
            preventDefault(e);
            if(e.originalEvent) {
                e.dataTransfer = e.originalEvent.dataTransfer;
            }

            var sendData = e.dataTransfer.getData('text');
            sendData = angular.fromJson(sendData);

            var dropOffset = calculateDropOffset(e);

            var position = dropOffset ? {
                x: dropOffset.x - sendData.offset.x,
                y: dropOffset.y - sendData.offset.y
            } : null;

            determineEffectAllowed(e);

            var uiOnDropFn = $parse(attr.uiOnDrop);
            scope.$evalAsync(function() {
                uiOnDropFn(scope, {$data: sendData.data, $event: e, $channel: sendData.channel, $position: position});
            });
            element.removeClass(dragEnterClass);
            dragging = 0;
        }

        function isDragChannelAccepted(dragChannel, dropChannel) {
            if (dropChannel === '*') {
                return true;
            }

            var channelMatchPattern = new RegExp('(\\s|[,])+(' + dragChannel + ')(\\s|[,])+', 'i');

            return channelMatchPattern.test(',' + dropChannel + ',');
        }

        function preventNativeDnD(e) {
            preventDefault(e);
            if(e.originalEvent) {
                e.dataTransfer = e.originalEvent.dataTransfer;
            }
            e.dataTransfer.dropEffect = 'none';
            return false;
        }

        function onAngularDragEnd() {
            element.unbind('dragover', onDragOver);
            element.unbind('dragenter', onDragEnter);
            element.unbind('dragleave', onDragLeave);

            element.unbind('drop', onDrop);
            element.removeClass(dragHoverClass);
            element.removeClass(dragEnterClass);

            element.unbind('dragover', preventNativeDnD);
            element.unbind('dragenter', preventNativeDnD);
            element.unbind('dragleave', preventNativeDnD);
            element.unbind('drop', preventNativeDnD);

            element.parents('.drag-drop-container').removeClass('hideTooltips');
        }

        function onAngularDragStart(_, e, channel, transferDataObject) {
            element.parents('.drag-drop-container').addClass('hideTooltips');
            dragChannel = channel;

            var valid = true;

            if (!isDragChannelAccepted(channel, dropChannel)) {
                valid = false;
            }

            if (valid && attr.dropValidate) {
                var validateFn = $parse(attr.dropValidate);
                valid = validateFn(scope, {
                    $drop: {scope: scope, element: element},
                    $event: e,
                    $data: transferDataObject.data,
                    $channel: transferDataObject.channel
                });
            }

            if (valid) {
                element.bind('dragover', onDragOver);
                element.bind('dragenter', onDragEnter);
                element.bind('dragleave', onDragLeave);
                element.bind('drop', onDrop);

                element.addClass(dragEnterClass);
            } else {
                element.bind('dragover', preventNativeDnD);
                element.bind('dragenter', preventNativeDnD);
                element.bind('dragleave', preventNativeDnD);
                element.bind('drop', preventNativeDnD);

                element.removeClass(dragEnterClass);
            }
        }

        function onDestroy() {
            //RootEventsService.removeWatchers(watchers);

            deregisterDragStart();
            deregisterDragEnd();
        }

        function onDropChannel(value) {
            if (value) {
                dropChannel = value;
            }
        }

        function preventDefault(e) {
            if (e) {
                console.log('preventDefault');
                if (e.preventDefault) {
                    e.preventDefault();
                }
                if (e.stopPropagation) {
                    e.stopPropagation();
                }
            }
        }
    };
}

