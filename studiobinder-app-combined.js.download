function LocationGroupCtrl( Pagination,TreeGroupInitCtrlService, $element) {
    //todo populate countries and country on edit / add popup
    var $ctrl = this;
    $ctrl.additionalMessageRemove = 'You will lose this project’s contacts, call sheets, and files.';
    $ctrl.quotaType = null;
    $ctrl.nameUnderlined = false;

    $ctrl.view = view;

    $ctrl.getItemImageSize = getItemImageSize;
    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl = new TreeGroupInitCtrlService($ctrl, $element, Pagination, false);
    }

    function view(item) {
        if ($ctrl.filtersService.selectedFilter) {
            $ctrl.CPS.transitionTo('user.product.location', $ctrl.currentProductPathParams({locationId: item._id}, item));
        }
    }

    function getItemImageSize(isMobile) {
        return isMobile ? 'mediumsmall' : ($ctrl.isGridView ? 'medium' : 'intermedium');
    }
}

