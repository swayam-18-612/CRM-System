}

angular.module('product.callsheet.basicSchedulesListCtrl.service', [
    'product.callsheet.block.init.controller.service',
    'product.callsheet.schedule.item.grid.component',
    'product.callsheet.schedules.header.component',
    'product.callsheet.schedules.import.component',
    'product.callsheet.schedules.item.edit.component'
])
    .service('CallsheetSchedulesListInitCtrlService', CallsheetSchedulesListInitCtrlService);
CallsheetSchedulesListInitCtrlService.$inject = ['CallsheetBlockGroupCtrlService', 'SBFieldTypesService'];
function CallsheetSchedulesListInitCtrlService(CallsheetBlockGroupCtrlService, SBFieldTypesService) {
    return function ($ctrl, $element, Pagination) {
        //console.log('SchedulesListCtrl');
        var advancedDateFormat = 'ddd, MMM D, YYYY';

        $ctrl.PopoverTypesOthers = {
            ImportSchedules: 'import-schedules'
        };

        $ctrl.SBFieldTypesService = SBFieldTypesService;
        $ctrl.SBFieldMethods = SBFieldTypesService.SBFieldMethods;
        $ctrl.MomentService = SBFieldMethods.MomentService;
        $ctrl.ScheduleTypes = $ctrl.SBFieldMethods.ScheduleTypes;

        _.each(['prepTime', 'shootTime', 'estTime', 'duration', 'count'], function (prop){
            $ctrl[prop] = 0;
        });

        $ctrl.withoutInitBottomActions = true;

        if(!$ctrl.constantsService){
            $ctrl.constantsService = {};
        }

        $ctrl.constantsService.ListParams = {
            includeFields: ['type', 'time', 'schedule', 'note', 'description', 'pages', 'scene', 'order', 'cast', 'dayTime','storyDay', 'location',
                'estTime', 'prepTime', 'shootTime', 'duration']
        };
        if(!$ctrl.constantsService.GroupSettings){
            $ctrl.constantsService.GroupSettings = {};
        }
        $ctrl.constantsService.GroupSettings.colType = 'schedules';

        if(!$ctrl.constantsService.CompOptions){$ctrl.constantsService.CompOptions = {};}

        $ctrl.openImportSchedules = openImportSchedules;
        $ctrl.getViewHeaderRight = getViewHeaderRight;
        $ctrl.getLowerFilters = getLowerFilters;
        $ctrl.getGridFooter = getGridFooter;
        $ctrl.getBottomActions = getBottomActions;
        $ctrl.hasMobileDetails = hasMobileDetails;
        $ctrl.getRowViewMobileDetails = getRowViewMobileDetails;
        $ctrl.getColClsBordersOther = getColClsBordersOther;
        $ctrl.getNewParams = getNewParams;
        $ctrl.processListItemColumn = processListItemColumn;
        $ctrl.onBlockLoaded = onBlockLoaded;
        $ctrl.afterProcessUpdates = afterProcessUpdates;
        $ctrl.onAdvancedChange = onAdvancedChange;

        $ctrl.onOtherPopoverTypes = onOtherPopoverTypes;
        if(!$ctrl.updateColListOther) {
            $ctrl.updateColListOther = updateColListOther;
        }
        $ctrl.recount = recount;
        $ctrl.setGroupCounter = recount;

        $ctrl = new CallsheetBlockGroupCtrlService($ctrl, $element, Pagination);

        if ($ctrl.canEdit) {
            $ctrl.scriptLoadingService = $ctrl.CurrentProduct.scriptLoadingService;

            $ctrl.getNewParams = getNewParams;
            $ctrl.importScenes = importScenes;
        }

        return $ctrl;

        function onAdvancedChange(updates) {
            if(updates) {
                return $ctrl.onChange({updates:updates});
            }
        }

        function getNewParams(after, type) {
            var item = {
                _id: new ObjectId().toString(),
                type: type !== undefined ? type : $ctrl.ScheduleTypes.Scene,
                schedule: null,
                note: null
            };
            if (type === $ctrl.ScheduleTypes.Scene) {
                item.pages = 0;
                item.dayTime = 3;
                item.scene = null;
            }

            var time;
            if($ctrl.list.items.length === 0){
                time = $ctrl.MomentService.getUtcMomentCopy($ctrl.callsheet.startDate)
            } else{
                var lastime = $ctrl.list.items[$ctrl.list.items.length - 1].time;
                if(lastime){
                    time = $ctrl.MomentService.getUtcMomentCopy(lastime).add(1, 'hours');
                }
            }

            if(time) {
                $ctrl.lastTime = time;
                item.time = time;
            }

            return item;
        }

        function getColClsBordersOther(item, c, isFirst, isLast, isMobile) {
            if(!item){return '';}
            switch (c.prop) {
                case 'scene':
                    return '';//(item.type !== $ctrl.ScheduleTypes.Scene ? 'hide-ipad':'')
            }
            return '';
        }

        function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {

            var isScene = item.type === $ctrl.ScheduleTypes.Scene,
                isCompany= item.type === $ctrl.ScheduleTypes.CompanyMove,
                prop = c.prop,
                t = '';

            $ctrl.itemTitle = isScene ? 'Schedule' : (isCompany ? 'Company Move' : 'Banner');

            switch (prop) {
                case 'scene':
                    if(isMobileRowDetails){
                        return isScene ? get(c) : '';
                    }
                    if(isMobile && (item.type === $ctrl.ScheduleTypes.Item || $ctrl.ScheduleTypes.CompanyMove)){
                        return '';
                    }

                    switch (item.type) {
                        case $ctrl.ScheduleTypes.Item:
                            t += $ctrl.LCS.getISBDiv('bannerinfo', 3, 'centered unchangedcolor');
                            break;
                        case $ctrl.ScheduleTypes.CompanyMove:
                            t += '<div class="move">' + $ctrl.LCS.getISBDiv('truck', 5, 'centered unchanged') + '</div><div class="move text-center">Move to:</div>';
                            //'<div class="move text-center">Move</div>';
                            break;
                        case $ctrl.ScheduleTypes.Scene:
                            if (isMobile) {
                                return '';
                            }
                            t += (isMobileRowDetails ? '' : '<div class="scene-title">Scene</div>') +
                                get(_.extend({}, c, isMobileRowDetails ? null : {editableContainerClass: 'without-height-padding'}), isMobileRowDetails ? '' : 'full-width');
                            break;
                    }
                    return '<div class="'+cls+'">' + t + '</div>';

                case 'schedule':
                    if(isMobileRowDetails){
                        return get(c);
                    }
                    var note = $ctrl.getColumnByProp('note'),
                        description = $ctrl.getColumnByProp('description'),
                        schedule = item.schedule,
                        scene = item.scene;

                        if (isCompany && (!$ctrl.canEdit || isMobile)) {
                            t = getC();
                        } else {
                            if(isMobile && isScene){
                               t = g();
                               if(scene){
                                   var r = 'class="'+$ctrl.SBFieldTypesService.SBViewContentCls+' semibold uppercase">';
                                   t = t.replace(r, r + 'Sc. ' + scene + ' ');
                               }
                            }
                            else{
                                t = g();
                            }
                            if(isMobile) {
                                t += getT();
                            }
                        }

                    t = '<div class="' + cls + '">' +
                              '<div class="full-width ' + (isMobile ? '' : 'display-flex') + '">' + t + '</div>' +
                        getN() +
                        getS() +
                        '</div>';

                    function getC(){
                        return schedule ? (
                            '<div class="move full-width show-ipad">Move to:</div>' +
                            '<div class="display-block full-width"><a class="unchanged semibold full-width ' + (schedule.formatted_address ? 'blue' : '') + '" target="_blank" href="' + $ctrl.SBFieldMethods.getMapLink(schedule) + '">' + $ctrl.SBFieldMethods.getAddress(schedule) + ' ➚</a></div>') : '-';
                    }

                    function g(){
                        return get(_.extend({}, c, {
                            placeholder: isScene? 'INT. Stuart’s Car' : (isCompany ? 'Set Address…' : 'Banner name (i.e. Meal Break, Load Out, Wrap, etc)…'),
                            type: isCompany ? $ctrl.SBFieldTypesService.PropTypes.Address : $ctrl.SBFieldTypesService.PropTypes.Field,
                            //eClassAttr: 'form-control without-underline',
                            fieldClass: ' semibold '+ (isScene ? 'uppercase' : ''),
                        }),scene ?' inline-block' : (cls  + ' '))
                    }

                    function getT(){
                        var estTime = getContent('estTime'),
                            pages = getContent('pages'),
                            startTime = null;// getContent('time'),

                        if (!(estTime || startTime || pages)){return '';}
                        return '<div class="full-width font-small">' +
                                    (estTime ? ('<span class="semibold">' + estTime + '</span>') : '') +
                                    (startTime ? ((estTime ? ' @ ' : '') + startTime) : '') +
                                    (pages ? (((estTime || startTime) ? ' • ' : '') + pages + '&nbsp;pgs') : '') +
                                '</div>';
                    }

                    function getN(){
                        if (!note) {return '';}
                        var n = get(_.extend({}, note, {
                            placeholder: isScene ? 'Stuart waits for Claire.' : (isCompany ? 'Company move description…' : 'Banner description…'),
                            hideEmptyContent: !$ctrl.canEdit || note.hideEmptyContent || !note.canEdit || isMobile
                        }));
                        return '<div class="full-width">' + n + '</div>';
                    }

                    function getS(){
                        if (!description) {return '';}
                        var n = get(_.extend({}, description, {
                            hideEmptyContent: !$ctrl.canEdit || description.hideEmptyContent || !description.canEdit || isMobile
                        }));
                        return '<div class="full-width">' + n + '</div>';
                    }

                    function getContent(name) {
                        var c = $ctrl.getColumnByProp(name),
                            co = c ? $ctrl.SBFieldTypesService.getSBFieldContentView($ctrl, item, _.extend({}, c, {
                                hideEmptyContent: true
                            }), textOnly).content : null;
                        return co && co !== '' && co.replace(/(<([^>]+)>)/ig, '') !== '–' ? co.replace('display-block', 'inline-block') : null;
                    }
                    return t;

                case 'note':
                case 'description':
                    return isMobileRowDetails ? get(c) : '';

                case 'storyDay':
                case 'dayTime':
                case 'cast':
                case 'location':
                case 'pages':
                     return isScene ? get(c) : '';

                case 'time':
                    if(isMobile && !isMobileRowDetails){
                        return '<div class="' + cls + '">' +
                            get(c, 'full-width') +
                            '<div class="scene-title full-width">Start</div>' +
                            '</div>';
                    }else{
                        return get(c);
                    }

                default:
                    return prop !== 'estTime' && isMobileRowDetails && !isScene ? '' : get(c);

            }

            function get(c, cls1) {
                return $ctrl.getDisplayItemCol(item, c, cls1 ? cls1 : cls, canEdit, textOnly, isMobile, isMobileRowDetails);
            }
        }

        function getRowViewMobileDetails (item){
            var isScene = item.type === $ctrl.ScheduleTypes.Scene;
            var t = '<div ng-if="$ctrl.isOpenRow(item._id)" class="row-mobile row-schedule fadeInDownSmall more-details">' +
                '<div class="page-icon padding-10"></div>' +
                '<div class="location-col">';
            if(isScene) {
                t += '<div class="full-width"><span class="small">Pages:</span> '+$ctrl.SBFieldMethods.getPages(item, 'small text inlline-block') +
                    '<div><span class="small">Scene:</span> <span class="small text">' + $ctrl.SBFieldMethods.getTimeDayDisplay(item) + '</span></div>';
            }
            t += '<div class="full-width" ><span class="small">Est (h):</span> <span class="small text">'+item.estTime.toFixed(2)+ 'h</span></div>' +
                '<!--<div class="full-width" ><span class="small">Prep Time:</span> <span class="small text" ng-bind="item.prepTime.toFixed(2)+\'h\'"></span></div>-->';

            if(isScene) {
                t += '<div class="padding-10">' +
                    '<div class="full-width"><span class="small">Cast:</span> <span class="small text">'+(item.cast ? item.cast : '–')+'</span></div>' +
                    '<div><span class="small">Location:</span> <span class="small text">'+(item.location ? item.location : '–')+'</span></div>' +
                    '</div>';
            }
            t += '</div>';

            return t;
        }

        function hasMobileDetails(item) {
            return $ctrl.isMobileView();
        }

        function setDefaultSelect(type, index) {
            $ctrl.setTabFocus(index, type === $ctrl.ScheduleTypes.Scene ? 5 : 6);
        }

        function recount() {
            $ctrl.LCS.timeout(process, 100);

            function process() {
                var props = ['prepTime', 'shootTime', 'estTime', 'duration'],
                    pages = 0, breakInfo = {},
                    l = $ctrl.list && $ctrl.list.items && $ctrl.list.items.length ? $ctrl.list.items.length : 0;

                _.each(props, function (prop) {
                    breakInfo[prop] = 0;
                });

                for (var i = 0; i < l; i++) {
                    var item = $ctrl.list.items[i];
                    if (item.type === $ctrl.ScheduleTypes.Scene) {
                        if (item.pages) {
                            pages += item.pages;
                        }
                    }
                    _.each(props, function (prop) {
                        if (item[prop]) {
                            breakInfo[prop] += item[prop];
                        }
                    });
                }

                var count = $ctrl.SBFieldMethods.getScenePage({pages: pages}),
                    el = $ctrl.element.querySelector('.totalPages');
                if (el) {
                    el.innerHTML = (count.page ? ('<span class="page">' + count.page + '</span>&nbsp;') : '') +
                        (count.fr ? ('<span class="fr">' + count.fr + '</span>') : '');
                }
                el = $ctrl.element.querySelector('.totalEstTime');
                if (el) {
                    var x = $ctrl.SBFieldMethods.getEstVal(breakInfo.estTime);
                    el.innerHTML = x ? x : (0 + 'h ' + 0 + 'm');
                }

                updateFooterGrid();
            }
        }

        function updateColListOther(){
            $ctrl.LCS.timeout(updateFooterGrid, 100);
            updateFooterGrid();
        }

        function updateFooterGrid(){
            var hasPages = $ctrl.getColumnByProp('pages'),
                hasEstTime = $ctrl.getColumnByProp('estTime');
            set(!hasPages && !hasEstTime, '.row-schedule.footer');
            set(!hasPages, '.row-schedule.footer .page-col');
            set(!hasEstTime, '.row-schedule.footer ');

            function set(hide, cls) {
                $ctrl.LCS[hide ? 'addClass' : 'removeClass']($ctrl.element.querySelector(cls), 'sb-hide');
            }
        }

        function onBlockLoaded() {
            console.log('onBlockLoaded');
            $ctrl.lastTime = $ctrl.MomentService.getUtcMomentCopy($ctrl.callsheet.startDate);
            if ($ctrl.list.items && $ctrl.list.items.length > 0) {
                $ctrl.lastTime = $ctrl.MomentService.getUtcMomentCopy($ctrl.list.items[$ctrl.list.items.length - 1].time);
            }

            $ctrl.recount();
        }

        function afterProcessUpdates(result) {
            if(!result){return;}
            $ctrl.recount();
        }

        function importScenes(item) {
            // var scene

            $ctrl.LCS.timeout(function () {
                $ctrl.lIsOpen = false;
            }, 0);
        }

        function getGridFooter() {
            return '<div class="row-schedule header noborderbottom footer large-column-padding">' +
                        ($ctrl.canEdit && ($ctrl.LCS.isTouchScreen || $ctrl.isMobileView()) ? '<div class="handle-col hide-print' + ($ctrl.withShortHandleCol ? $ctrl.withShortHandleCol :'')+ '"></div>' :'') +
                        '<div class="col-first grow-column text-right">Total</div>' +
                        '<div class="col60 page-col text-center no-large-column-padding '+
                 '">' +
                            '<div class="selected text-center totalPages"></div>' +
                        '</div>' +
                        '<div class="col-last col70 text-center no-large-column-padding ">' +
                            '<div class="selected text-center">' +
                                '<span class="totalEstTime lowercase">'+$ctrl.SBFieldMethods.getEstVal($ctrl.estTime) + '</span>' +
                            '</div>' +
                        '</div>' +
                    '</div>';
        }

        function getViewHeaderRight(){
            var tag = 'advanced-schedules-header';
            return $ctrl.canEdit && $ctrl.isAdvanced ? ('<'+tag+' ' +
                'class="'+tag+' clearfix pull-right" ' +
                    'item="::$ctrl.callsheet" ' +
                    'on-change="$ctrl.onAdvancedChange(updates)" ' +
                    '></'+tag+'>') : '';
        }

        function getLowerFilters(){
            if(!$ctrl.canEdit){
                var subt =
                    ($ctrl.count.page ? ('<span class="page">' + $ctrl.count.page + '</span>&nbsp;') : '') +
                    ($ctrl.count.fr ? ('<span class="fr">' + $ctrl.count.fr + '</span> pgs ') : '') +
                    ($ctrl.estTime ? (', <span class="page">Est. Time: ' + $ctrl.SBFieldMethods.getEstVal($ctrl.estTime) + '</span>') : '') +
                    ($ctrl.prepTime ? (', <span class="page">Prep Time: ' + $ctrl.SBFieldMethods.getEstVal($ctrl.prepTime) + '</span>') : '');


                var ad = $ctrl.isAdvanced ? $ctrl.CPS.getCreatedAt($ctrl.callsheet.advancedDate, advancedDateFormat) : null,
                    dd = $ctrl.isAdvanced ? $ctrl.callsheet.advancedDayOfDays : $ctrl.callsheet.dayOfDays;
                var txt = ad && dd ? ('<div class="inline-block read-field">' + dd + '</div>' +
                    '<div class="dot-separator inline-block line-height-18"></div>' +
                    '<div class="advancedDateReadOnly read-field inline-block">' + ad + '</div>'
                ) : (ad ? ad : dd);

                return '<div class="subt">' +
                (txt ? txt : 'What we\'re shooting ' + ($ctrl.isAdvanced ? 'next time' : 'today')) +
                    '</div>';
            }
        }

        function getBottomActions() {//ScheduleTypes.Scene
return  getBtn(1, $ctrl.ScheduleTypes.Scene, 'Scene')+
        getBtn(2, $ctrl.ScheduleTypes.Item, 'Banner')+
        getBtn(3, $ctrl.ScheduleTypes.CompanyMove, 'Company Move') +

        '<div tabindex="{{$ctrl.getTabIndex($ctrl.list.items.length, 4)}}" class="import-wrapper wide-tooltip '+$ctrl.getTableClass()+'">' +
            '<div class="hover-underline wrap-dd-select with-sb-popover ' + $ctrl.getBtnActionCls() + '" data-type="openImportSchedules" tooltip="Import previously saved schedules." tooltip-placement="top"' +
            // ' ng-click="$ctrl.openImportSchedules($event)"'+
            //' popover-type="'+$ctrl.PopoverTypesOthers.ImportSchedules+'' +
        '>' +
                '<div class="selected">' +
                    '<div class="selected-text">Import Schedules</div>' +
                '</div>' +
            '</div>' +
        '</div>';
        function getBtn(index, type, txt) {
            return '<a tabindex="{{$ctrl.getTabIndex($ctrl.list.items.length, ' + index + ')}}" class="small without-text inline-block ' + $ctrl.getBtnActionCls() + '" data-type="createNonNg" data-info="' + type + '" analytics-on analytics-action="Add ' + txt + '" >' + $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left with-margin-right') + ' <span>' + txt + '</span></a>';
        }
        }

        function onOtherPopoverTypes(result, popoverType, drpMenuId) {
            console.log('onOtherPopoverTypes');
            if (!result) {
                result = {};
            }
            if (!result.$ctrl) {
                result.$ctrl = {};
            }
            switch (popoverType) {
                case $ctrl.PopoverTypesOthers.ImportSchedules:
                    result = importSchedulesPopover(result, drpMenuId);
                    break;
            }

            return result;
        }

        function openImportSchedules(e){
            $ctrl.preventDefault(e);
            var max = $ctrl.list.items && $ctrl.list.items.length > 0 ? _.max($ctrl.list.items, function (item) {
                return item.order;
            }).order : null;
            $ctrl.popupsService.open({
                isAdvanced: $ctrl.isAdvanced === true,
                callsheetId: $ctrl.callsheetId,

                scriptId: $ctrl.CPS.scriptId,
                productId: $ctrl.CPS.productId,
                companyId: $ctrl.CPS.companyId,
            }, $ctrl.popupsService.operations.importSchedules, { //extraParam
order: max!==null ? (max + 1) : null,
                block: $ctrl.block,
                    scriptLoadingService: $ctrl.CurrentProduct.scriptLoadingService
            }, null, null, null, null, true);
        }

        function importSchedulesPopover(result, drpMenuId) {
            result.$ctrl.onUpdate = $ctrl.importSchedules;
            result.$ctrl.scriptLoadingService = $ctrl.CurrentProduct.scriptLoadingService;
            result.$ctrl.item = $ctrl.callsheet;
            result.template = '<import-callsheet-schedules-popover ' +
                'id="' + drpMenuId + '" ' +
                'header="Import from Schedules" ' +
                'item="::$ctrl.item" ' +
                'script-loading-service="::$ctrl.scriptLoadingService" ' +
                'on-update="$ctrl.onUpdate(result)"' +
                '></import-callsheet-schedules-popover>';
            return result;
        }
    }
}

angular.module('product.callsheet.editScheduleItem.controller.service', [
    'apiServices.Strips'
])
.service('EditScheduleItemCtrlService', EditScheduleItemCtrlService );
EditScheduleItemCtrlService.$inject = ['StripsService', 'SBFieldMethods'];
function EditScheduleItemCtrlService(StripsService, SBFieldMethods) {
    return function ($ctrl) {
        $ctrl.itemWithUpdatedSceneContent = StripsService.itemWithUpdatedSceneContent;
        $ctrl.SceneTimeOfDay = SBFieldMethods.SceneTimeOfDay;
        return $ctrl;
    }
}

angular.module('product.callsheet.schedule.item.grid.component', [
    'groupBlock.item.controller.service'
])

.component('callsheetSchedulesItemGrid', itemBlockGroupGridItemParams(null, 'CallsheetScheduleGridItemCtrl'))

.controller('CallsheetScheduleGridItemCtrl',CallsheetScheduleGridItemCtrl);
CallsheetScheduleGridItemCtrl.$inject = ['GridBlockItemGroupInitCtrlService', '$element'];
function CallsheetScheduleGridItemCtrl(GridBlockItemGroupInitCtrlService, $element) {
    //console.log('CallsheetScheduleGridItemCtrl: $onInit');
    var $ctrl = this;

    $ctrl.rowClsOther = rowClsOther;
    $ctrl.getColFromProp = getColFromProp; //for editable field

    $ctrl = new GridBlockItemGroupInitCtrlService($ctrl, $element);

    function rowClsOther() {
        if (!$ctrl.item) {
            return '';
        }

        switch ($ctrl.item.type) {
            case $ctrl.SBFieldMethods.ScheduleTypes.CompanyMove:
                return 'bluec';
            case $ctrl.SBFieldMethods.ScheduleTypes.Item:
                return 'yellow';
            case $ctrl.SBFieldMethods.ScheduleTypes.Scene:
                return '';// 'border-top';
        }
    }

    function getColFromProp(prop) {
        var c = $ctrl.getColFromPropInit(prop);
        if (c) {
            var isScene = $ctrl.item.type === 3,//Scene,
                isCompany = $ctrl.item.type === 2;//CompanyMove;

            if (c.prop === 'schedule') {
                return _.extend({}, c, {
                    placeholder: isScene ? 'INT. Stuart’s Car' : (isCompany ? 'Set Address…' : 'Banner name (i.e. Meal Break, Load Out, Wrap, etc)…'),
                    type: isCompany ? $ctrl.SBFieldTypesService.PropTypes.Address : $ctrl.SBFieldTypesService.PropTypes.Field,
                   // eClassAttr: 'form-control without-underline',
                    fieldClass: ' semibold '+ (isScene ? 'uppercase' : ''),
                });
            } else if (c.prop === 'note') {
                var n = _.extend({}, c, {
                    hideEmptyContent: true,
                    placeholder: isScene ? 'Stuart waits for Claire.' : (isCompany ? 'Company move description…' : 'Banner description…')
                });

                if (!n.canEdit) {
                    n.hideEmptyContent = true;
                }
                return n;
            }else if (isScene && c.prop === 'description') { //synopsis
                var n = _.extend({}, c, {
                    hideEmptyContent: true
                });

                if (!n.canEdit) {
                    n.hideEmptyContent = true;
                }
                return n;
            }
        }
        return c;
    }
}

angular.module('product.callsheet.schedules.import.component', [
    'product.callsheet.item.importSchedules.controller.service'
])
.component('importCallsheetSchedulesPopup', popupComponentParams('ImportCallsheetSchedulesPopupCtrl'))
.controller('ImportCallsheetSchedulesPopupCtrl', ImportCallsheetSchedulesPopupCtrl);
ImportCallsheetSchedulesPopupCtrl.$inject = ['CallsheetEditImportScheduleCtrlService', 'ListItemPopupTemplateCtrlService', 'SBFieldTypesService','CallsheetsService', '$element'];
function ImportCallsheetSchedulesPopupCtrl(CallsheetEditImportScheduleCtrlService, ListItemPopupTemplateCtrlService, SBFieldTypesService, service, $element) {

    console.log('ImportCallsheetSchedulesPopupCtrl');

    var $ctrl = this;
    $ctrl.SBFieldTypesService = SBFieldTypesService;
    $ctrl.preInitOther = preInitOther;
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.addSchedules = addSchedules;
    // $ctrl.getPopupFormOther = getPopupFormOther;

    $ctrl = new ListItemPopupTemplateCtrlService($ctrl, $element);

    function preInitOther() {
        $ctrl.service = service;
        $ctrl.scriptLoadingService = $ctrl.extraParam.scriptLoadingService;
        $ctrl.onUpdate = $ctrl.extraParam.onUpdate;

        $ctrl = new CallsheetEditImportScheduleCtrlService($ctrl, null);
        $ctrl.columnsList = $ctrl.getScheduleColumns([]);
    }

    function setTemplateData() {
        $ctrl.popupTitle = 'Import Schedules';
        $ctrl.icon = 'breakdowns';
        $ctrl.iconLevel = 3;
        $ctrl.btnText = '<span>Add</span><span class="hide-ipad"> Schedules</span>';
        $ctrl.firstBtnMethod = 'addSchedules';
        $ctrl.withFooterBtns = true;
    }

    //for now only add and dont remove existing
    function getPopupFormOther() {
        return '<div class="form-group text-left clearfix">' +
                '<div class="custom-checkbox '+ $ctrl.pageClass +'"><label><input id="removeExisting" type="checkbox" name="keep"><span><span class="longer">Remove existing items</span></span></label></div>' +
            '</div>';
    }

    function addSchedules(e) {
        $ctrl.preventDefault(e);
        $ctrl.error = null;
        if($ctrl.extraParam.order) {
            $ctrl.item.order = $ctrl.extraParam.order;
        }
        $ctrl.item.removeExisting = false;//$ctrl.element.querySelector('#removeExisting').checked;
        $ctrl.service.importSchedules($ctrl.item, onSuccess, onError);

        function onSuccess(result) {
            var block = $ctrl.extraParam.block || 'schedules';
            $ctrl.broadcastRoot('CALLSHEET_GRID_RELOAD_' + block);
            $ctrl.closePopup(e);
            /*$ctrl.LCS.timeout(function () {
                 $ctrl.CPS.reloadCurrentState();
            }, 400);*/
        }

        function onError(err){
            console.log(err);
        }
    }
}


angular.module('product.callsheet.schedules.item.edit.component', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'product.scheduling.item.edit.controller.service'
])
.component('callsheetScheduleEditPopup', popupComponentParams('CallsheetScheduleEditPopupCtrl'))
.controller('CallsheetScheduleEditPopupCtrl', CallsheetScheduleEditPopupCtrl);

CallsheetScheduleEditPopupCtrl.$inject = ['GeneralItemEditCtrlService', '$element'];
function CallsheetScheduleEditPopupCtrl(GeneralItemEditCtrlService, $element) {
    var $ctrl = this;
    $ctrl.isPopup = true;
    $ctrl.ScheduleTypes = {Item: 1, CompanyMove: 2, Scene: 3};

    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl.preSetTemplateData = preSetTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl.onLoaded = onLoaded;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneral() {
        $ctrl.itemChangedFields = $ctrl.extraParam.changedFields;

        $ctrl.objectType = 'callsheetSchedule';

        $ctrl.cleanParamType = $ctrl.item.type;
        $ctrl.modalBodyFormClass = 'med2 ' + ($ctrl.canEdit && $ctrl.LCS.isMobileSize? 'mobile-editable-form' : '');

        //dont populate day break automatically
        /*   if($ctrl.item.type === $ctrl.ScheduleTypes.DayBreak && !$ctrl.item.time){
               $ctrl.item.time = $ctrl.CPS.startTime;
           }*/
    }

    function preSetTemplateData() {

        if(typeof ($ctrl.preSetTemplateDataOther) === 'function') {
            $ctrl.preSetTemplateDataOther();
        }

        var itemTitle = 'Details';
        var isComp = $ctrl.item.type === $ctrl.ScheduleTypes.CompanyMove;
        $ctrl.itemTitle = $ctrl.item.type === $ctrl.ScheduleTypes.Scene ? itemTitle :
            (isComp ? 'Company Move' : 'Banner');

        $ctrl.icon = $ctrl.item.type === $ctrl.ScheduleTypes.Scene ? 'pencil' :
            (isComp ? 'daybreak' : 'banner');
        if(isComp) {
            $ctrl.iconLevel = 3;
        }
        $ctrl.popupTitle = ((!$ctrl.item._id ? 'Add New' : 'Edit') + ' ' + $ctrl.CPS.capitalizeFirst($ctrl.itemTitle));
        $ctrl.btnText =  !$ctrl.item._id ? 'Add' : 'Save';
        $ctrl.subtitle = $ctrl.item.miniTitle;
        $ctrl.modalBodyFormClass = 'med2 ' + ($ctrl.canEdit && $ctrl.LCS.isMobileSize? 'mobile-editable-form' : '');
        $ctrl.firstBtnCls = 'max-width200';
        $ctrl.withCloseBtn = true;
    }

    function onLoaded() {
        if ($ctrl.item.type !== 0) {
            $ctrl.setFocus($ctrl.extraParam.focus ? $ctrl.extraParam.focus : 1);
        }

        $ctrl.getItemById = getItemById;
    }

    function getItemById() {
        return $ctrl.item;
    }
    function getPopupBodyContent() {
        var withLabel = true,
            isMobile = $ctrl.LCS.isMobileSize;
        switch ($ctrl.item.type) {
            case $ctrl.ScheduleTypes.Scene:
                return getScene(withLabel, isMobile);
            case $ctrl.ScheduleTypes.Item:
                return getBanner();
            case $ctrl.ScheduleTypes.CompanyMove:
                return getBreak();
        }

        function getScene(withLabel, isMobile) {
            return getRow(['schedule'], 'full-width', {
                    name: 'Description',
                    placeholder: 'INT STUART\'S CAR)…',
                    withoutLabelInPopup: true
                }) +
                getRow(['scene', 'dayTime', 'pages'], 'col33p pull-left') +
                getRow(['cast', 'location'], 'col50p pull-left') +
                getRow(['time', 'estTime'], 'col50p pull-left') +
                getRow(['note'], 'full-width',{
                    name: 'Note',
                    placeholder: 'Stuart waits for Claire'
                });

            function getRow(l, cls) {
                return $ctrl.getRowCols(l, cls, withLabel, isMobile);
            }
        }

        function getBreak() {
            return getRow(['schedule'], 'full-width', {
                    name: 'Address',
                    placeholder: 'Set Address…',
                    withoutLabelInPopup: true,
                    type: $ctrl.SBFieldTypesService.PropTypes.Address
                }) +
               /*'<div class="table-div full-width">' +
                $ctrl.getContentEditable('schedule', true, {
                    name: 'Address',
                    placeholder: 'Set Address…',
                    withoutLabelInPopup: true
                }) +
                '</div>' +*/
                getRow(['time', 'estTime'], 'col50p pull-left') +
                getRow(['note'], 'full-width', {
                    name: 'Note',
                    placeholder: 'Company move description…'
                });
        }

        function getBanner() {
            return getRow(['schedule'], 'full-width', {
                    name: 'Banner',
                    placeholder: 'Banner description…',
                    withoutLabelInPopup: true
                }) +
                /*'<div class="table-div full-width">' +
                $ctrl.getContentEditable('schedule', true, {
                    name: 'Description',
                    placeholder: 'Short description (optional)…',
                    withoutLabelInPopup: true
                }) +
                '</div>' + */
                getRow(['time', 'estTime'], 'col50p pull-left') +
                getRow(['note'], 'full-width', {
                    name: 'Note',
                    placeholder: 'Banner description…'
                });
        }

        function getRow(l, cls, other) {
            return $ctrl.getRowCols(l, cls, withLabel, isMobile, other);
        }
    }
}

angular.module('product.callsheet.scheduleItem.controller', [

])
.controller('ScheduleItemCtrl',ScheduleItemCtrl);
ScheduleItemCtrl.$inject = ['GridItemUpdateInitCtrlService', 'EditScheduleItemCtrlService'];
function ScheduleItemCtrl(GridItemUpdateInitCtrlService, EditScheduleItemCtrlService) {
    var $ctrl = this;

    $ctrl.$onInit = $onInit;
    $ctrl.$doCheck = $doCheck;
    $ctrl.$onDestroy = $onDestroy;

    function $onInit() {
        $ctrl = new EditScheduleItemCtrlService($ctrl);
        $ctrl = new GridItemUpdateInitCtrlService($ctrl);
    }

    function $doCheck() {
        if($ctrl.$doInitCheck){$ctrl.$doInitCheck();}
    }

    function $onDestroy() {
        if($ctrl.onInitDestroy){$ctrl.onInitDestroy();}
    }
}

angular.module('product.callsheet.info.init.controller.service', [
])
.service('CallsheetInfoInitCtrlService', CallsheetInfoInitCtrlService);
CallsheetInfoInitCtrlService.$inject = [];
function CallsheetInfoInitCtrlService (){
    return function ($ctrl) {
        $ctrl.callsheet = angular.copy($ctrl.CurrentProduct.getCallsheet());
        $ctrl.callsheetId = $ctrl.callsheet._id;

        $ctrl.openSendCallsheetPopup = openSendCallsheetPopup;

        return $ctrl;

        function openSendCallsheetPopup() {
            console.log('openSendCallsheetPopup');
            $ctrl.popupsService.open($ctrl.callsheet, $ctrl.popupsService.operations.sendCallsheet, {}, $ctrl.compOptions, null, onsuccess);

            function onsuccess(el) {
                $ctrl.addRootWatcher('UPDATE_CALLSHEET_SENT', onUpdateCallsheetSent);
                var stateName = 'user.product.callsheet.confirmations';
                    //$ctrl.broadcastRoot('CLOSE_POPUP_SEND_CALLSHEET');
                /*$ctrl.CPS.transitionTo(stateName, $ctrl.CPS.currentProductPathParams({
                    callsheetId: $ctrl.callsheet._id
                }));*/

                $ctrl.SBStateService.assignUrl(
                    $ctrl.CPS.getStateHref(stateName, $ctrl.CPS.currentProductPathParams({
                    callsheetId: $ctrl.callsheet._id
                })));
            }
        }

        function onUpdateCallsheetSent(callsheetSent) {
            if (callsheetSent) {
                $ctrl.callsheet.callsheetSent = callsheetSent;
                $ctrl.callsheet.callsheetSentId = callsheetSent._id;

                $ctrl.CurrentProduct.setCallsheet($ctrl.callsheet);
            }
        }
    }
}

angular.module('product.callsheet.callsheetInviteItem.controller', [])
.controller('CallsheetInviteItemCtrl',CallsheetInviteItemCtrl);
CallsheetInviteItemCtrl.$inject = ['GridItemUpdateInitCtrlService', 'CompInitCtrlService'];
function CallsheetInviteItemCtrl( GridItemUpdateInitCtrlService, CompInitCtrlService) {
    //console.log('CallsheetInviteItemCtrl') ;
    var $ctrl = this;
    $ctrl.$onDestroy = $onDestroy;
    $ctrl = new CompInitCtrlService($ctrl);


    $ctrl.changeDetails = changeDetails;

    $ctrl.$onInit = $onInit;
    $ctrl.$doCheck = $doCheck;

    $ctrl.getShortProp = getShortProp;
    $ctrl.getName = getName;
    $ctrl.getTooltipName = getTooltipName;
    $ctrl.getTooltipProp = getTooltipProp;
    $ctrl.getPhone = getPhone;

    function $onInit() {
        //todo setsevice
        $ctrl.service = '';
        $ctrl = new GridItemUpdateInitCtrlService($ctrl);

        $ctrl.email = $ctrl.item && $ctrl.item.cast ? $ctrl.item.cast.email : null;
        $ctrl.name = $ctrl.getName($ctrl.item);
        $ctrl.tooltipName = $ctrl.getTooltipName($ctrl.item);
        $ctrl.picture = $ctrl.security.getLogoPath($ctrl.item.cast, 'profilePictureURL', 100);
        $ctrl.rolesText = $ctrl.getRolesText($ctrl.item, $ctrl.rolesgrid === 'CrewAndUnassigned' ? 2 : $ctrl.rolesgrid, $ctrl.dep ? $ctrl.dep.id : null);

        $ctrl.onUpdateAll = onUpdateAll;

        load();
    }

    function $doCheck() {
        if ($ctrl.$doInitCheck) {
            $ctrl.$doInitCheck();
        }
    }

    function $onDestroy() {
        if ($ctrl.onInitDestroy) {
            $ctrl.onInitDestroy();
        }
    }

    function load() {
        $ctrl.shortEmail = $ctrl.getShortProp($ctrl.item, 'email');
        $ctrl.tooltipEmail = $ctrl.getTooltipProp($ctrl.item, 'email');
        $ctrl.phone = $ctrl.getPhone($ctrl.item);
        $ctrl.tooltipDetails = ($ctrl.item.showDetails ? 'Hide' : 'Show') + ' Details';

        var phone = $ctrl.item.cast.phone;
        var showDetails = $ctrl.item.showDetails;
        $ctrl.hrefPhone = phone && showDetails ? ('tel:+' + phone) : '';
        $ctrl.cursorPhone = phone && showDetails ? 'hand' : 'default';
        $ctrl.smsPhone = phone && showDetails ? (($ctrl.LCS.isMobileSize ? 'sms' : 'imessage') + ':+' + phone) : '';
        $ctrl.hrefEmail = showDetails ? ('mailto:' + $ctrl.email) : '';
        $ctrl.cursorEmail = showDetails ? 'hand' : 'default';
        $ctrl.showPhone = ((phone !== null && phone !== undefined) && showDetails);
    }

    function getShortProp(item, prop) {
        var val = item ? item.cast[prop] : null;
        return val && item.showDetails ? (val.length > 18 ? (val.substring(0, 16) + '…') : val) : '–';
    }

    function onUpdateAll(item) {
        $ctrl.broadcastRoot('GRID_ITEM_UPDATE', item);
    }

    function changeDetails() {
        $ctrl.item.changeDetails();
        load();
    }

    function getName(item) {
        var val = item ? item.cast.name : null;
        return val ? (val.length > 18 ? (val.substring(0, 16) + '…') : val) : null;
    }

    function getTooltipName(item) {
        var val = item ? item.cast.name : null;
        return val && val.length > 18 ? val : '';
    }

    function getTooltipProp(item, prop) {
        var val = item ? item.cast[prop] : null;
        return item.showDetails && val && val.length > 18 ? val : '';
    }

    function getPhone(item) {
        return item.cast.phone && item.showDetails ? $ctrl.CPS.displayPhone(item.cast.phone) : '–';
    }
}

angular.module('product.callsheet.item.step1.edit.controller.service',  [
    'product.callsheet.update.service',
    'item.edit.controller.service'
])
.service('CallsheetStep1EditCtrlService', CallsheetStep1EditCtrlService);

CallsheetStep1EditCtrlService.$inject = ['CallsheetUpdateService', 'CompileService'] ;
function CallsheetStep1EditCtrlService(CallsheetUpdateService, CompileService) {
    return function ($ctrl, $element, isEdit) {
        console.log('CallsheetStep1EditCtrlService');

        $ctrl.CompileService = CompileService;

        $ctrl.preInitCU = preInitCU;
        $ctrl.postInitCU = postInitCU;

        return new CallsheetUpdateService($ctrl, $element);

        function preInitCU() {
            if (isEdit && !$ctrl.item) {
                $ctrl.item = angular.copy($ctrl.CurrentProduct.getCallsheet());
            }
            if (!$ctrl.extraParam) {
                $ctrl.extraParam = {};
            }

            if($ctrl.preInitCSE){
                $ctrl.preInitCSE();
            }
        }

        function postInitCU() {
            $ctrl.onTemplateChanged =  onTemplateChanged;
            $ctrl.getCallsheetTypeInfo = getCallsheetTypeInfo;
            $ctrl.getCallsheetTypeInfoLong = getCallsheetTypeInfoLong;

            if($ctrl.postInitCSE){
                $ctrl.postInitCSE();
            }
        }

        function onTemplateChanged(selected){
                console.log('onTemplateChanged');
                $ctrl.item.templateId = selected._id;//selected.isPredefined?selected._id:selected.parentId;
                if (selected.isPredefined) {
                    selected.options = $ctrl.CallsheetConstantsService.TemplateOptions['c_' + selected._id];
                }
                $ctrl.item.template = selected;
                $ctrl.item.options = selected.options;
        }

        function getCallsheetTypeInfo(callsheet, withCall) {
            var prop = 'title',
                type = callsheet && callsheet.type ? callsheet.type : 1,
                el = _.find($ctrl.CallsheetConstantsService.TypesInfo, function (item) {
                    return item.id === type;
                });
            return getTime(el, prop, type, withCall);
        }

        function getCallsheetTypeInfoLong(callsheet, withCall) {
            //getCallsheetTypeInfo
            var prop = 'title',
                el = _.find($ctrl.CallsheetConstantsService.TypesInfo, function (item) {
                    return item.id === type;
                }),
                t = callsheet && callsheet.type ? callsheet.type : 1,
                type = 'Call',
                CSSUB = 'Call Sheet';

            switch (t) {
                case 2:
                    type = 'Scout';
                    CSSUB = 'Location Scout';
                    break;
                case 3:
                    type = 'Rehearsal';
                    CSSUB = 'Rehearsal';
                    break;
                case 4:
                    type = 'Meeting';
                    CSSUB = 'Production Meeting';
                    break;
            }

            return getTime(el, prop, type, withCall);
        }

        function getTime(el, prop, type, withCall){
            return withCall ? ((type === 1 ? 'Your Call' : el[prop]) + ' Time') : el[prop];
        }
    }
}

angular.module('product.callsheet.item.step1.popup.controller.service',  [
    'product.callsheet.item.step1.edit.controller.service'
])
.service('CallsheetStep1PopupCtrlService', CallsheetStep1PopupCtrlService);

CallsheetStep1PopupCtrlService.$inject = ['TemplateCompileCompCtrlService', 'CallsheetStep1EditCtrlService'] ;
function CallsheetStep1PopupCtrlService(TemplateCompileCompCtrlService, CallsheetStep1EditCtrlService) {
    return function ($ctrl, $element, isEdit) {
        console.log('CallsheetStep1PopupCtrlService');

        $ctrl.formName = 'details';

        $ctrl.preInitCSE = preInitCSE;
        $ctrl.postInitCSE = postInitCSE;
        $ctrl.closeParent = closeParent;
        $ctrl.cancelPopup = cancelPopup;

        return new CallsheetStep1EditCtrlService($ctrl, $element, isEdit);

        function preInitCSE() {

            if (!$ctrl.extraParam) {
                $ctrl.extraParam = {};
            }

            $ctrl.extraParam.formName = $ctrl.formName;

            if($ctrl.preInitCSP){
                $ctrl.preInitCSP();
            }
        }

        function postInitCSE() {
            if($ctrl.postInitCSP){
                $ctrl.postInitCSP();
            }
        }

        function closeParent(result) {
            if (typeof ($ctrl.onClose) === 'function') {
                $ctrl.onClose({result: result ? result : 'cancel'});
            }
        }

        function cancelPopup() {
            if (typeof ($ctrl.onClose) === 'function') {
                $ctrl.onClose({result: 'cancel'});
            }
        }
    }
}

angular.module('product.callsheet.item.step1.edit.popup.controller.service',  [
    'product.callsheet.item.importSchedules.controller.service',
    'product.callsheet.item.step1.popup.controller.service'
])
.service('CallsheetStep1PopupEditCtrlService', CallsheetStep1PopupEditCtrlService);

CallsheetStep1PopupEditCtrlService.$inject = ['CallsheetEditImportScheduleCtrlService', 'CallsheetStep1PopupCtrlService','MomentService'] ;
function CallsheetStep1PopupEditCtrlService(CallsheetEditImportScheduleCtrlService, CallsheetStep1PopupCtrlService, MomentService) {
    return function ($ctrl, $element) {
        console.log('CallsheetStep1PopupEditCtrlService');
        var isEdit = false,
        dateProp = 'startDate';

        $ctrl.MomentService = MomentService;

        $ctrl.onChangeOther = onChangeOther;
        $ctrl.getCSForm = getCSForm;
        $ctrl.saveCSDetails = saveCSDetails;
        $ctrl.preInitCSP = preInitCSP;
        $ctrl.postInitCSP = postInitCSP;
        $ctrl.getEditState = getEditState;

        return new CallsheetStep1PopupCtrlService($ctrl, $element, isEdit);

        function preInitCSP() {
            $ctrl.withDayBreak = $ctrl.extraParam.withDayBreak;

            $ctrl.icon = $ctrl.itemIcon;
            if ($ctrl.isDuplicate) {
                $ctrl.item.title = 'Copy of ' + ($ctrl.item.title ? $ctrl.item.title : 'call sheet');

                $ctrl.icon = 'copy';
            }

            initCSINFO();
            if($ctrl.preInitCSPE){
                $ctrl.preInitCSPE();
            }
        }

        function postInitCSP() {
            postInitCSINFO();
            if($ctrl.postInitCSPE){
                $ctrl.postInitCSPE();
            }
        }

        function initCSINFO() {
            initDateInfo(dateProp);
        }

        function getDateXAfterToday(x){
            return getDateXAfterDay(x, null);
        }

        function getDateXAfterDay(x, mom) {
            var d = mom ? new Date(mom.year(), mom.month(), mom.date(), 0, 0, 0, 0) : new Date(),
                s = $ctrl.CPS.startTime,
                t = $ctrl.MomentService.utc([d.getFullYear(), d.getMonth(), d.getDate(), s.hours(), s.minutes(), s.seconds()]);
            return t.add(x, 'day');
        }

        function initDateInfo(dateProp) {
            if($ctrl.type === 'Create' && !$ctrl.item[dateProp]){
                //set start date to tomorrow
                $ctrl.item[dateProp] = getDateXAfterToday(1);
            }

            var d = $ctrl.item[dateProp];
            $ctrl.item['date'] = $ctrl.MomentService.getUtcMomentFromDateMoment(d, $ctrl.CPS.startTime);
            $ctrl.item['time'] = $ctrl.MomentService.getUtcMomentFromTimeMoment(d, $ctrl.CPS.startTime);
        }

        function postInitCSINFO() {
            $ctrl = new CallsheetEditImportScheduleCtrlService($ctrl, onInit);

            function convertResourceStripSchedule(item){
               return $ctrl.scriptLoadingService.Tbl.StripSchedules.loadingService.objectService.convertResource(item);
            }

            function onInit() {
                if($ctrl.extraParam.cast){
                    $ctrl.cast = $ctrl.extraParam.cast;
                }

                if (!$ctrl.withDayBreak) {
                    return;
                }

                var scheduleDayId = $ctrl.withDayBreak.scheduleDayId,
                    dayBreak = convertResourceStripSchedule($ctrl.scriptLoadingService.getStripScheduleById(scheduleDayId));

                if (!dayBreak || !$ctrl.schedulesLists || !$ctrl.schedulesLists.length) {
                    return;
                }

                var schedulesList = _.find($ctrl.schedulesLists, function (item) {
                    return item._id === $ctrl.withDayBreak.schedulesListId;
                });

                if (!schedulesList) {
                    return;
                }

                $ctrl.item.schedulesListId = schedulesList._id;
                $ctrl.item.scheduleDayId = scheduleDayId;

                processDate(dayBreak, dateProp, true);
                $ctrl.item.dayOfDays = dayBreak.name;

                var dayBreaks = $ctrl.scriptLoadingService.getStripSchedules({
                    type: 0,
                    active: true,
                    schedulesListId: $ctrl.item.schedulesListId
                }).map(convertResourceStripSchedule);

                for(var i = 0, l = dayBreaks.length;i < l; i++ ) {
                    var d = dayBreaks[i];
                    if (d._id === scheduleDayId) {
                        if (i + 1 < l) {
                            var nextday = dayBreaks[i + 1];
                            if (nextday) {
                                processDate(nextday, 'advancedDate');
                                $ctrl.item.nextScheduleDayId = nextday._id;
                                $ctrl.item.advancedDayOfDays = nextday.name;
                            }
                        }
                        break;
                    }
                }

                if (!$ctrl.item.advancedDate) {
                    $ctrl.item.advancedDate = getDateXAfterDay(1, $ctrl.item.startDate);
                }

                if (dayBreak.name) {
                    $ctrl.item.title = dayBreak.name;
                }
            }

            function processDate(dayBreak, prop, updateParams) {
                if (dayBreak.date || dayBreak.time) {
                    $ctrl.item[prop] = $ctrl.MomentService.getUtcMomentFromDateMoment(dayBreak.date ? dayBreak.date : $ctrl.MomentService.getUtcDateNow(), dayBreak.time ? dayBreak.time : $ctrl.CPS.startTime);
                    if(updateParams) {
                        initDateInfo(prop);
                    }
                }
            }
        }

        function onChangeOther(result) {
            var prop = result && result.prop ? result.prop : null;
            console.log('onChangeOther: ' + prop);
            if (prop === 'date' || prop === 'time') {
                $ctrl.item[dateProp] = prop === 'date' ?
                    $ctrl.MomentService.getUtcMomentFromDateMoment(result.selected.val, $ctrl.item['time']) :
                    $ctrl.MomentService.getUtcMomentFromDateMoment($ctrl.item['date'], result.selected.val);

                $ctrl.item.advancedDate = $ctrl.MomentService.getUTCMomentNextDay($ctrl.item[dateProp]);
            }
        }

        function getCSForm() {
            var eClassAttr = 'form-control with-underline ' + ($ctrl.pageClass || '');
            $ctrl.maxDate = $ctrl.MomentService.getUtcDateNowNextYear();

            var c1 = {
                    formGroupClass:'input-group col160 with-padding-right margin-bottom-30 ',
                    type: $ctrl.SBFieldTypesService.PropTypes.Date,
                    prop: 'date',
                    tabIndex: 2,
                    tabNextIndex: 3,
                    placeholder: 'Date',
                    eClassAttr: eClassAttr,
                    hasRemove: false,
                    enableTime: false,
                    dateFormat: 'ddd, MMM D, YYYY',//from moment
                    canEdit: true,
                    parentContainer: '.modal-dialog .modal-content',
                    // minDate: "::$ctrl.todayDate",
                    maxDate: "::$ctrl.maxDate",
                    icon:'date',
                    iconLevel: 6
                },
                c2 = {
                    formGroupClass:'input-group col150 with-padding-left margin-bottom-30 ',
                    type: $ctrl.SBFieldTypesService.PropTypes.Time,
                    placeholder: 'Calltime',
                    prop: 'time',
                    tabIndex: 3,
                    tabNextIndex: 4,
                    eClassAttr: eClassAttr,
                    hasRemove: false,
                    parentContainer: true,
                    canEdit: true,

                    timeFormat: $ctrl.CPS.timeFormat,
                    icon: 'clock'
                },
                columns = [{
                    type: $ctrl.SBFieldTypesService.PropTypes.Field,
                    prop: 'title',
                    tabIndex: 1,
                    tabNextIndex: 2,
                    placeholder: $ctrl.getCallsheetTypeInfo($ctrl.item) + ' Title…',
                    name: 'Title',
                    eClassAttr: eClassAttr,
                    isRequired: true,
                   // inputName: 'name',
                    canEdit: true,
                    icon: 'title ' + $ctrl.pageClass,
                    withoutLabelInPopup: true
                    //    capitalizeFirst: true,
                }];

            if($ctrl.LCS.isMobileSize) {
                var formGroupClass = {formGroupClass: ' form-group field thinner wide-tooltip '};
                columns.push(_.extend(c1, formGroupClass));
                columns.push(_.extend(c2, formGroupClass));
            }else {
                columns.push({
                    multiDiv: [c1, c2],
                    formGroupClass: 'form-group field table-div full-width margin-bottom-30'
                });
            }

            if($ctrl.isNew && !$ctrl.isDuplicate) {
                columns = $ctrl.getScheduleColumns(columns);
            }

            return $ctrl.SBFieldTypesService.getPopupSBForm($ctrl, columns, {
                withLabel: $ctrl.withLabel,
                onChangeOther: $ctrl.onChangeOther
            });
        }

        function saveCSDetails() {
            if($ctrl.isDuplicate){
                return duplicate();
            }
            return $ctrl.saveItemDetails(goToCallsheet);
        }

        function duplicate() {
            $ctrl.formHolderItem.details_attempted = true;
            if (!$ctrl.formHolderItem.details.$valid || $ctrl.isUpdating) {return;}
            $ctrl.isUpdating = true;
            var props = {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                callsheetId: $ctrl.item.afterId,
                title: $ctrl.item.title,
                header: $ctrl.item.title + ', ' + $ctrl.CPS.product.name,

            };
            props[dateProp] = $ctrl.item[dateProp];
            $ctrl.CallsheetsService.duplicate(props, goToCallsheet, onError);

            function onError(error) {
                $ctrl.isUpdating = false;
                $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.callsheet.Duplicate.error', 'error');
            }
        }

        function goToCallsheet(result) {
            var callsheet = result && result.item ? $ctrl.service.convertResource(result.item) : null;
            $ctrl.isUpdating = false;
            if(callsheet){
                $ctrl.CurrentProduct.setCallsheet(callsheet);
            }
            if($ctrl.isNew || $ctrl.isDuplicate){
                $ctrl.broadcastRoot('ADDED_CALLSHEET_ITEM', result);
            }
            return goToEdit(callsheet._id);
        }

        function goToEdit(callsheetId) {
            if( typeof($ctrl.closeParent) === 'function') {
                $ctrl.LCS.timeout(function () {
                    $ctrl.closeParent();
                }, 0);
            }

            if( typeof($ctrl.closeParent) === 'function'){$ctrl.closeParent();}
            $ctrl.getEditState(callsheetId, false);
        }

        function getEditState(id, isHref) {
            if (!isHref) {
                $ctrl.broadcastRoot('HIDE_MOBILE_DETAILS');
            }
            return $ctrl.CPS[isHref ? 'getStateHref' : 'transitionTo']('user.product.callsheet.edit', $ctrl.CPS.currentProductPathParams({callsheetId: id, mode: 'design'}));
        }
    }
}

angular.module('product.callsheet.item.importSchedules.controller.service',  [
    'product.callsheet.item.step1.popup.controller.service'
])
.service('CallsheetEditImportScheduleCtrlService', CallsheetEditImportScheduleCtrlService);

CallsheetEditImportScheduleCtrlService.$inject = [] ;
function CallsheetEditImportScheduleCtrlService() {
    return function ($ctrl, onInit) {
        console.log('CallsheetEditImportScheduleCtrlService');

//planFetatures testmode
        var quotaType = 'stripboardCallsheets';
        var hasQuota = quotaType ? $ctrl.CPS.hasQuotaType(quotaType) : true;
        $ctrl.getDayBreaks = getDayBreaks;
        loadScheduleInfo(onInit);

        return $ctrl;

        function loadScheduleInfo(onInit){
            if(!$ctrl.scriptLoadingService){
                console.warn('Parent for CallsheetEditImportScheduleCtrlService must define $ctrl.scriptLoadingService');
            }

            if(!$ctrl.Settings) {
                $ctrl.Settings = {};
            }

            $ctrl.importStripsPlaceholder = 'Import schedule from stripboard (optional)…';

            $ctrl.config = {
                valueField: '_id',
                labelField: 'name',
                placeholder: $ctrl.importStripsPlaceholder,
                searchField: ['name', 'note'],
                inputClass: 'selectize-input selected-text ' + $ctrl.pageClass,
                render: {
                    item: function (i, e) {
                        return renderItem(i, e, 'item');
                    },
                    option: function (i, e) {
                        return renderItem(i, e, 'option');
                    }
                }
            };

            $ctrl.setScheduleDayId = setScheduleDayId;
            $ctrl.setSchedulesListId = setSchedulesListId;
            $ctrl.getScheduleColumns = getScheduleColumns;
            $ctrl.loadShootingSchedules = loadShootingSchedules;

            $ctrl.loadShootingSchedules(onInit);
        }

        function renderItem(item, escape, type) {
            var avatar = '<div id="' + item._id + '"><span class="name">' + item.name + '</span>' +
                (item.note ? ('<span>  —  </span> <span class="note">' + item.note + '</span>') : '' ) +
                '</div>';

            $ctrl.CompileService.addCompiledTemplateWatcher($ctrl.watchers, avatar, item._id, type);

            return avatar;
        }

        function loadShootingSchedules(onInit) {
            console.log('loadShootingSchedules');
            $ctrl.schedulesLists = [{name: 'No Scenes', _id: -1}];
            var list = $ctrl.scriptLoadingService.getSchedulesLists({isFolder: false});
            $ctrl.item.schedulesListId =  -1;
            if (list && list.length > 0) {
                $ctrl.schedulesLists = $ctrl.schedulesLists.concat(list);
                if(hasQuota) {
                    $ctrl.item.schedulesListId = list[0]._id;
                }
            }

            $ctrl.Settings.schedulesLists = $ctrl.schedulesLists;
            $ctrl.getDayBreaks(true, onInit);
        }

        function getDayBreaks(isInit, onInit) {
            var dayBreaks = [];
            if (isInit && typeof (onInit) === 'function') {
                onInit();
            }

            if ($ctrl.item.schedulesListId === -1) {
                dayBreaks = null;
            } else {
                if ($ctrl.item.schedulesListId) {
                    dayBreaks = $ctrl.scriptLoadingService.getStripSchedules({
                        type: 0,
                        active: true,
                        schedulesListId: $ctrl.item.schedulesListId
                    });
                    dayBreaks.push({name: 'All Scenes', note: 'All Scenes', _id: 0, type: 0});
                    dayBreaks = _.sortBy(dayBreaks, 'order');
                }

                if (!dayBreaks || !dayBreaks.length) {
                    dayBreaks = null;
                }
            }
            $ctrl.dayBreaks = dayBreaks;
            $ctrl.Settings.dayBreaks = $ctrl.dayBreaks;
            var dayBreak = dayBreaks ? _.find(dayBreaks, {_id: $ctrl.item.scheduleDayId}) : null;
            setScheduleDay(dayBreak ? dayBreak._id : (dayBreaks ? dayBreaks[0]._id : null));
        }

        function setSchedulesListId(result) {
            //planFetatures testmode
            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), result && result.e ? {e:result.e} :null);
            function process() {
                if (result) {
                    $ctrl.item.schedulesListId = null;
                    $ctrl.LCS.timeout(function () {
                        $ctrl.item.schedulesListId = result.selected.val;
                        $ctrl.getDayBreaks(false, null);
                    }, 100);
                }
            }
        }

        function setScheduleDayId(result) {
            setScheduleDay(result && result.selected ? result.selected.val : null);
        }

        function setScheduleDay(scheduleDayId) {
            if (scheduleDayId !== null && scheduleDayId !== undefined && scheduleDayId !== -1) {
                for (var i = 0, l = $ctrl.dayBreaks.length; i < l; i++) {
                    var day = $ctrl.dayBreaks[i], id = day._id;
                    if (scheduleDayId === id) {
                        $ctrl.item.scheduleDayId = id;
                        $ctrl.item.dayOfDays = day.name;
                        if (id !== -1 && id !== 0 && (i + 1 < l)) {
                            var nextday = $ctrl.dayBreaks[i + 1];
                            $ctrl.item.nextScheduleDayId = nextday._id;
                            $ctrl.item.advancedDayOfDays = nextday.name;
                            if (nextday.date) {
                                $ctrl.item.advancedDate = nextday.date;
                            }
                        }
                        break;
                    }
                }
            } else {
                $ctrl.item.scheduleDayId = null;
                $ctrl.item.dayOfDays = null;
                $ctrl.item.nextScheduleDayId = null;
                $ctrl.item.advancedDayOfDays = null;
            }
        }

        function getScheduleColumns(columns) {
            var eClassAttr = 'form-control with-underline ' + ($ctrl.pageClass || ''),
                formGroupClass =' form-group field thinner wide-tooltip';
            if ($ctrl.schedulesLists.length > 1) {
                columns.push({
                    name: 'Import from Stripboard',
                    canEdit: true,
                    tabIndex: 4,
                    tabNextIndex: 5,
                    formGroupClass: formGroupClass,
                    type: $ctrl.SBFieldTypesService.PropTypes.Drp,
                    drpMenuCls: 'col394',
                    eClassAttr: eClassAttr,
                    cClassAttr: 'autoheight long-caret',
                    //fieldClass: 'form-control with-underline ' + $ctrl.pageClass,
                    initListName: 'schedulesLists',
                    prop: 'schedulesListId',
                    itemLabel: 'name',
                    itemValue: '_id',
                    parentContainer: true,
                    onChange: "$ctrl.setSchedulesListId(result)",
                    otherHtml: '<div class="wide-tooltip hide-ipad position-absolute" style="height:0;left:100%;top:0">' +
                        '<div style="right:-20px;top:4px" class="sbf info blueish position-absolute" tooltip-placement="left" tooltip="Automatically populates call sheet details based on the shoot day. Shoot days are defined by the daybreaks you add on the Stripboard page.">' +
                        $ctrl.LCS.getISBPath(3) +
                        '</div>' +
                        '</div>'
                });
            }

            if ($ctrl.dayBreaks && $ctrl.dayBreaks.length) {
                columns.push({
                    ifCond: '$ctrl.item.schedulesListId&&$ctrl.item.schedulesListId!==-1',

                    name: 'Select Day',
                    canEdit: true,
                    tabIndex: 5,
                    tabNextIndex: 6,
                    formGroupClass: formGroupClass,
                    type: $ctrl.SBFieldTypesService.PropTypes.Drp,
                    drpMenuCls: 'col394 drpDayBreaks',
                    eClassAttr: eClassAttr,
                    cClassAttr: 'autoheight long-caret',
                    initListName: 'dayBreaks',
                    prop: 'scheduleDayId',
                    itemLabel: 'name',
                    itemValue: '_id',
                    parentContainer: true,
                    onChange: "$ctrl.setScheduleDayId(result)",
                    otherHtml: '<div class="wide-tooltip hide-ipad position-absolute" style="height 0;left:100%;top:0"><div style="right:-20px;top:4px" class="sbf info blueish position-absolute" tooltip-placement="left" tooltip="Automatically import stripboard details such as scenes, banners, shooting locations, cast, advance schedule, and day out of days.">' +
                        $ctrl.LCS.getISBPath(3) +
                        '</div></div>'
                });
            }

            return columns;
        }
    }
}


angular.module('product.callsheet.update.service', [
    'apiServices.Callsheets',
    'apiServices.Contacts',
    'apiServices.CallsheetInvitations'
])
.service('CallsheetUpdateService', CallsheetUpdateService);

CallsheetUpdateService.$inject = ['ListItemPopupTemplateCtrlService', 'ContactsService', 'CallsheetInvitationsService', 'CallsheetConstantsService', 'CallsheetsService'];
function CallsheetUpdateService(ListItemPopupTemplateCtrlService, ContactsService, CallsheetInvitationsService, CallsheetConstantsService, service) {
    return function ($ctrl, $element) {

        console.log('CallsheetUpdateService');

        $ctrl.CallsheetInvitationsService = CallsheetInvitationsService;
        $ctrl.CallsheetsService = service;
        $ctrl.ContactsService = ContactsService;

        $ctrl.preInitOther = preInitOther;
        $ctrl.postInitOther = postInitOther;

        return new ListItemPopupTemplateCtrlService($ctrl, $element);

        function preInitOther() {
            if(!$ctrl.extraParam){$ctrl.extraParam = {};}
            $ctrl.extraParam.service = $ctrl.CallsheetsService;

            if($ctrl.preInitCU) {
                $ctrl.preInitCU();
            }
        }

        function postInitOther() {
            $ctrl.CallsheetConstantsService = angular.copy(CallsheetConstantsService);

            $ctrl.CallsheetTypes = $ctrl.CallsheetConstantsService.Types;
            $ctrl.TypesInfo = $ctrl.CallsheetConstantsService.TypesInfo;

            $ctrl.scriptLoadingService = $ctrl.CurrentProduct.scriptLoadingService;

            $ctrl.saveItemDetails = saveItemDetails;
            $ctrl.saveDetails = saveDetails;

            if($ctrl.postInitCU) {
                $ctrl.postInitCU();
            }
        }

        function isValid() {
            $ctrl.error = null;
            $ctrl.formHolderItem.details_attempted = true;
            var form = $ctrl.formHolderItem.details;
            if (form && !form.$valid) {
                if (form.$error['date-disabled'] !== null) {
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'date-disabled', 'error');
                }
                return false;
            }
            return true;
        }
        
        function saveDetails(e) {
            $ctrl.preventDefault(e);
            if (!isValid()) {
                return;
            }

            $ctrl.isUpdating = true;
            return updateCallsheet($ctrl.item, $ctrl.dontShowActivity);
        }

        function getDefaultParams() {
            return {
                productId: $ctrl.CPS.productId,
                companyId: $ctrl.CPS.companyId
            }
        }

        function getParams() {
            return _.extend({
                scriptId: $ctrl.CPS.product ? $ctrl.CPS.product.scriptId : null,
            }, getDefaultParams());
        }

        function saveItemDetails(next) {
            if ($ctrl.isUpdating || !isValid()) {
                return;
            }

            if(!$ctrl.item.title){
                $ctrl.error = 'Callsheet title is not set ';
                return;
            }
            $ctrl.isUpdating = true;
            if(!$ctrl.item.cast) {
                $ctrl.item.cast = null;
            }

            if (!$ctrl.item.header && $ctrl.item.title) {
                $ctrl.item.header = $ctrl.item.title + ', ' + ($ctrl.CPS.product ? $ctrl.CPS.product.getName() : '');
            }


            if($ctrl.item._id){
                return updateCallsheet($ctrl.item);
            }else {
                if($ctrl.item.options.logos) {
                    var logos = _.extend({}, $ctrl.item.options.logos);
                    delete $ctrl.item.options.logos;
                    $ctrl.item = _.extend($ctrl.item, logos);
                }
                if(!$ctrl.item.productionLogo) {
                    var company = $ctrl.security.getCurrentCompany();
                    if (company.logo) {
                        $ctrl.item.productionLogo = company.logo;
                    }
                    if (company.logoId) {
                        $ctrl.item.productionLogoId = company.logoId;
                    }
                }
                $ctrl.CallsheetsService.insert(_.extend({}, $ctrl.item, getParams()), onInserted, onError);
            }

            function onInserted(result) {
                var callsheet = result && result.item ? $ctrl.service.convertResource(result.item) : null;
                var callsheetBuilder = $ctrl.CPS.hasQuotaType('callsheetBuilder') ;
                if (callsheetBuilder) {
                    return process();
                }
                // for free users add the user to the callsheet so they can send tests to themselves
                $ctrl.ContactsService.getCastForCurrentUser(getDefaultParams(), function (cast) {
                    var id = cast._id;
                    var l = $ctrl.cast ? $ctrl.cast.length : 0;
                    if ($ctrl.cast === null || l === 0) {
                        $ctrl.cast = [id];
                    } else {
                        var exists = false;
                        for (var i = 0; i < l; i++) {
                            var el = $ctrl.cast._id;
                            if (id === el) {
                                exists = true;
                                break;
                            }
                        }
                        if (!exists) {
                            $ctrl.cast.push(id);
                        }
                    }
                    process();
                }, process);

                function process() {
                    $ctrl.item = callsheet;
                    if (!$ctrl.cast || $ctrl.cast.length === 0) {
                        $ctrl.isUpdating = false;
                        //  $ctrl.$close({callsheet: callsheet, step: 2});
                        //$ctrl.updatePage(callsheet, $ctrl.STEPS.Details, close);
                        //$ctrl. 'product.callsheet.edit'
                        return next(result);
                    }

                    $ctrl.CallsheetInvitationsService.insertRecipients(_.extend({
                        dontShowActivity: true
                    }, $ctrl.item, getDefaultParams()), $ctrl.cast, function (insertedCastIds) {
                        //$ctrl.$close({callsheet: callsheet, step: 3});
                        //$ctrl.updatePage(callsheet, $ctrl.STEPS.Details, close);
                        callsheet.cast = insertedCastIds;
                        next(result);
                    }, function (error) {
                        $ctrl.isUpdating = false;
                        $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.callsheet.UPDATE.cast.error', 'error');
                    });
                }
            }

            function onError(error) {
                $ctrl.isUpdating = false;
                $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.callsheet.Create.error', 'error');
            }
        }

        function updateCallsheet(callsheet, dontShowActivity) {
            var changeDetails = ['title', 'startDate', 'type', 'templateId', 'options'];
            var data = $ctrl.CallsheetsService.getChanges(changeDetails, callsheet, $ctrl.copyItem);
            if (!data) {
                $ctrl.isUpdating = false;
                return;
            }

            data._id = callsheet._id;
            if(dontShowActivity) {
                data.dontShowActivity = dontShowActivity;
            }
            $ctrl.CallsheetsService.update(_.extend(data, getParams()), onUpdated, onError);

            function onUpdated(result) {
                $ctrl.isUpdating = false;
                $ctrl.onCustomSaveInit(result);
                $ctrl.CurrentProduct.setCallsheet(_.extend(angular.copy($ctrl.CurrentProduct.getCallsheet()), data));
                $ctrl.LCS.timeout(function () {
                    if(data.templateId  ) {
                        $ctrl.broadcastRoot('CALLSHEET_TEMPLATE_CHANGED', data.options);
                    }else if (data.options){
                        //todo see if necessary. none defined yet
                        $ctrl.broadcastRoot('CALLSHEET_OPTIONS', data.options);
                    } else{ //edit callsheet from popup
                        result.editchanges = data;
                        if (data.type){
                            $ctrl.broadcastRoot('CALLSHEET_TYPE_CHANGED', result);
                        }
                        $ctrl.broadcastRoot('UPDATED_CALLSHEET_ITEM', result);
                    }
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.callsheet.details.success', 'success');
                    if( typeof($ctrl.closeParent) === 'function'){$ctrl.closeParent();}
                }, 100);
            }

            function onError(error) {
                $ctrl.isUpdating = false;
                $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.callsheet.details.error', 'error');
            }
        }
    }
}

