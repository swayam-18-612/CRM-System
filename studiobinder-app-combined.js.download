angular.module('product.document.scratchpad.service', [
    'apiServices.Documents',
    'product.documentVersion.scratchpad.service'
])
.service('DocumentScratchpadCtrlService', DocumentScratchpadCtrlService);
DocumentScratchpadCtrlService.$inject = ['DocumentVersionScratchpadCtrlService', 'TemplateCompileService', 'DocumentsService'];
function DocumentScratchpadCtrlService(DocumentVersionScratchpadCtrlService, TemplateCompileService, DocumentsService) {
    return function ($ctrl, $element){

        $ctrl.DocumentsService = DocumentsService;

        $ctrl.onScratchpadInit = onScratchpadInit;
        $ctrl.openScratchpad = openScratchpad;
        $ctrl.onInitVersion = onInitVersion;
        $ctrl.onItemUpdateOther = onItemUpdateOther;

        $ctrl = new DocumentVersionScratchpadCtrlService($ctrl, $element, $ctrl.isPopup);
    
        return $ctrl;

        function onScratchpadInit() {

            $ctrl.elemType = 'DOCUMENT';
            $ctrl.dontLoadEditorContent = true;
            $ctrl.service = $ctrl.DocumentsService;
            $ctrl.item = $ctrl.isPopup ? $ctrl.extraParam.item : {_id: $ctrl.extraParam.documentId};
            if($ctrl.isPopup){
                $ctrl.dontLoadFromServer = true;
            } else{
                $ctrl.addRootWatcher(getdocScratchId(), onPopupUpdated);
            }
        }

        function onPopupUpdated(item){
            console.log('onPopupUpdated');
            if(item && $ctrl.item && $ctrl.item._id === item._id) {
                $ctrl.item[$ctrl.field] = item[$ctrl.field];
            }
            onInitVersion();
        }

        function openScratchpad() {
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations.documentScratchpad, {
                item: $ctrl.item,
                //dontLoadFromServer: true,
                service: $ctrl.DocumentsService //save scratchpad for document not for version
            }, $ctrl.compOptions);
        }

        function onInitVersion(){
            if(!$ctrl.compileTemplate) {
                $ctrl.compileTemplate = new TemplateCompileService($ctrl.element.querySelector('.' + $ctrl.bodyTableCls), $ctrl.getContentEditor, $ctrl);
            }
            $ctrl.compileTemplate.loadTemplate(onLoaded);

            function onLoaded(){

            }
        }

        function onItemUpdateOther(result){
            console.log('DocumentScratchpadCtrlService.onItemUpdateOther');
            var editchanges = $ctrl.item && result && result.editchanges && result.editchanges._id === $ctrl.item._id ? result.editchanges : null;
            if(!editchanges){return;}
            _.each([$ctrl.field], function (prop){
                if(editchanges.hasOwnProperty(prop)) {
                    $ctrl.DocumentsService.update(_.extend({
                        companyId: $ctrl.CPS.companyId,
                    }, editchanges), function (result) {
                        $ctrl.item[prop] = editchanges[prop];

                        if($ctrl.isPopup){
                            $ctrl.broadcastRoot(getdocScratchId(), $ctrl.item);
                        }
                    });
                }
            });
        }

        function getdocScratchId(){
            return 'DOC_SCRATCHPAD_POPUP_' + $ctrl.item._id;
        }
    }
}

angular.module('product.documentVersion.scratchpad.service', [
    'product.document.notes.controller.service'
])
.service('DocumentVersionScratchpadCtrlService', DocumentVersionScratchpadCtrlService);
DocumentVersionScratchpadCtrlService.$inject = ['VersionNoteServiceCtrl'];
function DocumentVersionScratchpadCtrlService(VersionNoteServiceCtrl) {
    return function ($ctrl, $element){

        $ctrl.onAdditionalInitOther = onAdditionalInitOther;

        $ctrl = new VersionNoteServiceCtrl($ctrl, $element, $ctrl.isPopup);
    
        return $ctrl;
        
        function onAdditionalInitOther(){

            $ctrl.editorType = 'scratchpad';
            if($ctrl.extraParam && $ctrl.extraParam.service){
                $ctrl.service = $ctrl.extraParam.service;
            }

            $ctrl.editorClsOther = 'scratch-pad';
            $ctrl.field = 'scratchPad';
            $ctrl.placeholder = 'Enter notes…';

            $ctrl.customTitle = 'Script Outline';
            $ctrl.icon = 'scratchpad';

            if($ctrl.isPopup){
                $ctrl.isFullPageSize = true;
            } else{
                $ctrl.editorClsOther = ($ctrl.editorClsOther || '') + ' h-full';
                $ctrl.withScrollbar = true;
                $ctrl.bodyTableCls = 'body-table';

                $ctrl.getInlineTemplate = getInlineTemplate;
            }

            if(!$ctrl.isFullPageSize) {
                $ctrl.withTogglePopup = true;
            }
            if($ctrl.onScratchpadInit) {
                $ctrl.onScratchpadInit();
            }
        }

        function getInlineTemplate() {
            return getHeader() +
                getSimpleBody($ctrl.dontLoadEditorContent ? '' : $ctrl.getContentEditor());

            function getHeader(){
                return '<div class="modal-header clearfix hide-ipad">' +
                    '<div class="top-table table-div full-width">' +
                    '<div class="table-col">' +
                    $ctrl.LCS.getISBDiv($ctrl.icon, 4, 'gray') +
                    '<span class="stronger title with-margin-left">' + $ctrl.customTitle + ' </span>' +
                    getToggle() +
                    '</div>' +
                    $ctrl.getErrorBlock() +
                    '</div>' +
                    '</div>';
            }

            function getSimpleBody(content) {
                return '<div class="'+$ctrl.bodyTableCls+' medium-template h-full">' + (content ? content : '') + '</div>';
            }

            function getToggle(){
                return $ctrl.withTogglePopup ? ('<a style="margin-right: 40px" class="'+ $ctrl.getBtnActionCls() +' btn btn-small primary-faded with-margin-left inline-block pull-right without-text" data-type="openScratchpad" analytics-on analytics-action="Script Outline" tooltip="Script Outline " tooltip-placement="bottom">' + $ctrl.LCS.getISBDiv('resize-expand', 4) + '</a>') : '';
            }
        }
    }
}

angular.module('product.document.download.component', [
    'product.document.edit.service',
    'service.scriptConvert'
])
.component('documentDownloadPopup', popupComponentParams('DocumentDownloadPopupCtrl'))
.controller('DocumentDownloadPopupCtrl',DocumentDownloadPopupCtrl);
DocumentDownloadPopupCtrl.$inject = ['ScriptConvertService', 'DocumentVersionPopupCtrlService', 'DownloadExportService', '$element'];
function DocumentDownloadPopupCtrl(ScriptConvertService, DocumentVersionPopupCtrlService, DownloadExportService, $element) {

    var $ctrl = this;
    $ctrl.DownloadExportService = DownloadExportService;
    $ctrl.ScriptConvertService = ScriptConvertService;

    $ctrl.isPopup = true;

    $ctrl.getDownloadLink = getDownloadLink;
    $ctrl.preInitDocumentVersion = preInitDocumentVersion;

    $ctrl.getPopupHeaderSubtitle = getPopupHeaderSubtitle;
    $ctrl.preSetTemplateData = preSetTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl.viewTitlePage = viewTitlePage;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl = new DocumentVersionPopupCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitDocumentVersion() {
        $ctrl.TitleAlignments = getAlignments('header');
        $ctrl.FooterAlignments = getAlignments('footer');
        $ctrl.PageFormats = getPageFormat();

        $ctrl.Settings = {
            TitleAlignments: $ctrl.TitleAlignments,
            FooterAlignments: $ctrl.FooterAlignments,
            PageFormats: $ctrl.PageFormats
        };

        var username = $ctrl.CPS.user ? $ctrl.CPS.user.name : null;
        $ctrl.versionId = $ctrl.extraParam.versionId;

        $ctrl.item = {
            withWatermark: false,
            watermark: null,

            withFooter: false,
            footer: 'Generated' + (username ? (' by ' + username) : '') + ' on ' + moment().format('MMMM D, YYYY'),

            withTitle: false,
            title: $ctrl.extraParam.title,

            titleAlignment: $ctrl.TitleAlignments[0].id,
            footerAlignment: $ctrl.FooterAlignments[1].id,
            format: $ctrl.extraParam.format || $ctrl.PageFormats[0].id,

            createdBy: $ctrl.extraParam.createdBy,
            titlePage: $ctrl.extraParam.titlePage ? $ctrl.extraParam.titlePage :
                $ctrl.ScriptConvertService.getScriptTitlePageInit($ctrl.item, $ctrl.CPS)
        };

        if($ctrl.item.titlePage){
            $ctrl.item.withTitlePage = true;
        }
    }

    function getAlignments(prop) {
        return [
            {text: 'Left-aligned ' + prop, id: 'left'},
            {text: 'Right-aligned ' + prop, id: 'right'},
            {text: 'Center-aligned ' + prop, id: 'center'}
        ];
    }
    function getPageFormat() {
        return [
            {text: 'Letter', id: 'letter'},
            {text: 'A4' , id: 'a4'}
        ];
    }
    function getDownloadLink() {
        var item = $ctrl.item;
        if (!item) {
            return;
        }
        if (!$ctrl.isUpdating) {
            $ctrl.isUpdating = true;
            $ctrl.error = null;

            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.download.started', 'success');

            var options = {};
            if ($ctrl.item) {
                if ($ctrl.item.withWatermark && $ctrl.item.watermark && $ctrl.item.watermark.trim() !== '') {
                    options.watermark = $ctrl.item.watermark;
                }

                if ($ctrl.item.withFooter && $ctrl.item.footer && $ctrl.item.footer.trim() !== '') {
                    options.footer = $ctrl.item.footer;
                }

                if ($ctrl.item.withTitle && $ctrl.item.name && $ctrl.item.name.trim() !== '') {
                    options.withTitle = true;
                }
                options.title = $ctrl.item.name;
                options.titleAlignment = $ctrl.item.titleAlignment;
                options.footerAlignment = $ctrl.item.footerAlignment;
                options.format = $ctrl.item.format;

                if ($ctrl.item.withTitlePage && $ctrl.item.titlePage && $ctrl.item.titlePage.trim() !== '') {
                    options.titlePage = $ctrl.item.titlePage;
                }
            }

            var path = $ctrl.service.getDownloadLink({
                _id: $ctrl.versionId,
                productId: $ctrl.CPS.productId,
                companyId: $ctrl.CPS.companyId
            });

            if ($ctrl.item.withTitlePage && $ctrl.item.titlePage && $ctrl.item.titlePage.trim() !== '') {
                options.titlePage = $ctrl.item.titlePage;
            }
            options.pageSize = $ctrl.item.pageSize;

            var p = _.extend({
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                versionId: $ctrl.versionId,
                options: options
            }, $ctrl.extraParam.contentVersion ? $ctrl.extraParam.contentVersion : null);

            $ctrl.DownloadExportService.downloadBlobFile(path, p, onSuccess, onError);

            function onSuccess(res) {
                $ctrl.isUpdating = false;

                if (typeof ($ctrl.onClose) === 'function') {
                    $ctrl.onClose({result: 'cancel'});
                }
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.download.success', 'success');
            }

            function onError(err) {
                $ctrl.isUpdating = false;
                console.log("Could not get signed URL.");
                $ctrl.error = $ctrl.localizedMessages.getFromError(err, 'crud.documentVersion.download.error');
            }
        }

        /*var name = "downloadform" + $ctrl.versionId,
            body = $('body'),
            form = getForm();
        if (form.length === 0) {
            var formcontent = "<form style='width:0;height:0;z-index:-1' class='ng-hide' id='" + name + "' name='" + name + "' method='post' action='" + getDownloadLink(item) + "' target='_blank'></form>";
            body.append(formcontent);
        }
        form = getForm();
        if (form.length > 0) {
            document.forms[name].submit();
        }
        body.remove(form);
        return false;

        function getForm() {
            return body.find('#' + name);
        }
        */
    }

    function preSetTemplateData(){
        $ctrl.icon = 'download-pdf';
        $ctrl.iconLevel = 5;
        $ctrl.popupTitle = 'Download PDF';
        $ctrl.withFooterBtns = true;
        $ctrl.withBtnDisabled = true;
        $ctrl.btnText = 'Download PDF';
        $ctrl.firstBtnMethod = 'getDownloadLink';
        $ctrl.itemChangedFields = ['name', 'titleAlignment', 'footer', 'format', 'footerAlignment', 'watermark'];

        setColumns();
    }

    function getPopupHeaderSubtitle() {
        return '<div ng-if="::$ctrl.item.name" class="text-center subheader-popup" ng-bind="$ctrl.item.name"></div>';
    }
    
    function setColumns() {
        var eClassAttr = 'form-control with-underline ' + ($ctrl.pageClass || ''),
            drpInit = {
                formGroupClass: ' form-group field thinner wide-tooltip last ' ,
                type: $ctrl.SBFieldTypesService.PropTypes.Drp,
                eClassAttr: eClassAttr,
                cClassAttr: 'autoheight long-caret',
                //fieldClass: 'form-control with-underline ' + $ctrl.pageClass,
                itemLabel: 'text',
                itemValue: 'id',
                parentContainer: true
            },
            fieldInit = {
                type: $ctrl.SBFieldTypesService.PropTypes.Field,
                eClassAttr: eClassAttr,
                isRequired: true
            };

        $ctrl.columnsList = [
            _.extend({}, fieldInit, {
                prop: 'name',
                name: 'Name',
                placeholder:'Header title…'
            }),
            _.extend({}, drpInit, {
                prop: 'titleAlignment',
                initListName: 'TitleAlignments'
            }),
            _.extend({}, fieldInit, {
                prop: 'footer',
                name: 'Footer',
                placeholder:'Footer title…'
            }),
            _.extend({}, drpInit, {
                prop: 'footerAlignment',
                initListName: 'FooterAlignments'
            }),
            _.extend({}, fieldInit, {
                prop: 'watermark',
                name: 'Watermark',
                placeholder: 'Watermark…',
            }),

            _.extend({}, drpInit, {
                prop: 'format',
                initListName: 'PageFormats'
            }),
        ];
    }

    function getPopupBodyContent(){
        return '<div class="form-wrapper">' +
            $ctrl.getCondBlock('withTitle', 'Include header', [0, 1]) +
            $ctrl.getCondBlock('withFooter', 'Include footer', [2, 3]) +
            $ctrl.getCondBlock('withWatermark', 'Include watermark', [4], '$ctrl.item.withWatermark', !$ctrl.item.titlePage) +

            ($ctrl.item.titlePage ? $ctrl.getRowCheck('withTitlePage', 'Include title page') : '') +
           // '<div class="full-width margin-half" style="padding-left:40px"><a id="lnkChangeTitle">View Title Page</a</div>'+
          //  $ctrl.getDrpRow(5, 'margin-bottom-quarter') +
                '</div>';
    }

    function bind(isBind){
        $ctrl.bindElementsClickBySelector(isBind, '#lnkChangeTitle', $ctrl.viewTitlePage);
    }

    function onLoaded(){
        $ctrl.LCS.timeout(function () {
            bind(true);
        });
    }
    function onDestroy(){
        bind(false);
    }
    function viewTitlePage(e){
        $ctrl.popupsService.open($ctrl.item, $ctrl.popupsService.operations.titlePageDocumentVersion, {
            withScriptFormat: $ctrl.item.type === 2
        }, $ctrl.compOptions);
    }
}

