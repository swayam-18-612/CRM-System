                1: {name: 'General', cols: [2, 10, 5, 11, 12, 6], show: true},
                2: {name: 'Contacts', cols: [5, 4, 3], show: true},
                3: {name: 'Emergency Contacts', cols: [16]},
                4: {name: 'Agents', cols: [17]},
                5: {name: 'Dietary Information', cols: [1, 2, 3]},
                6: {name: 'Wardrobe Sizes', cols: [1, 2, 3]},
                7: {name: 'Skills', cols: [1, 2, 3]},
            };
        }
    }
}

