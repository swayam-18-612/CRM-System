angular.module('user.products', [
    'apiConstants.products.services',
    'user.productsPage.component'
])
.config(UserProductsRouting);
UserProductsRouting.$inject = ['$uiRouterProvider', 'ProductCompOptions'];
function UserProductsRouting($uiRouter, compOptions) {
    var listField = compOptions.listField,
        params = {};

    if(listField) {
        params[listField] = {
            value: null,
            dynamic: true
        };
    }
    addStates($uiRouter, [{
        name: 'user.projects',
        data: {
            bodyClass: 'products groups-tree-page with-tree with-printable-list',
            title: 'Projects',
            overviewBlockType: 'projects',
        },
        views: {
            loggedview: 'productsPage'
        },
        params: params,
        url: '/projects/'+(listField?(':' + listField):'') + '?' +
            'filter' +
            ((compOptions.withActiveGroup || compOptions.withActiveTree) ?  '&active' : ''),
        reloadOnSearch: false
    }]);
}



