          function resetScaleForView() {
              var printtableElStyle = $ctrl.printtableEl ? $ctrl.printtableEl.style : null;
              if (printtableElStyle) {
                  printtableElStyle.removeProperty('max-width');
                  printtableElStyle.removeProperty('max-height');
              }
          }
      }

      function setStyleAndWait(type, val, next, other) {
          processAndWait(m, val, 200, next);

          function m(val){
              if(typeof(other) === 'function'){
                  other();
              }

              setStyle(type, val);
          }
      }

      function setStyle(type, val){
          if(!$ctrl[type]){
              $ctrl[type] = 's_'+(new ObjectId().toString());
          }
          $ctrl.LCS.addStyleBlock($ctrl[type], $ctrl.element, val, true);
      }

      function processAndWait(method, val, delay, next) {
          delayedMethod(val, delay).then(next);
          function delayedMethod(val, delay) {
              // perform some asynchronous operation, resolve or reject the promise when appropriate.
              return $q(function (resolve) {
                  method(val);
                  $ctrl.LCS.timeout(function () {
                      resolve();
                  }, delay || 10);
              });
          }
      }

      function getMMinPx(v) {
          var vInMM,
              div = document.createElement('div');
          div.style.display = 'block';
          div.style.height = v + 'mm';
          document.body.appendChild(div);
          vInMM = div.clientHeight;
          div.parentNode.removeChild(div);
          return vInMM;
      }


      function pxToMm(v){
          return Math.ceil(v * 25.4 / 96); //PPI
      }

      function mmToPx(v){
          return Math.floor(v * 96 / 25.4);
      }

      function getPageCls(){
          return 'preview-callsheet printmode centering';
      }

      function getPageTemplate(){
return '<div class="h-full side-table">' +
        $ctrl.getSidebar() +
        '<div class="full-content with-fancy-scrollbar h-full show-scrollbar-on-hover">' +
              '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper not-absolute-tab-content">' +
                '<div class="printtable reports-table tab-content with-no-bg with-padding centering full-width">' +
                  '<div class="' + getPageClsFilled($ctrl.item) + '" style="'+getStyle()+'">' +
                        getCover(true) +
                        $ctrl.getHeader()+
                        '<div class="reports-table-wrapper">' +
                            $ctrl.getGroupContainer() +
                        '</div>' +
                        getCover(false) +
                  '</div>' +
                '</div>' +
              '</div>' +
          '</div>' +
          $ctrl.getSidebarRight() +
      '</div>';

        function getStyle(){
            var s = ''
            _.each(['fontColor', 'bgColor', 'bgCardColor', 'borderColor'], function (p){
                if($ctrl.item[p]){
                    s +=  getColorAttribute(p) + ':' + $ctrl.item[p] + ';';
                }
            });
            return s;
        }

        function getCover(isFront){
            var prop = isFront ? 'FrontCover' : 'BackCover',
                hide = $ctrl.item['has' + prop] ? '' : ' sb-hide',
                between = '<div class="betweenpages ' + prop + hide + '">&nbsp;</div>',
                s = '',
            item = $ctrl.item[prop];
           if(item){
               _.each(['fontColor', 'bgColor'], function (prop){
                   if(item[prop]){
                       s += (s ? ';' :  '') + getColorAttribute(prop, true) + ':' + item[prop];
                   }
               });
               return (isFront ? '' : between) +
                   '<div class="cover ql-container ql-snow section' + prop + hide + '"' +
                   (s ? (' style="' + s + '"') : '') +
                   '><div class="ql-editor oncover" contenteditable="false">'+ ($ctrl.item[prop] && $ctrl.item[prop].content ? $ctrl.item[prop].content : '')+ '</div></div>' +
                   (isFront ? between : '');
           }
        }
      }

      function getColorAttribute(field, isCover){
          if (field === 'fontColor') {
              //front and back covers
              return isCover ? '--gray-header' : '--color-print';
          } else if(field === 'bgColor'){
              return isCover ? 'background-color' : '--bg-color';
          } else if(field === 'bgCardColor'){
              return  '--bg-card-color';
          }  else if(field === 'borderColor'){
              return isCover ?'border-color' : '--grid-border-inner';
          }
      }

      function getSidebarRight(){
          return '<print-sidebar class="print-sidebar hide-print h-full side-nav static long printing ' +($ctrl.printPageParams.isDownloadPDF ? '' : ' sb-hide')+ '" ' +
              'options-str="$ctrl.optionsStr" ' +
              'list-tree-service="::$ctrl.listTreeService" ' +
              'comp-options="::$ctrl.compOptions" ' +
              'custom-grid-setting="::$ctrl.printPageParams.customGridSetting" ' +
              'on-sidebar-changes="$ctrl.onSidebarChanges(result)" ' +
              'on-download="$ctrl.download(e)" ' +
              'on-close="$ctrl.closePopup(result)" ' +
              'pre-change-column="$ctrl.preChangeColumn(next)"' +
              '></print-sidebar>';
      }

      function openPopup(quota, process, e) {
          $ctrl.CPS.loadQuotaPopup(quota, process ? process : function () {
          }, null, null, _.extend({}, {
              compOptions: $ctrl.compOptions,
              onSubscriptionUpdated: onSubscriptionUpdated
          }), {e:e});

          function onSubscriptionUpdated(result) {
              console.log('onSubscriptionUpdated');
              $ctrl.broadcastRoot('UPDATE_PRO_LABELS', result);
              setWatermarkText();
              setWatermark(null);
          }
      }

      function download(e){
          console.log('dowloadPDf');
          openPopup('pdfBuilder', process, e);

          function process() {
              var styleC = $ctrl.element.querySelector('#' + $ctrl.styleC),
                  styleG = $ctrl.element.querySelector('#' + $ctrl.styleG);
              startDownload({
                  style: document.querySelector('#sbstyle-root').outerHTML +
                         document.querySelector('#style-app').outerHTML +
                        (styleC ? styleC.outerHTML : '') +
                        (styleG ? styleG.outerHTML : ''),
                  bodyClass: document.querySelector('body').className.replace('h-full', '').replace('modal-open', '').replace('withInnerSidebar', '').replace('authenticated', ''),
                  content: document.querySelector('.print-page-popup > .print-mode .' + $ctrl.printTableCls).outerHTML
              }, getPrintOptions(true), e);
          }

          function startDownload(params, initPrintOptions){
              var p = $ctrl.CPS.currentProductPathParams(params);
              if(!p){
                  $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.printDownload.error', 'error');
                  return;
              }

              $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.printDownload.success', 'success');
              if($ctrl.CPS.scriptId) {
                  p.scriptId = $ctrl.CPS.scriptId;
              }
              p.options = getOptions(params.initPrintOptions ? params.initPrintOptions : initPrintOptions);

              var service = getPrintMethods(),
                  otherHeaders = {};
              otherHeaders['x-collection'] = service.collectionName;
              $ctrl.DownloadExportService.downloadBlobFile(
                  service.downloadPrintUrl(p), p, onsuccess, onerror, false, otherHeaders);

              function getOptions(options) {
                  var page = $ctrl.BlocksSetupService.getCurrentTodoPage();
                  var x = {title: page ? page.text : $ctrl.SBStateService.getCurrentStateData().title};
                  _.each(['format', 'orientation', 'scale', 'emulateMediaType'], function (v) {
                      x[v] = options[v];
                  });
                  //convert to px
                  return _.extend(x, {
                      mT: 0, mB: 0, mL: 0, mR: 0,
                      viewportSize: {
                          width: $ctrl.item.viewportSize.w + unit,
                          height: $ctrl.item.viewportSize.h + unit
                      },
                      hasNoHeaderAndFooter: true
                  });
              }

              function onsuccess(url, filename) {
                  $ctrl.isUpdating = false;

                  if ($ctrl.onClose) {
                      $ctrl.onClose({result: 'cancel'});
                  }
              }

              function onerror(err) {
                  $ctrl.isUpdating = false;
                  $ctrl.error = $ctrl.localizedMessages.getFromError(err, 'crud.printDownload.error');
              }
          }
          function getPrintOptions(withoutCols){
              var item = _.extend({}, $ctrl.item);
              if(withoutCols){
                  delete item.columns;
              }else {
                  item.columns = item.columns.map(function (c) {
                      return c.id ? c.id : c;
                  });
              }
              delete item.f;
              return item;
          }

          function getPrintMethods() {
              return $ctrl.listTreeService && $ctrl.selectedParams.lists ? $ctrl.listTreeService.listsService : $ctrl.service;
          }
      }

      function getAll(cls){
          return $ctrl.LCS.bodyElement.querySelectorAll('.print-mode .'+ cls);
      }

      function getPageClsFilled(item){
          return getPageCls() + ' ' +
              //general
              item.format + ' ' +
              item.orientation +
              ' padding-' + item.pageMargins +

              //grid
              ' font-general font-general-' + item.fontSize +
              ' column-margins-' + item.columnMargins +
              ' hide-toggleTags hide-toggleScenes ' + item.columnMargins +

              //top
              ' print-custom-font' + (item.isColor ? '' : ' print-black-white') +
              (item.withPageNumbers ? '' : ' print-no-page-numbers') +
              (item.showBorders ? (item.itemsBorder ? ' print-with-borders' : '') : '') +

              (item.withHeader ? '' : ' print-no-header') +
              (item.showIcons ? (item.withIcons ? '' : ' print-no-icons') : '') +
             // (item.showFontColor ? 'custom-font-color ' : '') +
             // (item.showBgColor ? 'custom-bg-color ' : '');

          ($ctrl.isRecompute ? ' print-recompute' : '');
      }

      function getPrintEl() {
          if (!$ctrl.printModeEl) {
              $ctrl.printModeEl = document.querySelector('.preview-callsheet.printmode');
          }
            return $ctrl.printModeEl;
      }

      function onSidebarChanges(result) {
          //console.log('onSidebarChanges');
          var resetCss,
              field = result.field,
              val = result.item[field];

          if($ctrl.item[field] === val){
              //console.log('onSidebarChanges NO change for '+field+' : prevVal=' + $ctrl.item[field] + '; newVal:' + val);
              return;
          }

          //console.log('onSidebarChanges YES change for '+field+' : prevVal=' + $ctrl.item[field] + '; newVal:' + val);

          //console.log('onSidebarChanges field: ' + field);
          $ctrl.item[field] = val;

          switch (field) {
              case 'title':
              case 'leftHeader':
              case 'rightHeader':
              case 'footer':
                  var heightChanged = field === 'footer' ? false : ($ctrl.headerClsHeight !== getHeaderClsHeight()),
                      valText = val ? $ctrl.LCS.convertHtmlToText(val) : null;
                  _.each($ctrl.element.querySelectorAll('.' + (field === 'footer' ?  $ctrl.footerCls : ($ctrl.headerCls + '.main-header')) + ' .' + field), function (el) {
                      if (valText && !$ctrl[field]) {
                          $ctrl[field] = el.innerHTML;
                      }
                      el.innerHTML = valText ? val : (field === 'footer' ? '' : $ctrl[field]);
                  });

                  //in this case font size shouldnt change . just reprocess the breaks
                  resetCss = heightChanged;
                  break;

              case 'fontColor':
              case 'bgColor':
              case 'borderColor':
              case 'bgCardColor':
              case 'isColor':
                  var isColor = field === 'isColor',
                      l = isColor ? ['fontColor', 'bgColor', 'bgCardColor', 'borderColor'] : [field];

                  $ctrl.item[field] = val;
                  processPrintEl(getPrintEl());

                  function processPrintEl(printModeEl) {
                      if (printModeEl) {
                          if (!isColor && !$ctrl.LCS.hasClass(printModeEl, 'print-black-white') || isColor && val) {
                              _.each(l, function (field) {
                                  processColor(printModeEl, field, $ctrl.item[field], false);
                              });
                          } else {
                              printModeEl.style = {};
                          }
                      }

                      if (isColor) {
                          $ctrl.LCS[val ? 'removeClass' : 'addClass'](printModeEl, 'print-black-white');
                          processCoversColors(val);
                      }
                  }

                  break;

              case 'hasFrontCover':
              case 'hasBackCover':
                  var prop = field.replace('has', '');
                  setCoverInfo(prop, val);

                  _.each(['.btn', '.section', '.betweenpages.'], function (cls) {
                      $ctrl.LCS[val ? 'removeClass' : 'addClass']($ctrl.element.querySelector(cls + prop), 'sb-hide');
                  });
                  break;

              case 'FrontCover':
              case 'BackCover':
                  //dont set for black and white
                  processCoversColors($ctrl.item.isColor, field);
                  $ctrl.element.querySelector('.section' + field + ' .ql-editor').innerHTML = val.content;

                  break;

              case 'view':
                  onGridViewChanges(val);
                  resetCss = true;
                  break;

              case 'toggleScenes':
              case 'toggleTags':
                  $ctrl.LCS[val ? 'removeClass' : 'addClass']($ctrl.printModeEl, 'hide-' + field);

                  resetCss = true;
                  break;

              case 'column':
                  setColumnsPerPage(val);
                  resetCss = true;
                  break;

              case 'orientation':
              case 'format':
              case 'fontSize':

                  resetCss = true;
                  break;

              default:
                  if (isMarginField(field)) {
                      $ctrl.item['withCustomMargin' + field.replace('margin', '')] = val !== undefined ? true : false;
                  }

                  resetCss = true;
                  break;
          }

          updateFilterCache();

          if(resetCss) {
              setCSSParams(result);
          }

          function updateFilterCache(){
              $ctrl.filtersService.changePropInit($ctrl, val, field, {val: val});
          }
          function processCoversColors(isColor){
              if(isColor) {
                  _.each(['FrontCover', 'BackCover'], function (field) {
                      processCover(isColor, field);
                  });
              }else{
                  //remove style for bg colors when is black and white
                  _.each($ctrl.printModeEl.querySelectorAll('.cover'), function (cover) {
                      cover.style = {};
                  });
              }
          }
          function processCover(isColor, field){
              if(isColor) {
                  _.each(['fontColor', 'bgColor'], function (prop) {
                      processColor(document.querySelector('.section' + field), prop, $ctrl.item[field] ? $ctrl.item[field][prop]: null, true);
                  });
              }
          }

          function processColor(el, field, val, isCover) {
              var prop = getColorAttribute(field, isCover),
                  isAdd = val && val.toLowerCase() !== $ctrl.item['default' + $ctrl.CPS.capitalizeFirst(field)].toLowerCase();

              if (!el.style) {
                  el.style = {};
              }
              if (isAdd) {
                  el.style.setProperty(prop, val, 'important');
              } else {
                  el.style.removeProperty(prop);
              }
          }
      }

      function setCoverInfo(prop, val){
          $ctrl.item['has' + prop] = val;
          var isFront = prop === 'FrontCover';
          if(!$ctrl.item[prop] ){
              $ctrl.item[prop] = {
                  content: getCoverContent(isFront),
                  _id: prop
              };
          }
      }

      function isGridReloading(isLoading){
          //console.log('isGridReloading ' + isLoading);
          if (!$ctrl.reportsTableEl) {
              $ctrl.reportsTableEl = $ctrl.element.querySelector('.printtable.reports-table');
          }
          if($ctrl.reportsTableEl) {
              if(isLoading) {
              } else {

              }
          }
      }

      function onGridViewChanges(view, column){
          setGridViewInfo(view, column);
          var isGridView = checkGridView(view);
          var els = $ctrl.element.querySelectorAll('.print-sidebar .whenGridView');
          if(els && els.length > 0) {
              _.each(els, function (el) {
                  $ctrl.LCS[isGridView ? 'removeClass' : 'addClass'](el, 'sb-hide');
              });
          }
          setColumnsPerPage(isGridView ? $ctrl.item.column : 0);
      }

      function setGridViewInfo(view, column){
          if(view && view !== $ctrl.item.view){
              $ctrl.item.view = parseInt(view, 10);
          }
          if (column !== undefined) {
              $ctrl.item.column = parseInt(column, 10) || 1;
          }
      }

      function setColumnsPerPage(val){
          setFonts(val);

          var cls = 'columns-1 columns-2 columns-3 columns-4 columns-5 columns-6 columns-7 columns-8';
          _.each($ctrl.element.querySelectorAll('.group-template .list.list-group-items'), function (el){
              if(!val) {
                  $ctrl.LCS.removeClass(el, cls);
              } else {
                  $ctrl.LCS.replaceClass(el, cls, 'columns-' + val);
              }
          });
      }

      function setFonts(val){
          if(val > 4 || val === 1) {
              if($ctrl.item.fontSize > 10) {
                  $ctrl.item.fontSize1 = $ctrl.item.fontSize;
                  $ctrl.item.fontSize = $ctrl.item.fontSize1 ? $ctrl.item.fontSize1 : 10;
              }
          } else{
              if($ctrl.item.fontSize > 12) {
                  $ctrl.item.fontSize4 = $ctrl.item.fontSize;
                  $ctrl.item.fontSize = $ctrl.item.fontSize4 ? $ctrl.item.fontSize4 : 12;
              }
          }
      }


      function setWatermark(val, delay) {
          if (timer) {
              $ctrl.LCS.cancelTimeout(timer);
          }

          if(delay) {
              timer = $ctrl.LCS.timeout(process, delay);
          } else{
              process();
          }
          function process() {
              var fontSize;
              _.each($ctrl.element.querySelectorAll('.watermark'), function (el) {
                  var w;
                  $ctrl.LCS[val ? 'removeClass' : 'addClass'](el, 'sb-hide');
                  var c = el.querySelector('.content');
                  if (c) {
                      c.innerText = val || '';
                      w = 0.8 * el.offsetWidth;
                      setFontSize(c.offsetWidth);
                  }

                  function setFontSize(cw) {
                      if(!fontSize){
                          var isPlus = cw < w;
                          while (isPlus ? (c.offsetWidth < w) : (c.offsetWidth > w)) {
                              if(!inc(isPlus)){
                                  break;
                              }
                          }
                      }

                      set(fontSize);

                      function inc(isPlus){
                          fontSize = c.style.fontSize || '80px';
                          var newFontSize = parseInt(fontSize.replace('px', ''), 10) + 20 * (isPlus ? 1 : -1);
                          if(newFontSize > 0 && newFontSize < 500) {
                              set(newFontSize + 'px');
                              return true;
                          }
                          return false;
                      }

                      function set(v){
                          c.style.fontSize = v;
                      }
                  }
              });

              /*_.each($ctrl.element.querySelectorAll('.'+$ctrl.footerCls+' .watermarkFooter '), function (el) {
                  el.innerText = val || '';
              });*/
          }
      }

      function setRecompute(isProcessing){
          if(isProcessing !== $ctrl.isRecompute) {
              $ctrl.isRecompute = isProcessing ;
              $ctrl.LCS[isProcessing ? 'addClass' : 'removeClass'](getPrintEl(), 'print-recompute');
          }
      }

      function geth(h){
          return h + 'px';
         return  (pxToMm(h) + unit);
      }

      function getHeaderClsHeight() {
          var el = $ctrl.element.querySelector('.' + $ctrl.headerCls);
          return el ? el.offsetHeight : 0;
      }

      function setCSSParams(result) {
          //console.log('setCSSParams');
          isGridReloading(true);
          setRecompute(true);

          var field = result.field,
              force = result.force;

          setItemValue(result.item);

          var change = getChange(field);
          setCLSDelayed({force: force, field: field, change: change}, next);

          function next() {
              //console.log('setCSSParams next');
              if (field === 'orientation') {
                  if ($ctrl.withPrintPanels) {
//
                  }
              }

              if (force || change.general) {
                  setStyleGAndWait(p);
              }else{
                  p();
              }

              function p() {
                  if (isGenOrGrid(force, change)) {
                      setRowWidth(force || field, setGridWidth);
                  } else {
                      setGridWidth();
                  }
              }

              function setGridWidth(){
                  setW('.printmode .flex-wrap');
                  setW('.printmode .row-header.list-header');

                  setWatermark($ctrl.item.watermark, 1000);

                  setRecompute(false);

                  function setW(cls) {
                      var maxWPX = $ctrl.item.viewportSize.maxWPX,
                          gridWPX = $ctrl.processResult ? $ctrl.processResult.gridWPX : $ctrl.item.viewportSize.maxWPX,
                          els = $ctrl.element.querySelectorAll(cls);
                      if(els && els.length > 0) {
                          _.each(els, function (el) {
                              el.style.width = pxToMm(gridWPX < maxWPX ? maxWPX : gridWPX) + unit + '!important';
                          });
                      }
                  }
              }

              function setRowWidth(force, next) {
                  //console.log(getAll(getPageCls().split(' ').join('.'))[0].className);
                  var iteration = 0,
                      skip = 1,
                      p = {
                          force: force,
                          iteration: iteration
                      };

                  processFontSize(p, onProcessedFontSize);

                  function onProcessedFontSize(isLastIt){
                      recurring(isLastIt);

                      function recurring(isLastIt) {
                          if (isLastIt) {
                              next();
                              return;
                          }

                          var fontSize = $ctrl.item.fontSize - skip, exists = false;
                          while (!exists && fontSize >= fontSizeMin) {
                              if (!_.find(PrintFontSizes, function (item) {
                                  return item.id === fontSize;
                              })) {
                                  fontSize = fontSize - 1;
                              } else {
                                  exists = true;
                              }
                          }
                          if (fontSize < fontSizeMin) {
                              if ($ctrl.lastIterationFontSize === fontSizeMin) {
                                  next();
                                  return;
                              } else {
                                  fontSize = fontSizeMin;
                              }
                          }

                          $ctrl.item.fontSize = fontSize;
                          $ctrl.optionsStr = JSON.stringify($ctrl.item);
                          processFontSize(_.extend({}, p, {iteration: iteration + 1}), recurring);
                      }
                  }

                  function processFontSize(result, next) {
                      $ctrl.lastIterationFontSize = $ctrl.item.fontSize;
                      //console.log('processFontSize iteration: ' + val.iteration + ';fontSize: ' + $ctrl.item.fontSize);

                      //if(exists){remove column Style and set font size then wait then process rows} / else just process rows

                      setCLS(force, 'fontSize', null);
                      removeStyleCAndWait(processRows);

                      function processRows() {
                         //console.log('processRows');
                         var isGridView = checkGridView($ctrl.item.view),
                             maxRowHeightPx = 0,
                             rows = $ctrl.element.querySelectorAll('.row-schedule' + (isGridView ? ':not(.header)':''));
                          if (!rows.length) {
                              return false;
                          }

                          //if grid has just been loaded the header has been processed already
                          _.each(rows, processRow);

                         if(!isGridView) {
                             $ctrl.processResult = getColsWidth();
                             setStyleCAndWait($ctrl.processResult.el, onColumnsSet);
                         } else{
                             onColumnsSet();
                         }

                          function getColsWidth(){
                              //there is dif on conversion from px to mm . convert before getting the dif
                              var el = '', gridWPX = 0, cols = [];
                              if($ctrl.colsW) {
                                  var distributeCount = 0, hasCG;

                                  for (var id in $ctrl.colsW) {
                                      var c = $ctrl.colsW[id],
                                          m = c.s ? c.w : c.m;
                                          cPX = {
                                              w: c.w,
                                              pH: c.pH,
                                              m: m > c.w ? c.w : m,
                                              o: c.o,
                                              p: getColCls(id)
                                          };
                                      //w = c.w,//c.g && !c.l ? (c.w + 100) : c.w, //c.l last column
                                      if (c.g) {
                                          hasCG = true;
                                          cPX.g = true;
                                      }

                                      if (c.l) {
                                          cPX.l = true;
                                      }

                                      if (c.s || c.className.indexOf('cant-increase') !== -1) {
                                          cPX.s = true;
                                      }

                                      if (c.isHtml) {
                                          cPX.isHtml = true;
                                      }

                                      if (!cPX.s) {
                                          //if the grid is wider distribute more for this
                                          if (cPX.m > c.w) {
                                              cPX.difPlus = cPX.m - cPX.w;
                                          }
                                          distributeCount++;
                                      }

                                      cols.push(cPX);


                                      gridWPX += cPX.m + cPX.pH + 1;
                                  }

                                  cols = _.sortBy(cols, 'o');

                                  if($ctrl.colsWPrefront) {
                                      gridWPX += $ctrl.colsWPrefront || 0;
                                  }

                                  var distribute = true,
                                      count = cols.length,
                                      row = '.preview-callsheet.printmode ' + '.list .row-schedule > div.',
                                      difTotal = $ctrl.item.viewportSize.maxWPX - gridWPX,
                                      dif, needsCuts;

                                  if (difTotal > 0) {
                                      _.each(cols, function (cPX, i){
                                          if(cPX.difPlus > 0){
                                              var d = difTotal - cPX.difPlus;
                                              if(d <= 0){ //difPlus is higher so max is difTotal
                                                  cols[i].m += difTotal;
                                                  distributeCount = 0;
                                                  difTotal = 0;
                                              } else{ //difTotal is higher
                                                  cols[i].m += cPX.difPlus;
                                                  difTotal = d;
                                                  distributeCount --;
                                              }
                                              cols[i].s = true;
                                          }
                                      });
                                      dif = difTotal > 0 ? (difTotal / (distribute ? distributeCount : 1)) : 0;
                                  } else if(difTotal < 0){
                                      needsCuts = Math.round(difTotal*(-1));
                                      var cut = 0,
                                          fl = _.filter(cols, {isHtml : true}).length,
                                          v = fl > 0 ? needsCuts / fl : 0;
                                      if(v) {
                                          for (var i = 0; i < cols.length; i++) {
                                              var cPX = cols[i];
                                              if (cPX.isHtml) {
                                                  var v1 = cPX.m * .1, //cut 20%
                                                      islast = cut + v1 > needsCuts;
                                                  if (islast) {
                                                      v1 = needsCuts - cut;
                                                  }

                                                  cut += v1;
                                                  cPX.m -= v1;

                                                  if (islast) {
                                                      break;
                                                  }
                                              }
                                          }
                                          needsCuts = needsCuts - cut;
                                      }
                                      if(needsCuts && distribute && distributeCount > 0){
                                          dif = (-1) * (needsCuts/distributeCount);
                                      }
                                  }

                                  for (var i = 0; i < count; i++) {
                                      var cPX = cols[i];
                                      if (dif && distribute && !cPX.s) {
                                          cPX.m += dif;
                                      }

                                      el += row +
                                           (cPX.g ? 'grow-column.' : '') +
                                          cPX.p + ':not(.prefront){'+
                                        //  (cPX.g ? 'max-width' : 'width') +
                                          'width:' +
                                          //(pxToMm(cPX.m + cPX.pH) + unit + '!important') +
                                          ( (cPX.m + cPX.pH + 1) + 'px!important') +
                                          (cPX.l && !hasCG ? ';-webkit-box-flex: 1;-webkit-flex-grow: 1;-ms-flex-positive: 1;flex-grow: 1' : '')+
                                          '}';
                                  }
                                 // console.log(el);
                              }

                              return {
                                  gridWPX: gridWPX,
                                  el: el,
                                  colsW: $ctrl.colsW
                              };
                          }

                          function processRow(row) {
                              if ( //don't consider daybreaks and banners
                                  !$ctrl.LCS.hasClass(row, 'daybreak')
                              ) {
                                  var isHeader = $ctrl.LCS.hasClass(row, 'header');
                                  setColW(isHeader, row.children, isHeader); //reset width when resizing font size
                              }

                              if(isGridView && row.offsetHeight > maxRowHeightPx){
                                  maxRowHeightPx = row.offsetHeight;
                              }
                          }

                          function addContentEl(addedCount, el, c, isLastPage, cls1, addInsideEl, groupHeader) {
                              //default addAfterEl . otherwise if addInsideEl
                              var cls = (cls1 || '') + ' ' + pageBreakAfterCls +
                                       ($ctrl.pagesInfo.hasColumns ? ' grid-columns ' : ' clearfix ') +
                                      (isLastPage ? ' is-last-page ' : '') + ' extra-row',
                                  content = $ctrl.LCS.createFragment('<div class="full-width ' + cls + '">' + c + '</div>');

                              if(groupHeader) {
                                  addedCount += 1;
                                  content.appendChild(groupHeader);
                              }
                              if(addInsideEl){
                                  el.appendChild(content);
                              } else {
                                  $ctrl.LCS.insertElementAfter(el, content);
                              }

                              addedCount += 1; //$ctrl.pagesInfo.hasColumns && !isLastPage ? 2 : 1; //account for nextpagetop
                              $ctrl.pagesInfo.typeLastAdded = 'break';
                              return addedCount;
                          }

                          function removePageBreaks(){
                              if ($ctrl.groups) {
                                  for(var id in $ctrl.groups){
                                      removeGroupPageBreaks($ctrl.groups[id]);
                                  }
                              }
                          }

                          function removeGroupPageBreaks(group){
                              for(var i = group.pageBreaks.length-1; i >= 0; i--){
                                  var p = group.pageBreaks[i];
                                  $ctrl.LCS.removeElement(p);
                              }
                          }

                          function observeGroup (group){
                              group.observer.observe(group.g.parentElement, observerOptions);
                          }

                          function disconnectGroup(group){
                              if (group && group.observer && group.allAdded && group.addedCount === 0) {
                                  console.log('Mutation Observer Removed.');
                                  group.observer.disconnect();
                              }
                          }

                          function onColumnsSet() {
                              var isLastIt = dontProcessAgain();

                              if(!isLastIt && checkGridView($ctrl.item.view)) {
                                  var el = $ctrl.element.querySelector('.list-header');//first
                                  $ctrl.headerClsHeight = getHeaderClsHeight();
                                  var h = $ctrl.item.remainingHPX - $ctrl.headerClsHeight - (el ? el.offsetHeight : 0);

                                  console.log('onColumnsSet GridView: fontSize:' + $ctrl.item.fontSize + '; h = ' + h + '; maxRowHeightPx = ' + maxRowHeightPx);
                                  if (h < maxRowHeightPx) {
                                      onPagesSet();
                                  } else {
                                      isLastIt = true;
                                      p();
                                  }
                              } else{
                                 // console.log('onColumnsSet List View: ' + $ctrl.item.fontSize);
                                  p();
                              }

                              function p(){
                                  if (!$ctrl.groups) {
                                      $ctrl.groups = {};
                                      var els = $ctrl.element.querySelectorAll('.group-template');
                                      $ctrl.groupsCount = els ? els.length : 0;
                                      $ctrl.unProcessedGroups = {};
                                      _.each(els, setGroup);
                                  }

                                  //(isLastIt){scaleGroups;}

                                  removePageBreaks();

                                  processPages(onPagesSet);
                              }

                              function setGroup(g, i) {
                                  var id = $ctrl.LCS.findClosestParent(g, $ctrl.treeNodeClass).getAttribute('data-id');
                                  //set observer for each group. same with page breaks
                                  $ctrl.groups[id] = {
                                      isLastGroup: i === $ctrl.groupsCount - 1,
                                      isFirstGroup: i === 0,
                                      pageBreaks: [],
                                      id: id,
                                      g: g,
                                      addedCount: 0,
                                      allAdded: false,
                                      observer: new MutationObserver(onObserver)
                                  };

                                  $ctrl.unProcessedGroups[id] = true;
                                  observeGroup($ctrl.groups[id]);

                                  //since there are page breaks added after a group set observer on the parent of the group

                                  function onObserver(mutations) {
                                      //console.log('onObserver');
                                      var group = $ctrl.groups[id],
                                          isGridView = checkGridView($ctrl.item.view),
                                          hasC = hasColumns();
                                      for (var m of mutations) {
                                          //console.log('G '+ group.id + ' Mutation Detected: ' + m.type);
                                          if (m.type === 'childList') {
                                              if (m.addedNodes) {
                                                  _.each(m.addedNodes, function (el) {
                                                      // console.log('G '+group.id + ' Mutation Detected: A child element has been added');
                                                      if ($ctrl.LCS.hasClass(el, 'extra-row')) {
                                                          group.loadedCount--;
                                                          group.pageBreaks.push(el);
                                                      }

                                                      var isLastPage = $ctrl.LCS.hasClass(el, 'is-last-page');
                                                      if ($ctrl.LCS.hasClass(el, pageBreakAfterCls) && !isLastPage) {
                                                          if(isGridView) {
                                                           //   setPageBreakHeight();
                                                          }
                                                          //if(hasC){setNextPageTop();} //should not be necessary no more
                                                      }

                                                      function setPageBreakHeight() {
                                                          var h = 0;
                                                          if (el.children) {
                                                              _.each(el.children, function (c) {
                                                                  h += c.offsetHeight;
                                                              });
                                                          }
                                                          if (h) {
                                                              var hpx = geth(h - betweenpagesPX )+'!important'
                                                              $ctrl.LCS.setCSSStyle(el, 'height', hpx);
                                                              $ctrl.LCS.setCSSStyle(el, 'max-height', hpx);
                                                              el.setProperty('data-h', h);
                                                          }
                                                      }

                                                      function setNextPageTop(){
                                                          var cls = 'nextpagetop';
                                                          if (!$ctrl.LCS.hasClass(el, cls)) {
                                                              addContentEl(null, el, '&nbsp;', false, cls + ' with-page-break', false, null);
                                                          }
                                                      }
                                                  });
                                              }

                                              if (m.removedNodes) {
                                                  _.each(m.removedNodes, function (el) {
                                                      group.addedCount --;
                                                      if(group.pageBreaks){
                                                          var i = _.findIndex(group.pageBreaks, function (el1) {
                                                              return el === el1;
                                                          });
                                                          if (i !== -1 && i <= group.pageBreaks.length)
                                                              group.pageBreaks.splice(i, 1);
                                                      }
                                                  });
                                              }

                                              //disconnectObserver(group);

                                              //onProcessed();
                                          }
                                      }
                                  }
                              }

                              function onPagesSet(){
                                  if(isLastIt){
                                      scaleForView();
                                  }
                                  //console.log($ctrl.colsW);
                                  if (next) {
                                      next(isLastIt);
                                  }
                              }

                              function processPages(next) {
                                  //console.log('processPages');
                                  var isGridView = checkGridView($ctrl.item.view),
                                      hasColumns = isGridView && $ctrl.item.column > 1;
                                  $ctrl.pagesInfo = {
                                      pages: {},
                                      page: 1,
                                      pageHasGroupHeader: false,
                                      gridGap: hasColumns ? $ctrl.item.gridGap : 0,
                                      columns: $ctrl.item.column,
                                      hasColumns: hasColumns,
                                      skipCols: hasColumns ? ($ctrl.item.column - 1) : 0, //by default skip 0 ; if is 2 skip = 1, if is 3 skip =2
                                      typeLastAdded: null
                                  }

                                  var isMainHeader = true;
                                  _.each($ctrl.element.querySelectorAll('.' + $ctrl.headerCls), function (el) {
                                      addElToPage(null, $ctrl.pagesInfo.page, el, {isMainHeader: isMainHeader});
                                      //isMainHeader = false;
                                  });

                                  processGroups(processGroup);

                                  function processGroup(group) {
                                      var groupHeader = null,
                                          groupHeaderH = null,
                                          start = 0,
                                          addedCount = 0;

                                      group.allAdded = false;

                                      _.each(group.g.querySelectorAll('.list-header'), function (h) {
                                          var listHeader = $ctrl.LCS.hasClass(h, 'topHeader');
                                          if (!listHeader) {
                                              //header with columns names
                                              groupHeader = h;
                                              groupHeaderH = getElHeightPX(h);
                                          }

                                          addElToPage(null, $ctrl.pagesInfo.page, h, getExtraParams(listHeader ? {listHeader: true} : {groupHeader: true}));
                                      });


                                      var rows = [],
                                          wrapper = group.g.querySelector('.flex-wrap');
                                      //.row-scheduleTemp
                                      _.each(wrapper.children, function (row) {
                                          rows.push(row);
                                      });

                                      /*addedCount = addDifItems(_.filter(rows, function (r) {
                                          return !$ctrl.LCS.hasClass(r, pageBreakAfterCls);
                                      }), addedCount);*/

                                      start = setItems(start);

                                      addedCount = addPageBreakAtTheEndOfGroup(addedCount);

                                      group.allAdded = true;
                                      group.addedCount = addedCount;
                                      group.loadedCount = addedCount;

                                      updateTotalPages();

                                      function getExtraParams(p) {
                                          return _.extend(p, {
                                              groupHeaderH: groupHeaderH
                                          });
                                      }

                                      function addDifItems(rowsF, addedCount) {
                                          if(!$ctrl.pagesInfo.hasColumns){return addedCount;}
                                          var l = rowsF.length,
                                              columns = $ctrl.pagesInfo.columns,
                                              dif = $ctrl.pagesInfo.hasColumns ? (l < columns ? l : (columns - l % columns)) : 0;
                                          if (dif === columns) {
                                              dif = 0;
                                          }
                                          if (dif > 0) {
                                              var rl = rowsF[l - 1],
                                                  cls = rl.className + ' extra-row ',
                                                  r = rl.querySelector('.row-schedule'),
                                                  cls1 = r ? r.className : '',
                                                  h = getElHeightPX(rl, false);
                                              while (dif > 0) {
                                                  var id = 'dif' + dif;
                                                  $ctrl.LCS.insertElementAfter(rows[rows.length - 1], $ctrl.LCS.createFragment('<div class="' + id + ' ' + cls + '" style="height:' + geth(h) + '!important">' +
                                                      '<div class="' + cls1 + '">&nbsp;</div>' +
                                                      '</div>'));
                                                  var difr = wrapper.querySelector('.' + id);
                                                  rows.push(difr);
                                                  addedCount++;
                                                  dif--;
                                              }
                                          }
                                          return addedCount;
                                      }

                                      function setItems(start) {
                                          var isRow = true,
                                              isLastPage = false;
                                          for (var j = 0, l = rows.length; j < l; j++) {
                                              var row = rows[j];
                                              if (row) {
                                                  //console.log('el ' + (j + 1) + ':  offsetHeight: ' + row.offsetHeight + '; remainingH: ' + pages['p_' + page].remainingH)
                                                  if ($ctrl.pagesInfo.pages['p_' + $ctrl.pagesInfo.page].remainingH <= getElHeightPX(row, isRow)) {
                                                      addedCount = addPageBreak(addedCount, j === 0 ? group.g : rows[j - 1], {
                                                          isLastPage: isLastPage,
                                                          elIsGroup: j === 0,
                                                          addGridHeader: true
                                                      });
                                                  }
                                                  start = addElToPage(start, $ctrl.pagesInfo.page, rows[j], getExtraParams({
                                                      considerSkip: isRow && $ctrl.pagesInfo.hasColumns &&  j !== l - 1,
                                                      isRow: isRow
                                                  }));
                                              }
                                          }

                                          return start;
                                      }

                                      function addPageBreakAtTheEndOfGroup(addedCount) {
                                          //after each group that is not last add page break
                                          //if the group is not last then isLastPage is false
                                          if (!group.isLastGroup) {
                                              if ($ctrl.pagesInfo.typeLastAdded !== 'break' && $ctrl.item.withPageBreakAfterList) {
                                                  addedCount = addPageBreak(addedCount, group.g, {
                                                      isLastPage: false,
                                                      elIsGroup: true,
                                                      isGroupBreak: true
                                                  });
                                              }
                                          } else {
                                              //if there is remaining break on the last page for remainingH
                                              addedCount = addPageBreak(addedCount, rows[rows.length - 1], {
                                                  isLastPage:true,
                                                  elIsGroup: false
                                              });
                                          }

                                          return addedCount;
                                      }

                                      function addPageBreak(addedCount, el, o) {
                                          var height = $ctrl.pagesInfo.pages['p_' + $ctrl.pagesInfo.page].remainingH,
                                              isGridView = checkGridView($ctrl.item.view);

                                          addedCount = addContentEl(addedCount, el, getPageBreak(), o.isLastPage, null, o.elIsGroup ? true : false, getColumnsHeader());

                                          if (!o.isLastPage) {
                                              $ctrl.pagesInfo.page = $ctrl.pagesInfo.page + 1;
                                          }

                                          return addedCount;

                                          function getColumnsHeader() {
                                              var showGroupHeadersOnTopOfPage = !isGridView && groupHeader && $ctrl.item.showGroupHeadersOnTopOfPage && $ctrl.item.groupHeadersOnTopOfPage && !o.isLastPage && o.addGridHeader;
                                              if(showGroupHeadersOnTopOfPage) {
                                                  $ctrl.pagesInfo.pages['p_' + $ctrl.pagesInfo.page].pageHasGroupHeader = true;
                                                  var n = groupHeader.cloneNode(true);
                                                  $ctrl.LCS.addClass(n, 'full-width extra-row');
                                                  $ctrl.LCS.addClass(n.children[0], 'with-border-bottom ');
                                                  return n;
                                              }
                                              return null;
                                          }

                                          function getPageBreak() {
                                              return (height > 0 ? '<div class="remaining" style="height:' + geth(height)+'">&nbsp;</div>' : '') +
                                                  getWatermark() +
                                                  getPreloader() +
                                                  getBottomPage() +

                                                  (o.isLastPage ? '' : (
                                                      '<div class="betweenpages">&nbsp;</div>') +
                                                    //  ((!isGridView || isGridView && o.elIsGroup) ?
                                                      '<div class="with-page-break">&nbsp;</div>' +
                                                      '<div class="nextpagetop">&nbsp;</div>'
                                                      //: '')
                                                  );

                                              function getWatermark() {
                                                  return '<div class="watermark position-relative sb-hide"><div><div><div class="content"></div></div></div></div>';
                                              }

                                              function getPreloader() {
                                                  return '<div class="preloader position-relative">' +
                                                      '<div class="reloadFacebookWrapper position-relative"><div class="centered"><div><div class="loadFacebookWrapper"><div class="sbLdsEllipsis"><div class="lds-ellipsis"><div></div><div></div><div></div><div></div></div></div></div></div></div></div>' +
                                                      '</div>';
                                              }

                                              function getBottomPage() {
                                                  return '<div class="'+$ctrl.footerCls+'"><div class="centered footer page pull-left">'+($ctrl.item.footer || '')+'</div><div class="text-right centered pull-right pageNumber"><span class="pageX">' + $ctrl.pagesInfo.page + '</span> of <span class="pageX ' + $ctrl.pagesCls + '"></span></div></div>';
                                              }
                                          }
                                      }

                                      function updateTotalPages() {
                                          for(var id in $ctrl.unProcessedGroups){
                                              if(!$ctrl.unProcessedGroups[id]){
                                                  return;
                                              }
                                          }
                                          _.each($ctrl.element.querySelectorAll('.' + $ctrl.pagesCls), function (p) {
                                              p.innerText = $ctrl.pagesInfo.page;
                                          });

                                          if (typeof (next) === 'function') {
                                              next();
                                          }
                                      }
                                  }
                              }

                              function addElToPage(start, page, el, other) {
                                  if (!el) {
                                      return;
                                  }

                                  var considerSkip = other && other.considerSkip,
                                      pg = 'p_' + page;
                                  if (!$ctrl.pagesInfo.pages[pg]) {
                                      $ctrl.pagesInfo.pages[pg] = {
                                          pageHasGroupHeader: false,
                                          page: page,
                                          //remainingHInit: $ctrl.item.remainingHPX - (other && !other.groupHeader && other.groupHeaderH && $ctrl.item.showGroupHeadersOnTopOfPage && $ctrl.item.groupHeadersOnTopOfPage ? other.groupHeaderH : 0),
                                          remainingH: $ctrl.item.remainingHPX - (other && !other.groupHeader && other.groupHeaderH && $ctrl.item.showGroupHeadersOnTopOfPage && $ctrl.item.groupHeadersOnTopOfPage ? other.groupHeaderH : 0),
                                          //  doesnt include margin-top margin-bottom
                                          els: [],
                                          elsH: 0,
                                          other: [],
                                          otherH: 0,
                                          height: 0 //elsH + otherH
                                      };
                                  }
                                  //if is group header set it for the page
                                  if (other && other.groupHeader) {
                                      $ctrl.pagesInfo.pages[pg].pageHasGroupHeader = true;
                                  }
                                  var isRow = other && other.isRow;
                                  var h = getElHeightPX(el, isRow);
                                  $ctrl.pagesInfo.pages[pg][isRow ? 'els' : 'other'].push({el: el, h: h, isRow: isRow, groupHeaderH: other.groupHeaderH});

                                  if (!considerSkip || considerSkip && ((start === $ctrl.pagesInfo.skipCols))) {
                                      //consider the grid padding between rows (except last row)
                                      $ctrl.pagesInfo.pages[pg].remainingH -= h;
                                      $ctrl.pagesInfo.pages[pg].height += h;

                                      if(isRow){
                                          $ctrl.pagesInfo.pages[pg].elsH += h;
                                      } else{
                                          $ctrl.pagesInfo.pages[pg].otherH += h;
                                      }
                                  }

                                  if (considerSkip) {
                                      start = start < $ctrl.pagesInfo.skipCols ? (start + 1) : 0;
                                  }

                                  $ctrl.pagesInfo.typeLastAdded = 'el';

                                  return start;
                              }


                              function getElHeightPX(el, considerMarginBottom) {
                                  return Math.ceil(el.offsetHeight);// + (considerMarginBottom && isGridView ? $ctrl.pagesInfo.gridGap : 0);
                              }

                              function scaleGroups() {
                                  document.querySelector('.' + $ctrl.printTableCls);
                                  _.each($ctrl.groups, function (group) {
                                      $ctrl.printtable = document.querySelector('.' + $ctrl.printTableCls);
                                      scaleContent($ctrl.printtable, group);
                                  });
                              }

                              function scaleForView() {
                                  if(!fitWindow){return;}

                                  if(!$ctrl.printtableEl){
                                      $ctrl.printtableEl = document.querySelector('.'+$ctrl.printTableCls);
                                  }
                                  scaleContent($ctrl.printtableEl, getPrintEl());
                              }
                          }

                          function setStyleCAndWait(val, next) {
                              setStyleAndWait('styleC', val, next);
                          }

                          function scaleContent(wrapper, el) {
//transform:translate(-50%, -50%);transform-origin:left top
                              var wS = window.getComputedStyle(wrapper, null),
                                  w = (wrapper.offsetWidth - getComputedHPadding(wS)) / el.offsetWidth,
                                  h = (wrapper.offsetHeight - getComputedVPadding(wS)) / el.offsetHeight,
                                  scale = Math.min(w, h);

                              el.style.setProperty('transform', 'scale(' + scale + ')');

                              wrapper.style.setProperty('max-width', el.offsetHeight + 'px');
                              wrapper.style.setProperty('max-height', el.offsetHeight + 'px');

                              //console.log('wrapper: w: ' + el.offsetWidth + 'px; h: ' + el.offsetHeight + 'px');
                          }
                      }
                  }

                  function dontProcessAgain(){
                       var shouldresize = $ctrl.processResult && ($ctrl.processResult.gridWPX > $ctrl.item.viewportSize.maxWPX);
                       if(!shouldresize || $ctrl.item.fontSize <= fontSizeMin || $ctrl.item.fontSize - skip < fontSizeMin){return true;}
                       return force === 'fontSize';
                  }
              }
          }
      }

      function setCLSDelayed(val, next) {
          processAndWait(function (val){
              setCLS(val.force, val.field, val.change);
          }, val, delayTimeout, next);
      }

      function isGenOrGrid(force, change){
          return force || change.general || change.grid;
      }

      function setCLS(force, field, change) {
          if(!change) {
              getChange(field);
          }

          if (isGenOrGrid(force, change) || isTop(change)) {
              var els = getAll(getPageCls().split(' ').join('.'));
              if (els && els.length > 0) {
                  var cls = getPageClsFilled($ctrl.item);
                  _.each(els, function (el) {
                      el.className = cls;
                     // console.log(cls);
                  });
              }
          }
          function isTop(change){
              return change.top;
          }
      }

      function isMarginField(f){
          return f === 'marginTop' || f === 'marginBottom' || f === 'marginRight' || f === 'marginLeft';
      }
      function getChange(field){
          return {
              general: field === 'format' || field === 'orientation' || field === 'pageMargins' ||
                field === 'view' || field === 'column' || field === 'rowsPerPage' || field === 'gridGap' ||
                  isMarginField(field),
              grid: field === 'columnMargins' || field === 'fontSize' || field === 'groupHeadersOnTopOfPage',
              top: field === 'isColor' ||  field === 'bgColor' || field === 'bgCardColor' || field === 'fontColor' || field === 'borderColor' ||
                  field === 'withPageNumbers' || field === 'itemsBorder' || field === 'withIcons' || field === 'withPageBreakAfterList' || field === 'withHeader'
          }
      }

      function onColumnsChanged() {
          //console.log('onColumnsChanged');
          resetGrids();
          $ctrl.columnsChanged = true;
          //must set
      }

      function preChangeColumn(next){
          removeStyleCAndWait(next, null);
      }

      function removeStyleCAndWait(next, other) {
          if (typeof (other) === 'function') {
              other();
          }
          processAndWait(function () {
              var styleEl = getStyleCEl();
              if (styleEl) {
                  $ctrl.LCS.removeElement(styleEl);
              }
          }, null, 200, next);


          function getStyleCEl() {
              var l = $ctrl.element.children ? $ctrl.element.children.length : 0;
              if (l) {
                  for (var i = 0; i < l; i++) {
                      var el = $ctrl.element.children[i];
                      if (el.id === $ctrl.styleC) {
                          return el;
                      }
                  }
              }
              return null;
          }
      }

      function getComputedProp(s, p){
          return parseInt(s.getPropertyValue(p).replace('px', ''), 10);
      }

      function getComputedHPadding(s){
          return getComputedProp(s, 'padding-left') + getComputedProp(s, 'padding-right');
      }

      function getComputedVPadding(s){
          return getComputedProp(s, 'padding-top') + getComputedProp(s, 'padding-bottom');
      }

      //find max width for each col
      function setColW(isHeader, cols, resetColW){
          if(!$ctrl.colsW){return;}
          var l = cols.length;
          _.each(cols, function (c, i) {
              //c_x -> x starts at 1 so we must add 1 to id
              var id = getColId(i + 1),
                  colW = id ? $ctrl.colsW[id] : null,
                  isLast = i === l - 1;

              if(colW){
                  var max = getColW(c, colW.w);

                  //var style = window.getComputedStyle(c.children.length > 0 ? c.children[0] : c, null); console.log('max ' + id + ': ' + max +'font-size:' + style.getPropertyValue('font-size') +'width:' + style.getPropertyValue('width'));

                  if (resetColW) { // on sidebar prop changed
                      $ctrl.colsW[id].m = 0;
                      //if cols changed
                      //$ctrl.colsW[id].pH = getColPH(c);
                      $ctrl.colsW[id].l = isLast;
                  }

                  if (max > $ctrl.colsW[id].m) {
                      $ctrl.colsW[id].m = max;
                  }
              }
          });
      }

      function setDefaultCol(c, isLast) {

          var s = window.getComputedStyle(c, null),
              id = getColId(c.printId),
              pH = getColPH(c, s),
              mW = parseInt(s.width, 10),
              minW = parseInt(s.minWidth, 10),
              oW = c.offsetWidth,
              w = (mW > oW ? oW : mW) - pH;

          $ctrl.colsW[id] = {
              o: c.index,
              pH: pH,
              w: w,
              className: c.className,
              s: c.className.indexOf('cant-shrink') !== -1,
              g: c.className.indexOf('grow-column') !== -1,
              isHtml: c.className.indexOf('note-col') !== -1 || c.className.indexOf('note') !== -1
          };
          $ctrl.colsW[id].m = getColW(c, w); // inner children || w

          if(isLast) {
              $ctrl.colsW[id].l = true;
          }
      }

      function getColPH(c, s){
          if(!s){s = getStyle(c);}
          return getComputedHPadding(s);
      }

      function getStyle(c, el){
          if(!el){el = null;}
          return window.getComputedStyle(c, el);
      }

      function getColCls(id){
          return 'r' + id;
      }

      function getColId(id){
          return 'c_' + id;
      }

      function getColW(c, w) {
          var l = c.children ? c.children.length : 0;
          if(!l){return w;}
          var max = 0;
          _.each(c.children, function (ch) {
              var el = ch && $ctrl.LCS.hasClass(ch, 'full-width') ? ch.querySelector('.sb-wrapper') : ch,
                  o = el ? el.offsetWidth : 0;
              if (o > max) {
                  max = o;
              }
          });

          return max;
          /* '<style>' +
                  '@media print{' +
                      '@page{' +
                          'margin:0!important;' +
                           item.marginTop + unit + ' ' + item.marginRight + unit + ' ' + item.marginBottom + unit + ' ' + item.marginLeft + unit + ';' +
                          'width:' + item.viewportSize.w + unit + ';' +
                          'height:' + item.viewportSize.h + unit + ';' +
                          'size: ' + ($ctrl.filtersService.Options.orientation || '' ) + ';' +
                      '}' +
                  '}' +
              '</style>'+*/
      }

      function getHeader() {
            var type = $ctrl.title.substring(0, $ctrl.title.length-1),
                cls = $ctrl.headerCls + ' clearfix ' + ($ctrl.isScriptPreview ? 'unit-xs centered screenplay-side-padding' : ''),
                scriptInfo = $ctrl.getPrintScriptInfo ? $ctrl.getPrintScriptInfo() : null,
            other = getOtherInfo();
    return '<div class="nextpagetop">&nbsp;</div>' +
           '<div class="'+ cls + ' main-header '+ ($ctrl.printPageParams && $ctrl.printPageParams.hideHeader ? ' sb-hide' :'') + '">' +
                '<div class="branded-logo sb-hide clearfix"><div>' + type + ' created in</div> <div class="studiobinder-logo"></div></div>' +
                '<div class="clearfix full-width script-showHeader">' +
                    '<div class="report-info">' +
                        '<h2 class="text-left smaller position-relative clearfix">' + $ctrl.getHeaderTitle() + '</h2>' +
                        '<div class="leftHeader clearfix">' + $ctrl.getScriptInfo() + '</div>' +
                    '</div>' +
                    $ctrl.getCompanyInfo() +
                '</div>' +
          '</div>' +
          (scriptInfo ? ('<div class="' + cls + '">' + scriptInfo + '</div>') : '') +
          (other ? ('<div class="' + cls + '">' + other + '</div>') : '');
      }

      function getHeaderTitle() {
          var t = $ctrl.title;
          if (t[t.length - 1] === 's') {
              t = t.substring(0, t.length - 1);
          }
          return $ctrl.LCS.getISBDiv($ctrl.itemIcon, 6, 'pull-left with-margin-right gray sbf28') +
              '<div class="report-name pull-left with-padding-left title">' + t + '</div>';
      }

      function getCompanyInfo() {
          if(!$ctrl.CPS.product){return '';}
          var p = $ctrl.CPS.product.production,
              a = $ctrl.CPS.product.address;
          return (p || a ? ('<div class="company-info rightHeader">' +
                   (p ? ('<div class="name">' + p + '</div>') : '') +
                   (a ? ('<div class="desc">' + $ctrl.SBFieldMethods.getAddress(a) + '</div>') : '') +
                  '</div>') : '') + '<div class="logo-info ' + ($ctrl.CPS.product.logo ? '' : 'hide-print') + '">' +
       $ctrl.security.getProjectImageComponent('$ctrl.CPS.product', 'intermedium') +
       '</div>';
      }

      function getScriptInfo(){
  return '<div class="script-info">' +
            ($ctrl.CPS.product ? ( ($ctrl.CPS.product.name? ('<div><span class="semibold">Project</span> '+$ctrl.CPS.product.name+'</div>')  : '')+
                ($ctrl.CPS.product.script? ('<div><span class="semibold">Script v'+$ctrl.CPS.product.script.version+'</span> <span>' + $ctrl.CPS.product.script.name + '</span></div>') : '')) : '') +
             '<div>' +
                  '<span class="semibold">Created</span> on ' + $ctrl.CPS.getCreatedAt($ctrl.MomentService.getMomentNow(), $ctrl.CPS.dateTimeFormat)+ ($ctrl.CPS.user ? (' by ' + $ctrl.CPS.user.name) : '') +
              '</div>' +
         '</div>';
      }

      function getOtherScriptInfo(){
          return 'getOtherScriptInfo';
          //'<div class="sb-hide '+$ctrl.Types.Schedules+'"><span class="semibold">Schedule</span> <span class="name"></span></div>' +($ctrl.isReports?('<div class="sb-hide '+$ctrl.Types.Days+'"><span class="semibold">Day</span> <span class="name"></span></div>'):'') +'<div>';
      }

      function getOtherInfo(){
          return '';

          return '<span ng-bind="$ctrl.info.scenesCount"></span> Scene<span ng-bind="$ctrl.info.scenesCount===1?\'\':\'s\'"></span>' +
              '<span ng-if="$ctrl.info.pages.value"><span class="dot-separator smaller"></span> {{$ctrl.SBFieldMethods.getPages($ctrl.info, "inline-block")}} Pages </span>' +
              '<span ng-if="$ctrl.info.prepTime"><span class="dot-separator smaller"></span>Prep Time: <span class="page" ng-bind="$ctrl.SBFieldMethods.getEstVal($ctrl.info.prepTime)"></span></span>' +
              '<span ng-if="$ctrl.info.shootTime"><span class="dot-separator smaller"></span>Shoot Time: <span class="page" ng-bind="$ctrl.SBFieldMethods.getEstVal($ctrl.info.shootTime)"></span></span>' +
              '<span ng-if="$ctrl.info.estTime"><span class="dot-separator smaller"></span>Est. Time: <span class="page" ng-bind="$ctrl.SBFieldMethods.getEstVal($ctrl.info.estTime)"></span></span>' +
              '<span ng-if="$ctrl.info.duration"><span class="dot-separator smaller"></span>Duration: <span class="page" ng-bind="$ctrl.SBFieldMethods.getEstVal($ctrl.info.duration, {isDuration:true})"></span></span>' +
              '</div>';
      }

      function getCoverContent(isFront){

          var writer = $ctrl.createdBy && $ctrl.createdBy.name ? $ctrl.createdBy.name : 'Name of First Writer',
              phone = $ctrl.createdBy && $ctrl.createdBy.phone ? $ctrl.CPS.displayPhone($ctrl.createdBy.phone) : 'Phone Number',
              company = $ctrl.security.getCurrentCompany(),
              name = $ctrl.CPS.product ? $ctrl.CPS.product.name : null,
              i = 0,
              el = '';

          addEmpty(true, 10);
          if(isFront) {
             if(name) {
                 add(true, '<h1>' + $ctrl.CPS.product.name + '</h1>');
             }
              add(true, '<h3>' + $ctrl.title + '</h3>');
              addEmpty(true, 2);

              add(true, 'Created on ' + $ctrl.CPS.getCreatedAt($ctrl.MomentService.getUtcDateNow(), 'MMM D, YYYY'));
              addEmpty(true, 1);
              add(true, 'by');
              addEmpty(true, 1);
              add(true, writer);
              //  addEmpty(true, 20);
              //  add(false, 'Address');
              //  add(false, phone);
          } else { // back cover
              add(true, '<h1>' + '©'+$ctrl.CPS.getCreatedAt($ctrl.MomentService.getUtcDateNow(), 'YYYY')+ ' ' + company.name + '</h1>');
              add(true, '<h3>' + $ctrl.title +(name ? ( ', ' + name) : '') + '</h3>');
              addEmpty(true, 2);
              add(true, 'Created by ' + writer);
          }
          return el;

          //add c empty lines
          function addEmpty(center, c){
              for(var j = 0 ; j < c; j++) {
                  add(center);
              }
          }

          //add content
          function add(center, content) {
              el += $ctrl.ScriptConvertService.getSimpleHtmlPar(content, center ? 'ql-align-center' : '');
              i++;
          }
      }
  }
}

