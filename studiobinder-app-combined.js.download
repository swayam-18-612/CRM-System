angular.module('dropdowns.sbDropdownSimple.controller.service', ['dropdowns.sbDropdownMenu.component',
    'dropdowns.sbDropdown.controller.service'
])
.service('SBDrpSimpleCtrlService', SBDrpSimpleCtrlService);
SBDrpSimpleCtrlService.$inject = ['SBFieldTypesService', 'SBFieldInitCtrlService', 'SBDrpInitCtrlService'];
function SBDrpSimpleCtrlService(SBFieldTypesService, SBFieldInitCtrlService, SBDrpInitCtrlService) {
    return function ($ctrl, $element, $attrs) {
//    $ctrl.propType = SBFieldTypesService.PropTypes.Pages;
        var withoutTemplateScope = true;
        $ctrl.SBFieldTypesService = SBFieldTypesService;
        $ctrl.SBFieldMethods = SBFieldTypesService.SBFieldMethods;

        if(!$ctrl.menuTag){
            $ctrl.menuTag = 'sb-dropdown-menu';
        }
        $ctrl.menuCls = 'display-block position-relative';
        $ctrl.btnResetId ='btnReset';
        
        $ctrl.$onDestroy = $onDestroy;
        $ctrl.resetOnClick = resetOnClick;
        $ctrl.loadReset = loadReset;


        $ctrl = new SBFieldInitCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

        $ctrl.generateDrpMenuContent = generateDrpMenuContent;
        $ctrl.onInitFieldLoaded = onInitFieldLoaded;

        $ctrl.$onInit = $onInit;

        return $ctrl;

        function loadReset(el) {
            if ($ctrl.resetValue !== undefined) {
                $ctrl.LCS.insertElementBefore(el, $ctrl.LCS.createFragment('<button id="' + $ctrl.btnResetId + '" class="btn btn-small small without-text transparent4' +
                    ($ctrl.resetValue === $ctrl.value ? ' sb-hide' : '') +
                    '"' +
                    ($ctrl.resetText ? '' : '  tooltip-placement="left" tooltip="Reset"') +
                    '>' + ($ctrl.resetText ? $ctrl.resetText : $ctrl.LCS.getISBDiv('cancel')) + '</button>'));
                bind(true);
            }
        }

        function $onInit() {
            if($ctrl.withSaveOnTouchScreen && $ctrl.dontClosePopoverOnClick === undefined ){
                $ctrl.dontClosePopoverOnClick = true;
            }

            if($ctrl.onSimpleDrpInitOther){
                $ctrl.onSimpleDrpInitOther();
            }

            $ctrl.withRepeatFromDrp = true;
            $ctrl = new SBDrpInitCtrlService($ctrl, $element);
        }

        function onInitFieldLoaded() {
            if($ctrl.onSimpleDrpFieldLoaded){
                $ctrl.onSimpleDrpFieldLoaded();
            }

            $ctrl.onRepeatFieldLoaded();
        }

        function $onDestroy() {
            bind(false);
            if ($ctrl.onInitDestroy) {
                $ctrl.onInitDestroy();
            }
        }
        function bind(isBind){
            if(typeof($ctrl.resetOnClick) === 'function'){
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('#' + $ctrl.btnResetId), $ctrl.resetOnClick);
            }
        }

        function resetOnClick(e){
            console.log('resetOnClick');
            $ctrl.preventDefault(e);
            var item = {};
            item[$ctrl.valueField] = $ctrl.resetValue;
            $ctrl.onSelect({
                withClose: true,
                item: item
            });
        }

        function generateDrpMenuContent() {
            return {
                $ctrl: $ctrl,
                template: ($ctrl.fixedHeight ? ("fixed-height='true' ") : '') +

                    "label-field='::$ctrl.labelField' " +
                    "value-field='::$ctrl.valueField' " +

                    "str-list='$ctrl.strList' " +
                    "value='$ctrl.active' " +
                    'on-select="$ctrl.onItemSelected(result)" ' +

                    ($ctrl.getGenerateMenuParams ? $ctrl.getGenerateMenuParams() : '')
            };
        }
    }
}

angular.module('dropdowns.drpMenuWithHover.controller.service', [
    'dropdowns.drpMenu.controller.service'
])
.service('SBDrpMenuWithHoverCtrlService', SBDrpMenuWithHoverCtrlService);

SBDrpMenuWithHoverCtrlService.$inject = ['SBDrpMenuCtrlService'];
function SBDrpMenuWithHoverCtrlService(SBDrpMenuCtrlService) {

    return function ($ctrl, $element) {

        if(!$ctrl.select) {
            $ctrl.select = select;
        }

        $ctrl.preInitOther = preInitOther;
        $ctrl.bindOthers = bindOthers;
        $ctrl.onLoadedOther = onLoadedOther;
        $ctrl.onDestroyOther = onDestroyOther;

        $ctrl = new SBDrpMenuCtrlService($ctrl, $element);

        return $ctrl;

        function preInitOther() {
            $ctrl.activeClass = 'active';

            setList();
            $ctrl.changedFields = ['value', 'strList'];

            $ctrl.$onChanges = $onChanges;

            if($ctrl.preInitOtherHover) {
                $ctrl.preInitOtherHover();
            }
            $ctrl.prevSelected = $ctrl.value;
        }

        function onLoadedOther() {
            if($ctrl.onLoadedOtherHover) {
                $ctrl.onLoadedOtherHover();
            }
        }

        function bindOthers(isBind) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.liEls, onMouseEnter, null, 'mouseenter');

            /*$ctrl.getBindMethod(isBind)($ctrl.element, 'mousedown', function (e) {
                e.preventDefault();  // prevent blur event from firing when clicking selection
            });*/

            if($ctrl.bindOthersHover) {
                $ctrl.bindOthersHover();
            }
        }

        function onDestroyOther(){
            $ctrl.bindOthers(false);
        }

        function $onChanges(changes) {
            //console.log(changes);
            if (!changes) {
                return;
            }
            _.each($ctrl.changedFields, function (field) {
                var change = changes[field];
                if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                    switch (field) {
                        case 'strList':

                            setList();
                            $ctrl.reloadTemplate();
                            break;
                        case 'value':
                            //console.log('value changed '+$ctrl[field]);
                            setActive($ctrl[field]);
                            break;
                    }
                }
            });
        }

        function setList() {
            var str = null;
            if ($ctrl.strList) {
                try {
                    str = JSON.parse($ctrl.strList);
                    str = str && str.length > 0 ? str : null;
                } catch (e) {
                }
            }
            $ctrl.list = str;
        }

        function onMouseEnter(e){
            // e.stopPropagation();
            //  if(!$ctrl.LCS.isTouchScreen){
            // this logic will no longer cause a conflict between desktop and mobile
            onActiveInit(e, false);
            //  }
        }

        function select(e){
            console.log('onActive select');
              onActiveInit(e, true);
        }

        function onActiveInit(e, withSelect) {
            $ctrl.preventDefault(e); // to not trigger body close
            var target = e.currentTarget,
                index = $ctrl.getIndexFromEl(target),
                item = $ctrl.list[index],
                id = item ? item[$ctrl.valueField] : null;

            if (setActive(id, withSelect)) {
                $ctrl.value = id;
                //console.log('set active: ' + id);

                if (item) {
                    return $ctrl.onSelect({
                        result: _.extend({
                            item: item,
                            $index: index,
                            $event: e
                        }, withSelect ? {
                            selected: $ctrl.value,
                            withClose: $ctrl.withSaveOnTouchScreen ? false : ($ctrl.isCustom ? false : true)
                        } : {active: $ctrl.value})
                    });
                }
            }else{
                console.log('onActiveInit: value unchanged');
            }
        }

        function setActive(id, withSelect) {
            withSelect ? process('prevSelected', $ctrl.activeClass) :
                process('prevValue', $ctrl.hoverClass);
            return true;

            function process(v, cls){
                $ctrl.updateChecks($ctrl[v], id, cls);
                $ctrl[v] = angular.copy(id);
            }
        }
    }
}


angular.module('dropdowns.pageDropdown.controller.service', [
    'dropdowns.sbDropdownSimple.controller.service'
])
.service('SBDrpPagesCtrlService', SBDrpPagesCtrlService);
SBDrpPagesCtrlService.$inject = ['SBDrpSimpleCtrlService'];
function SBDrpPagesCtrlService(SBDrpSimpleCtrlService) {
    return function ($ctrl, $element, $attrs) {
//    $ctrl.propType = SBFieldTypesService.PropTypes.Pages;
        $ctrl.getGenerateMenuParams = getGenerateMenuParams;

        $ctrl.onSimpleDrpInitOther = onSimpleDrpInitOther;
        $ctrl.onSimpleDrpFieldLoaded = onSimpleDrpFieldLoaded;

        $ctrl = new SBDrpSimpleCtrlService($ctrl, $element, $attrs);

        $ctrl.setDisplayValue = setDisplayValue;
        $ctrl.initDrp = initDrp;

        return $ctrl;

        function onSimpleDrpInitOther() {
            if($ctrl.onSimplePagesInit){
                $ctrl.onSimplePagesInit();
            }

            if(!$ctrl.initListName) {
                console.warn('Parent fr SBDrpPagesCtrlService must define property $ctrl.initListName');
            }

            $ctrl.initList = $ctrl.SBFieldMethods[$ctrl.initListName];

            $ctrl.setInputField = false;

            if(!$ctrl.drpMenuCls) {
                $ctrl.drpMenuCls = 'page-dropdown-menu';
            }
        }

        function onSimpleDrpFieldLoaded() {
            $ctrl.spanText = $ctrl.element.querySelector('#spanItemText');
            $ctrl.LCS.addClass($ctrl.element, $ctrl.element.tagName.toLowerCase() +
                ' display-block clearfix wrap-dd-select ' +
                ($ctrl.cClassAttr ? $ctrl.cClassAttr : ''));

            if ($ctrl.fieldClass) {
                $ctrl.LCS.addClass($ctrl.inputField, $ctrl.fieldClass);
            }

            if ($ctrl.tabIndex) {
                $ctrl.inputField.setAttribute('tabindex', $ctrl.tabIndex);
            }

            if(typeof ($ctrl.loadReset) === 'function') {
                $ctrl.resetText = 'Reset';
                $ctrl.loadReset($ctrl.element.querySelector('.selected'));
            }
        }

        function initDrp() {
            $ctrl.setInputField = false;
        }

        function setDisplayValue() {
            if ($ctrl.preDisplayValue) {
                $ctrl.preDisplayValue();
            }
            var info = $ctrl.getDisplayValue($ctrl.value);
            $ctrl.spanText.innerHTML = info.content ? info.content : info.placeholder;
            $ctrl.LCS[info.hasPlaceholderCls ? 'addClass' : 'removeClass']($ctrl.spanText, 'empty');

            if($ctrl.resetValue!== undefined){
                $ctrl.LCS[$ctrl.resetValue === $ctrl.value ? 'addClass' : 'removeClass']($ctrl.element.querySelector('#'+$ctrl.btnResetId), 'sb-hide');
            }
        }

        function getGenerateMenuParams(){
            return "get-item-desc='$ctrl.getItemDesc(item)' ";
        }
    }
}

angular.module('dropdowns.sbDropdown.border.menu.component', [
    'dropdowns.drpMenu.controller.service'
])
.component('sbBorderDropdownMenu', {
    bindings: {
        fixedHeight: '@',
        labelField: '@',
        valueField: '@',
        //header: '<',
        onSelect: '&',
        //variables:

        list: '<',
        value: '<',
    },
    controller: 'BorderDrpMenuCtrl',
})
.controller('BorderDrpMenuCtrl', BorderDrpMenuCtrl);

BorderDrpMenuCtrl.$inject = ['SBDrpMenuCtrlService', 'SBFieldTypesService', '$element'];
function BorderDrpMenuCtrl( SBDrpMenuCtrlService, SBFieldTypesService, $element) {
    console.log('BorderDrpMenuCtrl');
    var $ctrl = this;

    var types = ['style', 'width', 'color'];

    $ctrl.withChecks = true;
    $ctrl.header = 'Border';
    $ctrl.subheader = 'Add borders to text boxes';

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitOther = preInitOther;
    $ctrl.onPredefinedSelect = onPredefinedSelect;
    $ctrl.getWithClose = getWithClose;
    $ctrl.getJustSave = getJustSave;
    $ctrl.check = check;

    $ctrl = new SBDrpMenuCtrlService($ctrl, $element);

    function getWithClose() {
        return false;
    }

    function getJustSave(){
        return true;
    }

    function onPredefinedSelect(item, index, e) {
        console.log('onPredefinedSelect');
        $ctrl.valueTemp[item.t] = item.v;
        if (item.t === 'style') {
            var v = item.v;
            _.each(['width', 'color'], function (t) {
                if (v === 'none') {
                    $ctrl.valueTemp[t] = null;
                } else if (!$ctrl.valueTemp[t]) {
                    setFirst(t);
                }
            });
        }

        return _.extend({}, item, {id: getValue()});
    }

    function getValue() {
        var value = [];
        _.each(types, function (t, i) {
            var v = $ctrl.valueTemp[t];
            if (v) {
                value.push(v);
            }
        });
        return value.join(' ');
    }

    function preInitOther() {
        $ctrl.valueTemp = {};
        var str = $ctrl.value ? $ctrl.value.split(' ') : ['none'];

        _.each(types, function (t, i) {
            if (str.length > i) {
                setFirst(t, str[i]);
            }
        });
    }

    function setFirst(t, v) {
        var item = _.find($ctrl.list, _.extend({t: t}, v !== undefined ? {v: v} : null));
        if (item) {
            $ctrl.valueTemp[t] = item.v;
        } else {
            delete $ctrl.valueTemp[t];
        }
    }

    function getItemTemplate() {
        return '<div class="dropdown-menu custom-drp-ul custom-border' +
            ($ctrl.fixedHeight ? 'fixedHeight ' : '') +
            ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '') + '"><div> ' +
            ($ctrl.header ? ('<div class="header clearfix full-width">' +

                //$ctrl.LCS.getISBDiv('style', 2, 'pull-left with-margin-right position-relative', 'style="top:5px"') +
                $ctrl.header + '</div>') : '') +
            ($ctrl.subheader ? ('<div class="s clearfix full-width">' + $ctrl.subheader + '</div>') : '') +
            '<div class="full-width">' + check(true) + '</div>' +
            '</div>' +
            '</div>';
    }

    function check(isFirst) {
        var el = '', hide;
        _.each($ctrl.list, function (item, i) {
            var v = item.t,
                cls = getCls();
            if (isFirst) {
                el += '<div class="' + $ctrl.itemClass + ' with-cursor inrow table-div full-width' + cls + '" data-t="' + v + '" data-id="' + item.id + '" data-index="' + i + '">' +
                    '<div class="col30 checkmark centered">' + $ctrl.LCS.getISBDiv('check-bg', 2) + '</div>' +
                    '<div class="semibold text-left centered">' + item.n + '</div>' +
                    '<div class="col100 padding-left10 centered"><div style="width:100%;height: 6px;border-top:' + item.img + '"></div></div>' +
                    '</div>';
            } else {
                var el1 = $ctrl.element.querySelector('.' + $ctrl.itemClass + '[data-t="' + v + '"][data-index="' + i + '"]');
                if (el1) {
                    $ctrl.LCS.replaceClass(el1, 'active border-bottom sb-hide', cls);
                }
            }

            function getCls() {
                var isActive = item.v === $ctrl.valueTemp[v];
                if (i === 0) {
                    if (isActive) {
                        hide = v;
                    }
                }
                var c = (isActive ? ' active' : '') +
                    (!hide && item.border ? ' border-bottom' : '') +
                    ((hide && hide !== v) ? ' sb-hide' : '');
                return c && c.trim() ? c : '';
            }
        });

        return el;
    }
}

angular.module('dropdowns.sbDropdown.border.component', [
    'dropdowns.sbDropdown.border.menu.component',
    'dropdowns.sbDropdown.controller.service'
])
.component('sbBorderDropdown', sbPageDrpComponentParams('BorderDrpCtrl', {
    header: '<?'
}))
.controller('BorderDrpCtrl', BorderDrpCtrl);
BorderDrpCtrl.$inject = ['SBFieldTypesService', 'SBFieldInitCtrlService', 'SBDrpInitCtrlService', '$element', '$attrs'];
function BorderDrpCtrl(SBFieldTypesService, SBFieldInitCtrlService, SBDrpInitCtrlService, $element, $attrs) {

    var withoutTemplateScope = true;

    var $ctrl = this;
    $ctrl.menuTag = 'sb-border-dropdown-menu';
    $ctrl.SBFieldMethods = SBFieldTypesService.SBFieldMethods;
    $ctrl.propType = SBFieldTypesService.PropTypes.Border;

    $ctrl.$onDestroy = $onDestroy;

    $ctrl = new SBFieldInitCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

    $ctrl.onInitFieldLoaded = onInitFieldLoaded;
    $ctrl.generateDrpMenuContent = generateDrpMenuContent;

    $ctrl.setDisplayValue = setDisplayValue;
    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.setInputField = false;
        $ctrl.withRepeatFromDrp = true;
        $ctrl = new SBDrpInitCtrlService($ctrl, $element);
    }

    function onInitFieldLoaded(){
        $ctrl.spanText = $ctrl.element.querySelector('#spanItemText');

        $ctrl.LCS.addClass($ctrl.element, $ctrl.element.tagName.toLowerCase() +
            ' display-block clearfix ' +
            ($ctrl.cClassAttr ? $ctrl.cClassAttr : ''));

        $ctrl.onRepeatFieldLoaded();
    }

    function $onDestroy() {
        if($ctrl.onInitDestroy){$ctrl.onInitDestroy();}
    }

    function setDisplayValue(){
        var defaultVal = 'none',
            val = $ctrl.value ? $ctrl.value : defaultVal;

        if(!$ctrl.spanText.style){$ctrl.spanText.style={};}
        if(val === defaultVal){
            $ctrl.spanText.style.removeProperty('border');
        } else {
            var c = 'var(--fontello-svg-default-RGB)',
            cInit='0,0,0,';
            $ctrl.spanText.style.setProperty('border', val
                .replace(cInit+'0.25',c + ',0.5')//subtle
                .replace(cInit+'0.75',c + ',1')//Prominent
            );
        }
        $ctrl.LCS[val === defaultVal ? 'addClass' : 'removeClass']($ctrl.spanText, 'empty');
    }

    function generateDrpMenuContent() {
        return {
            $ctrl: {
                list: $ctrl.initList,
                value: angular.copy($ctrl.value),
                onSelect: $ctrl.onSelect,
                drpClassAttr: $ctrl.drpClassAttr
            },
            template: ($ctrl.fixedHeight ? ("fixed-height='true' ") : '') +
                "list='::$ctrl.list' " +
                "value='::$ctrl.value' " +
                ($ctrl.valueField ? ("value-field='" + $ctrl.valueField + "' ") : '') +
                ($ctrl.labelField ? ("label-field='" + $ctrl.labelField + "' ") : '') +
                "on-select='$ctrl.onSelect(result)' "
        };
    }
}

angular.module('dropdowns.sbColorDropdownMenu.component', [
    'dropdowns.drpMenu.controller.service'
])

.component('sbColorDropdownMenu', {
    bindings: {
        withSaveOnTouchScreen: '@',
        header: '@',
        subheader: '@',
        drpClassAttr: '@?',

        withoutCustom: '<',
        withUncheck: '<',
        hasCustom: '<',
        fixedHeight: '@',
        labelField: '<',
        valueField: '<',
        showColorName: '<',
        defaultColor: '@',
        //variables:
        list: '<',
        value: '<',
        closeOnSelect: '@',
        onSelect: '&'
    },
    controller: 'SBColorDrpMenuCtrl',
})
.controller('SBColorDrpMenuCtrl', SBColorDrpMenuCtrl);

SBColorDrpMenuCtrl.$inject = ['SBDrpMenuCtrlService', '$element'];
function SBColorDrpMenuCtrl(SBDrpMenuCtrlService, $element) {
    console.log('SBColorDrpMenuCtrl');
    var $ctrl = this;

    $ctrl.withChecks = true;

    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl.preInitOther = preInitOther;
    $ctrl.bindOthers = bindOthers;
    $ctrl.select = select;

    $ctrl = new SBDrpMenuCtrlService($ctrl, $element);

    function preInitOther() {
        if($ctrl.showColorName){
            $ctrl.element.id = 'longer';
            $ctrl.hasCustom = false;
            $ctrl.withUncheck = false;
        }
        $ctrl.activeClass = 'md-checked';
        $ctrl.itemClass = 'select-row';
        $ctrl.placeholder = '#FFFFFF';

        $ctrl.isCustom = isCustomProp($ctrl.value);
        $ctrl.prevIsCustom = $ctrl.isCustom;
    }

    function getItemTemplate() {
   return  '<div class="dropdown-menu customdropdown custom-drp-ul custom-color ' +
                    ($ctrl.fixedHeight ? 'fixedHeight' : '') +
                    ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '') +
                        '"' +
            '><div>' +
                ($ctrl.header ? ('<div class="header clearfix full-width">' + $ctrl.header + '</div>') : '') +
                ($ctrl.subheader ? ('<div class="s clearfix full-width">' + $ctrl.subheader + '</div>') : '') +
                '<div class="show-scrollbar-on-hover"><div class="custom-wrapper ' +
                   ($ctrl.withUncheck ? 'withUncheck' : '') +
                   ($ctrl.showColorName ? ' fancy-scrollbar vertical visible-scroll with-long-blocks' : '') +
                '">' + getEls() + '</div></div>' +
                 getCustom() +
                 getReset() +
                 $ctrl.getSaveBtns() +
            '</div></div>';


        function getCls(v){
            return 'class="customitem' + ((v === '#FFFFFF' || v === 'rgb(255, 255, 255)' || !v) ? ' with-border' : '') + '" ' +  (v ? ('style="background-color:' + v + '"') : '');
        }
        function getEls(){
            return $ctrl.list.map(function (item, i) {
                if(!(item && !item.hide)) {return '';}
                var v = item[$ctrl.valueField],
                    l = item[$ctrl.labelField];
                return  '<div class="custom-checkbox ' + $ctrl.itemClass + ' inrow ' + (item.cls === 'isday' ? 'dark' : '') + '" data-id="' + v + '" data-index="' + i + '">' +
                    '<div ' + getCls(v) + '>' +
                    ($ctrl.showColorName ? ("<span style='color:" + l + "'>" + (item.name ? item.name : v) + '</span>') : '') +
                    '<label class="text-center"><input type="checkbox" ' +
                    ($ctrl.value && $ctrl.value.toUpperCase() === v ? ' checked="checked"' : '') + '/><span></span><span></span></label>' +
                    '</div>' +
                    '</div>';
            }).join('');
        }
            function getCustom(){
                if (!$ctrl.hasCustom) {return '';}
                    var v = $ctrl.isCustom ? $ctrl.value : null;
                    return '<div class="clearfix separatorline custom-drp-ul bottom margin-top- margin-right-24">' +
                                '<div class="custom-wrapper  position-relative margin-top-quarter">' +
                                   '<div class="custom-checkbox ' + $ctrl.itemClass + ' inrow position-absolute" data-id="custom" style="top:4px;left:-2px">' +
                                        '<div '+getCls(v) + '>' +
                                            '<label class="text-center"><input type="checkbox" ' + ($ctrl.isCustom ? ' checked="checked"' : '') + '/><span></span><span></span></label>' +
                                        '</div>' +
                                    '</div>' +
                                    '<div class="padding-left-36">' +
                                        '<input id="customItemText" class="form-control with-underline thinner" ' + ($ctrl.placeholder ? ('placeholder="'+$ctrl.placeholder+'"') : '') + '/>' +
                                    '</div>' +
                                '</div>' +
                            '</div>';
           }
        function getReset(){
            return  $ctrl.withUncheck ? ('<div class="margin-top-half">' +
                '<button id="btnReset" type="button" class="btn btn-small transparent full-width">Reset</button>' +
                '</div>'):'';
        }

/*
* "<div id='customCheck' class='md-radio-button " + $ctrl.itemClass + " Drp' data-id='custom' " + ($ctrl.isCustom ? " checked='checked'" : '') + ">" +
                                "<div class='md-container md-ink-ripple'>" +
                                    "<div class='md-off'></div>" +
                                    "<div class='md-on'></div>" +
                                    "<div class='md-ripple-container'></div>" +
                                "</div>" +
                                "<div class='padding-left-30'>" +
                                    "<input id='customItemText' class='form-control thin with-underline font-size-12' placeholder='" + ($ctrl.placeholder ? $ctrl.placeholder : '') + "'/>" +
                                "</div>" +
                            "</div>" +
                            * */
    }

    function bindOthers(isBind) {
        if($ctrl.hasCustom){
            var el = $ctrl.element.querySelector('#customItemText');
            if (isBind) {
                if($ctrl.isCustom){
                    el.value = $ctrl.value;
                    el.focus();
                }
            }

            method('focus', onCustom);
            method('keyup paste', onCustomKey);
        }

        if($ctrl.withUncheck){
            $ctrl.bindEl(method, '#btnReset', reset);
        }

        function method(ev, m){
            $ctrl.LCS.bindElementsClick(isBind, el, m, 'cstmbtn', ev);
        }

    }

    function reset(e) {
        console.log('color.reset');
        $ctrl.preventDefault(e);

        /*for(var i =0, n = $ctrl.list.length;i<n;i++){
            var el = $ctrl.list[i];
            if(el[$ctrl.valueField] === $ctrl.defaultColor){
                return selectRowByIndex(i, $ctrl.defaultColor, false);
            }
        }*/

        selectRowByIndex(-1, null, false);
    }

    function onCustom(e) {
        onc(e, false);
    }

    function onCustomKey(e) {
        onc(e, true);
    }

    function onc(e, isTyping){
        console.log('onCustom' + (isTyping ? 'Keydown' : ''));
        selectRow(e, 'custom', isTyping);
    }

    function select(e) {
        if($ctrl.dontAllowSelect){return;}
        $ctrl.dontAllowSelect = true;
        $ctrl.isUpdating = true;
        selectRow(e, e.currentTarget.getAttribute('data-id'));
        $ctrl.LCS.timeout(function (){
            $ctrl.dontAllowSelect = false;
        }, 300)
    }

    function selectRow(e, id, isTyping) {
        var target = e.currentTarget,
            index = -1;
        try {
            index = parseInt(target.getAttribute('data-index'), 10);
        } catch (e) {
        }
        selectRowByIndex(index, id, isTyping);
    }

    function selectRowByIndex(index, id, isTyping, e){
        $ctrl.isCustom = id === 'custom';  
        var same = !$ctrl.isCustom && $ctrl.value === id || $ctrl.isCustom;
        if(isTyping){same = false;}
        if(same){
            if($ctrl.withUncheck){
                $ctrl.preventDefault(e);
                return reset();
            }
        }
        else {
            if ($ctrl.isCustom) {
                var el = $ctrl.element.querySelector('#customItemText');
                $ctrl.value = el.value;
                el.focus();
                var el = $ctrl.element.querySelector('.' + $ctrl.itemClass + '[data-id="custom"] .customitem');
                if(el) {
                    $ctrl.LCS[$ctrl.value ? 'removeClass' : 'addClass'](el, 'with-border');
                    $ctrl.LCS.setCSSStyle(el, 'background-color', $ctrl.value || '');el
                }
            } else {
                $ctrl.value = id;
            }
        }

        setSelected();

        var item = null;
        if ($ctrl.value) {
            if (!$ctrl.isCustom) {
                if (index !== -1) {
                    item = $ctrl.list[index];
                }
            } else {
                item = {};
                item[$ctrl.valueField] = $ctrl.value;
            }
        }

        $ctrl.onDefinedSelect(item, index, e);

        $ctrl.prevValue = angular.copy($ctrl.value);
        $ctrl.prevIsCustom = $ctrl.isCustom;
    }

    function setSelected() {
        var id = getV($ctrl.value, $ctrl.isCustom),
            previousId = getV($ctrl.prevValue, $ctrl.prevIsCustom);
        if (id === previousId && !$ctrl.withUncheck) {
            return;
        }

        $ctrl.updateChecks(previousId, id);

        if (isCustomProp($ctrl.value)) {
            var el = $ctrl.element.querySelector('#customItemText');
            if(el) {
                el.value = $ctrl.value;
            }
        }

        function getV(v, isC) {
            return v ? (isC ? 'custom' : v.toUpperCase()) : null;
        }
    }

    function isCustomProp(value) {
        return value && !_.find($ctrl.list, function (item) {
            return item[$ctrl.valueField] === value.toUpperCase();
        });
    }
}

angular.module('dropdowns.sbColorDropdown.component', [
    'dropdowns.sbColorDropdownMenu.component',
    'dropdowns.sbDropdown.controller.service'
])

.component('sbColorDropdown', sbFieldComponentParams('SBColorDrpCtrl', sbDefaultDrpComponentParams({
    header: '@',
    subheader: '@',
    longer: '@?',
    withUncheck: '@?',
    showColorName: '@?',
    withoutCustom: '@',
    defaultColor: '@',
    square: '@',
    icon: '@'
}),'<div class="selected"><div class="dropdown-sel-text drp-color"><div class="sbf custom-drp-img"></div></div></div>'))
.controller('SBColorDrpCtrl', SBColorDrpCtrl);

SBColorDrpCtrl.$inject = ['SBFieldTypesService', 'SBFieldInitCtrlService', 'SBDrpInitCtrlService', '$element', '$attrs'];
function SBColorDrpCtrl(SBFieldTypesService, SBFieldInitCtrlService, SBDrpInitCtrlService, $element, $attrs) {

    var withoutTemplateScope = true;

    var $ctrl = this;
    $ctrl.menuTag = 'sb-color-dropdown-menu';
    $ctrl.longer = false;

    $ctrl.propType = SBFieldTypesService.PropTypes.Color;
    $ctrl.$onDestroy = $onDestroy;

    $ctrl = new SBFieldInitCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

    $ctrl.getInputText = getInputText;
    $ctrl.setDisplayValueDrpOther = setDisplayValueDrpOther;

    $ctrl.onInitFieldLoaded = onInitFieldLoaded;
    $ctrl.generateDrpMenuContent = generateDrpMenuContent;

    $ctrl.initDrp = initDrp;
    $ctrl.$onInit = $onInit;
 
    function $onInit() {
        if($ctrl.dontClosePopoverOnClick === undefined ){
            $ctrl.dontClosePopoverOnClick = '.custom-drp-ul.bottom';
        }

        $ctrl.initDrp();
        $ctrl.withRepeatFromDrp = true;
        $ctrl = new SBDrpInitCtrlService($ctrl, $element);
    }

    function initDrp() {
        $ctrl.setInputField = false;
        $ctrl.valueField = 'id';

        $ctrl.hasCustom = $ctrl.withoutCustom !== 'true';
        $ctrl.longer = $ctrl.longer === 'true' || $ctrl.longer === true;

        $ctrl.withUncheck = $ctrl.withUncheck === 'true' || $ctrl.withUncheck === true;

        $ctrl.showColorName = $ctrl.showColorName === 'true' || $ctrl.showColorName === true;
        if ($ctrl.showColorName) {
            $ctrl.fixedHeight = true;
        }

        if (!$ctrl.header) {
            $ctrl.header = 'Change Color';
        }
        if (!$ctrl.placeholder) {
            $ctrl.placeholder = 'Change Color';
        }
        if ($ctrl.value === undefined) {
            $ctrl.value = null;
        }
    }

    function onInitFieldLoaded() {
        var drp = $ctrl.element.querySelector('.custom-drp-img');
        $ctrl.LCS.addClass(drp, $ctrl.icon ? $ctrl.icon : 'background-color');
        $ctrl.iconLevel = 3;
        if($ctrl.iconLevel > 1){
            drp.innerHTML = $ctrl.LCS.getISBPath($ctrl.iconLevel);
        }
        $ctrl.elSelText = $ctrl.element.querySelector('.dropdown-sel-text');
        $ctrl.list = $ctrl.list ? _.filter($ctrl.list, function (item){return item;}) : [];
        if ($ctrl.value) {
            $ctrl.selectModel = _.find($ctrl.list, function (item) {
                return item && item[$ctrl.valueField] === $ctrl.value.toUpperCase();
            });
        }

        if ($ctrl.longer) {
            $ctrl.elLongText = document.createElement("span");
            setLongText();
            $ctrl.elSelText.appendChild($ctrl.elLongText);
        }

        $ctrl.LCS.addClass($ctrl.element, $ctrl.element.tagName.toLowerCase() +
            ' display-block clearfix wrap-dd-select custom-drp-selector custom-color-selector ' +
            ($ctrl.longer ? 'longer without-underline ' : 'without-arrow smaller ') +
            ($ctrl.square ? 'square' : ''));

        $ctrl.onRepeatFieldLoaded();
    }

    function setDisplayValueDrpOther() {
        //console.log('setDisplayValueDrpOther: color drp' );
        $ctrl.LCS[$ctrl.longer && !$ctrl.value?'addClass':'removeClass']($ctrl.elSelText, 'selected-text');
        var color = $ctrl.selectModel && $ctrl.selectModel.text ? $ctrl.selectModel.text : ($ctrl.value === $ctrl.LCS.bannerColor ? '#FFFFFF' : null);
        if(!color){
            color = (!$ctrl.value || $ctrl.value && tinycolor($ctrl.value).isLight()) ? 'var(--body-color)':'#fff';
        }
        $ctrl.LCS.setCSSStyle($ctrl.elSelText, 'background-color', $ctrl.value ? $ctrl.value : '#FFFFFF');
        $ctrl.LCS.setCSSStyle($ctrl.elSelText, 'color', $ctrl.value ? ($ctrl.selectModel ?$ctrl.selectModel[$ctrl.labelField]: color): color);
        var hasBorder = $ctrl.value && ($ctrl.value === '#FFFFFF' || $ctrl.value === 'rgb(255, 255, 255)') || !$ctrl.value && !$ctrl.longer;
        $ctrl.LCS.setCSSStyle($ctrl.elSelText, 'border',  '1px solid ' + (hasBorder ? ($ctrl.selectModel && $ctrl.selectModel.border ? $ctrl.selectModel.border : '#D8E0E6') :'tnansparent'));

        setLongText();
    }

    function getInputText(el) {
        //console.log('getInputText');
        $ctrl.selectModel = el;
    }

    function setLongText() {
        if ($ctrl.elSelText) {
            $ctrl.elSelText.value = $ctrl.value ? ($ctrl.showColorName ? ($ctrl.selectModel && $ctrl.selectModel.name ? $ctrl.selectModel.name : ($ctrl.selectModel ? $ctrl.selectModel[$ctrl.valueField] : 'Select Color')) : 'Change Color') : 'Select Color';
        }
    }

    function $onDestroy() {
        if ($ctrl.onInitDestroy) {
            $ctrl.onInitDestroy();
        }
    }

    function generateDrpMenuContent() {
        return {
            $ctrl: {
                showColorName: $ctrl.showColorName,
                withUncheck: $ctrl.withUncheck,
                hasCustom: $ctrl.hasCustom,

                fixedHeight: $ctrl.fixedHeight,

                labelField: $ctrl.labelField,
                valueField: $ctrl.valueField,

                list: _.filter($ctrl.initList, function (item){return item;}),
                value: angular.copy($ctrl.value),
                onSelect: $ctrl.onSelect,
                closeOnSelect: $ctrl.service !== null && $ctrl.service!== undefined
            },
            template: 'show-color-name="::$ctrl.showColorName" ' +
                'with-uncheck="::$ctrl.withUncheck" ' +
                'has-custom="::$ctrl.hasCustom" ' +
                ($ctrl.subheader ? ('subheader="'+$ctrl.subheader+'" ') : '') +

                ($ctrl.defaultColor ? ('default-color="'+$ctrl.defaultColor+'" ') : '') +
                ($ctrl.fixedHeight ? ('fixed-height="true" ') : '') +
                'list="::$ctrl.list" ' +
                'value="::$ctrl.value" ' +

                'label-field="::$ctrl.labelField" ' +
                'value-field="::$ctrl.valueField" ' +

                'on-select="$ctrl.onSelect(result)" '
        };
    }
}


