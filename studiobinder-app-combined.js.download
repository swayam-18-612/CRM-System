    function isItemLikedByUser(item, userId){
        var likes = getItemLikes(item);
        return likes ? _.find(likes, {userId: userId}): false;
    }
    function getItemLikes(item, prop){
        if(!prop){prop = 'likes';}
        return item && item[prop] ? _.filter(item[prop], isLike) : null;

        function isLike(like) {
            var withRemoved = true,
                field = 'removed';
            return (!withRemoved || withRemoved && like[field] !== true);
        }
    }
    function getListOfRoles($ctrl, item, depId) {
        if(!item || !$ctrl){
            return null;
        }
        var itemRoles ;
        if ($ctrl.positions && $ctrl.positions.length > 0 && item && typeof(item.getType) === 'function') {
            itemRoles = $ctrl.service.getItemRoles(item, $ctrl.productContactListId);
            if (itemRoles && itemRoles.length > 0) {
                if(depId && typeof (depId)==='string'){
                    try{
                        depId = parseInt(depId, 10);
                    }catch (e){}
                }
                return getList(itemRoles, $ctrl.roleType ? $ctrl.roleType.toString() : $ctrl.roleType, (depId === null || depId === undefined) ? null : depId, getPosition);
            }
        }
        return null;

        function getPosition(posId) {
            var pos = $ctrl.positions;
            if (!pos || pos.length === 0) {
                return null;
            }
            return _.find(pos, function (el) {
                return el.posId === parseInt(posId, 10);
            });
        }

        function getList(itemRoles, roleType, depId, getPosition) {
            var l = [];

            if (itemRoles) {
                for (var i = 0, m = itemRoles.length; i < m; i++) {
                    var r = itemRoles[i], n = '';

                    if (roleType != null && roleType !== r.type.toString() || depId != null && depId !== 0 && depId !== r.depId || depId === 0 && r.depId !== undefined) {

                    } else {
                        if (r.type === 4) {
                            n = r.name;
                        } else if (r.type === 2) {
                            if (r.posId) {
                                var p = getPosition(r.posId);
                                if (p) {
                                    n = p.shortName;
                                }
                            }
                            if (!n && r.name) {
                                n = r.name;
                            }
                        } else {
                            n = '"' + r.name + '"';
                        }
                        if (n && n !== '') {
                            l.push(n);
                        }
                    }
                }
            }
            return l.length > 0 ? l : null;
        }
    }

    function convertHtmlToText (html){
        var d = document.createElement('div');
        d.innerHTML = html;
        return d.textContent || d.innerText || '';
    }

    function itemSort(item, prop, type, $ctrl) {
        var v, PropTypes = service.PropTypes;
        switch(type) {
            case PropTypes.Position:
                var roles = service.getListOfRoles($ctrl, item);
                if (roles && roles.length > 0) {
                    v = roles[0].toLowerCase().replace(/"/g, '');
                }
                return get(v);

            case PropTypes.Html:
            case PropTypes.Contenteditable:
            case PropTypes.HtmlTooltip:
                v = item[prop];
                return get(v ? convertHtmlToText(v).toLowerCase() : '');

            case PropTypes.StripLocation:
                v = item.stripLocation;
                return get(v && v.name ? v.name.toLowerCase() : null);

            case PropTypes.DayTime:
                return get(service.getTimeDayDisplay(item, 'dayTime'));

            case PropTypes.Rate:
            case PropTypes.ContactRate:
                v = item[prop];
                //todo check v.t
                return get(v ? v.v : null);

            case PropTypes.Calltime:
            case PropTypes.Pickuptime:
            case PropTypes.Onsettime:
            case PropTypes.HMUtime:
            case PropTypes.Costumestime:
            case PropTypes.Wraptime:
                v = item[prop];
                return get(v ? (v.isTime ? (v.value ? v.value.format($ctrl.CPS.timeFormat) : null) : v.value) : null);
        }
        return null;

        function get(v) {
            return {v: (v === null || v === undefined) ? -1 : v};
        }
    }

    function getScheduleItemType(type) {
        switch( type) {
            case service.ScheduleTypes.CompanyMove: return 'company move';
            case service.ScheduleTypes.Scene: return 'scene';
            default: return 'schedule item';
        }
    }
    function getCustomAddress(address) {
        var item = null;

        if (address) {
            if (address.formatted_address) {
                item = {
                    name: address.name,
                    address: address.formatted_address,
                    phone: address.phone
                };
            } else {
                item = {
                    address: address
                };
            }

            item.map = service.getMapLink(address);
        }

        return item;
    }

    function getCustomAddressDisplay(canEdit, val, placeholder, textOnly) {
        var a = service.getCustomAddress(val),
            t = '';
        if (a) {
            if (a.name) {
                var cls = 'class="word-wrap semibold full-width"',
                    t1 = textOnly ? a.name : ('<div ' + cls + '>' + a.name + '</div>');
                if (canEdit) {
                    t += t1;
                } else {
                    if (a.address) {
                        if(textOnly){
                            t += a.name + '\n' + a.map;
                        }else {
                            t += '<a ' + cls + ' target="_blank" href="' + a.map + '">' + a.name + ' ➚</a>';
                        }
                    } else {
                        t += t1;
                    }
                }
            }

            var address = a.address ? a.address : a;
            t += textOnly ? ('\n' + address) : ('<div class="word-wrap">' + address + '</div>');
              if  (a.phone ) {
                  t += textOnly ? ('\n' + a.phone):
                  ((canEdit ? ('<div>' + a.phone + '</div>') : ('<a href="tel:' + a.phone + '">' + a.phone + '</a>')));
              }
        }

        return t;
    }

    function getMapLink(address) {
        var url = null;
        if (address) {
            if (address.url) {
                url = address.url;
            }
            else {
                var adr = address.formatted_address ? address.formatted_address : address;
                if (adr) {
                    url = 'http://maps.google.com/maps?q=' + adr.replace(/\,/g, ' ').replace(/\ /g, '%20'); // get rid of commas & convert address into approprite URI for google maps
                }
            }
        }
        return url;
    }
    function canUpdateField($ctrl, c) {
        var isActive = typeof ($ctrl.isActiveFilter) === 'function' && $ctrl.isActiveFilter() || typeof ($ctrl.isActiveFilter) !== 'function';
        return isActive && $ctrl.canEdit && c.canEdit;
    }

    function getSBFieldContentView($ctrl, item, c, textOnly) {
        var canUpdate = service.canUpdateField($ctrl, c),
            content = getContentByType($ctrl, canUpdate, item, c, textOnly),
            nc = content ? content : null;
        if (content && typeof (content.trim) === 'function' && content.trim() === '') {
            nc = null;
        }
        var p = c.placeholder;// ? c.placeholder : (c.name + '…');
        return {
            value: getValFromProp(item, c.prop || ''),
            content: nc,
            placeholder: canUpdate ? (p && !textOnly ? p :
                    getPlaceholderByType(true, c.type, textOnly, c.withoutIcon, c.emptyIsCircle)) :
                getPlaceholderByType(false, c.type, textOnly),
            hasPlaceholderCls: !content && canUpdate
        };
    }

    function getColContentView($ctrl, canUpdate, item, c, textOnly) {
        var info = service.getSBFieldContentView($ctrl, item, c, textOnly);
        return {
            value: info.value,
            hasPlaceholderCls: info.hasPlaceholderCls,
            content: getContent($ctrl, info.content, info.placeholder, textOnly)
        }

        function getContent($ctrl, content, placeholder) {
            switch (c.type) { //todo for text only
                case service.PropTypes.BigCheck:
                    return displayBigCheck(canUpdate, c.tooltipPlacement, $ctrl.CPS.dateFormat, content, $ctrl.CPS.getCreatedAt, textOnly);

                case service.PropTypes.SimpleCheck:
                    return displaySimpleCheck(canUpdate, content, textOnly);

                case service.PropTypes.HtmlTooltip:
                    var noQuota = c && c.quotaType && !$ctrl.CPS.hasQuotaType(c.quotaType);
                    return textOnly ? (content ? $ctrl.LCS.convertHtmlToText(content) : get()) :
                        displayHtmlTooltipContent($ctrl, canUpdate, c,
                            content,
                            //only text:
                            //content ? $ctrl.LCS.convertHtmlToText(content) : null,
                            $ctrl.getClickEventName, textOnly, noQuota);

                case service.PropTypes.Html:
                case service.PropTypes.Contenteditable:
                    return content && textOnly ? $ctrl.LCS.convertHtmlToText(content) : get();

                default:
                    return get();
            }

            function get() {
                return content ? content : (c.hideEmptyContent ? '' : placeholder);
            }
        }
    }
    
    function getValFromProp(item, prop, isComp) {
        var str = prop ? prop.split('.') : null,
            has2 = str && str.length > 1,
            val = str && item ? item[str[0] + (isComp && !has2 ? 'Comp' : '')] : undefined;
        if(has2){
            val = val ? val[str[1] + (isComp ? 'Comp' : '')] : undefined;
        }
        return val;
    }

    function setValForProp(item, prop, value) {
     var str = prop ? prop.split('.') : '';
         prop = str[0];
        var t = value;
         if (str.length > 1) {
             t = {};
             t[str[1]] = value;
         }
         item[prop] = t;
         return item;
    }

    function getComplexTime1($ctrl, val, c, initList) {
        return service.getComplexTime(val, c, initList, getTimeFormat(c, $ctrl));
    }
    
    function getTimeFormat(c, $ctrl) {
        return c.timeFormat ? c.timeFormat : $ctrl.CPS.timeFormat;
    }

    function getContentByType($ctrl, canUpdate, item, c, textOnly) {
        if (!c.prop) {
            console.log('getContentByType '+c.prop+' is not defined for ' + c.type);
        }

        var val = getValFromProp(item, c.prop || '', c.isComp),// item ? item[c.prop] : null,
            initList = $ctrl.Settings && c.initListName ? $ctrl.Settings[c.initListName] : null;
     // initList = $ctrl.initList ? $ctrl.initList : ($ctrl.Settings && c.initListName ? $ctrl.Settings[c.initListName] : null)
        switch (c.type) {
            case service.PropTypes.Number:
            case service.PropTypes.CommentsCount:
                return val || 0;

            case service.PropTypes.Address:
                return c.formattedAddress ? getCustomAddressDisplay(canUpdate, item[c.prop], c.placeholder, textOnly) : getAddress(val, textOnly);

            case service.PropTypes.Phone:
                return displayPhone(val, c);

            case service.PropTypes.Email:
                return displayEmail(val, c);

            case service.PropTypes.Time:
                return service.getTime(val, getTimeFormat(c, $ctrl));

            case service.PropTypes.Calltime:
                return getComplexTime1($ctrl, val, c, service.CalltimeVals);

            case service.PropTypes.Pickuptime:
                return getComplexTime1($ctrl, val, c, service.PickupVals);

            case service.PropTypes.Onsettime:
            case service.PropTypes.HMUtime:
            case service.PropTypes.Costumestime:
            case service.PropTypes.Wraptime:
                //todo figure out for has moreVals
                return getComplexTime1($ctrl, val, c, service.OnSetVals);

            case service.PropTypes.EstTime:
                return getEstVal(val);

            case service.PropTypes.Duration:
                return getEstVal(val, {isDuration: true});

            case service.PropTypes.Timecode:
                return getEstVal(val, {isTimecode: true});



            case service.PropTypes.TimecodeRange:
                return getEstVal(val,  {isTimecode: true, isRange: true});

            case service.PropTypes.Scene:
                return item.scene ? service.getSceneText(item) : null;

            case service.PropTypes.Size:
                return item && item.version ? $ctrl.getTextFileSize(item.version.size) : 0;


            case service.PropTypes.Check:
            case service.PropTypes.Radio:
                return displayCheck(val, c, initList);

            case service.PropTypes.Color:
                return getDrpColor(val, c, initList);

            case service.PropTypes.Drp:
            case service.PropTypes.Style:
                return getDrp(val, c, initList);

            case service.PropTypes.Icon:
                return getIcon(val, c, initList);

            case service.PropTypes.Team:
                return getTeam($ctrl, val, c, initList, $ctrl.security, textOnly);

            case service.PropTypes.Projects:
                return getProjects($ctrl, val, c, initList, $ctrl.security, textOnly);

            case service.PropTypes.Collaborators:
                return getCollaborators($ctrl, canUpdate, c, item, textOnly);

            case service.PropTypes.Likes:
                return getLikes($ctrl, canUpdate, c, item, textOnly);

            case service.PropTypes.Characters:
                return getCharacters(canUpdate, c, val, initList, item, textOnly, $ctrl.isPrintLayout);

            case service.PropTypes.Locations:
                return getLocations(canUpdate, c, val, initList, item, textOnly, $ctrl.isPrintLayout);

            case service.PropTypes.StripLocation:
                return getStripLocation(canUpdate, c, val, initList, item, textOnly, $ctrl.isPrintLayout);

            case service.PropTypes.Elements:
                return getElementsCount(canUpdate, c, val, item, textOnly);

            case service.PropTypes.Pages:
                return service.getPages(item, null, textOnly, c.prop);

            case service.PropTypes.TopCall:
                return service.getTopCall(item, c.prop);


            case service.PropTypes.SceneType:
                return getSceneTypeText(item, c.prop); //todo see how to treat if  c.prop = x.y

            case service.PropTypes.DayTime:
                return service.getTimeDayDisplay(item, c.prop);//todo see how to treat if  c.prop = x.y

            case service.PropTypes.Rate:
                return displayRate(val, $ctrl.CPS.getCurrentRate, textOnly);

            case service.PropTypes.ContactRate:
                return $ctrl.getContactRate(item, canUpdate, textOnly);

            case service.PropTypes.Position:
                if ($ctrl.getAdjustRoles) {
                    return $ctrl.getAdjustRoles(item, canUpdate, $ctrl.depId, textOnly);
                } else {
                    console.warn('must define $ctrl.getAdjustRoles');
                    return '';
                }

            case service.PropTypes.Date:
                return displayDate(val, $ctrl.CPS.getCreatedAt, c.dateFormat);

            case service.PropTypes.Dates:

                function get(v) {
                    return v && v.value ? $ctrl.CPS.getCreatedAt(v.value, c.dateFormat +
                        (c.enableTime && v.hasTime ? (' @ ' + (c.timeFormat ? c.timeFormat : $ctrl.CPS.timeFormat)) : '')) : null;
                }

                function getL(prop, v, def, withLabel) {
                    return (withLabel ? ('<span class="semibold">' + (c.labels ? c.labels[prop] : def) + ':&nbsp;</span>') : '') +
                        '<span>' + v + '</span>';
                }

                var from, to;
                if(val) {
                    from = get(val.from);
                    to = get(val.to);
                }
                if(from && to){return '<span>'+from + ' to ' + to+'</span>';}
                else if(from){return getL('from', from, 'Start', true);}
                else if(to){return getL('to', to, 'Due', false);}
                else return null;


            case service.PropTypes.DateRange:
                function g(v){
                    return displayDate(v, $ctrl.CPS.getCreatedAt, c.dateFormat);
                }
                return val ? ('<span>'+g(val[0]) + (val[1] ? ('-' +  g(val[1])) : '')+'</span>') : null;

            case service.PropTypes.BigCheck:
                if(c.prop === 'onItem'){
                    return item ? {
                        completed: item.completed,
                        completedAt: item.completedAt,
                        completedById: item.completedById
                    } : null;
                }else {
                    return val || null;
                }

            case service.PropTypes.Border:
            default:
                return val || null;
        }
    }


    function getDurationPlaceholder(canEdit, textOnly) {
        return '00:00';
    }

    function getTimecodePlaceholder(canEdit, textOnly) {
        return '00:00:00:00';
    }
    function getTimecodeRangePlaceholder(canEdit, textOnly) {
        return '00:00 – 00:00';
    }
    function getPlaceholderByType(canEdit, type, textOnly, withoutIcon, emptyIsCircle) {
        switch (type) {
            case service.PropTypes.Scene:
                return canEdit ? '#' : '–';

            case service.PropTypes.Pages:
            case service.PropTypes.TopCall:
            case service.PropTypes.SceneType:
            case service.PropTypes.DayTime:
            case service.PropTypes.Drp:
                return textOnly ? textEmptyPlaceholder : '–';

            case service.PropTypes.Elements:
            case service.PropTypes.Number:
            case service.PropTypes.CommentsCount:
                return textOnly ? textEmptyPlaceholder : '0';

            case service.PropTypes.EstTime:
                return getEstTimePlaceholder(canEdit, textOnly);

            case service.PropTypes.Duration:
                return getDurationPlaceholder(canEdit, textOnly);

            case service.PropTypes.Timecode:
                return getTimecodePlaceholder(canEdit, textOnly);

            case service.PropTypes.TimecodeRange:
                return getTimecodeRangePlaceholder(canEdit, textOnly);

            case service.PropTypes.Rate:
            case service.PropTypes.ContactRate:
                return getRatePlaceholder(canEdit, textOnly);

            case service.PropTypes.Team:
                return textOnly ? textEmptyPlaceholder : 'Assign Team…';
            case service.PropTypes.Projects:
                return textOnly ? textEmptyPlaceholder : 'Assign Projects…';

            case service.PropTypes.Locations:
                return getLocationPlaceholder(canEdit, textOnly, withoutIcon);

            case service.PropTypes.Characters:
                return getCharactersPlaceholder(canEdit, textOnly, withoutIcon);

            case service.PropTypes.StripLocation:
                return getStripLocationPlaceholder(canEdit, textOnly, true);

            case service.PropTypes.BigCheck:
                return displayBigCheck(canEdit, null, null, null, null);

            case service.PropTypes.Date:
            case service.PropTypes.Dates:
            case service.PropTypes.DateRange:
                var icon =  LCS.getISBDiv('day-of-days',6, 'gray'),
                   txt = emptyIsCircle ? ('<div class="centered elemdate circular-btn dashed">' + icon + '</div>') : icon;
                return (withoutIcon  || emptyIsCircle )? (txt + (emptyIsCircle ?  getP() : '')) : getP();

            case service.PropTypes.SimpleCheck:
                return displaySimpleCheck(canEdit, false, null);

            default:
                return getP();
        }

        function getP(){
            return textOnly ? textEmptyPlaceholder : (canEdit ? '' : '–');
        }

        function getEstTimePlaceholder(canEdit, textOnly) {
            return '0m';
        }

        function getRatePlaceholder(canEdit, textOnly) {
            return textOnly ? textEmptyPlaceholder : ('<span class="rate-no">0</span><span class="rate-h">/h</span>');
        }

        function getLocationPlaceholder(canEdit, textOnly, withoutIcon) {
            return getPlaceholder(canEdit, textOnly, withoutIcon, 'pin', 'Location');
        }

        function getCharactersPlaceholder(canEdit, textOnly, withoutIcon) {
            return getPlaceholder(canEdit, textOnly, withoutIcon, 'contacts-1', 'Cast');
        }

        function getStripLocationPlaceholder(canEdit, textOnly, withoutIcon) {
            return getPlaceholder(canEdit, textOnly, withoutIcon, 'pin', 'Set');
        }

        function getPlaceholder(canEdit, textOnly, withoutIcon, icon, txt) {
            return textOnly ? textEmptyPlaceholder : ('<span class="assignPlaceholder">' +
                (withoutIcon ? '' : LCS.getISBDiv(icon, 2, 'pull-left sidepin gray with-margin-right hide-print') + ' ') +
                '<div class="pull-left placeholder gray-light ' + (canEdit ? 'with_underline' : '') + '">' + (canEdit ? ('Assign ' + txt + '…') : '–') + "</div>" +
                '</span>');
        }
    }

    function displayPhone(val, c) {
        var v = val ? IntlTelInputService[c.isInt ? 'formatIntNumber' : 'formatNatNumber'](val) : null;
        return v ? (c.viewRowDetailsMobile ? ('<a href="' + (c.isSMS ? 'sms' : 'tel') + ':' + val + '">' + v + '</a>') : v) : null;
    }

    function displayEmail(val, c) {
        if (!val) {
            return null;
        }
        if (c.viewRowDetailsMobile) {
            return '<a href="mailto:' + val + '">' + val + '</a>';
        }
        if (!c.showWithSep) {
            return val;
        }
        var s = val.split('@');
        return s.length === 2 ? (s[0] + '<span style="width:0;overflow:hidden">&nbsp;</span>' + s[1]) : val;//to prevent creating hyperlinks in pdf
    }

    function getAddress(val) {
        var init = null;
        if (val) {
            if (typeof (val) === 'object') {
                if (val.name) {
                    init = val.name;
                }
                if (val.formatted_address) {
                    init = init ? (init + ', ' + val.formatted_address) : val.formatted_address;
                }
            } else {
                init = val;
            }
        }
        return init;
    }

    function getTimeFromSeconds(v, res, props) { //p: isDuration, isTimecode
        var isDuration = res ? res.isDuration : false,
            isTimecode = res ? res.isTimecode : false;
            var info = getEstTimeInfo(v, res);

        if (isDuration || isTimecode) {
            return info;
        } else {
            var d = new Date();
            d.setHours(props && props.hideHours ? 0 : (info && info.hours ? info.hours : 0));
            d.setMinutes(info && info.minutes ? info.minutes : 0);
            d.setSeconds(props && props.showSeconds ? (info && info.seconds ? info.seconds : 0) : 0);
            d.setMilliseconds(props && props.showMilliseconds ? (info && info.milliseconds ? info.milliseconds : 0) : 0);
            return d;
        }
    }

    function getEstVal(val, res) {
        var isDuration = res ? res.isDuration : false,
        isTimecode = res ? res.isTimecode : false,
            isRange = res ? res.isRange : false;
        if (!val) {
            return isRange ? getTimecodeRangePlaceholder() : (isTimecode ? getTimecodePlaceholder() : (isDuration ? getDurationPlaceholder() : null));
        }

        return isRange  ? (process(val && val.from  ? val.from  : 0) + ' – ' + process(val && val.to  ? val.to  : 0)) :
                process(val);

        function process(v) {
            var info = getEstTimeInfo(v, res);
            if (isTimecode) {
                return (isRange ? '' : (pad(info.hours) + ':')) +
                pad(info.minutes) + ':' + pad(info.seconds) +
                (isRange ? '' : (':' + pad(info.milliseconds)));
            }
            return ((isDuration || !info.hours) ? '' : (info.hours + 'h ')) +
                pad(info.minutes, 'm') +
                (isDuration ? (':' + pad(info.seconds, 's')) : '');

            function pad(s, t) {
                return ((isDuration || isTimecode) && s < 10 ? '0' : '') + s + (isDuration ? '' : (t || ''));
            }
        }
    }

    //convert 1.5h value to {h, m, s, ms}
    function getEstTimeInfo(v, res) {
        var isDuration = res ? res.isDuration : false,
            isTimecode = res ? res.isTimecode : false;

        if (v === null || v === undefined) {
            v = 0;
        }
        if (isDuration) { //in seconds
            var s = v % 60,
                dif = v - s;
            return {seconds: s, minutes: dif > 0 ? dif / 60 : 0}; //min , sec
        } else if (isTimecode) { //in milliseconds
            //m   s     ms
            var res1 = {},

                r = getDiv(v, 3600000);
            res1.hours = r.c;

            r = getDiv(r.n, 60000);
            res1.minutes = r.c;

            r = getDiv(r.n, 1000);
            res1.seconds = r.c;
            res1.milliseconds = r.n;

            return res1;

            function getDiv(v, div) {
                var c = (v >= div) ? ((v - v % div) / div) : 0;
                return {
                    c: c || 0,
                    n: (v - c * div) || 0
                };
            }
        } else {
            var isCeil = v % 1 * 10000 > 9988, //998.9999999999987
                h = v ? (isCeil ? Math.ceil(v) : Math.floor(v)) : 0, //1
                p = isCeil ? 0 : (v - h); //.5
            return {
                hours: h,
                minutes: p > 0 ? Math.round(p * 60) : 0,
                seconds: 0,
                milliseconds: 0
            };
        }
    }

    function getSecondsToHour(s) {
        var el = {};
        _.each(moment.utc(s * 1000).format('HH:mm:ss').split(':'), function (v, i) {
            el[i === 0 ? 'h' : (i === 1 ? 'm' : 's')] = parseInt(v, 10);
        });
        return el //h:, m: , s:
    }

    function getBannerColor(item) {
        return getColorForProp(item, 'text');
    }

    function getBorderColor(item) {
        return getColorForProp(item, 'border');
    }

    function getHtmlTooltipContent(val) {
        return val ? truncate(extractContentFromHTML(val), 100) : null;

        function truncate(input, count) {
            if (input.length > count) {
                return input.substring(0, count) + '…';
            }
            return input;
        }
    }

    function extractContentFromHTML(s) {
        var span = document.createElement('span');
        span.innerHTML = s;
        return span.textContent || span.innerText;
    }

    function canUpdateFieldContent(c){
        return c && (c.canEdit || c.canChangeOnEdit);
    }

     function displayHtmlTooltipContent($ctrl, canEdit, c, content, getClickEventName, textOnly, noQuota) {
        var hasContent = content ? extractContentFromHTML(content) : false,
            t = hasContent && content ? content : (canEdit ? 'Add Notes' : null),
            canUpdate = service.canUpdateFieldContent(c);
        //todo: for text only display the text
         var propN = 'tooltip-content ql-editor view-mode sb-prop-' +  c.prop + (hasContent ? '' : ' sb-hide');
    return  '<div class="position-relative with-html-tooltip '+(c.leftaligned ? 'leftaligned' : '') + '">' +
                '<a class="display-block see-breakdown gray-light ' +
                    //(content ? 'colored-svg ' : '') +
    (getClickEventName ? getClickEventName(noQuota ? 'openProPopup' : 'viewNotes') : '') + '"' +
           (noQuota ? (' data-quota="' + c.quotaType + '"') : '') +
                ' analytics-on analytics-action="Open Notes"><div class="sbf bnote display-block centered '+ (hasContent ? 'blue ' : 'gray') + '"></div>' +
                '</a>'+
                ($ctrl.isGridView && c.displayInlineContent ?
                    //$ctrl.SBFieldTypesService.getViewEditElemSelector(prop, false, canUpdate)
                  ('<div class="' + propN + '  ">' + (t||'') + '</div>') :
                  ((canUpdate || content)  ? ('<div class="tooltip tooltip-inline left"><div class="tooltip-inner '+ propN + '">' + (t||'') +'</div></div>') : '')) +
            '</div>';
    }

    function displayBigCheck(canEdit, tooltipPlacement, dateFormat, stats, getCreatedAt, textOnly) {
        var tp = tooltipPlacement ? tooltipPlacement : 'left',
            date = stats && stats.completedAt ? (' on ' + getCreatedAt(stats.completedAt, dateFormat)) : '',
            name = stats && stats.completedBy ? (' by ' + stats.completedBy.name) : '',
            val = stats && stats.completed ? true : false,
            tooltip = (val ? ('Completed ' + name + date + '. ') : '')
               //+ (canEdit ? ('Mark as ' + (val ? 'Uncomplete' : 'Complete')) : '')
                ;
        return textOnly ? (val ? tooltip : '') : displaySimpleCheck(canEdit, val, false, tooltip, tp);
    }

    function displaySimpleCheck(canEdit, val, textOnly, tooltip, tp) {
        if(textOnly){
            return val ? '✔' : '';
        }
        return '<div class="custom-checkbox circled inrow ' + (canEdit ? 'editable' : '') + '"' +
            (tooltip ? ('tooltip-html="\'' + tooltip + '\'" tooltip-placement="' + tp + '"' +
                (canEdit ? ' tooltip-clear-cache="true"' : '')
            ) : '') +
            '><label class="i-check"><input type="checkbox" ' + (canEdit ? '' : 'disabled="disabled" ') + (val ? 'checked="checked"' : '') + '><span></span></label></div>';
    }

    function getColorForProp(item, prop) {
        var id = item.color;
        if (!id || id === '#46667F') {
            return prop === 'border' ? 'rgba(255, 255, 255, 0.3)' : '#4c5359';
        }
        var c = service.Colors;
        for (var i = 0, n = c.length; i < n; i++) {
            var el = c[i];
            if (el.id === id) {
                return el[prop];
            }
        }
    }

    function getShotNo(item, type, prop) {
        if(!item){return '';}
        var empty = '–';
        var c = 'custom' + prop.replace(prop[0], prop[0].toUpperCase());
        switch (type ? type.toString() : empty) {
            case '3':
                return item[c] ? item[c] : empty;//custom shot number
            case '2': //alphabetical
                return item[prop] ? String.fromCharCode(item[prop] + 64) : empty;
            default:
                return item[prop] ? item[prop] : empty;//numerical
        }
    }

    function getSceneFractions() {
        var mpc = 20, sf = [];
        for (var i = 0; i < mpc; i++) {
            for (var j = 0; j < FR.length; j++) {
                var el = FR[j];
                sf.push({
                    page: i === 0 ? null : i.toString(),
                    value: i + el.value,
                    fr: i === 0 && j === 0 ? '–' : el.text
                });
            }
        }

        sf.push({
            page: mpc.toString(),
            value: mpc,
            fr: '–'
        });

        return sf;
    }

    function getColor(id, hide, isDay){
        if(!id){return null;}
        return (isDay === undefined ? tinycolor(id).isLight() : isDay)? getDayColor(id, hide) : getNightColor(id, hide);
    }

    function getBannerColorCls(color) {
        var sel = _.find(service.Colors, function (el) {
            return el.id && color && color.toUpperCase() === el.id;
        });
        return sel ? sel.cls : 'isnight';
    }

    function getPagesDisplay(item){
        return item.pagesCustom ? item.pagesCustom : item.pages;
    }
    function getMiniTitle(item, likeOnScript) {
        if (!item) {
            return '';
        }
        switch (item.type) {
            case 1:
                if(likeOnScript && item.name){
                    return item.name;
                }
                var l = item.stripLocation ? item.stripLocation.name : '';
                var t = getSceneType(item).text;
                if (t !== '–') {
                    l = t + '. ' + l;
                }
                var d = service.getTimeDayDisplay(item);
                if (d !== '–') {
                    l += ' - ' + d;
                }
                return l.toUpperCase();
            case 0:
            case 2:
                return item.name || '';
        }
    }

    function getColorClass(item) {
        if (!item) {
            return null;
        }
        switch (item.type) {
            case 1:
                var d = item.dayTime, s = item.sceneType;
                if (!s) {
                    s = 1;
                }
                if (s === 2) {
                    s = 1;
                }
                if (s === 4) {
                    s = 3;
                }
                return 'stripcolor' + d + s + ' ' + (d ===10 ? 'isday' : (d >= 5 && !(d === 6 && s === 1) ? 'isnight' : 'isday'));
            case 0:
                return 'daybreak';
            case 2:
                return 'banner hastype ' + getBannerColorCls(item.color);
        }
        return null;
    }

    function getListVal(list, val, prop) {
        if (val === null || val === undefined) {
            return list[0];
        }
        for (var i = 0; i < list.length; i++) {
            var sc = list[i];
            if (sc[prop ? prop : 'value'] === val) {
                return sc;
            }
        }
        return list[0];
    }

    function getScenePage(item, prop) {
        var val = item ? item[prop ? prop : 'pages'] : 0;
        if (val === 0 || val == undefined) {
            return service.SceneFractions[0];
        }
        var p = Math.floor(val);
        var fr = null;
        _.each(FR, function (el) {
            if (el.value === (val - p)) {
                fr = el.text;
            }
        });
        return {
            page: p === 0 ? null : p.toString(),
            value: val,
            fr: fr
        };
    }

    function getTimeDay(item, prop) {
        if (!prop) {
            prop = 'dayTime';
        }
        return item ? getListVal(service.SceneTimeOfDay, item[prop]) : null;
    }

    function getTimeDayDisplay(item, prop) {
        if (!prop) {
            prop = 'dayTime';
        }
        var x = item ? service.getTimeDay(item, prop) : null;
        return x ? x.desc : null;
        //return x ? (x.value === 4 ? 'After- noon' : x.desc) : null;
    }

    function getTopCall(item, prop) {
        var x = item ? getListVal(service.TopCalls, item[prop], 'id') : null;
        return x ? x.text : null;
    }

    function getSceneType(item, prop) {
        return item ? getListVal(service.SceneTypes, item[prop ? prop : 'sceneType']) : null;
    }

    function getSceneTypeText(item, prop) {
        if (!prop) {
            prop = 'sceneType';
        }
        var opt = item && item[prop] ? getSceneType(item, prop) : null;
        return opt ? opt.text : null;
    }

    function getSceneText(item) {
        return item && item.scene ? item.scene.toString().toUpperCase() : '–';
    }

    function displayDate(val, getCreatedAt, dateFormat) {
        return val ? getCreatedAt(val, dateFormat) : null;
    }
    function displayRate(val, getCurrentRate, textOnly) {
        if (!val || val.v == null) {
            return null;
        }
        var r = getCurrentRate(val.v || 0),
            ph = _.find(service.PaymentRates, function (item) {
                return item.value === val.t;
            }).short;

        return textOnly ? (r+'/'+ph):
            ('<span class="rate-no">' + r + '</span><span class="rate-h">/' + ph + '</span>');

    }

    function displayCheck(val, c, initList) {
        if (!val) {
            return null;
        }

        var separator = ' / ';
        switch (c.type) {
            case service.PropTypes.Check:
                var text = '';
                for (var j = 0; j < val.length; j++) {
                    var t = val[j];
                    var el = t.id === 'custom' ? t.name : getValById(t);
                    if (el) {
                        text += el + separator;
                    }
                }

                if (text !== '') {
                    text = text.substring(0, text.lastIndexOf(separator));
                }

                return text === '' ? null : text;

            case service.PropTypes.Radio:
                return val.id === 'custom' ? val.name : getValById(val);

            default:
                return null;
        }

        function getValById(id) {
            var el = _.find(initList, function (item) {
                return item.id === id;
            });
            return el ? (el.short ? el.short : el.name) : null;
        }
    }

    function getDrp(val, c, initList) {
        var value = c.itemValue ? c.itemValue : 'value',
            item = _.find(initList, function (item) {
                return item[value] === val;
            }),
            text = item ? item[c.itemLabel ? c.itemLabel : 'text'] : null;
        if (c.withColor) {
            return '<div class="selected with-color inline-block"><div class="circle-container-10" style="background-color: ' + (item ? item.color : '') + '"></div></div>' +
                (c.withoutText ? '' : (text ? ('<div class="todo-status-name statusname centered inline-block">' + text + '</div>') : ''));
        } else {
            return text;
        }
    }

    function getDrpColor(val, c, initList) {
        var defaultColor = c.defaultColor !== undefined ? c.defaultColor : DefaultTodoCardColor;
        var value = c.itemValue ? c.itemValue : 'value',
            item = _.find(initList, function (item) {
                return item[value] && val && item[value].toLowerCase() === val.toLowerCase();
            }),
            itemValue = item ? item[value] : null,
            color = val || defaultColor,
            text = item ? item.text : ((!color || color && tinycolor(color).isLight()) ? 'var(--body-color)':'#fff'),
        border = val ? color : 'var(--checkBorder)';
        return '<div class="dropdown-sel-text drp-color centering text-center' + (c.square ? ' square' : '') + '" style="text-align:center;background-color:' + (item ? itemValue : color) + ';' +
            getColor()+
            ((!item || item && (itemValue === '#FFFFFF' || itemValue === 'rgb(255, 255, 255)')) ? (';border:1px solid ' + border
            ) : '') +
                '">' +
            '<span class="sbf custom-drp-img ' + (c.icon || 'background-color') + '" style="'+getColor(true)+'">' + LCS.getISBPath(c.icon ? c.iconLevel : 3) + '</span>' +
            '</div>';

        function getColor(isImp){
            return 'color:' + text + (isImp ? isImp : '!important');
        }
    }

    function getTime(val, timeFormat) {
        val = service.MomentService.stringToUTCMoment(val, false);
        return val ? val.format(timeFormat) : null;
    }

    function getComplexTime(val, c, initList, timeFormat) {
        if(!val){return null;}
        if(val.isTime){
            return getTime(val.value, timeFormat);
        }else{
            var el = _.find(initList, function (el) {
return el.val === val.value;
            });
            return el ? el.text : null;
        }
    }
    function getIcon(val, c, initList) {
        var value = c.itemValue ? c.itemValue : 'id';
        var item = _.find(initList, function (item) {
            return item[value] === val;
        });
        //return item ? item[value] : null;
        return item ? ('<div class="sbf' + (c.isSvg ? '-svg' : '') + ' ' +
            (c.fieldClass ? c.fieldClass : '') +
            ' colored icon inline-block ' + item[value] + '"></div>') : null;
    }

    function getCharacters(canEdit, c, val, list, item, textOnly, isPrintLayout) {
        return processInterList(textOnly, list, c, val, item, function (el, i, l) {
         return textOnly ? (el.name + (el.currentId ? ('('+el.currentId+')') :'')) :
            ('<div class="numbered-char display-inline with-margin2' + (canEdit ? ' with_underline' : '') + '" ' +
                (el.name && !isPrintLayout ? ('tooltip-placement="top" tooltip="' + el.name + '" ') : '') +
                '>' + (el.currentId ? el.currentId : ' ') + '</div>');
        });
    }

    function getLocations(canEdit, c, val, list, item, textOnly, isPrintLayout) {
        return processInterList(textOnly, list, c, val, item, function (el, i, l) {
            return textOnly ? (el.name ? el.name : '') :
                ('<div class="table-div full-width locationsselector' +
                    (i !== 0 && l > 1 ? ' padding-top-5' : '') +
                    '"><div class="centered col20"><div class="pull-left sidepin sbf pin blue"></div></div> ' +
                    '<div class="centered ' + (canEdit ? 'with_underline' : '') +
                    (isPrintLayout ? '' : ' with-ellipsis') +
                    '">' + (el.name ? el.name : '–') + '</div>' +
                    '</div>');
        });
    }

    function getStripLocation(canEdit, c, val, list, item, textOnly, isPrintLayout) {
        return processInterList(textOnly, list, c, val, item, function (el, i, l ) {
            return textOnly ? (el.name ? el.name :'') :
                ('<div class="display-block'+
                    (i!==0&& l>1 ? ' padding-top-5' : '')+
                    '"> ' +
                    '<div class="' + (canEdit ? 'with_underline' : '') +
                    (isPrintLayout ? '' : ' with-ellipsis') +
                    '">' + (el.name ? el.name : '–') + '</div>' +
                '</div>');
        });
        // content = item && item.stripLocation && item.stripLocation.name ? item.stripLocation.name.toUpperCase() : null ;
        //
    }

    function processInterList(textOnly, list, c, val, item, processEl) {
        if (!val || !val.length) {
            return null;
        }
        var l = getElsInList(list, val);
        if (!l) {
            return null;
        }
        var res = '';
        if (!l) {
            return res;
        }
        _.each(l, function (el, i) {
            res += processEl(el, i, l.length) + (textOnly ? (i + 1 === l.length ? '' : ', ') : '');
        });
        return res.trim() === '' ? null : res;
    }

    function getElementsCount(canEdit, c, val, item, textOnly) {
        var el = (item.elements ? item.elements : 0)
        return textOnly ? el : ('<span class="page display-block">' + el + '</span>');
    }

    function getCollaboratorsForList($ctrl, uId, todoPageId) {
        var team = $ctrl.RouteCollaboratorsService.getProjectTeam($ctrl.CPS.product),
            userCollabs = $ctrl.RouteCollaboratorsService.getUserCollaborators(uId, $ctrl.RouteCollaboratorsService.BlocksSetupService.getTodoPageById(todoPageId)),
            membersCount = (userCollabs && userCollabs.length > 0 ? userCollabs.length : 0) + (team ? team.length : 0);

        return {
            membersCountTxt: (membersCount + ' member' + (membersCount === 1 ? '' : 's')),
            userCollabs: userCollabs,
            team: team,
            tooltip: getTooltip()
        }

        function getTooltip() {
            var v = '';
            process(userCollabs);
            process(team);
            return v;

            function process(val) {
                if (val && val.length > 0) {
                    _.each(val, function (item) {
                        if (item && item.name) {
                            v += item.name + '<br>';
                        }
                    });
                }
            }
        }
    }

    function getLikes($ctrl, canUpdate, c, item, textOnly) {
        var security = $ctrl.security,
            result = getCollaboratorsForList($ctrl, c.uId, c.todoPageId),
            team = result.team,
            userCollabs = result.userCollabs,
            collab, i, el = '';
        if (!c.circleSize) {
            c.circleSize = 'little';
        }
        if (c.maxCount === undefined) {
            c.maxCount = 100;
        }
        if (!c.showOnlyCounter && userCollabs) {
            var max = c.showAllTeam ? team.length : (team.length < c.maxCount ? team.length : c.maxCount);
            for (i = 0; i < max; i++) {
                el += getImg(security, team[i], false, i);
            }
            var nmax = c.maxCount - max;
            for (i = 0; i < userCollabs.length; i++) {
                collab = userCollabs[i];
                if (!collab.isGeneral && (i < nmax || (i >= nmax && c.showAllTeam))) {
                    el += getImg(security, collab, true, i);
                }
            }
        }

        if (textOnly) {
            return;
        }
        el += '<div class="user1 one-line-tooltip hide-print">' +
            '<a ' + (c.showOnlyCounter ? 'class="gray-underlined-hover"' : '') + '>';
        if (c.showOnlyCounter) {
            el += "<div tooltip-placement='bottom' tooltip-html=\"'" + result.tooltip + "'\">" + result.membersCountTxt + "</div>";
        } else {
            el += '<div class="thumb-sm with-radius ' + c.circleSize + '" tooltip-placement="bottom" tooltip="' +
                (canUpdate ? 'Invite' : 'See') + ' People' +
                '">' + getShareLink() + '</div>';
        }
        el += '</a>' +
            '</div>';
        return el;

        function getImg(security, item, isCollab) {
            if (textOnly) {
                return item.name;
            }
            return '<div class="user1">' +
                security.getImage(item, c.circleSize, 'profilePictureURL', 50, {
                    tooltip: item.name + (isCollab ? ('<br>Can ' + (item.permission === 1 ? 'View' : (item.permission === 2 ? 'Comment' : 'Edit'))) : '')
                }) +
                '</div>';
        }
    }

    function getCollaborators($ctrl, canUpdate, c, item, textOnly) {
        var security = $ctrl.security,
            result = getCollaboratorsForList($ctrl, c.uId, c.todoPageId),
            team = result.team,
            userCollabs = result.userCollabs,
            collab, i, el = '';
        if (!c.circleSize) {
            c.circleSize = 'little';
        }
        if (c.maxCount === undefined) {
            c.maxCount = 100;
        }
        if (!c.showOnlyCounter && userCollabs) {
            var max = c.showAllTeam ? team.length : (team.length < c.maxCount ? team.length : c.maxCount);
            for (i = 0; i < max; i++) {
                el += getImg(security, team[i], false, i);
            }
            var nmax = c.maxCount - max;
            for (i = 0; i < userCollabs.length; i++) {
                collab = userCollabs[i];
                if (!collab.isGeneral && (i < nmax || (i >= nmax && c.showAllTeam))) {
                    el += getImg(security, collab, true, i);
                }
            }
        }

        if (textOnly) {
            return;
        }
        el += '<div class="user1 one-line-tooltip hide-print">' +
            '<a ' + (c.showOnlyCounter ? 'class="gray-underlined-hover"' : '') + '>';
        if (c.showOnlyCounter) {
            el += "<div class='with-tooltip inline  with-cursor' " +
                //" tooltip-placement='bottom' tooltip-html=\"'" + result.tooltip + "'\"" +
                ">" + result.membersCountTxt +

                ('<div class="tooltip tooltip-inline bottom"><div class="tooltip-inner">' + result.tooltip +'</div></div>') +
                "</div>";
        } else {
            el += '<div class="thumb-sm with-radius ' + c.circleSize + '" tooltip-placement="bottom" tooltip="' +
                (canUpdate ? 'Invite' : 'See') + ' People' +
                '">' + getShareLink() + '</div>';
        }
        el += '</a>' +
            '</div>';
        return el;

        function getImg(security, item, isCollab, i) {
            if (textOnly) {
                return item.name;
            }
            return '<div class="user1">' +
                security.getImage(item, c.circleSize, 'profilePictureURL', 50, {
                    tooltip: item.name + (isCollab ? ('<br>Can ' + (item.permission === 1 ? 'View' : (item.permission === 2 ? 'Comment' : 'Edit'))) : '')
                }) +
                '</div>';
        }
    }
    function getProjects($ctrl, val, c, projects, security) {
        c = _.extend(c, {
            withoutDefaultMembers: true,
            isAssign: true,
            txt: c.canEdit ? 'Assign Projects' : '',
            logoField: 'logo'
        });
        return getMembers($ctrl, val, c, projects, security);
    }

    function getTeam($ctrl, val, c, team, security) {
        c = _.extend(c, {
            txt: (c.isAssign ? (c.canEdit ? 'Assign Team' : '') : ((c.canEdit ? 'Invite' : 'See') + ' People')),
            logoField: 'profilePictureURL',
            withRole: false
            //$ctrl.isInModal is undefined if is in popover
        });
        if ($ctrl.isInModal === false) {
            if ($ctrl.isCommentsSidebar) {
                c.circleSize = 'small14';
            }
            if ($ctrl.isLikeWorkflow && !$ctrl.isCommentsSidebar) {
                c.circleSize = 'small24';
            } else if (!$ctrl.isCommentsSidebar) {
                c.circleSize = 'small14';
            }
        }
        return getMembers($ctrl, val, c, team, security);
    }

    function getMembers($ctrl, val, c, team, security) {
        var types = security.MemberTypes,
            t = c.txt,

            members = [],
            membersL = val && val.length ? val.length : 0;

        if (membersL > 0) {
            for (var i = membersL - 1; i >= 0; i--) {
                var el = _.find(team, function (item) {
                    return item._id === val[i]; //MemberTypes.Member
                });

                if (el && !_.find(members, {_id: el._id})) {
                    members.push(el);
                }
            }
        }
        var defaultMembers = _.filter(team, function (item) {
            if (c.withoutDefaultMembers === 'true' || c.withoutDefaultMembers === true) {
                return false;
            } else {
                return (item.memberType === types.Owner || item.memberType === types.Admin) &&
                    // if team members are in team dont consider them twice
                    !_.find(members, {_id: item._id});
            }
        });

        if (!c.circleSize) {
            c.circleSize = 'mini';
        }

        if (c.maxCount === undefined) {
            c.maxCount = 100;
        }

        var el = '', i,
            dl = defaultMembers.length,
            ml = members.length,
            nonShowMembersCount = (dl + ml) - (c.showOnlyCounter ? 0 : c.maxCount);
        if (nonShowMembersCount < 0) {
            nonShowMembersCount = 0;
        }
        //Don't show if only one team member

        var tp = c.tooltipPlacement || 'top';

        if (!c.showOnlyCounter) {
            var max = c.showAllTeam ? ml : (ml < c.maxCount ? ml : c.maxCount),
                els = [];


            //set current first
            if (c.currentId) {
                var index = -1;
                if (dl > 0) {
                    index = removeFromList(defaultMembers);
                }
                if (index === -1 && ml > 0) {
                    index = removeFromList(members);
                }
            }

            for (i = 0; i < max; i++) {
                els.push(members[i]);
            }

            var nmax = c.maxCount - max;
            for (i = 0; i < dl; i++) {
                var m = defaultMembers[i];
                if (m && (i < nmax || (i >= nmax && c.showAllTeam))) {
                    if (!_.find(els, {_id: m._id})) {
                        els.push(m);
                    }
                }
            }
            el = els.map(getImg).join('');

            function removeFromList(list) {
                var index = _.findIndex(list, {_id: c.currentId});
                if (index !== -1) {
                    els.push(list[index]);
                    list.splice(index, 1);
                    max = max - 1;
                }
                return index;
            }
        }

        if ((!el || el === '') && c.canEdit) {
            el += '<div class="user1 one-line-tooltip hide-print">' +
                '<a class="display-block with-cursor"' + getT(t) + '>' + getCounterCircle() + '</a>' +
                '</div>';
        } else if (c.showOnlyCounter || nonShowMembersCount > 0) {
            el += '<div class="user1 one-line-tooltip hide-print">' +
                '<a class="display-block"' + (c.showOnlyCounter ? ' class="gray-underlined-hover"' : '') + getT(getTooltip(), true)+ '>' + get() + '</a>' +
                '</div>';

            function get() {
                if (c.showOnlyCounter) {
                    return '<div class="with-tooltip inline' + (c.canEdit ? ' with-cursor' : '') + '">' +
                        (nonShowMembersCount + ' member' + (nonShowMembersCount === 1 ? '' : 's')) +
                        "</div>";
                } else {
                    return getCounterCircle();
                }
            }
        }

        return '<div class="team-members one-line-tooltip ' + (c.canEdit ? ' with-cursor' : '') + (c.maxCount ? ' moreusers ' : '') + c.circleSize + '">' + el + '</div>';

        function getT(t, isHtml){
            return (t ? (' tooltip'+(isHtml?'-html':'')+'="'+(isHtml?'\'':'')+ t +(isHtml?'\'':'')+ '" tooltip-placement="' + tp + '"') : '')
        }


        function getCounterCircle() {
            return '<div class="thumb-sm with-radius ' + c.circleSize + '">' +
                (c.withCount && nonShowMembersCount ? ('<div class="avatar semibold">+' + nonShowMembersCount + '</div>') : getShareLink()) +
                '</div>';
        }

        function getImg(item) {
            var m = c.withRole ? _.find(service.MemberTypes, function (el) {
                return el.value === item.memberType;
            }) : null;


            var t = c.withRole ? (
                (item.name ? ('<semibold>' + escape(item.name) + '</semibold>') : '') +
                '<div>' + escape(m ? m.text : '') + '</div>'
            ) : (item.name ? escape(item.name) : '');
            return '<div class="user1" tooltip-placement="' + tp + '" ' + (c.withRole ? 'tooltip-html' : 'tooltip') + '="' + t + '">' +
                security.getImage(item, c.circleSize ? c.circleSize : 'smaller', c.logoField, 100) +
                '</div>';

            function escape(txt) {
                return txt ? txt.replace(/'/g, '&#39;').replace(/&/g, '&amp;').replace(/"/g, '&#34;') : '';
            }
        }

        function getTooltip() {
            return process(members) + process(defaultMembers);

            function process(val) {
                return val && val.length > 0 ? val.map(function (item) {
                    return item && item.name ? (item.name + '<br>') : '';
                }).join('') : '';
            }
        }
    }

    function getMiniStripRowSchedule(item, active) {
        return '<div class="row-schedule colored-col side-borders border-top hastype font-size-10 ' + (service.getColorClass(item) || '') + '">' +
                    '<div class="border-right text-center col30">' + service.getSceneText(item) + '</div>' +
                    '<div class="with-padding-left uppercase grow-column">' +
                        '<div class="with-ellipsis">' + service.getMiniTitle(item) + '</div>' +
                        (active ? '' : '<div class="omitted">OMITTED</div>') +
                    '</div>' +
                '</div>';
    }

    function getPages(item, cls, textOnly, prop) {
        var p = item.pages && item.pages.fr ? item.pages : getScenePage(item, prop),
            page = p.page,
            fr = p.fr;
        return textOnly ? ((page ? (page + ' ') : '') + fr) : ('<div class="' + (cls ? cls : 'display-block') + '">' +
(prop === 'pagesDisplay' && item.pagesCustom ? LCS.getISBDiv('asterisk', 2, 'pull-left sidepin gray with-margin-right hide-print') : '') +
            (page ? ('<span class="page">' + page + '</span>&nbsp;') : '') +
            '<span class="fr">' + fr + '</span>' +
            '</div>');
        // + '<div class="fr display-block full-width">pages</div>';
    }

    function getElsInList(list, ids) {
        var l;
        if (ids && ids.length > 0 && list && list.length > 0) {
            l = _.sortBy(_.filter(list, function (el) {
                return (el && ids.indexOf(el._id) !== -1);
            }), 'order');
        }
        return l && l.length > 0 ? l : null;
    }

    function getAdjustRoles($ctrl, item, canUpdate, depId, textOnly) {
        var list = service.getListOfRoles($ctrl, item, depId),
            cls = '';
        if (!list) {
            return textOnly ? '' : ('<div class="with-hover placeholder hide-print gray-light ' + (cls ? cls : '') + '">' + (canUpdate ? ($ctrl.isMobileView() ? '–' : 'Assign Role…') : '') + '</div>');
        }
        var begining = textOnly ? '' : '<div style="float:{be}">',
            end = textOnly ? ', ' : '</div>',
            text = '';
        _.each(list, function (n, i) {
            text += begining.replace('{be}', (i === n - 1 ? 'left' : 'none')) + n +
                (textOnly && (i === list.length - 1) ? '' : end);

        });
        return textOnly ? text : ('<div class="rolesText  ' + (cls ? cls : '') + '">' + text + '</div>');
    }

    function getShareLink(){
        return '<div class="avatar">'+LCS.getISBDiv('team',2)+'</div>';
    }
}

angular.module('sb.fields.types.service', [
    'sb.fields.methods.service',
    'sb.fields.phone.service'
])
.service('SBFieldTypesService', SBFieldTypesService);
SBFieldTypesService.$inject = ['SBFieldMethods'];
function SBFieldTypesService( SBFieldMethods) {
    var service = this;
    service.SBFieldMethods = SBFieldMethods;
    service.PropTypes = SBFieldMethods.PropTypes;
    service.canUpdateField = SBFieldMethods.canUpdateField;

    service.SBViewWithEllipsisCls ='with-ellipsis';
    service.SBPlaceholderCls = 'sb-placeholder';
    service.SBFieldMoreTrigger = 'sb-more';
    service.SBFieldEditableTrigger = 'sb-editable-trigger';
    service.SBOpenFieldEditableTrigger = 'sb-open-editable-trigger';
    service.SBNoTableClick = 'sb-no-table-click';
    service.SBEditableOuter = 'sb-editable-outer';
    service.SBFieldEditable = 'with-sb-editable';
    service.SBViewBlock = 'with-sb-view';
    service.SBViewEditBlock = 'with-sb-view-edit';
    service.SBViewEmpty = 'sb-view-empty';
    service.SBEditBlock = 'with-sb-edit';
    service.SBPropMark = 'sb-prop-';
    service.SBViewContentCls = 'sb-view-content';

    service.getStyleProps = getStyleProps;

    service.getLikesCommentsProps = getLikesCommentsProps;
    service.extractContentFromHTML = SBFieldMethods.extractContentFromHTML;
    service.getSBFieldContentView = SBFieldMethods.getSBFieldContentView;
    service.getValFromProp = SBFieldMethods.getValFromProp;
    service.setValForProp = SBFieldMethods.setValForProp;
    service.canUpdateFieldContent = SBFieldMethods.canUpdateFieldContent;

    service.getEditFieldClass = getEditFieldClass;
    service.getColDisplayDiv = getColDisplayDiv;
    service.getSBFieldContentEdit = getSBFieldContentEdit;
    service.getSBColContentView = getSBColContentView;
    service.getViewEditElemSelector = getViewEditElemSelector;
    service.getDefaulSBEditProps = getDefaulSBEditProps;
    service.getDefaultFieldProps = getDefaultFieldProps;
    service.getSBForm = getSBForm;
    service.getPopupSBForm = getPopupSBForm;
    service.getElementId = getElementId;
    service.getElementIdFromItem = getElementIdFromItem;
    service.getSBContentEditObjectParams = getSBContentEditObjectParams;
    service.getSBColContentEdit = getSBColContentEdit;
    service.getSBColContentEditTag = getSBColContentEditTag;
    service.getEditFieldForCol = getEditFieldForCol;
    service.getPropFromClass = getPropFromClass;
    service.getColDisplayEl = getColDisplayEl;
    service.getLabel = getLabel;
    service.getClickEventEditable = getClickEventEditable;
    service.getPropMark = getPropMark;
    service.getCSSProp = getCSSProp;
    service.getCustomStyle = getCustomStyle;
    service.getStyle = getStyle;
    service.getCSSClassFromProp = getCSSClassFromProp;

    function getLikesCommentsProps(){

    }

    function getStyleProps(){
        return ['bgColor', 'fontColor', 'hColor', 'border'];
    }

    function getCSSProp(p, isNotCustomNotes){
        switch (p){
            case 'bgColor': return isNotCustomNotes ? 'background-color' : '--bg-color';
            case 'fontColor': return '--gray-header';
            case 'hColor': return '--h-color';
            case 'border': return '--bg-border';
        }
    }
    function getWithoutCloseParams(){
        return {
            withoutClose: true,
            withService: false
        };
    }

    function getPopupSBForm($ctrl, columns, otherParams) {
        return $ctrl.SBFieldTypesService.getSBForm($ctrl, $ctrl.item._id, columns, _.extend({
            objectType: typeof($ctrl.item.getType) === 'function' ? $ctrl.item.getType() : $ctrl.objectType,
        } , getWithoutCloseParams(), otherParams));
    }

    function getClickEventEditable(type) {
        return type === 'sbEditable' ? service.SBFieldEditableTrigger : service.SBOpenFieldEditableTrigger;
    }

    function getEditFieldClass(type, withoutHover){
        var el;
        switch (type) {
            case service.PropTypes.Html:
            case service.PropTypes.Contenteditable:
                el = 'autogrow word-wrap contenteditable'; break;
            case service.PropTypes.Address: el = 'contenteditable'; break;
            default: el = ''; break;
        }

        return el;
        //without-underline '+(withoutHover? '' : ' hover-underline');
    }

    function getColDisplayDiv($ctrl, item, c, colCls ) {
        return getColDisplayEl($ctrl, item, c, colCls, c.withoutDiv ? null : 'div');
    }

    function getPropMark(prop){
        return prop ? (service.SBPropMark + prop.replace('.', '_')) : '';
    }

    function getColDisplayEl($ctrl, item, c, colCls, type) {
        var listIndex = 0,
            canUpdate = service.canUpdateField($ctrl, c) && !$ctrl.isPrintLayout,
           // canUpdate1 = canUpdate && (c.canEdit || c.canChangeOnEdit) ,
            textOnly = type === null;
        if ($ctrl.isPrintLayout){
            c.withEllipsis = false;
        }
        if ($ctrl.isPrintLayout && c.type === $ctrl.SBFieldTypesService.PropTypes.HtmlTooltip) {
            c.type = $ctrl.SBFieldTypesService.PropTypes.Html;
        }
        if (c.type === $ctrl.SBFieldTypesService.PropTypes.Picture) {
            return get(null, function () {
                return $ctrl.getImageTemplate(item, c);
            });
        }
        else if (c.type === $ctrl.SBFieldTypesService.PropTypes.Position) {
            return get(null, function () {
                    var r = $ctrl.getAdjustRoles(item, canUpdate, c.depId, textOnly),
                        txt = (!canUpdate && c.hideEmptyContent || !r && textOnly) ? '' : r;
                    return textOnly ? txt : ('<div class="' + service.getViewEditElemSelector(c.prop, true, $ctrl.canEdit) + '">'+ txt + '</div>');
                },
                canUpdate ? ('with_underline ' + $ctrl.getClickEventName('adjustRoles')): 'inactive',
                canUpdate ? 'analytics-on analytics-action="Open Adjust Roles"' : ''
            );
        }
        else {
            var v = service.getSBColContentView($ctrl, item, c, listIndex, textOnly);
            if (textOnly) {
                return v;
            } else {
                if ($ctrl.isPrintLayout && !v) {
                    return '';
                }
                if (!canUpdate) {
                    //console.log(c.prop);
                    colCls = colCls ? colCls
                        .replace('form-control', '')
                        .replace('hover-underline', '')
                        .replace('with-underline', '') : '';
                }
                return get(canUpdate ? (service.SBFieldEditable + ' sb-col-' + c.prop + (c.editableContainerClass ? (' ' + c.editableContainerClass) : '')) : '', function () {
                    return v;
                });
            }
        }

        function get(cls, process, otherCls, otherProps) {
            var pr = process();
            if(!pr && c.dontPreserveDiv){return '';}
            return type ? ('<' + type + ' class="' +
                    (c.grow ? ' grow-column ' : '') +
                    (colCls ? colCls : '') +
                    (cls ? (' ' + cls) : '') +
                    (otherCls ? (' ' + otherCls) : '') +
                '" ' +
                (otherProps||'')+
                '>' + pr + '</' + type + '>') : pr;
        }
    }
    /*
        var val = item[col.prop];
    if(col.trimTooltip){
        var s =  val ? val.substring(0, 30) : '';
        var tooltip = (col.trimTooltip && val && val.length > 30 ? (' tooltip-placement="bottom" tooltip="' + s + '"') : '');
    }*/

    function getSBFieldContentEdit($ctrl1, value, c) {
        //in the editable field
        //initList?
        var $ctrl = _.extend({canEdit: true}, $ctrl1),
            item = {};
        item = service.setValForProp(item, $ctrl.prop, value ? value : $ctrl.value);
        //item[$ctrl.prop] = value ? value : $ctrl.value;
        if ($ctrl.canEdit === undefined) {
            $ctrl.canEdit = true;
        }
        if (c.canEdit === undefined) {
            c.canEdit = true;
        }

        if(c.initListName){
            $ctrl.Settings = {};
            $ctrl.Settings[c.initListName] = $ctrl.initList;
        }

        return service.getSBFieldContentView($ctrl, item, c, false);
    }

    function getTriggerEditOnCol(c) {
        return c.triggerEditOnCol ||
           (c.type === service.PropTypes.Color ||
            c.type === service.PropTypes.Icon ||
            c.type === service.PropTypes.BigCheck ||
            c.type === service.PropTypes.SimpleCheck ||
            c.type === service.PropTypes.Radio ||
            c.type === service.PropTypes.Check ||
            c.type === service.PropTypes.Pages ||
            c.type === service.PropTypes.TopCall ||
            c.type === service.PropTypes.Rate ||
            c.type === service.PropTypes.Calltime ||
            c.type === service.PropTypes.ContactRate ||
            c.type === service.PropTypes.Characters ||
            c.type === service.PropTypes.Locations ||
            c.type === service.PropTypes.StripLocation ||
            c.type === service.PropTypes.Team||
               c.type === service.PropTypes.Projects||
            c.type === service.PropTypes.Collaborators||
            c.type === service.PropTypes.Likes||
            c.type === service.PropTypes.Drp ||
            c.type === service.PropTypes.Style ||
            c.type === service.PropTypes.Border ||
            c.type === service.PropTypes.HtmlTooltip);
    }

    function getSBColContentView($ctrl, item, c, listIndex, textOnly) {
        var canUpdate = service.canUpdateField($ctrl, c) && !item.isPredef && !item.isPredefined,
            info = SBFieldMethods.getColContentView($ctrl, canUpdate, item, c, textOnly);

        if (textOnly) {
            return info.content || '';
        }

        if (!info.content && c.hideEmptyContent && !(c.canChangeOnEdit)) {
            return '';
        }

        var triggerEditOnCol = getTriggerEditOnCol(c),
            eClassAttr = replace(c.eClassAttr),
            cClassAttr = c.cClassAttr || '',
            fieldClass = c.fieldClass || '',
            triggerCls = 'sbet ' +
                (typeof($ctrl.getClickEventEditable) === 'function' ? $ctrl.getClickEventEditable : service.getClickEventEditable)(c.openPopup ? 'sbOpenEditable' : 'sbEditable'),
            trigger = ((canUpdate ||  c.canEdit && c.canChangeOnEdit) && triggerEditOnCol ? triggerCls : ''),
            s = getStyle(item, c),
        content = '<div class="' +
                (canUpdate ? ('no-drag ' + service.SBNoTableClick + ' ' +
                (c.openPopup ? ' with_underline ' : '')) : '') +
                service.SBViewBlock + ' ' +
                (!info.value ? (service.SBViewEmpty + ' ') : '') +
                getEditableCls(canUpdate || c.canChangeOnEdit) + trigger + '"' +
                (canUpdate && triggerEditOnCol ? (' data-type="makeFieldEditable" analytics-action="' + c.name + '" analytics-on' ) : '')+
            '>' +
                '<div class="sb-wrapper ' + (c.wrapperClass ? c.wrapperClass : '') + '">' +
                    '<div class="' +
                        service.SBViewContentCls + ' ' +
                        ((c.type === $ctrl.SBFieldTypesService.PropTypes.Html || c.type === $ctrl.SBFieldTypesService.PropTypes.Contenteditable) ? ' ql-editor ' : '') +
                        (c.withEllipsis ? (service.SBViewWithEllipsisCls + ' ') : '') +
                        (info.hasPlaceholderCls ? (service.SBPlaceholderCls + ' ') : '') +
                        (fieldClass && $ctrl.isPrintLayout ? fieldClass
                            .replace('with_underline', '')
                            .replace('with-underline', '') : fieldClass
                        ) +
                    '"' +
            (s ? (' style="' + s + '"') : '') +
             (c.styleProp ? (' data-style="' + (item[c.styleProp] ? item[c.styleProp].styleId : '1') + '"') : '') +
             '>' +
                        info.content +
                    '</div>' +
                '</div>' +
                editOnCol() +
            withSingleLink() +
            '</div>';

        return (trigger!=='' && !c.openPopup && c.withEditableOuter) ? ('<div class="' + service.SBEditableOuter + (c.editableOuterCls? (' ' + c.editableOuterCls) : '') + '">' + content + '</div>') : content;


        function editOnCol(){
            return canUpdate && (!triggerEditOnCol||c.triggerOnEditLink) ? '<div class="' + trigger + ' with-hover" tooltip-placement="bottom" tooltip="Edit"><div class="blue-sbf sbf pencil"></div></div>' : '';
        }

        function withSingleLink(){
            return c.withSingleLink ? ('<a class="with-hover ' + $ctrl.getClickEventName('goToSinglePage') + '" tooltip-placement="bottom" tooltip="View In New Page">'+$ctrl.LCS.getISBDiv('link', 2, 'blue-sbf') + '</a>') : '';
        }

        function getEditableCls(canUpdate) {
            return service.getViewEditElemSelector(c.prop, true, canUpdate) +  ' ' + eClassAttr + ' ' + cClassAttr + ' ';
        }

        function replace(cls) {
            if(!cls){return '';}
            return (canUpdate ? cls : cls
                .replace('semibold', '')
                .replace('non-inline-editor', '')
                .replace('form-control', '')
                .replace('hover-underline', '')
                .replace('with_underline', '')
                .replace('with-underline', '')) + ' ';
        }
    }

    function getStyle(item, c) {
        if(!c||!item){return null;}
        var noteStyle = item[c.styleProp];
        if (!(c.styleProp && noteStyle)) {
            return '';
        }
        return getCustomStyle(noteStyle, noteStyle.styleId).style;
    }

    function getViewEditElemSelector(prop, notClass, canUpdate) {
        return getCSSClassFromProp(prop, notClass) +
            (canUpdate ? ((notClass ? ' ' : '.') + service.SBViewEditBlock) : '');
    }

    function getCSSClassFromProp(prop, notClass) {
        return (notClass ? '' : '.') + service.SBPropMark + (prop ? prop.replace('.', '_') : '');
    }

    function getPropFromClass(cls) {
        if (cls.indexOf(service.SBPropMark) !== -1) {
            return cls.replace(service.SBPropMark, '').replace('_', '.');
        }
        return null;
    }

    function getCustomStyle(item, styleId, changeStyle) {
        var styles = SBFieldMethods.FontStyles,
            Style = get(styleId),
            props = {};
        if (!Style) {
            Style = get();
        }
        props.styleId = Style.id;
        var style = '';
        _.each(getStyleProps(), function (p) {
            props[p] = changeStyle ? (Style[p] ? Style[p] : null) : (item[p] ? item[p] : null);
            if (props[p]) {
                style += getCSSProp(p) + ':' + props[p] + ';';
            }
        });

        return {props: props, style: style, Style: Style};

        function get(id) {
            if (!id) {
                id = styles[0].id;
            }
            return _.find(styles, {id: id});
        }
    }

    function getDefaulSBEditProps(col) {
        return (col.fieldClass ? ('field-class="' + col.fieldClass + '" ') : '') +
            (col.cClassAttr ? ('c-class-attr="' + col.cClassAttr + '" ') : '') +
            (col.eClassAttr ? ('e-class-attr="' + col.eClassAttr + '" ') : '') +
            (col.drpMenuCls ? ('drp-menu-cls="' + col.drpMenuCls + '" ') : '') +
            (col.drpClassAttr ? ('drp-class-attr="' + col.drpClassAttr + '" ') : '') +
            (col.placeholder ? ('placeholder="' + col.placeholder + '" ') : '') +
            (col.isRequired === true ? ('is-required="true" ') : '') +
            (col.isMaxLength ? ('is-max-length="'+col.isMaxLength+'" ') : '') +
            (col.isMinLength ? ('is-min-length="'+col.isMinLength+'" ') : '') +
            (col.validatorClass ? ('validator-class="' + col.validatorClass + '" ') : '') +
            (col.inputName ? ('input-name="' + col.inputName + '" ') : '') +
            (col.styleG ? ('style-g="' + col.styleG + '" ') : '') +
            (col.tabIndex ? ('tab-index="' + col.tabIndex + '" ') : '') +
            (col.saveOnKeydown ? ('save-on-keydown="' + col.saveOnKeydown + '" ') : '') +
            (col.saveOnEnter ? ('save-on-enter="' + col.saveOnEnter + '" ') : '') +
            (col.tabNextIndex ? ('tab-next-index="' + col.tabNextIndex + '" ') : '') +
            (col.width ? ('min-width="' + col.width + '" ') : '') +
            (col.parentContainer ? ('parent-container="'+col.parentContainer+'" ') : '')+
            (col.popoverContainer ? ('popover-container="'+col.popoverContainer+'" ') : '')+
            (col.popupPlacement ? ('popup-placement="'+col.popupPlacement+'" ') : '')+
            (col.name === true ? ('name="true" ') : '')  +
            (col.hasCustom === true ? ('has-custom="true" ') : '') +
            ((col.withInlineLabel === true && col.name || col.withInlineLabel&& col.withInlineLabel !== true) ? ('with-label="' + (col.withInlineLabel === true ? col.name : col.withInlineLabel) + '" ') : '') +
            (col.isComplex=== true ? ('is-complex="true" ') : '') +
            (col.initListName ? ('init-list-name="'+col.initListName+'" ') : '') +
            (col.withoutClose ? ('without-close="'+col.withoutClose+'" ') : '') +
            (col.withoutDefaultFocus ? ('without-default-focus="'+col.withoutDefaultFocus+'" ') : '') +
            (col.editModeOnly ? ('edit-mode-only="'+col.editModeOnly+'" ') : '') +
            (col.withoutOpenedDrp ? ('without-opened-drp="'+col.withoutOpenedDrp+'" ') : '') +
            (col.wrapperClass ? ('wrapper-class="'+col.wrapperClass+'" ') : '') +
            (col.startInFocus ? ('start-in-focus="true" ') : '') +
            (col.capitalizeFirst === true ? ('capitalize-first="true" ') : '') +
        (col.quotaType ? ('quota-type="'+col.quotaType+'" ') : '');
    }

    function getDefaultFieldProps(type, attrs) {
        var props = getDefaultProps(type),
            result ={};
        _.each(props, function (attr) {
            var prop = attrs[attr.v];
            if (prop) {
                result[attr.v] = attr.t === 'int' ? parseInt(prop, 10) : (attr.t === 'bool' ?( prop ==='true' || prop ===true) : prop);
            }
        });

        return result;
    }

    function getDefaultProps(type){
        var l = [
            {t:'bool', v:'canEdit'},
            {t:'string', v:'validatorClass'},
            {t: 'string', v: 'styleG'},
            {t: 'string', v: 'inputName'},
            {t: 'string', v: 'fieldClass'},
            {t: 'string', v: 'placeholder'},
            {t: 'string', v: 'validatorClass'},
            {t: 'string', v: 'isRequired'},
            {t: 'int', v: 'isMaxLength'},
            {t: 'int', v: 'isMinLength'},
            {t: 'string', v: 'colCls'},
            {t: 'string', v: 'drpClassAttr'},
            {t: 'string', v: 'drpMenuCls'},
            {t: 'string', v: 'cClassAttr'},
            {t: 'string', v: 'eClassAttr'},
            {t: 'int', v: 'tabIndex'},
            {t: 'int', v: 'tabNextIndex'},
            {t: 'bool', v: 'withEllipsis'},
            {t: 'bool', v: 'capitalizeFirst'},
            {t: 'string', v: 'initListName'},
            {t: 'string', v: 'popoverContainer'},
            {t: 'bool', v: 'parentContainer'},
            {t: 'string', v: 'header'},
            {t: 'bool', v: 'saveOnKeydown'},
            {t: 'bool', v: 'saveOnEnter'},
          //  {t: 'bool', v: 'editableOuterCls'}
            //  {t: 'bool', v: 'withEditableOuter'}
            ];
        switch (type) {
            case service.PropTypes.Drp:
            case service.PropTypes.Style:
            case service.PropTypes.Border:
                l = [].concat(l, [
                    {t: 'string', v: 'itemLabel'},
                    {t: 'string', v: 'itemValue'},
                    {t: 'string', v: 'inputColor'},
                    {t: 'string', v: 'colorClass'},
                    {t: 'bool', v: 'withColor'},
                    {t: 'bool', v: 'withouTtext'},
                    {t: 'bool', v: 'truncate'},
                    {t: 'bool', v: 'fixedHeight'},
                    ]);
                break;

            case service.PropTypes.Icon:
                l = [].concat(l, [
                    {t: 'bool', v: 'longer'},
                    {t: 'bool', v: 'withUncheck'},
                    {t: 'bool', v: 'isSvg'}
                ]);
                break;

            case service.PropTypes.Color:
                l = [].concat(l, [
                    {t: 'bool', v: 'longer'},
                    {t: 'bool', v: 'square'},
                    {t: 'bool', v: 'withUncheck'},
                    {t: 'bool', v: 'withoutCustom'},
                    {t: 'bool', v: 'showColorName'},
                    {t: 'string', v: 'icon'},
                    {t: 'string', v: 'defaultColor'}
                ]);
                break;

            case service.PropTypes.Radio:
            case service.PropTypes.Check:
                l = [].concat(l, [
                    {t: 'bool', v: 'withUncheck'},
                    {t: 'bool', v: 'hasCustom'}
                ]);
                break;

            case service.PropTypes.Time:
            case service.PropTypes.Calltime:
            case service.PropTypes.Pickuptime:
            case service.PropTypes.HMUtime:
            case service.PropTypes.Costumestime:
            case service.PropTypes.Wraptime:
            case service.PropTypes.Onsettime:
                l = [].concat(l, [
                    {t: 'string', v: 'defaultTime'},
                    {t: 'string', v: 'meridians'},
                    {t: 'string', v: 'timeFormat'},
                    {t: 'string', v: 'removeText'},
                    {t: 'bool', v: 'hasRemove'}
                ]);
                break;

            case service.PropTypes.EstTime:
            case service.PropTypes.Duration:
            case service.PropTypes.Timecode:
            case service.PropTypes.TimecodeRange:
                l = [].concat(l, [
                    {t: 'string', v: 'defaultTime'},
                    {t: 'string', v: 'removeText'},
                    {t: 'bool', v: 'hasRemove'},
                    {t: 'string', v: 'dateFormat'},
                    {t: 'string', v: 'timeFormat'}
                ]);
                break;

            case service.PropTypes.Date:
            case service.PropTypes.Dates:
            case service.PropTypes.DateRange:
                l = [].concat(l, [
                    {t: 'string', v: 'dateFormat'},
                    {t: 'bool', v: 'emptyIsCircle'},
                    {t: 'string', v: 'defaultDate'},
                    {t: 'bool', v: 'hasRemove'},
                    {t: 'string', v: 'removeText'},
                    {t: 'bool', v: 'hasRemove'},
                    {t: 'bool', v: 'enableTime'},
                    {t: 'bool', v: 'withoutIcon'},
                    {t: 'string', v: 'timeFormat'},
                    {t: 'string', v: 'propFrom'},
                    {t: 'string', v: 'propTo'}
                ]);
                break;

            case service.PropTypes.Rate:
            case service.PropTypes.ContactRate:
                l = [].concat(l, [
                    {t: 'string', v: 'removeText'},
                    {t: 'bool', v: 'hasRemove'}
                ]);
                break;

            case service.PropTypes.Team:
            case service.PropTypes.Projects:
            case service.PropTypes.Collaborators:
            case service.PropTypes.Likes:
                l = [].concat(l, [
                    {t: 'bool', v: 'showAllTeam'},
                    {t: 'bool', v: 'showOnlyCounter'},
                    {t: 'bool', v: 'withCount'},
                    {t: 'int', v: 'maxCount'},
                    {t: 'bool', v: 'withoutDefaultMembers'},
                    {t: 'string', v: 'circleSize'},
                    {t: 'string', v: 'headerSelected'},
                    {t: 'bool', v: 'withoutDefaultFocus'},
                    {t: 'string', v: 'currentId'},
                    {t: 'bool', v: 'canRemoveCurrent'},
                    {t: 'bool', v: 'showMemberType'},
                    {t: 'bool', v: 'displayDefaultMembers'},

                    {t: 'bool', v: 'isAssign'},
                    {t: 'string', v: 'todoPageId'},
                    ]);

                break;

            case service.PropTypes.Html:
            case service.PropTypes.Contenteditable:
                l = [].concat(l, [
                    {t: 'bool', v: 'autofocus'},
                    {t: 'bool', v: 'withNoToolbar'},
                    {t: 'string', v: 'toolbarParentEl'},
                    {t: 'string', v: 'wordCountProp'},
                    {t: 'bool', v: 'withVideo'},
                    {t: 'bool', v: 'withSave'},
                    {t: 'bool', v: 'withCancel'},
                    {t: 'bool', v: 'withFullHeight'},
                    {t: 'bool', v: 'withBottomToolbar'},
                    {t: 'string', v: 'editorType'},
                    {t: 'string', v: 'focusOffset'}
                ]);
                break;

            case service.PropTypes.BigCheck:
                l = [].concat(l, [
                    {t: 'bool', v: 'withTooltip'},
                    {t: 'bool', v: 'tooltipPlacement'},
                    {t: 'bool', v:  'canEdit'}
                ]);
                break;
            case service.PropTypes.SimpleCheck:
                l = [].concat(l, [
                    {t: 'bool', v:  'canEdit'}
                ]);
                break;

            case service.PropTypes.Picture:
                l = [].concat(l, [
                    {t: 'string', v: 'containerClass'},
                    {t: 'string', v: 'icon'},
                    {t: 'string', v: 'areaType'},
                    {t: 'string', v: 'imgSize'},
                    {t: 'string', v: 'size'},
                    {t: 'bool', v: 'loadLater'},
                    {t: 'bool', v: 'isAvatarAttr'},
                    {t: 'bool', v: 'isPosterAttr'},
                    {t: 'bool', v: 'startWithEditorAttr'},
                    {t: 'bool', v: 'showMetadaAfterAttr'},
                    {t: 'bool', v: 'showLabel'},
                    {t: 'string', v: 'defaultText'},
                    {t: 'bool', v: 'canUploadAttr'},
                    {t: 'bool', v: 'canChangeName'},
                    {t: 'string', v: 'itemIdProp'},
                    {t: 'string', v: 'collectionProp'},
                    {t: 'bool', v: 'withoutInitials'},
                    {t: 'bool', v: 'withoutBgColor'},
                    {t: 'string', v: 'iconLevel'},
                    {t: 'bool', v: 'withImgBg'},
                    {t: 'string', v: 'bgColor'},
                    {t: 'string', v: 'color'},
                    {t: 'string', v: 'areaType'},
                    {t: 'string', v: 'item'},
                    {t: 'string', v: 'codeName'},
                    {t: 'bool', v: 'setName'},
                    {t: 'bool', v: 'withView'},
                    {t: 'bool', v: 'withViewOnEmpty'},
                    {t: 'bool', v: 'withoutRemove'},
                    {t: 'bool', v: 'withNext'},
                    {t: 'bool', v: 'withCommentsOnItem'},
                    {t: 'bool', v: 'withLikesOnItem'},
                    {t: 'bool', v: 'withCommentsCount'}
                ]);
                break;

            case service.PropTypes.Characters:
            case service.PropTypes.StripLocation:
            case service.PropTypes.Locations:
                l = [].concat(l, [
                    {t: 'bool', v: 'withoutIcon'},
                    {t: 'bool', v: 'withoutStripId'}
                ]);
                break;
        }
        return l;
    }

//{withoutClose: true, objectType: objectType, withService: true}
    function getSBForm($ctrl, id, columns, formOptions) {
        var form = '';
        if (!formOptions) {
            formOptions = {};
        }
        _.each(columns, function (c) {
            var multiDiv = c.multiDiv;
            if (multiDiv) {
                if (c.groupLabel && !c.groupLabelUnder) {
                    form += getLabel(c);
                }

                form += '<div ' + (c.ifCond ? ('ng-if="' + c.ifCond + '" ') : '') + ' class="' +
                    (c.formGroupClass ? c.formGroupClass : 'form-group field') + '">';

                _.each(multiDiv, function (d) {
                    form += get(d);
                });

                form += (c.otherHtml ? c.otherHtml : '') +
                    (c.groupLabel && c.groupLabelUnder ? getLabel(c) : '') +
                    '</div>';
            } else {
                form += get(c);
            }
        });

        return form;

        function get(c) {
            var c1 = _.extend({}, c);
            c1.withoutIcon = true;

            if ((c.parentContainer === true || c.parentContainer === 'true') && $ctrl.parentContainer) {
                c1.parentContainer = $ctrl.parentContainer;
            }

            if (c.parentContainer === undefined) {
                c1.parentContainer = true;
            }

            if (!$ctrl.isEditPopup && c.editPlaceholder) {
                c1.placeholder = c.editPlaceholder;
            }
            return getSBFormEditableField($ctrl, id, c1, formOptions);
        }
    }

    function getLabel(c) {
        return '<label class="header clearfix">' +
          (typeof(c.groupLabel) === 'string' ? c.groupLabel : (c.name||c.placeholder).replace('…','')) +
            '</label>';
    }

    function getSBFormEditableField($ctrl, id, c, formOptions) {
        var isMobileLayout = $ctrl.LCS.isMobileSize;
        if(isMobileLayout){
            c.withInlineLabel = false;
            if(c.withoutLabelInPopup !== true) {
                c.withoutLabelInPopup = false;
            }
        }


        var withTopLabel = (formOptions.withLabel || c.withLabel) && (!c.withoutLabelInPopup && !c.withInlineLabel);
        if(!isMobileLayout && !withTopLabel ){
            c.withInlineLabel = true;
        }

        var noQuota = c.quotaType && !$ctrl.CPS.hasQuotaType(c.quotaType);
        if(noQuota){
            c.canEdit = false;
        }

        if (c.type === service.PropTypes.Picture) {
            return get(c);
        } else {
            if (c.type === service.PropTypes.HtmlTooltip) {
                c.type = service.PropTypes.Html;
            }
            return ((formOptions.groupLabel || c.groupLabel) && !c.groupLabelUnder ? getLabel(c) : '') +
                '<div ' + (c.ifCond ? ('ng-if="' + c.ifCond + '" ') : '') + ' class="' +
                    (withTopLabel && !$ctrl.isPrintLayout ? 'with-top-label ' : '') +
                    ' ' + (c.formGroupClass ? c.formGroupClass : ('field form-group ')) +
                    (c.type === $ctrl.SBFieldTypesService.PropTypes.Html ? ' with-floating-toolbar' : '') +
                    (c.isLastRow? ' last ' : '') +
                    (c.icon && !c.hideIconOnEdit ? ' sbfgroup ' : '')+
                    ' ' + ($ctrl.pageClass || '') +
                '">' +
                    (c.icon && !c.hideIconOnEdit ? $ctrl.LCS.getISBDiv(c.icon, c.iconLevel ? c.iconLevel : 2) : '')+
                    (withTopLabel ? ('<label class="header clearfix">' + (c.withLabel ? c.withLabel : (
                        (c.name ? c.name : (c.placeholder ? c.placeholder.replace('…', '') : '')) +
                        (noQuota ? ('<span class="profeature position-absolute margin-left10">PRO</span>') :'')
                    )) + '</label>') : '') +//above the field
                    (c.justHtml ? c.justHtml : get(c)) +
                    (c.otherHtml ? c.otherHtml : '') +
                ((formOptions.groupLabel || c.groupLabel) && c.groupLabelUnder ? getLabel(c) : '') +
                '</div>';
        }

        function get(c){
            if((c.cantEditInPopup || noQuota) && $ctrl.item){
                return '<div class="form-control-nonedit ' +
                    (noQuota? (' with-cursor ' +$ctrl.getBtnActionCls()) : '') + '"' +
                    (noQuota? (' data-type="openProPopup" data-info="'+c.quotaType+'" analytics-on analytics-action="Popup Edit col '+c.name+'"') : '') +
                    '>' + service.getSBColContentView($ctrl, $ctrl.item[c.prop], c) + '</div>';
            }
            return service.getSBColContentEdit($ctrl, c, id, formOptions);
        }
    }

    function getElementId(id, prop, objectType) {
        return id + '_' + prop + (objectType ? ('_'+objectType) :'');
    }

    function getElementIdFromItem(item, prop) {
        return service.getElementId(item._id, prop, item.getType ? item.getType() : null);
    }

    function getSBContentEditObjectParams($ctrl, col) {
        var params = {};
        if(col) {
            if (col.initListName) {
                params.initList = $ctrl.Settings[col.initListName];
            }

            switch (col.type) {
                case service.PropTypes.Characters:
                case service.PropTypes.Locations:
                case service.PropTypes.StripLocation:
                    params.scriptLoadingService = $ctrl.scriptLoadingService;
                    params.stripId = $ctrl.stripId;

                    if(service.PropTypes.StripLocation && col.withoutStripId) {
                        params.withoutStripId = true;
                    }
                    break;

                case service.PropTypes.Collaborators:
                case service.PropTypes.Likes:
                    params.list = $ctrl.item;
                    break;

                case service.PropTypes.ContactRate:
                    if($ctrl.CPS.productId) {
                        params.contactLists = $ctrl.item.contactLists;
                        params.contactListId = $ctrl.CPS.productId ? $ctrl.CPS.product.contactListId : null;
                    }
                    break;
            }
        }

        return params;
    }

    function getSBColContentEditTag($ctrl, col, item, formOptions){
        return service.getSBColContentEdit($ctrl, col, item._id, _.extend({
            withInlineLabel: false,
            withService: col.withService!== undefined ? col.withService : ($ctrl.withServiceForField === undefined ? true : $ctrl.withServiceForField),
            objectType: typeof(item.getType) === 'function' ? item.getType() : $ctrl.objectType,
            timeFormat: $ctrl.CPS.timeFormat,
            altId: item[col.altId],
            origProp: item[col.origProp]
        }, formOptions));
    }

    function getSBColContentEdit($ctrl, col, id, formOptions) {
        if(!formOptions){formOptions = {};}
        col = angular.copy(col);
        if($ctrl.isGridView || formOptions.withInlineLabel === false){
            col.withInlineLabel = false;
        }

        if(formOptions.parentContainer && (col.parentContainer === true || col.parentContainer === 'true')){
            col.parentContainer = formOptions.parentContainer;
        }
        var tag = getTag(col.type),
            props = '';

        var withoutClose = formOptions.withoutClose && !col.startInEditMode;

        process();

        return col ? ('<' + tag + ' ' +
            'class="' + tag +' clearfix ' + service.SBEditBlock + (col.otherClass ? (' ' + col.otherClass) : '') + '" ' +

            'element-id="' + (formOptions.elementId ? formOptions.elementId : service.getElementId(id,
                (col.origProp ? col.origProp: col.prop), formOptions.objectType)) + '" ' +

            (formOptions.altId ? ('alt-id="'+formOptions.altId + '" ') : '') +
            (formOptions.origProp ? ('orig-prop="'+formOptions.origProp + '" ') : '') +

            //must be added as params on item.grid.group.edit.controller.service
            (formOptions.withService ? (
                'service="::$ctrl.service" '
            ) :'') +
            'on-change="' + ( col.onChange ? col.onChange : '$ctrl.onChange(result)') + '" ' +
            'on-cancel="' + ( col.onCancel ? col.onCancel : '$ctrl.cancel(result)') + '" ' +

            (formOptions.onChangeOther ? ('on-change-other="$ctrl.onChangeOther(result)" '): '') +
            (formOptions.onValidation ? ('on-validation="$ctrl.onValidation(result)" '): '') +

            'elem-type="::$ctrl.elemType" ' +
            (formOptions.withoutClose ? (
                'without-close="true" ' +
                'autofocus="false" ' +
                'value="$ctrl.item.' + col.prop + '" ' +
                (col.resetProp ? ('reset-value="$ctrl.item.' + col.resetProp + '" ') : '')
            ) : (
                'value="::$ctrl.value" ' +
                (col.resetProp ? ('reset-value="::$ctrl.resetValue" ') : '')
            )) +

            service.getDefaulSBEditProps(col) +
            props +
            '></' + tag + '>') : null;

        function process() {
            switch (col.type) { //below we set attributes from col not fields
                case service.PropTypes.Field:
                case service.PropTypes.Phone:
                case service.PropTypes.Email:
                case service.PropTypes.Shot:
                case service.PropTypes.Scene:
                case service.PropTypes.Size:
                case service.PropTypes.Number:
                case service.PropTypes.CommnentsCount:
                    getFieldClassAttr();
                    props = getInitListAttr(col);

                    props += (col.canEdit ? ('can-edit="true" ') : '') +
                        (col.focusDelay ? ('focus-delay="' + col.focusDelay + '" ') : '');

                    saveOnKeydown();
                    break;

                case service.PropTypes.Html:
                case service.PropTypes.Contenteditable:
                    getFieldClassAttr();
//must be added as params on item.grid.group.edit.controller.service
                    props += (col.withNoToolbar ? ('with-no-toolbar="true" ') : '') +
                        ($ctrl.saveOnEnter ? 'save-on-enter="true" ' : '') +
                        (col.focusOffset ? ('focus-offset="' + col.focusOffset + '" ') : '') +
                        (!col.withNoToolbar && col.withBottomToolbar ? ('with-bottom-toolbar="true" ') : '') +
                        (!col.withFullHeight ? ('with-full-height="true" ') : '') +
                        (col.toolbarParentEl ? ('toolbar-parent-el="' + col.toolbarParentEl + '" ') : '') +
                        (col.editorType ? 'editor-type="' + col.editorType + '" ' : '') +
                        (col.autofocus ? ('autofocus="true" ') : '') +

                        (col.canEdit ? ('can-edit="' + col.canEdit + '" ') : '') +

                        (col.wordCountProp ? ('word-count-prop="' + col.wordCountProp + '"') : '') +
                        (col.withVideo ? ('with-video="true" ') : '') +
                        (col.withSave ? ('with-save="true" ') : '') +
                        (col.withCancel ? ('with-cancel="true" ') : '') +
                        (col.withFullHeight ? ('with-full-height="true" ') : '');

                    saveOnKeydown();

                    break;

                case service.PropTypes.Rate:
                    getFieldClassAttr();
//must be added as params on item.grid.group.edit.controller.service
                    props += (col.header ? ('header="' + col.header + '" ') : '') +
                        (col.hasRemove ? ('has-remove="' + col.hasRemove + '" ') : '') +
                        (col.removeText ? ('remove-text="' + col.removeText + '" ') : '') +
                        getInitListAttr(col);
                    break;

                case service.PropTypes.ContactRate:
                    getFieldClassAttr();
//must be added as params on item.grid.group.edit.controller.service
                    props += (col.header ? ('header="' + col.header + '" ') : '') +
                        (col.hasRemove ? ('has-remove="' + col.hasRemove + '" ') : '') +
                        (col.removeText ? ('remove-text="' + col.removeText + '" ') : '') +
                        'contact-lists="::$ctrl.contactLists" ' +
                        'contact-list-id="::$ctrl.contactListId" ' +
                        getInitListAttr(col);
                    break;

                case service.PropTypes.Drp:
                case service.PropTypes.Style:
                case service.PropTypes.Border:
                    getCClassAttr();
                    props = 'field-class="selected-text centering text-left with-underline" ' +
                        'item-label="' + (col.itemLabel ? col.itemLabel : 'text') + '" ' +
                        'item-value="' + (col.itemValue ? col.itemValue : 'value') + '" ' +
                        (col.withColor ? 'with-color="true"' : '') +
                        (col.withoutText ? 'without-text="true"' : '') +
                        (col.colorClass ? ('color-class="' + col.colorClass + '" ') : '') +
                        (col.inputColor ? ('input-color="' + col.inputColor + '" ') : '') +
                        (col.fixedHeight ? ('fixed-height="true" ') : '') +
                        (col.truncate ? ('truncate="true" ') : '') +
                        getInitListAttr(col);
                    break;

                case service.PropTypes.Pages:
                case service.PropTypes.TopCall:
                case service.PropTypes.SceneType:
                case service.PropTypes.DayTime:
                    getCClassAttr();
                    props = getInitListAttr(col);
                    break;

                case service.PropTypes.Icon:
                    props = 'field-class="selected-text centering text-left with-underline" ' +
                        (col.withUncheck ? 'with-uncheck="' + col.withUncheck + '" ' : '') +
                        (col.longer ? 'longer="' + col.longer + '" ' : '') +
                        (col.isSvg ? 'is-svg="' + col.isSvg + '" ' : '') +
                        getInitListAttr(col);
                    break;

                case service.PropTypes.Color:
                    props = 'field-class="selected-text centering text-left with-underline" ' +
                        (col.header ? ('header="' + col.header + '" ') : '') +
                        (col.subheader ? ('subheader="' + col.subheader + '" ') : '') +
                        (col.icon ? ('icon="' + col.icon + '" ') : '') +
                        (col.withUncheck ? 'with-uncheck="' + col.withUncheck + '" ' : '') +
                        (col.longer ? 'longer="true" ' : '') +
                        (col.square ? 'square="true" ' : '') +
                        (col.defaultColor ? ('default-color="' + col.defaultColor + '" ') : '') +
                        (col.showColorName ? 'show-color-name="' + col.showColorName + '" ' : '') +
                        (col.withoutCustom ? 'without-custom="' + col.withoutCustom + '" ' : '') +
                        getInitListAttr(col);
                    break;

                case service.PropTypes.Radio:
                case service.PropTypes.Check:
                    //no-drag
                    getCClassAttr();
                    props = 'item-label="' + (col.itemLabel ? col.itemLabel : 'name') + '" ' +
                        'item-value="' + (col.itemValue ? col.itemValue : 'id') + '" ' +
                        'item-display="' + (col.itemDisplay ? col.itemDisplay : 'short') + '" ' +
                        (col.withUncheck ? 'with-uncheck="' + col.withUncheck + '" ' : '') +
                        (col.hasCustom ? 'has-custom="' + col.hasCustom + '" ' : '') +
                        (col.minWidth ? 'min-width="' + col.minWidth + '" ' : '') +
                        getInitListAttr(col);

                    //($ctrl.withUncheck ? 'with-uncheck="true" ' : '');
                    break;

                case service.PropTypes.Date:
                case service.PropTypes.Dates:
                case service.PropTypes.DateRange:
                    getCClassAttr();

//must be added as params on item.grid.group.edit.controller.service
                    props +=
                        (col.header ? ('header="' + col.header + '" ') : '') +
                        (col.propFrom ? ('prop-from="' + col.propFrom + '" ') : '') +
                        (col.propTo ? ('prop-to="' + col.propTo + '" ') : '') +
                        (col.defaultDate ? ('default-date="' + col.defaultDate + '" ') : '') +
                        (col.dateFormat ? ('date-format="' + col.dateFormat + '" ') : '') +
                        (col.emptyIsCircle ? ('empty-is-circle="' + col.emptyIsCircle + '" ') : '') +
                        (col.removeText ? ('remove-text="' + col.removeText + '" ') : '') +
                        (col.hasRemove ? ('has-remove="' + col.hasRemove + '" ') : '') +

                        (col.minDate ? ('min-date="' + col.minDate + '" ') : '') +
                        (col.maxDate ? ('max-date="' + col.maxDate + '" ') : '') +
                        (col.enableTime ? ('enable-time="' + col.enableTime + '" ') : '') +
                        getInitListAttr(col);
                    break;

                case service.PropTypes.Time:
                case service.PropTypes.Calltime:
                case service.PropTypes.Pickuptime:
                case service.PropTypes.HMUtime:
                case service.PropTypes.Costumestime:
                case service.PropTypes.Wraptime:
                case service.PropTypes.Onsettime:
                    getCClassAttr();

//must be added as params on item.grid.group.edit.controller.service
                    props +=
                        (col.header ? ('header="' + col.header + '" ') : '') +
                        (col.defaultTime ? ('default-time="' + col.defaultTime + '" ') : '') +
                        (col.meridians ? ('meridians="' + col.meridians + '" ') : '') +
                        (col.removeText ? ('remove-text="' + col.removeText + '" ') : '') +
                        (col.hasRemove ? ('has-remove="' + col.hasRemove + '" ') : '') +
                        'time-format="' + (col.timeFormat ? col.timeFormat : $ctrl.CPS.timeFormat) + '" ' +
                        getInitListAttr(col);
                    break;

                case service.PropTypes.EstTime:
                case service.PropTypes.Duration:
                case service.PropTypes.Timecode:
                case service.PropTypes.TimecodeRange:
                    getCClassAttr();
//must be added as params on item.grid.group.edit.controller.service
                    props += (col.header ? ('header="' + col.header + '" ') : '') +
                        (col.defaultTime ? ('default-time="' + col.defaultTime + '" ') : '') +
                        (col.hasRemove ? ('has-remove="' + col.hasRemove + '" ') : '') +
                        (col.removeText ? ('remove-text="' + col.removeText + '" ') : '') +
                        getInitListAttr(col);
                    break;


                case service.PropTypes.Team:
                case service.PropTypes.Projects:
                case service.PropTypes.Collaborators:
                case service.PropTypes.Likes:
                    getCClassAttr();
//must be added as params on item.grid.group.edit.controller.service
                    props += (col.showAllTeam ? ('show-all-team="true" ') : '') +
                        (col.showOnlyCounter ? ('show-only-counter="true" ') : '') +
                        (col.withCount ? ('with-count="true" ') : '') +
                        (col.headerSelected !== undefined ? ('header-selected="' + col.headerSelected + '" ') : '') +
                        (col.teamLabel !== undefined ? ('team-label="' + col.teamLabel + '" ') : '') +
                        (col.showMemberType !== undefined ? ('show-member-type="' + col.showMemberType + '" ') : '') +
                        (col.displayDefaultMembers !== undefined ? ('display-default-members="' + col.displayDefaultMembers + '" ') : '') +
                        (col.maxCount !== undefined ? ('max-count="' + col.maxCount + '" ') : '') +
                        (col.withoutDefaultMembers ? ('without-default-members="true" ') : '') +
                        (col.withoutDefaultFocus ? ('without-default-focus="true" ') : '') +
                        (col.circleSize ? ('circle-size="' + col.circleSize + '" ') : '') +
                        (col.isAssign ? ('is-assign="true" ') : '') +

                        (col.canEdit ? ('can-edit="' + col.canEdit + '" ') : '') +
                        getInitListAttr(col);

                    if (col.type === service.PropTypes.Collaborators) {
                        props += (col.todoPageId ? ('todo-page-id="' + col.todoPageId + '" ') : '') +
                            (col.uId ? ('u-id="\'' + col.uId + '\'" ') : '') + //is a string variable
                            (col.list ? 'list="$ctrl.list" ' : '');

                    }
                    break;

                case service.PropTypes.Characters:
                case service.PropTypes.StripLocation:
                case service.PropTypes.Locations:
                    getCClassAttr();
                    props += 'script-loading-service="::$ctrl.scriptLoadingService" ' +
                        'strip-id="::$ctrl.stripId" ' +
                        (col.withoutIcon ? ('without-icon="' + col.withoutIcon + '" ') : '') +
                        (col.type === service.PropTypes.StripLocation && col.withoutStripId ? 'without-strip-id="true" ' : '') +
                        (col.tooltipPlacement ? ('tooltip-placement="' + col.tooltipPlacement + '" ') : '') +
                        getInitListAttr(col);
                    break;

                case service.PropTypes.BigCheck:
//must be added as params on item.grid.group.edit.controller.service
                    props += (col.withTooltip ? ('with-tooltip="true" ') : '') +
                        (col.withTooltip && col.tooltipPlacement ? ('tooltip-placement="' + col.tooltipPlacement + '" ') : '') +
                        (col.canEdit ? ('can-edit="' + col.canEdit + '" ') : '');
                    break;

                case service.PropTypes.SimpleCheck:
                    props += (col.canEdit ? ('can-edit="' + col.canEdit + '" ') : '');
                    break;

                case service.PropTypes.Picture:
                    getCClassAttr();
                    props += (col.containerClass ? ('container-class="' + col.containerClass + '" ') : '') +
                        (col.icon ? ('icon="' + col.icon + '" ') : '') +
                        (col.areaType ? ('area-type="' + col.areaType + '" ') : '') +
                        (col.bgColor ? ('bg-color="' + col.bgColor + '" ') : '') +
                        (col.color ? ('color="' + col.color + '" ') : '') +
                        (col.imgSize ? ('img-size="' + col.imgSize + '" ') : '') +
                        'size="' + (col.size || '::null') + '" ' +
                        'img-observer-service="::$ctrl.imgObserverService" ' +
                        (col.loadLater ? ' load-later="true" ' : '') +
                        (col.defaultText ? 'default-text="' + col.defaultText + '" ' : '') +
                        (col.showLabel ? 'show-label="true" ' : '') +
                        (col.canUploadAttr ? 'can-upload-attr="true" ' : '') +
                        (col.canChangeName ? 'can-change-name="true" ' : '') +
                        (col.collectionProp ? 'collection-prop="' + col.collectionProp + '" ' : '') +
                        (col.imgProp ? ('img-prop="' + col.imgProp + '" ') : '') +
                        (col.withoutInitials ? ('without-initials="' + col.withoutInitials + '" ') : '') +
                        (col.withoutBgColor ? ('without-bg-color="' + col.withoutBgColor + '" ') : '') +
                        (col.iconLevel ? ('icon-level="' + col.iconLevel + '" ') : '') +
                        (col.withImgBg ? ('with-img-bg="' + col.withImgBg + '" ') : '') +
                        (col.codeName ? 'code-name="' + col.codeName + '" ' : '') +
                        (col.withView ? ('with-view="true" ' + (col.withNext ? 'with-next="true" ' : '')) : '') +
                        (col.withViewOnEmpty ? ('with-view-on-empty="true"') : '') +
                        (col.withCommentsOnItem ? 'with-comments-on-item="true" ' : '') +
                        (col.withLikesOnItem ? 'with-likes-on-item="true" ' : '') +
                        (col.withCommentsCount ? 'with-comments-count="true" ' : '') +
                        (col.withoutRemove ? 'without-remove="true" ' : '') +
                        (col.setName ? 'set-name="true" ' : '') +
                        (col.isAvatarAttr ? 'is-avatar-attr="true" ' : '') +
                        (col.isPosterAttr ? 'is-poster-attr="true" ' : '') +
                        (col.startWithEditorAttr ? 'start-with-editor-attr="true" ' : '') +
                        (col.showMetadaAfterAttr ? 'show-metadata-after-attr="true" ' : '') +
                        ('item="' + (col.item ? col.item : '$ctrl.item') + '" ') +
                        (col.itemIdProp ? ('item-id-prop="' + col.itemIdProp + '" ') : '') +
                        'parent-component-id="{{::$ctrl.componentId}}" '; // from grid item
                    break;

                case service.PropTypes.Selectize:
                    getCClassAttr();
                    break;

                default:
//must be added as params on item.grid.group.edit.controller.service
                    break;

                function getFieldClassAttr() {
                    var prop = 'eClassAttr',
                        und = col.canEdit ? (withoutClose ? 'with-underline' : (col.withFullHeight ? '' : 'hover-underline')) : '';

                    if (und && (!col[prop] || col[prop].indexOf(und) === -1)) {
                        col[prop] = (col[prop] || '') + ' ' + und;
                    }

                    /* var l = col[prop]?col[prop].split(' ');
                    if(l.indexOf('text-center')){
                        col.wrapperClass = col.wrapperClass || '' + ' centering';
                    }*/
                    removeFieldTextCenter(prop);
                    if (col.pageClass) {
                        col[prop] = (col[prop] || '') + ' ' + col.pageClass;
                    }

                    function removeFieldTextCenter(prop) {
                        if (withoutClose && col[prop]) {
                            col[prop] = col[prop].replace('text-center', '');
                        }
                    }
                }

                function getCClassAttr() {
                    var cls = 'without-underline without-arrow',
                        cClassAttr = col.cClassAttr;
                    col.cClassAttr = (cClassAttr ? (
                            (withoutClose ? cClassAttr.replace('text-center', '') : cClassAttr) + ' '
                        ) : '') +
                        (withoutClose ? (col.canEdit ? 'with-underline ' :
                            (cClassAttr && cClassAttr.indexOf(' with-arrow') !== -1) ? 'without-underline ' : cls) : cls);
                    getFieldClassAttr();

                    function has(cls) {
                        return cls ? cls.indexOf('wrapper-outer') !== -1 : false;
                    }
                }
            }
        }


        function saveOnKeydown() {
            if(formOptions.saveOnKeydown){
                col.saveOnKeydown = true;
            }
        }

        function getInitListAttr(col) {
            //return 'init-list="' + (formOptions.useSettings ? ('::$ctrl.Settings.' + col.initListName) : (col.initList ? col.initList : '::$ctrl.initList')) + '" ';
            return (col.initListName ? ('init-list="::$ctrl.initList ? $ctrl.initList : $ctrl.Settings.' + col.initListName+'" ') : '');
        }

        function getTag(type) {
            return 'sb-' + get(type);

            function get(type) {
                switch (type) {
                    case service.PropTypes.Field:
                        return 'input';

                    case service.PropTypes.Number:
                        return 'number';

                    case service.PropTypes.Email:
                        return 'email';

                    case service.PropTypes.Html:
                        return 'html';

                    case service.PropTypes.Contenteditable:
                        return 'contenteditable';

                    case service.PropTypes.Address:
                        return 'address';

                    case service.PropTypes.Phone:
                        return 'phone';

                    case service.PropTypes.Scene:
                        return 'scene';

                    case service.PropTypes.Size:
                        return 'size';

                    case service.PropTypes.Shot:
                        return 'input';

                    case service.PropTypes.BigCheck:
                        return 'big-check';

                    case service.PropTypes.SimpleCheck:
                        return 'simple-check';

                    case service.PropTypes.Date:
                        return 'date';

                    case service.PropTypes.Dates:
                        return 'dates';

                    case service.PropTypes.DateRange:
                        return 'daterange';

                    case service.PropTypes.Drp:
                        return 'dropdown';

                    case service.PropTypes.Style:
                        return 'style-dropdown';

                    case service.PropTypes.Border:
                        return 'border-dropdown';

                    case service.PropTypes.Pages:
                        return 'pages-dropdown';

                    case service.PropTypes.TopCall:
                        return 'top-call-dropdown';


                    case service.PropTypes.SceneType:
                        return 'scene-type-dropdown';

                    case service.PropTypes.DayTime:
                        return 'day-time-dropdown';

                    case service.PropTypes.Color:
                        return 'color-dropdown';

                    case service.PropTypes.Icon:
                        return 'icon-dropdown';

                    case service.PropTypes.Radio:
                        return 'radio-dropdown';

                    case service.PropTypes.Check:
                        return 'check-dropdown';

                    case service.PropTypes.Time:
                        return 'timepicker-dropdown';

                    case service.PropTypes.Calltime:
                        return 'calltime-dropdown';

                    case service.PropTypes.Pickuptime:
                        return 'pickuptime-dropdown';

                    case service.PropTypes.HMUtime:
                        return 'hmutime-dropdown';

                    case service.PropTypes.Costumestime:
                        return 'costumestime-dropdown';

                    case service.PropTypes.Wraptime:
                        return 'wraptime-dropdown';

                    case service.PropTypes.Onsettime:
                        return 'onsettime-dropdown';

                    case service.PropTypes.EstTime:
                        return 'esttime-dropdown';

                    case service.PropTypes.Duration:
                        return 'duration-dropdown';

                    case service.PropTypes.Timecode:
                        return 'timecode-dropdown';
                    case service.PropTypes.TimecodeRange:
                        return 'timecode-range-dropdown';

                    case service.PropTypes.Rate:
                        return 'rate-dropdown';

                    case service.PropTypes.ContactRate:
                        return 'contact-rate-dropdown';

                    case service.PropTypes.Position:
                        return 'position';

                    case service.PropTypes.Locations:
                        return 'assign-locations';

                    case service.PropTypes.Characters:
                        return 'assign-characters';

                    case service.PropTypes.Team:
                        return 'assign-team';
                    case service.PropTypes.Projects:
                        return 'assign-team';

                    case service.PropTypes.Collaborators:
                        return 'assign-collaborators';

                    case service.PropTypes.Likes:
                        return 'assign-likes';

                    case service.PropTypes.Selectize:
                        return 'selectize';

                    case service.PropTypes.StripLocation:
                        return 'strip-location';

                    case service.PropTypes.Picture:
                        return 'resizable-img';

                    default:
                        console.warn('service.getTag: must choose tag for type ' + type);
                        return '';
                }
            }
        }
    }

    function getEditFieldForCol($ctrl, c, formOptions) {
        return service.getSBColContentEdit($ctrl,
            _.extend({
                    //pageClass: $ctrl.pageClass
                }, c, c.type === service.PropTypes.HtmlTooltip ? {type: service.PropTypes.Html} : null
            ),
            $ctrl.item._id,
            _.extend({
                    elementId: $ctrl.getElementId(c.prop)
                }, getWithoutCloseParams(), formOptions
            ));
    }
}


angular.module('sb.fields.inputfield.service', [
    'sb.fields.field.service'
])
.service('SBInputFieldCtrlService', SBInputFieldCtrlService);
SBInputFieldCtrlService.$inject = ['SBFieldCtrlService'];
function SBInputFieldCtrlService(SBFieldCtrlService) {
    return function ($ctrl, $element, $attrs, withoutTemplateScope) {
        $ctrl = new SBFieldCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

        if (!$ctrl.inputType) {
            $ctrl.inputType = 'text';
        }

        if (!$ctrl.setValue) {
            $ctrl.setValue = setValue;
        }

        if (!$ctrl.getItemTemplate) {
            $ctrl.getItemTemplate = getItemTemplate;
        }
        
        $ctrl.onLoaded = onLoaded;

        //$ctrl.addRootWatcher('NEXT_TAB_INDEX_'+$ctrl.groupId+'_'+$ctrl.tabNextIndex);

        return $ctrl;

        function getItemTemplate() {
            return '<input ' +
                'type="' + $ctrl.inputType + '" ' +
                '{{props}}' +
                '/>' +
($ctrl.attrs.withLabel ? ('<label class="with-label '+($ctrl.getInputValue() ? '' :'sb-hide')+'">' + $ctrl.attrs.withLabel + '</label>') : '');
        }

        function onLoaded() {
            //console.log('SBInputFieldCtrlService.onLoaded');
            if (typeof ($ctrl.onItemLoaded) === 'function') {
                $ctrl.onItemLoaded();
            }
        }

        function setValue(next) {
            $ctrl.value = $ctrl.getInputValue();
            if ($ctrl.value === '') {
                $ctrl.value = null;
            }
            if($ctrl.attrs.withLabel){
                $ctrl.LCS[$ctrl.value ? 'removeClass':'addClass']($ctrl.element.querySelector('label'), 'sb-hide');
            }
            next();
        }
    }
}


angular.module('sb.fields.selectize.component', [])
.component('sbSelectize', {
    bindings: {
        ngModel: '<',
        config: '<?',
        initList: '<?',
        ngDisabled: '<',
        ngRequired: '&',
        maxItems: '@'
    },
    require: { modelCtrl: 'ngModel' },
    controller: SbSelectizeController
})
.controller('SbSelectizeController', SbSelectizeController);

SbSelectizeController.$inject = ['LCS', '$element', '$attrs'];

function SbSelectizeController(LCS, $element, $attrs) {
    var $ctrl = this,
        selectize, settings,
        previousModel = {ngModel: undefined, options: undefined},
        changedFields = ['ngDisabled', 'ngModel'];


    $ctrl.LCS = LCS;
    $ctrl.$element = $element;
    $ctrl.selectorCacheUpdate = selectorCacheUpdate;

    $ctrl.setSelectizeOptions = setSelectizeOptions;
    $ctrl.setSelectizeValue = setSelectizeValue;

    $ctrl.$onInit = $onInit;
    $ctrl.$onChanges = $onChanges;
    $ctrl.$doCheck = $doCheck;

    function $onInit() {
        if(!$ctrl.checkFields){
            $ctrl.checkFields = ['options', 'ngModel'];
        }
        if(!$ctrl.initList) {
            $ctrl.initList = [];
        }
        if(!$ctrl.config){$ctrl.config = {};}

        settings = _.extend({}, Selectize.default, {
                delimiter: '|',
                wrapperClass: 'selectize-control',
                inputClass: $attrs.fieldClass ? $attrs.fieldClass : 'selectize-input selected-text countries',
                dropdownClass: 'selectize-dropdown ',
                dropdownContentClass: 'selectize-dropdown-content ',

                maxItems: $attrs.maxItems ? parseInt($attrs.maxItems, 10) : 1,

                placeholder: $attrs.placeholder ? $attrs.placeholder :'',
        }, $ctrl.config);

        settings.onChange = onChange;
        settings.onOptionAdd = onOptionAdd;
        settings.onInitialize = onInitialize;

        $ctrl.isRequired = $attrs.required==='true' || $attrs.required===true || settings.required;
        $ctrl.isMaxLength = $attrs.maxlength ? parseInt($attrs.maxlength, 10) : null;
        $ctrl.isMinLength = $attrs.maxlength ? parseInt($attrs.minlength, 10) : null;


        $ctrl.$element.selectize(settings);
        $ctrl.$element.on('$destroy', onElementDestroy);
    }

    function $onChanges(changes) {
        //console.log(changes);
        if (!changes) {
            return;
        }
        $ctrl.LCS.onFieldChanges(changes, changedFields, method);

        function method(field, change){
            switch (field) {
                case 'ngDisabled':
                    toggle(change.currentValue);
                    return true;
                case 'ngModel':
                    $ctrl.setSelectizeValue();
                    return true;
            }
            return true;
        }
    }

    function $doCheck() {
        if( !previousModel){return;}
        for (var i = 0, l = $ctrl.checkFields.length; i < l; i++) {
            var field = $ctrl.checkFields[i];
            if (previousModel[field] !== undefined && !angular.equals($ctrl[field], previousModel[field])) {
                switch (field) {
                    case 'initList':
                        $ctrl.setSelectizeOptions($ctrl[field], previousModel[field]);
                        break;
                    case 'ngModel':
                        $ctrl.setSelectizeValue();
                        break;
                }
                previousModel[field] = angular.copy($ctrl[field]);
            }
        }
    }

    function selectorCacheUpdate(key, value, type) {
        var cached = selectize.renderCache[type][key];
        // update cached element
        var newValue = angular.element(cached).html(value);
        selectize.renderCache[type][key] = newValue[0].outerHTML;
        return newValue.html();
    }

    function toggle(disabled) {
        disabled ? selectize.disable() : selectize.enable();
    }

    function setSelectizeOptions(curr, prev) {
        _.each(prev, function (opt) {
            if (curr.indexOf(opt) === -1) {
                var value = opt[settings.valueField];
                selectize.removeOption(value, true);
            }
        });

        selectize.addOption(curr, true);

        $ctrl.LCS.timeout(function () {
            selectize.refreshOptions(false); // updates results if user has entered a query
        }, 0);
        $ctrl.setSelectizeValue();
    }

    function setSelectizeValue() {
        if($ctrl.isRequired) {
            $ctrl.modelCtrl.$setValidity('required', !isEmpty($ctrl.ngModel));
            selectize.$control.toggleClass('ng-valid', $ctrl.modelCtrl.$valid);
            selectize.$control.toggleClass('ng-invalid', $ctrl.modelCtrl.$invalid);
            selectize.$control.toggleClass('ng-dirty', $ctrl.modelCtrl.$dirty);
            selectize.$control.toggleClass('ng-pristine', $ctrl.modelCtrl.$pristine);

        }

        if (!angular.equals(selectize.items, $ctrl.ngModel)) {
            selectize.setValue($ctrl.ngModel, true);
        }

        function isEmpty(val) {
            return val === undefined || val === null || !val.length; //support checking empty arrays
        }
    }

    function onChange(value) {
        var value = angular.copy(selectize.items);
        if (settings.maxItems === 1) {
            value = value[0];
        }
        if($ctrl.modelCtrl) {
            $ctrl.modelCtrl.$setViewValue(value);
        }
        if ($ctrl.config.onChange) {
            $ctrl.config.onChange.apply(this, arguments);
        }
    }

    function onOptionAdd(value, data) {
        //console.log('SbSelectizeController.onOptionAdd');
        var el = $ctrl.initList ? _.find($ctrl.initList, function (el){
            return el[$ctrl.config.labelField] === data[$ctrl.config.labelField];
        }) : null;
        if (!el) {
           // $ctrl.initList.push(data);

            //console.log('SbSelectizeController.onOptionAdd element exists');
            if ($ctrl.config.onOptionAdd) {
                $ctrl.config.onOptionAdd.apply(this, arguments);
            }
        }
    }

    function onInitialize() {
        selectize = $ctrl.$element[0].selectize;
        if ($attrs.partialId) selectize.partialId = $attrs.partialId;

        $ctrl.setSelectizeOptions($ctrl.initList);

        //provides a way to access the selectize element from an
        //angular controller
        if ($ctrl.config.onInitialize) {
            $ctrl.config.onInitialize(selectize);
        }
    }

    function onElementDestroy() {
        if (selectize) {
            selectize.destroy();
            $ctrl.$element = null;
        }
    }
}


angular.module('sb.fields.selector.component', [])
.component('sbSelector', sbFieldComponentParams('SbSelectorController',{
    value: '<',
    config: '<?',
    initList: '<?',

    drpClassAttr: '@?',
    labelField: '@',
    valueField: '@',
    maxItems: '@'
}))
.controller('SbSelectorController', SbSelectorController);

SbSelectorController.$inject = ['$element', '$attrs', '$timeout'];

function SbSelectorController($element, $attrs, $timeout) {
    var $ctrl = this,
        selectize, settings,
        previousModel = {ngModel: undefined, options: undefined},
        checkFields = ['options', 'ngModel'];


    $ctrl.$element = $element;
    $ctrl.selectorCacheUpdate = selectorCacheUpdate;

    $ctrl.setSelectizeOptions = setSelectizeOptions;
    $ctrl.setSelectizeValue = setSelectizeValue;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        if(!$ctrl.initList) {
            $ctrl.initList = [];
        }
        if(!$ctrl.config){$ctrl.config = {};}

        settings = _.extend({}, Selectize.default, {
                delimiter: '|',
                wrapperClass: $ctrl.drpClassAttr || 'selectize-control',
                inputClass: $ctrl.config.inputClass ? ($ctrl.config.inputClass + ' selectize-input selected-text ') :
                    ($attrs.fieldClass ? $attrs.fieldClass : 'selectize-input selected-text countries'),
                dropdownClass: 'selectize-dropdown ',
                dropdownContentClass: 'selectize-dropdown-content ',

                maxItems: $attrs.maxItems ? parseInt($attrs.maxItems,10) : 1,

                placeholder: $attrs.placeholder ? $attrs.placeholder :'',
        }, $ctrl.config);

        settings.onOptionAdd = onOptionAdd;
        settings.onInitialize = onInitialize;

        $ctrl.isRequired = $attrs.required==='true' || $attrs.required===true || settings.required;

        $ctrl.$element.selectize(settings);
        $ctrl.$element.on('$destroy', onElementDestroy);
    }

    function selectorCacheUpdate(key, value, type) {
        var cached = selectize.renderCache[type][key];
        // update cached element
        var newValue = angular.element(cached).html(value);
        selectize.renderCache[type][key] = newValue[0].outerHTML;
        return newValue.html();
    }

    function toggle(disabled) {
        disabled ? selectize.disable() : selectize.enable();
    }

    function setSelectizeOptions(curr, prev) {
        _.each(prev, function (opt) {
            if (curr.indexOf(opt) === -1) {
                var value = opt[settings.valueField];
                selectize.removeOption(value, true);
            }
        });

        selectize.addOption(curr, true);

        $timeout(function () {
            selectize.refreshOptions(false); // updates results if user has entered a query
            $ctrl.setSelectizeValue();
        }, 0);
    }

    function setSelectizeValue() {
        if($ctrl.isRequired) {
            $ctrl.modelCtrl.$setValidity('required', !isEmpty($ctrl.value));
            selectize.$control.toggleClass('ng-valid', $ctrl.modelCtrl.$valid);
            selectize.$control.toggleClass('ng-invalid', $ctrl.modelCtrl.$invalid);
            selectize.$control.toggleClass('ng-dirty', $ctrl.modelCtrl.$dirty);
            selectize.$control.toggleClass('ng-pristine', $ctrl.modelCtrl.$pristine);

        }
        if (!angular.equals(selectize.items, $ctrl.ngModel)) {
            selectize.setValue($ctrl.ngModel, true);
        }

        function isEmpty(val) {
            return val === undefined || val === null || !val.length; //support checking empty arrays
        }
    }

    function onOptionAdd(value, data) {
        console.log('SbSelectorController.onOptionAdd');
        var el = $ctrl.initList ? _.find($ctrl.initList, function (el){
            return el[$ctrl.config.labelField] === data[$ctrl.config.labelField];
        }) : null;
        if (!el) {
            console.log('SbSelectorController.onOptionAdd element exists');
            if ($ctrl.config.onOptionAdd) {
                $ctrl.config.onOptionAdd.apply(this, arguments);
            }
        }
    }

    function onInitialize() {
        selectize = $ctrl.$element[0].selectize;
        if ($attrs.partialId) selectize.partialId = $attrs.partialId;

        $ctrl.setSelectizeOptions($ctrl.initList);

        //provides a way to access the selectize element from an
        //angular controller
        if ($ctrl.config.onInitialize) {
            $ctrl.config.onInitialize(selectize);
        }
    }

    function onElementDestroy() {
        if (selectize) {
            selectize.destroy();
            $ctrl.$element = null;
        }
    }
}

