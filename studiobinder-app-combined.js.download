    '</div>' +
'</div>'
)

.controller('ShareCallsheetCtrl', ShareCallsheetCtrl);
ShareCallsheetCtrl.$inject = ['CompInitCtrlService', 'CallsheetsService'];
function ShareCallsheetCtrl(CompInitCtrlService, CallsheetsService) {
    var $ctrl = this;
    $ctrl = new CompInitCtrlService($ctrl);
    $ctrl.focus = 1;
    var share = {
        withApproval: true,
        comment: null
    };

    $ctrl.onSave = onSave;
    $ctrl.onError = onError;
    $ctrl.cancelPopup = cancelPopup;
    $ctrl.refresh = refresh;
    $ctrl.addItem = addItem;
    $ctrl.removeItem = removeItem;
    $ctrl.shareCallsheet = shareCallsheet;
    $ctrl.getInitials = $ctrl.security.getInitialsByName;
    $ctrl.getNameColor = $ctrl.security.getNameColor;
    $ctrl.isFocus = isFocus;
    $ctrl.getFocus = getFocus;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.callsheetId = $ctrl.item.callsheetId;
        if ($ctrl.extraParam && $ctrl.extraParam.items && $ctrl.extraParam.items.length > 0) {
            share.approvers = $ctrl.extraParam.items;
            share.exists = true;
            //if(share.approvers.length == 1)share.withApproval = share.approvers[0].type == 2;
            $ctrl.focus = 0;
        } else {
            share.approvers = [{email: null, name: null}];
            share.exists = false;
        }

        $ctrl.share = share;
        $ctrl.formHolder = {};
    }

    function onSave(result) {
        $ctrl.isUpdating = false;
        if (result.ok) {//result
            $ctrl.broadcastRoot('SHARE_CALLSHEET', result.type);
            $ctrl.onClose({result: result});
        } else if (result.writeErrors && result.writeErrors.length > 0) {
            $ctrl.error = '';
            for (var i = 0; i < result.writeErrors.length; i++) {
                $ctrl.error += result.writeErrors[i];
            }
        }
    }

    function onError(error) {
        $ctrl.isUpdating = false;
        $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.callsheet.share.error');
    }

    function cancelPopup() {
        $ctrl.refresh();
        if ($ctrl.onClose) {
            $ctrl.onClose({result: 'cancel'});
        }
    }

    function refresh() {
        $ctrl.error = '';
    }

    function addItem() {
        $ctrl.share.approvers.push({name: null, email: null});
        $ctrl.focus = $ctrl.getFocus($ctrl.share.approvers.length - 1, 1);
    }

    function removeItem(el) {
        for (var i = $ctrl.share.approvers.length - 1; i >= 0; i--) {
            if ($ctrl.share.approvers[i]._id === el._id) {
                $ctrl.share.approvers.splice(i, 1);
                if (i > 1) {
                    $ctrl.focus = $ctrl.getFocus(i - 1, 1);
                }
                break;
            }
        }
    }

    function shareCallsheet(e) {
        $ctrl.error = null;
        if ($ctrl.isUpdating) {return;}

        if ($ctrl.share.approvers.length === 0) {
            $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.callsheet.share.invalidcount');
            return;
        }

        $ctrl.formHolderItem.formItem_attempted = true;
        if (!$ctrl.formHolderItem.formItem || !$ctrl.formHolderItem.formItem.$valid) {
            return;
        }

        //send only to selected
        $ctrl.isUpdating = true;
        $ctrl.share.productId = $ctrl.CPS.productId;
        $ctrl.share.companyId = $ctrl.CPS.companyId;
        $ctrl.share.callsheetId = $ctrl.callsheetId;
        CallsheetsService.share($ctrl.share, $ctrl.onSave, $ctrl.onError);
    }

    function isFocus(index, val) {
        return $ctrl.getFocus(index, val) === $ctrl.focus;
    }

    function getFocus(index, val) {
        return index * 2 + val;
    }
}

