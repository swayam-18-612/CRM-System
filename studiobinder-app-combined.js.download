angular.module('product.breakdown.sceneNotes.edit.controller', [
    'apiServices.Strips'
])

.component('sceneNotes', {
    bindings: {
        hideHeader: '@',
        item: '<',
        canComment:'<',
        onSceneNotesUpdate:'&',
    },
    controller: 'SceneNotesCtrl'
})
.controller('SceneNotesCtrl', SceneNotesCtrl);

SceneNotesCtrl.$inject = ['TemplateCompileCompCtrlService', 'StripsService', '$element'];
function SceneNotesCtrl(TemplateCompileCompCtrlService, service, $element) {
    var $ctrl = this;
    //console.log('SceneNotesCtrl') ;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.openProPopup = openProPopup;


    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.service = service;
        //$ctrl.editorType = ''
        $ctrl.elemType = 'BREAKDOWN';
        $ctrl.placeholder = 'Enter scene notes…';
        $ctrl.field = 'breakdownNotes';
        $ctrl.popupTitle = 'Scene Notes';
        $ctrl.emptyField = 'There are no notes added for this scene';

        $ctrl.canEdit = $ctrl.canComment;

        $ctrl.onItemUpdate = onItemUpdate;
    }

    function openProPopup(type, e){
        $ctrl.CPS.openProPopup(e);
    }

    function getItemTemplate() {
        //console.log('sceneNotes.getItemTemplate');
        var quotaType = 'breakdownsAdvanced',
          isPro = !$ctrl.CPS.hasQuotaType(quotaType);
        $ctrl.editorType = 'breakdownscene';
        return '<div class="with-padding document-version-wrapper with-min-height">' +
            ($ctrl.canComment ? ('<div class="margin-half centering document-version-wrapper" ng-class="{\'hide-print\':!$ctrl.item[$ctrl.field]}">' +
                    ($ctrl.hideHeader ? '' : ('<div class="header-small clearfix spacing-half-bottom">'+$ctrl.popupTitle+ (isPro ? '<span class="with-margin-left profeature position-relative">PRO</span>' : '') +'</div>')) +
                '<div id="sceneNotesSection" class="notes spacing '+(isPro ? $ctrl.getBtnActionCls():'')+'"' +
                    (isPro ? (' data-type="openProPopup" anaytics-on="" analytics-action="Breakdown Scene Notes" data-quota="' + quotaType + '"') : '') +
                    '>' +
                    '<content-editor-bubble ' +
                        'class="full-width display-block content-editor-bubble clearfix centered sceneNotesBubble withborderbottom" ' +
                    ($ctrl.editorType ? ('editor-type="'+$ctrl.editorType+'"') : '') +
                        'placeholder="'+$ctrl.placeholder+'" ' +
                        'can-edit="::' + (isPro ? false : $ctrl.canEdit) + '" ' +
                        'field="'+$ctrl.field+'" ' +
                        'service="::$ctrl.service" ' +
                        'item="::$ctrl.item" ' +
                        'on-item-update="$ctrl.onItemUpdate(result)"' +
                    '></content-editor-bubble>' +
                '</div>' +
            '</div>') :
            ($ctrl.item[$ctrl.field] ? ('<div class="margin-half centering document-version-wrapper">' +
                ($ctrl.hideHeader ? '' : ('<div class="header-small clearfix spacing-half-bottom">'+$ctrl.popupTitle+'</div>')) +
                '<div class="spacing-half notes view-mode ql-editor full-width padding-left-20 padding-right-20 bg-white" style="background-color:white">'+$ctrl.item[$ctrl.field] +'</div>') : '') +
            '</div>')  +
        '</div>';
    }

    function onItemUpdate(result) {
        //console.log('SceneNotesCtrl.onItemUpdate');
        if(typeof($ctrl.onSceneNotesUpdate) === 'function') {
            var item = result ? result.item : null;
            $ctrl.onSceneNotesUpdate({item: item});
        }
    }
}


