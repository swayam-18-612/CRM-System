        function removeHiddenBtnSave() {
            $ctrl.LCS.removeClass(getBtnSave(), 'sb-hide');
        }

        function unloadSaveBtn() {
            setSaveEvent(getBtnSave(), false);
        }

        function getBtnSave(){
            return document.querySelector('#btnSaveDocChanges');
        }

        function getTitleEl(){
            return $ctrl.element.querySelector('.' + $ctrl.titleCls);
        }

        function setTitleName(el){
            if(!el) {
                el = getTitleEl();
            }
            if(el) {
                var name = $ctrl.document ? $ctrl.document.name : null;
                var c = name === 'New Note' ? '' : name;
                el.innerText = c;
                return c;
            }
            return null;
        }

        function bindTitleEvents(isBind){
            var el = getTitleEl();
            if(el && $ctrl.canEdit) {
                $ctrl.LCS.bindElementsClick(isBind, el, onBlur, null, 'blur');
                $ctrl.LCS.bindElementsClick(isBind, el, onKeyUp, null, 'keyup paste');

                if (isBind && !setTitleName(el)) {
                    $ctrl.LCS.timeout(function (){
                        el.focus();
                    }, 100);
                }
            }

            function onBlur(e){
                //console.log ('onBlur');
                $ctrl.preventDefault(e);
                process(e, true, true);
            }

            function focusEditor(){
                var el = $ctrl.element.querySelector('.sb-editor .ql-editor');
                if(el){el.focus();}
            }

            function onKeyUp(e){
                //console.log ('onKeyUp');
                if (e.type === 'paste') {
                    process(e, false);
                    return;
                }
                switch (e.which) {
                    case 13: //enter
                        e.currentTarget.innerHTML = e.currentTarget.innerHTML.replace('<br/>', '').replace('<br>', '');
                        $ctrl.preventDefault(e);
                        process(e, true, true);
                        break;

                    case 9: //tab
                        $ctrl.preventDefault(e);
                        process(e, true, true);
                        break;

                    case 27: //esc
                        $ctrl.preventDefault(e);
                        process(e, true, false);
                        break;

                    default:
                        e.stopPropagation();
                        process(e, false, false);
                        break;
                }
            }

            function process(e, update, withNext){
                var val = e.currentTarget.innerText;
                if(val && $ctrl.item){
                    //rename document
                    $ctrl.broadcastRoot('RENAME_' + $ctrl.elemType + '_ITEM',{
                        item: {
                            _id: $ctrl.documentId,
                            versionId: $ctrl.item._id,
                            name: val
                        },
                        update: update
                    });
                    if(withNext) {
                        focusEditor();
                    }
                }
            }
        }

        function onRenamedNote(result){ //item.version
            console.log('onRenamedNote');
            var item = result ? result.item : null;
            if(item && $ctrl.item && item._id === $ctrl.item._id) {
                updateName(item);
            }
        }
        function onNameChanged(item){  //item is document and has item.version
            console.log('DocumentPageInitCtrlService.onNameChanged');
            if(item && $ctrl.document && $ctrl.documentId === item._id &&
                item.versionId === $ctrl.item._id) {
                updateName(item.version);
                setTitleName();
            }
        }

        function updateName(version) {
            $ctrl.item.name = version.name;
            $ctrl.document.name = version.name;
            if (version.updatedAt) {
                $ctrl.item.updatedAt = version.updatedAt;
                $ctrl.item.updatedAtT = version.updatedAtT;
                $ctrl.document.updatedAt = version.updatedAt;
                $ctrl.document.updatedAtT = version.updatedAtT;
            }

            if (version.contentVersionId && version.contentVersionId !== version.contentVersionId) {
                $ctrl.item.contentVersionId = version.contentVersionId;
            }

            if (version.description !== undefined) {
                $ctrl.item.description = version.description;
            }
            setTime(version);
        }

        function setTime(item){
            if($ctrl.withDocumentInline && item) {
                var el = $ctrl.element.querySelector('.lastUpdated');
                if (el) {
                    el.innerText = $ctrl.CPS.getCreatedAt(item.updatedAt ? item.updatedAt : item.createdAt, 'MMMM D ' + ' @ ' + $ctrl.CPS.timeFormat);
                }
            }
        }

        function loadSaveBtn() {
            $ctrl.LCS.timeout(function () {
                var parent = $ctrl.element.querySelector('nav.filters');
                if (!parent) {
                    return;
                }
                var a = document.createElement('a');
                a.setAttribute('id', 'btnSaveDocChanges');
                $ctrl.LCS.addClass(a, 'sb-hide btnsaving btn btn-small without-text transparent with-margin-left inline-block floppySaved ');

                $ctrl.LCS.appendChildFragment(a, $ctrl.LCS.getISBDiv('save', 3));
                setSaveEvent(a, true);
                parent.appendChild(a);
            }, 0);
        }

        function setSaveEvent(el, isBind) {
            $ctrl.LCS.bindElementListeners(isBind, el, $ctrl.onSaveDocEvent);
        }

        function saveDocChanges(onSuccess) {
            var id = $ctrl.item && $ctrl.item._id ? $ctrl.item._id : null;
            if (id) {
                var p = {id: id, type: 'documentVersion'};
                if(typeof (onSuccess) === 'function'){
                    p.onSuccess = onSuccess;
                }
                $ctrl.broadcastRoot('SAVE_DOC_CHANGES_' + id, p);
            }
        }


        function openScriptOutline(e) {
            $ctrl.preventDefault(e);
            //planFetatures testmode
            var quotaType = $ctrl.item.type === 3 ? 'avscriptOutline' : ($ctrl.item.type === 2 ? 'scriptOutline' : null);
            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});
        }

        function doOnFileSaved(onSuccess) {
            console.log('checkDownload');
            if($ctrl.SessionService.hasDocChanges) {
                $ctrl.saveDocChanges(onSuccess);
            }else{
                onSuccess();
            }
        }

        function openVersions() {
            /*if(!$ctrl.item.contentVersion){
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.revisionmanager.noversions', 'error');
                return;
            }*/
            $ctrl.popupsService.teamAccess(function () {
                $ctrl.popupsService.open($ctrl.item, $ctrl.popupsService.operations.documentRevisionHistory, {}, $ctrl.compOptions);
            });
        }

        function openDownload(){
            var item = $ctrl.item;
            if(!item){
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.download.error', 'error');
                return;
            }
            $ctrl.doOnFileSaved(function (){
                $ctrl.popupsService.open(item, $ctrl.popupsService.operations.documentDownload,  {
                    itemTitle: 'Version',
                    versionId: item._id,
                    title: item.name,
                    titlePage: item.titlePage,
                    createdBy: item.createdBy
                }, $ctrl.compOptions);
            });
        }

        function getVersionTemplate() {
            console.log('getVersionTemplate');
            $ctrl.copyItem = _.clone($ctrl.item); // make it a new one so that accepts onchanges instead of new
//$ctrl.item.active
            return $ctrl.copyItem ? ('<document-version-editor item="::$ctrl.copyItem" class-toolbar-attr="static-toolbar '+
                    ($ctrl.withScriptOutline ? ' with-script-outline' : '')+
                    '" can-edit="::'+canEdit()+ '" show-secondary-buttons="::true" on-save-version="$ctrl.onSaveVersion(version)"></document-version-editor>')
            : '';
        }
        function canEdit(){
            return $ctrl.document && $ctrl.document.active && $ctrl.canEdit;
        }

        function onSaveVersion(version){
            setItem(version);
            if($ctrl.document && version) {
                $ctrl.document.name = version.name;
            }
        }

        function duplicateVersion(e) {
            $ctrl.preventDefault(e);
        }

        function onScriptSyncedToProject(result) {
            console.log('onScriptSyncedToProject');
            //$ctrl.popupsService.open(null, $ctrl.popupsService.operations.scriptSyncedToProject);
            var script = result.script, userId = result.lastSyncedById;

            setItem(_.extend($ctrl.item, {_id: result.versionId}, {
                isLocked: result.isLocked,
                isLockedFirst: result.isLockedFirst,
                lastSyncedAt: result.lastSyncedAt,
                lastSyncedById: userId,
                lastSyncedBy: $ctrl.CPS.userId === userId ? $ctrl.CPS.user : {},
                lastSyncedScriptId: script ? script._id : null,
                lastSyncedScript: script
            }));

            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.Synced.success', 'success', {
                name: $ctrl.item.name
            });
            $ctrl.broadcastRoot('SCRIPT_SYNCED_TO_PROJECT_SIDEBAR', $ctrl.item);
        }


        function publishScript(e) {
            $ctrl.preventDefault(e);
            // if script is locked trigger renumber popup opening
            if (!$ctrl.item || !$ctrl.item._id) {
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.syncToProject.invalid', 'error');
                return;
            }

            if ($ctrl.item.isLocked) {//if is locked check if has all scene numbers
                $ctrl.broadcastRoot('SYNC_QUILL_TO_PROJECT', $ctrl.item._id);
            } else {//open sync popup
                onPublishScriptPart2($ctrl.item._id);
            }
        }

        function getNotes(){
            var page = $ctrl.BlocksSetupService.getCurrentTodoPage().text;
            return {
                notes: 'Screenplay Sync was initiated via <span class="semibold">'+page+'</span> page.',
                summary: 'sync|' + page,
            }
        }

        function onPublishScriptPart2(id) {
            if (!($ctrl.item && $ctrl.item._id && id === $ctrl.item._id)) {
                return onError();
            }
            console.log('onPublishScriptPart2 ' + id);

            var product = $ctrl.CurrentProduct.getProduct();
            if (!product) {
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.syncToProject.invalid', 'error');
                return;
            }

            //isPopupOpened check needed if there are 2 btns that get triggered
            if ($ctrl.isPopupOpened) {
                return;
            }

            $ctrl.isPopupOpened = true;
            var overwriteScript = false;
            $ctrl.popupsService.open($ctrl.DocumentVersionsService.getDuplicate($ctrl.item, null, null), $ctrl.popupsService.operations.scriptVersionEdit, {
                elemType: $ctrl.elemType,
                itemTitle: 'Script',
                modalTitle: 'Screenplay Name',
                btnText: 'Next',
                icon: 'screenplays',
                iconLevel: 2
            }, null, null, process);

            function process(result) {
                $ctrl.isPopupOpened = false;
                if(!result || result && result.isCancel){
                    return;
                }
                if($ctrl.item.type !== 2 || overwriteScript){
                    update();
                } else {
                    duplicate(result.item);
                }

                function duplicate(item){
                    $ctrl.DocumentVersionsService.duplicate(_.extend({}, item, {
                        _id:null,
                        versionId: $ctrl.item._id,
                        companyId: $ctrl.CPS.companyId,
                        productId: $ctrl.CPS.productId,
                        hideInInterface: true
                    }, getNotes()), onSuccess, onError);

                    function onSuccess(result) {
                        result.onSync = true;
                        $ctrl.broadcastRoot('ADDED_' + $ctrl.elemType + '_ITEM', result);

                        var document = $ctrl.service.convertResource(result.item);
                        getDocumentVersion(document.version._id,function (item) {
                            openCompare(item, document);
                        });
                    }
                }

                function update(){
                    var updates =  $ctrl.DocumentVersionsService.getChanges($ctrl.DocumentVersionsService.getChangedFieldForUpdate(), result.item, $ctrl.item, true);
                    if (updates) {
                        updates._id = $ctrl.item._id;
                        $ctrl.DocumentVersionsService.update(_.extend({
                            companyId: $ctrl.CPS.companyId,
                            productId: $ctrl.CPS.productId
                        }, updates), onSuccess, onError);
                    }
                    function onSuccess(result) {
                        var updates = $ctrl.DocumentVersionsService.getChanges($ctrl.DocumentVersionsService.getChangedFieldForUpdate(), result.item, $ctrl.item, true);
                        setItem(_.extend($ctrl.item, updates));
                        //update in sidebar
                        //if current update top
                        setSynced($ctrl.item);
                        if($ctrl.item.type) {
                            $ctrl.broadcastRoot('UPDATED_DOCUMENTVERSION_ITEM', result);
                        }
                        openCompare($ctrl.item, $ctrl.document);
                    }
                }

                function openCompare(item, document) {
                    $ctrl.popupsService.open(null, $ctrl.popupsService.operations.scriptCompare, _.extend({
                        script: product.script,
                        document: _.extend({version: item, versionId: item._id}, document),
                        syncChanges: true,
                        syncToProject: true
                    }, getNotes()), $ctrl.compOptions, null, function (result) {
                        console.log('result for onPublishScriptPart2');
                    });
                }
            }

            function onError() {
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.syncToProject.error', 'error');
            }
        }

        function onSaveAsTemplate(item) {
            if (!item) {
                return;
            }

//planFetatures testmode
            var quotaType = item.type === 1 ? 'notesTemplates' : null;
            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}));

            function process() {
                $ctrl.popupsService.open({
                    companyId: item.companyId,
                    productId: item.productId,
                    versionId: item._id,
                }, $ctrl.popupsService.operations.saveDocumentTemplate, {
                    itemTitle: 'document template'
                }, $ctrl.compOptions);
            }
        }

        function share(type, e) {
            if($ctrl.document) {
                $ctrl.RouteCollaboratorsService.share($ctrl.document._id,{
                    type: $ctrl.itemTitle,
                    name: $ctrl.document.name
                }, $ctrl.compOptions, e);
            }
        }

        function onAddDocumentTemplate(result) {
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentTemplate.Create.success', 'success', {name: result.item.name});
        }

        function convertResource(item) {
            return $ctrl.service.convertResource(item);
        }

        function loadDirectory(id) {
            var params = {
                productId: $ctrl.CPS.productId
            };
            params[$ctrl.listField] = id || null;
            var pattern = $ctrl.SBStateService.getCurrentState().url.split('?'),
                q = pattern && pattern.length > 1 ? pattern[1].split('&') : null,
                $sp = $ctrl.SBStateService.$stateParams,
                tp = $ctrl.listTreeService.treeListParamId,
                otherParams = {};
            if(q && q.length > 0) {
                for (var p in $sp) {
                    if(p !== tp && q.indexOf(p)!== -1) {
                        otherParams[p] = $sp[p];
                    }
                }
            }
            $ctrl.CPS.transitionTo('user.product.' + $ctrl.objectType + 's', $ctrl.CPS.currentPathParams(_.extend(otherParams, params), $ctrl.CPS.isCollaborator ? $ctrl.CPS.rolePaths.collabPath : $ctrl.CPS.rolePaths.currentUserPath));
        }

        function getSidebar() {
            var tag = $ctrl.getSidebarTag();
            return '<' + tag + ' class="' + tag + ' clearfix hide-print h-full side-nav static long ' +
                ((!$ctrl.displaySidebar()) ? ' sb-hide' : '') +
                '" ' +
                'tree-type="::$ctrl.treeType" ' +
                'comp-options="::$ctrl.compOptions" ' +
                'item="::$ctrl.document" ' +
                'save-doc-changes="$ctrl.saveDocChanges(onSuccess)" ' +
                'style="min-height:100%"' +
                '></' + tag + '>';
        }

        function getBannerInit() {
            return '';//the banner is displayed up top now
            if(!($ctrl.document.type === 2 && $ctrl.CPS.isCollaborator)){ // if is document
return '';
            }
            $ctrl.CPS.withBanner = $ctrl.CPS.setPageBanner($ctrl.CPS.withBanner,
                $ctrl.showBannerProp, $ctrl.bannerFeatureProp);
            if (!$ctrl.CPS.withBanner || typeof ($ctrl.getBanner) !== 'function' || !$ctrl.LCS.collabBannerInside) {
                return '';
            }
            var banner = typeof($ctrl.getBanner) === 'function' ?  $ctrl.getBanner() : null;
            return banner ? ('<div class="spacing-half-top hide-print margin-top-0 document-version-wrapper document-version-container centered">' +  banner + '</div>') : '';

        }

        function getBanner() {
            var txt = $ctrl.document.type === 2 ? 'screenplays' : ($ctrl.document.type === 3 ? 'AV Scripts' : 'documents'),
            txt1 = txt.replace(' ', '').toLowerCase();
            return '<div class="alert alert-warning alert-stylish '+txt+' table-div full-width">' +
                '<div class="centered grow-column">' +
                $ctrl.LCS.getISBDiv(txt, 5, 'icon sbf24 pull-left') +
                '<span class="text">Create your own '+txt+' now.</span>' +
                '</div>' +
                '<div class="centered col160">' +
                '<a href="' + $ctrl.CPS.websiteUrl + '/register?utm_campaign=collab-'+txt+'" target="_blank" class="btn btn-primary pull-right">Get Started Free</a>' +
                '</div>' +
                getCloseBtn() +
                '</div>';

            function getCloseBtn(){
                return '<div class="centered btn-col text-center col40">' +
                    //'<a class="closebtn display-block" ng-click="$ctrl.CPS.closeBanner()">' + $ctrl.LCS.getISBDiv('close-bigger', 2) + '</a>' +
                    '</div>';
            }
        }

        function getPageTemplate() {
            console.log('DocumentPageInitCtrlService.getPageTemplate');
            var withDocumentInline = $ctrl.withDocumentInline;

            if(!$ctrl.documentLoaded && !withDocumentInline){
                return '<preloader-center class="preloader '+($ctrl.pageClass||'')+'"></preloader-center>';
            }

            if($ctrl.document){
                var canedit = canEdit(),
                    isScript = $ctrl.document.type === 2,
                 cls = withDocumentInline ? '' : 'document-version-wrapper document-version-container centered';
    return '<div class="h-full side-table with-filters-above' + (withDocumentInline ?' position-relative ' : ('{{$ctrl.LCS.hasInnerSidebar($ctrl.SBStateService.currentState.name)?\' with-inner-sidebar\':\'\'}}')) + '">' +
                (withDocumentInline ? '' : getSidebar()) +
                getTopFilters() +
                '<div class="full-content h-full with-fancy-scrollbar ' +
                    (isScript ? (canedit ? '' : ' {{$ctrl.item.lastSyncedScriptId ? \'with-last-synced-block\' :\'\'}}') : '')+'">' +
                    '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper" ng-class="{\'spacing-half\':!$ctrl.item}">' +
                        emptyStateScriptRevision() +
                        '<div ng-show="!$ctrl.isemptystate">' +
        (isScript ? (
            '<div class="with-side-padding24">' +
                    getBannerInit() +
                '<div ng-show="$ctrl.canEdit&&($ctrl.item.lastSyncedContentId && $ctrl.item.lastSyncedContentId !== $ctrl.item.contentVersionId||!$ctrl.item.lastSyncedContentId)&&!$ctrl.closeSyncedBanner" class="ng-hide lastSyncedScript margin-top-half with-no-bg hide-print '+cls+'">' +
                    '<div class="alert alert-warning">' +
                        '<div class="spacing-quart full-width table-div">' +
                            '<div class="col30 centered"><span class="sbf info icon">'+$ctrl.LCS.getISBPath(3)+'</span></div> ' +
                            '<div class="centered"><b>Unsynced Changes:</b> This <span ng-bind="$ctrl.item.lastSyncedContentId && $ctrl.item.lastSyncedContentId !== $ctrl.item.contentVersionId?\'screenplay was last modified\':\'revision was generated\'"></span>' +
                                '<span ng-show="$ctrl.item.contentVersion.createdBy"> by <span class="semibold" ng-bind="$ctrl.item.contentVersion.createdBy.name"></span></span>' +
                                '<span ng-show="$ctrl.item.contentVersion.createdAt"> on {{$ctrl.item.contentVersion.createdAt|amDateFormat:\'MMM D @ \' + $ctrl.CPS.timeFormat}}</span>, but has not been synced to the project yet.</div>' +
                                //todo
                                //'<a ng-click="$ctrl.openCompare($event)">View Changes</a>' +
                         '</div>' +
                        '<a class="closebtn close" ng-click="$ctrl.closeSyncedBanner=true" style="top:18px">&times;</a>' +
                    '</div>' +
                '</div>' +
                '<div class="versionInfo lastSyncedScript margin-top-half with-no-bg hide-print '+cls+'"' +
                    //'ng-show="$ctrl.syncedToProject" ' +
                '>' +
                    '<div class="alert alert-info whitebg notbold">' +
                        '<div class="spacing-quart table-docs">' +
                            '<div class="table-div fixed-layout"></div>' +
                        '</div>' +
                    '</div>'+
                '</div>'+
            '</div>'
        ): '') +
                            '<div class="script-content tab-content text-center with-no-bg">' +
    (withDocumentInline ? ('<div class="lastUpdatedContainer"><div class="lastUpdated"></div></div>' +
                                '<div class="autogrow contenteditable '+$ctrl.titleCls+'" max-length="100" placeholder="New Note…" contenteditable="' + (canedit ? 'true' : 'false') + '" name="name"></div>') : '') +
                                '<div class="margin-half centering ' + cls + '" ' +
                                    'ng-class="{\'with-sidebar\':$ctrl.LCS.hasInnerSidebar($ctrl.SBStateService.currentState.name)}" style="min-height:800px"><div class="'+$ctrl.documentVersionCls+'"></div>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>'+
                '</div>' +
            '</div>';
            }else{
                var block = _.extend({}, $ctrl.BlocksSetupService.getBlockByType('documents'), {hideButton: true});
    return '<div class="with-fancy-scrollbar h-full">' +
                '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper spacing-half">' +
                    '<div class="tab-content text-center with-side-margin with-white-bg h-full with-border-radius">' +
        (withDocumentInline ? $ctrl.EmptyStateCtrlService.getSimpleTemplate($ctrl, block)  :
                        ('<div ng-if="!$ctrl.item" class="table-div full-width h-full">' +
                            '<div class="centered p">' +
                                '<h3 class="text-center">Invalid document</h3>' +
                                '<p class="text-center">This document doesn\'t exist anymore.</p>' +
                            '</div>' +
                        '</div>')) +
                    '</div>' +
                '</div>' +
            '</div>';
            }

            function emptyStateScriptRevision(){
              var title = $ctrl.document.type === 3 ? 'Version' : 'Revision',
                  withNgClick = false;
              return '<div ng-show="$ctrl.isemptystate" class="tab-content text-center with-side-margin with-white-bg h-full with-border-radius">' +
                '<div class="table-div full-width h-full">' +
                '<div class="centered p">' +
                '<h3 class="text-center">No '+title+'s</h3>' +
                '<p class="empty-subtitle text-center">'+( $ctrl.canEdit ? 'Create a new '+title.toLowerCase()+' below.' : 'There are no '+title.toLowerCase()+'.') + '</p>' +
                '<div class="spacing-half-top text-center">' +
                '<button class="btn btn-primary' + ($ctrl.pageClass||'') +
                  (withNgClick ? '' : ( ' ' + $ctrl.getBtnActionCls())) +
                  '" ' +
                  (withNgClick ? 'ng-click="$ctrl.createFromTop(null, $event)"':'') +
                  ' data-type="createFromTop" analytics-on analytics-action="New '+title+'">'+$ctrl.LCS.getISBDiv('plus-circled',2, 'pull-left') + '<div class="with-padding-left">New '+title+'</div></button></div>' +
                '</div>' +
                '</div>' +
                '</div>'
            }
            function getTopFilters() {
        return '<nav class="filters with-side-margin one-line-tooltip on-top '+
                    (withDocumentInline ? 'short' : '')+'">'+
                    (withDocumentInline ? '' : ('<div class="pull-left">' +
                        '<a data-type="toggleInnerSidebar" class="'+ $ctrl.getBtnActionCls() + ' btn btn-small primary-faded without-text pull-left with-margin-right" ' +
                        'ng-class="{\'sb-hide\':!$ctrl.isWithSidebar()}" ' +
                        '>' + $ctrl.LCS.getISBDiv('sidebar-filled', 2) + '</a>' +
                    '</div>' +
                    '<div class="pull-left title table-div h-full" >' +
                        '<a class="table-cell centered" ng-class="$ctrl.CPS.isAuthenticated?\'\':\'inactive\'" ng-show="$ctrl.hideAddNewGroupForCollabs||!$ctrl.item.parentId" href="'+$ctrl.getPath()+'">' +
                            '<span class="with-ellipsis" ng-bind-html="$ctrl.title" tooltip="{{$ctrl.title.length>20?$ctrl.title:\'\'}}" tooltip-placement="bottom"></span>' +
                        '</a>' +
                        getBreadcrumbs() +
                    '</div>')) +
                    getRightButtons() +
                '</nav>';


                function getRightButtons(){
                    return '<div class="pull-right">' +
                        $ctrl.getListNavComments('$ctrl.item') +
                        //$ctrl.getListNavCollabs('$ctrl.item') +
                        //getScriptOutline() + //todo bring back
                        ($ctrl.canEdit ? getScratchPadBtn() : '') +
                        $ctrl.getDrpSettings() +
                        '</div>';
                }
                function getScratchPadBtn(){
                    return withDocumentInline ? '' : ('<div class="pull-left">' +
                        '<a ng-show="$ctrl.item" class="btn btn-small primary-faded without-text with-margin-left hide-ipad ' + $ctrl.getBtnActionCls() + ' " data-type="openScratchpad" tooltip="Script Outline" tooltip-placement="bottom" analytics-on analytics-action="Script Outline">'+$ctrl.LCS.getISBDiv('scratchpad', 4)+'</a>' +
                        '</div>');
                }
                function getScriptOutline(){
                    return !withDocumentInline && $ctrl.withScriptOutline ? ('<div class="pull-left">' +
                        '<a ng-show="$ctrl.item&&$ctrl.item.type===2" class="btn btn-small primary-faded without-text with-margin-left hide-lower1024 ' + $ctrl.getBtnActionCls() + ' " data-type="openScriptOutline" tooltip="Outline" tooltip-placement="bottom">'+$ctrl.LCS.getISBDiv('bulb', 4)+'</a>' +
                        //($ctrl.CPS.isAuthenticated?('<share-button></share-button>') :'') +
                        //$ctrl.getListNavShare() +
                        '</div>') : '';
                }

                function getBreadcrumbs() {
                    if (!$ctrl.breadcrumbs) {
                        return '';
                    }

                    var el = '';
                    _.each($ctrl.breadcrumbs, function (n, i) {
                        el += '<span class="">';
                        if (i !== $ctrl.breadcrumbs.length - 1) {
                            el += '<span class="sbf forward"></span>' +
                                '<a ng-click="$ctrl.CPS.isCollaborator&&$ctrl.document ? null:$ctrl.loadDirectory(n)"><span ' + (n.name.length > 18 ? ('tooltip="' + n.name + '" tooltip-placement="bottom"') : '') + '>' + ((n._id ? n.name : $ctrl.title).substring(0, 20)) + '</span></a>' +
                                '</span>';
                        } else {
                            el += '<span class="sbf forward"></span>' +
                                ' <span ng-bind="$ctrl.document.name| truncate : 20" tooltip="{{n.name.length>18?n.name:\'\'}}" tooltip-placement="bottom"></span>' +
                                '<span class="mark-version" ng-show="$ctrl.item.version.version>1">' +
                                '<span>v{{::$ctrl.item.version}}</span>' +
                                '</span>';
                        }
                        el += '</span>';
                    });
                    return el;
                }
            }
        }

        function isScript(){
            return $ctrl.document && $ctrl.document.active && $ctrl.item && $ctrl.item.type===2 && $ctrl.item.contentVersion;
        }

        function getDrpSettings() {
            var canview = $ctrl.document && $ctrl.document.active,
                canedit = canview && $ctrl.canEdit,
                canDownload = canview;
    return '<div ng-show="$ctrl.item" dropdown class="pull-left position-relative dropdown dropdown-wrapper drpSubmenu">' +
                '<button id="btnSettings" type="button" class="btn btn-small primary-faded without-text dropdown-toggle with-margin-left dropdown-toggle" dropdown-toggle tooltip="More" tooltip-placement="bottom" analytics-on analytics-action="More Settings">'+$ctrl.LCS.getISBDiv('horizontal-dots', 3)+'</button>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft" role="menu" style="width: 212px;left: -175px">' +
                    '<ul class="listitems-selector with-checked">' +
                    (canedit? (
                        addLi('Sync Script', 'openSync', 'sync', true, true, true) +
                        addLi('Script Outline', 'openScratchpad', 'scratchpad', false, true) +
                        addLi('Title Page Designer', 'openTitlePage', 'title', false, false) +
                        addLi('Revision History', 'openVersions', 'versions', false, false, false, false, true
                                //show at all times in case there are local versions
                            //    , '$ctrl.item.contentVersion'
                        )
                        //'<li ng-show="$ctrl.item.contentVersion"><a class="table-div full-width" ng-click="$ctrl.doOnFileSaved($ctrl.openVersions)" analytics-on analytics-action="Revision History"><div class="col30">' + $ctrl.LCS.getISBDiv('versions', 3 , 'pull-left') + '</div> <div>Revision History</div></a></li>' +
                    ) : '') +

                    (canDownload ? (
                        addLi('Download PDF', 'openDownload', 'download-pdf', false, false, false, canedit, true) +
                        //'<li' + (canedit ? ' class="with-border-top"' : '') + '><a class="table-div full-width" ng-click="$ctrl.doOnFileSaved($ctrl.openDownload)"><div class="col30">'+$ctrl.LCS.getISBDiv('download-pdf')+'</div> <div>Download PDF</div></a></li>' +

                        addLi('Download {{$ctrl.getExtension($ctrl.item.type)}} File', 'downloadSBX', 'download-sbx', false, false, false, false, true)
                        //'<li><a class="table-div full-width" ng-click="$ctrl.doOnFileSaved($ctrl.downloadSBX)" analytics-on analytics-action="Download {{::$ctrl.getExtension($ctrl.item.type)}}"><div class="col30">'+$ctrl.LCS.getISBDiv('download-sbx', 3)+'</div> <div>Download {{::$ctrl.getExtension($ctrl.item.type)}} File</div></a></li>'
                    ): '') +
                        //'<li ng-show="$ctrl.item.type===2 && $ctrl.item.contentVersion"><a class="table-div full-width" ng-click="$ctrl.openScriptOutline($event)" analytics-on analytics-action="Outline"><div class="col30">' + $ctrl.LCS.getISBDiv('bulb', 4)+'</div> <div>Outline</div></a></li>' +

                    (canedit? (
                        addLi('Renumber', 'openRenumber', 'renumber', true, false, false, true) +
                        addLi('Lock Screenplay', 'openLock', 'lock', true, false) +

                        addLi('Autosave Settings', 'openAutosaveSettings', 'save', false, false, true, false) +
                      /*  '<li class="with-border-bottom"><a class="table-div full-width" ng-click="$ctrl.openAutosaveSettings($event)" analytics-on analytics-action="Autosave Settings"><div class="col30">'+$ctrl.LCS.getISBDiv('save', 3, 'pull-left')+'</div> <div>Autosave Settings</div></a></li>' +*/

                        '<import-script ' +
                            ($ctrl.pageClass ? ('page-class="'+$ctrl.pageClass+'" ') : '') +
                            'is-li="true" ' +
                            'is-just-script="::true" ' +
                            'script="$ctrl.item" ' +
                            'btn-text="Import '+getItemTitle()+'"' +
                            '></import-script>'
                   ) : '') +
                        //'<!--<li ng-if="::$ctrl.canEdit" class="show-lower1024"><a ng-click="$ctrl.duplicateVersion($event)" analytics-on analytics-action="Duplicate Version\'">'+$ctrl.LCS.getISBDiv('copy', 3, 'pull-left')+' Duplicate Version</span></a></li>' +
                    //'($ctrl.canEdit&&$ctrl.type===2? <li ng-if="$ctrl.canEdit&&$ctrl.type===2" class="show-lower1024"><a ng-click="$ctrl.publishScript($event)" analytics-on analytics-action="Publish Script\'">'+$ctrl.LCS.getISBDiv('transition', 4, 'pull-left')+' <span>Sync Script</span></a></li> -->' +
                    '</ul>' +
                '</div>' +
            '</div>';

            function addLi(n, m, i, isScript, isMobile, withBorderBottom, withBorderTop, isDoOnFileSaved, cond){
              return '<li ' +
                   (cond ? ('ng-show="' + cond +'" ') : '') +
                  ((isScript||isMobile) ? ('ng-show="' +
                       (isScript ? '$ctrl.isScript()' : '') +
                       (isMobile ? ((isScript ? '&&' : '') + '$ctrl.LCS.isMobileSize') : '') +
                    '"') : '') +
                   (withBorderBottom ? ' class="with-border-bottom"' : '') +
               (withBorderTop ? ' class="with-border-top"' : '') +
                   '><a data-type="'+m+'" class="'+ $ctrl.getBtnActionCls() + ' table-div full-width" ' +
                   (isDoOnFileSaved ? 'data-isdoonfilesaved="true" ' : '') +
                   //'ng-click="$ctrl.' + m + '($event)" ' +
                   'analytics-on analytics-action="' + n + '"><div class="col30">' + $ctrl.LCS.getISBDiv(i, 5, 'pull-left') + '</div> <div>' + n + '</div></a></li>';
            }
        }

        function openRenumber( ){
            $ctrl.broadcastRoot('SCRIPT_RENUMBER_POPUP');
        }

        function openLock(){
            $ctrl.broadcastRoot('SCRIPT_LOCK_POPUP');
        }

        function openSync(){
            $ctrl.broadcastRoot('SCRIPT_SYNC_POPUP');
        }

        function openScratchpad(info, e){
            //bind(e,'SCRIPT_NOTES_POPUP');  //documentVersionNotes popup
            //planFetatures testmode
            var quotaType = $ctrl.item.type === 3 ? 'avscriptOutline' : ($ctrl.item.type === 2 ? 'scriptOutline' : null);
            process('notes', null, null, quotaType, e);
        }

        function openTitlePage(info, e){
            //bind(e,'SCRIPT_TITLEPAGE_POPUP');  //documentVersionTitlePage popup
            //planFetatures testmode
            var quotaType = $ctrl.document.type === 2 ? 'scriptTitlePage' : ($ctrl.document.type === 1 ? 'notesTitlePage' : null);
            process('titlePage', {withScriptFormat: $ctrl.isScript}, null, quotaType, e);
        }

        function process(type, params, onConfirm, quotaType, e) {
            if (!params) {
                params = {};
            }

            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e: e});

            function process() {
                $ctrl.popupsService.open($ctrl.item, $ctrl.popupsService.operations[type + 'DocumentVersion'], params, $ctrl.compOptions, null, onConfirm);
            }
        }
    }
}

angular.module('product.document.list.item.more.component', [
    'services.sessionService'
])

.component('documentVersionListItemMorePopover', {
    bindings: {
        item: '<',
        showRemove:'<', //$ctrl.list.totalCount>1&&!item.lastSyncedScriptId,
        getTemplate:''
    }, 
    controller: 'DocumentsVersionListItemMorePopoverController',
})

.controller('DocumentsVersionListItemMorePopoverController', DocumentsVersionListItemMorePopoverController);

DocumentsVersionListItemMorePopoverController.$inject = ['$element', 'LCS'] ;
function DocumentsVersionListItemMorePopoverController($element, LCS) {
        console.log('DocumentsVersionListItemMorePopoverController');
    var $ctrl = this;
    $ctrl.LCS = LCS;

    $ctrl.element = $element[0];

    $ctrl.$onDestroy = $onDestroy;

    function $onDestroy() {
        var isBind = false;
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('ul li a'), update);
    }

    function update(e) {
        var target = e.currentTarget, params = {item: $ctrl.item, e: e};
        switch (target.getAttribute('data-type')) {
            case 'edit':
                return $ctrl.onEdit(params);
            case 'duplicate':
                return $ctrl.onDuplicate(params);
            case 'template':
                return $ctrl.onTemplate(params);
            case 'remove':
                return $ctrl.onRemove(params);
        }
    }
}

angular.module('product.document.compare.component', [
    'apiServices.Documents',
    'apiServices.Materials',

])
.component('documentComparePopup',  popupComponentParams ('DocumentComparePopupCtrl'))
.controller('DocumentComparePopupCtrl', DocumentComparePopupCtrl);
DocumentComparePopupCtrl.$inject = ['ItemTemplateCompileCtrlService', 'DocumentsService','MaterialsService', '$element'];
function DocumentComparePopupCtrl(ItemTemplateCompileCtrlService, service, MaterialsService, $element) {
    var $ctrl  = this;

    $ctrl.MaterialsService = MaterialsService;

    $ctrl.isPopup = true;
    $ctrl.isJustScript = true;

    $ctrl.preInit = preInit;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl.dontAutoloadTemplate = true;
    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInit() {
        $ctrl.reloadTemplate();
        var resultUpload = $ctrl.result;
        if (resultUpload) {
            $ctrl.documentVersion = service.convertResource(resultUpload.document).version;
            $ctrl.itemTitle = $ctrl.documentVersion.type === 2 ? 'screenplay' : 'note';

            $ctrl.previousVersion = resultUpload.previousVersion;
            getDownloadContent($ctrl.previousVersion, function (content) {
                if (content) {
                    $ctrl.previousVersion.content = content;
                }
                $ctrl.isLoaded = true;
                $ctrl.reloadTemplate();
            });
        }
    }

    function getDownloadContent(previousVersion, onComplete) {
        if (!previousVersion) {
            return onComplete();
        }
        //check if there is any local version
        //check if there is any uploaded version
        //get the latest of the 2  and set it to content field
        //if local version is newer
        if (!previousVersion.contentVersionId) {
            return onComplete();
        }//there is a saved version in s3 . get it and pass it for update

        var contentVersion = previousVersion.contentVersion;
        $ctrl.materialId = contentVersion && contentVersion.materialId ? contentVersion.materialId : null;
        if (!$ctrl.materialId) {
            return onComplete();
        }

        $ctrl.MaterialsService.getDownloadLink({
            id: $ctrl.materialId,
            versionId: previousVersion.contentVersionId,
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId,
        }, function (link) {
            //var headers = $ctrl.security.getHttpHeaders(state, params)
            $ctrl.security.getRequest(link, null, function (result) {
                var data = result && result.data !== 'undefined' ? result.data : null,
                    size = parseInt(contentVersion.size, 10);
                onComplete((data && size > 0 || !data && size === 0) ? data : null);
            }, function (err) {
                console.log(err);
                onComplete();
            });
        }, function (err) {
            // i18nNotifications.pushForCurrentRoute(err, 'crud.file.upload.error', 'error');
            onComplete();
        });
    }

    function setTemplateData() {

    }

    function getPopupBodyContent() {
        return '<div class="full-width h-full">' +
                    '<div class="compare-script h-full">' +
                        '<div class="modal-header">' +
                            '<div class="top-table table-div">' +
                                '<div class="table-col">'+$ctrl.LCS.getISBDiv('transition', 4)+'<span class="stronger title with-margin-left">Compare '+$ctrl.itemTitle+'s</span></div>' +
                            '</div>' +
                        '</div>' +
               ( $ctrl.isLoaded ? '<document-compare-step class="body-table medium-template h-full" previous-version="::$ctrl.previousVersion" document-version="::$ctrl.documentVersion" is-just-script="::$ctrl.isJustScript"></document-compare-step>' :
                '<preloader-center class="preloader '+($ctrl.pageClass||'')+'"></preloader-center>') +
                        '<div class="modal-footer semi-tall" style="background: white; padding-top: 20px; padding-bottom: 20px;margin-bottom: 0;">' +
            $ctrl.LCS.getErrorBlock() +
                            '<div class="form-wrapper text-center hide-ipad">' +
                                '<button class="btn btn-primary hide-ipad" ng-click="$ctrl.close($event)" analytics-on analytics-action="Close">Close</button>' +
                                '<!--<button class="btn btn-primary  " type="submit" ng-click="showDiffs()" analytics-on analytics-action="Compare Documents\': \'Show Differences\'" ng-class="{ \'disabled\': isUpdating === true}" ng-disabled= "isUpdating === true"><span class="sbf " ng-class="{ \'loadingicon animate-spin\': isUpdating === true} "></span> Show Differences</button>-->' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>';
    }
}

angular.module('product.document.documentCompare.step.component', [
    'apiServices.Documents'
])
.component('documentCompareStep', {
    bindings: {
        isJustScript: '<?',
        previousVersionJson: '<?',
        documentVersion: '<?'
    },
template: '<div id="compareDocument show-scrollbar-on-hovers">' +
            '<div class="table-div full-width" ng-if="$ctrl.previousVersion" style="padding-bottom: 0;">' +
                '<div class="table-col spacing-quarter padding-right10" ng-show="!$ctrl.LCS.noSidebarFilters">' +
                    '<span class="uppercase strong">Current {{::$ctrl.title}}</span> <div class="display-inline col30 with-margin-right"><div ng-bind="::\'v\'+$ctrl.previousVersion.version" class="version"></div></div> <a class="pull-right display-inline" target="_blank" ng-bind="::$ctrl.previousVersion.name|truncate:30" ng-href="{{::$ctrl.getDocumentVersionUrl($ctrl.documentVersion)}}"></a>' +
                '</div>' +
                '<div class="table-col spacing-quarter" ng-style="{\'padding-left\':!$ctrl.LCS.noSidebarFilters?\'0\':\'10px\',\'width\':!$ctrl.LCS.noSidebarFilters?\'50%\':\'100%\'}">' +
                    '<div class="table-div full-width">' +
                        '<div class="table-col ">' +
                            '<span class="uppercase strong">New {{::$ctrl.title}}</span> <div class="display-inline col30 with-margin-right"><div ng-bind="::\'v\'+$ctrl.documentVersion.version" class="version"></div></div>   <a class="pull-right display-inline" target="_blank" ng-bind="::$ctrl.documentVersion.name|truncate:30" ng-href="{{::$ctrl.getDocumentVersionUrl($ctrl.documentVersion)}}"></a>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
            '<div class="body-table-parent-wrapper h-full full-width">' +
                '<div ng-if="$ctrl.previousVersion" class="h-full padding-right10" ng-show="!$ctrl.LCS.noSidebarFilters">' +
                    '<div id="left" class="fix-column-height workflow-cards-scroll-wrapper fancy-scrollbar h-full">' +
                        '<div>' +
                            '<div id="currentScript" class="compare-column">' +
                                '<div class="notes full-width">' +
                                    '<div class="clearfix ql-container"><div class="ql-editor" ng-class="$ctrl.previousVersion.type===2?\'scene-wrapper\':\'sbdoc-wrapper\'" ng-bind-html="$ctrl.previousVersion.content|unsafe"></div></div>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
                '<div class="h-full" ng-style="{\'padding-left\':!$ctrl.LCS.noSidebarFilters&&$ctrl.previousVersion?\'0\':\'10px\',\'width\':!$ctrl.LCS.noSidebarFilters&&$ctrl.previousVersion?\'50%\':\'100%\'}">' +
                    '<div id="right" class="fix-column-height workflow-cards-scroll-wrapper fancy-scrollbar h-full">' +
                        '<div>' +
                            '<div id="newScript" class="compare-column position-relative" ng-class="$ctrl.classToolbar">' +
                                '<a ng-if="$ctrl.canEdit&&$ctrl.documentVersion" class="onbreakdowns btnsaving btn btn-small without-text transparent btnq with-margin-left" ng-class="$ctrl.SessionService.savingDocChanges?\'floppySaving\':($ctrl.SessionService.hasDocChanges?\'floppyUnsaved\':\'floppySaved\')" ng-click="$ctrl.saveDocChanges()" analytics-on analytics-action="Save Doc Changes" tooltip-placement="bottom" tooltip="{{$ctrl.SessionService.lastDocChanges ? (\'Saved @ \' + $ctrl.SessionService.lastDocChanges) : null}}">' +
    '<span class="sbf save"><span class="sbp p1"></span><span class="sbp p2"></span></span></a>' +
                                '<document-version-editor ng-if="$ctrl.documentVersion" item="$ctrl.documentVersion" can-edit="::true" placeholder="::$ctrl.placeholder" saving-at="::$ctrl.savingAt" elem-type="{{::$ctrl.elemType}}"></document-version-editor>' +
        '<preloader-center ng-if="!$ctrl.documentVersion" class="preloader"></preloader-center>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
            '<!--' +
            '<ng-html-window options="::$ctrl.windowOptions" ng-repeat="window in $ctrl.windows">' +
                '<div class="fancy-scrollbar vertical h-full">' +
                    '<div class="spacing-half notes full-width bg-white" style="margin-top:20px;margin-bottom:20px" ng-if="$ctrl.previousVersion">' +
                        '<div class="scene-wrapper clearfix" ng-bind-html="$ctrl.comparing.html|unsafe" style="margin-top:20px;margin-bottom:20px"></div>' +
                    '</div>' +
                '</div>' +
            '</ng-html-window>-->' +
        '</div>',
    controller: 'DocumentCompareStepCtrl'
})
.controller('DocumentCompareStepCtrl', DocumentCompareStepCtrl);

DocumentCompareStepCtrl.$inject = ['CompInitCtrlService'];
function DocumentCompareStepCtrl(CompInitCtrlService) {
    var $ctrl = this;

    $ctrl = new CompInitCtrlService($ctrl);
    var previousVersion;
    $ctrl.changedFields = ['previousVersionJson'];
    $ctrl.$onInit = $onInit;
    $ctrl.$onChanges = $onChanges;

    function $onInit() {
        setV();
        $ctrl.title = $ctrl.documentVersion.type === 1 ? 'note' : 'screenplay';
        $ctrl.classToolbar = 'inline-toolbar ' + $ctrl.title;
        $ctrl.placeholder = 'Edit the ' + $ctrl.title;
        $ctrl.windows = [];
        $ctrl.comparing = {};
        $ctrl.windowOptions = {
            title: 'Untitled ',
            width: 500,
            height: 400,
            x: 0,
            y: 0,
            minWidth: 500,
            maxWidth: Infinity,
            minHeight: 400,
            maxHeight: Infinity,
            resizable: true,
            onClose: function () {
                removeWindow(this);
            }
        };

        $ctrl.showDiffs = showDiffs;
        $ctrl.getDocumentVersionUrl = getDocumentVersionUrl;

        $ctrl.savingAt = 5;
        $ctrl.saveDocChanges = saveDocChanges;

        if ($ctrl.SessionService.hasDocChanges) {
            var retVal = window.confirm("Are you sure you want to leave this page? There are unsaved changes.");
            if (retVal) {
                next();
            }
        }
    }
    function $onChanges(changes) {
        console.log(changes);
        if (!changes) {
            return;
        }

        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i];
            var change = changes[field];
            if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                if(field ==='previousVersionJson'){
                    setV();
                }
                break;
            }
        }
    }

    function setV() {
        previousVersion = $ctrl.previousVersionJson;
        $ctrl.previousVersion = previousVersion ? JSON.parse(previousVersion) : null;

    }

    function getDocumentVersionUrl(item) {
        return item ? $ctrl.SBStateService.getStateHref('user.product.document', $ctrl.CPS.currentProductPathParams({
            documentId: item.documentId,
            filter: encodeURIComponent(JSON.stringify({l: item._id}))
        })) : null;
    }

    function removeWindow(_this) {
        var windows = $ctrl.windows;
        var index = _this ? windows.indexOf(_this) : (windows.length > 0 ? windows.length - 1 : -1);
        if (index > -1 && index <= windows.length) {
            windows.splice(index, 1);
        }
    }

    function showDiffs() {
        removeWindow();
        var compareDocuments = angular.element('#compareDocuments');
        $ctrl.comparing.html = htmldiff(compareDocuments.find('#currentScript .scene-wrapper').html(), compareDocuments.find('#newScript .scene-wrapper').html());
        $ctrl.windows.push({
            options: {
                title: 'Another Window'
            }
        });
    }

    function saveDocChanges() {
        //todo correct
        var id = $ctrl.documentVersion ? $ctrl.documentVersion._id : null;
        if (id) {
            $ctrl.broadcastRoot('SAVE_DOC_CHANGES_' + id, {id: id, type: 'documentVersion'});
        }
    }
}

angular.module('product.document.autosaving.component', [
    'ctrl.PopupsCtrl.generalItemEdit.service'
])
.component('documentAutosavingPopup', popupComponentParams ('DocumentAutosavingPopupCtrl'))

.controller('DocumentAutosavingPopupCtrl', DocumentAutosavingPopupCtrl);
DocumentAutosavingPopupCtrl.$inject = ['GeneralItemEditCtrlService', '$element'];
function DocumentAutosavingPopupCtrl(GeneralItemEditCtrlService, $element) {
    console.log('DocumentAutosavingPopupCtrl');
    var $ctrl = this;
$ctrl.isPopup = true;
    $ctrl.Options = [
        {text: 'Every 20 seconds', val: 20},
        {text: 'Every 5 minutes', val: 300},
        {text: 'Every 10 minutes', val: 600},
        {text: 'Never', val: 0}
    ];

    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl.postInitGeneral = postInitGeneral;
    $ctrl.preSetTemplateData = preSetTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneral() {
        var val = $ctrl.LCS.getDocumentAutosavings(),
            selected;
        if (val !== undefined) {
            selected = _.find($ctrl.Options, function (item) {
                return item.val === val;
            });
        }
        if(!selected){
            selected = $ctrl.Options[0];
        }
        $ctrl.item = {
            selectedVal: selected.val
        }
        $ctrl.Settings = {Options: $ctrl.Options};
        setColumns();
    }

    function setColumns(){
        $ctrl.columnsList = [{
            formGroupClass: 'centered col130 form-group field',
            drpMenuCls: 'col160',
            fieldClass: 'selected-text centering text-left with-underline ',
            canEdit: true,
            type: $ctrl.SBFieldTypesService.PropTypes.Drp,
            itemLabel: 'text',
            itemValue: 'val',
            parentContainer:true,
            initListName: 'Options',
            prop: 'selectedVal'
        }];
    }

    function postInitGeneral(){
        $ctrl.save = save;
    }

    function preSetTemplateData() {
        $ctrl.icon = 'save';
        $ctrl.popupTitle = 'Autosave Settings';
        $ctrl.subdesc = 'We autosave the script to your computer’s local storage periodically. This allows you to continue working offline if your WiFi connection is lost.';
        $ctrl.withFooterBtns = true;
        $ctrl.btnText = 'Save';
        $ctrl.textAnalytics = $ctrl.removeHtmlTags($ctrl.popupTitle);
    }

    function getPopupBodyContent() {
return '<div class="table-div centered">' +
            '<div class="centered form-group field text-left centering col150">Autosave my script:</div>' +
            $ctrl.getPopupFormForSelectedCol($ctrl.columnsList[0]) +
        '</div>';
    }

    function save() {
        var val = $ctrl.item.selectedVal;
        $ctrl.LCS.setDocumentAutosavings(val);
        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.document.autosaving.success', 'success');
        $ctrl.broadcastRoot('UPDATE_AUTOSAVE_SEC', val);
        $ctrl.closePopup();
    }
}

