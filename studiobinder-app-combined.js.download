BreakdownsGroupCtrl.$inject = ['BreakdownsGroupCtrlService', 'StripsPagination', '$element'];
function BreakdownsGroupCtrl(BreakdownsGroupCtrlService, Pagination, $element) {

    var $ctrl = this;

    $ctrl.getDisplayRootCount = getDisplayRootCount;

    $ctrl.getRowMobileActions = getRowMobileActions;
    $ctrl.getMorePopoverTemplate = getMorePopoverTemplate;
    $ctrl.getKeyEvents = getKeyEvents;
    $ctrl.$onInit = $onInit;

    function getDisplayRootCount(){
      return $ctrl.getStrips(true).length || 0;
    }

    function $onInit() {
        $ctrl = new BreakdownsGroupCtrlService($ctrl, $element, Pagination, true);
    }

    function getKeyEvents() {
        return [{
            type: 'Create',
            keys: [$ctrl.keyboardService.keys.SKey, $ctrl.keyboardService.keys.sKey],
            method: onSKey
        }];

        function onSKey(sId, item) {
            if ($ctrl.currentListId !== sId) {
                return;
            }
            var e = null;
            $ctrl.create(item, $ctrl.StripTypes.Scene, null, null, null, e);
        }
    }

    /* todo remove
          //  $ctrl.onAdded = onAdded;
        function onAdded(result) {
            //returns:
            //schedules:  //other schedule inserted in all active scheduleListss for the new strip
            //updates: //schedules updates in current scheduleList

            //item:  //scheduleItem -> already added

            //strips: {item, updates} //new inserted strip plus updates

            //shotsLists: //shot list inserted

            if(!result){
                //error
                return
            }
            console.log('onAddStrip');
            var su = result.schedules;
            if(su){
                for(var i=0; i < su.length; i++ ){
                    $ctrl.preLoadingService.modify($ctrl.preLoadingService.TblTypes.StripSchedules, su[i], $ctrl.preLoadingService.Ops.Create);
                }
            }
            su= result.strips;
            if(su){
                var tableType = $ctrl.preLoadingService.TblTypes.Strips;
                $ctrl.preLoadingService.modify(tableType, su.item, $ctrl.preLoadingService.Ops.Create);
                $ctrl.preLoadingService.updateMany(tableType, su.updates);
            }
           /!* su= result.shotsLists;
            if(su){
                var tableType = $ctrl.preLoadingService.TblTypes.ShotLists;
                $ctrl.preLoadingService.modify(tableType, su.item, $ctrl.preLoadingService.Ops.Create);
                $ctrl.preLoadingService.updateMany(tableType, su.updates);
            }*!/

            //  $ctrl.preLoadingService.insertStripFromScheduling(result); -> shotlists todo

            //PROCESS CURRENT SCHEDULE ITEM
            var item = result.item;
            if(item) {
                item = $ctrl.preLoadingService.getStripById(item._id);
                if (!$ctrl.list.getElementById(item._id)) {
                    $ctrl.list.insertElementAtIndex(item, item.order);
                }
            }
            $ctrl.processUpdates(result);

            $ctrl.broadcastRoot('START_INTRO');
            return item;
        }*/

    function getRowMobileActions(item) {
        if (item.type !== $ctrl.StripTypes.Scene) {
            return null;
        }

        var l = [{
            type: 'viewScene',
            action: 'Preview Scene',
            icon: 'sides'
        }];
         //todo: addNote
        return l;
    }

    function getMorePopoverTemplate(item, isMobile) {
        if (item.type !== $ctrl.StripTypes.Scene) {
            return '';
        }

        var count = 0;
        var template =  '';
        if(isMobile) {
            template += $ctrl.getSideMenuLi({
                type: 'viewScene',
                action: 'Preview Scene',
                icon: 'sides'
            });
            count++;
        }

        if ($ctrl.canEdit  ) {
            if (item.active) {
                template += $ctrl.getSideMenuLi({
                        type: 'createScene',
                        action: 'Add ' + $ctrl.itemTitle + ' Under',
                        icon: 'add-scene',
                        iconLevel : 4,
                        withTopBorder: count>0
                    });count++;

                    if(!isMobile){
                        template +=  $ctrl.getSideMenuLi({
                            type: 'edit',
                            action: 'Edit Details',
                            param: 1000,
                            iconLevel : 2,
                            icon: 'pencil'
                        });
                        count++;
                    }
                    template += $ctrl.getSideMenuLi({
                             type: 'duplicate',
                             action: 'Duplicate ' + $ctrl.itemTitle,
                             icon: 'copy',
                             aClass: 'a-duplicate'
                         });
                         count++;
            }
        }

        if ($ctrl.canEdit && !item.active) {
            template += $ctrl.getSideMenuLi({
                type: 'activate',
                action: 'Restore ' + $ctrl.itemTitle,
                icon: 'restore',
                withTopBorder: count>0
            });
            count++;
        }

        template += (item.contentScript ? $ctrl.getSideMenuLi({
                type: 'viewUnsyncedScene',
                action: 'View Unsynced Scene',
                icon: 'unlinked',
                withTopBorder: count > 0
            }) : '') +
            $ctrl.getSideMenuLi({
                type: 'goToBreakdown',
                action: 'View Breakdown',
                icon: 'breakdowns',
                withTopBorder: count > 0
            }) +
            $ctrl.getSideMenuLi({
                type: 'goToShotsList',
                action: 'View Shot List',
                icon: 'shots',
                iconLevel: 6
            });

        if ($ctrl.canEdit) {
            if (item.active) {
                template += $ctrl.getSideMenuLi({
                    type: 'archive',
                    action: 'Omit ' + $ctrl.itemTitle,
                    icon: 'box',
                    withTopBorder: true,
                    aClass: 'accent'
                });
            }

            if ($ctrl.removeGroupOnAll || !item.active) {
                template += $ctrl.getSideMenuLi({
                    type: 'remove',
                    action: 'Remove ' + $ctrl.itemTitle,
                    icon: 'trash',
                    withTopBorder: true,
                    aClass: 'accent'
                });
            }
        }
        return '<ul class="dropdown-menu side-menu display-block scheduling-sidemenu">'+template + '</ul>';
    }
}


angular.module('product.breakdowns.group.init.component.service', [
    'product.breakdowns.item.events.service',
    'groupSimpleForRow.controller.service',
    'product.breakdowns.group.loading.service',
    'sb.fields.methods.service',
    'services.blocksSetup'
])
    .service('BreakdownsGroupInitCtrlService',BreakdownsGroupInitCtrlService);
BreakdownsGroupInitCtrlService.$inject = ['BreakdownsGroupLoadingCtrlService', 'ScenePopupEventsCtrlService', 'GroupSimpleForRowCtrlService', 'BlocksSetupService'];
function BreakdownsGroupInitCtrlService(BreakdownsGroupLoadingCtrlService, ScenePopupEventsCtrlService, GroupSimpleForRowCtrlService, BlocksSetupService) {
    return function($ctrl) {

        $ctrl.groupItemTag = 'strip';
        $ctrl.scriptOrder = 'scriptPosition';

        $ctrl.withColoredHeader = $ctrl.isScheduling;
        $ctrl.modalMethodForEdit = 'editSchedule';

        $ctrl.create = create;
        $ctrl.getUpdatedChanges = getUpdatedChanges;

        $ctrl.getEditPopupParams = getEditPopupParams;
        $ctrl.getNewParams = getNewParams;
        $ctrl.getNextSceneNumber = getNextSceneNumber;
        $ctrl.getNewPopupParamsOther = getNewPopupParamsOther;
        $ctrl.onItemPopoverChanged = onItemPopoverChanged;

        $ctrl.getInlineActions = getInlineActions;
        $ctrl.getGroupItemAttributes = getGroupItemAttributes;

        $ctrl.preloadSettings = preloadSettings;

        $ctrl.afterProcessUpdatesG = afterProcessUpdatesG;

        $ctrl.edit = edit;
        $ctrl.editSchedule = editSchedule;

        $ctrl.getCount = getCount;
        $ctrl.getCreateInlineGroup = getCreateInlineGroup;
        $ctrl.getItemToEdit = getItemToEdit;
        $ctrl.getMobileColoredHeader = getMobileColoredHeader;

        //since there is no group for breakdown page must set them here:
        if($ctrl.isBreakdown) {
            $ctrl = new GroupSimpleForRowCtrlService($ctrl);
        } else  {
            $ctrl.processDefaultSelectedParams = processDefaultSelectedParams;
            $ctrl.getClipboardProcessingParams = getClipboardProcessingParams;
            $ctrl.onClipboardProcessingSuccess = onClipboardProcessingSuccess;
        }

        $ctrl = new BreakdownsGroupLoadingCtrlService($ctrl);
        $ctrl = new ScenePopupEventsCtrlService($ctrl);

        return $ctrl;

        function create(after, type, moreNewItemData, addInline, isDuplicate, e) {
            if (type === $ctrl.StripTypes.Scene || type === undefined) {
                $ctrl.checkQuota($ctrl.quotaType, process, {maxAddedCount: 1, type: type, e: e});

                function process() {
                    $ctrl.viewScene($ctrl.computeNewItem(after, type, moreNewItemData), true, true);
                }
            } else {
                $ctrl.createInit(after, type, moreNewItemData, addInline, isDuplicate, e);
            }
        }

        function canSaveScreenplay(action, item){
            if($ctrl.isScheduling && item && item.type!== 1){return false;} // if is not strip
            return !($ctrl.isScheduling && action !== $ctrl.keyboardService.ActionTypes.Delete);
        }

        function processDefaultSelectedParams(action, info){
            if(!canSaveScreenplay(action, info?info.item:null)){return null;}
             var updateScreenplay = true,
                 autoupdateScreenplay = action === $ctrl.keyboardService.ActionTypes.Delete,
                cls = 'select-row item md-radio-button ' + $ctrl.pageClass,
                methodOnCheck= 'onCheck',
                params = {updateScreenplay: updateScreenplay};

                if(!autoupdateScreenplay) {
                    params.extraMessage = '<br/><p class="text-center medium-size">It is recommended to update the screenplay so everything stays in sync.</p>' +
                        '<div class="max-width-300 centered margin-top-half medium-size">' +
                        '<div class="margin-bottom-quarter ' + cls + (updateScreenplay ? ' md-checked' : '') + '" data-id="true" ng-click="$ctrl.extraParam.' + methodOnCheck + '($event, $ctrl)"><div class="md-container md-ink-ripple "><div class="md-off"></div><div class="md-on"></div><div class="md-ripple-container"></div></div><div class="md-label namex">Update screenplay</div></div>' +
                        '<div class="' + cls + (updateScreenplay ? '' : ' md-checked') + '" data-id="false" ng-click="$ctrl.extraParam.' + methodOnCheck + '($event, $ctrl)"><div class="md-container md-ink-ripple"><div class="md-off"></div><div class="md-on"></div><div class="md-ripple-container"></div></div><div class="md-label namex">Don\'t update screenplay</div></div>' +
                        '</div>';
                } else{
                    params.extraMessage = '<br/><p class="text-center medium-size">We\'ll automatically update the screenplay to keep everything in sync.</p>';
                }

            params[methodOnCheck] = onCheck;

            var message = getMessage();
            if(message){
                params.message = message;
            }

            return params;

            function getMessage() {
                switch (action) {
                    case $ctrl.keyboardService.ActionTypes.Archive:
                        return 'Omitting a scene adds a label to the scene heading so everyone is aware it has been cut from production. You can remove this label and restore the scene at any point.';

                    case $ctrl.keyboardService.ActionTypes.Activate:
                        return 'This will remove the "Omitted" label from the selected scene heading everywhere it is displayed.';

                    case $ctrl.keyboardService.ActionTypes.Delete:
                        return 'This will remove the selected scene and its content.';
                }

                return null;
            }

            function onCheck(e, $ctrl) {
                $ctrl.preventDefault(e);
                var el = e.currentTarget,
                    update = el.getAttribute('data-id') === 'true';

                $ctrl.LCS[update ? 'addClass' : 'removeClass']($ctrl.element.querySelector(".md-radio-button[data-id='true']"), 'md-checked');
                $ctrl.LCS[update ? 'removeClass' : 'addClass']($ctrl.element.querySelector(".md-radio-button[data-id='false']"), 'md-checked');

                if(!$ctrl.extraParam){$ctrl.extraParam = {};}
                $ctrl.extraParam.updateScreenplay = update;
            }
        }

        function getClipboardProcessingParams(params, extraParam) {
            console.log('getClipboardProcessingParams');
            var opType = params.opType;

            if (!canSaveScreenplay(opType, extraParam && extraParam.item ? extraParam.item : null)) {
                return null;
            }

            if (!processClip(opType)) {
                return null;
            }
            var ids = [],
                notes = getNotes();
            return _.extend({
                syncChanges: true,
                syncToProject: false,
                notes: notes,
                summary: getProcessClipType(opType) + '|' + BlocksSetupService.getCurrentTodoPage().text,
                scriptId: $ctrl.CPS.scriptId || null,
                ids: ids
            }, (opType === 3 || opType === 11 || opType === 12) ? _.extend({updateSceneContent: true},
                extraParam ? {updateScreenplay: extraParam.updateScreenplay} : null) : null);


            function getNotes() {
                var sc = '', c = 0,
                    items = params && params.updates ? params.updates.clipboard : null;
                if (items && $ctrl.isScheduling) {//remove scenes from scheduling
                    params.updates.clipboard = _.filter(params.updates.clipboard.map(function (item) {
                        var el = _.find($ctrl.list.items, {_id: item.id});
                        return el ? {sId: null, id: el.stripId} : null;
                    }), function (item) {
                        return item !== null
                    });
                    items = params.updates.clipboard;
                }
                if (items) {
                    _.each(items, function (sel, i) {
                        var id = sel.id,
                            item = _.find($ctrl.list.items, $ctrl.isScheduling ? {stripId: id} : {_id: id});
                        if (item) {
                            sc += 'Sc. ' + (item.scene ? (item.scene + '. ') : '') +
                                (item.content && item.content.length > 0 ? item.content[0].text : '').toUpperCase() + (i !== items.length - 1 ? '<br/>' : '');
                            c++;
                            ids.push(id);
                        }
                    });
                }
                var x = getProcessClipType(params.opType);
                return (c === 1 ? 'A scene was ' : 'Scenes were ') +
                    (x === 'archive' ? 'omitted' : ((x === 'activate' ? 'restored' : x) + 'd')) +
                    ': <span class="semibold">' + sc + '</span>';
            }
        }

        function onClipboardProcessingSuccess(opType, result, params, extraParam){
            console.log('onClipboardProcessingSuccess');

            //reload page after removing the strip
            if($ctrl.isScheduling){
                if (opType === $ctrl.keyboardService.ActionTypes.Delete &&
                    extraParam&&extraParam.item && extraParam.item.type === 1){
                    reloadPage();
                }
            } else {

                //delete archive activate
                //trigger page reload for now
                if (processClip(opType)) {
                    result.sceneChanged = {
                        isNewStrip: getProcessClipType(opType),
                        ids: params.ids
                    }
                    reloadPage();
                }
            }

            function reloadPage(){
                $ctrl.LCS.timeout(function () {
                    //doesnt trigger the update for shotLists and storyboards Lists -> based on script
                    var hardReload = true;
                    $ctrl.CPS.reloadCurrentState(hardReload);
                }, 200);
            }
        }

        function getProcessClipType(opType){
            return opType === 3 ? 'remove' : (opType === 11 ? 'activate' : 'archive');
        }

        function processClip(opType){
            return !$ctrl.isBreakdown && !$ctrl.isScheduling && (opType === 3 || opType === 11 || opType === 12)||
                $ctrl.isScheduling && opType === 3;
        }


        function getInlineActions(isHeader, item) {
            return '<div ' +
                (isHeader ? 'ng-if="!$ctrl.isGridView" ' : '') +
                'class="preview-col col60 hide-print hide-ipad text-center no-drag">' +
                (isHeader ? 'Preview' : ((item && item.type !== $ctrl.StripTypes.Scene) ? '' :
                    ('<a class="gray-light inline-block no-tooltip-arrow ' + $ctrl.getClickEventName('viewScene') + '" analytics-on analytics-action="Open Preview" tooltip-placement="left" tooltip="Preview Scene">' + $ctrl.LCS.getISBDiv('sides', 2, 'pull-left gray') + '</a>'))) +
                '</div>';
        }

        function getMobileColoredHeader(item){
            var v;
            switch (item.type) {
                case $ctrl.StripTypes.Scene: v = 'scene hastype ' + item.color ; break;
                case $ctrl.StripTypes.DayBreak: v = 'daybreak'; break;
                case $ctrl.StripTypes.Banner: v = 'banner'; break;
            }
            return v;
        }

        function getItemToEdit(item) {
            return item ? _.find($ctrl.list.items, item.type === 1 && $ctrl.isScheduling ? {stripId: item.stripId} : {_id:  item._id}) : null;
        }

        function getCreateInlineGroup(type) {
            return (type === $ctrl.StripTypes.Scene || type === null || type === undefined);
        }

        function getCount() {
            return $ctrl.getCounter($ctrl.list.items, $ctrl.isScheduling);
        }

        //when other fields in the same item are updated -> ie start time end time
        //if 'estTime', 'prepTime', 'shootTime' changed for banner and scene
        //if time changed for daybreak
        function getUpdatedChanges(result, Settings) {
            console.log('getUpdatedChanges');
            var editchanges = result ? result.editchanges : {},
                item = result && result.item ? result.item :
                    (editchanges && editchanges._id ? _.extend({}, $ctrl.isBreakdown ?($ctrl.item._id === editchanges._id ? $ctrl.item : null) : $ctrl.list.getElementById(editchanges._id), editchanges) : null);

            item = $ctrl.scriptLoadingService.getExtendedStrip(item, null, $ctrl.isScheduling, Settings);

            if(item) {
                if (!editchanges) {
                    editchanges = {_id: item._id};
                }
                var props = $ctrl.service.getChangedFieldForUpdate(), n = props.length;
                for(var i = 0; i < n; i++) {
                    var prop = props[i],
                        str = prop.split('.'),
                        l = str.length;
                    if(l > 1){
                        var str0 = item ? item[str[0]] : null;
                        str0 = str0 ? str0[str[1]] : null;
                        if(l === 3){
                            str0 = str0 ? str0[str[2]] : null;
                        }
                        editchanges[prop] = str0;
                    }else {
                        editchanges[prop] = item[prop];
                    }
                }

                result.item = item;
            }

            return editchanges;
        }

        function afterProcessUpdatesG() {
            $ctrl.allStrips = $ctrl.getStrips();
            $ctrl.broadcastRoot('RELOAD_ALL_STRIPS', $ctrl.allStrips);
            return $ctrl.allStrips;
        }

        function edit(item, field) {
            try {
                field = field ? parseInt(field, 10) : null;
            } catch (e) {
                field = null;
            }
            if (!item) {
                return;
            }
            console.log('groups breakdowns edit');
            var is1000 = field === 1000;
            if (!$ctrl.isScheduling && !is1000 ||
                $ctrl.isScheduling && item.type === $ctrl.StripTypes.Scene && !is1000) {
                var isEditMode = field === 1;
                $ctrl.viewScene(item, isEditMode, false);//open in edit mode if comes from add new
            } else {
                $ctrl.editInit(item, is1000 ? 1 : field);
            }
        }

        function editSchedule(item) {
            return edit(item, 1000);
        }

        function getNewParams(after, type) {
            if(type && typeof(type) ==='string'){type = parseInt(type, 10);}
            if (type === undefined || type === null) {
                type = $ctrl.StripTypes.Scene;
            }

            var params = {
                name: null,
                type: type,
                pages: 0,
                active: true
            };

            if(after){
                params.afterId = after._id;
            }

            if (type === $ctrl.StripTypes.Scene) {
                if ($ctrl.isScheduling && after) {
                    params.afterId = after.stripId;
                }
                params.scene = $ctrl.getNextSceneNumber(after ? params.afterId : null);
            }
            else if (type === $ctrl.StripTypes.Banner) {
                var banner = $ctrl.LCS.getSetting('bannerColor');
                params.color = banner ? banner : $ctrl.LCS.bannerColor;
            }
            else{
                params.time = $ctrl.MomentService.getUtcMomentFromTimeMoment(null, $ctrl.CPS.startTime);
            }

            if ($ctrl.isScheduling) {
                var p = 'scheduleDayId';
                if (after && after[p] && type !== $ctrl.StripTypes.DayBreak) {
                    params[p] = after[p];
                }

                if($ctrl.listField){
                    params[$ctrl.listField] = $ctrl.currentListId;
                }
            }

            return params;
        }

        function getNewPopupParamsOther() {
            return {
                field: 'note',
                service: $ctrl.service,
                listTreeService: $ctrl.listTreeService,
                scriptLoadingService: $ctrl.preLoadingService,
                Settings: $ctrl.Settings,

                currentListId: $ctrl.currentListId,
                canEdit: $ctrl.canEdit,

                isScheduling: $ctrl.isScheduling
            };
        }

        function getEditPopupParams(item, field){
            return _.extend({}, $ctrl.getNewPopupParams(item), {
                changedFields: $ctrl.canEdit ? $ctrl.service.getEditableFields(item.type) : null
            });
        }

        function getNextSceneNumber(afterId) {
            return $ctrl.preLoadingService.getNewSceneNumber($ctrl.getStrips(true), afterId);
        }

        function preloadSettings(settings) {
            $ctrl.Settings = _.extend({}, $ctrl.Settings, settings ? settings : $ctrl.scriptLoadingService.preloadSettings());
        }

        function onItemPopoverChanged(result) {
            console.log('breakdowns group onItemPopoverChanged: ' + result._id);
            $ctrl.replaceElementProps(result._id, result.props);
        }

        function getGroupItemAttributes() {
        return 'strip-types="::$ctrl.StripTypes" '+
                'is-breakdown="::$ctrl.isBreakdown" ' +
                'is-scheduling="::$ctrl.isScheduling" ' +
                'on-view="$ctrl.goToBreakdown(stripId)" ' +
                'on-breakdown="$ctrl.goToBreakdown(stripId)"';
        }
    }
}

angular.module('product.breakdowns.group.loading.service', [
])
.service('BreakdownsGroupLoadingCtrlService',BreakdownsGroupLoadingCtrlService);
BreakdownsGroupLoadingCtrlService.$inject = ['SBFieldTypesService'];
function BreakdownsGroupLoadingCtrlService(SBFieldTypesService) {
    return function($ctrl) {
        if(!$ctrl.SBFieldTypesService) {
            $ctrl.SBFieldTypesService = SBFieldTypesService;
        }

        if(!$ctrl.SBFieldMethods) {
            $ctrl.SBFieldMethods = $ctrl.SBFieldTypesService.SBFieldMethods;
        }

        if(!$ctrl.MomentService) {
            $ctrl.MomentService = $ctrl.SBFieldMethods.MomentService;
        }

        $ctrl.setupNameInLine = 'End of ';
        $ctrl.StripTypes = {Scene: 1, DayBreak: 0, Banner: 2};

        $ctrl.getCounter = getCounter;
        $ctrl.processListItemColumn = processListItemColumn;
        $ctrl.showColumnOther = showColumnOther;
        return $ctrl;


        function showColumnOther(item, c, isHeader, isMobile, notTextOnly){
            return !($ctrl.isPrintLayout && c.prop === 'breakdownNotes');
        }

        function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
            var startTime = getContent('time'),
                estTime = getContent('estTime'),
                pages = getContent('pages'),
                duration = getContent('duration');

            var cDT = $ctrl.getColumnByProp('dayTime');
            var cST = $ctrl.getColumnByProp('sceneType');
            switch(item.type){
                case $ctrl.StripTypes.DayBreak:
                    return getColsDayBreak(c);
                case $ctrl.StripTypes.Scene:
                    return getColsScene(c);
                case $ctrl.StripTypes.Banner:
                    return getColsBanner(c);
            }

            function getColsScene(c) {
                switch (c.prop) {
                    case 'scene':
                        //with drp for scene
                        /* el += "<div class='" + c.colCls + "'>" +
                                    "<div class='scene-col colored-col scene text-center'>" +
                                        "<div dropdown>" +
                                            "<a class='with_underline scene-number gray' dropdown-toggle>" +
                                               // (hasScene ? $ctrl.SBFieldTypesService.getSBColContentView($ctrl, item, hasScene) : '') +
                                                (item.scene?$ctrl.SBFieldMethods.getSceneText(item):'#') +
                                                 $ctrl.LCS.getISBDiv('arrow-filled-down', 2, ' pull-right') +
                                            "</a>" +
                                            "<div class='dropdown-menu side-menu fadeInDownLeft fixedHeight strip-search-drp' role='menu'>" +
                                                "<div class='header-small clearfix'>Jump to Scene Breakdown…</div>" +
                                                "<ul class='fancy-scrollbar vertical strips-ul medium-template'>" + getStrips() + "</ul>" +
                                            "</div>" +
                                        "</div>" +
                                    "</div>" +
                                "</div>";
                            break;*/
                        return $ctrl.isBreakdown ? ("<div class='" + $ctrl.getClsCol(c) + "'>" +
                                "<div class='scene-col colored-col scene text-center'>" +
                                "<div class='scene-number gray'>" + (item.scene ? $ctrl.SBFieldMethods.getSceneText(item) : '#') + "</div>" +
                                "</div>" +
                            "</div>") : get(c);

                    case 'stripLocationId': //for scheduling
                    case 'miniTitle':   //for breakdowns & breakdown
                        var  cls = c.colCls + (c.grow? ' grow-column ' : '');
                        if(!$ctrl.isScheduling || isMobile){
                            c = $ctrl.getColumnByProp('miniTitle', true);
                            if(!$ctrl.isPrintLayout){
                                c = _.extend({} , c, {fieldClass: c.fieldClass + ' blue with-cursor with_underline '});
                            }
                        }

                        var info = $ctrl.SBFieldTypesService.getSBFieldContentView($ctrl, item, c, textOnly),
                            v = info.content ? info.content : info.placeholder;
                                // el += ($ctrl.isBreakdown ? '<div class="full-width">' : "<div class='display-block word-wrap'>") +

                        if(textOnly ){
                            return v;
                        }

                        if(isMobileRowDetails){
                            return get(c);
                        }

                     var withClick = ($ctrl.isBreakdown || $ctrl.isSides) ? '' :
                             ($ctrl.isPrintLayout ? '' : (($ctrl.LCS.isTouchScreen ? ' with_underline ' : ' with-cursor ') + $ctrl.getClickEventName('goToBreakdown'))),
                         el = (isMobile ? getommitted('full-width') : '') +
                              '<div class="full-width clearfix minititleblock">' +
                                 (item.contentScript ? ('<div class="pull-left col-unlinked '+
                                     (($ctrl.isPrintLayout || $ctrl.isSides) ? '' : (' with-cursor  ' + $ctrl.getClickEventName('viewUnsyncedScene'))) +
                                     '">' + $ctrl.LCS.getISBDiv('unlinked', 3, 'pull-left sbf18' + (($ctrl.isPrintLayout || $ctrl.isSides) ? '' : ' blue'),
                                         $ctrl.isPrintLayout ? '' : '  tooltip="Scene is not in sync with the screenplay" tooltip-placement="bottom"') +
                                     '</div>') : '') +
                                '<div class="' +
                                    ($ctrl.LCS.isTouchScreen ? '' : withClick ) + ' ' +
                                    (info.hasPlaceholderCls ? 'sb-placeholder ' : '') +
                                    (c.fieldClass ? c.fieldClass : '') + ' ' +
                                    $ctrl.SBFieldTypesService.getViewEditElemSelector(c.prop, true, $ctrl.canEdit && c.canEdit) +
                                '">' +
                                    '<span class="' + $ctrl.SBFieldTypesService.SBViewContentCls + ' ' + ($ctrl.LCS.isTouchScreen ? withClick : '') + '">' + v + '</span>' +
                                '</div>' +

                                (isMobile ? '' : getommitted('pull-left')) +
                              '</div>' +
                              getNote('description', textOnly)+
                              getNote('note', textOnly);

                        if($ctrl.isPrintLayout) {
                            el += getNote('breakdownNotes', textOnly, false,{wrapperClass: '', isNote: true});
                        }

                        el += getT();

                        function getT(){
                            if (!(isMobile && (estTime || startTime || pages || duration))){return '';}
                            return '<div class="full-width font-small">' +
                                (
                                    $ctrl.isSides ? (
                                        (pages ? (pages + '&nbsp;pages') : '')
                                       // +(duration && item.duration ? ((pages ? ' • ' : '') + 'Duration: ' + duration) : '')
                                    ) :
                                    (
                                        (estTime ? ('<span class="semibold">' + estTime + '</span>') : '') +
                                        (startTime ? ((estTime ? ' @ ' : '') + startTime) : '') +
                                        (pages ? (((estTime || startTime) ? ' • ' : '') + pages + '&nbsp;pages') : '')
                                       // +(duration ? (((estTime || startTime || startTime) ? ' • ' : '') + 'Duration: ' + duration) : '')
                                    )
                                ) +
                                '</div>';
                        }

                        function getommitted(cls) {
                            var isOmmitted = item[($ctrl.isScheduling || $ctrl.isSides) ? 'isNotOmitted' : 'active'] === false;
                            if (textOnly) {
                                return isOmmitted ? ' / OMITTED' : '';
                            }
                            return '<div class="' + $ctrl.SBFieldTypesService.getViewEditElemSelector('active', true, $ctrl.canEdit) + ' ' + (cls ? cls : '') + '">' + (isOmmitted ? '<div class="omitted">OMITTED</div>' : '') + '</div>';
                        }

                        return '<div class="' + cls +'">' + el + '</div>';

                    case 'breakdownNotes':
                        return $ctrl.isPrintLayout  ? '' : get(c);

                    case 'sceneType':
                    case 'dayTime':
                        if(c.prop === 'dayTime' ){
                            if(cST){return '';}
                        }
                        if(isMobileRowDetails) {
                            return get();
                        }

                        var center = ' text-center',
                            cls1 = 'full-width clearfix' + center,
                            ext = {
                                editableContainerClass: 'without-height-padding' + center,
                                withoutDiv: true
                            },
                            va = cST ? get(_.extend({}, cST, ext), ' ') : null,
                            dt = cDT ? get(_.extend({}, cDT, ext), ' ') : null;

                        if(textOnly){
                            return va + ', ' + dt;
                        }

                        return '<div class="' + (c.colCls + (c.grow ? ' grow-column ' : '')) + '">' +
                            (va ? (va
                             //'<div class="' + cls1 + '">' + va + '</div>'
                            ) : '') +
                            (dt ? (($ctrl.canEdit || item.dayTime) ?
                                dt //('<div class="' + cls1 + '">' + dt +'</div>')
                                : '') : '')+
                               '</div>';

                    case 'characterIds':
                    case 'locationIds':
                        if(!item.active){c.canEdit = false;}
                        return get(c);
                    default:
                        return get(c);
                }
            }

            function getColsBanner(c) {
                switch (c.prop) {
                    case 'scene':
                        return textOnly ? 'BANNER' : ('<div class="stripList scene-col">' +
                            '<div class="col30 centering">' +//col28
                                $ctrl.LCS.getISBDiv('info', 3, 'pull-left sbf30') +//sbf24
                            '</div>' +
                        '</div>');

                    case 'stripLocationId':
                    case 'miniTitle':
                        var el = '',
                            isCenter = false,
                            n = get($ctrl.getColumnByProp('name', true), ' ');
                        el += (textOnly ? n : ('<div class="full-width">' + n + '</div>')) +
                              getNote('note', textOnly, isCenter);

                        if($ctrl.isPrintLayout) {
                            el += getNote('breakdownNotes', textOnly, isCenter,
                                    _.extend({}, isCenter ? {wrapperClass:'centering'} : null, {isNote: true})
                                );
                        }

                        if(!textOnly){
                            el = '<div class="title-cell day-breaks grow-column"><div class="full-width">' + el + '</div></div>';
                        }

                        //last col
                        if (isMobile) {
                            if (estTime || startTime) {
                                el += '<div class="stripList shot-esttime-col text-center">' +
                                    (startTime ? ('<div class="full-width text-center semibold">Start Time:&nbsp;' + startTime + '</div>') : '') +
                                    (estTime ? ('<div class="full-width text-italic with-parenthesis font-small">' + estTime + '</div>') : '') +
                                    '</div>';
                            }
                        }
                        return el;

                    case 'estTime':
                    case 'shootTime':
                    case 'prepTime':
                        return get(c);

                    case 'time':
                    case 'endTime':
                        return get(c);

                  /*  case 'sceneType':
                        return isMobileRowDetails ? '' : ('<div class="'+cls+'"><span class="dash">—</span></div>');
                    */
                    case 'breakdownNotes':
                        return $ctrl.isPrintLayout ? '' : get(c);

                    default:
                        return '';
                }
            }

            function getColsDayBreak(c) {
                switch (c.prop) {
                    case 'scene':
                        var d = item.date,
                            mo = $ctrl.CPS.getCreatedAt(d, 'MMM'),
                            day = $ctrl.CPS.getCreatedAt(d, 'DD'),
                            icon = $ctrl.LCS.getISBDiv('daybreak', 3, 'pull-left sbf20'); //'—';
return textOnly ? (mo + ' ' + day) :
                           ('<div class="stripList scene-col calendar-box transparent">' +
                                '<div class="centering">' +
                                    '<div class="calendar-bottom text-center uppercase '+(d?'':'empty')+'">' + (d ? mo : icon) + '</div>' +
                                    '<div class="calendar-top text-center">' + day + '</div>' +
                                '</div>' +
                           '</div>');

                    case 'stripLocationId':
                    case 'miniTitle':
                        var dash = textOnly ? ' — ' : ('<span class="long-dash"> — </span>'),
                            sp = textOnly ? ' ' : '&nbsp;',
                            spSL = (textOnly ? '' : '<span class="pull-left">'),
                            spE = (textOnly ? '' : '</span>'),
                            brM = (isMobile ? '<br/>' : dash),
                            canEdit = !isMobile && $ctrl.canEdit,
                            el = '';
                        //title-cell
                        el += textOnly ? '' : '<div class="title-cell day-breaks grow-column">';

                        el += $ctrl.setupNameInLine +sp+ getColInfo('name', false, true);
                        //to do trigger edit modal for day break
                        //el += $ctrl.setupNameInLine +sp+ getColInfo('name', true , true, null, {openPopup: true});

                        if(canEdit || !canEdit && item.note) {
                            if(canEdit) {
                                el +=  getColInfo('note', false, false,  'with-ap-and-dash' + (item.note ? '' : ' empty'), {hideEmptyContent: true});
                            }else {
                                el += brM + getColInfo('note');
                            }
                        }

                        var hasDate = canEdit || !canEdit && item.date,
                            hasTime = canEdit || !canEdit && (item.time || item.endTime),
                            hastTimeOrEst = hasTime || item.estTime,
                            withLineUnder = hasDate || hastTimeOrEst || pages || duration;
                        //---
                        if(!isMobile && withLineUnder) {
                            el += textOnly ? ' • ' : '<div class="full-width subtitle">';

                            //use dot for items on the line under
                                brM = getSep(true);
                        }

                        if(hasDate) {
                            el += (isMobile ? brM : '') + getColSubtitle('date', !isMobile, true);
                        }

                        // — 9:00 am to 9:00 pm  (12h day) — 5 4/8 total pages | mobile: 9:00 am to 9:00 pm <br> (12h day) <br> 5 4/8 total pages
                        el += (isMobile ? '<div class="full-width">' : brM) +
                            getColSubtitle('time', canEdit, true, true) +
                           (item.endTime ? ( spSL + sp + 'to' + sp + spE + //if end time exists -> start time exists
                                getColSubtitle('endTime', false, true, true)) : '') +
                             (isMobile ? '</div>' : '');

                        if(!isMobile) {
                            var hasEstTime = $ctrl.getColumnByProp('estTime');
                            if (item.estTime) {
                                el += (hasTime ? (spSL + sp + sp + '(' + spE) : '') +
                                    getColSubtitle('estTime', false, true) +
                                    spSL + sp + 'day' + spE +
                                    (hasTime ? (spSL + ')' + spE) : '');
                            }
                            var prop = 'pages', //'pagesDisplay'
                               info = getColSubtitle(prop, false, true);
                            if (info) {
                                el += brM + info + spSL + sp + 'total pages' + spE;
                            }

                            prop = 'duration';
                            info = getColSubtitle(prop, false, false);
                            if (info) {
                             //   el += brM + spSL + 'Duration: ' + sp + spE + info;
                            }

                            if(withLineUnder) {
                                el += textOnly ? '' : '</div>';
                            }

                            if ($ctrl.isPrintLayout) {
                                el += getNote('breakdownNotes', textOnly, false, {isNote: true});
                            }

                        }

                        //title-cell
                        el += textOnly ? '' : '</div>';

                        if(!isMobile && $ctrl.canEdit && !textOnly){
                            el += '<div class="col140 with-hover text-center hide-print hide-ipad no-drag">' +
                                '<button type="button" class="btnCall display-block btn btn-small without-text with-square ' + $ctrl.getClickEventName('createCallsheet') + '" data-type="createCallsheet" analytics-on analytics-action="Open Create Call Sheet">' +
                                //$ctrl.LCS.getISBDiv('plus', 2)+
                                '<span class="hide-ipad">Create Call Sheet</span>' +
                                '</button>' +
                                '</div>';
                        }

                        if (isMobile && (estTime || pages || duration)) {     //last col on mobile
                            el += '<div class="stripList shot-esttime-col text-center">' +
                                    (estTime ?('<div class="full-width text-center semibold">' + estTime + sp + 'Day</div>') : '') +
                                    (pages ? ('<div class="text-italic font-small">' + pages + sp + 'pgs</div>') : '') +
                                   // (duration ? ('<div class="text-italic font-small">' + sp +  'Duration:'  + duration + '</div>') : '') +
                                  '</div>';
                        }

                        function getSep(isLeft) {
                            return textOnly ? ' • ' : ('<span class="dot-separator smaller ' + (isLeft ? 'pull-left' : '') + '"></span>');
                        }
                    return el;

                   /* case 'sceneType':
                        return isMobileRowDetails ? '' :
                            (textOnly ? ' — ' : ('<div' + (cls ? (' class="'+cls+'"') : '') + '><span class="dash">—</span></div>'));
                    */
                    //case 'estTime':
                    //case 'shootTime':
                    //case 'prepTime':
                    //case 'time':
                    //case 'endTime':
                        //return get(c);

                    case 'breakdownNotes':
                        return $ctrl.isPrintLayout ? '' : get(c);

                    default:
                        return '';
                }

                function getColInfo(prop, canEdit, isAll, cls, other) {
                    return getInline($ctrl.getColumnByProp(prop, isAll), prop, canEdit,cls, other);
                }

                function getColSubtitle(prop, canEdit, isAll, pullLeft){
                    var c = $ctrl.getColumnByProp(prop, isAll),
                    div = c ? getInline(c, prop, canEdit, ' ') : null;
                    return div ? ((isMobile && !pullLeft) ? div :
                        (textOnly ? div : ('<div class="pull-left">'  + div + '</div>'))
                    ) : null;
                }

                function getInline(c, prop, canEdit, cls, other) {
                    return get(_.extend({}, c, {canEdit: canEdit},
                        canEdit ? {editableContainerClass: 'without-height-padding'} : null,
                        other,
                        prop === 'name' ? {placeholder: 'Name'} : null),   cls || 'inline-block') ;
                }
            }

            function getNote(prop, textOnly, isCenter, other) {
                var n = $ctrl.getColumnByProp(prop),
                    isNote = other && other.isNote;
                if (!n) {
                    return '';
                }

                var v = get(_.extend({}, n, {
                    hideEmptyContent: true,
                    fieldClass: n.fieldClass
                }, other), ' ');

                if ($ctrl.isPrintLayout && !v) {
                    return '';
                }

                return textOnly ? v : (n ? ('<div class="full-width ' + (isNote ? 'padding-top-5' : 'subtitle') +
                    (isCenter ? ' text-center' : '') +
                    '">' +
                    (isNote ? '<div class="bold padding-top-8">NOTE: </div>' : '') + v + '</div>') : '');
            }

            function get(c, nCls){
                return c ? $ctrl.getDisplayItemCol(item, c, nCls ? nCls : cls, canEdit, textOnly, isMobile, isMobileRowDetails) : '';
            }

            function getContent(name) {
                var c = $ctrl.getColumnByProp(name, $ctrl.isSides),
                    co = c ? $ctrl.SBFieldTypesService.getSBFieldContentView($ctrl, item, _.extend({}, c, {hideEmptyContent: true}), textOnly).content : null;
                return co && co !== '' && co.replace(/(<([^>]+)>)/ig, '') !== '–' ? co.replace('display-block', 'inline-block') : null;
            }
        }

        function getCounter(list, isScheduling) {
            //totalCount display count
            //dif -> the remaining items that are not considered for display
            var d = 0, t = 0, l = [];
            getc($ctrl.StripTypes.Scene, 'scene', isScheduling ? false : true, true);
            if (isScheduling){
                 getc($ctrl.StripTypes.Banner, 'banner', false, false);
                 getc($ctrl.StripTypes.DayBreak, 'day break', true, false);
            }

            return {totalCount: d, dif: t, counterText:  l.length > 0 ? l.join('&nbsp;•&nbsp;') : ''};

            function getc(t, n, isLast, set) {
                var c = _.filter($ctrl.list.items, {type: t}).length;
                if(set) {
                    d = c;
                }else{
                    t += c;
                }
                if(c){
                    l.push(c + ' ' + n + (c === 1 ? '' : 's'));
                }
            }
        }
    }
}

angular.module('product.breakdowns.group.component.service', [
    'product.breakdowns.group.init.component.service'
])
.service('BreakdownsGroupCtrlService', BreakdownsGroupCtrlService);
BreakdownsGroupCtrlService.$inject = ['ScriptConvertService', 'BreakdownsGroupInitCtrlService', 'TreeGroupInitCtrlService'];
function BreakdownsGroupCtrlService(ScriptConvertService, BreakdownsGroupInitCtrlService, TreeGroupInitCtrlService) {
    return function($ctrl, $element, Pagination) {

        $ctrl.withAddUnder = true;
        $ctrl.scriptLoadingService = $ctrl.preLoadingService;//todo check

        $ctrl.getBanner = getBanner;

        $ctrl.getGroupButtons = getGroupButtons;

        $ctrl.onListChanged = onListChanged;
        $ctrl.onPreloadGroup = onPreloadGroup;

        $ctrl.duplicate = duplicate;
        $ctrl.viewNotesParams = viewNotesParams;
        $ctrl.preProcessGroupItem = preProcessGroupItem;
        $ctrl.onPreAdded = onPreAdded;
        $ctrl.onPreloadSettings = onPreloadSettings;
        $ctrl.createScene = createScene;

        $ctrl = new BreakdownsGroupInitCtrlService($ctrl);
        $ctrl = new TreeGroupInitCtrlService($ctrl, $element, Pagination, true);

        if ($ctrl.initScenePopupEvents) {
            $ctrl.initScenePopupEvents();
        }

        return $ctrl;

        function onPreloadSettings(result) {
            console.log('onPreloadSettings');
            if ($ctrl.preloadSettings) {
                $ctrl.preloadSettings();
            }
            // $ctrl.broadcastRoot('PRELOADED_SETTINGS_CHANGED_' + $ctrl.elemType + '_GROUP', $ctrl.Settings);
        }

        function getBanner() {
            if($ctrl.CPS.isCollaborator && $ctrl.LCS.collabBannerInside){
                var txt = ($ctrl.isScheduling ? 'stripboard' : 'breakdowns');
            return '<div class="alert alert-warning alert-stylish '+txt+' table-div full-width">' +
                        '<div class="centered grow-column">' +
                            $ctrl.LCS.getISBDiv (txt, 5, 'icon sbf24 pull-left') +
                            '<span class="text">Create your own '+($ctrl.isScheduling ? 'shooting schedules' : 'breakdowns')+' now.</span>' +
                        '</div>' +
                        '<div class="centered col160">' +
                            '<a href="'+$ctrl.CPS.websiteUrl+'/register?utm_campaign=collab-stripboard" target="_blank" class="btn btn-primary pull-right">Get Started Free</a>' +
                        '</div>' +
                        getCloseBtn() +
                    '</div>';
                function getCloseBtn(){
                    return '<div class="centered btn-col text-center col40">' +
                        //'<a class="closebtn display-block" ng-click="$ctrl.CPS.closeBanner()">' + $ctrl.LCS.getISBDiv('close-bigger', 2) + '</a>' +
                        '</div>';
                }
            }
            if(!$ctrl.CPS.isCollaborator){
                var message = '<strong>50% of the Imported Scenes are displayed</strong> – This plan doesn’t support full screenplay display. '+
                        ($ctrl.isScheduling ? ('To schedule your entire screenplay') : ('To view your entire screenplay'));
        return '<div class="alert alert-warning">' +
                    '<div class="spacing-quart position-relative">' + message + ', <a href="'+$ctrl.CPS.getStateHref('user.pricing', $ctrl.CPS.currentPathParams())+'">Upgrade now!</a>' +
                   // '<a class="closebtn close" ng-click="$ctrl.CPS.closeBanner()" style="top:7px">&times;</a>' +
                    '</div>' +
                '</div>';
            }

        }

        function duplicate(item, param, e) {
            console.log('duplicate');
            var newItem = angular.copy(item);
            if($ctrl.listField){
                newItem[$ctrl.listField] = $ctrl.currentListId;
            }

            if(item.type === 1) {
                newItem.scene = $ctrl.getNextSceneNumber(item ? ($ctrl.isScheduling ? item.stripId : item._id) : null);
                newItem.htmlContent = ScriptConvertService.getHtmlContent(newItem.content, newItem.scene);
            }

            newItem.isDuplicate = true;
            delete newItem._id;
            $ctrl.create(item, item.type, newItem, null,null,e);
        }

        function createScene(after, type, e) {
            $ctrl.create(after, (type === undefined || type === null) ? $ctrl.StripTypes.Scene : parseInt(type, 10), null, null, null, e);
        }

        function getGroupButtons() {
            var withNgClick = false,
                createScene = 'createScene',
                create = 'createItemWithEvent',
                btnCls = 'small inline-block semibold '  + (withNgClick ? '' : $ctrl.getBtnActionCls());

            return '<a class="' + btnCls + '"' +
(withNgClick ? (' ng-click="$ctrl.' + createScene + '(null,$ctrl.StripTypes.Scene, $event)"') :'') +   ' data-type="createNonNg" data-info="' + $ctrl.StripTypes.Scene + '" analytics-on analytics-action="Add Scene" tabindex="{{$ctrl.list.totalCount * 4 + 1}}"' +
                //' ui-keyup="{enter:\'$ctrl.' + createScene + '(null,$ctrl.StripTypes.Scene, $event)\'}"' +
                '>' + getC() + ' <span>Add <span class="underlined">S</span>cene</span></a>' +
($ctrl.isScheduling ? ('<a class="' + btnCls + '"' +
(withNgClick ? (' ng-click="$ctrl.'+create+'(null, $ctrl.StripTypes.DayBreak, $event)"') : '') + ' data-type="createNonNg" data-info="' + $ctrl.StripTypes.DayBreak + '" analytics-on analytics-action="Add Day Break" tabindex="{{$ctrl.list.totalCount * 4 + 2}}"' +
                //' ui-keyup="{enter:\'$ctrl.'+create+'(null, $ctrl.StripTypes.DayBreak, $event)\'}"' +
    '>' + getC() + ' <span><span class="underlined">D</span>ay Break</span></a>' +
                    '<a class="' + btnCls + '"' +
(withNgClick ? (' ng-click="$ctrl.' + create + '(null, $ctrl.StripTypes.Banner, $event)"'):'') + ' data-type="createNonNg" data-info="' + $ctrl.StripTypes.Banner + '" analytics-on analytics-action="Add Banner" tabindex="{{$ctrl.list.totalCount * 4 + 3}}"' +
                //' ui-keyup="{enter:\'$ctrl.' + create + '(null, $ctrl.StripTypes.Banner, $event)\'}"' +
    '>' +
                    getC() + ' <span><span class="underlined">B</span>anner</span></a>') : '');

            function getC() {
                return $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left with-margin-right');
            }
        }

        function onPreloadGroup() {
            if($ctrl.canEdit){
                $ctrl.assignLocations = assignLocations;
                $ctrl.assignCast = assignCast;
                $ctrl.removeLocations = removeLocations;
            }
        }

        function assignLocations(ids, e) {
            console.log('assignLocations');
            processBulk($ctrl.popupsService.operations.assignLocations, ids, e);
        }

        function assignCast(ids, e) {
            console.log('assignCast');
            processBulk($ctrl.popupsService.operations.assignCast, ids, e);
        }

        function removeLocations(ids, e) {
            console.log('removeLocations');
            var txt = 'Unassign Locations';
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations.confirm, {
                btn: txt,
                icon: 'pin',
                title: txt,
                pageClass: $ctrl.pageClass,
                dontShowAgain: false,
                message: '<p class="text-center font-general font-general-14 line-height-2">This will unassign all assigned locations from the selected scene'+(ids.length===1?'':'s')+'. The locations will still exist, and can be reassigned anytime.</p>',
                onConfirm: onConfirm
            });

            function onConfirm() {
                console.log('onConfirm');
                if ($ctrl.saveInProgress) {return;}
                $ctrl.saveInProgress = true;
                var info = processIds(ids),
                stripIds = info.selected;
                $ctrl.scriptLoadingService.Tbl.Locations.loadingService.objectService.updateMultipleForStrip( {
                    companyId: $ctrl.CPS.companyId,
                    productId: $ctrl.CPS.productId,
                    scriptId: $ctrl.CPS.scriptId,
                    stripIds: stripIds,
                    removeAll: true
                }, onsuccess, onerror);

                function onerror(err){
                    $ctrl.saveInProgress = false;
                    $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.locations.removeAll.error', 'error');
                }

                function onsuccess(result){
                    var tableType = 'locations';
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.locations.removeAll.success', 'success');
                    $ctrl.scriptLoadingService.processSceneElement(result, tableType);

                    result.editchangesList = stripIds.map(function (stripId) {
                        return {
                            //get scheduleId for the item for schedulign page
                            _id: $ctrl.isScheduling ? info.matchings['s_' + stripId] : stripId,
                            locationIds: $ctrl.scriptLoadingService.getStripById(stripId).locationIds
                        };
                    });
                    if(result.editchangesList){
                        delete result.withStripChanges;
                        $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result);
                    }
                    $ctrl.broadcastRoot('CLEAR_SELECTED_ROWS_' + $ctrl.elemType);

                    $ctrl.saveInProgress = false;
                }
            }
        }

        function processIds(ids){
            console.log('processIds');
            var matchings = {},
                newids = ids && ids.length > 0 ? ids.map(function (el){
                    var id = el && el.id !== undefined ? el.id : el;
                    //these are scheduleIds -> get the stripIds
                    if($ctrl.isScheduling){
                        var stripId = $ctrl.list.getElementById(id).stripId;
                        matchings['s_' + stripId] = id;
                        return stripId;
                    }
                    return id;
                }) : null;

            return {
                selected: newids,
                matchings: matchings
            };
        }

        function processBulk(operation, ids) {
            if (!ids || ids.length === 0) {
                return;
            }

            $ctrl.preloadSettings();

            var extraParam = $ctrl.withProperty();
            extraParam.elemType = $ctrl.elemType;
            extraParam.type = operation.type;
            extraParam.isScheduling = $ctrl.isScheduling;
            if(ids && ids.length> 0){
                extraParam.scriptLoadingService  = $ctrl.scriptLoadingService;
                extraParam.isScheduling = $ctrl.isScheduling;
                extraParam.initList  = $ctrl.Settings[operation.type === 'Assign Cast' ? 'characters' : 'locations'];
                extraParam = _.extend(extraParam, processIds(ids));

                $ctrl.popupsService.open(null, operation, extraParam, $ctrl.compOptions);
            }else{
                //$ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.team.pending.error', 'error');
            }
        }

        function viewNotesParams(item) {
            console.log('viewNotesParams');
            var customTitle = (item.type === $ctrl.StripTypes.Scene ?  'Scene'  : item.type === $ctrl.StripTypes.DayBreak ? 'Day Break' : 'Banner'),
                itemName = item.type === $ctrl.StripTypes.Scene && item.scene ? (customTitle + ' ' + item.scene) : customTitle;
                //subtitle = item.type === $ctrl.StripTypes.Scene ? ('Sc. ' + item.scene + ' — '+item.miniTitle) : '';
            return {
                itemName: itemName,
                //subtitle: subtitle,
                field: 'breakdownNotes',
                emptyField: 'There are no notes added for this ' + customTitle.toLowerCase()
            };
        }

        function onListChanged() {
            $ctrl.broadcastRoot('START_INTRO');
        }

        function changeOrder(order) { //client side reordering
            if (!$ctrl.list.items.length) {
                return [];
            }

            var p = $ctrl.orders[order];
            $ctrl.orders[order] = (p != null) ? (p === 1 ? -1 : 1) : 1;

            var items = [],
                groups = _.groupBy($ctrl.list.items, 'type');
            concat('1');
            concat('0');
            concat('2');

            $ctrl.list.items = items;

            function concat(type) {
                var c = getGroup(type);
                if (c) {
                    items = items.concat(c);
                }
            }

            function getGroup(type) {
                var g = groups[type], o = $ctrl.orders[order];
                if (g && g.length > 0) {
                    if (type === '1') {
                        g = g.sort(compare);
                    }
                    return g;
                }
                return null;
            }

            function compare(a, b) {
                var an, bn;
                switch (order) {
                    case 'stripLocationId':
                        if (a.stripLocation && b.stripLocation) {
                            an = a.stripLocation.name.toLowerCase();
                            bn = b.stripLocation.name.toLowerCase();
                        } else {
                            an = 0;
                            bn = 0;
                        }
                        break;
                    case 'dayTime':
                        an = $ctrl.SBFieldMethods.getTimeDayDisplay(a);
                        bn = $ctrl.SBFieldMethods.getTimeDayDisplay(b);
                        break;
                    default:
                        an = a[order] ? a[order] : 0;
                        bn = b[order] ? b[order] : 0;
                        break;
                }

                return (an > bn) ? 1 : ((bn > an) ? -1 : 0);
            }
        }

        function onPreAdded(result) {
            $ctrl.preLoadingService.processTablesUpdatesG(result);

            if($ctrl.withCustomSettings && $ctrl.preloadSettings) {
                $ctrl.preloadSettings();
            }
        }

        function preProcessGroupItem(item) {
            console.log('preProcessGroupItem');
            if ($ctrl.isScheduling && item.type !== 1) {
                return item;
            }

            var strip = null,
                allStrips = $ctrl.afterProcessUpdatesG(),
                index = _.findIndex($ctrl.allStrips, function (el) {
                    return el._id === item[$ctrl.isScheduling ? 'stripId' : '_id'];
                });

            if (index > -1) {
                if (!strip) {
                    strip = allStrips[index];
                } else {
                    allStrips[index] = strip;
                }
            }
            //todo: should include Settings instead of null ???
            return $ctrl.scriptLoadingService.getExtendedStrip(item, strip, $ctrl.isScheduling, $ctrl.Settings);
        }
    }
}

angular.module('product.breakdowns.item.grid.component', [
    'product.callsheet.editScheduleItem.controller.service'
])
.component('stripItemGrid', itemGridComponentParams({
    isScheduling: '<',
    isBreakdown: '<',
    stripTypes: '<',
}, 'StripItemGridCtrl','<div class="row-schedule"></div>'))
.controller('StripItemGridCtrl', StripItemGridCtrl);
StripItemGridCtrl.$inject = ['GridItemGroupInitCtrlService', 'EditScheduleItemCtrlService', '$element'];
function StripItemGridCtrl(GridItemGroupInitCtrlService, EditScheduleItemCtrlService, $element) {
   //console.log('StripItemGridCtrl')
    var rowClass;

    var $ctrl = this;
    $ctrl = new EditScheduleItemCtrlService($ctrl);

    $ctrl.bindingNames= ['goToShotsList', 'viewScene', 'goToBreakdown', 'viewUnsyncedScene', 'editSchedule', 'createCallsheet'];

    $ctrl.updateEditableItemPropsAll = updateEditableItemPropsAll;
    $ctrl.postInitItem = postInitItem;
    $ctrl.getAdditionalChanges = getAdditionalChanges;
    $ctrl.getSBPropForField = getSBPropForField;
    $ctrl.preInitGridItem = preInitGridItem;

    $ctrl = new GridItemGroupInitCtrlService($ctrl, $element, {
        itemId: $ctrl.itemId
    });

    function preInitGridItem() {
        $ctrl.scriptLoadingService = $ctrl.preLoadingService;//todo check
        $ctrl.itemId = $ctrl.item._id;
        $ctrl.stripId = $ctrl.isScheduling ? $ctrl.item.stripId : $ctrl.item._id;

        if ($ctrl.item.type === undefined || $ctrl.item.type === null) {
            $ctrl.item.type = 1;
        }

        rowClass = getRowClass($ctrl.item.type);
        $ctrl.previousItemId = $ctrl.itemId;
        $element[0].className += rowClass;
    }

    function updateEditableItemPropsAll(changes) {
        console.log('StripItemGridCtrl: updateEditableItemPropsAll');

        if($ctrl.item){
            if ($ctrl.item.type === 1) {
                var noteChanged = $ctrl.hasPropChanged(changes, 'breakdownNotes'),
                    charChanged = $ctrl.hasPropChanged(changes, 'characterIds'),
                    scriptPosChanged = $ctrl.hasPropChanged(changes, 'stripLocationId') ||
                        $ctrl.hasPropChanged(changes, 'sceneType') || $ctrl.hasPropChanged(changes, 'dayTime');
                // sceneChanged = $ctrl.hasPropChanged(changes, 'scene');

                if (noteChanged) {
                    $ctrl.updatePropContent('breakdownNotes');
                }
                if (charChanged) {
                    $ctrl.updatePropContent('elements');
                }
                if($ctrl.hasPropChanged(changes, 'pages') || $ctrl.hasPropChanged(changes, 'pagesCustom')){
                    $ctrl.item.pagesDisplay = $ctrl.item.pagesCustom ? $ctrl.item.pagesCustom : $ctrl.item.pages;
                    $ctrl.updatePropContent('pagesDisplay');
                }
                if (scriptPosChanged) {
                    $ctrl.updatePropContent($ctrl.isScheduling ? 'stripLocationId' : 'miniTitle');
                }
            }else if($ctrl.item.type === 0){//day break
                if($ctrl.hasPropChanged(changes, 'date')){
                    var el = $ctrl.element.querySelector('.calendar-box');
                    if(el){
                        var d = $ctrl.item.date,
                        b = el.querySelector('.calendar-bottom');
                        $ctrl.LCS[d ? 'removeClass': 'addClass'](b, 'empty');
                        b.innerText = d ? $ctrl.CPS.getCreatedAt(d, 'MMM') : '—';
                        el.querySelector('.calendar-top').innerText = d ? $ctrl.CPS.getCreatedAt(d, 'DD') : '';
                    }
                }
                if($ctrl.hasPropChanged(changes, 'note')){
                    var el = $ctrl.element.querySelector('.with-ap-and-dash');
                    if(el ){
                       $ctrl.LCS[$ctrl.item.note ? 'removeClass' : 'addClass'](el, 'empty');
                    }
                }
            }
        }

        $ctrl.postInitItem();
    }

    //update infor from the strip
    function getAdditionalChanges(data) {
        if (data && $ctrl.item.type === $ctrl.stripTypes.DayBreak) {
            _.each(['prepTime', 'shootTime', 'estTime', 'duration', 'pages', 'scenes'], function (prop){
                if (data[prop] !== undefined) {
                    delete data[prop];
                }
            });  //if is day break and (pages or est time is getting change don't update

            var hasProp;
            for (var prop in data) {
                hasProp = true;
                break;
            }
            return hasProp ? data : null;
        }
        return data;
    }


    function getRowClass(type) {
        switch (type) {
            case $ctrl.stripTypes.Scene:
                return ' scene hastype ';
            case $ctrl.stripTypes.DayBreak:
                return ' daybreak ';
            case $ctrl.stripTypes.Banner:
                return ' banner ';
        }
    }

    function postInitItem() {
        //console.log('postInitItem');
        var l = ['row-schedule', 'full-width', 'border-bottom', 'colored-col', 'with-smaller-font fullstrip',
                'with-smaller-font is12 fullstrip', 'without-hover'],
            toRemove = [];
        _.each($ctrl.elRowSchedule.classList, function (cls) {
            if (l.indexOf(cls) === -1) {
                toRemove.push(cls);
            }
        });
        _.each(toRemove, function (cls) {
            $ctrl.elRowSchedule.classList.remove(cls);
        });

        if ($ctrl.isScheduling || $ctrl.isBreakdown) {
            $ctrl.LCS.addClass($ctrl.elRowSchedule, $ctrl.isScheduling ? 'colored-col' : 'with-smaller-font is12 fullstrip');
        }

        var el = $ctrl.isScheduling ? $ctrl.elRowSchedule : $ctrl.elRowSchedule.querySelector('.colored-col');
        if (el) {
            if ($ctrl.prevItemColor) {
                $ctrl.LCS.removeClass(el, rowClass + $ctrl.prevItemColor);
            }

            $ctrl.LCS.addClass(el, rowClass + $ctrl.item.color);
        }

        if ($ctrl.item.type === $ctrl.stripTypes.Banner) {//banner
            $ctrl.LCS.setCSSStyle($ctrl.elRowSchedule, 'background-color', $ctrl.item.color);
            $ctrl.LCS.addClass($ctrl.elRowSchedule, $ctrl.SBFieldMethods.getColorClass($ctrl.item));
        }

        $ctrl.prevItemColor = $ctrl.item.color;
    }

    function getSBPropForField(item, prop) {
        if (prop === 'active') {
            return (item[$ctrl.isScheduling ? 'isNotOmitted' : 'active'] === false ? '<div class="omitted">OMITTED</div>' : '');
        }
        return $ctrl.getSBPropForFieldInit(item, prop);
    }
}


