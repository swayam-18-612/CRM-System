angular.module('product.callsheet.locations.import.component', [
    'apiServices.Locations'
])
.component('importCallsheetLocationPopover', {
    bindings: {
        parentContainer: '@',
        header: '@',
        scriptLoadingService: '<',
        onUpdate: '&',
    },
    controller: 'ImportCallsheetLocationPopoverCtrl'
})
.controller('ImportCallsheetLocationPopoverCtrl', ImportCallsheetLocationPopoverCtrl);

ImportCallsheetLocationPopoverCtrl.$inject = ['TemplateCompileCompCtrlService', 'LocationsService', '$element'];
function ImportCallsheetLocationPopoverCtrl(TemplateCompileCompCtrlService, service, $element) {
    console.log('ImportCallsheetLocationPopoverCtrl');
    var $ctrl = this;

    $ctrl.preLoadingTableName = 'Locations';
    $ctrl.service = service;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        if($ctrl.scriptLoadingService){
            $ctrl.list = $ctrl.scriptLoadingService.getLocations({active: true});
        }

        $ctrl.LCS.addClass($ctrl.element, 'import-callsheet-location-popover parent-dropdown-menu clearfix');
    }

    function getItemTemplate() {
        var t = ($ctrl.header ? ('<div class="header-small clearfix spacing-half-top padding-left20">'+$ctrl.header+'</div>') : '');
        if($ctrl.list.length > 0){
            t += '<ul>';
            _.each($ctrl.list, function (item) {
                t += '<li class="dropdown-item wide-tooltip table-div " data-id="'+item._id+'">' +
                        '<div class="col20 centered">'+$ctrl.LCS.getISBDiv('pin', 2, 'gray')+'</div>' +
                        '<div>'+item.name+'</div>' +
                     //   '<a class="btnRemove editable-btn btn gray-light">'+$ctrl.LCS.getISBDiv('cancel')+'</a>' +
                    '</li>';
            });
            t += '</ul>'
        }else{
            t += '<div class="no-items">' +
                    '<div class="text-center">'+$ctrl.LCS.getISBDiv('pin', 2, 'gray sbf30')+'</div>' +
                    '<div class="text">No locations have been saved to your Location Library.</div>' +
                '</div>';
        }

        return '<div class="dropdown-menu display-block locations-popup wide-padding display-block '  + ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '')+'">' + t + '</div>';
    }

    function onLoaded() {
        $ctrl.btnRemove =  $ctrl.element.querySelectorAll('.btnRemove');
        $ctrl.ulEl =  $ctrl.element.querySelector('ul');
        $ctrl.liItems =  $ctrl.element.querySelectorAll('li');
        bind(true);
    }

    function remove(e) {
        var item = getItem(e);
        $ctrl.service.delete(item, function (res) {
            for (var i = $ctrl.list.length - 1; i >= 0; i--) {
                if ($ctrl.list[i]._id === item._id) {
                    $ctrl.list.splice(i, 1);
                    $ctrl.scriptLoadingService.modify($ctrl.preLoadingTableName, item, $ctrl.scriptLoadingService.Ops.Remove);
                    $ctrl.ulEl.removeChild($ctrl.ulEl.childNodes[i]);
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.locations.Remove.success', 'success');
                    break;
                }
            }
        }, function (error) {
            $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.locations.Remove.error', 'error');
        });
    }
    
    function select(e) {
        $ctrl.onUpdate({result: {withClose: true, item: getItem(e), $event: e}});
    }

    function getItem(e) {
        //e.preventDefault();
        //e.stopPropagation();
        var id = e.currentTarget.getAttribute('data-id');
            return _.find($ctrl.list, function (item) {return item._id === id;});
    }

    function bind(isBind) {
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnRemove, remove);
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.liItems, select);
    }

    function onDestroy() {
        bind(false);
    }
}

angular.module('product.callsheet.locations.save.component', [
    'apiServices.Locations'
])
//Location Name…
.component('saveCallsheetLocationPopover', {
    bindings: {
        drpClassAttr: '@?',
        fieldClass:'@?',
        header: '@',
        placeholder: '@?',
        required: '@?',
        scriptLoadingService: '<',
        //variables:
        item: '<',
        onUpdate: '&',
    },
    controller: 'SaveCallsheetLocationPopoverCtrl',
})
.controller('SaveCallsheetLocationPopoverCtrl', SaveCallsheetLocationPopoverCtrl);

SaveCallsheetLocationPopoverCtrl.$inject = ['TemplateCompileCompCtrlService', 'LocationsService', '$element'];
function SaveCallsheetLocationPopoverCtrl(TemplateCompileCompCtrlService, service, $element) {
    console.log('SaveCallsheetLocationPopoverCtrl');
    var $ctrl = this;
    $ctrl.service = service;
    $ctrl.preLoadingTableName = 'Locations';
    $ctrl.save = save;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.formHolderItem = {};
    $ctrl.formName = 'formItem';
    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        if(!$ctrl.scriptLoadingService) {
            console.log('SaveCallsheetLocationPopoverCtrl must define $ctrl.scriptLoadingService');
        }
        $ctrl.list = $ctrl.scriptLoadingService.getLocations({active: true});

        $ctrl.LCS.addClass($ctrl.element, 'dropdown-menu add-locations-popup display-block ' + ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : ''));
        $ctrl.element.setAttribute('ui-keyup', "{'enter':'$ctrl.save()'}");
        $ctrl.formHolderItem = {};
        $ctrl.item.locationName = null;
        $ctrl.formName = 'formItem';
    }

    function getItemTemplate() {
        return ($ctrl.header ? ('<div class="header-small clearfix">'+$ctrl.header+'</div>') : '') +
            $ctrl.LCS.getErrorBlock() +
            '<form class="form-group field last" name="$ctrl.formHolderItem[$ctrl.formName]" novalidate autocomplete="off">' +
                '<input type="'+($ctrl.type?$ctrl.type:'text')+'" placeholder="'+($ctrl.placeholder ? $ctrl.placeholder : 'Location Name…')+'" ' +
            ($ctrl.fieldClass ? ('class="'+$ctrl.fieldClass+'"') :'') +
            ' name="locationName" ng-model="$ctrl.item.locationName" '+($ctrl.required==='true'?'required ':'')+'>' +
                '<div ng-show="($ctrl.formHolderItem[$ctrl.formName].locationName.$dirty || $ctrl.formHolderItem[$ctrl.formName+\'_attempted\']) && $ctrl.formHolderItem[$ctrl.formName].locationName.$error.required" class="help-inline ng-hide" style="top: 30px;">Location name is required</div>' +
                '<button class="small-blue-btn btn primary with-margin-left" type="submit" ng-click="$ctrl.save($event)" ng-disabled="$ctrl.isUpdating">' +
            '<div class="col20 pull-left" ng-show="$ctrl.isUpdating===true"><span class="sbf smaller loadingicon animate-spin"></span></div>' +
            '<div>Save</div></button>' +
            '</button>' +
            '</form>';
    }

    function onLoaded() {
        $ctrl.LCS.timeout(function (){
            $ctrl.element.querySelector('input').focus();
        }, 105);
    }

    function save(e){
        $ctrl.preventDefault(e);
        $ctrl.error = null;
        if($ctrl.list && $ctrl.list.length > 0 && _.find($ctrl.list, {name: $ctrl.item.locationName})){
            $ctrl.error = 'A location with this name already exists in Locations';
        }

        if ($ctrl.error || $ctrl.isUpdating) {
            return false;
        }
        $ctrl.formHolderItem[$ctrl.formName+'_attempted'] = true;
        if (!$ctrl.formHolderItem[$ctrl.formName] || !$ctrl.formHolderItem[$ctrl.formName].$valid) {
            return;
        }

        $ctrl.isUpdating = true;

        var item = {};
        _.each($ctrl.service.getDefaultFields(), function(prop){
            item[prop] = $ctrl.item[prop];
        });
        item.name = $ctrl.item.locationName;
        item.order = getNewItemOrder($ctrl.list);

        $ctrl.service.insert($ctrl.service.convertResource(item), onsuccess, onerror);

        function onsuccess(result) {
            $ctrl.isUpdating = false;
            var item = result.item;
            if(item){
                $ctrl.list.push(item);
                $ctrl.scriptLoadingService.modify($ctrl.preLoadingTableName, item, $ctrl.scriptLoadingService.Ops.Create);
                $ctrl.onUpdate({result: {item: item, $event: e}});
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.locations.Create.success', 'success');
               $ctrl.broadcastRoot('CLOSE_POPOVER_' +
                   $ctrl.LCS.findClosestParent(e.currentTarget, '.add-locations-popup').id
               );
            }else{
                onError(null, 'Create');
            }
        }

        function onerror (error) {
            $ctrl.isUpdating = false;
            onError(error, 'Create');
        }

        function onError(error, type) {
            $ctrl.isUpdating = false;
            $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.'+$ctrl.preLoadingTableName+'.'+type+'.error');
        }
    }
    function getNewItemOrder(list){
        return (list && list.length > 0 ? _.max(list, function (item) {
            return item.order;
        }).order : -1) + 1;
    }

}

