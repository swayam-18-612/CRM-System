angular.module('product.preLoading.contacts.group.init.service', [
    'product.preLoading.init.group.service',
    'product.preLoading.contacts.service',
    'product.preLoading.contactLists.service',
    'product.preLoading.products.service',

    'product.preLoading.positions.service',
    'product.preLoading.departments.service'
])
 .service('ContactsGroupInitLoadingService', ContactsGroupInitLoadingService);
ContactsGroupInitLoadingService.$inject = ['InitGroupLoadingService', 'ProductsLoadingService', 'ContactListsLoadingService','ContactsLoadingService', 'DepartmentsLoadingService','PositionsLoadingService'];
function ContactsGroupInitLoadingService(InitGroupLoadingService, Products, ContactLists, Contacts, Positions, Departments) {
    return function (isInitType, TblOthers, TblTypesOther) {
        var Tbl = {}, TblTypes = {};

        _.each([Products, ContactLists, Contacts, Positions, Departments], function (table){
            var name = table.name;
            var withoutLoad = name === 'Products';
            TblTypes[name] = table.tableType;
            Tbl[TblTypes[name]] = {loadingService: table, withoutLoad: withoutLoad};
        });

        if (TblOthers) {
            Tbl = _.extend(Tbl, TblOthers);
        }

        if (TblTypesOther) {
            TblTypes = _.extend(TblTypes, TblTypesOther);
        }

        var Resource = new InitGroupLoadingService(Tbl, isInitType, null, TblTypes);

        Resource.prototype.loadProducts = function (next) {
            var _this = this;
            if (!Resource.isProductsLoaded && !Resource.isProductsLoading) {
                Resource.isProductsLoading = true;
                _this.loadAndInitTable(_this.TblTypes.Products, null, null, c, 'getAll');
            } else {
                next1();
            }

            function c() {
                Resource.isProductsLoaded = true;
                Resource.isProductsLoading = false;
                return next1();
            }

            function next1(){
                next(_this.getObjectList(_this.TblTypes.Products, function (item) {
                    return item.active === true;
                }));
            }
        };

        function getQS(item, s, contactListId, withList, isInList) {
            s = s ? s.toLowerCase() : null;
            var exists = item.email && item.email.toLowerCase().indexOf(s) !== -1 ||
                item.name && item.name.toLowerCase().indexOf(s) !== -1;

            if (exists && withList) {
                var list = item.contactLists ? item.contactLists['c_' + contactListId] : null;
                exists = (list !== null && list !== undefined) === isInList;
            }

            return exists;
        }

        Resource.prototype.searchContactsNotInList = function (data, onSuccess) {
            var _this = this;
            return searchContactsNotInListForContacts(_this, data, onSuccess);
        }

        function searchContactsNotInListForContacts(_this, data, onSuccess) {
            var results = [];
//if is in general lists -> get from lists that are

            //get all contacts that are not in list
            var cast = _this.getList(_this.TblTypes.Contacts, function (item) {
                return getQS(item, data.q, data.contactListId, true, false);
            });

            if (cast && cast.length > 0) {
                _.each(cast, function (item) {
                    results.push({
                        _id: item._id,
                        name: item.name,
                        logo: item.profilePictureURL,
                        logoId: item.profilePictureURLId,
                        email: item.email,
                        type: 'contact',
                    });
                });
            }

            /* if (results >= 5) {
                 return done(null, results);
             }*/

            //get all contact lists that match the search for their name
            var current = _this.getById(_this.TblTypes.ContactLists, function (item) {
                return item._id === data.contactListId;
            });

            var contactLists = _this.getList(_this.TblTypes.ContactLists, function (item) {
                return item._id !== data.contactListId && //not current list
                    (item.type === 5 || item.type === 6) && !item.isPredef &&
                    (data.productId ? true : (item.productId === null || item.productId === undefined)) &&
                    getQS(item, data.q, data.contactListId, false, false);
            });

            if (contactLists && contactLists.length > 0) {
                _.each(contactLists, function (item) {
                    results.push({
                        _id: item._id,
                        name: item.type === 6 ? item.name : item.name.replace('Project ', ''),
                        logo: item.logo,
                        type: item.type === 6 ? 'list' : 'project',
                        productId: item.productId
                    });
                });
            }

            onSuccess(results);
        }

        Resource.prototype.searchProjectContacts = function (data, onSuccess) {
            var _this = this,
                results = [];
            var product = data.productId ? _this.getById(_this.TblTypes.Products, data.productId) : null;
            if (product) {
                var cast = _this.getList(_this.TblTypes.Contacts, function (item) {
                    return getQS(item, data.q, product.contactListId, true, true);
                });
                if (cast && cast.length > 0) {
                    _.each(cast, function (item) {
                        results.push({
                            _id: item._id,
                            name: item.name,
                            logo: item.profilePictureURL,
                            logoId: item.profilePictureURLId,
                            email: item.email
                        });
                    });
                }
            }

            onSuccess(results);
        };

        //todo: see if still needed
        Resource.prototype.getPositions = function (query, order, populate) {
            var _this = this;
            return _this.getObjectList(_this.TblTypes.Positions, query, order, populate);
        };

        Resource.prototype.getDepartments = function (query, order, populate) {
            var _this = this;
            return _this.getObjectList(_this.TblTypes.Departments, query, order, populate);
        };

        return Resource;
    }
}

