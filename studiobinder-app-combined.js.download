angular.module('sb.fields.popovers.assignCollaboratorsInit.controller.service',[
    'user.share.collaborators.service'
])
.service('SBAssignCollaboratorsInitCtrlService', SBAssignCollaboratorsInitCtrlService);
SBAssignCollaboratorsInitCtrlService.$inject =['SBDrpNonClosedCtrlService', 'RouteCollaboratorsService', 'SBFieldTypesService', 'BlocksSetupService'];

function SBAssignCollaboratorsInitCtrlService(SBDrpNonClosedCtrlService, RouteCollaboratorsService, SBFieldTypesService, BlocksSetupService) {
    return function ($ctrl, $element, $attrs) {

        console.log('SBAssignCollaboratorsInitCtrlService');

        var withoutTemplateScope = false;

        $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
        $ctrl.BlocksSetupService = BlocksSetupService;

        $ctrl.$element = $element;
        $ctrl.element = $ctrl.$element[0];

        if (!$ctrl.propType) {
            $ctrl.propType = SBFieldTypesService.PropTypes.Collaborators;
        }

        $ctrl.changedFieldsOther = ['uId'];

        $ctrl.generateDrpMenuContent = generateDrpMenuContent;
        $ctrl.initDrp = initDrp;
        $ctrl.onChangesOther = onChangesOther;
        $ctrl.preventDefault = preventDefault;

        $ctrl = new SBDrpNonClosedCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

        return $ctrl;

        function initDrp() {
            if ($ctrl.canEdit) {
                $ctrl.col.canEdit = true;
            }

            var withoutClose = $ctrl.element.getAttribute('without-close');
            /* if(withoutClose === 'true' || withoutClose === true) {
                 $ctrl.withoutClose = true;
             }*/

            if (!$ctrl.element.getAttribute('parent-container')) {
                $ctrl.element.setAttribute('parent-container', 'true');
            }
            $ctrl.element.setAttribute('c-class-attr', 'without-underline without-arrow');
            $ctrl.withParentDropdownMenu = $ctrl.withParentDropdownMenu === true || $ctrl.withParentDropdownMenu === 'true';
            $ctrl.team = $ctrl.RouteCollaboratorsService.getProjectTeam($ctrl.CPS.product);

            if ($ctrl.initDrpOther) {
                $ctrl.initDrpOther();
            }

            addWatcher();

            //when collaborators from the parent get updated propagate : {uId: uId, c:collaborators}
            $ctrl.removeWatcher($ctrl.uPIdRootWatcher);
            $ctrl.uPIdRootWatcher = $ctrl.addRootWatcher('UPDATE_PARENT_COLLABORATORS', onUpdateParentCollaborators);
        }

        function getUserCollabs() {
            return $ctrl.RouteCollaboratorsService.getUserCollaborators($ctrl.uId, $ctrl.todoPage);
        }

        function addWatcher() {
            //pass todoPageId for avscript
            $ctrl.todoPage = $ctrl.todoPageId ? $ctrl.RouteCollaboratorsService.BlocksSetupService.getTodoPageById($ctrl.todoPageId) : $ctrl.RouteCollaboratorsService.todoPage;
            $ctrl.uIdType = $ctrl.RouteCollaboratorsService.getUIdType($ctrl.todoPage);
            $ctrl.col.uId = $ctrl.uId ? $ctrl.uId : null;
            $ctrl.isDoc = $ctrl.todoPage && $ctrl.todoPage[$ctrl.uIdType] && !$ctrl.todoPage.hasTree &&
                $ctrl.list && $ctrl.list._id === $ctrl.uId && !$ctrl.list.isFolder;
            //todo double check this
            $ctrl.userCollabs = getUserCollabs();

            if ($ctrl.uId) {
                if ($ctrl.isDoc) {
                    $ctrl.shareListType = $ctrl.itemTitle;
                    $ctrl.shareListName = $ctrl.list.name;
                } else {
                    var info = $ctrl.RouteCollaboratorsService.getShareListInfo($ctrl.uId, $ctrl.compOptions, $ctrl.isDoc ? $ctrl.list : null),
                        shareList = info ? info.shareList : null;
                    if (shareList) {
                        $ctrl.shareListType = shareList.type;
                        $ctrl.shareListName = shareList.name;
                    }
                }
                $ctrl.removeWatcher($ctrl.uIdRootWatcher);
                $ctrl.uIdRootWatcher = $ctrl.addRootWatcher('UPDATE_ITEM_COLLABORATORS_' + $ctrl.uId, onUpdateItemCollaborators);
            }
        }

        function onChangesOther(changes) {
            for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
                var field = $ctrl.changedFields[i];
                if (field === 'uId') {
                    var change = changes[field];
                    if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                        addWatcher();
                        break;
                    }
                }
            }
        }

        function onUpdateItemCollaborators(collaborators) {
            console.log('sbAssignCollaborators.UPDATE_ITEM_COLLABORATORS');
            reload();
        }

        function onUpdateParentCollaborators(result) {
            console.log('sbAssignCollaborators.UPDATE_PARENT_COLLABORATORS');
            reload();
        }

        function reload() {
            $ctrl.userCollabs = getUserCollabs();
            $ctrl.onRepeatFieldLoaded();
        }

        function generateDrpMenuContent() {
            var l = $ctrl.team.length;
            if ($ctrl.userCollabs && $ctrl.userCollabs.length) {
                l += $ctrl.userCollabs.length;
            }
            return {
                $ctrl: _.extend({
                    team: $ctrl.team,
                    userCollabs: $ctrl.userCollabs,
                    onSelect: $ctrl.onSelect
                }, $ctrl.onAction ? {
                    onAction: $ctrl.onAction
                } : null),
                template: ($ctrl.shareListType ? ('share-list-type="' + $ctrl.shareListType + '" ') : '') +
                    ($ctrl.shareListName ? ('share-list-name="' + $ctrl.shareListName + '" ') : '') +
                    'drp-class="' + ($ctrl.showOnlyCounter ? 'toleftless' : (l > $ctrl.maxCount ? 'toleft' : '')) + '" ' +
                    "with-share='::" + canShare() + "' " +
                    "with-team='::" + $ctrl.CPS.isOwner + "' " +

                    "team='::$ctrl.team' " +
                    "user-collabs='::$ctrl.userCollabs' " +

                    "on-select='$ctrl.onSelect(result)' " +
                    ($ctrl.onAction ? ("on-action='::$ctrl.onAction(type)' ") : '')
            };
        }

        function preventDefault(e) {
            console.log('preventDefault');
            $ctrl.LCS.preventDefault(e);
        }
    }
}

angular.module('sb.fields.popovers.assignCollaboratorsMenuInit.controller.service',[
])
.service('SBAssignCollaboratorsMenuInitCtrlService', SBAssignCollaboratorsMenuInitCtrlService);
SBAssignCollaboratorsMenuInitCtrlService.$inject =['TemplateCompileCompCtrlService', 'SBFieldMethods'];

function SBAssignCollaboratorsMenuInitCtrlService(TemplateCompileCompCtrlService, SBFieldMethods) {
    return function ($ctrl, $element){

        var withoutTemplateScope = false;

        $ctrl.SBFieldMethods = SBFieldMethods;

        $ctrl.preInit = preInit;
        $ctrl.getItemTemplate = getItemTemplate;
        $ctrl.onDestroy = onDestroy;
        $ctrl.onLoaded = onLoaded;
        $ctrl.loadlist = loadlist;

        $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

        return $ctrl;

        function preInit() {
            $ctrl.liShare = 'liShare';
            $ctrl.liTeam = 'liTeam';
            $ctrl.teamCount = ($ctrl.team ? $ctrl.team.length : 0);
            $ctrl.collabCount = ($ctrl.userCollabs ? _.filter($ctrl.userCollabs, function (el) {
                if (el.isGeneral) {
                    $ctrl.hasGeneralLink = true;
                }
                return !el.isGeneral;
            }).length : 0);
            $ctrl.membersCount =  $ctrl.collabCount + $ctrl.teamCount;
        }

        function onDestroy() {
            if($ctrl.bind) {
                $ctrl.bind(false);
            }
        }

        function onLoaded() {
            if($ctrl.bind) {
                $ctrl.bind(true);
            }
        }

        function getItemTemplate() {
            return '<div class="dropdown-menu selectabledropdown addteammate team' + $ctrl.membersCount + ' ' + ($ctrl.drpClass ? $ctrl.drpClass : '') + '">' +
                '<div class="show-scrollbar-on-hover" style="padding-right: 11px">' +
                '<div class="fancy-scrollbar vertical" style="max-height: 438px;padding-right: 17px;">' +
                $ctrl.getInnerContent() +
                '</div>' +
                '</div>' +
                '</div>';
        }

        function loadlist(isCollabs) {
            var name = isCollabs ? 'userCollabs' : 'team',
                list = $ctrl[name];

            if(!list){return '';}

            if(isCollabs && !(list.length - ($ctrl.hasGeneralLink ? 1 : 0))){return '';}

            return '<ul style="max-height:100%">' +
                list.map(function (item, i) {
                    return  !(isCollabs&&item.isGeneral) ?(
                        '<li class="ui-select-choices-group" '+ ((isCollabs && (i === 0)) || (!isCollabs && (i === (list.length - 1)))?'style="border-color:transparent"':'') + '>' +
                            '<div class="select-choices-row-inner">' +
                                '<div class="col40 vtop">' + getImage(item, "small34") + '</div>' +
                                '<div class="with-padding-left">' +
                                    (item.name ? ('<div class="name">'+item.name+'</div>') : '') +
                                    '<div class="email">'+(isCollabs?('Can ' + (item.permission===1?'View':(item.permission===2?'Comment':'Edit'))): getMemberTypeText(item))+'</div>' +
                                '</div>' +
                            '</div>' +
                        '</li>'
                        ) : '';
                }).join('') +
                '</ul>';
        }

        function getImage(item, cls) {
            return $ctrl.security.getImage(item, cls, 'profilePictureURL', 50);
        }

        function getMemberTypeText(item) {
            var el = _.find($ctrl.SBFieldMethods.MemberTypes, {value: item.memberType});
            return el ? el.text : '';
        }
    }
}

angular.module('fields.popovers.simpleSelector.controller.service',[
    'product.selectors.searchonlist.controller.service',
    'sb.fields.selectize.service'
])
.service('SBSimpleSelectorCtrlService',SBSimpleSelectorCtrlService);
SBSimpleSelectorCtrlService.$inject =['CompInitCtrlService', 'SearchOnListCtrlService', 'SBSelectorInitCtrlService'];
function SBSimpleSelectorCtrlService(CompInitCtrlService, SearchOnListCtrlService, SBSelectorInitCtrlService) {
    console.log('SBSimpleSelectorCtrlService');
    return function ($ctrl, $element) {
        var initList = [];
        $ctrl.changedFields = ['value'];

        $ctrl.scrollableContainerSelector = '.selected-projects .listitems-selector';
        if (!$ctrl.imageField) {
            $ctrl.imageField = 'logo';
        }

        $ctrl.getItemTemplate = getItemTemplate;
        $ctrl.$onChanges = $onChanges;

        if(!$ctrl.compLoaded) {
            $ctrl = new CompInitCtrlService($ctrl);
        }

        $ctrl.setLoader = setLoader;
        $ctrl.onSBFieldInit = onSBFieldInit;
        $ctrl.assignElementsInit = assignElementsInit;
        $ctrl.getOrder = getOrder;

        if(!$ctrl.getList) {
            $ctrl.getList = getList;
        }

        $ctrl.sendUpdate = sendUpdate;

        $ctrl.getTitleSingular = getTitleSingular;
        $ctrl.updateItem = updateItem;
        $ctrl.$onInit = $onInit;
        $ctrl.$onDestroy = $onDestroy;
        $ctrl.hasField = hasField;
        $ctrl.processSearchOther = processSearchOther;

        $ctrl.getSmallHeader = getSmallHeader;

        if(!$ctrl.processEmpty) {
            $ctrl.processEmpty = processEmpty;
        }

        return $ctrl;

        function $onInit() {
            //so that the object in parent doesnt get updated

            $ctrl = new SearchOnListCtrlService($ctrl);

            $ctrl.value = [].concat($ctrl.value);
            $ctrl.placeholder = 'Search ' + $ctrl.itemTitle.toLowerCase() + ' by name…';

            $ctrl.assignElementsInit();
            setItems();
        }

        function setItems(element, get) {
            var el = element ? element : $ctrl.element,
            m = get ? get : getItemTemplate;
            if ($ctrl.withoutTemplateCompile) {
                $ctrl.LCS.appendChildFragment(el, m());
                onTemplateLoaded(get === true);
            } else {
                reloadTemplate(angular.element(el), m);
            }
        }

        function reloadTemplate(element, getItemTemplate) {
            if (!$ctrl.templateCompile) {
                $ctrl.templateCompile = new TemplateCompileService(element, getItemTemplate, $ctrl, withoutTemplateScope);
            }
            $ctrl.templateCompile.withoutTimeout = $ctrl.withoutTemplateCompile;
            $ctrl.templateCompile.loadTemplate(onLoaded);
        }

        function onLoaded() {
            onTemplateLoaded(false);
        }

        function onTemplateLoaded(isPartial) {
            if (!isPartial) {
                bindDefault(true);
            }

            bindItemClicks($ctrl.element, false);
            bindItemClicks($ctrl.element, true);

            $ctrl.setFocusOnSearch(100);
        }

        function getMemberById(id) {
            return _.find($ctrl.initList, function (item) {
                return item._id === id
            });
        }

        function getItemTemplate() {
            return $ctrl.hasCustomTemplate ? getItemTemplateContent() : (getItemTemplateContent());
        }

        function getItemTemplateContent() {
        return '<div class="dropdown-menu selector-dropdown with-overflow selectabledropdown addteammate cast-popup assign-elements-drp ' +($ctrl.drpClass ? $ctrl.drpClass : '') + '">' +
                    '<div>' +
                        '<div class="search-field form-group sbfgroup field last withSearch margin-quarter no-indent ' +
                            ($ctrl.initList.length > 0 ? '' : 'sb-hide ') +
                            ($ctrl.pageClass||'')+
                        '">' +
                            $ctrl.LCS.getISBDiv('search') +
                            '<input id="' + $ctrl.searchInputCls + '" type="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" class="form-control search full-length without-underline ' +
                            ($ctrl.withUppercase ? 'uppercase ' : '') +
                            ($ctrl.pageClass||'')+
                            '" placeholder="' + $ctrl.placeholder + '">' +
                            '<div class="cancel-search"><a class="' + $ctrl.btnClearSearchCls + ' no-transition sb-hide">' + $ctrl.LCS.getISBDiv('cancel', null, 'with-primary-hover') + '</a></div>' +
                        '</div>' +
                        '<div class="' + ($ctrl.withScroll ? 'selected-items-dropdown ' : '') + 'margin-bottom-quarter">' +
                            ($ctrl.initList.length > 0 ? getItemsList() : $ctrl.getEmptyList()) +
                        '</div>' +
                    '</div>' +
                '</div>';
        }

        function getItemsList() {
            resetLists();

    return $ctrl.withScroll ? ('<div class="show-scrollbar-on-hover">' +
                '<div class="fancy-scrollbar vertical padding-right-0">' +
                    '<div>' + get() + '</div>' +
                '</div>' +
            '</div>') : get();

            function get(){
                return '<div class="select-choices with-teams display-block without-hover">' +
                    processLists(false) +
                    '</div>'
                // ($ctrl.search ? getEmptySearch():;
            }
        }

        function processLists(isReload){
            var m = isReload ? reloadList : loadlist;
            return  m('members', true) +
                m($ctrl.listBottomName, false);
                //(!$ctrl.canEdit && $ctrl.withInlineBlock ? '' :  m($ctrl.listBottomName, false));
        }

        function resetLists() {
            $ctrl.members = _.sortBy($ctrl.value.length ? _.filter($ctrl.value.map(getMemberById), function(item){return item !== null && item !== undefined;})  : [], 'order');

            $ctrl[$ctrl.listBottomName] = _.sortBy(_.filter($ctrl.initList, function (item) {
                return !$ctrl.value || $ctrl.value.indexOf(item._id) === -1;
            }), 'order');
        }


        function getSmallHeader(type, withRemove) {
            return withRemove ? 'Assigned to Scene' : 'Unassigned';
        }

        function loadlist(type, withRemove) {
            var list = $ctrl[type];
            return '<div class="' + getBlockName(type) + ' ' + (list && list.length > 0 ? '' : 'sb-hide') + '">' +
                 ($ctrl.getSmallHeader ? ('<div class="header-small clearfix spacing-half-top with-side-padding">' +
                     $ctrl.getSmallHeader(type, withRemove) +
                 '</div>') : '') +
                '<ul>' +
                    getListContent(list, withRemove) +
                '</ul>' +
            '</div>';
        }

        function getListContent(list, withRemove) {
            return list ? _.map(list, function (item){
                return getListItem(item, withRemove);
            }).join('') : '';
        }

        function getListItem(item, checked) {
            if (!item) {
                return '';
            }
        return '<li class="' + $ctrl.itemClass + ' ui-select-choices-group with-cursor" data-id="' + item._id + '">' +
                    '<a class="select-choices-row-inner table-div fixed-layout">' +
                        '<div class="col20">' +
                            '<div class="custom-checkbox '+($ctrl.pageClass||'')+'"><label><input type="checkbox" ' + (checked ? 'checked="checked"' : '') + '><span></span></label></div>' +
                        '</div>' +

            ($ctrl.icon ? ('<div class="col30 centered">' + $ctrl.LCS.getISBDiv($ctrl.icon, $ctrl.iconLevel, 'gray') + '</div>') : '') +

     ($ctrl.withImage ? ('<div class="col45 position-relative">' +
                            getImage(item, "smaller") +
                            (item.currentId ? ('<div class="numbered-char on-top">' + item.currentId + '</div>') : '') +
                        '</div>')  : '') +

                        '<div>' +
                            '<div class="' + ($ctrl.withEllipsis ? 'with-ellipsis' : '') + ' name ' +  ($ctrl.withUppercase ? 'uppercase' : '') + '">' + (item.name ? item.name : '–') + '</div>' +
                        //not confirmed
                        // (item.memberType!== $ctrl.security.MemberTypes.Owner && item.status !== 2 ? '<div class="smaller-orange">Invited and pending…</div>' : '') +
                        '</div>' +
                    '</a>' +
                '</li>';
        }

        function bindItemClicks(parent, isBind) {
            if (!parent) {
                console.log('parent for bindItemClicks is null on isbind = ' + isBind);
                return;
            }
            bindForm(parent, isBind);
        }

        function bindForm(parent, isBind) {
            $ctrl.LCS.bindElementsClick(isBind, parent.querySelectorAll('.' + $ctrl.itemClass), updateItem);
        }

        function getImage(item, cls) {
            return $ctrl.security.getImage($ctrl.isElement ? item.element : item, cls, $ctrl.imageField, 100, {
                withSquareImg: $ctrl.withSquareImg
            });
        }

        function processEmpty(item) {
            var icon = $ctrl.hideIconCircle ? 'search' : $ctrl.icon,
                iconLevel = $ctrl.iconLevel ? $ctrl.iconLevel : 2,
                cls = $ctrl.hideIconCircle ? 'text-center margin-botttom20' : ('centered circled-svg-colored small76 ' + ($ctrl.pageClass ? $ctrl.pageClass : ''));

    return '<div class="no-project withpopover centering spacing-half ' + (item.isSearch ? 'blockempty' : '') + '">' +
                '<div class="' + cls+ '">' +
                    $ctrl.LCS.getISBDiv(icon, iconLevel, $ctrl.hideIconCircle ? 'sbf40 gray' : '') +
                '</div>' +

                (item.title ? ('<div class="text-center h3">' + item.title + '</div>') : '') +
                (item.desc ? ('<p class="text-center desc">' + item.desc + '</p>') : '') +

            '</div>';
        }

        function getTitleSingular() {
            return ($ctrl.itemTitle.indexOf('s') === ($ctrl.itemTitle.length - 1)) ? $ctrl.itemTitle.substring(0, $ctrl.itemTitle.length - 1) : $ctrl.itemTitle;
        }

        function hasField(field) {
            return $ctrl.fields.indexOf(field) !== -1
        }

        function bindDefault(isBind) {
            $ctrl.bindSearch(isBind);
        }

        function processSearchOther(exists){
            $ctrl.onSearch({result: {el: $ctrl.element, search: $ctrl.search, isEmpty: !exists}});
        }


        function getWrapperByType(type){
            var name = getBlockName(type);
            if(!$ctrl[name]){
                var el = $ctrl.element.querySelector('.' + name);
                if(el){
                    $ctrl[name] = el.querySelector('ul');
                }
            }
            return $ctrl[name];
        }

        function getBlockName(type){
            return 'block' + type;
        }

        function updateItem(e) {
            console.log('updateItem');
            var el = e.currentTarget,
                id = el.getAttribute('data-id'),
                input = el.querySelector('input'),
                isToRemove = input.getAttribute('checked') === 'checked';
            $ctrl.preventDefault(e);
            var index = $ctrl.value ? $ctrl.value.indexOf(id) : -1;
            if (isToRemove) {
                if (index !== -1) {
                    $ctrl.value.splice(index, 1);
                }
                input.removeAttribute('checked');
            } else {
                if (index === -1) {
                    $ctrl.value.push(id);
                }
                input.setAttribute('checked', 'checked');
            }
            $ctrl.sendUpdate(e, false);
        }

        function $onDestroy() {
            bindDefault(false);
            bindForm($ctrl.element, false);
            if ($ctrl.templateCompile) {
                $ctrl.templateCompile.destroyNewScope();
            }
            $ctrl.removeWatchers();
        }

        function setLoader(isUpdating) {
            if(!isUpdating) {
                $ctrl.isUpdating = isUpdating;
            }
        }

        function assignElementsInit() {
            $ctrl.objectType = $ctrl.elemtype;
            initList = $ctrl.getList();
            $ctrl.initList = initList;

            if($ctrl.initOthers){
                $ctrl.initOthers ();
            }

            //$attrs
            //$ctrl.isSOpen = true; //to prevent opening the popper
            $ctrl.withoutPopper = true; //to prevent opening the popper
            $ctrl = new SBSelectorInitCtrlService($ctrl, $ctrl.service, $element);

        }

        function getOrder(elements) {
            return elements && elements.length > 0 ? _.max(elements, function (item) {
                return item.order;
            }).order + 1 : 1;
        }

        function getList() {
            return $ctrl.list;
        }

        function onSBFieldInit() {
            if (!$ctrl.value && $ctrl.multipleSelection) {
                $ctrl.value = [];
            }
            $ctrl.prevValue = angular.copy($ctrl.value);

            $ctrl.$element = $element;
            $ctrl.element = $ctrl.$element[0];
            $ctrl.attrs = {};

        }

        function sendUpdate(e, withClose, initResult) {
            var result = {
                e: e,
                value: angular.copy($ctrl.value)
            };
            result.initResult = initResult;
            result.withClose = withClose;
            $ctrl.onSelect({result: result});
        }

        function $onChanges(changes) {
            if (!changes) {
                return;
            }
            console.log('SBSimpleSelectorCtrlService.$onChanges');
            console.log(changes);
            for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
                var field = $ctrl.changedFields[i],
                    change = changes[field];
                if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                    if($ctrl.onChangesOther){
                        $ctrl.onChangesOther(changes);
                    }
                    if(field === 'value') {
                       // updateValue(change.currentValue);
                        setPreviousValue();
                        if(!$ctrl.withoutSeparatedLists) {
                            reloadElements();
                        }else{
                            updateChecks();
                        }
                    }
                    break;
                }
            }
        }

        function setPreviousValue(){
            $ctrl.previousValue = $ctrl.value ? (typeof($ctrl.value) === 'object' ? _.extend({}, _.clone($ctrl.value)) : angular.copy($ctrl.value)) : $ctrl.value;
        }

        function updateChecks() {
            _.each($ctrl.element.querySelectorAll('.select-choices .' + $ctrl.itemClass), function (el) {
                var id = el.getAttribute('data-id'),
                    input = el.querySelector('input');
                if ($ctrl.value.indexOf(id) !== -1) {
                    input.setAttribute('checked', 'checked');
                } else {
                    input.removeAttribute('checked');
                }
            });
        }

        function reloadElements() {
            resetLists();
            if($ctrl.isEmptyListOn){
                $ctrl.LCS.removeClass($ctrl.element.querySelector('.search-field'), 'sb-hide');
                var el = $ctrl.element.querySelector('.selected-items-dropdown');
                $ctrl.LCS.emptyElement(el);

                setItems(el, getItemsList);
                $ctrl.isEmptyListOn = false;
            }else{
                processLists(true)
            }
        }

        function reloadList(type, withRemove) {
            var list = $ctrl[type],
                cls =  getBlockName(type);
            if (!$ctrl[cls]) {
                $ctrl[cls] = $ctrl.element.querySelector('.' + cls);
            }

            if ($ctrl[cls]) {
                $ctrl.LCS[list.length > 0 ? 'removeClass' : 'addClass']($ctrl[cls], 'sb-hide');
            }

            var wrapper = getWrapperByType(type);
            if (wrapper) {
                bindItemClicks(wrapper, false);
                $ctrl.LCS.appendChildFragment(wrapper, getListContent(withRemove), true);
                bindItemClicks(wrapper, true);
            }
        }
    }
}

angular.module('product.selectors.searchonlist.controller.service', [
])
.service('SearchOnListCtrlService', SearchOnListCtrlService);
function SearchOnListCtrlService() {
    return function ($ctrl) {

        if (!$ctrl.searchFields) {
            $ctrl.searchFields = ['name'];
        }

        $ctrl.btnClearSearchCls = 'clear-search';
        $ctrl.searchInputCls = 'autosearch-field';

        if(!$ctrl.listBottomName) {
            $ctrl.listBottomName = 'unselected';
        }

        if(!$ctrl.itemClass){
            $ctrl.itemClass = 'selectrow';
        }

        $ctrl.setFocusOnSearch = setFocus;
        $ctrl.bindSearch = bindSearch;

        if (!$ctrl.getSearchContent) {
            $ctrl.getSearchContent = getSearchContent;
        }

        $ctrl.getEmptyList = getEmptyList;
        $ctrl.getEmptySearch = getEmptySearch;

        if (!$ctrl.getCompareItem) {
            $ctrl.getCompareItem = getCompareItem;
        }

        if(!$ctrl.processEmpty) {
            $ctrl.processEmpty = processEmpty;
        }

        return $ctrl;

        function getCompareItem(item) {
            return item;
        }

        function getSearchContent() {
            return $ctrl.LCS.getISBDiv('search') +
                '<input id="' + $ctrl.searchInputCls + '" type="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" class="form-control search full-length without-underline ' + ($ctrl.withUppercase ? 'uppercase' : '') + '" placeholder="' +
                ($ctrl.getSearchPlaceholder ? $ctrl.getSearchPlaceholder() : '') + '">' +
                '<div class="cancel-search"><a class="' + $ctrl.btnClearSearchCls + ' no-transition sb-hide">' + $ctrl.LCS.getISBDiv('cancel', null, 'with-primary-hover') + '</a></div>';
        }

        function bindSearch(isBind) {
            if (!$ctrl.searchInput) {
                $ctrl.searchInput = $ctrl.element.querySelector('#' + $ctrl.searchInputCls);
            }
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.searchInput, onSearch, null, 'blur keyup paste');

            if (isBind && !$ctrl.btnClearSearch) {
                $ctrl.btnClearSearch = $ctrl.element.querySelector('.' + $ctrl.btnClearSearchCls);
            }
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnClearSearch, clearSearch);
        }

        function onSearch(e) {
            console.log('search');
            if (e.type === 'paste') {
                processSearch();
                return;
            }
            switch (e.which) {
                case 13: //enter
                    $ctrl.preventDefault(e);
                    processSearch();
                    break;
                case 27: //esc
                    $ctrl.preventDefault(e);
                    clearSearch(e);
                    break;
                default:
                    processSearch();
                    e.stopPropagation();
                    break;
            }
        }

        function clearSearch(e) {
            $ctrl.preventDefault(e);
            $ctrl.searchInput.value = null;
            processSearch();
            setFocus();
        }


        function setFocus(ms) {
            console.log('setFocus');
            ms ? $ctrl.LCS.timeout(set, ms) : set();

            function set() {
                if (!$ctrl.searchInput) {
                    $ctrl.searchInput = $ctrl.element.querySelector('#' + +$ctrl.searchInputCls);
                }
                if ($ctrl.searchInput) {
                    $ctrl.searchInput.focus();
                }
            }
        }

        function processSearch() {
            var search = $ctrl.searchInput.value;
            if (search === '' || search === null) {
                search = undefined;
            } else {
                search = search.trim().toUpperCase();
            }

            var isSame = !($ctrl.search !== search);
            if (!isSame) {
                $ctrl.search = search;
            }

            if (!$ctrl.btnClearSearch) {
                $ctrl.btnClearSearch = $ctrl.element.querySelector('.' + $ctrl.btnClearSearchCls);
            }
            if ($ctrl.btnClearSearch) {
                $ctrl.LCS[$ctrl.search ? 'removeClass' : 'addClass']($ctrl.btnClearSearch, 'sb-hide');
            }

            var exists = ((processList(true) + processList(false))) > 0;
            var selectChoicesEl = $ctrl.element.querySelector('.select-choices');
            $ctrl.LCS[exists ? 'removeClass' : 'addClass'](selectChoicesEl, 'sb-hide');
            var parent = selectChoicesEl.parentNode,
                emptyBlock = parent.querySelector('.blockempty');
            if (!exists) {
                if (!emptyBlock) {
                    emptyBlock = $ctrl.LCS.createFragment(getEmptySearch());
                    parent.appendChild(emptyBlock);
                }
            }
            if (emptyBlock) {
                $ctrl.LCS[exists ? 'addClass' : 'removeClass'](emptyBlock, 'sb-hide');
            }

            if ($ctrl.processSearchOther) {
                $ctrl.processSearchOther(exists);
            }

            return isSame;

            function processList(checked) {
                var count = 0,
                    type = checked ? 'members' : $ctrl.listBottomName,
                    list = $ctrl[type],
                    blockEl = $ctrl.element.querySelector('.block' + type);

                _.filter(list, function (item) {
                    if (item) {
                        for (var i = 0; i < $ctrl.searchFields.length; i++) {
                            var n = $ctrl.getCompareItem(item)[$ctrl.searchFields[i]];
                            var show = true;
                            if (n && (!$ctrl.search || $ctrl.search && n.toUpperCase().indexOf($ctrl.search) !== -1)) {
                                count++;
                            } else {
                                show = false;
                            }
                            $ctrl.LCS[show ? 'removeClass' : 'addClass'](blockEl.querySelector('li[data-id="' + item._id + '"]'), 'sb-hide');
                        }
                    }
                });

                $ctrl.LCS[count > 0 ? 'removeClass' : 'addClass'](blockEl, 'sb-hide');
                return count;
            }
        }

        function getEmptyList() {
            $ctrl.addEmptyListBtnBind = true;
            $ctrl.isEmptyListOn = true;

            return $ctrl.processEmpty({
                title: $ctrl.emptyItemTitle,
                desc: 'No ' + $ctrl.emptyItemTitle.toLowerCase() + 's exist yet.',
                btn: 'Add ' + $ctrl.emptyItemTitle.toLowerCase()
            });
        }

        function getEmptySearch() {
            return $ctrl.processEmpty({
                isSearch: true,
                title: null,
                desc: 'No ' + $ctrl.emptyItemTitle + 's match this search.'
            });
        }

        function processEmpty(item) {
            var icon = $ctrl.hideIconCircle ? 'search' : ($ctrl.emptyIcon ? $ctrl.emptyIcon : $ctrl.icon),
                iconLevel = $ctrl.emptyIconLevel ? $ctrl.emptyIconLevel : ($ctrl.iconLevel ? $ctrl.iconLevel : 2),
                cls = $ctrl.hideIconCircle ? 'text-center margin-botttom20' : ('centered circled-svg-colored small76 page-class ' + ($ctrl.pageClass ? $ctrl.pageClass : ''));

        return '<div class="no-project withpopover centering spacing-half ' + (item.isSearch ? 'blockempty' : '') + '">' +

                '<div class="' + cls+ '">' +
                    $ctrl.LCS.getISBDiv(icon, iconLevel, $ctrl.hideIconCircle ? 'sbf40 gray' : '') +
                '</div>' +

                (item.title ? ('<div class="text-center h3">' + item.title + '</div>') : '') +
                (item.desc ? ('<p class="text-center desc">' + item.desc + '</p>') : '') +

                ($ctrl.withEmptyBtn && item.btn ? ('<div class="text-center spacing-half"><button id="btnSaveAddEmpty" class="btn primary smallbtn small-btns" type="button"> <div class="sbf1 pull-left"></div> ' + item.btn + '</button></div>') : '') +
            '</div>';
        }


    }
}


angular.module('expandableSection.controller.service', [

])
.service('ExpandableSectionService', ExpandableSectionService);
ExpandableSectionService.$inject = ['CPS', 'RootEventsService'];
function ExpandableSectionService(CPS, RootEventsService) {
    return function ($element, options) {
        var _this = this;
        if(options){
            _this = _.extend(_this, options);
        }
        _this.RootEventsService = RootEventsService;
        _this.CPS = CPS;
        _this.LCS = CPS.LCS;
        _this.$element = $element;
        _this.element = _this.$element[0];

        _this.expandItemCls =  'expitem' + (options && options.expandItemCls ? (' expitem' + options.expandItemCls) : '');
        _this.expandArrowCls = 'expandarrow';
        _this.openExpandableCls = 'openExpandable';
        _this.expandableSectionCls = 'expandable';

        _this.getExpandItemCls = getExpandItemCls;
        _this.bindExpandable = bindExpandable;
        _this.setExpandable = setExpandable;
        _this.onExpandableLoaded = onExpandableLoaded;
        _this.openExpandable = openExpandable;
        _this.toggleExpandable = toggleExpandable;
        _this.getExpandableContent = getExpandableContent;
        _this.bindElementsClickBySelector = bindElementsClickBySelector;
        _this.getIdTagById = getIdTagById;
        _this.updateQuotaInfo = updateQuotaInfo;

        if(!_this.getExpandableHeader) {
            _this.getExpandableHeader = getExpandableHeader;
        }

        return _this;

        function getId(el){
            return getIdById(el.id);
        }

        function getIdTag(el) {
            return getIdTagById(el.id);
        }

        function getIdTagById(id) {
            return 'e_' + getIdById(id) + '_inline';
        }

        function getIdById(id){
            return id.toString();
        }

        function updateQuotaInfo(quotaTypes, next) {
            if (quotaTypes) {
                _.each(quotaTypes, function (quotaType) {
                    var hasQuota = _this.CPS.hasQuotaType(quotaType);
                    if(quotaType === 'pdfBuilder') {
                        var header = _this.element.querySelector('.sidebar-header .profeature[data-quota="' + quotaType + '"]');
                        if (header) {
                            _this.LCS[!hasQuota ? 'removeClass' : 'addClass'](header, 'sb-hide');
                        }
                    } else {//advanced
                        var els = _this.element.querySelectorAll('.' + _this.expandItemCls + ' .'+_this.expandableSectionCls+'[data-quota="' + quotaType + '"]');
                        if (els && els.length>0) {
                            _this.LCS.bindElementsClick(!hasQuota, els, openProPopup);
                            _this.LCS[hasQuota ? 'removeClass' : 'addClass'](els, 'with-pro-overlay');
                        }

                        var show = showPro(quotaType);
                        els = _this.element.querySelectorAll('.profeature[data-quota="' + quotaType + '"]');
                        if (els && els.length > 0) {
                            _this.LCS[show ? 'removeClass' : 'addClass'](els, 'sb-hide');
                        }
                    }
                });
            }
            if(next) {
                next();
            }
        }

        function getExpandableContent(sections, getExpandableItem) {
            var t = '';
            _.each (sections, function (el, i){
                if(el && !el.hide) {
                    var isPro = el.quotaType && !_this.CPS.hasQuotaType(el.quotaType);
                   t += '<div id="' + getIdTag(el) + '" class="' + _this.expandItemCls + ' inline-tree-item">' +
                            '<div data-id="' + getId(el) + '" class="' + _this.openExpandableCls + ' ' +
(el.notExpandable && !_this.allExpandable ? ('notExpandable' + (_this.notExpandableMethod?' with-cursor ' : '')) : (_this.expandArrowCls + ' with-cursor sbf arrow-right-big')) +
                       ' list-edit-item with-padding-right one-line-tooltip">' +
                                '<div class="table-div fixed-layout full-width">' + _this.getExpandableHeader(el) + '</div>' +
                            '</div>' +
                            (el.notExpandable ? '' : ('<div class="' + _this.expandableSectionCls + (isPro ? (' with-pro-overlay') :'') + '" style="height: 0px;overflow:hidden"' + (el.quotaType ? (' data-quota=' + el.quotaType) : '') +
                                 (isPro ? (' data-type="openPropPopup" analytics-on analytics-action="'+(el.name?el.name:'')+'"') : '') + '><div>' + getExpandableItem(el, i) + '</div></div>')) +
                        '</div>';
                    if(!_this.openId && !_this.startCollapsed){
                        _this.openId = getId(sections[0]);
                    }
                }
            });

            return t;
        }

        function showPro(quotaType){
            return !_this.CPS.hasQuotaType(quotaType)&&
            (quotaType === 'advancedPdfBuilder' ? _this.CPS.hasQuotaType('pdfBuilder') : true);

        }

        function getExpandableHeader(el){
            return '<div class="centered">' + el.name +
                ((el.quotaType  === 'advancedPdfBuilder' || el.quotaType  === 'callsheetAdvanced' || el.quotaType  === 'callsheetTemplates') ?
                    ('<span class="with-margin-left profeature right-align ' + (showPro(el.quotaType) ? '' : ' sb-hide') + '" data-quota="' + el.quotaType + '">PRO</span>') : '') +
                '</div>';
        }

        function onExpandableLoaded(openId) {
            _this.setExpandable(openId);
            _this.bindExpandable(true);
        }

        function getExpandItemCls(){
            return '.' + _this.expandItemCls.split(' ').join('.');
        }

        function bindExpandable(isBind) {
            var cls = getExpandItemCls();
            _this.bindElementsClickBySelector(isBind,cls + ' .' + _this.openExpandableCls + ':not(.notExpandable)', open);

            if(typeof (_this.notExpandableMethod) === 'function'){
                _this.bindElementsClickBySelector(isBind,cls + ' .'+_this.openExpandableCls + '.notExpandable', _this.notExpandableMethod);
            }

            if(_this.expandableOther) {
                _.each(_this.expandableOther, function (el){
                    _this.bindElementsClickBySelector(isBind,(el.withExpandCls ? (cls + ' ') : '') + el.selector, el.method);
                });
            }

            _this.bindElementsClickBySelector(isBind,cls + ' .expandable.with-pro-overlay', openProPopup);
        }

        function openProPopup(e){
            _this.CPS.openProPopup(e, {
                compOptions: _this.compOptions,
                onSubscriptionUpdated: onSubscriptionUpdated
            });
        }

        function onSubscriptionUpdated(result){
            console.log('onSubscriptionUpdated');
            _this.RootEventsService.broadcastRoot('UPDATE_PRO_LABELS', result);
        }

        function setExpandable(openId) {
            if (openId) {
                _this.openId = openId;
            }
            processList(function (el, expandable) {
                if (_this.LCS.hasClass(el, 'active')) {
                    _this.LCS.removeClass(el, 'active');
                    collapseSection(expandable);
                } else if (_this.openId && el.id === getIdTagById(_this.openId)) {
                    _this.LCS.addClass(el, 'active');
                    expandSection(expandable);
                }
            });
        }

        function toggleExpandable(isOpen){
            _this.openId = 'all';
            processList(function (el, expandable) {
                if (_this.LCS.hasClass(el, 'active')) {
                    if (!isOpen) {
                        _this.LCS.removeClass(el, 'active');
                        collapseSection(expandable);
                    }
                } else {
                    if (isOpen) {
                        _this.LCS.addClass(el, 'active');
                        expandSection(expandable);
                    }
                }
            })
        }

        function processList(processListItem){
            var list = _this.element.querySelectorAll(getExpandItemCls());
            if(list) {
                _.each(list, function (el) {
                    var expandable = el.querySelector('.'+_this.expandableSectionCls);
                    if(expandable) {
                        processListItem(el, expandable);
                    }
                });
            }
        }

        function openExpandable(openId){
            if(openId) {
                _this.openId = openId;
                setExpandable(openId);
            }
        }

        function open(e) {
            _this.openExpandable(e.currentTarget.getAttribute('data-id'));
        }

        function collapseSection(element) {
            var sectionHeight = element.scrollHeight,
                elementTransition = element.style.transition;
            element.style.transition = '';
            requestAnimationFrame(function() {
                element.style.height = sectionHeight + 'px';
                element.style.transition = elementTransition;
                requestAnimationFrame(function() {
                    element.style.height = 0 + 'px';
                });
            });
        }

        function expandSection(element) {
            var sectionHeight = element.scrollHeight;
            element.style.height = sectionHeight + 'px';
            _this.LCS.bindElementListeners(true, element, function(e) {
                _this.LCS.bindElementListeners(false, element, arguments.callee, 'transitionend');
                element.style.height = null;
            }, 'transitionend');
        }

        function bindElementsClickBySelector(isBind, cls, ev) {
            _this.LCS.bindElementsClick(isBind, _this.element['querySelectorAll'](cls), ev);
        }
    }
}



var ZoomTypesOptions={In:1, Out:2, Reset: 3};
var ZoomsDropdown = [
    {id: 2, name:'Zoom Out', icon:'minus'},
    {id: 3, name:'Reset Zoom', icon:'zoom-actual'},
    {id: 1, name:'Zoom In', icon:'plus-1'},
];

angular.module('filters.controller.service', [
])
.service('FiltersCtrlService', FiltersCtrlService);
FiltersCtrlService.$inject = ['CompInitCtrlService'];
function FiltersCtrlService(CompInitCtrlService) {
    return function ($ctrl) {
        console.log('FiltersCtrlService');

        if (!$ctrl) {
            console.warn('parent must pass $ctrl parameter to FiltersInitController');
        }
        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl);
        }

        if ($ctrl.listTreeService && !$ctrl.filtersService) {
            $ctrl.filtersService = $ctrl.listTreeService.filtersService;
        }
        if( $ctrl.filtersService === undefined){
            console.warn('parent must pass $ctrl.filtersService parameter to FiltersInitController');
        }

        if ($ctrl.elemType === undefined) {
            console.warn('parent must pass $ctrl.elemType parameter to FiltersInitController');
        }
        if (!$ctrl.currentZoomedTable) {
            $ctrl.currentZoomedTable = '.tree-node .sb-scrolling-monitor';
        }
        $ctrl.Settings = $ctrl.filtersService ? $ctrl.filtersService.Settings : {};

        $ctrl.MoreFilters = {};
        //view events
        $ctrl.ViewModes = $ctrl.filtersService.ViewModes;


        $ctrl.MoreFilters.ViewModes = $ctrl.filtersService.getColumnsItems($ctrl.ViewModes);
        $ctrl.MoreFilters.ColumnsPerRow = $ctrl.filtersService.getColumnsItems($ctrl.filtersService.ColumnsPerRow);

        $ctrl.ColumnsList = $ctrl.filtersService.ColumnsList;


        $ctrl.isProp = $ctrl.filtersService.isProp;
        $ctrl.isColumn = $ctrl.filtersService.isColumn;
        $ctrl.isFilter = $ctrl.filtersService.isFilter;
        $ctrl.getFilters = $ctrl.filtersService.getFilters;

        $ctrl.changeFilter = changeFilter;
        $ctrl.changeProp = changeProp;
        $ctrl.changeColumn = changeColumn;

        $ctrl.isCProp = isCProp;
        $ctrl.changeCProp = changeCProp;

        //zoom events
        $ctrl.currentZoom = 1;
        $ctrl.ZoomTypes = ZoomTypesOptions;
        $ctrl.Zooms = ZoomsDropdown;
        $ctrl.zoom = zoom;

        return $ctrl;

        function changeFilter(selected, type) {
            $ctrl.filtersService.broadcastChangeFilter($ctrl.broadcastRoot, selected, type, false);
        }

        function zoom(e, type) {
           // $ctrl.preventDefault(e);
            $ctrl.currentZoom = getChangedZoomType($ctrl.currentZoom, type);
            $($ctrl.currentZoomedTable).animate({'zoom': $ctrl.currentZoom}, 'slow');
        }

        function getChangedZoomType(currentZoom, type){
            return type === ZoomTypesOptions.Reset ? 1 : (type === ZoomTypesOptions.In ? (currentZoom + 0.1) : (currentZoom - 0.1));
        }

        function changeColumn(id, e) {
            changeProp(e, id, 'columns', {val: $ctrl.filtersService.listCols});
        }

        function changeProp(e, id, prop, result) {
            //$ctrl.preventDefault(e);
            $ctrl.filtersService.changePropInit($ctrl, id, prop, result);
        }

        function getPrefix(){
            return ($ctrl.isPrintLayout ? '_PRINT_LAYOUT' : '') +
                ($ctrl.isInTreeModal ? '_TREE_MODAL' : '');
        }

        function changeCProp(e, type, index, prop, i) {
            var item = getFilter(index, prop, i);
            $ctrl.changeProp(e, item.id, type);
        }

        function isCProp(type, index, prop, i) {
            return $ctrl.isProp(getFilter(index, prop, i), type);
        }

        function getFilter(index, prop, i){
            return $ctrl.MoreFilters[index].l[prop][i];
        }
    }
}

angular.module('filters.service', [
    'list.tree.service'
])
.service('FiltersService', FiltersService);
FiltersService.$inject = ['RootEventsService', 'LCS'];
function FiltersService(RootEventsService, LCS) {

    return function (constantsService, listOptionsService, other) {
        console.log('FiltersService');
        if (!constantsService) {
            constantsService = {};
        } else{
            constantsService = _.clone(constantsService);
        }
        var isChanging = false,

            Settings = constantsService.Settings,
            Columns = Settings && Settings.Columns ? Settings.Columns : [],
            Options = constantsService.Options,

            ViewModes = [
                {id: 2, code: 'List', name: 'List View', icon: 'storyboard-list'},
                {id: 3, code: 'Grid', name: 'Grid View', icon: 'storyboard-grid'}
            ],

            ColumnsPerRow = [
                {id: '-1', name: 'Frames per Row', isHeader: true, col: 1},
                {id: '1', name: 'One Frame', icon: 'frames-1', iconLevel:6},
                {id: '2', name: 'Two Frames', icon: 'frames-2', iconLevel:17},
                {id: '3', name: 'Three Frames', icon: 'frames-3', iconLevel:37},
                {id: '4', name: 'Four Frames', icon: 'frames-4', iconLevel:49},
                {id: '5', name: 'Five Frames', icon: 'frames-5', iconLevel:49}
            ],

            PrintingFrames = [
                {id: "-1", name: 'Frames per Row', isHeader: true, col: 1},

                {id: "1", type:1, name: 'Full Page', icon: 'landscape-full-page', c:1, r:1, p:1},// 1-(text under p=1)
                {id: "2", type:1, name: 'Two Frames', icon: 'landscape-two-frame', c:1, r:2, p:2},//2 = 1 column * 2 rows (text on the side p=2)
                {id: "3", type:1, name: 'Four Frames', icon: 'landscape-four-frame', c:2, r:2, p:1},//4 = 2 columns * 2 rows (text under)
                {id: "4",type:1, name: 'Six Frames', icon: 'landscape-six-frame-grid', c:3, r:2, p:1},//6 = 3 columns * 2 rows (text under)
                {id: "5",type:1, name: 'Nine Frames', icon: 'landscape-nine-frame-grid', c:1, r:1, p:1},//9 = 3 columns * 3 rows (text under)
                {id: "6",type:1, name: 'Twelve Frames', icon: 'landscape-twelve-frame-grid', c:1, r:1, p:1},//12 = 4 columns * 3 rows (text under)

                {id: "7", type:2, name: 'Full Page', icon: 'portrait-full-page'},// 1-(text under)
                {id: "8", type:2, name: 'Two Frames', icon: 'portrait-two-frame'},//2 = 1 column * 2 rows (text under)
                {id: "8", type:2, name: 'Three Frames', icon: 'portrait-three-frame'},//3 = 1 column * 3 rows (text on the side)
                {id: "9",type:2, name: 'Four Frames', icon: 'portrait-four-frame'},//4 = 1 column * 4 rows (text on the side)
                {id: "10",type:2, name: 'Six Frames', icon: 'portrait-six-frame-grid'},// 6 = 2 columns * 3 rows (text under)
                {id: "11",type:2, name: 'Nine Frames', icon: 'portrait-nine-frame-grid'},//9 = 3 columns * 3 rows (text under) (no icon)
                {id: "12",type:2, name: 'Twelve Frames', icon: 'portrait-twelve-frame-grid'},//12 = 3 columns * 4 rows (text under)
                {id: "13",type:2, name: 'Sixteen Frames', icon: 'portrait-sixteen-frame-grid'}//16 = 4 columns * 4 rows (text under)
            ],

            isPrintLayout = constantsService && constantsService.CompOptions && constantsService.CompOptions.isPrintLayout;
        if(!Settings){
            Settings = {};
        }
        if(!Settings.ViewModes){
            Settings.ViewModes = ViewModes;
        }

        if(!Settings.ColumnsPerRow){
            Settings.ColumnsPerRow = isPrintLayout ? PrintingFrames : ColumnsPerRow;
        }

        var _this = _.extend({
            LCS: LCS,
            filtersServiceId: new ObjectId().toString(),
            allOptions: {},
            listOptionsService: listOptionsService,
            constantsService: constantsService,
            withGridView: constantsService.CompOptions.withGridView,
            ViewProp: constantsService.ViewProp,
            Filters: constantsService.Filters,
            noListModeOnMobile: constantsService.CompOptions.noListModeOnMobile,
            isPrintLayout: isPrintLayout,
            Settings: Settings,
            Options: Options,
            ViewModes: Settings.ViewModes,
            ColumnsPerRow: Settings.ColumnsPerRow,
            DefaultFilterProp: 'selectedFilter',
            //view events
            isProp: isProp,
            isColumn: isColumn,
            getColumnByProp: getColumnByProp,
            getColumnByPropType: getColumnByPropType,
            getColumnsItems: getColumnsItems,
            setOptions: setOptions,
            hasColumn: hasColumn,
            changeFilter: changeFilter,
            isFilter: isFilter,
            getFilters: getFilters,
            recomputeOptions: recomputeOptions,
            updatePropertyAndCache: updatePropertyAndCache,
            setColumns: setColumns,
            checkGridView:checkGridView,
            broadcastChangeFilter: broadcastChangeFilter,
            hasProp: hasProp,

            onChangeFilter: onChangeFilter,
            getListIdParam: getListIdParam,
            changePropInit : changePropInit,
            getCachedListOptions: getCachedListOptions
        }, other);

        var filters = _this.constantsService.Filters;
        if(filters){
            for(var prop in filters){
                _this[prop] = filters[prop];
            }
        }

        _this.ColumnsList = getSortedColumns();
        _this.Options.view = getView(getCache());

        return _this;


        function changePropInit($ctrl, id, prop, result){
            var params = {
                    isReports: $ctrl.isReports || $ctrl.isPrintLayout || $ctrl.LCS.isMobileSize,
                    canEdit: $ctrl.canEdit,
                    data: _.extend({
                        productId: $ctrl.CPS.productId ? $ctrl.CPS.productId : null,
                        companyId: $ctrl.CPS.companyId
                    }, !$ctrl.isPrintLayout && $ctrl.listTreeService ? _this.getListIdParam($ctrl.listTreeService.active.selectedListId) : null)
                },
                list = [{prop: prop, id: id}].concat((prop === 'column' && !_this.checkGridView()) ? [{prop: 'view', id: 3}] : []);

            _this.updatePropertyAndCache(list, params, function () {
                _.each(list, function (item){
                    $ctrl.LCS.timeout(function (){
                        $ctrl.broadcastRoot('LIST_FILTERS_' + item.prop.toUpperCase() + getPrefix() + '_' + $ctrl.elemType, result ? result.val : item.id);
                    }, 10);
                });
            });
        }

        function broadcastChangeFilter(broadcastRoot, selected, type, force) {
            if (!type) {
                type = _this.DefaultFilterProp;
            }
            if (_this.changeFilter(selected, type) || force) {
                _this.onChangeFilter({type: type, val: _this[type]}, broadcastRoot);
            }
        }

        function onChangeFilter(info, broadcastRoot){
            broadcastRoot('CHANGED_TOP_DRP_FILTERS' + getPrefix(), info);
        }

        function getPrefix(){
            return (_this.isPrintLayout ? '_PRINT_LAYOUT' : '') +
                (_this.isInTreeModal ? '_TREE_MODAL' : '');
        }

        function setCache(val) {
            LCS.setSetting(getKey(), val);
        }

        function getCache() {
           return LCS.getSettings(getKey());
        }

        function getKey(){
            return _this.ViewProp + getPrefix();
        }

        function checkGridView() {
            return (_this.noListModeOnMobile || !_this.noListModeOnMobile && !LCS.isMobileSize) && checkGridByType('Grid');
        }

        function checkGridByType(type) {
            return _this.options && _this.options.view && _.find(_this.ViewModes, function (v) {
                return v.code === type;
            }).id === _this.options.view;
        }

        function updatePropertyAndCache(list, params, next) {
            updateProperty(list, params, onsuccess);

            function onsuccess(updateCached) {
                setCachedListOptions(params.data, updateCached);
                if (next) {
                    next();
                }
            }
        }

        function updateProperty(list, params, onSuccess) {  // list od [prop, id] prop, id
            if (isChanging) {
                return;
            }

            if (!list) {
                return;
            }

            var info = updateOptionsListProperty(list);
            isChanging = true;
            if (!params.isReports && params.canEdit && !_this.LCS.isMobileSize && typeof(updateFiltersProperty) === 'function') {
                //update options to be overwritten by local services
                var updateCached = info.options;
                updateFiltersProperty(_.extend({
                    options: updateCached
                }, params.data), function(){
                    setCache(updateCached);
                    processchange(updateCached);
                }, function (err) {
                    isChanging = false;
                });
            } else {
                processchange();
            }

            function processchange(updateCached) {
                setActive(info);
                if (typeof(onSuccess) === 'function') {
                    onSuccess(updateCached);
                }
            }

            function setActive(info) {
                isChanging = false;
                if (info) {
                    for (var prop in info) {
                        _this[prop] = info[prop];
                    }
                }
            }
        }

        function getListIdParam(id){
            var p = {};
            if (_this.withOptionsForList) {//based on the list id
                p[ _this.withOptionsForListField] = !_this.withStringOptionsForListField && id === 'All' ? null : id;
            }
            return p;
        }

        function recomputeOptions(updatedOptions, params, id, elemType, next) {
            console.log('recomputeOptions');
            _this.options = null;
            if (_this.listOptionsService) {
                if (!params) {
                    console.warn('must define companyId and productId for treeService.setList');
                    params = {};
                }
                //based on the list id
                params = _.extend(params, _this.getListIdParam(id));
            }
            var prop = getOptionsListPropName(params),
                options = _this.isPrintLayout ? updatedOptions : getCachedListOptions(prop);
            if (options || !_this.isPrintLayout) {
                updatedOptions = options;
            }

            //if is print layout dont load from db
            if (options){
                return process();
            }

            if(!_this.listOptionsService) {
                return process();
            }

            _this.listOptionsService.getListOptions(params, function (newOptions) {
                updatedOptions = newOptions;
                process();
            });

            function process() {
                var options = _this.setOptions(updatedOptions);
                setCachedListOptions(prop, options);
                //var info = 'LOAD_GROUP' + getPrefix() + '_' + elemType + '_' + id;
                //console.log(info);
                RootEventsService.broadcastRoot('LOAD_GROUP' + getPrefix() + '_' + elemType + '_' + id, {forceReload: true});
                next(options);
            }
        }

        function getCachedListOptions(params) {
            console.log('getCachedListOptions');
            var prop = typeof(params)  === 'string' ? params : getOptionsListPropName(params);

            if(_this.allOptions[prop]) {
                return _this.allOptions[prop];
            }

            return null;
        }

        function setCachedListOptions(params, val) {
            console.log('setCachedListOptions');
            if(!val){return;}
            var prop = typeof(params) === 'string' ? params : getOptionsListPropName(params);
          /*  if(_this.listOptionsService) {
                //todo store in object cache instead
                LCS.PersistenceService.set(prop, val);
            }*/
            LCS.PersistenceService.set(prop, val);
            _this.allOptions[prop] = val;
            _this.currentOptions = val;
        }

        function updateFiltersProperty(options, onsuccess, onerror) {
            if(_this.listOptionsService) {
                _this.listOptionsService.setOptions(options, onsuccess, onerror);
            }else{
                onsuccess();
            }
        }

        function getFilters(type) {
            var val = type.substring(0, 1).toUpperCase() + type.substring(1, type.length);
            if (val.substring(val.length - 1, val.length) !== 's') {
                val += 's';
            }
            return _this[(type === _this.DefaultFilterProp || !type) ? 'Filters' : val];
        }

        function changeFilter(selected, type) {
            if (!_this.isFilter(selected, type)) {
                _this[type ? type : _this.DefaultFilterProp] = selected;
                return true;
            }
            return false;
        }

        function isFilter(filter, type) {
            return _this[type ? type : _this.DefaultFilterProp] === filter;
        }

        function hasColumn(id) {
            return listHasEl(_this.options.columns, id);
        }

        function listHasEl(list, id) {
            var el;
            if (list && list.length > 0) {
                el = _.find(list, function (el) {
                    return el && id && el.toString() === id.toString();
                });
            }
            return el !== null && el !== undefined;
        }

        function getColumnsItems(list) {
            var colListItems = null, columns = 0, col;
            if (list && list.length > 2) {
                for (var i = 0, n = list.length; i < n; i++) {
                    var el = list[i];
                    if (el.isHeader && col !== el.col) {
                        col = el.col;
                    }
                    if (!colListItems) {
                        colListItems = {};
                    }
                    if (!colListItems[col]) {
                        colListItems[col] = [];
                        columns++;
                    }
                    colListItems[col].push(el);
                }
            } else {
                columns = 1;
                colListItems = {1: list};
            }

            return {
                l: colListItems,
                c: columns
            };
        }

        function isProp(item, prop) {
            return hasProp(item.id, prop);
        }

        function isColumn(id) {
            return hasProp(id, 'columns');
        }

        function hasProp(id, prop) {
            var option = getSelectedProp(prop);
            if (option) {
                return prop === 'columns' ? listHasEl(option, id) : option.toString() === id.toString();
            }
            return false;
        }

        function getColumnByPropType(type, searchAllColumns) {
            return getcols(type, searchAllColumns, false);
        }

        function getColumnByProp(prop, searchAllColumns) {
            return getcols(prop, searchAllColumns, true);
        }

        function getcols(prop, searchAllColumns, isProp){
            var cols = Columns;
            for (var id in cols) {
                var col = cols[id], options = getSelectedProp('columns');
                if (col && col[isProp ? 'prop' : 'type'] === prop) {
                    return searchAllColumns ? col : (listHasEl(options, id) ? col : null);
                }
            }
            return null;
        }
        function getSelectedProp(prop) {
            return _this.options ? _this.options[prop] : null;
        }

        function getListCols(cols) {
            var columns = Columns, list = [];
            if (!cols || !columns) {
                return list;
            }
            for (var i = 0, n = cols.length; i < n; i++) {
                processItem(list, columns[cols[i]]);
            }
            return getSortedList(list);
        }

        function getSortedColumns() {
            var columns = Columns, list = [];
            for (var prop in columns) {
                processItem(list, columns[prop]);
            }
            return getSortedList(list);
        }

        function processItem(list, el) {
            if (el && !_.find(list, function(item){return item.id.toString() === el.id.toString();})) {
                list.push(el);
            }
        }

        function getSortedList(list) {
            return list && list.length > 0 ? _.sortBy(list, 'order') : null;
        }

        function getOptionsListPropName(params) {
            var prop = getKey() + '_' + params.companyId + '_' + params.productId;
            if (_this.listOptionsService && _this.withOptionsForList) {
                prop += '_' + params[_this.withOptionsForListField];
            }
            return prop;
        }

        function setOptions(options) {
            console.log('setOptions');
            _this.options = angular.copy(options ? options : _this.Options);

            setColumns(_this.options ? _this.options.columns : null);

            _this.options.view = getView(_this.options);
            _this.options.column = getColumn(_this.options);

            if(!_this.isOptionsInit){
                _this.isOptionsInit = true;
                RootEventsService.broadcastRoot('FILTERS_OPTIONS_SET' + getPrefix() + '_' +  _this.filtersServiceId);
            }

            return _this.options;
        }

        function getView(options) {
            var v = _this.ViewModes;
            if(!_this.withGridView){
                return v[0].id;//listview
            }
            return getSel(options, 'view', v);
        }

        function getColumn(options) {
            //if is mobile default to 1 col
            if(_this.LCS.isMobileSize){return 1;}
            return getSel(options, 'column', _this.ColumnsPerRow);
        }

        function getSel(options, prop, v) {
            var c = options ? options[prop] : null;
            if(c) {
                if(v && v.length > 0) {
                    var exists = _.find(v, function (item) {
                        return item.id.toString() === c.toString();
                    });
                    if(exists) {
                        return exists.id;
                    }
                }
            }
            return _this.Options[prop];
        }

        function setColumns(cols) {
            if(!_this.options) {
                _this.options = angular.copy(_this.Options);
            }
            if(cols){
                _this.options.columns = _.uniq(cols);
            }
            _this.listCols = cols ? getListCols(cols) : null;
        }

        function updateOptionsListProperty(list) {
            console.log('updateOptionsListProperty');
            var options = angular.copy(_this.options),
                params = {},
                columns = Columns,
                n = list && list.length > 0 ? list.length : 0;

            for (var i = 0; i < n; i++) {
                var el = list[i], prop = el.prop, id = el.id;
                if (prop === 'columns') {
                    var cols = options[prop],
                        index = cols.indexOf(id);
                    if (index === -1) {
                        cols.push(id);
                        cols.sort(sorting);
                    } else {
                        cols.splice(index, 1);
                    }
                    cols = onlyUnique(cols);
                    options[prop] = cols;
                    if (cols) {
                        params.listCols = getListCols(cols);
                    }
                } else {
                    options[prop] = id;
                }
            }

            params.options = options;
            return params;

            function sorting(a, b) {
                var a1 = columns[a] && columns[a].order ? columns[a].order : 0,
                    b1 = columns[b] && columns[b].order ? columns[b].order : 0;
                if (a1 && b1) {
                    if (a1 > b1) {
                        return 1;
                    }
                    else if (b1 > a1) {
                        return -1;
                    }
                }
                return 0;
            }
        }

        function onlyUnique(list) {
            if (!list || list.length === 0) {
                return list;
            }
            var nList = [];
            for (var i = 0; i < list.length; i++) {
                var el = list[i];
                if (!listHasEl(nList, el)) {
                    nList.push(el);
                }
            }
            return nList;
        }
    };
}

