angular.module('user.dashboardPage.myTeam.component', [
    'user.dashboardPage.widget.component.service',
    'apiConstants.myTeam.services',
    'user.dashboardPage.myTeamGroup.component'
])
.component('myTeam', {
    bindings: getDashboardWidgetGroupBindings(),
    controller: 'MyTeamCtrl'
})
.controller('MyTeamCtrl', MyTeamCtrl);
MyTeamCtrl.$inject = ['DashboardWidgetCtrlService', 'MyTeamConstantsService', '$element'];
function MyTeamCtrl(DashboardWidgetCtrlService, constantsService, $element) {
    console.log('MyTeamCtrl');
    var $ctrl = this;

    $ctrl.DashboardWidgetCtrlService = DashboardWidgetCtrlService;

    $ctrl.preInitOther = preInitOther;
    $ctrl.preProcessGroupItems = preProcessGroupItems;
    $ctrl.onPreloadedService = onPreloadedService;

    $ctrl = new $ctrl.DashboardWidgetCtrlService($ctrl, constantsService, $element);

    function preInitOther(constantsService){
        var c = angular.copy(constantsService);
        c.GroupSettings = _.extend({}, c.GroupSettings, {
            maxGridItemWidth: 140,
            dragHandleOnTheSide: false,
            withoutGroupSorting: true,
            hideGridHeader: false,
            gridItemClass: ' ',
            noBorderGridHeader: true,
            showSortingColumns: false,
            withRoleUnder: true,

            noListModeOnMobile: true
        });

        c.Options = _.extend({}, c.Options, $ctrl.isFullItem ? {
            showHeader: true,
            view: 2,
            columns: ['1', '2' , '3', '3.1', '4',  '6', '7']
        } : {
            columns: ['1', '2', '5'],
            view: 3,
            column: 4
        });

        c.Settings.Columns = _.extend({}, c.Settings.Columns);

        c.Settings.Columns['1'] = _.extend({}, c.Settings.Columns['1'], {
            canEdit: false,
            imgSize: 'small48 centered'
        });
        c.Settings.Columns['2'] = _.extend({}, c.Settings.Columns['2'], {
            canEdit: false
        });
        c.Settings.Columns['5'] = _.extend({}, c.Settings.Columns['5'], {
            canEdit: false
        });

        $ctrl.constantsService = c;
    }

    function preProcessGroupItems(item) {
        item.productIds = $ctrl.teamForProduct[item._id] || [];
        item.products = item.productIds.map(function (id) {
            return _.find($ctrl.products, {_id: id});
        });
        return item;
    }

    function onPreloadedService(err, other){
        $ctrl.teamForProduct = {};

        $ctrl.other = other;
        $ctrl.products = $ctrl.other && $ctrl.other.products ? $ctrl.other.products.map(function (p){
            p.teamIds = [];
            p.team = _.filter(_.unique(p.teamIds).map(function (id){
                return _.find($ctrl.team, {_id: id});
            }), function (el){
                if(el){
                    p.teamIds.push(el._id);
                    if(!$ctrl.teamIds[p._id]) {
                        $ctrl.teamIds[p._id] = [];
                    }
                    $ctrl.teamForProduct[el._id].push(p._id);
                }
                return el;
            });
            return p;
        }) : null;
    }
}

angular.module('user.dashboardPage.myTeamGroup.component', [
    'user.team.group.component.service',
    'groupBlock.controller.service',
    'user.dashboardPage.myTeam.item.grid.component'
])
.component('myteamGroup', groupBlockComponentParams('MyTeamGroupCtrl', {
    onListItemsQuery: '&',
    preProcessGroupItems: '&',
    nestedLevel: '@'
}))
.controller('MyTeamGroupCtrl', MyTeamGroupCtrl);
MyTeamGroupCtrl.$inject = ['TeamGroupCtrlService', 'GroupBlockInitCtrlService','CPS', '$element'];
function MyTeamGroupCtrl(GroupCtrlService, GroupBlockInitCtrlService,CPS, $element) {
    console.log('MyTeamGroupCtrl');
    var $ctrl = this;
    $ctrl.styles = {borders: 0};
    $ctrl.CPS = CPS;
    $ctrl.GroupCtrlService = GroupCtrlService;
    $ctrl.GroupBlockInitCtrlService = GroupBlockInitCtrlService;
    $ctrl.isWidget = true;

    $ctrl.afterProcessUpdates = afterProcessUpdates;
    $ctrl.$onInit = $onInit;

    $ctrl = new $ctrl.GroupCtrlService($ctrl);

    function $onInit() {
        $ctrl.quotaType = 'team';

        $ctrl.isFullItem = $element[0].getAttribute('is-full-item') === 'true';

        $ctrl.customButtons = true;
        $ctrl.hideRemoveBtn = true;

        $ctrl.options = $ctrl.constantsService.Options;
        $ctrl.withCustomSettings = $ctrl.constantsService.CompOptions.withCustomSettings;

        $ctrl.onInit();

        $ctrl = new $ctrl.GroupBlockInitCtrlService($ctrl, $element, $ctrl.Pagination, $ctrl.constantsService, null);
    }

    function afterProcessUpdates(result) {

        if (result.eventType === 'CHANGED_FIELD') {
            return;
        }
        var res = $ctrl.setCounter();
    }

}

function getDashboardWidgetGroupBindings(){
    return {
        nestedLevel: '@',
        block: '@',
        canEdit: '@'
    };
}

angular.module('user.dashboardPage.widget.component.service', [
    'group.container.block.controller.service',
    'service.currentDashboard'
])
.service('DashboardWidgetCtrlService', DashboardWidgetCtrlService);
DashboardWidgetCtrlService.$inject = ['GroupContainerBlockCtrlService', 'CurrentDashboard'];
function DashboardWidgetCtrlService(GroupContainerBlockCtrlService , CurrentDashboard) {
    return function ($ctrl, constantsService, $element) {
        console.log('DashboardWidgetCtrlService');

        $ctrl.CurrentDashboard = CurrentDashboard;
        $ctrl.GroupContainerBlockCtrlService = GroupContainerBlockCtrlService;

        if(!$ctrl.getGroupBodyAttrs) {
            $ctrl.getGroupBodyAttrs = getGroupBodyAttrs;
        }

        if(!$ctrl.preInitOther) {
            $ctrl.preInitOther = preInitOther;
        }

        if(!$ctrl.onInit) {
            $ctrl.onInit = onInit;
        }

        if(!$ctrl.$onInit) {
            $ctrl.$onInit = $ctrl.onInit;
        }

        return $ctrl;

        function onInit() {
            $ctrl.element = $element[0];

            $ctrl.preInitOther(constantsService);

            $ctrl.canEdit = $ctrl.element.getAttribute('can-edit') === 'true';
            $ctrl.isFullItem = $ctrl.element.getAttribute('is-full-item') === 'true';

            $ctrl.preloadingType = $ctrl.constantsService.CompOptions.preloadingType;
            if (!$ctrl.preloadingType) { // for tasks use the preloading service from tasks
                $ctrl.preLoadingService = $ctrl.CurrentDashboard.preLoadingService;
            }
            $ctrl.groupTag = $ctrl.block + '-group';
            $ctrl.smallPreloader = true;
            $ctrl.currentListId = null;
            if($ctrl.rowLoadNow===undefined) {
                $ctrl.rowLoadNow = false;
            }
            $ctrl = new $ctrl.GroupContainerBlockCtrlService($ctrl, $element, $ctrl.constantsService);
        }

        function preInitOther(constantsService) {
            $ctrl.constantsService = angular.copy(_.extend({}, constantsService));
        }

        function getGroupBodyAttrs() {
            return ($ctrl.onListItemsQuery ? ('on-list-item-query="$ctrl.onListItemsQuery(item)"') : '') +
                ($ctrl.preProcessGroupItems ? ('pre-process-group-items="$ctrl.preProcessGroupItems(item)"') : '') +
                ($ctrl.isFullItem ? 'is-full-item="true"' : '') +
                ($ctrl.nestedLevel ? ('nested-level="' + $ctrl.nestedLevel + '"') : '') +
                ($ctrl.other ? ('other="::$ctrl.other"') : '');
        }
    }
}

