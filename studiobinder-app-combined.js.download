angular.module('pdfjsViewer.config', [
    'pdfjsViewer.provider'
])
.config(pdfjsViewerConfig);

pdfjsViewerConfig.$inject = ['pdfjsViewerConfigProvider' ,'API_CONFIGS'];
function pdfjsViewerConfig(pdfjsViewerConfigProvider, API_CONFIGS) {
    var configs = API_CONFIGS(),
        url = ('https://'+configs.staticDomain + '/'+configs.distdir + '/') + "pdf.js-viewer/",
        isNewVersion = false;

    pdfjsViewerConfigProvider.setWorkerSrc(url + "pdf" + (isNewVersion ? '-dist' : '') + ".worker.js?v=" + new Date().getTime());
    pdfjsViewerConfigProvider.setCmapDir(url + "cmaps");
    pdfjsViewerConfigProvider.setImageDir(url + "images");

    //pdfjsViewerConfigProvider.disableWorker();
    pdfjsViewerConfigProvider.setVerbosity("infos");  // "errors", "warnings" or "infos"
}


angular.module('pdfjsViewer.provider', [])
    .provider('pdfjsViewerConfig', pdfjsViewerConfigProvider );

function pdfjsViewerConfigProvider() {
    var config = {
        workerSrc: null,
        cmapDir: null,
        imageResourcesPath: null,
        disableWorker: false,
        verbosity: null
    };

    this.setWorkerSrc = setWorkerSrc;
    this.setCmapDir = setCmapDir;
    this.setImageDir = setImageDir;
    this.disableWorker = disableWorker;
    this.setVerbosity = setVerbosity;
    this.$get = $get;

    function setWorkerSrc(src) {
        config.workerSrc = src;
    }

    function setCmapDir(dir) {
        config.cmapDir = dir;
    }

    function setImageDir(dir) {
        config.imageDir = dir;
    }

    function disableWorker(value) {
        if (typeof value === 'undefined') {
            value = true;
        }
        config.disableWorker = value;
    }

    function setVerbosity(level) {
        config.verbosity = level;
    }

    function $get() {
        return config;
    }
}
angular.module('pdfjsViewer.run', [
    'pdfjsViewer.provider'
])
.run(pdfjsViewerRun);

pdfjsViewerRun.$inject = ['pdfjsViewerConfig'];
function pdfjsViewerRun(pdfjsViewerConfig) {
  if (pdfjsViewerConfig.workerSrc) {
      PDFJS.workerSrc = pdfjsViewerConfig.workerSrc;
  }

  if (pdfjsViewerConfig.cmapDir) {
      PDFJS.cMapUrl = pdfjsViewerConfig.cmapDir;
  }

  if (pdfjsViewerConfig.imageDir) {
      PDFJS.imageResourcesPath = pdfjsViewerConfig.imageDir;
  }

  if (pdfjsViewerConfig.disableWorker) {
      PDFJS.disableWorker = true;
  }

  if (pdfjsViewerConfig.verbosity !== null) {
      var level = pdfjsViewerConfig.verbosity;
      if (typeof level === 'string') {level = PDFJS.VERBOSITY_LEVELS[level];}
      PDFJS.verbosity = pdfjsViewerConfig.verbosity;
  }
}
angular.module('components.PdfViewer.servuce', [
    'components.PdfAnnotations.controller.service'
])
.service('SbPdfViewerService', PdfJsViewerService);
PdfJsViewerService.$inject = [];
function PdfJsViewerService() {
    var $ctrl = this;

        var initialised = false, loaded = {}, poller, numLoaded = 0;
        // watch pdf source
        $ctrl.PDFJS = window.PDFJS;
        $ctrl.pdfViewer = null;
        $ctrl.HOSTED_VIEWER_ORIGINS = [$ctrl.CPS.websiteUrl];
        if($ctrl.CPS.awsOrigin) {
            $ctrl.HOSTED_VIEWER_ORIGINS.push($ctrl.CPS.awsOrigin);
        }

        $ctrl.onLoaded = onLoaded;
        $ctrl.onDestroy = onDestroy;

        function preInit() {
            if($ctrl.$element && $ctrl.$element.on) {
                $ctrl.$element.on('$destroy', onDestroy);
            }
        }

        function validSrc(src) {
            if($ctrl.HOSTED_VIEWER_ORIGINS.indexOf(new URL(window.location.href).origin || 'null') ===-1){return false;}
            return _.find($ctrl.HOSTED_VIEWER_ORIGINS, function (val) {
                return src.indexOf(val) >= 0;
            });
        }

        function onLoaded() {
            $ctrl.$element.children().wrap('<div class="pdfjs full-width " style=" height: 100%;"></div>');
            if (!$ctrl.PDFJS) {
                return console.warn("PDFJS is not set! Make sure that pdf.js is loaded before angular-pdfjs-viewer.js is loaded.");
            }
            console.log('sbPdfViewer loaded');
            // initialize the pdf viewer with (with empty source)
            if(!validSrc($ctrl.src)){
                return console.warn("invalid file.");
            }
            $ctrl.PDFJS.webViewerLoad($ctrl.src);

            poller = $interval(pdfPoller, 200);
        }

        function pdfPoller() {
            if (!window.PDFViewerApplication) {
                return;
            }

            $ctrl.pdfViewer = window.PDFViewerApplication.pdfViewer;

            if ($ctrl.pdfViewer) {
                if ($ctrl.scale !== $ctrl.pdfViewer.currentScale) {
                    loaded = {};
                    numLoaded = 0;
                    $ctrl.scale = $ctrl.pdfViewer.currentScale;
                }
            } else {
                console.warn("PDFViewerApplication.pdfViewer is not set");
            }

            $ctrl.pages = getPages();
            if($ctrl.pages && $ctrl.pages.length > 0) {
                processPage($ctrl.pages[0]);
            }

            function processPage(page) {
                var element = angular.element(page);
                var pageNum = element.attr('data-page-number');

                if (!element.attr('data-loaded')) {
                    delete loaded[pageNum];
                    return;
                }

                if (pageNum in loaded) {
                    return;
                }

                if (!initialised) {
                    onPdfInit();
                }


                if ($ctrl.onPageLoad) {
                    if ($ctrl.onPageLoad({page: pageNum}) === false) {
                        return;
                    }
                }


                loaded[pageNum] = true;
                numLoaded++;
            }
        }

        function getPages() {
            return document.querySelectorAll('.page');
        }

        function onPdfInit() {
            console.log('onPdfInit');
            initialised = true;
            if ($ctrl.onInit) {
                $ctrl.onInit();
            }
        }

        function onGroupChange(values) {
            var src = values[0];
            var data = values[1], path;

            if (!src && !data) {
                return;
            }

            if ($ctrl.isSrc) {
                if (!src) {
                    return;
                } else {
                    path = src;
                }
            } else {
                if (!data) {
                    return;
                } else {
                    path = data;
                }
            }

            window.PDFViewerApplication.open(path);
        }

        function onAttrsChange() {
            if ($attrs.open === 'false') {
                document.getElementById('openFile').setAttribute('hidden', 'true');
                document.getElementById('secondaryOpenFile').setAttribute('hidden', 'true');
            }
            set('width');
            set('height');

            function set(prop){
                var v = $attrs[prop];
                if (v) {
                    var el = document.getElementById('outerContainer');
                    if(el){
                        if(!el.style){el.style = {};}
                        el.style[prop] = v;
                    }
                }
            }
        }

        function onDestroy() {
            bind(false);
            if(poller){
                $interval.cancel(poller);
            }
        }
    }

angular.module('components.securePdfViewer', [
    'components.PdfAnnotations.controller.service',
    'templateCompile.service'
])
.component('sbPdfViewer',  {
    bindings: {
        src: '<?',
        options: '<?'
    },
    template: '<pdfjs-viewer src="$ctrl.pdfViewer.src" scale="$ctrl.pdfViewer.scale" download="$ctrl.pdfViewer.download" print="$ctrl.pdfViewer.print" is-src="$ctrl.pdfViewer.isSrc"></pdfjs-viewer>',
    controller: 'SbPdfViewerCtrl',
})
.controller('SbPdfViewerCtrl', SbPdfViewerCtrl);
SbPdfViewerCtrl.$inject = [];
function SbPdfViewerCtrl() {
    var $ctrl = this;
    $ctrl.changedFields = ['src'];

    $ctrl.$onInit = $onInit;
    $ctrl.$onChanges = $onChanges;

    function $onInit() {
        if (!$ctrl.options) {
            $ctrl.options = {};
        }

        $ctrl.pdfViewer = {
            src: $ctrl.src,
            isSrc: true,
            data: null,
            scale: $ctrl.options.scale ? $ctrl.options.scale : 1,
            download: $ctrl.options.download ? $ctrl.options.download : true,
            print: $ctrl.options.print ? $ctrl.options.print : true
        };
    }

    function $onChanges(changes) {
        console.log(changes);
        if (!changes) {
            return;
        }
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var change = changes[$ctrl.changedFields[i]];
            if (change!==undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                //todo
                $ctrl.pdfViewer.src = $ctrl.src;
                break;
            }
        }
    }
}


/*https://github.com/eKoopmans/html2pdf*/
angular.module('components.sbPrintPdfViewer', [
    'product.print.options.controller.service'
])

.component('sbPrintPdfViewer', {
    bindings: {
        options: '<?',
    },
    controller: 'SbPrintPdfViewerCtrl',
})

.controller('SbPrintPdfViewerCtrl', SbPrintPdfViewerCtrl);
SbPrintPdfViewerCtrl.$inject = ['PrintOptionsCtrlService', '$element'];
function SbPrintPdfViewerCtrl(PrintOptionsCtrlService, $element) {

    var ignore = ['.side-table>.side-nav', '#intercom-frame', '#intercom-container', '.intercom-launcher-frame.intercom-launcher-frame-shadow', '.hide-print', 'header#section-header', "nav", "iframe", "canvas", "sb-pdf-viewer"];
    var $ctrl = this;

    $ctrl.preInitGeneralOther = preInitGeneralOther;
    $ctrl.preSetTemplateDataOther = preSetTemplateDataOther;
    $ctrl.getItemPopupTemplate = getItemPopupTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl = new PrintOptionsCtrlService($ctrl, $element);

    function preSetTemplateDataOther(){
        $ctrl.icon = 'print';
    }

    function preInitGeneralOther() {
        if (!$ctrl.item.htmlContainer) {
            $ctrl.item.htmlContainer = '#body-wrapper .scrollable-content .reports-table';
        }
        if (!$ctrl.item.filename) {
            $ctrl.item.filename = 'StudioBinder.pdf';
        }
        if (!$ctrl.item.scale) {
            $ctrl.item.scale = 4;
        }
        if ($ctrl.item.showWatermark === 'undefined') {
            $ctrl.item.showWatermark = true;
        }
        if (!$ctrl.item.watermark) {
            $ctrl.item.watermark = 'StudioBinder Inc';
        }

        if ($ctrl.item.isSrc === 'undefined') {
            $ctrl.item.isSrc = false;
        }

        if (!$ctrl.item.crossOrigin) {
            $ctrl.item.crossOrigin = 'Anonymous'; //'use-credentials';
        }
        $ctrl.item.useCORS = true;

        if (!$ctrl.item.margin) {
            $ctrl.item.margin = [20, 0, 20, 0];// [top, left, bottom, right]
        }

        // Avoid page-breaks on all elements, and add one before #page2el.
        $ctrl.mode1 = {
            mode: 'avoid-all',
            before: '#page2el'
        };

        // Enable all 'modes', with no explicit elements.
        $ctrl.mode2 = {
            mode: ['avoid-all', 'css', 'legacy']
        };

        // No modes, only explicit elements.
        $ctrl.mode3 = {
            before: '.beforeClass',
            after: ['#after1', '#after2'],
            avoid: 'img'
        };

        $ctrl.pdfViewer = {
            isSrc: false,
            data: null,
            scale: $ctrl.item.scale,
            download: $ctrl.item.download,
            print: $ctrl.item.print,
            onInit: onPdfViewerInit,
            onPageLoad: onPdfViewerPageLoad
        };

        $ctrl.downloadPdf = downloadPdf;
        $ctrl.loadPdf = loadPdf;
        $ctrl.close = close;
    }
    //The on-init function is called when PDF.JS is fully loaded
    function onPdfViewerInit() {
        // pdf.js is initialized
    }

    /*The on-page-load function is each time a page is loaded and will pass the page number. When the scale changes all pages are unloaded, so on-page-load will be called again for each page. If onPageLoad() returns false, the page will not be marked as loaded and onPageLoad will be called again for that page on the next (200ms) interval. */
    function onPdfViewerPageLoad(page) {
        //
        // page is loaded
    }

    function onLoaded() {
        // The basic workflow of html2pdf tasks (enforced by the prereq system) is:
        // worker .from() -> [.toContainer() / .toCanvas() / .toImg() / .toPdf()] -> .save()
        $ctrl.htmlContainer = $ctrl.element.querySelector($ctrl.item.htmlContainer);
        //1 -> loadPdfWithHtml2Canvas
        //2 -> loadPdfWithHtml2PDF
        loadPdf(null, 3);
    }

    function close() {
        $ctrl.broadcastRoot('REMOVE_PRINT_POPUP', 'cancel');
    }

    function loadPdf(e, type) {
        $ctrl.preventDefault(e);
        try {
            switch (type) {
                case 1:
                    loadPdfWithHtml2Canvas();
                    break;
                case 2:
                    loadPdfWithHtml2PDF();
                    break;
                case 3:
                    break;
            }
        } catch (e) {
            onPDFGeneratedError(e);
        }
    }

    function loadPdfWithHtml2Canvas() {
        //get cancas
        html2canvas($ctrl.htmlContainer, getHtml2canvasOptions())
            .then(onCanvasGenerated)
            .catch(onPDFGeneratedError);

        function onCanvasGenerated(canvas) {
            var imgData = canvas.toDataURL(
                'image/png');
            //orientation/point unit/size

            var pdf = new jsPDF($ctrl.item.orientation, $ctrl.item.point, $ctrl.item.format),
                pdfConf = {
                    pagesplit: false,
                    background: '#fff'
                };
            document.body.appendChild(canvas); //appendChild is required for html to add page in pdf
            pdf.addHTML(canvas, 0, 0, pdfConf, function () {
                document.body.removeChild(canvas);
                pdf.addPage();
                html2canvas(document.getElementById('new-page-dom')).then(function (newCanvasDom) { //render the dom to be printed on the second page
                    document.body.appendChild(newCanvasDom);
                    pdf.addHTML(newCanvasDom, 20, 20, pdfConf, function () {
                        document.body.removeChild(newCanvasDom);
                        pdf.save(fileName + '.pdf');
                        callback();
                    });
                });
            });
        }
    }

    function loadPdfWithHtml2PDF() {
        html2pdf().set(getOptions()).from($ctrl.htmlContainer, 'element').save();
        //html2pdf().set(getOptions()).from(htmlContainer, 'element').outputPdf('arraybuffer').then(onPDFGenerated);
    }

    function loadPdfWithJsPdf() {
        var base64Img = null,

            margins = {
                top: 70,
                bottom: 40,
                left: 30,
                width: 550
            };

        imgToBase64('octocat.jpg', function (base64) {
            base64Img = base64;
        });

        var pdf = new jsPDF($ctrl.item.orientation, $ctrl.item.point, $ctrl.item.format);
        pdf.fromHTML($ctrl.htmlContainer[0],
            margins.left, // x coord
            margins.top,
            {
                // y coord
                width: margins.width// max width of content on PDF
            }, function (dispose) {
                headerFooterFormatting(pdf, pdf.internal.getNumberOfPages());
            },
            margins);

        var iframe = document.createElement('iframe');
        iframe.setAttribute('style', 'position:absolute;right:0; top:0; bottom:0; height:100%; width:650px; padding:20px;');
        document.body.appendChild(iframe);

        iframe.src = pdf.output('datauristring');

        function headerFooterFormatting(doc, totalPages) {
            for (var i = totalPages; i >= 1; i--) {
                doc.setPage(i);
                //header
                header(doc);

                footer(doc, i, totalPages);
                doc.page++;
            }
        }

        function header(doc) {
            doc.setFontSize(30);
            doc.setTextColor(40);
            doc.setFontStyle('normal');

            if (base64Img) {
                doc.addImage(base64Img, 'JPEG', margins.left, 10, 40, 40);
            }

            doc.text("Report Header Template", margins.left + 50, 40);
            doc.setLineCap(2);
            doc.line(3, 70, margins.width + 43, 70); // horizontal line
        }

        // You could either use a function similar to this or pre convert an image with for example http://dopiaza.org/tools/datauri
        // http://stackoverflow.com/questions/6150289/how-to-convert-image-into-base64-string-using-javascript
        function imgToBase64(url, callback, imgVariable) {
            if (!window.FileReader) {
                callback(null);
                return;
            }
            var xhr = new XMLHttpRequest();
            xhr.open('GET', url);
            //xhr.open("GET", url, true); needs to be async ??
            xhr.responseType = 'blob';
            //xhr.crossOrigin = 'Anonymous';
            xhr.onload = onSuccess;
            xhr.onerror = onError;
            xhr.send();

            function onSuccess() {
                var reader = new FileReader();
                reader.onloadend = function () {
                    imgVariable = reader.result.replace('text/xml', 'image/jpeg');
                    callback(imgVariable);
                };
                reader.readAsDataURL(xhr.response);
            }

            function onError(e) {
                console.log('download image error');
                console.log(e);
                callback(null);
            }
        }

        function footer(doc, pageNumber, totalPages) {

            var str = "Page " + pageNumber + " of " + totalPages;

            doc.setFontSize(10);
            doc.text(str, margins.left, doc.internal.pageSize.height - 20);

        }
    }

    function clean() {
        $(document).find('.html2canvas-container').remove();
        $(document).find('.html2pdf__overlay').remove();
    }

    function onPDFGeneratedError(error) {
        console.log('onPDFGeneratedError');
        console.log(error);
        clean();
    }

    function onPDFGenerated(doc) {
        $ctrl.pdfViewer.isSrc = false;
        $ctrl.pdfViewer.data = new Uint8Array(doc);
        //PDFJS.getDocument($ctrl.pdfViewer.src);
        clean();
    }

    function onclone(document) {
        var l = ignore && ignore.length > 0 ? ignore.length : 0, els;
        if (l) {
            for (var i = 0; i < l; i++) {
                els = $(document).find(ignore[i]).remove();
            }
        }
        $('img').filter(function () {
            return this.src.match(/^data:,/);
        }).remove();
    }

    function ignoreElements(node) {
        var type = node.nodeName.toLowerCase();
        var res = type === "nav" || type === "iframe" || type === "canvas" || type === "pdf-viewer";
        if (res) {
            return true;
        }
        var cls = node.getAttribute('class');
        var list = cls && cls.split(''), l = list && list.length > 0 ? list.length : 0;
        if (l > 0) {
            var l2 = ['.side-nav', '.intercom-launcher-frame', 'hide-print'];
            for (var i = 0; i < l; i++) {
                res = l2.indexOf(list[i].trim().toLowerCase()) !== -1;
                if (res) {
                    return true;
                }
            }
        }
        if (type === 'img') {
            node.setAttribute('cross-origin', $ctrl.item.crossOrigin);
            node.setAttribute('crossorigin', $ctrl.item.crossOrigin);
        }
        return false;
    }

    function getHtml2canvasOptions() {
        return {
            scale: $ctrl.item.scale,

            useCORS: $ctrl.item.useCORS,
            crossOrigin: $ctrl.item.crossOrigin,
            removeContainer: true,
            imageTimeout: 0,
            //foreignObjectRendering: true,
            //allowTaint: true,
            login: true,
            ignoreElements: ignoreElements,
            onclone: onclone
        };
    }

    function getJsPDFOptions() {
        return {
            unit: $ctrl.item.unit,//"pt" (points), "mm" (Default), "cm", "in" or "px"
            format: $ctrl.item.format, /*a4 -> default,a0 - a10,b0 - b10,c0 - c10,c0 - c10,dl,letter,government-letter,legal,junior-legal,ledger,tabloid,credit-card*/
            orientation: $ctrl.item.orientation//portrait" or "landscape
        };
    }

    function getOptions() {
        var options = {
            metadata: $ctrl.item.metadata,
            filename: $ctrl.item.filename,
            margin: $ctrl.item.margin,
            pagebreak: $ctrl.mode1,
            image: {
                type: 'jpeg',
                quality: 0.98
            },
            enableLinks: true, //default
            html2canvas: getHtml2canvasOptions(),
            jsPDF: getJsPDFOptions()
        };
        if ($ctrl.item.showWatermark && $ctrl.item.watermark) {
            options.watermark = $ctrl.item.watermark;
        }
        return options;
    }

    function downloadPdf(e) {
        $ctrl.preventDefault(e);
        jspdf.save('filename');
    }

    function onDestroy() {
        $ctrl.removeWatchers();
        clean();
    }

    function getItemPopupTemplate(){
return '<div class="file-uploader-wrapper uploader-wrapper hide-print pdfjs-viewer" >' +
        '<div class="with-no-padding">' +
            '<div class="centered spacing-top spacing-bottom h-full" style="max-width: 1300px">' +
                '<div class="table-div h-full full-width" style="background-color: white">' +
                    '<div class="position-relative">' +
                        '<div class="pdf-wrapper" style="position: absolute;left:0;right:0;bottom:0;top:0;">' +
                            '<div id="canvas-pdf" class="display-block full-width h-full centered">' +
                                '<pdfjs-viewer data="$ctrl.pdfViewer.data" src="$ctrl.pdfViewer.src" scale="$ctrl.pdfViewer.scale" on-init="$ctrl.onInit()" download="$ctrl.pdfViewer.download" print="$ctrl.pdfViewer.print" on-page-load="$ctrl.onPageLoad(page)" is-src="$ctrl.pdfViewer.isSrc"></pdfjs-viewer>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="sidebar h-full col270" style="background: lightgrey;padding:20px">' +
                        '<div class="outtercontainer show-scrollbar-on-hover">' +
                            '<div class="innercontainer fancy-scrollbar ultrathin">' +
                                '<div class="sidebarScrollingContainer">' +
                                    '<div class="sidebar-toggle"><a class="btnToggleSidebar btn btn-small transparent noborder smaller inline-block" ng-click="$ctrl.LCS.toggleInnerSidebar()"><div class="sbf angle-double-left centered gray"><span class="sbp p1"></span><span class="sbp p2"></span></div></a></div>' +
                                    '<div class="show-ipad title uppercase text-center spacing-half-top">Filter By</div>' +
                                    '<h3 class="text-left spacing-half-top" ng-bind="label"></h3>' +
                                    '<div>' +
                                        '<a ng-click="$ctrl.downloadPdf($event)">Download PDF</a>' +
                                        '<a ng-click="$ctrl.download($event)">Download</a>' +
                                    '</div>' +
                                    '<div class="display-block position-relative">' +
                                        '<div class="settings form-wrapper">' +
                                             $ctrl.getLayoutWrapper() +
                                            '<div>' +
                                                '<a ng-click="$ctrl.loadPdf($event)">Reload PDF</a>' +
                                            '</div>' +
                                        '</div>' +
                                    '</div> ' +
                                '</div> ' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</div>' +
    '</div>';
    }
}

/*
                $element.on('touchstart', onTouchStart)
                    .on('touchmove', onTouchMove)
                    .on('touchend', onTouchEnd);
  $element.off('touchstart', onTouchStart)
                    .off('touchmove', onTouchMove)
                    .off('touchend', onTouchEnd);

function onPDFGenerated(doc) {
    var pdfAsArray = convertDataURIToBinary(doc);
    // PDFJS.disableStream = true;
    PDFJS.getDocument(pdfAsArray).then(onPDFLoaded)
        .catch(onPDFNotLoaded);
    clean();
}
function onPDFLoaded(pdf) {
    pdfFile = pdf;
    openPage(pdf, currPageNumber, 1);
}

function onPDFNotLoaded(error) {
    console.log(error);
}

function openNextPage() {
    var pageNumber = Math.min(pdfFile.numPages, currPageNumber + 1);
    if (pageNumber !== currPageNumber) {
        currPageNumber = pageNumber;
        openPage(pdfFile, currPageNumber);
    }
}

function openPrevPage() {
    var pageNumber = Math.max(1, currPageNumber - 1);
    if (pageNumber !== currPageNumber) {
        currPageNumber = pageNumber;
        openPage(pdfFile, currPageNumber);
    }
}

function toggleZoom() {
    zoomed = !zoomed;
    openPage(pdfFile, currPageNumber);
}

function openPage(pdfFile, pageNumber) {
    var scale = zoomed ? $scope.options.scale : $scope.options.scale;

    pdfFile.getPage(pageNumber).then(onPageLoaded);

    function onPageLoaded(page) {
        var viewport = page.getViewport(1);

        if (zoomed) {
            scale = $element.clientWidth / viewport.width;
            viewport = page.getViewport(scale);
        }

        canvas.height = viewport.height;
        canvas.width = viewport.width;

        var renderContext = {
            canvasContext: context,
            viewport: viewport
        };

        page.render(renderContext);
    }
}

function onTouchStart(e) {
    touchDown = true;

    if (e.timeStamp - lastTouchTime < 500) {
        lastTouchTime = 0;
        toggleZoom();
    } else {
        lastTouchTime = e.timeStamp;
    }
}

function onTouchMove(e) {
    if ($element.scrollLeft === 0 ||
        $element.scrollLeft === $element.scrollWidth - $element.clientWidth) {
        reachedEdge = true;
    } else {
        reachedEdge = false;
        touchStart = null;
    }

    if (reachedEdge && touchDown) {
        if (touchStart === null) {
            touchStart = e.changedTouches[0].clientX;
        } else {
            var distance = e.changedTouches[0].clientX - touchStart;
            if (distance < -100) {
                touchStart = null;
                reachedEdge = false;
                touchDown = false;
                openNextPage();
            } else if (distance > 100) {
                touchStart = null;
                reachedEdge = false;
                touchDown = false;
                openPrevPage();
            }
        }
    }
}

function onTouchEnd(e) {
    touchStart = null;
    touchDown = false;
}
 */
