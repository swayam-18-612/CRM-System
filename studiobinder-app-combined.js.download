        isArchived:'<',
    },
    controller: 'EmptyStateCtrl'
})
.controller('EmptyStateCtrl', EmptyStateCtrl);
EmptyStateCtrl.$inject = ['EmptyStateCtrlService', 'TemplateCompileCompCtrlService', '$element'];
function EmptyStateCtrl(EmptyStateCtrlService, TemplateCompileCompCtrlService, $element) {

    var $ctrl = this;

    $ctrl.changedFields = ['treeType'];

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;
    $ctrl.$onChanges = $onChanges;

    $ctrl.addItemBtn = addItemBtn;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function $onChanges(changes) {
        if (!changes) {
            return;
        }
        console.log('SBSimpleSelectorCtrlService.$onChanges');
        console.log(changes);
        for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
            var field = $ctrl.changedFields[i],
                change = changes[field];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                if (field === 'treeType') {
                    console.log('treeTypeChanged');
                    $ctrl.reloadTemplate();
                }
                break;
            }
        }
    }

    function preInit() {
        console.log('EmptyStateCtrl');
        if (!$ctrl.block) {
            $ctrl.block = $ctrl.LCS.csBlock;
        }
        $ctrl.addListOnEmptyState = $ctrl.addListOnEmptyState === 'true' || $ctrl.addListOnEmptyState === true;
    }

    function getItemTemplate() {
        var btns = typeof($ctrl.getButtons) === 'function' ? $ctrl.getButtons() : null;
        if(btns){
            btns = btns.replace('[ACTION_BUTTON]', $ctrl.getBtnActionCls());
        }
        return EmptyStateCtrlService.getItemTemplate($ctrl, $ctrl.block, btns, $ctrl.withButtons);
    }

    function onLoaded() {
        bind(true);
    }

    function onDestroy() {
        console.log('EmptyStateCtrl: destroy');
        bind(false);
    }

    function bind(isBind) {
        EmptyStateCtrlService.bind($ctrl, isBind);
    }

    function addItemBtn(type, e){
        $ctrl.onAddItemBtn({e:e})
    }
}

angular.module('groupBlock.empty-state.service', [
    'services.videoService'
])
.service('EmptyStateCtrlService', EmptyStateCtrlService);
EmptyStateCtrlService.$inject = ['VideoService'];
function EmptyStateCtrlService(VideoService) {

    return {
        getItemTemplate: getItemTemplate,
        bind: bind,
        getSimpleTemplate: getSimpleTemplate
    };

    function getSimpleTemplate($ctrl, block){
       return '<div class="empty-state table-div h-full"><div class="center spacing-half centered">' + getVideo($ctrl, block) + '</div></div>' ;
    }

    function getVideo($ctrl, block, isIFrame) {
        var p = 'emptystate/' + block.type + '/emptystate.';
        return isIFrame && block.videoUrl ?
            ('<div class="video-anime"><iframe width="398" height="222" frameBorder="0" webkitallowfullscreen="" mozallowfullscreen="" allowfullscreen="" src="' + block.videoUrl + '" allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope" referrerPolicy="strict-origin-when-cross-origin></iframe></div>') :
            ('<video class="video-anime wide" muted playsinline autoplay="autoplay" loop="loop" poster="' + $ctrl.LCS.getImgUrl(p + 'jpg') + '"><source src="' + $ctrl.LCS.getVideoUrl(p + 'mp4') + '" type="video/mp4"></video>');
    }

    function getItemTemplate($ctrl, block, btns, withButtons) {
        if (!block) {
            return '';
        }
        var emptyStateButtons = btns ? btns : getButtons(block),
            name = block.name,
        el = '<div>' +
                '<div class="empty-state">' +
                    '<div class="center spacing-half topemptystate">' +
                        '<div class="left">' +
                            '<div class="header">' +
                                '<div class="circled-svg-colored small60 page-class ' +
                                ($ctrl.pageClass ? $ctrl.pageClass : '') +
                                '">' +
                                (block.icon ? $ctrl.LCS.getISBDiv(block.icon, block.iconLevel, 'colored') : '') +
                                '</div>' +
                                '<div class="info">' +
                                    '<h3 class="infoh" style="color:' + block.color + '">{{$ctrl.withButtons?\'\' :\'Archived \'}}' + name +
         //   ($ctrl.isPro ? '<span class="profeature with-margin-left">Pro</span>' : '') +
        '</h3>' +
                                    ((block.shortDesc || $ctrl.customTitle) ?
                                        ('<div class="desc">{{!$ctrl.withButtons ? (\'No Archived \' + $ctrl.name) : \'' + ($ctrl.customTitle ? $ctrl.customTitle : block.shortDesc) + '\'}}</div>')
                                        : '') +
                                '</div>' +
                            '</div>' +

                            ($ctrl.customDesc ? ('<div class="body">' + $ctrl.customDesc +  '</div>'):
                            (block.desc ? ('<div class="body">{{!$ctrl.withButtons ? (\'Archived \'+$ctrl.name +\' will be moved here, where you can either restore or permanently delete them.\') : \'' + block.desc + '\'}}</div>') : '')) +

                            ($ctrl.canEdit && !block.hideButton ? ('<div ng-show="$ctrl.withButtons" class="spacing-quarter-top text-left empty-buttons-div">' + emptyStateButtons + '</div>') : '') +
                        '</div>' +
                        '<div class="right">' +
                /* '<vjs-video-container class="display-block clearfix" vjs-ratio="{{$ctrl.options.ratio}}" vjs-media="$ctrl.options.media" vjs-setup="$ctrl.options.setup">' +
                     '<video class="video-js vjs-default-skin vjs-big-play-centered vjs-paused vjs-controls-enabled vjs-workinghover vjs-v6 vjs_video_1-dimensions vjs-user-active" controls preload="auto"></video>' +
                 '</vjs-video-container>' +*/

                (block.emptyStateImage ? (
                    '<img src="' + $ctrl.LCS.getImgUrl('emptystate/' + block.type + '/emptystate.svg') + '"/>'
                ) : (
                    //'<iframe loading="lazy" src="' + block.videoUrl + '" width="{{$ctrl.isMobileView()?\'100%\':\'398\'}}" height="222" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>'
                    getVideo($ctrl, block)
                )) +
                '</div>' +
            '</div>';

        if (block.howToTitle || block.howToProps) {
            el += '<div class="how-to-block">';
            if (block.howToTitle) {
                el += '<div class="title">' + block.howToTitle + '</div>'
            }
            var cols = block.howToProps.length;
            if (cols > 0) {
                el += '<div class="blocks cols-' + cols + '">';
                _.each(block.howToProps, function (prop, i) {
                    if (prop) {
                        el += '<div class="block">';
                        el += '<div class="logo val-' + i + '" style="background-image:url(' +
                            $ctrl.LCS.getImgUrl('emptystate/' + block.type + '/' + (i + 1) + '.svg', false) +
                            ')"></div>';
                        if (prop.title) {
                            el += '<div class="title">' + prop.title + (prop.isPro ? '<span class="profeature with-margin-left">PRO</span>' : '') + '</div>';
                        }

                        if (prop.desc) {
                            el += '<div class="desc">' + prop.desc + '</div>';
                        }
                        el += '</div>';
                    }
                });

                el += '</div>';
            }
            el += '</div>';
        }
        if (block.tutorialUrl) {
            el += '<div class="video-frame">' +
                '<a href="' + block.tutorialUrl + '" target="_blank">' +
                '<div class="inner-frame table-div">' +
                '<div class="text-left centered">' +
                '<div class="with-margin-right pull-left icon-learn" style="height: 24px">' +
                '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">' +
                '<defs>' +
                '<linearGradient id="a" x1="50%" x2="50%" y1="0%" y2="100%">' +
                '<stop stop-color="#EE3D5B" offset="0%"/>' +
                '<stop stop-color="#F024A2" offset="100%"/>' +
                '</linearGradient>' +
                '</defs>' +
                '<path fill="url(#a)" d="M30,13 C23.3827826,13 18,18.3827826 18,25 C18,31.6172174 23.3827826,37 30,37 C36.6172174,37 42,31.6172174 42,25 C42,18.3827826 36.6172174,13 30,13 Z M26.8695652,30.2173913 L26.8695652,19.7826087 L35.7391304,25 L26.8695652,30.2173913 Z" transform="translate(-18 -13)"/>' +
                '</svg>' +
                '</div>' +
                '<div class="lightz inline-block">Learn how to create </div> <div class="semibold inline-block">' + block.name.toLowerCase() + '</div>' +
                '</div>' +
                '<div class="semibold with_underline centered">View Tutorials</div>' +
                '</div>' +
                '</a>' +
                '</div>'
        }
        el += '</div>' +
            '</div>';
        return el;

        function getButtons(block) {
            if (!block) {
                return '';
            }
            var m ='addItemBtn';
            var icon = $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left');
            if ($ctrl.addListOnEmptyState) {
                return '<button ' + ($ctrl.checkCustomListOnEmpty ? 'ng-show="$ctrl.isCustomList()" ' : '') +
                    'class="' + $ctrl.getBtnActionCls() + ' btn btn-primary big ' + $ctrl.pageClass + '" data-type="' + m + '" analytics-on analytics-action="New ' + $ctrl.nameForList + '">' + icon + ' New ' + $ctrl.nameForList + '</button>';

            }
            return '<button class="' + $ctrl.getBtnActionCls() + ' btn btn-primary without-text page-class ' + ($ctrl.pageClass ? $ctrl.pageClass : '') +
                (block.icon ? (' ' + block.icon) : '') + '" data-type="createFromTop" analytics-on analytics-action="Create ' + $ctrl.itemTitle + '">' + icon + ' New ' + $ctrl.itemTitle + '</button>' +
                ($ctrl.addListOnEmptyState ? ('<button class="' + $ctrl.getBtnActionCls() + ' btn btn-small transparent big with-margin-left" data-type="' + m + '">' + icon + ' New ' + $ctrl.nameForGroup + '</button>'
                ) : '');
        }
    }

    function bind($ctrl, isBind) {
        VideoService.bindVideo($ctrl, isBind);
    }
}

angular.module('group.item.more.component', [
    'item.more.controller.service'
])

.component('groupItemMorePopover', {
    bindings: {
        item: '<',
        onUpdate: '&',
        getTemplate: '&',
    },
    controller: 'GroupItemMorePopoverController',
})

.controller('GroupItemMorePopoverController', GroupItemMorePopoverController);

GroupItemMorePopoverController.$inject = ['$element', 'ItemMoreControllerService'] ;
function GroupItemMorePopoverController($element, ItemMoreControllerService) {
    var $ctrl = this;
    $ctrl = new ItemMoreControllerService($ctrl, $element, 'group-item-more-popover');
}

angular.module('group.search.drp.service', [
])
.service('GroupSearchDrpCtrlService', GroupSearchDrpCtrlService);
GroupSearchDrpCtrlService.$inject = [];
function GroupSearchDrpCtrlService() {
    return function ($ctrl, hasGroupSearchDrp) {

        $ctrl.searchInputCls = 'autosearch-' + $ctrl.itemType;

        $ctrl.btnSearchFilter = 'btnFilters';
        $ctrl.bindItemsSearch = bindItemsSearch;
        $ctrl.getItemSearch = getItemSearch;
        $ctrl.preventDefault = preventDefault;

        $ctrl.toggleDropdown = toggleDropdown;
        if(!$ctrl.onSearchSelected) {
            $ctrl.onSearchSelected = onSearchSelected;
        }
        if(!$ctrl.getSearchItemLi) {
            $ctrl.getSearchItemLi = getSearchItemLi;
        }

        if(!$ctrl.getSearchItemLi) {
            $ctrl.getSearchItemLi = getSearchItemLi;
        }

        return $ctrl;

        function getProfileParams(id){
            var p = {
                productId: $ctrl.CPS.productId ? $ctrl.CPS.productId : null
            }

            p[$ctrl.profileFieldId] = id;
//todo listID ????
            return p;
        }

        function onSearchSelected(id) {
            if (!id) {
                return null;
            }
            var name = $ctrl.SBStateService.getCurrentStateName();
            return $ctrl.CPS.transitionTo(name, $ctrl.CPS.currentPathParams(getProfileParams(id), $ctrl.CPS.isCollaborator ? $ctrl.CPS.rolePaths.collabPath : $ctrl.CPS.rolePaths.currentUserPath), {
                reload: false,
                notify: false,
                location: true
            });
        }

        function getSearchItemLi(item) {
            return '<div class="row-schedule border-top">' +
                '<div class="text-center">' + item[$ctrl.displayProp] + '</div>' +
                '</div>';
        }
        function getItemSearch(items) {
            $ctrl.searchGroupItems = items;
            //todo must update when changes appear for strip dayTime sceneType scene
            if (!$ctrl.searchGroupItems || $ctrl.searchGroupItems.length === 0) {
                return '';
            }

            var name = $ctrl.getSelectedSearch();

            if (!hasGroupSearchDrp) {
                return '<div class="pull-left table-div h-full title with-margin-right" style="height:32px"><div class="table-cell centered"><div class="with-ellipsis">' + name + '</div></div></div>';
            }

            return '<div class="btnSearchFilter pull-left position-relative dropdown dropdown-wrapper ' + $ctrl.itemType + '-wrapper">' +
                '<button id="' + $ctrl.btnSearchFilter + '" type="button" class="btn btn-small without-text transparent noborder semibold dropdown-toggle" aria-haspopup="true" aria-expanded="false" data-type="toggleDropdown">' +
                '<span class="pull-left">' + name + '</span> ' +
                $ctrl.LCS.getISBDiv('down-arrow', 2, 'pull-left') + '</button>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft fixedHeight ' + $ctrl.itemType + '-drp top-search-drp withsearch" role="menu">' +
                '<div class="search-field form-group sbfgroup field last withSearch left margin-bottom-quarter">' +
                $ctrl.LCS.getISBDiv('search') +
                '<input id="' + $ctrl.searchInputCls + '" type="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" class="form-control search full-length without-underline uppercase" placeholder="' + $ctrl.searchPlaceholder + '">' +
                '<div class="cancel-search"><a class="clear-search no-transition sb-hide">' + $ctrl.LCS.getISBDiv('cancel', 2, 'with-primary-hover') + '</a></div></div>' +
                '<div class="xchoices">' +
                '<div class="header-small clearfix">' + $ctrl.groupSearchTitle + '…</div>' +
                '<div class="margin-quarter show-scrollbar-on-hover">' +
                '<div class="fancy-scrollbar vertical strips-ul medium-template padding-right-0">' +
                '<div><div><ul></ul></div></div>' +
                '</div>' +
                '</div>' +
                '</div>' +
                '</div>' +
                '</div>';
        }

        function toggleDropdown(val, e) {
            var el = $ctrl.LCS.findClosestParent(e.currentTarget, '.dropdown');
            if (el) {
                $ctrl.LCS[$ctrl.LCS.hasClass(el, 'open') ? 'removeClass' : 'addClass'](el, 'open');
            }
        }

        function bindItemsSearch(isBind) {
            bindSearch(isBind);
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('#' + $ctrl.btnSearchFilter), toggleFilter, $ctrl.itemType);
            if (!isBind) {
                bindDrpRows(isBind);
            }

            function bindSearch(isBind) {
                if (!$ctrl.searchInput) {
                    $ctrl.searchInput = $ctrl.element.querySelector('#' + $ctrl.searchInputCls);
                }
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.searchInput, onSearch, $ctrl.itemType + '-input', 'blur keyup paste');

                if (isBind && !$ctrl.btnClearSearch) {
                    $ctrl.btnClearSearch = $ctrl.element.querySelector('.' + $ctrl.btnClearSearchCls);
                }
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnClearSearch, clearSearch, $ctrl.itemType + '-clear-input');
            }
        }

        function bindDrpRows(isBind) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('.xchoices li'), select, $ctrl.itemType + '-row');
            $ctrl.LCS.bindElementsClick(isBind, document, bodyHideFilter, $ctrl.itemType + '-hide');
        }

        function bodyHideFilter(e) {
            if (!$ctrl.LCS.hasChild($ctrl.element.querySelector('.' + $ctrl.itemType + '-drp'), e.target)) {
                showFilters(false);
            }
        }

        function toggleFilter(e) {
            $ctrl.preventDefault(e);
            showFilters();
        }

        function showFilters(val) {
            $ctrl.showFilters = val ? val : ($ctrl.showFilters ? false : true);
            loadItems($ctrl.showFilters);

            var method = $ctrl.LCS[$ctrl.showFilters ? 'addClass' : 'removeClass'];
            method($ctrl.element.querySelector('.' + $ctrl.itemType + '-drp'), 'sb-show');
            method($ctrl.element.querySelector('.' + $ctrl.itemType + '-wrapper'), 'open');

            if ($ctrl.showFilters) {
                setFocus();
            }

            function loadItems(showFilters) {
                var ul = $ctrl.element.querySelector('.' + $ctrl.itemType + '-drp ul');
                if (ul) {
                    if (showFilters) {
                        // empty();
                        $ctrl.LCS.appendChildFragment(ul, getItems());
                        bindDrpRows(true);
                    } else {
                        empty();
                    }

                    function empty() {
                        bindDrpRows(false);
                        $ctrl.LCS.emptyElement(ul);
                    }
                }
            }


            function getItems() {
                var els = '';
                _.each($ctrl.searchGroupItems, function (item) {
                    els += '<li class="strip-item with-overlay with-cursor ' + ($ctrl.isSelectedSearch(item) ? ' selected' : '') + '" data-id="' + item._id + '"><span class="with-no-padding">' + $ctrl.getSearchItemLi(item) + '</span></li>';
                });
                return els;
            }
        }

        function select(e) {
            console.log('select');
            $ctrl.onSearchSelected(e.currentTarget.getAttribute('data-id'));
            toggleFilter();
        }

        function clearSearch(e) {
            $ctrl.preventDefault(e);
            $ctrl.searchInput.value = null;
            processSearch();
            setFocus();
        }

        function onSearch(e) {
            console.log('search');
            if (e.type === 'paste') {
                $ctrl.preventDefault(e);
                processSearch();
                return;
            }
            switch (e.which) {
                case 13: //enter
                    processSearch();
                    $ctrl.preventDefault(e);
                    break;
                case 27: //esc
                    $ctrl.preventDefault(e);
                    clearSearch(e);
                    break;
                default:
                    processSearch();
                    e.stopPropagation();
                    break;
            }
        }

        function setFocus(ms) {
            ms ? $ctrl.LCS.timeout(set, ms) : set();

            function set() {
                if (!$ctrl.searchInput) {
                    $ctrl.searchInput = $ctrl.element.querySelector('#' + +$ctrl.searchInputCls);
                }
                if ($ctrl.searchInput) {
                    $ctrl.searchInput.focus();
                }
            }
        }

        function getChoicesEl() {
            if (!$ctrl.selectChoicesEl) {
                $ctrl.selectChoicesEl = $ctrl.element.querySelector('.xchoices');
            }
            return $ctrl.selectChoicesEl;
        }

        function processSearch() {
            var search = $ctrl.searchInput.value;
            if (search === '') {
                search = null;
            }
            if ($ctrl.search !== search) {
                $ctrl.search = search ? search.toUpperCase() : null;
            }

            if (!$ctrl.btnClearSearch) {
                $ctrl.btnClearSearch = $ctrl.element.querySelector('.' + $ctrl.btnClearSearchCls);
            }
            if ($ctrl.btnClearSearch) {
                $ctrl.LCS[$ctrl.search ? 'removeClass' : 'addClass']($ctrl.btnClearSearch, 'sb-hide');
            }

            var selectChoicesEl = getChoicesEl(),
                parent = selectChoicesEl.parentNode,
                exists = processList() > 0;
            $ctrl.LCS[exists ? 'removeClass' : 'addClass'](selectChoicesEl, 'sb-hide');
            var emptyBlock = parent.querySelector('.blockempty');
            if (!exists) {
                if (!emptyBlock) {
                    emptyBlock = $ctrl.LCS.createFragment(getEmptySearch());
                    parent.appendChild(emptyBlock);
                }
            }
            if (emptyBlock) {
                $ctrl.LCS[exists ? 'addClass' : 'removeClass'](emptyBlock, 'sb-hide');
            }

            function processList() {
                var count = 0;

                _.each($ctrl.searchGroupItems, function (item) {
                    if (item) {
                        for (var i = 0; i < $ctrl.searchFields.length; i++) {
                            var n = item[$ctrl.searchFields[i]];
                            var show = true;
                            if (!$ctrl.search || $ctrl.search && n && n.toUpperCase().indexOf($ctrl.search) !== -1) {
                                count++;
                            } else {
                                show = false;
                            }
                            $ctrl.LCS[show ? 'removeClass' : 'addClass'](selectChoicesEl.querySelector('li[data-id="' + item._id + '"]'), 'sb-hide');
                        }
                    }
                });
                $ctrl.LCS[count > 0 ? 'removeClass' : 'addClass'](selectChoicesEl, 'sb-hide');
                return count;
            }

            function getEmptySearch() {
                return '<div class="no-project withpopover centering spacing-half blockempty">' +
                    '<div class="centered circled-svg-colored small76 page-class ' + ($ctrl.pageClass ? $ctrl.pageClass : '') + '">' + $ctrl.searchEmptyIcon + '</div>' + '<p class="text-center desc margin-top-half">' + $ctrl.searchEmptyText + '</p>' +
                    '</div>';
            }
        }

        function preventDefault(e) {
            $ctrl.LCS.preventDefault(e);
        }
    }
}

function itemBlockGroupGridItemParams(bindings, controllerName, template) {
    return itemSimpleGroupGridComponentParams(_.extend({
        block: '@',
        listIndex: '<'
    }, bindings || {}), controllerName || 'GroupBlockGridItemCtrl', template, null);
}


function groupBlockComponentParams(controllerName, bindings) {
    return groupSimpleComponentParams(controllerName, _.extend({
        block: '@',
        currentListId: '@',
    }, bindings || {}));
}

angular.module('groupBlock.controller.service', [
    'groupSimple.controller.service',
    'groupBlock.item.controller'
])
//parent can define $ctrl.onOtherPopoverTypes
.service('GroupBlockInitCtrlService', GroupBlockInitCtrlService);
GroupBlockInitCtrlService.$inject = ['GroupSimpleInitCtrlService', 'FiltersService'];
function GroupBlockInitCtrlService(GroupSimpleInitCtrlService, FiltersService) {
    return function ($ctrl, $element, Pagination, constantsService, listOptionsService) {
        console.log('GroupBlockInitCtrlService');
        var isInit = false;
        $ctrl.isGroupBlock = true;
       // $ctrl.showSortingColumns = true;

       // $ctrl.constantsService = _.clone(constantsService);
        $ctrl.constantsService = angular.copy(constantsService);


        if(!$ctrl.block){$ctrl.block = $ctrl.objectType;}

        if ($ctrl.block === undefined) {
            console.warn('$ctrl.block must be defined in parent for GroupBlockInitCtrlService');
        }

        /*
        if ($ctrl.canEdit&&$ctrl.openEditSettings === undefined) {
            console.error('$ctrl.openEditSettings must be defined in parent for GroupBlockInitCtrlService');
        }
        */
        if($ctrl.expandMobileRowWithDetails === undefined) {
            $ctrl.expandMobileRowWithDetails = true;
        }
        if($ctrl.expandMobileRow === undefined) {
            $ctrl.expandMobileRow = true;
        }

        $ctrl.withoutPopover = true;

       // $ctrl.indexOrder = $ctrl.options.indexOrder !== undefined ? $ctrl.options.indexOrder : 0;

        if(!$ctrl.filtersService){
            $ctrl.filtersService = new FiltersService($ctrl.constantsService, listOptionsService, $ctrl.isPrintLayout);
        }

        $ctrl.getHeaderTitleAndIcon = getHeaderTitleAndIcon;

        if(!$ctrl.getLowerFilters){
            $ctrl.getLowerFilters = getLowerFilters;
        }

        if (typeof ($ctrl.getSideBorderCls) !== 'function') {
            $ctrl.getSideBorderCls  = getSideBorderCls;
        }

        if(!$ctrl.getMoreInfoBtnTemplate) {
            $ctrl.getMoreInfoBtnTemplate = getMoreInfoBtnTemplate;
        }

        if(!$ctrl.onReloadGroupTemplateOther) {
            $ctrl.onReloadGroupTemplateOther = onReloadGroupTemplateOther;
        }


        if($ctrl.LCS && typeof($ctrl.getGridFooter) === 'function'){
           $ctrl.LCS.addClass($element[0], 'with-footer');
        }
        $ctrl.onPostloadGroup = $ctrl.onPostloadGroup;

        if (Pagination) {
            if (typeof ($ctrl.onLoaded) !== 'function') {
                $ctrl.onLoaded = onLoaded;
            }
            if (!$ctrl.itemTitle) {
                $ctrl.itemTitle = $ctrl.block;
            }
            if (!$ctrl.tableClass) {
                $ctrl.tableClass = '.'+$ctrl.block + '.scenetable';
            }

            if (typeof ($ctrl.getColumnNamesRow) !== 'function') {
                $ctrl.getColumnNamesRow = getColumnNamesRow;
            }

            if (typeof ($ctrl.viewColumns) !== 'function') {
                $ctrl.viewColumns = viewColumns;
            }

            if (typeof ($ctrl.getGridHeader) !== 'function') {
                $ctrl.getGridHeader = getGridHeader;
            }

            if (typeof ($ctrl.getViewHeaderLeft) !== 'function') {
                $ctrl.getViewHeaderLeft = getViewHeaderLeft;
            }

            if (!$ctrl.getGroupTemplate) {
                $ctrl.getGroupTemplate = getGroupTemplate;
            }

            if (!$ctrl.getNewParams) {
                $ctrl.getNewParams = getNewParams;
            }

            if (!$ctrl.onSettingsChanged) {
                $ctrl.onSettingsChanged = onSettingsChanged;
            }

            $ctrl.getViewHeaderInitRight = getViewHeaderInitRight;

            if ($ctrl.canEdit && !$ctrl.remove) {
                $ctrl.remove = remove;
            }

            if (!$ctrl.onReloadGroupTemplate) {
                $ctrl.onReloadGroupTemplate = onReloadGroupTemplate;
            }

            if(!$ctrl.onItemPopoverChanged) {
                $ctrl.onItemPopoverChanged = onItemPopoverChanged;
            }

            if(!$ctrl.getCompiledGroupContentTemplate) {
                $ctrl.getCompiledGroupContentTemplate = getCompiledGroupContentTemplate;
            }
            $ctrl = new GroupSimpleInitCtrlService($ctrl, $element, Pagination, $ctrl.withoutPopover);
        }

        $ctrl.onGroupBlocksDestroy = onGroupBlocksDestroy;

        if (!$ctrl.$onDestroy) {
            $ctrl.$onDestroy = onGroupBlocksDestroy;
        }

        onPostloadGroup();

        return $ctrl;


        function onPostloadGroup() {
            if ($ctrl.canEdit) {
                $ctrl.addRootWatcher('GROUP_BLOCK_' + $ctrl.block + '_CHANGED', $ctrl.onSettingsChanged);

                $ctrl.addRootWatcher('GROUP_BLOCK_' + $ctrl.block + '_ADD', function () {
                    $ctrl.createNonNg();
                });
            }
        }

        function onSettingsChanged(updates) {
            console.log('onSettingsChanged');
            if (updates) {
                updateTitle(updates.title);
                updateHeader(updates, 'showHeader', '.gridheader')
                updateHeader(updates, 'showHeaderIcon', '.gridicon');
                updateColList( updates.columns);
                if($ctrl.onSettingsChangedOther){
                    $ctrl.onSettingsChangedOther(updates);
                }
            }
        }

        function updateColList(value) {
            console.log('updateColList');
            var prop = 'columns';
            if (value !== undefined && $ctrl.options[prop] !== value) {
                $ctrl.options[prop] = value;
                $ctrl.filtersService.setColumns(value);

                var header = $ctrl.element.querySelector('.row-schedule.header');
                if (header) {
                    header.innerHTML = getHeaderRowContent();
                }
                if($ctrl.updateColListOther){
                    $ctrl.updateColListOther();
                }

                $ctrl.broadcastListFiltersCols(value, $ctrl.block);
            }
        }

        function updateTitle(value) {
            var prop = 'title';
            if (value !== undefined && $ctrl.options[prop] !== value) {
                $ctrl.options[prop] = value;

                var el = $ctrl.element.querySelector('.txtTitle');
                if (el) {
                    el.innerText = value;
                }
            }
        }
        function updateHeader(updates, prop, selector) {
            var value = updates[prop];
            if (value !== undefined && $ctrl.options[prop] !== value) {
                $ctrl.options[prop] = value;
                var el = $ctrl.element.querySelector(selector);
                if (el) {
                    $ctrl.LCS[$ctrl.options[prop] ? 'removeClass' : 'addClass'](el, 'sb-hide');
                }
            }
        }

        function onItemPopoverChanged(result) {
            console.log('onItemPopoverChanged');
        }

        function getSideBorderCls(val) {
            return $ctrl.withoutSideBorderCls ? null : (' side-borders-' + (val !== undefined ? val : 2));
        }

        function onReloadGroupTemplate() {
            if (!isInit) {
                var cls = ($ctrl.templateClsOther ? $ctrl.templateClsOther : '') +
                    ( ' ' + $ctrl.getSideBorderCls($ctrl.styles ? $ctrl.styles.borders : undefined) + ' ') +
                    ($ctrl.otherCls ? $ctrl.otherCls : '');
                if ($ctrl.canEdit && !$ctrl.withoutGroupWhiteBg) {
                    cls += ' with-white-bg';
                }
                if (cls && cls.trim() !== '') {
                    $ctrl.LCS.addClass($ctrl.element, cls);
                }
                $ctrl.element.id = $ctrl.elementId;
            }

            if ($ctrl.canEdit) {
                setBtnMethods(false);
                if (!$ctrl.btnMethods) {
                    $ctrl.btnMethods = {};
                }
                $ctrl.btnMethods = _.extend($ctrl.btnMethods, {
                    'btnShow': 'toggleVisibility',
                    'btnEdit': 'openEditSettings'
                });

                for (var btn in $ctrl.btnMethods) {
                    var el = $ctrl.element.querySelector('.' + btn);
                    if (el) {
                        $ctrl[btn] = el;
                    } else {
                        delete $ctrl.btnMethods[btn];
                    }
                }

                $ctrl.btnShowF = $ctrl.element.querySelector('.btnShow .sbf');
                if ($ctrl.btnShowF) {
                    $ctrl.LCS.addClass($ctrl.btnShowF, $ctrl.options.show ? 'eye-hidden' : 'eye');
                }
                setBtnMethods(true);
            }

            if ($ctrl.onReloadGroupTemplateOther) {
                $ctrl.onReloadGroupTemplateOther(isInit);
            }

            isInit = true;
        }

        function onReloadGroupTemplateOther(isInit) {
            if (!$ctrl.canEdit && !$ctrl.list.items.length) {
                $ctrl.LCS.addClass($ctrl.element, 'sb-hide');
            } else {
                if (isInit) {
                    $ctrl.LCS.removeClass($ctrl.element, 'sb-hide');
                }
                if (!$ctrl.list.items.length) {
                    $ctrl.LCS.addClass($ctrl.element, 'hide-print');
                }
            }
        }

        function getGroupTemplate() {
            console.log('GroupBlockInitCtrlService.getGroupTemplate');
            return (($ctrl.canEdit || !$ctrl.canEdit && $ctrl.list.items && $ctrl.list.items.length > 0) ?
                    ('<div class="position-relative ' + $ctrl.groupContentCls + '" ' + ($ctrl.canEdit ? 'ng-show="$ctrl.list.isLoaded"' : '') + '></div>') : ''
                   ) +
                    (typeof ($ctrl.getGroupTemplateOther) === 'function' ? $ctrl.getGroupTemplateOther() : '');
        }

        function getCompiledGroupContentTemplate() {
            return $ctrl.canEdit ? getTemplate() :
                ((!$ctrl.list.items || !$ctrl.list.items.length) ? '' : ($ctrl.options && $ctrl.options.twoCols ? $ctrl.viewColumns() : getTemplate()));

            function getTemplate() {
                var items = $ctrl.getGroupItemsInit() +
                    ($ctrl.canEdit ?  (!$ctrl.isPrintLayout && typeof($ctrl.getGroupItemsOthers) === 'function' ? $ctrl.getGroupItemsOthers() : '') :''),
                    bottomActions = $ctrl.canEdit && typeof ($ctrl.getBottomActions) === 'function' ? $ctrl.getBottomActions() : '',
                    footer = typeof($ctrl.getGridFooter)==='function' ?   $ctrl.getGridFooter() : '';
            return  $ctrl.getGridHeader() +
                    '<div class="rewards-list1 fixed-layout full-width centering ' + ($ctrl.canEdit ? 'editMode' : $ctrl.groupWrapperName) + '"' +
                        ($ctrl.canEdit ? ' ng-show="$ctrl.list.items.length>0"' : '') +
                    '>' +
                        ($ctrl.showSortingColumns ? ('<div class="row-schedule full-width header">' + $ctrl.getGroupHeader() + '</div>') : $ctrl.getColumnNamesRow()) +
                        ($ctrl.canEdit ? ($ctrl.getInnerContent(items) + getNonCustomBtns()) : items) +
                    '</div>' +
                    ($ctrl.canEdit ? getBtnsEmpty() : footer);

                function getNonCustomBtns(){
                    return $ctrl.customButtons ?  '' : (
                        '<div class="hide-print table-bottom-actions font-general font-general-12' + ($ctrl.withoutSpacingForBottomAction ? '' : ' spacing-half-top') + '" >' +
                        '<div class="text-left">' + getInitBottomActions() + bottomActions + '</div>' +
                        '</div>');

                    function getInitBottomActions() {
                        return $ctrl.withoutInitBottomActions ? '' : ('<a tabindex="1" class="small inline-block semibold ' + getBtnInfo() + '"' +
                            //' ui-keyup="{enter:\'$ctrl.create()\'}"
                            '>' +
                            $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left with-margin-right') +
                            ' Add ' + $ctrl.itemTitle + '</a>');
                    }
                }

                function getBtnsEmpty(){
                    return $ctrl.canEdit ? ($ctrl.customButtons ? bottomActions: (
                        '<div class="ng-hide hide-print spacing" ng-show="$ctrl.list.items.length===0">' +
                        '<a type="button" class="schedule-btn text-center display-block centering    ' + getBtnInfo() + '">'+$ctrl.LCS.getISBDiv($ctrl.options.icon ? $ctrl.options.icon : 'plus', $ctrl.options.iconLevel ? $ctrl.options.iconLevel : 2, 'centered sbf28')+' <div>Add ' + $ctrl.itemTitle + '</div></a>'+
                        '</div>')) : '';
                }

                function getBtnInfo(){
                    var withNgClick = false;
                    return (withNgClick ? ('" ng-click="$ctrl.create()" ') :
                            ($ctrl.getBtnActionCls() + '" data-type="createNonNg" ')) +
                        'analytics-on analytics-action="Add ' + $ctrl.itemTitle;
                }
            }
        }

        function onLoaded(noMoreDataToLoad) {
            if (!noMoreDataToLoad) {
                console.log('loadmore');
                $ctrl.list.nextPage();
            }

            $ctrl.recount();
        }

        function viewColumns() {
            console.log('viewColumns: ' + $ctrl.block);
            var t = $ctrl.getGridHeader(),
                atLeast2 = $ctrl.list.items.length > 1;
            t += '<div class="tableblock hide-mobile">' +
                    getColumnNamesRow(atLeast2);

                    if (atLeast2) {
                       t += getEmpty() +
                            getColumnNamesRow(true);
                    }
            t += '</div>';

            t += '<div class="tableblock">' +
                processSide(true, atLeast2);

                if (atLeast2) {
                    t += getEmpty(true) +
                        processSide(false, true);
                }
            t += '</div>';

            return t;


            function processSide(isLeft, halfwidth) {
                return '<div class="tablecellblock ' + (halfwidth ? 'halfwidth' + (isLeft ?' left' : '') : 'fullwidth') + '">' +
                    $ctrl.getGroupItemsInit(isLeft, halfwidth) +
                    '</div>';
            }

            function getColumnNamesRow(halfwidth) {
             return '<div class="tablecellblock ' +
                 (halfwidth ? 'halfwidth' : 'fullwidth') + '"' +
                 (halfwidth ? ' style="border-top: 3px solid #E4ECF2"' : '') +
                 '>' +
                        '<div class="row-schedule full-width header ' + rowCls() + '">' +
                            '<div class="name-col col-first grow-column">Name</div>' +
                            '<div class="callsheet-time-col col60 view text-center col-last">Call</div>' +
                        '</div>' +
                    '</div>';
            }

            function getEmpty(hideMobile) {
                return '<div class="tablecellblock' + (hideMobile ? ' hide-mobile' : '') + '">&nbsp;</div>'
            }
        }

        function setBtnMethods(isBind) {
            if($ctrl.btnMethods) {
                for (var prop in $ctrl.btnMethods) {
                    $ctrl.LCS.bindElementsClick(isBind, $ctrl[prop], $ctrl[$ctrl.btnMethods[prop]], prop);
                }
            }
        }

        function onGroupBlocksDestroy() {
            if ($ctrl.canEdit) {
                setBtnMethods();
            }
            $ctrl.onInitGroupDestroy();
        }

        function rowCls() {
            return ($ctrl.rowClsOther ? $ctrl.rowClsOther() : '');
        }

        function getGridHeader() {
            return $ctrl.hideGridHeader && !$ctrl.canEdit ? '' : ('<div class="grid-header'+($ctrl.noBorderGridHeader ? ' no-border':'')+' "'+
                ($ctrl.canEdit ? 'ng-hide="$ctrl.hideGridHeader===true"' : '')+'>' +
                $ctrl.getViewHeaderLeft() +
                '<div class="advancedSchedule hide-print">' + getViewHeaderInitRight() + '</div>' +
                '</div>');
        }

        function getViewHeaderInitRight() {
            if (!$ctrl.canEdit) {
                return '';
            }
            return ''+
                // '<a class="btnShow btn btn-small primary-faded without-text with-margin-left inline-block '+$ctrl.pageClass+'" tooltip-placement="bottom" tooltip="Hide Grid">
                // <div class="text-center sbf centered"></div>
                // </a>' +
                (typeof ($ctrl.getViewHeaderRight) === 'function' ? $ctrl.getViewHeaderRight() : '') +
                '<button type="button" class="pull-right btnEdit btn btn-small navbtn primary-faded without-text with-margin-left inline-block"' +
                ($ctrl.settingsNoTooltip ? '' : (' tooltip-placement="bottom" tooltip="'+($ctrl.settingsName||'Settings')+'"')) +
                '>' +
                    $ctrl.LCS.getISBDiv( $ctrl.settingsIcon || 'cog', 2, 'text-center centered' + ($ctrl.settingsNoTooltip ? ' pull-left with-margin-right with-margin-left' :'')) +
                ($ctrl.settingsNoTooltip ? ($ctrl.settingsName||'Settings') : '') +
                '</button>';
        }

        function getHeaderTitleAndIcon(other){
        return '<div class="gridtitle">' +
                    ($ctrl.options.icon ?
                        $ctrl.LCS.getISBDiv($ctrl.options.icon,
                            $ctrl.options.iconLevel ? $ctrl.options.iconLevel : 5,
                            'gridicon pull-left with-margin-right8 gray ' +
                            ($ctrl.options.showHeaderIcon ? '' : 'sb-hide ')) : '') +
                    '<span class="txtTitle">' + $ctrl.options.title +'<span>' +
                    (other ? other : '') +
                '</div>';
        }

        function getViewHeaderLeft() {
            //    ('h2.grid_title', 'color', '')
            //     ('h2.grid_title', 'border-bottom-color', '');
            if(!$ctrl.options.title){return '';}
            return '<h2 class="grid-title clearfix">' + $ctrl.getHeaderTitleAndIcon($ctrl.getLowerFilters()) + '</h2>';
        }


        function getLowerFilters() {
            return !$ctrl.canEdit && !$ctrl.hideCounter && $ctrl.list.items.length > 1 ? (' <span class="subt">' + $ctrl.getCounterBlock($ctrl.hideCounter, 'inline-block') + '</span>') : '';
        }

        function getHeaderRowContent() {
            var isHeader = true;
            return $ctrl.processListItemColumns(null, isHeader, false, undefined, undefined, null).content +
                ($ctrl.getMoreBtnTemplate ? $ctrl.getMoreBtnTemplate(isHeader, null) : '');
        }

        function getColumnNamesRow() {
            if($ctrl.hideGridHeader || $ctrl.isGridView){return '';}
            var cls = rowCls();
            return '<div class="gridheader row-schedule full-width header hide-ipad ' +
                ($ctrl.withoutBorderBottom? '':'border-bottom ') +
                ($ctrl.options.showHeader ? '' : 'sb-hide ') +
                cls + '">' + (typeof ($ctrl.getHeaderRowFront) === 'function' ? $ctrl.getHeaderRowFront() :'') + getHeaderRowContent() +
                '</div>'; //set grow-column
        }

        function updateCache(item, method) {
           return $ctrl.preLoadingService ? $ctrl.preLoadingService.modify($ctrl.preLoadingTableName, item, $ctrl.preLoadingService.Ops[method]) : item;
        }


        function remove(item) {
            console.log('GroupBlockInitCtrlService.remove');
            var method = 'Remove';
         /*   var block = $ctrl.list.getElementBlockById(item._id);
            if (block.index === -1) {
                return onError(null, method);
            }
            var item = block.item;*/
            $ctrl.service.delete($ctrl.getRemoveParams ? $ctrl.getRemoveParams(item) : item, onsuccess, onerror);

            function onsuccess(result) {
                var id = result && result.item ? result.item._id : null,
                    i = _.findIndex($ctrl.list.items, function (item){
                        return item._id === id;
                    });
                if(i !== -1){
                    var del = result && result.changes && result.changes[$ctrl.currentListId] ? result.changes[$ctrl.currentListId].del : null;
                    if(del && del.length > 1){
                        _.each(del, function (id){
                           var index = _.findIndex($ctrl.list.items, function (item) {
                               if (item._id === id) {
                                   updateCache(item, method);
                                   return true;
                               }
                               return false;
                           });
                            $ctrl.list.removeElementByIndex(index);
                        });
                    } else{
                        $ctrl.list.removeElementByIndex(i);
                        updateCache(result.item, method);
                    }

                    if(result.updates) {
                        var res = {
                            type: result.type,
                            updates: _.extend({}, result.updates)
                        };
                        $ctrl.processUpdates(res, true, false, false, false, result);
                    }

                    //see if necessary
                    $ctrl.setCounter();
                    if (i > 0) {
                        $ctrl.setTabFocus(i - 1, 1);
                    }
                    if(typeof($ctrl.onRemoved) === 'function') {
                        $ctrl.onRemoved(result, i - 1);
                    }
                }
            }

            function onerror(error) {
                onError(error, method);
            }
        }

        function onError(error, method) {
            $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.' + $ctrl.block + '.' + method + '.error', 'error');
        }

        function getNewParams(after, type) {
            return {_id: new ObjectId().toString()};
        }

        function getMoreInfoBtnTemplate(isHeader, item) {
            return {
                count: $ctrl.editInlineOnMobile && $ctrl.isMobileView() ? 2 : 1,
                content: isHeader ? '' : (($ctrl.editInlineOnMobile ? g('edit', 'Edit', 'pencil', 'visible-xs hide-print') : '') +
                    g('remove', 'Remove', $ctrl.btnRemoveIcon ? $ctrl.btnRemoveIcon : 'trash'))
            };

            function g(type, name, icon) {
                return '<a class="btn'+name+' inline-block gray-light editable-btn btn ' + $ctrl.getClickEventName(type) + '" tooltip-placement="bottom" tooltip="'+name+'">' + $ctrl.LCS.getISBDiv(icon, 2, 'gray') + '</a>'
            }
        }
    }
}


angular.module('groupSimpleForRow.controller.service', [
    'components.fileUploader.sbResizableImg.service'
])
.service('GroupSimpleForRowCtrlService', GroupSimpleForRowCtrlService);
GroupSimpleForRowCtrlService.$inject = ['ImageUploaderService', 'BlocksSetupService'];
function GroupSimpleForRowCtrlService(ImageUploaderService, BlocksSetupService) {
    return function ($ctrl) {
        $ctrl.ImageUploaderService = ImageUploaderService;
        $ctrl.BlocksSetupService = BlocksSetupService;

        setCurrentList();

        $ctrl.$onChanges = $onChanges;

        if(!$ctrl.getHeaderColumnText) {
            $ctrl.getHeaderColumnText = getHeaderColumnText;
        }
        if (!$ctrl.isMobileView) {
            $ctrl.isMobileView = isMobileView;
        }

        if(typeof ($ctrl.getColumnsFilterService) !== 'function'){
            $ctrl.getColumnsFilterService = getColumnsFilterService;
        }

        if (typeof ($ctrl.getSettingsColumns) !== 'function') {
            $ctrl.getSettingsColumns = getSettingsColumns;
        }

        if (typeof ($ctrl.processListItemColumns) !== 'function') {
            $ctrl.processListItemColumns = processListItemColumns;
        }

        if (!$ctrl.getColumnByProp) {
            $ctrl.getColumnByProp = getColumnByProp;
        }

        if (!$ctrl.getColumnByPropType) {
            $ctrl.getColumnByPropType = getColumnByPropType;
        }

        if (!$ctrl.getHeaderColumnContent) {
            $ctrl.getHeaderColumnContent = getHeaderColumnContent;
        }

        $ctrl.showColumn = showColumn;

        $ctrl.getColumnsList = getColumnsList;
        $ctrl.getDisplayItemCol = getDisplayItemCol;
        $ctrl.getAddress = getAddress;
        $ctrl.getAdjustRoles = getAdjustRoles;

        if (!$ctrl.getGridItemTemplate) {
            $ctrl.getGridItemTemplate = getGridItemTemplate;
        }

        if(!$ctrl.processListItemColumn){
            $ctrl.processListItemColumn = processListItemColumn;
        }

        if(!$ctrl.processListItemColumnInit) {
            $ctrl.processListItemColumnInit = processListItemColumn;
        }

        if(!$ctrl.processListViewItem) {
            $ctrl.processListViewItem = processListViewItem;
        }

        if(!$ctrl.isLoadOnlySelected) {
            $ctrl.isLoadOnlySelected = isLoadOnlySelected;
        }

        if(!$ctrl.showColumnCond) {
            $ctrl.showColumnCond = showColumnCond;
        }

        if(!$ctrl.showPrefrontRow) {
            $ctrl.showPrefrontRow = showPrefrontRow;
        }

        if(!$ctrl.openSinglePopup) {
            $ctrl.openSinglePopup = openSinglePopup;
        }

        if(!$ctrl.goToSinglePage) {
            $ctrl.goToSinglePage = goToSinglePage;
        }
        if(!$ctrl.viewSingleItemParams) {
            $ctrl.viewSingleItemParams = viewSingleItemParams;
        }

        if(!$ctrl.processChildPage) {
            $ctrl.processChildPage = processChildPage;
        }

        if(!$ctrl.getOperationName) {
            $ctrl.getOperationName = getOperationName;
        }

        if(!$ctrl.getClsCol) {
            $ctrl.getClsCol = getClsCol;
        }

        if(!$ctrl.getClickEventName) {
            $ctrl.getClickEventName = getClickEventName;
        }

        if(!$ctrl.getGroupItemComponent) {
            $ctrl.getGroupItemComponent = getGroupItemComponent;
        }

        if(!$ctrl.getGroupItemInfo){
            $ctrl.getGroupItemInfo = getGroupItemInfo;
        }

        if(!$ctrl.hasSortableForItem){
            $ctrl.hasSortableForItem = hasSortableForItem;
        }

        if (!$ctrl.getItemImageSize) {
            $ctrl.getItemImageSize = getItemImageSize;
        }

        if (!$ctrl.getItemImageArea) {
            $ctrl.getItemImageArea = getItemImageArea;
        }

        if (!$ctrl.getImageTemplate) {
            $ctrl.getImageTemplate = getImageTemplate;
        }

        if (!$ctrl.canEditItem) {
            $ctrl.canEditItem = canEditItem;
        }

        if (!$ctrl.hasUserPermissionToEdit) {
            $ctrl.hasUserPermissionToEdit = hasUserPermissionToEdit;
        }

        if (!$ctrl.isActiveItem) {
            $ctrl.isActiveItem = isActiveItem;
        }

        if (typeof ($ctrl.isActiveFilter) !== 'function') {
            $ctrl.isActiveFilter = isActiveFilter;
        }

        $ctrl.processChildPage();

        return $ctrl;

        function $onChanges(changes) {
            if (!changes) {
                return;
            }
            var field = 'currentListId';
            var change = changes[field];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                console.log('$onChanges: changedField = ' + field + '; val: ' + change.currentValue);
                setCurrentList();
            }
        }

        function setCurrentList(){
            if($ctrl.currentListId === 'null'){
                $ctrl.currentListId = null;
            }

            if($ctrl.currentListId === 'undefined'){
                $ctrl.currentListId = undefined;
            }
        }
        function isMobileView() {
            return $ctrl.noListModeOnMobile ? false : ($ctrl.LCS.isMobileSize || $ctrl.isMobileMode); //callsheet
        }

        function showColumnCond(item){
            return !$ctrl.isGridView;
        }
        function showColumn(item, c, isHeader, isMobile, notTextOnly) {
            if(!c){return false;}

            var show ='';

            if(notTextOnly){
                if(c && c.hidePrint && $ctrl.isPrintLayout){
                    show = false;
                } if(c && c.showPrint && $ctrl.isPrintLayout){
                    show = true;
                } else {
                    show = $ctrl.showColumnCond(item) &&
                        !(!c.showMobile && isMobile ||
                            isHeader && c.hideHeaderColumn ||
                            isHeader && (c.hideHeaderColumn ||
                                $ctrl.isPrintLayout && c.hideHeaderColumnOnPrint) ||
                            (c.notInList || $ctrl.isPrintLayout && c.notInListOnPrint) ||
                            c.isListSubtitle && !isMobile ||
                            c.isMobileSubtitle && isMobile
                        );
                }
            }else{
                show = !c.notInList || c.isInTextOnly;
            }
            if(!show){return false;}
            return typeof($ctrl.showColumnOther) === 'function' ? $ctrl.showColumnOther(item, c, isHeader, isMobile, notTextOnly) : true;
        }

        function isLoadOnlySelected(item){
            return true;
        }

        function getListColsForItem(item, isHeader, textOnly, isMobile, isMobileRowDetails){
            var list = _.sortBy($ctrl.getColumnsList(isMobileRowDetails, $ctrl.isLoadOnlySelected(item)), 'order');

            if (!list || !list.length) {return null;}

            var nl = [];
            _.each(list, p);
            return _.filter(nl, filter);

            function filter(c1) {
                if (!c1 || textOnly && c1.type === $ctrl.SBFieldTypesService.PropTypes.Picture) {
                    return false;
                }
                var show = $ctrl.showColumn(item, c1, isHeader, isMobile, !textOnly && !isMobileRowDetails);

                if (show && isMobileRowDetails && typeof ($ctrl.showColumnMobileView) === 'function') {
                    show = show && $ctrl.showColumnMobileView(item, c1);
                }
                return show;
            }

            function p(c1) {
                if(!textOnly ){
                    c1 = _.extend({}, c1, isMobile ? {
                        canEdit: false,
                        canChangeOnEdit: !$ctrl.isPrintLayout && (c1.canEdit || c1.canChangeOnEdit),
                        viewRowListMobile: true
                    } : {
                        withLabel: null
                    });

                    if(isMobileRowDetails){
                        c1 = _.extend({}, c1, {
                            viewRowDetailsMobile: true,
                            fieldClass: null,
                            withoutIcon: true,
                            withInlineLabel: false,
                            withLabel: true
                        });

                        if (c1.type === $ctrl.SBFieldTypesService.PropTypes.HtmlTooltip) {
                            c1.type = $ctrl.SBFieldTypesService.PropTypes.Html;
                        }
                    }else {
                        var l = isMobile ? ['isMobileTitle', 'isMobileSubtitle'] : ['isListTitle', 'isListSubtitle'];
                        if (c1[l[0]]) {
                            var c = _.find($ctrl.columnsList, function (c) {
                                return c[l[1]];
                            });
                            if (c) {
                                if(c.canEdit || c.canChangeOnEdit) {
                                    c1.subtitleColProp = c.prop;
                                }
                                c1.subtitleColContent = $ctrl.SBFieldTypesService.getSBFieldContentView($ctrl, item, _.extend({}, c, {
                                    hideEmptyContent: true,
                                    withoutIcon: true
                                })).content;
                            }
                        }
                    }
                }
                nl.push(c1);
            }
        }

        function processListItemColumns(item, isHeader, textOnly, isMobile, isMobileRowDetails, depId) {
            var canEdit = !isHeader && $ctrl.canEdit && (isMobileRowDetails ? false : true);

            if(typeof($ctrl.canEditItem) === 'function'){
                canEdit = canEdit && $ctrl.canEditItem(item);
            }

            if(isMobile === undefined) {
                isMobile = $ctrl.isMobileView();
            }

            var title, subtitle, img,
                elCols = [],
                colIndex = 0,
                listCols = getListColsForItem(item, isHeader, textOnly, isMobile, isMobileRowDetails),
                l = listCols && listCols.length ? listCols.length :0,
                hasGrow = !isMobile || isMobile && _.find(listCols, {grow: true})!==undefined;

            var index = 1;
            if(l){
                _.each(listCols, isMobileRowDetails ? processColumnMobileRow : processColumn);
            }

            return {
                content: textOnly ? elCols : elCols.join(''),
                title: title,
                subtitle: subtitle,
                img: img
            };

            function processColumn(c1, i) {
                if(!c1){return;}
                var p = null;

                if(isMobile  ) {
                    if (!textOnly) {
                        p = {};
                        if (c1.isMobileTitle && !hasGrow) {
                            p.grow = true;
                        }
                    }
                } else if(!hasGrow && l - 1 === i) {
                    p = {};
                    p.grow = true;
                }

                var c = _.extend({}, c1, p),
                    isFirst = colIndex === 0,
                    isLast = colIndex === (l - 1),
                    other = '';

                if(depId !== undefined && depId !== null){
                    c.depId = depId;
                }

                if(!textOnly) {
                    if (typeof ($ctrl.getColClsBorders) === 'function') {
                        other += $ctrl.getColClsBorders(item, c, isFirst, isLast, isMobile) + ' ';
                    }
                    if(isFirst) {
                        other += $ctrl.hasRowFront ? ' without-border-left ' : '';
                    }

                    c.colCls = (c.colCls || '') +  ' rc_' + c.id.replace('.','');
                    index++;

                    var cls = $ctrl.getClsCol(c, isLast) + (other ? (' ' + other) : '');
                    if (listCols.length === 1 && cls.indexOf('grow-column') === -1) {
                        cls += ' grow-column ';
                    }
                }

                if(canEdit){
                    c.withInlineLabel = false;
                }

                var info = (isHeader ? $ctrl.processListHeaderColumn : $ctrl.processListItemColumn)(item, !isHeader && canEdit,  c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);
                elCols.push(info);
                colIndex++;
            }

            function processColumnMobileRow(c) {
                if (c.type === $ctrl.SBFieldTypesService.PropTypes.Picture) {
                    img = '<div class="col75 centered position-relative">' +
                        $ctrl.ImageUploaderService.generateDisplayImage(item, _.extend({}, c, {imgSize: 'intermedium'})) +
                        '</div>';
                } else {
                    if (c.type === $ctrl.SBFieldTypesService.PropTypes.Address) {
                        c.formattedAddress = true;
                    }

                    if (c.viewOn2Lines !== false && (c.type === $ctrl.SBFieldTypesService.PropTypes.Html ||
                        c.type === $ctrl.SBFieldTypesService.PropTypes.Contenteditable ||
                        c.type === $ctrl.SBFieldTypesService.PropTypes.Address)) {
                        c.viewOn2Lines = true;
                    }

                    //todo test if is k
                    //var val = $ctrl.getDisplayItemCol(item, c, 'label-content', false);
                    //item, c,      cls,       isFirst, isLast, canEdit, textOnly, isMobileView
                    //listViewMode

                    var isFirst = false,
                        isLast = false;

                    if(c.isMobileTitle || c.isMobileSubtitle) {
                        var v = p(_.extend({}, c, {wrapperClass: 'centered'}), '');
                        if (c.isMobileTitle) {
                            title = v;
                        } else if (c.isMobileSubtitle) {
                            subtitle = v;
                        }
                    }
                    c.withEllipsis = false;

                    var val = p(c, 'label-content');
                    if(val !== '') {
                        val = val.replace('text-center', '');

                        var viewOn2Lines = c.viewOn2Lines && val && val.replace(/(<([^>]+)>)/ig, '') !== '–';
                        val.replace('centered', viewOn2Lines ? '' : 'div-right');

                        elCols.push('<div class="details-item full-width ' + (viewOn2Lines ? 'two-lines' : 'table-div') + '">' +
                            getheader(viewOn2Lines ? 'full-width' : 'col50p ') +
                            (viewOn2Lines ? val.replace('centered', '') : val.replace('label-content', 'label-content grow-column text-right').replace('centered', 'div-right')) +
                            '</div>');
                        colIndex++;
                    }

                    function p(c, cls) {
                        if(!c){return '';}
                        return $ctrl.processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);
                    }
                }

                function getheader(cls) {
                    return '<div class="label-header ' + cls + '">' + $ctrl.getHeaderColumnContent(isMobileRowDetails, c) + '</div>';
                }
            }
        }

        function getHeaderColumnText(isMobileRowDetails, c) {
            return !isMobileRowDetails && c.headerName ? c.headerName : c.name;
        }

        function getHeaderColumnContent(isMobileRowDetails, c){
            return ''+//(c.icon ? $ctrl.LCS.getISBDiv(c.icon, 6, 'sbf14 pull-left with-margin-right gray') : '') +
                $ctrl.getHeaderColumnText(isMobileRowDetails, c);
        }

        function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails){
            if($ctrl.isPrintLayout){
                var r = c.printRelatedColumns;
                if(r){
                    var info = $ctrl.SBFieldTypesService.getSBFieldContentView($ctrl, item, c, textOnly),
                        v = info.content ? info.content : info.placeholder,
                        el = '';
                    _.each(r, function (prop) {
                        el += getNote(prop, textOnly, false, {wrapperClass: '', isNote: true});
                    });

                    return '<div class="' + cls +'">' +
                                '<div class="full-width clearfix">' +
                                    '<div class="' +
                                        (info.hasPlaceholderCls ? $ctrl.SBFieldTypesService.SBPlaceholderCls : '') +
                                        (c.fieldClass ? c.fieldClass : '') + ' ' +
                                        $ctrl.SBFieldTypesService.getViewEditElemSelector(c.prop, true, canEdit && c.canEdit) +
                                    '">' +
                                        (v ? ('<span class="' + $ctrl.SBFieldTypesService.SBViewContentCls +
(info.hasPlaceholderCls && (c.type === $ctrl.SBFieldTypesService.PropTypes.Html || c.type === $ctrl.SBFieldTypesService.PropTypes.Contenteditable) ? ' ql-editor' : '') + '">' + v + '</span>') : '')+
                                    '</div>' +
                                '</div>' +
                                el +
                            '</div>';


                } else if(c.notInListOnPrint){
                    return '';
                }

                function get(c, nCls){
                    return c ? $ctrl.getDisplayItemCol(item, c, nCls ? nCls : cls, canEdit, textOnly, isMobile, isMobileRowDetails) : '';
                }

                function getNote(prop, textOnly, isCenter, other) {
                    var n = $ctrl.getColumnByProp(prop),
                        isNote = other && other.isNote;

                    if (!n) {
                        return '';
                    }

                    var v = get(_.extend({}, n, {
                        hideEmptyContent: true,
                        fieldClass: n.fieldClass
                    }, other), ' ');

                    if ($ctrl.isPrintLayout && !v) {
                        return '';
                    }

                    return textOnly ? v : (
            n ? ('<div class="full-width ' + (isNote ? 'padding-top-5' : 'subtitle') + (isCenter ? ' text-center' : '') + '">'                              + (isNote ? '<div class="bold padding-top-8">' + n.name + ': </div>' : '') + v +
                    '</div>'
                    ) : '');
                }
            }

            var withS = isMobile || isMobileRowDetails;

            //there is no subtitle
            if(isMobileRowDetails && c.viewRowDetailsMobile || !c[withS ? 'isMobileTitle' : 'isListTitle']) {
                return $ctrl.getDisplayItemCol(item, c, cls, canEdit, textOnly, isMobile, isMobileRowDetails);
            }

            return $ctrl.getMobileTitleAndSubtitle(item, c, c.subtitleColContent, cls, false, textOnly, isMobile, isMobileRowDetails);
        }

        function getGridItemTemplate(item, depId, isMobileRowDetails) {
           //console.log('getGridItemTemplate ' + item._id);
           return ($ctrl.isGridView && typeof ($ctrl.processGridViewItem) === 'function') ? $ctrl.processGridViewItem(item) : $ctrl.processListViewItem(item, depId, isMobileRowDetails);
        }

        function showPrefrontRow(){
            return !$ctrl.isPrintLayout;
        }

        function processListViewItem(item, depId, isMobileRowDetails){
            var isMobile = $ctrl.isSides || $ctrl.isMobileView();
            if(isMobileRowDetails && !isMobile){
                isMobile = true;
            }
            var row = (typeof ($ctrl.getPreRowFront) === 'function' ? $ctrl.getPreRowFront(false, item,  $ctrl.showPrefrontRow()) : '') +
                      (typeof ($ctrl.getSortAndCheck) === 'function' ? $ctrl.getSortAndCheck(item) : '') +
            //cause crew is off on one side
                      (($ctrl.canEdit && $ctrl.withoutGroupSorting && $ctrl.withHandlePlaceholder) ? ('<div class="handle-col hide-print"></div>') : '') +
                      ((typeof ($ctrl.getRowFront) === 'function') ? $ctrl.getRowFront(item) : '') + //front
                      $ctrl.processListItemColumns(item, false, false, isMobile, isMobileRowDetails, depId).content +
                    (typeof ($ctrl.getMoreBtnTemplate) === 'function' ? $ctrl.getMoreBtnTemplate(false, item, isMobile) : ''),
                after = (typeof ($ctrl.getRowAfter) === 'function') ? $ctrl.getRowAfter(item, isMobile, isMobileRowDetails, 'logo') : '';
            return after ? ('<div class="rowschedulelike">'+(after ? row.replace('row-schedule', 'row-schedule with-after') : row)+'</div>' + after) : row;
        }

        function getDisplayItemCol(item, c, otherCls, canEdit, textOnly, isMobile, isMobileRowDetails) {
            canEdit = canEdit && !isMobile && !$ctrl.isPrintLayout && c.canEdit &&
                (!$ctrl.isActiveItem || typeof ($ctrl.isActiveItem) === 'function' && $ctrl.isActiveItem(item)) &&
                !c.withSinglePopup;
            var fieldClass = (c.fieldClass || '') +
    (c.withSinglePopup ? (' bluelink with_underline semibold' + ($ctrl.LCS.isTouchScreen ? ' ' : ' with-cursor ') + $ctrl.getClickEventName('openSinglePopup')) : '');

            return c ? $ctrl.SBFieldTypesService.getColDisplayEl($ctrl, item, _.extend({}, c, {
                canChangeOnEdit: !$ctrl.isPrintLayout && (c.canEdit || c.canChangeOnEdit),
                openPopup: c.openPopup && !isMobile,
                canEdit: canEdit,
                fieldClass: fieldClass
            }), otherCls ? otherCls : '', textOnly ? null : 'div') : (textOnly ? null : '');
        }

        function getAdjustRoles(item, canUpdate, depId, textOnly) {
            //console.log('ContactsGroupInitCtrlService.getAdjustRoles');
            return $ctrl.SBFieldMethods.getAdjustRoles($ctrl, item, canUpdate, depId, textOnly);
        }

        function getAddress(item, c, cls, hideEmptyContent) {
            return c &&( $ctrl.canEdit && (c.canEdit || c.canChangeOnEdit) || !$ctrl.canEdit && item[c.prop] )?
                getDisplayItemCol(item, _.extend({}, c, {
                    hideEmptyContent: c.hideEmptyContent || hideEmptyContent || $ctrl.isPrintLayout,
                    formattedAddress: true
                }), cls ? cls : '')  : '';
        }

        function getSettingsColumns (){
            return $ctrl.Settings.Columns;
        }

        function getColumnsList(sortedForPopup, loadOnlySelected) {
            var columns = $ctrl.getSettingsColumns();
            if(!columns){return null;}
            var list = [],
                listCols = $ctrl.getColumnsFilterService().listCols;

            for(var prop in columns){
                var c = columns[prop];
                if(c && (!loadOnlySelected || loadOnlySelected && _.find(listCols, function(c1){return c1.prop === c.prop;}))){
                    list.push(_.extend({}, c,
                        typeof($ctrl.getColumnListExt) === 'function' ? $ctrl.getColumnListExt(c) : null));
                }
            }

            return _.sortBy(list, function (c) {
                return sortedForPopup && c.orderModal ? c.orderModal : c.order;
            });
        }

        function getColumnByProp(prop, searchAllColumns) {
            return $ctrl.getColumnsFilterService().getColumnByProp(prop, searchAllColumns);
        }

        function getColumnByPropType(type, searchAllColumns) {
            return $ctrl.getColumnsFilterService().getColumnByPropType(type, searchAllColumns);
        }

        function getColumnsFilterService() {
            return $ctrl.filtersService;
        }

        function openSinglePopup(item) {
            viewSingleItem(item, true);
        }

        function goToSinglePage(item) {
           return viewSingleItem(item, false);
        }

        function viewSingleItemParams(item){
            return _.extend({
                    treeType: $ctrl.treeType,
                    productId: $ctrl.CPS.productId
                },
                $ctrl.onLoadDirectoryParams ? $ctrl.onLoadDirectoryParams(item) : null
            );
        }

        function viewSingleItem(item, isPopup) {
            console.log('viewSingleItem');
            if($ctrl.singlePopupQuota) {
                $ctrl.checkQuota($ctrl.singlePopupQuota, process);
            } else {
                process();
            }

            function process() {
                if(!isPopup){
                    p = $ctrl.CPS.currentPathParams(p, $ctrl.CPS.rolePaths.currentUserPath);
                    p[$ctrl.childListField] = item._id;
                    return $ctrl.CPS.openInNewWindow($ctrl.childListPage, p);
                }
                else //if (isPopup || !$ctrl.childListPage)
                {
                    var p = $ctrl.viewSingleItemParams(item);
                    $ctrl.popupsService.open(null, $ctrl.popupsService.operations['single' + $ctrl.getOperationName(item)], p, $ctrl.compOptions);
                }
            }
        }

        function processChildPage() {
            $ctrl.todoPage = $ctrl.BlocksSetupService.getCurrentTodoPage();
            $ctrl.childTodoPage = $ctrl.todoPage ? $ctrl.BlocksSetupService.getChildPage($ctrl.todoPage._id) : null;
            $ctrl.childListPage = $ctrl.childTodoPage ? $ctrl.childTodoPage.name : null;
            $ctrl.childListField = $ctrl.childTodoPage ? $ctrl.childTodoPage.uId : null;
        }

        function getOperationName(){
            return $ctrl.itemTitle;
        }

        function getClsCol(c, isLast, isHeader) {
            var cls = (c ? ((c.colCls ? c.colCls: '') + (c.grow ? ' grow-column' : '')) : '') +
                ($ctrl.getClsColOther ? $ctrl.getClsColOther(c, isLast, isHeader) : '');
            if(isHeader){
                cls = cls.replace('vtop', '');
            }
            return cls;
        }

        function getClickEventName(name) {
            return 'sb-click-' + name;
        }

        function getGroupItemComponent(canEdit, isEdit, depId, i, info, opts) {
            if(!opts){
                opts = {};
            }

            if (!info) {
                info = getGroupItemInfo(canEdit, isEdit, depId, opts);
            }

            return '<' + info.tag + ' ' + info.cls + ' ' + info.attrs + ' ' +
            (opts.groupItemInfo ? opts.groupItemInfo : getGroupItemComponentInfo(canEdit, isEdit, i ? i : 0) ) + ' ' +
            '></' + info.tag + '>';
            function getGroupItemComponentInfo(canEdit, isEdit, i){
                return isEdit ? ('ng-repeat="(listIndex, item) in $ctrl.list.items track by item._id" item="item"') :
                    ('item="' + ((canEdit||$ctrl.canLikeItems()) ? '' : '::') + '$ctrl.list.items[' + i + ']"');
            }
        }

        function getGroupItemInfo(canEdit, isEdit, depId, opts) {
            var tag = getgroupitemtag();
            return {
                tag: tag,
                cls: getgroupitemcls(tag),
                attrs: getGroupItemAttributes(),
            };

            function getgroupitemtag() {
                return ($ctrl.groupItemTag ? $ctrl.groupItemTag : $ctrl.elemType.toLowerCase()) + '-item-grid';
            }

            function getgroupitemcls(tag) {
                return (depId ? (' dep-id="' + depId + '" ') : '') +
                    ' class="clearfix dd-item ' + tag + ' ' +
                    ($ctrl.gridItemClass ? $ctrl.gridItemClass : 'productitemcolumn') + ' ' +
                    (opts.groupItemCls ? (opts.groupItemCls) : (
                        ((canEdit && $ctrl.isGroupBlock || !$ctrl.isGroupBlock) &&
                        !($ctrl.withoutGroupWhiteBg || $ctrl.isPrintLayout && $ctrl.withoutPrintGroupWhiteBg) ? ' with-white-bg ' : '') + ' ' + $ctrl.getItemImageSize(opts.isMobileLayout)
                    )) +
                    '" ';
            }

            function getGroupItemAttributes() {
                if(opts.currentListId === undefined){
                    opts.currentListId = ($ctrl.currentListId === 'All' || $ctrl.currentListId === 'Archived') && $ctrl.listField ? '{{::item[$ctrl.listField]}}' : $ctrl.currentListId;
                }

                if(!opts.columnsListName){
                    opts.columnsListName = 'columnsList';
                }

                if(!opts.columnsListVal){
                    opts.columnsListVal = $ctrl.getColumnsList(false, false);
                }

                $ctrl[opts.columnsListName] = opts.columnsListVal;

                if(opts.withSortable === undefined){
                    opts.withSortable = $ctrl.hasSortableForItem();
                    //withSortable = $ctrl.hasSortableInit() && $ctrl.withSortable ? 'true' : 'false';
                }

                if(opts.selectedFilter === undefined){
                    opts.selectedFilter = ($ctrl.withActiveGroup || $ctrl.withActiveTree) ? '$ctrl.filtersService.selectedFilter' : '::false';
                }

                if(opts.rowLoadLater === undefined){
                    opts.rowLoadLater = '!$ctrl.rowLoadNow&&!$ctrl.isPrintLayout';
                }

                if(opts.isMobileLayout === undefined){
                    opts.isMobileLayout = $ctrl.isMobileView();
                }

                if(opts.getGroupItemAttributes === undefined){
                    opts.getGroupItemAttributes = getGroupInitItemAttributes(depId);
                }

                opts.canEdit = $ctrl.canEdit;

               // console.log('getGroupItemAttributes');

                return 'current-list-id="' +  opts.currentListId+ '" ' +
                    'current-list-id-inherited="' + ($ctrl.currentList ? $ctrl.currentList._id : null) + '" ' +
                    'selected-filter="' + opts.selectedFilter + '" ' +

                    'with-sortable="::' + opts.withSortable + '" ' +
                    'row-load-later="::' + opts.rowLoadLater + '" ' +
                    'columns-list="::$ctrl.' + opts.columnsListName + '" ' +
                    'is-mobile-layout="::' + opts.isMobileLayout + '" ' +

                    'can-edit="::'+opts.canEdit+'" ' +

                    'comp-options="::$ctrl.compOptions" ' +
                    'service="::$ctrl.service" ' +
                    'pre-loading-service="::$ctrl.preLoadingService" ' +
                    'img-observer-service="::$ctrl.imgObserverService" ' +
                    'row-observer-service="::$ctrl.rowObserverService" ' +
                    'list-settings="::$ctrl.Settings" ' +

                    'on-actions="$ctrl.onGridItemActions(result)" ' +
                    'on-get-template="$ctrl.getGridItemTemplate(item, '+ (depId ? depId : null) + ',' + opts.isMobileRowDetails + ')" ' +
                    (typeof($ctrl.onImageLoaded) === 'function' ? 'on-image-loaded-other="$ctrl.onImageLoaded(result)" ' : '') +

                    'on-is-open-row="$ctrl.isToggleMobileRow(id)" ' +

                    (opts.getGroupItemAttributes  ? opts.getGroupItemAttributes : '');
            }
        }

        function getGroupInitItemAttributes(depId) {
            return 'is-grid-view="::' + ($ctrl.withGridView ? '$ctrl.isGridView' : 'false') +'" ' +
                ($ctrl.isGroupBlock ? ( 'block="' + $ctrl.block + '" ') : '') +
                //($ctrl.gridNested ? ' grid-nested="true" ' : '') +
                (typeof ($ctrl.getGroupItemAttributes) === 'function' ? $ctrl.getGroupItemAttributes(depId) : '');
        }

        function hasSortableForItem() {
            var show = ($ctrl.hasSortableInit() && $ctrl.withSortable && $ctrl.currentListId !== 'Archived') ? true : false;
            return show ? ($ctrl.hasSortableForItemOther ? $ctrl.hasSortableForItemOther() : true) : false
        }

        function getItemImageSize(isMobile){
            return isMobile ? 'smaller' : ($ctrl.isGridView ? 'medium' : 'smaller');
        }

        function getItemImageArea(c){
            return $ctrl.isGridView ? 'no-radius' : (c.areaType || 'square');
        }

        function getImageTemplate(item, c, other) {
            var isMobile = $ctrl.isMobileView(),
                canEdit = c.canEdit && $ctrl.canEditItem(item) && !isMobile;
            if (canEdit && typeof ($ctrl.canEditImage) === 'function') {
                canEdit = $ctrl.canEditImage(item, $ctrl.isGridView === true);
            }
            var cls = (canEdit ? 'with-cursor' : '') + ($ctrl.isGridView ? '' : ' centering') +
                    (isMobile ? ' vtop ' : ''),
                c1 = _.extend({}, c, {
                    cClassAttr: cls,
                    areaType: $ctrl.getItemImageArea(c),
                    variableSize: $ctrl.isGridView === true
                }, other);

            if(c1.variableSize) {
                c1.updateRatio = $ctrl.updateRatio;
            }
            if (!c1.imgSize) {
                c1.imgSize = $ctrl.getItemImageSize(isMobile);
            }

            if($ctrl.isMasonary){
                c1.withImgBg = false;
            }

            //no need to load the image later if the item is loaded later or is print layout
            if ($ctrl.rowLoadLaterS || $ctrl.isPrintLayout) {
                c1.loadLater = false;
            }

            if ($ctrl.isPrintLayout || $ctrl.LCS.isTouchScreen) {
                c1.withView = false;
                c1.canUploadAttr = false;
            } else if (canEdit) {
                c1.canUploadAttr = true;
            }

            if ($ctrl.getPicturePopupOtherProps) {
                c1 = _.extend(c1, $ctrl.getPicturePopupOtherProps(item));
            }

            return $ctrl.SBFieldTypesService.getSBColContentEdit($ctrl, c1, item._id);
        }

        function hasUserPermissionToEdit(item) {
            return $ctrl.mustBeAdminToEdit ? (item.createdById === $ctrl.CPS.userId ||
                $ctrl.CPS.memberType >= $ctrl.security.MemberTypes.Admin) : true;
        }

        function canEditItem(item) {
            return $ctrl.hasUserPermissionToEdit(item) &&
                $ctrl.isActiveFilter() &&
                $ctrl.isActiveItem(item);
        }

        function isActiveItem(item) {
            return item && $ctrl.canEdit && ($ctrl.withActiveGroup && item.active || !$ctrl.withActiveGroup);
        }
        function isActiveFilter() {
            return !($ctrl.withActiveGroup || $ctrl.withActiveTree) ||
                ($ctrl.withActiveGroup || $ctrl.withActiveTree) &&
                ($ctrl.filtersService.selectedFilter!==false) && $ctrl.currentListId !== 'Archived';
        }
    }
}

function itemSimpleGroupGridComponentParams(bindings, controllerName, template, rowClass) {
    return {
        bindings: _.extend({

            nestedLevel: '@',
            currentListId: '@',
            currentListIdInherited: '@',

            isMobileLayout: '<',
            canEdit: '<',

            withSortable: '<',
            selectedFilter: '<',

            compOptions: '<',
            service: '<',
            preLoadingService: '<',
            imgObserverService: '<',
            rowObserverService: '<',
            rowLoadLater: '<',

            listSettings: '<',
            columnsList: '<',
            isGridView: '<',

            //vars
            item: '<',

            //methods
            onActions: '&',
            onGetTemplate: '&',
            onImageLoadedOther: '&',
            onIsOpenRow: '&'
        }, bindings || {}),
        template: template || ('<div class="row-schedule ' + (rowClass?rowClass:'') + '"></div>'),
        controller: controllerName,
    }
}

function groupSimpleComponentParams(controllerName, bindings) {
    return {
        bindings: _.extend({
            constantsService: '<',
            preLoadingService: '<?',
            preLoadingTableName: '<?',

            canEdit: '<',
            selectedFilter: '<',

            compOptions: '<'
        }, bindings || {}),
        controller: controllerName,
    };
}

angular.module('groupSimple.controller.service', [
    'list.ctrl',
    'list.tree.service',
    'list.keyboard.service',
    'list.keyboard.init.controller.service',
    'list.keyActions.component',
    'group.keyActions.component',
    'list.base.component.service',
    'group.sbPopover.events.service',
    'group.item.more.component',
    'services.downloadExport',
    'groupSimpleForRow.controller.service',

    'groupBlock.empty-state.component',
    'observer.img.service',
    'observer.row.service',

    'templateCompile.actions.service'
])
.service('GroupSimpleInitCtrlService', GroupSimpleInitCtrlService);
GroupSimpleInitCtrlService.$inject = ['GroupSimpleForRowCtrlService', 'ListInitService', 'KeyboardListService', 'KeyboardListInitControllerService', 'PopoverInitEventsService', 'TemplateCompileService', 'TemplateCompileActionsService', 'CompInitCtrlService','SBFieldTypesService', 'RowObserverCtrlService', 'ImgObserverCtrlService', 'DownloadExportService', 'RouteCollaboratorsService'];
function GroupSimpleInitCtrlService(GroupSimpleForRowCtrlService, ListInitService, KeyboardListService, KeyboardListInitControllerService, PopoverInitEventsService, TemplateCompileService, TemplateCompileActionsService, CompInitCtrlService, SBFieldTypesService, RowObserverCtrlService, ImgObserverCtrlService, DownloadExportService, RouteCollaboratorsService) {
    return function ($ctrl, $element, Pagination, withoutPopover) {

        $ctrl.TemplateCompileService = TemplateCompileService;
        $ctrl.TemplateCompileActionsService = TemplateCompileActionsService;

        $ctrl.ImgObserverCtrlService = ImgObserverCtrlService;
        $ctrl.RowObserverCtrlService = RowObserverCtrlService;
        $ctrl.DownloadExportService = DownloadExportService;
        $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
        $ctrl.ListInitService = ListInitService;
        $ctrl.KeyboardListService = KeyboardListService;
        $ctrl.SBFieldTypesService = SBFieldTypesService;

        var observerOptions =  {
            childList: true,
            subtree: true
        };

        if(!$ctrl.initWrapperCls) {
            $ctrl.initWrapperCls = 'group-simple-wrapper';
        }

        $ctrl.itemHandleCls = 'as-sortable-item-handle';
        $ctrl.groupContentCls = 'group-content1';
        $ctrl.groupListCls = 'list list-group-items';
        $ctrl.isProcessing = false;
        $ctrl.withPageLoading = false;
        $ctrl.PAGE_LENGTH = 20;
        $ctrl.isLoadingPage = false;
        $ctrl.currentPage = 0;
        //$ctrl.counterCls

        $ctrl.emptySearchGroup = 'empty-search';

        $ctrl.onDestroy = onDestroy;

        if (!$ctrl.$onDestroy) {
            $ctrl.$onDestroy = onDestroy;
        }

        if (!$ctrl.compLoaded) {
            $ctrl = new CompInitCtrlService($ctrl);
        }

        $ctrl = new $ctrl.TemplateCompileActionsService($ctrl, $element);

        $ctrl.itemSelector = 'row-scheduleTemp' + '.' +  $ctrl.compInitId;
        $ctrl.element.setAttribute('component-id', $ctrl.compInitId);


        if (!$ctrl.rowObserverService) {
            $ctrl.rowObserverService = new $ctrl.RowObserverCtrlService($ctrl.watchers);
        }

        $ctrl.LikeFilter = [
            {value: 1, text: 'All Tasks'},
            {value: 2, text: 'Hide Completed'}
        ];

        if(!$ctrl.getBtnActionCls){
            $ctrl.getBtnActionCls = getBtnActionCls;
        }
        if(!$ctrl.getGroupName) {
            $ctrl.getGroupName = getGroupName;
        }
        if(!$ctrl.getGroupIcon) {
            $ctrl.getGroupIcon = getGroupIcon;
        }
        if(!$ctrl.hasRemovePermissions) {
            $ctrl.hasRemovePermissions = hasRemovePermissions;
        }
        if(!$ctrl.hasArchivePermissions) {
            $ctrl.hasArchivePermissions = hasArchivePermissions;
        }

        if(!$ctrl.getGroupHeader){
            $ctrl.getGroupHeader = getGroupHeader;
        }

        $ctrl = new GroupSimpleForRowCtrlService($ctrl);

        loadCompOptions();

