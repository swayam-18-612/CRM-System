angular.module('product.callsheet.skycon.component', [])
.component('skycon', {
    bindings: {
        icon: '@',
        size: '<',
        color: '@'
    },
    controller: 'SkyconCtrl'
})
.controller('SkyconCtrl', SkyconCtrl);
SkyconCtrl.$inject = ['LCS', '$element'];
function SkyconCtrl(LCS, $element) {
    var $ctrl = this;
    $ctrl.$element = $element;
    $ctrl.element = $element[0];

    $ctrl.$onInit = $onInit;
    //$ctrl.$onChanges = $onChanges;
    $ctrl.$onDestroy = $onDestroy;
    var changedFields = ['size', 'icon'];

    function $onChanges(changes) {
        if (!changes) {
            return;
        }
        for (var i = 0, l = changedFields.length; i < l; i++) {
            var field = changedFields[i],
                change = changes[field];
            if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                if (_.find(changedFields, function (item) {
                    return field === item;
                })) {
                    if (field === 'size') {
                        // watch the size property from the controller
                        onSizeChanged(change.currentValue);
                    } else {
                        // watch the icon property from the controller
                        onIconChanged(change.currentValue);
                    }
                }
                break;
            }
        }
    }

    function $onInit() {
        // make a canvas for our icon

        $ctrl.isRetina = LCS.isRetina() ? 2 : 1;
        $ctrl.canvas = document.createElement('canvas');
        onSizeChanged($ctrl.size);

        // set default color if "color" attribute not present
        var config = {};
        if ($ctrl.color) {
            config.color = $ctrl.color;
        }

        $ctrl.skycons = new Skycons(config);
        onIconChanged($ctrl.icon);
        $ctrl.skycons.play();

        if ($ctrl.element.nodeType === 8) {
            $ctrl.$element.replaceWith($ctrl.canvas);
        } else {
            $ctrl.element.appendChild($ctrl.canvas);
        }
    }

    function onSizeChanged(val) {
        $ctrl.canvas.height = val * $ctrl.isRetina;
        $ctrl.canvas.width = val * $ctrl.isRetina;
        if($ctrl.isRetina) {
            //$ctrl.canvas.getContext('2d').scale(2, 2);
        }
    }

    function onIconChanged() {
        if ($ctrl.icon) {
            try {
                $ctrl.skycons.set($ctrl.canvas, $ctrl.icon);
            } catch (e) {
                console.log('skycon error :' + e);
            }
        }
    }

    function $onDestroy() {
        if ($ctrl.skycons && $ctrl.canvas) {
            $ctrl.skycons.remove($ctrl.canvas);
            if ($ctrl.skycons.list && $ctrl.skycons.list.length) {
                $ctrl.skycons.pause($ctrl.canvas);
            }
        }
    }
}

angular.module('product.callsheet.weather.component', [
    'product.callsheet.skycon.component',
    'apiServices.Temperatures',
    'apiServices.Callsheets'
])

.component('weatherInfo', {
    bindings: {
        firstLoc: '<',
        block: '@',
        canEdit: '<',
        onChange: '&'
    },
    controller: 'WeatherCtrl'
}) 
.controller('WeatherCtrl', WeatherCtrl);
WeatherCtrl.$inject = ['TemperaturesService', 'TemplateCompileCompCtrlService', '$element'];
function WeatherCtrl(TemperaturesService, TemplateCompileCompCtrlService, $element) {
    console.log('WeatherCtrl');
    var $ctrl = this;
    $ctrl.TemperaturesService = TemperaturesService;
    $ctrl.local = {};
    $ctrl.prevItem = null;
    $ctrl.convert = convert;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;

    $ctrl.dontAutoloadTemplate = true;
    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {

        $ctrl.forecastIO = $ctrl.API_CONFIGS.forecastIO;
        if ($ctrl.forecastIO.enable) {
            $ctrl.isWS = false;
        } else {
            $ctrl.forecastIO = $ctrl.API_CONFIGS.weatherstack;
            if ($ctrl.forecastIO.enable) {
                $ctrl.isWS = true;
            } else {
                console.warn('Weather api is not enabled');
            }
        }

        $ctrl.optionsProp = 'top';
        setUnit();
        $ctrl.callsheet = $ctrl.CurrentProduct.getCallsheet();
        $ctrl.startDate = $ctrl.callsheet.startDate;
        $ctrl.options = $ctrl.callsheet.options[$ctrl.optionsProp][$ctrl.block];
        setCoordinates($ctrl.firstLoc);
        getWeather(true);
    }

    function postInit() {
        if($ctrl.canEdit) {
            $ctrl.addRootWatcher('WEATHER_ADDRESS_CHANGED', onAddressChanged);
            $ctrl.addRootWatcher('CALLSHEET_DATE_CHANGED', onCallsheetVarsChanged);
            $ctrl.addRootWatcher('CALLSHEET_TEMPLATE_CHANGED', onTemplateChanged);
            $ctrl.addRootWatcher('TEMP_FORMAT_CHANGED', onTempFormatChanged);
        }
    }

    function getItemTemplate() {
        if(!$ctrl.item && !$ctrl.canEdit){return '';}
        var t =  '<h2 class="grid-title visible-xs hide-print"><div class="full-width">Weather</div><div class="subt full-width">Prepare accordingly.</div></h2>' +
            '<hr class="with-hr margin-top-quarter"/>' +
            '<div class="weather-info">';
        if($ctrl.item){
            t += '<div ng-show="$ctrl.item" class="weather-section">' +
                    '<div>' +
                        '<div class="weather-degrees">' +
                            '<div class="weather-emoticon col40"><skycon class="skycon" icon="'+($ctrl.item.icon?$ctrl.item.icon:'')+'" size="32"></skycon></div>' +
                            '<div class="weather-high"><span>'+$ctrl.convert($ctrl.item.high)+'</span><span class="unit">&deg; ' + $ctrl.unit + '</span> </div>' +
                            '<div class="weather-low">/ <span>'+$ctrl.convert($ctrl.item.low)+'</span></div>' +
                        '</div>' +
                    '</div>';


            if($ctrl.options.showNote && $ctrl.item.note ) {
                t += '<div class="summary weather-sun italic">' + $ctrl.item.note + '</div>';
            }
            if ($ctrl.options.showSunrise && $ctrl.item.sunrise) {
                t += '<div class="weather-sun pull-left"><b>Sunrise</b> ' +
                    $ctrl.SBFieldMethods.getTime($ctrl.item.sunrise, $ctrl.CPS.timeFormat) +
                    '&nbsp;•&nbsp;<b>Sunset</b> ' +
                    $ctrl.SBFieldMethods.getTime($ctrl.item.sunset, $ctrl.CPS.timeFormat) +
                    '</div>';
            }
           t += '</div>';
        } else if($ctrl.canEdit){
        t += '<div class="weather-section">' +
                '<div>' +
                    '<div class="weather-degrees empty">' +
                        '<div class="weather-emoticon">'+$ctrl.LCS.getISBDiv('temperature', 2, 'gray')+'</div>' +
                        '<div class="weather-high">Tbd<span class="unit">&deg; ' + $ctrl.unit + '</span> </div>' +
                        '<div class="weather-low">/ Tbd</div>' +
                    '</div>' +
                '</div>' +
                '<div class="weather-sun pull-left"><i>Weather details will be updated once you enter a Shooting Location. There is a 15 days forecast.</i></div>' +
            '</div>';
        }

        t += '</div>';

        return t;
    }

    function convert(value) {
        return $ctrl.unit === 'C' ? Math.round((value - 32) * 5 / 9) : value;
    }

    function onTempFormatChanged() {
        setUnit();
        $ctrl.reloadTemplate();
    }

    function onAddressChanged(firstLoc) {
        setCoordinates(firstLoc);
        getWeather(false);
    }

    function setCoordinates(firstLoc) {
        $ctrl.coordinates = firstLoc && firstLoc.address && firstLoc.address.geoloc ? firstLoc.address.geoloc : null;
    }

    function onTemplateChanged() {
        $ctrl.callsheet = $ctrl.CurrentProduct.getCallsheet();
        $ctrl.options = $ctrl.callsheet.options[$ctrl.optionsProp][$ctrl.block];
        getWeather(false);
    }

    function onCallsheetVarsChanged(startDate) {
        console.log('CALLSHEET_DATE_CHANGED');
        $ctrl.startDate = startDate;
        getWeather(false);
    }

    function getWeather(isInit) {
        if (!$ctrl.coordinates || !$ctrl.coordinates.lat || !$ctrl.coordinates.lat) {
            if (isInit) {$ctrl.reloadTemplate();}
            return;
        }

        if (($ctrl.local.coordinates !== $ctrl.coordinates || $ctrl.local.date !== $ctrl.startDate) && !$ctrl.isSearching) {
            $ctrl.isSearching = true;
            var timestamp = $ctrl.MomentService.getDateISOFromMoment($ctrl.startDate), //2016-01-30T08:00:00Z
                name = $ctrl.coordinates.lat + ',' + $ctrl.coordinates.lng + ',' + timestamp;

            $ctrl.TemperaturesService.queryAndPopulate({name: name, ws: $ctrl.isWS},null, null, function (result) {
                result = result.docs;
                var weather = result && result.length > 0 ? $ctrl.TemperaturesService.convertResource(result[0]) : null;
                $ctrl.prevItem = weather;
                var run = false;
                if (!weather || weather && weather.ws !== $ctrl.isWS) {
                    run = true;
                }else {
                    var now = $ctrl.MomentService.utc(new Date()).unix(),
                        h = 3600 * 2; //update every 2 hours
                    if ($ctrl.MomentService.utc(timestamp) > now && (now - weather.lastChecked > h)) {
                        run = true;
                    }
                }

                if (!run) {
                    return onError('loading from previous weather');
                }

                getFromAPI(name);
            }, function (error) {
                getFromAPI(name);
            });
        }
    }

    function setUnit() {
        $ctrl.unit = $ctrl.CPS.temperature ? $ctrl.CPS.temperature.toUpperCase() : 'F';
    }

    function onError(error) {
        $ctrl.item = $ctrl.prevItem && $ctrl.prevItem.ws === $ctrl.isWS ? $ctrl.prevItem.weather : {};
        $ctrl.isSearching = false;
        $ctrl.reloadTemplate();
        console.log(error);
    }

    function getFromAPI(name) {
        if (!name) {
            return;
        }
        $ctrl.item = null;

        var params = $ctrl.isWS ? getWeatherstackIO(name) :  getForecastIO(name);

        if (!params) {
            return onError();
        }

        $.ajax({
            dataType: 'jsonp',
            url: params.url,
            data: params.data,
            success: function (response) {
                onSuccess(response, params.getItem);
            },
            error: onError
        });

        function onSuccess(response, getItem) {
            $ctrl.isSearching = false;

            var hasError = getItem(response);

            if (hasError) {
                return onError('error getting weather response');
            }

            $ctrl.local = {
                coordinates: $ctrl.coordinates,
                date: $ctrl.startDate
            };

            $ctrl.reloadTemplate();

            console.log($ctrl.item);

            var params = $ctrl.TemperaturesService.convertResource({
                ws: $ctrl.isWS,
                weather: $ctrl.item,
                lastChecked: $ctrl.MomentService.utc(new Date()).unix()
            });

            if ($ctrl.prevItem) {
                params._id = $ctrl.prevItem._id;
                $ctrl.TemperaturesService.update(params, function (result) {
                    console.log('success updating the weather in db');
                }, function (error) {
                    console.log('error updating the weather in db');
                });
            } else {
                params.name = name;
                $ctrl.TemperaturesService.insert(params, function (result) {
                    var item = result.item;
                    if (item) {
                        $ctrl.onChange({
                            updates: {
                                temperatureId: item._id
                            }
                        });
                    }
                    console.log('success inserting the weather in db');
                }, function (error) {
                    console.log('error inserting the weather in db');
                });
            }
        }

        function getForecastIO(name) {
            return {
                url: $ctrl.forecastIO.url + '/' + $ctrl.forecastIO.key + '/' + name,

                data: {
                    exclude: 'currently,minutely,hourly,alerts,flags',
                    units: 'us' // unit = 'f' ? 'us' : 'si'
                },

                getItem: function (response) {
                    if (!response || !response.daily || !response.daily.data || !response.daily.data.length) {
                        return true;
                    }

                    var day = response.daily.data[0],
                        timezoneOffset = response.offset,
                        sunrise = moment.unix(day.sunriseTime).utc().clone().utcOffset(timezoneOffset),
                        sunset = moment.unix(day.sunsetTime).utc().clone().utcOffset(timezoneOffset);
                    /*
                     day.temperatureMin: 12.17,
                     day.temperatureMax: 20.68,
                     day.sunriseTime: 1454165633,
                     day.sunsetTime: 1454203373,
                     day.summary: "Partly cloudy throughout the day.",
                     day.icon: "partly-cloudy-day",
                     */

                    $ctrl.item = {
                        icon: day.icon,
                        high: Math.round(day.temperatureMax),
                        low: Math.round(day.temperatureMin),
                        text: day.summary,
                        sunrise: $ctrl.MomentService.getUTCMomentByFields(sunrise.hours(), sunrise.minutes()),
                        sunset: $ctrl.MomentService.getUTCMomentByFields(sunset.hours(), sunset.minutes()),
                        note: day.summary
                    };
                }
            }
        }

        function getWeatherstackIO(name) {
            var str = name.split(','),
            coordinates = str && str.length >= 2 ? (str[0] + ',' + str[1]) : null;
            return {
                url: $ctrl.forecastIO.url + '/forecast',
                data: {
                    access_key: $ctrl.forecastIO.key,
                    query: coordinates, //location search/autocomplete query to the API in free-text
                    // optional parameters:
                    forecast_days: 14, //the number of days for which the API returns forecast data. (Default: 7 or 14 days, depending on your subscription)
                    hourly: 1, //1 (on) or 0 (off) depending on whether or not you want the API to return weather data split hourly. (Default: 0 - off)
                    interval: 1, //If hourly data is enabled, use this parameter to define the interval: 1 hour, 3 hourly (default), 6 hourly, 12 hourly (day/night), 24 hourly (day average)
                    units: 'f',  //m for Metric, s for Scientific, f for Fahrenheit
                   // language: 'en' //preferred API response language using its ISO-code.
                },

                getItem: function (response) {
                    console.log('getItem weather for coordinates ' + coordinates);
                    console.log(JSON.stringify(response.location));
                    var startDate = $ctrl.startDate.year() + '-' +
                            getWith0($ctrl.startDate.month() + 1) + '-' +
                            getWith0 ($ctrl.startDate.date()),
                        startHour = $ctrl.startDate.hour(),
                        day, lastDate,

                        f = response ? response.forecast : null;

                    if(!f){
                        return true;
                    }

                    for(var d in f){
                        if(d === startDate){
                            day = f[d];
                            console.log('show weather for ' + d);
                        }
                        lastDate = d;
                    }

                    if(!day){
                        day = f[lastDate];
                        console.log('show weather for ' + lastDate);
                    }

                    var hour = day ? day.hourly[startHour] : null;

                    if (!hour) {
                        return true;
                    }

                    var iconx = hour ? hour.weather_icons[0]: null,
                        str = iconx ? iconx.split('/') : null,
                        icon = str ? str[str.length-1].split('.')[0]: null,
                        hFormat = 'HH:mm A',
                        sunrise = moment(day.astro.sunrise, hFormat),
                        sunset = moment(day.astro.sunset, hFormat);

                    $ctrl.item = {
                        high: Math.round(day.maxtemp),
                        low: Math.round(day.mintemp),
                        hourTemp: Math.round(hour.temp),
                        text: hour.weather_descriptions.join(','),
                        sunrise: $ctrl.MomentService.getUTCMomentByFields(sunrise.hours(), sunrise.minutes()),
                        sunset: $ctrl.MomentService.getUTCMomentByFields(sunset.hours(), sunset.minutes()),
                        code:  hour.weather_code,
                        icon: getIconForCode(icon),
                        windDegree: hour.wind_degree,
                        windDir: hour.wind_dir,
                        windSpeed: hour.wind_speed
                    };
                    $ctrl.item.note = $ctrl.item.summary;
                }
            }
        }

        function getWith0(d){return (( d < 10) ? '0' : '') + d;}

        function getIconForCode(icon){
            switch(icon){
                //day icons
                case 'wsymbol_0012_heavy_snow_showers':return 'snow-showers-day';
                case 'wsymbol_0016_thundery_showers':return 'thunder-showers-day';
                case 'wsymbol_0024_thunderstorms':return 'thunder-showers-day';
                case 'wsymbol_0021_cloudy_with_sleet':return 'sleet';
                case 'wsymbol_0013_sleet_showers':return 'sleet';
                case 'wsymbol_0012_heavy_snow_showers':return 'snow-showers-day';
                case 'wsymbol_0013_sleet_showers':return 'sleet';
                case 'wsymbol_0013_sleet_showers':return 'sleet';
                case 'wsymbol_0018_cloudy_with_heavy_rain':return 'showers-day';
                case 'wsymbol_0010_heavy_rain_showers':return 'showers-day';
                case 'wsymbol_0009_light_rain_showers':return 'showers-day';
                case 'wsymbol_0021_cloudy_with_sleet':return 'rain-snow-showers-day';
                case 'wsymbol_0020_cloudy_with_heavy_snow':return 'snow-showers-day';
                case 'wsymbol_0012_heavy_snow_showers':return 'snow-showers-day';
                case 'wsymbol_0011_light_snow_showers':return 'snow-showers-day';
                case 'wsymbol_0019_cloudy_with_light_snow':return 'snow-showers-day';
                case 'wsymbol_0018_cloudy_with_heavy_rain':return 'rain';
                case 'wsymbol_0010_heavy_rain_showers':return 'rain';
                case 'wsymbol_0018_cloudy_with_heavy_rain':return 'rain';
                case 'wsymbol_0010_heavy_rain_showers':return 'showers-day';
                case 'wsymbol_0017_cloudy_with_light_rain':return 'rain';
                case 'wsymbol_0009_light_rain_showers':return 'showers-day';
                case 'wsymbol_0007_fog':return 'fog';
                case 'wsymbol_0007_fog':return 'fog';
                case 'wsymbol_0020_cloudy_with_heavy_snow':return 'snow-showers-day';
                case 'wsymbol_0019_cloudy_with_light_snow':return 'snow-showers-day';
                case 'wsymbol_0013_sleet_showers':return 'showers-day';
                case 'wsymbol_0009_light_rain_showers':return 'showers-day';
                case 'wsymbol_0006_mist':return 'rain';
                case 'wsymbol_0003_white_cloud':return 'partly-cloudy-day';
                case 'wsymbol_0002_sunny_intervals':return 'clear-day';
                case 'wsymbol_0001_sunny':return 'clear-day';
                //night icons
                case 'wsymbol_0028_heavy_snow_showers_night': return 'snow-showers-night';
                case 'wsymbol_0032_thundery_showers_night': return 'thunder-showers-night';
                case 'wsymbol_0040_thunderstorms_night': return 'thunder-showers-night';
                case 'wsymbol_0027_light_snow_showers_night': return 'rain-snow';
                case 'wsymbol_0034_cloudy_with_heavy_rain_night': return 'showers-night';
                case 'wsymbol_0026_heavy_rain_showers_night': return 'showers-night';
                case 'wsymbol_0036_cloudy_with_heavy_snow_night': return 'snow-showers-night';
                case 'wsymbol_0027_light_snow_showers_night': return 'snow-showers-night';
                case 'wsymbol_0027_light_snow_showers_night': return 'snow-showers-night';
                case 'wsymbol_0035_cloudy_with_light_snow_night': return 'snow-showers-night';
                case 'wsymbol_0037_cloudy_with_sleet_night': return 'rain-snow-showers-night';
                case 'wsymbol_0034_cloudy_with_heavy_rain_night': return 'rain';
                case 'wsymbol_0026_heavy_rain_showers_night': return 'rain';
                case 'wsymbol_0034_cloudy_with_heavy_rain_night': return 'rain';
                case 'wsymbol_0026_heavy_rain_showers_night': return 'showers-night';
                case 'wsymbol_0033_cloudy_with_light_rain_night': return 'rain';
                case 'wsymbol_0007_fog': return 'fog';
                case 'wsymbol_0035_cloudy_with_light_snow_night': return 'snow-showers-night';
                case 'wsymbol_0032_thundery_showers_night': return '  thunder-showers-night';
                case 'wsymbol_0029_sleet_showers_night': return 'showers-night';
                case 'wsymbol_0025_light_rain_showers_night': return 'showers-night';
                case 'wsymbol_0006_mist': return 'rain';
                case 'wsymbol_0004_black_low_cloud': return 'partly-cloudy-night';
                case 'wsymbol_0008_clear_sky_night': return 'clear-night';
            }
        }


        function getinfo(){
            return;
            /*astro: {
                       moon_illumination:49
                       moon_phase:"First Quarter"
                       moonrise:"12:57 PM"
                       moonset:"01:11 AM"
                       sunrise:"06:34 AM"
                       sunset:"06:45 PM"
                   },
                   hourly:{
                       0:{
                           chanceoffog: 0
                           chanceoffrost: 0
                           chanceofhightemp: 0
                           chanceofovercast: 0
                           chanceofrain: 0
                           chanceofremdry: 85
                           chanceofsnow: 0
                           chanceofsunshine: 92
                           chanceofthunder: 0
                           chanceofwindy: 0
                           cloudcover: 27
                           dewpoint: 0
                           feelslike: 11
                           heatindex: 12
                           humidity: 47
                           precip: 0
                           pressure: 1016
                           temperature: 21
                           time: 0
                           uv_index: 4
                           visibility: 10
                           weather_code: 113
                           weather_descriptions: ["Sunny"]
                           weather_icons: ["https://cdn.worldweatheronline.com/images/wsymbols01_png_64/wsymbol_0001_sunny.png"]
                           wind_degree: 122
                           wind_dir: "ESE"
                           wind_speed: 17
                           windchill: 11
                           windgust: 19
                       }
                   }
                   avgtemp:86
                   date:"2023-03-29"
                   date_epoch:1680048000
                   maxtemp:97
                   mintemp:75
                   sunhour:11.6
                   totalsnow:0
                   uv_index:7*/
        }
    }
}

angular.module('product.callsheet.confirmPage.component', [
