addMoSePa('Products', 'products', TempProductsService, {
    modelMethod: ProductsFactory,
    serviceInjectList:['Settings', 'Scripts', 'Materials', 'ProductTypes', 'Calendars'],
    serviceInjectMod:[
        'resources.Settings',
        'resources.Scripts',
        'resources.Materials',
        'resources.ProductTypes',
        'resources.Calendars'
    ]
});

function ProductsFactory(ApiResource) {
    var model = ApiResource(SBApiCollections.Products);

    model.prototype.getName = function () {
        return this.name ? this.name : '';
    };

    return model;
}
function TempProductsService(ApiService, model, Settings, Scripts, Materials, ProductTypes,Calendars) {
    var service = ApiService(model, {
        listType: 'isGroup',
        listField: 'productsListId',
        materialProps: ['logo'],
        convertOtherResources: convertOtherResources
    });

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;

    return service;

    function convertOtherResources(item) {
        if (item.settingsId && typeof(item.settingsId) === 'object') {
            item.settings = new Settings(item.settingsId);
            item.settingsId = item.settingsId._id;
        }

        if (item.scriptId && typeof(item.scriptId) === 'object') {
            item.script = new Scripts(item.scriptId);
            item.scriptId = item.scriptId._id;
        }

        if (item.productTypeId && typeof(item.productTypeId) === 'object') {
            item.productType = new ProductTypes(item.productTypeId);
            item.productTypeId = item.productTypeId._id;
        }

        if (item.calendarId && typeof(item.calendarId) === 'object') {
            item.calendar = new Calendars(item.calendarId);
            item.calendarId = item.calendarId._id;
        }
        return item;
    }

    function getChangedFieldForUpdateOther(){
        return ['name','description', 'production', 'settings', 'address', 'logo', 'logoId', 'teamIds' ];
    }
}

