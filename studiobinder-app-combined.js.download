angular.module('product.invite.init.controller.service', [
    'apiServices.Contacts',
    'ngTagsInput'
])
.service('InviteInitCtrlService', InviteInitCtrlService);
InviteInitCtrlService.$inject = ['ContactsService', 'CompInitCtrlService'];
function InviteInitCtrlService(ContactsService, CompInitCtrlService) {
    //$ctrl.type = null;
    return function($ctrl) {
        console.log('InviteInitCtrlService');
        $ctrl.ContactsService = ContactsService;
        $ctrl.$onDestroy = $onDestroy;
        $ctrl = new CompInitCtrlService($ctrl);
        $ctrl.$select = {selected: []};
        $ctrl.hasAutoFocus = true;

        $ctrl.onTagAdding = onTagAdding;
        $ctrl.onTagAdded = onTagAdded;
        $ctrl.onInvalidTag = onInvalidTag;
        $ctrl.onTagRemoving = onTagRemoving;
        $ctrl.onTagRemoved = onTagRemoved;
        $ctrl.invite = invite;
        $ctrl.onSave = onSave;
        $ctrl.onError = onError;
        $ctrl.cancelPopup = cancelPopup;
        $ctrl.showError = showError;
        $ctrl.hideError = hideError;
        $ctrl.getInviteForm = getInviteForm;

        return $ctrl;

        function onTagAdding($tag) {
            //console.log('onTagAdding');//console.log($tag);
            $ctrl.ContactsService.validateEmail($tag.text, function (result) {
                if (result && result.exists) {
                    $tag.valid = {isValid: false, message: 'This email has already been added'};
                }
            }, function (error) {
                // $ctrl.onError(error);
            });
        }

        function onTagAdded($tag) {
            //console.log('onTagAdded');
            //console.log($tag);
        }

        function onInvalidTag($tag) {
            //console.log('onInvalidTag');
            //console.log($tag);
        }

        function onTagRemoving($tag) {
            //console.log('onTagRemoving');
            //console.log($tag);
        }

        function onTagRemoved($tag) {
            //console.log('onTagRemoved');
            //console.log($tag);
        }

        function invite() {
            $ctrl.showError();
            if (!$ctrl.$select.selected.length) {
                $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.' + $ctrl.type + '.email');
                return;
            }

            var isValid = true;
            _.each($ctrl.$select.selected, function (value, key) {
                if (!value.valid.isValid) {
                    isValid = false;
                }
            });

            if (!isValid) {
                $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.' + $ctrl.type + '.email-errors');
                return;
            }

            $ctrl.isUpdating = true;
            $ctrl.error = null;
            var items = [];
            _.each($ctrl.$select.selected, function (i) {
                items.push(i.text.toLowerCase());
            });

            $ctrl.ContactsService.addEmailContacts( {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                emails: items
            }, $ctrl.onSave, $ctrl.onError);
        }

        function onSave(result) {
            $ctrl.isUpdating = false;
            console.log('broadcast: ' + 'ADDED_MULTIPLE_' + $ctrl.elemType + '_' + $ctrl.currentListId);
            result.processMultiple = true;
            $ctrl.broadcastRoot('ADDED_MULTIPLE_' + $ctrl.elemType + '_' + $ctrl.currentListId, result);
            //$ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result);
            if (typeof ($ctrl.onClose) === 'function') {
                $ctrl.onClose({result: result});
            }
        }

        function onError(error) {
            $ctrl.isUpdating = false;
            if (error && error.name === 'ValidationError') {
                for (var prop in error.errors) {
                    var err = error.errors[prop];
                    if (err) {
                        if (prop === 'email') {
                            //$ctrl.item[prop] = $ctrl.copyItem[prop];
                            try {
                                $ctrl.error = err.message;
                            } catch (e) {
                            }
                        } else {
                            $ctrl.error = err.message;
                        }
                    }
                }
            } else {
                $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.' + $ctrl.type + '.error', {name: $ctrl.item && typeof($ctrl.item.getName) === 'function' ? $ctrl.item.getName() : ''});
            }
        }

        function cancelPopup() {
            $ctrl.error = '';
            if ($ctrl.$dismiss) {
                $ctrl.$dismiss('cancel');
            }
        }

        function hideError() {
            var elem = $('.error-container');
            if (elem.length > 0) {
                elem.css({opacity: 0, transition: 'all 0.2s', height: 0});
            }
        }

        function showError() {
            var elem = $('.error-container');
            $ctrl.error = null;
            if (elem.length > 0) {
                elem.css({height: 'auto', opacity: 1});
            }
        }

        function getInviteForm() {
return '<div id="formNewInvite" name="$ctrl.formNewInvite" class="auto" novalidate autocomplete="off">' +
            '<tags-input class="tags-input hover-underline" ng-model="$ctrl.$select.selected" ' +
                    'placeholder="Enter or paste email addresses here (space or comma-separated)…" ' +
                    'replace-spaces-with-dashes="false" ' +
                    'add-on-comma="true" ' +
                    'add-on-space="true" ' +
                    'add-on-paste="true" ' +
                    'paste-split-pattern=\'[,;|\\s]\' ' +
                     'allowed-tags-pattern=\'^(([^<>()[\\]\\\\.,;:\\s@"]+(\\.[^<>()[\\]\\\\.,;:\\s@"]+)*)|(".+"))@((\\[[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}])|(([a-zA-Z\\-0-9]+\\.)+[a-zA-Z]{2,}))$\' ' +
                    'max-length="254" ' +
                    'min-length="3" ' +
                    'on-tag-adding = "$ctrl.onTagAdding$ctrl($ctrl.$tag)" ' +
                    'on-tag-added = "$ctrl.onTagAdded($ctrl.$tag)" ' +
                    'on-invalid-tag = "$ctrl.onInvalidTag($ctrl.$tag)" ' +
                    'on-tag-removing = "$ctrl.onTagRemoving($ctrl.$tag)" ' +
                    'on-tag-removed = "$ctrl.onTagRemoved($ctrl.$tag)"></tags-input> ' +
            '</div>';
        }

        function $onDestroy() {
            $ctrl.removeWatchers();
            if($ctrl.templateCompile) {
                $ctrl.templateCompile.destroyNewScope();
            }
        }
    }
}

angular.module('product.contacts.item.edit.component.service', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'product.contacts.adjustRoles.init.controller.service',
    'sb.fields.types.service'
])
.service('AddContactCtrlService', AddContactCtrlService);
AddContactCtrlService.$inject = ['GeneralItemEditCtrlService', 'AdjustRolesInitCtrlService'];
function AddContactCtrlService( GeneralItemEditCtrlService, AdjustRolesInitCtrlService) {
    return function ($ctrl, $element, isPopup){
        var adjustRolesTabIndex = 14, generalRate, projectRate;

        $ctrl.withLabel = true;
        $ctrl.compareWithoutKeys = true;

        $ctrl.preInitGeneral = preInitGeneral;
        $ctrl.postInitGeneral = postInitGeneral;

        $ctrl.getPopupBodyContent = getPopupBodyContent;
        $ctrl.preSetTemplateData = preSetTemplateData;
        $ctrl.updateContact = updateContact;

        $ctrl.processadd = processadd;

        $ctrl.onSaveGeneral = onSaveGeneral;
        $ctrl.onSaveAfter = onSaveAfter;
        $ctrl.addContactF = addContactF;
        $ctrl.addContactT = addContactT;

        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function addContactF(id, e) {
            $ctrl.processadd(false);
        }

        function addContactT(id, e) {
            $ctrl.processadd(true);
        }

        function preInitGeneral() {
            $ctrl.clean = false;
            //{
            // contactType: $ctrl.contactType,
            // activeId: $ctrl.activeId,
            // contactListId: $ctrl.CPS.product ? $ctrl.productId ? $ctrl.CPS.contactListId : null
            // }
            if($ctrl.preInitGeneralOther){
                $ctrl.preInitGeneralOther();
            }
        }

        function postInitGeneral(){
            $ctrl = new AdjustRolesInitCtrlService($ctrl);

            if($ctrl.item.rate) {
                generalRate = _.clone($ctrl.item.rate);
            }

            if($ctrl.productContactListId) {
                projectRate = $ctrl.item.contactLists['c_' + $ctrl.productContactListId].rate;
                if(projectRate){
                    $ctrl.item.rate = _.clone(projectRate);
                }
            }

            $ctrl.onSave = onSave;

            if($ctrl.postInitGeneralOther){
                $ctrl.postInitGeneralOther();
            }
        }

        function onSave(result) {
            console.log('AddContactCtrlService.onSave');
            result.type = $ctrl.type;
            $ctrl.onListItemSave(result, $ctrl.listItemUpdates, false);
        }

        function getPopupBodyContent() {
            return $ctrl.getPopupForm() +
                   (typeof($ctrl.getPopupBodyContentOther) === 'function' ? $ctrl.getPopupBodyContentOther() : '') +
                   '<label class="header clearfix">Roles</label>' +
                   $ctrl.getAddRoles(null, adjustRolesTabIndex);
        }

        function preSetTemplateData() {
            $ctrl.icon = 'contacts';
            if($ctrl.isNew){
                $ctrl.with2FooterBtns = true;
                $ctrl.firstBtnMethod = 'addContactF';
                $ctrl.secBtnMethod = 'addContactT';
            } else{
                $ctrl.firstBtnMethod = 'updateContact';
            }
        }

        function updateContact(e) {
            $ctrl.preventDefault(e);
            $ctrl.processadd(false);
        }

        function processadd(clean) {
            $ctrl.clean = clean;
            $ctrl.error = null;
            var keepEmpty = true;
            var roles = $ctrl.updateRoles($ctrl.itemRoles, keepEmpty);
            $ctrl.error = $ctrl.validCrewPositions(roles);
            if ($ctrl.error) {
                return false;
            }

            if(!$ctrl.item.name){
                $ctrl.error = 'Name cannot be empty';
                return false;
            }

            if(!$ctrl.item.email){
                $ctrl.error = 'Email field cannot be empty';
                return false;
            }

            if (!$ctrl.callsheetId && $ctrl.productContactListId) {
                if (!$ctrl.item.contactLists['c_' + $ctrl.productContactListId]) {
                    $ctrl.item.contactLists['c_' + $ctrl.productContactListId] = {};
                }
                $ctrl.item.contactLists['c_' + $ctrl.productContactListId].roles = roles;
            }

            if ($ctrl.isNew || !$ctrl.isNew && !$ctrl.productContactListId) {
                $ctrl.item.roles = roles;
            }

            $ctrl.listItemUpdates = $ctrl.isNew ? null : $ctrl.getDataToUpdate();
            if(!$ctrl.callsheetId && $ctrl.productContactListId && ($ctrl.isNew || !$ctrl.isNew && $ctrl.listItemUpdates && $ctrl.listItemUpdates.rate)){
                $ctrl.item.contactLists['c_' + $ctrl.productContactListId].rate = $ctrl.item.rate;
                $ctrl.item.rate = generalRate;
            }

            $ctrl.save();
        }

        function onSaveGeneral(result) {
            if (!$ctrl.isNew) {
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.objectType + '.' + ($ctrl.isNew ? 'Create' : 'Edit') + '.success', 'success', {
                    name: $ctrl.item.name
                });
            }
        }

        function onSaveAfter(result) {
            console.log('onSaveAfter');
            //for crew reload the list after update to ensure that the departments are reloaded
            var currentListId = '2';
            if($ctrl.extraParam.parent && $ctrl.extraParam.parent._id === currentListId) {
                $ctrl.LCS.timeout(function () {
                    $ctrl.broadcastRoot('TREE_SERVICE_RELOAD_LIST_' + $ctrl.elemType, currentListId);
                }, 300);
            }
        }

    }
}

angular.module('product.contacts.item.edit.popup.component', [
    'product.contacts.item.edit.component.service',
])
.component('contactEditPopup', popupComponentParams('ContactEditPopupCtrl'))
.controller('ContactEditPopupCtrl', ContactEditPopupCtrl);
ContactEditPopupCtrl.$inject = ['AddContactCtrlService', '$element'];
function ContactEditPopupCtrl( AddContactCtrlService, $element) {
     var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.preInitGeneralOther = preInitGeneralOther;
    $ctrl.postInitGeneralOther = postInitGeneralOther;
    $ctrl.clearFormOther = clearFormOther;

    $ctrl = new AddContactCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneralOther() {
        $ctrl.objectType = 'contact';
        $ctrl.elemType = 'CONTACT';
        $ctrl.productContactListId = $ctrl.CPS.product ? $ctrl.CPS.product.contactListId : null;

        $ctrl.isCustomList = $ctrl.extraParam.isCustomList;
        $ctrl.contactType = $ctrl.isCustomList ? $ctrl.service.ContactTypes.List : ($ctrl.CPS.productId ? $ctrl.service.ContactTypes.Project : $ctrl.service.ContactTypes.General);

        $ctrl.currentListId = $ctrl.extraParam.currentListId;

        onCreate();
    }

    function clone(item){
        return item ? angular.copy(item) : item;
    }

    function onCreate(){
        if ($ctrl.type !== 'Create') {return;}

        if (!$ctrl.isCustomList && ($ctrl.currentListId && $ctrl.currentListId !== 'All' && $ctrl.currentListId !== 'Unassigned')) {
            $ctrl.defaultRole = parseInt($ctrl.currentListId, 10);
        }
        $ctrl.item = getItem();
        $ctrl.copyItem = clone($ctrl.item);

        function getItem() {
            var params = {};

            if ($ctrl.contactType !== '') {//not general
                params.contactLists = {};
                if ($ctrl.contactType === 'List') {
                    params.contactLists['c_' + $ctrl.currentListId] = {};
                    if ($ctrl.CPS.productId) {
                        addProdList();
                    } //contact list for project
                } else {
                    addProdList();
                } // is project contact
            }

            return $ctrl.service.convertResource(params);

            function addProdList() {
                params.contactLists['c_' + $ctrl.productContactListId] = {productId: $ctrl.CPS.productId};
            }
        }
    }

    function postInitGeneralOther() {
        $ctrl.listIndex = 'new';
    }

    function clearFormOther(){
        onCreate();
        $ctrl.itemRoles = [];
        $ctrl.loadRoles();
    }
}

angular.module('product.contacts.item.bulkAction.component', [
    'apiServices.Contacts'
])
.component('removeContactsPopup', popupComponentParams('RemoveContactsPopupCtrl'))
.controller('RemoveContactsPopupCtrl', RemoveContactsPopupCtrl);
RemoveContactsPopupCtrl.$inject = ['ContactsService', 'ItemTemplateCompileCtrlService', '$element'];

function RemoveContactsPopupCtrl(service, ItemTemplateCompileCtrlService, $element) {
    var $ctrl  = this;

    $ctrl.isPopup = true;
    
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl.preInit = preInit;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInit() {
        $ctrl.cast = $ctrl.item;
        $ctrl.send = {subject: null, title: null, message: null};
        $ctrl.onSave = onSave;
        $ctrl.onError = onError;
        $ctrl.cancelPopup = cancelPopup;
        $ctrl.refresh = refresh;
        $ctrl.save = save;
        $ctrl.preLoadingService = $ctrl.extraParam.preLoadingService;
        $ctrl.currentListId = $ctrl.extraParam.currentListId;
        $ctrl.service = service;
    }

    function setTemplateData() {
        $ctrl.icon = 'trash';
        $ctrl.popupTitle = $ctrl.extraParam.title ? $ctrl.extraParam.title : 'Are you sure?';
        $ctrl.withFooterBtns = true;
        $ctrl.btnText = 'Remove<span class="hide-ipad">' +($ctrl.cast.length === 1 ? '' : ($ctrl.cast.length + ' ')) +
            'Contact' + ($ctrl.cast.length === 1 ? '' : 's') + '</span>';
        $ctrl.textAnalytics = 'Remove Contacts';
    }

    function getPopupBodyContent(){
        return '<p class="text-center medium-size">' +
            ($ctrl.extraParam.noDefault!==true? ('Are you sure you want to remove '+ ($ctrl.cast.length === 1 ? '' : ('the ' + $ctrl.cast.length + ' ')))  +'selected contact' + (($ctrl.cast.length === 1 ? '' : 's') + '?') : '') +
                ($ctrl.extraParam.additionalMessage || '') +
               '</p>';
    }

    function save() {
        if (!$ctrl.cast || $ctrl.cast.length === 0) {
            $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.cast.error.invalid-cast');
        }
        else {
            refresh();
            $ctrl.isUpdating = true;
            switch ($ctrl.type) {
                case 'Remove Selected':
                    $ctrl.service.deleteBulk({
                        castIds: $ctrl.cast,
                        companyId: $ctrl.CPS.companyId,
                        productId: $ctrl.CPS.productId,
                        contactListId: $ctrl.extraParam.isCustomList ? $ctrl.currentListId : null,
                        contactType: $ctrl.extraParam.contactType
                    }, onSave, onError);
                    break;
            }
        }
    }

    function refresh() {
        $ctrl.error = '';
    }

    function onSave(result) {
        $ctrl.isUpdating = false;
        if ($ctrl.type === 'Remove Selected') {
            result.type = $ctrl.type;

            var currentListId = $ctrl.currentListId || 'All';
            //propagates to all recipient grids in callsheet -> all recipient grids will be reloaded
            $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result);
            $ctrl.broadcastRoot('CLEAR_SELECTED_ROWS_' + $ctrl.elemType);

            $ctrl.LCS.timeout(function () {
                $ctrl.broadcastRoot('TREE_SERVICE_RELOAD_LIST_' + $ctrl.elemType, currentListId);
            }, 300);
        }
        close(result);
    }

    function onError(error) {
        $ctrl.isUpdating = false;
        $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.cast.' + $ctrl.type + '.error');
    }

    function cancelPopup() {
        refresh();
        close('cancel');
    }

    function close(result) {
        $ctrl.broadcastRoot('HIDE_MOBILE_DETAILS');
        if (typeof ($ctrl.onClose) === 'function') {
            $ctrl.onClose({result: result});
        }
    }
}

