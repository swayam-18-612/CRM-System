StoryboardsPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'StoryboardsPageCtrlServiceInjectors'];
function StoryboardsPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    return function ($ctrl, $element, printPageParams) {
        console.log('StoryboardsPageCtrlService');

        $ctrl.btnCustomizeColumsTxt = 'Customize Frames';
        $ctrl.viewFilters = 'columnsLayout';

        $ctrl.getCollabBannerInfo = getCollabBannerInfo;
        $ctrl.getGroupFilters = getGroupFilters;

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);

        return $ctrl;

        function getCollabBannerInfo(){
            return {txt: 'Create and share your own storyboards for free.', campaign:'collab-storyboards'};
        }

        function getGroupFilters(isDisplay) {
            return $ctrl.withTreeDisplayCount && isDisplay ? {type: 1} : null;
        }
    }
}

angular.module('product.storyboards.item.popup.component', [
    'product.shots.item.edit.controller.service',
])
.component('storyboardEditPopup', popupComponentParams('StoryboardEditPopupCtrl'))
.controller('StoryboardEditPopupCtrl', StoryboardEditPopupCtrl);
StoryboardEditPopupCtrl.$inject = ['ShotEditPopupCtrlService', '$element'];
function StoryboardEditPopupCtrl(ShotEditPopupCtrlService, $element) {
    console.log('StoryboardEditPopupCtrl');

    var $ctrl = this;

    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.preInitGeneralOther = preInitGeneralOther;

    $ctrl = new ShotEditPopupCtrlService($ctrl, $element);

    function preInitGeneralOther() {
        $ctrl.defaultField = 'sceneNo';
        $ctrl.withoutFieldScroll = true;
    }

    function getPopupBodyContent() {
        var isMobile = $ctrl.LCS.isMobileSize, el = '', t = [],
            isCustom = isCustomShot();
        for (var i = 0, n = $ctrl.columnsList.length; i < n; i++) {
            var c = $ctrl.columnsList[i];
            //skip prop
            if(isCustom && c.prop === 'shotNo' || !isCustom && c.prop === 'customShotNo'){

            } else if (c.prop === 'sceneNo' || (isCustom && c.prop === 'customShotNo' || !isCustom && c.prop === 'shotNo')) {
                t.push(c);
            } else{
                el += $ctrl.getRowCols([c], 'col100p', $ctrl.withLabel, isMobile);
            }
        }

        return $ctrl.getRowCols(t, 'col50p pull-left', $ctrl.withLabel, isMobile) +
               el;
    }

    function isCustomShot() {
        return $ctrl.listTreeService.filtersService.options.type.toString() === '3';
    }
}



