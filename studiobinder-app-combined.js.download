angular.module('product.settings', [
    'product.settings.routing',
    'product.settings.init.controller',
    'product.settings.page.component',
    'product.settings.popup.component'
]);

angular.module('product.settings.init.controller', [
    'apiServices.Settings',
    'item.edit.listTemplate.init.controller.service'
])
.service('ProductSettingsInitCtrlService', ProductSettingsInitCtrlService);
ProductSettingsInitCtrlService.$inject = ['ListItemTemplateFormCtrlService', 'SettingsService', 'CompileService', 'SBFieldTypesService'];
function ProductSettingsInitCtrlService(ListItemTemplateFormCtrlService, service, CompileService, SBFieldTypesService) {
    return function($ctrl, $element) {
        var country;
        $ctrl.SBFieldTypesService = SBFieldTypesService;
        $ctrl.CompileService = CompileService;
        $ctrl.service = service;

        $ctrl.countries = $ctrl.CurrentLocaleSettings.Countries;
        $ctrl.currencies = $ctrl.CurrentLocaleSettings.getCurrencies();

        if ($ctrl.onSettingsSave === undefined) {
            console.warn('Parent for ProductSettingsInitCtrlService must define method $ctrl.onSettingsSave');
        }
        $ctrl.objectType = 'settings';
        $ctrl.extraParam = {service: $ctrl.service};

        $ctrl.item = getItem($ctrl.isGeneral);
        $ctrl.type = $ctrl.item._id ? 'Edit' : 'Create';

        var Temperatures = $ctrl.CurrentLocaleSettings.getTemperatures(),
            TimeFormats  = $ctrl.CurrentLocaleSettings.getTimeFormats(),
            DateFormats  = $ctrl.CurrentLocaleSettings.getDateFormats();

        $ctrl.Settings = {
            Temperatures: Temperatures,
            TimeFormats: TimeFormats,
            DateFormats: DateFormats
        };

        $ctrl.configCountry = _.extend({
            valueField: 'iso3',
            labelField: 'name',
            placeholder: 'Select default country…',
            searchField: ['name'],
            onChange: onChangeCountry
        }, getDrpParams(renderCountryItem, 'countries'));

        $ctrl.configCurrency = _.extend({
            valueField: 'v',
            labelField: 'n',
            placeholder: 'Select default currency…',
            searchField: ['n'],
            onChange: onChangeCurrency
        }, getDrpParams(renderCurrencyItem));

        country = $ctrl.item.country;

        if (!$ctrl.item.temperature) {
            $ctrl.item.temperature = Temperatures[0].value;
        }
        if (!$ctrl.item.timeFormat) {
            $ctrl.item.timeFormat = TimeFormats[0].value;
        }

        if (!$ctrl.item.country) {
            $ctrl.item.country = $ctrl.CurrentLocaleSettings.DefaultSettings.country;
        }

        if (!$ctrl.item.currency) {
            $ctrl.item.currency = $ctrl.CurrentLocaleSettings.getCurrencyBasedOnCountry(country)  ;
        }

        if (!$ctrl.item.startTime) {
            $ctrl.item.startTime = $ctrl.CurrentLocaleSettings.DefaultSettings.startTime;
        }

        $ctrl.item.productId = $ctrl.CPS.productId || null;
        $ctrl.item.companyId = $ctrl.CPS.companyId;

        $ctrl.templateType = $ctrl.item.productId ? 'product' : 'company';

        $ctrl.onProductSettingsSave = onSave;
        $ctrl.getProjectSectionForm = getProjectSectionForm;
        $ctrl.getElementId = getElementId;

        $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

        return $ctrl;

        function getDrpParams(m, c){
            return {
                dropdownContentClass: 'selectize-dropdown-content countries ',
                inputClass: 'selectize-input selected-text with-underline ' + (c||'') + ' ' + $ctrl.pageClass,
                render: {
                    item: function (i, e) {
                        return m(i, e, 'item');
                    },
                    option: function (i, e) {
                        return m(i, e, 'option');
                    }
                }
            };
        }

        function getItem(isGeneral) {
            var item;
            if (isGeneral) {
                 item = $ctrl.company.settings ? $ctrl.company.settings : $ctrl.CurrentLocaleSettings.getCompanySettings();
            } else {
                 item = $ctrl.CPS.product && $ctrl.CPS.product.settings ? $ctrl.CPS.product.settings : ($ctrl.company && $ctrl.company.settings ? $ctrl.company.settings : null);

                if (!item) {
                    var news = $ctrl.CurrentLocaleSettings.getCompanySettings();
                    delete news._id;
                    item = news;
                }
            }
            return item.getType ? item : $ctrl.service.convertResource(item);
        }

        function getElementId(prop) {
            return $ctrl.SBFieldTypesService.getElementId($ctrl.item._id, prop, $ctrl.objectType);
        }

        function onSave(result) {
            $ctrl.onSettingsSave(result && result.item ? result.item : null);
        }

        function getForm() {
            var formGroupClass =  'form-group field margin-bottom ',
                drpMenuCls = 'col334',
                columns = [ {
                    formGroupClass: formGroupClass ,
                    name: 'Temperature',
                    icon: 'temperature',
                    type: $ctrl.SBFieldTypesService.PropTypes.Drp,
                    prop: 'temperature',
                    tabIndex: 1,
                    tabNextIndex: 2,
                    cClassAttr: 'autoheight long-caret',
                     initListName: 'Temperatures',
                    //'on-change="$ctrl.changeTemperature(result)" ' +
                    canEdit: true,
                    parentContainer: true,
                    drpMenuCls: drpMenuCls
                },{
                    formGroupClass: formGroupClass ,
                    name: 'Time format',
                    icon: 'clock',
                    type: $ctrl.SBFieldTypesService.PropTypes.Drp,
                    prop: 'timeFormat',
                    tabIndex: 2,
                    tabNextIndex: 3,
                    cClassAttr: 'autoheight long-caret',
                    initListName: 'TimeFormats',
                    //'on-change="$ctrl.changeTime(result)" ' +
                    canEdit: true,
                    parentContainer: true,
                    drpMenuCls: drpMenuCls
                },/*{
                    formGroupClass: formGroupClass ,
                    name: 'Date format',
                    icon: 'clock',
                    type: $ctrl.SBFieldTypesService.PropTypes.Drp,
                    prop: 'dateFormat',
                    tabIndex: 2,
                    tabNextIndex: 3,
                    eClassAttr: 'form-control with-underline',
                    cClassAttr: 'autoheight long-caret',
                    initListName: 'DateFormats',
                    //'on-change="$ctrl.changeTime(result)" ' +
                    canEdit: true
                },*/{
                    formGroupClass: formGroupClass ,
                    name: 'Start time',
                    icon: 'clock',
                    type: $ctrl.SBFieldTypesService.PropTypes.Time,
                    prop: 'startTime',
                    tabIndex: 3,
                    tabNextIndex: 4,
                    cClassAttr: 'autoheight long-caret',
                    hasRemove: false,
                    placeholder: 'Start Time',
                    otherHtml: '<div class="wide-tooltip hide-ipad position-absolute" style="height: 0;left:100%;top:0"' +
                        'tooltip-placement="left" tooltip="Used as default start time for call sheets and day breaks."' +
                        '><div style="right: -30px;top: 6px" class="sbf info blueish position-absolute" ' +
                        '>'+$ctrl.LCS.getISBPath(3)+'</div></div>',
                    //'init-list="::$ctrl.TimeFormats" '
                    //'on-change="$ctrl.changeTime(result)" ' +
                    canEdit: true,
                    parentContainer: true,
                    drpMenuCls: drpMenuCls
                }];

// otherHtml: '<div class="wide-tooltip hide-ipad position-relative full-width" style="height: 0;"><span class="sbf info blueish position-absolute" tooltip="The production company address will be displayed on call sheets and reports." tooltip-placement="left" style="position: absolute;right: 0;top: -26px;width:18px;height:18px;"></span></div>'

            return $ctrl.SBFieldTypesService.getPopupSBForm($ctrl, columns, {
                groupLabel: true
            });
        }

        function getProjectSectionForm() {
return '<div class="tab-content  with-white-bg margin-half with-padding h-full h-full-55">' +
            $ctrl.getPopupHeaderForInfo({
                icon: 'cog',
                title: $ctrl.popupTitle
            }) +

        '<div class="form-wrapper">' +
            '<form name="$ctrl.formHolderItem[$ctrl.formName]" id="formHolderItem.formItem" novalidate  class="form-wrapper spacing-bottom" autocomplete="off">' +
                $ctrl.LCS.getErrorBlock() +
                '<label class="header clearfix">Country</label>'+
                '<div class="form-group field margin-bottom">' +
                    '<sb-selectize ' +
                        'config="::$ctrl.configCountry" ' +
                        'init-list="::$ctrl.countries" ' +
                        'ng-model="$ctrl.item.country"' +
                    '></sb-selectize>' +
                '</div>' +

                getForm() +

                '<label class="header clearfix">Currency</label>'+
                '<div class="form-group sbfgroup field">' +
                    $ctrl.LCS.getISBDiv('dollar', 3) +
                    '<sb-selectize ' +
                        'config="::$ctrl.configCurrency" ' +
                        'init-list="::$ctrl.currencies" ' +
                        'ng-model="$ctrl.item.currency"' +
                    '></sb-selectize>' +
                '</div>' +

                '<div class="form-group text-center spacing-half-top">' +
                    '<button type="submit" class="btn btn-primary full-width '+($ctrl.pageClass||'')+'" ng-disabled="$ctrl.isUpdating" ng-click="$ctrl.save()" analytics-on analytics-action="Save Project Settings"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Save</button>' +
                '</div>' +
            '</form>' +
        '</div>' +
    '</div>';
        }

        function onChangeCountry(result) {
            console.log('onChangeCountry');
            var country = $ctrl.item.country;
            var data = $ctrl.CurrentLocaleSettings.getVarsByCountryCode(country);
            var language = data.language ? data.language : $ctrl.CurrentLocaleSettings.DefaultSettings.language;
            $ctrl.item.language = language &&   Array.isArray(language) && language.length>0?language[0] : language;
            $ctrl.item.currency = data.currency ? data.currency : $ctrl.currencies[0].v;
            $ctrl.item.temperature = data.temperature ? data.temperature : Temperatures[0].value;

            console.log('country= ' +country+'; language = ' + $ctrl.item.language+ '; currency= ' + $ctrl.item.currency +'; temperature= '+ $ctrl.item.temperature);
        }

        function renderCountryItem(item, escape, type) {
            var avatar = '<div id="' + item._id + '"><div class="iti__flag iti__' + item.iso2.toLowerCase() + '"></div> <span class="country-name">' + item.name + '</span></div>';

            $ctrl.CompileService.addCompiledTemplateWatcher($ctrl.watchers, avatar, item._id, type);

            return avatar;
        }

        function renderCurrencyItem(item, escape, type) {
            var avatar = '<div id="item_' + item.v + '">' +
                '<span class="country-name">'+item.n+'</span> ' +
                (item.s ? (' <span class="symbol with-parenthesis">' + item.s + '</span>'):'') +
                '</div>';

            $ctrl.CompileService.addCompiledTemplateWatcher($ctrl.watchers, avatar, item.v, type);
            return avatar;
        }

        function onChangeCurrency(result) {
            console.log('onChangeCurrency');
        }
    }
}

