angular.module('product.document.viewDocument.controller.service', [
    'apiServices.DocumentVersions',
    'apiServices.Materials',
    'apiServices.Strips',
    'services.downloadExport'
])
.service('ViewDocumentCtrlService', ViewDocumentCtrlService);

ViewDocumentCtrlService.$inject = ['ItemTemplateCompileCtrlService', 'MaterialsService', 'DocumentVersionsService', 'DownloadExportService','StripsService'];
function ViewDocumentCtrlService(ItemTemplateCompileCtrlService, MaterialsService, DocumentVersionsService, DownloadExportService, service) {
    return function ($ctrl, $element, isPopup) {
        console.log('ViewDocumentCtrlService');
        var clsComp = 'compare-script padding-bottom-0';
        $ctrl.MaterialsService = MaterialsService;
        $ctrl.DocumentVersionsService = DocumentVersionsService;
        $ctrl.DownloadExportService = DownloadExportService;

        $ctrl.service = service;

        $ctrl.download = download;
        $ctrl.preInit = preInit;
        $ctrl.getItemPopupTemplate = getItemPopupTemplate;
        $ctrl.getDownloadLink = getDownloadLink;

        $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function preInit() {
            if ($ctrl.isPopup) {
                if (!$ctrl.extraParam) {
                    $ctrl.extraParam = {};
                }
                $ctrl.type = $ctrl.extraParam.type;
                $ctrl.previousVersion = $ctrl.extraParam.previousVersion;
                $ctrl.withDownload = $ctrl.extraParam.withDownload;
                $ctrl.withoutDownloadPDF = $ctrl.extraParam.withoutDownloadPDF;
            } else {
                $ctrl = _.extend($ctrl, $ctrl.fileOptions);
                $ctrl.LCS.addClass($ctrl.element, clsComp +
                    ($ctrl.withHeader ? ' with-top-header' : ' without-top-padding') +
                    ($ctrl.withoutSidebar ? ' without-sidebar' : '')
                );
                if ($ctrl.withoutSidebar) {
                    $ctrl.LCS.addClass($ctrl.element.parentElement, 'without-sidebar');
                }
            }

            $ctrl.prevTitle = 'prevTitle';
            $ctrl.currentTitle = 'currentTitle';

            $ctrl.itemName = ($ctrl.type === 1 ? 'document' : ($ctrl.type === 2 ? 'script' : 'avscript'));
            $ctrl.fileType = ($ctrl.type === 1 ? 'SBDOC' : ($ctrl.type === 2 ? 'SBX' : 'SBAV'));
            $ctrl.popupTitle = 'Preview ' + $ctrl.CPS.capitalizeFirst($ctrl.itemName);
            $ctrl.empty = 'There is no content for this ' + $ctrl.itemName;

            $ctrl.firstBtnMethod = 'download';
            $ctrl.btnText = 'Download';


            if(!$ctrl.item){
                console.error('empty item');
                return;
            }
            if(!$ctrl.item.content && $ctrl.item.size){
                $ctrl.dontAutoloadTemplate = true;
                processDownload($ctrl.item);
            } else {
                onComplete();
            }
        }

        function getBHeader() {
            return '<div class="top-table table-div full-width">' +
                '<div class="table-col">' +
                $ctrl.LCS.getISBDiv('eye', 4, 'gray') +
                '<span class="stronger title with-margin-left">' + $ctrl.popupTitle + '</span>' +
                '</div>' +
                '<div class="table-col legend">' + getDownloadBtn() + '</div>' +
                '</div>';
        }

        function getDownloadBtn() {
            // return $ctrl.withDownload ? ('<a class="edit-profile btn btn-small primary" ng-click="$ctrl.download($event)">' + $ctrl.LCS.getISBDiv('pencil', 2, 'gray pull-left with-margin-right') + '<div class="inline-block">Download '+$ctrl.CPS.capitalizeFirst($ctrl.itemName)+'</div></a>') :'';
var name = 'Download ' + ($ctrl.originalVersion ? 'File' : 'PDF');
return $ctrl.withDownload ? ('<div dropdown class="position-relative download-drp">' +
                '<button type="button" class="btnMore btn btn-small dropdown-toggle dots without-text transparent3" dropdown-toggle aria-haspopup="true" aria-expanded="true"> ' + $ctrl.LCS.getISBDiv('vertical-dots', 1) + '</button>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft col200 pull-right" role="menu">' +
                    '<ul class="listitems-selector with-checked">' +
($ctrl.withoutDownloadPDF ? '' : ('<li><a class="table-div full-width '+$ctrl.getBtnActionCls()+'" data-type="' + ($ctrl.originalVersion ? 'getDownloadLink' : 'download')+'" ' + ($ctrl.originalVersion ? 'target="_self"' : 'data-info="PDF"') + ' analytics-on analytics-action="' + name + '">' +
                            '<div class="col30">' + $ctrl.LCS.getISBDiv(($ctrl.originalVersion ? 'download' : 'download-pdf'), 5) + '</div>' + '<div>'+name+'</div>' +
                        '</a></li>')) +
                        ($ctrl.originalVersion ? '' : ('<li><a class="table-div full-width '+$ctrl.getBtnActionCls()+'" data-info="'+$ctrl.fileType+'" data-type="download" analytics-on analytics-action="Download '+$ctrl.fileType+'">' +
                            '<div class="col30">' + $ctrl.LCS.getISBDiv('download-'+$ctrl.fileType, 5) + '</div>' + '<div>Download '+$ctrl.fileType+'</div>' +
                        '</a></li>')) +
                      /* '<li class="sb-hide '+$ctrl.getBtnActionCls()+'" data-info="RTF" data-type="download"><a class="table-div full-width" analytics-on analytics-action="Download RTF File">' +
                            '<div class="col30">' + $ctrl.LCS.getISBDiv('download', 5) + '</div>' + '<div>Download RTF</div>' +
                        '</a></li>' +*/
                    '</ul>' +
                '</div>' +
            '</div>') : '';
        }


        function getBBody() {
        return '<div class="body-table-parent-wrapper h-full full-width fix-column-height workflow-cards-scroll-wrapper fancy-scrollbar h-full">' +
                    '<div class="h-full column-right-screenplay full-width" ng-class="{\'single-col centered\':!(!$ctrl.LCS.noSidebarFilters&&$ctrl.previousVersion)}" ng-style="{\'padding-left\': \'10px\'}">' +
                        getScriptContent($ctrl.item ? $ctrl.item.content : null) +
                    '</div>' +
                '</div>';
        }

        function getDownloadLink() {
            processDownload($ctrl.originalVersion, function (link) {
                $ctrl.SBStateService.assignUrl(link, null);
            }, function (err){

            }, true);
        }

        function getItemPopupTemplate() {
            if(!$ctrl.isLoaded){
                return '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
            }
            var id = 'id="compareDocuments"';
            if ($ctrl.isPopup) {
                return $ctrl.getItemPopupMSForm([{
                    fCls: 'with-no-padding',
                    cls: clsComp + ' h-full',
                    body: getBody()
                }], 'h-full', true, id);
            } else if ($ctrl.withHeader) {
                return getBody();
            } else {
                return '<div ' + id + ' class="body-table full-width h-full">' + getBBody() + '</div>'
            }

            function getBody() {
            return '<div class="h-full" >' +
                        '<div class="modal-header hide-ipad">' + getBHeader() + '</div>' +
                        '<div class="body-table medium-template h-full spacing-half-top">' + getBBody() + '</div>' +
                    '</div>';
            }
        }

        function getScriptContent(content) {
        return  '<div class="document-version-wrapper bg-white centered spacing-double margin-half">' +
                    '<div class="sceneEditor screenplayeditor screenplay-padding">' +
                        '<div class="editorwrapper ql-container ql-snow">' +
                            '<div class="ql-editor ' + ($ctrl.type === 2 ? ('scene-wrapper init-top-margin') : ' sbdoc-wrapper ') + '">' + (content ? content : $ctrl.empty) + '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>';
        }

        function download(type) {
            var item = $ctrl.item;
            if(!item){
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.download.error', 'error');
                return;
            }
            switch(type) {
                case 'PDF':
                    $ctrl.popupsService.open(item, $ctrl.popupsService.operations.documentDownload, _.extend({
                        itemTitle: 'Version',
                        versionId: item.documentVersionId || item._id,
                        title: item.name,
                        titlePage: item.titlePage,
                        createdBy: item.createdBy
                    }, item.documentVersionId ? null : (item.content ? {
                        contentVersion: {
                            content: item.content,
                            name: item.name,
                            type: $ctrl.type
                        }
                    } : null)), $ctrl.compOptions);
                    break;

                case $ctrl.fileType:
                    d(item.documentVersion ? item.documentVersion : {
                        name: item.name,
                        type: $ctrl.type,
                        content: item.content,
                    }, item.content);
                    break;

                case 'RTF':
                    var htmlToRtfLocal = new window.htmlToRtf();
                    var rtfContent = htmlToRtfLocal.convertHtmlToRtf(item.content);
                    d({
                        name: item.name,
                        type: $ctrl.type, //other
                    }, rtfContent);
                    break;
            }
        }

        function d(item, content) {
            if (!content) {return;}
            $ctrl.DownloadExportService.downloadAttachment($ctrl.DownloadExportService.createBlobFromContent($ctrl.DocumentVersionsService.getFilename(item), content));
        }

        function processDownload(v, onsuccess, onerror, isOriginal) {
            if ($ctrl.isDownloading) {
                return;
            }

            $ctrl.isDownloading = true;
            $ctrl.MaterialsService.getDownloadLink({
                id: v.materialId,
                versionId: v._id,
                productId: v.productId,
                companyId: v.companyId,
            }, onSuccess, onError);

            function onSuccess(link) {
                $ctrl.isDownloading = false;
                //var headers = $ctrl.security.getHttpHeaders(state, params)

                if (isOriginal) {
                    $ctrl.LCS.timeout(function () {
                        onsuccess(link);
                    }, 500);
                    return false;
                } else {
                    $ctrl.security.getRequest(link, null, function (result) {
                        var data = result && result.data !== 'undefined' ? result.data : null,
                            size = parseInt(v.size, 10);
                        onComplete((data && size > 0 || !data && size === 0) ? data : null);
                    }, function (err) {
                        console.log(err);
                        onComplete();
                    });
                }
            }

            function onError(err) {
                $ctrl.isDownloading = false;
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.download.error', 'error');
                onerror(err);
            }
        }

        function onComplete(content) {
            if (content) {
                $ctrl.item.content = content;
            }
            $ctrl.isLoaded = true;
            $ctrl.reloadTemplate();
        }
    }
}

