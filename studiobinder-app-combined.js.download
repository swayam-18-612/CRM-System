angular.module('product.preLoading.script.group.service', [
    'product.preLoading.init.group.service',
    'product.preLoading.strips.service',
    'product.preLoading.taggingElements.service',
    'product.preLoading.taggingCategories.service',
    'product.preLoading.taggingScenes.service',
    'product.preLoading.locations.service',
    'product.preLoading.shots.service',
    'product.preLoading.shotsLists.service',
    'product.preLoading.storyboards.service',
    'product.preLoading.storyboardsLists.service',
    'product.preLoading.stripSchedules.service',
    'product.preLoading.stripsLists.service',
    'product.preLoading.schedulesLists.service'
])
 .service('ScriptGroupLoadingService', ScriptGroupLoadingService);
ScriptGroupLoadingService.$inject = ['InitGroupLoadingService','StripsLoadingService', 'TaggingElementsLoadingService', 'TaggingCategoriesLoadingService', 'TaggingScenesLoadingService', 'LocationsLoadingService','ShotsListsLoadingService', 'ShotsLoadingService','StoryboardsListsLoadingService', 'StoryboardsLoadingService','StripSchedulesLoadingService','SchedulesListsLoadingService', 'StripsListsLoadingService'];
function ScriptGroupLoadingService(InitGroupLoadingService, Strips, TaggingElements, TaggingCategories, TaggingScenes, Locations, ShotsLists, Shots, StoryboardsLists, Storyboards, StripSchedules, SchedulesLists, StripsLists) {

    var Tbl = {}, TblTypes = {};

    _.each([Strips, StripsLists, TaggingScenes, TaggingElements, TaggingCategories,
    StripSchedules, SchedulesLists, Locations, ShotsLists, Shots, StoryboardsLists, Storyboards], function (table){
        var name = table.name,
            lists = name === 'StoryboardsLists' || name === 'ShotsLists',
            withoutLoad = name === 'Storyboards' || name === 'Shots' || lists;
        TblTypes[name] = table.tableType;
        Tbl[TblTypes[name]] = {
            loadingService: table,
            withoutLoad: withoutLoad
        };
    });

    var Resource = new InitGroupLoadingService(Tbl, 'isInitScript', null, TblTypes);
    var service = Tbl[TblTypes.TaggingScenes].loadingService;

    Resource.characterCategoryId = service.characterCategoryId;
    Resource.stripLocationCategoryId = service.stripLocationCategoryId;

    Resource.prototype.characterCategoryId = service.characterCategoryId;
    Resource.prototype.stripLocationCategoryId = service.stripLocationCategoryId;

    Resource.prototype.getShownCategories = function (withChars) {
        var _this = this;
        return _this.getObjectList(_this.TblTypes.TaggingCategories, function (item) {
            return withChars || item._id !==  Resource.characterCategoryId;
        });
    };

    Resource.prototype.getCategoryById = function (id) {
        var _this = this;
        return id ? _this.getById(_this.TblTypes.TaggingCategories, id) : null;
    };

    Resource.prototype.getShootingSchedules = function () {
        var _this = this;
        return _this.getObjectList(_this.TblTypes.StripSchedules, {});
    };

    Resource.prototype.getShotsListsTreeType = function () {
        var _this = this;
        return _this.getListCount(_this.TblTypes.ShotsLists, function (item) {
            return item.type === 5;
        }) > 0 ? 5 : 6;
    };

    Resource.prototype.getStripLocations = function () {
        var _this = this;
        return _this.getObjectList(_this.TblTypes.TaggingElements, {type: 3});
    };

    Resource.prototype.setUpdateFromStrip = function (item) {
        var _this = this, table = _this.Tbl[_this.TblTypes.Strips];
        return table.loadingService.setUpdateFromStrip(_this.getTableParams(table), item);
    };

    Resource.prototype.getNewSceneNumber = function (list, afterId) {
        var _this = this, table = _this.Tbl[_this.TblTypes.Strips];
        return table.loadingService.getNewSceneNumber(list, afterId);
    };

    Resource.prototype.updateStripLocation = function (oldStripLocation, params, def, onsuccess, onerror) {
        var _this = this,
            TaggingScenesService = _this.getObjectService(_this.TblTypes.TaggingScenes);
        TaggingScenesService.insert(_.extend(params, def), function (result) {
            result.type = 'Create';
            result = _this.processSceneElement(result, 'taggingScenes');
            var item = result.item,
                stripLocation = item ? _this.getById(_this.TblTypes.TaggingElements, item.elementId) : null;
            if (!stripLocation) {
                return onerror('Invalid Strip Location');
            }
            if (!oldStripLocation) {
                return process();
            }

            var l = _this.getList(_this.TblTypes.TaggingScenes, _.extend({
                elementId: oldStripLocation._id,
            }, def));

            if (!l || !l.length) {
                return process();
            }

            TaggingScenesService.delete(TaggingScenesService.convertResource(l[0]), function (result) {
                result.type = 'Remove';
                result = _this.processSceneElement(result, 'taggingScenes');
                process();
            }, function (err) {
                console.log(err);
            });

            function process() {
                onsuccess({
                    stripLocations: _this.getStripLocations(),
                    stripLocation: stripLocation
                });
            }

        }, onerror);
    };

    Resource.prototype.getElementReferences = function (id) {
        var _this = this, table = _this.Tbl[_this.TblTypes.TaggingElements];
        return table.loadingService.getElementReferences(_this.getTableParams(table), id);
    };

    Resource.prototype.getElementsCountForStrip = function (stripId) {
        var _this = this, table = _this.Tbl[_this.TblTypes.TaggingElements];
        return table.loadingService.getElementsCountForStrip(_this.getTableParams(table), stripId);
    };

    Resource.prototype.getElementsNotInStrip = function (categoryId, stripId) {
        var _this = this, table = _this.Tbl[_this.TblTypes.TaggingElements];
        return table.loadingService.getElementsNotInStrip(_this.getTableParams(table), categoryId, stripId);
    };

    Resource.prototype.getCharactersForStrip = function (stripId) {
        var _this = this, table = _this.Tbl[_this.TblTypes.TaggingElements];
        return table.loadingService.getCharactersForStrip(_this.getTableParams(table), stripId);
    };

    Resource.prototype.beforeTablesProcessed = function (_this) {
        var table = _this.Tbl[_this.TblTypes.TaggingElements];
        table.loadingService.setTaggingScenesName(_this.getTableParams(table));
    };

    Resource.prototype.getLocationsForStrip = function (item) {
        var _this = this, table = _this.Tbl[_this.TblTypes.Locations];
        return table.loadingService.getLocationsForStrip(_this.getTableParams(table), item);
    };

    Resource.prototype.processSceneElement = function (result, col) {
        console.log('PROCESS_SCENE_ELEMENT');
        var _this = this,
            updatesG = _.clone(result.updatesG),

            table = _this.getTableForCollection(col),
            r = updatesG ? updatesG[col] : null,
            countUpdated = 0;

        result.withStripChanges = result.updatesG && result.updatesG.strips && result.updatesG.strips.set ? result.updatesG.strips.set: false;
        updates();

        switch (result.type) {
            case 'Create':
            case 'Remove':
                // new scene element {added:{taggingElements, taggingScenes}, updates:{strips: {id:'updates'}, taggingElements:{id:'updates'}}}
                var isCreate = result.type === 'Create',
                    els = r ? r[isCreate ? 'add' : 'del'] : null;
                countUpdated = els && els.length > 0 ? els.length : 0;
                result.countUpdated = countUpdated;
                if (countUpdated > 0 && isCreate) {
                    var el = els[0], id = el ? (el._id ? el._id : el) : null;
                    if (id) {
                        result.item = _this.getByIdFromTable(table, id);
                    }
                }
                break;

            case 'ApplyChanges':
                // new scene element {added:{taggingElements, taggingScenes}, updates:{strips: {id:'updates'}, taggingElements:{id:'updates'}}}
                var elsC = r ? r['add'] : null,
                    elsD = r ? r['del'] : null;
                result.countUpdated = (elsC && elsC.length > 0 ? elsC.length : 0) + (elsD && elsD.length > 0 ? elsD.length : 0);
                break;

            case 'Edit':
                break;
        }

        return result;

        function updates() {
            if (!result) {
                return;
            }
            _this.processTablesUpdatesG(result);

            if (col === 'taggingElements' || col === 'taggingScenes') {
                var tableEl = _this.Tbl[_this.TblTypes.TaggingElements];
                tableEl.loadingService.setTaggingScenesName(_this.getTableParams(tableEl));
            }
        }
    };

    Resource.prototype.getSchedulesLists = function (query, order, populate) {
        var _this = this;
        return _this.getObjectList(_this.TblTypes.SchedulesLists, query, order, populate);
    }

    Resource.prototype.getStripSchedules = function (query, order, populate) {
        var _this = this;
        return _this.getObjectList(_this.TblTypes.StripSchedules, query, order, populate);
    }

    Resource.prototype.getStripScheduleById = function (id) {
        var _this = this;
        return _this.getById(_this.TblTypes.StripSchedules, id);
    }

    Resource.prototype.getTaggingCategories = function (query, order, populate) {
        var _this = this;
        return _this.getObjectList(_this.TblTypes.TaggingCategories, query, order, populate);
    }

    Resource.prototype.getTaggingCategoryById = function (id) {
        var _this = this;
        return _this.getById(_this.TblTypes.TaggingCategories, id);
    }

    Resource.prototype.getTaggingScenes = function (query, order, populate) {
        var _this = this;
        return _this.getObjectList(_this.TblTypes.TaggingScenes, query, order, populate);
    }

    Resource.prototype.getTaggingScenesWithElements = function (query) {
        var _this = this;
        var l = _this.getTaggingScenes(query);
        return l && l.length>0 ? l.map(function (el){
            el.element = _this.getTaggingElementById(el.elementId);
            return el;
        }) : [];
    }

    Resource.prototype.getTaggingSceneById = function (id) {
        var _this = this;
        return _this.getById(_this.TblTypes.TaggingScenes, id);
    }

    Resource.prototype.getLocations = function (query, order, populate) {
        var _this = this;
        return _this.getObjectList(_this.TblTypes.Locations, query, order, populate);
    }

    Resource.prototype.getTaggingElements = function (query, order, populate) {
        var _this = this,
            l =_this.getObjectList(_this.TblTypes.TaggingElements, query, order, populate);
        return l && l.length > 0 ? _.filter(l, function (el){
            var exists = el.categoryId !== null && el.categoryId !== undefined && el.deleted === false;
            return exists ? _this.getTaggingCategoryById(el.categoryId) : false;
        }) : l;
    }

    Resource.prototype.getTaggingElementById= function (id) {
        var _this = this;
        return _this.getById(_this.TblTypes.TaggingElements, id);
    }

    Resource.prototype.getStrips = function (query, order, populate) {
        var _this = this;
        return _this.getObjectList(_this.TblTypes.Strips, query, order, populate);
    }

    Resource.prototype.getStripById = function (id, settings) {
        var _this = this;
        return _this.getById(_this.TblTypes.Strips, id, settings);

    }
    Resource.prototype.getLocationById = function (id) {
        var _this = this;
        return _this.getById(_this.TblTypes.Locations, id);

    }

    Resource.prototype.getSelectedStrips = function(query, order, hasQuotaType) {
        var _this = this,
            items = _this.getStrips(query, order),
            stripsCount = items ? items.length : 0;
        return stripsCount && !hasQuotaType ? items.splice(0, Math.ceil(stripsCount / 2)) : items;
    }

    Resource.prototype.getSelectedTaggingScenes = function(query, strips) {
        var _this = this,
            items = _this.getTaggingScenes(query);
        //todo remove tagging scene from scenes not displayed
        return (items.length > 0 && strips && strips.length > 0) ? _.filter(items, function (tag) {
            return _.find(strips, {_id: tag.stripId});
        }) : items;
    }

    Resource.prototype.getProcessedStripsTables = function(query, order, withCategories, hasQuotaType) {
        var _this = this;
        var locations = _this.getLocations({active: true}), //todo consider only active locations ???

            strips = _this.getSelectedStrips(query, order, hasQuotaType),
            taggingScenes = _this.getSelectedTaggingScenes(null, strips),
            elsIds = [];

        _.each(taggingScenes, function (tag) {
            if (_.find(elsIds, function (id) {
                return id === tag.elementId;
            }) === undefined) {
                elsIds.push(tag.elementId);
            }
        });

        var elements = _this.getTaggingElements();


        var tables = {
            locations: locations,
            taggingScenes: taggingScenes,
            elements: _.filter(elements, function (item) {
                return elsIds.indexOf(item._id) !== -1;
            }),
            nonscriptedElements: _.filter(elements, function (item) {
                return elsIds.indexOf(item._id) === -1;
            })
        };

        tables.strips = strips && strips.length > 0 ? strips.map(function(item) {
            return _this.loadStrip(item, tables);
        }) : [];

        if (withCategories) {
            tables.categories = _this.getTaggingCategories();
        }

        return tables;
    };

    Resource.prototype.preloadSettings = function () {
        var _this = this;
        var els = _this.getTaggingElements();
        return {
            taggingScenes: _this.getTaggingScenes(),
            elements: els,
            locations: _this.getLocations({active: true}),

            characters: els ? _.filter(els, isCharacter) : null,
            stripLocations: els ? _.filter(els, isStripLocation) : null
        };
    };

    Resource.prototype.getPopulatedStripById = function (id, settings) {
        var _this = this;
        if(!settings){settings = {};}
        return id ? _this.getPreById(_this.TblTypes.Strips, id, {
            locations: settings.locations,
            stripEls: getElementsForStrip(id, settings.elements, settings.taggingScenes)
        }) : null;
    };

    Resource.prototype.loadStrip = function (item, settings) {
        if (!item) {
            return item;
        }
        if(!settings){settings = {};}
        return Strips.populateStrip(item, settings.locations, getElementsForStrip(item._id, settings.elements, settings.taggingScenes));
    };

    function isCharacter(item) {
        return item && item.type === 1;
    }

    function isStripLocation(item) {
        return item && item.type === 3;
    }

    Resource.prototype.getExtendedStrip  = function (item, strip, isScheduling, Settings) {
        var _this = this,
        isScene = item && item.type === 1;
        if (!strip && isScene) {
            if(isScheduling){
                strip = _this.getPopulatedStripById(item.stripId, Settings);
            }else{//if is not scheduling the strip didn't get yet updated in the cache
                strip = _this.loadStrip(item, Settings);
            }
        }

        return item ? (isScene ? _.extend({}, strip ? strip : {}, isScheduling ? {
            _id: item._id,
            stripId: item.stripId,
            order: item.order,

            schedulesListId: item.schedulesListId,
            scheduleDayId: item.scheduleDayId,

            active: item.active,
            isNotOmitted: strip && strip.active !== false,

            time: item.time,
            endTime: item.endTime,
        } : null) : item) : null;
    };

    return Resource;

    function getElementsForStrip(stripId, elements, taggingScenes) {
        if (!stripId) {
            return null;
        }
        var l = _.filter(_.filter(taggingScenes, {stripId: stripId}).map(function (item) {
            return item ? _.find(elements, {_id: item.elementId}) : null;
        }), function (item) {
            return item!== null && item !== undefined;
        });

        return l && l.length > 0 ? l : null;
    }
}

angular.module('product.scheduling.scriptProcessing.service', [
]).service('ScriptProcessingService', ScriptProcessingService);

function ScriptProcessingService() {
    var lineSep = ' - ',
        sceneTypes = ['INT.', 'EXT.', 'INT/EXT.', 'EXT/INT.'],
        transitions = ['Cut to:', 'Fade in:', 'Fade out.', 'Fade to:', 'Fade out', 'Fade to:', 'Dissolve to:', 'Back to:', 'Match cut to:', 'Jump cut to:', 'Smash to:', 'Fade to black.'],
        timesOfDay = ['day', 'night', 'dawn', 'sunrise', 'morning', 'afternoon', 'noon', 'dusk', 'sunset', 'evening', 'twilight', 'midnight', 'this moment', 'that moment', 'moments later', 'later', 'continuous', 'same time', 'immediately after', 'the next day', 'later that day', 'same day', 'late night', 'same night', 'same morning', 'late afternoon', 'same afternoon', 'high noon', 'same evening', 'later that evening', 'late evening', 'later that night', 'late night'],
        charAppend = ['(V.O.)', '(O.S.)', '(O.C.)', '(SUBTITLE)', '(CONT’D)', '(CONT\'D)'],
        ListsDayTime = {
            listDay: [
                {t: 'the next day', v: 3}, {t: 'later that day', v: 3}, {t: 'same day', v: 3}, {t: 'day', v: 3}, {t: 'dia', v: 3}, {t: 'día', v: 3}, {t: 'jour', v: 3}, {t: 'year', v: 3}, {t: 'years', v: 3},
                {t: 'dawn', v: 10},
                {t: 'sunrise', v: 1},
                {t: 'morning', v: 2}, {t: 'same morning', v: 2}, {t: 'manhã cedo', v: 2}, {t: 'morgen', v: 2}, {t: 'primera hora día', v: 2},
                {t: 'late afternoon', v: 4}, {t: 'same afternoon', v: 4}, {t: 'afternoon', v: 4}, {t: 'high noon', v: 4}, {t: 'noon', v: 4}, {t: 'mediodía', v: 4}
            ],
            listNight: [
                {t: 'dusk', v: 8},
                {t: 'sunset', v: 6},
                {t: 'evening', v: 5}, {t: 'same evening', v: 5}, {t: 'soir', v: 5},
                {t: 'later that evening', v: 5}, {t: 'late evening', v: 5}, {t: 'kveld', v: 5},
                {t: 'twilight', v: 7},
                {t: 'midnight', v: 9}, {t: 'later that night', v: 9}, {t: 'late night', v: 9}, {t: 'same night', v: 9}, {t: 'night', v: 9}, {t: 'noite', v: 9}, {t: 'noche', v: 9}, {t: 'natt', v: 9}, {t: 'nuit', v: 9}
            ],
            listCont: [{t: 'this moment'}, {t: 'that moment'}, {t: 'moments later'}, {t: 'later'}, {t: 'continuous'}, {t: 'same time'}, {t: 'same'}, {t: 'immediately following'}, {t: 'immediately after'}, {t: 'before'}, {t: 'year'}, {t: 'month'}, {t: 'tarde'}, {t: 'plus tard'}]
        },
        ListTypes = [//begining is the int, ext or i/e
            {t: 'int./ext.', v: 2}, {t: 'int/ext.', v: 2}, {t: 'int/ext', v: 2},
            {t: 'ext./int.', v: 4}, {t: 'ext/int.', v: 4}, {t: 'ext/int', v: 4},
            {t: 'i./e.', v: 2}, {t: 'i./e', v: 2}, {t: 'i/e.', v: 2}, {t: 'i/e', v: 2},
            {t: 'e./i.', v: 4}, {t: 'e/i.', v: 4}, {t: 'e./i', v: 4}, {t: 'e/i', v: 4},
            {t: 'ext.', v: 3}, {t: 'ext', v: 3},
            {t: 'int.', v: 1}, {t: 'int', v: 1}
        ],
        ListTypesSimple = [//begining is the int, ext or i/e
            {t: 'int/ext.', v: 2},
            {t: 'ext/int.', v: 4},
            {t: 'ext.', v: 3},
            {t: 'int.', v: 1}
        ];

    return {
        LineSep: lineSep,
        SceneTypes: sceneTypes,
        Transitions: transitions,
        TimesOfDay: timesOfDay,
        CharAppend: charAppend,
        isTransition: isTransition,
        getSceneHeadingInfo: getSceneHeadingInfo,
        getCharactersInfo: getCharactersInfo
    };

    function getSceneHeadingInfo(name, isExact) {
        var result = {};
        if (name === '') {
            return result;
        }
        var s = name.toLowerCase().trim().replace('\t', '').replace('\n', '').replace('  ', ' ').replace(/—/g, '-').replace(/–/, '-').replace(/--/, '-').replace(/\t/g, ' ').replace(/\u00A0/g, ' ').replace(/'/g, '’').replace(/\((.*?)\)/, '').replace(/-$/, '').trim();
        //check if day is sep by ', '
        for (var prop in ListsDayTime) {
            var l = ListsDayTime[prop];
            for (var j = 0, m = l.length; j < m; j++) {
                var t = l[j].t, el1 = ', ' + t;
                if (s.indexOf(el1) !== -1) {
                    s = s.replace(el1, lineSep + ' ' + t);
                }
            }
        }

        s = s.split('-');
        for (var i = s.length - 1; i >= 0; i--) {
            if (s[i].trim() === '') {
                s.splice(i, 1);
            }
        }

        var firstpart = s.length > 0 ? s[0].trim() : '';
        if (firstpart.length > 0) {
            //check if contains scene number in front
            var match = getMatch(firstpart, /^[0-9]+[A-zÀ-ÿØ-ÞΆΈ-ΏΑ-ΫϢϤϦϨϪϬϮϴϷϹϺϽ-Ͽ]*(\.|\s)/g);
            if (match) {
                result.sceneScript = match[0].trim();
                firstpart = firstpart.replace(match[0], '').trim();
            }
        }

        var k, el, prevType = null;//todo get from prev scene
        if (s.length > 0) {
            var st = getSceneType(firstpart.trim(), isExact);
            result.sceneType = getSceneByType(st.v);
            result.sceneTypeValue = st.v;
            var tlin = st.t.trim();
            if (tlin === '') {
                s.splice(0, 1);
            } else {
                s[0] = tlin;
            }

            var time = [], location = [], timeAdded = false, newt;
            for (k = s.length - 1; k >= 0; k--) {
                s[k] = s[k].trim();
                el = s[k];
                if (el !== '') {
                    newt = getDayTime(el.toLowerCase(), prevType);
                    //if(k>0 &&!timeAdded && (newt.r !== 0 || newt.r === 0 && newt.isContinuous)) {
                    if (k > 0 && (newt.r !== 0 || newt.r === 0 && newt.isContinuous)) {
                        time.push(newt);
                        timeAdded = true;
                    } else {
                        location.push(el);
                    }
                }
            }
            var templ = (timeAdded ? location.reverse() : s).join(lineSep).trim().replace(/,$/, '').trim().toUpperCase();

            var lt = time.length, tempt;
            if (lt > 0) {
                for (k = 0; k < lt; k++) {
                    el = time[k];
                    if (el.v !== 0) {
                        result.dayTime = el;
                        break;
                    } else {
                        tempt = el;
                    }
                }
                if (!result.dayTime && tempt) {
                    result.dayTime = tempt;
                }
            }

            if (!result.dayTime) {
                var sd = templ.split('. '), ld = sd.length;
                if (ld > 1) {
                    newt = getDayTime(sd[ld - 1].toLowerCase(), prevType);
                    if (newt.r !== 0 || newt.r === 0 && newt.isContinuous) {
                        result.dayTime = newt;
                        sd.splice(ld - 1, 1);
                        templ = sd.join('. ').trim();
                    }
                }
            }

            if (templ) {
                result.location = templ.trim().toUpperCase();
            }

            if (result.dayTime) {
                result.exactTime = s.join(lineSep).replace(new RegExp('^' +escapeRegexp(result.location + lineSep), 'gi'), '');
            }
        }

        return result;

        function escapeRegexp(queryToEscape) {
            return queryToEscape.replace(/([.?*+^$[\]\\(){}|-])/g, '\\$1');
        }
        function getDayTime(lt, prevType) {
            var val = getTimeType(lt, ListsDayTime.listDay, 3); // day list
            if (val.r === 0) {
                val = getTimeType(lt, ListsDayTime.listNight, 9);
            } // night list
            if (val.r === 0) {
                val = getTimeType(lt, ListsDayTime.listCont, prevType, true);
            }//continuous list
            return val;
        }

        function getTimeType(lt, list, val, isCont) {
            for (var j = 0, lj = list.length; j < lj; j++) {
                var t = list[j].t, v = list[j].v;
                if (t) {
                    var match = getWordMatch(lt, t);
                    if (match) {
                        return {r: val, v: v ? v : val, isContinuous: isCont};
                    }
                }
            }
            return {r: 0};
        }

        function getSceneByType(type) {
            switch (type) {
                case 1:
                    return 'INT.';
                case 2:
                    return 'INT/EXT.';
                case 3:
                    return 'EXT.';
                case 4:
                    return 'EXT/INT.';
            }
            return ''
        }
    }

    function getCharactersInfo(c) {
        var result = {};
        if (!c || c === '') {
            return;
        }
        var ch = c.match(/\((.*?)\)(\s)*$/gi);
        if (ch) {
            result.characterAp = ch[0];
        }
        c = c.replace(/\((.*?)\)/g, '')
            .replace(/\[(.*?)\]/g, '')
            .replace(/(\s)*\((.*)/g, '')
            .replace(/\:/g, '')
            .trim()
            .replace(/ and /gi, ' and ')
            .trim();
        if (c !== '') {
            result.charText = c;
            if (c.indexOf('\/') !== -1) {
                processSplit('\/');
            }
            if (c.indexOf('|') !== -1) {
                processSplit('|');
            }
            if (c.indexOf(' and ') !== -1) {
                processSplit(' and ');
            } else {
                addChar(c);
            }

            function processSplit(s1) {
                var ls = c.split(s1);
                for (var x = 0; x < ls.length; x++) {
                    addChar(ls[x]);
                }
            }

            function addChar(c) {
                c = c ? c.trim().toUpperCase() : null;
                if (c) {
                    if (!result.character) {
                        result.character = [];
                    }
                    result.character.push(c);
                }
            }
        }
        return result;
    }

    function isTransition(name) {
        for (var j = 0, lj = transitions.length; j < lj; j++) {
            if (getMatch(name, new RegExp('^' + transitions[j].replace(':', '').replace('.', '') + '(:|\.)?$', 'gi'))) return true;
        }
        return false;
    }

    function getSceneType(lt, isExact) {
        var list = isExact ? ListTypesSimple : ListTypes;
        for (var j = 0, lj = list.length; j < lj; j++) {
            var el = list[j];
            var t = el.t;
            var sub = 0;
            if (lt.indexOf(t + '/') === 0) {
                sub = t.length + 1;
            } else if (lt.indexOf(t) === 0) {
                sub = t.length;
            }
            if (sub > 0) {
                return {v: el.v, t: lt.substring(sub, lt.length)};
            }
        }
        return {v: 0, t: lt};
    }

    function countOccurrences(str, regex) {
        if (!regex.global) {
            throw new Error('Please set flag /g of regex');
        }
        return (str.match(regex) || []).length;
    }

    function getMatch(str, regex) {
        if (str) {
            try {
                if (countOccurrences(str, regex) > 0) {
                    return regex.exec(str);
                }
                return null;

            } catch (e) {
                console.log(e);
                return null;
            }
        }
        return null;
    }

    function escapeRegexChars(str) {
        return str.replace(/([.?*+^$[\]\\(){}|-])/g, '\\$1');
    }

    function getSimpleWordMatch(str) {
        return new RegExp('(?<=[\\s,.:;"\']|^)' + escapeRegexChars(str) + '(?=[\\s,.:;"\']|$)', 'gi');
    }

    function getWordMatch(str, word) {
        // Regex word boundaries with Unicode:
        //(?<=[\s,.:;"']|^)UNICODE_WORD(?=[\s,.:;"']|$)
        var exp;
        try {
            var t = escapeRegexChars(word);
            if (t[t.length - 1] === '.') {
                t = t.substring(0, t.length - 1);
            }
            exp = getSimpleWordMatch(t);
        } catch (e) {
            console.log(e);
        }
        return exp && str && word ? getMatch(str, exp) : null;
    }
}

angular.module('product.preLoading.shots.group.service', [
    'product.preLoading.init.group.service',
    'product.preLoading.shots.service',
    'product.preLoading.shotsLists.service'
])
 .service('ShotsGroupLoadingService', ShotsGroupLoadingService);
ShotsGroupLoadingService.$inject = ['InitGroupLoadingService', 'ShotsLoadingService', 'ShotsListsLoadingService'];
function ShotsGroupLoadingService(InitGroupLoadingService, Shots, ShotsLists) {
    var Tbl = {}, TblTypes = {},
        listName = 'ShotsLists',
        itemName = 'Shots';

    _.each([ShotsLists, Shots], function (table) {
        var name = table.name;
        TblTypes[name] = table.tableType;
        Tbl[TblTypes[name]] = {loadingService: table};
        Tbl[TblTypes[name]].tableParamsColsInit = ['companyId', 'productId', 'scriptId'];
    });

    var Resource = new InitGroupLoadingService(Tbl, 'isInit' + itemName, {
        parent: TblTypes[listName],
        child: TblTypes[itemName],
    }, TblTypes);

    Resource.prototype.load = function (next) {
        var _this = this,
            tasks = {};

        add(listName, 'type');
        add(itemName, 'listType');

        async.parallel(tasks, function (err, res) {
            next();
        });

        function add(name, type, pageSize, populate) {
            tasks[name] = function (c) {
                _this.loadAndInitTable(_this.TblTypes[name], pageSize, populate, c, 'getAll', processParams, true);

                function processParams(params1) {
                    var scriptId = params1.scriptId || null;
                    var params = _.extend({}, params1);
                    delete params.scriptId;
                    var p6 = {};
                    p6[type] = 6;
                    var p5 = {};
                    p5[type] = 5;
                    params.$or = [p6, {$and: [p5, {scriptId: scriptId}]}];
                    return params;
                }
            };
        }
    };

    return Resource;
}

