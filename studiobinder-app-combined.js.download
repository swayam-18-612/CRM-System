            return cvc.length >= 3 && cvc.length <= 4;
        }
    };

    _validators.card = function (num, ctrl, scope, attr) {
        var card, ref, typeModel;

        if (attr.paymentsTypeModel) {
            typeModel = $parse(attr.paymentsTypeModel);
        }

        var clearCard = function () {
            if (typeModel) {
                typeModel.assign(scope, null);
            }
            ctrl.$card = null;
        };

        // valid if empty - let ng-required handle empty
        if (!num || !num.length) {
            clearCard();
            return true;
        }

        num = (num + '').replace(/\s+|-/g, '');

        if (!/^\d+$/.test(num)) {
            clearCard();
            return false;
        }

        card = Cards.fromNumber(num);

        if (!card) {
            clearCard();
            return false;
        }

        ctrl.$card = angular.copy(card);

        if (typeModel) {
            typeModel.assign(scope, card.type);
        }
        ref = num.length;
        return __indexOf.call(card.length, ref) >= 0 && (card.luhn === false || _luhnCheck(num));
    };

    _validators.expiry = function (val) {
        // valid if empty - let ng-required handle empty
        if (!val || !val.length) {
            return true;
        }

        var obj = Common.parseExpiry(val);

        var month = obj.month,
            year = obj.year;

        var currentTime, expiry, prefix;

        if (!(month && year)) {
            return false;
        }

        if (!/^\d+$/.test(month)) {
            return false;
        }

        if (!/^\d+$/.test(year)) {
            return false;
        }

        if (parseInt(month, 10) > 12) {
            return false;
        }

        if (year.length === 2) {
            prefix = (new Date).getFullYear();
            prefix = prefix.toString().slice(0, 2);
            year = prefix + year;
        }

        expiry = new Date(year, month);
        currentTime = new Date;
        expiry.setMonth(expiry.getMonth() - 1);
        expiry.setMonth(expiry.getMonth() + 1, 1);

        return expiry > currentTime;
    };

    return function (type, val, ctrl, scope, attr) {
        if (!_validators[type]) {

            var types = Object.keys(_validators);

            var errstr = 'Unknown type for validation: "' + type + '". ';
            errstr += 'Should be one of: "' + types.join('", "') + '"';

            throw errstr;
        }
        return _validators[type](val, ctrl, scope, attr);
    };
}

_ValidateWatchPaymentsFactory.$inject = ['_Validate'];
function _ValidateWatchPaymentsFactory(_Validate) {

    var _validatorWatches = {};

    _validatorWatches.cvc = function (type, ctrl, scope, attr) {
        if (attr.paymentsTypeModel) {
            scope.$watch(attr.paymentsTypeModel, function (newVal, oldVal) {
                if (newVal !== undefined && newVal !== oldVal) {
                    var valid = _Validate(type, ctrl.$modelValue, ctrl, scope, attr);
                    ctrl.$setValidity(type, valid);
                }
            });
        }
    };

    return function (type, ctrl, scope, attr) {
        if (_validatorWatches[type]) {
            return _validatorWatches[type](type, ctrl, scope, attr);
        }
    };
}

paymentsValidateDirective.$inject = ['$window', '_Validate', '_ValidateWatch'];
function paymentsValidateDirective($window, _Validate, _ValidateWatch) {
    return {
        restrict: 'A',
        require: 'ngModel',
        link: function (scope, elem, attr, ctrl) {

            var type = attr.paymentsValidate;

            _ValidateWatch(type, ctrl, scope, attr);

            var validateFn = function (val) {
                var valid = _Validate(type, val, ctrl, scope, attr);
                ctrl.$setValidity(type, valid);
                return valid ? val : undefined;
            };

            ctrl.$formatters.push(validateFn);
            ctrl.$parsers.push(validateFn);
        }
    };
}


 angular.module('services.persistenceService', [])
    .service('PersistenceService', PersistenceService);

PersistenceService.$inject = ['API_CONFIGS', '$localStorage'];
function PersistenceService(API_CONFIGS, $localStorage) {
    var _this = this;
    _this.prefix = API_CONFIGS().appId;

    _this.set = function set(key, data, isText) {
        setLocalStorage(key, data ? ((!isText || typeof (data) === 'object') ? JSON.stringify(data) : data) : null);
    }

    _this.get = function get(key, isText) {
        try {
            var data = getLocalStorage(key);
            return data ? (isText ? data : JSON.parse(data)) : null;
        } catch (e) {
            _this.remove(key);
            console.error('Error getting data from localStorage', e);
            return null;
        }
    }

    _this.setText = function(key, data) {
        _this.set(key, data, true);
    }

    _this.getText = function (key) {
         return _this.get(key, true);
    }

    _this.setProp = function setProp(key, prop, val) {
        var data = _this.get(key), changed = false;
        if (!data) {
            data = {};
            data[prop] = val;
            changed = true;
        } else if (val !== data[prop]) {
            data[prop] = val;
            changed = true;
        }
        if (changed) {
            _this.set(key, data);
        }

        return changed;
    }

    _this.getProp = function getProp(key, prop) {
        var data = _this.get(key);
        return data ? (prop ? data[prop] : data) : undefined;
    }

    _this.remove = function remove(key) {
        removeLocalStorage(key);
    }

    _this.getKey = function getKey(key) {
        return _this.prefix + '_' + key;
    }

    _this.getSchedulesOptions = function (productId, val) {
        _this.set("ScheduledListOptions" + productId, val);
    }

    _this.setSchedulesOptions = function (productId) {
        return _this.get("ScheduledListOptions" + productId);
    }

    _this.setStripOptions = function (productId, val) {
        _this.set("StripsListOptions" + productId, val);
    }

    _this.getStripOptions = function (productId) {
        return _this.get("StripsListOptions" + productId);
    }

    _this.setReportsViewed = function (productId, val) {
        _this.set("reports_viewed_" + productId, val);
    }

    _this.getReportsViewed = function (productId) {
        return _this.get("reports_viewed_" + productId);
    }

    _this.setScriptsViewed = function (productId, val) {
        _this.set("script_viewed_" + productId, val);
    }

    _this.getScriptsViewed = function (productId) {
        return _this.get("script_viewed_" + productId);
    }

    _this.setGeoLocations = function (val) {
        _this.set("geocoder_locations", val);
    }

    _this.getProductionCalendarSettings = function (companyId) {
        return _this.get("production_calendars_" + companyId) || {};
    }

    _this.setProductionCalendarSettings = function (companyId, val) {
        _this.set("production_calendars_" + companyId, val);
    }

    return _this;

    function getLocalStorage(key){
        return $localStorage[_this.getKey(key)];
    }

    function setLocalStorage(key, data){
        try {
            $localStorage[_this.getKey(key)] = data;
        } catch (e) {
            console.error('Error saving to localStorage', e);
        }
    }
    function removeLocalStorage(key){
        try {
            delete $localStorage[_this.getKey(key)];
        } catch (e) {
            console.error('Error removing data from localStorage', e);
        }
    }
}

angular.module('services.pollingService', [
    'services.sbHttp'
])
.service('PollingService', PollingService);

PollingService.$inject = ['security'];
function PollingService(security) {
    return function (options) {
        var service = _.extend(this, options);

// interval is how often to poll
        if (!service.interval) {
            service.interval = 5;
        }
        // timeout is how long to poll waiting for a result (0 means try forever)
        if (!service.timeout) {
            service.timeout = 0;
        }

        service.poll = poll;
        service.stop = stop;

        return service;

        function stop() {
            service.stopPolling = true;
            if(service.timerId) {
                clearTimeout(service.timerId);
            }
        }

        function poll(url, postParams, onSuccess, onError) {
            var startPolling = function () {
                if (service.stopPolling === true) {
                    return;
                }
                var start = Date.now();
                security.sendGeneratorRequest(url, postParams, onsuccess, onerror, true
                //    , service.timeout
                );

                function onsuccess(res) {
                    if (service.stopPolling === true) {
                        return errorHandler();
                    }

                    console.log(res.data); // { text: "Some data" } -> will be printed in your browser console every 5 seconds
                    onSuccess(res);
                    if (service.timeout && service.timeout !== 0 && (Date.now() - start > service.timeout)) {
                        errorHandler();
                    } else {
                        // run again with a short delay
                        service.timerId = setTimeout(startPolling, service.interval * 1000);//in seconds
                    }
                }

                function onerror(err) {
                    console.log('polling error' + err);
                    stop();
                    if (typeof (onError) === 'function') {
                        onError(err);
                    }
                    // startPolling();
                }

                function errorHandler() {
                    stop();
                }
            }

            // Make sure to call it once first
            startPolling();
        }
    }
}

angular.module('resizableScriptFont.service', [
])
.service('ResizableScriptFontService', ResizableScriptFontService);
ResizableScriptFontService.$inject = ['RootEventsService', 'LCS'];
function ResizableScriptFontService(RootEventsService, LCS) {
var defaultFontSize = 16;

    var _this = {
        lists: {},
        set: set,
        remove: remove,
        LCS: LCS
    };

    return _this;

    function set(doc, other) {
        //other = {maxFontSize, minFontSize}
        var styleParentId = 'style_' + new ObjectId().toString();
        _this.lists[styleParentId] = {
            watchers: []
        };
        //change font size
        //setResizable(_this.lists[styleParentId]);

        function setResizable(l) {
            _this.LCS.timeout(function () {
                resize();
            }, 200);
            RootEventsService.addRootWatcherSimple(l.watchers, LCS.onWindowWidthChanged(resize));
        }

        function resize() {
            if (doc) {
                onResize(doc);
            }
        }

        function onResize(doc) {
            //console.log('onResize');
            var docWrapperClass = (!other || !other.docWrapperClass) ? 'document-version-wrapper' : other.docWrapperClass,
                maxFontSize = (!other || !other.maxFontSize) ? defaultFontSize : other.maxFontSize,
                minFontSize = (!other || !other.minFontSize) ? 12 : other.minFontSize,
                fixedPadding = (!other || !other.fixedPadding) ? false : other.fixedPadding,
                blockPaddingLeft = (!other || !other.blockPaddingLeft) ? 3 : other.blockPaddingLeft,
                docWrapper = LCS.findClosestParent(doc, '.' + docWrapperClass);
            if (docWrapper) {
                LCS.addStyleBlock(styleParentId, docWrapper.parentNode, getCss(getSetup(docWrapper.offsetWidth)), false, 'scriptfontstyle');
                return styleParentId;
            }

            return null;

            function getSetup(w) {
                var lineHeight = maxFontSize,
                    mW = 51,
                    mH = 66;
                if (w) {
                    for (var i = lineHeight; i >= minFontSize; i--) {
                        if (!(w < getMaxWidth(i))) {
                            lineHeight = i;
                            break;
                        }
                    }
                }
                //console.log('getSetup: ' + lineHeight);
                return {
                    lineHeight: lineHeight,
                    width: getMaxWidth(lineHeight),
                    height: getMaxHeight(lineHeight)
                };

                function getMaxWidth(lineHeight) {
                    return mW * lineHeight;
                }

                function getMaxHeight(lineHeight) {
                    return mH * lineHeight;
                }
            }

            function getCss(setup) {
                var lineHeight = setup.lineHeight,
                    p = '.' + docWrapperClass,
                    ps = p + ' .scene-wrapper',
                    blockPaddingLeft = lineHeight * 0.25,
                    w = (lineHeight * 2.5) + 'px';
                return (
                    LCS.isMobileSize || !LCS.isMobileSize && lineHeight === defaultFontSize
                ) ? '' : ('.screenplay-side-padding,.document-version-wrapper{--lineHeightInit:' + lineHeight + 'px}');
            }
        }
    }

    function remove(styleParentId) {
        var style = document.getElementById('#' + styleParentId);
        if (style) {
            style.parentElement.removeChild(style);
        }

        var l = _this.lists[styleParentId];
        if (l) {
            if (l.watchers) {
                RootEventsService.removeWatchers(l.watchers);
            }
            delete _this.lists[styleParentId];
        }
    }
}

angular.module('services.rootEvents', [
])
.service('RootEventsService',RootEventsService);
RootEventsService.$inject = ['$rootScope', 'observeOnScope'];
function RootEventsService($rootScope, observeOnScope) {
    var _this = this;
    _this.$rootScope = $rootScope;
    _this.observeOnScope = observeOnScope;
    _this.names = [];
    _this.events ={}

    _this.broadcastRoot = broadcastRoot;
    _this.addRootWatcher = addRootWatcher;
    _this.addRootWatcherSimple = addRootWatcherSimple;

    _this.addToObservable = addToObservable;
    _this.addToRootObserver = addToRootObserver;

    _this.removeWatchers = removeWatchers;
    _this.removeWatcher = removeWatcher;

    _this.broadcastComplex = broadcastComplex;
    _this.onDefaultEmitted = onDefaultEmitted;

    return _this;

    function broadcastComplex(name, e, channel, data) {
        console.log('broadcastComplex: ' + name);
        _this.$rootScope.$broadcast(name, e, channel, data);
    }

    function onDefaultEmitted(name, method) {
        if(!name || typeof(method)!=='function'){return;}
        return _this.$rootScope.$on(name, function (e, val) {
           // console.log('onDefaultEmitted: ' +name);
            if (typeof (method) === 'function') {
                method(val);
            }
        });
    }

    function broadcastRoot(name, val, checkIfExists) {
        if(!name){return;}
        var run = !checkIfExists || checkIfExists && _this.$rootScope.$$listenerCount[name] !== undefined;
        if (run) {
            _this.$rootScope.$broadcast(name, val);
            return true;
        }
        return false;
    }

    function addRootWatcher(watchers, name, method) {
        //console.log('addRootWatcher: ' + name);
        return addRootWatcherSimple(watchers, _this.onDefaultEmitted(name, method));
    }

    function addToObservable(watchers, scope, name, onChange, isTrue) {
        return addRootWatcherSimple(watchers, _this.observeOnScope(scope, name, isTrue === true).subscribe(function (change) {
            if (change.newValue !== undefined && change.newValue !== change.oldValue) {
                onChange(change.newValue, change.oldValue);
            }
        }));
    }

    function addToRootObserver(watchers, name, onChange, isTrue) {
        return addToObservable(watchers, _this.$rootScope, name, onChange, isTrue);
    }

    function addRootWatcherSimple(watchers, watcher) {
        watchers.push(watcher);
        return watcher;
    }

    function removeWatchers(watchers) {
        while (watchers.length) {
            removeWatcher(watchers.shift());
        }
    }

    function removeWatcher(el) {
        if (!el) {
            return;
        }
        if (typeof (el.dispose) === 'function') {
            el.dispose();
        } else {
            try{
                el();
            } catch (e) {
                console.error('RootEventsService.removeWatcher error');
            }
        }
    }
}

angular.module('sbaveragecolor.service', [
    'averagecolor.service'
])
.service('SBAverageColorService', SBAverageColorService);
SBAverageColorService.$inject = ['AverageColorService'];
function SBAverageColorService(AverageColorService) {

    var service = new AverageColorService();

    return {
        getColorFromImg: getColorFromImg,
        getColorsFromImg: getColorsFromImg,
        getGradientsFromImg: getGradientsFromImg,
        getColorsFromColor: getColorsFromColor
    };

    function getColorsFromColor(h){
        var hsl = hexToHSLVals(h),
        l = hsl.l,
       i = 10 * (hsl.isDark ? (-1) : 1) ;

        return {
            top: get(l - i),
            bottom: get(l - 2* i),
            left: get(l + i),
            right: get(l + 2 * i)
        };

        function get(l){
            return "hsl(" + hsl.h + "," + hsl.s + "%," + l + "%)";
        }
    }

    function hexToHSL(H){
        var hsl = hexToHSLVals(H);
        return "hsl(" + hsl.h + "," + hsl.s + "%," + hsl.l + "%)";
    }

    function hexToHSLVals(H) {
        // Convert hex to RGB first
        let r = 0,
            g = 0,
            b = 0;
        if (H.length === 4) {
            r = "0x" + H[1] + H[1];
            g = "0x" + H[2] + H[2];
            b = "0x" + H[3] + H[3];
        } else if (H.length === 7) {
            r = "0x" + H[1] + H[2];
            g = "0x" + H[3] + H[4];
            b = "0x" + H[5] + H[6];
        }
        // Then to HSL
        r /= 255;
        g /= 255;
        b /= 255;
        let cmin = Math.min(r, g, b),
            cmax = Math.max(r, g, b),
            delta = cmax - cmin,
            h = 0,
            s = 0,
            l = 0;

        if (delta === 0) h = 0;
        else if (cmax === r) h = ((g - b) / delta) % 6;
        else if (cmax === g) h = (b - r) / delta + 2;
        else h = (r - g) / delta + 4;

        h = Math.round(h * 60);

        if (h < 0) h += 360;

        l = (cmax + cmin) / 2;
        s = delta === 0 ? 0 : delta / (1 - Math.abs(2 * l - 1));
        s = +(s * 100).toFixed(1);
        l = +(l * 100).toFixed(1);

        return {h: h, s: s, l: l, isDark: !tinycolor(H).isLight()};
    }

    function getColorsFromImg(img){
        var width = img.naturalWidth;
        var height = img.naturalHeight;
        var size = 30;
       return {
            top: getColorFromImg(img, {left: 0, top: 0, width: width, height: size}),
            bottom: getColorFromImg(img, {left: 0, top: height - size, width: width, height: size}),
            left: getColorFromImg(img, {left: 0, top: 0, width: size, height: height}),
            right: getColorFromImg(img, {left: width - size, top: 0, width: size, height: height})
        };
    }

    function getColorFromImg(img, props){
        var color = service.getColor(img, props);
        return {
            color: color.rgb,
            textColor: color.isDark ? 'white' : 'black'
        }
    }

    function getGradientsFromImg(img) {
        return {
            verticalGradientBackground: getVerticalGradient(getVerticalColors(img)),
            horizontalGradientBackground: getHorizontalGradient(getHorizontalColors(img))
        }
        /*
        verticalGradient.style.background = getVerticalGradient(verticalColors);
        horizontalGradient.style.background = getHorizontalGradient(horizontalColors);
         */

        function getVerticalColors(img) {
            var result = [];
            for (var i = 0; i < img.height; i++) {
                var color = service.getColor(img, {
                    left: 0,
                    width: img.width,
                    top: i,
                    height: 1,
                    mode: 'precision',
                });
                result.push(color.rgba);
            }
            return result;
        }

        function getHorizontalColors(img) {
            var result = [];
            for (var i = 0; i < img.width; i++) {
                var color = service.getColor(img, {
                    left: i,
                    top: 0,
                    width: 1,
                    height: img.height,
                    mode: 'precision',
                });
                result.push(color.rgba);
            }
            return result;
        }

        function getVerticalGradient(data) {
            return "linear-gradient(180deg, ".concat(data.join(', '), ")");
        }

        function getHorizontalGradient(data) {
            return "linear-gradient(90deg, ".concat(data.join(', '), ")");
        }
    }
}
/*
box shadow
            var color = service.getColor(img);
            if (img) {
                img.style.boxShadow = '0 70px 90px ' + color.rgb;
                img.style.color = color.isDark ? 'white' : 'black';
            }
* */
/* border
var colorTop = fac.getColor(image, { height: size });
var colorRight = fac.getColor(image, { left: width - size, width: size });
var colorLeft = fac.getColor(image, { width: size });
var colorBottom = fac.getColor(image, { top: height - size, height: size });
imageContainer.style.borderColor = [
    colorTop.rgb,
    colorRight.rgb,
    colorBottom.rgb,
    colorLeft.rgb
].join(' ');

 */

angular.module('services.sbHttp', [])
    .service('SbHttpService', SbHttpService);

SbHttpService.$inject = ['$http'];
function SbHttpService($http) {
    return {
        axiosGet: axiosGet,
        post: post,
        postRequest: postRequest,
        getRequest: getRequest,
        simpleHttpRequest: simpleHttpRequest,
    };

    function axiosGet(url, options, onSuccess, onFinally) {
        return axios.get(url, options)
            .then(function (result) {
                if (typeof (onSuccess) === 'function') {
                    onSuccess(result.data);
                }
            })
            .catch(function (err) {
                if (typeof (onError) === 'function') {
                    onError(err);
                }
            }).finally(function () {
                if (typeof (onFinally) === 'function') {
                    onFinally();
                }
            });
    }

    function getRequest(url, headers, onSuccess, onError) {
        //console.log('getRequest');
        return sendHttpRequest('GET', url, null, headers, onSuccess, onError);
    }

    function postRequest(url, data, headers, onSuccess, onError, onFinally, timeout) {
        //console.log('postRequest');
        return sendHttpRequest('POST', url, data, headers, onSuccess, onError, onFinally, timeout);
    }

    function sendHttpRequest(method, url, data, headers, onSuccess, onError, onFinally, timeout) {
        //console.log('sendHttpRequest')
        var params = {
            method: method,
            url: url
        };
        if (data) {
            params.data = data;
        }
        if (headers) {
            params.headers = headers;
        }
        if(timeout){
            params.timeout = timeout * 1000;
        }
        return simpleHttpRequest(params, onSuccess, onError, onFinally);
    }

    function simpleHttpRequest(params, onSuccess, onError, onFinally) {
        return $http(params).then(function (result) {
            onSuccess(result);
            onfinally(result);
        }).catch(function (error) {
            onError(error);
            onfinally(error);
        });

        function onfinally(result) {
            if (typeof (onFinally) === 'function') {
                onFinally(result);
            }
        }
    }

    function post(url, data, onSuccess, onError) {
        return $http.post(url, data).then(onSuccess).catch(onError);
    }
}

if (!document) {
    var document = {cookie: ''}; // fix crashes on node
}

angular.module('services.SBMachineIdService', [])
    .service('SBMachineIdService', SBMachineIdService);

SBMachineIdService.$inject = [];
function SBMachineIdService() {
    var timestamp = 16777215,
        varId = 'SBMachineId',
        machine = Math.floor(Math.random() * (16777216)),
        setMachineCookie = function() {
          var cookies = document.cookie.split('; ');
          for (var i in cookies) {
              var cookie = cookies[i].split('=');
              var cookieMachineId = parseInt(cookie[1], 10);
              if (cookie[0] === varId && cookieMachineId && cookieMachineId >= 0 && cookieMachineId <= timestamp) {
                  machine = cookieMachineId;
                  break;
              }
          }
          document.cookie = varId + '=' + machine + ';expires=Tue, 19 Jan 2038 05:00:00 GMT;path=/';
      };
    if (typeof (localStorage) != 'undefined') {
        try {
            var el = parseInt(localStorage[varId],10);
            if (el >= 0 && el <= timestamp) {
                machine = Math.floor(localStorage[varId]);
            }
            // Just always stick the value in.
            localStorage[varId] = machine;
        } catch (e) {
            setMachineCookie();
        }
    }
    else {
        setMachineCookie();
    }

    return{
        machine: machine
    }
}
/**
 * Javascript class that mimics how WCF serializes a object of type MongoDB.Bson.ObjectId
 * and converts between that format and the standard 24 character representation.
 */
var ObjectId = (function () {
    var increment = Math.floor(Math.random() * (16777216));
    var pid = Math.floor(Math.random() * (65536));
    var machine = SBMachineIdService().machine;
    function ObjId() {
        if (!(this instanceof ObjectId)) {
            return new ObjectId(arguments[0], arguments[1], arguments[2], arguments[3]).toString();
        }

        if (typeof (arguments[0]) == 'object') {
            this.timestamp = arguments[0].timestamp;
            this.machine = arguments[0].machine;
            this.pid = arguments[0].pid;
            this.increment = arguments[0].increment;
        }
        else if (typeof (arguments[0]) == 'string' && arguments[0].length == 24) {
            this.timestamp = Number('0x' + arguments[0].substr(0, 8)),
                this.machine = Number('0x' + arguments[0].substr(8, 6)),
                this.pid = Number('0x' + arguments[0].substr(14, 4)),
                this.increment = Number('0x' + arguments[0].substr(18, 6))
        }
        else if (arguments.length == 4 && arguments[0] != null) {
            this.timestamp = arguments[0];
            this.machine = arguments[1];
            this.pid = arguments[2];
            this.increment = arguments[3];
        }
        else {
            this.timestamp = Math.floor(new Date().valueOf() / 1000);
            this.machine = machine;
            this.pid = pid;
            this.increment = increment++;
            if (increment > 0xffffff) {
                increment = 0;
            }
        }
    };
    return ObjId;
})();

ObjectId.prototype.getDate = function () {
    return new Date(this.timestamp * 1000);
};

ObjectId.prototype.toArray = function () {
    var strOid = this.toString();
    var array = [];
    var i;
    for(i = 0; i < 12; i++) {
        array[i] = parseInt(strOid.slice(i*2, i*2+2), 16);
    }
    return array;
};

/**
 * Turns a WCF representation of a BSON ObjectId into a 24 character string representation.
 */
ObjectId.prototype.toString = function () {
    if (this.timestamp === undefined
        || this.machine === undefined
        || this.pid === undefined
        || this.increment === undefined) {
        return 'Invalid ObjectId';
    }

    var timestamp = this.timestamp.toString(16);
    var machine = this.machine.toString(16);
    var pid = this.pid.toString(16);
    var increment = this.increment.toString(16);
    return '00000000'.substr(0, 8 - timestamp.length) + timestamp +
        '000000'.substr(0, 6 - machine.length) + machine +
        '0000'.substr(0, 4 - pid.length) + pid +
        '000000'.substr(0, 6 - increment.length) + increment;
};

