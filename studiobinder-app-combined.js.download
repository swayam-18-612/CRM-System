}

angular.module('tree.item.edit.controller.service', [
])
.service('TreeItemEditCtrlService',TreeItemEditCtrlService);
TreeItemEditCtrlService.$inject = ['GridItemUpdateInitCtrlService', 'CompInitCtrlService', 'TemplateCompileService'];
function TreeItemEditCtrlService(GridItemUpdateInitCtrlService, CompInitCtrlService, TemplateCompileService) {
    return function($ctrl, $element){
        console.log('TreeItemEditCtrlService');
        if(!$ctrl.$onDestroy){
            $ctrl.$onDestroy  = $ctrl.onDestroyTreeItemEdit;
        }
        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl);
        }

        if(!$ctrl.changedFields){
            $ctrl.changedFields = ['name'];
        }

        if(!$ctrl.onPreloadItem){
            $ctrl.onPreloadItem = onPreloadItem;
        }
        if(!$ctrl.getItemTemplate){
            $ctrl.getItemTemplate = getItemTemplate;
        }

        $ctrl.$element = $element ;
        $ctrl.element = $element[0];

        $ctrl.body = document.querySelector('body');
        $ctrl.drpMenuId = 'tree_item_edit_' + new ObjectId().toString();

        $ctrl.onItemUpdate = onItemUpdate;
        $ctrl.onInitTreeItemEdit  = onInitTreeItemEdit;

        if(!$ctrl.$onInit){
            $ctrl.$onInit  = $ctrl.onInitTreeItemEdit;
        }

        $ctrl.onDestroyTreeItemEdit = onDestroyTreeItemEdit;

        return $ctrl;

        function onInitTreeItemEdit() {
            $ctrl.dontDebounceUpdates = true;

            $ctrl.currentListId = null;
            $ctrl = new GridItemUpdateInitCtrlService($ctrl);

            $ctrl.onSuccessItemUpdate = onSuccessItemUpdate;
            $ctrl.getChanges = getChanges;
            $ctrl.bind = bind;

            loadItem();

            function loadItem() {
                $ctrl.bind(false);
                if (typeof ($ctrl.onPreloadItem) === 'function') {
                    $ctrl.onPreloadItem();
                }
                if (!$ctrl.templateCompile) {
                    $ctrl.templateCompile = new TemplateCompileService($ctrl.$element, $ctrl.getItemTemplate, $ctrl);
                }

                $ctrl.templateCompile.loadTemplate(onLoaded);

                function onLoaded() {
                    $ctrl.elInput = $ctrl.element.querySelector('input');
                    $ctrl.LCS.autoselectElText($ctrl.elInput);
                    $ctrl.bind(true);
                    if (typeof ($ctrl.onLoadedOther) === 'function') {
                        $ctrl.onLoadedOther();
                    }
                }
            }
        }

        function onDestroyTreeItemEdit() {
            $ctrl.bind(false);
            if ($ctrl.onInitDestroy) {
                $ctrl.onInitDestroy();
            }
            $ctrl.templateCompile.destroyNewScope();
        }

        function onPreloadItem() {
            if(!$ctrl.placeholder){
                $ctrl.placeholder = 'Enter list name…';
            }
            if(!$ctrl.fontSize){
                $ctrl.fontSize = $ctrl.item.isFolder ? '15' : '13';
            }
            if(!$ctrl.paddingRight){
                $ctrl.paddingRight = '50px';
            }

            $ctrl.LCS.setCSSStyle($ctrl.element, 'padding-right', $ctrl.paddingRight);
            $ctrl.LCS.addClass($ctrl.element, 'table-cell clearfix centered');
        }

        function bind(isBind) {
            //$ctrl.LCS.bindElementsClick(isBind, $ctrl.body, onClick, 'TREE_ITEM_EDIT_' + $ctrl.drpMenuId);
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.elInput, $ctrl.onItemUpdate, 'tree-item-edit-blur', 'blur');
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.elInput, onKeydown, 'tree-item-edit-keydown', 'keydown');
        }

        function onItemUpdate(e) {
            onCancel(e, true);
        }

        function onKeydown(e) {
            var code = e.keyCode || e.which;

            switch (code) {
                case 13://enter
                    onCancel(e, true);
                break;

                case 27://escape
                    onCancel(e);
                    break;
            }
        }

        function onCancel(e,withSave) {
            $ctrl.preventDefault(e);
            if(withSave){
                $ctrl.item.actiontype = 'rename';
                if ($ctrl.save() === false) {
                    $ctrl.cancelEdit();
                }
            }else{
                $ctrl.cancelEdit();
            }
        }

        function onSuccessItemUpdate(item) {
            $ctrl.onUpdate({item:$ctrl.item});
        }

        function getChanges() {
            return $ctrl.service ? $ctrl.service.getChanges($ctrl.changedFields, $ctrl.item, $ctrl.copyItem) : null;
        }

        function getItemTemplate() {
            var id = $ctrl.item._id;
        return '<form class="full-width contactlistedit thinner" name="$ctrl.formHolder.form'+id+'" novalidate>' +
                    '<input id="name'+id+'" name="name" type="text" ng-model="$ctrl.item.name" placeholder="'+$ctrl.placeholder +'" required class="form-control with-underline listcolor name '+(($ctrl.isSemibold !==undefined ? $ctrl.isSemibold : !$ctrl.item.parentId)?'semibold':'')+' font-size-'+$ctrl.fontSize+'"/>' +
                    '<div ng-if="($ctrl.formHolder[\'form'+id+'\'][\'name\'].$dirty || $ctrl.formHolder[\'formItem_attempted\']) && $ctrl.formHolder[\'form'+id+'\'][\'name\'].$error.required" class="help-inline with-relative">Please insert list name.</div>' +
                    '<div ng-if="($ctrl.formHolder[\'form'+id+'\'][\'name\'].$dirty || $ctrl.formHolder[\'formItem_attempted\']) && $ctrl.formHolder[\'form'+'+id+'+'\'][\'name\'].$error.duplicate" class="help-inline with-relative" ng-bind="$ctrl.formHolder[\'form'+'+id+'+'\'][\'name\'].$error.duplicate"></div>' +
                '</form>';
        }

        function onClick(e) {
            //console.log('onCustomDropDownClick:' + $ctrl.drpMenuId);
            if (!isInElement($ctrl.element)) {
                //console.log('onCustomDropDownClick:' + $ctrl.drpMenuId +'.closeDrp');
                $ctrl.onItemUpdate(e);
            }

            function isInElement(el) {
                return !el || (e.target === el || $ctrl.LCS.hasChild(el, e.target));
            }
        }
    }
}

angular.module('tree.item.component', [
    'tree.item.controller.service'
])
.component('treeItemGrid', {
    bindings: {
       // variable
        treeType: '<?',
        startIndent: '<',

        item: '<',
        isSidebar: '<',
        canEdit :'<',
        clickOnGroup: '<',
        hideCounter: '<',
        active:'<',

        isInTreeModal: '<',

        selectedIdField:'@',
        elemType: '@',
        itemTitle: '@',
        itemIcon: '@',
        iconForGroup:'@',
        canDragPredefTreeItem:'@',
        withFontSmall:'@',

        withTreeDisplayCount: '@',

        toggle: '&',
        onGoToList: '&',
        onGetListItemIcon: '&'
    },
    controller: 'TreeItemGridCtrl',
})
.controller('TreeItemGridCtrl',TreeItemGridCtrl);
TreeItemGridCtrl.$inject = ['TreeItemGridCtrlService', '$element'];
function TreeItemGridCtrl(TreeItemGridCtrlService, $element) {
    var $ctrl = this;

    $ctrl.collapsed = false;

    $ctrl.goToList = goToList;
    $ctrl.bindClick = bindClick;

    $ctrl.getTreeItemTemplate = getTreeItemTemplate;
    $ctrl.preTreeInit = preTreeInit;

    if(!$ctrl.canClickOnList){
        $ctrl.canClickOnList = canClickOnList;
    }

    $ctrl = new TreeItemGridCtrlService($ctrl, $element);

    function getListItemIcon(item) {
        return $ctrl.onGetListItemIcon({item: item}) || '';
    }

    function hasSideHandle() {
        return ($ctrl.LCS.isMobileSize || $ctrl.LCS.isTouchScreen) && $ctrl.canEdit;
    }

    function canClickOnList(item){
        return !$ctrl.isInTreeModal && $ctrl.clickOnGroup && item.isFolder || !item.isFolder;
    }
    function getTreeItemTemplate(item) {
        var canClick = $ctrl.canClickOnList(item);
        return ($ctrl.isSidebar ? (
            '<div class="gantt-tree-handle-column centered text-center action-buttons-trigger with-cursor">' +
    (           hasSideHandle() ? ($ctrl.canDragItem(item) ?
                ('<div sb-tree-handle class="col30 handle-col hide-print with-hover">'+$ctrl.LCS.getISBDiv('dd3-handle', 0)+'</div>') : '<div class="col30 handle-col hide-print ">&nbsp;</div>') : '') +
                (!$ctrl.isAll && item.isFolder && item.nodes && item.nodes.length > 0 ? '<span class="gantt-tree-handle sbf sbf12" ng-class="$ctrl.collapsed === true ? \'sort-right\' : \'sort-down\'"></span>' : '') +
            '</div>') : '') +
            getListItemIcon(item) +
            '<div class="list-edit-item grow-column centered with-padding-right table-cell">' +
                '<div class="list-item-name ' + ($ctrl.isSidebar ? 'table-div fixed-layout ' : '') + (canClick ? ' with-cursor' : '') + ($ctrl.isSemibold ? ' semibold' : '') + '">' +
                    '<div class="with-ellipsis">' + (item.prefix ? (item.prefix + (item.name ? ' — ' : '')) : '') + item.name +
                        //';id='+item._id+
                        //';l='+item.l+';ind='+item.indent+';order='+item.order+
                    '</div>' +
                    //'<span ng-bind="item.count"></span>'+
                '</div>' +
            '</div>';
    }
    
    function preTreeInit() {
        $ctrl.setCanDragAttribute($ctrl.element);

        $ctrl.LCS.addClass($ctrl.element, 'table-div inline-tree-item tree-item-grid ' + ($ctrl.isSidebar ? '' : 'without-sidebar'));
        var indentInit = ($ctrl.startIndent !== undefined ? $ctrl.startIndent : 1) - (hasSideHandle() ? 1 : 0);
        if(indentInit < 0){indentInit = 0;}
        $ctrl.LCS.addClass($ctrl.elNode, 'indent' + ($ctrl.item.indent + indentInit));//add 20 px
        $ctrl.isSmallFont = ($ctrl.withFontSmall === 'true' || $ctrl.withFontSmall === true);
        $ctrl.isSemibold = !$ctrl.isSmallFont && $ctrl.item.isFolder;

        if ($ctrl.item.isFolder) {
            // $ctrl.LCS.addClass($ctrl.element, 'font-bigger');
            if (!$ctrl.isSidebar && !$ctrl.isSmallFont) {
              //  $ctrl.LCS.addClass($ctrl.element, 'margin-top-half');
            }
        }

        $ctrl.LCS.addClass($ctrl.elNode, $ctrl.item.isFolder ? 'font-bigger' : ($ctrl.isSmallFont ? 'font-small' : 'font-bigger'));

        if (!$ctrl.isSidebar) {
           // $ctrl.LCS.addClass($ctrl.element, 'spacing-quarter-bottom');
        } else {
            $ctrl.setSelected();

            /*  if($ctrl.item._id=== 'All' &&$ctrl.item.isHarcoded ){
                  var li = $ctrl.LCS.findClosestParent($ctrl.element, 'li');
                  if(li) {
                      $ctrl.LCS.addClass(li, 'with-spacing-after');
                  }
              }*/
        }
    }

    function goToList(e) {
        console.log('TreeItemGridCtrl.goToList ' + $ctrl.elemType);
        if($ctrl.isInTreeModal && $ctrl.item.isFolder && !$ctrl.clickOnGroup){
            return ;
        }
        if($ctrl.LCS.isMobileSize) {
            //$ctrl.LCS.closeInnerSidebar();
            $ctrl.LCS.setMainSideBar(false);
        }
        return $ctrl.onGoToList({item: $ctrl.item});
    }

    function toggleItem() {
        var handle = $ctrl.handle.querySelector('.gantt-tree-handle');
        if(handle){
            $ctrl.collapsed = $ctrl.collapsed ? false : true;
            if($ctrl.LCS){
                $ctrl.LCS.replaceClass(handle, 'sort-down','sort-right');
            }else {
                $ctrl.LCS.replaceClass(handle, 'sort-right','sort-down');
            }
        }

        var parent = $ctrl.LCS.findClosestParent($ctrl.element, '.angular-ui-tree-node');
        parent.setAttribute('collapsed', $ctrl.collapsed);
        $ctrl.LCS[$ctrl.collapsed ? 'addClass' : 'removeClass'](parent.querySelector('.angular-ui-tree-nodes'),'hidden');
       // $ctrl.toggle();
    }

    function bindClick(isBind) {
        if(!$ctrl.isSidebar){return;}

        $ctrl.handle = bind(isBind, '.gantt-tree-handle-column', toggleItem);
        $ctrl.itemName = bind(isBind, '.list-edit-item', goToList);

        return false;

        function bind(isBind, s, m){
            var el = $ctrl.element.querySelector(s);
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector(s), m);
            return el;
        }
    }

}

angular.module('tree.item.controller.service', [

])
.service('TreeItemGridCtrlService', TreeItemGridCtrlService);
TreeItemGridCtrlService.$inject = ['TemplateCompileCompCtrlService', 'CommentsSidebarService'];
function TreeItemGridCtrlService(TemplateCompileCompCtrlService, CommentsSidebarService) {
    return function($ctrl, $element) {
       //console.log('TreeItemGridCtrlService');

        $ctrl.CommentsSidebarService = CommentsSidebarService;

        var noDragAttr = 'data-tree-nodrag';
        $ctrl.$onChanges = $onChanges;

        //$doCheck should be removed - currently the tree logic doesnt allow for full swap of the item -> instead doesn an update of props
        //item should be updated on $onChanges instead
        $ctrl.$doCheck = $doCheck;

        $ctrl.onDestroy = onDestroy;
        $ctrl.preInit = preInit;
        //console.log('TreeItemGridCtrl.onInit: ' + id);
        $ctrl.getItemTemplate = getItemTemplate;
        $ctrl.onLoaded = onLoaded;
        if(!$ctrl.canDragItem) {
            $ctrl.canDragItem = canDragItem;
        }
        $ctrl.setCanDragAttribute = setCanDragAttribute;
        $ctrl.setSelected = setSelected;

        if(typeof($ctrl.getTreeItemTemplate)!=='function'){
            console.log('parent for TreeItemGridCtrlService must define getTreeItemTemplate');
        }

        $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

        return $ctrl;

        function preInit() {
            $ctrl.elNode = $ctrl.element.parentNode;
            $ctrl.changedFields = ['name', 'count', 'parentId'];

            if ($ctrl.changedFieldsOther) {
                $ctrl.changedFields = $ctrl.changedFields.concat($ctrl.changedFieldsOther);
            }

            $ctrl.isAll = false;//id === null && $ctrl.item.isFolder;
            $ctrl.element.setAttribute('data-isall', $ctrl.isAll);
            $ctrl.element.setAttribute('data-id', $ctrl.item[$ctrl.selectedIdField ? $ctrl.selectedIdField : '_id']);

            $ctrl.totalCountCls = 'counter-text-' + $ctrl.elemType;
            $ctrl.counterTextCls = $ctrl.totalCountCls + ' with-text' + ($ctrl.hideListCounter ? ' sb-hide' : '');

            setArchived($ctrl.item.count && !$ctrl.isInTreeModal ? $ctrl.item.count : 0);

            if (!$ctrl.getCounterBlock) {
                $ctrl.getCounterBlock = getCounterBlock;
            }

            if (!$ctrl.getMoreButtons) {
                $ctrl.getMoreButtons = getMoreButtons;
            }

            if (typeof ($ctrl.preTreeInit) === 'function') {
                $ctrl.preTreeInit();
            }
        }

        function getItemTemplate() {
            bindInitClick(false);
            $ctrl.previousItem = _.clone($ctrl.item);

            return $ctrl.getTreeItemTemplate($ctrl.item) +
                (!$ctrl.withoutSideBtns? ($ctrl.getCounterBlock()+ $ctrl.getMoreButtons()) : '');
        }

        function onLoaded() {
            hideParent();
            if($ctrl.item.withLabelAfter){
                //  $ctrl.elNode.parentNode.setAttribute('data-label', $ctrl.item.withLabelAfter);
                // $ctrl.LCS.addClass($ctrl.elNode.parentNode, 'with-label-after');
                var n =$ctrl.elNode.parentNode;
                $ctrl.LCS.insertFragmentBeforeChild(n.parentNode,'<li class="angular-ui-tree-node with-label-after" data-label="' + $ctrl.item.withLabelAfter +
                    //' {{$ctrl.item.nodes.length ? $ctrl.item.nodes.length:\'\'}}' +
                    '" '+noDragAttr+'></li>', n.nextSibling);

            }

            $ctrl.setCanDragAttribute($ctrl.elNode);

            $ctrl.setSelected();

            bindInitClick(true);
            $ctrl.isInit = true;
        }

        function setCanDragAttribute(el) {
            if(!$ctrl.canDragItem($ctrl.item)){
                el.setAttribute(noDragAttr, 'true');
            }
        }

        function canDragItem(item) {
            //$ctrl.listTreeService.noTreeDrag??
            if(item.isPredef && !$ctrl.canDragPredefTreeItem || item.isHarcoded){return false;}
            return typeof($ctrl.canDrag) === 'function' ? $ctrl.canDrag(item) : true;
        }

        function onDestroy() {
            bindInitClick();
        }

        function $onChanges(changes) {
            if (!$ctrl.isInit || !changes) {
                return;
            }
            console.log('TreeItemGridCtrl.$onChanges: ');
            //  console.log(changes);
            //$ctrl.LCS.onFieldChanges(changes, ['item', 'active'], method);

            $ctrl.changedFields = ['item', 'active'];
            for (var i = 0, l = $ctrl.changedFields && $ctrl.changedFields.length; i < l; i++) {
                var field = $ctrl.changedFields[i],
                    change = changes[field];
                if(change) {
                    var isFirstChange = typeof (change.isFirstChange) === 'function' ? change.isFirstChange() : false;
                    if (!isFirstChange && field === 'item') {
                        change.previousValue = $ctrl.previousItem;
                    }
                    if (shouldChange(change, isFirstChange) && method(field, change)) {
                        break;
                    }
                }
            }

            function shouldChange(change, isFirstChange) {
                return change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !isFirstChange;
            }

            function method(fieldN, change){
                switch(fieldN) {
                    case 'item':
                        console.log('TreeItemGridCtrl.$onChanges.item');
                        if($ctrl.previousItem){
                            var field = 'name';
                            if(fieldChanged(field)) {
                                if ($ctrl.CommentsSidebarService.currentList && $ctrl.CommentsSidebarService.currentList._id === $ctrl.item._id) {
                                    $ctrl.CommentsSidebarService.currentList.name = $ctrl.item[field];
                                    $ctrl.broadcastRoot('COMMENTS_SIDEBAR_UPDATED', $ctrl.CommentsSidebarService.getSidebarInfo());
                                }
                            }
                            /*field = 'parentId';
                            if(fieldChanged(field)) {
                                setCounter();
                            }

                            field = 'count';
                            if(fieldChanged(field)) {
                                setCounter();
                                _.each(['count', 'displayCount'],function (field){
                                    $ctrl.previousItem[field] = $ctrl.item[field];
                                })
                            }*/
                        }

                        $ctrl.reloadTemplate();

                        return true;

                    case 'active':
                        $ctrl.setSelected();
                        return true;
                }

                return false;

                function fieldChanged(field){
                    return $ctrl.previousItem[field] === undefined && !$ctrl.item[field] !== undefined || $ctrl.previousItem[field] !== $ctrl.item[field];
                }
            }
        }

        function $doCheck() {
            //console.log('TreeItemGridCtrlService.$doCheck');
            //cause the sidebar tree that currently doesnt allow for replace of the item.
            // todo : use $onChanges instead
            if(!$ctrl.item || !$ctrl.previousItem){return;}
            for (var i = 0; i < $ctrl.changedFields.length; i++) {
                var field = $ctrl.changedFields[i];
                if (!angular.equals($ctrl.previousItem[field], $ctrl.item[field])) {
                    //console.log('TreeItemGridCtrlService.$doCheck: ' + field + ' changed from ' + $ctrl.previousItem[field] + ' to '+ $ctrl.item[field]);
                    if(field === 'count'){
                        _.each(['count', 'displayCount'],function (field){
                            $ctrl.previousItem[field] = $ctrl.item[field];
                        });
                        setCounter();
                    } else if(field === 'parentId' && ($ctrl.previousItem[field] === undefined && !$ctrl.item[field] !== undefined || $ctrl.previousItem[field] !== $ctrl.item[field])) {
                        $ctrl.previousItem[field] = $ctrl.item[field];
                        setCounter();
                    }
                    break;
                }
            }
        }

        function getPlural(c){return c !== 1 ? 's' : '';}

        function getCounterBlock() {
            var item = $ctrl.item,
                count = getCount(item),
                counter = getCounterTxt(count),
                l = item.nodes ? item.nodes.length : 0,
                txt = '<div class="inline-block ' + $ctrl.totalCountCls + '">' + (counter || 0) + '</div>';
return $ctrl.hideCounter ? '' : ('<div class="counter-col tree-nodrag centered ' +($ctrl.canEdit && !$ctrl.item.isHarcoded ? '' : 'no-hide') + ($ctrl.isSidebar ? '' : 'big') + '">' +
($ctrl.isSidebar ? txt : ('<div>' + (item.isFolder ? ('<div class="inline-block">' + l + ' ' + $ctrl.nameForList.toLowerCase()  + getPlural(l)+'</div><span class="with-margin-left with-margin-right">•</span>') : '') + txt + '</div>')) +
            '</div>');
        }

        function getMoreButtons() {
            if (!$ctrl.isSidebar) {
                return '';
            }
        return $ctrl.canEdit && !$ctrl.item.isHarcoded && !$ctrl.isInTreeModal ?
            ('<div class="btn-col tree-nodrag centered">' +
                '<div class="with-hover hide-print">' +
                        '<div class="btn-group actions hide-print with-sb-popover with-cursor" popover-type="more-actions">' +
                        '<button type="button" class="col30 btn btn-default dropdown-toggle dots btn-default dots">' + $ctrl.LCS.getISBDiv('vertical-dots') + '</button>' +
                    '</div>' +
                '</div>' +
            '</div>') : '';
        }

        function getCounterTxt(count) {
            return count + ($ctrl.isSidebar ? '' : (' ' + ($ctrl.itemTitle||$ctrl.elemType).toLowerCase()  + getPlural(count)));
        }

        function setCounter() {
            console.log('TreeItemGridCtrlService.setCounter');
            var count = getCount($ctrl.item);
            if (count !== $ctrl.prevCount) {
                if ($ctrl.item.show === false && $ctrl.item.hideEmpty) {
                    hideParent(count);
                }

                var els = $ctrl.element.querySelectorAll('.' + $ctrl.totalCountCls);
                if (els && els.length > 0) {
                    _.each(els, function (el) {
                        el.innerHTML = getCounterTxt(count);
                    });
                }
                setArchived(count);
                $ctrl.prevCount = count;
            }
            return count;
        }

        function getCount(item){
            var prop = $ctrl.withTreeDisplayCount ? 'displayCount' : 'count';
            return item[prop] ? item[prop] : 0;
        }

        function setArchived(count){
            if($ctrl.item.withArchiveGroupAsList) {
                var m = $ctrl.LCS[(count && !$ctrl.isInTreeModal) ? 'removeClass' : 'addClass'];
                m($ctrl.element, 'sb-hide');
                $ctrl.LCS.timeout(function (){
                    var el1 = $ctrl.LCS.findClosestParent($ctrl.element, '.angular-ui-tree-node'),
                        el2 = $ctrl.LCS.findClosestParent($ctrl.element,'li[ng-treenodeid="Archived"]');
                    m(el1, 'sb-hide');
                    m(el2, 'sb-hide');
                }, 200);
            }
            if(!count && !$ctrl.isInTreeModal) {
                $ctrl.broadcastRoot('ARCHIVED_HIDDEN_' + $ctrl.elemType + '_TREE');
            }
        }

        function setSelected() {
            $ctrl.LCS[($ctrl.active === 'true' || $ctrl.active === true) ? 'addClass' : 'removeClass']($ctrl.element, 'active');
        }

        function hideParent(count) {
            set($ctrl.elNode, $ctrl.item.show === false);
            set($ctrl.elNode.parentNode, $ctrl.item.hideEmpty && !count);

            function set(el, show){
                $ctrl.LCS[show ? 'addClass' : 'removeClass'](el, 'sb-hide');
            }
        }

        function bindInitClick(isBind) {
            if (!$ctrl.isSidebar) {
                return;
            }
            if (typeof ($ctrl.bindClick) === 'function') {
                $ctrl.bindClick(isBind);
            }
        }
    }
}

angular.module('list.tree.sidebar.component', [
    'list.tree.sidebar.controller.service'
])
.component('treeSidebar', {
    bindings: getTreeSidebarInitParams(),
    controller: 'SidebarTreeCtrl',
})
.controller('SidebarTreeCtrl', SidebarTreeCtrl);

SidebarTreeCtrl.$inject = ['SidebarTreeCtrlService', '$element'];
function SidebarTreeCtrl(SidebarTreeCtrlService, $element) {
    console.log('SidebarTreeCtrl');

    var $ctrl = this;

    $ctrl.isSidebar = true;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        if(!$ctrl.getPopoverTemplate){
            console.warn('treeSidebar must define getPopoverTemplate(item) method');
        }
        $ctrl = new SidebarTreeCtrlService($ctrl, $element);
    }
}

angular.module('list.tree.service', [
    'filters.service',
    'list.tree.service'
])
.service('ListTreeService', ListTreeService);
ListTreeService.$inject = ['RouteCollaboratorsService', 'CPS'];
function ListTreeService(RouteCollaboratorsService, CPS) {
    return function (constantsService, filtersService, listsService, listTreeServiceParams) {
        console.log('ListTreeService');
        var defaultType = 6;
        var $ctrl = _.extend({
                CPS: CPS,
               LCS: CPS.LCS,
                RouteCollaboratorsService: RouteCollaboratorsService,
                SBStateService: CPS.SBStateService,
                constantsService: constantsService,
                filtersService: filtersService,
                listsService: listsService,
                addListOnEmptyState: false,
                withNull: false, //for breakdowns / team is true
                withTreeDisplayCount: false, //ifthe display count for items is different than the number of items in the group - ex shots vs shots + banners
                clickOnGroup: true,
                updateChangedFields: null,
                treeEditName: 'Rename',
                dontUpdateUrl: false,
                hideSidebarButtons: false,
                moveInGroup: false,
                hasTreeShare: false,
                hasTreeCopy: false,
                noTreeDrag: false,
                indentInit: 0,
                //withIndentation: false,
                noItemEdit: false,
                ungroupOnTreeDelete: false,
                harcodedAllIcon: null,
                level0Name: null,
                sidebarTitle: null,
                groupPopulate: false, //breakdowns/locations/shots
                hideLevel0: false,
                withHarcodedAll: false,
                dontStartTreeWithAll: false,
                withLabelAfter: null,
                selectedIdField: undefined, //depId
                maxLevel: 0,
                listCheckerConsidersItemsCount: false,
                isRecursiveTree: false, //library
                insertElementAfter: true,
                withOptionsForList: false,
                withOptionsForListField: null,
                hideCounter: false,
                cachedListName: undefined,
                cachedListId: undefined,
                preLoadingTableName: null,
                withoutLoadDirectory: false, //workflow
                displayAllTreeLists: false, //workflow
                withoutEmptyState: false, //documents

                defaultSelectedIdField: '_id',
                allLists: {},
                treeCounters: {},
                isCustomList: isCustomList,
                getTree: getTree,
                setActive: setActive,
                add: add,
                remove: remove,
                selectList: selectList,
                updateCountForNodeId: updateCountForNodeId,

                //to be overwritten
                getSearchFilter: getSearchFilter,
                setSearchFilter: setSearchFilter,
                setSearch: setSearch,
                hasLists: hasLists,
                hasListsChecker: hasListsChecker,
                processUpdates: processUpdates,
                setList: setList,
                getListName: getListName,
                getList: getList,
                getBreadcrumbs: getBreadcrumbs,
                getNodeById: getNodeById,
                getSimpleNodeById: getSimpleNodeById,
                getParentNode: getParentNode,
                onClipboardProcessingForTree: onClipboardProcessingForTree,
                uiOnParamsChanged: uiOnParamsChanged,
                reloadGroups: reloadGroups,

                onTreeAdded: onTreeAdded,
                onTreeUpdated: onTreeUpdated,
                onTreeRemoved: onTreeRemoved,
                onTreeArchived: onTreeArchived,
                onTreeActivated: onTreeActivated,
                onTreeDuplicated: onTreeDuplicated,

                onInitAddedItem: onInitAddedItem,
                onInitRemovedItem: onInitRemovedItem,
                onInitArchivedItem: onInitArchivedItem,
                onInitActivatedItem: onInitActivatedItem,
                onInitUpdateName: onInitUpdateName,
                onInitLists: onInitLists,
                hasItems: hasItems,
                getSelectedFieldFromItem: getSelectedFieldFromItem,// for departments select by depId instead of _id
                getSelectedIdFromItem: getSelectedIdFromItem,
                computeNodeCount: computeNodeCount,
                getActiveList: getActiveList,
                computeAllNodesCount: computeAllNodesCount,
                updateNodeCountById: updateNodeCountById,

                getTreeItemGridInit: getTreeItemGridInit,
                getFirstLevelNodesCount: getFirstLevelNodesCount,
                getFirstLeveActiveArchiveCount: getFirstLeveActiveArchiveCount,
                loadTreeGroups: loadTreeGroups,

                isArchiveAsList: isArchiveAsList,

                setListsCounters: setListsCounters,
                setListCount: setListCount,
                getListCount: getListCount,
                getDisplayListCount: getDisplayListCount,
                showBottomButtons: showBottomButtons,

                getDisplayRootCount: getDisplayRootCount
            },
            listTreeServiceParams);

        $ctrl.customBGForList = constantsService && constantsService.CompOptions ? constantsService.CompOptions.customBGForList :false;

        $ctrl.treeTypeCustomList = constantsService.CompOptions.treeTypeCustomList || defaultType;
        $ctrl.treeTypeScriptList = constantsService.CompOptions.treeTypeScriptList;

        $ctrl.defaultType = $ctrl.treeTypeCustomList ? $ctrl.treeTypeCustomList : defaultType;

        if (!$ctrl.getSearch) {
            $ctrl.getSearch = getSearch;
        }

        if ($ctrl.withIndentation === undefined) {
            $ctrl.withIndentation = $ctrl.maxLevel > 1;
        }

        if ($ctrl.withOptionsForList) {
            $ctrl.filtersService.withOptionsForList = $ctrl.withOptionsForList;
            $ctrl.filtersService.withOptionsForListField = $ctrl.withOptionsForListField;
        }
        if (!$ctrl.selectedIdField) {
            $ctrl.selectedIdField = $ctrl.defaultSelectedIdField;
        }

        if ($ctrl.withLabelAfter) {
            $ctrl.sidebarTitle = '&nbsp;';
        }

        if ($ctrl.startIndent === undefined) {
            $ctrl.startIndent = 1;
        }

        if ($ctrl.cachedListName) {
            $ctrl.cachedListId = $ctrl.LCS.PersistenceService.get($ctrl.cachedListName) ? $ctrl.LCS.PersistenceService.get($ctrl.cachedListName) : null
        }

        if (!$ctrl.isNotEmptyGroupState) {
            $ctrl.isNotEmptyGroupState = isNotEmptyGroupState;
        }

        if (typeof ($ctrl.shouldLoad) !== 'function') {
            $ctrl.shouldLoad = shouldLoad;
        }

        return $ctrl;

        function isCustomList(treeType){
            return treeType === $ctrl.treeTypeCustomList;
        }
        function showBottomButtons(isActiveFilter) {
            var maxLevel = $ctrl.maxLevel,
                l = $ctrl.active.selectedList;
            return !$ctrl.hideSidebarButtons && isActiveFilter && l &&
                (maxLevel === 1 && maxLevel >= l.l ||
                    maxLevel === 2 && maxLevel >= l.l ||
                    $ctrl.isRecursiveTree && (l._id === null || maxLevel > l.l));
        }

        function setListCount(type, hasLists) {
            $ctrl.treeCounters['t_' + type] = hasLists;
        }

        function getListCount(type) {
            return $ctrl.treeCounters['t_' + type];
        }

        function shouldLoad(res) {
            return true;
        }

        function isArchiveAsList() {
            return !!($ctrl.active && $ctrl.active.selectedList && $ctrl.active.selectedList.withArchiveGroupAsList);
        }

        function getTreeNodes(p, isCollaborator) {
            console.log('getTreeNodes ' + $ctrl.elemType);
            //todo load simplified tree for collaborators ??? from server side???
            //if is print selecte only folders and set parent Id for all lists to null. also ensure the selected list is in selectedLists
            var treeLists = $ctrl.preLoadingService.getObjectList($ctrl.preLoadingService.TblTypes[$ctrl.preLoadingTableName], function (item){
                return getTreeFilters(item, p.treeType) && (!p.isPrintLayout || p.isPrintLayout && !item.isFolder);
            });

            if(isCollaborator && $ctrl.listField) {
                var c = $ctrl.SBStateService.initStateParams[$ctrl.listField];
                if (c) {
                    $ctrl.RouteCollaboratorsService.selectedCollabId = c;
                    $ctrl.collabRootId = $ctrl.RouteCollaboratorsService.collabRootId;
                    $ctrl.collabRoot = _.find(treeLists, {_id: $ctrl.collabRootId});
                }
            }

            if(p.isPrintLayout && p.printedLists) {
                treeLists = _.filter(p.printedLists.map(function (id) {
                    return _.find(treeLists, function (item) {
                        return item._id === id;
                    });
                }), function (item) {
                    return item;
                }).map(function (item, i) {
                    item.parentId = null;
                    item.order = i;//order starts at 0
                    return item;
                });
            }

            console.log('PreloadingResourceService.getTreeNodesInit ' + $ctrl.elemType + ' ' + getSBTimestamp());

            var params = {};
            if (p.type) {
                if (treeLists && treeLists.length > 0) {
                    treeLists = _.filter(treeLists, function (item) {
                        return p.type ? item.type === p.type : true;
                    });
                }
                params.type = p.type;
            }

            //if isPrintLayout get only the selected lists. set parent Id null so all will be assigned to parent. ensure the All null parent is the currentList

            //isFolder: false in this case cause each group is a list

            addOtherParents();

            var isRecursiveTree = withRecursiveTree(),
                //set elements count for the lists //docs and materials

                //above all
                pTop = _.extend({
                    _id: null,
                    isFolder: true,
                    order: 0,
                    show: $ctrl.hideLevel0 ? false : true,
                    l: 0,
                    parentId: undefined,
                    name: $ctrl.level0Name,
                    isPredef: true,
                    treeType: p.treeType
                }, params);

            if ($ctrl.selectedIdField !== '_id') {
                pTop[$ctrl.selectedIdField] = null;
            }

            //add the invisible parent for lists with parent null
            var result = {isSet: true};
            if($ctrl.withActiveTree) {
                getListWithCounters(treeLists, undefined);
                result.items = processItems(true);

                if (!isCollaborator) {
                    result.archived = processItems(false);
                }

                function processItems(isActive){
                    return getItems(treeLists, [getPtop(isActive)]);
                }
            }
            else if($ctrl.withArchiveGroupInLists) {
                result.items = getProcessedItemsForParent(treeLists, true);
                result.archived = getProcessedItemsForParent(treeLists, false);
            }
            else {
                result.items = getProcessedItemsForParent(treeLists, undefined);
            }

            return result;

            function getProcessedItemsForParent(treeLists, selectedFilter){
                var lists = selectedFilter === undefined ? treeLists : JSON.parse(JSON.stringify(treeLists)).map(function (item) {
                    if (selectedFilter === false) {
                        item.active = false;
                    }
                    return item;
                });
                getListWithCounters(lists, selectedFilter);
                return getItemsForParent(lists, selectedFilter);
            }

            function getListWithCounters(treeLists, selectedFilter){
                var parents = {};
                treeLists.map(function(item){
                    item = getItemsCountForNode(item, selectedFilter);
                    if($ctrl.maxLevel > 1) {
                        if (!parents[item.parentId]) {
                            parents[item.parentId] = {count: item.count || 0};
                            if ($ctrl.withTreeDisplayCount) {
                                parents[item.parentId].displayCount = item.displayCount || 0;
                            }
                        } else {
                            parents[item.parentId].count += item.count || 0;
                            if ($ctrl.withTreeDisplayCount) {
                                parents[item.parentId].displayCount += item.displayCount || 0;
                            }
                        }
                    }
                    return item;
                });

                if($ctrl.maxLevel > 1) {
                    //level 2
                    for (var i = 0; i < treeLists.length; i++) {
                        var p = treeLists[i], v = parents[p._id];
                        if (p.isFolder && v) {
                            treeLists[i].count = v.count;
                            if ($ctrl.withTreeDisplayCount) {
                                treeLists[i].displayCount = v.displayCount;
                            }
                        }
                    }
                }

                //for recursive???
            }

            function getItemsForParent(treeLists, isActive){
                return getItems(treeLists, getParents(treeLists, getPtop(isActive)));
            }

            function getParents(treeLists, pTop){
                var parents = isRecursiveTree ? [] : _.filter(treeLists, function (item) {
                    return item.isFolder && item[$ctrl.selectedIdField] === null;
                });
                if (!parents.length) {
                    parents.unshift(pTop);
                }
                return parents;
            }

            function getPtop(isActive){
                if(isActive === undefined){
                    return pTop;
                }
                return _.extend({}, pTop, {active: isActive}, isActive ? null: {
                    name: (pTop.name ? pTop.name : 'All').replace('All', 'Archived')
                });
            }

            function addOtherParents() {
                var d = {
                    isFolder: isRecursiveTree,
                    parentId: null,
                    show: true,
                    l: 1,
                    indent: $ctrl.withIndentation ? 1 : 0,
                    isHarcoded: true
                };

                var id = p.archivedName ? p.archivedName : null;
                if (p.withNull || p.withArchiveForGroup && !$ctrl.isPrintLayout) {
                    var x = _.extend({
                        _id: id,
                        order: -1,
                        name: p.archivedName ? p.archivedName : 'General',
                        withArchiveGroupAsList: $ctrl.withArchiveGroupAsList,
                        withArchiveGroupInLists: $ctrl.withArchiveGroupInLists,
                        withNull: p.withNull,
                        withLabelAfter: $ctrl.withLabelAfter && $ctrl.withArchiveGroupAsList ? $ctrl.withLabelAfter : null
                    }, d, params);

                    if (p.withArchiveForGroup) {
                        x.active = false;
                        x.icon = 'box';
                    }

                    if ($ctrl.selectedIdField !== '_id') {
                        x[$ctrl.selectedIdField] = null;
                    }

                    treeLists.unshift(x);
                }

                id = 'All';
                if (p.withHarcodedAll && (!$ctrl.isPrintLayout ||
                    $ctrl.isPrintLayout && p.printedLists.indexOf(id) !== -1)) {
                    var e = _.extend({
                        _id: id,
                        order: -100,
                        name: $ctrl.level0Name,
                        icon: $ctrl.harcodedAllIcon,
                        withLabelAfter: $ctrl.withLabelAfter && !$ctrl.withArchiveGroupAsList ? $ctrl.withLabelAfter : null,
                        withHarcodedAll: true
                    }, d, params);

                    if ($ctrl.selectedIdField !== '_id') {
                        e[$ctrl.selectedIdField] = id;
                    }

                    treeLists.unshift(e);
                }

                if (!p.withHarcodedAll && $ctrl.level0Name) {
                    for (var i = 0, l = treeLists.length; i < l; i++) {
                        if (treeLists[i]._id === 'All') {
                            treeLists[i].name = $ctrl.level0Name;
                            break;
                        }
                    }
                }
            }

            function getTreeFilters(item, treeType) {
                var exists = typeof (p.getTreeFilters) === 'function' ? p.getTreeFilters(item, treeType) : true;
                if (!exists) {
                    return false;
                }

                var falseSelectedFilter = $ctrl.withActiveGroup ? $ctrl.falseSelectedFilterForGroup : ($ctrl.withActiveTree ? $ctrl.falseSelectedFilterForTree : false);

                if ($ctrl.withActiveGroup) {
                    if($ctrl.withArchiveGroupInLists){
                        return true;
                    }
                                                                                        //workflow
                    return !falseSelectedFilter && (item.isHarcoded || item.active || $ctrl.displayAllTreeLists) ||
                        //schedulingx
                        falseSelectedFilter && (item.active === false || p.withArchiveGroupInLists);
                } else if ($ctrl.withActiveTree) {//shots storyboards moodboards contacts files
                    // notes???
                    return true;
                    //todo double check
                    //return (falseSelectedFilter && item.active === false) || (!falseSelectedFilter && item.active === true);
                }

                return exists;
            }

            function getItems(treeLists, parents) {
                var l = parents.length;
                //check if is not All
                if(!(isCollaborator && $ctrl.collabRootId && $ctrl.collabRoot && $ctrl.collabRoot.isFolder)) {
                    return l > 0 ? sortNodes(parents.map(processParentCount)) : [];
                }

                //find on which parent is the specific folder
                return findCollabFolder(parents);

                function findCollabFolder(parents){
                    var l = parents ? parents.length :0;
                    if(l) {
                        for (var i = 0; i < l; i++) {
                            var parent = parents[i];
                            if (parent._id === $ctrl.collabRootId) {
                                return processParentCount(parent);
                            } else if (parent.isFolder) {
                                parent = getParentWithNodes(parent);
                                if (parent.nodes && parent.nodes.length > 0) {
                                    findCollabFolder(parent.nodes);
                                }
                            }
                        }
                    }
                }

                function processParentCount(nodes) {
                    nodes = processParentMethod(nodes, 'count');
                    nodes = processParentMethod(nodes, 'displayCount');

                    return nodes;
                }

                function processParentMethod(parent, prop) {
                    if (parent.l === undefined) {
                        parent.l = 0;
                    }
                    if (parent.indent === undefined) {
                        parent.indent = 0;
                    }
                    return getParentWithNodes(parent, prop);
                }

                function getParentWithNodes(parent, prop){
                    if(!prop){prop = 'count';}
                    var is = isAllORArchived(parent),
                        nodes = _.filter(treeLists, _.extend(getFilterParams(parent, params, is),
                            $ctrl.withActiveTree ? {active: parent.active} : null
                        ));

                        //consider only folders and (the all & archived list)
                    var nodesInit;
                    if($ctrl.isRecursiveTree && !is){
                         nodesInit = [].concat(nodes);
                        //consider only folders and the all & archived list
                        nodes = _.filter(nodes, function (n){
                            return n.isFolder === true || isAllORArchived(n);
                        });
                    }

                    var count = 0;
                    if($ctrl.isRecursiveTree && parent._id !== null && parent.isFolder === true && !is){
                        count = _.filter(nodesInit || nodes, function (n) {
                            return n.isFolder === false && !isAllORArchived(n);
                        }).length;
                    }
                    var fNodes = nodes && nodes.length > 0 ?
                            (isRecursiveTree && !is ? _.filter(nodes, {isFolder: true}) : nodes) :
                            null,
                    countAll = 0,
                    countArchived = 0;

                    if (fNodes && fNodes.length > 0) {
                        parent.nodes = sortNodes(fNodes).map(setNode);
                    }

                    if (!parent.nodes) {
                        parent.nodes = [];
                    }

                    parent[prop] = isAll(parent) ? (countAll + countArchived) : count;

                    return parent;

                    function setNode(el) {
                        if (!el[prop]) {
                            el[prop] = 0;
                        }

                        el.indent = $ctrl.withIndentation ? (parent.indent + 1) : 0;

                        if (el.l === undefined) {
                            el.l = parent.l + 1;
                        }

                        if (el.isFolder && !isAllORArchived(el)) {
                            el = processParentMethod(el, prop);
                        }

                        // el.l = data.isSingleList ? 0 : (item.l + 1);
                        if (el[prop] && !el.isHarcoded) {
                            count += el[prop];
                        }

                        if (isAll(el)) {
                            countAll = isRecursiveTree ? count : el[prop];
                            if (isRecursiveTree) {
                                el[prop] = countAll;
                            }
                        }

                        if (isArchived(el)) {
                            countArchived = el[prop];
                        }

                        if (el.show === undefined) {
                            el.show = true;
                        }

                        return el;
                    }
                }
            }

            function isAll(el) {
                return p.withHarcodedAll && el[$ctrl.selectedIdField] === 'All';
            }

            function isArchived(el) {
                return $ctrl.withArchiveGroupAsList && el.withArchiveGroupAsList;
            }

            function isAllORArchived(el) {
                return isAll(el) || isArchived(el);
            }
        }

        //start debug for tree here -> to populate the tree
        //params: treeType, getTreeParams
        function loadTreeGroups(params, onGroupsLoaded, isCollaborator) {
            console.log('SidebarTreeCtrlService.loadTreeGroups ' + $ctrl.elemType);
            var  treeType = params.treeType;
            if ($ctrl.treeTypeCustomList && $ctrl.treeTypeScriptList) {
                return process($ctrl.treeTypeCustomList, function () {
                    process($ctrl.treeTypeScriptList, onGroupsLoaded, {
                        dontEmptyTrees: true
                    });
                }, {
                    holdOnSelect: true
                });
            } else {
                return process(params.treeType, onGroupsLoaded);
            }

            function process(treeType, onLoaded, rules) {
                return loadTreeGroupsInit(params.getTreeParams(treeType), onLoaded, rules);
            }
//rules: dontEmptyTrees, holdOnSelect
            function loadTreeGroupsInit(p, onLoaded, rules) {
                console.log('ListTreeService.loadTreeGroups ' + $ctrl.elemType);
                //start debug for tree here -> to populate the tree
                if (!rules || rules && !rules.dontEmptyTrees) {
                    $ctrl.trees = {};
                    $ctrl.allLists = {};
                }

                $ctrl.active = {};
                //in compOptions
                $ctrl.isPrintLayout = p.isPrintLayout;
                $ctrl.printedItems = p.printedItems;
                $ctrl.withActiveTree = p.withActiveTree;
                $ctrl.withActiveGroup = p.withActiveGroup;
                $ctrl.withArchiveGroupAsList = p.withArchiveGroupAsList;
                $ctrl.withArchiveGroupInLists = p.withArchiveGroupInLists;
                $ctrl.withTreeDisplayCount = p.withTreeDisplayCount;
                $ctrl.withActiveTreeOrGroup = p.withActiveTreeOrGroup;

                //check if selectedFilter === false
                $ctrl.falseSelectedFilterForGroup = $ctrl.withActiveGroup ? (p.selectedFilter === false) : false;
                $ctrl.falseSelectedFilterForTree = $ctrl.withActiveTree ? (p.selectedFilter === false) : false;
                p.withNull = !$ctrl.falseSelectedFilterForGroup && $ctrl.withNull === true;

                return $ctrl.preLoadingTableName ? processFromCache() : processFromDB();

                function processFromCache() {
                    return process(getTreeNodes(getParams(), isCollaborator));

                    function getParams() {
                        var params = {
                            treeType: p.treeType,
                            withNull: p.withNull,
                            withArchiveGroupInLists: p.withArchiveGroupInLists,
                            withArchiveForGroup: ($ctrl.falseSelectedFilterForGroup || $ctrl.withArchiveGroupAsList) && $ctrl.withActiveGroup && !p.withArchiveGroupInLists,
                            withHarcodedAll: !$ctrl.falseSelectedFilterForGroup && $ctrl.withHarcodedAll === true,
                            getTreeFilters: p.getTreeFilters
                        };

                        if ($ctrl.isPrintLayout) {
                            params.isPrintLayout = true;
                            params.printedLists = p.printedLists;
                            params.printedItems = p.printedItems;
                        }
                        if (params.withArchiveForGroup) {
                            params.archivedName = 'Archived';
                        }
                        return params;
                    }
                }

                function processFromDB() {
                    console.warn('Check if preLoadingTableName must be defined for parent');

                    return $ctrl.listsService.getWithCounters(getGroupFilters(), process, function (err) {
                        console.log('getCounters');
                        console.log(err);
                        process(null);
                    });

                    function getGroupFilters() {
                        var groupFilters = $ctrl.getGroupFiltersInit(),
                            withNull = p.withNull;
                        if (!groupFilters) {
                            groupFilters = {};
                        }
                        if (withNull) {
                            groupFilters.withNull = withNull;
                        }
                        return groupFilters;
                    }
                }

                function process(res) {
                    $ctrl.isLoaded = false;
                                                 //for breakdowns & scheduling
                    var withActiveTreeOrGroup = $ctrl.withActiveTreeOrGroup;
                    if (res) {
                        if (res.options && !$ctrl.isPrintLayout) {
                            $ctrl.filtersService.setOptions(res.options);
                        }
                        if (res.isSingleList) {
                            $ctrl.isSingleList = res.isSingleList;
                        }//for single shot list shared
                        if (res.hasDocs) {
                            $ctrl.hasDocs = res.hasDocs;
                        }
                        //for single shot list shared
                        //tree has already been created so just assign it
                        //happens on return from server side
                        var m = res.isSet ? setTreeItem : setTree;

                        m(p.treeType, withActiveTreeOrGroup ? true : null, res.items, {});

                        if (withActiveTreeOrGroup) {
                            m(p.treeType, false, res.archived, {});
                        }
                    }

                    setListsCounters(withActiveTreeOrGroup, p.treeType);

                    if(!rules || rules && !rules.holdOnSelect) {
                        selectList();
                    }

                    if (onLoaded) {
                        onLoaded();
                    }

                    function selectList(){
                        console.log('select List First Time');
                        var firstTime = true,
                            active = p.isPrintLayout ? {} : $ctrl.getSearch($ctrl.active),
                            parents = [],
                            sel = $ctrl.getSimpleNodeById(active.selectedListId, parents, treeType),
                            node = active.selectedListId !== undefined ? (isCollaborator ? sel : $ctrl.getNodeById(active.selectedListId)) : undefined;
                        if (!node && (!isCollaborator||isCollaborator && $ctrl.active.selectedListId===undefined)) {
                            node = parents[0];
                        }

                        $ctrl.selectList(node, firstTime, isCollaborator);

                        $ctrl.isLoaded = true;
                    }
                }
            }
        }

        function getFirstLevelNodesCount(treeType, selectedFilter) {
            var p = $ctrl.getNodeById(null, treeType, selectedFilter);
            return p && p.nodes ? (p.nodes.length - ($ctrl.withHarcodedAll ? 1 : 0)) -($ctrl.withArchiveGroupAsList ? 1 : 0) : 0;
        }

        function getFirstLeveActiveArchiveCount(treeType) {
            return getFirstLevelNodesCount(treeType, $ctrl.withActiveTree ? true : undefined) +
                ($ctrl.withActiveTree ? getFirstLevelNodesCount(treeType, false) : null);
        }

        function withRecursiveTree(){
            return ($ctrl.isRecursiveTree && !$ctrl.withHarcodedAll) === true;
        }

        function getTreeItemGridInit(params, others) {
            //tree-item-grid
            var tag = (params.treeItemTag ? params.treeItemTag : 'tree') + '-item-grid';
            return '<' + tag + ' ' +
                //treeType
                //startIndent

                'item="item" ' +
                'is-sidebar="::' + params.isSidebar + '" ' +
                'can-edit="::' + (params.canEdit === true && !params.isInTreeModal && !$ctrl.noItemEdit) + '" ' +
                'click-on-group="::' + $ctrl.clickOnGroup + '" ' +
                ($ctrl.hideCounter ? ('hide-counter="' + $ctrl.hideCounter + '" ') : '') +
                'active="$ctrl.isSelectedItem(item)" ' +

                (params.isInTreeModal ? ('is-in-tree-modal="' + params.isInTreeModal + '" ') : '') +

                ($ctrl.selectedIdField !== $ctrl.defaultSelectedIdField ? ('selected-id-field="' + $ctrl.selectedIdField + '" ') : '') +
                (params.elemType ? ('elem-type="' + params.elemType + '" ') : '') +
                (params.itemTitle ? ('item-title="' + params.itemTitle + '" ') : '') +
                (params.itemIcon ? ('item-icon="' + params.itemIcon + '" ') : '') +
                (params.iconForGroup ? ('icon-for-group="' + params.iconForGroup + '" ') : '') +
                ($ctrl.constantsService.CompOptions.canDragPredefTreeItem ? ('can-drag-predef-tree-item="true" ') : '') +
                ($ctrl.withFontSmallForList === true ? 'with-font-small="true" ' : '') +

                'toggle="toggle()" ' +
                'on-go-to-list="$ctrl.goToList(item)" ' +
                'on-get-list-item-icon="$ctrl.getListItemIcon(item)" ' +

                (others ? others : '') +
                '></' + tag + '>';
        }

        function processCachedElementInit(el, cacheType, changedFields, tableType, isChildTable) {
            return $ctrl.preLoadingService.processCachedElementInit(el, cacheType, changedFields, tableType || $ctrl.preLoadingTableName, isChildTable || $ctrl.isChildTable);
        }

        function isNotEmptyGroupState(currentList) {
            var l =  currentList ?  currentList : ($ctrl.active ? $ctrl.active.selectedList : null);
            return l ?(l.count > 0 || $ctrl.isRecursiveTree && l.nodes && l.nodes.length > 0):false;
        }

        function hasItems(treeType, isActive) {
            if (!$ctrl.preLoadingService) {
                return false;
            }
            var tree = $ctrl.getTree(treeType, isActive),
                all = tree && tree.length > 0 ? tree[0] : null;
            return all && all.count > 0;
        }

        function onInitLists(node) {
            if (!$ctrl.preLoadingTableName) {
                return null;
            }
            console.log('onInitLists ' + getSBTimestamp());
            var list = getChildListByType(node, 'getObjectList'),
                items = $ctrl.isPrintLayout && $ctrl.printedItems ? $ctrl.printedItems[node._id] : null;
            return items && items.length > 0 ? _.filter(list, function (item){return !items || items.indexOf(item._id)!==-1;}) : list;
        }

        function getListIdForNode(node) {
            var id = $ctrl.getSelectedFieldFromItem(node);
            return node && (
                (!withRecursiveTree() && node.isFolder && id === null) ||
                $ctrl.withHarcodedAll && node.withHarcodedAll ||
                $ctrl.withArchiveGroupAsList && node.withArchiveGroupAsList
            ) ? undefined : (node && node.withNull ? null : id);
        }

        /*function getNodeCount(node, isDisplay) {
            var f = _.extend({}, groupFilters);
            var listId = node ? node[$ctrl.selectedIdField] : undefined;
            if( node) {
                if (node.isFolder && listId === null) {
                    listId = undefined;
                } else if (p.withHarcodedAll && node.withHarcodedAll) {
                    listId = undefined;
                    f = _.extend(f, {isFolder: false});
                } else if ($ctrl.withArchiveGroupAsList && node.withArchiveGroupAsList) {
                    listId = null;
                    f = _.extend(f, {active: false});
                }
            }

            return $ctrl.preLoadingService.getChildListByType($ctrl.preLoadingTableName, 'getListCount', listId, f);
        }*/

        function getDisplayListCount(list, isTotal) {
            var l = list ? list : ($ctrl.active ? $ctrl.active.selectedList : null);
            return l ? l[(isTotal || ! $ctrl.withTreeDisplayCount) ? 'count' : 'displayCount'] : 0;
        }

        function getDisplayRootCount(treeType, type) {
            var isActive = ($ctrl.withActiveGroup || $ctrl.withActiveTree) ? true : null,
                tree = getTree(treeType, isActive),
                c = getDisplayListCount($ctrl.withHarcodedAll ? getNodeById('All') : tree[0]);

            if (isActive) {
                if($ctrl.withActiveGroup && $ctrl.withArchiveGroupAsList){
                    c += getDisplayListCount(getNodeById('Archived'));
                }
            }

            return c;
        }

        function getNodeCount(node, isDisplay, selectedFilter) {
           // console.log('getNodeCount');
            return getChildListByType(node, 'getListCount', isDisplay, selectedFilter);
        }

        function getChildListByType(node, method, isDisplay, selectedFilter) {
            //console.log('getChildListByType: ' + method + ' ' + $ctrl.elemType + ' ' + node._id);
            var isCount = method === 'getListCount',
                listId = getListIdForNode(node),
                groupOrder = typeof ($ctrl.getGroupOrder) === 'function' ? $ctrl.getGroupOrder(listId) : null,
                list = $ctrl.preLoadingService.getChildListByType($ctrl.preLoadingTableName, method, listId,
                    $ctrl.getGroupFiltersInit(node, method, isDisplay, selectedFilter),
                    groupOrder ? groupOrder : $ctrl.groupOrder, $ctrl.groupPopulate);

            if (typeof ($ctrl.showOnlyHalf) === 'function' && $ctrl.showOnlyHalf()) {
                var count = isCount ? list : (list ? list.length : 0),
                    countH = Math.ceil(count / 2);
                return count ? (isCount ? countH : list.splice(0, countH)) : list;
            }

            return list;
        }

        function onInitAddedItem(result, editTimeout, isDuplicate) {
            console.log('onInitAddedItem');
            var item = result.item;

            result.differentTree = item && result.isDuplicate && result.treeType !== item.type;

            $ctrl.add(result, next);
            function next () {
                if ($ctrl.onTreeAdded) {
                    $ctrl.onTreeAdded(result);
                }
                if(isDuplicate) {
                    computeAllNodesCount();
                }else{
                    computeNodeCount(item._id, result.treeType);
                }
                if(!result.differentTree) {
                    editTimeout(item);
                }
            }
        }

        function onInitRemovedItem(result, next) {
            processRemoveTreeMethod(result, result.removed, $ctrl.onTreeRemoved, next, 'remove');
        }

        function onInitArchivedItem(result, next) {
            onInitAItem($ctrl.onTreeArchived, result, next, 'archive');
        }

        function onInitActivatedItem(result, next) {
            onInitAItem($ctrl.onTreeActivated, result, next, 'activate');
        }

        function onInitAItem(method, result, next, type) {
            var id = result.item ? result.item._id : null; // getSelectedFieldFromItem(result.item);
            processRemoveTreeMethod(result, [id], method, next, type);
        }

        function processRemoveTreeMethod(result, list, method, next, type){
            $ctrl.remove(list, result, function (ids){
                process();

               if($ctrl.withActiveTree && (type === 'archive' || type === 'activate')){
                   $ctrl.add(result, function () {
                       process();
                   }, true);
                } else{
                    process();
                }
            });

            function process(ids) {
                if (typeof (method) === 'function') {
                    method(result);
                }
                if (typeof (next) === 'function') {
                    next();
                }
            }
        }

        function onInitUpdateName(item) {
            console.log('onInitUpdate');
            var updates = {}, props = ['name'];
            if ($ctrl.updateChangedFields) {
                props = props.concat($ctrl.updateChangedFields);
            }

            if($ctrl.customBGForList){
                props = props.concat(['color', 'sideColors', 'background', 'backgroundId']);
            }

            _.each(props, function (prop) {
                updates[prop] = item[prop];
            });
            if ($ctrl.onTreeUpdated) {
                var u = {};
                u[item._id] = updates;
                $ctrl.onTreeUpdated({updates: u});
            }
            replaceNodeProps(getSelectedFieldFromItem(item), updates);
        }

        function compareSelectedFieldIds(){

        }
        function replaceNodeProps(id, props) {
            var item = $ctrl.getNodeById(id), changed;
            if (!item) {
                return;
            }
            var node = angular.copy(item);
            for (var prop in props) {
                if (node[prop] !== props[prop]) {
                    node[prop] = props[prop];
                    changed = true;
                }
            }
            if (changed) {
                //replace immutable;
                var parent = $ctrl.getParentNode(node),
                    nid = getSelectedFieldFromItem(node);
                var index = _.findIndex(parent.nodes, function (el) {
                    return getSelectedFieldFromItem(el) === nid
                });
                if (index !== -1) {
                    parent.nodes[index] = node;
                    if (node._id === $ctrl.active.selectedListId && $ctrl.active.selectedList) {
                        $ctrl.active.selectedList = node;
                    }
                }

                //parent.nodes.splice(index, 1, node);
            }
        }

        function sortNodes(nodes) {
            var order = $ctrl.defaultOrder || 'order',
                dir = $ctrl.defaultOrderDir || 1,
                l = _.sortBy(nodes, order);
            return dir === -1 ? l.reverse() : l;
        }

        function setTree(type, isActive, list, params) {
            var parents = [],
                l = _.filter(list, params),
                defEmpty = {_id: null, isFolder: true, order: 0, show: false, l: 0, indent: 0, parentId: null};
            defEmpty[$ctrl.selectedIdField] = null;
            if ($ctrl.withActiveTree) {
                defEmpty.active = isActive;
            }
            // if ($ctrl.startsAtLevel0) {
            //get groups of parents that are folders
            var filter = $ctrl.withActiveTree ? function (item) {
                return item.isFolder && item.active === isActive;
            } : function (item) {
                return item.isFolder;
            }
            parents = _.filter(l, filter);
            //add the invisible parent for lists with parent null
            if (_.find(parents, function (item) {
                return item.isFolder && getSelectedFieldFromItem(item) === null && !item.parentId;
            }) === undefined) {
                parents.unshift(_.extend(defEmpty, params));//null parent
            }
            /*} else {
                //get groups of parents that have no parents
                parents = _.filter(l, function (item) {
                    return item.isFolder && item._id === null;
                });

                //add the invisible parent for lists with parent null
                if (parents.length === 0) {
                    var p = _.extend({}, defEmpty);
                    if (params.type) {
                        p.type = params.type;
                    }
                    parents.unshift(_.extend(p, params));
                }//null parent
            }*/

            if (parents.length > 0) {
                parents = parents.map(function (parent) {
                    var nodes = parent.nodes && parent.nodes.length > 0 ? parent.nodes : _.filter(list, _.extend(getFilterParams(parent, params, false), function (n){return !n.isFolder}));
                    if (nodes && nodes.length > 0) {
                        parent.nodes = sortNodes(nodes);
                    }
                    if (!parent.nodes) {
                        parent.nodes = [];
                    }
                    return parent;
                });
            }
            parents = sortNodes(parents);
            setTreeItem(type, isActive, parents);
            return getTree(type, isActive);
        }

        function getFilterParams(item, params, is) {
            return _.extend({
                parentId: is ? null : getSelectedFieldFromItem(item)
            }, params);
        }

        function setTreeItem(type, isActive, val) {
            if (typeof ($ctrl.preProcessTreeItem) === 'function') {
                var process = function (nodes) {
                    if (nodes && nodes.length > 0) {
                        nodes = nodes.map(function (parent) {
                            if (!parent.isFolder) {
                                parent = $ctrl.preProcessTreeItem(parent);
                            }
                            process(parent.nodes);
                        });
                    }
                };

                process(val);
            }

            $ctrl.trees[getTreeN(type, isActive)] = val;
        }

        function onTreeDuplicated(result) {
            processTree($ctrl, result, 'onTreeNodeDuplicated');
        }

        function onTreeAdded(result) {
            processTree($ctrl, result, 'onTreeNodeAdded');
        }

        function onTreeUpdated(result) {
            processTree($ctrl, result, 'onTreeNodeUpdated');
        }

        function onTreeRemoved(result) {
            processTree($ctrl, result, 'onTreeNodeRemoved');
        }

        function onTreeArchived(result) {
            processTree($ctrl, result, 'onTreeNodeArchived');
        }

        function onTreeActivated(result) {
            processTree($ctrl, result, 'onTreeNodeActivated');
        }

        function processTree($ctrl, result, method) {
            console.log(method);
            if (!result) {return;}

            if ($ctrl.preLoadingService) {
                if ($ctrl.preLoadingTableName) {
                    $ctrl.preLoadingService.onTreeNodeMethod($ctrl.preLoadingTableName, method, result);
                }
            }
            setListsCounters($ctrl.withActiveTreeOrGroup, result.treeType);
        }

        function setListsCounters(withActiveTree, treeType) {
            if (withActiveTree) {
                setListCount(treeType, hasLists(treeType));
            }
        }

        function onClipboardProcessingForTree(result) {
            console.log('onClipboardProcessingForTree');
            //{id: sId, dif:dif}
            //shot list and projects for moving -> update counter for list and group
            // update the changes for all children of the modified lists
            //works if the display count is not present and if the level is 0
            var dif = result.dif,
                node = setCounter(result.id, dif),
                parentId = node.parentId;
            if (parentId !== undefined) {
               // $ctrl.LCS.timeout(function (){
                    setCounter(parentId, dif);
                //},200)
            }

            function setCounter(id, dif) {
                var node = $ctrl.getNodeById(id);
                if (node) {
                    updateCountForNode(node, getC('count'), getC('displayCount'));
                    return node;
                }
                return node;

                function getC(prop){
                    return (node[prop] ? node[prop] : 0) + dif;
                }
            }
        }

        function getBreadcrumbs(node) {
            var breadcrumbs = [];
            if (node) {
                $ctrl.CPS.SessionService.pageChildName = node.name;
            }
            process(node);

            return breadcrumbs.reverse();

            function process(tn) {
                if (tn && tn.name) {
                    var info = 'name: ' + tn.name + '; id: ' + tn._id + '; ';
                    var el = {name: tn.name, isFolder: true, _id: tn._id,};
                    if ($ctrl.selectedIdField !== $ctrl.defaultSelectedIdField) {
                        el[$ctrl.selectedIdField] = tn[$ctrl.selectedIdField];
                        info += $ctrl.selectedIdField + ': ' + el[$ctrl.selectedIdField];
                    }
                    breadcrumbs.push(el);
                    console.log(info);
                    if (getSelectedFieldFromItem(tn) !== null && (tn.parentId !== null || tn.parentId === null && !tn.isFolder)) {
                        process(getParentNode(tn));
                    }
                }
            }
        }

        function setList(id, list, elemType, params) {
            console.log('treeservice.selectList ' + id + ' ' + elemType);
            $ctrl.allLists[getListN(id)] = list;

            //todo: getoptions differently
            if(!$ctrl.isPrintLayout) {
                $ctrl.filtersService.recomputeOptions($ctrl.options, params, id, elemType, function (newOptions) {
                    console.log('filtersService.recomputeOptions listTreeService.setList ' + getSBTimestamp());
                    $ctrl.options = newOptions;
                });
            }
        }

        function getActiveList(id) {
            return $ctrl.getList($ctrl.active.selectedListId);
        }

        function getList(id) {
            return $ctrl.allLists[getListN(id)];
        }

        function getListName(id) {
            return 'allLists.' + getListN(id);
        }

        function getListN(id) {
            return 'c_' + id;
        }

        function hasLists(type, isActive) {
            /*if (!$ctrl.isLoaded) {
                console.log('hasLists: isLoaded = false');
                return false;
            }*/

            var trees = $ctrl.trees;
            if (!trees) {
                console.log('hasLists: trees = null');
                return false;
            }

            if (type !== undefined) {
                return check(type);
            }

            for (var prop in trees) {
                if (!$ctrl.withActiveTree || $ctrl.withActiveTree && prop.indexOf('false') === -1 &&
                    hasLists(getTypeFromTreeN(prop))) {
                    return true;
                }
            }

            return false;

            function check(type) {
                if (!$ctrl.withActiveTreeOrGroup) {
                    return $ctrl.hasListsChecker(type, null);
                }

                if(isActive !== undefined) {
                    if(isActive){
                        return $ctrl.hasListsChecker(type, true);
                    } else{
                        return !!$ctrl.hasListsChecker(type, false);
                    }
                } else{
                    //$ctrl.withActiveTree
                    if ($ctrl.hasListsChecker(type, true)) {
                        return true;
                    }
                    return !!$ctrl.hasListsChecker(type, false);
                }
            }
        }

        function hasListsChecker(type, isActive) {
            //  return $ctrl.CPS.isCollaborator ? true : ($ctrl.listTreeService.hasDocs? true : (parents && parents.length > 0 ? true : false));
            var tree = $ctrl.getTree(type, isActive),
                all = tree && tree.length > 0 ? tree[0] : null;

            if ($ctrl.withoutEmptyState) {
                return true;
            }
            var withCount = $ctrl.listCheckerConsidersItemsCount;
            if (withCount && all && all.count > 0) {
                return true;
            }

            var parents = all ? all.nodes : null,
                l = parents ? parents.length : 0;

            if (l > 0) {
                if (!withCount) {
                    return true;
                }
                //there is at least a group or list
                if (parents && _.filter(parents, function (item) {
                    var id = getSelectedFieldFromItem(item);
                    // console.log('hasListsChecker: id =  ' + id);
                    //general
                    return (id === null || item.withHarcodedAll || item.withArchiveGroupAsList) ? item.count > 0 : true;
                }).length > 0) {
                    return true;
                }//there is at least a group item in a list that is not general or 'All'
            }

            return false;
        }

        /*

    function hasListsChecker(type) {
        var tree = $ctrl.listTreeService.getTree(type),
            parent = tree && tree.length > 0 ? tree[0] : null,
            parents = parent ? parent.nodes : null;
        return $ctrl.CPS.isCollaborator ? true : ($ctrl.listTreeService.hasDocs? true : (parents && parents.length > 0 ? true : false));
    }*/
        function processUpdates(result, withSort, props, processUpdatesMore, afterProcessUpdates) {
            console.log('treeService.processUpdates');
            var changed = {}, exists,
                processMore = typeof (processUpdatesMore) === 'function',
                parents = [],
                updates = result.updates;

            if (result.srcParentId !== undefined) {
                parents.push(result.srcParentId);
            }

            if ($ctrl.onTreeUpdated) {
                $ctrl.onTreeUpdated({
                    updates: updates,
                    updatesG: result.updatesG
                });
            }

            for (var id in updates) {
                processU(updates[id]);
            }

            var l = parents.length;
            if (l > 0) {
                _.each(parents, processItem);
            }

            if (processMore && exists) {
                processUpdatesMore(changed, result);
            }

            if (afterProcessUpdates) {
                afterProcessUpdates(result);
            }

            function processU (newel) {
                if (!newel) {return;}

                var el = $ctrl.getNodeById(id);
                if (!el) {return;}

                //if doesnt already exist add node to the parents list
                if (_.find(parents, function (id) {
                    return id === el.parentId;
                }) === undefined) {
                    parents.push(el.parentId);
                }

                for (var j = 0, k = props.length; j < k; j++) {
                    var prop = props[j],
                        val = newel[prop];
                    //if parentId changed adjust indentation ???
                    if (val !== undefined && el[prop] !== val) {
                        el[prop] = val;
                        if (processMore) {
                            if (!changed[id]) {
                                changed[id] = {};
                            }
                            changed[id][prop] = val;
                            exists = true;
                        }

                    }
                }
            }

            function processItem(id) {
                var node = $ctrl.getNodeById(id);
                if (node) {
                    var nodes = node.nodes;
                    if (nodes && nodes.length > 0) {
                        var count = 0;
                        _.each(nodes, function (item) {
                            if (!item.isHarcoded && item.count) {
                                count += item.count;
                            }
                        });
                        node.count = count;
                        if (withSort) {
                            node.nodes = sortNodes(node.nodes);
                        }
                    } else {
                        node.count = 0;
                    }
                }
            }
        }

        function selectList(item, firstTime, isCollaborator, treeType, fromsame) {
            console.log($ctrl.elemType + ' listTreeService.selectList');

            var reloadList = !item,
                mentId = $ctrl.getSelectedIdFromItem(item, $ctrl.collabRootId && isCollaborator);

            if(firstTime && isCollaborator && $ctrl.collabRootId){
                $ctrl.collabRoot = item || null;
            }

            var parents = [],
                prevSelectedListId = $ctrl.getSelectedIdFromItem($ctrl.active ? $ctrl.active.selectedList : null, $ctrl.collabRootId && isCollaborator),
                selectedListId = $ctrl.getSelectedIdFromItem(item),
                selectedList = item ? item : $ctrl.getSimpleNodeById(selectedListId, parents, treeType);

            if (!selectedList && (!isCollaborator || !$ctrl.collabRootId )) {
                selectedList = parents && parents.length > 0 ? parents[0] : null;
                selectedListId = $ctrl.getSelectedIdFromItem(selectedList);
            }

            selectedList = getActiveSelected(selectedListId, selectedList);
            selectedListId = $ctrl.getSelectedIdFromItem(selectedList);

            //dont load groups f one cant click on them
            if(selectedList && selectedList._id && selectedList.isFolder && $ctrl.clickOnGroup === false ){
                return;
            }
            //in case no list is specified ensure the setup of the list id in url
            var same = mentId === selectedListId;
            if(!(same && selectedListId === null)) {
                if (reloadList || !same) {
                    selectList(selectedList, false, isCollaborator, treeType, true);
                    return;
                }
            }

            $ctrl.active.selectedList = selectedList;
            $ctrl.active.selectedListId = selectedListId;
            if($ctrl.withArchiveGroupInLists && $ctrl.active.selectedList === false && $ctrl.filtersService.selectedFilter === false){
                $ctrl.selectedFilter = false;
            }
            if($ctrl.withActiveTree && $ctrl.active.selectedList){
                $ctrl.selectedFilter = $ctrl.active.selectedList.active;
            }
            //is all
            var l = $ctrl.active && $ctrl.active.selectedList && $ctrl.active.selectedList.nodes ? $ctrl.active.selectedList.nodes.length : 0;
            if(firstTime && $ctrl.withActiveTree && $ctrl.active.selectedList && $ctrl.active.selectedList._id === null &&
                !l){
                $ctrl.loadDirectory($ctrl.active.selectedList, firstTime || fromsame);
            } else {
                var dont = firstTime || prevSelectedListId === undefined && !selectedListId || $ctrl.withoutLoadDirectory;
                if (dont) {
                    console.log('first time selectList: ' + selectedListId);
                } else if (selectedListId !== prevSelectedListId) {
                    console.log('selectList: ' + selectedListId);
                    $ctrl.loadDirectory($ctrl.active.selectedList, firstTime || fromsame);
                }
            }
        }

        function reloadGroups(extraParam, params, otherParams) {
            console.log('listTreeService.reloadGroups ' + $ctrl.elemType + ' ' + getSBTimestamp());

            if ($ctrl.cachedListName) {
                $ctrl.cachedListId = $ctrl.active.selectedListId;
                $ctrl.LCS.PersistenceService.set($ctrl.cachedListName, $ctrl.cachedListId);
            }
            if (typeof ($ctrl.onListSelected) === 'function') {
                $ctrl.onListSelected($ctrl.active.selectedListId);
            }
            setActive($ctrl.active);
            if (!$ctrl.active) {
                 return p(null);
            }

            var node = $ctrl.active.selectedList;
            if (node) {
                p( node.isFolder && !$ctrl.isRecursiveTree ? node.nodes : [node]);
            }

            function p(nodes){
                return processInitLists(extraParam, params, nodes);

                function loadGroupLoaded(nodes){
                    if(otherParams && otherParams.$ctrl && otherParams.$ctrl.keyboardService){
                        otherParams.$ctrl.keyboardService.loadGroupLoaded(otherParams.$ctrl, nodes);
                    }
                }

                function processInitLists(extraParam, p, nodes) {
                    console.log('processInitLists ' + getSBTimestamp());
                    var n = nodes && nodes.length > 0 ? nodes.length : 0;
                    if (n) {
                        loadGroupLoaded(nodes);

                        if ($ctrl.preLoadingTableName) {
                            _.each(nodes, function (node) {
                                var list = $ctrl.onInitLists(node) || [];
                                /* double check if is needed
                                var result = $ctrl.listTreeService.onInitLists(node),
                                    listField = $ctrl.listTreeService.getSelectedFieldFromItem(node),
                                    list = [];
                                if (result) {
                                    var params = {};
                                    if ($ctrl.listField) {
                                        params[$ctrl.listField] = listField;
                                    }
                                    var els = _.filter(result, params);
                                    if (els && els.length > 0) {
                                        list = els && els.length > 0 ? els : [];
                                    }
                                }*/
                                if ($ctrl.shouldLoad(list)) {
                                    $ctrl.setList($ctrl.getSelectedIdFromItem(node), list, extraParam.elemType, {
                                        companyId: extraParam.companyId,
                                        productId: extraParam.productId,
                                    });
                                }
                            });
                        }
                        else {
                            var params = _.extend({}, p);
                            var pageSize = null;
                            if ($ctrl.listField) {
                                params[$ctrl.listField] = {$in: nodes ? nodes.map($ctrl.getSelectedFieldFromItem) : null};
                            }
                            //extraParam.service.queryPaged(params, pageSize, 0, null, extraParam.includeFields, extraParam.populate,
                            extraParam.service.getAll(params, pageSize, extraParam.populate, onsuccess, onerror);

                            function onsuccess() {

                            }

                            function onerror() {
                                console.error('todo define onprocess for processInitLists');
                            }
                        }
                    }
                }
            }
        }


        function getSelectedIdFromItem(item, isUndefined) {
            return item ? item[$ctrl.selectedIdField] : (isUndefined ? undefined : null);
        }

        function getSelectedFieldFromItem(item) {
            return item ? item[$ctrl.selectedIdField] : null;
        }

        function uiOnParamsChanged(changedParams, treeType) {
            console.log('uiOnParamsChanged');
            // do something with the changed params
            // you can inspect $transition$ to see the what triggered the dynamic params change.

            if ($ctrl.treeListParamId && changedParams) {
                console.log('uiOnParamsChanged');
                var p = changedParams[$ctrl.treeListParamId];
                if (p !== undefined) {
                    $ctrl.transitionList = $ctrl.getNodeById(p, treeType);
                }
            }
        }

        //contacts tree
        function updateNodeCountById(id, treeType) {
            return updateNodeCount($ctrl.getNodeById(id, treeType));
        }

        function computeNodeCount(id, treeType, isSimple) {
            var node = $ctrl.getNodeById(id);
            if (node) {
                //console.log('computeNodeCount ' + id);
               /* if(node.isFolder){
                    var n = node.nodes
                    if(n && n.length > 0) {
                        var count = 0, displayCount = 0;
                        _.each(n, function (node){

                        })
                    }

                } else { */
                    node = updateNodeCount(node, treeType);

                    if (!isSimple && getSelectedFieldFromItem(node) === null && node.isFolder && node.parentId === undefined && node.nodes && node.nodes.length === 1) {
                        node.nodes[0] = updateCount(node.nodes[0], [node.count, node.displayCount]);
                    }

                    if(node.parentId !== undefined){
                        var p = $ctrl.getNodeById(node.parentId);
                        if($ctrl.maxLevel > 1 && p.isFolder && p.nodes && p.nodes.length > 0){
                            var info = {count: 0, displayCount: 0};
                            _.each(p.nodes, function (n){
                                info.count += n.count || 0;
                                info.displayCount += n.displayCount || 0;
                            });
                            p = updateCount(p, [info.count, info.displayCount]);

                        } else {
                            computeNodeCount(node.parentId, treeType, true);
                        }
                    }
                //}
            }
            return node;
        }

        function computeAllNodesCount() {
            for (var prop in $ctrl.trees) {
                processA(true);
                if ($ctrl.withActiveTreeOrGroup) {
                    processA(false);
                }
            }

            function processA(isActive) {
                process($ctrl.getTree(getTypeFromTreeN(prop), isActive));
            }

            function process(list) {
                var l = list ? list.length : 0;
                if (l) {
                    for (var i = 0; i < l; i++) {
                        var node = list[i];
                        if (!node) {
                            return;
                        }
                        node = updateNodeCount(node);
                        process(node.nodes);
                    }
                }
                return null;
            }
        }

        function updateCountForNodeId(id, count, displayCount) {
            return updateCountForNode(getNodeById(id), count, displayCount);
        }

        function updateCountForNode(node, count, displayCount) {
            console.log('updateCountForNode');
            if (node) {
                var parent = getParentNode(node); //set count for list node
                if (parent) {
                    var ncount = [parent.count, parent.displayCount];
                    if ($ctrl.withHarcodedAll) {
                        var all = [0,0], archived = [0,0];
                        if (getSelectedFieldFromItem(parent) === null && parent.isFolder && parent.isPredef) { //All
                            var nodes = parent.nodes;
                            if (nodes) {
                                var temp, c, harcodedItem = true, l = nodes.length;
                                for (var i = 0; i < l && harcodedItem; i++) {
                                    temp = nodes[i];
                                    if (temp.isHarcoded) {
                                        c = getNodeCountVals(temp);

                                        if (temp.withHarcodedAll) {
                                            all = angular.copy(c);
                                        }
                                        if (temp.withArchiveGroupAsList) {
                                            archived = angular.copy(c);
                                        }
                                        nodes[i].count = c[0];
                                        if($ctrl.withTreeDisplayCount) {
                                            nodes[i].displayCount = c[1];
                                        }
                                    } else {
                                        harcodedItem = false;
                                    }
                                }
                            }
                            _.each(all, function (i){
                                ncount[i] = all[i] + archived[i];
                            });
                        } else {
                            ncount = getNodeCountVals(parent);
                        }
                    } else {
                        ncount = [getParentC(count, 'count')];
                        if($ctrl.withTreeDisplayCount) {
                            ncount.push(getParentC(displayCount, 'displayCount'));
                        }
                    }
                    updateCount(parent, ncount);


                    function getParentC(count, prop){
                        var dif = count - (node[prop] ? node[prop] : 0);
                        return (parent[prop] ? (parent[prop] + dif) : dif);
                    }
                }

                updateCount(node, [getC(count, false), getC(displayCount, true)]);

                function getC(c, isDisplay){
                    return node.isHarcoded ? getNodeCount(node, isDisplay) : c;
                }
            }
        }

        function getNodeCountVals(node){
            var vals = [getNodeCount(node, false)];
            if($ctrl.withTreeDisplayCount){vals.push(getNodeCount(node, true));}
            return vals;
        }

        function updateNodeCount(node){
           return updateCount(node, getNodeCountVals(node));
        }

        //l = [count, displayCount]
        function updateCount(node, vals) {
            if (!node) {
                return node;
            }
            var changed = false,
                props = ['count'];
            if ($ctrl.withTreeDisplayCount) {
                props.push('displayCount');
            }
            if (vals) {
                _.each(vals, function (val, i) {
                    if (vals.length > i) {
                        var prop = props[i];
                        if (node[prop] !== val) {
                            node[prop] = val; //set new count for node with items
                            changed = true;
                        }
                    }
                });
            }
            if (changed) {
                if (node._id === $ctrl.active.selectedListId && $ctrl.active.selectedList) {
                    $ctrl.active.selectedList = node;
                }

                processCachedElementInit(node, $ctrl.preLoadingService.Ops.Edit, props, null, true);
            }
            return node;
        }

        function getParentNode(node) {
            return $ctrl.getNodeById(node.parentId, node.treeType);
        }

        function getNodeById(id, treeType, selectedFilter) {
            var parents = [],
                n = getSimpleNodeById(id, parents, treeType, selectedFilter);
            return n ? n : parents[0];
        }

        function getSimpleNodeById(id, parents, treeType, selectedFilter) {
            var n;
            if(treeType){
                return processTree(treeType) || null;
            } else {
                for (var prop in $ctrl.trees) {
                    n = processTree(getTypeFromTreeN(prop), selectedFilter);
                    if (n) {
                        return n;
                    }
                }
                return null;
            }

            function processTree(treeType, selectedFilter){
                var tree = $ctrl.getTree(treeType, selectedFilter !== undefined ? selectedFilter : $ctrl.filtersService.selectedFilter);
                if (tree && tree.length > 0) {
                    parents.push(tree[0]);
                    n = process(tree);
                    if (n) {
                        return n;
                    }
                }
                return null;
            }

            function process(list) {
                var l = list ? list.length : 0;
                if (l) {
                    for (var i = 0; i < l; i++) {
                        var node = list[i];
                        if (!node) {
                            return null;
                        }
                        if (getSelectedFieldFromItem(node) === id) {
                            return node;
                        } else {
                            var n = process(node.nodes);
                            if (n) {
                                return n;
                            }
                        }
                    }
                }
                return null;
            }
        }

        function getActiveSelected(selectedListId, node) {
            console.log('getActiveSelected: ' + selectedListId);
            var res;
            if (node) {
                res = getChildSelected(node);
                if (res) {
                    return res;
                }
            }

            if (!selectedListId) {
                // or if here are no strips and there are custom lists set it as the first custom list
                for (var prop in $ctrl.trees) {
                    var parents = $ctrl.getTree(getTypeFromTreeN(prop), $ctrl.filtersService.selectedFilter);
                    var l = parents && parents.length > 0 ? parents.length : 0;
                    for (var i = 0; i < l; i++) {
                        var node1 = getChildSelected(parents[i]);
                        if (node1) {
                            return node1;
                        }
                    }
                }
            }
            return null;
        }

        function getChildSelected(node) {
            if (!node) {
                return null;
            }
//if is print layout retrun current node -> most likely the parent
            if (!node.isFolder || $ctrl.isPrintLayout) {
                return node;
            }


            if ($ctrl.dontStartTreeWithAll && getSelectedFieldFromItem(node) === null) { //if dont start with all select the first list
                //todo check if necessary
                var ch = node.nodes, firstFolder;
                var chl = ch && ch.length > 0 ? ch.length : 0;
                if (chl) {
                    for (var i = 0; i < chl; i++) {
                        var temp = ch[i];
                        if (temp.isFolder && !temp.withHarcodedAll) {
                            if(!firstFolder){firstFolder=temp;}
                            var l = temp.nodes && temp.nodes.length ? temp.nodes.length : 0;
                            for (var j = 0; j < l; j++) {
                                var n = temp.nodes[j];
                                if (n.show) {
                                    return n;
                                }
                            }
                        } else if (temp.show) {
                            return temp;
                        }
                    }
                    if(firstFolder){return firstFolder;}
                }
            } else if (node.isFolder && !$ctrl.clickOnGroup && $ctrl.maxLevel > 1) {//if one can't click on groups select the child
                return node.nodes && node.nodes.length > 0 ? node.nodes[0] : (node.show === false ? null : node);
            }

            return node;
        }

        function setActive(active) {
            //$ctrl.setSearch(active);
            $ctrl.active = active;
        }

        function getTree(type, isActive) {
            return $ctrl.trees ? $ctrl.trees[getTreeN(type, isActive)] : null;
        }

        function getTreeN(type, isActive) {
            return 't_' + type + ($ctrl.withActiveTreeOrGroup ? ('_' + isActive) : '');
        }

        function getTypeFromTreeN(name) {
            return name ? parseInt(name.split('_')[1], 10) : null;
        }

        function getItemsCountForNode(item, selectedFilter) {
            //group items count
            if (!item.isFolder) {
                item.count = getNodeCount(item, false, selectedFilter);
                if($ctrl.withTreeDisplayCount) {
                    item.displayCount = getNodeCount(item, true, selectedFilter);
                }
            }
            return item;
        }

        function add(result, next, dontSelect) {//{item: item, updates: result}
            var item = result.item ? $ctrl.listsService.convertResource(result.item) : null,
                type = result.differentTree ? item.type :
                    (result.treeType ? result.treeType : (item.type ? item.type : defaultType)),
                added,
                updates = result.updates,
                toAdd = {};

            _.each((result.added ? result.added : []).concat([item]), function (el){
                toAdd[ 'c_'+el._id] = el;
            });

            if (!item) {
                return next();
            }
            var parents = $ctrl.getTree(type, item.active);
            var l = parents ? parents.length : 0,
                parent;
            if (l) {
                for (var i = 0; i < l; i++) {
                    parent = parents[i];
                    parents[i].nodes = processNodes(parent.nodes, parent);
                }
            }

            if(!result.differentTree && !dontSelect) {
                $ctrl.LCS.timeout(function () {
                    console.log('selectList ' + getSBTimestamp());
                    $ctrl.selectList(item, false);
                }, 100);
            }

            next();

            function processNodes(nodes, parent) {
                var parentId = getSelectedFieldFromItem(parent);
                if (!nodes) {
                    nodes = [];
                }

                //see if there are any nodes to be added that have this as parent
                for(var id in toAdd) {
                    var item = toAdd[id];
                    if (item) {
                        if (parent.isFolder && item.parentId === parentId && parent.isFolder) {
                            item.l = (parent ? parent.l : 0) + 1;
                            item.indent = (parent ? parent.indent : 0) + ($ctrl.withIndentation ? 1 : 0);
                            if (item.show === undefined) {
                                item.show = true;
                            }
                            var index = _.findIndex(nodes, {_id: item._id})
                            if(index === -1) {
                                nodes.push(item);
                            } else {
                                nodes[index] = item;
                            }
                            toAdd[id] = null;
                        }
                    }
                }
                var l = nodes.length;
                if (l > 0) {
                    nodes = nodes.map(function (el) {
                        var upd = updates ? updates[el._id] : null;
                        if (upd) {
                            el.order = upd.order;
                        }
                        return el;
                    });
                    nodes = sortNodes(nodes);
                    for (var i = 0; i < l; i++) {
                        nodes[i].nodes = processNodes(nodes[i].nodes, nodes[i]);
                    }
                }

                return nodes;
            }
        }

        function remove(removed, result, next) {
            var updates = result.updates,
                ungroup = result.ungroup,
                selectedListId = $ctrl.active.selectedListId,
                type = result.treeType ? result.treeType : (result.item && result.item.type ? result.item.type : defaultType),
                active = $ctrl.active.selectedList.active,
                parents = $ctrl.getTree(type, active),
                isSelected = false;
            processNodes(parents);

            if($ctrl.withActiveGroup && $ctrl.withArchiveGroupInLists && active){
                processNodes($ctrl.getTree(type, !active));
            }

            if (isSelected || ungroup) {
                var parent = parents[0];//todo see if should select a child
                $ctrl.LCS.timeout(function () {
                    $ctrl.selectList(parent, false);
                }, 100);
            }
            next();

            function processNodes(nodes, parent) {
                var l = nodes && nodes.length > 0 ? nodes.length : 0;
                if (!l) {
                    return null;
                }
                var rl = removed && removed.length > 0 ? removed.length : 0;
                for (var j = l - 1; j >= 0; j--) {
                    var node = nodes[j],
                        id = node._id;// getSelectedFieldFromItem(node);

                    if (rl > 0 && removed.indexOf(id) !== -1) {
                        nodes.splice(j, 1);
                        if (id === selectedListId) {
                            isSelected = true;
                        }
                        if (parent && !node.isFolder && node.count) {
                            parent.count = parent.count - node.count;
                        }
                    } else {
                        var upd = updates ? updates[id] : null;
                        if (upd) {
                            node.order = upd.order;
                        }
                        node.nodes = processNodes(node.nodes, node);
                    }
                }
                return nodes;
            }
        }

        function getSearch(active) {
            var search = $ctrl.SBStateService.getSearchFilter('filter');

            var sp = $ctrl.SBStateService.getCurrentStateParams();
            active.selectedListId = sp[$ctrl.listField] ? sp[$ctrl.listField] : undefined;
            if (!active.selectedListId && $ctrl.cachedListId) {
                active.selectedListId = $ctrl.cachedListId;
            }
            if (search) {
                /*a = {selectedListId, treeType, view, type, ratio, column, dayBreakId} -> l: s: v: t: r:, c:, d:*/
                if (!active.selectedListId && search.l) {
                    active.selectedListId = search.l;
                }
                if (!active.options) {
                    active.options = $ctrl.options || {};
                }
                if (search.v) {
                    active.options.view = search.v;
                }
                if (search.r) {
                    active.options.ratio = search.r;
                }
                if (search.c) {
                    active.options.column = search.c;
                }
                if (search.t) {
                    active.options.type = search.t;
                }
                if (search.cs) {
                    active.options.columns = search.cs;
                }
                if (search.tt) {
                    active.treeType = search.tt;
                }
                //remove any filter
                $ctrl.SBStateService.setSearchFilter(null, 'filter');

                return $ctrl.getSearchFilter(active, search);
            }

            return active;
        }

        function setSearch(active) {
            var info,
                o = $ctrl.options;
            if (o) {

                if (o.view) {
                    if (!info) {
                        info = {};
                    }
                    info.v = o.view;
                }

                if (o.ratio) {
                    if (!info) {
                        info = {};
                    }
                    info.r = o.ratio;
                }

                if (o.column) {
                    if (!info) {
                        info = {};
                    }
                    info.c = o.column;
                }

                if (o.columns) {
                    if (!info) {
                        info = {};
                    }
                    info.cs = o.columns;
                }
            }
            info = $ctrl.setSearchFilter(info);
            if (info) {
                $ctrl.SBStateService.setSearchFilter(info, 'filter');
            }
        }

        function getSearchFilter(a, search) {
            return a;
        }

        function setSearchFilter(info) {
            return info;
        }
    };
}

angular.module('list.tree.sidebar.controller.service', [
    'ctrl.PopupsCtrl.service',
    'tree.item.component',
    'tree.item.remove.component',
    'tree.item.edit.component',
    'tree.item.more.component',
    'group.sbPopover.events.service',
    'list.tree.currentList.service'
])
    //set on sidebar
.service('SidebarTreeCtrlService', SidebarTreeCtrlService);
SidebarTreeCtrlService.$inject = ['CompInitCtrlService', 'PopoverInitEventsService', 'TemplateCompileService', 'CurrentTreeListService', 'RouteCollaboratorsService', 'SBFieldTypesService'];
function SidebarTreeCtrlService(CompInitCtrlService, PopoverInitEventsService, TemplateCompileService, CurrentTreeListService, RouteCollaboratorsService, SBFieldTypesService) {
    return function($ctrl, $element, listTreeInitParams) {
        console.log('SidebarTreeCtrlService');
        $ctrl.PopoverInitEventsService = PopoverInitEventsService;
        $ctrl.SBFieldTypesService = SBFieldTypesService;
        $ctrl.CurrentTreeListService = CurrentTreeListService;
        $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;

        $ctrl.onListTreeInitDestroy = onListTreeInitDestroy;

        if(!$ctrl.$onDestroy){
            $ctrl.$onDestroy  = $ctrl.onListTreeInitDestroy;
        }

        if(!$ctrl.compLoaded){
            $ctrl = new CompInitCtrlService($ctrl);
        }

        $ctrl.$element = $element;
        $ctrl.element = $ctrl.$element[0];

        if($ctrl.compOptions && !$ctrl.compOptionsUpdated) {
            var compOptions;
            try {
                compOptions = JSON.parse($ctrl.compOptions);
                if (compOptions) {
                    $ctrl = $.extend($ctrl, compOptions);
                    $ctrl.compOptionsUpdated = true;
                }
            } catch (e) {}
        }

        if (!$ctrl.listParams) {
            console.warn('define $ctrl.listParams in parent for PageTreeInitCtrlService');
        }

        if(listTreeInitParams){
            $ctrl = _.extend($ctrl, listTreeInitParams);
        }

        $ctrl.editedId = undefined;

        if (!$ctrl.objectType) {
            console.warn('define $ctrl.objectType in parent');
        }

        if (!$ctrl.withoutListField && !$ctrl.listField) {
            console.warn('define $ctrl.listField in parent');
        }

        if (!$ctrl.elemType) {
            console.warn('define $ctrl.elemType in parent');
        }

        if ($ctrl.canEdit === undefined) {
            console.warn('Parent must define canEdit');
        }

        if (!$ctrl.listParams) {
            console.warn('define $ctrl.listParams in parent for InitGroupCtrl');
        }

        if (!$ctrl.sidebarButtons) {
            $ctrl.sidebarButtons = getSidebarButtons();
        }
        if(!$ctrl.getListIdsForTreeItemsMoved){
            $ctrl.getListIdsForTreeItemsMoved = getListIdsForTreeItemsMoved;
        }

        if ($ctrl.listTreeService === undefined) {
            console.warn('Parent for ListTreeInitCtrl must define $ctrl.listTreeService');
        } else {
            $ctrl.listTreeService.listField = $ctrl.listField;
            $ctrl.listsService = $ctrl.listTreeService.listsService;
            $ctrl.filtersService = $ctrl.listTreeService.filtersService;
            $ctrl.withArchiveGroupAsList = $ctrl.listTreeService.withArchiveGroupAsList;

            if(!$ctrl.isCommentsSidebar) {
                $ctrl.RouteCollaboratorsService.setListTreeService($ctrl.listTreeService, $ctrl.compOptions);
            }
        }

        if ($ctrl.service === undefined) {
            console.warn('Parent for ListTreeInitCtrl must define prop $ctrl.service');
        }

        if ($ctrl.watchers === undefined) {
            console.warn('Parent for ListTreeInitCtrl must define prop $ctrl.watchers');
        }

        if (!$ctrl.getPopoverTemplate) {
            console.warn('Parent for ListTreeInitCtrl must define method $ctrl.getPopoverTemplate()');
        }

        if(!$ctrl.eventCounterChanged){
            $ctrl.eventCounterChanged = eventCounterChanged;
        }

        if(!$ctrl.onCurrentTreeListChanged) {
            $ctrl.onCurrentTreeListChanged = onCurrentTreeListChanged;
        }

        if(!$ctrl.hideExtraItemsCond) {
            $ctrl.hideExtraItemsCond = hideExtraItemsCond;
        }

        if(!$ctrl.treeItemTag){
            $ctrl.treeItemTag = 'tree';
        }

        $ctrl.listTreeService.popupTreeParams = {
            hasCustomItemEdit: $ctrl.hasCustomItemEdit,
            itemIcon: $ctrl.itemIcon,
            iconLevel: $ctrl.iconLevel,
            iconForGroup: $ctrl.iconForGroup,
            moveInGroup: $ctrl.listTreeService.moveInGroup,
            selectedFilter: $ctrl.selectedFilter
        };

        $ctrl.reloadForList = reloadForList;
        $ctrl.goToList = goToList;
        $ctrl.toggleTree = toggleTree;
        $ctrl.getParentId = getParentId;
        $ctrl.getTreeItemGrid = getTreeItemGrid;
        $ctrl.reloadTreeGroups = reloadTreeGroups;
        $ctrl.showBottomButtonsInit = showBottomButtons;

        if(!$ctrl.getItemForDuplicate) {
            $ctrl.getItemForDuplicate = getItemForDuplicate;
        }

        if(!$ctrl.getItemForAdd) {
            $ctrl.getItemForAdd = getItemForAdd;
        }

        $ctrl.toggleInnerSidebar = toggleInnerSidebar;

        $ctrl.getSidebarName = getSidebarName;
        $ctrl.hasInnerSidebar = hasInnerSidebar;

        if(!$ctrl.getImgSizeInit){
            $ctrl.getImgSizeInit = getImgSizeInit;
        }

        $ctrl.addBottomItem = addBottomItem;

        $ctrl = new $ctrl.PopoverInitEventsService($ctrl, {
            popupPlacement: 'bottom-end',
            isTree: true,
            getMorePopoverTemplate: getMorePopoverTemplate,
            onMorePopoverUpdate: typeof ($ctrl.onMorePopoverUpdate) === 'function' ? $ctrl.onMorePopoverUpdate : onMorePopoverUpdate
        });

        if ($ctrl.canEdit) {
            if (!$ctrl.addItem) {
                $ctrl.addItem = addItem;
            }
            $ctrl.editItem = editItem;
            $ctrl.deleteItem = deleteItem;
            $ctrl.duplicateItem = duplicateItem;
            $ctrl.cancelEdit = cancelEdit;
            $ctrl.isEdit = isEdit;

            $ctrl.processUpdates = processUpdates;
            $ctrl.onInitAddedItem = onInitAddedItem;
            $ctrl.onInitRemovedItem = onInitRemovedItem;
            $ctrl.onInitArchivedItem = onInitArchivedItem;
            $ctrl.onInitActivatedItem = onInitActivatedItem;

            $ctrl.share = share;
            $ctrl.getNewCreatedItem = getNewCreatedItem;
            $ctrl.onClipboardProcessingForTree = onClipboardProcessingForTree;

            $ctrl.compiledItemEdit = new TemplateCompileService($ctrl.$element);

            $ctrl.onDestroyEdit = onDestroyEdit;

            if(!$ctrl.showBottomButtons){
                $ctrl.showBottomButtons = showBottomButtons;
            }
        }

        $ctrl.treeOptions = {
            accept: acceptSortableTree,
            removed: function (node) {
            },
            dropped: onTreeDropped,
            //beforeDrop: onBeforeTreeDrop
        };

        var ending = '_TREE',
        treeEnding = $ctrl.elemType + ending;

        $ctrl.TreeEvents = {
            Moved: 'MOVE_' + $ctrl.elemType + '_',
            Removed: 'REMOVED_' + treeEnding,
            Archived: 'ARCHIVED_' + treeEnding,
            Activated: 'ACTIVATED_' + treeEnding,
            Duplicate: 'DUPLICATED_' + treeEnding,
            DuplicateFromTop: 'DUPLICATE_FROM_TOP_' + treeEnding,
            Updated: 'UPDATED_' + treeEnding,
            OpenUpdate: 'OPEN_UPDATE_' + treeEnding,
            Added: 'ADDED_' + treeEnding,
            AddFromEmptyState: 'ADD_FROM_EMPTY_STATE_' + treeEnding,
            FolderChanged: 'FOLDER_CHANGED_' + treeEnding,
            NameChangedInTree: 'NAME_CHANGED_' + treeEnding,
            UpdateCounter: 'COUNTER_CHANGED_' + treeEnding,
            ArchivedHidden: 'ARCHIVED_HIDDEN_' + treeEnding,
            NameChanged: 'NAME_CHANGED_' + $ctrl.elemType + '_GROUP', // for recursive trees
        };

        $ctrl.reloadNodeItems = reloadNodeItems;
        $ctrl.bind = bind;

        if(!$ctrl.isPrintLayout) {
            if ($ctrl.canEdit) {
                $ctrl.addRootWatcher('UPDATE_CLIPBOARD_PROCESSING_TREE', $ctrl.onClipboardProcessingForTree);

                if ($ctrl.listTreeService.isRecursiveTree) {
                    $ctrl.addRootWatcher($ctrl.TreeEvents.NameChanged, eventNameChangedInGroup);
                }

                $ctrl.addRootWatcher($ctrl.TreeEvents.AddFromEmptyState, eventAddFromEmptyState);
                $ctrl.addRootWatcher($ctrl.TreeEvents.Added, eventAdded);
                $ctrl.addRootWatcher($ctrl.TreeEvents.Updated, eventUpdated);
                $ctrl.addRootWatcher($ctrl.TreeEvents.Removed, eventRemoved);
                $ctrl.addRootWatcher($ctrl.TreeEvents.Archived, eventArchived);
                $ctrl.addRootWatcher($ctrl.TreeEvents.Activated, eventActivated);
                $ctrl.addRootWatcher($ctrl.TreeEvents.FolderChanged, eventFolderChanged);
                $ctrl.addRootWatcher($ctrl.TreeEvents.DuplicateFromTop, eventDuplicate);

                $ctrl.addRootWatcher($ctrl.TreeEvents.OpenUpdate, editItem);
                $ctrl.addRootWatcher('TREE_SERVICE_RELOAD_LIST_' + $ctrl.elemType, $ctrl.reloadNodeItems);
            }

            $ctrl.addRootWatcher('CHANGED_TOP_DRP_FILTERS' + getPrefix(), onChangedGroupFiltersInit);

            $ctrl.addRootWatcher($ctrl.TreeEvents.UpdateCounter, $ctrl.eventCounterChanged);
            $ctrl.addRootWatcher($ctrl.TreeEvents.ArchivedHidden, onArchivedHidden);
        }

        $ctrl.isSelectedItem = isSelectedItem;

        if ($ctrl.sidebarOptions) {
            $ctrl = _.extend($ctrl, $ctrl.sidebarOptions);
        }

        if (!$ctrl.getParams) {
            console.warn('Parent for ListTreeInitCtrl must define $ctrl.getParams');
        }

        $ctrl.withProperty = withProperty;

        //for edit mode only todo
        if (!$ctrl.changedFields) {
            $ctrl.changedFields = [];

            if ($ctrl.withActiveGroup || $ctrl.withActiveTree) { //dont enable selected filters for trees
                $ctrl.changedFields.push('selectedFilter');
            }
        }

        $ctrl.onTreeItemsMoved = onTreeItemsMoved;
        $ctrl.setListTree = setListTree;

        if(!$ctrl.listTreeService.getSidebarTemplate){
            $ctrl.listTreeService.getSidebarTemplate = getSidebarTemplate;
        }

        if(!$ctrl.listTreeService.onSidebarLoaded){
            $ctrl.listTreeService.onSidebarLoaded = onSidebarLoaded;
        }

        if(!$ctrl.getSidebarHeader){
            $ctrl.getSidebarHeader = getSidebarHeader;
        }

        if(!$ctrl.isMobileView) {
            $ctrl.isMobileView = isMobileView;
        }
        $ctrl.getListItemIcon = getListItemIcon;
        $ctrl.reloadTree = reloadTree;

        if(!$ctrl.getGroupName) {
            $ctrl.getGroupName = getGroupName;
        }

        if(!$ctrl.getGroupIcon) {
            $ctrl.getGroupIcon = getGroupIcon;
        }

        $ctrl.reloadTree();

        return $ctrl;

        function getPrefix(){
            return ($ctrl.isPrintLayout ? '_PRINT_LAYOUT' : '') +
                ($ctrl.isInTreeModal ? '_TREE_MODAL' : '');
        }

        function getNodeById(id){
            return $ctrl.listTreeService.getNodeById(id, $ctrl.treeType);
        }

        function getListItemIcon(item){
            return $ctrl.onGetListItemIcon({item: item});
        }

        function onChangedGroupFiltersInit(result) {
            var type = result.type,
                val = result.val;
            if ($ctrl[type] !== val) {
                console.log('CHANGED_TOP_DRP_FILTERS: SidebarTreeCtrlService.onChangedGroupFiltersInit: type=' + type + ', val: ' + val);
                $ctrl[type] = val;

                if ($ctrl.listTreeService && (type === 'selectedFilter' || type === 'treeType')){
                    onGroupsLoaded();

                    $ctrl.listTreeService.active.selectedList = undefined;
                    $ctrl.listTreeService.active.selectedListId = undefined;
                    reloadItem(null, true);
                }
                // var currentListId = 'All';
                // $ctrl.reloadNodeItems(currentListId);
            }
        }

        function onCurrentTreeListChanged(selectedList) {
            var id = $ctrl.listTreeService.getSelectedIdFromItem(selectedList);
            console.log('CURRENT_TREE_LIST_CHANGED ' + $ctrl.elemType +': ' + id);
            $ctrl.listTreeService.transitionList = getNodeById(id, $ctrl.treeType);
            if($ctrl.onCurrentTreeListChangedOther){
                $ctrl.onCurrentTreeListChangedOther(selectedList);
            }
            $ctrl.reloadTreeGroups();
        }

        function getListParams(){
            return {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId || null
            };
        }

        function reloadTreeGroupsParams() {
           return _.extend({
                elemType: $ctrl.elemType,
                service: $ctrl.service,

                populate: $ctrl.listParams.populate,
                includeFields: $ctrl.listParams.includeFields
           }, getListParams());
        }
        function reloadTreeGroups() {
            console.log('reloadTreeGroups');
            $ctrl.listTreeService.reloadGroups(reloadTreeGroupsParams(), $ctrl.getParams(), {$ctrl: $ctrl});
        }

        function onArchivedHidden(){
            var list = $ctrl.listTreeService.active ? $ctrl.listTreeService.active.selectedList : null;//got
            if(list && (list.withArchiveGroupAsList ||
                //on notes PAGE:
                ((!list.nodes || !list.nodes.length) && $ctrl.listTreeService.goToOtherNodeIfEmpty))){
                $ctrl.goToList(getNodeById('All'));
            }
        }

        function setListTree(id, list) {
            console.log('setListTree: ' + id);
            $ctrl.listTreeService.setList(id, list ? list : [], $ctrl.elemType, getListParams());

        }

        function reloadTree() {
            console.log('reloadTree ' + $ctrl.elemType);
            $ctrl.listTreeService.loadTreeGroups({
                treeType: $ctrl.treeType,
                getTreeParams: getTreeParams
            }, onGroupsLoaded, $ctrl.CPS.isCollaborator);

            function getTreeParams(treeType) {
                var p = _.extend({
                    treeType: treeType,
                    selectedFilter: $ctrl.selectedFilter,

                    withTreeDisplayCount: $ctrl.withTreeDisplayCount,
                    withActiveTree: $ctrl.withActiveTree === true,
                    withActiveGroup: $ctrl.withActiveGroup === true,
                    withArchiveGroupInLists: $ctrl.withArchiveGroupInLists === true,
                    withArchiveGroupAsList: $ctrl.withArchiveGroupAsList === true,

                    getTreeFilters: $ctrl.getTreeFilters,
                }, reloadTreeGroupsParams(), {
                    params: $ctrl.getParams()
                });

                p.withActiveTreeOrGroup = $ctrl.withActiveTree ||
                                                //breakdowns        scheduling
                    $ctrl.withActiveGroup && ($ctrl.withNull || $ctrl.withArchiveGroupInLists);

                if ($ctrl.isPrintLayout === true) {
                    p.isPrintLayout = true;
                    if ($ctrl.printedLists) {
                        p.printedLists = $ctrl.printedLists;
                    }
                    if ($ctrl.printedItems) {
                        p.printedItems = $ctrl.printedItems;
                    }
                }

                return p;
            }
        }

        function onGroupsLoaded() {
            console.log('SidebarTreeCtrlService.onGroupsLoaded ' + $ctrl.elemType);
            if(!$ctrl.isCommentsSidebar && !$ctrl.isNotFirstTime) {
                $ctrl.isNotFirstTime = true;
                $ctrl.CurrentTreeListService.addOnTreeListChanged($ctrl.watchers, getTreeChangedParams(), $ctrl.elemType, $ctrl.onCurrentTreeListChanged);
            }

            treeTypeChanged();

            if ($ctrl.hideSidebar) {
                return;
            }

            if (!$ctrl.sidebarCompile) {
                $ctrl.sidebarCompile = new TemplateCompileService($ctrl.$element);

                $ctrl.sidebarCompile.getItemTemplate = function () {
                    return $ctrl.listTreeService.getSidebarTemplate($ctrl.isInTreeModal, $ctrl.canEdit);
                }
            }

            $ctrl.sidebarCompile.loadTemplate(function(){
                bind(true);
                $ctrl.listTreeService.onSidebarLoaded();
            }, $ctrl);

            function treeTypeChanged(){
                console.log('SidebarTreeCtrlService.treeTypeChanged ' + $ctrl.elemType);

                $ctrl.tree = $ctrl.listTreeService.getTree($ctrl.treeType, $ctrl.selectedFilter);

                var listWithDifFilter = $ctrl.previousSelectedListId !== $ctrl.listTreeService.active.selectedListId ||
                    $ctrl.prevSelectedFilter !== $ctrl.selectedFilter;
                if ($ctrl.listTreeService.active && $ctrl.listTreeService.active.selectedList &&
                    listWithDifFilter) {
                    //selected filter changed
                    if($ctrl.prevSelectedFilter !== undefined && listWithDifFilter){
                        $ctrl.listTreeService.active.selectedList = getNodeById($ctrl.listTreeService.active.selectedListId);
                        $ctrl.listTreeService.active.selectedListId = $ctrl.listTreeService.active.selectedList ? $ctrl.listTreeService.active.selectedList._id : undefined;
                    }

                    console.log('onTreeActiveChanged');

                    var list = $ctrl.listTreeService.active.selectedList;
                    $ctrl.breadcrumbs = $ctrl.listTreeService.getBreadcrumbs(list);

                    if ($ctrl.isSidebar) {
                        var val = $ctrl.previousSelectedListId !== undefined ? $ctrl.previousSelectedListId : ($ctrl.listTreeService.active.selectedListId ? $ctrl.listTreeService.active.selectedListId : undefined);
                        if (val !== undefined) {
                            $ctrl.LCS.removeClass($ctrl.element.querySelectorAll('.inline-tree-item[data-id="' + val + '"]'), 'active');
                        }
                    }

                    $ctrl.previousSelectedListId = $ctrl.listTreeService.active.selectedListId;
                    $ctrl.prevSelectedFilter = $ctrl.selectedFilter;

                    if($ctrl.listTreeService && !$ctrl.listTreeService.inTransition) {
                        broadcastTreeListChanged('SidebarTreeCtrlService.treeTypeChanged');
                    }
                }
            }
        }

        function broadcastTreeListChanged(from) {
            var list = $ctrl.listTreeService.active.selectedList;
            $ctrl.CurrentTreeListService.broadcastTreeListChanged(getTreeChangedParams(), $ctrl.elemType, list, from);

            function getTreeChangedParams() {
                return {
                    isCommentsSidebar: $ctrl.isCommentsSidebar,
                    isPrintLayout: $ctrl.isPrintLayout,
                    isInTreeModal: $ctrl.isInTreeModal
                }
            }
        }

        function withProperty() {
            var params = _.extend({}, $ctrl.getParams());

            if ($ctrl.CPS.isCollaborator) {
                var parentId = $ctrl.getParentId();
                if (parentId) {
                    params.parentId = parentId;
                    $ctrl.hideAddNewGroupForCollabs = parentId;
                }
            }

            return params;
        }

        function onSidebarLoaded() {
            console.log('onSidebarLoaded');
        }

        function getSidebarButtons() {
            if(!$ctrl.canEdit){return '';}
            var group = $ctrl.nameForGroup,
                clsL = 'pull-left with-margin-right';
            if($ctrl.listTreeService.isRecursiveTree || $ctrl.listTreeService.maxLevel === 1){
                var isFolder = $ctrl.listTreeService.isRecursiveTree,
                    name = 'Add ' + (isFolder ? group : $ctrl.nameForList),
                    padding = $ctrl.paddingLeftCls ? $ctrl.paddingLeftCls : 'padding-left-12';
                return '<a ng-show="$ctrl.showBottomButtons()" id="btnNewList1" class="small" ' + addItemClick(isFolder, 'false') + ' analytics-on analytics-action="' + name + '">' +
                    $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left') + '<div class="' + padding + ' gray inline-block">' + name + '</div></a>';
          }else {//shotlists library
                var cls = 'btn btn-small full-width primary-faded';
            return '<div class="bottom-buttons spacing-top-double" ng-show="$ctrl.showBottomButtons()">' +
                        '<div class="dropdown position-relative" dropdown ng-show="$ctrl.treeType===6">' +
                                '<button id="btnNewList" type="button" class="'+cls+' dropdown-toggle long full-width" dropdown-toggle aria-haspopup="true" aria-expanded="true">' +
                                      $ctrl.LCS.getISBDiv('plus', null, clsL) + 'New ' + $ctrl.nameForList + ' ' +
                                      $ctrl.LCS.getISBDiv('arrow-filled-down', null, 'pull-right') +
                                '</button>' +
                                '<ul class="dropdown-menu side-menu fadeInUp tree-side-menu" role="menu" >' +
(typeof($ctrl.sidebarOptions.sidebarButtonsOther) ==='function' ? $ctrl.sidebarOptions.sidebarButtonsOther() : getBtns()) +
                                '</ul>' +
                          '</div>'+
                ($ctrl.hideAddNewGroup ?'' :('<button ng-show="$ctrl.treeType===5" id="btnNewList1" type="button" class="' + cls + '" ' + addItemClick('true', 'false') + '>' +
                        $ctrl.LCS.getISBDiv('plus', null, clsL) + 'New ' + group +
                        '</button>')) +
                    '</div>';
            }
            function getBtns() {
                return '<li ng-if="$ctrl.listTreeService.active.selectedListId !== null">' +
                    '<a ' + addItemClick('false', 'isFromList') + ' analytics-action="New ' + $ctrl.nameForList+'">' +
                    $ctrl.LCS.getISBDiv($ctrl.itemIcon,null,clsL)+ ' New '+$ctrl.nameForList+'</a></li>' +
                    ($ctrl.hideAddNewGroup ? '':('<li '+($ctrl.CPS.isCollaborator?'ng-if="::$ctrl.hideAddNewGroupForCollabs !== item._id"':'')+'><a '+addItemClick('true', 'false')+' analytics-action="New '+ $ctrl.nameForGroup+'">' +
                        $ctrl.LCS.getISBDiv($ctrl.iconForGroup , null, clsL) + ' New '+$ctrl.nameForGroup+'</a></li>'));
            }
        }

        function addBottomItem(info, e){
            var str = info.split('|'),
                addFolder = str[0] === 'true' || str[0] === true,
                isParent = str[1] === 'true' || str[1] === true;
            if(isParent === 'isFromList'){
                isParent = $ctrl.listTreeService.active.selectedList && $ctrl.listTreeService.active.selectedList.isFolder ? true : false;
            }
            $ctrl.addItem($ctrl.treeType, {item: {type: $ctrl.treeType}, addFolder: addFolder, isParent: isParent, useSelected: true, addFromBottom: true, e: e});
        }

        function addItemClick(addFolder, isParent){
            return ' ng-click="$ctrl.addBottomItem(\'' + addFolder + '|'+ isParent + '\',$event)" data-type="addBottomItem" analytics-on';
            //'"$ctrl.addItem($ctrl.treeType, {item: {type: $ctrl.treeType}, addFolder: ' + addFolder + ', isParent: ' + isParent + ', useSelected: true, addFromBottom: true})" ';
        }


        function getSidebarHeader(isInTreeModal) {
            //return !isInTreeModal &&
            return $ctrl.listTreeService.sidebarTitle ? ('<h3 class="text-left spacing-half-top sidebarTitle">' + $ctrl.listTreeService.sidebarTitle + '</h3>') : '';
        }

        function hasHandle(isInTreeModal) {
            return !isInTreeModal && $ctrl.canEdit && !$ctrl.listTreeService.noTreeDrag && $ctrl.isSidebar && !$ctrl.isMobileView() && !$ctrl.LCS.isTouchScreen;
        }

        function getSidebarTemplate(isInTreeModal, canEdit) {
            var sh = $ctrl.getSidebarHeader(isInTreeModal),
                ispredef1 = '', ispredef = '', hasOther = !isInTreeModal;
            if(isInTreeModal) {
                ispredef1 = '+((item.isPredef&&item._id!==null||item.withArchiveGroupAsList)? \' sb-hide\' : \'\')';
                hasOther = _.filter($ctrl.listTreeService.getTree($ctrl.treeType, ($ctrl.withActiveTree || $ctrl.withActiveGroup) ? $ctrl.selectedFilter : undefined)[0].nodes, function (el) {
                    return el._id !== 'All' && el._id !== 'Archived';
                }).length > 0;
                if (hasOther) {
                    ispredef = ispredef1;
                }
            }
return '<div class="outtercontainer show-scrollbar-on-hover">' +
        '<div class="innercontainer fancy-scrollbar sb-scrolling-monitor ultrathin medium-template strips" sb-scrolling-monitor-id="tree">' +
            '<div class="sidebarScrollingContainer">' +
        //(isInTreeModal ? '' :
             ('<div class="sidebar-toggle no-padding"><a class="btnInnerSidebarToggle btn btn-small transparent noborder smaller inline-block ' +
             //$ctrl.getBtnActionCls() + '" data-type="toggleInnerSidebar' +
             '" tooltip="Close Sidebar" tooltip-placement="bottom">' + $ctrl.LCS.getISBDiv('angle-double-left', 2,'centered gray') + '</a></div>')
        //)
            +
                sh +
                '<div class="display-block' +
        ((isInTreeModal && (!$ctrl.listTreeService.sidebarTitle && !sh) || !isInTreeModal && !sh) ? ' spacing-top-60' : '')+'">' +
                    '<div class="list-tree" data-sb-tree="$ctrl.treeOptions" data-max-depth="'+$ctrl.listTreeService.maxLevel+'" ' +
        'data-scroll-container=".h-full side-table .side-nav.static .outtercontainer > .innercontainer > div" '+
        ($ctrl.withTreeTypes ? 'ng-attr-data-tree-type="{{$ctrl.treeType}}"' : 'data-tree-type="{{::$ctrl.treeType}}"') +' ' +
        (($ctrl.listTreeService.noTreeDrag || isInTreeModal || !canEdit) ? 'data-tree-nodrag="true"':'ng-attr-data-tree-nodrag="{{$ctrl.listTreeService.noTreeDrag}}"') + '>' +
                        getOl('$ctrl.tree', false) +
                    '</div>' +
                '</div>'+
                $ctrl.sidebarButtons +
            '</div>' +
        '</div>' +
    '</div>' +

    '<script type="text/ng-template" id="nodes_renderer.html">' + 
        '<div class="tree-node tree-node-content" ' + (hasHandle(isInTreeModal) ? ' sb-tree-handle' : '') + '>' +
            $ctrl.getTreeItemGrid(isInTreeModal,
                ($ctrl.withTreeDisplayCount ? 'with-tree-display-count="true" ' : '') +
                'start-indent="::$ctrl.listTreeService.startIndent" '
            ) +
        '</div>' +
        getOl('item.nodes', true) +
    '</script>';
        function getOl(type, isChild){
        return '<ol sb-tree-nodes ng-model="' + type + '" ng-if="' + type + '" ' + (isChild ? ' class="ui-children"' : '') +
                'ng-class="(!item.parentId&&!item.isFolder?\'without-padding\':\'\')+(collapsed?\' hidden\':\'\')' + ispredef + '">' +
                    '<li ng-treenodeid="{{::item._id}}" sb-tree-node ng-if="::item" ng-repeat="item in ' + type + ' track by item._id" ng-include="::\'nodes_renderer.html\'"  class="with-hover"' +
            ($ctrl.listTreeService.hideNonPredef ? ' data-hide="{{::$ctrl.hideExtraItemsCond(item, true)}}"' : (' ng-class="'+ (hasOther ? '{\'sb-hide\':item.isPredef === true && item._id!==\'Archived\'}' : ispredef1)  +'"')) +
            '></li>' +
                '</ol>';
            }
        }
        function hideExtraItemsCond(item, hideNonPredef) {
            return item ? (hideNonPredef ? (item.productId !== $ctrl.CPS.productId && item.isPredef !== true) : (item.isPredef === true && item._id!=='Archived')) : true;
           // if(!$ctrl.CPS.isAuthenticated && !hide && item._id ==='Archived'){return true;}
           // return hide;
        }

        function showBottomButtons() {
            return $ctrl.listTreeService.showBottomButtons($ctrl.isActiveFilter());
        }

        function getTreeItemGrid(isInTreeModal, other) {
            return $ctrl.listTreeService.getTreeItemGridInit({
                treeType: $ctrl.treeType,
                treeItemTag: $ctrl.treeItemTag,
                isSidebar: $ctrl.isSidebar,
                elemType: $ctrl.elemType,
                itemIcon: $ctrl.itemIcon,
                iconForGroup: $ctrl.iconForGroup,
                canEdit: $ctrl.canEdit && !isInTreeModal,
                isInTreeModal: isInTreeModal,
            }, other ? other : null);
        }

        function duplicate(item, dataParam, e){
            $ctrl.CPS.loadQuotaPopup($ctrl.quotaTypeList ? $ctrl.quotaTypeList : $ctrl.quotaType, function (){
                $ctrl.duplicateItem(item, dataParam);
            }, null, null, $ctrl.compOptions, {e: e});
        }

        function onMorePopoverUpdate(result) {
            console.log('onMorePopoverUpdate');
            if (!result) {
                return;
            }
            var e = result.e,
                item = result.item,
                target = e.currentTarget,
                dataType = target.getAttribute('data-type'),
            dataParam = target.getAttribute('data-param');
            console.log('SidebarTreeCtrlService.onMorePopoverUpdate: ' + dataType);
            switch (dataType) {
                case 'add-list-inside':
                    return $ctrl.addItem($ctrl.treeType, {item: item, addFolder: false, isParent: true, useSelected: false, e:e});

                case 'add-list-under':
                    return $ctrl.addItem($ctrl.treeType, {item: item, addFolder: false, isParent: false, useSelected: false, e:e} );

                case 'add-group-inside':
                    return $ctrl.addItem($ctrl.treeType, {item: item, addFolder: true, isParent: true, useSelected: false, e:e});

                case 'add-group-under':
                    return $ctrl.addItem($ctrl.treeType, {item: item, addFolder: true, isParent: false, useSelected: false, e:e});

                case 'edit':
                    return $ctrl.editItem(item);

                case 'duplicate':
                    return duplicate(item, dataParam, e);

                case 'remove':
                    function process() {
                        return $ctrl.deleteItem($ctrl.treeType, item, {
                            otherParams: $ctrl.getParams(),
                            action: 'Remove',
                            ungroup: item.isFolder && $ctrl.listTreeService.ungroupGroupOnTreeDelete || $ctrl.listTreeService.ungroupOnTreeDelete
                        });
                    }
                    return typeof($ctrl.checkQuotaOnDelete) === 'function' ? $ctrl.checkQuotaOnDelete(process) : process();

                case 'archive':
                    return $ctrl.deleteItem($ctrl.treeType, item, {action: 'Archive'});

                case 'activate':
                    return $ctrl.deleteItem($ctrl.treeType, item, {action: 'Activate'});

                case 'share':
                    return $ctrl.share(item, e);

                default:
                    if($ctrl.sidebarOptions && typeof($ctrl.sidebarOptions[dataType]) === 'function') {
                        return $ctrl.sidebarOptions[dataType](item);
                    } else if(typeof($ctrl[dataType]) === 'function') {
                        return $ctrl[dataType](item);
                    }
            }

            if(typeof($ctrl.onMorePopoverUpdateOther) === 'function') {
                $ctrl.onMorePopoverUpdateOther(result);
            }
        }

        function getMorePopoverTemplate(item, isMobile) {
            return $ctrl.getPopoverTemplate({item: item, isMobile: isMobile});
        }

        function eventAddFromEmptyState(result) {
            console.log($ctrl.TreeEvents.AddFromEmptyState);
            if (result) {
                if(!result.treeType){
                    result.treeType = $ctrl.listTreeService.defaultType;
                }
                $ctrl.addItem(result.treeType, result.data);
            }
        }

        function eventAdded(result) {
            console.log($ctrl.TreeEvents.Added);
            if(!result.treeType){
                result.treeType = $ctrl.listTreeService.defaultType;
            }
            $ctrl.onInitAddedItem(result);
        }

        function eventUpdated(result){
            if(!result || result.noUpdates){return;}
            console.log($ctrl.TreeEvents.Updated);
            if(!result.treeType){
                result.treeType = $ctrl.listTreeService.defaultType;
            }
            onUpdate(result.item);
        }

        function eventDuplicate(result){
            if(result) {
                duplicate(result.item, result.dataParam);
            }
        }

        function onInitAddedItem(result) {
            return $ctrl.listTreeService.onInitAddedItem(result, function(item){
                if(!isNotInline() && !result.noEditMode){
                    onEditTimeout(item, 101);
                }

                if(typeof($ctrl.onTreeItemAdded) === 'function'){
                    $ctrl.onTreeItemAdded(result);
                }
            }, result.isDuplicate);
        }

        function isNotInline() {
            $ctrl.treeAddNotInline = true;
            //there is an error with drag after editing a newly added list if new item added inline
            if($ctrl.treeAddNotInline || $ctrl.isMobileView()){
                return true;
            }
           return typeof($ctrl.isNotInline) === 'function' ? $ctrl.isNotInline() : true;
        }
        
        function eventFolderChanged(item) {
            console.log($ctrl.TreeEvents.FolderChanged);
            $ctrl.reloadForList(item);
        }

        function eventRemoved(result) {
            console.log($ctrl.TreeEvents.Removed);
            return $ctrl.onInitRemovedItem(result) ;
        }

        function onInitRemovedItem(result) {
            return $ctrl.listTreeService.onInitRemovedItem(result);
        }

        function eventArchived(result) {
            console.log($ctrl.TreeEvents.Archived);
            return $ctrl.onInitArchivedItem(result) ;
        }

        function onInitArchivedItem(result) {
            return $ctrl.listTreeService.onInitArchivedItem(result);
        }

        function eventActivated(result) {
            console.log($ctrl.TreeEvents.Activated);
            return $ctrl.onInitActivatedItem(result) ;
        }

        function onInitActivatedItem(result) {
            return $ctrl.listTreeService.onInitActivatedItem(result);
        }

        function eventNameChangedInGroup(item) {
            console.log($ctrl.TreeEvents.NameChanged);
            if(!item || !item.isFolder){return ;}
            console.log('sidebar eventNameChangedInGroup');
            $ctrl.listTreeService.onInitUpdateName(item);
        }

        function eventCounterChanged(result) {
            console.log('eventCounterChanged: elemType='+$ctrl.elemType+'; isCommentsSidebar = ' + $ctrl.isCommentsSidebar);
            var ids = result && result.ids ? result.ids : [];
            _.each(ids, function (id) {
                var node = $ctrl.listTreeService.computeNodeCount(id, $ctrl.treeType),
                prop = $ctrl.withTreeDisplayCount ? 'displayCount' : 'count';
                if (node) {
                    if (node.withArchiveGroupAsList) {
                        var m = $ctrl.LCS[node[prop] === 0 ? 'addClass' : 'removeClass'],
                            el = $ctrl.element.querySelector('.tree-item-grid[data-id="' + node._id + '"]'),
                            el1 = $ctrl.LCS.findClosestParent(el, '.angular-ui-tree-node'),
                            el2 = $ctrl.LCS.findClosestParent(el, 'li[ng-treenodeid="Archived"]');
                        m(el, 'sb-hide');
                        m(el1, 'sb-hide');
                        m(el2, 'sb-hide');

                        if (node[prop] === 0) {
                            onArchivedHidden();
                        }
                    }
                }
            });
        }

        function isSelectedItem(item) {
            return $ctrl.listTreeService.active.selectedListId === $ctrl.listTreeService.getSelectedIdFromItem(item);
        }

        function onDestroyEdit() {
            if ($ctrl.compiledItemEdit) {
                $ctrl.compiledItemEdit.destroyNewScope();
            }
        }

        function bind(isBind){
            if(isBind){
                p(false);
            }
            p(isBind);

            function p(isBind) {
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('.btnInnerSidebarToggle'), $ctrl.toggleInnerSidebar);
            }
        }

       function toggleInnerSidebar(e){
            var close = 'CLOSE_SIDEBAR_'+$ctrl.getSidebarName();
           console.log(close);
           if(e){
               e.preventDefault(e);
               e.stopPropagation(e);
           }
           $ctrl.broadcastRoot(close);
       }

        function getSidebarName(){
            return $ctrl.SBStateService.currentState.name + ($ctrl.isCommentsSidebar ? '_COMMENTS' : '') + ($ctrl.isInTreeModal ? ('_' + $ctrl.isInTreeModal) : '')  + ($ctrl.getSidebarNameOther ? ('_' + $ctrl.getSidebarNameOther()) : '');
        }

        function hasInnerSidebar() {
           return $ctrl.LCS.hasInnerSidebar($ctrl.getSidebarName());
        }

        function onListTreeInitDestroy() {
            bind(false);
            $ctrl.removeWatchers();

            $ctrl.onListPopoverDestroy();

            if($ctrl.onDestroyEdit){
                $ctrl.onDestroyEdit();
            }

            if ($ctrl.sidebarCompile) {
                $ctrl.sidebarCompile.destroyNewScope();
            }
        }
        
        function reloadNodeItems(id) {
            console.log('reloadNodeItems: ' + id);
            $ctrl.eventCounterChanged({ids: [id]});
            var node = getNodeById(id);
            $ctrl.setListTree($ctrl.listTreeService.getSelectedIdFromItem(node), $ctrl.listTreeService.onInitLists(node));
        }

        function getParentId() {
            return $ctrl.CPS.stateParams.parentId;
        }

        function share(list, e) {
            console.log('share list from tree');
            if(list) {
                $ctrl.RouteCollaboratorsService.share($ctrl.listTreeService.getSelectedIdFromItem(list), {
                    type: list.isFolder ? $ctrl.nameForGroup:$ctrl.nameForList,
                    name: list.name
                }, $ctrl.compOptions, null, e);
            }
        }

        function onClipboardProcessingForTree(result) {
            console.log('onClipboardProcessingForTree');
            if (!result) {
                return;
            }
            $ctrl.listTreeService.onClipboardProcessingForTree(result);
        }

        function getEl(editedId) {
            return $ctrl.element.querySelector('.inline-tree-item[data-id="' + editedId + '"]');
        }

        function processFieldEditMode(editedId, withRemove) {
            if (editedId === undefined) {
                return;
            }
            if (withRemove) {
                $ctrl.onDestroyEdit();
            }
            var method = withRemove ? $ctrl.LCS.removeClass : $ctrl.LCS.addClass,
                el = getEl(editedId);
            if(el){
                method(el.querySelector('.list-item-name'), 'sb-hide');
                method(el.querySelector('.counter-col'), 'sb-hide');
                method(el.querySelector('.btn-col'), 'sb-hide');
                method(el.querySelector('.list-edit-item'), 'sb-hide');
            }

            $ctrl.editedId = withRemove ? undefined : editedId;
            //todo
            //data-nodrag="$ctrl.isEdit(item)" class="list-edit-item
        }

        function editItem(item) {// when called from the sidebar dropdown  menu or when editing
            processOpenItem(item, false, false);
            /*if (isNotInline()) {
                processOpenItem(item, false);
              }else{
                editItemInline(item);
              }*/
        }

        function editItemInline(item) {// when called from the sidebar dropdown  menu or when editing
            cancelPrevItemEdit();
            if (!item) {
                return;
            }
            var editedId = item ? $ctrl.listTreeService.getSelectedIdFromItem(item) : undefined,
                el = getEl(editedId);
            //remove the object from previous editable item place
            $ctrl.compiledItemEdit.getItemTemplate = function () {
                var tag = $ctrl.treeItemTag + '-item-edit';
                return '<' + tag + ' is-semibold="::' + ($ctrl.isSemibold===true) + '" ' +
                    'with-font-small="::' + ($ctrl.isSmallFont===true) + '" ' +
                    'item="::$ctrl.item" ' +
                    'service="::$ctrl.service" ' +

                    'elem-type="' + $ctrl.elemType + '" ' +
                    //font-size="::'+(item.isFolder?'15px':'13px')+'
                    //paddingRight

                    'cancel-edit="$ctrl.cancelEdit()" ' +
                    'on-update="$ctrl.onUpdate(item)"' +
                    '></' + tag + '>';
            };

            $ctrl.compiledItemEdit.loadTemplate(function (clonedElement){
                //remove the object from previous editable item place
                processFieldEditMode(editedId);
            }, {
                item: angular.copy(item),
                service: $ctrl.listTreeService.listsService,
                cancelEdit: cancelPrevItemEdit,
                onUpdate: onUpdate
            }, angular.element(el));
        }

        function processOpenItem(item, isAdd, isDuplicate, onSuccess){
            var op = isAdd ?
                    ($ctrl.addGroupPopupName ? ($ctrl.customBGForList ? (item.isFolder ?'createItem' : $ctrl.addGroupPopupName) : $ctrl.addGroupPopupName) : 'createItem') :
                    ($ctrl.editGroupPopupName ? ($ctrl.customBGForList ? (item.isFolder ? 'updateItem' : $ctrl.editGroupPopupName) : $ctrl.editGroupPopupName) : 'updateItem'),
                params = typeof ($ctrl.getNewTreePopupExtraParam) === 'function' ? $ctrl.getNewTreePopupExtraParam() : {};

            $ctrl.popupsService.open(item, $ctrl.popupsService.operations[op], _.extend(params,
                {
                    service: $ctrl.listsService,
                    isDuplicate: isAdd && isDuplicate,
                    isTreeAdd: true,
                    treeType: $ctrl.treeType,
                    itemTitle: item.isFolder ? $ctrl.getGroupName(item) : $ctrl.nameForList,
                    itemIcon: item.isFolder ? $ctrl.getGroupIcon(item) : ($ctrl.listIcon ? $ctrl.listIcon : $ctrl.itemIcon),
                    iconLevel: item.isFolder ? $ctrl.iconLevel : ($ctrl.listIconLevel ? $ctrl.listIconLevel : $ctrl.iconLevel),
                    onSuccess: onSuccess
                },
                $ctrl.listTreeService.withTreeEditPopupColumns ? getEditPopupColumns(isAdd, item): null
            ), $ctrl.compOptions);
        }

        function getEditPopupColumns(isAdd, item) {
            console.log('treeList . getEditPopupColumns');
            var columnImg = null,
                columns = [],
                sortedForPopup = true;

            _.each(_.filter(_.sortBy( $ctrl.listTreeService.filtersService.ColumnsList,  function (c) {
                return sortedForPopup && c.orderModal ? c.orderModal : c.order;
            }), function (c) {
                return !c.notInModal && !c.isHeader;
            }), processColumn);

            return {columnsList: columns, columnImg: columnImg};

            function processColumn(c1) {
                if (c1) {
                    var isImg = c1.type === $ctrl.SBFieldTypesService.PropTypes.Picture;
                    if (isImg) {
                        if (!isAdd && ($ctrl.isMobileSize || !$ctrl.isMobileSize && !c1.hideDesktopModal)) {
                            columnImg = _.extend({}, c1, {imgSize: c1.isAvatarAttr ? 'intermedium' : $ctrl.getImgSizeInit()},
                                typeof ($ctrl.getPicturePopupOtherProps) === 'function' ? $ctrl.getPicturePopupOtherProps(item) : null);
                        }
                    } else {
                        if (!(typeof ($ctrl.getEditPopupColumnsCond) === 'function' && !$ctrl.getEditPopupColumnsCond(c1, item))) {
                            columns.push(_.extend({}, c1));
                        }
                    }
                }
            }
        }
        function getImgSizeInit(){
            return 'storyboard1';
        }

        function cancelPrevItemEdit() {
            if($ctrl.editedId){
                console.log('sidebar cancelItemEdit ');
                processFieldEditMode($ctrl.editedId, true);
            }
        }

        function isEdit(item) {
            return !!(item && $ctrl.editedId === $ctrl.listTreeService.getSelectedIdFromItem(item));
        }

        function cancelEdit() {
            $ctrl.editItem(null);
        }

        function onEditTimeout(item, ms) {
            $ctrl.LCS.timeout(function () {
                console.log('onEditTimeout ' + getSBTimestamp());
                $ctrl.editItem(item);
            }, ms ? ms : 100);
        }

        function onUpdate(item) {
            console.log('sidebar onUpdate');
            $ctrl.listTreeService.onInitUpdateName(item);
            $ctrl.broadcastRoot($ctrl.TreeEvents.NameChangedInTree, item);//update in group
            //i18nNotifications.pushForCurrentRoute (null, 'crud.shotsLists.Edit.success', 'success', item.name );
            //call it from inside the editable item on blur or enter
            cancelPrevItemEdit();
            if($ctrl.onUpdateOther){
                $ctrl.onUpdateOther(item);
            }
        }

        function toggleTree(scope) {
            scope.toggle();
        }

        function getListsCount(){
            if(!$ctrl.listTreeService) {
                return $ctrl.getItemById(null).count;
            }
            switch($ctrl.listTreeService.maxLevel) {
                case 1: return $ctrl.listTreeService && $ctrl.listTreeService.getFirstLeveActiveArchiveCount(null);

                case 2:
                //recursive
                case 3:
                case 4:
                case 5:
                case 6:
                case 7:
                    var n = $ctrl.getItemById(null);
                    return n && n.nodes && n.nodes.length ? n.nodes.length : 0;
            }
        }

        function addItem(treeType, data) {// item, addFolder, isParent, useSelected, preserveName
            if(!$ctrl.cantDuplicateTreeOnFree){return process();} //av script list / taskboards

            var isFolder = data.addFolder,
                maxAddedcount = 1,
                maxFree = isFolder ? 0 : $ctrl.maxFreeListsCount,
                quotaType = isFolder ? $ctrl.quotaTypeGroups : ($ctrl.quotaTypeList !== undefined ? $ctrl.quotaTypeList : $ctrl.quotaType);
            $ctrl.CPS.loadQuotaPopup(quotaType, process, maxFree,
                (maxFree === 0 ? 0 : (getListsCount()) + maxAddedcount),
                $ctrl.compOptions, {e: data ? data.e : null});

            function process() {
                console.log('tree.addItem');
                var newItem = $ctrl.getItemForAdd($ctrl.getNewCreatedItem(data), null, true);

                if (isNotInline() && !data.addInline) {
                    processOpenItem(newItem, true, false);
                } else {
                    $ctrl.listsService.insert(newItem, function (result) {
                        result.treeType = treeType;
                        $ctrl.onInitAddedItem(result);
                    });
                }
            }
        }

        function getItemForDuplicate(item, param){
            return angular.copy(item);
        }
        function getItemForAdd(item, param){
            return item;
        }

        function duplicateItem(item, param) {
            var newItem = $ctrl.getItemForDuplicate(item, param);
            newItem.afterId = item._id;

            delete newItem._id;

            if($ctrl.treeDuplicateNotInline){
                processOpenItem(newItem, true, true, onsuccess);
            } else {
                $ctrl.listsService.duplicate(newItem, onsuccess);
            }
            function onsuccess(result) {
                return onInitDuplicatedItem(newItem.type, result);
            }
        }

        function deleteItem(treeType, item, extra) {
            var name = item.isFolder ? $ctrl.getGroupName() : $ctrl.nameForList;
                // icon = item.isFolder ? $ctrl.getIconForGroup() : $ctrl.nameForList,
            item = $ctrl.listsService.convertResource(item);
            $ctrl.popupsService.open(item, $ctrl.popupsService.operations[$ctrl.removeTreeItemPopup ? $ctrl.removeTreeItemPopup : 'treeItemRemove'], _.extend({}, {
                service: $ctrl.listsService,
                additionalMessage: extra.ungroup ? $ctrl.ungroupAdditionalMessage : $ctrl.removeAdditionalMessage,
                treeType: treeType,
                nameForGroup: name,
                //iconForGroup: icon,

                nameForArchived: $ctrl.nameForArchived ? ($ctrl.nameForArchived === 'Omit' ? 'Omitted' : ($ctrl.nameForArchived + 'd')) : 'Archived'
            }, extra), $ctrl.compOptions);
        }

        function onInitDuplicatedItem(type, result) {
            if (!result.treeType) {
                result.treeType = type ? type : $ctrl.listTreeService.defaultType; //duplicate get added to custom lists
            }
            if ($ctrl.listTreeService.onTreeDuplicated) {
                $ctrl.listTreeService.onTreeDuplicated(result);
            }
            result.isDuplicate = true;
            $ctrl.onInitAddedItem(result);
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + ($ctrl.nameForList ? $ctrl.nameForList.toLowerCase().replace(/ /,'') : $ctrl.objectType) + '.Duplicate.success');
        }

        function onTreeDropped(e) {
            console.log('onTreeDropped');
            var prop = '_id',
                src = e.source.nodeScope.$modelValue,
                srcParentId = src.parentId,
                srcList = e.source.nodesScope.$modelValue,
                destList = e.dest.nodesScope,
                destParent = destList ? destList.$parent.item : null,
                destParentId = destParent ? $ctrl.listTreeService.getSelectedFieldFromItem(destParent) : null;

            var u = {}, ids = [srcParentId], updates = {};

            var listLength = processcurrent(srcList);

            if (srcParentId !== destParentId) {
                processcurrent(destList.$modelValue);

                var it = {};
                it[prop] = src[prop];
                it.parentId = destParentId;
                setProp('parentId', destParentId);
                setProp('l', destParent.l + 1);
                setProp('indent', destParent.indent + 1);
                ids.push(destParentId);
                u.item = it;
            }
            u.listIds = {};
            u.listIds.parentId = ids;
            u.updates = updates;
            changeOrderServerSide(u, !listLength && srcParentId ? srcParentId : null, onprocessed);

            function setProp(prop, val) {
                e.source.nodeScope.$modelValue[prop] = val;
            }

            function processcurrent(list) {
                var n = list && list.length ? list.length : 0;
                _.each(list, function (el, i) {
                    var id = el[prop];
                    if (id && el.order !== i) {
                        updates[id] = i;
                    }
                });
                return n;
            }

            function onprocessed() {
                reloadItem(e.source.nodeScope.$modelValue);
            }
        }
        function getListIdsForTreeItemsMoved(ids){

            var listIds = {};
            listIds.parentId = ids;
            return listIds;
        }
        function onTreeItemsMoved(items, currentListId) {
            var changed, u = {},
                ids = [currentListId],
                updates = {},
                prop = '_id';

            for (var i = 0, n = items.length; i < n; i++) {
                var el = items[i],
                    val = i,
                    elList = getNodeById(getAttribute(el, 'data-id'));
                if (elList && elList[prop] && elList.order !== val) {
                    updates[elList[prop]] = val;
                    changed = true;
                }
            }

            if (changed) {
                var listIds = getListIdsForTreeItemsMoved(ids);
                if(!listIds) {
                    u.listIds = listIds;
                }
                u.updates = updates;

                changeOrderServerSide(u, null, onprocessed);
            }

            function onprocessed() {
                console.log('onprocessed');
                // reloadItem(src);
            }
        }


        function getAttribute(el, attr) {
            if (!el) {
                return undefined;
            }
            var id = el.getAttribute(attr);
            if (id === 'null') {
                id = null;
            }
            if (id === 'undefined') {
                id = undefined;
            }

            if ($ctrl.selectedIdFieldIsNumber) {
                id = parseInt(id, 10);
            }
            return id;
        }

        function reloadItem(item, firstTime) {
            console.log('tree.reloadItem');
            return $ctrl.listTreeService.selectList(item, firstTime, $ctrl.CPS.isCollaborator, $ctrl.treeType);
        }

        function changeOrderServerSide(otherParams, srcParentId, onprocessed) {
            console.log('onOrderChangedServerSide');
            var updates = otherParams.updates, exists;

            if (updates) {
                for (var prop in updates) {
                    exists = true;
                }
            }

            if (!exists) {
                return;
            }

            var params = $ctrl.getParams();
            if (otherParams) {
                params = _.extend(params, otherParams);
            }

            params.dontShowActivity  = true;

            $ctrl.listsService.updateSelected(params, function (result) {
                if (srcParentId !== undefined) {
                    if (!result) {
                        result = {};
                    }
                    result.srcParentId = srcParentId;
                }
                $ctrl.processUpdates(result, false, false);
                if (onprocessed) {
                    onprocessed(result.srcParentId);
                }
            }, function (error) {
                console.log(error);
            });
        }

        function acceptInitSortable(src, dest) {
           // console.log('acceptInitSortable');
            if (!src || !dest || !dest.isFolder) {
                return false;
            }

            var srcId = $ctrl.listTreeService.getSelectedFieldFromItem(src),
                destId = $ctrl.listTreeService.getSelectedFieldFromItem(dest);

            if ((srcId !== destId) && (!src.isPredef || $ctrl.canDragPredefTreeItem) &&
                (!dest.isPredef || $ctrl.canDragPredefTreeItem || destId == null)) {
                switch ($ctrl.listTreeService.maxLevel) {
                    case 1:
                        return destId === null;
                    case 2:
                        return destId === null || !src.isFolder;
                    // $ctrl.LCS.addClass($ctrl.elNode, 'indent' + ($ctrl.item.indent + ($ctrl.startIndent !== undefined ? $ctrl.startIndent : 1)));//add 20 px
                    default: //folders todo more complex checking
                        return ((dest.l + src.l) <= $ctrl.listTreeService.maxLevel);
                }
            }
            //maxLevel = 1 -> dest.l && src.l must be 0 < 1 //since dest is folder -> isAll
            //maxLevel = 2 -> dest.l = 1 && src.l=0 must be 1 < 2 //since dest is folder -> dest.l = 1 - >src.l = 0 (isFile)
            //(!src.isFolder && dest || src.isFolder && !dest) ? true : false;
        }

        function acceptSortableTree(s, d, destIndex) {
           // console.log('acceptSortableTree');
            var src = s.$modelValue,
                dest = d.$parent.item;
            if (!acceptInitSortable(src, dest)) {
                return false;
            }

            return typeof ($ctrl.acceptSortableTree) === 'function' ? $ctrl.acceptSortableTree(src, dest, destIndex) : true;
        }

        function goToList(item) {
            console.log('SidebarTreeCtrlService.goToList ' + $ctrl.elemType);
            if (!isEdit(item) && $ctrl.isSidebar &&
                ($ctrl.listTreeService.clickOnGroup && item.isFolder || !item.isFolder)) {
                $ctrl.reloadForList(item);
            }
        }

        function isMobileView() {
            return $ctrl.LCS.isMobileSize || $ctrl.isMobileMode; //callsheet
        }


        function getGroupName(list, inside){
            return $ctrl.nameForGroup;
        }

        function getGroupIcon(list, inside){
            return $ctrl.itemIcon;
        }

        function reloadForList(item) {
            if ($ctrl.LCS.noSidebarFilters || $ctrl.isMobileView()) {
                $ctrl.LCS.setMainSideBar(false);
            }
            reloadItem(item);
        }

        function getNewCreatedItem(data) {
            if (data.itemIsSet) {
                return $ctrl.listsService.convertResource(data.item);
            }
            var item = data.item,
                el = _.extend({isFolder: data.addFolder === true}, $ctrl.getParams()),
                afterId = null,
                parentId = null;

            if (!data.addFromBottom) {
                var selectedList = data.useSelected ? $ctrl.listTreeService.active.selectedList : item;
                if (data.isParent) {
                    parentId = selectedList._id;
                } else {
                    afterId = selectedList._id;
                    parentId = selectedList.parentId;
                }
            }

            el.afterId = afterId;
            el.parentId = parentId;

            el.l = item.l + (data.isParent ? 1 : 0);

            if(typeof ($ctrl.getNewTreeItem) === 'function') {
                el = _.extend(el, $ctrl.getNewTreeItem(item, el));
            }

            if (!el.name) {
                el.name = data.preserveItem && item && item.name ? item.name : ('New ' + (el.isFolder ? $ctrl.getGroupName(el) : $ctrl.nameForList) + ' ');
            }

            if (data.preserveItem) {
                el.preserveItem = true;
            }

            if(!el.type && data.item.type){
                el.type = data.item.type;
            }

            return $ctrl.listsService.convertResource(el);
        }

        function processUpdates(result, withSort, isForAll) {
            console.log('listTreeInit.processListUpdates');
            var props = isForAll ? $ctrl.listsService.getChangedFieldForUpdate() : $ctrl.listsService.fieldsUpdatedOnOrderChanged;
            $ctrl.listTreeService.processUpdates(result, withSort, props, $ctrl.processUpdatesMore, $ctrl.afterProcessUpdates);
        }

        function getTreeChangedParams(){
            return {
                isCommentsSidebar: $ctrl.isCommentsSidebar,
                isPrintLayout: $ctrl.isPrintLayout,
                isInTreeModal: $ctrl.isInTreeModal
            }
        }
    }
}


