angular.module('dropdowns.sbDropdownMenu.component', [
    'dropdowns.drpMenuWithHover.controller.service'
])

.component('sbDropdownMenu', sbDrpMenuComponentParams('SBDrpMenuCtrl',{
    withColor: '@',
    getItemDesc: '&'
}, '<ul class="dropdown-menu customdropdown"></ul>'))
.controller('SBDrpMenuCtrl', SBDrpMenuCtrl);

SBDrpMenuCtrl.$inject = ['SBDrpMenuWithHoverCtrlService', '$element'];

function SBDrpMenuCtrl(SBDrpMenuWithHoverCtrlService, $element) {
    //console.log('SBDrpMenuCtrl');
    var $ctrl = this;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitOtherHover = preInitOtherHover;

    $ctrl.elementWrapper = $element[0].querySelector('.dropdown-menu');
    $ctrl = new SBDrpMenuWithHoverCtrlService($ctrl, angular.element($ctrl.elementWrapper));

    function preInitOtherHover(){
        $ctrl.itemClass = 'selected-row';
        $ctrl.element.querySelector('.dropdown-menu')
        var cls =  ($ctrl.fixedHeight ? "fixedHeight " : '') +
            ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '');
        if(cls){
            $ctrl.LCS.addClass($ctrl.elementWrapper, cls);
        }
    }

    function getItemTemplate() {
        $ctrl.bindClick(false);
        if(!$ctrl.list ||!$ctrl.list.length){return '';}
        var el = '', i = 0;
        _.each($ctrl.list, function (item) {
           var val = item[$ctrl.labelField];
           el += '<li '+(item.hide?'class="sb-hide"' : '')+'>';

           if (item.isHeader) {
               el += "<div class='header dropdown-item semibold font-size-12'><span class='with-ellipsis'>" + val + "</span></div>"
           } else {
               el += "<a class='"+$ctrl.itemClass+" " +
                   ($ctrl.value === item[$ctrl.valueField] && $ctrl.activeClass ? $ctrl.activeClass : '') +
                   "' data-id='" + item[$ctrl.valueField] + "' data-index='" + (i++) + "'>";
               var withColor = $ctrl.withColor && (item.color || item.image);
               if (withColor) {
                   el += "<div class='circle-container-10 big inline-block'><div class='circle' style='" +
                       (item.color ? ('background-color:' + item.color + ';border-color:' + item.color) : '') +
                       (item.image ? ('background-image:' + $ctrl.LCS.imgPaths + item.image) : '') +
                       "'></div></div>";
               }
               var cls = ($ctrl.itemClss ? $ctrl.itemClss : '') + ' ' + (withColor? ' padding-left-12 inline-block' : '');

               el += "<div " + ( cls.trim() !=='' ? ("class='" + cls + "'") : '') + "><span class='with-ellipsis'>" + getItemDesc(item) + "</span></div>" +
                   "</a>";
           }

           el += "</li>";
        });

        return el;
    }

    function getItemDesc(item) {
        var nv = $ctrl.getItemDesc({item:item});
        return nv ? nv : item[$ctrl.labelField];
    }
}

angular.module('dropdowns.sbDropdown.component', [
    'dropdowns.sbDropdownSimple.controller.service'
])
.component('sbDropdown', sbDrpComponentParams('SBDropdownComponentCtrl', {
    inputColor: '@',
    colorClass: '@'
}))
.controller('SBDropdownComponentCtrl', SBDropdownComponentCtrl);

SBDropdownComponentCtrl.$inject = ['SBFieldTypesService', 'SBDrpSimpleCtrlService', '$element', '$attrs'];
function SBDropdownComponentCtrl(SBFieldTypesService, SBDrpSimpleCtrlService, $element, $attrs) {
    //console.log('SBDropdownComponentCtrl');

    var withoutTemplateScope = true;
    var $ctrl = this;
    $ctrl.propType = SBFieldTypesService.PropTypes.Drp;

    $ctrl.getGenerateMenuParams = getGenerateMenuParams;
    $ctrl.onSimpleDrpFieldLoaded = onSimpleDrpFieldLoaded;

    $ctrl = new SBDrpSimpleCtrlService($ctrl, $element, $attrs);

    $ctrl.setDisplayValueDrpOther = setDisplayValueDrpOther;

    function onSimpleDrpFieldLoaded(){
        $ctrl.withoutText = $attrs.withoutText === 'true' || $attrs.withoutText === true;
        $ctrl.withColor = $attrs.withColor === 'true' || $attrs.withColor === true;
        $ctrl.elSelText = $ctrl.element.querySelector('.selected');

        if ($ctrl.withColor) {
            $ctrl.LCS.addClass($ctrl.elSelText, 'with-color');
            $ctrl.LCS.insertFragmentBeforeChild($ctrl.elSelText, getCircle(), $ctrl.inputField);
            $ctrl.elColor = $ctrl.element.querySelector('.cc');
        }

        if ($ctrl.fieldClass) {
            $ctrl.LCS.addClass($ctrl.inputField, $ctrl.fieldClass);
        }

        $ctrl.LCS.addClass($ctrl.element, $ctrl.element.tagName.toLowerCase() +
            ' display-block clearfix wrap-dd-select ' +
            ($ctrl.cClassAttr ? $ctrl.cClassAttr : '') +
            ($ctrl.withColor && $ctrl.withoutText ? ' without-text' :'')
        );

        //$ctrl.loadReset($ctrl.elSelText);
    }

    function setDisplayValueDrpOther(selected) {
       // console.log('setDisplayValue: drp');
        if ($ctrl.withColor) {
            var color = selected ? selected.color : $ctrl.inputColor;
            if (color !== $ctrl.prevInputColor) {
                var circle = $ctrl.elColor.querySelector('.circle-container-10');
                $ctrl.LCS.setCSSStyle(circle, 'background-color', color ? color : '');
                $ctrl.prevInputColor = color;
            }

            if ($ctrl.colorClass !== $ctrl.prevColorClass) {
                if ($ctrl.prevColorClass) {
                    $ctrl.LCS.replaceClass($ctrl.elColor, $ctrl.prevColorClass, $ctrl.colorClass);
                } else {
                    $ctrl.LCS.addClass($ctrl.elColor, $ctrl.colorClass);
                }
                $ctrl.prevColorClass = $ctrl.colorClass;
            }
        }

        if($ctrl.resetValue!== undefined){
            $ctrl.LCS[$ctrl.resetValue === $ctrl.value ? 'addClass' : 'removeClass']($ctrl.element.querySelector('#'+$ctrl.btnResetId), 'sb-hide');
        }
    }

    function getCircle(){
        return '<div class="cc"><div class="circle-container-10"></div></div>';
    }

    function getGenerateMenuParams(){
            return ($ctrl.withColor ? ('with-color="true" ') : '');
    }
}

