        this.from = from;
        this.to = to;

        this.columns = ColumnGenerator.generate(this.columnBuilder, from, to, viewScale, this.getColumnsWidth());
        this.headers = HeadersGenerator.generate(this);
        this.previousColumns = [];
        this.nextColumns = [];

