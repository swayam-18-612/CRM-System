})
.controller('GroupZoomFiltersCtrl', GroupZoomFiltersCtrl);

GroupZoomFiltersCtrl.$inject = ['TemplateCompileCompCtrlService', 'FiltersCtrlService', '$element'];
function GroupZoomFiltersCtrl(TemplateCompileCompCtrlService, FiltersCtrlService, $element) {
    var $ctrl = this,
        withoutTemplateScope = false;

    console.log('GroupDrpFiltersCtrl');

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onZoom = onZoom;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        $ctrl.btnId = 'id';
        $ctrl.hideFilters = false; //hide page filter and display the group filters
        $ctrl.filtersClass = 'small';
        $ctrl.canEdit = false;
        $ctrl = new FiltersCtrlService($ctrl);
    }

    function getItemTemplate(){
        bind(false);
        var t = '';
        _.forEach($ctrl.Zooms, function (item){
            t += '<div tooltip-placement="bottom" tooltip="'+item.name+'">' +
                    '<a data-id="'+item.id+'" analytics-on analytics-action="'+item.name+'">' + $ctrl.LCS.getISBDiv(item.icon, 2) + '</a>' +
                 '</div>';
        });
        return '<div class="header-small clearfix spacing-half-top ">Adjust Zoom</div>' +
                    '<div class="viewZoomButtons one-line-tooltip pull-left  margin-bottom-quarter">' + t + '</div>' +
                '</div>';
    }

    function onDestroy() {
        bind(false);
    }

    function onLoaded() {
        bind(true);
    }

    function bind(isBind) {
        $ctrl.bindElementsClickBySelector(isBind, 'a', $ctrl.onZoom);
    }

    function onZoom(e){
        $ctrl.preventDefault(e);
        $ctrl.zoom(e, parseInt(e.currentTarget.getAttribute('data-id'), 10));
    }
}

angular.module('groupBlock.empty-state.component', [
