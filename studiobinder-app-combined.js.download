angular.module('user.team.group.component.service',[
    'apiPagination.TodoCards',
    'group.controller.service',
    'apiPagination.Team',
    'apiServices.Users',
    'user.team.item.grid.component',
    'user.team.item.grid.component',
    'list.keyboard.service',
    'list.ctrl'
])
 
.service('TeamGroupCtrlService',TeamGroupCtrlService);
TeamGroupCtrlService.$inject = ['TeamPagination'];
function TeamGroupCtrlService(Pagination) {
    return function($ctrl) {
        $ctrl.Pagination = Pagination;

        $ctrl.EmailStatus = {
            Sent: 1,
            Confirmed: 2,
            Delivered: 3,
            Bounced: 4,
            Dropped: 5,
            Deferred: 6,
            Spam: 7,
            Blocked: 8
        };

        $ctrl.dontLoadPlans = true;
        $ctrl.withSignup = false;
        $ctrl.btnActionCls1 = 'btnAction1';

        $ctrl.getNewPopupParamsOther = getNewPopupParamsOther;
        $ctrl.getInlineActions = getInlineActions;
        $ctrl.getRowMobileActions = getRowMobileActions;
        $ctrl.getGroupItemsOthers = getGroupItemsOthers;
        $ctrl.isNotCurrentList = isNotCurrentList;
        $ctrl.onPostloadGroup = onPostloadGroup;
        $ctrl.onPreloadGroup = onPreloadGroup;
        $ctrl.onAdded = onUpdated;
        $ctrl.onUpdated = onUpdated;
        $ctrl.onRemoved = onUpdated;
        $ctrl.onUpdatedImage = onUpdatedImage;
        $ctrl.showSelectCondition = showSelectCondition;
        $ctrl.getItemImageSize = getItemImageSize;
        $ctrl.getNumber = getNumber;
        $ctrl.processGridViewItem = processGridViewItem;
        $ctrl.processListItemColumn = processListItemColumn;
        $ctrl.getItemImageArea = getItemImageArea;
        $ctrl.hideSelectAllCheck = hideSelectAllCheck;
        $ctrl.getClipboardProcessingParams = getClipboardProcessingParams;
        $ctrl.canEditImage = canEditImage;
        $ctrl.setGroupCounter = setGroupCounter;
        $ctrl.onInit = onInit;
        $ctrl.preloadSettings = preloadSettings;
        $ctrl.addTeamSeats = addTeamSeats;

        $ctrl.bindActionsOthers = bindActionsOthers;

        $ctrl.onDestroyGroupOther = onDestroyGroupOther;

        return $ctrl;

        function preProcessGroupItems(item) {
            item.productIds = $ctrl.teamForProduct[item._id] || [];
            item.products = item.productIds.map(function (id) {
                return _.find($ctrl.products, {_id: id});
            });
            return item;
        }

        function preloadSettings() {
            $ctrl.teamForProduct = {};
            $ctrl.products = $ctrl.preLoadingService ? $ctrl.preLoadingService.getObjectList($ctrl.preLoadingService.TblTypes.Products).map(function (p) {
                p.teamIds = [];
                p.team = _.filter(_.unique(p.teamIds).map(function (id) {
                    return _.find($ctrl.team, {_id: id});
                }), function (el) {
                    if (el) {
                        p.teamIds.push(el._id);
                        if (!$ctrl.teamIds[p._id]) {
                            $ctrl.teamIds[p._id] = [];
                        }
                        $ctrl.teamForProduct[el._id].push(p._id);
                    }
                    return el;
                });
                return p;
            }) : null;
            $ctrl.Settings = _.extend({}, $ctrl.Settings, {products: $ctrl.products});
        }

        function onInit() {
            onUpdateSubscription();
            if(!$ctrl.count) {
                $ctrl.count = getFiltersTotalCounter();
            }
            if(!$ctrl.quotaType) {
                $ctrl.quotaType = 'team';
            }
        }

        function hideSelectAllCheck(){
           return !($ctrl.CPS.currentPlan.isCompany && $ctrl.count > 1);
        }

        function showSelectCondition() {
            return $ctrl.showSelectConditionInit() && ($ctrl.count > 1);
        }

        function onUpdatedImage(item, result) {
            console.log('onUpdatedImage');
            if(!item){return;}
            var prop = 'profilePictureURL', p = {};
            p[prop] = item[prop];
            p[prop + 'Id'] = item[prop + 'Id'];
            onUpdated({
                item: item,
                editchanges: p
            });
        }

        function onUpdated(result) {
            console.log('onUpdated');
            var ch = result ? result.editchanges : null,
                withUserChanges = false;
            if(ch){
                for(var prop in ch){
                    if(prop === 'name' || prop === 'email' || prop === 'phone' || prop === 'profilePictureURL'){
                        withUserChanges = true;
                    }
                }
            }

            if(withUserChanges && result.item.userId === $ctrl.CPS.userId){
                $ctrl.security.updateCurrentUser(result.item.user, $ctrl.SessionService);
            }
            reloadTeam();
        }

        function reloadTeam(){
            $ctrl.SessionService.reloadTeam();
        }

        function onPreloadGroup() {
            if (!$ctrl.canEdit) {
                return;
            }
            $ctrl.create = create;
            $ctrl.resendInvites = resendInvites;
            $ctrl.resendElemInvite = resendElemInvite;
            $ctrl.processItem = processItem;
        }

        function onPostloadGroup(){
            if($ctrl.canEdit) {
                $ctrl.addRootWatcher('ASSIGN_TEAM', function (e) {
                    assignTeam(null, true);
                });
            }
        }

        function bindActionsOthers(isBind){
            bindEmptyStateItem(isBind);
        }

        function isNotCurrentList(){
            return false;
        }

        function isNotApproved(item) {
            return item.status !== 2;
        }

        function getInlineActions(isHeader, item) {
            return $ctrl.canEdit ?
                (isHeader ? ('<div class="with-btn hide-print hide-ipad no-drag show-listview sb-hide">&nbsp;</div>') :
                    ('<div class="with-btn hide-print hide-ipad no-drag with-hover text-center no-drag">' +//one-line-tooltip
                        (!($ctrl.CPS.userId === item.userId && $ctrl.service.isOwner(item)) && isNotApproved(item) ? ('<a class="see-breakdown gray-light display-block ' + $ctrl.getClickEventName('resendElemInvite') + '" tooltip="Resend Invite" tooltip-placement="bottom" analytics-on analytics-action="Resend Invite">' +
                            $ctrl.LCS.getISBDiv('paper-plane', 2, 'gray') +
                            '</a>') : '') +
                        '</div>')) : '';
        }

        function getRowMobileActions(item) {
            return ($ctrl.canEdit && !($ctrl.CPS.userId === item.userId && $ctrl.service.isOwner(item)) && isNotApproved(item)) ?
                [{
                    type: 'resendElemInvite',
                    action: 'Resend Invite',
                    icon: 'paper-plane'
                }] : null;
        }

        function getGroupItemsOthers() {
           return $ctrl.canEdit && $ctrl.CPS.isOwnerOrAdmin ? getRemainingItems() : '';
        }

        function getRemainingItems() {
            $ctrl.currentlyEmpty = $ctrl.getNumber($ctrl.count - $ctrl.list.totalCount);
            return getEmptyBlocks($ctrl.currentlyEmpty);
        }

        function getEmptyBlocks(c){
                                                //add seats block
            return c ? getEmptyItems(c) : getEmptyItem(0, true);

            function getEmptyItems(c) {
                var el = '';
                for (var i = 0; i < c; i++) {
                    el += getEmptyItem(i);
                }
                return el;
            }
        }

        function getMethod(isAddSeats) {
            return isAddSeats ? 'addTeamSeats' : 'create';
        }

        function getEmptyItem(i, isAddSeats) {
            var txt = isAddSeats ? 'Add User Seat' : 'Invite User',
                btn = $ctrl.btnActionCls1 + '" data-type="' + getMethod(isAddSeats)+ '" analytics-on analytics-action="Open ' + txt,
                icon = isAddSeats ? 'plus' : 'add-user';
            return '<div class="clearfix ' + $ctrl.gridItemClass + ' with-cursor team-member-row dd-item team-item-grid  ' + btn + '" data-index="' + i + '">' +
                '<div class="team-member new-member h-full full-width">' +
                '<div class="overlayx text-center' + ($ctrl.isWidget ? ' on-widget' : '') + (isAddSeats ? ' add-seats' : '') + '">' +
                ($ctrl.isWidget ? '' : (
                    '<div class="col150 centering">' +
                    '<div class="sbf sbf30 blue ' + icon + '">' + $ctrl.LCS.getISBPath(3) + '</div>' +
                    '<div class="text-center full-width blue">' + txt + '</div>' +
                    '</div>'
                )) +
                '</div>' +
                '</div>' +
                '</div>';
        }

        function setGroupCounter(item) {
            if (!$ctrl.isOnLoad) {
                $ctrl.isOnLoad = true;
                return;
            }

            console.log('setGroupCounter');
            if (!($ctrl.canEdit && $ctrl.CPS.isOwnerOrAdmin)) {
                return;
            }

            var c = $ctrl.getNumber($ctrl.count - $ctrl.list.totalCount),
                remove = $ctrl.currentlyEmpty - c;
            bindEmptyStateItem(false);
            var group = $ctrl.element.querySelector('.flex-wrap');

            removeItems(true);

            if (remove === 0) {//data-type="addTeamSeats" -> remove all the invite team items.
                $ctrl.LCS.appendChildFragment(group, getEmptyBlocks(c));
            } else if (remove < 0) { //add invite items
                $ctrl.LCS.appendChildFragment(group, getEmptyBlocks(c));
            } else if (remove > 0) {  //> remove   invite team
                removeItems(false, remove);
            }

            bindEmptyStateItem(true);

            $ctrl.currentlyEmpty = c;

            function removeItems(isAddSeats, remove) {
                var items = group.querySelectorAll('.team-member-row' + (isAddSeats ? '' : '[data-type="addTeamSeats"]'));
                var l = items && items.length > 0 ? items.length : 0;
                if (isAddSeats) {
                    remove = l;
                }
                for (var i = remove - 1; i >= 0; i--) {
                    if (items.length > 0) {
                        $ctrl.LCS.removeElement(items[items.length - 1 - i]);
                    }
                }
            }
        }

        function bindEmptyStateItem(isBind) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('.' + $ctrl.btnActionCls1), $ctrl.onAction);
        }

        function getNumber(n) {
            return new Array(n < 0 ? 0 : n).length;
        }

        function onUpdateSubscription(sub) {
            if (sub) {
                $ctrl.showNewBtn = true;
            }
        }

        function create(info, e) {
            assignTeam(e, false);
        }

        function assignTeam(e, allowMultiple) {
            $ctrl.preventDefault(e);
            var extraParam =  {
                remaining: $ctrl.count-$ctrl.list.totalCount,
                total: $ctrl.count,
                allowMultiple: allowMultiple
            };

            $ctrl.CPS.loadQuotaPopup($ctrl.quotaType, process, $ctrl.count, $ctrl.list.totalCount, $ctrl.compOptions, {e:e});

            function process() {
                $ctrl.popupsService.open(null, $ctrl.popupsService.operations.inviteTeam, extraParam, $ctrl.compOptions);
            }
        }

        function processGridViewItem(item) {
            return processItemView(true, item);
        }

        function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
            return processItemView(false, item, canEdit, c, cls, isFirst, isLast, textOnly, textOnly, isMobile, isMobileRowDetails);
        }

        function processItemView(isGrid, item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
            if(!isGrid && !c){return '';}

            var isOwner = $ctrl.service.isOwner(item);
            if(isOwner){item.isPredef = true;}
            var hasInvite = !($ctrl.CPS.userId === item.userId && isOwner),
                status = item.status,
                name = item.name,
                statusText = 'Invite Pending',
                statusIcon = getStatusIcon(),
                tooltip = 'Invite Email Status: ' + getStatusText() + '.' + getStatusTooltip();
            if(!name){name='';}
            var email = item.email;
            if(!email){email='';}

            var memberTypeCol = $ctrl.getColumnByProp('memberType', isMobileRowDetails && !textOnly),
                 emailCol = $ctrl.getColumnByProp('email'),
                 nameCol = $ctrl.getColumnByProp('name');

            if (isGrid) {
                var cls2 =  'without-height-padding';
                return '<div>' +
                    '<div class="table-div fixed-layout full-width height10P">' +
                        '<div class="side-col"></div>'+
                        '<div class="team-member full-width spacing-half one-line-tooltip">' +
                            ($ctrl.withInvites ? ('<div class="top-info">' +
                               (hasInvite ? ('<div class="with-hover">' +
               (!item.userId && isNotApproved(item) ?('<div tooltip="'+tooltip+'" tooltip-placement="bottom" class="with-italic mail views text-center '+statusIcon+'">' +
                                        '<div class="resend-invite '+$ctrl.getClickEventName('resendElemInvite')+'" analytics-on analytics-action="Resend Invite">'+statusText+' <span class="resend">Resend?</span></div>' +
                                    '</div>'):'') +
                                    //'<div class="remove one-line-tooltip  '+$ctrl.getClickEventName('remove')+'" "><a class="gray-light sbf cancel" tooltip="Remove Teammate" tooltip-placement="bottom" analytics-on analytics-action="Remove Teammate"></a></div>' +
                                '</div>'):'')+
                            '</div>') : '') +
                            $ctrl.getImageTemplate(item, $ctrl.getColumnByProp('profilePictureURL', true)) +
                            (nameCol ? ('<div class="text-center name margin-top-quarter" ' + (name.length > 30?(' tooltip-placement="bottom" tooltip="'+name+'"') : '') + '>' +get(nameCol, cls2) +  '</div>') : '') +
                            (emailCol ? ('<div class="text-center email " ' + (email.length > 30?(' tooltip-placement="bottom" tooltip="'+email+'"') : '') + '>' + get(emailCol, cls2) + '</div>') : '') +
                            (memberTypeCol ? ('<div class="text-center centering">'+ get(memberTypeCol, cls2) + '</div>') : '') +
                        '</div>' +
                        '<div class="side-col">' +
                            (isOwner ? '' : (
                                $ctrl.getCustomCheckbox(true) +
                                $ctrl.getMoreBtnTemplate(false, item, isMobile)
                            ))+
                        '</div>' +
                    '</div>' +
                '</div>';
            }else{
           /*     if(c.prop === 'status' && !isOwner){
                    el += '<div tooltip="' + tooltip + '" tooltip-placement="bottom" class="with-italic mail views text-center ' + statusIcon + '">' + statusText + '</div>';
                }*/

                if (c.prop === 'name' && ($ctrl.displaySubtitleUnder || isMobileRowDetails && !textOnly)) {
                    if(!memberTypeCol || c.viewRowDetailsMobile){
                        return get(c);
                    }else{
                        return '<div ' +(cls?('class="' + cls +'"'):'')+'>' +
                                    get(c, 'full-width name with-ellipsis') +
                                    '<div class="subname">' + get(memberTypeCol, ' ') + '</div>' +
                               '</div>';
                    }
                }else if(c.prop === 'status') {
                    return '<div class="' + cls + '">' +
                        ((isOwner || item.userId) ? '' : ('<div tooltip="' + tooltip + '" tooltip-placement="bottom" class="with-italic mail views text-center ' + statusIcon + '">' + statusText + '</div>')) +
                        '</div>';
                }else{
                    return get(c);
                }
            }

            function get(c, cls1) {
                var canEdit = $ctrl.canEdit && c.canEdit && !isMobileRowDetails;
                if(c.prop === 'memberType'){
                    canEdit = canEdit && $ctrl.security.isCompanyAdmin() && !isOwner && item.userId !== $ctrl.CPS.userId;
                }else if(!$ctrl.security.isOwner){
                    canEdit = canEdit && !isOwner && ($ctrl.security.isCompanyAdmin() || item.userId === $ctrl.CPS.userId);
                }

                var ext = {
                        wrapperClass: 'centered',
                        fieldClass:'text-center'
                    },
                    ext2 = {
                        wrapperClass: 'centering',
                        fieldClass:'text-center'
                    };
                return $ctrl.getDisplayItemCol(item, _.extend({}, c, {
                    canEdit:canEdit
                }, $ctrl.isGridView ? ((c.prop === 'email' || c.prop === 'name' || c.prop === 'memberType') ? _.extend({}, ext2, {
                    cClassAttr: (c.cClassAttr || '') + ' centered '
                }) : (c.prop === 'teamIds' ? ext2 : null)) : (!$ctrl.isGridView && c.prop === 'teamIds' ?  ext: null)),
                    cls1 !== undefined ? cls1 : cls,
                    canEdit, textOnly, isMobile, isMobileRowDetails);
            }

            function getStatusTooltip() {
                var inv = item.teamInvitation;
                if (!inv) {
                    return null;
                }
                var reason = inv.reason,
                    updatedAt = inv.updatedAt ? inv.updatedAt.format($ctrl.CPS.dateTimeFormat) : '',
                    on = updatedAt ? ('on ' + updatedAt) : '';
                switch (inv.status) {
                    case $ctrl.EmailStatus.Delivered:
                        return 'Message has been successfully delivered to the receiving server ' + on;
                    case $ctrl.EmailStatus.Bounced:
                        return 'Receiving server could not or would not accept message ' + on + ' because: ' + reason;
                    case $ctrl.EmailStatus.Dropped:
                        return 'Dropped ' + on + ' because: ' + reason;
                    case $ctrl.EmailStatus.Deferred:
                        return 'Deferred ' + on + ' because: ' + reason;
                    case $ctrl.EmailStatus.Spam:
                        return 'Recipient marked message as spam on ' + updatedAt;
                    case $ctrl.EmailStatus.Blocked:
                        return 'Recipient blocked ' + on + ' because: ' + reason;
                    case $ctrl.EmailStatus.Sent:
                        return ('Last Sent on ' + (inv.createdAt ? inv.createdAt.format($ctrl.CPS.dateTimeFormat) : ""));
                    case $ctrl.EmailStatus.Confirmed:
                        return 'Joined on ' + (inv.confirmedAt ? inv.confirmedAt.format($ctrl.CPS.dateTimeFormat) : "");
                }
            }

            function getStatusText() {
                switch (status) {
                    case $ctrl.EmailStatus.Sent:
                        return 'Sent';
                    case $ctrl.EmailStatus.Delivered:
                        return 'Delivered';
                    case $ctrl.EmailStatus.Bounced:
                        return 'Bounced';
                    case $ctrl.EmailStatus.Dropped:
                        return 'Dropped';
                    case $ctrl.EmailStatus.Deferred:
                        return 'Deferred';
                    case $ctrl.EmailStatus.Spam:
                        return 'Spam Report';
                    case $ctrl.EmailStatus.Blocked:
                        return 'Blocked';
                    case $ctrl.EmailStatus.Confirmed:
                        return 'Joined';
                }
            }

            function getStatusIcon() {
                switch (status) {
                    case $ctrl.EmailStatus.Delivered:
                        return 'green-del mail-delivered';
                    case $ctrl.EmailStatus.Bounced:
                        return 'purple-bo mail-bounced';
                    case $ctrl.EmailStatus.Dropped:
                        return 'purple-dr mail-dropped';
                    case $ctrl.EmailStatus.Deferred:
                        return 'green-def mail-deferred';
                    case $ctrl.EmailStatus.Spam:
                        return 'red-sp mail-spam';
                    case $ctrl.EmailStatus.Blocked:
                        return 'red-bl mail-blocked';
                    case $ctrl.EmailStatus.Sent:
                        return 'red mail-sent';
                    case $ctrl.EmailStatus.Confirmed:
                        return 'green check-mark-circle';
                }
            }
        }

        function resendElemInvite(item) {
            console.log('resendElemInvite');
            //$ctrl.processItem(item, 'sendMessage');
            resendInvites([item._id]);
        }

        function resendInvites(ids) {
            processBulk($ctrl.popupsService.operations.resendTeamInvites, ids);
        }

        function processBulk(operation, selected) {
            if (!selected || selected.length === 0) {
                return;
            }
            var extraParam = $ctrl.withProperty();
            extraParam.type = operation.type;
            extraParam.message = null;
            extraParam.company = $ctrl.company;

            if (operation.type === 'Resend Selected') {
                var s = [];
                for (var i = 0; i < selected.length; i++) {
                    var el = $ctrl.list.getElementById(selected[i]);
                    if (el) {
                        var inv = el.teamInvitation;
                        var t = {
                            teamId: el._id,
                            name: el.name,
                            email: el.email
                        };

                        if (inv) {
                            if (inv.status !== $ctrl.EmailStatus.Confirmed) {
                                t._id = inv._id;
                                s.push(t);
                                if (!extraParam.message) {
                                    extraParam.message = inv.message;
                                }
                            }
                        } else {
                            s.push(t);
                        }
                    }
                }
                if (s.length > 0) {
                    extraParam.selected = s;
                } else {
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.team.pending.error', 'error');
                    return;
                }
            } else {
                extraParam.selected = selected;
            }

            $ctrl.popupsService.open(null, operation, extraParam, $ctrl.compOptions);
        }

        function processItem(item, action, e) {
            $ctrl.selectKeyboardItem(item);
            $ctrl.processGroupEvent(action, e);
        }

        function getItemImageSize(isMobile) {
            var type = 'mediumsmall';
            return isMobile ? type : ($ctrl.isGridView ? 'medium centered' : type);
        }

        function getNewPopupParamsOther() {
            return {
                Settings: $ctrl.Settings
            };
        }

        function getItemImageArea(c){
            return c.areaType;
        }

        function getClipboardProcessingParams(params) {
            if (params.opType === 3) {
                var u = params.updates.clipboard;
                if (u && u.length > 0) {
                    var o = _.find($ctrl.list.items, function (el) {
                            return $ctrl.service.isOwner(el);
                        }),
                        ownerId = o ? o._id : null;

                    if (ownerId) {
                        params.updates.clipboard = _.filter(u, function (el) {
                            return el.id !== ownerId;
                        });
                    }
                }
            }
            return params;
        }

        function canEditImage(item, isGridView){
            return item && item.userId;
        }

        function getFiltersTotalCounter() {
            var subFeatures = $ctrl.CPS.subscription ? $ctrl.CPS.subscription.features : null,
                count = subFeatures && subFeatures.team ? subFeatures.team.total : 1;
            if (count === undefined || count === null) {
                count = 1;
            }
            return count;
        }

        function onDestroyGroupOther(){
            bindEmptyStateItem(false);
        }

        function addTeamSeats(){
            if($ctrl.isWidget){
                goToTeam();
            } else {
                $ctrl.broadcastRoot('ADD_TEAM_SEATS');
            }
        }


        function goToTeam() {
            $ctrl.popupsService.teamAdminAccess(function () {
                $ctrl.CPS.transitionTo('user.team', $ctrl.CPS.currentPathParams({
                  //  addSeats: true // open Add Seats modal
                }));
            });
        }
    }
}

angular.module('user.team.item.grid.component', [
    'item.grid.controller.service',
    'apiServices.Team'
])
.component('teamItemGrid', itemGridComponentParams({
    team: '<'
}, 'TeamGridItemCtrl'))

.controller('TeamGridItemCtrl', TeamGridItemCtrl);
TeamGridItemCtrl.$inject = ['CompInitCtrlService', 'GridItemGroupInitCtrlService', '$element'];
function TeamGridItemCtrl(CompInitCtrlService, GridItemGroupInitCtrlService, $element) {
    var $ctrl = this;

    $ctrl.bindingNames = ['resendElemInvite'];

    $ctrl.getColFromProp = getColFromProp;

    $ctrl = new GridItemGroupInitCtrlService($ctrl, $element);

    function getColFromProp(prop) {
        var c = $ctrl.getColFromPropInit(prop),
            canEdit = $ctrl.canEdit && c.canEdit,
            isOwner = $ctrl.service.isOwner($ctrl.item),
            isCurrentUser = $ctrl.item.userId === $ctrl.CPS.userId;
        if (c.prop === 'memberType') {
            c.canEdit = canEdit && $ctrl.security.isCompanyAdmin() && !isOwner && !isCurrentUser;
        } else if (!$ctrl.security.isOwner) {
            c.canEdit = canEdit && !isOwner && ($ctrl.security.isCompanyAdmin() || isCurrentUser);
        }

        if ($ctrl.isGridView) {
            var wrapperClass = 'centering';
            c = _.extend({}, c, {
                wrapperClass: wrapperClass,
            });
            if (c.prop === 'email' || c.prop === 'name' || c.prop === 'memberType') {
                return _.extend({}, c, {
                    cClassAttr: (c.cClassAttr || '') + ' centered ',
                    fieldClass: 'text-center'
                });
            } else if (c.prop === 'teamIds') {
                return _.extend({}, c, {
                    fieldClass: 'text-center'
                });
            }
        } else {
            if (c.prop === 'teamIds') {
                return _.extend({}, c, {
                    wrapperClass: 'centered',
                    fieldClass: 'text-center'
                });
            }
        }

        return c;
    }
}


