function AvscriptsConstantsService(SBFieldTypesService, compOptions){
    var PropTypes = SBFieldTypesService.PropTypes,
        constants = DocumentsConstantsServiceInit(SBFieldTypesService, compOptions);
    constants.Options.view = 2;
    constants.Options.columns = ["1", "2", "3", "4", "5"];
    constants.Settings.Columns = angular.copy(SBApiGridColumns['avscripts'](PropTypes));

    return constants;
}


