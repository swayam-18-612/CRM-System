LoadingIndicatorHook.$inject = ['$transitions', 'LoadingIndicatorService'];

function LoadingIndicatorHook($transitions, LoadingIndicatorService) {
    $transitions.onStart( { /* match anything */ }, LoadingIndicatorService.showLoadingIndicator);
    $transitions.onFinish( { /* match anything */ }, LoadingIndicatorService.hideLoadingIndicator);
}

var SBRegisteredStates = [];


function addStates($uiRouter, states, getState) {
    _.each(states, function (state) {
        var s = getState ? getState(state) : state;
        SBRegisteredStates.push(s);
        $uiRouter.stateRegistry.register(s);
    });
}

angular.module('app.routing.config', [
    'ui.router',
    'app.states.constant',
    'auth.interceptor.factory'
])
.config(AppRouting);
AppRouting.$inject = ['$urlRouterProvider', '$httpProvider', '$locationProvider', 'API_CONFIGS', '$uiRouterProvider','MAIN_APP_STATES', '$qProvider'];
function AppRouting($urlRouterProvider, $httpProvider, $locationProvider, API_CONFIGS, $uiRouter, MAIN_APP_STATES, $qProvider) {

    $locationProvider.html5Mode(true);

    var configs = API_CONFIGS(),
        defaultRoute = configs.site.loginPath;//configs.baseHref;

    $urlRouterProvider.otherwise(function ($injector) {
        var url = $injector.get('$location').url(),
            preload = url.indexOf('/collab/') !== -1 || url.indexOf('/anon/') !== -1;
            console.log('default route set to ' + defaultRoute + (preload ? ' with preload ' : ''));
            $injector.get('$state').transitionTo('public.login', preload ? {
                preload: 1//url
            } : null);
    });

    addStates($uiRouter, MAIN_APP_STATES);

    $httpProvider.interceptors.push('authInterceptor');

    $qProvider.errorOnUnhandledRejections(true);
}


/** This run block registers a Transition Hook which protects
 * routes that requires authentication.
 *
 * This hook redirects to /login when both:
 * - The user is not authenticated
 * - The user is navigating to a state that requires authentication
 */
//not in use
angular.module('app.state.auth.run', [
])
.run(authHookRunBlock);

authHookRunBlock.$inject = ['$transitions', 'security'];
  function authHookRunBlock($transitions, security) {
    // Matches if the destination state's data property doesn’t have 'minRole' property
    var requiresAuthCriteria = {
        to: function(state) {
            return state.data.minRole > 0;
        }
    };

    // Function that returns a redirect for the current transition to the login state
    // if the user is not currently authenticated (according to the security service)

    // Register the "requires auth" hook with the TransitionsService
    $transitions.onBefore(requiresAuthCriteria, redirectToLogin, {priority: 10});

    function redirectToLogin(transition) {
        console.log('redirectToLogin');
        var $state = transition.router.stateService;
        if (!security.isUserOrCollab()) {
            return $state.target(security.loginState, undefined, {location: false});
        }
    }
}

angular.module('app.state.change.run', [
     'apiServices.Collaborators',
     'user.share.collaborators.service',
    'service.currentPageSettings.service',
    'angularytics.provider',
    'chat.service'
])
   /* .run(['SBCurrentState', '$state', '$stateParams', 'authorization', 'principal',
        function(SBCurrentState, $state, $stateParams, authorization, principal) {
            $rootScope.$on('$stateChangeStart', function(event, toState, toStateParams) {
                SBCurrentState.toState = toState;
                SBCurrentState.toStateParams = toStateParams;

                if (principal.isIdentityResolved()) authorization.authorize();
            });
        }
    ])*/

.run(StateChangeRunBlock);

StateChangeRunBlock.$inject = ['security', 'CheatSheetService', '$transitions', 'SBStateService', 'SessionService', 'RouteCollaboratorsService', 'CPS', 'ChatService', 'Angularytics'];

function StateChangeRunBlock(security, CheatSheetService, $transitions, SBStateService, SessionService, RouteCollaboratorsService, CPS, ChatService, Angularytics) {
    console.log('StateChangeRunBlock');

    //$transitions.onSuccess({}, onSuccessStateChange);

    var LCS = CPS.LCS,
        configs = LCS.API_CONFIGS,
        loggedIn = false,

     $window = SBStateService.$window,
     RootEventsService = SBStateService.RootEventsService;

    $transitions.onBefore({}, onBeforeStateChange);
    $transitions.onFinish({}, onFinishStateChange);

    function setBeforeUnload(isBind) {
        LCS.bindElementListeners(isBind, $window, onBeforeUnload, 'beforeunload');
    }

    function hasDocChanged(from){
        return SessionService.hasDocChanges && from && (
            from === 'user.product.document' ||
            from === 'user.product.documents' ||

            from === 'user.product.screenplay' ||
            from === 'user.product.screenplays' ||

            from === 'user.product.breakdown' ||
            from === 'user.product.breakdown'
        )
    }
    function onBeforeUnload(e) {
        var from = SBStateService.getCurrentStateName();
        console.log('onBeforeUnload: ' + from);
        console.log("page is about to be unloaded. set page refresh to true in set local storage");
        // localStorage.setItem('page_refresh', 'true');
        if (hasDocChanged(from)) {
            var confirmationMessage = "Are you sure you want to leave this page? There are unsaved changes.";
            (e || $window.event).returnValue = confirmationMessage; //Gecko + IE
            return confirmationMessage;
        }
        return false;
    }

    function saveDocBefore(onSuccess){
        var from = SBStateService.getCurrentStateName();
        if (hasDocChanged(from)) {
            return RootEventsService.broadcastRoot('SAVE_DOC_BEFORE_PAGE_CHANGE_'+from, {onSuccess: onSuccess});
           // var confirmationMessage = "Are you sure you want to leave this page? There are unsaved changes.";
            // (e || $window.event).returnValue = confirmationMessage; //Gecko + IE
            // return confirmationMessage;
        } else{
            return onSuccess();
        }
    }

    function onBeforeStateChange(transition) {
        //todo work on SBAuthorization to move the verification before state change begins
       return saveDocBefore(onSuccess);

        function onSuccess() {
            var fromState = transition.from(),
                fromStateName = fromState.name,

                toState = transition.to(),
                toStateName = toState.name,
                toParams = Object.assign({}, angular.copy(transition.params())),
                data = toState.data,
                isPublicPage = isPublic(data),

                withstate = changeToStateForCollab();

            if (withstate) {
                toState = withstate.state;
                toStateName = toState.name;
                toParams = Object.assign({}, getStateParams(toState, withstate.url));
                data = toState.data;
            }

            //record init state for collaborators purpose
            if (!SBStateService.initStateParams) {
                SBStateService.initStateParams = toParams;
            }

            console.log('stateChangeBefore: validate change state from', fromStateName, 'to', toStateName);

            SBStateService.isRedirecting = true;

            if (toStateName !== fromStateName) {
                return security.getUserStatus(toStateName, toParams, onProcess, SessionService);
            } else {
                return onProcess();
            }

            //for calendar
            function process1() {
                var str = toState.url.split('?')[0].split('/'),
                    listField = str[str.length - 1];
                if (listField.indexOf(':') !== -1) {
                    var p = listField.replace(':', ''),
                        val = toParams[p];
                    if (!val) {
                        _.each(SBStateService.getCurrentUrl().split('?')[1].split('&'), function (pa) {
                            var s = pa.split('=')
                            if (s[0] === p) {
                                toParams[p] = s[1];
                            }
                        });
                    }
                }
            }

            function onProcess(result) {
                Angularytics.setUser(security.getCurrentUserId(), security.getAnalyticsUserParams());
                ChatService.load(security.crispTokenId, function () {
                    process(result);
                });
            }

            function changeToStateForCollab() {
                // Deal with missing trailing slash for routes for collab from previous version
                var url = SBStateService.getCurrentUrl();
                if ((url.indexOf('/collab/') !== -1 || url.indexOf('/anon/') !== -1) && toStateName === 'public.login') {//url was not found

                    //if url already has / dont change it
                    var str = url.split('?'),
                        p = str[0];
                    if (p[p.length - 1] === '/') {
                        return false;
                    }

                    //see if it requires the trailing slash - if there is a state that matches dont do anything
                    if (match(url)) {
                        return false;
                    }

                    var newUrl = p + '/' + (str.length === 2 ? ('?' + str[1]) : ''),
                        newState = match(newUrl);
                    if (newState) {
                        return {
                            state: newState,
                            url: newUrl
                        };
                    }
                }

                return false;

                function match(path) {
                    var l = SBRegisteredStates.length;
                    for (var i = 0; i < l; i++) {
                        var s = SBRegisteredStates[i],
                            url = s.abstract ? null : s.$$state().url,
                            exp = url ? url._cache.pattern : null;
                        if (exp && path.match(exp)) {
                            return s;
                        }
                    }
                    return false;
                }
            }

            function getStateParams(state, newPath) {
                var nstr = newPath.split('?'),
                    np = split(nstr[0]),
                    q = nstr.length > 1 ? nstr[1] : null,
                    paths = state.$$state().path,
                    pattern = [],
                    patternQ = [],
                    params = {};

                for (var i = 2, n = paths.length; i < n; i++) {//0&1are abstract states
                    var v = paths[i].self.url.split('?');
                    pattern = pattern.concat(split(v[0]));
                    if (i === n - 1 && v.length > 1) {
                        patternQ = v[1].split('&');
                    }
                }
                //get vals for params from path
                for (var i = 0, n = pattern.length; i < n; i++) {
                    var v = pattern[i];
                    if (v.indexOf(':') === 0) {
                        params[v.replace(':', '')] = np[i];
                    }
                }

                var q = nstr.length > 1 ? nstr[1] : null;
                //get vals for params from query
                if (q && q.length > 0) {
                    var q1 = q.split('&');
                    for (var i = 0, n = q1.length; i < n; i++) {
                        var s = q1[i].split('=');
                        if (s.length > 1 && patternQ.indexOf(s[0]) !== -1) {
                            params[s[0]] = s[1];
                        }
                    }
                }

                return params;

                function split(s) {
                    return s ? _.filter(s.split('/'), function (el) {
                        return el !== '';
                    }) : [];
                }
            }

            function process(result) {
                if (result && result.showAppRefresh) {
                    RootEventsService.broadcastRoot('APP_REFRESH');
                }
                var isAuth = security.isAuthenticated();
                if (!security.isUserOrCollab() && !isPublicPage) {//redirect unauth users to login
                    addDefaultParams();
                    if (loggedIn) {
                        loggedIn = false;
                        CPS.popupsService.open(security.Popups.Login, CPS.popupsService.operations.auth, {
                            // redirectState:
                        });
                    } else {
                        return goToPage(security.loginState, true);
                    }
                } else {
                    if (fromStateName === toStateName && !toParams['#']) {
                        return;
                    }

                    addDefaultParams();

                    //todo
                    if (!security.isAuthorized(data)) {
                        //alert('dont have perms to access this page')
                        // return $state.go(isAuth ? 'user.nonauthorized' : 'public.nonauthorized');
                        return goToPage(isAuth ? 'user.nonauthorized' : 'public.nonauthorized', true);
                    }

                    if (security.isCollaborator || (!isAuth && isPublicPage)) {
                        return goToPage(toStateName, false, withstate);
                    } else {
                        //update intercom with the page code name
                        identify();
                        if (isAuth) {
                            // redirect to dashboard
                            if (toStateName === 'public.home') {
                                return goToPage('user.dashboard', true);
                            } else {
                                if (toStateName === security.loginState) {
                                    security.clearCookies();
                                } else if (toStateName === 'public.pricing') {
                                    return goToPage('user.pricing', true);
                                } else if (toStateName === 'public.team-invite' && security.isUser()) {
                                    return goToPage('user.team-invite', true);
                                }

                                /*   else if (toStateName == 'public.view-shared')
                                        return goToPage('product.callsheet.view-shared', true);
                                     else if (toStateName == 'public.confirm-invite')
                                        return goToPage('product.callsheet.confirm-invite', true);
                                  */

                                else {
                                    var gohome = isPublicPage && !SBStateService.isLoginHrefState(toState.url) ||
                                        SBStateService.isBaseHrefState(toState.url);
                                    if (gohome) {
                                        console.log(toState.url);
                                        console.log("on state change: relocating to dashboard: " + configs.baseHref + 'dashboard');
                                        return goToPage('user.dashboard', true);
                                    } else {
                                        return goToPage(toStateName, false);
                                    }
                                }
                            }
                        } else { //not authenticated
                            if (toStateName.indexOf('user.') !== -1 || toStateName.indexOf('admin.') !== -1) {
                                return goToPage(security.loginState, true);
                            }
                        }

                        function identify() {
                            var user = security.getCurrentUser(),
                                userId = user ? user._id : null; // Replace your_user_id with your own if available.
                            Angularytics.setUser(userId);
                            ChatService.setData(user, toStateName);

                            if (userId) {
                                //identify hotjar session
                                try {
                                    if (configs.hotjar && configs.hotjar.enabled && window.hj) {
                                        window.hj('identify', userId, {});
                                    }
                                } catch (e) {
                                }
                            }
                        }
                    }
                }
            }

            function addDefaultParams() {
                toParams.role = security.isCollaborator ? configs.rolePaths.collabPath : (configs.rolePaths.currentUserPath);
                toParams.teamId = security.getCurrentTeamId();
                toParams.companyId = security.getCurrentCompanyId();
            }

            function goToPage(name, notify, withstate) {
                console.log('goToPage: change state from ' + fromStateName + ' to ' + name);

                loggedIn = security.isUserOrCollab();
                return SessionService.setSessionVars(security, onLoaded);

                function onLoaded() {

                    //if same name && withstate -> would have redirected to login
                    if (name === toStateName && !withstate) {//&& name === security.loginState){ already goes to that page
                        return;
                    }

                    var path = SBStateService.getCurrentPath(),
                        url = SBStateService.getCurrentUrl();
                    if (name === security.loginState && path !== '/' && path.indexOf('/login') === -1) {
                        if (url) {
                            toParams.redirectUrl = url;
                        }
                    }

                    /*  if (name === security.loginState) {
                          security.isAuthenticated() ? security.logout() : security.clearCookies();
                      }*/
                    /* return getStateService(transition).target(name, toParams, {
                         notify : notify,
                         priority: 10,
                         location: 'replace'
                     });*/

                    SBStateService.assignUrl(SBStateService.getStateHref(name, toParams, null));
                    //  $state.go('login');
                }
            }
        }
    }

    function onFinishStateChange(transition) {
        var fromState = transition.from(),
            toState = transition.to(),
            toStateName = toState.name,
            params = angular.copy(transition.params());

        if(params.redirectUrl === undefined){
            delete params.redirectUrl;
        }

        console.log('onFinishStateChange: ' + toStateName);

        setBeforeUnload(fromState.data && fromState.data.withDocumentUnload === true ? true : false);

        SBStateService.setRouteState(toState, params, getStateService(transition));
        SBStateService.isRedirecting = false;
        SBStateService.isStaticPage = isPublic(toState.data);

        LCS.updateBody(SBStateService, {
            isCollaborator: security.isCollaborator,
            isAuthenticated: security.isAuthenticated(),
            fromClass: fromState.data ? fromState.data.bodyClass : null,
            toClass: toState.data ? toState.data.bodyClass : null
        });

        LCS.resizePage();

        CPS.setPageSettings(CheatSheetService);
        var name = '';
        if(toStateName.indexOf('public.')!==0) {
            name = RouteCollaboratorsService.reloadCollaboratorsForState(params.productId, toStateName);
        }

        document.title = configs.site.appName + (name ? (': ' + name) : '');

        Angularytics.onPageChanged(toState, fromState, security.getAnalyticsUserParams());

        SBStateService.emitStateChanged(toState);
    }

    function onSuccessStateChange(transition) {
        console.log('onSuccessStateChange: changed state from', transition.from().name, 'to', transition.to().name);
    }

    function getStateService(transition) {
        return transition.router.stateService;
    }

    function isPublic(data) {
        return data.minRole === 0;
    }
}

angular.module('app.state.error.run', [
])

.run(StateErrorProvider);

StateErrorProvider.$inject = ['$state', '$transitions','i18nNotifications'];

function StateErrorProvider($state, $transitions, i18nNotifications) {
    $state.defaultErrorHandler(stateChangeError);
    $transitions.onError({}, onError);

    function onError (transition) {
        stateChangeError(transition.error());
    }

    function stateChangeError(error) {
        if(!error|| error && error.message==="The transition was ignored"){ return;}
        console.log("$stateChangeError: " + error);
        i18nNotifications.pushForCurrentRoute(null, 'errors.route.changeError', i18nNotifications.NOTES_TYPES.ERROR, {}, {rejection: error});
    }
}

angular.module('app.state.loading.service', [
])
    .service('LoadingIndicatorService', LoadingIndicatorService);
LoadingIndicatorService.$inject = ['$document'];

function LoadingIndicatorService ($document) {
    var _this = this,
        body = $document.find("body");

    _this.showLoadingIndicator = showLoadingIndicator;
    _this.hideLoadingIndicator = hideLoadingIndicator;

    function showLoadingIndicator() {
       // console.log('showLoadingIndicator');
        body.append(angular.element('<div id="spinner"><i class="fa fa-spinner fa-pulse fa-3x fa-fw" aria-hidden="true"></i></div>'));
    }

    function hideLoadingIndicator() {
       // console.log('hideLoadingIndicator');
        var spinner = document.getElementById("spinner");
        spinner.parentElement.removeChild(spinner);
    }
}

