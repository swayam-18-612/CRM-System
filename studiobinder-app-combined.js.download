angular.module('security.service', [
    'satellizer.auth',
    'services.sbHttp',
    'services.stateHeadersService',
    'services.sessionEventsService'
    //,'services.socketIO'
])
.service('security', SecurityService);
SecurityService.$inject = ['API_CONFIGS','SatellizerAuth', 'CookiesService', 'SbHttpService', 'SessionEventsService', 'StateHeadersService', 'CurrentLocaleSettings'
//,'SocketIO'
];
function SecurityService( API_CONFIGS, SatellizerAuth, CookiesService, SbHttpService, SessionEventsService, StateHeadersService, CurrentLocaleSettings
 //, SocketIO
) {
    var configs = API_CONFIGS(),
      Popups = {Login: 1, SignUp: 2, RecoverPassword: 3, ResetPassword: 4, BetaSignUp: 5, Logout: 6, PasswordChanged: 7},
      UserRoles = StateHeadersService.UserRoles,
      MemberTypes = {Owner: 2, Admin: 1,  Member: 0},
      Permissions = {View: 1, ViewAndComment: 2, Edit: 3},

    // The public API of the service
      service = {
          loginState: 'public.login',
          canEdit: canEdit,
          canComment: canComment,
          isUserOrCollab: isUserOrCollab,
          currentCompany: null,
          teamId: null,
          paymentFailed: false,
          lowQuota: false,
          Popups: Popups,
          UserRoles: UserRoles,
          MemberTypes: MemberTypes,
          rolePaths: configs.rolePaths,
          Permissions: Permissions,

          currentPathParams: currentPathParams,
          //----------------current user methods ----------------//
          // Information about the current user
          getCurrentUser: getCurrentUser,

          updateCurrentUser: updateCurrentUser,

          getCurrentSessionId: getCurrentSessionId,
          getCurrentUserId: getCurrentUserId,
          getCurrentTeamId: getCurrentTeamId,
          updateCurrentCompany: updateCurrentCompany,
          getCurrentCompanyId: getCurrentCompanyId,
          getCurrentCompany: getCurrentCompany,
          getCurrentUserEmail: getCurrentUserEmail,

          setCurrentUserEmail: setCurrentUserEmail,
          getInitialsByName: getInitialsByName,
          getNameColor: getNameColor,
          getColorForInitials: getColorForInitials,
          getStyleForColor: getStyleForColor,
          // Is the current user authenticated?
          isAuthenticated: isAuthenticated,
          isAuthorized: isAuthorized,
          isCompanyOwner: isCompanyOwner,
          isCompanyAdmin: isCompanyAdmin,
          isCompanyOwnerOrAdmin: isCompanyOwnerOrAdmin,
          isInRole: isInRole,
          isUser: isUser,
          getUserRole: getUserRole,
          getRolePath: getRolePath,
          getRoleFromPath: StateHeadersService.getRoleFromPath,
          //----------------api calls  ---------//
          // Attempt to authenticate a user by the given email and password
          clearCookies: clearCookies,
          loginOauth: loginOauth,
          login: login,
          // Attempt to register a user
          register: register,
          // Logout the current user and redirect
          logout: logout,
          recoverPassword: recoverPassword,
          resetPassword: resetPassword,
          getUserStatus: getUserStatus,
          getHttpHeaders: StateHeadersService.getHttpHeaders,
          redirectUrl: null,
          getSocket: getSocket,
          getSecureResizedImage: getSecureResizedImage,
          getSecureResizedImageWithAttrs: getSecureResizedImageWithAttrs,
          sendGeneratorRequest: sendGeneratorRequest,
          getGeneratorUrl: getGeneratorUrl,
          getAuthorizeHeaders: getAuthorizeHeaders,
          getLogoPath: getLogoPath,
          resizeUploadedImg: resizeUploadedImg,
          getImageExtraInfo: getImageExtraInfo,
          postRequest: SbHttpService.postRequest,
          getRequest: SbHttpService.getRequest,
          getImgPropIdName: getImgPropIdName,
          getImgPropId: getImgPropId,

          getImage: getImage,
          getUserImageComponent: getUserImageComponent,
          getCompanyImage: getCompanyImage,
          getProjectImageComponent: getProjectImageComponent,

          getImgTag: getImgTag,

          getAnalyticsUserParams: getAnalyticsUserParams
      };

    return service;

    function getImageExtraInfo(item, imgProp) {
        return _.extend({
            currentItemId: item._id,
            currentProductId: item.productId
        }, imgProp ? {
            currentItemLogoId: item[imgProp + 'Id'],
            currentItemLogo: item[imgProp] ? resizeUploadedImg(item[imgProp], {width: 600, m: true}) : null,
            currentItemLikes: item.likes
        } : null);
    }

    function getImgPropId(item, prop) {
        return item ? item[getImgPropIdName(prop)] : null;
    }

    function getImgPropIdName(prop) {
        //$ctrl.collectionProp === "materials"
        return prop === "path" ? '_id' : (prop + 'Id');
    }

    function getLogoPath(item, prop, width, withImgBg, defaultImage, isOlder) {
        //studiobinder-callsheet-logo1.svg is the only predefined default image
        var logo = item && item[prop] ? item[prop] : null,
            m = false;
        if (logo) {
            if (getImgPropId(item, prop)) {
                m = true;
            }
        } else if (defaultImage) {
            logo = defaultImage;
            //most likely if has no slashes is older
            if (logo !== 'studiobinder-callsheet-logo1.svg' && logo.indexOf('/') !== -1 && !isOlder) {
                m = true;
            }
        }
        return resizeUploadedImg(logo, {
            width: width,
            withImgBg: withImgBg,
            companyId: getCurrentCompanyId(),
            isOlder: isOlder,
            m: m
        });

        // return configs.imgUrl + getCurrentCompanyId() + '/' + (getImgPropId(item, prop) ? ((productId ? ('projects/' + productId + '/') : '') + 'resize-image') : 'resize-uploaded-image') + '?f=' + logo;
    }

    function resizeUploadedImg(logo, other) {
        return logo ? (configs.imgUrl + configs.SBPredefCompanyId + '/' +
                (other && other.m ? 'resize-image' : 'resize-uploaded-image') +
                '?f=' + logo +
                (other ? ((other.isOlder && !other.width || logo.toLowerCase().endsWith('.svg')) ? '' :
                     (other.width === 'fullsize' ? '' : ('&' + (other.withImgBg&&!other.width ? 'h' : 'w') + '=' + (other.width ? other.width : 200)))) : '')
            ) : null;
    }

    function currentPathParams(params, role) {
        var p = {
            role: role ? role : configs.rolePaths.currentUserPath,
            teamId: getCurrentTeamId(),
            companyId: getCurrentCompanyId()
        };
        if (p) {
            for (var prop in params) {
                p[prop] = params[prop];
            }
        }
        return p;
    }


    function getCurrentUser() {
        return service.isCollaborator ? service.currentCollaborator : SatellizerAuth.getCurrentUser();
    }

    function updateCurrentUser(user, sessionService) {
        console.log('security.updateCurrentUser');
        var u = getCurrentUser();
        if (!u) {
            u = {};
        }
        var changed;
        if (user) {
            if (u.name !== user.name) {
                u.name = user.name;
                changed = true;
            }
            if (u.email !== user.email) {
                u.email = user.email;
                changed = true;
            }
            if (u.phone !== user.phone) {
                u.phone = user.phone;
                changed = true;
            }
            if (u.profilePictureURL !== user.profilePictureURL) {
                u.profilePictureURL = user.profilePictureURL;
                u.profilePictureURLId = user.profilePictureURLId;
                changed = true;
            }
        } else {
            u = null;
            changed = true;
        }
        if (changed) {
            console.log(u);
            CookiesService.setSessionCookieUser(u);
            sessionService.onUserUpdated(u);
        }
    }

    function updateCurrentCompany(item, sessionEventsService) {
        var c = getCurrentCompany();
        if (!c) {
            c = {};
        }
        var changed;
        if (item) {
            if (item.name !== c.name) {
                c.name = item.name;
                changed = true;
            }
            if (item.address !== c.address) {
                c.address = item.address;
                changed = true;
            }
            if (item.logo !== c.logo) {
                c.logo = item.logo;
                c.logoId = item.logoId ? item.logoId : null;
                changed = true;
            }
        } else {
            c = null;
            changed = true;
        }
        if (changed) {
            service.currentCompany = c;
            sessionEventsService.emitUpdateCompany(c);
        }
    }

    function getCurrentSessionId() {
        return SatellizerAuth.getToken();
    }

    function getCurrentUserId() {
        var user = getCurrentUser();
        return user != null ? user._id : 0;
    }

    function getCurrentTeamId() {
        return service.teamId;
    }

    function getCurrentCompanyId() {
        var company = service.currentCompany;
        return company ? company._id : 0;
    }

    function getCurrentUserEmail() {
        var user = getCurrentUser();
        return user != null ? user.email : '';
    }

    function setCurrentCompany(companySession) {
        service.currentCompany = companySession ? companySession.company : null;
        service.companyId = service.currentCompany ? service.currentCompany._id : null;
        service.subscription = companySession ? companySession.subscription : null;
        CurrentLocaleSettings.initCompanySettings(companySession ? companySession.settings : null);
    }

    function getCurrentCompany() {
        return service.currentCompany;
    }

    function setCurrentUserEmail(email) {
        if (email && email !== '') {
            service.email = email;
        }
    }

    function getInitialsByName(name) {
        var init = null;
        var sp = name ? name.toUpperCase().split(' ') : null;
        if (sp != null) {
            if (sp.length > 1) {
                init = '';
                for (var i = 0; i < sp.length; i++) {
                    if (sp[i].length > 0) {
                        init += sp[i][0];
                        if (init.length === 2) {
                            break;
                        }
                    }
                }
            } else if (sp.length === 1) {
                var s = sp[0];
                init = s.length > 2 ? s.substring(0, 2) : s;
            }
        }
        return init;
    }

    function getColorForInitials(init, withoutClass) {
        if (!init) {
            return null;
        }
        var c = withoutClass ? '' : 'l l', l = init.length;
        for (var i = 0; i < l; i++) {
            c += parseInt((91 - init.charCodeAt(i)) / 5, 10);
        }
        if (l === 1) {
            c += '0';
        }
        return c;
    }

    function getStyleForColor(init) {
        var s = 'color:#fff;';
        switch (getColorForInitials(init, true)) {
            case '00':
                return s + 'border-color: #8F124D; background-color: #8F124D';
            case '01':
                return s + 'border-color: #991287; background-color: #991287';
            case '02':
                return s + 'border-color: #F1C40F; background-color: #F1C40F';
            case '03':
                return s + 'border-color: #FF1B79; background-color: #FF1B79';
            case '04':
                return s + 'border-color: #00B6AD; background-color: #00B6AD';
            case '05':
                return s + 'border-color: #9137CC; background-color: #9137CC';
            case '10':
                return s + 'border-color: #A42077; background-color: #A42077';
            case '11':
                return s + 'border-color: #D6145F; background-color: #D6145F';
            case '12':
                return s + 'border-color: #F39C12; background-color: #F39C12';
            case '13':
                return s + 'border-color: #0ACDB6; background-color: #0ACDB6';
            case '14':
                return s + 'border-color: #F87117; background-color: #F87117';
            case '15':
                return s + 'border-color: #FFAB75; background-color: #FFAB75';
            case '20':
                return s + 'border-color: #4C81FF; background-color: #4C81FF';
            case '21':
                return s + 'border-color: #2D355B; background-color: #2D355B';
            case '22':
                return s + 'border-color: #7233D5; background-color: #7233D5';
            case '23':
                return s + 'border-color: #6C7A92; background-color: #6C7A92';
            case '24':
                return s + 'border-color: #1ABC9C; background-color: #1ABC9C';
            case '25':
                return s + 'border-color: #F1536F; background-color: #F1536F';
            case '30':
                return s + 'border-color: #C41388; background-color: #C41388';
            case '31':
                return s + 'border-color: #3498DB; background-color: #3498DB';
            case '32':
                return s + 'border-color: #E73535; background-color: #E73535';
            case '33':
                return s + 'border-color: #6164FF; background-color: #6164FF';
            case '34':
                return s + 'border-color: #7857FF; background-color: #7857FF';
            case '35':
                return s + 'border-color: #05B477; background-color: #05B477';
            case '40':
                return s + 'border-color: #C0175F; background-color: #C0175F';
            case '41':
                return s + 'border-color: #6538CE; background-color: #6538CE';
            case '42':
                return s + 'border-color: #373D5C; background-color: #373D5C';
            case '43':
                return s + 'border-color: #FF3B80; background-color: #FF3B80';
            case '44':
                return s + 'border-color: #7884CD; background-color: #7884CD';
            case '45':
                return s + 'border-color: #38A0FA; background-color: #38A0FA';
            case '50':
                return s + 'border-color: #FF5C6F; background-color: #FF5C6F';
            case '51':
                return s + 'border-color: #FF694D; background-color: #FF694D';
            case '52':
                return s + 'border-color: #FF6853; background-color: #FF6853';
            case '53':
                return s + 'border-color: #FBA026; background-color: #FBA026';
            case '54':
                return s + 'border-color: #BF1B54; background-color: #BF1B54';
            case '55':
                return s + 'border-color: #2C1F60; background-color: #2C1F60';
        }
        return '';
    }

    function getNameColor(name) {
        return name ? getColorForInitials(getInitialsByName(name)) : null;
    }

    function getCompanyImage(size, cls) {
        var c = service.getCurrentCompany();
        return getImage(c, cls, 'logo', size, {
            withSquareImg: true,
            avatar: 'company',
            iconPaths: getISBPath(3)
        });

        function getISBPath(max) {
            return (new Array(max ? max : 2)).fill(null).map(function (el, i){return ' <span class="sbp p'+(i+1)+'"></span>';}).join('');
        }
    }
    function getUserImageComponent(item, imgSize, p) {
        return getImgTag(item, imgSize, 'user', 'profilePictureURL', 'circle', p);
    }

    function getProjectImageComponent(item, imgSize, p) {
        return getImgTag(item, imgSize,  'project', 'logo', 'square', ' without-initials="true" ' + (p || ''));
    }

    function getImgTag(item, imgSize, icon, prop, type, p) {
        return '<sb-resizable-img item="::' + item + '" img-size="' + imgSize + '" ' + (icon ? ('icon="' + icon + '"') : '') + ' img-prop="' + prop + '" area-type="' + type + '" size="::null" img-observer-service="::$ctrl.imgObserverService" load-later="true" ' + (p ? p : '') + '></sb-resizable-img>';
    }

    function getImage(item, cls, prop, size, p) {
        if (!item) {
            return '';
        }
        var logo = service.getLogoPath(item, prop, size),
            name = item.hideColor ? '' : item.name,
            img = (logo ? ('<img class="' +
                        (p && p.noImgCls ? '' : ('featured-image' + (p && p.imgClass ? (' ' + p.imgClass) : ''))) +
                        '" src="' + logo + '">') :
                    (name ? ('<div class="avatar ' +
                            (p && p.imgClass ? (' ' + p.imgClass) : '') +
                            service.getNameColor(name) +
                            '">' +
                            (p && p.avatar ? ('<div class="sbf ' + p.avatar + '">' + (p.iconPaths ? p.iconPaths : '') + '</div>') :
                                service.getInitialsByName(name)) +
                            '</div>') : ''
                    )
            );
        return '<div ' + (p && p.id ? ('id="' + p.id + '" ') : '') +
            'class="thumb-sm ' + (cls || '') + (p && p.radiusCls ? '' : (p && p.withSquareImg ? ' with-radius-square' : ' with-radius')) + '" ' +
            (p && p.tooltip ? ('tooltip-placement="bottom" tooltip-html="\'' + p.tooltip + '\'"') : '') +
            '>' + (p && p.withWrap ? ('<div class="imgwrap resized-wrapped">' + img + '</div>') : img) + '</div>';
    }

    function isAuthenticated() {
        if (service.isCollaborator) {
            return false;
        }
        return CookiesService.isAuthenticatedUser();
    }

    function getSocket() {
        return isAuthenticated() ? service.socketUIO : service.socketCIO;
    }

    function isInRole(role) {
        if (service.isCollaborator) {
            return role === UserRoles.Collaborator;
        } else {
            if (isAuthenticated()) {
                var user = getCurrentUser();
                return user != null && user.role >= role;
            }
        }
        return false;
    }

    function isAdmin() {
        return isInRole(UserRoles.Admin);
    }

    function isUser() {
        return isInRole(UserRoles.User);
    }

    function getUserRole() {
        if (service.isCollaborator) {
            return UserRoles.Collaborator;
        }
        if (isAuthenticated()) {
            var user = getCurrentUser();
            if (user != null && user.role !== null) {
                return user.role;
            } else {
                return UserRoles.User;
            }
        }
        return UserRoles.Guest;
    }

    function getRolePath(role) {
        if (!role) {
            role = getUserRole();
        }
        switch (role) {
            case UserRoles.Admin:
              //  return configs.rolePaths.adminPath;
            case UserRoles.User:
                return configs.rolePaths.currentUserPath;
            case UserRoles.Collaborator:
                return configs.rolePaths.collabPath;
        }
        return '';
    }

    function clearCookies() {
        CookiesService.clearCookies();
    }

    function loginOauth(provider, onsuccess, onerror) {
        SatellizerAuth.authenticate(provider, onsuccess, onerror);
    }

    function login(user, onsuccess, onerror) {
        SatellizerAuth.login({email: user.email, password: user.password, role: user.role}, function (res) {
            var data = res.data;
            if (data) {
                if (data.paymentFailed) {
                    service.paymentFailed = data.paymentFailed;
                }
                if (data.lowQuota) {
                    service.lowQuota = data.lowQuota;
                }
                service.memberType = data.memberType;

                initSesionData(data, true);
            }
            return onsuccess(data);
        }, onerror);
    }

    function getAnalyticsUserParams(){
        var u = getCurrentUser();
        return {
            username: u ? u.name : null,
            userid: getCurrentUserId(),
            companyname: service.currentCompany ? service.currentCompany.name : null,
            companyid: service.currentCompany ? service.currentCompany._id : null,

            isCollaborator: service.isCollaborator,
            isAuthenticated: service.isAuthenticated()
        }
    }

    function getInitHeaders() {
        return {
            'x-company-id': service.getCurrentCompanyId(),
            'x-team-id': service.teamId,
            'x-role': service.role,
            'x-member-type': service.memberType
        };
    }

    function initSesionData(data, initHeaders) {
        service.permission = Permissions.Edit; //todo: set permissions on server side
        service.isCollaborator = false;
        service.role = UserRoles.User;
        service.teamId = data.teamId;
        var user = data.user;
        if (user){
            service.role = user.role;
        }
        setCurrentCompany(data.companySession);

        if (initHeaders) {
            StateHeadersService.stateHeaders = getInitHeaders();
        }
    }

    function createSocket(socket) {
        if (!(socket && socket.teamId === service.teamId)) {
            disconnectSocket(socket);
            socket = new SocketIO(getRolePath(service.role), StateHeadersService.stateHeaders, onSuccess, onError);
        }

        return socket;

        function onSuccess(socketId) {
        }

        function onError() {

        }
    }

    function disconnectSocket(socket) {
        if (socket) {
            socket.forceDisconnect();
            socket = null;
        }
    }

    function register(signupType, user, onsuccess, onerror) {
        SatellizerAuth.signup(signupType === Popups.BetaSignUp, user, onReqSuccess, onerror);

        function onReqSuccess(res) {
            var data = res.data;
            service.companies = data.companies;
            service.memberType = data.memberType;
            initSesionData(data, true);
            return onsuccess(data);
        }
    }

    function logout(onsuccess, onerror, type) {
        return SbHttpService.postRequest('/auth/logout', null, StateHeadersService.stateHeaders, onReqSuccess, onReqError);

        function onReqSuccess() {
            disconnectSocket();
            SatellizerAuth.logout(type);
            if (typeof (onsuccess) === 'function') {
                onsuccess();
            }
        }

        function onReqError(error) {
            console.log(error);
            if (typeof (onerror) === 'function') {
                return onerror(error);
            }
        }
    }

    function recoverPassword(email, onsuccess, onerror) {
        SbHttpService.postRequest('/auth/recoverPassword', {email: email}, StateHeadersService.stateHeaders, onsuccess, onerror);
    }

    function resetPassword(params, onsuccess, onerror) {
        return SbHttpService.postRequest('/auth/resetPassword', params, StateHeadersService.stateHeaders, onReqSuccess, onerror);

        function onReqSuccess(response) {
            logout(onsuccess, onerror, '/passwordChanged');
        }
    }


    function getSecureResizedImageWithAttrs(path, attrs, onsuccess, onerror) {
        if (!attrs) {
            attrs = {};
        }

        var query = {};
        if (attrs.w) {
            try {
                query.w = parseInt(attrs.w,10);
            } catch (e) {
            }
        }
        if (attrs.h) {
            try {
                query.h = parseInt(attrs.h,10);
            } catch (e) {
            }
        }
        if (attrs.q) {
            try {
                query.t = parseInt(attrs.q,10);
            } catch (e) {
            }
        }
        if (attrs.c) {
            try {
                query.c = parseInt(attrs.c,10);
            } catch (e) {
            }
        }//compression
        if (attrs.t) {
            query.t = attrs.t;
        }
        if (attrs.p) {
            query.p = 1;
        }//progressive

        var original = attrs.original && attrs.original.toLowerCase() !== 'false' ? true : false;
        var fromUrl = attrs.fromUrl && attrs.fromUrl.toLowerCase() !== 'false' ? true : false;
        var url = (original ? 'fetch' : 'resize') + '-' + (fromUrl ? 'url' : 's3') + '-image?f=' + encodeURIComponent(path);
        if (query) {
            for (var prop in query) {
                var p = query[prop];
                if (p) {
                    url += '&w=' + p;
                }
            }
        }
        service.getSecureResizedImage(configs.imgUrl + url, onsuccess, onerror);
    }

    function getSecureResizedImage(url, onsuccess, onerror) {
        var headers = getInitHeaders();
        headers.accept = 'image/*,*/*;q=0.8';
        var inv = StateHeadersService.stateHeaders['x-invitation-id'];
        if (inv) {
            headers['x-invitation-id'] = inv;
        }

        headers = CookiesService.setAuthorizationHeader(headers);
        delete headers['x-invitation-id'];
        if (headers.Authorization) {
            headers.Authorization += '_split_' + headers['x-company-id'];
        }

        SbHttpService.simpleHttpRequest({
            method: 'GET',
            url:   url,
            headers: headers,
            responseType: 'arraybuffer',
            cache: true,
        }, function (response) {
            onsuccess(URL.createObjectURL(new Blob([response.data], {type: response.headers('Content-Type')})));
        }, onerror);
    }

    function getUserStatus(state, params, onsuccess, SessionService) {
        var headers = service.getHttpHeaders(state, params);
        var h =headers;

        var token = CookiesService.getCookie('token');
        if(StateHeadersService.isPagePublic(state) && token ){
            var rs = CookiesService.getPayload(token);
            if(rs && headers['x-role' ] === service.UserRoles.Guest && rs.role !== service.UserRoles.Guest ){
                headers['x-role'] = rs.role;
            }
            h = _.extend({}, headers, {Authorization: 'Bearer ' + token});
        }

        return SbHttpService.getRequest('/auth/status', h, onReqSuccess, onReqError);

        function onReqSuccess(response) {
            var data = response.data;

            if (!CookiesService.isFingerprintTimestamp(data.fingerprintTimestamp)) {
                data.showAppRefresh = true;
            }

            service.companies = data.companies;
            service.companyId = data.companyId;
            service.role = data.role;
            service.teamId = data.teamId;
            service.permission = data.permission;
            service.memberType = data.memberType;

            setCurrentCompany(data.companySession);

            StateHeadersService.stateHeaders = headers;

            if (data.role === UserRoles.Collaborator) {
                service.isCollaborator = true;
                service.currentCollaborator = data.createdBy;
            } else {
                service.isCollaborator = false;
                service.currentCollaborator = null;
                if (isAuthenticated()) {
                    headers['x-team-id'] = getCurrentTeamId();
                    headers['x-company-id'] = getCurrentCompanyId();
                    if (!data.createdBy ||
                        data.role !== UserRoles.Admin && getUserRole() === UserRoles.Admin ||
                        service.getCurrentUserId() !== data.createdBy._id ) {
                        SatellizerAuth.logout();
                        data.changed = true;
                    }
                    service.updateCurrentUser(data.createdBy, SessionService);
                }
            }

            //createSocket(getSocket());
            console.log('getUserStatus');
            console.log(headers);

            return onsuccess(data);
        }

        function onReqError(error) {
            console.log(error);


           /* if (!CookiesService.isFingerprintTimestamp(data.fingerprintTimestamp)) {
                data.showAppRefresh = true;
            }*/

            disconnectSocket(getSocket());
            StateHeadersService.stateHeaders = {};
            console.log('getUserStatus error: ');
            service.isCollaborator = false;
            service.currentCollaborator = null;
            service.permission = 0;
            service.memberType = 0;
            service.role = 0;
            var res = {status: false};
            if (isAuthenticated() && error && error.message === 'You did not provide a JSON Web Token in the Authorization header. Please refresh the page and retry.') {
                SatellizerAuth.logout();
                res.changed = true;
            }
            return onsuccess(res);
        }
    }

    function canEdit() {
        return isUserOrCollab() && service.permission >= Permissions.Edit;
    }

    function canComment() {
        return isUserOrCollab() && service.permission >= Permissions.ViewAndComment;
    }

    function isUserOrCollab() {
        return isAuthenticated() || service.isCollaborator;
    }

    function isCompanyOwner() {
        return isCompanyRole(MemberTypes.Owner);
    }

    function isCompanyAdmin() {
        return isCompanyRole(MemberTypes.Admin);
    }

    function isCompanyOwnerOrAdmin(){
        return isCompanyOwner() || isCompanyAdmin();
    }

    function isCompanyRole(memberType) {
        return isAuthenticated() && service.memberType >= memberType;
    }

    function isAuthorized(data) {
        switch(data.minRole){
            case UserRoles.Guest:
                return true;

            case UserRoles.Collaborator:
                return isUserOrCollab();

            case UserRoles.User:
                return isCompanyRole(data.minMemberType);
        }
        return false;
    }

    function getAuthorizeHeaders() {
        return CookiesService.setAuthorizationHeader(_.extend({}, StateHeadersService.stateHeaders));
    }

    function getGeneratorUrl() {
        return configs.sbApi.url;
    }

    function sendGeneratorRequest(path, postParams, onSuccess, onError, fullResult, timeout, otherHeaders) {
        //console.log('sendGeneratorRequest')
        //"content-type":'ion/json', "Accept":"application/json, text/plain, */*"
        var headers =  _.extend({}, getAuthorizeHeaders(), otherHeaders);
        delete headers['x-invitation-id'];

        SbHttpService.postRequest(getGeneratorUrl() + path, postParams, headers, onsuccess, onerror, null, timeout);

        function onsuccess(result) {
            if (result) {
                if (result.error) {
                    onError(result.error);
                } else {
                    onSuccess(fullResult ? result : result.data);
                }
            } else {
                onError(result.error);
            }
        }

        function onerror(error) {
            onError(error ? error.data : error);
        }
    }
}

function getSBEvent(){
   return Array.from(document.querySelectorAll('*'))
        .reduce(function(pre, dom){
            var evtObj = getEventListeners(dom)
            Object.keys(evtObj).forEach(function (evt) {
                if (typeof pre[evt] === 'undefined') {
                    pre[evt] = 0
                }
                pre[evt] += evtObj[evt].length
            })
            return pre
        }, {});
}

function getSBEvents1(){
    var listeners = (function listAllEventListeners() {
        var elements = [];
        var allElements = document.querySelectorAll('*');
        var types = [];
        for (var ev in window) {
            if (/^on/.test(ev)) types[types.length] = ev;
        }

        for (var i = 0, l = allElements.length; i < l; i++) {
            var currentElement = allElements[i];
            for (var j = 0; j < types.length; j++) {
                if (typeof currentElement[types[j]] === 'function') {
                    elements.push({
                        "node": currentElement,
                        "listeners": [ {
                            "type": types[j],
                            "func": currentElement[types[j]].toString(),
                        }]
                    });
                }
            }
        }

        return elements.filter(function(element){return element.listeners.length;});
    })();

    console.table(listeners);
}

function getSBEvents2(){
    const findAllChildren = (e, ee = []) => {
        const children = [...e.children]
        ee.push(...children)
        children.forEach(c => findAllChildren(c, ee))
        return ee
    }
    const allElements = [window, ...findAllChildren(document.body)]
    const mapToEntry = e => [e, Object.values(getEventListeners(e)).flat().length]

    const prev = allElements.map(mapToEntry)

    const next = allElements.map(mapToEntry)

    const increased = prev
        .map(([e, count], i) => [e, count, next[i][1]])
        .filter(([_, prevCount, nextCount], i) => prevCount < nextCount)

    console.table(
        increased.map(([element, prevCount, nextCount]) => ({
            element,
            prevCount,
            nextCount
        }))
    )

}
angular.module('services.assessWatchers', [])
.service('AssessWatchersService', AssessWatchersService);

AssessWatchersService.$inject = ['LCS'];
function AssessWatchersService(LCS) {
    var WatchersVars = {
        id: 'refreshWatcherInfo_123asdaiu9',
        minHeight: "30px",
        minWidth: "260px",
        maxHeight: "600px",
        maxWidth: "600px"
    };

    return {
        loadWatchersContainer: loadWatchersContainer,
        getElementWatchers: getElementWatchers,
        removeElementWatchers:removeElementWatchers,
        processElementListeners: processElementListeners,

        getEvents: getEvents
    };

    function loadWatchersContainer(isDebug) {
        if(!isDebug){ return;}

        loadWatchers();
    }

    function removeElementWatchers(root) {
        root = angular.element(root || document.documentElement);
        var watchers = getElWatchers(root);
        var wl = watchers.length;
        if(wl>0){
            for (var i = wl-1; i >= 0; i--) {
                var t = watchers[i];
                if(typeof(t) === 'function') {t();}
                else if(typeof(t.fn) === 'function' ){t.fn();}
                //console.log('removeWatcher');
            }
        }
        return wl;
    }

    function getElementWatchers(root) {
        root = angular.element(root || document.documentElement);

        return getElWatchers(root);
    }

    function getWatchers(root) {
        root = angular.element(root || document.documentElement);
        return getWatcherExpressions(root);
    }

    function getWatcherExpressions(element) {
        var watchers = getElWatchers(element);
        var watchlist = {
            '_total': watchers.length
        };
        angular.forEach(watchers, function (watcher) {
            watchlist[watcher.exp] = watchlist[watcher.exp] || [];
            watchlist[watcher.exp].push(watcher);
        });
        return watchlist;
    }

    function getElWatchers(element) {
        var isolateWatchers = getWatchersFromScope(element.data().$isolateScope);
        var scopeWatchers = getWatchersFromScope(element.data().$scope);
        var watchers = scopeWatchers.concat(isolateWatchers);
        angular.forEach(element.children(), function (childElement) {
            watchers = watchers.concat(getElWatchers(angular.element(childElement)));
        });
        return watchers;
    }

    function getWatchersFromScope(scope) {
        if (scope) {
            return scope.$$watchers || [];
        } else {
            return [];
        }
    }

    function toggleWatchers() {
        var container = document.getElementById(WatchersVars.id);
        var height = container.style.height;
        var width = container.style.width;

        if (width === WatchersVars.minWidth) {
            container.style.height = WatchersVars.maxHeight;
            container.style.width = WatchersVars.maxWidth;
        } else {
            container.style.height = WatchersVars.minHeight;
            container.style.width = WatchersVars.minWidth;
        }
        refreshWatcherInfo();
    }

    function refreshWatcherInfo() {
        var arr = [],
            container = document.getElementById(WatchersVars.id);
        if (!container) {
            container = document.createElement('div');
            container.setAttribute("id", WatchersVars.id);
            container.setAttribute("style", "position:fixed; left:0px; bottom: 0px; padding:0px; z-index:99999;background:rgba(0,0,0,0.8);overflow: auto;");
            container.setAttribute("class", "hidden-print hide-ipad");

            container.style.height = WatchersVars.minHeight;
            container.style.width = WatchersVars.minWidth;

            container.style.maxHeight = WatchersVars.maxHeight;
            container.style.maxWidth = WatchersVars.maxWidth;

            document.body.insertBefore(container, document.body.firstChild);
        }

        var watchers = getWatchers();
        var keys = Object.keys(watchers);
        for (var i = 0; i < keys.length; i++) {
            var key = keys[i];
            var val = watchers[key];
            if (Object.prototype.toString.call(val) === '[object Array]') {
                val = val.length;
            }
            arr.push([val, key]);
        }

        arr.sort(function (a, b) {
            return b[0] - a[0];
        });

        var html = '<style>#wtccnt th, #wtccnt td{font-size:14px; color:yellow;text-align:left;border:1px gray solid;padding:2px;} #wtccnt th {white-space: nowrap;} #recount, #openClose {color:lightblue;text-decoration:underline;text-align:right;cursor: pointer;}</style>';

        html +=  '<div><a id="recount">Recount</a> <a id="openClose">Toggle</a><a id="annotate">annotate</a><a id="listeners">listeners</a></div>' ;

        html += '<table id="wtccnt">';
        html += '<tr><td>Count</td><td>Element</td></tr>';
        for (var k = 0; k < arr.length; k++) {
            var row = arr[k];
            html += ['<tr><th><b>', row[0], '</b></th><td>', row[1].substring(0, 200), '...</td></tr>'].join('');
        }
        html += '</table>';


        container.innerHTML = html;

        var isBind = true;
        LCS.bindElementListeners(isBind, document.getElementById('openClose'), toggleWatchers);
        LCS.bindElementListeners(isBind, document.getElementById('recount'), refreshWatcherInfo);
        LCS.bindElementListeners(isBind, document.getElementById('annotate'), function () {
            annotateWatchers(document.documentElement);
        });
        LCS.bindElementListeners(isBind, document.getElementById('listeners'), refreshListeners);
    }

    function loadWatchers() {
        refreshWatcherInfo();
        LCS.bindElementListeners(true, window, hasChange, 'hashchange');
    }

    function hasChange() {
        LCS.timeout(refreshWatcherInfo, 2500)
    }

    function annotateWatchers(elem) {
        elem = angular.element(elem);
        var selfWatchers = countWatchers(elem),
            totalWatchers = selfWatchers;
        angular.forEach(elem.children(), function(child) {
            totalWatchers += annotateWatchers(child);
        });
        elem.attr('data-watchers', selfWatchers + ',' + totalWatchers);
        return totalWatchers;
    }

    function countWatchers(elem) {
        if (!elem || !elem.data) {
            return 0;
        }
        return countScopeWatchers(elem.data().$scope) + countScopeWatchers(elem.data().$isolateScope);
    }

    function countScopeWatchers(scope) {
        if (!scope || !scope.$$watchers) {
            return 0;
        }
        return scope.$$watchers.length;
    }

    function getElementListeners(selector) {
        return Array.prototype.slice.call(document.querySelectorAll(selector ? selector : '*')).map(function (element) {
            var listeners = getEventListeners(element);
            return {
                element: element,
                listeners: Object.keys(listeners).sort().map(function (k) {
                    return {event: k, listeners: listeners[k]};
                })
            };
        }).filter(function (item) {
            return item.listeners.length;
        });
    }

    function processElementListeners(selector){
        var items = getElementListeners(selector);
        // Things you can do with the items

// 1. log them to the console
        console.log(items);


// 2. Put a red border around the elements
        items.forEach(function(item) {
            item.element.style.outline = '1px solid red';
        });

// 3. generate a summary
        var summary =items.map(function(item) {
            var el = item.element,
                id = el.id,
                className = el.className;
            if (className instanceof SVGAnimatedString) {
                className = className.baseVal;
            }
            var str = el.tagName.toLowerCase() + (id ? '#' + id : '') + (className ? '.' + className.replace(/\s+/g, '.') : '');
            str += ' ' + item.listeners.map(function(l) {
                return l.event + ': ' + l.listeners.length;
            }).join(' ');
            return str;
        }).join('\n');

        console.log(summary);
    }

    function refreshListeners() {
        var elem =  getEvents();
    }

    function _isEvent(prop) {
        if (0 !== prop.indexOf('on')) {
            return false;
        }

        return true;
    }

    function _getEvents(obj) {
        var result = [];

        for (var prop in obj) {
            if (_isEvent(prop)) {
                prop = prop.substr(2); // remove "on" at the beginning
                result.push(prop);
            }
        }

        return result;
    }
    function getEvents() {
        var result = {};

        result['window'] = _getEvents(window, hasOwnProperty);

        var  arr = Object.getOwnPropertyNames(window);

        for (var i = 0; i < arr.length; i++) {
            var element = arr[i],  resultArray = [];

            try {
                var obj = window[element];

                if (!obj || !obj['prototype']) {
                    continue;
                }

                proto = obj['prototype'];

                resultArray = _getEvents(proto);

            } catch (err) {
                // console.error(`failed to get events of %o`, element);
            }

            result[element] = resultArray;
        }

        return result;
    }
}
