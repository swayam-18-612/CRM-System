angular.module('components.feed.sidebarFeedBlog.directive', [
    'components.feed.sidebarFeed.model',
    'services.blocksSetup'
])
.component('sidebarFeedBlog', {
    controller: 'SidebarFeedBlogCtrl',
})
.controller('SidebarFeedBlogCtrl', SidebarFeedBlogCtrl);
SidebarFeedBlogCtrl.$inject = ['SidebarFeedModel', 'BlocksSetupEventsService', 'TemplateCompileService', '$element'];

function SidebarFeedBlogCtrl(SidebarFeedModel, BlocksSetupEventsService, TemplateCompileService, $element) {
    //console.log('SidebarFeedBlogCtrl');
    var watchers = [];

    var $ctrl = this;
    $ctrl.TemplateCompileService = TemplateCompileService;
    $ctrl.BlocksSetupEventsService = BlocksSetupEventsService;
    $ctrl.SidebarFeedModel = SidebarFeedModel;

    $ctrl.$element = $element;
    $ctrl.element = $ctrl.$element[0];

    $ctrl.$onInit = $onInit;
    $ctrl.onInitOther = onInitOther;
    $ctrl.$onDestroy = $onDestroy;
    $ctrl.getItemTemplate = getItemTemplate;

    function $onInit() {
              if($ctrl.onInitOther){
                  $ctrl.onInitOther();
              }

        $ctrl.BlocksSetupEventsService.onClearFeed(watchers, $ctrl.closeAll);
    }

    function onInitOther(){
        //use defaultSources
        $ctrl = $.extend($ctrl, new $ctrl.SidebarFeedModel(new ObjectId().toString(), null, reloadTemplate));
        reloadTemplate();
        $ctrl.loadSources();
    }

    function $onDestroy() {
        if ($ctrl.templateCompile) {
            $ctrl.templateCompile.destroyNewScope();
        }
        while (watchers.length) {
            var el = watchers.shift();
            if (el) {
                if (typeof (el.dispose) === 'function') {
                    el.dispose();
                } else {
                    el();
                }
            }
        }
    }

    function reloadTemplate() {
        if(!$ctrl.templateCompile) {
            $ctrl.templateCompile = new $ctrl.TemplateCompileService($ctrl.$element, $ctrl.getItemTemplate, $ctrl);
        }
        $ctrl.templateCompile.loadTemplate();
    }

    function getItemTemplate() {
        if(!$ctrl.isLoaded){return '<div class="with-side-padding h-full"><preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center></div>';}
return '<div class="with-side-padding">' +
            '<div>' +
                '<div ng-if="::feed.entries" class="feed-entries" ng-repeat="feed in ::$ctrl.feeds | orderBy: \'order\' track by feed.id">' +
                    '<div ng-bind="::feed.title" class="todo-column-title spacing-half-bottom full-width"></div>' +
                    '<tutorial-post ng-repeat="item in ::feed.entries" item="::item" feed-id="::feed.id" on-open="$ctrl.open(feed.id, item)"></tutorial-post>' +
                '</div>' +
            '</div>' +
        '</div>';
    }
}

angular.module('components.feed.sidebarFeed.model', [
    'components.feedList.service'
])
.service('SidebarFeedModel', SidebarFeedModel);

SidebarFeedModel.$inject = ['FeedListService'];

function SidebarFeedModel(FeedListService) {
    var SidebarFeedModel = function (dirid, sources, onLoaded) {
        //console.log('SidebarFeedModel: ' + dirid);
        this.defaultSources = FeedListService.defaultSources;
        this.sources = sources ? sources : this.defaultSources;
        this._sources = FeedListService.getSources(this.sources ? this.sources : undefined);
        this.isLoaded = false;
        this.loadedCount = 0;
        this.feeds = [];
        this.dirid = dirid ? dirid : new ObjectId().toString();
        this.onCtrlLoaded = function () {
           return onLoaded(this);
        };
    };

    SidebarFeedModel.prototype.getRandomIndex = function (l) {
        return FeedListService.getRandomNumber(l - 1);
        // return Math.floor(Math.random() *  l);
    };

    SidebarFeedModel.prototype.loadSources = function () {
        var _this = this;
        console.log('SidebarFeedModel.loadSources' + _this.dirid);
        FeedListService.onLoad(_this.dirid, onLoad);
        FeedListService.get(_this.dirid, _this._sources);

        function onLoad(feed) {
            console.log('Resource.onLoad ' + _this.dirid);
            if (feed && feed.entries && feed.entries.length > 0) {
                var exists = false;
                for (var i = 0, l = _this.feeds.length; i < l; i++) {
                    if (_this.feeds[i].id === feed.id) {
                        _this.feeds[i] = feed;
                        exists = true;
                        break;
                    }
                }
                if (!exists) {
                    _this.feeds.push(feed);
                }
                _this.getUnopened();
            }

            _this.loadedCount++;
            if (!_this.isLoaded && _this.sources && _this.sources.length > 0 && _this.loadedCount === _this.sources.length) {
                _this.isLoaded = true;
                console.log('onCtrlLoaded1');
                if (typeof (_this.onCtrlLoaded) === 'function') {
                    _this.onCtrlLoaded();
                }
            }
        }
    };

    SidebarFeedModel.prototype.open = function (feedId, item) {
        var _this = this;
        window.open(item.linkurl + '?utm_campaign=sb_app', '_blank');
        if (!item.open) {
            _this.openLink(feedId, item);
            _this.getUnopened();
        }
    };

    SidebarFeedModel.prototype.getUnopened = function () {
        var _this = this;
        FeedListService.getUnopened(_this._sources);
    };

    SidebarFeedModel.prototype.openLink = function (feedId, item) {
        var _this = this;
        FeedListService.open(_this._sources, feedId, item);
        item.open = true;
    };

    SidebarFeedModel.prototype.closeAll = function () {
        var _this = this;
        if (_this.feeds && _this.feeds.length > 0) {
            _this.feeds.forEach(function (feed) {
                _.filter(feed.entries, function (item) {
                    if (!item.open) {
                        _this.openLink(feed.id, item);
                    }
                });
            });
            FeedListService.setNewFeedItemsCount(0);
        }
    };

    return SidebarFeedModel;
}

angular.module('components.tutorialFeedPost.directive', [
    'components.feed.sidebarFeed.model'
])
.component('tutorialFeedPost',  {
    controller: 'TutorialFeedPostCtrl',
    bindings: {
        sources:"<"
    }
})
.controller('TutorialFeedPostCtrl', TutorialFeedPostCtrl);
TutorialFeedPostCtrl.$inject = ['TemplateCompileCompCtrlService', 'SidebarFeedModel', '$element'];

function TutorialFeedPostCtrl(TemplateCompileCompCtrlService, SidebarFeedModel, $element) {
    //console.log('TutorialFeedPostCtrl');
    var $ctrl = this;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;

    $ctrl.onLoaded = onLoaded;

    $ctrl.next = next;
    $ctrl.previous = previous;
    $ctrl.isFirst = isFirst;
    $ctrl.isLast = isLast;
    $ctrl.changeFeed = changeFeed;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        $ctrl = $.extend($ctrl, new SidebarFeedModel(new ObjectId().toString(), $ctrl.sources, $ctrl.onLoaded));
    }

    function postInit() {
        $ctrl.loadSources();
    }

    function next(e) {
        $ctrl.preventDefault(e);
        $ctrl.changeFeed($ctrl.selectedIndex < $ctrl.feeds.length - 1 ? $ctrl.selectedIndex + 1 : 0);
    }

    function previous(e) {
        $ctrl.preventDefault(e);
        $ctrl.changeFeed($ctrl.selectedIndex > 0 ? $ctrl.selectedIndex - 1 : $ctrl.feeds.length - 1);
    }

    function isFirst() {
        return $ctrl.selectedIndex === 0;
    }

    function isLast() {
        return $ctrl.selectedIndex === $ctrl.feeds.length - 1;
    }

    function changeFeed(i) {
        $ctrl.selectedIndex = i;
        $ctrl.feed = $ctrl.feeds[i];
        $ctrl.reloadTemplate();
    }

    function getItemTemplate() {
        if(!$ctrl.isLoaded){return '<preloader-center class="preloader"></preloader-center>';}
        if(!$ctrl.feed){return '';}
return '<div>' +
            '<div class="feed-entries">' +
                '<div class="table-div spacing-half-bottom full-width">' +
                    ($ctrl.feeds.length>1 ? ('<div class="col20 centered"><a class="bigarrow circled-arrow gray-light '+($ctrl.isFirst()?'disabled':'')+'" ng-click="$ctrl.previous($event)">' +
                        $ctrl.LCS.getISBDiv('arrow-left-circle') +
                        '</a></div>') :'') +
                    '<div class="centering type centered">'+$ctrl.feed.title+'</div>' +
                    ($ctrl.feeds.length>1 ? ('<div class="col20 centered"><a class="bigarrow circled-arrow gray-light " ng-click="$ctrl.next($event)">' +
                        $ctrl.LCS.getISBDiv('arrow-right-circle') +'</a></div>'):'') +
                '</div>' +
                '<tutorial-post ng-repeat="item in ::$ctrl.feed.entries" item="::item" feed-id="::$ctrl.feed.id" on-open="$ctrl.open($ctrl.feed.id, item)"></tutorial-post>' +
            '</div>' +
        '</div>';
    }

    function onLoaded($ctrl) {  //console.log('onLoaded')
        if(!$ctrl){return;}
        var l = $ctrl.feeds && $ctrl.feeds.length ? $ctrl.feeds.length : 0;
        if (l > 0) {
            $ctrl.changeFeed($ctrl.getRandomIndex(l));
        }
    }
}

angular.module('components.tutorialPost.directive', [
])
.component('tutorialPost', {
    controller: 'TutorialPostCtrl',
    bindings: {
        item: '<',
        feedId: '<',
        type:'@?',
        onOpen:'&'
    }
})
    .controller('TutorialPostCtrl', TutorialPostCtrl);
TutorialPostCtrl.$inject = ['LCS', '$element'];

function TutorialPostCtrl(LCS, $element) {
    //console.log('TutorialPostCtrl')
    var $ctrl = this,
        element = $element[0],
        itemId;

    $ctrl.LCS = LCS;

    $ctrl.$onInit = load;
    $ctrl.$doCheck = $doCheck;
    $ctrl.$onDestroy = $onDestroy;

    function $onDestroy() {
        bindClick(element);
    }

    function $doCheck() {//deep checking
        if ($ctrl.item.id !== itemId)  {
            load();
        }
    }

    function load() {
        if(!$ctrl.item){return;}
        itemId = $ctrl.item.id;
        //console.log('load element: ' + $ctrl.item.id) ;
        bindClick(element);

        var content = getContent($ctrl.type, $ctrl.item);
        if(!content){return;}
        var div = $ctrl.LCS.createFragment(content);
        bindClick(div, true);

        $ctrl.LCS.removeChild(element, '.feed-item');
        addChild(element, div);
    }

    function bindClick(parent, isBind) {
        $ctrl.LCS.bindElementListeners(isBind, parent.querySelector('.with_click'), openItem);
    }

    function openItem() {
        $ctrl.onOpen({feedId: $ctrl.feedId, item: $ctrl.item});
        if($ctrl.type !=='feature') {
            $ctrl.LCS.removeChild(element, '.feed-unread');
        }
    }

    function addChild(parent, child ){
        parent.appendChild(child);
    }

    function getContent(type, item) {
        if(!item){return null;}
        var src = $ctrl.LCS.getImgUrl(item.imagelarge ? item.imagelarge : item.image, true, true);
        if($ctrl.type !== 'feature'){
            return "<div class='feed-item'>" +
                "<div class='table-div'>" +
                "<div class='centered img-col'>" +
                "<div>" +
                "<img src='"+ src+"'/>" +
                (item.open ? '': "<span class='feed-unread'></span>") +
                "</div>" +
                "</div>" +
                "<div class='centered title-col text-left'>" +
                "<a class='with_underline gray with_click'>"+item.title+"</a>" +//click
                "</div>" +
                "</div>" +
                "</div>";
        }else {
            //click
            return "<div class='feed-item large with-cursor'>" +
                "<div class='full-width display-block blog-img' style='background-image:url(" + src + ")'></div>" +
                "<div class='full-width display-block blog-title'><a class='with_click with_underline gray'>" + item.title.substring(0, 65) + "</a></div>" +
                //(item.description ? ("<div class='display-block full-width text-left spacing-quarter-top blog-desc'><div>" + item.description.substring(0, 70) + "…</div></div>") : '') +
                "</div>";
        }
    }
}

