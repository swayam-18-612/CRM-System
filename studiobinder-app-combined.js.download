angular.module('user.dashboardPage.myTasks.component', [
    'user.dashboardPage.widget.component.service',
    'apiConstants.myTasks.services',
    'user.dashboardPage.myTasksGroup.component',
])
.component('myTasks', {
    bindings: getDashboardWidgetGroupBindings(),
    controller: 'MyTasksCtrl'
})
.controller('MyTasksCtrl', MyTasksCtrl);
MyTasksCtrl.$inject = ['DashboardWidgetCtrlService', 'MyTasksConstantsService', '$element'];
function MyTasksCtrl(DashboardWidgetCtrlService, constantsService, $element) {
    console.log('MyTasksCtrl');
    var $ctrl = this;

    $ctrl.DashboardWidgetCtrlService = DashboardWidgetCtrlService;

    $ctrl.preInitOther = preInitOther;
    $ctrl.onPreloadedService = onPreloadedService;
    $ctrl.getOtherParams = getOtherParams;
    $ctrl.preProcessGroupItems = preProcessGroupItems;

    $ctrl = new $ctrl.DashboardWidgetCtrlService($ctrl, constantsService, $element);

    function preInitOther(constantsService) {
        var c = angular.copy(constantsService);
        c.GroupSettings = _.extend({}, c.GroupSettings, {
            gridItemClass: ' ',
            hideGridHeader: false,//make false to set filters
            noBorderGridHeader: true,

            withoutGroupSorting: true,
            dragHandleOnTheSide: false,
            showSortingColumns: false,
            withoutBorderBottom: false,
            tabTasks: 'tasks',

            noListModeOnMobile: true
        });
        if ($ctrl.isFullItem) {
            c.Settings.Columns = _.extend({}, c.Settings.Columns);

            c.Settings.Columns['5'] = _.extend({}, c.Settings.Columns['5'], {//teamIds
                canEdit: $ctrl.canEdit,
                maxCount: 6,
            });

            c.Options = _.extend({}, c.Options, {
                showHeader: true,
                columns: ['1', '2', '2.1',   '4', '7', '9', '10'] //'5' - > teamId
            });
        }

        $ctrl.constantsService = c;
    }

    function preProcessGroupItems(item) {
        item.taskBoard = _.find($ctrl.taskBoards, {_id: item.taskBoardId});
        if(!item.taskBoard){
            return null;
        }

        item.todoColumn = _.find(item.taskBoard.todoColumns, {_id: item.todoColumnId});
        if(!item.todoColumn) {
            return null;
        }

        item.team = item.teamIds ? _.filter(item.teamIds.map(function (id) {
            var exists = item.taskBoard.teamIds ? _.find(item.taskBoard.teamIds, function (id1){return id1 === id;}) : null;
            return exists ? _.find($ctrl.team, {_id: id}) : null;
        }), function (item){return item;}) : null;
        item.teamIds = item.team ? item.team.map(function (item){return item._id;}) : null;

        item.taskboardName = item.taskBoard.name;
        item.todoColumnName = item.todoColumn.name;

        return item;
    }

    function getOtherParams() {
        return {
            teamId: $ctrl.CPS.teamId
        };
    }

    function onPreloadedService(err, result){
        $ctrl.team = $ctrl.SessionService.getSetting('team');
        $ctrl.taskBoards = $ctrl.preLoadingService ? $ctrl.preLoadingService.getObjectList($ctrl.preLoadingService.TblTypes.TaskBoards).map(function (item){
            item.team = item.teamIds ? _.filter(item.teamIds.map(function (id){
                return _.find($ctrl.team, {_id: id});
            }), function (item){return item;}) : null;
            item.teamIds = item.team ? item.team.map(function (item){return item._id;}) : null;
            item.todoColumns = $ctrl.preLoadingService ? _.filter($ctrl.preLoadingService.getObjectList($ctrl.preLoadingService.TblTypes.TodoColumns), {taskBoardId: item._id}) : [];
            return item;
        }) : null;
    }
}

angular.module('user.dashboardPage.myTasksGroup.component', [
    'groupBlock.controller.service',
    'user.dashboardPage.myTasks.item.grid.component',
    'product.workflow.group.component.service',
    'apiConstants.product.workflow.services'
])
.component('mytasksGroup', groupBlockComponentParams('MyTasksGroupCtrl', {
    onListItemsQuery: '&',
    preProcessGroupItems: '&',
    nestedLevel: '@'
}))
.controller('MyTasksGroupCtrl', MyTasksGroupCtrl);
MyTasksGroupCtrl.$inject = ['TaskcardGroupCtrlService', 'WorkflowConstantsService', 'GroupBlockInitCtrlService', '$element'];
function MyTasksGroupCtrl(GroupCtrlService, WorkflowConstantsService, GroupBlockInitCtrlService, $element) {
    console.log('MyTasksGroupCtrl');
    var $ctrl = this;

    $ctrl.WorkflowConstantsService = WorkflowConstantsService;
    $ctrl.GroupCtrlService = GroupCtrlService;
    $ctrl.GroupBlockInitCtrlService = GroupBlockInitCtrlService;

    $ctrl.styles = {borders: 0};
    $ctrl.filterField = 'selectedFilter';
    $ctrl.Filters = [
        {value: 1, text: 'Uncompleted'},
        {value: 2, text: 'Completed'},
        {value: 3, text: 'All Tasks'}
    ];

    $ctrl.$onInit = $onInit;
    $ctrl.processListItemColumn = processListItemColumn;
    //item methods
    if(!$ctrl.hasClick) {
        $ctrl.hasClick = hasClick;
    }
    $ctrl.openTaskCard = openTaskCard;
    $ctrl.goToTaskBoard = goToTaskBoard;

    $ctrl.onListItemsQuery = onListItemsQuery;

    $ctrl.showColumnOther = showColumnOther;
    $ctrl.preloadSettings = preloadSettings;

    $ctrl.onPreloadGroup = onPreloadGroup;
    //enable to display filters
    //$ctrl.getGridHeader = getGridHeader;
    $ctrl.changeFilter = changeFilter;
    $ctrl.getBottomActions = getBottomActions;
    $ctrl.goToTaskboards = goToTaskboards;

    $ctrl = new $ctrl.GroupCtrlService($ctrl);

    function $onInit() {
        $ctrl.isFullItem = $element[0].getAttribute('is-full-item') === 'true';
        $ctrl.customButtons = true;
        $ctrl.hideRemoveBtn = true;
        $ctrl.options = $ctrl.constantsService.Options;
        $ctrl.withCustomSettings = $ctrl.constantsService.CompOptions.withCustomSettings;

        $ctrl.tabTasks = 'tasks';

        $ctrl.onInit();

        $ctrl = new $ctrl.GroupBlockInitCtrlService($ctrl, $element, $ctrl.Pagination, $ctrl.constantsService, null);
    }

    function goToTaskboards(id, e) {
        redirect(e, 'user.taskboards');
    }

    function goToTaskBoard(item, e) {
        redirect(e, 'user.taskboards', {
            taskBoardId: item.taskBoardId,
            // card: item._id
        });
    }

    function redirect(e, name, params){
        var p = $ctrl.CPS.currentPathParams(params);
        if (e && e.shiftKey) {
            $ctrl.CPS.openInNewWindow(name, p);
        } else {
            $ctrl.CPS.transitionTo(name, p);
        }
    }

    function onPreloadGroup() {
        if(!$ctrl.filtersService){
            $ctrl.filtersService = {};
        }
        if ($ctrl.filtersService[$ctrl.filterField] === undefined) {
            $ctrl.filtersService[$ctrl.filterField] = 1;
        }
    }

    function getGridHeader() {
        return getFilterDrp();

        function getFilterDrp(){

            return '<div class="pull-right wrapper-outer wrapper-tasks-filter with-arrow with-bgcolorgray" ng-show="!$ctrl.canEdit&&$ctrl.list.totalCount||$ctrl.canEdit">' +
                '<sb-dropdown ' +
                //'class="col130" ' +
                'drp-class-attr="drpTasksFilter" '+
                'without-close="true" ' +
                'c-class-attr="without-underline without-arrow opendrp auto-width thinner" ' +
                'init-list="::$ctrl.Filters" ' +
                'value="::$ctrl.filtersService.'+$ctrl.filterField+'" ' +
                'on-change="$ctrl.changeFilter(result)" ' +
                'field-class="selected-text">' +
                '</sb-dropdown>' +
                '</div>';
        }
    }

    function changeFilter(result) {
        $ctrl.filtersService[$ctrl.filterField] = result.selected.val;
        $ctrl.loadGroupTemplate();
    }

    function onListItemsQuery() {
        console.log('onListItemsQuery');
        return function (item) {
            if (!item) {
                return false;
            }
            return $ctrl.filtersService[$ctrl.filterField] === 1 && !item.completed  || //return uncompleted
                $ctrl.filtersService[$ctrl.filterField] === 2 && item.completed ||
                $ctrl.filtersService[$ctrl.filterField] === 3  ; //return all
        }
    }

    function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
        var clsOther = $ctrl.getClsCol(c, isLast);
        switch (c.prop) {
            case 'name':
                return '<div' + (clsOther ? (' class="' + clsOther + '"') : '') +'>' +
                    getName(item, c.prop, 'full-width name font-size-13', 'openTaskCard') +
                    '</div>' +
                    ($ctrl.isFullItem ? ('<div class="col120">' + $ctrl.TodoCardGridItemInitCtrlService.getStats(false, item, true) + '</div>') : '');

            case 'teamIds':
                var teamIds = getTeamIds();
                return teamIds ? get(teamIds, $ctrl.canEdit && c.canEdit) : '';

            case 'taskboardName':
                return '<div' + (clsOther ? (' class="' + clsOther + '"') : '') + '">' +
                    getName(item, c.prop, null, 'goToTaskBoard') +
                    '</div>';

            case 'todoColumnId':
                var co = item.todoColumn.color, isLight = tinycolor(co).isLight();

                return '<div class="semibold ' + (clsOther || '') + '"' +
                    //' style="--label-bg:' + co + (isLight ? (';--label-color:#FFF') : '') + '"' +
                    '>' +
                    getName(item, 'todoColumnName', '', 'goToTaskBoard', '<div class="circle-container-10 inline-block with-margin-right" style="background-color:' + co + '"></div>') +
                    '</div>';

            //case 'startDate':
            //case 'dueDate':
            case 'dates':
                return $ctrl.TodoCardGridItemInitCtrlService.getDatesContent($ctrl, item, c.colCls || '', c.prop === 'startDate' ? 1 : (c.prop === 'dueDate' ? 2 : null));

            case 'completed':
                c.tooltipPlaceholder = ' ';
                return $ctrl.TodoCardGridItemInitCtrlService.getCompleteMark(item, $ctrl, 'col30');

            default:
                return get(c);
        }

        function get(c, canEdit1) {
            return $ctrl.getDisplayItemCol(item, c, clsOther, canEdit1 ? canEdit1 : canEdit, textOnly, isMobile, isMobileRowDetails);
        }
    }

    function getTeamIds() {
        var teamIds = $ctrl.getColumnByProp('teamIds', true);
        return teamIds && $ctrl.showColumnOther(teamIds) ? teamIds : null;
    }

    function showColumnOther(item, c, isHeader, isMobile, notTextOnly) {
        return true;
        if (c && c.prop === "teamIds") {
            return (!$ctrl.team || $ctrl.team.length < 2) ? false : true;
        }
    }
    function hasClick(item){
        return $ctrl.isActiveFilter() && $ctrl.isActiveItem(item);
    }

    function getName(item, prop, cls, event, other) {
        var hasclick = event && $ctrl.hasClick(item),
            tag = 'div',//(hasclick ? 'a' : 'div'),
            withclick = hasclick ? (' no-drag with_underline with-cursor" '
               //+ 'href="' + $ctrl.CPS.getStateHref('user.product.overview', currentPathParams(item))
          ) : '';
        return '<' + tag + ' class="' + (cls||'') + ' display-block ' +
            $ctrl.getViewEditElemSelector(prop) + ' ' +
            $ctrl.getClickEventName(event) +
            (hasclick ? withclick : '') + '">' + (other || '') + $ctrl.LCS.convertHtmlToText(item[prop]) +
            '</' + tag + '>';
    }

    function openTaskCard(item) {
        console.log('open card popup');

        $ctrl.popupsService.open(item, $ctrl.popupsService.operations.updateTaskCard, {
            canEdit : $ctrl.canEdit,
            service: $ctrl.preLoadingService.Tbl.TodoCards.loadingService.objectService,
            onGridItemActions: $ctrl.onGridItemActions,
            otherSettings: {
                todoColumns: item.taskBoard.todoColumns,
                team: _.unique([].concat(item.taskBoard.team ||[]).concat( $ctrl.teamAdmins||[]), '_id')
            },
            currentListId: $ctrl.currentListId,
        }, $ctrl.compOptions);
    }

    function preloadSettings() {{
            $ctrl.team = $ctrl.SessionService.getSetting('team');
            $ctrl.teamAdmins = _.filter($ctrl.team, function (item) {
                return item.memberType === $ctrl.security.MemberTypes.Owner || item.memberType === $ctrl.security.MemberTypes.Admin;
            });
            $ctrl.Settings = _.extend({}, $ctrl.Settings, $ctrl.TodoCardGridItemInitCtrlService.getExtendedSettingsParams($ctrl));

        }
    }
    function getBottomActions() {
        return '<div class="ng-hide hide-print spacing text-center empty-state" ng-show="$ctrl.list.items.length===0">' +
            '<div class="empty-img my-tasks">&nbsp;</div>'+
            '<p class="empty-txt">No ' +
           // 'open ' +
            'task cards assigned to you</p>' +
            '<a type="button" class="btn btn-small transparent navbtn col160 ' + $ctrl.getBtnActionCls() + '" data-type="goToTaskboards" analytics-on analytics-action="Go To TaskBoards">'+$ctrl.LCS.getISBDiv('plus', 2, 'pull-left centered')+' <div>View Task Boards</div></a>'+
            '</div>';
    }
}

