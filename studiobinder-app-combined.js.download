angular.module('product.script.versions.component',[
    'list.ctrl',
    'apiPagination.Scripts',
    'apiServices.Materials',
    'apiServices.MaterialVersions',
    'apiServices.DocumentVersions',
    'product.script.versions.select.component'
])
.component('scriptVersionsPopup', popupComponentParams('ScriptVersionsPopupCtrl'))
.controller('ScriptVersionsPopupCtrl', ScriptVersionsPopupCtrl);
ScriptVersionsPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', 'ScriptsPagination', 'ListInitService', 'MaterialsService', 'DocumentVersionsService', 'MaterialVersionsService', 'MomentService', '$element'];
function ScriptVersionsPopupCtrl( ItemTemplateCompileCtrlService, ScriptsPagination, ListInitService, MaterialsService, DocumentVersionsService, MaterialVersionsService, MomentService, $element) {
    console.log('ScriptVersionsPopupCtrl');

    var $ctrl = this;

    $ctrl.MomentService = MomentService;
    $ctrl.MaterialsService = MaterialsService;
    $ctrl.DocumentVersionsService = DocumentVersionsService;
    $ctrl.MaterialVersionsService = MaterialVersionsService;

    $ctrl.isPopup = true;

    $ctrl.removeVersion = removeVersion;
    $ctrl.changeVersion = changeVersion;
    $ctrl.rename = rename;
    $ctrl.startRename = startRename;
    $ctrl.getDocumentVersionUrl = getDocumentVersionUrl;
    $ctrl.getColorStyle = getColorStyle;
    $ctrl.getDownloadLink = getDownloadLink;
    $ctrl.goToScript = goToScript;
    $ctrl.duplicate = duplicate;

    $ctrl.view = view;
    $ctrl.duplicateShots = duplicateShots;
    $ctrl.preview = preview;

    $ctrl.preInit = preInit;
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function getExtendedParams(params){
        return _.extend({
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId
        }, params);
    }
    function preInit() {
        $ctrl.formHolder = {};

        var list = new ScriptsPagination(1000,
            ['name', 'order', 'isDefault', 'versionId', 'documentVersionId', 'version', 'createdById', 'createdAt', 'contentVersionId', 'color', 'summary', 'notes'],
            ['name'],
            ['name', 'createdAt', 'createdAtT', 'updatedAt', 'updatedAtT'],
            '' // 'documentVersionId contentVersionId'
        );
        var team = $ctrl.SessionService.getSetting('team');

        var l = _.sortBy($ctrl.CurrentProduct.getScripts().map(function (item){
            if(item.notes) {
                if (typeof (item.notes) === 'string') {
                    item.notes = item.notes.split('<br/>').map(function (n) {
                        return {note: n};
                    });
                }

                item.notes = item.notes.map(function (n) {
                    if (n.userId) {
                        n.user = _.find(team, {userId: n.userId});
                    }
                    if(item.time && typeof(item.time) === 'string') {
                        item.time = $ctrl.MomentService.getMomentFromString(item.time);
                    }
                    return n;
                });
            }


            if(item.createdAt){
                if(typeof(item.createdAt) === 'string') {
                    item.createdAt = $ctrl.MomentService.getMomentFromString(item.createdAt);
                }
                item.createdAtT = $ctrl.MomentService.getTimestamp(item.createdAt);
            }


            if(!item.updatedAt){
                item.updatedAt = item.createdAt;
            }

            if(item.updatedAt){
                if(typeof(item.updatedAt) === 'string') {
                    item.updatedAt = $ctrl.MomentService.getMomentFromString(item.updatedAt);
                }
                item.updatedAtT = $ctrl.MomentService.getTimestamp(item.updatedAt);
            }

            return item;
        }, 'updatedAtT')).reverse();

        var fromIndex = _.findIndex(l, {isDefault: true});
        if(fromIndex !== 0){
            var el = l[fromIndex];
            l.splice(fromIndex, 1);
            l.splice(0, 0, el);//move current in front
        }

        list.setList(l);

        $ctrl = new ListInitService($ctrl, {
            preloadAll: true,
            list: list,
            orders: {updatedAtT: -1}
        });
    }

    function setTemplateData() {
        $ctrl.popupTitle = 'Version Manager';
        $ctrl.icon = 'versions';
        $ctrl.iconLevel = 3;
        $ctrl.withFooterBtns = false;
    }

    function getPopupBodyContent(){
return '<div ng-show="$ctrl.list.isLoaded" class="table-rewards scripts">' +
    '<div ng-show="$ctrl.list.items.length>0">' +
        '<div  class="version-row centering" ng-class="{\'with-border-bottom\':listIndex!==$ctrl.list.items.length-1}" ng-repeat="(listIndex, item) in $ctrl.list.items track by item._id">' +
            '<div dropdown class="position-relative">'+
                '<div class="file table-div full-width">' +
                    '<div class="centered col60 with-padding-right"><div ng-bind="\'v\'+item.version" class="mark-version" ng-style="$ctrl.getColorStyle(item)"></div></div>' +
                    '<div class="centered" ng-show="!item.rename">' +
                        '<span class="semibold" ng-bind="item.name ? item.name : \'Script\'"></span>' +
                        '<div class="inline-block with-margin-left current" ng-if="item.isDefault">Current Version</div>' +
                    '</div>' +
                    '<div class="position-relative centered col50 with-padding-left" ng-show="!item.rename">' +
                        //'<button ng-click="item.show=item.show?false:true" type="button" class="btn btn-small transparent3 without-text"><span class="sbf sbf12" ng-class="item.show?\'sort-down\':\'sort-right\'"></span></button>' +
                        '<button type="button" class="btnMore btn btn-small dropdown-toggle dots without-text transparent3" dropdown-toggle aria-haspopup="true" aria-expanded="true"> ' + $ctrl.LCS.getISBDiv('vertical-dots',1) + '</button>' +
                    '</div>' +
                    '<form class="centered auto" ng-show="item.rename" name="$ctrl.formHolder.form{{::item._id}}" novalidate>' +
                        '<div class="table-div full-width">' +
                            '<div class="text-center white thinner">' +
                                '<input placeholder="Version Name…" class="font-size-12 max-width300 form-control with-underline inline-block" id="name{{::item._id}}" name="name{{::item._id}}" type="text" ng-model="item.name"/>' +
                                '<div ng-show="($ctrl.formHolderItem.formItem.name.$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem.formItem.name.$error.required" class="help-inline ng-hide text-left">Version name is required.</div>' +
                            '</div>' +
                            '<div class="col130 padding-left10">' +
                                '<button style="min-width: 60px;margin-right: 10px" type="submit" class="col60 btn primary smallbtn pull-left small-btns" ng-click="$ctrl.rename(item)">Save</button>' +
                                '<a class="cancelsmall" ng-click="item.rename = false">Cancel</a>' +
                            '</div>' +
                        '</div>' +
                    '</form>' +
                '</div>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft col150 pull-right" role="menu">' +
                    '<ul class="listitems-selector with-checked">'+
                        '<li ng-if="!item.isDefault" class="with-border-bottom spacing-quarter-bottom margin-bottom-quarter"><a class="table-div full-width" ng-click="$ctrl.changeVersion(item)" analytics-on analytics-action="Make Current">' +
                        // '<div class="col30">'+$ctrl.LCS.getISBDiv('pencil',2, 'gray')+'</div>' +
                        '<div>Make Current</div>' +
                        '</a></li>' +
                        '<li ><a class="table-div full-width" ng-click="$ctrl.view(item, $event)" analytics-on analytics-action="Preview Script">' +
                        // '<div class="col30">'+$ctrl.LCS.getISBDiv('pencil',2, 'gray')+'</div>' +
                        '<div>Preview Script</div>' +
                        '</a></li>' +
                        '<li ng-if="!item.isDefault"><a ng-click="$ctrl.preview(item, $event)" class="table-div full-width" analytics-on analytics-action="View Project">' +
                        //'<div class="col30">'+$ctrl.LCS.getISBDiv('pencil',2, 'gray')+'</div>' +
                        '<div>View Project</div>' +
                        '</a></li>' +
                        '<li><a class="table-div full-width" ng-click="$ctrl.startRename(item,$event)" analytics-on analytics-action="Rename">' +
                        //'<div class="col30">'+$ctrl.LCS.getISBDiv('pencil',2, 'gray')+'</div>' +
                        '<div>Rename</div>' +
                        '</a></li>' +
                        '<li class="sb-hide" ng-if="$ctrl.list.items.length>1"><a ng-click="$ctrl.duplicateShots(item, $event)" class="table-div full-width"  analytics-on analytics-action="Import Shots">' +
                        //'<div class="col30">'+$ctrl.LCS.getISBDiv('pencil',2, 'gray')+'</div>' +
                        '<div>Import Shots</div>' +
                        '</a></li>' +
                        '<li class="with-border-top spacing-quarter-top margin-top-quarter" ng-if="!item.isDefault && $ctrl.list.items.length>1"><a class="table-div full-width accent" ng-click="item.confirmRemove=true" analytics-on analytics-action="Remove">' +
                        //'<div class="col30">'+$ctrl.LCS.getISBDiv('pencil',2, 'gray')+'</div>' +
                        '<div>Remove</div>' +
                        '</a></li>' +
                    '</ul>' +
                '</div>' +
            '</div>' +
            '<div class="uploadedinfo"><span class="italic">Updated on {{::item.updatedAt|amDateFormat:$ctrl.CPS.dateTimeFormat}} by {{::item.createdBy.name}}</span> <div class="inline-block" ng-if="::item.notes&&item.notes.length>0"><div class="dot-container"><span class="dot-separator"></span></div><a class="semibold" ng-click="item.show=item.show?false:true"><span ng-bind="item.show?\'Hide\':\'See\'"></span> History</a></div></div>' +
            '<div class="margin-top-quarter" ng-show="item.show">' +
                '<div class="full-width padding-left-24 with-border-top margin-top-half" ng-if="::item.notes">' +
                    '<div class="  font-size-13 table-div" ng-repeat="(nIndex, n) in item.notes" ng-class="{\'with-border-bottom spacing-half\':nIndex!==item.notes.length-1, \'spacing-half-top\':nIndex===item.notes.length-1}">' +
                        '<div class="col40" ng-show="n.user">' + $ctrl.security.getUserImageComponent('$ctrl.list.items[listIndex].notes[nIndex].user','smaller') + '</div>' +
                        '<div class="name text-left with-padding-left text-left">' +
                            '<span ng-bind-html="::n.note|unsafe"></span> <span ng-if="::n.time" ng-bind="::$ctrl.CPS.getCreatedAt(n.time, $ctrl.CPS.dateTimeFormat)"></span><span ng-if="::n.dontUpdateScreenplay">. Screenplay was not updated.</span>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
            '<div class="layer" ng-show="item.confirmRemove">' +
                '<div class="text-center white">Are you sure you want to remove this script version?</div>' +
                '<div class="text-center">' +
                '<a ng-click="$ctrl.removeVersion(item)" style="margin-right: 20px;">Remove</a>' +
                '<a ng-click="item.confirmRemove = false">Cancel</a>' +
                '</div>' +
            '</div>' +
            '</div>' +
            '<loading-more ng-if="$ctrl.list.busy"></loading-more>' +
            '</div>' +
            '<loading-more ng-if="$ctrl.list.busy"></loading-more>' +
            '</div>' +
            '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '" ng-if="!$ctrl.list.isLoaded"></preloader-center>';
    }

    function duplicateShots(item, e) {
        processDup(item, e, 'shots');
    }

    function preview(item, e){
        $ctrl.preventDefault(e);
        $ctrl.SBStateService.openInNewWindow($ctrl.SBStateService.getCurrentStateName(), _.extend({},
             $ctrl.CPS.currentPathParams(), {scriptId: item._id}));

    }
    function processDup(item, e, type) {
        $ctrl.preventDefault(e);
        $ctrl.popupsService.open(null, $ctrl.popupsService.operations.scriptVersionsSelect, {
            items: $ctrl.list.items,
            onConfirm: onConfirm
        }, $ctrl.compOptions);

        function onConfirm(result) {
            console.log('onConfirm');
            if (result && result.toScriptId) {

            }
            $ctrl.service.duplicateFromScript(getExtendedParams({
                type: 'shots',
                fromScriptId: item._id,
                toScriptId: result.toScriptId
            }), function (result) {

                $ctrl.broadcastRoot('HIDE_MOBILE_DETAILS');
                $ctrl.close();
            }, function (err) {

            });
        }
    }

    function  goToScript(item, e){
        $ctrl.preventDefault(e);
        $ctrl.getDocumentVersionUrl(item, true);
        close();
    }

    function getColorStyle(item) {
        return $ctrl.service.getColorStyle(item);
    }

    function getDocumentVersionUrl(script, isTransition) {
        var item = script.documentVersion;
        return item ? $ctrl.CPS[isTransition ? 'transitionTo' : 'getStateHref']('user.product.document', $ctrl.CPS.currentProductPathParams({
            documentId: item.documentId,
            versionId: item._id
        })) : null;
    }

    function removeVersion(item) {
        $ctrl.error = null;
        $ctrl.service.delete(item, function (el) {
            if (el.item) {
                el = el.item;
            }
            if ($ctrl.list && $ctrl.list.items) {
                $ctrl.list.removeElement(el);
                $ctrl.CPS.CurrentProduct.setScripts($ctrl.list.items);
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.version.Remove.success', 'success');
            }
        }, onError);

        function onError(err) {
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.version.Remove.error', 'error');
        }
    }

    function changeVersion(item) {
        var items = $ctrl.list.items,
            scriptId = item._id;
        $ctrl.service.changeVersion(getExtendedParams({
            scriptId: scriptId
        }), function (result) {
            var script,
                updates = result ? result.updates : null;
            if(updates) {
                for (var id in updates) {
                    for (var j = 0, m = items.length; j < m; j++) {
                        if (items[j]._id === id) {
                            $ctrl.list.items[j] = _.extend(items[j], updates[id]);
                            if(scriptId === id){
                                script = $ctrl.list.items[j];
                            }
                        }
                    }
                }
            }
            //  $ctrl.CurrentProduct.scriptLoadingService.processTablesUpdatesG(result);

            if(script) {
                $ctrl.broadcastRoot('UPDATE_SCRIPT_VERSION', script);
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.version.makeCurrent.success', 'success');
            }
            if ($ctrl.onClose) {
                $ctrl.onClose({result: 'cancel'});
            }
        }, function (err) {
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.version.makeCurrent.error', 'error');
        });
    }

    function close(){
        if ($ctrl.onClose) {
            $ctrl.onClose({result: 'cancel'});
        }
    }
    function duplicate(item) {
        // open popup to choose color and title
    }

    function startRename(item, e){
        $ctrl.preventDefault(e);
        //old approach
        // item.rename = true;
        $ctrl.popupsService.open(angular.copy(item), $ctrl.popupsService.operations.scriptVersionEdit, {
            elemType: $ctrl.elemType,
            itemTitle: $ctrl.itemTitle,
            modalTitle: 'Script Version',
            btnText: 'Save Changes',
            icon: 'screenplays',
            iconLevel: 2
        }, null, null, function (result){
            if(result && result.item) {
                onRename(item, getChanges(result.item, item));
            }
        });
    }

    function rename(item) {
        $ctrl.formHolder['form' + item._id + '_attempted'] = true;
        var form = $ctrl.formHolder['form' + item._id];
        if (form && form.$valid) {
            onRename(item, {name: item.name});
        }
    }

    function onRename(item, updates){
        if(!updates){return;}

        $ctrl.isUpdating = true;
        $ctrl.service.update(_.extend(updates, getExtendedParams({
            _id: item._id,
            //notes: 'A '+$ctrl.fileTypeName+' file was imported on <span class="semibold">' +$ctrl.BlocksSetupService.getCurrentTodoPage().text + '</span> page' +  ($ctrl.script ? (': <span class="semibold">' + ($ctrl.script.contentVersion ? $ctrl.script.contentVersion.name : $ctrl.script.name)+'</span>') : '');

        })), function (result) {
            $ctrl.isUpdating = false;
            // $ctrl.list.items[index].name  = el.name ;

            var updates = getChanges(result.item, item);
            $ctrl.list.replaceElementProps(item._id, updates);

            item.rename = false;
            if (item.isDefault) {
                var p = $ctrl.CurrentProduct.getProduct();
                p.script = _.extend(p.script, updates);
                $ctrl.CurrentProduct.broadcastProduct(p, 'SCRIPT_CHANGES');
            } else {
                $ctrl.CurrentProduct.setScripts($ctrl.list.items);
            }

        }, function (error) {
            $ctrl.isUpdating = false;
            $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.version.Edit.error', 'error');
        });
    }

    function getChanges(item, itemCopy){
        return $ctrl.service.getChanges(['name', 'version', 'color', 'updatedAt', 'updatedAtT', 'notes'], item, itemCopy, true);
    }

    function getDownloadLink(item,e) {
        console.log('getDownloadLink');
        processDownload(item, e, onsuccess, onerror);

        function onsuccess(link) {
            $ctrl.SBStateService.assignUrl(link, 500);
            return false;
        }

        function onerror(err) {
        }
    }

    function view(item, e) {
        console.log('view script version');

        $ctrl.popupsService.open(item.contentVersionId, $ctrl.popupsService.operations.materialViewer, {
           // withDownload: true,
            withComments: false,
            canComment: false,
            canUpload: false,
            withoutSidebar: true,
            withHeader: true
        }, null, null, function (result){
            console.log('onSuccess');
        });

        return;


        if(item.content) {
            openView();
        }else{
            processDownload(item, e, onsuccess, onerror);
        }

        function onsuccess(link) {
            //var headers = security.getHttpHeaders(state, params)
            $ctrl.security.getRequest(link, null, function (result) {
                var data = result && result.data !== 'undefined' ? result.data : null,
                    size = data ? data.length : parseInt(item.size, 10);
                if ((data && size > 0 || !data && size === 0) ? data : null) {
                    item.content = data;
                }
                openView();
            }, onerror)
        }

        function onerror(err) {
            //console.log(err);
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.version.Download.error', 'error');
        }

        function openView() {
            //$ctrl.close();

            $ctrl.popupsService.open(item, $ctrl.popupsService.operations.viewDocument, {
                type: 2,//script
                withDownload: true
            }, $ctrl.compOptions);
        }
    }

    function processDownload(item, e, onsuccess, onerror) {
        $ctrl.preventDefault(e);
        if (!item.documentVersionId && !item.versionId || item.isDownloading) {
            return null;
        } //has document or has no file

        item = _.extend(item, getExtendedParams({
            isDownloading: true
        }));

        if (item.contentVersionId) {
            if (item.contentVersion) {
                initVersion(item.contentVersion);
            } else {
                $ctrl.MaterialVersionsService.getById(item.contentVersionId, null, initVersion, onError);
            }

            function initVersion(item1) {
                var materialId = item1 ? item1.materialId : null;
                if (materialId) {
                    $ctrl.MaterialsService.getDownloadLink(getExtendedParams({
                        id: materialId,
                        versionId: item.contentVersionId,
                    }), onSuccess, onError);
                } else {
                    onError();
                }
            }
        } else if (item.documentVersionId) {
            var v = item.documentVersion;
            $ctrl.DocumentVersionsService.getById(item.documentVersionId, 'contentVersionId', initVersion1, onError);

            function initVersion1(item1) {
                var cv = item1 ? item1.contentVersion : null,
                    materialId = cv ? cv.materialId : null;
                if (materialId) {
                    $ctrl.MaterialsService.getDownloadLink(getExtendedParams({
                        id: materialId,
                        versionId: v.contentVersionId
                    }), onSuccess, onError);
                } else {
                    onError();
                }
            }
        } else {
            $ctrl.service.getDownloadLink(getExtendedParams({
                scriptId: item._id,
                versionId: item.versionId
            }), onSuccess, onError);
        }

        function onSuccess(link) {
            item.isDownloading = false;
            if (onsuccess) {
                onsuccess(link);
            }
        }

        function onError(err) {
            item.isDownloading = false;
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.version.DownloadScript.error', 'error');
            if (onerror) {
                onerror(err);
            }
        }
    }
}

angular.module('product.script.versions.select.component',[
    'apiServices.DocumentVersions'
])
.component('scriptVersionsSelectPopup', popupComponentParams('ScriptVersionsSelectPopupCtrl'))
.controller('ScriptVersionsSelectPopupCtrl', ScriptVersionsSelectPopupCtrl);
ScriptVersionsSelectPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', 'DocumentVersionsService', '$element'];
function ScriptVersionsSelectPopupCtrl(ItemTemplateCompileCtrlService, DocumentVersionsService, $element) {
    console.log('ScriptVersionsSelectPopupCtrl');

    var $ctrl = this;

    $ctrl.DocumentVersionsService = DocumentVersionsService;

    $ctrl.isPopup = true;
    var dataInfo = 'data-info';

    $ctrl.select = select;
    $ctrl.save = save;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function select(id, e) {
        $ctrl.preventDefault(e);
        //console.log('select');
        var el = e.currentTarget;

        set($ctrl.selectedId, false);

        $ctrl.selectedId = id;
        set($ctrl.selectedId, true);

        function set(id, isAdd) {
            setRadio(id, isAdd);
        }

        function setCk(id, isAdd) {
            if (!id) {
                return;
            }
            var el = $ctrl.element.querySelector('.version-row[' + dataInfo + '="' + id + '"] .custom-checkbox input');
            if (el) {
                if (isAdd) {
                    el.setAttribute('checked', 'checked');
                } else {
                    el.removeAttribute('checked');
                }
            }
        }

        function setRadio(id, isAdd) {
            if (!id) {
                return;
            }
            var el = $ctrl.element.querySelector('.version-row['+dataInfo+'="' + id + '"] .md-radio-button');
            if (el) {
                $ctrl.LCS[isAdd ? 'addClass' : 'removeClass'](el, 'md-checked');
            }
        }
    }

    function save(e){
        $ctrl.preventDefault(e);
        $ctrl.error = null;
        if(!$ctrl.selectedId){
            $ctrl.error = 'Select the version where to duplicate the shots';
            return;
        }
        if ($ctrl.extraParam.onConfirm) {
            $ctrl.extraParam.onConfirm({toScriptId: $ctrl.selectedId}, _.extend({}, $ctrl.extraParam, {onConfirm: null}));
        }

        $ctrl.broadcastRoot('HIDE_MOBILE_DETAILS');
        $ctrl.close();
    }

    function setTemplateData() {
        $ctrl.popupTitle = 'Select Script Version';
        $ctrl.subtitle = 'Select the Script Version where to duplicate the shots';
        $ctrl.icon = 'versions';
        $ctrl.iconLevel = 3;
        $ctrl.withFooterBtns = true;
        $ctrl.btnText = 'Apply';
        $ctrl.items = $ctrl.extraParam.items && $ctrl.extraParam.items.length > 0 ? $ctrl.extraParam.items : null;
    }

    function getPopupBodyContent(){
        if(!$ctrl.items){
            return '<p class="text-center">There are no scripts</p>';
        }
        var list = _.sortBy($ctrl.items, 'version').reverse();
        $ctrl.selectedId = list[0]._id;
        var el= '';
    _.each(list, function (item, i){
        var id= list[i]._id;
el +='<div class="' + $ctrl.getBtnActionCls() + ' version-row centering' + ((i!==(list.length - 1)) ? ' with-border-bottom' : '') + '" data-type="select" data-info="' + id + '">' +
            '<div class="file table-div full-width with-cursor">' +
                '<div class="col30 centered">' +
                    '<div class="md-radio-button with-padding-right stripboardPage '+(id === $ctrl.selectedId?' md-checked"' : '')+'"><div class="md-container md-ink-ripple"><div class="md-off"></div><div class="md-on"></div><div class="md-ripple-container"></div></div></div>' +
                   // '<div class="ckcls shotsPage selectGroups font-general-12 custom-checkbox inrow"><label><input type="checkbox" ' + (id === $ctrl.selectedId?' md-checked"' : '') + '><span></span></label></div>' +
                '</div>' +
                '<div class="col30 centered with-padding-right"><div class="mark-version" style="'+$ctrl.DocumentVersionsService.getColorStyleStr(item)+'">v'+item.version+'</div></div>' +
                '<div class="centered">' +
                   '<div class="full-width">' +
                        '<div class="semibold inline-block">' +(item.name ? item.name : 'Script')+'</div>' +
                        (item.isDefault ?('<div class="inline-block with-margin-left current">Current</div>' ) : '')+
                    '</div>' +
                '</div>' +
            '</div>' +
        '</div>';
    });
        return '<div class="table-rewards scripts">' + el + '</div>';
    }
}

