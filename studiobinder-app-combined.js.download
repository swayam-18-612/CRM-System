        },

        Filters = [
            {value: true, text: 'Active Lists'},
            {value: false, text: 'Archived Lists'}
        ],

        CompOptions = angular.copy(compOptions),

        ListTreeServiceParams = {

            preLoadingTableName: 'ContactLists',

            hasTreeCopy: true,
            hasTreeShare: true,
            //moveInGroup: false,

            addListOnEmptyState: true,
            maxLevel: 1,
            hideLevel0: true,
            withHarcodedAll: true,
            dontStartTreeWithAll: true,
            harcodedAllIcon: 'contacts-all',

            withOptionsForList: true,
            withOptionsForListField: 'contactListId',
            withStringOptionsForListField: true
        },

        ListParams = {
            includeFields: ['name', 'email', 'roles', 'profilePictureURL', 'profilePictureURLId', 'phone', 'createdAt', 'orderLists', 'contactLists', 'note', 'rate'],
            searchFields: ['name', 'email', 'roles', 'note'],
            orderFields: ['name', 'email', 'phone','roles', 'note', 'rate'],
            populate: ''
        },

        KeyboardServiceParams = {
            canCopy: false,
            canMove: false,
        },

        PopupOperations = {
        },

        Hotkeys = [
            {key: 'e', desc: 'Edit selected contact'},
            {key: 'backspace', desc: 'Delete selected contacts'}
        ],

        SidebarOptions = {
        };

    return {
        PropTypes: PropTypes,
        Settings: Settings,
        Options: Options,
        Filters: {Filters: Filters},
        ViewProp: 'contactView',

        CompOptions: CompOptions,
        ListTreeServiceParams: ListTreeServiceParams,
        ListParams: ListParams,
        KeyboardServiceParams: KeyboardServiceParams,

        PopupOperations: PopupOperations,
        Hotkeys: Hotkeys,
        SidebarOptions: SidebarOptions,

        CastRoles: CastRoles,
        ContactTypes:ContactTypes
    };
}

