            console.log('DocumentPageInitCtrlService.onAddedDocumentTemplate');
        }

        function onBtnDocChanges() {
            //console.log('onBtnDocChanges');
            var a = getBtnSave();
            if (a) {
                $ctrl.LCS.removeClass(a, 'floppySaving floppyUnsaved floppySaved');
                $ctrl.LCS.addClass(a, $ctrl.SessionService.savingDocChanges ? 'floppySaving' : ($ctrl.SessionService.hasDocChanges ? 'floppyUnsaved' : 'floppySaved'));
                a.setAttribute('data-content', $ctrl.SessionService.savingDocChanges ? 'Saving…' : ($ctrl.SessionService.lastDocChanges ? ('Saved @ ' + $ctrl.SessionService.lastDocChanges) : ''));
            }
        }

        function $onDestroy() {
            $ctrl.onSimplePageDestroy();
            unloadSaveBtn();
            bindTitleEvents(true);
            $ctrl.EmptyStateCtrlService.bind(false);
            if($ctrl.templateVersionCompile){
                $ctrl.templateVersionCompile.destroyNewScope();
            }
        }

        function getPath(){
            return $ctrl.CPS.getStateHref('user.product.'+($ctrl.withDocumentInline ? 'documents' : ($ctrl.treeType === 3 ? 'avscripts' : 'screenplays'))+'', $ctrl.CPS.currentProductPathParams())
        }

        function openAutosaveSettings(e) {
            $ctrl.preventDefault(e);
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations.documentAutosaving, {
                versionId: $ctrl.item._id
            }, $ctrl.compOptions);
        }
        function downloadSBX() {
            if($ctrl.item){
                $ctrl.doOnFileSaved(function () {
                    $ctrl.broadcastRoot('DOWNLOAD_SBX_' + $ctrl.item._id, $ctrl.getExtension($ctrl.item.type).toLowerCase());
                });
            }
