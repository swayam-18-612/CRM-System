function ContactSidebarTreeCtrl(SidebarTreeCtrlService, $element) {
    console.log('ContactSidebarTreeCtrl');
    var $ctrl = this;
    $ctrl.isSidebar = true;

    $ctrl.getNewTreeItem = getNewTreeItem;
    $ctrl.eventCounterChanged = eventCounterChanged;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl = new SidebarTreeCtrlService($ctrl, $element, $ctrl.listTreeInitParams);
    }

    function getNewTreeItem(item) {
        return {
            type: 6,
            productId: $ctrl.CPS.productId
        };
    }

    function eventCounterChanged(result) {
        console.log('contacts eventCounterChanged');
        var ids = result && result.ids ? result.ids : [];
        _.each(ids, updateNodeCountById);
        _.each(['All', '1', '2', '3', '4'], function (id) {
            if (ids.indexOf(id) === -1) {
                updateNodeCountById(id);
            }
        });

        function updateNodeCountById(id){
            return $ctrl.listTreeService.updateNodeCountById(id, $ctrl.treeType);
        }
    }
}


angular.module('apiConstants.departments.services', [
