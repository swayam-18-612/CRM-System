angular.module('product.departments.page.controller.service', [
    'product.positions.group.component',
    'apiConstants.departments.services',
    'apiServices.Positions',
    'apiServices.Departments',

    'user.departments.list.popup.component',
    'user.departments.list.makeDefault.component',
    'user.departments.list.reset.component',
    'page.tree.simple.controller.service'
])
.service('DepartmentsPageCtrlService', DepartmentsPageCtrlService);
DepartmentsPageCtrlService.$inject = ['PageTreeSimpleCtrlService', 'DepartmentConstantsService', 'DepartmentsService', 'PositionsService'];
function DepartmentsPageCtrlService(PageTreeSimpleCtrlService, constantsService, listsService, service) {
    return function ($ctrl, $element, printPageParams) {
        console.log('DepartmentsPageCtrlService');

        $ctrl.getParams = getParams;

        $ctrl.getDrpSettingsOther = getDrpSettingsOther;
        $ctrl.getRightButtons = getRightButtons;

        $ctrl.makeDefault = makeDefault;
        $ctrl.reset = reset;
        $ctrl.checkShowAddNewItem = checkShowAddNewItem;

        return new PageTreeSimpleCtrlService($ctrl, $element, {
            constantsService: constantsService,
            listsService: listsService,
            service: service,
            listOptionsService: null
        });

        function checkShowAddNewItem(){
            return $ctrl.listTreeService.active && $ctrl.listTreeService.active.selectedListId !== 'All';
        }
        function getParams() {
            return {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId ? $ctrl.CPS.productId : null,
            };
        }

        function getDrpSettingsOther() {
            return getBtns(true);
        }

        function getRightButtons() {
            return getBtns(false);
        }

        function getBtns(isLi){
                if(!$ctrl.canEdit){return '';}
            var cls = $ctrl.getBtnActionCls();
            return get('reset', 'Reset Departments', 'refresh') +
                ($ctrl.CPS.productId ? get('makeDefault', 'Make Default', 'upload-2', 3) : '');

            function get(m, txt, icon, iconLevel){
                if(!iconLevel){ iconLevel = 2;}
              return  isLi ? ('<li class="show-ipad">' +
                    '<a class="fixed-layout table-div ' + cls + '" data-type="' + m + '">' +
                        '<div class="col30 with-margin-right">' + $ctrl.LCS.getISBDiv(icon, iconLevel) + '</div>' +
                        '<div><div class="with-ellipsis">'+txt+'</div></div>' +
                        '</a>' +
                    '</li>') : ('<a class="btn btn-small primary-faded without-text with-margin-left hide-lower1024 '+cls+'" data-type="' + m + '" analytics-on analytics-action="Open '+txt+'">' +
                  $ctrl.LCS.getISBDiv(icon, iconLevel, 'pull-left') +
                  '<span class="hide-ipad">'+txt+'</span></a>');
            }
        }

        function makeDefault() {
            openPopup('makeDefaultDepartments');
        }

        function reset() {
            openPopup('resetDefaultDepartments', true);
        }

        function openPopup(popup, withReload) {
            console.log(popup);
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations[popup], {
                service: listsService,
                preLoadingService: $ctrl.preLoadingService
            }, $ctrl.compOptions, null, function (result) {
                if(withReload) {
                    $ctrl.LCS.timeout(function () {
                        $ctrl.SBStateService.reloadPage();
                    }, 200);
                }
            });
        }
    }
}

angular.module('user.departments.list.makeDefault.component', [
    'apiServices.Departments'
])
.component('departmentsMakeDefaultPopup', popupComponentParams('DepartmentsMakeDefaultPopupCtrl'))

.controller('DepartmentsMakeDefaultPopupCtrl',DepartmentsMakeDefaultPopupCtrl);
DepartmentsMakeDefaultPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', '$element'];
function DepartmentsMakeDefaultPopupCtrl(ItemTemplateCompileCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.makeDefault = makeDefault;
    $ctrl.preInit = preInit;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function setTemplateData() {
        $ctrl.icon = 'departments';
        $ctrl.popupTitle = 'Save as Default?';
        $ctrl.withFooterBtns = true;
        $ctrl.btnText = 'Make Default';
        $ctrl.firstBtnMethod = 'makeDefault';
        $ctrl.with2FooterBtns = true;
        $ctrl.secBtnMethod = 'closePopup';
        $ctrl.btnText2 = 'No Thanks';
        $ctrl.textAnalytics = 'Make Default Departments';
        $ctrl.textAnalytics2 = $ctrl.textAnalytics;
    }

    function preInit() {
        $ctrl.service = $ctrl.extraParam.service;
    }

    function getPopupBodyContent(){
        return '<p class="text-center">Want to make your changes the default preset for new projects moving forward?</p>';
    }

    function makeDefault(e) {
        $ctrl.preventDefault(e);
        $ctrl.error = null;
        if ($ctrl.isUpdating) {return;}
        $ctrl.isUpdating = true;
        var message = 'crud.department.make-default';
        $ctrl.service.makeDefault({
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.CPS.productId ? $ctrl.CPS.productId : null,
        }, function (result) {
            $ctrl.isUpdating = false;
            $ctrl.closePopup(result);
            $ctrl.i18nNotifications.pushForCurrentRoute(null, message + '.success', 'success');
        }, function (error) {
            $ctrl.isUpdating = false;
            $ctrl.error = $ctrl.localizedMessages.getFromError(error, message + '.error');
        });
    }
}

