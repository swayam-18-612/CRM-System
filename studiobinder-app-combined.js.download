angular.module('satellizer.auth', [
    'satellizer.config',
    'satellizer.shared',
    'satellizer.local',
    'satellizer.oauth'
])
    .provider('SatellizerAuth', SatellizerAuth);
SatellizerAuth.$inject = ['SatellizerConfig'];
function SatellizerAuth(SatellizerConfig) {
    Object.defineProperties(this, {
        logoutRedirect: {
            get: function () {
                return SatellizerConfig.logoutRedirect;
            },
            set: function (value) {
                SatellizerConfig.logoutRedirect = value;
            }
        },
        loginRedirect: SatellizerConfig.loginRedirect,
        signupRedirect: {
            get: function () {
                return SatellizerConfig.signupRedirect;
            },
            set: function (value) {
                SatellizerConfig.signupRedirect = value;
            }
        },
        loginOnSignup: {
            get: function () {
                return SatellizerConfig.loginOnSignup;
            },
            set: function (value) {
                SatellizerConfig.loginOnSignup = value;
            }
        },
        loginUrl: {
            get: function () {
                return SatellizerConfig.loginUrl;
            },
            set: function (value) {
                SatellizerConfig.loginUrl = value;
            }
        },
        signupUrl: {
            get: function () {
                return SatellizerConfig.signupUrl;
            },
            set: function (value) {
                SatellizerConfig.signupUrl = value;
            }
        },
        betaSignupUrl: {
            get: function () {
                return SatellizerConfig.betaSignupUrl;
            },
            set: function (value) {
                SatellizerConfig.betaSignupUrl = value;
            }
        },
        loginRoute: {
            get: function () {
                return SatellizerConfig.loginRoute;
            },
            set: function (value) {
                SatellizerConfig.loginRoute = value;
            }
        },
        signupRoute: {
            get: function () {
                return SatellizerConfig.signupRoute;
            },
            set: function (value) {
                SatellizerConfig.signupRoute = value;
            }
        },
        tokenName: {
            get: function () {
                return SatellizerConfig.tokenName;
            },
            set: function (value) {
                SatellizerConfig.tokenName = value;
            }
        },
        userCookie: {
            get: function () {
                return SatellizerConfig.userCookie;
            },
            set: function (value) {
                SatellizerConfig.userCookie = value;
            }
        },
        unlinkUrl: {
            get: function () {
                return SatellizerConfig.unlinkUrl;
            },
            set: function (value) {
                SatellizerConfig.unlinkUrl = value;
            }
        },
        authHeader: {
            get: function () {
                return SatellizerConfig.authHeader;
            },
            set: function (value) {
                SatellizerConfig.authHeader = value;
            }
        }
    });

    _.each(Object.keys(SatellizerConfig.providers), function (provider) {
        this[provider] = function (params) {
            return _.extend(SatellizerConfig.providers[provider], params);
        };
    }, this);

    this.oauth1 = function (params) {
        oauth(params);
        SatellizerConfig.providers[params.name].type = '1.0';
    };

    this.oauth2 = function (params) {
        oauth(params);
        SatellizerConfig.providers[params.name].type = '2.0';
    };

    this.$get = ['$q', 'SatellizerShared', 'SatellizerLocal', 'SatellizerOauth',
       function ($q, SatellizerShared, SatellizerLocal, SatellizerOauth) {
        var $auth = {
            authenticate: authenticate,
            onresetpassword: onresetpassword,
            login: login,
            signup: signup,
            logout: logout,
            link: link,
            unlink: unlink,
            getToken: getToken,
            setToken: setToken,
            getCurrentUser: getCurrentUser
        };

        return $auth;

        function authenticate(name, userData) {
            return SatellizerOauth.authenticate(name, false, userData);
        }

        function onresetpassword(response, onsuccess) {
            SatellizerLocal.onLogin(response, onsuccess);
        }

        function login(user, onsuccess, onerror) {
            return SatellizerLocal.login(user, onsuccess, onerror);
        }

        function signup(isBetaRegister, user, onsuccess, onerror) {
            return SatellizerLocal.signup(isBetaRegister, user, onsuccess, onerror);
        }

        function logout(redirectUrl) {
            return SatellizerShared.logout(redirectUrl);
        }

        function link(name, userData) {
            return SatellizerOauth.authenticate(name, true, userData);
        }

        function unlink(provider) {
            return SatellizerOauth.unlink(provider);
        }

        function getToken() {
            return SatellizerShared.getToken();
        }

        function setToken(token, isLinking) {
            SatellizerShared.setToken({access_token: token}, isLinking);
        }

        function getCurrentUser() {
            return SatellizerShared.getCurrentUser();
        }

    }];

    function oauth(params) {
        SatellizerConfig.providers[params.name] = SatellizerConfig.providers[params.name] || {};
        _.extend(SatellizerConfig.providers[params.name], params);
    }
}


