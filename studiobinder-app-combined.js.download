addMoSePa('Users', 'users', TempUsersService, {
    modelMethod: UsersFactory
});
function UsersFactory(ApiResource) {
    var roles = [
        {value: 0, text: 'Collaborator'},
        {value: 1, text: 'User'},
        {value: 2, text: 'Owner'},
        {value: 3, text: 'Admin'}
    ];
    var model = ApiResource(SBApiCollections.Users);
    model.roles = roles;
    model.getRoles = getRoles;

    model.prototype.getUserRole = getUserRole;
    model.prototype.getFullName = function getFullName() {
        return this.name ? this.name : this.displayName;
    };

    return model;

    function getRoles() {
        return roles;
    }

    function getUserRole() {
        for (var i = 0; i < roles.length; i++) {
            if (roles.value === this.role) {
                return roles.text;
            }
        }
        return '';
    }
}
function TempUsersService(ApiService, model) {
    var service = ApiService(model, {
        listType: 'isGroup',
        materialProps: ['profilePictureURL']
        // listField: 'todoColumnId'  -> set it dynamically in get group prams
    });
    
    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    return service;

    function getChangedFieldForUpdateOther() {
        return ['profilePictureURL', 'profilePictureURLId'];
    }
}


/*https://codepen.io/Mamboleoo/pen/BxMQYQ*/
angular.module('components.animated-bg', [])
.component('animatedBg', {
    bindings :{
        options:'<'
    },
    controller:'AnimatedBgCtrl'
})
.controller('AnimatedBgCtrl', AnimatedBgCtrl);

AnimatedBgCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];

function AnimatedBgCtrl(TemplateCompileCompCtrlService, $element) {
    var withoutTemplateScope = true;

     var $ctrl = this;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        $ctrl.LCS.addClass($ctrl.element, 'animated-bg');
        $ctrl.mainWrapperCls = 'animatedbg';
        if(!$ctrl.options){$ctrl.options = {}}
         $ctrl.bgColor = $ctrl.options.bgColor || 'var(--bg-color)';
        $ctrl.colors = $ctrl.options.colors || ['#583C87', '#E45A84', '#FFACAC'];
        $ctrl.count = $ctrl.options.count || 23;
        $ctrl.particleSize = $ctrl.options.particleSize || 5;
        $ctrl.duration = $ctrl.options.duration || 6;
    }

    function onLoaded(){
        $ctrl.LCS.timeout(function (){
            $ctrl.LCS.insertFragmentBeforeChild($ctrl.element, getCSS(), $ctrl.element.querySelector('.'+$ctrl.mainWrapperCls));
        }, 100);
    }

    function getItemTemplate() {
    return '<div class="' + $ctrl.mainWrapperCls + '">' + getSpans() + '</div>';
    }

    function getSpans(){
        var el = '';
        for(var i = 0; i < $ctrl.count; i++){el +='<span></span>';}
        return el;
    }

    function getCSS(){
        var animation = 'animatebg',
            unit = 'px';//'vmin';
        var s = $ctrl.element.parentElement,
            w = s.offsetWidth / 100,
            h = s.offsetHeight / 100,
            size = 20;

        return '<style type="text/css">' +
            '@keyframes '+animation+'{100%{transform:translate3d(0, 0, 1px) rotate(360deg)}}' +
            '.animated-bg{overflow:hidden;position:absolute;height:100%;width:100%;display:flex; }'+
            '.'+ $ctrl.mainWrapperCls +'{overflow:hidden;position:absolute;height:100%;width:100%;top:0;left:0;background-color:'+$ctrl.bgColor+'}' +
            '.'+ $ctrl.mainWrapperCls +' span{width:'+size+unit+';height:'+size+unit+';border-radius:'+size+unit+';backface-visibility:hidden;position:absolute;animation:'+animation+';animation-duration:1s;animation-timing-function:linear;animation-iteration-count:infinite;}' +
            getSpansStyles() +
            '</style>';

        function getSpansStyles() {
            var el = '';
            for(var i = 1; i <$ctrl.count; i++) {
                var blurRadius = (random() + 0.5) * size * 0.5,
                    x = random(100) > 50 ? -1 : 1;

                el += '.' + $ctrl.mainWrapperCls + ' span:nth-child(' + ($ctrl.count - 1) + '){' +
                        'color:' + randomColor() + ';' +
                        'top:' + ((h * random(100)) / 100) + 'px;left:' + ((h * random(100)) / 100) + 'px' +
                        'animation-duration:' + (random($ctrl.duration * 10) / 10 + 10) + 's;' +
                        'animation-delay:-' + (random(($ctrl.duration + 10) * 10) / 10) + 's;' +
                        'transform-origin:' + ((random(50) - 25) * w )+ 'px ' +( (random(50) - 25) * h) + 'px;' +
                        'box-shadow:' + (size * 2 * x) + unit + ' 0 ' + blurRadius + unit + ' currentColor;' +
                    '}';
            }
            return el;
        }

        function r(min, max) { // min and max included
            return Math.floor(Math.random() * (max - min + 1) + min)
        }

        function randomColor() {
            return $ctrl.colors[r(0, $ctrl.colors.length - 1)];
        }
        function random(max){
            return r(1, max||100);
        }
    }
}


angular.module('components.btn-search', [
    'components.custom-search'
])
.component('btnSearch', {
    bindings:{
        isA: '@',
        header: '@',
        placeholder: '@',
        cClassAttr: '@',
        isShort:'@',
        onSearch: '&',
        withoutBackground: '@'
    },
    controller: 'BtnSearchCtrl'
})
.controller('BtnSearchCtrl', BtnSearchCtrl);
BtnSearchCtrl.$inject = ['TemplateCompileCompCtrlService', 'TemplateCompileService', '$element'];
function BtnSearchCtrl(TemplateCompileCompCtrlService, TemplateCompileService, $element) {
    console.log('BtnSearchCtrl');
    var $ctrl = this;

    $ctrl.TemplateCompileCompCtrlService = TemplateCompileCompCtrlService;
    $ctrl.TemplateCompileService = TemplateCompileService;

    var withoutTemplateScope = true;

    $ctrl.drpCls = 'btnSearchDrp';
    $ctrl.drpMenuCls = 'drpSearch';
    $ctrl.wrapperCls = 'searchWrapper';
    $ctrl.mainWrapperCls = 'dropdown';
    $ctrl.isOpen = false;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onTxtSearch = onTxtSearch;

    $ctrl = new $ctrl.TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);


    function getItemTemplate() {
        var tag = $ctrl.isA ? 'a' : 'button',
        cls = $ctrl.isA ? 'transparent' : 'btn primary-faded without-text';
return '<div class="'+$ctrl.mainWrapperCls+' position-relative">' +
            '<div class="'+$ctrl.drpMenuCls+' side-menu dropdown-menu display-block ng-hide">' +
                ($ctrl.header ? ('<div class="header-small clearfix with-side-padding30">'+$ctrl.header+'</div>') : '')+
                '<div class="'+$ctrl.wrapperCls+'" style="display: grid"></div>' +
            '</div>' +
            '<'+tag+' id="'+$ctrl.drpCls+'" type="button" class="' +cls+ ' btn-small dropdown-toggle" dropdown-toggle>' +
                $ctrl.LCS.getISBDiv('search', 2, 'pull-left') +
            '</'+tag+'>' +
        '</div>';
    }

    function onTxtSearch(search){
        $ctrl.onSearch({search: search});
    }

    function bind(isBind){
        if (!$ctrl.btnSearch) {
            $ctrl.btnSearch = $ctrl.element.querySelector('#' + $ctrl.drpCls);
        }
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnSearch, onBtnClick);
    }

    function bindBodyClick(isBind){
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.LCS.bodyElement, onBodyClick, 'btnSearch');
    }
    function onDestroy() {
        bind(false);
        destroySearch();
    }

    function onLoaded() {
        bind(true);
    }

    function destroySearch(){
        onTxtSearch(null);
        bindBodyClick(false);
        if ($ctrl.searchCompile) {
            $ctrl.searchCompile.destroyNewScope();
        }
    }

    function onBodyClick(e) {
        //   if(  $ctrl.LCS.findClosestParent(e.target, '#body-wrapper') &&
        if ($ctrl.isOpen && !$ctrl.LCS.findClosestParent(e.target, '.' + $ctrl.mainWrapperCls)) {
            console.log('btnSearch.onBodyClick');
            toggle(false);
        }
    }

    function onBtnClick(e){
        $ctrl.preventDefault(e);

        if(!$ctrl.drpMenu) {
            $ctrl.drpMenu = $ctrl.element.querySelector('.'+$ctrl.drpMenuCls);
        }

        if($ctrl.drpMenu) {
            toggle(!$ctrl.isOpen);
        }

        bindBodyClick(true);
    }

    function toggle(isOpen){
        if($ctrl.isOpen === isOpen){return;}

        $ctrl.isOpen = isOpen;

        $ctrl.LCS[$ctrl.isOpen ? 'removeClass':'addClass']($ctrl.drpMenu, 'ng-hide');

        if($ctrl.isOpen){
            if(!$ctrl.searchWrapper){
                $ctrl.searchWrapper = $ctrl.element.querySelector('.'+$ctrl.wrapperCls);
            }
            if (!$ctrl.searchCompile) {
                $ctrl.searchCompile = new $ctrl.TemplateCompileService(angular.element($ctrl.searchWrapper), getWrapperTemplate, $ctrl);
            }
            $ctrl.searchCompile.loadTemplate(function () {
                console.log('search loaded');

                $ctrl.LCS.timeout(function () {
                    var el = $ctrl.element.querySelector('#searchfield');
                    if(el){el.focus();}
                }, 100);

            });
        }else{
            destroySearch();
        }
    }

    function getWrapperTemplate(){
        return '<custom-search class="custom-search search-field pull-right" ' +
            'on-search="$ctrl.onTxtSearch(search)" '+
            ($ctrl.withoutBackground ? ('without-background="true" ') :'') +
            ($ctrl.placeholder ? ('placeholder="'+$ctrl.placeholder+'" ') :'') +
            ($ctrl.cClassAttr ? ('c-class-attr="' + $ctrl.cClassAttr + '" ') :'') +
            ($ctrl.isShort ? ('is-short="' + $ctrl.isShort + '" ') : '') +
                '></custom-search>';
    }
}


angular.module('components.custom-search', [
])
.component('customSearch', {
    bindings:{
        withoutBackground: '@',
        placeholder: '@',
        cClassAttr: '@',
        isShort:'@',
        onSearch: '&',
        onEnter: '&'
    },
    controller: 'CustomSearchCtrl'
})
.controller('CustomSearchCtrl', CustomSearchCtrl);
CustomSearchCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];
function CustomSearchCtrl(TemplateCompileCompCtrlService, $element) {
    console.log('CustomSearchCtrl');
    var withoutTemplateScope = true;
    var $ctrl = this;

    $ctrl.id = 'searchfield'
    $ctrl.delay = 500;
    $ctrl.search = null;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;
    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);


    function onLoaded() {
        bind(true);
        //setting
       // $ctrl.LCS.timeout(function () {
            $ctrl.element.querySelector('#' + $ctrl.id).focus();
       // }, 100);
        $ctrl.addRootWatcher('CLEAR_SEARCH', clearSearch);
    }

    function onDestroy() {
        bind(false);
    }

    function getItemTemplate() {
        return getI('search', 'primary') +
            '<input id="'+$ctrl.id+'" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" ' +
            'class="' +
                (($ctrl.isShort === 'true' || $ctrl.isShort === true) ? 'short' : '') +
                ($ctrl.cClassAttr ? $ctrl.cClassAttr : ' form-control search full-length') +
            ($ctrl.withoutBackground ? ' without-background' : '') +
            '" type="text" ' +
            'placeholder="' + ($ctrl.placeholder ? $ctrl.placeholder : 'Search…') + '"/>' +
            '<a class="clear-search sb-hide">' + getI('delete-circle') + '</a>';
    }

    function getI(icon, cls) {
        return $ctrl.LCS.getISBDiv(icon, null, cls ? cls : '');
    }

    function bind(isBind) {
        if(!$ctrl.searchField){
            $ctrl.searchField = $ctrl.element.querySelector('#searchfield');
        }
        $ctrl.LCS.bindElementListeners(isBind, $ctrl.searchField, oKeyUp, 'keyup');

        if(!$ctrl.clearField){
            $ctrl.clearField = $ctrl.element.querySelector('.clear-search');
        }
        $ctrl.LCS.bindElementListeners(isBind, $ctrl.clearField, clearSearch);
    }

    function oKeyUp(e) {
        callSearch(e, e.target.value);
    }

    function clearSearch(e) {
        console.log('clearSearch ');
        var val = null;
        $ctrl.searchField.value = val;
        $ctrl.searchField.focus();
        callSearch(e, val);
    }

    function callSearch(e, val) {
        console.log('callSearch ' +val );
        $ctrl.preventDefault(e);
        if (val === '') {
            val = null;
        }
        if($ctrl.search !== val){
            $ctrl.search = val;
            $ctrl.LCS[val ? 'removeClass' : 'addClass']($ctrl.clearField, 'sb-hide');

            $ctrl.onSearch({search: $ctrl.search});
        }
    }
}

