}


angular.module('user.workflowPage.component', [
    'product.workflowBoard.controller.service'
])
.component('userWorkflowPage',{
    controller:'UserWorkflowPageCtrl'
})
.controller('UserWorkflowPageCtrl', UserWorkflowPageCtrl);
UserWorkflowPageCtrl.$inject = ['WorkflowBoardCtrlService','$element'];
function UserWorkflowPageCtrl(pageCtrlService, $element) {

    console.log('UserWorkflowPageCtrl');

    var $ctrl = this;
    $ctrl.productId = null;
    $ctrl.isOnProduct = false;

    $ctrl.getTopFiltersTitle = getTopFiltersTitle;

    $ctrl = new pageCtrlService($ctrl, $element);

    function getTopFiltersTitle(isList) {
        return  '';
        var hasFilter = $ctrl.CPS.isAuthenticated &&
                $ctrl.showFilter() && (!$ctrl.withArchiveGroupAsList && ($ctrl.withActiveGroup || $ctrl.withActiveTree)),
            t = getTitle(isList),
            t1 = getTitle(true);
        return (typeof ($ctrl.getPageTitle) === 'function' ? $ctrl.getPageTitle() : '') +
            (hasFilter ? $ctrl.getDrpSelectedFilters(null, $ctrl.filterTitleExt, _.extend({
                btnClass: $ctrl.isCommentsSidebar ? null : 'with-bg',
                //cls: $ctrl.CPS.isAuthenticated ? 'sb-hide' : ''
            }, $ctrl.drpSelectedFiltersClass ? {drpClassAttr: $ctrl.drpSelectedFiltersClass} : null)) : t) +
            (getText(t) !== getText(t1) ? t1 : '');

        //(sf  ? getTitle(true) : '');

        function getText(html) {
            return $ctrl.LCS.createFragment('<div>' + html + '<div>').children[0].innerText.toLowerCase();
        }

        function getTitle(isList) {
            return $ctrl.LCS.isMobileSize && $ctrl.hideTitleOnMobile ? '' : $ctrl.getTopFiltersTitleInit(isList);
        }
    }
}

var PreloadingInstances;
angular.module('product.preLoading.provider', [
    'product.preLoading.products.group.service',
    'product.preLoading.script.group.service',
    'product.preLoading.callsheet.group.service',
    'product.preLoading.callsheets.group.service',
    'product.preLoading.locations.group.service',
    'product.preLoading.elements.group.service',
    'product.preLoading.departments.group.service',
    'product.preLoading.documents.group.service',
    'product.preLoading.materials.group.service',
    'product.preLoading.shots.group.service',
    'product.preLoading.storyboards.group.service',
    'product.preLoading.moodboards.group.service',
    'product.preLoading.team.group.service',
    'product.preLoading.todoCards.group.service',
    'product.preLoading.tasks.group.service',
    'product.preLoading.productDetails.group.service',
    'product.preLoading.contacts.group.service',
    'product.preLoading.calendars.group.service',
    'product.preLoading.todoCardsScript.group.service',
    'product.preLoading.todoCardsSidebar.group.service',
    'product.preLoading.todoCardsBoards.group.service',
    'product.preLoading.avscripts.group.service',
    'product.preLoading.activities.group.service',
    'product.preLoading.taskBoards.group.service',
    'product.preLoading.widgets.group.service',
    'product.preLoading.myTodoCards.group.service',
    'product.preLoading.myCallsheets.group.service',
    'product.preLoading.myTeam.group.service',
    'product.preLoading.myComments.group.service',
    'product.preLoading.myActivities.group.service',
    'product.preLoading.myProducts.group.service'
])
.factory('PreLoadingProv', PreLoadingProv);
PreLoadingProv.$inject = ['ScriptGroupLoadingService', 'ProductsGroupLoadingService', 'LocationsGroupLoadingService', 'CallsheetsGroupLoadingService', 'CallsheetGroupLoadingService', 'DepartmentsGroupLoadingService', 'DocumentsGroupLoadingService', 'MaterialsGroupLoadingService', 'AvscriptsGroupLoadingService', 'ShotsGroupLoadingService', 'StoryboardsGroupLoadingService', 'MoodboardsGroupLoadingService', 'TeamGroupLoadingService',
    'TodoCardsGroupLoadingService', 'TodoCardsScriptGroupLoadingService', 'TodoCardsBoardsGroupLoadingService', 'TodoCardsSidebarGroupLoadingService', 'TasksGroupLoadingService', 'ProductDetailsGroupLoadingService', 'ContactsGroupLoadingService', 'CalendarsGroupLoadingService', 'TaskBoardsGroupLoadingService', 'ActivitiesGroupLoadingService', 'WidgetsGroupLoadingService', 'MyTodoCardsGroupLoadingService','MyCallsheetsGroupLoadingService', 'MyTeamGroupLoadingService', 'MyCommentsGroupLoadingService', 'MyActivitiesGroupLoadingService', 'MyProductsGroupLoadingService'];
function PreLoadingProv(ScriptGroupLoadingService, ProductsGroupLoadingService, LocationsGroupLoadingService, CallsheetsGroupLoadingService, CallsheetGroupLoadingService, DepartmentsGroupLoadingService, DocumentsGroupLoadingService, MaterialsGroupLoadingService, AvscriptsGroupLoadingService, ShotsGroupLoadingService, StoryboardsGroupLoadingService, MoodboardsGroupLoadingService, TeamGroupLoadingService,
    TodoCardsGroupLoadingService, TodoCardsScriptGroupLoadingService, TodoCardsBoardsGroupLoadingService, TodoCardsSidebarGroupLoadingService, TasksGroupLoadingService, ProductDetailsGroupLoadingService, ContactsGroupLoadingService, CalendarsGroupLoadingService, TaskBoardsGroupLoadingService, ActivitiesGroupLoadingService, WidgetsGroupLoadingService, MyTodoCardsGroupLoadingService, MyCallsheetsGroupLoadingService, MyTeamGroupLoadingService, MyCommentsGroupLoadingService, MyActivitiesGroupLoadingService, MyProductsGroupLoadingService) {
    var instances = {},
        PreloadingTypes = {
            Products: 1,
            Scripts: 2,
            Locations: 3,
            Callsheets: 4,
            Callsheet: 5,
            Departments: 7,
            Documents: 8,
            Materials: 9,
            Shots: 10,
            Team: 11,
            TodoCards: 12,
            Contacts: 13,
            Tasks: 14,
            Calendars: 15,
            TodoCardsScripts: 16,
            TodoCardsSidebar: 20,
            ProductDetails: 17,
            Moodboards: 18,
            Storyboards: 19,
            AvScripts: 21,
            TaskBoards: 22,
            TodoCardsBoards: 23,
            Activities: 24,
            Widgets: 25,
            MyTodoCards: 26,
            MyTeam: 27,
            MyCallsheets: 28,
            MyComments: 29,
            MyActivities: 30,
            MyProducts: 31
        };

    PreloadingInstances = instances;

    return {
        PreloadingTypes: PreloadingTypes,
        getInstance: getInstance,
        getScriptPreloader: getScriptPreloader,
    };

    function getScriptPreloader(params, listFieldForTables) {
        return getInstance(params, PreloadingTypes.Scripts, listFieldForTables);
    }

    function getInstance(params, type, listFieldForTables) {//consider page
        var id;
        switch (type) {
            //todo note:
            // if changing the extra params must update also the params for method getTableParamsId
            // in product.preLoading.tables.service

            //companyId
            case PreloadingTypes.Activities:
            case PreloadingTypes.Contacts:

            case PreloadingTypes.Products:
            case PreloadingTypes.Team:
            case PreloadingTypes.TaskBoards:
                id = getCompId(params, type);
                break;

            //companyId teamId

            case PreloadingTypes.MyActivities:
            case PreloadingTypes.MyProducts:
            case PreloadingTypes.MyTodoCards:
            case PreloadingTypes.MyCallsheets:
            case PreloadingTypes.MyTeam:
            case PreloadingTypes.MyComments:
            case PreloadingTypes.Widgets:
                id = getWidgetsId(params, type);
                break;

            //companyId productId todoCardId //add taskBoardId
            case PreloadingTypes.Tasks: // dont preserve tasks for now
                id = getExtraId(params, type, ['todoCardId']);
                break;

            //companyId productId type uId (isonlycomment -> for sidebarcomment) . //add taskBoardId for TodoCards
            case PreloadingTypes.TodoCards:
            case PreloadingTypes.TodoCardsSidebar:
            case PreloadingTypes.TodoCardsScripts:
                id = getExtraId(params, type, ['type', 'uId']);
                break;

            case PreloadingTypes.TodoCardsBoards:
                id = getExtraId(params, type, ['type', 'taskBoardId']);
                break;

            //companyId productId type
            case PreloadingTypes.Documents:
                id = getExtraId(params, type, ['type']);
                break;

            //companyId productId scriptId
            case PreloadingTypes.Scripts:
            case PreloadingTypes.Shots:
            case PreloadingTypes.Storyboards:
                id = getExtraId(params, type, ['scriptId']);
                break;

            case PreloadingTypes.AvScripts:
                id = getExtraId(params, type, ['documentId']);
                break;

            //companyId productId callsheetId
            case PreloadingTypes.Callsheet:
                id = getExtraId(params, type, ['callsheetId']);
                break;


            //companyId productId
            default:
                //case PreloadingTypes.Tasks: // dont preserve tasks for now
                id = getProdId(params, type);
                break;
        }

        var instance = instances[id];
        if (!instance) {
            var Service = getServiceByType(type);
            instance = new Service(params);
            instances[id] = instance;
        }

        if (listFieldForTables) {
            instance.updateListFieldForTables(listFieldForTables);
        }

        return instance;
    }

    function getServiceByType(type) {
        switch (type) {
            //companyId
            case PreloadingTypes.Products:
                return ProductsGroupLoadingService;

            case PreloadingTypes.Contacts:
                return ContactsGroupLoadingService;

            case PreloadingTypes.Team:
                return TeamGroupLoadingService;

            case PreloadingTypes.TaskBoards:
                return TaskBoardsGroupLoadingService;

            //companyId productId type
            case PreloadingTypes.Documents:
                return DocumentsGroupLoadingService;

            //companyId productId scriptId
            case PreloadingTypes.Scripts:
                return ScriptGroupLoadingService;

            case PreloadingTypes.Storyboards:
                return StoryboardsGroupLoadingService;

            case PreloadingTypes.Shots:
                return ShotsGroupLoadingService;

            //companyId productId callsheetId
            case PreloadingTypes.Callsheet:
                return CallsheetGroupLoadingService;

            //companyId productId
            case PreloadingTypes.Locations:
                return LocationsGroupLoadingService;

            case PreloadingTypes.Departments:
                return DepartmentsGroupLoadingService;

            case PreloadingTypes.AvScripts:
                return AvscriptsGroupLoadingService;

            case PreloadingTypes.Moodboards:
                return MoodboardsGroupLoadingService;

            case PreloadingTypes.Callsheets:
                return CallsheetsGroupLoadingService;

            case PreloadingTypes.Materials:
                return MaterialsGroupLoadingService;

            case PreloadingTypes.Tasks:
                return TasksGroupLoadingService;

            case PreloadingTypes.ProductDetails:
                return ProductDetailsGroupLoadingService;

            case PreloadingTypes.Calendars:
                return CalendarsGroupLoadingService;

            case PreloadingTypes.TodoCards:
                return TodoCardsGroupLoadingService;

            case PreloadingTypes.TodoCardsSidebar:
                return TodoCardsSidebarGroupLoadingService;

            case PreloadingTypes.TodoCardsScripts:
                return TodoCardsScriptGroupLoadingService;

            case PreloadingTypes.TodoCardsBoards:
                return TodoCardsBoardsGroupLoadingService;

            case PreloadingTypes.Activities:
                return ActivitiesGroupLoadingService;

            case PreloadingTypes.Widgets:
                return WidgetsGroupLoadingService;

            case PreloadingTypes.MyTodoCards:
                return MyTodoCardsGroupLoadingService;

            case PreloadingTypes.MyCallsheets:
                return MyCallsheetsGroupLoadingService;

            case PreloadingTypes.MyTeam:
                return MyTeamGroupLoadingService;

            case PreloadingTypes.MyComments:
                return MyCommentsGroupLoadingService;

            case PreloadingTypes.MyActivities:
                return MyActivitiesGroupLoadingService;

            case PreloadingTypes.MyProducts:
                return MyProductsGroupLoadingService;

            default:
                return null;
        }
    }

    function getCompId(params, type) {
        return type + '_' + params.companyId;
    }

    function getProdId(params, type) {
        return getCompId(params, type) + '_' + (params.productId ? params.productId : null);
    }

    function getWidgetsId(params, type) {
        return getCompId(params, type) + '_' + getExtra(params, ['teamId', 'type']);
    }

    function getExtraId(params, type, typeArray) {
        return getProdId(params, type) + '_' + getExtra(params, typeArray);
    }

    function  getExtra(params, typeArray){
        var el = '',
            l = typeArray && typeArray.length > 0 ? typeArray.length : 0;
        for (var i = 0; i < l; i++) {
            var v = params[typeArray[i]] + (i !== l - 1 ? '_' : '');
            el += v ? v : null;
        }
        return el;
    }
}

angular.module('product.preLoading.activities.group.service', [
    'product.preLoading.init.group.service',
    'product.preLoading.activities.service',
    'product.preLoading.products.service',
    'product.preLoading.todoPages.service'
])
 .service('ActivitiesGroupLoadingService', ActivitiesGroupLoadingService);
ActivitiesGroupLoadingService.$inject = ['InitGroupLoadingService', 'ActivitiesLoadingService', 'ProductsLoadingService', 'TodoPagesLoadingService'];
function ActivitiesGroupLoadingService(InitGroupLoadingService, Activities, Products, TodoPages) {
    var Tbl = {}, TblTypes = {};

    _.each([Activities, Products, TodoPages], function (table) {
        var name = table.name;
        var withoutLoad = name === 'Products';
        TblTypes[name] = table.tableType;
        Tbl[TblTypes[name]] = {loadingService: table, withoutLoad: withoutLoad,

            customLoading: name === 'Activities',
        };
    });

    var Resource = new InitGroupLoadingService(Tbl, 'isInitActivities', null, TblTypes);

    Resource.prototype.load = function (next, otherParams) {
        var _this = this,
            m = 'getAll',
            tasks = {};

        add('Activities', m, function (params) {
           // params.type = type;
            return { };
        });

        add('TodoPages', 'getAllForPreloading');

        async.parallel(tasks, function (err, res) {
            next();
        });

        function add(table, m, processParams, pageSize, populate){
            tasks[table] = function (c) {
                _this.loadAndInitTable(_this.TblTypes[table], pageSize, populate, c, m, processParams);
            };
        }
    };

    return Resource;
}

