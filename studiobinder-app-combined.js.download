TraceConfigHook.$inject = ['API_CONFIGS', '$uiRouterProvider'];

function TraceConfigHook(API_CONFIGS, $uiRouter) {
    var configs = API_CONFIGS();
    if(configs.debugger && configs.debugger.enabled){
        $uiRouter.trace.enable('TRANSITION');
    }

// Enable tracing of each TRANSITION... (check the javascript console)

// This syntax `$trace.enable(1)` is an alternative to `$trace.enable("TRANSITION")`.
// Besides "TRANSITION", you can also enable tracing for : "RESOLVE", "HOOK", "INVOKE", "UIVIEW", "VIEWCONFIG"
}


AuthorizationParam.$inject = ['SBAuthorization'];
AppPreloadParam.$inject = ['BlocksSetupService'];

angular.module('app.states.constant', [
    'sbApp.component',
    'sbAppPrint.component',
    'security.authorization'
])
.constant('MAIN_APP_STATES', getMainAppStates())

function getMainAppStates(){
    var publicState =  {
        name: 'public',
        parent: getParentName(false),
        url: '/',
        abstract: true,
        data: getData(true),
        views: {
            appview :{
                template: getTemplate(true)
            }
        }
    }

    return [
        getAppState(false),
        getAppState(true),
        publicState,
        getUserState(false),
        getUserState(true)
    ];

    function getAppState(isPrint) {
        var parent = getParentName(isPrint);
        return {
            name: parent,
            component: 'sb' + parent,
            abstract: true,
            resolve: {
                // authorize: AuthorizationParam,
                preload: AppPreloadParam
            }
        };
    }

    function getUserState(isPrint){
       var isPublic = false;
        return {
            name: (isPrint ? getPrintExt() : '') + 'user',
            parent: getParentName(isPrint),
            url: (isPrint ? '/print/:invitationId' : '') + '/company/:companyId/:role/:teamId',
            abstract: true,
            data: getData(isPublic),
            views: {
                appview :{
                    template: getTemplate(isPublic, isPrint),
                }
            }
        }
    }

    function getData(isPublic){
        return {
            minRole: isPublic ? 0 : 1,
            memberType : 0
        }
    }

    function getTemplate(isPublic, isPrint) {
        var tag = isPublic ? 'layout-unlogged' : (isPrint ? 'layout-print' : 'layout-logged');
        return getCollabBanner() +
            '<' + tag + ' ' +
                (isPublic ? 'id="body-surface" ' : '') +
                'class="'+tag+' h-full ' + (isPublic ? 'isStaticPage display-block' : '') + '" window-width="$ctrl.windowWidth" window-height="$ctrl.windowHeight" is-mobile-opened="$ctrl.isMobileOpened"></' + tag + '>';

        function getCollabBanner(){
            if(isPublic || isPrint){return '';}
            return '<div class="alert alert-warning collab-alert-nav without-margin-bottom hide-print"><div class="centered text-center">' +
                '<div class="text"></div>' +
                '<a href="" target="_blank" class="btn btn-primary inline-block with-transition">Get Started Free</a></div>' +
                //'<div class="centered btn-col text-center col40"></div>' +
                '</div>';
        }
    }

    function getParentName(isPrint){
        return 'app' + (isPrint ? 'print' : '');
    }
}

function AppPreloadParam(BlocksSetupService) {
    if (!BlocksSetupService.isLoaded) {
        BlocksSetupService.init();
    }
    return BlocksSetupService.isLoaded;
}

function AuthorizationParam( SBAuthorization){
    return SBAuthorization.authorize();
}

