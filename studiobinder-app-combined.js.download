angular.module('product.reportsPage.service', [
    'product.reportsPage.init.controller.service',
    'apiConstants.reports.services',
    'apiServices.TaggingElements',
    'product.sides.scriptSides.service'
])

.constant('ReportsPageCtrlServiceInjectors', {
    pageCtrlService: 'ReportsPageInitCtrlService',
    constantsService: 'ReportsConstantsService',

    //service: 'LocationsService',
    VideoService: 'VideoService',
    TaggingElementsService: 'TaggingElementsService',
    ScriptSidesCtrlService: 'ScriptSidesCtrlService',

})

.service('ReportsPageCtrlService', ReportsPageCtrlService);

ReportsPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'ReportsPageCtrlServiceInjectors'];
function ReportsPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    return function($ctrl, $element, printPageParams) {
        var sep = '<span class="dot-separator small dark"></span>';

        var defaultReportId = '3';

        $ctrl.onDestroyOther = onDestroyOther;
        $ctrl.isReports = true;

        $ctrl.TdWidth = 40;
        $ctrl.scriptSides = {
            showDetails: true,
            showNotes: true,
            showTagging: false,
            withTagging: true,

            withHeader: true,
            withDayHeader: true,
            pageBreak: false,
            dayBreak: false,
            showHeader: true,
            showOmitted: false,
            showBoneyard: false,
            showLocations: true,
            showSynopsis: true,
            showDescription: true,
            showStoryday: true,
            showTimes: true,
            showOffDays: true,
            showNonscriptedElements: true,
            showSummary: true,
            showHold: false,
            showDays: true,
            showElementNote: true,
            showElementRate: true
        };
        $ctrl.scriptSidesJson = JSON.stringify($ctrl.scriptSides);

        $ctrl.DisplayFilters = [
            {_id: 5, name: 'Reports Header', prop: 'showHeader'},
            {_id: 2, name: 'Scene Headers', prop: 'withHeader'},
            {_id: 14, name: 'Day Headers', prop: 'withDayHeader'},

            {_id: 3, name: 'Page Break after Scenes', icon: 'split-horizontal', prop: 'pageBreak'},//4
            {_id: 4, name: 'Page Break after Shoot Days', icon: 'split-horizontal', prop: 'dayBreak'}, //5

            {_id: 4, name: 'Omitted Scenes', icon: 'box', prop:'showOmitted'},
            {_id: 7, name: 'Boneyard', icon: 'boneyard', prop: 'showBoneyard'},//3
            {_id: 1, name: 'Scene Details', icon: 'info-square', prop:'showDetails'}, //0
            {_id: 13, name: 'Scene Notes', icon: 'postit', prop:'showNotes'},
            {_id: 8, name: 'Locations', icon: 'pin', prop:'showLocations'},//1

          //todo bring back
             {_id: 9, name: 'Show Days Off', icon: 'clock', prop:'showOffDays'},//1


            {_id: 11, name: 'Show Synopsis', icon: 'postit', prop:'showSynopsis'},//1
            {_id: 12, name: 'Show Description', icon: 'postit', prop:'showDescription'},//1
            {_id: 15, name: 'Show Script Day', icon: 'postit', prop:'showStoryday'},
            {_id: 10, name: 'Times', icon: 'clock', prop:'showTimes'},//1

            //elements
             {_id: 16, name: 'Non Scripted Elements', icon: 'pin', prop:'showNonscriptedElements'},//1
            {_id: 18, name: 'Show Element Rate', icon: 'pin', prop:'showElementRate'},
            {_id: 19, name: 'Show Element Notes', icon: 'pin', prop:'showElementNote'},
            //dood
            {_id: 17, name: 'Row Summary', icon: 'pin', prop:'showSummary'},
            {_id: 19, name: 'Show Days', icon: 'pin', prop:'showDays'},
            {_id: 19, name: 'Show Hold Column', icon: 'pin', prop:'showHold'}
        ];

        $ctrl.elemCount = 0;
        $ctrl.elementsCount = 0;

        $ctrl.getReport = getReport;
        $ctrl.getHeaderTitle = getHeaderTitle;
        $ctrl.changeHold = changeHold;
        $ctrl.toggleOther = toggleOther;
        $ctrl.selectStrip = selectStrip;

        $ctrl.goToPage = goToPage;
        $ctrl.incrementCount = incrementCount;
        $ctrl.getEmptyTable = getEmptyTable;

        $ctrl.getPageTemplateOther = getPageTemplateOther;

        $ctrl.onPageLoadedOther = onPageLoadedOther;
        $ctrl.additionalScriptInitOther = additionalScriptInitOther;
        $ctrl.onStripsChangedOther = onStripsChangedOther;
        $ctrl.toggleDisplayOptionsOther = toggleDisplayOptionsOther;
        $ctrl.getCollabBannerInfo = getCollabBannerInfo;

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);
        $ctrl = new $ctrl.ScriptSidesCtrlService ($ctrl);

        return $ctrl;
        function getCollabBannerInfo(){
            return {txt: 'Create your own script breakdowns and schedules for free.', campaign:'collab-reports'};
        }
        function onPageLoadedOther(scriptLoadingService) {
            console.log('onPageLoadedOther');

            if ($ctrl.info && $ctrl.info.stripId) {
                $ctrl.anchorScroll('scene' + $ctrl.info.stripId);
            }
            bind(true);
        }

        function onDestroyOther() {
            bind(false);
            bindHold(false);
        }

        function bind(isBind) {
            $ctrl.VideoService.bindVideo($ctrl, isBind);
        }

        function onStripsChangedOther() {
            console.log('onStripsChangedOther');
            reloadReport();
        }

        function toggleDisplayOptionsOther(prop, val){
            if(prop === 'showOffDays' && $ctrl.selectedReport.layout === 'dood'){
                setDoodTableFilters();
            }
        }

        function setDoodTableFilters() {
            var withOff = $ctrl.scriptSides.showOffDays,
                table = $ctrl.element.querySelector('.dood-table');
            if(table) {
                $ctrl.LCS[withOff ? 'removeClass' : 'addClass'](table, 'hide-off-days');
                if ($ctrl.FiltersW && $ctrl.FiltersWCount > 20) {
                    $ctrl.TdWidth = 40;//850 / ($ctrl.FiltersWCount - (withOff ? 0 : $ctrl.FiltersWOffCount));
                    var width = 40,
                        cell = table.querySelectorAll('td.dayx-col');
                    $ctrl.LCS.setCSSStyle(cell, 'width', width + 'px');
                    _.each($ctrl.FiltersM, function (m, i) {
                        var mEl = table.querySelector('#months_' + i);
                        if (mEl) {
                            var colspan = m.colspan - ((!withOff && m.isOff) ? m.isOff : 0);
                            $ctrl.LCS.setCSSStyle(mEl, 'width', (colspan * width) + 'px');
                            mEl.setAttribute('colspan', colspan);
                            $ctrl.LCS[colspan ? 'removeClass' : 'addClass'](mEl, 'sb-hide');
                        }
                    });
                }
            }
        }

        function showFilterDRow(d) {
            var id = $ctrl.filters[$ctrl.Types.Days],
                isNull = $ctrl.isNullValue(d._id);
            return !isNull &&
            (!$ctrl.isNullValue(id) && id === d._id || isNull &&
                ($ctrl.selectedReport.row === 'strip' || $ctrl.selectedReport.row === 'elements' && (id !== 0 && d.categories[id] || id === 0)
                )
            ) && ($ctrl.selectedReport.row === 'strip' || $ctrl.selectedReport.row === 'elements' && d.categories);
        }


        function showPage() {
            return $ctrl.stripsCount > 0 || $ctrl.nonscriptedElements !== null;
        }

        function additionalScriptInitOther() {
            if(showPage()) {
                $ctrl.LCS.PersistenceService.setReportsViewed($ctrl.CPS.productId, true);
            }

            //check the vals for filter & type
            $ctrl.filters[$ctrl.Types.Reports] = $ctrl.filterSearch && $ctrl.filterSearch.r ? $ctrl.filterSearch.r : defaultReportId
           if($ctrl.filterSearch) {
               if ($ctrl.filterSearch.h) {
                   var show = $ctrl.filterSearch.h.split('');
                   for (var i = 0; i < show.length; i++) {
                       show[i] = show[i] === '1';
                   }
                   $ctrl.filterSearch.h = show;
               }

               //todo
          /*     $ctrl.info = {
                   report: $ctrl.selectedReport._id,
                   show: $ctrl.selectedReport.withShow ? ($ctrl.filterSearch.h ? $ctrl.filterSearch.h : defaultShow) : null,
                   scheduleDayId: $ctrl.selectedReport.withDays && $ctrl.filterSearch.d ? $ctrl.filterSearch.d : 0,
                   categoryId: $ctrl.selectedReport.sidebar === 2 && $ctrl.filterSearch.c ? $ctrl.filterSearch.c : 0,
                   stripId: $ctrl.selectedReport.sidebar === 1 && $ctrl.filterSearch.s ? $ctrl.filterSearch.s : 0
               };*/

           }

            return true;
        }

        function getReport(item) {
            $ctrl.selectedReport = item;
            if(!$ctrl.info){$ctrl.info = {};}
            $ctrl.info.stripId = 0;

            $ctrl.info.date = $ctrl.MomentService.getMomentNow();
            $ctrl.info.name = $ctrl.selectedReport.name;
            toggleDisplayOptions();
            onLoadShow();
        }

        function toggleDisplayOptions() {
            //Element List
            var scheduling = ['showNotes', 'showLocations', 'showSynopsis', 'showStoryday', 'showTimes', 'withHeader', 'showDetails', 'showDescription'],
                elements = ['showNonscriptedElements', 'showElementRate', 'showElementNote'],
                dood = ['showSummary', 'showHold','showDays'];
            if($ctrl.selectedReport._id === '4'){
                show(elements.concat(scheduling), true);
                show(dood, false);
            }
            //Day out of Days
           else if($ctrl.selectedReport._id === '6'){
                show(dood, true);
                show(elements.concat(scheduling), false);
           } else{ // Shooting Schedule * Breakdown Summary
                show([].concat(elements).concat(dood), false);
                show(scheduling, true);
            }

            function show(props, show) {
                _.each(props, function (prop) {
                    $ctrl.showDisplayOption(prop, show);
                });
            }
        }

        function onLoadShow() {
            $ctrl.info.isOneLine = $ctrl.filters[$ctrl.Types.Reports] === '5' && $ctrl.scriptSides.showDetails && !$ctrl.scriptSides.showNotes && !$ctrl.scriptSides.withTagging && !$ctrl.scriptSides.showBoneyard;
            $ctrl.info.name = $ctrl.info.isOneLine ? 'One Liner Schedule' : $ctrl.selectedReport.name;
        }

        function toggleOther(e, prop) {
            onLoadShow();
            setSearch();
        }

        function selectStrip(item) {
            $ctrl.info.stripId = item._id;
            setSearch();
            $ctrl.anchorScroll('scene' + item._id);
        }

        function goToPage(page, p) {
            $ctrl.popupsService.teamAccess(function () {
                $ctrl.CPS.transitionTo('user.product.' + page, $ctrl.CPS.currentProductPathParams(p));
            });
        }

        function incrementCount(val) {
            if (val !== undefined) {
                $ctrl.elemCount = val;
            }
            $ctrl.elemCount++;
        }

        function setSearch() {
            var oi = $ctrl.info, info = null;
            if (oi) {
                info = {};
                var h = oi.show;
                if (h) {
                    var r = '';
                    for (var p in h) {
                        r += h[p] ? 1 : 0;
                    }
                    h = r;
                }
                if (h) {
                    info.h = h;
                }
                if (oi.scheduleDayId && oi.scheduleDayId !== 0) {
                    info.d = oi.scheduleDayId;
                }
                info.c = oi.categoryId && oi.categoryId !== 0 ? oi.categoryId : 0;
                if (oi.stripId && oi.stripId !== 0) {
                    info.s = oi.stripId;
                }
                info.r = $ctrl.filters[$ctrl.Types.Reports];
            }
            $ctrl.CPS.setSearchFilter(info, 'filter');
        }

        function getPageTemplateOther() {
            var show = showPage();
            return '<div class="' + $ctrl.tableCls + (show ? '' : ' sb-hide') + '"></div>' +
                (show ? '' : noScreenplay());
        }

        function reloadReport() {
            var isDood = $ctrl.selectedReport.layout === 'dood';
            var section = $ctrl.element.querySelector('.' + $ctrl.tableCls);
            if (section) {
                bindGoEls(false);
                $ctrl.replaceContent(section, getReportLayout());
                bindGoEls(true);
            }

            function bindGoEls(isBind) {
                $ctrl.bindClickEvent(section.querySelector('#btnGoS'), isBind, goToScheduling);
                $ctrl.bindClickEvent(section.querySelector('#btnGoB'), isBind, goToBreakdowns);

                if(isBind){
                    var a = $ctrl.element.querySelector('a[data-id="showOffDays"]');
                    if(a){
                        $ctrl.LCS[isDood ? 'removeClass' : 'addClass'](a.parentElement, 'sb-hide');
                    }
                    setDoodTableFilters();
                }
                if(!isBind || isDood) {
                    bindHold(isBind);
                }
            }
        }

        function goToScheduling(e){
            $ctrl.preventDefault(e);
            $ctrl.goToPage('scheduling'  );//todo go to the specific schedule
        }

        function goToBreakdowns(e){
            $ctrl.preventDefault(e);
            $ctrl.goToPage('breakdowns');
        }

        function getEmptyTable(withoutFilters) {
             var path = 'emptystate/' + $ctrl.overviewBlockType + '/emptystate',
                 h3, txt;
             if (!$ctrl.stripsCount) {
                 h3 = 'No scenes have been added yet.';
                 txt = 'add scenes or import a script';
             } else if (!$ctrl.categories) {
                 h3 = 'No elements have been tagged yet.';
                 txt = 'tag elements on your script';
             }
        return '<div ng-show="!(' +
            //$ctrl.stripsCount + ' && ' + //display if there are no strips
            '($ctrl.selectedReport.sidebar === 1 || $ctrl.selectedReport.sidebar === 2 && $ctrl.categories))" class="full-content with-fancy-scrollbar show-scrollbar-on-hover h-full ' + (withoutFilters ? '' : 'with-filters') + '">' +
                 '<div class="tab-content margin-half with-radius with-white-bg margin-bottom-30 ' + (withoutFilters ? '' : 'with-filters') + '">' +
                     '<div class="no-product h-full with-white-bg centered text-center">' +
                         '<video class="video-anime" muted playsinline autoplay="autoplay" loop="loop" poster="' + $ctrl.LCS.getImgUrl(path + '.jpg') + '"><source src="' + $ctrl.LCS.getVideoUrl(path + '.mp4') + '" type="video/mp4"></video>' +
                         '<div>' +
                             '<h3 class="text-center">' + h3 + '</h3>' +
                             '<p class="spacing-half text-center">To generate this report, you need to first ' + txt + '. <br/> You can do so via the Breakdowns page.</p>' +
                             getBtn() +
                        '</div>' +
                     '</div>' +
                '</div>' +
            '</div>';

             function getBtn() {
                 return ($ctrl.canEdit ? ('<div class="text-center">' +
                     '<button class="btn btn-small transparent big with-margin-left uppercase" ng-click="$ctrl.goToPage(\'breakdowns\')" analytics-on analytics-action="Go to Breakdowns">Go to Breakdowns</button>' +

                     '</div>') : '');
             }
         }

        function getBreak(type) {
            return '<div class="' + $ctrl.getScriptSidesCls(type) +'"><div class="view-page-break hide-ipad onsides"></div></div>'
        }

        function getHeaderTitle(){
         return '<span class="sbf gray" ng-class="$ctrl.info.icon?$ctrl.info.icon:$ctrl.selectedReport.icon" ng-style="$ctrl.info.color && {color: $ctrl.info.color}">'+ $ctrl.LCS.getISBPath(6)+'</span> ' +
                '<span ng-bind="$ctrl.info.name"></span> ' +
                '<span ng-show="$ctrl.info.count>0" style="color:#A3ADB5" ng-bind="\'(\'+$ctrl.info.count+\')\'"></span>  ' +
                $ctrl.LCS.getISBDiv('info', 3, 'blue hide-print margin-left-6', ' tooltip-placement="top" tooltip="{{$ctrl.info.isOneLine ? $ctrl.selectedReport.tooltipOneLine : $ctrl.selectedReport.tooltip}}"') +
                '</span>';
        }

        function noScreenplay() {
            return '<div class="no-screenplay no-product unit-xs sb-hide">' +
                        '<div class="centered circled-svg-colored small150 stripboard '+
                        ($ctrl.pageClass ? $ctrl.pageClass : '') +
                        '">' + $ctrl.LCS.getISBStripboard()+ '</div>' +
                        '<div><h3 class="text-center">No screenplay has been uploaded yet.</h3></div>' +
                    '</div>';
        }

        function getReportLayout() {
            var layout = $ctrl.selectedReport.layout;
            if(!showPage()){return '';}
            switch (layout) {
                case 'days':
                case 'scenes':
                    var days = $ctrl.FiltersD && $ctrl.FiltersD.length >0 ? _.sortBy(_.filter($ctrl.selected, {type: $ctrl.StripTypes.DayBreak}), 'order') : null;
                    if(days && days.length>0) {
                        return getReportDayBreaks(days);
                    }else{
                        return getReportLayoutScenes();
                    }
                case 'dood': return getReportLayoutDood();
                case 'elements': return getReportLayoutElements();
            }

            function getReportDayBreaks(days) {
                var l = days ? days.length : 0;
                return l ? days.map(function(d, i){
                    return processDay(d, i === l - 1);
                }).join('') : '';

                function processDay(d, isLast) {
                    // ng-show="$ctrl.showFilterDRow($ctrl.FiltersD[\''+id+'\'])"
                return '<table class="row-day margin-top-half full-width">' +
                            getDayHeader(d) +
                            //or-> ng-if="$ctrl.selectedReport.row === 'elements'"
                            ($ctrl.selectedReport.row === 'strip' ? getStripsAndBanners(d._id) : displayElementsForDay(d._id)) +
                            (isLast ? '' : ('<tr><td>' + getBreak('dayBreak')+ '</td></tr>')) +
                        '</table>';

                    function getDayHeader(day) {
                        var p = getPages(day),
                        t = getTimes(day, 0, 'margin-bottom-30 ');
                        if(p){p = 'Total pages: ' + p;}
                return '<tr class="header-row">' +
                            '<td>' +
                                '<div class="pull-left uppercase">' +
                                    '<span>'+day.name+'</span>' +
                                    (day.note ? (sep +
                                        '<span>'+day.note+'</span>'):'') +
                                    (day.date ? (sep +
                                        '<span>' + $ctrl.CPS.getCreatedAt(day.date, $ctrl.CPS.dateFormat) + '</span>'):'') +
                                '</div>' +
                                '<div class="pull-right total-pages">' +
                                    p + (p && t ?sep : '') + t +
                                '</div>' +
                            '</td>' +
                        '</tr>';
                    }

                    function getStripsAndBanners(scheduleDayId) {
                        return _.filter($ctrl.selected, function(item){
                            return (scheduleDayId ? item.scheduleDayId === scheduleDayId : true) && item.type!== $ctrl.StripTypes.DayBreak;
                        }).map(function (item){
                            return '<tr class="with-auto-break" id="scene' + $ctrl.getScheduleId(item) + '">' +
                                        '<td class="spacing-half-top">' + getRowStrips(item) + '</td>' +
                                   '</tr>';
                        }).join('');
                    }

                    function displayElementsForDay(scheduleDayId) {
                     return '<tr class="with-auto-break elements spacing-half-bottom">' +
                                '<td class="spacing-half-top">' + getRowElements(getElementsForDay(scheduleDayId)) + '</td>' +
                            '</tr>';
                    }
                }
            }

            function getElementsForDay(scheduleDayId){
                var strips = _.filter($ctrl.selected, {type: $ctrl.StripTypes.Scene, scheduleDayId: scheduleDayId}),
                    elements = {},
                    catId = $ctrl.filters[$ctrl.Types.Categs],
                    allCategs = $ctrl.isNullValue(catId);
                _.each($ctrl.selectedCategIds, function (cId) {
                    if((cId === catId || allCategs) && !$ctrl.isNullValue(cId)) {
                        _.each(strips, function (strip) {
                            var se = strip.elements ? strip.elements[cId] : null;
                            if (se && se.length) {
                                _.each(se, function (el) {
                                    if (!el) {
                                        console.log('null element for ' + cId);
                                    } else {
                                        if (!elements[cId]) {
                                            elements[cId] = [];
                                        }

                                        if (_.find(elements[cId], function (item) {
                                            return item && el.elementId === item.elementId;
                                        }) === undefined) {
                                            elements[cId].push(el);
                                        }
                                    }
                                });
                            }
                        });

                        if (elements[cId] && elements[cId].length > 0) {
                            elements[cId] = _.sortBy(elements[cId], 'order');
                        }
                    }
                });
                return Object.keys(elements).length ? elements : null;
            }

            function getReportLayoutScenes() {
                console.log('getReportLayoutScenes');
                var el = '';
                var l = $ctrl.selected.length;
                _.each($ctrl.selected, function (item, i) {
                    //ng-show="item.active||!item.active&&$ctrl.scriptSides.showBoneyard"
                    el += '<div id="scene'+item._id+'" class="row-scene margin-bottom-30">' +
                            $ctrl.getRowHeader(item) +
                            getScene(item, i === l-1) +
                        '</div>';
                });
                return el;
            }

            function getNoDayBreaks() {
                console.log('getNoDayBreaks');
        return '<div class="hide-print" style="border-top:2px solid #4C5359">'+
                    '<div class="no-product unit-xs">' +
                        '<div>' +
                            '<div class="centered circled-svg-colored small76">'+$ctrl.LCS.getISBDiv('day-of-days', 6)+'</div>' +
            '<h3 class="text-center ng-scope">No daybreaks</h3>' +
            '<p class="empty-subtitle text-center">This report requires you to add <span class="bold">at least one daybreak</span> to your stripboard.</p>' +
                    ($ctrl.canEdit && $ctrl.CPS.isAuthenticated ? ('<p class="spacing-half-top spacing-bottom text-center">' +
                                '<button id="btnGoS" class="btn btn-small primary-faded medium" analytics-on analytics-action="Go to Stripboard">Go to Stripboard</button>') : '') +
                            '</p>' +
                        '</div>' +
                    '</div>'+
                '</div>';
            }

            function getReportLayoutDood() {
                console.log('getReportLayoutDood');
                if(!$ctrl.FiltersD){return getNoDayBreaks();}
                $ctrl.setDoodReportInfo();

                return assignDates() +
                   getFiltersD();

                function getFiltersD(){
        return '<div class="fancy-scrollbar scrollable-content dood-table margin-top-half ' +($ctrl.FiltersWCount > 14? 'landscape' :'' )+ ' ' + ($ctrl.scriptSides.showOffDays? '':'hide-off-days') +'">' +
                    getTableStyle()+
                    '<table>' +
                        '<tbody class="header-table">' +
                            getFilersMRow() +
                            getDayBreaksRow() +
                            getShootDayRow() +
                        '</tbody>' +
                         getFiltersCTable() +
                    '</table>' +
                '</div>';
                }

                function getTableStyle(){
                    if(!($ctrl.FiltersWCount > 14)){return '';}
                    return '<style media="print" type="text/css">' +
                                '@page{size:'+$ctrl.selectedReport.size+'}' +
                                '.dood-table.fancy-scrollbar{width:100%; overflow: visible}' +
                                '.dood-table td.dayx-first-col,td.filled{font-size:8px;font-weight: 400;}' +
                                '.dood-table td.dayx-first-col{width: 100px; padding-left:3px; padding-right:3px;}' +
                                '.dood-table td{padding:0}' +
                                '.dood-table .headerx td.dayx-col>.h-b{font-size:10px;line-height:1}' +
                                '.dood-table .headerx td.dayx-col>.h-t{font-size:7px;}' +
                                '.dood-table .header-table .bodyx .n{font-size: 8px;}' +
                               '.preview-callsheet{max-width: 100%}' +
                            '</style>';
                }

                function getExtraCells(){
                    return [
                      //      {name: 'Travel', id: 1},
                        {name: 'Work', id: 2, w: 50},
                        {name: 'Hold', id: 3, w: 50},
                       // {name: 'Holiday', id: 4},
                        {name: 'Start', id: 5, w: 50},
                        {name: 'Finish', id: 6, w: 50},
                        {name: 'Total', id: 3.1, w: 50},
                        {id: 8, hidePrint: true, w:50} // enable hold
                    ];
                }

                function getEmptyCells(type, info) {
                    var r = '',
                        cells = getExtraCells(),
                        l = cells.length - 1;
                    if (type === 'month' || type === 'day'){
                        var s = 0;
                        _.each(cells, function (c, i) {
                            if(i !== cells.length - 1) {
                                s += c.w || 30;
                            }
                        });
                        var cls = ' h with-border-top headerx '+(type === 'month' ? '' : 'with-border-bottom');
                        return '<td class="' + $ctrl.getScriptSidesCls('showSummary') + cls + '" colspan="' + l + '" id="months_1" style="width:'+s+'px">' +
                                    '<div class="h-t text-center uppercase' + (type === 'month' ? ' semibold':'') + '">' + (type === 'month' ? 'All Months' : 'Summary')+'</div>' +
                               '</td>' +
                               '<td class="' + $ctrl.getScriptSidesCls('showHold') + ' ' +  cls + ' ' + getCls1(cells[cells.length - 1]) +
                            //' no-border-left' +
                            '">&nbsp;</td>';
                    } else {
                        _.each(cells, function (c) {
                            var v;
                            if (type === 'header') {
                                v = (type === 'header' && c.name ? c.name : '');
                            } else {
                                if (c.id === 8) {
                                    v = '<div class="remove one-line-tooltip">' +
                                            '<div class="centered position-relative col25">' +
                                                '<a data-id="' + info.id + '" class="btnReportHold editable-btn btn gray-light"><div class="sbf"></div></a>' +
                                            '</div>' +
                                        '</div>';
                                } else {
                                    v = info ? (c.id === 3.1 ? (info.work + info.hold) : info[c.name.toLowerCase()]) : '';
                                    if(v === undefined || v === null){
                                        v = '';
                                    }
                                }
                            }
                            r += '<td class="' + getCls(c) + '">' + v + '</td>';
                        });
                        return r;
                    }

                    function getCls(c){
                        return getCls1(c) + ' bodyx ' +
                        $ctrl.getScriptSidesCls(c.id === 8 ? 'showHold' : 'showSummary');
                    }

                    function getCls1(c){
                        return ' col' + (c.w || 30) + (c.hidePrint ? ' hide-print' : '') + ' text-center ';
                    }
                }

                function getFilersMRow() {
                    if(!$ctrl.FiltersM){
                        return '';
                    }

                    var withOff = $ctrl.scriptSides.showOffDays;
            var result = '<tr class="month '+$ctrl.getScriptSidesCls('showDays')+'">' +
                            '<td class="dayx-first-col with-border-top">&nbsp;</td>';
                        _.each($ctrl.FiltersM, function (m, i) {
                        var colspan = m.colspan - ((!withOff && m.isOff) ? m.isOff : 0);
                 result += '<td class="h with-border-top headerx" colspan="' + colspan + '" id="months_'+i+'" ' +
                             'style="width:'+ (colspan * $ctrl.TdWidth) +'px' +
                             (colspan ? '' : 'visibility:hidden') +
                             '" ' +
                            '>' +
                                '<div class="h-t text-center uppercase semibold">'+$ctrl.CPS.getCreatedAt(m.date, 'MMM')+'</div>' +
                            '</td>';
                        });
                  result += getEmptyCells('month') +
                        '</tr>';
                 return result;
                }

                function getDayCls(d){
                    return (d._id ? '' : (' with-off ' + $ctrl.getScriptSidesCls('showOffDays')))  + ' ' + $ctrl.getScriptSidesCls('showDays');
                }

                function getDayBreaksRow() {
                    if($ctrl.DayBreaksWithoutDates){return '';}
          var result = '<tr class="day '+$ctrl.getScriptSidesCls('showDays')+'">' +
                            '<td class="dayx-first-col with-border-top">&nbsp</td>';
                _.each($ctrl.FiltersW, function (d) {
                result +=   '<td class="h dayx-col with-border-top headerx ' + getDayCls(d) +  '">' +
                                '<div class="h-t text-center uppercase">'+ $ctrl.CPS.getCreatedAt(d.date, 'ddd') +'</div>' +
                                '<div class="h-b calendar-top text-center">'+ $ctrl.CPS.getCreatedAt(d.date, 'DD') +'</div>' +
                            '</td>';
                    });
                    result += getEmptyCells('day') + //day row
                        '</tr>';
                    return result;
                }

                function getShootDayRow() {
            var result = '<tr class="shootday uppercase semibold">' +
                            '<td class="dayx-first-col h bodyx ' + ($ctrl.DayBreaksWithoutDates ? ' with-border-top' : '')+'">Shoot Day</td>';

                    _.each($ctrl.FiltersW, function (d) {
                        result += '<td class="n dayx-col text-center with-border-top bodyx ' + getDayCls(d) + '"><span>'+
                            (d._id ? d.shortName : 'Off')+
                            '</span></td>';
                    });
                    result += getEmptyCells('header') + //shoot day row
                        '</tr>';
                    return result;
                }

                function assignDates() {
                    return $ctrl.DayBreaksWithoutDates ? ('<div class="hide-print alert alert-danger margin-bottom-0">' +
                        '<div class="spacing-quart position-relative">To complete this report, please assign calendar dates to <strong>all</strong> the day breaks in this schedule on the Stripboard. ' +
                        '<a id="btnGoS">View Stripboard</a></div>' +
                        '</div>') : '';
                }

                function getFiltersCTable() {
                    var result = '',
                        catId = $ctrl.filters[$ctrl.Types.Categs],
                        allCategs = $ctrl.isNullValue(catId);
                    _.each($ctrl.selectedCategIds, function (cId) {
                        if((cId === catId || allCategs) && !$ctrl.isNullValue(cId)){
                            var cat = $ctrl.getCategoryById(cId),
                                ce = cat.ce;

                            if(ce && ce.length) {
                                var c = cat.c,
                                    color = c.color,
                                    isCast = cId === $ctrl.scriptLoadingService.characterCategoryId,
                                    isCorL = isCast || (cId === $ctrl.scriptLoadingService.stripLocationCategoryId);

                                result += '<tbody class="body-table">';
                                _.each(ce, processElement);
                                result += '</tbody>';

                                function processElement (el, i) {
                                    var id = el._id,
                                        hasStrips = $ctrl.hasStripsForElement(cId, id),
                                        db = $ctrl.elementDays ? $ctrl.elementDays[id] : null,
                                        info = {work:0, hold: 0, id:id};
                                    if(hasStrips) {
                                        result += '<tr class="with-borders '+(el.hideHoldOnDood?'hold-hidden':'hold-visible')+'">' +
                                            addNameCell();

                                        _.each($ctrl.FiltersW, addDayCell);

                                        result += getEmptyCells('val', info) +
                                            '</tr>';
                                    }

                                    function addNameCell(){
                                    return '<td class="dayx-first-col bodyx">' +
                                            '<div>' +
                                            (el.currentId ? ('<div class="numbered-char smallerx">'+el.currentId+'</div>') : '') +
                                                '<span' + (isCorL ? ' class="uppercase"' : '') + '>'+el.name+'</span>' +
                                            '</div>' +
                                            (allCategs ? ('<div class="font-size-10">'+c.name+'</div>'):'') +
                                        '</td>';
                                    }

                                    function addCounterCell(c){
                                        return '<td class="col30 hide-print text-center with-a-hover">' + c + '</td>';
                                    }


                                    function addDayCell(d) {
                                        var s = db ? db[d._id] : null;
                                        var cls = getDayCls(d);
                                        if(s) {
                                           /* cls += (isCast ? (
                                                        (s.isFirstClass ? 'with-first ' : '') +
                                                        (s.isLastClass ? 'with-last ' : '') +
                                                        (s.isWorkClass ? 'with-work ' : '')
                                                    ):
                                                    (!(s.isHold && el.hideHoldOnDood)  ? 'with-check ' : '')
                                                  ) +
                                                  (s.isHold && !el.hideHoldOnDood ? 'with-hold ' : '') +
                                                  (!(s.isHold && el.hideHoldOnDood) ? 'filled ' : '');*/

                                            if(s.isWork){
                                                info.work += 1;
                                            }
                                            if(s.isHold) {
                                                info.hold += 1;
                                            }
                                            var date = $ctrl.CPS.getCreatedAt(s.date, 'MM/DD');
                                            if(s.isFirst){
                                                info.start = date ? date : '';
                                            }
                                            if(s.isLast){
                                                info.finish = date ? date : '';
                                            }
                                            cls += 'filled ' + (isCast ? (
                                                            (s.isFirstClass ? 'with-first ' : '') +
                                                            (s.isLastClass ? 'with-last ' : '') +
                                                            (s.isWorkClass ? 'with-work ' : '')
                                                        ): '' ) +
                                                (s.isHold ? 'with-hold ' : (isCast ? '' : 'with-check ' ));

                                        }
                                        result += '<td class="bodyx dayx-col text-center ' + cls + '">';
                                        if(s) {
                                            result += '<span>' +
                                                    (!isCast && !s.isHold ? $ctrl.LCS.getISBDiv('check-mark',2) : '') +
                                                    (isCast && s.isFirst ? '<span>S</span>' : '') +
                                                    (s.isHold ? '<span class="hold-letter">H</span>' : '') +
                                                    (isCast && s.isWork ? '<span>W</span>' : '') +
                                                    (isCast && s.isLast ? '<span>F</span>' : '') +
                                                '</span>';
                                        }
                                        result += '</td>';
                                    }
                                }
                        }
                    }
                });

                    return result;
                }
            }

            function getReportLayoutElements() {
                console.log('getReportLayoutElements');
                $ctrl.elemCount = 0;
                $ctrl.incrementCount(-1);
                var result = '',

                    catId = $ctrl.filters[$ctrl.Types.Categs],
                    allCategs = $ctrl.isNullValue(catId);
                _.each($ctrl.selectedCategIds, function (cId) {
                    if((cId === catId || allCategs) && !$ctrl.isNullValue(cId)){
                        var cat = $ctrl.getCategoryById(cId),
                            ce = cat.ce;

                        if(ce && ce.length) {
                            var c = cat.c,
                                color = c.color,
                                isCast = cId === $ctrl.scriptLoadingService.characterCategoryId,
                                isCorL = isCast || (cId === $ctrl.scriptLoadingService.stripLocationCategoryId);

                 result += '<table class="row-elem full-width">' +
                                '<tr class="with-auto-break">' +
                                    '<td>';
                                        _.each(ce, processElement);
                          result += '</td>' +
                                '</tr>' +
                            '</table>';

                            function processElement(el) {
                                var strips = $ctrl.getStripsForElement(cId, el._id),
                                hasStrips = strips && strips.length > 0;

                                if(hasStrips) {
                                    var maxCount = 0, hasdif = 0;
                                    _.each(strips, function (s) {
                                        var c = _.find($ctrl.taggingScenes, {elementId: el._id, stripId: s._id}).count;

                                        if (c > maxCount) {
                                            maxCount = c;
                                            hasdif++;
                                        }
                                    });
                                }

                                $ctrl.incrementCount();

                                result += '<table class="margin-bottom-30 full-width ' + (el.isNonScripted ? $ctrl.getScriptSidesCls('showNonscriptedElements') : '')+'">' +
                                    getHeader() +
                                    getScenes() +
                                    '</table>';

                                function getHeader() {
                             return '<tr class="header-row">' +
                                        '<td class="clearfix">' +
                                            '<div class="pull-left"> ' +
                                            '<span>' + $ctrl.elemCount + '.</span> ' +
                                            (el.currentId ? ('<div class="numbered-char inline-block">' + el.currentId + '</div>  ') : '') +
                                            '<span' + (isCorL ? ' class="uppercase"' : '') + '>' + el.name + '</span>' +
                                            (maxCount > 1 ? (' <span class="with-parenthesis">' + (hasdif > 1 ? 'Max ' : '') + maxCount + '</span>') : '') +

                                            (allCategs ? ('<div class="categ-name inline-block"><div class="color-button smaller">' +
                                                '<div ' +
                                                (color ? ('style="background-color:' + color + '" ') : '') +
                                                (color ? '' : ' class="md-color-picker-checkered-bg"') + '></div></div>' +
                                                '<span class="uppercase">' + c.name + '</span></div>') : '') +
                                            '</div>' +
                                            ('<div class="pull-right text-right total-pages">' + getElementRate() + (el.rate ? sep : '') + '<span>' + strips.length + '</span> Scene' + (strips.length === 1 ? '' : 's') + '</div>')  +
                                        '</td>' +
                                    '</tr>' +
                                    getElementNote() +
                                    '<tr class="with-no-page-break-after"><td class="padding-top-10">&nbsp;</td></tr>';
                                }
                                function getElementRate(){
                                    return (el.rate ? ('<span class="' +$ctrl.getScriptSidesCls('showElementRate') + '"><span>Rate: </span>'+ $ctrl.SBFieldMethods.displayRate(el.rate, $ctrl.CPS.getCurrentRate, true) + '</span>') : '');
                                }
                                function getElementNote(){
                                    return (el.note ? ('<tr class="strip-item ' +$ctrl.getScriptSidesCls('showElementNote') + '"><td>' +
                                        '<div class="scene-notes margin-30">' +
                                            '<div class="labelx">' + $ctrl.LCS.getISBDiv('bnote', 2, 'pull-left with-margin-right gray sbf14') + ' Element Notes</div>' +
                                            '<div class="margin-right notex ql-editor" >'+el.note+'</div>' +
                                        '</div>' +
                                    '</td></tr>') :'');
                                }


                                function getScenes() {
                                    if(!hasStrips){return '';}
                                    var el = '';
                                    _.each(strips, function (item) {
                                        el += '<tr class="strip-item">' +
                                                    '<td>' +
                                                        '<div class="scene-info smaller clearfix">' +
                                                            '<div class="scene-number vtop">' +
                                                                '<div class="row-schedule colored-col hastype ' + item.color + '">' +
                                                                    '<div class="valuex text-center uppercase">' + item.sceneText + '</div>' +
                                                                '</div>' +
                                                            '</div>' +
                                                            '<div>' +
                                                            getSceneName(item, 'lineHeight1') +
                                                            getTimes(item, 1) +
                                                            '</div>' +
                                                        '</div>' +
                                                    '</td>' +
                                                '</tr>';
                                    });
                                    return el;
                                }
                            }
                        }
                    }
                });

                return result;
            }
        }

        function getPages(item){
            var prop = item.type === 1 ? 'pagesDisplay' : 'pages';
            return item[prop] ? ($ctrl.SBFieldMethods.getPages(item, 'inline-block', false, prop) + ' pgs') : '';
        }

        function getSceneName(item, cls){
            var pages = getPages(item);
    return '<div class="scene-name">' +
                '<div class="clearfix">' +
                    '<div class="pull-left mini-title">'+item.miniTitle+
                        (!item.isNotOmitted ? '<div class="omitted">OMITTED</div>' : '') +
                    '</div>' +
                '</div>' +
                getSynopsis(item) +
                '<div class="clearfix">' +
                    (pages ? ('<div class="pagesx inline-block"><span class="labelx">Pages:</span> ' + pages + '</div>') : '') +
                    (item.storyDay ? ('<div class="inline-block '+$ctrl.getScriptSidesCls('showStoryday') + '">'+(pages ? sep : '')+'<span class="labelx">Script Day:</span> ' + item.storyDay + '</div>') : '') +
                '</div>' +
            '</div>';
        }

        function changeHold(e) {
            console.log('changeHold');
            $ctrl.preventDefault(e);
            var target = e.currentTarget,
                id = target.getAttribute('data-id');
            var el = $ctrl.elements[id];
            if(!el){return ;}
            if (!el.isUpdating) {
                $ctrl.elements[id].isUpdating = true;
                $ctrl.TaggingElementsService.update({
                    _id: id,
                    hideHoldOnDood: el.hideHoldOnDood ? false : true,

                    companyId: $ctrl.CPS.companyId,
                    productId: $ctrl.CPS.productId,
                    scriptId: $ctrl.CPS.scriptId
                }, function (result) {
                    var item = result.item;
                    if (item) {
                        $ctrl.elements[id].hideHoldOnDood = item.hideHoldOnDood;
                    }
                    $ctrl.LCS.replaceClass( $ctrl.LCS.findClosestParent(target, 'tr'),
                        item.hideHoldOnDood?'hold-visible':'hold-hidden',
                        item.hideHoldOnDood?'hold-hidden':'hold-visible');
                    $ctrl.elements[id].isUpdating = false;
                }, function (err) {
                    $ctrl.elements[id].isUpdating = false;
                });
            }
        }

        function bindHold(isBind){
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('.btnReportHold'), $ctrl.changeHold, 'hold');
        }

        function getRowElements(elements) { //$ctrl.itemCategs <=> elements
            if(!elements || !$ctrl.selectedCategIds){return '';}
            var result = '',
                catId = $ctrl.filters[$ctrl.Types.Categs],
                allCategs = $ctrl.isNullValue(catId);

        _.each($ctrl.selectedCategIds, function(cId){
            if((cId === catId || allCategs) && !$ctrl.isNullValue(cId)){
                var se = elements[cId];
                if(se && se.length) {
                    var cat = $ctrl.getCategoryById(cId),
                        c = cat.c,
                        color = c.color,
                        isCast = c.name.toLowerCase() === 'cast members',
                        isCorL = isCast || (cId === $ctrl.scriptLoadingService.stripLocationCategoryId);
    //'ng-init="c=cat.c;isCast=c.name.toLowerCase() === \'cast members\'" ' +
    //'ng-show="se && (($ctrl.info.categoryId === 0) || ($ctrl.info.categoryId !== 0) && ($ctrl.info.categoryId == catId))"' +
        //category header
                   // console.log(c.name);
            result += '<table class="margin-bottom-30 full-width">' +
                        addHeaderRow();

                //row elements
                _.each(se, processElement);

            result  += '</table>';

            function addHeaderRow(){
              return '<tr>' +
                        '<td>' +
                            '<div class="headerx">' +
                                '<span class="color-button smaller inline-block">' +
                                    '<div ' + (color ? ('style="background-color:' + color + '"') : 'class="md-color-picker-checkered-bg"') + '></div>' +
                                '</span>' +
                                '<span>' + c.name + '</span> <span class="with-parenthesis">' + se.length + '</span>' +
                            '</div>' +
                        '</td>' +
                    '</tr>';
            }

            function processElement(el) {
              result += '<tr class="bodyx">' +
                            '<td>' +
                                (el.currentId ? ('<div class="numbered-char smallerx">' + el.currentId + '</div> ') : '') +
                                '<span ' + (isCorL ? 'class="uppercase"' : '') + '>' + el.name + '</span>' +
                                (el.count > 1 ? (' <span class="with-parenthesis">' + el.count + '</span>') : '') +
                            '</td>' +
                         '</tr>';
            }
                }
            }
        });

            return result ? ('<div class="elements-table">' + result +'</div>') : '';
        }

        function getRowStrips(item) {
            switch (item.type) {
                case $ctrl.StripTypes.Scene:
                    return getScene(item);

                case $ctrl.StripTypes.DayBreak:
                    return get('day-break text-center');

                case $ctrl.StripTypes.Banner:
                    return get('banner');
            }

            function get(cls) {
                return '<div class="strip-item margin-bottom-30 ' + cls + '">' +
                            $ctrl.processListItemColumns(item, false, false, false, false, null).content +
                            getTimes(item, 1) +
                        '</div>';
            }
        }

        function getScene(item, isLast){
            var br = item.locations && item.locations.length > 1 ? '<br/>' : '';
        return '<div class="strip-item margin-top-half">' +
                '<div class="margin-bottom-20 ' + $ctrl.getScriptSidesCls('showDetails') + '">' +
                    '<div class="scene-info margin-bottom-30 ' + $ctrl.getScriptSidesCls('showDetails') + '">' +
                        '<div class="scene-number">' +
                            '<div class="row-schedule colored-col hastype '+item.color+'">' +
                                '<div class="labelx uppercase text-center">Scene</div>' +
                                '<div class="valuex text-center">' +
                                    (item.scene ? ("<span>" + $ctrl.SBFieldMethods.getSceneText(item) + "</span>") : '') +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                        getSceneName(item ) +

                    '</div>' +
                    '<div class="clearfix">' +
                        getLocations()+
                        getChars() +
                        getTimes(item, 1, 'margin-bottom-30 ') +
                    '</div>' +
                '</div>' +
                getSceneNotes() +
                (item.elements ? ('<div class="margin-bottom-30 elements ' + $ctrl.getScriptSidesCls('withTagging') +'">'+getRowElements(item.elements)+'</div>') :'') +
                '</div>' +
            (isLast ? '' : getBreak('pageBreak'));


            function getLocations(){
                var count = item.locations ? item.locations.length : 0;
                if(!count){return '';}
                var el = '';

                _.each(item.locations, function (l, i) {
                    if(l) {
                        var address = $ctrl.SBFieldMethods.getCustomAddress(l.address),
                            x = (l.name ? l.name : '') +
                                (l.name && address ? sep : '') +
                                (address ?
                                    (address.address ? (
                                            (address.name ? (address.name + sep) : '') +
                                            (
    (address.map ? ('<a target="_blank" href="' + address.map + '" class="blackonprint">'+ (address.address && address.address.name ? address.address.name : address.address) + '</a>') : address.address) +
    (address.phone ? (sep + '<a target="_blank" href="tel:'+address.phone+'" class="blackonprint">' + address.phone + '</a>') : '')
                                            )) : address
                                    ) : '') +
                                br;

                        el +=  getH(i) +
    '<div class="notex '+ (count > 1 ? ((count-1) === i ? 'margin-bottom-20' : 'margin-bottom-30') : 'inline-block') + '">' + x + '</div>';
                    }
                });

                return '<div class="clearfix location ' + $ctrl.getScriptSidesCls('showLocations') + '">' + el + '</div>';

                function getH(i) {
                    return $ctrl.LCS.getISBDiv('pin', 2, 'with-margin-right sbf14 gray') +
                        '<span class="labelx uppercase">Shoot Location' + (count > 1 ? (' ' + (i + 1)) :  ': ') + br + '</span>';
                }
            }

            function getChars() {
                var count = item.characters ? item.characters.length : 0;
                if(!count){return '';}
                var el = '' ;
                _.each(item.characters, function (c, i) {
                    el += c.name +
                        (c.currentId ? ( '<span class="with-margin-left with-parenthesis">' + c.currentId +'</span>'): '')+
                        (i!==item.characters.length-1?',&nbsp;':'');
                });

                return '<div class="clearfix location script-showChars ' +
                    ($ctrl.scriptSides.showDetails && !$ctrl.scriptSides.withTagging ? '' : 'sb-hide') +
                    '">' +
                    $ctrl.LCS.getISBDiv('contacts-1', 3, 'pull-left with-margin-right gray') +
                    '<span class="labelx">Cast ID’s: </span>'+'<span class="uppercase">' + el + '</span>' +
                '</div>';
            }

            function getSceneNotes(){
                return (item.breakdownNotes ? ('<div class="scene-notes margin-bottom-30 ' +$ctrl.getScriptSidesCls('showNotes') + '">' +
                        '<div class="labelx">' + $ctrl.LCS.getISBDiv('bnote', 2, 'pull-left with-margin-right gray sbf14') + ' Scene Notes</div>' +
                        '<div class="margin-right notex ql-editor">'+item.breakdownNotes+'</div>' +
                    '</div>') :'');
            }
        }

        function getTimes(day, type, cls) {
            var withclock = type === 1;
            if(type === 0){
                return getEstTime(false);
            }

            var el = getEstTimeInfo(!withclock, 'time', 'Start Time', true);
                //(day.pages && (day.time || day.estgetTimesTime||day.prepTime||day.shootTime)? sep : '') +
                //el += getEstTimeInfo(!withclock, 'endTime', 'End Time', true);
            el += getEstTime(el);
            el += getEstTimeInfo(el, 'prepTime', 'Prep Time');
            el += getEstTimeInfo(el, 'shootTime', 'Shoot Time');
           // el += getEstTimeInfo(el, 'duration', 'Duration');

            return el && withclock ? (
                '<div class="clearfix times margin-top-quarter ' + (cls || ' ') + $ctrl.getScriptSidesCls('showTimes') + '">' +
                    $ctrl.LCS.getISBDiv('clock', 2, 'with-margin-right sbf14 gray pull-left') +
                    el +
                '</div>'
            ) : el;

            function getEstTime(withSep, prop, name){
                return getEstTimeInfo(withSep, 'estTime', 'Est Time');

            }
            function getEstTimeInfo(withSep, prop, name, isTime) {
                var p = day[prop],
                    v = isTime ? $ctrl.SBFieldMethods.getTime(p, $ctrl.CPS.timeFormat) : $ctrl.SBFieldMethods.getEstVal(p, {isDuration: prop === 'duration'});
                return (p ? ((withSep ? sep : '') + '<span class="labelx uppercase">' + name + ': </span> <span class="page">' + v + '</span>') : '');
            }
        }
        function getSynopsis(item) {
            return '<div class="clearfix notex">' +
                (item.description ? ('<div class="clearfix '+(item.note ? 'margin-bottom-quarter ' : '') + $ctrl.getScriptSidesCls('showDescription') + '">' + item.description + '</div>') : '') +
                (item.note ? ('<div class="clearfix margin-bottom-quarter ' + $ctrl.getScriptSidesCls('showSynopsis') + '">' + item.note + '</div>') : '') +
                '</div>';
        }
    }
}

angular.module('product.reportsPage.init.controller.service', [
    'apiServices.Strips',
    'apiServices.TaggingScenes',
    'list.base.component.service',
    'apiConstants.reports.services',
    'product.breakdowns.group.loading.service',
    'groupSimpleForRow.controller.service',
    'apiConstants.scheduling.services'
])
.run(AnchorScrollProvider)
.service('ReportsPageInitCtrlService', ReportsPageInitCtrlService);

AnchorScrollProvider.$inject = ['$anchorScroll'];
function AnchorScrollProvider($anchorScroll) {
    $anchorScroll.yOffset = 60;
}

ReportsPageInitCtrlService.$inject = ['GroupSimpleForRowCtrlService', 'SchedulingConstantsService', 'BreakdownsGroupLoadingCtrlService', '$anchorScroll', 'PageSimpleInitCtrlService', 'CompInitCtrlService', 'FiltersService'];
function ReportsPageInitCtrlService(GroupSimpleForRowCtrlService, SchedulingConstantsService, BreakdownsGroupLoadingCtrlService, $anchorScroll, PageSimpleInitCtrlService, CompInitCtrlService, FiltersService) {
    return function ($ctrl, $element, p) {
        var constantsService = _.extend({}, p ? p.constantsService : null);
        $ctrl.isSides = true;
        $ctrl.tableCls = 'reports-table-wrapper';
        $ctrl.scriptInfoCls = 'scriptinfo';
        $ctrl.quotaType = 'stripboard';

        $ctrl.shareList = shareList;
        $ctrl.getElementIdsForCategory = getElementIdsForCategory;
        $ctrl.getStripsForElement = getStripsForElement;
        $ctrl.hasStripsForElement = hasStripsForElement;
        $ctrl.getScheduleId = getScheduleId;

        $ctrl.SchedulingConstantsService = _.extend({}, SchedulingConstantsService);
        $ctrl.schedulingFiltersService = new FiltersService($ctrl.SchedulingConstantsService, null);
        $ctrl.schedulingFiltersService.setColumns(['1', '2', '3.2']);

        $ctrl.getCategoryById = getCategoryById;
        $ctrl.getColumnsFilterService = getColumnsFilterService;
        $ctrl.isMobileView = isMobileView;
        $ctrl.getSettingsColumns = getSettingsColumns;
        $ctrl.getPageTemplate = getPageTemplate;
        $ctrl.getCategColor = getCategColor;
        $ctrl.setDoodReportInfo = setDoodReportInfo;
        $ctrl.processBtnClick = processBtnClick;

        $ctrl = new GroupSimpleForRowCtrlService($ctrl);
        $ctrl = new BreakdownsGroupLoadingCtrlService($ctrl);

        $ctrl.$onDestroy = $onDestroy;

        if (!$ctrl.compLoaded) {
            $ctrl = CompInitCtrlService($ctrl);
        }

        $ctrl.nullValue = null;
        $ctrl.sceneCls = 'scenex';
        $ctrl.Types = {
            Schedules: 'sc', Strips: 's', Days: 'd', Categs: 'ca',
            StripsF: 'sf', Elements:'e', Chars: 'c', Locations:'l',
            Display: 'do', Boneyard:'b', DisplayedFilters:'df', Reports:'r'
        };

        $ctrl.filtersGroupCls = 'filtersGroup';
        var filterTypes = [$ctrl.Types.StripsF, $ctrl.Types.Elements, $ctrl.Types.Chars, $ctrl.Types.Locations];
        $ctrl.filters = {};

        $ctrl.$onInit = $onInit;
        $ctrl.getDrpFilterCls = getDrpFilterCls;
        $ctrl.isNullValue = isNullValue;
        $ctrl.getSearchSides = getSearchSides;
        $ctrl.setSearchSides = setSearchSides;
        $ctrl.getHeader = getHeader;
        $ctrl.getTopFilters = getTopFilters;
        $ctrl.getBanner = getBanner;
        $ctrl.getCompanyInfo = getCompanyInfo;
        $ctrl.getScriptInfo = getScriptInfo;
        $ctrl.replaceContent = replaceContent;

        $ctrl.isSelectedFilter = isSelectedFilter;
        $ctrl.showStrip = showStrip;
        $ctrl.setSearchFilter = setSearchFilter;
        $ctrl.setSearch = setSearch;
        $ctrl.toggle = toggle;

        $ctrl.anchorScroll = anchorScroll;
        $ctrl.onPageLoaded = onPageLoaded;
        $ctrl.onFilterClick = onFilterClick;
        $ctrl.onDisplayedFilterClick = onDisplayedFilterClick;
        $ctrl.getSidebar = getSidebar;
        $ctrl.removeFiltersAndReload = removeFiltersAndReload;

        $ctrl.onlyNonScripted = onlyNonScripted;
        $ctrl.bindClickEvent = bindClickEvent;
        $ctrl.showDisplayOption = showDisplayOption;

        $ctrl.filtersService = new FiltersService(constantsService, null);

        $ctrl.addRootWatcher('ON_SHOW_HEADER', showHeader);

        $ctrl = new PageSimpleInitCtrlService($ctrl, $element, {
            constantsService: constantsService
        });

        return $ctrl;

        function getReports(nonScripted) {
            var r = {
                _id: '4',
                name: 'Element List',
                showIcon:true,
                type: 1,
                sidebar: 2,
                layout: 'elements',
                withShow: false,
                withDays: false,
                row: 'strip',
                icon: 'elements',
                tooltip: 'Lists out all elements and the scenes they are attached to.'
            }
            $ctrl.ReportTypes = nonScripted ? [r] : [
                {_id: '1', name: 'Order Report By', header:true},

                {
                    _id: '3',
                    name: 'Breakdown Summary',
                    showIcon:true,
                    type: 1,
                    sidebar: 1,
                    withShow: true,
                    withDays: false,
                    layout: 'scenes',
                    row: 'strip',
                    icon: 'breakdowns',
                    tooltip: 'Displays all elements tagged in a scene.'
                },

                 r,

                {_id: '2', name: 'Production Reports', header:true, cls:'margin-top-half'},

                {
                    _id: '5',
                    name: 'Shooting Schedule',
                    showIcon:true,
                    type: 2,
                    sidebar: 1,
                    withShow: true,
                    withDays: true,
                    layout: 'days',
                    row: 'strip',
                    icon: 'stripboard',
                    iconLevel: 5,
                    tooltipOneLine: 'A One Liner Schedule is a condensed report of shoot days and scenes.',
                    tooltip: 'A report of shoot days and customizable breakdown details.',
                    disabled: !$ctrl.schedulesLists || !$ctrl.schedulesLists.length
                },
                //if show == '1000' > title = 'One Liner Schedule
                //if no elements && scene details > show characterIds
                {
                    _id: '6',
                    name: 'Day out of Days (DOOD)',
                    showIcon:true,
                    type: 2,
                    sidebar: 2,
                    withDays: true,
                    layout: 'dood',
                    icon: 'day-of-days',
                    iconLeve: 6,
                    tooltip: 'DOOD reports lists elements for a category (usually Cast), and what days they’re needed in a gantt chart.',
                    size: 'landscape'
                },
               /* {
                    _id: '7',
                    name: 'Unique Daily Elements',
                    showIcon:true,
                    type: 2,
                    sidebar: 2,
                    withShow: false,
                    withDays: true,
                    layout: 'days',
                    row: 'elements',
                    icon: 'unique-elements',
                    tooltip: 'All the elements scheduled by shoot day. Element quantities are taken from the scene with highest QTY.'
                }*/
                //show all elements for a specific day by category
                // if there are no day breaks > disable production phase
            ];
        }

        function isMobileView() {
            return true;
        }

        function $onInit() {
            $ctrl.onSimplePageInit({
                isScript: true,
                additionalScriptInit: additionalScriptInit
            }, $ctrl.onPageLoaded);
        }

        function $onDestroy() {
            $ctrl.onSimplePageDestroy();
            var isBind = false;
            bind(isBind);
            bindLogo(isBind);

            bindClickEvents($ctrl.Types.Days, isBind);
            bindClickEvents($ctrl.Types.Categs, isBind);
            bindClickEvents($ctrl.Types.Strips, isBind);
            bindClickEvents($ctrl.Types.Boneyard, isBind);
            bindClickEvents($ctrl.Types.Reports, isBind);

            _.each(filterTypes, function(type){
                bindClickEvents(type, isBind);
                bindDisplayButtonEvents(type, isBind);
            });

            if (typeof ($ctrl.onDestroyOther) === 'function') {
                $ctrl.onDestroyOther();
            }
        }

        function isEmpty(){
            return !$ctrl.stripsCount && (!$ctrl.isReports ||  $ctrl.isReports && !$ctrl.nonscriptedElements);
        }

        function onlyNonScripted(){
            return $ctrl.isReports  && !$ctrl.stripsCount && $ctrl.nonscriptedElements!==null;
        }

        function getPageTemplate() {
            $ctrl.CPS.withBanner = $ctrl.CPS.setPageBanner($ctrl.CPS.withBanner, $ctrl.showBannerProp, $ctrl.bannerFeatureProp);

            var onlyNonScripted = $ctrl.onlyNonScripted();
            var empty = isEmpty();//!$ctrl.stripsCount
            if(empty) {
                var content = '';
                if ($ctrl.isReports) {
                    content = (typeof($ctrl.getEmptyTable) === 'function' ? $ctrl.getEmptyTable(true) : '');
                } else {
                    content = '<div class="empty-state-wrapper with-margin-top with-side-margin">' + $ctrl.getEmptyState() + '</div>';
                }
                return '<div class="full-content with-fancy-scrollbar show-scrollbar-on-hover h-full white-bg">' +
                    '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper with-side-padding">' +
content +'</div>' +
                    '</div>';
            }else{
         return $ctrl.getTopFilters(onlyNonScripted) +
                '<div class="h-full side-table with-filters-above">' +
                        $ctrl.getSidebar(onlyNonScripted) +
                        '<div class="full-content with-fancy-scrollbar show-scrollbar-on-hover h-full">' +
                            '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper with-side-padding">' +
                                '<div class="reports-table tab-content with-no-bg with-padding centering unit-xs full-width margin-half">' +
                                    $ctrl.getBanner() +
                                    '<div class="preview-callsheet centering'+($ctrl.isReports ? '' : ' nopadding')+'">' +
                                        $ctrl.getHeader($ctrl.isReports ? '' : 'unit-xs centered screenplay-side-padding')+
                                        '<div class="report-body medium-template">' +
                        (typeof($ctrl.getPageTemplateOther) === 'function' ? $ctrl.getPageTemplateOther() : '') +
                                        '</div>' +
                                    '</div>' +
                                '</div>' +
                            '</div>' +
                    '</div>' +
                '</div>';
            }
        }
        function getHeader(cls) {
            var type = ($ctrl.isReports ? 'Report' : 'Sides');
        return '<div class="header-info clearfix ' + (cls ? cls:'') + '">' +
                    '<div class="branded-logo sb-hide"><div>' + type + ' created in</div> <div class="studiobinder-logo"></div></div>' +
                    '<div class="table-div full-width script-showHeader">' +
                        '<div class="report-info">' +
                            '<h2 class="text-left smaller position-relative clearfix">' + $ctrl.getHeaderTitle(type) + '</h2>' +
                            '<div class="script-info ' + $ctrl.scriptInfoCls + '"></div>'+
                        '</div>' +
                        $ctrl.getCompanyInfo() +
                    '</div>' +
                '</div>';
        }

        function getScriptInfo() {
            return ($ctrl.CPS.product.script.version ? ('<div><span class="semibold">Script v' + $ctrl.CPS.product.script.version + '</span> <span>' + $ctrl.CPS.product.script.name + '</span></div>') : '') +
                '<div class="sb-hide ' + $ctrl.Types.Schedules + '"><span class="semibold">Schedule</span> <span class="name"></span></div>' +
                ($ctrl.isReports ? ('<div class="sb-hide ' + $ctrl.Types.Days + '"><span class="semibold">Day</span> <span class="name"></span></div>') : '') +
                '<div>' +
                ($ctrl.info.date ? ('<span class="semibold">Created</span> ' + $ctrl.CPS.getCreatedAt($ctrl.info.date, $ctrl.CPS.dateTimeFormat)) : '') +
                ($ctrl.CPS.user ? ('&nbsp;<span class="semibold">by</span> <span>' + $ctrl.CPS.user.name + '</span>') : '') +
                '</div>' +
                '<div>' +
                ($ctrl.info.scenesCount ? ($ctrl.info.scenesCount + ' Scene' + ($ctrl.info.scenesCount === 1 ? '' : 's')) : '') +
                ($ctrl.info.pages.value ? ('<span class="dot-separator smaller"></span> ' + $ctrl.SBFieldMethods.getPages($ctrl.info, 'inline-block') + ' Pages') : '') +
                ($ctrl.info.prepTime ? ('<span class="dot-separator smaller"></span>Prep Time: <span class="page">' + $ctrl.SBFieldMethods.getEstVal($ctrl.info.prepTime) + '</span>') : '') +
                ($ctrl.info.shootTime ? ('<span class="dot-separator smaller"></span>Shoot Time: <span class="page">' + $ctrl.SBFieldMethods.getEstVal($ctrl.info.shootTime) + '</span>') : '') +
                ($ctrl.info.estTime ? ('<span class="dot-separator smaller"></span>Est. Time: <span class="page">' + $ctrl.SBFieldMethods.getEstVal($ctrl.info.estTime) + '</span>') : '') +
                //($ctrl.info.duration ? ('<span class="dot-separator smaller"></span>Duration: <span class="page">' + $ctrl.SBFieldMethods.getEstVal($ctrl.info.duration, true) + '</span>') : '') +
                '</div>';
            //'<div ng-if="$ctrl.filters[$ctrl.Types.Chars].length>0"><span class="semibold">Cast Members: </span> <span ng-repeat="f in $ctrl.filters[$ctrl.Types.Chars]"><span ng-if="$index!==0" class="dot-separator smaller"></span> <span class="numbered-char inline-block" ng-bind="::f.currentId"></span> <span class="page uppercase" ng-bind="::f.name"></span></span></div>' +
        }

        function getCompanyInfo() {
            if(!$ctrl.CPS.product){return '';}
            var p = $ctrl.CPS.product.production,
                a = $ctrl.CPS.product.address;
            return '<div class="logo-info ' + ($ctrl.CPS.product.logo ? '' : 'hide-print') + '">' +
                $ctrl.security.getProjectImageComponent('$ctrl.CPS.product', 'intermedium') +
                '</div>' +
                (p || a ? ('<div class="company-info">' +
                    (p ? ('<div class="name">' + p + '</div>') : '') +
                    (a ? ('<div class="desc">' + $ctrl.SBFieldMethods.getAddress(a) + '</div>') : '') +
                    '</div>') : '');
        }

        function getBanner() {
            if (!$ctrl.CPS.withBanner) {return '';}

            var el = '';
            if ($ctrl.CPS.isCollaborator && $ctrl.LCS.collabBannerInside) {
                var txt = ($ctrl.isReports ? 'reports' : 'sides');
                el += '<div class="alert alert-warning alert-stylish ' + txt + ' table-div full-width">' +
                    '<div class="centered grow-column">' +
                    $ctrl.LCS.getISBDiv(txt, 2, 'icon sbf24 pull-left') +
                    ' <span class="text">Import your shooting script and generate ' + txt + ' now.</span>' +
                    '</div>' +
                    '<div class="centered col160">' +
                    '<a href="' + $ctrl.CPS.websiteUrl + '/register?utm_campaign=' + ($ctrl.isReports ? 'collab-script' : 'collab-sides') + '" target="_blank" class="btn btn-primary  pull-right">Get Started Free</a>' +
                    '</div>' +
                    //getCloseBtn() +
                    '</div>';
            }
            if ($ctrl.CPS.isAuthenticated) {
                el += '<div class="alert alert-warning">' +
                        '<div class="spacing-quart position-relative">' +
                            '<strong>50% of Imported Scenes are displayed</strong> – This plan doesn’t support full screenplay display. To run reports on all the scenes, <a href="' + $ctrl.CPS.getStateHref('user.pricing', $ctrl.CPS.currentPathParams()) + '">upgrade now!</a>' +
                        // '<a class="closebtn close" ng-click="$ctrl.CPS.closeBanner()" style="top:7px">&times;</a>' +
                        '</div>' +
                    '</div>';
            }

            return el ? ('<div class="hide-print centering margin-half document-version-wrapper banner-wrapper">' + el + '</div>') : '';

            function getCloseBtn(){
                return '<div class="centered btn-col text-center col40">' +
                '<a class="closebtn" ng-click="$ctrl.CPS.closeBanner()">' + $ctrl.LCS.getISBDiv('close-bigger', 2 ) + '</a>' +
                '</div>';
            }
        }

        function getTopFilters(onlyNonScripted) {
            return '<nav class="reportsNav filters on-top hide-print with-side-margin one-line-tooltip">' +
                (onlyNonScripted ? '' : ('<a data-type="toggleInnerSidebar" class="'+ $ctrl.getBtnActionCls() + ' btn btn-small primary-faded without-text pull-left with-margin-right">' + $ctrl.LCS.getISBDiv('sidebar-filled', 2) + '</a>')) +
                '<div class="pull-left">' +
                getReportsDrp(onlyNonScripted) +
                getSchedulesDrp() +
                /*  ($ctrl.stripsCount ? ('<div class="hide-ipad pull-left left-separator text-info-count with-line-height">' +
                      '{{$ctrl.info.scenesCount}} scene{{$ctrl.scenesCount===1?\'\':\'s\'}}' +
                      '<span ng-if="$ctrl.dayBreakCount">&nbsp;•&nbsp;{{$ctrl.dayBreakCount}} day break{{$ctrl.dayBreakCount===1?\'\':\'s\'}}</span>' +
                      '<span ng-if="$ctrl.bannerCount">&nbsp;•&nbsp;{{$ctrl.bannerCount}} banner{{$ctrl.bannerCount===1?\'\':\'s\'}}</span>' +
                      '</div>') : '') +*/
                '</div>' +
                '<div class="with-margin-left pull-left '+ getSectionListCls($ctrl.Types.DisplayedFilters)+'"></div>' +
                '<div class="pull-right">' +

                //TODO BRING BACK SHARE REPORT
                //$ctrl.getListNavShare() +
                ($ctrl.stripsCount > 0 ? (
                    getDayBreaksDrp() +
                    getScenesDrp() +
                    getLocationsDrp()
                ) : '') +
                ($ctrl.isReports ? (($ctrl.stripsCount > 0 || onlyNonScripted) ? (getCategoriesDrp() + getCharactersDrp()): '') : getCharactersDrp()) +
                getOptionsDrp() +
                getDrpSettings() +
                $ctrl.getPdfReports(false, {exposeOnDesktop: true}, true, $ctrl.getBtnActionCls()) +
                '</div>' +
                '</nav>';
        }


        function getSidebar(onlyNonScripted){
            if(onlyNonScripted){return '';}
            return '<div class="hide-print h-full side-nav static long mini-strips ' +
                ((!$ctrl.displaySidebar())? ' sb-hide' : '') + '">' +
                        '<div class="outtercontainer show-scrollbar-on-hover">' +
                            '<div class="innercontainer fancy-scrollbar sb-scrolling-monitor ultrathin medium-template strips stripboard-page stripboard mobile-view '+($ctrl.strips.length > 0 ? '':'with-radius')+'">' +
                                '<div class="sidebarScrollingContainer">' +
                                    ($ctrl.isInTreeModal ? '' : ('<div class="sidebar-toggle no-padding"><a data-type="toggleInnerSidebar" class="'+ $ctrl.getBtnActionCls() + ' btn btn-small transparent noborder smaller inline-block">'+$ctrl.LCS.getISBDiv('angle-double-left', 2,'centered gray')+'</a></div>')) +
                                    '<div class="sidebarScrollingContainer wrapper-scenes table-rewards list">' +
                                        '<h3 class="text-left spacing-half-top padding-left-24"><span class="namex">Script</span>&nbsp;Scenes&nbsp;<span class="with-parenthesis"><span class="txtSel sb-hide"></span><span class="txt"></span></span></h3>' +
                                        '<ul class="dd clearfix scenetable '+getDrpFilterCls($ctrl.Types.Strips)+' '+getSectionListCls($ctrl.Types.Strips)+'"></ul>' +
                                        //boneyard is based on schedule
                                        '<div class="wrapper-boneyard margin-bottom sb-hide">' +
                                            '<h3 class="text-left spacing-half-top padding-left-24">Boneyard &nbsp;<span class="txt with-parenthesis"></span></h3>' +
                                            '<ul class="dd clearfix scenetable '+getDrpFilterCls($ctrl.Types.Boneyard)+' '+getSectionListCls($ctrl.Types.Boneyard)+'"></ul>'+
                                        '</div>' +
                                        getNoSelectedStrips() +
                                    '</div>' +
                                '</div>' +
                            '</div>' +
                        '</div>'+
                    '</div>';

            function getNoSelectedStrips() {
            return '<div class="no-product unit-xs h-full table-div todono full-width sb-hide">' +
                        '<div class="centered text-center">' +
                            '<div class="centered circled-svg-colored small60 ' + ($ctrl.pageClass ? $ctrl.pageClass : '') + '">' +  $ctrl.LCS.getISBStripboard() + '</div>' +
                            '<div><h3 class="text-center" style="border:0">There are no scenes that match your filters.</h3></div>' +
                        '</div>' +
                    '</div>';
            }
        }
        function toggle(e, prop) {
            if(e) {
                e.stopPropagation(e);
            }

            var sides = angular.copy($ctrl.scriptSides);
            sides[prop] = sides[prop] ? false : true;
            if (prop === 'pageBreak' && $ctrl.scriptSides.pageBreak) {
                //dayBreak
                $ctrl.scriptSides.dayBreak = false;
                //dayBreak
            } else if (prop === 'dayBreak' && $ctrl.scriptSides.dayBreak) {
                //pageBreak
                $ctrl.scriptSides.pageBreak = false;
            }

            $ctrl.scriptSides = sides;
            $ctrl.scriptSidesJson = JSON.stringify(sides);
            if($ctrl.isReports){
                toggleDisplayOptions(prop);
                if (prop === 'showDetails' || prop === 'withTagging'){
                    toggleDisplayOptions('showChars', $ctrl.scriptSides.showDetails && !$ctrl.scriptSides.withTagging);
                }
            }
        }

        function toggleDisplayOptions(prop, val) {
            var els = $ctrl.element.querySelectorAll('.script-'+prop);
            if (els) {
                $ctrl.LCS[(val !== undefined ? val : $ctrl.scriptSides[prop]) ? 'removeClass' : 'addClass'](els, 'sb-hide');
            }

            if($ctrl.toggleDisplayOptionsOther){
                $ctrl.toggleDisplayOptionsOther(prop, val);
            }
        }
        
        function removeFiltersAndReload(e) {
            $ctrl.preventDefault(e);
             removeFilters();
             onStripsChanged();
        }

        function getColumnsFilterService() {
            return $ctrl.schedulingFiltersService;
        }

        function getSettingsColumns (){
            return $ctrl.SchedulingConstantsService.Settings.Columns;
        }

        function onPageLoaded(scriptLoadingService) {
            console.log('onPageLoaded');

            bind(true);
            onUpdateSubscription();
            if($ctrl.isReports) {
                onReportChanged();
            }else{
                scheduleChanged();
            }

            var scene = $ctrl.CPS.getSearchFilter('scene');
            if (scene) {
                gotoscene(scene);
            }

            if(typeof($ctrl.onPageLoadedOther) === 'function') {
                $ctrl.onPageLoadedOther();
            }
        }

//c: null, chars: [], days: null, strips: []
        //c   ,
        //only for view only based on stripIds
        function getSearch() {
            var search = $ctrl.CPS.getSearchFilter('filter');
            if (!search) {
                return null;
            }

            if(typeof($ctrl.getSearchSides) === 'function') {
                search = $ctrl.getSearchSides(search);
            }

            for (var type in search) {
                process(search[type]);
            }

            function process(filters) {
                if (filters && typeof(filters.map) === 'function') {
                    if (type === $ctrl.Types.Days) {
                        $ctrl.filters[$ctrl.Types.Days] = _.find($ctrl.FiltersD, {_id: filters});
                    }
                    var l = filters.length;
                    if (l > 0) {
                        if (type === $ctrl.Types.Strips) {
                            $ctrl.filters[$ctrl.Types.Strips] = filters.map(function (id) {
                                return _.find($ctrl.strips, {_id: id});
                            });
                        } else {
                           /* $ctrl.filters[type === 'c' ? $ctrl.Types.Chars : $ctrl.Types.Categs] = filters.map(function (id) {
                                return _.find($ctrl.elements, {_id: id});
                            });*/
                        }
                        //elements
                        //schedules
                    }
                }
            }

            return search;
        }

        function setSearch() {
            var info = null;
            if(typeof($ctrl.setSearchSides) === 'function'){
                info = $ctrl.setSearchSides(info);
            }

            for (var type in $ctrl.filters) {
                var filters = $ctrl.filters[type];
                if (filters) {
                    if (!info) {
                        info = {};
                    }
                    if(type === $ctrl.Types.Schedules) {
                        info[type] = filters;
                    } else if (type === $ctrl.Types.Days) {
                        //info[type] = _.each(getDayById(id);
                    }else{
                        var l = filters.length;
                        if (l > 0) {
                            /*   info[type === $ctrl.Types.Strips ? $ctrl.Types.Strips : ($ctrl.Types.Chars ? 'c' : $ctrl.Types.Days)] = filters.map(function (item) {
                                   return item ? item._id : null;
                               });*/
                        }
                    }
                }
            }

            /*if (oi.strip && oi.scheduleDayId !== 0) {
                info.d = oi.scheduleDayId;
            }
            if (oi.characterIds && oi.characterIds.length>0) {
                info.c = oi.characterIds;
            }
            */

            $ctrl.setSearchFilter(info);
        }

        function setSearchSides(info) {
            var h = $ctrl.scriptSides;

            if (h) {
                var d;
                for (var p in h) {
                    var el = h[p];
                    if (el) {
                        var pr = getitem(p);
                        if (pr) {
                            if (!d) {
                                d = {};
                            }
                            d[pr] = 1;
                        }
                    }
                }
                if (d) {
                    if (!info) {
                        info = {};
                    }
                    info.display = d;
                }
            }

            return info;

            function getitem(prop) {
                switch (prop) {
                    case 'showTagging':
                        return 't';
                    case 'showHeader':
                        return 'ph';
                    case 'withHeader':
                        return 'h';
                    case 'withDayHeader':
                        return 'dh';
                    case 'pageBreak':
                        return 'p';
                    case 'dayBreak':
                        return 'd';
                    case 'showOmitted':
                        return 'o';
                    case 'showBoneyard':
                        return 'b';
                    case 'showDetails':
                        return 'de';
                    case 'showNotes':
                        return 'no';
                    case 'showLocations':
                        return 'l';
                    case 'showSynopsis':
                        return 'sy';
                    case 'showDescription':
                        return 'sd';
                    case 'showStoryday':
                        return 'scd';
                    case 'showTimes':
                        return 'ti';
                    case 'showOffDays':
                        return 'od';
                    case 'showNonscriptedElements':
                        return 'ne';
                    case 'showSummary':
                        return 'ss';
                    case 'showHold':
                        return 'sh';
                    case 'showDays':
                        return 'sds';
                }
                return null;
            }
        }

        function setSearchFilter(info, type){
            //set search filters in persistent storage
            $ctrl.CPS.setSearchFilter(info, type);
        }

        //c: null, chars: [], days: null, strips: []
        //c   ,
        //only for view only based on stripIds
        function getSearchSides(search) {
            var d = search && search.display ? search.display : null;
            if(d) {
                delete search.display;
                $ctrl.scriptSides.showTagging = d && d.t ? d.t : false;
                $ctrl.scriptSides.withHeader = d && d.h ? d.h : false;
                $ctrl.scriptSides.withDayHeader = d && d.dh ? d.dh : false;
                $ctrl.scriptSides.pageBreak = d && d.p ? d.p : false;
                $ctrl.scriptSides.dayBreak = d && d.d ? d.d : false;
                $ctrl.scriptSides.showHeader = d && d.ph ? d.ph : true;
                $ctrl.scriptSides.showOmitted = d && d.o ? d.o : false;
                $ctrl.scriptSides.showBoneyard = d && d.b ? d.b : false;
                $ctrl.scriptSides.showLocations = d && d.l ? d.l : true;
                $ctrl.scriptSides.showSynopsis = d && d.sy ? d.sy : true;
                $ctrl.scriptSides.showDescription = d && d.sd ? d.sd : true;
                $ctrl.scriptSides.showStoryday = d && d.scd ? d.scd : true;
                $ctrl.scriptSides.showTimes = d && d.ti ? d.ti : true;
                $ctrl.scriptSides.showOffDays = d && d.od ? d.od : true;
                $ctrl.scriptSides.showDetails = d && d.de ? d.de : true;
                $ctrl.scriptSides.showNotes = d && d.no ? d.no : true;
            }
            return search;
        }
        
        function getReportsList() {
            return getUl($ctrl.ReportTypes, $ctrl.Types.Reports, '_id', false, null,true);
        }

        function bind(isBind) {
            bindClickEvents($ctrl.Types.Display, isBind);
            if ($ctrl.schedulesLists && $ctrl.schedulesLists.length > 0) {
                bindClickEvents($ctrl.Types.Schedules, isBind);
            }
        }

        function bindDisplayButtonEvents(type, isBind) {
            bindDisplayButtonEvent(type, isBind);
        }

        function bindDisplayButtonEvent(type, isBind){
            bindClickEvents(type, isBind, 'button', $ctrl.onDisplayedFilterClick, $ctrl.filtersGroupCls);
        }

        function bindClickEvents(type, isBind, tag, ev, listName) {
            bindClickEvent($ctrl.element.querySelectorAll(getLiSelector(type, tag, listName)), isBind, ev);
        }

        function bindClickEvent(el, isBind, m) {
           if($ctrl.LCS.hasClass(el, 'with-title')){return;}
            $ctrl.LCS.bindElementsClick(isBind, el, m ? m : $ctrl.onFilterClick);
        }

        function getLiSelectorById(type, tag, id, listName) {
            return $ctrl.element.querySelector(getLiSelector(type, tag, listName) +':not(.with-title)[data-id=\''+id+'\']')
        }

        function onDisplayedFilterClick(e) {
            $ctrl.preventDefault(e);
            console.log('onDisplayedFilterClick');
            var tag = 'button',
                id = e.currentTarget.getAttribute('data-id'),
                type = e.currentTarget.getAttribute('data-type');
            if(id === 'null'){id = null;}

            var el = getLiSelectorById(type, tag, id, $ctrl.filtersGroupCls);
            //remove the button
            if(el) {
                bindDisplayButtonEvent(type, false);
                if(el && el.parentNode) {
                    el.parentNode.removeChild(el);
                }
                processBtnClick(type, null, id);
            }
        }

        function onFilterClick(e) {
            console.log('onFilterClick');
            $ctrl.preventDefault(e) ;
            var tag = null,
                id = e.currentTarget.getAttribute('data-id'),
                type = e.currentTarget.getAttribute('data-type');
            if(id === 'null'){id = null;}

            processBtnClick(type, tag, id);
        }

        function processBtnClick(type, tag, id){
            var el = getLiSelectorById(type, tag, id);
            if (hasMultiSelect(type)) {
                //if current item is active - > set as inactive ; if current item is inactive - > set as active
                var has = $ctrl.LCS.hasClass(el, 'active');
                $ctrl.LCS[has ? 'removeClass' : 'addClass'](el, 'active');

                var check = el.querySelector('.custom-checkbox input');
                if(check) {
                    if (has) {
                        check.removeAttribute('checked');
                    } else {
                        check.setAttribute('checked', 'checked');
                    }
                }
            }
            else {
                //remove the existing active element
                var activeEl = $ctrl.element.querySelector(getLiSelector(type, tag) + '.active');
                if (activeEl) {
                    $ctrl.LCS.removeClass(activeEl, 'active');
                }
                //set current as active
                $ctrl.LCS.addClass(el, 'active');
            }

            changeSelectedFilter(null, id, type);
            onFilterClickOther(id, type);
        }

        function onFilterClickOther(id, type) {
            if (type === $ctrl.Types.Strips || type === $ctrl.Types.Boneyard) {
                console.log('onSceneClick: ' + id);
                var scene = $ctrl.CPS.getSearchFilter('scene');
                if (!scene || scene !== id) {
                    gotoscene(id);
                    $ctrl.setSearchFilter($ctrl.selectedScene, 'scene');
                }
            }
        }

        function getLiSelector(type, tag, listName) {
            return '.' + getSectionListCls(type, listName) + ' ' + (tag ? tag : 'li') + (tag ? '' : (hasStripsSelector(type) ? '' : ' a'));
        }
        
        function hasStripsSelector(type) {
            return type === $ctrl.Types.Strips || type === $ctrl.Types.StripsF || type === $ctrl.Types.Boneyard;
        }

        function isFilterType(type) {
            return type === $ctrl.Types.Chars || type === $ctrl.Types.Locations || type === $ctrl.Types.Elements;
        }

        function hasMultiSelect(type) {
            return type === $ctrl.Types.Display || type === $ctrl.Types.StripsF || isFilterType(type);
        }

        function onUpdateSubscription() {
            console.log('onUpdateSubscription');
            var quotaType = 'brandedCallsheets',
                hasQuota = $ctrl.CPS.hasQuotaType(quotaType);
            $ctrl.brandedLogo = $ctrl.element.querySelector('.branded-logo');
            $ctrl.LCS[hasQuota ? 'removeClass':'addClass']($ctrl.brandedLogo, 'sb-hide');
            $ctrl.LCS.setCSSStyle($ctrl.brandedLogo, 'cursor', hasQuota ? 'initial':'pointer');
            if (!hasQuota) {
                $ctrl.clickFunction = function (evt) {
                    $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions);
                };
                bindLogo(true);

                function process() {

                }
            }
        }

        function bindLogo(isBind) {
            if ($ctrl.brandedLogo && $ctrl.clickFunction) {
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.brandedLogo, $ctrl.clickFunction);
            }
        }

        function isNullValue(id){
            return id === $ctrl.nullValue || id === undefined;
        }

        function getCategoryById(id) {
            return (!id || isNullValue(id)) ? {c: getEmptyCategory()} : $ctrl.categories['c_' + id];
        }

        function getEmptySchedule() {
            return {
                _id: $ctrl.nullValue,
                name: 'Script Order',
                hideSchedule: $ctrl.isReports
            }
        }

        function getEmptyDayBreak() {
            return {
                _id: $ctrl.nullValue,
                name: 'All Days',
                type: $ctrl.StripTypes.DayBreak,
            }
        }

        function getEmptyCategory() {
            return {
                _id: $ctrl.nullValue,
                name: 'All Categories',
                order: -1
            }
        }

        function getEmptyItem(type) {
            switch(type){
                case $ctrl.Types.Schedules : return getEmptySchedule();
                case $ctrl.Types.Days : return getEmptyDayBreak();
                case $ctrl.Types.Categs : return getEmptyCategory();
            }

            return null;
        }

        function loadScriptInfo() {
            if (!$ctrl.scriptInfo) {
                $ctrl.scriptInfo = $ctrl.element.querySelector('.' + $ctrl.scriptInfoCls);
            }
            if ($ctrl.scriptInfo) {
                $ctrl.scriptInfo.innerHTML = $ctrl.getScriptInfo();
            }
        }

        function additionalScriptInit() {
            //check the vals for filter & type

            if(!$ctrl.info){$ctrl.info = {};}
            $ctrl.info.date = $ctrl.MomentService.getMomentNow();
            $ctrl.info.count = 0;

            $ctrl.filterSearch =  getSearch();

            console.log('additionalScriptInit');
            $ctrl.scriptOrder = 'scriptPosition';
            var tables = $ctrl.scriptLoadingService.getProcessedStripsTables({type: $ctrl.StripTypes.Scene}, $ctrl.scriptOrder, true, $ctrl.CPS.hasQuotaType('stripboard'));

            $ctrl.stripsCount = tables.strips && tables.strips.length > 0 ? tables.strips.length : 0;

            $ctrl.categories = {};
            $ctrl.categoryIds = [ ];
            var categories = _.sortBy($ctrl.scriptLoadingService.getShownCategories(true), 'order');

            var isEmpty = !$ctrl.stripsCount && !$ctrl.isReports;
            if (isEmpty) {
                $ctrl.strips = [];
            } else{

                var locations = tables.locations,
                    locationIds = [];
                $ctrl.locations = [];

                $ctrl.taggingScenes = tables.taggingScenes;

                var elements = tables.elements;
                if(elements && elements.length>0){
                    $ctrl.elements = {};
                    _.each(elements, function (el) {
                        $ctrl.elements[el._id] = el;
                    });
                }

                var nonscriptedElements = tables.nonscriptedElements;
                if(nonscriptedElements && nonscriptedElements.length > 0) {
                    $ctrl.nonscriptedElements = {};
                    _.each(nonscriptedElements, function (el) {
                        el.isNonScripted = true;
                        $ctrl.nonscriptedElements[el._id] = el;
                        addCategoryAndEls(el.categoryId, [el], null, true);
                    });
                }

                $ctrl.characters = elements ? _.sortBy(_.filter(elements, {categoryId: $ctrl.scriptLoadingService.characterCategoryId}), 'order') : null;

                $ctrl.strips = _.sortBy(tables.strips.map(loadStrip), 'scriptPosition');
                if(!$ctrl.locations.length){
                    $ctrl.locations = null;
                }

                var sc = $ctrl.scriptLoadingService.getSchedulesLists({
                    isFolder: false,
                    active: true
                }).map(function (item) {
                    return {_id: item._id, name: item.name};
                });

                if (sc && sc.length > 0) {
                    $ctrl.schedulesLists = [
                        //dont consider script order
                        getEmptySchedule()
                    ].concat(sc);

                    $ctrl.scheduleItems = {};
                    _.each($ctrl.schedulesLists, function (schedulesList) {
                        var id = schedulesList._id;
                        if(!isNullValue(id)) {
                            $ctrl.scheduleItems[id] = _.sortBy($ctrl.scriptLoadingService.getStripSchedules({schedulesListId: id}), 'order');
                        }
                    });
                }
                var nonScripted = !$ctrl.stripsCount && $ctrl.nonscriptedElements;
                if($ctrl.stripsCount || nonScripted) {
                    getReports(nonScripted);
                }
            }

            $ctrl.additionalScriptInitOther();

            return true;

            function loadStrip(item) {
                if (!item) {
                    return item;
                }
                var stripId = item._id;
                //these are added based on elements
                item.stripLocation = getStripLocationForStrip(stripId);
                item.stripLocationId = item.stripLocation ? item.stripLocation._id : null;

                //these are added based on elements
                item.characters = getCharactersForStrip(stripId);
                item.characterIds = item.characters ? item.characters.map(function (c) {
                    return c ? c.elementId : null;
                }) : null;

                //based on locationIds
                item.locations = getLocations(item.locationIds, locations);

                item.elements = {};
                var has = false;
                _.each(categories, function (c) {
                    var id = c._id;
                    //   if(id !== $ctrl.scriptLoadingService.characterCategoryId){
                    var els = getElementsForStrip(stripId, id);
                    if(els && els.length>0){
                        item.elements[id] = els;
                        has = true;
                        addCategoryAndEls(id, els, c);
                    }
                    //  }
                });
                if(!has){item.elements = null;}

                item.stripId = stripId;
                item.isNotOmitted = item && item.active !== false;
                item.active = true;

                return item;

                function getLocations(ids, list) {
                    var l = [];
                    if (ids && ids.length > 0) {
                        _.each(ids, function (id) {
                            var el = _.find(list, {_id: id});
                            if (el){
                                if(locationIds.indexOf(id) === -1) {
                                    $ctrl.locations.push(el);
                                    locationIds.push(id);
                                }

                                l.push(el);
                            }
                        });
                        return l.length > 0 ? l : null;
                    }
                    return null;
                }

                function getCharactersForStrip(stripId) {
                    return getElementsForStrip(stripId, $ctrl.scriptLoadingService.characterCategoryId);
                }

                function getStripLocationForStrip(stripId) {
                    var l = getElementsForStrip(stripId, $ctrl.scriptLoadingService.stripLocationCategoryId);
                    return l && l.length > 0 && l[0] ? l[0] : null;
                }

                function getElementsForStrip(stripId, categoryId) {
                    if (!stripId) {
                        return null;
                    }

                    var l = _.filter(_.filter($ctrl.taggingScenes, _.extend({stripId: stripId}, categoryId ? {categoryId: categoryId} : null)).map(function (s) {
                        var el = $ctrl.elements[s.elementId];
                        return el ? {
                                _id: s._id,
                                count: s.count,
                                stripId: s.stripId,
                                elementId: s.elementId,
                                name: el.name,
                                order: el.order,
                                currentId: el.currentId
                        } : null;
                    }), function (item) {
                        return item !== undefined && item !== null;
                    });

                    return l && l.length > 0 ? l : null;
                }

            }

            function addCategoryAndEls(id, els, c, isNonscripted){
                if($ctrl.categoryIds.indexOf(id) === -1){
                    var cn = c ? c : _.find(categories, {_id:id});
                    if(cn) {
                        $ctrl.categories['c_' + id] = {c:cn};
                        $ctrl.categoryIds.push(id);
                    }
                }
                addElementsToCategory(id, els);

                function addElementsToCategory(catId, els) {
                    var c = $ctrl.categories['c_' + catId];
                    if(!c){return;}
                    var ce = c.ce;
                    if(!ce){ce = [];}
                    _.each(els, function (s) {
                        if(s) {
                            var id = isNonscripted ? s._id : s.elementId,
                                item = (isNonscripted ? $ctrl.nonscriptedElements : $ctrl.elements)[id];
                            if (item && _.find(ce, {_id: id}) === undefined) {
                                ce.push(item);
                            }
                        }
                    });
                    $ctrl.categories['c_' + catId].ce = _.sortBy(ce, catId === $ctrl.scriptLoadingService.characterCategoryId ? 'order':'name');
                }
            }
        }

        function anchorScroll(to) {
            $ctrl.LCS.timeout(function () {
                $anchorScroll(to);
            }, 0);
        }

        function shareList(e){
            $ctrl.preventDefault(e);
            //shareList
        }


        function showStrip(item) {
            var d = $ctrl.info.d;
            var cIds = $ctrl.info.c;
            if (!d && !cIds) {
                return true;
            } else {
                var exists = !d || d && (d === item.scheduleDayId || d === item._id);
                if (exists) {
                    //check if has char
                    var l = !cIds || cIds && cIds.length === 0;
                    if (!l) {
                        return true;
                    } else {
                        for (var i = 0; i < l; i++) {
                            if (item.cIds && item.cIds.indexOf(cIds[i]) !== -1) { //if the scene has at least one of the chars selected show it
                                return true;
                            }
                        }
                    }
                }
            }
            return false;
        }

        function updateDisplayedFilters() {
                var listName = $ctrl.filtersGroupCls,
                    parent = getDrpSection($ctrl.Types.DisplayedFilters);
                _.each(filterTypes, function (type) {
                    bindDisplayButtonEvents(type, false);

                    var s = getDrpSection(type, listName, parent);
                    if(s) {
                        s.parentNode.removeChild(s);
                    }
                    $ctrl.LCS.appendChildFragment(parent, getFiltersGroup(type));

                    bindDisplayButtonEvents(type, true);
                });

                function getFiltersGroup(type) {
                    var ids = $ctrl.filters[type], l = ids && ids.length > 0 ? ids.length : 0;
                    var el = '<div class="pull-left ' + getSectionListCls(type, listName) + ' ' + (l > 0 ? '' : 'ng-hide') + '">';
                    if (l > 0) {
                        _.each(ids, function (id) {
                            var item = null;
                            if(type === $ctrl.Types.Chars){
                                item = _.find($ctrl.characters, {_id: id});
                            } else if(type === $ctrl.Types.Locations){
                                item = _.find($ctrl.locations, {_id: id});
                            } else if(type === $ctrl.Types.StripsF){
                                item = _.find($ctrl.filteredScenes,function (item) {
                                    return getScheduleId(item) === id;
                                });
                            }

                            if(item){
                                el += getFiltersGroupBtn(type, item);
                            }
                        });
                    }
                    el += '</div>';
                    return el;
                }

                function getFiltersGroupBtn(type, item) {
                    var isChar = type === $ctrl.Types.Chars;
                    return '<button data-type="'+type+'" data-id="' +
                        (type === $ctrl.Types.StripsF ? getScheduleId(item) : item._id) +
                        '" class="btn btn-small filtersx white small with-margin-right pull-left" ' +  (isChar ? '' : getT()) + '>' +
                        getN() +
                        $ctrl.LCS.getISBDiv('cancel', 2, 'pull-right') +

                        '</button>';

                    function getN() {
                        if (isChar) {
                            return '<div class="display-inline" style="width: 18px;padding-right:6px" ' + getT() + '><div class="numbered-char">' + getFilterName(type, item) + '</div></div>';
                        } else {
                            return '<span>' + getFilterName(type, item) + '</span>';
                        }
                    }

                    function getT() {
                        var t = getFilterTooltip(type, item);
                        return t ? ('tooltip-placement="bottom" tooltip="' + t + '"') : '';
                    }
                }

                function getFilterTooltip(type, item) {
                    switch (type) {
                        case $ctrl.Types.Strips:
                        case $ctrl.Types.StripsF:
                        case $ctrl.Types.Boneyard:
                            return item.miniTitle;

                        case $ctrl.Types.Chars:
                        case $ctrl.Types.Elements:
                            //  case $ctrl.Types.Categs:
                            //  case $ctrl.Types.Days:
                            return item.name;
                    }
                    return null;
                }

                function getFilterName(type, item) {
                    switch (type) {
                        case $ctrl.Types.Strips:
                        case $ctrl.Types.StripsF:
                        case $ctrl.Types.Boneyard:
                            return 'Scene ' + item.sceneText;

                        case $ctrl.Types.Chars:
                            return item.currentId;

                        case $ctrl.Types.Elements:
                            return 'Element ' + item.name;

                        case $ctrl.Types.Locations:
                            return 'Location ' + item.name;

                        case $ctrl.Types.Days:
                            return 'Day ' + item.name;

                    }
                }
        }


        function displayDayBreaks(show){
            showDisplayOption('dayBreak', show);
            showDisplayOption('withDayHeader', show);
        }

        function getDayBreaks(type) {
            $ctrl.dayBreakCount = 0;
            $ctrl.bannerCount = 0;
            if (!$ctrl.schedulesLists) {
                return '';
            }
            var schedulesList = getSelectedSchedule();
            if (!schedulesList) {
                return '';
            }
            var schedulesListId = schedulesList._id,
                scheduleItems = $ctrl.scheduleItems[schedulesListId];
            if (scheduleItems && !scheduleItems.length) {
                scheduleItems = null;
            } else {
                scheduleItems = _.sortBy(scheduleItems, 'order');
            }

            var dayBreaks = (isNullValue(schedulesListId) || !scheduleItems) ? null : _.filter(scheduleItems, {
                    active: true,
                    type: $ctrl.StripTypes.DayBreak
                }).map(function (item) {
                    item.shortName = item.name ? item.name.split(' ')[1] : '';
                    return item;
                }),
                allDays = _.extend(getEmptyDayBreak(), {schedulesListId: schedulesListId}),
                prop = '_id';

            $ctrl.dayBreakCount = dayBreaks ? dayBreaks.length : 0;
            if (!$ctrl.dayBreakCount) {
                dayBreaks = null;
            }

            if (!$ctrl.isReports) {
                displayDayBreaks($ctrl.dayBreakCount > 1);
            }
            $ctrl.FiltersD = dayBreaks;
            $ctrl.elementDaysIsSet = false;
            $ctrl.currentScheduleItems = scheduleItems;

            $ctrl.filters[type] = dayBreaks ? allDays._id : null;

            $ctrl.activeStrips = getStripsForSchedule({active: true});
            if ($ctrl.activeStrips && !$ctrl.activeStrips.length) {
                $ctrl.activeStrips = null;
            }

            $ctrl.boneyardStrips = getStripsForSchedule({
                type: $ctrl.StripTypes.Scene,
                active: false
            });
            if ($ctrl.boneyardStrips && !$ctrl.boneyardStrips.length) {
                $ctrl.boneyardStrips = null;
            }

            $ctrl.omittedStrips = _.filter($ctrl.strips, {isNotOmitted: false});
            showDisplayOption('showOmitted', $ctrl.omittedStrips && $ctrl.omittedStrips.length > 0);

            return getULSection(type, prop, allDays, dayBreaks);
        }


        function setDoodReportInfo(){
            if($ctrl.elementDaysIsSet){return;}
            setElementDays($ctrl.FiltersD, $ctrl.currentScheduleItems);
            getWeeks($ctrl.FiltersD);
            $ctrl.elementDaysIsSet = true;

            function setElementDays(dayBreaks, scheduleItems){
                $ctrl.elementDays = {};
                if(!scheduleItems || !dayBreaks){return;}

                var elementDays = {};
                _.each(dayBreaks, function (item){
                    var scheduleDayId = item._id,
                        stripIds = _.filter(scheduleItems, {
                            active: true,
                            scheduleDayId: scheduleDayId,
                            type: $ctrl.StripTypes.Scene
                        }).map(function (item){
                            return item.stripId;
                        });

                    if(stripIds && stripIds.length > 0) {
                        item.stripIds = stripIds;
                        item.elementIds = _.filter($ctrl.taggingScenes, function (tag) {
                            //element exists at least in one scene
                            return _.find(item.stripIds, function (stripId){return stripId === tag.stripId});
                        }).map(function (s) {
                            var id = s.elementId;
                            if(!elementDays[id]){elementDays[id] = [];}
                            if(_.find(elementDays[id], function (x){return x === scheduleDayId;}) === undefined)
                                elementDays[id].push(scheduleDayId);
                            return s.elementId;
                        });
                    }
                });

                for (var id in elementDays) {
                    var db = elementDays[id],
                        dbc = db ? db.length : 0,
                        db0 = _.find(dayBreaks, {_id: db[0]}) ,
                        dbL = dbc > 1 ? _.find(dayBreaks, {_id: db[dbc - 1]}) : null,
                        l;
                    $ctrl.elementDays[id] = {};

                    _.each(dayBreaks, function (dbB){
                        var scheduleDayId = dbB._id;
                        l = null;
                        if (_.find(db, function (id) {return id === scheduleDayId;})){
                            l = {isFirst: dbc >= 1 && db[0] === scheduleDayId};
                            l.isFirstClass = l.isFirst && dbc > 1;
                            l.isLast = db[dbc - 1] === scheduleDayId;
                            l.isLastClass = l.isLast;
                            l.isWork = true;
                            l.isWorkClass = dbc > 2 && !l.isFirstClass && !l.isLastClass;
                            l.date = dbB.date;
                        } else if(db0 && dbB && dbL && db0.order < dbB.order && dbB.order < dbL.order) {//check if hold
                            l = {
                                isHold: true //el.hideHoldOnDood ? false : true
                            };
                        }

                        if(l) {
                            $ctrl.elementDays[id][scheduleDayId] = l;
                        }
                    });
                }
            }
        }

        function getWeeks(dayBreaks) {
            var dates = [], dayBreaksWithoutDates = [];
            _.each(dayBreaks, function (s) {
                var date = s.date;
                if (date) {
                    dates.push({_id: s._id, date: date, shortName: s.shortName, order: s.order});
                } else {
                    dayBreaksWithoutDates.push(s.shortName);
                }
            });

            $ctrl.DayBreaksWithoutDates = dayBreaksWithoutDates && dayBreaksWithoutDates.length > 0 ? dayBreaksWithoutDates : null;
            $ctrl.FiltersW = null;
            $ctrl.FiltersM = null;
            $ctrl.FiltersWCount = 0;

            if (!$ctrl.FiltersD) {return;}

            if ($ctrl.DayBreaksWithoutDates) {
                $ctrl.FiltersW = angular.copy(dayBreaks);
            }
            else {
                //filter weeks
                if (dates.length > 0) {
                    dates = dates.sort(function (a, b) {
                        return a && b ? (a.date && b.date ? (a.date - b.date) : (a.order - b.order)) : 0;
                    });
                    var daysw = {}, dayswCount = 0, dayswoffCount=0, months = [], d, nd,
                        id = 0,
                        l = dates.length;
                    for (var i = 0; i < l; i++) {
                        daysw[id++] = dates[i];
                        dayswCount++;
                        d = dates[i].date;

                        add(d, false);

                        if (i + 1 < l) {
                            nd = dates[i + 1].date;
                            if (nd.diff(d, 'days', true) !== 0) {
                                var x = d.clone().add(1, 'day');//add 1 to current day
                                while (nd.diff(x, 'days', true) >= 1) {
                                    daysw[id++] = {date: x};
                                    add(x, true);
                                    x = x.clone().add(1, 'day');
                                }
                            }
                        }
                    }

                    function add(x, isOff){
                        var om = months.length > 0 ? months[months.length - 1].id : null,
                            nm = x.month();
                        if (om !== nm) {
                            months.push({id: nm, colspan: 0, isOff: 0, date: x});
                        }
                        months[months.length - 1].colspan = months[months.length - 1].colspan + 1;
                        dayswCount++;
                        if(isOff) {
                            months[months.length - 1].isOff = months[months.length - 1].isOff + 1;
                            dayswoffCount++;
                        }
                    }

                    $ctrl.FiltersW = daysw;
                    $ctrl.FiltersWCount = dayswCount;
                    $ctrl.FiltersWOffCount = dayswoffCount;

                    if (months.length > 0) {
                        $ctrl.FiltersM = months;
                    }
                }
            }
        }

        function setDrpShow(type, show) {
            var drp = $ctrl.element.querySelector('.' + getDrpFilterCls(type));
            $ctrl.LCS[show ? 'removeClass' : 'addClass'](drp, 'sb-hide');
        }

        function getStripsForSchedule(q) {
            return _.sortBy(_.filter(_.filter($ctrl.scheduleItems[$ctrl.filters[$ctrl.Types.Schedules]], q).map(preProcessGroupItem), function(item){return item;}), 'order');
        }

        function showBoneyard(show) {
            var boneyardSection = $ctrl.element.querySelector('.wrapper-boneyard');
            if (boneyardSection) {
                $ctrl.LCS[show ? 'removeClass' : 'addClass'](boneyardSection, 'sb-hide');
                if(show) {
                    $ctrl.filteredBoneyard = _.filter($ctrl.filteredScenes, {active: false});
                    boneyardSection.querySelector('h3 .txt').innerHTML = $ctrl.filteredBoneyard ? $ctrl.filteredBoneyard.length : 0;
                    loadSection($ctrl.Types.Boneyard, getStrips($ctrl.Types.Boneyard, $ctrl.filteredBoneyard, false, true));
                }else{
                    $ctrl.filteredBoneyard = null;
                }
            }
        }

        function preProcessGroupItem(item) {
            if (!item || item.type !== $ctrl.StripTypes.Scene){
                return item;
            }
            var strip = _.find($ctrl.strips, {_id: item.stripId});
            return strip ? _.extend({}, strip, {
                _id: item._id,
                order: item.order,
                scheduleDayId: item.scheduleDayId,

                time: item.time,
                endTime: item.endTime,

                active: item.active,
            }) : null;
        }
        
        function setDrpName(type, val) {
            if(!val){val = getEmptyItem(type);}
            var el = $ctrl.element.querySelector('.' + getDrpFilterCls(type) + ' .btn .txt');
            if(el) {
                el.innerText = val.name;
            }
            el = $ctrl.element.querySelector('.' + getDrpFilterCls(type) + ' .btn .icon');
            if(el) {
                $ctrl.LCS.addClass(el, val.icon);
            }
        }

        function getDrpSection(type, listName, parent) {
            var name = getSectionListCls(type, listName);
            return (parent ? parent : $ctrl.element).querySelector('.' + name);
        }

        function loadSection(type, content, listName) {
            var section = getDrpSection(type, listName);
            if (!section) {return false;}

            bindClickEvents(type, false);
            replaceContent(section, content);
            bindClickEvents(type, true);
            return true;
        }

        function replaceContent(section, content) {
            if(section) {
                $ctrl.LCS.appendChildFragment(section, content, true);
            }
        }

        function isSelectedFilter(id, type) {
            switch (type) {
                case $ctrl.Types.Display:
                    return $ctrl.scriptSides[id];

                default:
                    return isInFilter(type, $ctrl.filters[type], id);
            }
        }

        function changeSelectedFilter(e, id, type) {
            console.log('changeSelectedFilter: id:'+id+',type:'+type);
            var filters = $ctrl.filters[type];
            if(hasMultiSelect(type)){
                if(type === $ctrl.Types.Display){
                    $ctrl.toggle(e, id);

                    if(id === 'showOmitted' || id === 'showBoneyard') {
                        onDayBreakChanged();
                    }
                }else{
                    var l = filters && filters.length ? filters.length : 0, exists;
                    if (!l) {
                        exists = false;
                    } else {
                        var index = findIndex(filters, id);
                        if (index !== -1) {
                            exists = true;
                            if($ctrl.filters[type]){ $ctrl.filters[type].splice(index, 1);}
                        }
                    }

                    if (!exists) {
                        if(!$ctrl.filters[type]){
                            $ctrl.filters[type] = [];
                        }
                        $ctrl.filters[type].push(id);
                    }

                    if (type === $ctrl.Types.StripsF) {
                        onStripsFChanged();
                    }else if (isFilterType(type)) {
                        onStripsChanged();
                    }
                }
            }else {
                $ctrl.filters[type] = id ? id : null;
                if (type === $ctrl.Types.Reports){
                    onReportChanged();
                }else if (type === $ctrl.Types.Schedules) {
                    scheduleChanged();
                }else if (type === $ctrl.Types.Days) {
                    onDayBreakChanged();
                }else if(type === $ctrl.Types.Categs){

                    if ($ctrl.isReports) {
                       // onReportChanged();
                    } else {
                        $ctrl.setSearch();
                    }

                    onCategoryChanged();
                }
            }
        }

        function scheduleChanged(){
            $ctrl.filters[$ctrl.Types.Days] = $ctrl.nullValue;
            onScheduleChanged();
        }

        function isBreakdownReport() {
            var r = $ctrl.filters[$ctrl.Types.Reports];
            return $ctrl.isReports && (r === '3' || r === '4');
        }

        function onReportChanged() {
            console.log('onReportChanged');
            if(!$ctrl.isReports || !$ctrl.ReportTypes){return;}

            var item,
                type = $ctrl.Types.Reports,
                filter = $ctrl.filters[type];

            if(filter) {
                item = _.find($ctrl.ReportTypes, {_id: filter});
            }

            if (!item) {
                item = $ctrl.ReportTypes[$ctrl.ReportTypes.length > 1 ? 1 : 0]; //0 is the header
                $ctrl.filters[type] = item._id;
            }

            $ctrl.getReport(item);
            setDrpName(type, item);

           $ctrl.element.setAttribute('data-report', item._id);

            var isShootingSchedule = item._id === '5';
            var isBreakdownSummary = item._id === '3';
            if($ctrl.isReports) {
                displayDayBreaks(isShootingSchedule);
            }
            showDisplayOption('pageBreak', isShootingSchedule || isBreakdownSummary);

            onReportChangedInit();
            scheduleChanged();

            $ctrl.setSearch();

            function onReportChangedInit() {
                var isNull = isNullValue($ctrl.filters[$ctrl.Types.Schedules]),
                    show = false;
                if (isBreakdownReport()) {//breakdown summary
                    if (!isNull) {
                        $ctrl.filters[$ctrl.Types.Schedules] = $ctrl.nullValue;
                        setDrpShow($ctrl.Types.Schedules, show);
                    }
                } else {
                    show = $ctrl.schedulesLists && $ctrl.schedulesLists.length > 0;
                    $ctrl.filters[$ctrl.Types.Schedules] = show ? $ctrl.schedulesLists[1]._id : $ctrl.nullValue;
                    setDrpShow($ctrl.Types.Schedules, show);
                }
            }
        }

        function onCategoryChanged() {
            var catId = $ctrl.filters[$ctrl.Types.Categs];
            var cat = $ctrl.categories ? getCategoryById(catId) : null,
            c = cat.c;
            var reportId = $ctrl.filters[$ctrl.Types.Reports];
            if (reportId === '7' || reportId === '4' || reportId === '6') {
                $ctrl.info.name = reportId === '7' ? 'Unique ' : (reportId === '6' ? 'DOOD: ' : '');
                if (catId) {
                    $ctrl.info.name += c.name;
                    if (c && c.name.toLowerCase() === 'cast members') {
                        $ctrl.info.icon = 'cast';
                    }
                } else {
                    if (reportId === '4') {
                        $ctrl.info.name = 'All Elements';
                    } else {
                        $ctrl.info.name += 'Elements';
                    }
                }
            }
            var categ = $ctrl.selectedReport && $ctrl.selectedReport.sidebar === 2 && catId && c ? c : null;
            if (categ) {
                $ctrl.info.color = categ.color ? categ.color : null;
                $ctrl.info.icon = categ.icon ? categ.icon : null;
            }

            if(!$ctrl.selectedCategIds){
                return '';
            }
            var ids = $ctrl.getElementIdsForCategory(catId);
            if(ids) {
                loadSection($ctrl.Types.Elements, ids.map(function (id) {
                    return $ctrl.elements[id];
                }));
            }else{
                //hide elements
            }

            if (typeof ($ctrl.onStripsChangedOther) === 'function') {
                $ctrl.onStripsChangedOther();
            }
        }

        function getElementIdsForCategory(catId){
            var ids = [];
            if(catId) {
                _.each($ctrl.selected, function (item) {
                    var els = item.elements ? item.elements[catId] : null;
                    if (els && els.length > 0) {
                        _.each(els, function(el){
                            var elementId = el.elementId;
                            if(elementId && _.find(ids, function(id){return id === elementId;}) === undefined){
                                ids.push(elementId);
                            }
                        });
                    }
                });
            }
            return ids && ids.length ? ids : null;
        }
        
        function getStripsForElement(catId, elementId) {
            var list = [];
            _.each($ctrl.selected, function (item) {
                var els = item.elements ? item.elements[catId] : null;
                if (els && els.length && _.find(els, {elementId: elementId})) {
                    list.push(item);
                }
            });
            return list;
        }

        function hasStripsForElement(catId, elementId) {
            for(var i = 0, l = $ctrl.selected.length ;i < l; i++){
                var item = $ctrl.selected[i],
                    els = item.elements ? item.elements[catId] : null;
                if (els && els.length && _.find(els, {elementId: elementId})) {
                    return true;
                }
            }
            return false;
        }

        function gotoscene(id) {
            $ctrl.selectedScene = id;
            $ctrl.anchorScroll('scene' + id);
        }

        function getSelectedSchedules(list) {
            var selected = angular.copy(list);

            //check strips filter
            var type = $ctrl.Types.StripsF,
                filter = $ctrl.filters[type],
                l = filter && filter.length > 0 ? filter.length : 0;
            if (selected && selected.length > 0 && l) { //get strips that match filter strips
                // showHeader = true;
                selected = _.filter(selected, function (item) {
                    return isInFilter(type, filter, getScheduleId(item));//is the stripId in the filter for strips
                });
            }

            //check char filter
            selected = processList(selected, $ctrl.Types.Chars, 'characterIds');

            //check locations filter
            selected = processList(selected, $ctrl.Types.Locations, 'locationIds');

            //todo check elements filter

            $ctrl.LCS.addClass($ctrl.element.querySelectorAll('.side-nav .scenetable > li .' + $ctrl.sceneCls), 'sb-hide'); //hide sidebar scenes hide tagging scenes
            _.each(selected, function (item) { //show only the selected scenes
                $ctrl.LCS.removeClass($ctrl.element.querySelector('.side-nav .scenetable > li[data-id="' +
                    getScheduleId(item) + '"] .' + $ctrl.sceneCls), 'sb-hide');
            });

            var current = {scenesCount: 0, pages: 0};
            _.each(['prepTime', 'shootTime', 'estTime', 'duration'], function (prop){
                current[prop] = 0;
            });
            _.each(_.filter(selected, function (el) {
                return el.type === $ctrl.StripTypes.Scene;
            }), function (el){
                if (el.pages) {
                    current.pages += el.customPages !== undefined ? el.customPages : el.pages;
                }
                current.scenesCount +=1;
                _.each(['prepTime', 'shootTime', 'estTime', 'duration'], function (prop){
                    current[prop] += el[prop];
                });
            });

            $ctrl.info.pages = $ctrl.SBFieldMethods.getScenePage({pages: current.pages});
            $ctrl.info.scenesCount = current.scenesCount;

            _.each(['prepTime', 'shootTime', 'estTime', 'duration'], function (prop){
                $ctrl.info[prop] = current[prop];
            });

            //todo see
            $ctrl.info.count = 0;
            /* if ($ctrl.filters[$ctrl.Types.Reports] === '4') {//element list
                var catId = $ctrl.filters[$ctrl.Types.Categs];
                 $ctrl.info.count = catId ? $ctrl.elementsCount : ;
             }*/

            if (typeof ($ctrl.getSelectedStripsOther) === 'function') {
                $ctrl.getSelectedStripsOther(selected);
            }

            $ctrl.LCS.timeout(function (){
                loadScriptInfo();
            }, 100);


            return selected;

            function getSelectedStripsOther(selected) {
                $ctrl.selected = JSON.parse(JSON.stringify(selected));

                $ctrl.selectedIds = selected.map(function(item){return item._id;});
                if ($ctrl.scriptSides.showHeader) {
                    gotoscene('Header');
                }

                return selected;
            }

            function processList(selected, type, prop) {
                var filter = $ctrl.filters[type], hasAll = false;
                var list = [];
                l = filter ? filter.length : 0;
                if(!l){
                    return selected;
                }
                if (selected && selected.length > 0) { //get strips that match filter char
                    //showHeader = true;
                    for (var i = 0; i < selected.length; i++) {
                        var item = selected[i],
                            chars = item[prop];
                        if (chars && chars.length) { //if has no characters remove the strip
                            //check if each character from filter exists in all the strips
                            //remove the strip if at least one character is not in
                            var exists;
                            if(hasAll) {
                                exists = true;
                                //check if each item in filter is in the list of chars
                                for (var j = 0; j < filter.length; j++) {
                                    var c = filter[j];
                                    if (!isInFilter(type, chars, c)) {
                                        exists = false;
                                        break;
                                    }
                                }
                            }else{
                                exists = false;
                                //check if at least one item in filter is in the list of chars
                                for (var j = 0; j < filter.length; j++) {
                                    var c = filter[j];
                                    if (isInFilter(type, chars, c)) {
                                        exists = true;
                                        break;
                                    }
                                }
                            }
                            if (exists) {
                                list.push(item);
                            }
                        }
                    }
                }
                return list;
            }
        }

        function getSelectedSchedule() {
            if(!$ctrl.schedulesLists || !$ctrl.schedulesLists.length){return null;}
            var type = $ctrl.Types.Schedules;
            var id = $ctrl.filters[type];
            if (!id) {
                id = $ctrl.schedulesLists[0]._id;
                $ctrl.filters[type] = id;
            }
            return _.find($ctrl.schedulesLists, {_id: id});
        }

        function showDisplayOption(id, show){
            return $ctrl.LCS[show ? 'removeClass' : 'addClass'](
                $ctrl.element.querySelector(getLiSelector($ctrl.Types.Display) + '[data-id="' + id + '"]'), 'sb-hide');
        }

        function onScheduleChanged() {
            console.log('onScheduleChanged');
            var type = $ctrl.Types.Schedules,
                s = getSelectedSchedule();
            setDrpName(type, s);

            var allScenes = isNullValue(s ? s._id : null);
            showScriptTitle(type, allScenes ? null : s.name);

            //is element list reports
            if ($ctrl.isReports && $ctrl.selectedReport._id === '4' || loadSection($ctrl.Types.Days, getDayBreaks($ctrl.Types.Days))) {
                onDayBreakChanged();
            }
        }

        function onDayBreakChanged() {
            console.log('onDayBreakChanged');
            removeFilters();
            //$ctrl.filteredStrips changes when schedule changes
            var sceneNameEl = $ctrl.element.querySelector('.wrapper-scenes > h3 .namex'),
                scheduleListId = $ctrl.filters[$ctrl.Types.Schedules],
                scheduleDayId = scheduleListId ? $ctrl.filters[$ctrl.Types.Days] : null,
                dayBreak,
                allScenes = isNullValue(scheduleDayId),
                withBoneyard = allScenes && $ctrl.boneyardStrips && $ctrl.scriptSides.showBoneyard,
                schedules = withBoneyard ? [].concat($ctrl.activeStrips).concat($ctrl.boneyardStrips) : (scheduleListId ? $ctrl.activeStrips : $ctrl.strips);

            if(!$ctrl.scriptSides.showOmitted){
                schedules = _.filter(schedules, function(item){return item.type === $ctrl.StripTypes.Scene && item.isNotOmitted || item.type !== $ctrl.StripTypes.Scene});
            }

            var scenename;
            if(!scheduleListId){//scenes in order of the script
                $ctrl.filteredSchedules = schedules;
                scenename = 'Script';
            }else if(allScenes){//scenes day breaks and banners for schedule
                $ctrl.filteredSchedules = schedules;
                scenename = 'Schedule';
                dayBreak = getEmptyDayBreak();
            }else { //scenes and banners for the day
                $ctrl.filteredSchedules = _.filter(schedules, {scheduleDayId: scheduleDayId});
                scenename = 'Day Break';
                dayBreak = _.find($ctrl.activeStrips, {_id: scheduleDayId});
            }

            if(scenename && sceneNameEl){
                sceneNameEl.innerHTML = scenename;
            }

            $ctrl.filteredScenes = _.filter($ctrl.filteredSchedules, {type: $ctrl.StripTypes.Scene});
            $ctrl.filteredActive = _.filter($ctrl.filteredSchedules, {active: true});
            showBoneyard(withBoneyard);

            var sceneCountEl = $ctrl.element.querySelector('.wrapper-scenes > h3 .txt');
            if(sceneCountEl) {
                var activeScenesCount = _.filter($ctrl.filteredScenes, {active: true}).length;
                sceneCountEl.innerHTML = activeScenesCount;
                $ctrl.LCS[activeScenesCount ? 'removeClass' : 'addClass'](sceneCountEl, 'sb-hide');
            }

            var id = 'showBoneyard';
            $ctrl.LCS[allScenes && $ctrl.boneyardStrips ? 'removeClass' : 'addClass'](
            $ctrl.element.querySelector(getLiSelector($ctrl.Types.Display) + '[data-id="' + id + '"]'), 'sb-hide');

            if($ctrl.isReports) {
                loadSection($ctrl.Types.Reports, getReportsList());
            }

            setDrpName($ctrl.Types.Days, dayBreak);
            showScriptTitle($ctrl.Types.Days, dayBreak ? dayBreak.name:null);

            var hasStrips = loadSection($ctrl.Types.StripsF, getStrips($ctrl.Types.StripsF, $ctrl.filteredScenes, true));
            if (hasStrips) {
                loadSection($ctrl.Types.Strips, getStrips($ctrl.Types.Strips, $ctrl.filteredActive, false, true));

                loadSection($ctrl.Types.Locations, getUniqueLocationsList($ctrl.Types.Locations, $ctrl.filteredScenes, 'locations'));
            }

            if(hasStrips || $ctrl.nonscriptedElements !== null) {

                if ($ctrl.isReports) {
                    loadSection($ctrl.Types.Categs, getCategories($ctrl.Types.Categs));
                }
                //loadSection($ctrl.Types.Categs, getCharacters());
                loadSection($ctrl.Types.Chars, getUniqueElementsList($ctrl.Types.Chars, $ctrl.filteredScenes, 'characters'));

                onStripsChanged();
            }
        }

        function getCategories(type) {
            var hasScenes = $ctrl.filteredScenes && $ctrl.filteredScenes.length > 0,
                showNonscriptedElements = $ctrl.nonscriptedElements !== null && $ctrl.scriptSides.showNonscriptedElements;
            if(!$ctrl.filteredScenes && !showNonscriptedElements){return null;}
            var prop = '_id', c = [];
            $ctrl.selectedCategIds = [];

            if(hasScenes) {
                _.each($ctrl.filteredScenes, function (item) {
                    var els = item.elements;
                    if (els) {
                        for (var categoryId in els) {
                            if (els[categoryId] && els[categoryId].length > 0) {
                                processC(categoryId);
                            }
                        }
                    }
                });
            }

            if(showNonscriptedElements) {
                for(var id in $ctrl.nonscriptedElements){
                    var el = $ctrl.nonscriptedElements[id];
                    processC(el.categoryId);
                }
            }

            return getULSection(type, prop, getCategoryById().c, c, false, null, true);

            function processC(categoryId){
                if(_.find($ctrl.selectedCategIds, function(cid){return categoryId === cid;}) === undefined){
                    var cat = getCategoryById(categoryId);
                    if(cat && cat.c) {
                        c.push(cat.c);
                        $ctrl.selectedCategIds.push(categoryId);
                    }
                }
            }
        }

        function showScriptTitle(type, name) {
            var els = $ctrl.element.querySelectorAll('.'+$ctrl.scriptInfoCls+' .'+type);
            if (els && els.length>0) {
                _.each(els, function (el) {
                    if(el) {
                        if(name) {
                            var n = el.querySelector('.name');
                            if(n){
                                n.innerHTML = name;
                            }
                        }
                        $ctrl.LCS[name ? 'removeClass' : 'addClass'](el, 'sb-hide');
                    }
                });
            }
        }

        function onStripsChanged() {
            console.log('onStripsChanged');
            var selected = $ctrl.isReports
                //&&$ctrl.selectedReport.withDays
                ? $ctrl.filteredSchedules : $ctrl.filteredScenes;
            $ctrl.selected = getSelectedSchedules(selected);

            $ctrl.info.scenesCount = $ctrl.selected ? $ctrl.selected.length : 0;

            var l = $ctrl.info.scenesCount;
            $ctrl.LCS[l ? 'addClass' : 'removeClass']($ctrl.element.querySelector('.no-product'), 'sb-hide');

            updateDisplayedFilters();

            onCategoryChanged();

            var selEl = $ctrl.element.querySelector('.wrapper-scenes > h3 .txtSel');
            if(selEl) {
                var sceneCountEl = $ctrl.element.querySelector('.wrapper-scenes > h3 .txt'),
                    c = parseInt(sceneCountEl ? sceneCountEl.innerText : 0, 10);
                selEl.innerHTML = l + ' of ';
                $ctrl.LCS[c === l  ? 'addClass' : 'removeClass'](selEl, 'sb-hide');
            }
        }
        
        function getUniqueLocationsList(type, list, prop) {
            if (!list || !list.length) {
                return null;
            }
            var c = [], p = '_id';
            _.each(list, function (el) {
                var els = el[prop];
                if (els) {
                    for (var i = 0; i < els.length; i++) {
                        var item = els[i], id = item[p];
                        if (_.find(c, {_id: id}) === undefined) {
                            c.push(item);
                        }
                    }
                }
            });
            c = _.sortBy(c, 'order');

            return c && c.length > 0 ? getUl(c, type, p, true) : null
        }

        function getUniqueElementsList(type, list, prop) {
            if (!list || !list.length) {
                return null;
            }
            var c = [];
            _.each(list, function (item) {
                var els = item[prop];
                if (item.type === 1 && els) {
                    for (var i = 0; i < els.length; i++) {
                        var el = els[i];
                        if(el) {
                            var id = el.elementId;
                            if (_.find(c, {_id: id}) === undefined) {
                                c.push($ctrl.elements[id]);
                            }
                        }
                    }
                }
            });
            c = _.sortBy(c, 'order');

            return c && c.length > 0 ? getUl(c, type, '_id', true) : null
        }
        
        function onStripsFChanged() {
            var filters = $ctrl.filters[$ctrl.Types.StripsF],
                l = filters && filters.length ? filters.length : 0;
            if (!l) {
                $ctrl.filters[$ctrl.Types.Chars] = [];
            } else {
                var chars = $ctrl.filters[$ctrl.Types.Chars];
                _.each(chars, function (char, index) {
                    if (!isCharInStrips(char, filters)) {
                        $ctrl.filters[$ctrl.Types.Chars].splice(index, 1);
                    }
                });
            }
            onStripsChanged();
        }

        function isCharInStrips(id, strips) {
            var l = strips && strips.length > 0 ? strips.length : 0;
            if (l) {
                for (var i = 0; i < l; i++) {
                    var stripId = strips[i];
                    //if there are scene elements for the scenes than use them
                    if (_.find($ctrl.taggingScenes, {elementId: id, stripId: stripId._id ? stripId._id : stripId})) {
                        return true;
                    }
                }
            }

            return false;
        }

        function isInFilter(type, filters, id) {
            return hasMultiSelect(type) ? _.find(filters, function (f) {
                return f === id;
            }) : filters === id;
        }

        function findIndex(filters, id) {
            return _.findIndex(filters, function (f) {
                return f === id;
            });
        }


        function getStrips(type, list, withCheck, withSelected) {
            var el = '';
            _.each(list, function (item, i) {
                el += getStrip(item, withCheck, withSelected);
            });
            return el;

            function getStrip(item, withCheck, withSelected) {
                var id = getScheduleId(item);
                return '<li class="with-overlay stripitem" data-type="' + type + '" data-id="' + id + '"  ' +
                    (withSelected ? ('ng-class="{\'selected\': $ctrl.selectedScene === \'' + id + '\'}"') : '') +
                    '>' +
                    '<div class="row-schedule colored-col border-top hastype with-smaller-font ' +
                    (item.type === $ctrl.StripTypes.DayBreak ? 'daybreak' :
                        (item.type === $ctrl.StripTypes.Banner ? $ctrl.SBFieldMethods.getColorClass(item) : (' '+$ctrl.sceneCls+' ' + item.color))) + '" ' +
                    (item.type === $ctrl.StripTypes.Banner ? ('style="background-color:' + item.color + '"') : '') +
                    '>' +
                    (withCheck ? getCheck($ctrl.isSelectedFilter(id, type)) : '') +
                    (type === $ctrl.Types.StripsF ? getSimpleContent() : getContent()) +
                    '</div>' +
                    '</li>';

                function getContent() {
                    return $ctrl.processListItemColumns(item, false, false, true, undefined, null).content;
                }

                function getSimpleContent() {
                    var el = '';
                    if (item.type === $ctrl.StripTypes.DayBreak) {
                        el += '<div class="text-center white">' + getDayBreakName(item) + '</div>';
                    } else if (item.type === $ctrl.StripTypes.Banner) {
                        el += (item.name ? (
                            '<div class="text-center white">' +
                            '<div>'+item.name+'</div>' +
                            '</div>'
                        ) : '');
                    } else {
                        el += '<div class="border-right text-center col30">' + item.sceneText + '</div>' +
                            '<div class="with-padding-left uppercase grow-column">' +
                            (!item.isNotOmitted ? '<div class="display-block full-width"><span class="omitted">OMITTED</span></div>' : '') +
                            '<div class="with-ellipsis">' + (item.miniTitle || "–") + '</div>' +
                            '</div>';
                    }
                    return el;
                }
            }
        }

        function getCategColor(item) {
            return '<div class="color-button small">' + //'sbf' todo
                '<div class="'+(item.icon ?item.icon : 'elements ') + '" ' +
                (item.color ? ('style="background-color:'+item.color+'"') : '') +
                '></div>' +
                '</div>';
        }
        function getCheck(checked) {
            return '<div class="custom-checkbox inrow whitebg text-center col30"><label><input type="checkbox" ' + (checked ? 'checked="checked" ':'')+
                //' disabled="disabled"' +
                '><span></span></label></div>';
        }

        function getDayBreakName(item) {
            var n = '&nbsp;–&nbsp',
                d='<span class="long-dash">'+n+'</span>';
            return '<span>'+item.name+'</span>' +
                (item.pages.value ? (d +
                    'Pgs: ' + (item.pages.page ? ('<span class="page font-size-12">'+item.pages.page+'</span>&nbsp;'):'')+
                    '<span class="fr">'+item.pages.fr+'</span>'):'') +
                (item.date ? (d +
                    '<span>'+ $ctrl.CPS.getCreatedAt(item.date, $ctrl.CPS.shortDateFormat)+'</span>') :'') +
                (item.startTime ? ((item.date?' @ ' :'') + $ctrl.SBFieldMethods.getEstVal(item.startTime)) : '') +
                (item.estTime ? ('<span class="semibold">Est. Time</span>' + $ctrl.SBFieldMethods.getEstVal(item.estTime)) : '')
                //+(item.duration ? ('<span class="semibold">Duration</span>' + $ctrl.SBFieldMethods.getEstVal(item.duration, true)) : '');
        }

        function getOptionsDrp() {
            var type = $ctrl.Types.Display,
                icon = 'cog',
                iconLevel = 2,
                style = 'width: 230px;left: -186px',
                title = 'Display Options';
            return '<div class="with-margin-left pull-left ' + getDrpFilterCls(type) + '" dropdown>' +
                '<button id="btnLayout" type="button" class="btn btn-small primary-faded without-text dropdown-toggle pull-left" dropdown-toggle tooltip="'+title+'" tooltip-placement="bottom">' +
                $ctrl.LCS.getISBDiv(icon, iconLevel, 'pull-left') +
                $ctrl.LCS.getISBDiv('arrow-filled-down', 2, 'pull-right blue') +
                '</button>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft" role="menu" style="'+style+'">' +
                '<div class="header-small clearfix with-side-padding">'+title+'</div>' +
                '<ul class="listitems-selector with-checkedx ' + getSectionListCls(type) + '">' +
                getUl($ctrl.DisplayFilters, type, 'prop', false, null, true) +
                '</ul>' +
                '</div>' +
                '</div>';
        }

        function getReportsDrp(nonScriptedOnly) {
            if(!$ctrl.isReports){return '';} //$ctrl.selectedReport.icon
            var type = $ctrl.Types.Reports, name='Report Type';
            return '<div class="' + getDrpFilterCls(type) + ' dropdown pull-left with-margin-right ' + (nonScriptedOnly ? 'sb-hide' : '') + '" dropdown>' +
                '<button type="button" class="btnReportTypes btn btn-small without-text transparent noborder dropdown-toggle semibold pull-left" dropdown-toggle tooltip="'+name+'" tooltip-placement="bottom">' +
                $ctrl.LCS.getISBDiv('icon', 6, 'pull-left gray') +
                '<div class="with-margin-left hide-ipad pull-left txt"></div> ' +
                $ctrl.LCS.getISBDiv('down-arrow', 2, 'pull-right') +
                '</button>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft" role="menu" style="width: 240px">' +
                //'<div class="header-small clearfix   with-side-padding">Select '+name+'</div>' +
                '<ul class="listitems-selector with-checkedx ' + getSectionListCls(type) + '"></ul>' +
                '</div>' +
                '</div>';
        }

        function getSchedulesDrp() {
            if (!$ctrl.schedulesLists) {
                return $ctrl.isReports ? '' : ('<span class="title pull-left">' + $ctrl.title + '</span>');
            }
            var type = $ctrl.Types.Schedules,
                name = 'Order Sides By',//'ShootingSchedules';
                s = getSelectedSchedule();

            return '<div class="medium-template pull-left ' + getDrpFilterCls(type) + ' ' + (isBreakdownReport() ? 'sb-hide' : '') + '" dropdown>' +
                ($ctrl.isReports ?('<span class="left-separator hide-ipad text-info-count with-line-height pull-left"></span>') : '') +
                '<button type="button" class="btn btn-small without-text transparent noborder dropdown-toggle semibold pull-left" dropdown-toggle tooltip="' + name + '" tooltip-placement="bottom">' +
                $ctrl.LCS.getISBStripboard('pull-left gray') +
                ' <span class="with-margin-left hide-ipad txt pull-left">' + s.name + '</span> <div class="sbf down-arrow pull-right"></div>' +
                '</button>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft filters-reports-days" role="menu">' +
                '<div class="header-small clearfix with-side-padding ">' + name + '</div>' +
                '<ul class="fancy-scrollbar vertical ' + getSectionListCls(type) + '">' + getUl($ctrl.schedulesLists, type, '_id') + '</ul>' +
                '</div>' +
                '</div>';
        }

        function getDayBreaksDrp() {
            var type = $ctrl.Types.Days,
                name = 'Day',
                icon = 'daybreak',
                iconLevel = 3,
                drpCls =  'filters-reports-days',
                style= 'left: -138px';
            return '<div class="' + getDrpFilterCls(type) + ' dropdown pull-left with-margin-left sb-hide" dropdown>' +
                '<button type="button" class="btn btn-small without-text primary-faded dropdown-toggle pull-left" dropdown-toggle tooltip="Filter By '+name+'" tooltip-placement="bottom">' +
                $ctrl.LCS.getISBDiv(icon, iconLevel, 'pull-left') +
                //'<span class="hide-ipad txt"></span> ' +
                $ctrl.LCS.getISBDiv('arrow-filled-down', 2, 'pull-right blue') +
                '</button>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft '+drpCls+'" role="menu" style="'+style+'">' +
                '<div class="header-small clearfix with-side-padding">Filter By '+name+'</div>' +
                getDrpUl(type) +
                '</div>' +
                '</div>';
        }

        function getCategoriesDrp() {
            if(!$ctrl.categoryIds || $ctrl.categoryIds.length < 2){return '';}
            var type = $ctrl.Types.Categs,
                name = 'Categories',
                icon ='elements',
                iconLevel = 6,
                drpCls =  'cast-popup',
                style= 'left: -136px;width: 260px',
                drpUlCls = 'with-checkedx',
                title = 'Filter by ' + name;

            return '<div class="pull-left with-margin-left ' + getDrpFilterCls(type) + '" dropdown >' +
                '<button type="button" class="btn btn-small primary-faded without-text dropdown-toggle pull-left" dropdown-toggle tooltip="'+title+'" tooltip-placement="bottom">' +
                $ctrl.LCS.getISBDiv(icon, iconLevel, 'pull-left') +
                //'<div class="hide-ipad txt inline-block"></span> ' +
                $ctrl.LCS.getISBDiv('arrow-filled-down', 2, 'pull-right blue') +
                '</button>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft ' + drpCls + '" role="menu" style="' + style + '">' +
                '<div class="header-small clearfix with-side-padding">' + name + '</div>' +
                '<div class="cast-popup ">'+
                getDrpUl(type, drpUlCls)+
                '</div>' +
                '</div>' +
                '<div class="no-project withpopover centering spacing-half ng-hide" ng-show="$ctrl.search">' + $ctrl.LCS.getISBDiv(icon, 'big-icon text-center') +
                '<p class="text-center desc spacing-half-top">No '+name.toLowerCase()+' match this search.</p>' +
                '</div>' +
                '</div>';
        }

        function getElementsDrp() {
            var type = $ctrl.Types.Elements,
                name = 'Elements',
                icon ='category';
            return '<div class="' + getDrpFilterCls(type) + ' margin-half-top ">' +
                '<div class="header-small clearfix   with-side-padding">Filter by <span class="txt">'+name+'</div>' +
                getDrpUl(type )+
                '</div>';
        }

        function getLocationsDrp() {
            if (!$ctrl.locations) {
                return '';
            }
            var type = $ctrl.Types.Locations,
                name = 'Locations',
                icon = 'pin',
                iconLevel = 2,
                drpCls = 'cast-popup',
            style= 'left: -216px;width: 260px';

            return '<div class="pull-left with-margin-left ' + getDrpFilterCls(type) + '" dropdown>' +
                '<button type="button" class="btn'+ name.split(' ')[0] +' btn btn-small primary-faded without-text dropdown-toggle pull-left" dropdown-toggle tooltip="Filter '+name+'" tooltip-placement="bottom">' +
                $ctrl.LCS.getISBDiv(icon, iconLevel, 'pull-left') +
                $ctrl.LCS.getISBDiv('arrow-filled-down', 2, 'pull-right blue') +
                '</button>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft '+drpCls+'" role="menu" style="'+style+'">' +
                '<div class="header-small clearfix with-side-padding">Filter by '+name+'</div>' +
                getDrpUl(type )+
                '</div>' +
                '<div class="no-project withpopover centering spacing-half ng-hide" ng-show="$ctrl.search">' +
                $ctrl.LCS.getISBDiv(icon, 6, 'big-icon text-center') +
                '<p class="text-center desc spacing-half-top">No '+name.toLowerCase()+' match this search.</p>' +
                '</div>' +
                '</div>';
        }

        function getCharactersDrp() {
            if (!$ctrl.characters) {
                return '';
            }
            var type = $ctrl.Types.Chars,
                name = 'Characters',
                icon = 'character',
                iconLevel = 3,
                drpCls = 'cast-popup',
                style= 'left: -216px;width: 260px';

            return '<div class="pull-left with-margin-left ' + getDrpFilterCls(type) + '" dropdown>' +
                '<button type="button" class="btn btn-small primary-faded without-text dropdown-toggle pull-left" dropdown-toggle tooltip="Filter By '+name+'" tooltip-placement="bottom">' +
                $ctrl.LCS.getISBDiv(icon, iconLevel, 'pull-left') +
                $ctrl.LCS.getISBDiv('arrow-filled-down', 2, 'pull-right blue') +
                '</button>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft '+drpCls+'" role="menu" style="'+style+'">' +
                '<div class="header-small clearfix with-side-padding">Filter by '+name+'</div>' +
                getDrpUl(type )+
                '</div>' +
                '<div class="no-project withpopover centering spacing-half ng-hide" ng-show="$ctrl.search">' +
                $ctrl.LCS.getISBDiv(icon, null, 'big-icon text-center') +
                '<p class="text-center desc spacing-half-top">No '+name.toLowerCase()+' match this search.</p>' +
                '</div>' +
                '</div>';
        }

        function getScenesDrp() {
            var type = $ctrl.Types.StripsF,
                name = 'Scenes',
                icon = 'stripboard',
                iconLevel = 5,
                drpCls = 'top-search-drp mini-strips',
                style= 'left:-297px';

            return '<div class="medium-template pull-left with-margin-left '+getDrpFilterCls(type)+'" dropdown>' +
                '<button type="button" class="btn' + name.split(' ')[0] + ' btn btn-small primary-faded without-text dropdown-toggle pull-left" dropdown-toggle tooltip="Filter ' + name + '" tooltip-placement="bottom">' +
                $ctrl.LCS.getISBDiv(icon, iconLevel, 'pull-left') +
                $ctrl.LCS.getISBDiv('arrow-filled-down', 2, 'pull-right blue') +
                '</button>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft '+drpCls+'" role="menu" style="' + style + '">' +
                '<div class="header-small clearfix">Filter by ' + name + '</div>' +
                getDrpUl(type) +
                '</div>' +
                '</div>';
        }

        function getDrpSettings() {
            $ctrl.currentZoomedTable = '.' + $ctrl.tableCls;
            return '<div dropdown class="pull-left position-relative one-line-tooltip with-margin-left dropdown dropdown-wrapper">' +
                '<button id="btnSettings" type="button" class="btn btn-small primary-faded without-text dropdown-toggle" dropdown-toggle tooltip="Settings" tooltip-placement="bottom">' + $ctrl.LCS.getISBDiv('horizontal-dots', 2) + '</button>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft with-overflow drpSettings" role="menu">' +
                '<div class="header-small clearfix spacing-half-top padding-left20">More Options</div>' +
                '<ul class="listitems-selector with-checked">' +
                /* '<li class="padding-right: 20px">' +
                     '<a class="fixed-layout table-div" ng-click="$ctrl.openVersions()" analytics-on analytics-action="Version History" >' +
                         '<div class="sbf versions"></div>' +
                         '<div class="with-padding-right"><div class="with-ellipsis">Version History</div> </div>' +
                     '</a>' +
                 '</li>' +
                 */
                ($ctrl.CPS.isAuthenticated ? ('<import-script is-li="true" ' +
                    ($ctrl.pageClass ? ('page-class="'+$ctrl.pageClass+'" ') : '') +
                    '></import-script>') : '') +
                (($ctrl.stripsCount > 0 || $ctrl.nonscriptedElements!==null) ? ('<print-button-li></print-button-li>') : '') +
                ($ctrl.isReports ? ( '' +
                    '<li>' + $ctrl.getDrpZoomFilters() + '</li>'
                ) : ('<li><a ng-click="$ctrl.downloadSBX(e)" class="fixed-layout table-div full-width"><div class="col30">'+$ctrl.LCS.getISBDiv('download-sbx', 3)+'</div><div class="with-ellipsis">Download SBX File</div></a></li>')) +
                '</ul>' +
                '</div>' +
                '</div>';


            //' <!--<a class="btn btn-gray btn-small without-text sbf with-margin-left" ng-class="{false:\'category\',true:\'category\'}[$ctrl.scriptSides.showTagging==true]" ng-click="$ctrl.toggleTagging()" analytics-on analytics-action="{{($ctrl.scriptSides.showTagging ? \'Hide\':\'Show\')+ \' Tags\'}}" tooltip="{{$ctrl.scriptSides.showTagging ? \'Hide\':\'Show\'}} Tags" tooltip-placement="bottom"></a>-->' +
        }

        function getDrpUl(type, cls, isFixedHeight) {
            return '<ul class="fancy-scrollbar vertical listitems-selector ' + getSectionListCls(type) + ' ' + (cls || '') + '"' +
                (isFixedHeight? (' style="max-height: '+(type==='ca' ? '205':'200')+'px;margin-right:5px;padding-right:5px"') : '') +
                '></ul>';
        }

        function getDrpFilterCls(type) {
            return 'drpFilter' + type;
        }

        function getSectionListCls(type, listName) {
            return (listName ? listName : 'sectionList') + type;
        }


        function getULSection(type, prop, defaultItem, list, withCheckInFront, cls, withCheckAfter) {
            var section = getDrpSection(type);
            if (section) {
                setDrpShow(type, list);
                if (list) {
                    var s = isNullValue($ctrl.filters[type]) ? defaultItem : _.find(list, {_id: $ctrl.filters[type]});
                    setDrpName(type, s);
                    return getLi(defaultItem, type, prop, withCheckInFront, cls, withCheckAfter) +
                        getUl(list, type, prop, withCheckInFront, cls, withCheckAfter);
                }
            }
            return '';
        }

        function getUl(list, type, prop, withCheckInFront, cls, withCheckAfter) {
            var el = '';
            _.each(list, function (item) {
                el += getLi(item, type, prop, withCheckInFront, cls, withCheckAfter);
            });
            return el;
        }

        function getLiType(type, val, active, cls) {
return 'data-type="' + type + '" data-id="' + val + '" class="table-div full-width '+(cls?cls:'') + ' ' +
            (active ? 'active' : '') + '"';
        }

        function getLi(item, type, prop, withCheckInFront, cls, withCheckAfter) {
            var isChar = type === $ctrl.Types.Chars,
                isCateg = type === $ctrl.Types.Categs,
                val = item[prop],
                active = $ctrl.isSelectedFilter(val, type),
              tag = item.header ? 'span' : 'a';
   return '<li ' + (item.hideSchedule ? 'class="sb-hide"' : '') + '>' +
                '<'+tag+' ' + getLiType(type, val, active, (cls ? cls : '') + (item.header? ' with-title padding-left-24' : '')) + '>' +
                (withCheckInFront? getCheck(active) : '') +
   (isChar ? ('<div class="col24 with-padding-right"><div class="numbered-char">' + item.currentId + '</div></div>') : '') +
   (isCateg ? ('<div class="icon-col categ-icon color-button small centered">' +
                   '<div style="background-color:' + item.color + '">' + $ctrl.LCS.getISBDiv(item.icon ? item.icon:'elements', 6, 'sbf22') + '</div>' +
               '</div>') : '') +
(item.showIcon?('<div class="col30">' + $ctrl.LCS.getISBDiv(item.icon, 6)+ '</div>'):'') +
              '<div '+(isChar ? 'class="uppercase"':(item.header?'class="bold uppercase"':'')) +
                (item.tooltip? ('tooltip="'+item.tooltip+'" tooltip-placement="bottom"') : '') +
              '>' +
              '<div class="'+(item.header?('header-small clearfix '+(item.cls?item.cls:'')):'with-ellipsis')+'">' + item.name + '</div>' +
              '</div>' +
                    /*'<div class="checkmark"><span class="sbf check-mark primary ' + ($ctrl.isSelectedFilter(item.prop, type) ? '' : 'sb-hide') + '"> </span></div>' + */
                '</'+tag+'>' +
            '</li>';
        }
        
        function getScheduleId(item) {
            //return item._id; //preProcessGroupItem ensures that _id is stripId
           return item.type === $ctrl.StripTypes.Scene ? item.stripId : item._id;
        }

        function removeFilters() {
            _.each(filterTypes, function (type){
                $ctrl.filters[type] = null;
            });
        }
        //todo showHeader()
        function showHeader() {
            var m = $ctrl.LCS[$ctrl.scriptSides.showHeader ? 'removeClass' : 'addClass'];
            var els = $ctrl.element.querySelectorAll('.script-showHeader');
            if (els) {
                m(els, 'sb-hide');
            }
            m($ctrl.element.querySelector('.report-body > div'), 'spacing');
        }
    }
}


function getExtraRouteParams(isPrint){
    return isPrint ? null : 'share&collabrootid&card&:comment&item&utm_source&utm_medium&utm_campaign&utm_content&utm_term&dontcountview'
}
angular.module('product.routing', [
    'product.item.component'
])
.config(ProductRouting);

ProductRouting.$inject = ['$uiRouterProvider'];

function getPrintExt(){
    return 'print-';
}
function ProductRouting($uiRouter) {

    var type = 'user';
    addStates($uiRouter, [
        getP(type),
        getP(getPrintExt() + type)
    ]);

    function getP(type) {
        return {
            name: type + '.product',
            abstract: true,
            url: '/projects/:productId?scriptId',
            views: {
                loggedview: 'productPage'
            },
            resolve: {
                product: ProductParam
            }
        };
    }
}

ProductParam.$inject = ['$transition$', 'CurrentProduct'];

function ProductParam(  $transition$, CurrentProduct){
    var params = $transition$.params(),
        productId = params ? params.productId : null,
        scriptId = params ? params.scriptId : null;

    return CurrentProduct.loadProduct(productId, scriptId, function (product) {
        return product;
    })
}

function productPageRouting($uiRouter, compOptions, other){
    pageRouting(true, $uiRouter, compOptions, other);
}

function maniNavPageRouting($uiRouter, compOptions, other){
    pageRouting(false, $uiRouter, compOptions, other);
}

function pageRouting(isProduct, $uiRouter, compOptions, other) {
    if (!other) {
        other = {};
    }

    other.bodyClass = (other.bodyClass || '') +
        (isProduct && other.withCommentsSidebar ? ' with-sidebar-comments ' : '') +
        ((compOptions.hasTree || other.hasTree) ? (' groups-tree-page with-tree' +
            (other.withPrint ? ' with-printable-list' : '')) : '') +
        (other.isDarkMode ? ' dark-mode' : '');


    var overviewBlockType = compOptions.overviewBlockType,
        listField = other.listField || compOptions.listField,
        withoutChildren = !listField || other.withoutChildren,

        data = {
            title: other.title,
            bodyClass: other.bodyClass
        },

        params,
        resolve = {},

        otherListField = compOptions.otherListField || other.otherListField,
        otherListName = compOptions.otherListName || other.otherListName;

    if (isProduct) {
        data.overviewBlockType = overviewBlockType;
        data.hasScript = compOptions.hasScript;
        data.showVersions = compOptions.showVersions;
    }

    if (!withoutChildren) {
        setParam('listField', listField, other.defaultListField);
    }

    setParam('otherListField', otherListField, other.defaultOtherListField);

    var p = other.permissions;
    if (p) {
        data = _.extend(data, p === 'useronly' ? {
            minRole: 2, minMemberType: 0 //only for logged in users
        } : p);
    }

    var s = [getP(false)];
    if (compOptions.withCustomReports) {
        s.push(getP(true));
    }

    addStates($uiRouter, s);

    function setParam(type, name, value) {
        if (!name) {
            return;
        }

        data[type] = name;
        if (!params) {
            params = {};
        }
        params[name] = {
            value: value ? value : null,
            dynamic: true
        };

        resolve[name] = DocumentIdParam;

        DocumentIdParam.$inject = ['$transition$'];

        function DocumentIdParam($transition$){
            return $transition$.params()[name];
        }
    }

    function getP(isPrint) {
        var p = getExtraRouteParams(isPrint),
            pageComponent = compOptions.pageComponent ? compOptions.pageComponent : overviewBlockType,
            url = other.url ? other.url : (compOptions.url ? compOptions.url : pageComponent),
            views = {};

        views[isProduct ? 'bodyWrapper' : 'loggedview'] = pageComponent + (isPrint ? 'Print' : 'Page');

        return _.extend({
                name: (isPrint ? getPrintExt() : '') +
                     (isProduct ? 'user.product' : 'user') + '.' + (other.stateName ? other.stateName : url),
                data: data,
                url: '/' + url +
                    (otherListField ? ('/:' + otherListField) : (withoutChildren ? '' : ('/:' + listField))) +
                    (otherListField && !other.withoutVersion ? (
                            (otherListName ? ('/' + otherListName) : '') +
                            '/:' + listField) : ''
                    ) +
                    '?filter' +
                    (isProduct && p ? ('&' + p) : '') +
                    ((compOptions.withActiveGroup || compOptions.withActiveTree) ? '&active' : '') +
                    (other.otherUrl ? ('&' + other.otherUrl) : ''),
                views: views,
                reloadOnSearch: false
            },
            params ? {params: params} : null,
            resolve ? {resolve: resolve} : null
        );
    }
}

/*todo figure out resolve
DocumentIdParam.$inject = ['$transition$'];
function DocumentIdParam($transition$){
    return $transition$.params().documentId;
}

DocumentVersionIdParam.$inject = ['$transition$'];
function DocumentVersionIdParam($transition$){
    return $transition$.params().documentVersionId;
}

