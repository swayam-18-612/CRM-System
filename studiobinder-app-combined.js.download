.controller('CalendarPageCtrl', CalendarPageCtrl);
CalendarPageCtrl.$inject = ['CalendarPageCtrlService', '$element'];
function CalendarPageCtrl(CalendarPageCtrlService, $element) {

    var $ctrl = this;

    $ctrl.$onInit = $onInit;
    $ctrl.$onDestroy = $onDestroy;

    $ctrl = new CalendarPageCtrlService($ctrl, $element);

    function $onInit() {
        $ctrl.onInit();
    }

    function $onDestroy() {
        $ctrl.onDestroy();
    }
}

angular.module('product.calendarPage.service', [
    'user.calendar.init.service'
])

.service('CalendarPageCtrlService', CalendarPageCtrlService);
CalendarPageCtrlService.$inject =  ['CalendarPageInitCtrlService', 'RouteCollaboratorsService'];

function CalendarPageCtrlService(CalendarPageInitCtrlService, RouteCollaboratorsService ) {
    return function($ctrl, $element) {
        $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
        $ctrl.isOnProduct = true;

        $ctrl.getPageTemplate = getPageTemplate;

        $ctrl.listTreeService = {
            active: null,
            getNodeById: getNodeById,
            getBreadcrumbs: getBreadcrumbs
        }
        $ctrl.RouteCollaboratorsService.setListTreeService($ctrl.listTreeService);

        $ctrl.getCollabBannerInfo = getCollabBannerInfo;

        $ctrl = new CalendarPageInitCtrlService($ctrl, $element, {
            moreFilterButtons: true,
            showBannerProp: 'showCalendarBanner',
            bannerFeatureProp: 'calendar',
        });

        return $ctrl;

        function getCollabBannerInfo(){
            return {txt: 'Create and share your own production calendars for free.', campaign:'collab-calendar'};
        }

        function getNodeById(listId) {
            return $ctrl.selectedCalendar;
        }

        function getBreadcrumbs(list) {
            return [];
        }

        function getPageTemplate() {
    return ($ctrl.withoutTopFilters ? '' : ('<nav class="filters on-top hide-print" ng-show="$ctrl.list.items.length > 0">' +
                $ctrl.getTopFilters() +
            '</nav>')) +
            '<sb-calendar ng-show="$ctrl.list.items.length > 0" class="sb-calendar h-full" ' +
                'comp-options="::$ctrl.compOptions" ' +
                'is-company="::false" ' +
                'calendar-id="$ctrl.selectedCalendarId" ' +
                'create-from-top="$ctrl.createFromTop()" ' +
                'get-empty-state="$ctrl.getEmptyState()" ' +
            '></sb-calendar>' +
        '<div ng-if="$ctrl.list.items.length === 0" class="empty-state-wrapper with-side-margin with-margin-top">'+$ctrl.getEmptyState()+'</div>';
        }
    }
}

angular.module('user.calendar.init.service', [
    'user.calendar.gantt.component',
    'apiPagination.Calendars',
    'apiServices.CalendarTemplates',
    'product.calendar.item.edit.component',
    'user.calendar.topNav.service',
    'apiConstants.calendar.services',
    'services.todoColumnsConfigsService',
    'angularytics.provider'
])

.service('CalendarPageInitCtrlService',CalendarPageInitCtrlService);
CalendarPageInitCtrlService.$inject = ['TodoColumnsConfigsService', 'CalendarsPagination', 'TopNavCalendarService','ListInitService', 'CalendarConstantsService', 'PageSimpleInitCtrlService', 'RouteCollaboratorsService', 'Angularytics'];

function CalendarPageInitCtrlService(TodoColumnsConfigsService, CalendarsPagination, TopNavCalendarService, ListInitService, constantsService, PageSimpleInitCtrlService, RouteCollaboratorsService, Angularytics) {
    return function($ctrl, $element, otherCompOptions){
        $ctrl.Angularytics = Angularytics;
        $ctrl.TodoColumnsConfigsService = TodoColumnsConfigsService;
        $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
        $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;

        $ctrl.$element = $element;
        $ctrl.element = $element[0];

        $ctrl.isActiveGroup = isActiveGroup;
        $ctrl.isSelectedCalendar = isSelectedCalendar;
        $ctrl.selectCalendar = selectCalendar;

        if(!$ctrl.getParams) {
            $ctrl.getParams = getParams;
        }

        if(!$ctrl.getTopFilters) {
            $ctrl.getTopFilters = getTopFilters;
        }
        if(!$ctrl.getEmptyState) {
            $ctrl.getEmptyState = getEmptyState;
        }

        if (!$ctrl.share) {
            $ctrl.share = share;
        }

        if (!$ctrl.isNotEmptyGroupState) {
            $ctrl.isNotEmptyGroupState = isNotEmptyGroupState;
        }

        $ctrl.goToCalendar = goToCalendar;
        $ctrl.getListNavShare = getListNavShare;

        $ctrl.onInit = onInit;
        $ctrl.onDestroy = onDestroy;

        if(! constantsService){
            console.warn('parent for CalendarPageInitCtrlService must define  constantsService');
        }
        if(!$ctrl.getPageTemplate){
            console.warn('parent for CalendarPageInitCtrlService must define $ctrl.getPageTemplate');
        }

        $ctrl = new PageSimpleInitCtrlService($ctrl, $ctrl.$element, {
            constantsService: _.extend({}, constantsService),

            otherOptions:{
                compOptions: otherCompOptions
            }
        });

        return $ctrl;

        function onInit() {
            $ctrl.listField = $ctrl.CPS.SBStateService.getCurrentStateData().listField;

            var stateParams = $ctrl.CPS.stateParams;
            var calendarId = $ctrl.CPS.getSearchFilter($ctrl.listField); //calendarId = >for backwards compatibility
            if(calendarId){
                $ctrl.CPS.setSearchFilter(null, $ctrl.listField);//'calendarId
            }else{
                calendarId = stateParams ? stateParams[$ctrl.listField] : null;
            }
            $ctrl.calendarId = calendarId;
            $ctrl.dontNotify = true;
            $ctrl.topNavApi = TopNavCalendarService;
            $ctrl.ScaleOptions = $ctrl.topNavApi.ScaleOptions.map(function (item){
                item.text = $ctrl.CPS.capitalizeFirst(item.value);
                return item;
            });

            $ctrl.topNavApi.canDrawTasks = $ctrl.canEdit;
            $ctrl.topNavApi.canEdit = $ctrl.canEdit;

            $ctrl = new ListInitService($ctrl, {
                $element: $element,
                list: new CalendarsPagination(1000, ['name', 'order', 'isDefault', 'productId']),
                preloadAll: true,
                withProperty : getParams,
                getNew: getNew,
                onAllLoaded: onAllLoaded
            });

            $ctrl.formHolder = {};
            $ctrl.confirmRemove = false;
            $ctrl.selected = null;

            //should come from list
            $ctrl.duplicate = duplicate;
            $ctrl.create = create;
            $ctrl.setEdit = setEdit;
            $ctrl.isEdit = isEdit;
            $ctrl.isDefault = isDefault;
            $ctrl.setConfirmRemove = setConfirmRemove;
            $ctrl.isConfirmRemove = isConfirmRemove;
            $ctrl.rename = rename;
            $ctrl.escapeRename = escapeRename;
            $ctrl.removeItem = removeItem;
            $ctrl.makeCurrent = makeCurrent;

            $ctrl.saveTemplate = saveTemplate;
            $ctrl.setOption = setOption;
            $ctrl.setViewType = setViewType;
            $ctrl.isViewType = isViewType;
            $ctrl.showSidebar = showSidebar;
            $ctrl.changeWorkingDay = changeWorkingDay;
            $ctrl.changeZoom = changeZoom;
            $ctrl.toggleDependencies = toggleDependencies;

            $ctrl.topNavApi.onCalendarRendered = onCalendarRendered;

            $ctrl.TodoColumnsConfigsService.getTodoColumnsForProductAsync($ctrl.CPS.companyId, $ctrl.CPS.productId, function (todoColumns) {
                $ctrl.Settings = {};
                $ctrl.todoColumns = todoColumns;
                $ctrl.Settings.todoColumns = $ctrl.todoColumns;
                $ctrl.team = $ctrl.RouteCollaboratorsService.getProjectTeam($ctrl.CPS.product);
                $ctrl.Settings.team = $ctrl.team;

                $ctrl.onSimplePageInit({}, onLoaded);
            });
        }
        function onLoaded() {
            $ctrl.getAll();
            if ($ctrl.canEdit) {
                $ctrl.addRootWatcher('ADDED_CALENDAR_ITEM', onAddedCalendar);
                $ctrl.addRootWatcher('ADD_FROM_PAGE_TOP_' + $ctrl.elemType, onAddFromTop);
            }
        }

        function isDefault(item){return item.isDefault === true;}

        function goToCalendar(calendarId) {
            return $ctrl.CPS.transitionTo($ctrl.SBStateService.getCurrentStateName(), $ctrl.CPS.currentPathParams({
                calendarId: calendarId,
                productId: $ctrl.CPS.productId,
                role: $ctrl.CPS.isCollaborator ? $ctrl.CPS.rolePaths.collabPath : $ctrl.CPS.rolePaths.currentUserPath
            }), {
                reload: false,
                notify: false,
                location: true
            });
        }

        function isNotEmptyGroupState() {
            return true;
        }

        function share(type, e) {
            if ($ctrl.selectedCalendar) {
                $ctrl.RouteCollaboratorsService.share($ctrl.selectedCalendar._id, {
                    type: $ctrl.itemTitle,
                    name: $ctrl.selectedCalendar.name
                }, $ctrl.compOptions, null, e );
            }
        }

        function getEmptyState(){
            return '<div class="empty-state-wrapper with-side-margin with-margin-top">' + $ctrl.getEmptyStateInit() + '</div>';
        }

        function reload(){
            $ctrl.reloadPageTemplate(false, onPageLoaded);
        }

        function onAllLoaded() {
            console.log('onAllLoaded');
            $ctrl.isAllLoaded = true;

            var defaultId, isSelected, selected = null;
            for (var i = 0; i < $ctrl.list.items.length; i++) {
                var el = $ctrl.list.getElementByIndex(i), id = el._id;
                if ($ctrl.calendarId === id) {
                    selected = el;
                    isSelected = true;
                } else if (el.isDefault) {
                    defaultId = el;
                }
            }
            if (!isSelected) {
                selected = defaultId ? defaultId : $ctrl.list.getElementByIndex(0);
            }
            $ctrl.selectCalendar(selected);
            closeFilters();
            reload();
        }

        function onPageLoaded() {
            if(!$ctrl.isAllLoaded ){return;}

            bind(true);

            if(typeof($ctrl.onPageLoadedOther) === 'function') {
                $ctrl.onPageLoadedOther();
            }
        }

        function onDestroy() {
            bind(false);
            $ctrl.onSimplePageDestroy();
        }

        function onAddFromTop(result) {
            console.log('ADD_FROM_PAGE_TOP_' + $ctrl.elemType);
            $ctrl.create(null, null, null, null, null, result.e);
        }

        function showSidebar() {
            console.log('showSidebar');
        }

        function bind(isBind) {
            if(!$ctrl.onCalendars){
                $ctrl.onCalendars = function (e) {
                    var t = $(e.target);
                    if (!t.hasClass('with-click') || t.parents('.with-click').length > 0) {
                        $ctrl.preventDefault(e);
                        t.parents('.calendars-dropdown').addClass('open');
                    }
                };
            }
            bindBody('.dropdown-menu.calendars', $ctrl.onCalendars);

            if(!$ctrl.onCalendarSettings){
                $ctrl.onCalendarSettings = function (e) {
                    var t = $(e.target);
                    $ctrl.preventDefault(e);
                    t.parents('.calendars-settings-dropdown').addClass('open');
                };
            }

            bindBody('.dropdown-menu.calendars-settings', $ctrl.onCalendarSettings);

            function bindBody(elCls, method) {
                angular.element($ctrl.LCS.bodyElement)[isBind ? 'on' : 'off']($ctrl.LCS.clickEvent + '.calendars', elCls, method);
            }
        }

        function onCalendarRendered() {
            console.log('Gantt is fully rendered in browser');
            $ctrl.broadcastRoot('START_INTRO');
        }

        function getParams() {
            var params = {
                companyId: $ctrl.CPS.companyId
            };
            if ($ctrl.isOnProduct) {
                params.productId = $ctrl.CPS.productId;
            }

            return params;
        }

        function getNew() {
            var params = $ctrl.getParams();
            params.order = $ctrl.list.getNewItemOrder();
            return $ctrl.service.convertResource(params);
        }

        function closeFilters() {
           // $ctrl.BlocksSetupService.toggleComments(false);
        }

        function isSelectedCalendar(item) {
            return item && item._id === $ctrl.selectedCalendarId;
        }

        function selectCalendar(item) {
            if (!$ctrl.selectedCalendarId && item || $ctrl.selectedCalendarId && (!item || item && $ctrl.selectedCalendarId !== item._id)) {
                $ctrl.selectedCalendar = item;
                $ctrl.selectedCalendarId = item ? item._id : null;
                $ctrl.goToCalendar($ctrl.selectedCalendarId);

                $ctrl.listTreeService.active = {
                    selectedListId: $ctrl.selectedCalendarId,
                    selectedList: $ctrl.selectedCalendar
                }
            }
        }

        function getListsCount(){
            return $ctrl.list.totalCount;
        }

        function create(type, e) {
            return $ctrl.createNew('create', $ctrl.quotaTypeList, null,
                _.extend({}, {e: e}, typeof ($ctrl.getNewPopupParams) ? $ctrl.getNewPopupParams() : null),
                $ctrl.maxFreeListsCount);
        }

        function duplicate(e, item) {
            //$ctrl.preventDefault(e);

            var extraParam = {
                calendarId: item._id,
                service: $ctrl.service
            };

            var maxAddedcount = 1,
                maxFree = $ctrl.maxFreeListsCount;
            $ctrl.CPS.loadQuotaPopup($ctrl.quotaTypeList, process, maxFree, maxFree === 0 ? 0 : (getListsCount()) + maxAddedcount, $ctrl.compOptions, {e:e});

            function process() {
                $ctrl.popupsService.open(getItem(), $ctrl.popupsService.operations.duplicateCalendar, extraParam, $ctrl.compOptions);

                function getItem() {
                    var newitem = $ctrl.getNew();
                    newitem.order = $ctrl.list.getNewItemOrder();
                    newitem.companyId = $ctrl.CPS.companyId;
                    newitem.productId = item.productId;
                    return newitem;
                }
            }
        }

        function setEdit(e, item, val) {
            $ctrl.preventDefault(e);
            item.isEdit = val === true;
        }

        function isEdit(item) {
            return item.isEdit === true;
        }

        function setConfirmRemove(e, item, val) {
            $ctrl.preventDefault(e);
            $ctrl.confirmRemove = val ? item._id : false;
        }

        function isConfirmRemove(item) {
            return item._id === $ctrl.confirmRemove;
        }

        function rename(e, item) {
            $ctrl.preventDefault(e);

            if($ctrl.isUpdating){return;}
            $ctrl.formHolder['form' + item._id + '_attempted'] = true;
            var form = $ctrl.formHolder['form' + item._id];
            if (!form || !form.$valid) {return;}

            $ctrl.isUpdating = true;

            $ctrl.service.update({
                _id: item._id,
                name: item.name
            }, onsuccess, onerror);

            function onsuccess(result) {
                $ctrl.isUpdating = false;
                $ctrl.Angularytics.trackEvent(null, $ctrl.itemTitle + ' Renamed', {event_value: item._id});

                // $ctrl.list.items[index].name  = el.name ;
                item.isEdit = false;
            }
            function onerror(error) {
                $ctrl.isUpdating = false;
                $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.calendar.Edit.error', 'error');
            }
        }

        function escapeRename(e, item) {
            $ctrl.preventDefault(e);
            item.isEdit = false;
        }

        function removeItem(e, item) {
            $ctrl.preventDefault(e);
            $ctrl.error = null;
            var isDefault = item.isDefault,
                name = item.name;
            $ctrl.service.delete(item, onsuccess, onerror);

            function onsuccess(el) {
                if (el.item) {
                    el = el.item;
                }

                if ($ctrl.list && $ctrl.list.items) {
                    $ctrl.list.removeElement(el);

                    var selected = $ctrl.list.items && $ctrl.list.items.length > 0 ? $ctrl.list.getElementByIndex(0) : null;
                    if (isDefault && selected) {
                        $ctrl.makeCurrent(null, selected, true, function () {
                            $ctrl.selectCalendar(selected);
                            if ($ctrl.list.items.length === 0) {
                                closeFilters();
                                reload();
                            }
                        });
                    }

                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.calendar.Remove.success', 'success', {name: name});
                }

                $ctrl.confirmRemove = false;
            }

            function onerror(err) {
                $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.calendar.Remove.error', 'error');
            }
        }

        function saveTemplate(data, e) {
            $ctrl.CPS.loadQuotaPopup($ctrl.quotaTypeGroups, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e})
            function process() {
                $ctrl.topNavApi.saveTemplate($ctrl.CPS.productId);
            }
        }

        function setOption(id, result) {
            return $ctrl.topNavApi.setViewType(id, result.selected.val);
        }

        function setViewType(id) {
            $ctrl.topNavApi.setViewType(id);
        }

        function toggleDependencies(id, e){
            process();
           // $ctrl.CPS.loadQuotaPopup($ctrl.quotaTypeGroups, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}));
            function process() {
                console.log('toggleDependencies');
                var isEnabled = $ctrl.topNavApi.setViewType(id);
                var checkbox = e.currentTarget.querySelector('input');
                if (checkbox) {
                    if (isEnabled) {
                        checkbox.setAttribute('checked', 'checked');
                    } else {
                        checkbox.removeAttribute('checked');
                    }
                }
            }
        }

        function isViewType(id) {
            return $ctrl.topNavApi.isViewType(id);
        }

        function makeCurrent(e, item, withoutNotification, onsuccess) {
            $ctrl.service.makeCurrent({
                calendarId: item._id,
                productId: $ctrl.CPS.productId,
                companyId: $ctrl.CPS.companyId
            }, function (result) {
                var updated = result && result.item && result.item._id === item._id ? result.item : null;
                var changed = updated ? updated.isDefault : false;
                if(changed) {
                    $ctrl.topNavApi.clearTaskFilters();
                    resetCalendars(updated);
                    //$ctrl.list.replaceElement(updated);
                    if (onsuccess) {
                        onsuccess();
                    }
                    if (!withoutNotification) {
                        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.calendar.makeCurrent.success', 'success', {name: item.name});
                    }
                }
            }, function (err) {
                $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.calendar.makeCurrent.error', 'error', {name: item.name});
            });
        }

        function onAddedCalendar(result) {
            console.log('ADDED_CALENDAR_ITEM');
            var item = result.item;
            if (item) {
                item = $ctrl.service.convertResource(item);
                $ctrl.list.insertElement(item, false);
                $ctrl.selectCalendar(item);
            }
        }

        function changeWorkingDay(id, e) {
            if (typeof (id) === 'string') {
                id = parseInt(id, 10);
            }
            var wasSet = $ctrl.topNavApi.isWorkingDay(id);
            $ctrl.topNavApi.changeWorkingDay(id);

             var checkbox = e.currentTarget.querySelector('input');
            if (checkbox) {
                if (wasSet) {
                    checkbox.removeAttribute('checked');
                } else {
                    checkbox.setAttribute('checked', 'checked');
                }
            }
        }


        function resetCalendars(el) {
            for (var i = 0; i < $ctrl.list.items.length; i++) {
                //$ctrl.list.items[i].isDefault = el._id === $ctrl.list.items[i]._id;
                var item = $ctrl.list.getElementByIndex(i);
               $ctrl.replaceElementProps(item._id, {isDefault: el._id === item._id});
            }
        }

        function getTopFilters() {
      /*/'<a data-type="toggleInnerSidebar" class="btn btn-small primary-faded without-text pull-left with-margin-right">' +
      $ctrl.LCS.getISBDiv('sidebar-filled', 2) +
              </a>' + */
    return '<div ng-show="$ctrl.selectedCalendarId" class="pull-left">' +
                getCalendarsDrp() +
                '<span class="left-separator hide-ipad text-info-count with-line-height pull-left hide-ipad ' +($ctrl.moreFilterButtons ? 'with-margin-left' :'' )+ '">{{$ctrl.topNavApi.tasksCount}} event{{$ctrl.topNavApi.tasksCount ===1?\'\':\'s\'}} </span>' +
            '</div>' +

            '<div ng-show="$ctrl.selectedCalendarId" class="pull-right">' +
                getListNavComments() +
                '<button class="pull-left btn btn-small filtersx white" ng-if="$ctrl.topNavApi.hasTaskFilters()" ng-click="$ctrl.topNavApi.clearTaskFilters()">' +
                    $ctrl.LCS.getISBDiv('filter', 2, 'pull-left')+' Filtering is on '+$ctrl.LCS.getISBDiv('cancel', 2, 'pull-right')+
                '</button>' +
                '<div class="with-margin-left pull-left col90 hide-ipad drpScale">' + getScaleOptions() + '</div>' +
               // getZoomDrp('inline-block pull-left padding-left20') +
                getMoreButtons() +
                $ctrl.getListNavComments() +
               // $ctrl.getListNavShare() +
                getSettingsDrp () +
                getMoreMenuLinks() +
            '</div>'
        }

        function getListNavComments() {
            var isPage = false;
            return getBtn('filters', isPage) +
                ($ctrl.CPS.productId ? (
                    ($ctrl.CPS.isAuthenticated ? getBtn('archived', isPage) : '')
                    //+ getBtn('comments', isPage)
                ) : '');

            function getBtn(type, isPage) {
                return '<comments-button type="' + type + '" btn-cls="btn btn-small primary-faded without-text with-margin-left pull-right" page="' + isPage + '"></comments-button>';
            }
        }

        function isActiveGroup(){
            return true;
        }

        function getListNavShare() {
            if(!$ctrl.showShareInListNav || !$ctrl.CPS.productId){return '';}
            return '<a ng-show="$ctrl.selectedCalendarId" id="btnSh" class="'+$ctrl.getBtnActionCls()+' btn btn-small primary-faded without-text with-margin-left pull-right" data-type="share" analytics-on analytics-action="Open Share" tooltip="Share '+$ctrl.itemTitle+'" tooltip-placement="bottom">' +
                $ctrl.LCS.getISBDiv('link', 2, 'centered gray') + '</a>';
        }

        function getScaleOptions() {
return '<sb-dropdown without-close="true" c-class-attr="hover-underline opendrp text-right" item-clss="capitalize" drp-class-attr="fancy-scrollbar vertical scaleDrp" field-class="selected selected-text text-right capitalize hover-underline" init-list="::$ctrl.ScaleOptions" value="$ctrl.topNavApi.scale" item-label="text" item-value="value" on-change="$ctrl.setOption(3, result)"></sb-dropdown>';
        }

        function getMoreButtons() {
            return ''; //hide create new

            if(!$ctrl.canEdit || !$ctrl.CPS.productId){return '';}

return '<a ng-show="$ctrl.list.items.length>0" class="btn btn-small primary with-margin-right pull-left with-margin-left '+
            ($ctrl.pageClass ? $ctrl.pageClass :'') + ' ' +  $ctrl.getBtnActionCls() +
    +'" data-type="create" analytics-on analytics-action="Add Calendar">' +
    $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left') +
    ' <span class="hide-ipad">New '+$ctrl.itemTitle+'</span></a>' ;
        }

        function getMoreMenuLinks() {
            if(!$ctrl.canEdit || !$ctrl.CPS.productId){return '';}
            var btncls = $ctrl.getBtnActionCls();
    return '<div dropdown class="pull-left position-relative one-line-tooltip more-drp dropdown dropdown-wrapper" ng-show="$ctrl.list.items.length>0">' +
                '<button id="btnSettings" type="button" class="btn btn-small primary-faded without-text dropdown-toggle with-margin-left" dropdown-toggle tooltip="More" tooltip-placement="bottom" analytics-on analytics-action="More Settings">'+$ctrl.LCS.getISBDiv('horizontal-dots', 3, 'centered')+'</button>' +
                '<div class="dropdown-menu side-menu fadeInDownLeft calendar-more" role="menu">' +
                    '<ul class="listitems-selector with-checked">' +
                        '<li ng-show="$ctrl.list.items.length>0">' +
                            '<a class="'+btncls+' fixed-layout table-div" id="btnCalendarTemplate"' + ' data-type="saveTemplate" analytics-on analytics-action="Save Calendar Template">' +
                                '<div class="col30 with-margin-right">'+$ctrl.LCS.getISBDiv('calendar-template', 2)+'</div>' +
                                '<div><div class="with-ellipsis">Save As Template</div></div>' +
                            '</a>' +
                        '</li>' +
                        '<li ng-show="$ctrl.list.items.length>0">' +
                            '<a class="'+btncls+' fixed-layout table-div" id="btnExpand" data-type="setViewType" data-info="4" analytics-on analytics-action="Toggle Collapse">' +
                                '<div class="col30 with-margin-right"><div class="sbf" ng-class="{true:\'cal-expand\',false:\'cal-collapse\'}[$ctrl.isViewType(4, $ctrl.CPS.productId)]">'+$ctrl.LCS.getISBPath(2)+'</div></div>' +
                                '<div><div class="with-ellipsis" ng-bind-html="$ctrl.isViewType(4, $ctrl.CPS.productId)?\'Expand\':\'Collapse\'"></div></div>' +
                            '</a>' +
                        '</li>' +
                       // '<print-button-li></print-button-li>' +
                    '</ul>' +
                '</div>' +
            '</div>';

            /* '<a id="btnExpand" class="btn btn-small primary-faded without-text sbf with-margin-left hide-ipad" ng-class="{true:\'cal-expand\',false:\'cal-collapse\'}[$ctrl.isViewType(4, $ctrl.CPS.productId)]" ng-click="$ctrl.setViewType($event, 4)" analytics-on analytics-action="Toggle Collapse" tooltip="{{$ctrl.isViewType(4, $ctrl.CPS.productId)?\'Expand\':\'Collapse\'}}" tooltip-placement="bottom"></a>'*/
        }

        function getZoomDrp(cls) {
            var el = '';
            _.each($ctrl.topNavApi.Zooms, function (item) {
                el += '<div tooltip-placement="bottom" tooltip="' + item.name + '">' +
                    '<a class="'+$ctrl.getBtnActionCls()+' inline-block" data-info="' + item.id + '" data-type="changeZoom" analytics-on analytics-action="' + item.name + '">' + $ctrl.LCS.getISBDiv(item.icon, 2) + '</a>' +
                    '</div>';
            });
            return '<div class="viewZoomButtons one-line-tooltip ' + (cls || '') + '">' + el + '</div>';
        }

        function changeZoom(id){
            $ctrl.topNavApi.changeZoom(id);
        }

        function getCalendarsDrp () {
            if (!$ctrl.isOnProduct) {
                return '<div class="pull-left title with-margin-right">All Active Projects</div>';
               // ($ctrl.isOnProduct ? '{{$ctrl.selectedCalendar.name}}' : 'All Active Projects')+
            }else if($ctrl.CPS.isCollaborator){
                return '<div class="pull-left title with-margin-right" ng-bind="$ctrl.selectedCalendar.name|truncate:$ctrl.LCS.isMobileSize?10:70"></div>';
            }

return '<div dropdown class="dropdown-wrapper dropdown-wrapper calendars-dropdown one-line-tooltip inline-block position-relative pull-left">' +
            '<button id="btnCalendars" type="button" class="btn btn-small without-text transparent noborder dropdown-toggle semibold with-margin-right pull-left dropdown-toggle" dropdown-toggle>' +
                '<span ng-bind="$ctrl.selectedCalendar.name|truncate:$ctrl.LCS.isMobileSize?10:70"></span> ' +
                $ctrl.LCS.getISBDiv('arrow-filled-down', 2, 'pull-right') +
            '</button>' +
            '<div class="dropdown-menu side-menu fadeInDownLeft selectabledropdown calendars calendars-list" role="menu">' +
                '<div>' +
                    '<div class="column">' + //show-scrollbar-on-hover
                        '<div class="header">Calendars</div>' +
                        '<div class="version-rows" ng-if="$ctrl.list.items.length>0" ng-class="{\'fancy-scrollbar vertical with-fixed-height\':$ctrl.list.items.length>3}">' +
                            '<div class="version-row centering action-buttons-trigger" ng-class="{\'with-border-bottom\':$index!=list.items.length-1, \'active\':$ctrl.isSelectedCalendar(item)}" ng-repeat="item in $ctrl.list.items track by item._id">' +
                                '<div ng-if="!$ctrl.isEdit(item)" class="file table-div full-width">' +
                                    '<div class="default-pin centered with-click" ng-show="$ctrl.isDefault(item)" ng-click="$ctrl.selectCalendar(item)">'+$ctrl.LCS.getISBDiv('default-filled', 2)+'</div>' +
                                    '<div ng-bind="::item.name|truncate:$ctrl.LCS.isMobileSize?20:30" class="name centered with-click" ng-click="$ctrl.selectCalendar(item, $event)" data-type="selectCalendar" ></div>' +
                                    ($ctrl.canEdit ? ('<div class="col130 action-buttons centered text-right">' +
                                            setBtn('makeCurrent', 'bulletini', false, true) +
                                            setBtn('duplicate', 'copy', false, false) +
                                            setBtn('setEdit', 'pencil', true, false) +
                                            setBtn('setConfirmRemove', 'trash', true, false) +
                                    '</div>'):'') +
                                '</div>' +
                                '<form ng-if="$ctrl.isEdit(item)" name="$ctrl.formHolder.form{{::item._id}}" class="file table-div centered full-width" novalidate>' +
                                    '<div class="text-center white thinner">' +
                                        '<input placeholder="Calendar Name…" class="form-control with-underline" id="name{{::item._id}}" name="name{{::item._id}}" type="text" ng-model="item.name" ui-keyup="{\'esc\':\'$ctrl.escapeRename($event, item)\',\'enter\':\'$ctrl.rename($event, item)\'}" ui-focus="true" ng-blur="$ctrl.rename($event, item)"/>' +
                                        '<div ng-show="($ctrl.formHolderItem.formItem.name.$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem.formItem.name.$error.required" class="help-inline ng-hide text-left">Calendar name is required.</div>' +
                                        '<div ng-if="$ctrl.showError(\'name\',\'duplicate\')" class="help-inline with-relative" ng-bind="$ctrl.formHolder[\'form\' + item._id][\'name\' + item._id].$error.duplicate"></div>' +
                                    '</div>' +
                                    '<div class="padding-left10 col60">' +
                                        '<button style="min-width: 60px" type="submit" class="col60 btn primary smallbtn pull-left small-btns" ng-click="$ctrl.rename($event, item)">Save</button>' +
                                    '</div>' +
                                '</form>' +
                                ($ctrl.canEdit ? ('<div class="layer" ng-show="$ctrl.isConfirmRemove(item)">' +
                                    '<div class="text-center white font-size-11">Are you sure you want to remove this calendar?</div>' +
                                    '<div class="text-center padding-top-10">' +
                                        '<a class="margin-right-20" ng-click="$ctrl.removeItem($event, item)" '+getAnalytics('Remove  ' + $ctrl.itemTitle, true)+'>Remove</a>' +
                                        '<a ng-click="$ctrl.setConfirmRemove($event, item, false)">Cancel</a>' +
                                    '</div>' +
                                '</div>'):'') +
                            '</div>' +
                        '</div>' +
                        ($ctrl.canEdit ? ('<div class="table-div list-item new-calendar">' +
                            '<div class="centered"><buttom type="button" class="btn btn-small primary-faded col130 ' +$ctrl.getBtnActionCls()+ '" data-type="create" analytics-on analytics-action="Add Calendar">' +
                            $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left with-margin-right') +
                            ' <div>Add Calendar</div></buttom></div>' +
                        '</div>'):'') +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</div>';
        //'<a id="btnRemoveAll" class="btn btn-small without-text with-margin-right" ng-click="removeItem()" analytics-action="Remove Calendar" tooltip="Remove Calendar" tooltip-placement="bottom">'+$ctrl.LCS.getISBDiv('trash', 2)+'</a>'

            function setBtn(m, icon,hasTrue, isDefault){
                return '<div ' + (isDefault ? 'ng-hide="$ctrl.isDefault(item)" ' : '') + ' class="with-margin-left action-icon-transparent" ng-click="$ctrl.' + m + '($event, item'+(hasTrue ? ', true':'')+')" data-type="' + m + '" analytics-on analytics-action="' + icon + '"' + '>' + $ctrl.LCS.getISBDiv(icon, 2) + '</div>';
            }
        }


        function getAnalytics(a, isLink){
            return 'analytics-on analytics-action="' + a + '" ' + (isLink ? ' analytics-label="sb_link" ' : '');
        }
        function getSettingsDrp() {
    return '<div dropdown class="dropdown-wrapper dropdown display-inline position-relative calendars-settings-dropdown one-line-tooltip">' +
            '<button id="btnLayout" type="button" class="btn btn-small primary-faded without-text with-margin-left dropdown-toggle" dropdown-toggle tooltip="Display Options" tooltip-placement="bottom">'+$ctrl.LCS.getISBDiv('cog', 2)+'</button>' +
            '<div class="dropdown-menu side-menu fadeInDownLeft selectabledropdown full-width calendars-settings display-options" role="menu">' +
                '<div class="calendar-display-options">' +
                    '<div class="column">' +
                        '<div class="header">Display Options</div>' +

                        '<div class="table-div full-width">' +
                            '<div class="name centered">Working days</div>' +
                            getWorkingDays('col170 centered') +
                        '</div>' +

                        getDisplayOptions() +

                        '<div class="table-div full-width with-border-top hide-desktop hide-print">' +
                            '<div class="name centered">Scale</div>' +
                            '<div class="centered text-right">' + getScaleOptions() + '</div>' +
                        '</div>' +

                        '<div class="table-div full-width with-border-top hide-ipad">' +
                            '<div class="name centered">Zoom</div>' +
                            '<div class="centered text-right">' + getZoomDrp() + '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</div>';
        }

        function getDisplayOptions(){
            var el = '';

            _.each($ctrl.topNavApi.DisplayOptions, function(item, i){
            el += '<div class="table-div full-width with-border-top">' +
                    '<div class="name centered"><span class="line-height36"' + (item.tooltip? (' tooltip="'+item.tooltip+'" tooltip-placement="top"') : '') + '>' + item.name + '</span></div>' +
                    '<div class="centered">' +
                        (item.type === 0 ? ('<div class="'+$ctrl.getBtnActionCls()+' pull-right custom-checkbox" data-type="' + (item.action? item.action : 'setViewType') + '" data-info="' + item._id + '"><label class="i-switch"><input type="checkbox" ng-checked="$ctrl.isViewType('+item._id+')"><i></i></label></div>') : ('<sb-dropdown drp-menu-cls="col150" c-class-attr="without-underline" item-class="capitalize" drp-class-attr="fancy-scrollbar vertical" field-class="selected selected-text text-right capitalize" init-list="::$ctrl.topNavApi.DisplayOptions[' + i + '].options" value=":: $ctrl.topNavApi[\''+item.prop+'\']" item-label="name" item-value="value" on-change="$ctrl.setOption(' + item._id + ', result)"></sb-dropdown>')) +
                    '</div>' +
                '</div>';
            });

            return el;
        }

        function getWorkingDays(cls, weekDays) {
            var el = '';
            _.each($ctrl.topNavApi.WeekDays, function (day) {
                el += '<div class="' + $ctrl.getBtnActionCls() + ' inrow inline-block col24 custom-checkbox" data-type="changeWorkingDay" data-info="' + day.value + '"><label class="text-center"><input type="checkbox"' + ($ctrl.topNavApi.isWorkingDay(day.value) ? ' checked="checked"' : '') + '><span></span><div class="txt">' + day.name + '</div></label></div>';
            });
            return '<div class="drpWorkingDays ' + (cls || '') + ' ">' + el + '</div>';
        }
    }
}

