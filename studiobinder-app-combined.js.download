function UserDepartmentsRouting($uiRouter) {
    var listField = 'depId',
        overviewBlockType = 'departments',
        params = {};

    params[listField] = {
        value: null,
        dynamic: true
    };

    addStates($uiRouter, [{
        name: 'user.' + overviewBlockType,
        data: {
            bodyClass: 'departments groups-tree-page with-tree with-printable-list',
            title: 'Company Departments',

            overviewBlockType: overviewBlockType,
        },
        views: {
            loggedview: 'userDepartmentsPage'
        },
        params: params,
        url: '/departments/:' + listField + '?filter&active',
        reloadOnSearch: false
    }]);
}

