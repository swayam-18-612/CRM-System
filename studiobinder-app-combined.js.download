])
.constant('ProductsPageCtrlServiceInjectors', {
    pageCtrlService: 'PageTreeSimpleCtrlService',
    constantsService: 'ProductConstantsService',
    listsService: 'ProductsListsService',
    service: 'ProductsService'
})
.service('ProductsPageCtrlService', ProductsPageCtrlService);
ProductsPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'ProductsPageCtrlServiceInjectors'];
function ProductsPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    console.log('ProductsPageCtrlService');
    return function ($ctrl, $element, printPageParams) {
        $ctrl.dynamicWithArchiveGroupAsList = dynamicWithArchiveGroupAsList;
        $ctrl.getParams = getParams;
        $ctrl.isWithSidebar = isWithSidebar;
        $ctrl.showIntro = showIntro;

        //todo
        //$ctrl.getDisplayListCount = getDisplayListCount;

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);

        return $ctrl;

        function showIntro() {
            return false;
        }

        function getParams() {
            return {
                companyId: $ctrl.CPS.companyId,
            };
        }

        function isWithSidebar() {
            return $ctrl.CPS.memberType >= $ctrl.security.MemberTypes.Admin;
        }

        function dynamicWithArchiveGroupAsList() {
            return isWithSidebar();
        }

        function getDisplayListCount() {
            if(isWithSidebar()) {
                return $ctrl.getDisplayListCountInit();
            } else {
                return $ctrl.listTreeService.getDisplayListCount(list ? list : null, isTotal);
                var l = $ctrl.listTreeService.getList((list ? list : $ctrl.listTreeService.active).selectedListId);
                return l ? l.length : 0;
            }
        }
    }
}

