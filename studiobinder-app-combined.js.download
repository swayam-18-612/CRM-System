angular.module('product.callsheet.routing', [
    'product.callsheet.page.view.component',
    'product.callsheet.page.edit.component',
    'product.callsheet.page.preview.component',
    'product.callsheet.confirmationsPage.component'
])
    .config(CallsheetRouting);
CallsheetRouting.$inject = ['$uiRouterProvider'];

function CallsheetRouting($uiRouter) {
    var listField = 'invitationId',
        defParams = {
            pageClass: 'page-class callsheetsPage',
            overviewBlockType: 'callsheets',
            //dragHandleOnTheSide: true,
            //withoutMouseHover:true
        },
        cls = 'callsheet-page ',
        modeField = 'mode';

    addStates($uiRouter, [{
        name: 'user.product.callsheet',
        url: '/callsheets/:callsheetId',
        data: {
            bodyClass: cls + ' edit-mode no-sidebar',
            title: 'Edit Call sheet',
            overviewBlockType: 'callsheets'
        },
        views: {
            bodyWrapper: {
                template: '<div id="bodyCallsheet" ui-view="bodyCallsheet" class="h-full"/>',
            }
        },
        resolve: {
            callsheet: CallSheetParam
        }
    },{
        name: 'user.product.callsheet.confirmations',
        url: '/confirmations',
        data: _.extend({
            bodyClass: 'callsheet-confirmations-page groups-tree-page with-tree with-printable-list',
            title: 'Confirmations',
        }, defParams),
        views: {
            'bodyCallsheet': 'callsheetConfirmationsPage'
        }
    }, {
        name: 'user.product.callsheet.view',
        url: '/view',
        data: _.extend({
            bodyClass: cls + ' view-mode',
            title: 'View',
        }, defParams),
        views: {
            'bodyCallsheet': 'callsheetViewPage'
        }
    }, {
        name: 'user.product.callsheet.edit',
        url: '/edit/:' + modeField,
        data:  _.extend({
            bodyClass: cls + ' view-mode edit-mode no-sidebar',
            title: 'Edit',
            modeField: modeField,
        }, defParams ),
        views: {
            'bodyCallsheet': 'callsheetEditPage'
        },
        params: getParams(),
        reloadOnSearch: false
    },{
        name: 'user.product.callsheet.previewGeneral',
        url: '/preview-general-callsheet/:'+listField,
        data: _.extend({
            bodyClass: cls + ' view-mode no-sidebar preview-general',
            title: 'Preview General Call Sheet',
        }, defParams),
        views: {
            'bodyCallsheet': 'previewGeneralCallsheetPage'
        },
        params: getDownloadId()
    }]);

    function getParams() {
        var p = {};
        p[modeField] = {
            value: 'design',
            dynamic: true
        };
        return p;
    }

    function getDownloadId() {
           var p = {};
        p[listField] = {
            value: null,
            dynamic: true
        };
    return p;
    }
}

CallSheetParam.$inject = ['$transition$', 'CallsheetsService','CurrentProduct', 'CallsheetConstantsService'];
function CallSheetParam($transition$, CallsheetsService, CurrentProduct, CallsheetConstantsService){
    console.log('product.callsheet callsheet param');
    var callsheet = CurrentProduct.getCallsheet();
    var params = $transition$.params(), id = params ? params.callsheetId : null;
    if (!id) {return null;}

    if (callsheet != null && callsheet._id === id) {
        return processInit(callsheet);
    }
    return CallsheetsService.getById(id, 'callsheetSentId templateId', processInit, function (error) {
        if(error){console.log(error);}
        return processInit(null);
    });

    function processInit(callsheet) {
        if (!callsheet) {
            return processChanges(callsheet);
        }
        var t = callsheet.templateId,
            tId = t ? t._id : null,
            changeTemplate, hasChanges;

        var templates = CallsheetConstantsService.Templates;
                            //set template id for old modern callsheet to the standard call sheet
        if (!tId || tId === '56e4db951f34291f252317d7') {
            tId = templates[0]._id;
            changeTemplate = true;
        }
        var template = _.find(templates, function (item) {
            return item._id === tId;
        });

        if (!template) {
            return processChanges(callsheet);
        }

        callsheet.template = template;
        callsheet.templateId = tId;

        if(!callsheet.options){callsheet.options = {};}

        var options = CallsheetConstantsService.TemplateOptions['c_' + tId],
            blocks =  getOptions(options, 'blocks'),
            topSection =  getOptions(options, 'top'),
            styles =  getOptions(options, 'styles');// backwards compatibility

        processHide('hideTalent', 'cast');
        processHide('hideExtras', 'extras');
        processHide('hideClients', 'clients');
        processHide('hideCrew', 'crew');

        _.each( ['locations', 'schedules', 'extras1', 'departmentNotes', 'advancedSchedules', 'files'], processMissing);

        if (!callsheet.options.styles && options && options.styles) {
            callsheet.options.styles = options.styles;
            hasChanges = true;
        }

        var breaks = callsheet.options.breaks;
        if (breaks) {
            var optionsProp = 'blocks';
            if(!callsheet.options[optionsProp]){callsheet.options[optionsProp] = {};}
            for (var prop in breaks) {
                switch (prop) {
                    case 'break1': set('topSection'); break;
                    case 'break2': set('locations'); break;
                    case 'break3': set('schedules'); break;
                    case 'break4': set('clients'); break;
                    case 'break5': set('cast'); break;
                    case 'break6': set('extras1'); break;
                    case 'break7': set('departmentNotes'); break;
                    case 'break8': set('advancedSchedules'); break;
                    case 'break9': set('crew'); break;
                }
                hasChanges = true;
            }
            delete callsheet.options.breaks;

            function set(prop1) {
                if (!callsheet.options[optionsProp][prop1]) {
                    callsheet.options[optionsProp][prop1] = {};
                }
                callsheet.options[optionsProp][prop1].break = breaks[prop] === true;
            }
        }
        if (!hasChanges && !changeTemplate) {
            return processChanges(callsheet);
        }

        var updated = {_id: callsheet._id};
        if(changeTemplate){
            updated.templateId = callsheet.templateId;
        }

        if(changeTemplate){
            updated.options = callsheet.options;
        }

        return CallsheetsService.updateOptions(updated, function (result) {
            return processChanges(callsheet);
        });

        function processHide(hideProp, table){
            if (callsheet.options[hideProp] !== undefined) {
                if (callsheet.options[hideProp]){
                    if(!callsheet.options.blocks){callsheet.options.blocks = {};}
                    if(!callsheet.options.blocks[table] && options && options.blocks && options.blocks[table]) {
                        callsheet.options.blocks[table] = _.extend({}, options.blocks[table]);
                    }
                    callsheet.options.blocks[table].show = false;
                }
                delete callsheet.options[hideProp];
                hasChanges = true;
            }

            processMissing(table);
        }

        function processMissing(table){
            try {
                if (!callsheet.options.blocks[table].columns) {
                    callsheet.options.blocks[table] = _.extend({}, options.blocks[table], callsheet.options.blocks[table]);

                    hasChanges = true;
                }
            }catch (err){}
        }

        function getOptions(options, optionsProp) {
            var blocks = options[optionsProp];// backwards compatibility
            callsheet.template.options = options;
            if (!callsheet.options[optionsProp]) {
                callsheet.options[optionsProp] = blocks;
                hasChanges = true;
            }
            for (var prop in blocks) {
                if (!callsheet.options[optionsProp][prop]) {
                    callsheet.options[optionsProp][prop] = blocks[prop];
                    hasChanges = true;
                }
            }
            return blocks;
        }

        function processChanges(callsheet) {
            CurrentProduct.broadcastCallsheet(callsheet);
            return callsheet;
        }
    }
}

angular.module('product.callsheet.InvitationsBulkAction.controller.service', [
    'apiServices.CallsheetInvitations',
    'product.callsheet.resendInit.controller.service'
])
.service('InvitationsBulkActionPopupCtrlService',InvitationsBulkActionPopupCtrlService);
InvitationsBulkActionPopupCtrlService.$inject = ['ResendCallsheetPopupInitCtrlService', 'CallsheetInvitationsService'];
function InvitationsBulkActionPopupCtrlService(ResendCallsheetPopupInitCtrlService, service) {
    return function ($ctrl, $element) {

        $ctrl.preInitOther = preInitOther;
        $ctrl.postInitOther = postInitOther;

        return new ResendCallsheetPopupInitCtrlService($ctrl, $element);

        function preInitOther() {
            $ctrl.service = service;
            $ctrl.extraParam.service = $ctrl.service;
            $ctrl.refresh = refresh;
            $ctrl.inviteIds = $ctrl.extraParam.inviteIds;
            $ctrl.editType = $ctrl.extraParam.editType;
            $ctrl.callsheetId = $ctrl.extraParam.callsheetId;
            $ctrl.callsheet = angular.copy($ctrl.CurrentProduct.getCallsheet());
            if(!$ctrl.callsheet || $ctrl.callsheetId !== $ctrl.callsheet._id){
                cancel();
                return;
            }

            if ($ctrl.type === 'Resend Selected') {
                $ctrl.send = {
                    sendToAll: false,
                    cc: false,
                    dontSendConfirmToSender: false,
                    resetConf: false,
                    sms: true,
                };

                $ctrl.changes = true;
            }

            $ctrl.defaultTime = $ctrl.callsheet.startDate;

            if(!$ctrl.item) {
                $ctrl.item = {
                    calltime: {
                        isTime: true,
                        value: $ctrl.defaultTime
                    },
                    personalNote: null
                };
            }
        }

        function postInitOther() {
            $ctrl.onSaveCustomize = onSaveCustomize;
            $ctrl.onSaveRemoved = onSaveRemoved;
            $ctrl.onSaveResent = onSaveResent;
            $ctrl.onError = onError;
            $ctrl.cancelPopup = cancelPopup;
            $ctrl.save = save;
        }

        function onSaveCustomize(result) {
            $ctrl.isUpdating = false;
            if (result) {//success
                $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result);

                $ctrl.broadcastRoot('CLEAR_SELECTED_ROWS_' + $ctrl.elemType);

                $ctrl.onClose({result: 'call on success popup'});
            }
        }

        function onSaveRemoved(result) {
            $ctrl.isUpdating = false;
            $ctrl.closePopup(result);
        }

        function onSaveResent(res) {
            $ctrl.broadcastRoot('UPDATE_CALLSHEET_SENT', res.callsheetSent);
            $ctrl.LCS.timeout(process, 5000);

            function process() {
                $ctrl.isUpdating = false;

                if ($ctrl.onClose) {
                    $ctrl.onClose({result: res.invites});
                }
            }
        }

        function onError(error) {
            $ctrl.isUpdating = false;
            $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.callsheetInvitations.' + $ctrl.type + '.error');
        }

        function cancelPopup() {
            $ctrl.refresh();
            if ($ctrl.onClose) {
                $ctrl.onClose({result: 'cancel'});
            }
        }

        function refresh() {
            $ctrl.error = '';
        }

        function save() {
            if($ctrl.isUpdating){return;}

            if (!$ctrl.CPS.productId) {
                $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.callsheetInvitations.error.invalid-product');
                return;
            }

            if (!$ctrl.inviteIds || $ctrl.inviteIds.length === 0) {
                $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.callsheetInvitations.error.invalid-invites');
                return;
            }

            $ctrl.refresh();

            var params = {
                productId: $ctrl.CPS.productId,
                companyId: $ctrl.CPS.companyId,
                callsheetId: $ctrl.callsheetId
            };

            $ctrl.isUpdating = true;

            switch ($ctrl.type) {
                case 'Customize Selected':
                    params.inviteIds = $ctrl.inviteIds.map(function (el) {return el.id;});
                    switch ($ctrl.editType) {
                        case 'calltime':
                            params.item = {calltime: $ctrl.item.calltime};
                            break;
                        case 'personalNote':
                            params.item = {personalNote: $ctrl.item.personalNote};
                            break;
                    }
                    $ctrl.service.customizeRecipientsBulk(params, $ctrl.onSaveCustomize, $ctrl.onError);
                    break;

                case 'Resend Selected':
                    params.inviteIds = $ctrl.inviteIds;
                    $ctrl.service.resendInvitesBulk($ctrl.security.sendGeneratorRequest, $ctrl.send, params, $ctrl.onSaveResent, $ctrl.onError);
                    break;
            }
        }
    }
}

angular.module('product.callsheet.resendCalltimePopup.component', [
