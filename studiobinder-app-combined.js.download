                    '<div class="text-center centering border-bottom border-right">'+ imgCheckYes +'</div>' +
                    '<div class="text-center centering border-bottom">' + imgCheckYes +'</div>' +
                '</div>' +
                '<div class="table-div full-width">' +
                    '<div class=" centering border-bottom border-right">Edit page content</div>' +
                    '<div class="text-center centering border-bottom border-right" style="display:none">'+ imgCheckNo +'</div>' +
                    '<div class="text-center centering border-bottom border-right">'+ imgCheckYes +'</div>' +
                    '<div class="text-center centering border-bottom">' + imgCheckYes +'</div>' +
                '</div>' +
