angular.module('product.documentPage.init.controller.service',[
    'apiServices.Documents',
    'apiServices.DocumentVersions',
    'product.document.sidebar.component',
    'product.document.version.editor.component',
    'product.document.popups',
    'apiConstants.documentFiles.services',
    'product.material.fileStats.service',
    'groupBlock.empty-state.service',
    'product.document.documentCompare.step.component'
])

.service('DocumentPageInitCtrlService', DocumentPageInitCtrlService);
DocumentPageInitCtrlService.$inject = ['DocumentsService','DocumentVersionsService', 'CompInitCtrlService', 'TemplateCompileService', 'PageSimpleInitCtrlService', 'DocumentFileConstantsService', 'FiltersService', 'RouteCollaboratorsService', 'EmptyStateCtrlService'];
function DocumentPageInitCtrlService( service, DocumentVersionsService, CompInitCtrlService, TemplateCompileService, PageSimpleInitCtrlService, DocumentFileConstantsService, FiltersService, RouteCollaboratorsService, EmptyStateCtrlService) {
    console.log('DocumentPageInitCtrlService');
    return function($ctrl, $element, otherOptions) {

        $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
        $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;

        $ctrl.EmptyStateCtrlService = EmptyStateCtrlService;
        $ctrl.DownloadExportService = DownloadExportService;
        $ctrl.DocumentVersionsService = DocumentVersionsService;

        var constantsService = _.extend({}, DocumentFileConstantsService);
        var c = otherOptions ? otherOptions.constantsService : null;
        if(c){
            for(var prop in c){
                var cp = c[prop];
                if(cp){
                    constantsService[prop] = _.extend(constantsService[prop] ? constantsService[prop] : {}, cp);
                }
            }
        }

        $ctrl.documentVersionCls = 'document-version-editor-child';
        $ctrl.titleCls = 'documentTitle';
        $ctrl.service = service;

        $ctrl.$onDestroy = $onDestroy;

        $ctrl = new CompInitCtrlService($ctrl);

        $ctrl.$element = $element;
        $ctrl.element = $ctrl.$element[0];

        $ctrl.isDocument = true;
        //$ctrl.showShareInListNav = true;

        $ctrl.share = share;
        $ctrl.convertResource = convertResource;
        $ctrl.getExtension = $ctrl.DocumentVersionsService.getExtension;
        $ctrl.getColorStyle = $ctrl.DocumentVersionsService.getColorStyle;
        $ctrl.publishScript = publishScript;
        $ctrl.duplicateVersion = duplicateVersion;
        $ctrl.openDownload = openDownload;
        $ctrl.openVersions = openVersions;
        $ctrl.saveDocChanges = saveDocChanges;
        $ctrl.openAutosaveSettings = openAutosaveSettings;
        $ctrl.downloadSBX = downloadSBX;

        $ctrl.doOnFileSaved = doOnFileSaved;
        $ctrl.getPath = getPath;
        $ctrl.openScriptOutline = openScriptOutline;
        $ctrl.getDrpSettings = getDrpSettings;
        $ctrl.onSaveDocEvent = onSaveDocEvent;

        $ctrl.$onInit = $onInit;
        $ctrl.getPageTemplate = getPageTemplate;

        $ctrl.openRenumber = openRenumber;
        $ctrl.openScratchpad = openScratchpad;
        $ctrl.openTitlePage = openTitlePage;

        $ctrl.isScript = isScript;
        $ctrl.openLock = openLock;
        $ctrl.openSync = openSync;
        $ctrl.onSaveVersion = onSaveVersion;
        $ctrl.openCompare = openCompare;
        $ctrl.getSidebarTag = getSidebarTag;
        $ctrl.isWithSidebar = isWithSidebar;
        if(!$ctrl.getBanner) {
            $ctrl.getBanner = getBanner;
        }

        $ctrl.filtersService = new FiltersService(constantsService, null);

        $ctrl.loadDirectory = loadDirectory;

        //for the document page
        if($ctrl.RouteCollaboratorsService.BlocksSetupService.getCurrentTodoPage().parentPageId){
            $ctrl.listTreeService = {
                getNodeById: getNodeById,
                getBreadcrumbs: getBreadcrumbs,
                active: null,
                isForShare: true
            }
            $ctrl.RouteCollaboratorsService.setListTreeService($ctrl.listTreeService);
        }

        $ctrl.Events = {
            AddScriptNotes: 'ADD_SCRIPT_NOTES',
            AddTitlePage: 'ADD_TITLE_PAGE',
            Renamed: 'RENAMED'
        };

        $ctrl = new PageSimpleInitCtrlService($ctrl, $ctrl.$element, {
            constantsService: constantsService,
            otherOptions: otherOptions
        });

        return $ctrl;

        function isWithSidebar() {
            return !$ctrl.hideSidebar && $ctrl.canEdit;
        }

        function getSidebarTag(){
            return 'document-sidebar';
        }

        function getCollabBannerInfo() {
            return {txt: 'Write and share your own ' + getType(true) + ' for free.', campaign: 'collab-' + getType()};
        }

        //todo compare scriptVersions
        function openCompare(e){
            $ctrl.preventDefault(e);
            $ctrl.item.lastSyncedContentId !== $ctrl.item.contentVersionId
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations.scriptCompare, _.extend({
                script: {documentVersionId: $ctrl.item.lastSyncedContentId},
                document: _.extend({}, $ctrl.document, {version: $ctrl.item.contentVersion, versionId: $ctrl.item.contentVersionId}),
                syncChanges: true,
                syncToProject: true
            }, getNotes()), $ctrl.compOptions, null, function (result) {
                console.log('result for onPublishScriptPart2');
                //     $ctrl.isPopupOpened = false;
            });
        }

        function getNodeById(listId) {
            return $ctrl.document;
        }

        function getBreadcrumbs(list) {
            //set it up
            return [];
        }

        function $onInit() {
            if(!$ctrl.isPopup && !$ctrl.isInsideOtherPage){
                $ctrl.getCollabBannerInfo = getCollabBannerInfo;
            }
            if($ctrl.isPopup && $ctrl.extraParam && $ctrl.extraParam.documentId){
                $ctrl.documentId = $ctrl.extraParam.documentId;
            }
            if($ctrl.showCommentsInListNav === undefined) {
                $ctrl.showCommentsInListNav = $ctrl.withDocumentInline === true;
            }
            $ctrl.onSimplePageInit({}, function (){
                $ctrl.setCompOptions(  {
                    title: 'Documents',
                    overviewBlockType: getType()
                });
                reload(true);
            });
        }

        function getType(isTxt) {
            return $ctrl.treeType === 3 ? (isTxt ? 'AV scripts' : 'avscripts') : ($ctrl.treeType === 1 ? 'documents' : 'screenplays');
        }

        function reload(isInit) {
            $ctrl.documentLoaded = false;
            $ctrl.document = undefined;
            if(!$ctrl.documentId){
                return done($ctrl.documentId === undefined);
            }

            async.parallel({
                item: function (c) {
                    $ctrl.service.getById($ctrl.documentId, $ctrl.withDocumentInline ? 'versionId' : null, function (result) {
                        c(null, result);
                    }, function (err) {
                        console.log(err);
                        c(null, null);
                    });
                },
                breadcrumbs: function (c) {
                    $ctrl.service.getBreadcrumbs({
                        id: $ctrl.documentId
                    }, function (result) {
                        c(null, result);
                    }, function (err) {
                        console.log(err);
                        c(null, null);
                    });
                }
            },

            function (err, result) {
                console.log('load document');
                $ctrl.breadcrumbs = result.breadcrumbs || [];

                $ctrl.document = result.item;

                if ($ctrl.document) {
                    $ctrl.treeType = $ctrl.document.type;
                    $ctrl.title = $ctrl.document.name;
                    $ctrl.btnText = 'Import ' + getItemTitle();
                }

                done();
            });

            function done() {
                if (!isInit || !$ctrl.withDocumentInline) {
                    $ctrl.documentLoaded = true;
                }

                $ctrl.reloadPageTemplate(false, function () {
                    if ($ctrl.document && $ctrl.withDocumentInline && $ctrl.document.versionId && $ctrl.document.versionId !== $ctrl.tempDocumentVersionId ) {
                        $ctrl.tempDocumentVersionId = $ctrl.document.versionId;
                        $ctrl.LCS.timeout(function () {
                            loadDocumentVersion($ctrl.document.versionId);
                        }, 300);
                    }
                    onPageLoaded();
                });
            }
        }

        function getItemTitle() {
            return $ctrl.treeType === 3 ? 'AV Script' : ($ctrl.treeType === 1 ? 'Document' : 'Screenplay');
        }

        function getTemplateVersion(){
            if (!$ctrl.templateVersionCompile) {
                $ctrl.templateVersionCompile = new TemplateCompileService(null, getVersionTemplate, $ctrl);
            }
            $ctrl.templateVersionCompile.loadTemplate(function (el) {
                console.log('DocumentPageInitCtrlService.onLoaded');
            }, null, $ctrl.element.querySelector('.' + $ctrl.documentVersionCls));
        }

        function onSaveDocBeforePageChange(result){
            doOnFileSaved(onSuccess);

            function onSuccess(){
                if(result && typeof(result.onSuccess) === 'function'){
                    result.onSuccess();
                }
            }
        }

        function onPageLoaded(){
            console.log('doc page loaded');

            if(!$ctrl.isNotFirst) {
                getTemplateVersion(false);
                if ($ctrl.canEdit) {
                    /*$ctrl.addToRootObserver('hasDocChanges', onBtnDocChanges);
                    $ctrl.addToRootObserver('savingDocChanges', onBtnDocChanges);
                    $ctrl.addToRootObserver('lastDocChanges', onBtnDocChanges);*/

                    $ctrl.addRootWatcher('DOC_CHANGED', onBtnDocChanges);
                    $ctrl.addRootWatcher('SAVE_DOCUMENTTEMPLATE_ITEM', onSaveAsTemplate);
                    $ctrl.addRootWatcher('ADDED_DOCUMENTTEMPLATE_ITEM', onAddedDocumentTemplate);
                    $ctrl.addRootWatcher('SCRIPT_SYNCED_TO_PROJECT', onScriptSyncedToProject);
                    $ctrl.addRootWatcher('PUBLISH_SCRIPT_2', onPublishScriptPart2);
                    $ctrl.addRootWatcher('SAVE_DOC_BEFORE_PAGE_CHANGE_' + $ctrl.SBStateService.getCurrentStateName(), onSaveDocBeforePageChange);

                    if ($ctrl.withDocumentInline) {
                        $ctrl.addRootWatcher('RENAMED_NOTE', onRenamedNote);
                        $ctrl.addRootWatcher('NAME_CHANGED_DOCUMENT_GROUP', onNameChanged);

                        $ctrl.addRootWatcher('UPDATED_DOCUMENTVERSION_ITEM', onDocumentVersionUpdated);

                     }
                    // $ctrl.addRootWatcher($ctrl.Events.AddScriptNotes, onAddScriptNotes);
                    // $ctrl.addRootWatcher($ctrl.Events.AddTitlePage, onAddTitlePage);
                }
                //CHANGE_DOCUMENTVERSION
                $ctrl.addRootWatcher('CHANGE_' + $ctrl.elemType, onChangeDocumentVersion);
                $ctrl.addRootWatcher('UPDATE_FROM_SIDEBAR_' + $ctrl.elemType, onUpdateDocumentVersion);
                $ctrl.addRootWatcher('FILE_CHANGED', onChangeDocument);

                $ctrl.isNotFirst = true;

                if(typeof($ctrl.onPageLoadedOther) === 'function') {
                    $ctrl.onPageLoadedOther();
                }
            }

            if($ctrl.documentLoaded) {
                if($ctrl.canEdit) {
                    unloadSaveBtn();
                    loadSaveBtn();
                }
                bindTitleEvents(false);
                bindTitleEvents(true);

                $ctrl.EmptyStateCtrlService.bind(false);
                if(!$ctrl.documentId){
                    $ctrl.EmptyStateCtrlService.bind(true);
                }
            }
        }

        function onDocumentVersionUpdated(result){
            //onDocumentVersionUpdated;
            //scratchPad titlepage
            var editchanges = $ctrl.item && result && result.editchanges && result.editchanges._id === $ctrl.item._id ? result.editchanges : null;
           if(!editchanges){return;}
            _.each(['scratchPad', 'titlePage'], function (prop){
                if(editchanges.hasOwnProperty(prop)) {
                    $ctrl.item[prop] = editchanges[prop];
                }
            });
        }

        function saveBefore(onSuccess){
            if($ctrl.withDocumentInline){
                doOnFileSaved(onSuccess);
            }else{
                onSuccess();
            }
        }

        function onChangeDocument(result) {
            console.log('onChangeDocument');
            var item = result && result.item ? result.item : result,
                documentId = item ? item._id : null,
                versionId = item ? item.versionId : null;
            if (documentId && documentId !== $ctrl.documentId || !$ctrl.documentLoaded) {
                if(documentId === 'null'){ // set empty state
                    documentId = null;
                    onSuccess();
                } else {
                    saveBefore(onSuccess);
                }
            } else if (!$ctrl.item || $ctrl.item && versionId && versionId !== $ctrl.item._id) {
                loadDocumentVersion(versionId);
            }

            function onSuccess() {
                $ctrl.documentId = documentId;
                reload();
            }
        }

        function onChangeDocumentVersion(id) {
            console.log('onChangeDocumentVersion');
            if (!$ctrl.item || $ctrl.item && id && $ctrl.item._id !== id) {
                doOnFileSaved(onSuccess);
            }

            function onSuccess() {
                loadDocumentVersion(id);
            }
        }
        
        function onUpdateDocumentVersion(changes) {
            console.log('UPDATE_FROM_SIDEBAR_' + $ctrl.elemType);
            if(changes){
                setItem(_.extend($ctrl.item, changes));
            }
        }

        function getDocumentVersion(id, onsuccess, onerror){
            $ctrl.DocumentVersionsService.getById(id, 'contentVersionId createdById materialVersionId', onsuccess, onerror);
        }

        function loadDocumentVersion(id) {!
            console.log('loadDocumentVersion: ' + id);
            if(!id){
                //empty state
                setItem(null);
                return;
            }
            getDocumentVersion(id, initVersion, onError);

            function initVersion(item) {
                var scripts = $ctrl.CurrentProduct.getScripts(),
                    s = scripts && item && item.lastSyncedScriptId ? _.find(scripts, {_id: item.lastSyncedScriptId}) : null;
                setItem(item);
                setSynced(item);
                getTemplateVersion(true);


                $ctrl.LCS[$ctrl.document && $ctrl.document.active ? 'removeClass' : 'addClass'](getBtnSave(), 'sb-hide');

                $ctrl.title = item && item.name ? item.name : ($ctrl.document ? $ctrl.document.name : '');

            }

            function onError(err) {
                console.log(err);
                initVersion(null);
            }
        }

        function setSynced(s){
            var el = $ctrl.element.querySelector('.versionInfo');
            if(!el){return;}
            var summary = s && s.summary ? s.summary.split('|') : null,
                res =  s ? {
                    name: s.name,
                    version: s.version,
                    subversion: s.subversion,
                    notes: s.notes,
                    color: s.color,
                    page: summary && summary.length > 1 ? summary[1] : null,
                    createdBy: s.createdBy,
                    createdAt: s.createdAt,
                } : null;

            $ctrl.LCS[res ? 'removeClass' : 'addClass'](el, 'sb-hide');

            if(res) {
                el.querySelector('.alert .table-div').innerHTML =
                    //'<div class="col50">' + $ctrl.security.getImage(res.createdBy, 'small', 'profilePictureURL', 70) + '</div>' +
                    '<div class="col50 vtop"><span class="mark-version tall" style="margin-top:4px;' + $ctrl.DocumentVersionsService.getColorStyleStr(res) + '">v' + res.version + (res.subversion ? ('.'+res.subversion):'') + '</span></div>' +
                    '<div class="centered">' +
                        //'Revision <span ng-bind="$ctrl.syncedToProject.version"></span>' +
                        //<span className="mark-version" style="' + $ctrl.DocumentVersionsService.getColorStyleStr(res) + '">v' + res.version + (res.subversion ? ('.'+res.subversion):'') + '</span> +
                        '<span class="semibold">' + res.name + '</span> was generated' +
        (res.createdBy ? (' by <span class="semibold">' + res.createdBy.name + '</span> on ' + $ctrl.CPS.getCreatedAt(res.createdAt, 'MMM D @ ' + $ctrl.CPS.timeFormat)) : '') +
                            (res.page ? (' via the <span class="semibold">' + res.page + '</span> page') : '') +
                            (res.notes ? ('<div class="italic gray-light-2 margin-top-4">' + res.notes + '</div>') : '') +
                    '</div>';
            }
        }

        function onSaveDocEvent(e) {
            console.log('onSaveDocEvent from anchor');
            $ctrl.preventDefault(e);
            if ($ctrl.item) {
                $ctrl.saveDocChanges(onSaveDocChanges);
            }
        }

        function onSaveDocChanges(result){
            console.log('onSaveDocChanges: ');
            var item = result ? result.item : null;
            if(item) {
                $ctrl.item.contentVersion = result.contentVersionId;
                setItem(_.extend($ctrl.item, item));
                var document = {
                    _id: $ctrl.item.documentId,
                    version: $ctrl.item,
                    versionId: $ctrl.item._id
                }
                if($ctrl.withDocumentInline){
                    $ctrl.broadcastRoot('DESCCHANGED_' + $ctrl.elemType+ '_ITEM', document);
                }
            }
        }

        function setItem(item){
            console.log('setItem');
            $ctrl.item = item;
            setTime(item);
            //screenplay with no revisions
            $ctrl.isemptystate = $ctrl.document && $ctrl.document.type === 2 && !item ? true : false;

        }

