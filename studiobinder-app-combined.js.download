        {name: 'access-denied', title: 'Access Denied', classx: 'page-not-found'}
    ], function (state) {
        return {
            name:  'public.' + state.name,
            url: state.name,
            views: {
                publicview: 'others'
            },
            data: {
                bodyClass: state.name + ' ' + (state.classx ? state.classx : ''),
