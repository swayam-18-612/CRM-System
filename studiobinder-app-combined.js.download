addMoSePa('TodoPages', 'todoPages', TempTodoPagesService,{
    serviceInjectList:  ['PersistenceService'],
    serviceInjectMod: [
        'services.persistenceService'
    ]
});

function TempTodoPagesService(ApiService, model, PersistenceService) {
     var service = ApiService(model, {
         listType: 'isList'
     });

     var prop = service.collectionName + '_' + fingerprintTimestamp;

     service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
     service.getAllForPreloading = getAllForPreloading;
     service.getTodoPages = getTodoPages;
     service.getTodoPagesList = getTodoPagesList;

     return service;

     function getAllForPreloading(query, pageSize, populate, successcb, errorcb, withoutResourceObject) {
         return successcb(getTodoPagesData());
     }

    function getTodoPages(next) {
         return getTodoPagesData();

        var val = getFromStorage();
        if (val) {
            return onsuccess(val, next);
        }
        service.getAll({deleted: false}, null, null, onSuccess, onError);

        function onSuccess(result) {
            var val = null;
            for (var i = 0; i < result.length; i++) {
                var r = result [i];
                if
                (!val) {
                    val = {};
                }
                val[r.name] = r;
            }
            set(prop, val, next);
        }

        function onError(error) {
            set(prop, null, next);
        }

        function set(prop, val, next) {
            //PersistenceService.set(prop, val);
            return onsuccess(val, next);
        }

        function onsuccess(val, next) {
            return typeof (next) === 'function' ? next(val) : val;
        }
    }

    function getTodoPagesList() {
        var storage = getFromStorage(), list = [];
        for (var prop in storage) {
            list.push(storage[prop]);
        }
        return list;
    }

    function getFromStorage() {
        return PersistenceService.get(prop);
    }

     function getChangedFieldForUpdateOther() {
         return [ 'name', 'order', 'uId', 'text', 'color', 'icon', 'iconLevel', 'hasShare', 'hasComments',
             'hasTasks',  'hasListTasks',
             'hasListComments','url'];
     }

 }


