                {"id": "5a97b2a4436c2c9acc6b5ad2", "value": "Maria Cruiser", "myCustomProperty": "custom value"},
                {"id": "5a97b2a4436c2c9acc6b5ad3", "value": "Pablo Escobeer", "myCustomProperty": "custom value"},
                {"id": "5a97b2a4436c2c9acc6b5ad4", "value": "Richard Schmidt", "myCustomProperty": "custom value"}
            ];

        config.modules.mentions = {
            allowedChars: /^[0-9A-zÀ-ÿØ-ÞΆΈ-ΏΑ-ΫϢϤϦϨϪϬϮϴϷϹϺϽ-Ͽ_]*$/,
            mentionDenotationChars: ["@", "#"],
            dataAttributes: ['myCustomProperty'],
            source: function (searchTerm, renderList, mentionChar) {
                var values;
                if (mentionChar === "@") {
                    values = atValues;
                } else {
                    values = hashValues;
                }
                var l = searchTerm ? searchTerm.length   : 0;
                if (l > 0) {
                    var matches = [], s = searchTerm.toLowerCase(), v;
                    for (var i = 0; i < values.length; i++) {
                        v = values[i];
                        if (v.value.toLowerCase().indexOf(s) !== -1) {
                            matches.push(v);
                        }
                    }
                    renderList(matches, searchTerm);
                } else {
                    renderList(values, searchTerm);
                }
            }
        };

        loadModuleMentions();
    }

