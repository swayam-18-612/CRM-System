CustomizeOverviewBlocksCtrl.$inject = ['CustomizeOverviewBlocksCtrlService', 'TemplateCompileCompCtrlService', '$element'];
function CustomizeOverviewBlocksCtrl (CustomizeOverviewBlocksCtrlService, TemplateCompileCompCtrlService, $element) {
    console.log('CustomizeOverviewBlocksCtrl');
    var $ctrl = this;

    $ctrl.apply = apply;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new CustomizeOverviewBlocksCtrlService(TemplateCompileCompCtrlService, $ctrl, $element);

    function getItemTemplate() {
        return '<div class="btnCustomize one-line-tooltip display-inline dropdown" dropdown auto-close="outsideClick">' +
            '<button type="button" class="btnFeatures btn btn-small primary-faded-gray without-text with-margin-left dropdown-toggle long with-large-padding col170" dropdown-toggle>' +
            $ctrl.LCS.getISBDiv('cog', 2, 'pull-left col20') + '<span class="hide-ipad">Project Features</span>' +
            $ctrl.LCS.getISBDiv('arrow-filled-down', 2, 'pull-right col20 blue') +
            '</button>' +
            '<div class="dropdown-menu side-menu fadeInDownLeft filters-shotlist overview customize wide-tooltip show-scrollbar-on-hover" role="menu" dropdown-menu role="menu" aria-labelledby="btnCustomize">' +
            '<div class="header-small clearfix">Project Features <span tooltip-html="\'Show or hide the project features you<br/> need. This does not affect project data.\'" tooltip-placement="bottom" class="position-relative inline-block with-margin-left sbf info" style="top:4px"></span> </div>' +
            '<ul class="fancy-scrollbar vertical visible-scroll listitems-selector with-checked overview-blocks-selector">' + $ctrl.getBlocks() + '</ul>' +
            '<div class="form-group text-center clearfix last spacing-half-top margin-top-quarter spacing-quarter-bottom">' +
            '<button class="btn primary smallbtn height40 '+ $ctrl.getBtnActionCls() + '" type="button" data-type="apply" analytics-on analytics-action="Update Overview Blocks" ng-disabled="$ctrl.isUpdating==true"> <span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Apply</button>' +
            '</div>' +
            '</div>' +
            '</div>';
    }

    function apply(){
        if($ctrl.onChangeBlocks) {
            $ctrl.onChangeBlocks({ids: $ctrl.overviewBlockIds});
        }
    }
}

angular.module('product.overview.customizeOverviewBlocks.controller.service',[
    'product.overview.productInfoBoxes.service',
    'services.blocksSetup'
]) 
.service('CustomizeOverviewBlocksCtrlService', CustomizeOverviewBlocksCtrlService);
CustomizeOverviewBlocksCtrlService.$inject = ['ProductOverviewBoxesService', 'BlocksSetupService'];
function CustomizeOverviewBlocksCtrlService (ProductOverviewBoxesService, BlocksSetupService) {
    return function (templateCompileCompCtrlService, $ctrl, $element, isPopup) {
        console.log('CustomizeOverviewBlocksCtrlService');

        var activeCls = 'active thick';
        $ctrl.BlocksSetupService = BlocksSetupService;
        $ctrl.ProductOverviewBoxesService = ProductOverviewBoxesService;

        $ctrl.getOverviewBlockIds = $ctrl.ProductOverviewBoxesService.getOverviewBlockIds;
        $ctrl.scriptFeatureId = '58ce8752133efb50dbe0fec9';

        $ctrl.preInit = preInit;

        if(!$ctrl.isBlock) {
            $ctrl.isBlock = isBlock;
        }
        if(!$ctrl.changeBlock) {
            $ctrl.changeBlock = changeBlock;
        }
        $ctrl.getBlockContent = getBlockContent;
        $ctrl.getBlocks = getBlocks;
        $ctrl.initFeaturesByProjectType = initFeaturesByProjectType;

        //GeneralItemEditCtrlService or TemplateCompileCompCtrlService
        $ctrl = new templateCompileCompCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function preInit() {
            if (!$ctrl.overviewBlocks) {
                $ctrl.overviewBlocks = $ctrl.BlocksSetupService.getNonParentBlocks($ctrl.BlocksSetupService.overviewBlocks);
            }
            $ctrl.overviewBlockIds = angular.copy($ctrl.getOverviewBlockIds());
        }

        function getParents(list){
            return _.sortBy($ctrl.BlocksSetupService.getParentBlocks(list, true), 'order').map(function (p){
                p.ch = _.sortBy(_.filter(list, function (item) {
                    return item.parentNavId === p._id;
                }), 'navOrder');

                return p;
            });
        }

        function getBlocks(groupedByParents) {
            if (!groupedByParents) {
                return getA($ctrl.overviewBlocks) +
                    getA($ctrl.customOverviewBlocks);

                function getA(blocks) {
                    return blocks ? _.sortBy(listToArray(blocks), 'order').map(function (item) {
                        return $ctrl.getBlockContent(item);
                    }).join('') : '';
                }
            } else {
                return getParents($ctrl.overviewBlocks).map(function (p) {
                    return p.ch ? ('<ul>' + p.ch.map(function (item) {
                       return getBlockContent(item, true);
                    }).join('') + '</ul>') : '';
                }).join('');
            }
        }

        function listToArray(obj) {
            var l = [];
            for (var id in obj) {
                l.push(obj[id]);
            }
            return l;
        }

        function getBlockContent(item, withoutSwitch) {
            var canBringBack = !item.isSelectable && item.canBringBack,
                isSelectable = item.isSelectable || canBringBack && !withoutSwitch;
            if (!isSelectable) {
                return '';
            }
            var id = item._id, isBlock = $ctrl.isBlock(id),
                cls = isBlock ? activeCls : '';
            return '<li class="' + (canBringBack && !isBlock ? ' sb-hide ' : '') + ($ctrl.groupByFeatures ? cls : '') + '">' +
                '<a class="table-div full-width ' + $ctrl.getBtnActionCls() + ' ' + ($ctrl.groupByFeatures ?  '' : cls) + '" data-type="changeBlock" data-info="' + id + '">' +
                '<div class="col30 centered"><div class="colored sbf sbf20 ' + item.icon + '">' + $ctrl.LCS.getISBPath(8) + '</div></div>' +
                '<div class="text-left centered"><span>' + item.name + '</span></div>' +
                getSwitch() +
                '</a>' +
                '</li>';

            function getSwitch() {
                return (withoutSwitch ? '' : ('<div class="col40 centered"><div class="custom-checkbox switch display-block"><label class="i-switch radiobtn"><input type="checkbox" disabled="disabled" ' +
                    (isBlock ? ('checked="checked"') : '') +
                    '><i></i></label></div></div>'));
            }
        }

        function isBlock(id) {
            return $ctrl.overviewBlockIds && $ctrl.overviewBlockIds.indexOf(id) !== -1;
        }

        function changeBlock(id) {
            console.log('changeBlock');
            var remove = isBlock(id);
            if (remove) {
                var index = $ctrl.overviewBlockIds.indexOf(id);
                if (index !== -1) {
                    $ctrl.overviewBlockIds.splice(index, 1);
                }
            } else {
                $ctrl.overviewBlockIds.push(id);
            }
            var aEl = $ctrl.element.querySelector('li a[data-info="' + id + '"]');
            $ctrl.LCS[remove ? 'removeClass' : 'addClass'](
                $ctrl.groupByFeatures ? aEl.parentElement : aEl, activeCls);
            var checkbox = aEl.querySelector('input');
            if(checkbox) {
                if (remove) {
                    if (checkbox) {
                        checkbox.removeAttribute('checked');
                    }
                } else {
                    if (checkbox) {
                        checkbox.setAttribute('checked', 'checked');
                    }
                }
            }

            if(id === $ctrl.scriptFeatureId && $ctrl.setWithImport) {
                $ctrl.setWithImport();
            }
            return false;
        }

        function initFeaturesByProjectType() {
            _.each($ctrl.element.querySelectorAll('.feature-selector li'), function (el){
                var isBlock = $ctrl.isBlock(el.querySelector('a').getAttribute('data-info'));
                $ctrl.LCS[isBlock ? 'addClass' : 'removeClass'](el, activeCls);
            });
        }
    }
}

