        return _this.RootEventsService.addRootWatcher(watchers, 'UPDATE_SUBSCRIPTION_ITEM', method);
    }

    _this.emitSessionVarsChanged = function (sub) {
        //console.log('emitSessionVarsChanged');
        _this.RootEventsService.broadcastRoot('SESSION_VARS_CHANGED', sub);
    }

    _this.onSessionVarsChanged = function (watchers, method) {
