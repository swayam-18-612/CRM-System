    };

    return {
        getDrps: getDrps,
        getPopups: getPopups
    };

    function getDrps() {
        return {
            RatiosImages: RatiosImages,
            ShotTypes: [
                {id: "-1", name: 'Shot Numbering', isHeader: true, col: 1},
                {id: "1", name: 'Numerical', icon: 'shot-numerical'},
                {id: "2", name: 'Alphabetical', icon: 'shot-alphabetical'},
                {id: "3", name: 'Custom', icon: 'shot-custom'}
            ],

            AspectRatios: [
