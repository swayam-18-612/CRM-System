                        domNode.innerHTML += data.value;
                        return MentionBlot.setDataValues(domNode, data);
                    };

                    MentionBlot.setDataValues = function (element, data) {
                        var domNode = element;
                        Object.keys(data).forEach(function (key) {
                            domNode.dataset[key] = data[key];
