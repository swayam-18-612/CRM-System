angular.module('product.breakdowns.item.events.service', [
    'group.sbPopover.events.service',
    'product.callsheet.editScheduleItem.controller.service'
])
.service('ScenePopupEventsCtrlService', ScenePopupEventsCtrlService);
ScenePopupEventsCtrlService.$inject = ['EditScheduleItemCtrlService', 'TaggingScenesService'];
function ScenePopupEventsCtrlService(EditScheduleItemCtrlService, TaggingScenesService) {
    return function($ctrl) {
$ctrl.TaggingScenesService = TaggingScenesService;
        $ctrl = new EditScheduleItemCtrlService($ctrl);
        if(!$ctrl.scriptLoadingService){
            console.warn('parent for ScenePopupEventsCtrlService must define $ctrl.scriptLoadingService');
        }

        var characterCategoryId = $ctrl.scriptLoadingService.characterCategoryId;

        $ctrl.StripTypes = {Scene: 1, DayBreak: 0, Banner: 2};
        $ctrl.categories = $ctrl.scriptLoadingService.getShownCategories(true);

        $ctrl.onProcessSceneElement = onProcessSceneElement;
        $ctrl.getTaggingScenes = getTaggingScenes;

        $ctrl.goToShotsList = goToShotsList;
        $ctrl.goToBreakdowns = goToBreakdowns;
        $ctrl.viewScene = viewScene;
        $ctrl.goToScene = goToScene;
        $ctrl.goToBreakdown = goToBreakdown;
        $ctrl.viewUnsyncedScene = viewUnsyncedScene;
        $ctrl.initScenePopupEvents = initScenePopupEvents;
        $ctrl.getStrips = getStrips;

        return $ctrl;

        function initScenePopupEvents() {
            if($ctrl.canEdit){
                $ctrl.addRootWatcher('PROCESS_SCENE_ELEMENT', onProcessSceneElement);
            }

            $ctrl.addRootWatcher('VIEW_SCENE', onPreviewScene);
        }

        function getStrips(getAll){
            return $ctrl.scriptLoadingService.getProcessedStripsTables({
                type: $ctrl.StripTypes.Scene
            }, $ctrl.scriptOrder, false, getAll ? true : $ctrl.CPS.hasQuotaType('stripboard')).strips;
        }

        function onPreviewScene(id) {
            if (!id) {
                return;
            }
            viewScene(_.find($ctrl.list.items, {_id: id}));
        }

        function viewScene(item, isEditMode, isNewStrip) {//strip as param,  isEditMode if new strip
            if(!item){return '';}
            var s = isNewStrip ? isNewStrip.toString() : null;
            if (s && (s.indexOf('PointerEvent') !== -1 || s.indexOf('TouchEvent') !== -1)) {
                isNewStrip = false;
            }

            if($ctrl.isScheduling){
                item.strip = _.find($ctrl.getStrips(), {_id: item.stripId});
            }
            $ctrl.popupsService.open(item, $ctrl.popupsService.operations.viewScene, {
                item: item,
                canEdit: $ctrl.canEdit && item.active,
                scriptLoadingService: $ctrl.scriptLoadingService,
                isEditMode : isEditMode,
                isNewStrip: isNewStrip,
                isScheduling: $ctrl.isScheduling
            }, $ctrl.compOptions);
        }

        function goToScene(item) {
            $ctrl.popupsService.teamAccess(function () {
                $ctrl.CPS.transitionTo('user.product.script', $ctrl.CPS.currentProductPathParams({
                    scene: item._id
                }));
            });
        }

        function goToBreakdowns(active) {
            $ctrl.popupsService.teamAccess(function () {
                $ctrl.CPS.transitionTo('user.product.breakdowns', $ctrl.CPS.currentProductPathParams({
                    active: active === false ? false:true
                }));
            });
        }
        function viewUnsyncedScene(item) {
            $ctrl.popupsService.open(item, $ctrl.popupsService.operations.viewUnsyncedScene, {
                item: item,
                scriptLoadingService: $ctrl.scriptLoadingService,
                isScheduling: $ctrl.isScheduling
            }, $ctrl.compOptions);
        }

        function goToBreakdown(scene, withoutReload) {
            var prop = $ctrl.isScheduling ? 'stripId' : '_id',
                params = {
                    productId: $ctrl.CPS.productId,
                    scene: scene && scene[prop] ? scene[prop] : scene
                },
                rolePath = $ctrl.CPS.isCollaborator ? $ctrl.CPS.rolePaths.collabPath : $ctrl.CPS.rolePaths.currentUserPath;

            $ctrl.CPS.transitionTo('user.product.breakdown', $ctrl.CPS.currentPathParams(params, rolePath));


            /*if($ctrl.CPS.isAuthenticated){
                $ctrl.CPS.transitionTo('user.product.breakdown', $ctrl.CPS.currentPathParams(params, rolePath));
            }else if ($ctrl.CPS.isCollaborator) {
                console.log('goToBreakdown');
                //to do
                //load breakdown page in a popup
                $ctrl.popupsService.open(null, $ctrl.popupsService.operations.singleMaterial, params, $ctrl.compOptions);
            }*/
        }

        function goToShotsList(item) {
            $ctrl.popupsService.teamAccess(function () {
                console.log('goToShotsList');
                $ctrl.CPS.transitionTo('user.product.shots', $ctrl.CPS.currentProductPathParams({
                    filter: encodeURIComponent(JSON.stringify({s: item._id}))
                }));
            });
        }

        function onProcessSceneElement (result) {
            var strip = _.find($ctrl.allStrips, function (item) {
                return item._id === result.stripId;
            });
            return strip ? processStripUpdates(strip, result) : {};

            function processStripUpdates(strip, result) {
                console.log('processStripUpdates');
                var count = 0;
                if (result.cancel !== true) {
                    if (!result.noProcessing) {
                        result = $ctrl.scriptLoadingService.processSceneElement(result, 'taggingScenes');
                    }//on character selector
                    count = $ctrl.getTaggingScenes(strip._id);
                    var item = result.item;

                    if (!result.item && (result.type === 'Create' || result.type === 'Remove')) {
                        result.cancel = true;
                        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.taggingScenes.' + result.type + '.' + (result.type === 'Create' ? 'alreadyExists' : 'alreadyDeleted'), 'success');
                    } else if ((result.type === 'Create' || result.type === 'Remove') && item) {
                        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.taggingScenes.' + result.type + '.success', 'success', {
                            name: item.name,
                            category: $ctrl.scriptLoadingService.getTaggingCategoryById(item.categoryId).name,
                            count: result.countUpdated
                        });
                    } else if (result.type === 'Edit' && result.updates) {
                        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.taggingScenes.' + result.type + '.success', 'success');
                    }

                    strip.characters = $ctrl.scriptLoadingService.getCharactersForStrip(strip._id);
                }

                $ctrl.broadcastRoot('RELOAD_TAG_ELEMENT_' + strip._id, result);

                if ($ctrl.onPreloadSettings) {
                    $ctrl.onPreloadSettings(result, false);
                }
                return {strip: strip, count: count};
            }
        }

        //note: tagging scenes are grouped by category id. tagging scene has attr name from element.name. set these in method getTaggingScenes
        function getTaggingScenes(stripId) {
            //set scene elements for each category
            var count = 0, res = {},
                tags = $ctrl.scriptLoadingService.getTaggingScenesWithElements({stripId: stripId});
            _.each($ctrl.categories, function (category) {
                var id = category._id;
                if (category.type !== 3) {
                    var se = _.filter(tags, {categoryId: id});
                    if (se.length > 0) {
                        if (id === characterCategoryId) {
                            se = se.sort($ctrl.TaggingScenesService.sortChars);
                        }
                        count += se.length;
                        res['c' + id] = se;
                    }
                }
            });

            $ctrl.taggingScenes = count > 0 ? res : null;
            return count;
        }
    }
}

