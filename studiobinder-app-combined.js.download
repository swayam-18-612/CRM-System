    'apiServices.Avscripts',
    'apiServices.Documents',
    'apiServices.DocumentVersions',
    'apiServices.AvscriptsListOptions',
    'apiConstants.avscript.services',

    'product.shots.page.init.controller.service',
    'product.avscript.group.component',
    'product.avscript.item.popup.component',
    'product.avscript.single.popup.component',
    'page.tree.simple.controller.service.injector',
    'product.document.scratchpad.component',
    'product.document.notes.popup.component'
])

.constant('AvscriptPageCtrlServiceInjectors', {
    pageCtrlService: 'PageTreeSimpleCtrlService',
    constantsService: 'AvscriptConstantsService',
    service: 'AvscriptsService',
    DocumentsService: 'DocumentsService',

    listOptionsService: 'AvscriptsListOptionsService',
    listsService: 'DocumentVersionsService',
})
.service('AvscriptPageCtrlService', AvscriptPageCtrlService);
AvscriptPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'AvscriptPageCtrlServiceInjectors'];
function AvscriptPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    return function ($ctrl, $element, printPageParams) {
        console.log('AvscriptPageCtrlService');

        $ctrl.enableListShare = true;
        $ctrl.singleAddBtn = true;
        $ctrl.setupTypeName = 'Segment';
        $ctrl.setupTypeIcon = 'daybreak';
        $ctrl.drpSelectedFiltersClass = 'drpAvscriptFilter';
        $ctrl.counterSetDynamically = true;

        $ctrl.getColorStyle = getColorStyle;

        $ctrl.getSidebarAddon = getSidebarAddon;
        $ctrl.hideGridViewFilters = hideGridViewFilters;
        $ctrl.checkShowAddNewItem = checkShowAddNewItem;
        $ctrl.getListItemIcon = getListItemIcon;


        $ctrl.getParams = getParams;
        $ctrl.getParamsRedirect = getParamsRedirect;
        $ctrl.hasLists = hasLists;
        $ctrl.getPageTitle = getPageTitle;
        $ctrl.onPageLoaded = onPageLoaded;
        $ctrl.getTopFiltersTitleOther = getTopFiltersTitleOther;
        $ctrl.getGroupFilters = getGroupFilters;
        $ctrl.canArchive = canArchive;
        $ctrl.isCurrent = isCurrent;
        $ctrl.makeCurrent = makeCurrent;
        $ctrl.saveAsTemplate = saveAsTemplate;
        $ctrl.importTemplate = importTemplate;
        $ctrl.onUpdatedCommentsTab = onUpdatedCommentsTab;

        //todo make it work and remove
        $ctrl.canMoveMulti = canMoveMulti;
        //$ctrl.canCopyMulti = canCopyMulti;
        $ctrl.getTreePopoverTemplateOther = getTreePopoverTemplateOther;
        $ctrl.sharePage = sharePage;

        $ctrl.getCollabBannerInfo = getCollabBannerInfo;
        $ctrl.hasTwoSidebars = hasTwoSidebars;

        $ctrl.openScratchpad = openScratchpad;
        // $ctrl.getTopFilters = getTopFilters;

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);

        initOther();

        return $ctrl;

        function openScratchpad(type, e){
            $ctrl.broadcastRoot('TOP_BTN_' + $ctrl.listTreeService.active.selectedListId, {e: e, event: 'TOGGLESCSRATCHPAD', document: $ctrl.document});
        }

        function hasTwoSidebars(){
            //todo :: mobile??
            return $ctrl.has2Sidebars && $ctrl.canEdit;
        }

        function getCollabBannerInfo(){
            return {txt: 'Write and share your own AV scripts for free.', campaign: 'collab-avscripts'};
        }

        function sharePage(e){
            var list = $ctrl.document; // $ctrl.getCurrentList() -> that is the document version
            $ctrl.share(list, e);
        }

        function canCopyMulti(){
            return false;
        }

        function canMoveMulti(){
            return false;
        }

        function onUpdatedCommentsTab(result){
            console.log('onUpdatedCommentsTab');
        }

        function canArchive(item){
            return !$ctrl.isCurrent(item);
        }

        function isCurrent(item){
            return $ctrl.document && $ctrl.document.versionId === item._id;
        }

        function getGroupFilters(isDisplay) {
            return isDisplay ? {type: 1} : null;
        }

        function getDuplicateListParam(increment) {
            var prop = 'version',
                tree = $ctrl.listTreeService.getTree($ctrl.treeType, true),
                nodes = tree && tree.length > 0 ? tree[0].nodes : null,
                res = {addInFront: true};
            res[prop] = ((nodes ? _.max(nodes, prop) : 0)[prop] || 0) + (increment ? 1 : 0);
            return res;
        }

        function getTopFiltersTitleOther() {
            return '<div data-type="openVersions" class="'+ $ctrl.getBtnActionCls() + ' with-cursor col50 centered position-relative pull-left table-div" analytics-on analytics-action="Open Versions" tooltip="Open Versions" tooltip-placement="bottom"><div class="size centering spacing-bottom margin-top-quarter version-label full-width">v <span class="txtVersion"></span></div><div class="sbf pull-right arrow-filled-down hide-print blue" style="position:absolute;top:3px;right:4px"></div></div>';
        }

        function saveAsTemplate(item, e) {
            console.log('save as template');
//planFetatures testmode
            var quotaType = $ctrl.LCS.isDebugMode ? 'avscriptTemplates' : null;
            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});

            function process() {
                /*$ctrl.popupsService.open({
                    companyId: $ctrl.CPS.companyId,
                    productId: $ctrl.CPS.productId,
                    versionId: $ctrl.documentVersionId,
                }, $ctrl.popupsService.operations.saveDocumentTemplate, {
                    itemTitle: ($ctrl.document.type === 3 ? 'AV Script ' : 'Document') + ' template'
                }, $ctrl.compOptions);*/

                $ctrl.broadcastRoot('DUPLICATE_FROM_TOP_' + $ctrl.elemType + '_TREE', {
                    item: item ? item : $ctrl.listTreeService.active.selectedList,
                    dataParam: {isTemplate: true}
                });
            }
        }

        function importTemplate(item){
            console.log('importTemplate');
           /* $ctrl.broadcastRoot('DUPLICATE_FROM_TOP_' + $ctrl.elemType + '_TREE', {
                item: item ? item : $ctrl.listTreeService.active.selectedList,
                dataParam: {isTemplate: true}
            });*/

        }

        function makeCurrent(item){
            console.log('makeCurrent');
            $ctrl.listTreeService.listsService.makeCurrent(getData(item), onSuccess, onError);

            function onSuccess(result){
                if(result && result.item){
                    $ctrl.document.version =result.item.version;
                    $ctrl.document.versionId =result.item.versionId;

                }
            }

            function onError(err){
                $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.version.makeCurrent.error', 'error');
            }
        }

        function getData(item) {
            return {
                versionId: item._id,
                id: item.documentId,
                type: 'documentVersion'
            };
        }

        function onPageLoaded() {
            if (typeof ($ctrl.onPageLoadedOther) === 'function') {
                $ctrl.onPageLoadedOther();
            }
            if ($ctrl.documentLoaded || $ctrl.documentLoading) {
                return;
            }
            $ctrl.documentLoading = true;

            if ($ctrl.documentVersionId) {
                $ctrl.listTreeService.listsService.getById($ctrl.documentVersionId, 'createdById documentId', function (item) {
                    $ctrl.document = item.document;
                    $ctrl.documentVersion = item;
                    final();
                }, onError);
            } else if ($ctrl.documentId) { // the default version becomes the selected version
                if (!$ctrl.DocumentsService) {
                    $ctrl.DocumentsService = $ctrl.$injector.get('DocumentsService');
                }
                $ctrl.DocumentsService.getById($ctrl.documentId, 'createdById documentVersionId', function (item) {
                    $ctrl.document = item;
                    $ctrl.documentVersion = item;
                    final()
                }, onError);
            }

            function final() {
               // initOther();
                $ctrl.documentLoading = false;
                $ctrl.documentLoaded = true;
                if ($ctrl.documentId !== $ctrl.document._id) {
                    console.error('Invalid doc');
                } else {
                    setPageTitle();
                }
                /* var n = $ctrl.document ? $ctrl.document.name : '';
                 var el = $ctrl.element.querySelector('.text-info-count');
                 if (el) {
                     $ctrl.LCS.addClass(el, 'sb-hide');
                     el.innerText = '';//n;  //don;t display script name
                 }*/


                $ctrl.addRootWatcher('UPDATED_DOCUMENT_ITEM', onDocumentUpdated);
            }

            function onError(err) {
                console.error(err);
            }
        }

        function onDocumentUpdated(result){
            var editchanges = $ctrl.document && result && result.editchanges && result.editchanges._id === $ctrl.document._id ? result.editchanges : null;
            if(!editchanges){return;}
            _.each(['scratchPad'], function (prop){
                if(editchanges.hasOwnProperty(prop)) {
                    $ctrl.document[prop] = editchanges[prop];
                }
            });
        }

        function initOther(){

            if($ctrl.RouteCollaboratorsService) {
                $ctrl.RouteCollaboratorsService.setListTreeService({
                    getNodeById: function getNodeById(listId) {
                        return listId && $ctrl.document && $ctrl.document._id === listId ? $ctrl.document : null;
                    },
                    getBreadcrumbs: function getBreadcrumbs(list) {
                        return [];
                    },
                    isArchiveAsList: function isArchiveAsList() {
                        return false;
                    },
                    active: null,

                    maxLevel: $ctrl.RouteCollaboratorsService.BlocksSetupService.getCurrentTodoPage().maxLevel,

                    isForShare: true
                });
            }

            if(!$ctrl.isFirstTimeAV) {
                $ctrl.sidebarOptions = _.extend({}, $ctrl.sidebarOptions, {
                    getNewTreeItem: getNewTreeItem,
                    // showBottomButtons: showBottomButtons,
                    onMorePopoverUpdateOther: onMorePopoverUpdateOther,
                    getItemForDuplicate: getItemForDuplicate,
                    getItemForAdd: getItemForDuplicate
                });

                if ($ctrl.canEdit) {
                    $ctrl.SettingsActions = []
                    //todo bring back share
                    /*
                    .concat(
                         ($ctrl.LCS.isMobileSize && $ctrl.showShareInListNav && $ctrl.CPS.isAuthenticated && $ctrl.CPS.productId) ? [{
                             id: 'btnShare',
                             name: 'Share List',
                             icon: 'link',
                             type: 'shareList',
                             active:true,
                             cond: '$ctrl.isActiveGroup()',
                             callDirectly: true
                             //tooltip: 'Reorder strips by shooting location or scene number'
                         }] : []
                     )*/
              .concat([
                        {
                            id: 'btnScratchpad',
                            name: 'Script Outline',
                            icon: 'scratchpad',
                            iconLevel: 4,
                            type: 'openScratchpad',
                            active: true,
                            //tooltip: 'Reorder strips by shooting location or scene number'
                            exposeOnDesktop: true,
                            callDirectly: true
                        },

                  /* {
                      id: 'btnSaveTemplate',
                      name: 'Save as Template',
                      icon: 'star',
                      type: 'saveAsTemplate',
                      active: true,
                      //tooltip: 'Reorder strips by shooting location or scene number'
                      exposeOnDesktop: true,
                      callDirectly: true
                  },  {
                      id: 'btnImportTemplate',
                      name: 'Import Template',
                      icon: 'upload-2',
                      iconLevel: 3,
                      type: 'importTemplate',
                      active: true,
                      //tooltip: 'Reorder strips by shooting location or scene number'
                      exposeOnDesktop: true,
                      callDirectly: true
                  } */
                    ]);

                }

                $ctrl.isFirstTimeAV = true;
            }
        }

        function setPageTitle(){
            var el = $ctrl.element.querySelector('.sb-prop-document-name');
            if(el){
                el.innerText = $ctrl.document && $ctrl.document.name ? $ctrl.document.name : '';
            }
        }

        function getPageTitle(){
            return $ctrl.document ? ('<span class="sb-prop-document-name left-separator right pull-left with-line-height hide-lower1024"><span class=" " tooltip-html="\'\'" tooltip-placement="bottom">'+($ctrl.document && $ctrl.document.name ? $ctrl.document.name : '')+'</span></span>') : '';
        }

        function hasLists(checkActive) {
            return true; //show the sidebar and dont show empty state. if there are no rows populate first time
            //return $ctrl.listTreeService.hasLists($ctrl.treeType, checkActive ? $ctrl.selectedFilter !== false: undefined);
        }

        function getItemForDuplicate(item, param, increment) {
            return _.extend($ctrl.listTreeService.listsService.getUpdatedInfo(_.extend({}, angular.copy(item), param ? param : null)), getDuplicateListParam(increment));
        }

        function onMorePopoverUpdateOther(result){
            if (!result || result && !result.item) {
                return;
            }

            var e = result.e,
                target = e.currentTarget,
                dataType = target.getAttribute('data-type'),
                method = $ctrl[dataType];

            if(method && typeof(method)){
                $ctrl.preventDefault(e);
                method(result.item);
            }
        }

        function getTreePopoverTemplateOther(item, isMobile, checkHasItems) {
            return '';
            return $ctrl.getSideMenuLi({
                    type: 'saveAsTemplate',
                    action: 'Save as Template',
                    icon: 'star'
                })

                 + $ctrl.getSideMenuLi({
                    type: 'importTemplate',
                    action: 'Import Template',
                    icon: 'upload-2',
                    iconLevel: 3
                });

               /* + ($ctrl.isCurrent(item) ? '' : $ctrl.getSideMenuLi({
                    type: 'makeCurrent',
                    action: 'Make Current',
                    icon: 'save'
                }));*/
        }

        function showBottomButtons(){
            return false;
        }

        //doesnt seem to be user
        function getNewTreeItem(item) {
            var items = $ctrl.listTreeService.getNodeById(null, $ctrl.treeType).nodes;//get items from parent
            if (!item.name) {
                item.name = 'New ' + $ctrl.nameForList;
            }

            return $ctrl.listTreeService.listsService.getUpdatedInfo(item, items);
        }

        function getListItemIcon(item) {
            if (!item && !item.version) {
                return null;
            }
            return '<div class="version-col col40 centered text-left"><span class="mark-version sb-prop-list-version" ' + getColorStyle(item) + '>v' + item.version + '</span></div>'
              //+ ($ctrl.isCurrent(item) ? ('<div class="inline-block with-margin-left version-current">Current</div>') : '')
            ;
        }

        function getColorStyle(item) {
            var s = $ctrl.listTreeService.listsService.getColorStyle(item);
            if (!s) {
                return '';
            }
            var el = '';
            for (var p in s) {
                el += p + ':' + s[p] + ';';
            }
            return 'style="' + el + '"';
        }

        function hideGridViewFilters() {
            return true;
        }

        function getSidebarAddon() {
            return 'on-get-drp-selected-filters="$ctrl.getDrpSelectedFilters(filter)" ';
        }

        function checkShowAddNewItem() {
            return false;
        }

        function getParams() {
            return _.extend($ctrl.getParamsInit(), $ctrl.getParamsRedirect());
        }

        function getParamsRedirect() {
            return  {
                documentId: $ctrl.documentId,
            };
        }
    }
}

angular.module('product.avscript.item.popup.component', [
    'product.shots.item.edit.controller.service',
])
.component('avscriptEditPopup', popupComponentParams('AvscriptEditPopupCtrl'))
.controller('AvscriptEditPopupCtrl', AvscriptEditPopupCtrl);
AvscriptEditPopupCtrl.$inject = ['ShotEditPopupCtrlService', '$element'];
function AvscriptEditPopupCtrl(ShotEditPopupCtrlService, $element) {
    console.log('AvscriptEditPopupCtrl');
    var $ctrl = this;

    $ctrl.preInitGeneralOther = preInitGeneralOther;
    $ctrl.preSetTemplateDataOther = preSetTemplateDataOther;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.onChangeOther = onChangeOther;

    $ctrl = new ShotEditPopupCtrlService($ctrl, $element);

    function preInitGeneralOther() {
        $ctrl.columnsList = $ctrl.columnsList.map(function (c) {
            if (c.prop === 'color') {
                c.startInFocus = false;
            }
            return c;
        });

        if (!$ctrl.setupTypeName) {
            $ctrl.setupTypeName = 'Segment';
        }

        if (!$ctrl.setupTypeIcon) {
            $ctrl.setupTypeIcon = 'daybreak';
        }

        $ctrl.itemname = ($ctrl.item.type === $ctrl.ShotTypes.Shot ? $ctrl.itemTitle : ($ctrl.item.type === $ctrl.ShotTypes.Banner ? 'Banner' : $ctrl.setupTypeName));
    }

    function preSetTemplateDataOther(){
        $ctrl.icon = ($ctrl.item.type === $ctrl.ShotTypes.Shot ? $ctrl.itemIcon : ($ctrl.item.type === $ctrl.ShotTypes.Banner ? 'banner' : $ctrl.setupTypeIcon));
        $ctrl.iconLevel = ($ctrl.item.type === $ctrl.ShotTypes.Shot ? $ctrl.iconLevel : 4);

        $ctrl.subtitle = null;
        var setupId = $ctrl.item.type === $ctrl.ShotTypes.Setup ? $ctrl.item._id : $ctrl.item.setupId;
        if (setupId) {
            var setup = $ctrl.extraParam.scriptLoadingService.getById('Avscripts', setupId);
            $ctrl.subtitle = setup ? (setup.name ? setup.name : (setup.segNo ? ('Segment ' + setup.segNo) : null)) : null;
        }

        if($ctrl.isDuplicate){
            $ctrl.item.isDuplicate = true;
        }
    }

    function getEClassAttr() {
        return ' form-control with-underline ' + getPageClass();
    }
    function getPageClass(){return $ctrl.pageClass ? ('page-class '+$ctrl.pageClass):'';}

    function getPopupBodyContent() {
        var isMobile = $ctrl.LCS.isMobileSize;
        switch ($ctrl.item.type) {
            case $ctrl.ShotTypes.Shot:
                return getShot();
            case $ctrl.ShotTypes.Banner:
                return getBanner();
            case $ctrl.ShotTypes.Setup:
                return getBreak();
        }

        function getFirstRow(isShot, p) {
            var isAll = true;
            var c = $ctrl.getColumnByProp('color', isAll);

            return '<div class="form-group table-div full-width margin-bottom-half">' +
                    $ctrl.getContentEditable('color', isAll, {
                        formGroupClass: (c && (!c.quotaType || c.quotaType && $ctrl.CPS.hasQuotaType(c.quotaType)) ? 'col60' :'col140' ) +' ' + (isShot ? 'vtop' : 'centered' ),
                        withoutLabelInPopup: !isShot,
                        hideIconOnEdit: true,
                    }) +
                    $ctrl.getContentEditable(isShot ? 'duration'  : 'name', isAll, _.extend({
                        formGroupClass:  'thin ',//padding-left-10',
                        withoutLabelInPopup: !isShot,
                        hideIconOnEdit: true
                    }, p ? {placeholder: p} : p,
                      isShot ?  null : {
                        withNoToolbar: true,
                        eClassAttr: getEClassAttr()
                    })) +
                '</div>';
        }

        function getBanner() {
            return getFirstRow(false, 'e.g. Load In or Meal Break') +
                getNote();
        }

        function getBreak() {
            return  $ctrl.getContentEditable('name', true,{
                    withNoToolbar: true,
                placeholder: 'Segment name' 
            }) +
            getNote();
            //   + getRow(['duration'], 'full-width') +
        }

        function getNote() {
            return getRow(['note'], 'full-width no-margin-bottom', {
                withNoToolbar: true,
                withoutLabelInPopup: false
            });
        }

        function getShot() {
            var def = _.filter($ctrl.columnsList, function (c) {
                return c.prop === 'audio' || c.prop === 'video';
            }).map(function (c) {
                var isAudio = c.prop === 'audio', other = '';

                if(isAudio){
                    other = $ctrl.getRowCols([_.extend({}, $ctrl.getColumnByProp('wordCount', true), {
                        fieldClass: ' form-control ',
                        formGroupClass: ' field form-group inline-block with-margin-left ',
                        withoutLabelInPopup: true,
                        cantEditInPopup: true,
                        withInlineLabel: true,
                        groupLabel: true,

                    })], 'colp50 pull-right', false, isMobile, {

                    });
                }
                return $ctrl.getRowCols([c], 'full-width', $ctrl.withLabel, isMobile, other) +
                    (other || '');
            }).join('');

            return '<div class="clearfix">' + getFirstRow(true) + '</div>' +
                (def || '');
        }

        function getRow(l, cls, other) {
            return $ctrl.getRowCols(l, cls, $ctrl.withLabel, isMobile, other);
        }
    }

    function onChangeOther(result) {
        console.log('onChangeOther');
        var prop = 'wordCount';
        if (result && result.prop === 'audio') {
            var changes = result.editchanges || result.selected;
            $ctrl.item[prop] = changes[prop] || 0;
            var el = $ctrl.element.querySelector('.sb-prop-' + prop + ' .sb-view-content');
            if (el) {
                el.innerText = $ctrl.item[prop];
            }
        }
    }
}

angular.module('product.avscript.single.popup.component', [
    'product.avscriptPage.service'
]) 
.component('singleAvscriptPopup', popupComponentParams('SingleAvscriptPopupCtrl', true))
.controller('SingleAvscriptPopupCtrl', SingleAvscriptPopupCtrl);
SingleAvscriptPopupCtrl.$inject = ['AvscriptPageCtrlService', '$element'];
function SingleAvscriptPopupCtrl(pageCtrlService, $element) {
    console.log('SingleAvscriptPopupCtrl');
    var $ctrl = this;

    $ctrl.isPopup = true;
    $ctrl.popupInitParams = ['documentId', 'documentVersionId'];

    $ctrl.onPageLoadedOther = initPopupParams;

    $ctrl = new pageCtrlService($ctrl, $element);

    function initPopupParams(){
        if ($ctrl.extraParam && $ctrl.popupInitParams) {
            _.each($ctrl.popupInitParams, function (prop) {
                $ctrl[prop] = $ctrl.extraParam[prop];
            });
        }
    }
}


