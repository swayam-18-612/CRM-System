        $ctrl.withFooterBtns = true;
        $ctrl.btnText = '<span>Remove</span><span class="hide-ipad"> ' + $ctrl.typeS+'</span>';
    }

    function getPopupBodyContent() {
        return '<p class="text-center">Are you sure you want to remove the selected ' + $ctrl.typeS + '</p>';
    }
}

