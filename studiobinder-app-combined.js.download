addRoutingForType('shots', {
    title: 'Shot Lists',
    bodyClass: 'bodyshots shots shots-page stripboard storyboard medium-template ',
    withPrint: true
});

angular.module('product.shotsPage.service', [
    'apiServices.Shots',
    'apiServices.ShotsLists',
    'apiServices.ShotsListOptions',
    'apiConstants.shots.services',

    'product.shots.page.init.controller.service',
    'product.shots.group.component',
    'page.tree.simple.controller.service.injector'
])
.constant('ShotsPageCtrlServiceInjectors', {
    pageCtrlService: 'ShotsPageInitCtrlService',
    constantsService: 'ShotConstantsService',
    listOptionsService: 'ShotsListOptionsService',
    listsService: 'ShotsListsService',
    service: 'ShotsService'

})
.service('ShotsPageCtrlService', ShotsPageCtrlService);
ShotsPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'ShotsPageCtrlServiceInjectors'];

function ShotsPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    console.log('ShotsPageCtrlService');
    return function ($ctrl, $element, printPageParams) {

        //$ctrl.viewFilters = 'shotsLayout';

        $ctrl.getGroupFilters = getGroupFilters;
        $ctrl.onPageLoadedOther = onPageLoadedOther;
        $ctrl.getCollabBannerInfo = getCollabBannerInfo;
        
        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);

        return $ctrl;

        function getCollabBannerInfo(){
            return {txt: 'Create and share your own shot lists for free.', campaign:'collab-shotlists'};
        }

        function getGroupFilters(isDisplay) {
            return $ctrl.withTreeDisplayCount && isDisplay ? {type: 1} : null;
        }

        function onAddNewList(treeType) {
            if (treeType === $ctrl.treeTypeCustomList) {
                $ctrl.addItem(treeType, {
                    item: {type: $ctrl.treeType},
                    addFolder: false,
                    isParent: $ctrl.listTreeService.active.selectedList && $ctrl.listTreeService.active.selectedList.isFolder ? true : false,
                    useSelected: true,
                    addFromBottom: true
                });
            }
        }

        function onPageLoadedOther() {
            if ($ctrl.canEdit) {
                $ctrl.removeWatcher($ctrl.addNewWatcher);
                $ctrl.addNewWatcher = $ctrl.addRootWatcher('ADD_NEW_LIST', onAddNewList);
            }
            var search = $ctrl.CPS.getSearchFilter('filter');
            if (!search) {
                return null;
            }
        }
    }
}

angular.module('product.shots.page.init.controller.service', [
    'product.shots.page.init.first.controller.service',
    'product.shots.list.tree.component',
    'product.shots.popups',
    'page.group.controller.service',
    'product.shots.firstListOrScript.component'
]) 
.service('ShotsPageInitCtrlService', ShotsPageInitCtrlService);
ShotsPageInitCtrlService.$inject = ['ShotsPageInitFirstCtrlService'];
function ShotsPageInitCtrlService(ShotsPageInitFirstCtrlService) {

  return function($ctrl, $element, initOptions){
      console.log('ShotsPageInitCtrlService');
      $ctrl.withDrpAdd = true;

     // $ctrl.getTopFilters = getTopFilters;
      $ctrl.getDrpSettingsOther = getDrpSettingsOther;

      $ctrl.getEmptyStateButtons = getEmptyStateButtons;
      $ctrl.getEmptyTitleName = getEmptyTitleName;
      $ctrl.addListOrScript = addListOrScript;
      $ctrl.addFirstList = addFirstList;

      $ctrl.hasTwoSidebars = hasTwoSidebars;
      $ctrl.viewAction = viewAction;
      $ctrl.duplicateTitle = duplicateTitle;
      //$ctrl.canDuplicate = canDuplicate;
      $ctrl.getDrpSettingsAfter = getDrpSettingsAfter;
      $ctrl.preBroadcastPreloadOther = preBroadcastPreloadOther;
      $ctrl.isCustomList = isCustomList;
      $ctrl.showFilterForCollabs = showFilterForCollabs;
      $ctrl.checkListActiveInit = checkListActiveInit;

      $ctrl = new ShotsPageInitFirstCtrlService($ctrl, $element, initOptions);

      //todo see if necessary
      addKeyboardActions();

      return $ctrl;

      function checkListActiveInit(){
          return '';
      }

      function showFilterForCollabs(){
          return $ctrl.showFiltersForCollabs && !$ctrl.RouteCollaboratorsService.collabRootId;
      }

      function preBroadcastPreloadOther() {
          console.log('preBroadcastPreloadOther');
          var isCustomList = $ctrl.isCustomList();
          $ctrl.listIcon = isCustomList ? $ctrl.itemIcon : 'stripboard';
          $ctrl.listIconLevel = isCustomList ? $ctrl.iconLevel : 6;
          $ctrl.emptyStateDesc = isCustomList ? 'Don’t have a script to import? Need one-off shot lists? Create custom shot lists here.' : null;
          $ctrl.emptyStateTitle = isCustomList ? ('Custom ' + $ctrl.nameForList + 's') : null;
      }

      function canDuplicate(){
          return $ctrl.CPS.hasQuotaType($ctrl.quotaType);
      }

      function duplicateTitle(item){
          var name = item.isFolder ? $ctrl.nameForGroup : $ctrl.nameForList;
          return $ctrl.isCustomList() ? name : ' to Custom Lists';
      }

      function getDrpSettingsOther() {
          return getLi('Preview Scene', 'sides', 'TOGGLESCENE', true);

          function getLi(txt, icon, method, showIpadOnly, cond){
              return $ctrl.getLiInit(txt, icon, 2, method, cond, showIpadOnly, false);
          }
      }


      function addKeyboardActions() {
          $ctrl.keyboardService.toggleScreen = toggleScreenEvent;
          $ctrl.keyboardService.processOtherKey = processOtherKey;

          function processOtherKey(key, data) {
              var keys = $ctrl.keyboardService.keys;
              var sId = data.currentListId;
              if ($ctrl.currentListId !== sId) {
                  return;
              }
              var e = data.e;
              var totalCount = $ctrl.list.totalCount;
              if ($ctrl.slideshow) {
                  if (key === keys.leftKey || key === keys.rightKey || key === keys.downKey || key === keys.upKey || keys.escKey) {
                      switch (key) {
                          case keys.leftKey:
                              $ctrl.preventDefault(e);
                              $ctrl.changeSlide($ctrl.slideshow.index, -1);
                              break;

                          case keys.rightKey:
                              $ctrl.preventDefault(e);
                              $ctrl.changeSlide($ctrl.slideshow.index, 1);
                              break;

                          case keys.downKey:
                              if (totalCount > 0) {
                                  $ctrl.preventDefault(e);
                                  $ctrl.changeSlide(0, -1);
                              }
                              break;

                          case keys.upKey:
                              if (totalCount > 0) {
                                  $ctrl.preventDefault(e);
                                  if (totalCount > 0) {
                                      $ctrl.changeSlide(totalCount - 1, 1);
                                  }
                              }
                              break;

                          case keys.escKey:
                              $ctrl.preventDefault(e);
                              toggleScreen();
                              break;
                      }
                  }
              }
          }

          function toggleScreen() {
              $ctrl.keyboardService.toggleScreen();
          }

          function toggleScreenEvent() {// if already full screen; exit ; else go fullscreen  Fullscreen.isEnabled()
              $ctrl.keyboardService.fullscreenList = $ctrl.keyboardService.fullscreenList ? null : {
                  c: $ctrl.keyboardService.currentListId,
                  t: new Date().getTime()
              };
              $ctrl.broadcastRoot('FULLSCREEN_CHANGED', $ctrl.keyboardService.fullscreenList);
              console.log('toggleScreen');
          }
      }

      function getDrpSettingsAfter(cls){
          return ($ctrl.CPS.isAuthenticated ? ('<import-script  is-li="true" show-title="true" ' +
              (cls?('li-'+cls):'') + ($ctrl.pageClass ? (' page-class="'+$ctrl.pageClass+'" ') : '') +
              '></import-script>') : '')
      }
      function viewAction(e, event) {
          $ctrl.preventDefault(e);
          $ctrl.broadcastRoot('TOP_BTN_' + $ctrl.listTreeService.active.selectedListId, {event: event, e:e});
      }

      function getEmptyStateButtons(checkActive) {
          var clsP = 'btn btn-primary ' + ($ctrl.pageClass || ''),
              hasBtn1 = $ctrl.CPS.isAuthenticated && $ctrl.hasScript,
              hasLists = '$ctrl.hasLists()',
              clsT = hasBtn1 ? 'btn btn-small transparent big with-margin-left' : clsP;
          return '<button ng-show="!' + hasLists + '" class="' + clsP + ' [ACTION_BUTTON]" data-type="addListOrScript">Get Started</button>' +
                  '<div ng-show="' + hasLists + '">' +
                  (hasBtn1 ? ('<import-script data-info="EMPTY_STATE"' + (checkActive ? 'ng-if="!$ctrl.isCustomList()"' : '') + ' btn-class="' + clsP + '" show-title="true" show-text-on-ipad="true" ' + ($ctrl.pageClass ? ('page-class="' + $ctrl.pageClass + '" ') : '') + '></import-script>') : '') +
                  '<button ' + (checkActive ? 'ng-show="$ctrl.isCustomList()"' : '') + ' class="' + ((checkActive || !$ctrl.hasScript) ? clsP : clsT) + ' [ACTION_BUTTON]' + '" data-type="addFirstList"><span class="pull-left sbf plus"></span> New ' + ($ctrl.listMustBeInGroup ? $ctrl.nameForGroup : $ctrl.nameForList) + '</button>' +
                  '</div>';
      }

      function getEmptyDesc(){
          return isCustomList() ? 'Don’t have a script to import? Need one-off shot lists? Create custom shot lists here.' : null;
      }

      function getEmptyTitleName(){
           return isCustomList() ? ('Custom ' + $ctrl.nameForList + 's') : null;
      }

      function addFirstList() {
          $ctrl.treeType = $ctrl.treeTypeCustomList;
          $ctrl.filtersService.broadcastChangeFilter($ctrl.broadcastRoot, $ctrl.treeType, 'treeType', false);
          $ctrl.broadcastRoot('ADD_FIRST_LIST' + $ctrl.elemType, $ctrl.listMustBeInGroup);
      }

      function addListOrScript() {
        //  $ctrl.broadcastRoot('ADD_LIST_OR_SCRIPT' + $ctrl.elemType);
          if(!$ctrl.hasLists()){//isempty
              $ctrl.popupsService.open(null, $ctrl.popupsService.operations.createListOrScript, {
                  listTreeService: $ctrl.listTreeService,
                  canEdit: $ctrl.canEdit,
              }, $ctrl.compOptions, null, function (result) {
                  console.log('addListOrScript');
                  if (result && result.treeType) {
                      $ctrl.treeType = result.treeType;
                  }
                  process();
              });
          } else {
              process();
          }

          function process(){
              if (isCustomList()) {
                  addFirstList();
              } else {
                  $ctrl.filtersService.broadcastChangeFilter($ctrl.broadcastRoot, $ctrl.treeType, 'treeType', false);
                  $ctrl.broadcastRoot('IMPORT_SCRIPT_FROM_BTN_EMPTY_STATE');
              }
          }
      }

      function hasTwoSidebars(){
          //todo :: mobile??
          return $ctrl.has2Sidebars && $ctrl.checkIfStripList();
      }

      function isCustomList(){
          return $ctrl.treeType === $ctrl.treeTypeCustomList;
      }

  }
}

angular.module('product.shots.page.init.first.controller.service', [
    'page.group.controller.service'
])
.service('ShotsPageInitFirstCtrlService', ShotsPageInitFirstCtrlService);
ShotsPageInitFirstCtrlService.$inject = ['PageTreeInitCtrlService'];
function ShotsPageInitFirstCtrlService(PageTreeInitCtrlService) {
    return function($ctrl, $element, initOptions){
        console.log('ShotsPageInitFirstCtrlService');
        $ctrl.withoutCustomize = true;
        $ctrl.groupClass = 'shot-group';
        $ctrl.treeTag = 'shot';

        if(!$ctrl.viewFilters) {
            $ctrl.viewFilters = 'printLayout';// $ctrl.withGridView ? 'printLayout' : null;
        }

        if(!$ctrl.setupTypeName) {
            $ctrl.setupTypeName = 'Setup';
        }

        if(!$ctrl.setupTypeIcon) {
            $ctrl.setupTypeIcon = 'camera-setup';
        }

        $ctrl.onChangedGroupFilters = onChangedGroupFilters;
        $ctrl.getParams = getParams;
        if(!$ctrl.getTreeFilters) {
            $ctrl.getTreeFilters = getTreeFilters;
        }
        $ctrl.preProcessTreeItem = preProcessTreeItem;

        $ctrl.preBroadcastPreload = preBroadcastPreload;
        $ctrl.processSettings = processSettings;

        $ctrl.onPageTreeInit = onPageTreeInit;
        $ctrl.getSidebarAddon = getSidebarAddon;

        if(!$ctrl.hasLists){
            $ctrl.hasLists = hasLists;

        }
        $ctrl.isScriptList = isScriptList;
        $ctrl.sidebarButtonsOther = sidebarButtonsOther;
        //since there is just one
        $ctrl.getGroupContainer = getGroupContainer;

        $ctrl.getListIcon = getListIcon;
        $ctrl = new PageTreeInitCtrlService($ctrl, $element, _.extend({
            otherOptions: {
                listTreeServiceParams: _.extend({
                    getSearchFilter: getSearchFilter
                }, $ctrl.listTreeServiceParamsOther),
                sidebarOptions: _.extend({
                    sidebarButtonsOther: $ctrl.sidebarButtonsOther,
                    changedFields:['selectedFilter', 'treeType'],
                }, $ctrl.sidebarOptionsOther)
            }
        }, initOptions));

        $ctrl.hasSidebar = hasSidebar;
        $ctrl.onPageLoaded = onPageLoaded;

        $ctrl.canRenameList = canRenameList;

        return $ctrl;

        function getListIcon(item){
            return item.type === $ctrl.treeTypeScriptList ? 'stripboard' : $ctrl.itemIcon;
        }

        function getGroupContainer() {
            if($ctrl.withEmptyStateInGroup) {
                return '<div ng-if="$ctrl.hasLists(true)">' + $ctrl.getGroupContainerInit() + '</div>' +
                    '<div ng-if="!$ctrl.hasLists(true)">' + $ctrl.getEmptyStateBlock(null, true) + '</div>';
            }else{
                return $ctrl.getGroupContainerInit();
            }
        }

        function sidebarButtonsOther() {
            //add list under > this is called in tree
            var cls = 'col30 pull-left',
            group = $ctrl.nameForGroup;
            return '<li ng-if="$ctrl.listTreeService.isCustomList($ctrl.treeType)"><a ng-click="$ctrl.addItem($ctrl.treeType, {item: {type: $ctrl.treeType}, addFolder: false, isParent: $ctrl.listTreeService.active.selectedList&&$ctrl.listTreeService.active.selectedList.isFolder?true:false, useSelected: true, addFromBottom: true})" analytics-on analytics-action="New ' + $ctrl.nameForList + '">' +
                $ctrl.LCS.getISBDiv($ctrl.itemIcon , $ctrl.iconLevel, cls) +
                ' New ' + $ctrl.nameForList + '</a></li>' +
                //add folder under
                ($ctrl.hideAddNewGroup ? '' : ('<li><a ng-click="$ctrl.addItem($ctrl.treeType, {item: {type: $ctrl.treeType}, addFolder: true, isParent: false, useSelected: $ctrl.listTreeService.isCustomList($ctrl.treeType), addFromBottom: true})" analytics-on analytics-action="New {{$ctrl.treeType === 6 ? \'\' : \'Scene \'}}' + group + '">' +
                    $ctrl.LCS.getISBDiv($ctrl.iconForGroup , null, cls) +
                    ' New {{$ctrl.listTreeService.isCustomList($ctrl.treeType) ? \'\' : \'Scene \'}} ' + group + '</a></li>'));
        }

        function getSettings() {
            $ctrl.SettingsActions = [{
                id: 'btnAspectRatio',
                name: 'Aspect Ratio',
                icon: 'aspect-ratio',
                iconLevel: 3,
                type: 'aspectRatio',
                active: true,
                quotaType: $ctrl.quotaTypeCustomize
            },{
                id: 'btnNumbering',
                name: 'Numbering',
                icon: 'shot-specs',
                type: 'shotNumbering',
                active: true,
                quotaType: $ctrl.quotaTypeCustomize
            }];

            if ($ctrl.withDynamicCols) {
                $ctrl.SettingsActions.push({
                    id: 'btnShotSpecs',
                    name: $ctrl.btnCustomizeColumsTxt,
                    icon: 'cog',
                    type: 'shotSpecs',
                    //quotaType: $ctrl.quotaTypeCustomize
                });
            }
        }

        function getActiveLists(withActive) {
            var preLoadingService = $ctrl.scriptLoadingService,
                listTable = preLoadingService && preLoadingService.parentRel ? preLoadingService.parentRel.parent : ($ctrl.preloadingType ? ($ctrl.preloadingType + 'Lists') : ''),
                lists = preLoadingService ? preLoadingService.getObjectList(preLoadingService.TblTypes[listTable]) : null;
            if(lists && withActive) {
                lists = _.filter(lists, {type: $ctrl.treeType, active: $ctrl.selectedFilter !== false});
            }
            return lists;
        }

        function getListCount(withActive) {
            var lists = getActiveLists(withActive);
            return lists ? lists.length > 0 : 0;
        }

        function hasLists(checkActive) {
            //todo: if is collaborator & just one list might need to hide the sidebar
            var isNotEmpty = $ctrl.listTreeService.getListCount($ctrl.treeTypeScriptList) || $ctrl.listTreeService.getListCount($ctrl.treeTypeCustomList);
            return isNotEmpty && checkActive ? getListCount(true) : isNotEmpty;
        }

        function canRenameList(item) { //rename groups or custom lists
            return !item.isPredef && (item.isFolder || item.type === $ctrl.treeTypeCustomList);
        }

        function onPageTreeInit() {
            console.log('onPageTreeInit');
            getSettings();

            if($ctrl.hasScript){
                processForScript();
            } else{
                $ctrl.listTreeService.preloadingType = $ctrl.PreloadingTypes[$ctrl.preloadingType];
                $ctrl.onPageInit();
            }

            //loads only custom lists . the script lists come from scriptprovide
        }

        function processForScript() {
            //for both script and non script use the ShotLists Preloading option. ensure the params passed are correct to load all with (type=5 && scriptId or type=6) use it to populate shotslists and shots, since in script preloader they re not loaded
            $ctrl.getPreloadingService({
                withPreloaderProperty: withPreloaderProperty,
                preloadingType: $ctrl.PreloadingTypes[$ctrl.preloadingType],
            }, onsuccess);

            $ctrl.listTreeService.preloadingType = $ctrl.PreloadingTypes.Scripts;
            $ctrl.onPageInit(null, additionalScriptInit);

            //$ctrl.addRootWatcher('FULLSCREEN_CHANGED', onFullscreenChanged);

            function onsuccess(service) {
                console.log('preloadedItems');
                $ctrl.otherPreLoadingService = service;
                $ctrl.preloadedItems = true;
                onPreloading();
            }

            function additionalScriptInit() {
                console.log('preloadedScript');
                $ctrl.preloadedScript = true;
                onPreloading();

                return false;
            }

            function onPreloading() {
                console.log('onPreloading');
                if ($ctrl.preloadedItems && $ctrl.preloadedScript) {
                    //if there is a list start with that
                    var lists = getActiveLists(false);
                    if (lists && lists.length > 0) {
                        var params = $ctrl.SBStateService.getCurrentStateParams(),
                            listId = params ? params[$ctrl.listField] : null, list;
                        if (listId) {
                            list = _.find(lists, {_id: listId});
                            if (list) {
                                $ctrl.treeType = list.type;
                            }
                        }
                    }
                    set($ctrl.treeTypeCustomList, !set($ctrl.treeTypeScriptList, true));

                    $ctrl.preBroadcastPreload();
                    $ctrl.broadcastPreload();
                }

                function set(type, set) {
                    var count = lists ? _.filter(lists, {type: type}).length : 0;
                    $ctrl.listTreeService.setListCount(type, count > 0);
                    if (set && count && !$ctrl.treeType) {
                        $ctrl.treeType = type;
                        return true;
                    }
                    return false;
                }
            }
        }

        function onFullscreenChanged(newVal) {
            if (newVal && newVal.c === $ctrl.currentListId) {
                $ctrl.fullscreenList = true;
            } else if ($ctrl.fullscreenList) {
                $ctrl.fullscreenList = false;
            }
        }

        function getSidebarAddon() {
            return 'on-get-drp-selected-filters="$ctrl.getDrpSelectedFilters(filter)" ' +
                'service="$ctrl.service"';
        }

        function onChangedGroupFilters(type) {
            console.log('onChangedGroupFilters');
            if(type === 'treeType' || type === 'selectedFilter'){
                $ctrl.preBroadcastPreload();
            }
        }

        function preBroadcastPreload() {
            console.log('preBroadcastPreload');
            if (!$ctrl.hasScript) {
                return;
            }
            var isStrip = $ctrl.isScriptList();
            //default to custom lists
            $ctrl.listTreeService.groupPopulate = isStrip;
            $ctrl.listTreeService.preLoadingService = isStrip ? $ctrl.scriptLoadingService : $ctrl.otherPreLoadingService;
            $ctrl.listTreeService.preProcessTreeItem = isStrip ? $ctrl.preProcessTreeItem : null;
            $ctrl.hideAddList = isStrip;
            $ctrl.hideRemoveList = isStrip;
            $ctrl.listTreeService.withFontSmallForList = true;

            var hasQuotaTypeStrips = true;
            $ctrl.allStrips = $ctrl.scriptLoadingService.getProcessedStripsTables({
                type: 1
            }, 'scriptPosition', false, hasQuotaTypeStrips).strips;

            if ($ctrl.preBroadcastPreloadOther) {
                $ctrl.preBroadcastPreloadOther();
            }
        }

        function preProcessTreeItem(item) {
            if(item.stripId) {
                var strip = _.find($ctrl.allStrips, {_id: item.stripId});
                if (strip) {
                    item.name = 'Sc. ' + strip.sceneText + '  |  ' + strip.miniTitle +
                        (strip.active ? '' : '<span class="omitted">OMITTED</span>');
                }
            }
            return item;
        }

        function getParams() {
            return getParamsWithScriptId(getScriptId());
        }

        function getTreeFilters(item, treeType) {
            return item.type === treeType;
        }

        function withPreloaderProperty() {
            return getParamsWithScriptId($ctrl.CPS.scriptId);
        }

        function getParamsWithScriptId(scriptId){
            return {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                scriptId: scriptId
            }
        }

        function getScriptId(){
            return $ctrl.isCustomList() ? null : $ctrl.CPS.scriptId;
        }

        function onPageLoaded() {
            if(typeof($ctrl.onPageLoadedOther) === 'function') {
                $ctrl.onPageLoadedOther();
            }
        }

        function getCustomizeHideCond(){
            return $ctrl.isStoryboards;
        }

        function getSearchFilter(a, search) {
            if (search) {
                if (search.s) {
                    a.stripId = search.s;
                }
            }
            return a;
        }

        function hasSidebar() {
            return !($ctrl.CPS.isCollaborator && $ctrl.listTreeService.isSingleList);
        }

        function processSettings(type) {
            if(type === 'autoBreak'){
                var params = _.extend({
                    currentListId: $ctrl.listTreeService.active.selectedListId,
                    service: $ctrl.service,
                }, $ctrl.getParams());
                $ctrl.popupsService.open(null, $ctrl.popupsService.operations[type], params, $ctrl.compOptions);
            }

            return $ctrl.processSettingsInit(type);
        }

        function isScriptList(){
            return $ctrl.treeType === $ctrl.treeTypeScriptList;
        }
    }
}


angular.module('product.shots.firstListOrScript.component', [
])
.component('firstListOrScriptPopup', popupComponentParams('FirstListOrScriptPopupCtrl'))
.controller('FirstListOrScriptPopupCtrl', FirstListOrScriptPopupCtrl);

FirstListOrScriptPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', '$element'];

function FirstListOrScriptPopupCtrl(ItemTemplateCompileCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.selectTreeType = selectTreeType;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function getPopupBodyContent() {
        var n = $ctrl.nameForList.toLowerCase();
    return '<style>' +
        '.table-div {color:#2C3042; height:150px; margin-top:20px}' +
        '.table-div > div{vertical-align:middle}'+
        '.table-div .col:hover .h{color:#6E3EFF}' +
        '.table-div .col .h,.table-div .col .b{display: block;width: 100%;text-align:center; }'+
        '.table-div .col .h{font-size: 13px; font-weight:bold;margin-bottom:8px;margin-top:8px;line-height:1.8 }'+
        '.table-div .col .b{font-size: 12px;line-height:1.4 }'+
        '.table-div .or{font-size:14px;}' +
        '.table-div .col > div{color:#2C3042; line-height:1.8;border-radius: 10px; border:3px solid transparent;padding:24px 30px;min-height:160px; width: 200px;-webkit-transition: all .2s ease-out;-o-transition: all .2s ease-out;-ms-transition: all .2s ease-out;-moz-transition: all .2s ease-out; transition: all .2s ease-out; box-shadow: 0 0 14px 0 rgba(0,0,0,0.1)}' +
        '.table-div .col:hover > div{border-color: #6E3EFF; }' +
        '.table-div .col .img{background-repeat:no-repeat; background-size:auto 100%;background-position: center;height:40px;}' +
        '.table-div .or{font-weight: 600;font-size:14px;padding:24px 20px}'+
        '</style>' +

        '<div class="table-div">' +
                '<div class="'+$ctrl.getBtnActionCls()+' col with-cursor" data-type="selectTreeType" data-info="5">' +
                    '<div>' +
                         getImg('import.svg') +
                        '<div class="h">Import Script</div>' +
                        '<div class="b">Generate '+n+'s for every scene</div>' +
                    '</div>' +
                '</div>' +

                '<div class="centered col40 text-center or hide-ipad"><span class="gray">or</span></div>'+

                '<div class="'+$ctrl.getBtnActionCls()+' col with-cursor" data-type="selectTreeType" data-info="6">' +
                    '<div>' +
                         getImg('1'+($ctrl.isStoryboards? '':'-dark')+'.svg') +
                        '<div class="h">Create Manually</div>' +
                        '<div class="b">No script? Create '+n+'s as you go.</div>' +
                    '</div>' +
                '</div>' +
        '</div>';

        function getImg(img){
            return '<div class="img" style="background-image:url('+$ctrl.LCS.getImgUrl('emptystate/'+$ctrl.overviewBlockType +'/'+img)+ ')"></div>';
        }
    }

    function setTemplateData() {
        //$ctrl.withCloseBtn = true;
        $ctrl.withFooterBtns = false;
        $ctrl.icon = $ctrl.itemIcon;

        $ctrl.popupTitle = 'Getting Started';
    }

    function selectTreeType(id){
        if ($ctrl.onClose) {
            $ctrl.onClose({result: {treeType: parseInt(id, 10)}});
        }
    }
}


angular.module('product.shots.firstShotList.component', [
])
.component('firstShotlistPopup', popupComponentParams('SettingsShotListPopupCtrl'));

angular.module('product.shots.firstShotList.service', [
    'ctrl.popups.columnSettings.controller.service',
    'product.shots.shotUploads.component',
    'filters.controller.service'
])
.controller('SettingsShotListPopupCtrl', SettingsShotListPopupCtrl);

SettingsShotListPopupCtrl.$inject = ['ColumnSettingsPopupCtrlService', 'TemplateCompileService', '$element'];
function SettingsShotListPopupCtrl(ColumnSettingsPopupCtrlService, TemplateCompileService, $element) {
    var $ctrl = this;

    $ctrl.uploaderWrapper = 'upload-images-wrapper';

    $ctrl.withCloseBtn = true;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onInitOther = onInitOther;
    $ctrl.createNewList = createNewList;
    $ctrl.onDestroy = onDestroy;
    $ctrl.addEmptyShots = addEmptyShots;
    $ctrl.closeShotUploads = closeShotUploads;
    $ctrl.changeGenProp = changeGenProp;
    $ctrl = new ColumnSettingsPopupCtrlService($ctrl, $element);

    function onDestroy() {
        $ctrl.removeWatchers();
        if ($ctrl.uploadCompile) {
            $ctrl.uploadCompile.destroyNewScope();
        }
    }
    function onInitOther() {
        $ctrl.icon = $ctrl.itemIcon;
        $ctrl.formHolder = {};
        $ctrl.currentListId = new ObjectId().toString();
        if($ctrl.item){
            $ctrl.item.name = null;
            $ctrl.item._id = $ctrl.currentListId;
        }

        init();
        $ctrl.addRootWatcher('FIRST_' + $ctrl.elemType + '_ADDED', onFirstListAdded);
    }

    function onLoaded(){
        setFocus();
    }

    function createNewList() {
        console.log('createNewList');
        $ctrl.broadcastRoot('ADD_LIST_FROM_TOP_' + $ctrl.elemType, {
            item: $ctrl.item
        });
    }

    function setFocus(){
        var el = $ctrl.element.querySelector('#name');
        if(el){el.focus();}
    }

    function init() {
        $ctrl.info = {
            Create: {
                title: 'Name Your ' + $ctrl.nameForList,
                subtitle: 'You can add more ' + $ctrl.nameForList.toLowerCase() + 's later.',
                getItemPopupTemplate: getFirstShotlistPopup
            },
            aspectRatio: {
                title: 'Select Aspect Ratio',
                subtitle: 'You can always change this later.',
                getPopupBodyContent: getAspectRatioPopup
            },
            framesPerRow: {
                title: 'Frames Per Row',
                subtitle: 'You can always change this later.',
                getPopupBodyContent: getFramesPerRowPopup
            },
            shotNumbering: {
                title: 'Select '+ ($ctrl.isStoryboards ? 'Frame' : 'Shot') + ' Numbering',
                subtitle: 'You can always change this later.',
                getPopupBodyContent: getShotNumberingPopup
            },
            shotSpecs: {
                title: $ctrl.isStoryboards? 'Adjust Frame Details' : 'Adjust Shot Specs',
                subtitle: 'You can always change this later.',
                getPopupBodyContent: $ctrl.getColumnsContent
            },
            shotViewTypes: {
                title: 'Select Preferred View',
                subtitle: 'You can always change this later.',
                getPopupBodyContent: getShotViewTypesPopup
            },
            uploadImages: {
                title: 'Great! Let’s get started.',
                subtitle: 'Select one.',
                getPopupBodyContent: getUploadImagesPopup
            }
        };

        $ctrl.MoreFilters.AspectRatios = $ctrl.filtersService.getColumnsItems($ctrl.Settings.AspectRatios);
        $ctrl.MoreFilters.ShotTypes = $ctrl.filtersService.getColumnsItems($ctrl.Settings.ShotTypes);

        var type = $ctrl.type;
        var info = $ctrl.info[type];

        if (type !== 'Create') {
            $ctrl.type = 'Edit';
            $ctrl.withBtnDisabled = false;
            $ctrl.withFooterBtns = false;
            if (info.title) {
                $ctrl.popupTitle = info.title;
            }
            if (info.subtitle) {
                $ctrl.subtitle = info.subtitle;
            }

            $ctrl.modalBodyFormClass = type === 'aspectRatio' ? 'full-width' : 'long500';
            $ctrl.getPopupBodyContent = info.getPopupBodyContent;
            $ctrl.btnText = '<span>Save</span><span class="hide-ipad"> Settings</span>';
        } else {
            $ctrl.withCloseBtn = true;
            $ctrl.type = 'Create';
            $ctrl.withFooterBtns = true;
            $ctrl.getItemPopupTemplate = info.getItemPopupTemplate;
            $ctrl.filtersService.setOptions(null);
        }
    }

    function getFirstShotlistPopup() {
        var clsModal = 'sb-modal-content-w fancy-scrollbar ultrathin ' + ' font-general font-general-16',
            previousBtn = '<div class="semibold">'+ getPrev (false, true) + '</div>',
            step2 = $ctrl.info[$ctrl.isStoryboards ? 'aspectRatio' : 'shotSpecs'],
/*       return $ctrl.getItemPopupMSForm([{
fCls: 'show-scrollbar-on-hover',
            btn: getbtn(true, false, true)
        },{

        }], null, false, null);*/
             pageClass = $ctrl.pageClass ? (' ' + $ctrl.pageClass + ' page-class'):'';
    return '<div ms-form class="full-width msform" on-next="$ctrl.msFormOnNext()">' +
                 '<fieldset class="fieldset show-scrollbar-on-hover"><div class="display-block clearfix">' +
                     $ctrl.getMobileBack(getbtn(true, false, true, true)) +
                     '<div class="'+clsModal+'">' +
                        $ctrl.getPopupHeaderForInfo( $ctrl.info.Create) +
                        '<div class="modal-body clearfix">' +
                            '<div class="clearfix centered centering max-width-424">' +
                                $ctrl.getErrorBlock() +
                                '<form class="full-width" name="$ctrl.formHolderItem[$ctrl.formName]" novalidate autocomplete="off">' +
                                    '<div class="form-group sbfgroup '+pageClass+'">' +
                                        $ctrl.LCS.getISBDiv('title', 2) +
                                         '<input placeholder="Enter shot list name…" class="form-control with-underline '+pageClass+'" type="text" id="name" name="name" ng-model="$ctrl.item.name" required>' +
                                         '<div ng-show="($ctrl.formHolderItem[$ctrl.formName].name.$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem[$ctrl.formName].name.$error.required" class="help-inline ng-hide">Name is required.</div>' +
                                         '<div ng-show="($ctrl.formHolderItem[$ctrl.formName].name.$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem[$ctrl.formName].name.$error.duplicate" class="help-inline ng-hide" ng-bind="$ctrl.formHolderItem[$ctrl.formName].name.$error.duplicate"></div>' +
                                     '</div>' +
                                '</form>' +
                             '</div>' +
                             '<ul class="progressdots">' +
                                 '<li><button class="with-primary-bg-before active '+pageClass+'"></button></li>' +
                                 '<li><button class="nextbtn" data-required="true"></button></li>'+
                                 ($ctrl.isStoryboards ? '<li><button></button></li>' :'') +
                                 '<li><button></button></li>' +
                             '</ul>' +
                        '</div>' +
                        $ctrl.getPopupFooter(getbtn(true, true, true, true),'long') +
                    '</div>' +
                 '</div></fieldset>' +

                '<fieldset class="fieldset show-scrollbar-on-hover"><div class="display-block clearfix">' +
                        $ctrl.getMobileBack($ctrl.isStoryboards ? getbtn(true, false) : btnCreateList(true, false), previousBtn) +
                        '<div class="'+clsModal+'">' +
                            $ctrl.getPopupHeaderForInfo(step2) +
                            '<div class="modal-body clearfix">' +
                                 step2.getPopupBodyContent() +
                                 '<ul class="progressdots">' +
                                     '<li><button class="previousbtn"></button></li>' +
                                     '<li><button class="with-primary-bg-before active '+pageClass+'"></button></li>' +
                                     ($ctrl.isStoryboards ? '<li><button class="nextbtn"></button></li>' : '') +
                                     '<li><button></button></li>' +
                                 '</ul>' +
                            '</div>' +
        $ctrl.getPopupFooter($ctrl.isStoryboards ? getbtn(true, true) : btnCreateList(true, true), 'long') +
                        '</div>' +
                '</div></fieldset>' +

                ($ctrl.isStoryboards ? ('<fieldset class="fieldset show-scrollbar-on-hover"><div class="display-block clearfix">' +
                    $ctrl.getMobileBack(btnCreateList(true, false), previousBtn) +
                    '<div class="'+clsModal+'">' +
                        $ctrl.getPopupHeaderForInfo( $ctrl.info.framesPerRow) +
                        '<div class="modal-body clearfix">' +
                            $ctrl.info.framesPerRow.getPopupBodyContent() +
                             '<ul class="progressdots">' +
                                 '<li><button></button></li>' +
                                 '<li><button class="previousbtn"></button></li>' +
                                 '<li><button class="with-primary-bg-before active '+pageClass+'"></button></li>' +
                                 '<li><button class="nextbtn"></button></li>' +
                             '</ul>' +
                        '</div>' +
                        $ctrl.getPopupFooter(btnCreateList(true, true), 'long') +
                    '</div>' +
                 '</div></fieldset>') : '') +

                '<fieldset class="fieldset show-scrollbar-on-hover"><div class="display-block clearfix">' +
                    $ctrl.getMobileBack(getbtn(true, false), previousBtn) +
                    '<div class="'+clsModal+'">' +
                        $ctrl.getPopupHeaderForInfo( $ctrl.info.uploadImages) +
                        '<div class="modal-body clearfix">' +
                            $ctrl.info.uploadImages.getPopupBodyContent() +
                        '</div>' +
                        //$ctrl.getPopupFooter(getbtn(true, true), 'long') +
                    '</div>' +
                 '</div></fieldset>' +

             '</div>';

        function getbtninit(hidePrev, hideNext, method, hasRequire) {
            return getPrev(hidePrev) + getNext();

            function getNext() {
                return '<button ' + (hasRequire ? 'data-required="true"' : '') + ' class="max-width200 btn btn-primary nextbtn ' + pageClass + ' ' +
                    (method ? (' ' + $ctrl.getBtnActionCls() + ' ') : '') +
                    (hideNext ? 'hide-ipad' : '') + '" type="button" ' +
                    (method ? ('data-type="' + method + '"') : '') +

                    '>Next »</button>';
            }
        }
        function getPrev(hidePrev, isIpad) {
            return '<button class="btn btn-small transparent big previousbtn '+
                (isIpad ? '' : ('margin-right10 max-width200 ' +
                    //$ctrl.pageClass+'-outline '+
                    (hidePrev ? 'hide-ipad' : '')))+
                '" type="button">« Previous</button>';
        }

        function getbtn(hidePrev, hideNext, isFirst, hasRequire) {
            return isFirst ? ('<button data-required="true" class="max-width200 btn btn-primary nextbtn '+ pageClass+' ' + (hideNext ? 'hide-ipad' : '') +'" type="submit" ng-disabled="!$ctrl.formHolderItem[$ctrl.formName].$valid">Next »</button>') :
                getbtninit(hidePrev, hideNext, null, hasRequire);
        }

        function btnCreateList(hidePrev, hideNext) {
            return getbtninit(hidePrev, hideNext, 'createNewList');
        }
    }

    function getShotNumberingPopup() {
        return getGrid('ShotTypes', 'type', '', 'shot-numerical', null);
    }

    function getAspectRatioPopup() {
        return getGrid('AspectRatios', 'ratio', 'aspect-ratio-wrapper', '', null);
    }

    function getFramesPerRowPopup() {
        return getGrid('ColumnsPerRow', 'column', 'frames-wrapper', 'frames', 'col-md-6 col-sm-6 col-xs-12');
    }

    function changeGenProp(p, e) {
        var s = p.split('|');
        $ctrl.changeCProp(e, s[0], s[1], s[2], s[3]);
    }

    function getGrid(c, type, cls, cls2, cls3) {
        if(!cls3){
            cls3 = 'col-md-4 col-sm-4 col-xs-6';
        }
        var el = '';
        for(var prop in $ctrl.MoreFilters[c].l){
            var v = $ctrl.MoreFilters[c].l[prop];
            if(v){ 
                _.each(v, function (item, i) {
                    if (!item.isHeader && !item.hide) {
                        var p = '\'' + type + '\', \'' + c + '\', \'' + prop + '\', ' + i + '',
                            info=   type + '|' + c + '|' + prop + '|' + i + '';
                        el += '<div class="product-box shotListTypes ' + cls3 + ' ' +$ctrl.getBtnActionCls()+'" ' +
                                'data-type="changeGenProp" data-info="' +info+'" ' +
                                'ng-class="{\'active with-primary-border\':$ctrl.isCProp(' + p + ')}" ' +
                             'analytics-on analytics-action="' + item.name + '" ' +
                              '>' +
                                getitem(item, cls2, type) +
                              '</div>';


                    }
                });
            }
        }

    return '<div class="form-group last margin-top-half">' +
                '<div class="feature-selector  '+$ctrl.pageClass+' product-boxes clearfix tooltip-bigger inline ' + cls + '">' +
                    el +
                '</div>' +
            '</div>';
    }

    function getShotViewTypesPopup() {
        return getGrid( 'ViewModes', 'view', 'shotlistview aspect-ratio-wrapper', null, null);
    }
    
    function getitem(item, cls, type) {
        var isRatio = type === 'ratio',isType = type === 'type';
return '<div class="table-div">' +
            '<div class="centered">' +
                '<div>' +
                    '<div class="circle-check"><span class="sbf check-mark"></span></div>' +
                    '<div class="icon text-center shotlistmodal ' + (cls ? cls : '') + ' ' +
                        (isRatio ?  (item.icon + ' with-svg') : (isType ? '' : item.icon)) +
                    '">' +
                        (isRatio ? ('<div>' + $ctrl.Settings.RatiosImages[item.icon] + '</div>') : (isType ? ($ctrl.LCS.getISBDiv( item.icon,2, 'sbf30 gray')) : '')) +
                    '</div>' +
                    '<div class="name text-center">' + item.name + '</div>' +
                '</div>' +
            '</div>' +
        '</div>';
    }

    function getUploadImagesPopup() {
return '<div class="' + $ctrl.uploaderWrapper + ' margin-bottom spacing-half-bottom">' +
            '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '" ng-if="!$ctrl.isListLoaded"></preloader-center>' +
       '</div>';
    }

    function onFirstListAdded(currentList){
        $ctrl.currentList = currentList;
        if(!$ctrl.extraParam){
            $ctrl.extraParam = {};
        }
        if(!$ctrl.extraParam.btnUploadText) {
            $ctrl.extraParam.btnUploadText = 'UploadImages';
        }
        $ctrl.extraParam.addEmptyShots = $ctrl.addEmptyShots;

        if (!$ctrl.uploadCompile) {
            var el = $ctrl.element.querySelector('.' + $ctrl.uploaderWrapper);
            if(el) {
                $ctrl.uploadCompile = new TemplateCompileService(angular.element(el), getTemplate, $ctrl);
            }
        }
        if($ctrl.uploadCompile) {
            $ctrl.uploadCompile.loadTemplate(function () {
                console.log('template loaded');
                $ctrl.isListLoaded = true;
            });
        }

        function getTemplate(){
            var tag = 'shot-uploads';
            return '<' + tag + ' ' +
                'item="$ctrl.currentList" ' +
                'extra-param="::$ctrl.extraParam" ' +
                'comp-options="::$ctrl.compOptions" ' +
                'on-close="$ctrl.closeShotUploads(result)"' +
                'class="'+tag+'" ' +
                '></' + tag + '>'
                //+getProgressBtns();
        }

        function getProgressBtns(){
           return '<ul class="progressdots">' +
            '<li><button></button></li>' +
            '<li><button></button></li>' +
            '<li><button class="previousbtn"></button></li>' +
            '<li><button class="with-primary-bg-before active '+($ctrl.pageClass || '')+'"></button></li>' +
            '</ul>';
        }
    }

    function addEmptyShots(result) {
        console.log('addEmptyShots');
        $ctrl.broadcastRoot('ADD_EMPTY_' + $ctrl.elemType + '_' + $ctrl.currentList._id, {
            count: result && result.count ? result.count : $ctrl.currentList.count,
            next: next
        });

        function next(err, result) {
            if(err) {
                if (err.name === 'LimitExceededError') {
                    $ctrl.error = err.message;
                    $ctrl.CPS.loadQuotaPopup($ctrl.quotaType, function (){}, $ctrl.maxFreeItemsCount, err.count, $ctrl.compOptions);
                } else {
                    $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.shot.Create.error', 'error');
                    $ctrl.closePopup();
                }
            }else {
                $ctrl.closePopup();
            }
        }
    }

    function closeShotUploads(){
        console.log('closeShotUploads');
        $ctrl.closePopup();
    }
}

angular.module('product.shots.group.popup.component', [
