                formGroupClass = ' form-group field';
            $ctrl.projectTypeDrpCol = {
                canEdit: true,
                type: $ctrl.SBFieldTypesService.PropTypes.Drp,
                formGroupClass: formGroupClass,
                drpMenuCls: 'col390 centered projectDrp',
                eClassAttr: eClassAttr,
                cClassAttr: 'autoheight long-caret',
                fieldClass: 'form-control with-underline ' + ($ctrl.pageClass || ''),
                initListName: 'productTypes',
                prop: 'productionType',
                icon: 'project',
                itemLabel: 'name',
                itemValue: 'id',
                parentContainer: true,
                onChange: "$ctrl.changeProductTypeId(result)",
                /* otherHtml: '<div class="wide-tooltip hide-ipad position-absolute" style="height: 0;left:100%;top:0">' +
                     '<div style="right:-20px;top:0" class="sbf info blueish position-absolute" tooltip-placement="left" tooltip="Automatically populates call sheet details based on the shoot day. Shoot days are defined by the daybreaks you add on the Stripboard page.">' +
                     $ctrl.LCS.getISBPath(3) +
                     '</div>' +
                     '</div>'*/
            };
        }
        else {//not used
            $ctrl.isBlock = function (id) {
                return $ctrl.checks && $ctrl.checks[id] === true;
            };
            $ctrl.changeBlock = function (id, e) {
                $ctrl.checks[id] = $ctrl.checks[id] ? false : true;
                if(id === $ctrl.scriptFeatureId) {
                    $ctrl.setWithImport();
                }
            };
        }
    }

    function postInitGeneral(){
        var c = $ctrl.security.getCurrentCompany();
        if(c) {
            if (!$ctrl.item.production) {
                $ctrl.item.production = c.name;
            }
            if (!$ctrl.item.address) {
                $ctrl.item.address = c.address;
            }
        }
        $ctrl.overviewBlocks = $ctrl.extraParam.overviewBlocks;
        $ctrl.customOverviewBlocks = $ctrl.extraParam.customOverviewBlocks;

        if ($ctrl.isDuplicate) {
            $ctrl.item.sendEmails = false;
            $ctrl.item.toduplicate = {contacts: true, script: true, locations: true, workflow: true, callsheets: true};
        }

        $ctrl.imageResult = null;

        $ctrl.save = save;

        if ($ctrl.isNew) {
            if ($ctrl.groupByFeatures) {
                changeProductTypeId({selected: {val: $ctrl.productTypes[0].id}}, true);
            } else {
                initFeaturesChecks();
            }
        }
    }

    function preSetTemplateData() {
        $ctrl.modalBodyFormClass = 'longest';
    }

    function computeOverviewBlocks(){
        return $ctrl.groupByFeatures ? $ctrl.overviewBlockIds : getOverviewBlockIds();

        function getOverviewBlockIds() {
            var overviewBlockIds = [],
                toRemove = [],

                addCustom = function (list) {
                    for (var id in list) {
                        var el = list[id];
                        if ($ctrl.checks[id]) {
                            overviewBlockIds.push(id);
                            //add unselectable parent
                            addUnselectableParent(el.parentNavId);
                        }
                    }

                    if (toRemove.indexOf(id) === -1 && isUnsParent(el) && !_.find(overviewBlockIds, function (id1) {
                        var el = list[id1];
                        return el && el.parentNavId === id;
                    })) {
                        toRemove.push(id);
                    }

                    function isUnsParent(p) {
                        return p && p.mainNav && !p.isSelectable;
                    }

                    function addUnselectableParent(parentId) {
                        if (parentId) {
                            var p = list[parentId];
                            if (p.mainNav && !p.isSelectable && overviewBlockIds.indexOf(parentId) === -1) {
                                overviewBlockIds.push(parentId);
                            }
                        }
                    }
                },
                add = function (list) {
                    for (var id in list) {
                        if ($ctrl.parents[id]) {
                            _.filter(list, function (item) {
                                if (item.parentNavId === id && item.mainNav && item.isSelectable && !_.find(overviewBlockIds, item._id)) {
                                    overviewBlockIds.push(item._id);
                                }
                            })
                        }
                    }
                };

            addCustom($ctrl.customOverviewBlocks);
            add($ctrl.overviewBlocks);

            if (toRemove.length > 0) {
                overviewBlockIds = _.difference(overviewBlockIds, toRemove);
            }

            return overviewBlockIds;
        }
    }

    function setWithImport(){
        if($ctrl.isNew) {
            $ctrl.item.overviewBlockIds = computeOverviewBlocks();
            $ctrl.withImport = _.find($ctrl.item.overviewBlockIds, function (id) {
                return id === $ctrl.scriptFeatureId;
            });
            updateBtn();
        }
    }

    function save(e) {
        $ctrl.preventDefault(e);
        if($ctrl.isUpdating || !$ctrl.isValidForm()){return;}

        $ctrl.isUpdating = true;
        if ($ctrl.isNew) {
            /* if(!$ctrl.item.parentId){
                 $ctrl.error = 'Select the project type';
             } else{
             */

            $ctrl.service.insert($ctrl.item, onSuccessInsert, $ctrl.onCustomError);
        } else if ($ctrl.isDuplicate) {
            $ctrl.service.duplicate({
                productId: $ctrl.item._id,
                name: $ctrl.item.name,
                address: $ctrl.item.address,
                production: $ctrl.item.production,
                logo: $ctrl.item.logo,
                settingsId: $ctrl.item.settingsId,
                active: true,
                toduplicate: $ctrl.item.toduplicate
            }, onSuccessInsert, $ctrl.onCustomError);
        } else {
            var changedFields = $ctrl.service.getChangedFieldForUpdate();
            var updates = $ctrl.service.getChanges(changedFields, $ctrl.item, $ctrl.copyItem);
            if (updates) {
                updates._id = $ctrl.item._id;
                $ctrl.service.update(updates, function (result) {
                    $ctrl.onListItemSave(result, updates, false);
                }, $ctrl.onCustomError);
            } else {
                $ctrl.onListItemSave(null, null, false);
            }
        }
    }

    function changeProductType(selected) {
        if ($ctrl.item.parentId !== selected.val) {
            setProductType(selected.val);
        }
    }

    function isGroup(id) {
        return $ctrl.parents && $ctrl.parents[id] === true;
    }

    function changeGroup(id, e) {
        $ctrl.parents[id] = $ctrl.parents[id] ? false : true;
    }

    function selectProductType(el) {
        $ctrl.item.parentId = el._id;
        var checks = {}, parents = {};
        for (var i = 0, n = el.overviewBlockIds.length; i < n; i++) {
            var id = el.overviewBlockIds[i], block = $ctrl.overviewBlocks[id];
            if (block) {
                parents[$ctrl.overviewBlocks[id].parentNavId] = true;
            } else {
                block = $ctrl.customOverviewBlocks[id];
                if (block) {
                    checks[id] = true;
                }
            }
        }
        $ctrl.checks = checks;
        $ctrl.parents = parents;
    }

    function setProductType(val) {
        for (var j = 0, m = $ctrl.productTypes.length; j < m; j++) {
            var el = $ctrl.productTypes[j];
            if (el._id === val) {
                selectProductType(el);
                break;
            }
        }
    }

    function onSuccessInsert(result) {
        if (result) {
            if (result && result.subscription) {
                $ctrl.SessionService.broadcastUpdateSubscription(result.subscription);
            }
            var item = result.item;
            if (item) {
                $ctrl.onListItemSave(result, null, false);
                var p = {productId: item._id};
                if ($ctrl.withImport) {
                    p.import = true;
                }
                $ctrl.CPS.transitionTo('user.product.overview', $ctrl.CPS.currentPathParams(p));
            }
        }
    }

    function saveNonNg(id, e){
        $ctrl.save(e);
    }

    function isChecked(p, e){
        $ctrl.item[p] = $ctrl.item[p] ? false:true;
    }

    function updateBtn() {
        var submitCls = 'submitbtn ' + $ctrl.getBtnActionCls(),
            btns = $ctrl.element.querySelectorAll('#btnImport');

        if (btns) {
            _.each(btns, function (btnImport) {
                if ($ctrl.withImport) { //should become next
                    _.each(['data-type', 'analytics-on', 'analytics-action'], function (p) {
                        btnImport.removeAttribute(p);
                    });

                    $ctrl.LCS.replaceClass(btnImport, submitCls, 'nextbtn');
                } else { //should become create project
                    btnImport.setAttribute('data-type', 'save');
                    btnImport.setAttribute('analytics-on', '');
                    btnImport.setAttribute('analytics-action', getProjectBtnAction());
                    $ctrl.LCS.replaceClass(btnImport, 'nextbtn', submitCls);
                }

                var el1 = btnImport.querySelector('#txt');
                if (el1) {
                    el1.innerHTML = $ctrl.withImport ? 'Import Script' : getProjectBtnTxt();
                }
                btnImport.setAttribute('type', $ctrl.withImport ? 'button' : 'submit');
            });
        }

        var els = $ctrl.element.querySelectorAll('.liStep2Btn1');
        if (els && els.length > 0) {
            _.each(els, function (el) {
                $ctrl.LCS[$ctrl.withImport ? 'removeClass' : 'addClass'](el, 'sb-hide');
            });
        }
    }

    function getProjectBtnAction() {
        return 'Project ' + ($ctrl.isNew ? 'Created' : ($ctrl.isDuplicate ? 'Duplicated' : 'Saved'));
    }

    function getProjectBtnTxt() {
        return '<span>' + (($ctrl.isNew ? 'Create' : ($ctrl.isDuplicate ? 'Duplicate' : 'Rename')) + '</span><span class="hide-ipad"> ' + $ctrl.itemTitle + '</span>');
    }
    function getItemPopupTemplate() {

        var l = [{
            btn: getFirstStepBtn(),
            fCls: 'transparent step1' ,
            //cls: 'maxwidth550',
            body: getFirstBody(),
            headerInfo: {
                icon: $ctrl.icon,
                iconLevel: $ctrl.iconLevel,
                title: ($ctrl.isNew || $ctrl.isDuplicate) ? 'Name Your Project' : 'Rename Project',
            }
        }];

        if ($ctrl.isNew || $ctrl.isDuplicate) {
            l.push({
                btn: getSecStepBtn(),
                body: getSecBody(),
                headerInfo: {
                    icon: $ctrl.icon,
                    iconLevel: $ctrl.iconLevel,
                    title: getSecStepTitle(),
                   // subtitle: 'You can always readjust these later.'
                }
            });
        }

        if ($ctrl.isNew) {
            l.push({
                btn: getSaveBtn(),
                body: getImportBody(),
                headerInfo: {
                    icon: $ctrl.icon,
                    iconLevel: $ctrl.iconLevel,
                    title: 'Import Script',
                    subtitle: 'If you have an existing screenplay (FDX, PDF, Fountain), you can import it now. You can always import later as well.'
                }
            });
        }

        return $ctrl.getItemPopupMSForm(l, 'with-small', false);

        function getFirstStepBtn() {
            return ($ctrl.isNew || $ctrl.isDuplicate) ? getNext('Next', true) : getSaveBtn();
        }

        function getFirstBody() {
            return '<div class="centering max-width-390" >' + $ctrl.getPopupForm() + '</div>' +
                (($ctrl.isNew || $ctrl.isDuplicate) ? ('<ul class="progressdots hide-ipad">' +
                    '<li><button class="with-primary-bg-before active"></button></li>' +
                    '<li><button class="nextbtn" sibling="1" data-required="true" ng-disabled="$ctrl.isBtnDisabled()"></button></li>' +
                    '<li class="liStep2Btn1 '+($ctrl.withImport ? '' : 'sb-hide')+'"><button class="nextbtn" sibling="2"></button></li>' +
                    '</ul>') : '');
        }

        function getSecBody() {
            return (($ctrl.isNew
                    //|| $ctrl.isDuplicate
                ) ? ($ctrl.groupByFeatures ? getFeaturesByProjectType() : getFeaturesByParent()) : '') +
                ($ctrl.isDuplicate ? (
                    getRowSwitch('Duplicate Task Cards', 'toduplicate.workflow') +
                    getRowSwitch('Duplicate Project Contacts', 'toduplicate.contacts') +
                    getRowSwitch('Duplicate Stripboard & Breakdowns', 'toduplicate.script') +
                    getRowSwitch('Duplicate Call Sheets', 'toduplicate.callsheets')) : '') +

                '<ul class="progressdots hide-ipad ' + ($ctrl.pageClass || '') + '">' +
                    '<li><button class="previousbtn"></button></li>' +
                    '<li><button class="with-primary-bg-before active"></button></li>' +
                    '<li class="liStep2Btn1  '+($ctrl.withImport ? '' : 'sb-hide')+'"><button class="nextbtn" sibling="1"></button></li>' +
                '</ul>';

            function getRowSwitch(txt, prop) {
        return '<div class="field border-bottom">' +
                    '<div class="pull-left">' + txt + '</div>' +
                    '<div class="custom-checkbox pull-right ' + $ctrl.getBtnActionCls() + ' ' + ($ctrl.pageClass || '') + '" data-type="isChecked" data-info="' + prop + '">' +
                        '<label class="i-switch"><input type="checkbox" ' + ($ctrl.item[prop] ? 'checked="checked"' : '') + '><i></i></label>' +
                    '</div>' +
                '</div>';
            }

            function getFeaturesByParent() {
                return '<div class="feature-selector product-boxes with-opacity clearfix tooltip-bigger inline">' +
                    getList($ctrl.customOverviewBlocks, true) +
                    getList($ctrl.overviewBlocks, false) +
                    '</div>';

                function getList(l, isCustom) {
                    var list = [];
                    for (var id in l) {
                        var ov = l[id];
                        if (ov && (isCustom && ov.isSelectable || !isCustom && ov.isParent && ov.mainNav)) {
                            list.push(ov);
                        }
                    }

                    return _.sortBy(list, 'order').map(function (el) {
                        return '<div data-type="' + (isCustom ? 'changeBlock' : 'changeGroup') + '" data-info="' + ov._id + '" class="active with-primary-border product-box ' + ov.icon + ' ' + $ctrl.getBtnActionCls() + '">' +
                            '<div class="table-div">' +
                            '<div class="centered col30">' +
                            '<div class="circle-check with-empty"' +
                            ' ng-class="{\'checked\':$ctrl.' + (isCustom ? 'isBlock' : 'isGroup') + '(\'' + ov._id + '\')}"' +
                            '>' +
                            '<span class="sbf check-mark"></span></div>' +
                            '</div>' +
                            '<div class="centered col80">' +
                            '<div class="' + (ov.icon + ' ' + (ov.isSolution ? 'circled-svg-colored small60 ' : 'icon text-center')) + '">' +
                            (ov.icon ? $ctrl.LCS.getISBDiv(ov.icon + (ov.isSolution ? '-color' : ''), ov.iconLevel) : '') +
                            '</div>' +
                            '</div>' +
                            '<div class="centered">' +
                            '<div>' +

                            '<div class="name">' + (ov.shortName ? ov.shortName : ov.name) + '</div>' +
                            '<div class="desc">' + ov.description + '</div>' +
                            '</div>' +
                            '</div>' +
                            '</div>' +
                            '</div>';
                    }).join('');
                }
            }

            function getFeaturesByProjectType() {
            return '<div class="colmax394 centered">' +
                        $ctrl.getPopupFormForSelectedCol($ctrl.projectTypeDrpCol) +
                        '<div class="full-width margin-bottom-40 margin-top-30"><a class="' + $ctrl.btnToggleCls + ' gray table-div full-width ' + $ctrl.getBtnActionCls() + '" data-type="toggleFeatures">' +
                            '<div class="col40 centered">' + $ctrl.LCS.getISBDiv(getArrowCls()) + '</div>' +
                            '<div class="centered"> ' + $ctrl.btnToggleText + '</div>' +
                        '</a></div>' +
                    '</div>' +
                    '<div class="features-wrapper centered ' + ($ctrl.showToggled ? '' : 'sb-hide') + '">' +
                        '<div class="text">These are the recommended features based on your project type. <br/> Feel free to adjust. You can readjust these at any time.</div>' +
                        '<div class="feature-selector product-boxes-by-parent clearfix centered">' + $ctrl.getBlocks(true) + '</div>' +
                    '</div>';
            }
        }

        function getSecStepTitle(){
            return $ctrl.groupByFeatures ? ('Select Type<span class="hide-ipad"> of Production</span>') : ('Select <span class="hide-ipad">Project Solutions</span>');
        }

        function getSecStepBtn() {
            var id = 'btnImport';
            return $ctrl.withImport ? getNext('Import Script', true, id) : getSaveBtn(id, true);
            //<button data-required="true" class="max-width300 btn btn-primary nextbtn" ng-disabled="$ctrl.isUpdating===true||$ctrl.isBtnDisabled()" ng-class="{'disabled':$ctrl.isUpdating===true||$ctrl.isBtnDisabled()}" type="button" style="">Next</button>
        }

        function getNext(txt, isReq, id) {
            return getnextbtn(id, isReq, 'nextbtn', txt, null, 'button');
        }

        function getSaveBtn(id, isReq) {
            var cls = 'submitbtn ' + $ctrl.getBtnActionCls(),
                other = ' data-type="save" analytics-on analytics-action="' + getProjectBtnAction() + '" ';
            return getnextbtn(id, isReq, cls, getProjectBtnTxt(), other, 'submit');
        }

        function getnextbtn(id, isReq, cls, txt,other,type){

            return '<button ' + (id ? ('id="' + id + '" ') : '') +
                'class="max-width300 btn btn-primary ' + cls + '" ' +
                (isReq ? 'data-required="true" ' : '') +
                getDisabled() +
                'type="'+type+'" ' +
                (other || '') + '>' + getLoader() + ' <span id="txt">' + txt + '</span></button>';
        }

        function getLoader() {
            return '<span class="sbf loadingicon animate-spin pull-left ng-hide" ng-show="$ctrl.isUpdating===true"></span> ';
        }

        function getDisabled() {
            return 'ng-disabled="' + $ctrl.disabledText + '" ng-class="{\'disabled\':' + $ctrl.disabledText + '}" ';
        }

        function getImportBody(){
            return '<div class="import-script-section">' +
                getRowSwitch('Yes, I have a script file I’d like to import now', true, true) +
                getRowSwitch('No, I don’t have a script at this time', false) +
            '</div>' +

            '<ul class="progressdots hide-ipad ' + ($ctrl.pageClass||'') + '">' +
                '<li><button class="previousbtn" sibling="2"></button></li>' +
                '<li><button class="previousbtn" sibling="1"></button></li>' +
                '<li><button class="with-primary-bg-before active"></button></li>' +
            '</ul>';

            function getRowSwitch(txt, prop, isActive) {
                return '<div class="import-item table-div full-width with-cursor with-transition ' + $ctrl.getBtnActionCls() + (isActive ? ' active' : '') + '" data-type="toggleImportScript" data-info="' + prop + '">' +
                    '<div class="with-check-mark text-center centered"></div>' +
                    '<div class="txt centered">' + txt + '</div>' +
                    '</div>';
            }
        }
    }

    function toggleFeatures(){
        $ctrl.showToggled = $ctrl.showToggled ? false : true;
        var btn = $ctrl.element.querySelector('.' + $ctrl.btnToggleCls);
        if (btn) {
            $ctrl.LCS.replaceClass(btn.querySelector('.sbf'), getArrowCls(true), getArrowCls());
        }

        var wrapper = $ctrl.element.querySelector('.features-wrapper');
        if (wrapper) {
            $ctrl.LCS[$ctrl.showToggled ? 'removeClass' : 'addClass'](wrapper, 'sb-hide');
        }
    }

    function getArrowCls(reversed) {
        if (reversed) {
            return $ctrl.showToggled ? 'arrow-right-big' : 'arrow-down';
        }
        return $ctrl.showToggled ? 'arrow-down' : 'arrow-right-big';
    }

    function changeProductTypeId(result, onLoad) {
        if (result) {
            if (onLoad) {
                process();
            } else {
                $ctrl.LCS.timeout(process, 100);
            }
        }

        function process() {
            $ctrl.item.productionType = result.selected.val;
            $ctrl.overviewBlockIds = _.find($ctrl.productTypes, {id: $ctrl.item.productionType}).ids;

            if(!onLoad) {
                $ctrl.initFeaturesByProjectType();
            }
            $ctrl.setWithImport();
        }
    }

    function initFeaturesChecks() {
        var checks = {}, list = $ctrl.customOverviewBlocks;
        for (var prop in list) {
            var item = list[prop];
            if (item.isSelectable) {
                checks[prop] = true;
            }
        }
        $ctrl.checks = checks;
        var parents = {};
        list = $ctrl.overviewBlocks;
        for (var prop in list) {
            var item = list[prop];
            if (item.isParent && item.mainNav) {
                parents[prop] = true;
            }
        }
        $ctrl.parents = parents;

        $ctrl.setWithImport();
    }

    function toggleImportScript(id, e) {
        $ctrl.withImport = id === true || id === 'true';
        var els = $ctrl.LCS.findClosestParent(e.currentTarget, '.import-script-section').children;
        _.each(els, function (el) {
            var v = el.getAttribute('data-info'),
                isTrue = v === true || v === 'true';
            $ctrl.LCS[($ctrl.withImport && isTrue || !$ctrl.withImport && !isTrue) ? 'addClass' : 'removeClass'](el, 'active');
        });
    }

    function msFormOnNext(e){
        var el = e ? e.currentTarget : null;
        if( $ctrl.isNew && el && el.getAttribute('id') === 'btnImport'){
            var type = el.getAttribute('data-type');
            if(type && $ctrl[type]){//save
                $ctrl[type]();
                return false;
            }
        }
        return true;
    }
}

angular.module('user.search', [
])
.service('SearchInitCtrlService', SearchInitCtrlService);
SearchInitCtrlService.$inject = [];
function SearchInitCtrlService() {
    //$ctrl must include item & objectType
    return function ($ctrl) {
        if (!$ctrl.compLoaded) {
            throw ('parent for SearchInitCtrlService must inherit CompInitCtrlService');
        }
        var KEY = {
            TAB: 9,
            ENTER: 13,
            ESC: 27,
            SPACE: 32,
            LEFT: 37,
            UP: 38,
            RIGHT: 39,
            DOWN: 40
        };
        $ctrl.contactLists = null;

        if ($ctrl.withSearchTooltip === undefined) {
            $ctrl.withSearchTooltip = true;
        }
        if (!$ctrl.minLength) {
            $ctrl.minLength = 25;
        }
        $ctrl.selectedClass = "selected-items";
        $ctrl.avatarSize = 'smaller';
        $ctrl.errorNoMatch = 'Sorry, no results match';
        $ctrl.errorNoElem = 'Sorry, you don’t have any ' + $ctrl.objectType.toLowerCase() + 's';
        $ctrl.errormessageDuplicate = 'This ' + $ctrl.objectType + ' has already been added';

        $ctrl.$select = {
            selected: [],
            open: false,
            search: null,
            active: -1,
            searchField: $('#autosearch-field'),
            sendEmails: false
        };

        $ctrl.isDuplicate = false;
        $ctrl.isSearching = false;
        $ctrl.showResults = true;
        $ctrl.searchNull = false;

        $ctrl.isOpened = isOpened;
        $ctrl.setOpen = setOpen;
        $ctrl.isActive = isActive;
        $ctrl.setActive = setActive;
        $ctrl.move = move;
        $ctrl.clearSearch = clearSearch;

        $ctrl.areEqual = areEqual;
        $ctrl.existsItem = existsItem;
        $ctrl.addItem = addItem;
        $ctrl.removeItem = removeItem;
        $ctrl.hasItems = hasItems;
        $ctrl.getItems = getItems;
        $ctrl.getAssignedItem = getAssignedItem;
        $ctrl.getCheckedItem = getCheckedItem;
        $ctrl.assign = assign;
        $ctrl.onError = onError;
        $ctrl.onSave = onSave;
        $ctrl.onSearch = onSearch;
        $ctrl.getIcon = getIcon;
        $ctrl.getInitials = getInitials;
        $ctrl.getSearchForm = getSearchForm;

        if (!$ctrl.getDisplayName) {
            $ctrl.getDisplayName = getDisplayName;
            $ctrl.getEmail = getEmail;

        }

        if(!$ctrl.onSave){
            $ctrl.onSave = onSave;
        }
        $ctrl.$select.searchField
            .on('blur', onSearchBlur)
            .on('keydown', onSearchKeydown);

        return $ctrl;

        function onSearchKeydown(e) {
            if (e.which === KEY.DOWN || e.which === KEY.UP) {
                move(e.which);
            } else if (e.which === KEY.ENTER) {

            }
        }

        function onSearchBlur() {
            setOpen(false);
            setActive(-1);
        }

        function isOpened() {
            return $ctrl.$select.open;
        }

        function setOpen(val) {
            $ctrl.$select.open = val;
            $ctrl.$select.active = -1;
        }

        function isActive(index) {
            return $ctrl.$select.index === index;
        }

        function setActive(val) {
            $ctrl.$select.active = val;
            if (val === -1) {
                $('#ui-select-choices' + val).focus();
            } else {
                $ctrl.$select.searchField.focus();
            }
        }

        function move(where, index) {
            var ac = null;
            if (where === KEY.DOWN) {
                if (index < $ctrl.availableItems.length) {
                    ac = index + 1;
                }
            } else if (where === KEY.UP) {
                if (index > 1) {
                    ac = index - 1;
                }
            }
            if (ac !== null) {
                setActive();
            }
        }

        function clearSearch() {
            setOpen(false);
            $ctrl.$select.search = null;
            $ctrl.availableItems = $ctrl.initItems;
        }

        function areEqual(x, y) {
            return x.$$hashKey === y.$$hashKey || x._id === y._id;
        }

        function existsItem(item) {
            for (var i = 0; i < $ctrl.$select.selected.length; i++) {
                if (areEqual($ctrl.$select.selected[i], item)) {
                    return i;
                }
            }
            return -1;
        }

        function addItem(item) {
            if (existsItem(item) === -1) {
                $ctrl.$select.selected.push(item);
                //remove from search
               var index = _.findIndex($ctrl.availableItems, {_id: item._id});
                $ctrl.availableItems.splice(index,1);
                //clearSearch();
            } else {
                $ctrl.isDuplicate = true;
            }
        }

        function removeItem(item) {
            var index = existsItem(item);
            if (index !== -1) {
                $ctrl.$select.selected.splice(index, 1);
            }
        }

        function hasItems() {
            return $ctrl.availableItems && $ctrl.availableItems.length > 0;
        }

        function getItems() {
            return $ctrl.availableItems;
        }

        function getAssignedItem(item) {
            console.log('search init getAssignedItem');
            return item._id;
        }

        function getCheckedItem(item) {
            return item;
        }

        function assign() {
            console.log('assign');
            if ($ctrl.$select.selected.length === 0) {
                $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.researchers.invite.email');
                return;
            }
            $ctrl.isUpdating = true;
            $ctrl.error = null;

            var items = $ctrl.$select.selected.map(function (item) {
                    return $ctrl.getAssignedItem(item);
                }),
                selIds = $ctrl.item.map(function (item) {
                    return $ctrl.getCheckedItem(item);
                });

            $ctrl.assignMultiple($ctrl.$select.sendEmails, selIds, items);
        }

        function onError(error) {
            $ctrl.broadcastRoot('CLEAR_SELECTED_ROWS_' + $ctrl.elemType);
            if(error == null && typeof ($ctrl.onClose === 'function')) {
                $ctrl.onClose({result: 'cancel'});
            }else {
                $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.researchers.invite.email');
            }
            $ctrl.isUpdating = false;
        }

        function onSave(result) {
            $ctrl.isUpdating = false;
            $ctrl.broadcastRoot('CLEAR_SELECTED_ROWS_' + $ctrl.elemType);
            $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result);
            var l = _.filter($ctrl.contactLists, function (item) {
                return item.type === 'List';
            }).map(function (item) {
                return item.contactListId;
            });
            $ctrl.broadcastRoot('COUNTER_CHANGED_' + $ctrl.elemType + '_TREE', {ids: l.length > 0 ? l : $ctrl.currentListId });

            if($ctrl.popupType !== 'assign-projects') {
                    if($ctrl.contactType === "Project"){
                        var fullCurrentListId = $ctrl.extraParam.fullCurrentListId;
                        $ctrl.broadcastRoot('TREE_SERVICE_SET_LIST_' + $ctrl.elemType + '_' + fullCurrentListId, $ctrl.preLoadingService.getObjectList($ctrl.preLoadingService.TblTypes.Contacts, function (item) {
                            var list = item.contactLists ? item.contactLists['c_' + $ctrl.currentListId] : null,
                                listExists = (list !== null && list !== undefined);
                            if(!listExists){return false;}
                            if (fullCurrentListId !== $ctrl.currentListId || fullCurrentListId === 'All') {
                                return true;
                            }
                            return list && list.roles && list.roles.type === $ctrl.currentListId;
                        }));
                    }else {
                        $ctrl.broadcastRoot('TREE_SERVICE_SET_LIST_' + $ctrl.elemType + '_' + $ctrl.currentListId, $ctrl.preLoadingService.getObjectList($ctrl.preLoadingService.TblTypes.Contacts, function (item) {
                            var list = item.contactLists ? item.contactLists['c_' + $ctrl.currentListId] : null;
                            return (list !== null && list !== undefined);
                        }));
                    }
            }

            if (typeof ($ctrl.onClose === 'function')) {
                $ctrl.onClose({result: 'cancel'});
            }
        }

        function onSearch(search) {
            console.log('onSearch');
            $ctrl.search = search;
            $ctrl.isDuplicate = false;
            if (!$ctrl.isSearching) {
                if (!search && !$ctrl.searchNull) {
                    $ctrl.availableItems = $ctrl.initItems ? $ctrl.initItems : [];
                    setOpen(false);
                } else {
                    $ctrl.isSearching = true;
                    var onSuccess = function (items) {
                        $ctrl.availableItems = items ? items : [];
                        $ctrl.isSearching = false;
                        setOpen(true);
                        if ($ctrl.availableItems.length > 0 && $ctrl.availableItems[0].alreadyAdded) {
                            $ctrl.isDuplicate = true;
                            $ctrl.availableItems = [];
                        }
                    };

                    var onError = function (error) {
                        $ctrl.availableItems = [];
                        $ctrl.isSearching = false;
                        setOpen(false);
                    };

                    var itemId = $ctrl.item && $ctrl.item.length === 1 ? $ctrl.getCheckedItem($ctrl.item[0]) : null;
                    $ctrl.searchItems(search, itemId, onSuccess, onError);
                }
            }
        }

        function getDisplayName(item, short) {
            return short && item.name && item.name.length > $ctrl.minLength ? item.name.substring(0, $ctrl.minLength) : item.name;
        }

        function getEmail(item) {
            var e = item.email ? item.email.toLowerCase() : '';
            return item.email ? (item.name ? (' (' + e + ')') : e) : '';
        }

        function getIcon(item) {
            return $ctrl.security.getInitialsByName(item.name) ? $ctrl.security.getNameColor(item.name) : $ctrl.icon;
        }

        function getInitials(item) {
            return $ctrl.security.getInitialsByName(item.name);
        }

        function getSearchForm() {
        return '<div id="formNewInvite" name="$ctrl.formNewInvite" class="form-wrapper" novalidate autocomplete="off" >' +
            $ctrl.LCS.getErrorBlock() +
                '<div class="search-wide form-group" ng-class="{\'last\': $ctrl.$select.selected.length == 0}">' +
                    $ctrl.LCS.getISBDiv('search gray', 2, null, 'style="position: absolute;top: 9px;left: 10px"') +
                    '<input id="autosearch-field" type="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" class="form-control ' +
                    ($ctrl.specialClass ? $ctrl.specialClass : 'with-border-around without-underline') + '" ' +
                    'placeholder="' + $ctrl.placeholder + '" ' +
                    'ng-keyup="$ctrl.onSearch($ctrl.$select.search)" ng-model="$ctrl.$select.search" ng-focus="$ctrl.setOpen($ctrl.hasItems())" ui-focus="$ctrl.hasAutoFocus">' +

                    '<div class="cancel-search"><a class="clear-search no-transition" ng-click="$ctrl.clearSearch()" ng-show="$ctrl.$select.search">' +
                    $ctrl.LCS.getISBDiv('delete-circle', 2, 'with-primary-hover') +
            '</a></div>' +
                    '<div class="select-choices '+($ctrl.selectChoicesCls?$ctrl.selectChoicesCls:'')+'" ng-if="$ctrl.isOpened()">' +
                        '<ul>' +
                            '<li class="select-first table-div full-width" ng-show="$ctrl.hasItems()"><div ng-bind="$ctrl.isDuplicate ? $ctrl.errormessageDuplicate: \'Select to add\'"></div></li>' +
                            '<li class="select-first" ng-show="!$ctrl.hasItems() && $ctrl.showResults">' +
                                '<div ng-if="$ctrl.$select.search" class="text-center">{{$ctrl.errorNoMatch}}</div>' +
                                '<div ng-if="!$ctrl.$select.search" class="text-center">{{$ctrl.errorNoElem}}</div>' +
                            '</li>' +
                            '<li ng-show="$ctrl.hasItems()" class="ui-select-choices-group" ng-class="{\'active\':$ctrl.isActive($index)}" ng-repeat="item in $ctrl.getItems()" ng-click="$ctrl.addItem(item)">' +
                                '<div class="select-choices-row-inner">' +
                                    '<div class="col30 vtop">' + getLogo('{{::$ctrl.avatarSize}}') + '</div>' +
                                    '<div>' +
                                        '<div class="name" ng-bind-html="::$ctrl.getDisplayName(item)|unsafe"></div>' +
                                        '<div ng-if="::$ctrl.showEmail" class="email" ng-bind-html="$ctrl.getEmail(item)|highlight: $ctrl.$select.search|unsafe"></div>' +
                                    '</div>' +
                                    '<div class="plus-round">' +$ctrl.LCS.getISBDiv('plus-circled gray', 2) + '</div>' +
                                '</div>' +
                            '</li>' +
                        '</ul>' +
                    '</div>' +
                '</div>' +
                '<div class="'+$ctrl.selectedClass+'">' +
                    '<div ng-if="$ctrl.$select.selected.length > 0" class="selected-projects">' +
                        '<ul>' +
                            '<li class="smaller" ng-repeat="item in $ctrl.$select.selected" >' +
                                '<a tooltip-html="::$ctrl.withSearchTooltip ? $ctrl.getDisplayName(item):\'\'" tooltip-placement="bottom">' +
                                    '<div class="col40">'+ getLogo('smaller pull-left') + '</div>' +
                                    '<div class="name" ng-bind-html="::$ctrl.getDisplayName(item, true)|unsafe" ></div>' +
                                    '<a class="btn-remove" ng-click="$ctrl.removeItem(item)">'+ $ctrl.LCS.getISBDiv('cancel', 2, 'pull-left') +'</a>' +
                                '</a>' +
                            '</li>' +
                        '</ul>' +
                    '</div>' +
                    '<div ng-if="!$ctrl.$select.selected.length&&$ctrl.showEmptyState" class="no-project withpopover centering spacing text-center">' +
            $ctrl.LCS.getISBDiv('search', 2, 'big-icon text-center spacing-half col100', 'style="font-size: 80px;color: rgba(192, 202, 209,0.6)"' ) +
                    '</div>' +
                '</div>' +
            '</div>'
        }

        function getLogo(cls){
            return '<div class="thumb-sm with-radius '+(cls ? cls : '')+'">' +
                '<div ng-if="::!$ctrl.getLogoPath(item)" class="avatar" ng-bind="::$ctrl.getInitials(item)">' +
                    '<div ng-show="$ctrl.getIcon(item)" class="sbf">'+$ctrl.LCS.getISBPath(2)+'</div>' +
                '</div>' +
                '<img ng-if="::$ctrl.getLogoPath(item)" class="featured-image" ng-src="{{::$ctrl.getLogoPath(item)}}">' +
                '</div>';
        }
    }
}

angular.module('company.settings.billing.page.component',[
    'company.settings.init.service',
    'user.payment.init.controller.service'

])
.component('billingPage', {
    controller: 'BillingPageCtrl',
    bindings: {
        plans:'<',
        features: '<'
    }
})
.controller('BillingPageCtrl', BillingPageCtrl);
BillingPageCtrl.$inject = ['CompInitCtrlService', 'SettingsInitCtrlService', 'PaymentInitCtrlService', '$element'];
function BillingPageCtrl(CompInitCtrlService, SettingsInitCtrlService, PaymentInitCtrlService, $element) {
    console.log('BillingPageCtrl');
    var $ctrl = this;

    $ctrl.CompInitCtrlService = CompInitCtrlService;
    $ctrl.PaymentInitCtrlService = PaymentInitCtrlService;
    $ctrl.SettingsInitCtrlService = SettingsInitCtrlService;

    $ctrl = new $ctrl.CompInitCtrlService($ctrl);

    $ctrl.popupTitle = 'Payment Methods';

    $ctrl.$onInit = $onInit;
    $ctrl.getSettingsTemplate = getSettingsTemplate;

    function $onInit() {
        $ctrl.templateType = 'company';
        $ctrl.withSignup = false;
        $ctrl.getPriceForPlan = getPriceForPlan;

        $ctrl.PaymentInitCtrlService.loadPayment($ctrl, next, true);

        function next() {
            var sub = $ctrl.subscription;
            if ($ctrl.subscription) {
                $ctrl.emailInfo = {
                    billingEmail: sub.billingEmail ? sub.billingEmail : (sub.createdBy ? sub.createdBy.email : null),
                    taxId: sub.taxId,
                    companyId: $ctrl.CPS.companyId
                };
            }

            $ctrl = new $ctrl.SettingsInitCtrlService($ctrl, $element);
        }
    }

    function getPriceForPlan(){
        var f = $ctrl.currentPlan.features,
            extra = $ctrl.subFeatures.team.total - (f.team ? f.team.count : 1),
            monthly = $ctrl.currentPlan.amount + (extra > 0 ? $ctrl.currentPlan.amount_additional * extra : 0);
        return $ctrl.getFormattedCurrency(monthly * ($ctrl.currentPlan.interval === 'year' ? 12 : 1));
    }

    function getSettingsTemplate() {
        var isFree = $ctrl.currentPlan.name === 'Free';
    return '<div class="position-relative">' +
                '<div class="tab-content with-white-bg with-radius margin-top-half">' +
                    '<div class="spacing-top">' +
                        '<div class="centered circled-svg-colored small76">'+$ctrl.LCS.getISBDiv('card', 3)+'</div>' +
                        '<h3 class="subtitle text-center">'+(isFree ? 'Free Forever Plan': 'Payment Methods')+'</h3>' +
                    '</div>' +
                    '<div class="centering spacing-bottom clearfix">' +
                        '<div class="billing-settings">' +

                            (isFree ? ('<div class="centering" style="max-width: 600px;">' +
                                '<p class="text-center " style="line-height: 24px">'+$ctrl.currentPlan.description+'</p>' +
                                '<div class="centering text-center spacing-half-top">' +
                                    '<a class="btn btn-primary" href="'+$ctrl.CPS.getStateHref('user.pricing', $ctrl.CPS.currentPathParams())+'" analytics-on analytics-action="Upgrade Your Plan">Upgrade Your Plan</a>' +
                                '</div>' +
                            '</div>') : '') +

                            ('<div class="billing-settings-table centering clearfix" style="max-width: 700px' + (isFree ? ';margin-top: 40px' : '') + '">' +
                                (isFree ? '' : ('<div class="rowx left">' +
                                     '<div class="one-line-tooltip">' +
                                        '<label class="uppercase">Subscription Plan</label>' +
                                        '<div class="inputheight">' +
                                            '<span>'+$ctrl.currentPlan.name+'</span> Plan' +
                                    '<span class="orspan">•</span><span class="symbolmo">$</span><span>'+ $ctrl.getPriceForPlan()+'</span><span class="symbolmo">/<span>'+($ctrl.currentPlan.interval!=='year' ?'mo':'yr')+'</span></span>' +
                                        '</div>' +
                                        '<a class="with-hover location-edit-btn empty hide-print" tooltip="Change Plan" tooltip-placement="bottom" href="'+$ctrl.CPS.getStateHref('user.pricing', $ctrl.CPS.currentPathParams())+'">' +
                                getPencil() +
                                        '</a>' +
                                    '</div>' +

                                    '<div class="one-line-tooltip ">' +
                                        '<label class="uppercase">Users On Plan</label>' +
                                        '<div class="inputheight"><span>'+$ctrl.subFeatures.team.total+'</span> User<span>'+($ctrl.subFeatures.team.total===0?'':'s')+'</span></div>' +
                                        '<a class="with-hover location-edit-btn empty hide-print" ng-click="$ctrl.openPayment($ctrl.currentPlan, {showMonthly: $ctrl.currentPlan.interval === \'month\', withRelatedPlans: true})" tooltip-placement="bottom" tooltip="Add Seats">' + getPencil() + '</a>' +
                                    '</div>' +

                                    '<div class="without-border one-line-tooltip ">' +
                                        '<label class="uppercase">Coupon</label>' +
                                        '<div ng-if="!$ctrl.info.showCoupon">' +
                                            '<div ng-if="$ctrl.appliedCoupon" class="spacing-half-bottom">' +
                                                '<div class="first">Coupon Applied: <span class="semibold" ng-bind="$ctrl.appliedCoupon.id"></span></div>' +
                                                '<div class="note">Redeemed on <span ng-bind="$ctrl.appliedCoupon.startDate| amDateFormat : \'M/D/YY\'"></span></div>' +
                                            '</div>' +
                                            '<button type="button" ng-click="$ctrl.info.showCoupon=!$ctrl.info.showCoupon" class="edit-profile btn btn-small primary-faded">Apply Coupon</button>' +
                                        '</div>' +
                                        '<form ng-if="$ctrl.info.showCoupon" class="coupon" name="$ctrl.formHolder.coupon" autocomplete="off" novalidate>' +
                                            '<div class="form-group">' +
                                                '<input class="form-control with-underline coupon" type="text" name="coupon" ng-model="$ctrl.coupon.id" placeholder="Offer Code (optional)" ng-keyup="$ctrl.onValidateCoupon()" ui-focus="true">' +
                                                '<span class="validator sbf" ng-class="{\'check-semi success\':($ctrl.formHolder.coupon.coupon.$dirty || $ctrl.formHolder[\'coupon_attempted\']) && $ctrl.formHolder.coupon.coupon.$invalid == \'valid\', \'wrong insuccess\':($ctrl.formHolder.coupon.coupon.$dirty || $ctrl.formHolder[\'coupon_attempted\']) && formHolder.coupon.coupon.$invalid == \'invalid\', \'loadingicon animate-spin\': $ctrl.coupon.isUpdating}"></span>' +
                                                '<div class="validator1 success ng-hide" ng-show="($ctrl.formHolder.coupon.coupon.$dirty || $ctrl.formHolder[\'coupon_attempted\']) && $ctrl.formHolder.coupon.coupon.$invalid == \'valid\'">Coupon valid. Apply now to get {{$ctrl.coupon.amountOff > 0 ? $ctrl.coupon.amountOff : ($ctrl.coupon.percentOff + \'%\')}} off for {{$ctrl.coupon.duration}} month{{$ctrl.coupon.duration!=1 ? \'s\' : \'\'}}.</div>' +
                                            '</div>' +
                                            '<div class="form-group last">' +
                                                '<button ng-click="$ctrl.applyDiscount()" analytics-on analytics-action="Apply Coupon" class="btn primary small-blue-btn" ng-class="{\'disabled\': !(($ctrl.formHolder.coupon.coupon.$dirty || $ctrl.formHolder[\'coupon_attempted\']) && $ctrl.formHolder.coupon.coupon.$invalid == \'valid\') || $ctrl.isUpdatingD == true}" ng-disabled= "!(($ctrl.formHolder.coupon.coupon.$dirty || $ctrl.formHolder[\'coupon_attempted\']) && $ctrl.formHolder.coupon.coupon.$invalid == \'valid\') || $ctrl.isUpdatingD== true" type="submit">' +
                                '<div class="col20 pull-left" ng-show="$ctrl.isUpdatingD === true"><span class="sbf smaller loadingicon animate-spin"></span></div>' +
                                '<div>Save</div></button>' +
                                '</button>' +
                                                '<span class=\'orspan\'> or </span>' +
                                                '<a ng-click="$ctrl.info.showCoupon = false">Cancel</a>' +
                                            '</div>' +
                                        '</form>' +
                                    '</div>' +
                                '</div>' )) +

                                '<div class="rowx '+(isFree?'':'right')+'"'+(isFree?'style="margin-left:auto;margin-right:auto"':'')+'>' +
                                    '<div class="one-line-tooltip ">' +
                                        '<label class="uppercase">Card Details</label>' +
                                        $ctrl.getCreditCardForm()+
                                        '<div ng-if="$ctrl.info.addCard" class="form-group last" style="margin-top:10px">' +
                                            '<button type="button" class="btn primary small-blue-btn" ng-click="$ctrl.changeCard($event)" analytics-on analytics-action="Update Card" ng-class="{\'disabled\': !$ctrl.formHolder.card.$valid || $ctrl.isUpdatingC}" ng-disabled="!$ctrl.formHolder.card.$valid || $ctrl.isUpdatingC">' +
                                                '<div class="col20 pull-left" ng-show="$ctrl.isUpdatingC === true"><span class="sbf smaller loadingicon animate-spin"></span></div>' +
                                                '<div>Save</div></button>' +
                                            '</button>' +
                                            '<span class=\'orspan\'> or </span>' +
                                            '<a ng-click="$ctrl.info.addCard = false;$ctrl.isUpdatingC=false">Cancel</a>' +
                                        '</div>' +
                                        '<a ng-if="!$ctrl.info.addCard" class="with-hover location-edit-btn empty hide-print" ng-click="$ctrl.info.addCard = true" tooltip="Edit Credit Card" tooltip-placement="bottom">' + getPencil() + '</a>' +
                                    '</div>' +

                              //  getBillingAddress() +
                                getBillingEmail() +
                                     getTaxId()+

                                    (isFree ? '' : ('<div class="without-border" ng-if="$ctrl.currentPlan.interval!==\'year\'">' +
                                        '<label class="uppercase">Pay Yearly & <span class="green-color">Save 15%</span></label>' +
                                        '<button type="button" class="edit-profile btn btn-small primary-faded" ng-click="$ctrl.openUpgradeYearly($event)" analytics-on analytics-action="Pay Yearly">Pay Yearly</button>' +
                                    '</div>')) +
                                '</div>' +
                            '</div>')  +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>';

    function getPencil(){
        return $ctrl.LCS.getISBDiv('pencil', 2, 'sbf12');
    }
        function getBillingEmail(){
        return '<div class="one-line-tooltip">' +
                    '<label class="uppercase">Billing Email</label>' +
                    '<div ng-if="!$ctrl.info.showEmail">' +
                        '<div class="inputheight" ng-bind="$ctrl.emailInfo.billingEmail"></div>' +
                        '<a class="with-hover location-edit-btn empty hide-print" ng-click="$ctrl.info.showEmail=!$ctrl.info.showEmail" tooltip="Edit Email" tooltip-placement="bottom">' +
            getPencil() +
                        '</a>' +
                    '</div>' +
                    '<form ng-if="$ctrl.info.showEmail" class="form-wrapper" name="$ctrl.formHolder.email" autocomplete="off" novalidate>' +
                        '<div class="form-group">' +
                            '<input ui-focus="true" class="form-control with-underline" type="email" name="email" ng-model="$ctrl.emailInfo.billingEmail" placeholder="Billing email address" required>' +
                            '<div ng-if="$ctrl.showError(\'email\',\'required\')" class="help-inline">Please insert an email address.</div>' +
                            '<div ng-if="$ctrl.showError(\'email\',\'email\')" class="help-inline">Please insert a valid email address.</div>' +
                        '</div>' +
                        '<div class="form-group last">' +
                            '<button ng-click="$ctrl.changeBillingEmail($event)" analytics-on analytics-action="Change Email" class="btn primary small-blue-btn" ng-class="{\'disabled\': !($ctrl.formHolder.email.email.$dirty || $ctrl.formHolder.email.attempted) || $ctrl.isUpdatingE}" ng-disabled= "!($ctrl.formHolder.email.email.$dirty || $ctrl.formHolder.email.attempted) || $ctrl.isUpdatingE" type="submit">' +
                                 '<div class="col20 pull-left" ng-show="$ctrl.isUpdatingE === true"><span class="sbf smaller loadingicon animate-spin"></span></div>' +
                                 '<div>Save</div></button>' +
                             '</button>' +
                            '<span class=\'orspan\'> or </span>' +
                            '<a ng-click="$ctrl.info.showEmail=false;$ctrl.isUpdatingE=false">Cancel</a>' +
                        '</div>' +
                    '</form>' +
                '</div>';
        }

        function getTaxId(){
            if(!$ctrl.emailInfo.taxId){
                $ctrl.info.showTaxId = true;
            }
            var txt = 'Tax ID';
            return '<div class="one-line-tooltip">' +
                    '<label class="uppercase">'+txt+'</label>' +
                    '<div ng-if="!$ctrl.info.showTaxId">' +
                        '<div class="inputheight" ng-bind="$ctrl.emailInfo.taxId"></div>' +
                        '<a class="with-hover location-edit-btn empty hide-print" ng-click="$ctrl.info.showTaxId=!$ctrl.info.showTaxId" tooltip="Edit '+txt+'" tooltip-placement="bottom">' +
            getPencil() +
                        '</a>' +
                    '</div>' +
                    '<form ng-if="$ctrl.info.showTaxId" class="form-wrapper" name="$ctrl.formHolder.taxid" autocomplete="off" novalidate>' +
                        '<div class="form-group">' +
                            '<input ui-focus="true" class="form-control with-underline" type="text" name="taxId" ng-model="$ctrl.emailInfo.taxId" placeholder="Enter '+txt.toLowerCase()+'">' +
                        '</div>' +
                        '<div class="form-group last">' +
                            '<button ng-click="$ctrl.changeTaxId($event)" analytics-on analytics-action="Change Tax ID" class="btn primary small-blue-btn" ng-class="{\'disabled\': !($ctrl.formHolder.taxid.taxId.$dirty || $ctrl.formHolder.taxid.attempted) || $ctrl.isUpdatingT}" ng-disabled= "!($ctrl.formHolder.taxid.taxId.$dirty || $ctrl.formHolder.taxid.attempted) || $ctrl.isUpdatingT" type="submit">' +
                                 '<div class="col20 pull-left" ng-show="$ctrl.isUpdatingT === true"><span class="sbf smaller loadingicon animate-spin"></span></div>' +
                                 '<div>Save</div></button>' +
                             '</button>' +
                            '<span ng-if="$ctrl.emailInfo.taxId"><span class=\'orspan\'> or </span>' +
                            '<a ng-click="$ctrl.info.showTaxId=false;$ctrl.isUpdatingT=false">Cancel</a></span>' +
                        '</div>' +
                    '</form>' +
                '</div>';
        }
    }
}

angular.module('company.settings.projects.page.component', [
    'company.settings.init.service',
    'apiServices.Companies'
])
.component('companyProjectsSettingsPage', {
    bindings: {
        onClose: '&'
    },
    controller: 'CompanyProjectsSettingsPageCtrl'
})
.controller('CompanyProjectsSettingsPageCtrl', CompanyProjectsSettingsPageCtrl);
CompanyProjectsSettingsPageCtrl.$inject = ['CompInitCtrlService', 'CompaniesService', 'SettingsInitCtrlService','ProductSettingsInitCtrlService', 'ListItemTemplateInitCtrlService', '$element'];
function CompanyProjectsSettingsPageCtrl(CompInitCtrlService, service, SettingsInitCtrlService, ProductSettingsInitCtrlService, ListItemTemplateInitCtrlService, $element) {
    console.log('CompanyProjectsSettingsPageCtrl');
    var $ctrl = this;

    $ctrl = new CompInitCtrlService($ctrl);

    $ctrl.service = service;
    $ctrl.isGeneral = true;

    $ctrl.getSettingsTemplate = getSettingsTemplate;
    $ctrl.onSettingsSave = onSettingsSave;

    $ctrl.preInitSettings = preInitSettings;
    $ctrl.postInitSettings = postInitSettings;
    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.service.getById($ctrl.security.getCurrentCompanyId(), 'settingsId logoId', onCompanyLoaded);
    }

    function onCompanyLoaded (company) {
        $ctrl.company = company ? company : $ctrl.security.getCurrentCompany();
        $ctrl = new SettingsInitCtrlService($ctrl, $element);
    }

    function preInitSettings(){
        $ctrl.templateType = 'company';
        $ctrl.popupTitle = 'Project Defaults';

        $ctrl = new ProductSettingsInitCtrlService($ctrl);
        $ctrl = new ListItemTemplateInitCtrlService($ctrl);
    }

    function postInitSettings() {
        $ctrl.onSave = $ctrl.onProductSettingsSave;
    }

    function getSettingsTemplate() {
       return $ctrl.getProjectSectionForm();
    }

    function onSettingsSave(item) {
        console.log('CompanyProjectsSettingsPageCtrl.onSettingsSave');
        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.project.setting.success', 'success');
        $ctrl.CurrentLocaleSettings.initCompanySettings(item);
        $ctrl.CPS.loadCurrentLocale();
        if ($ctrl.item.settingsId !== item._id) {
            $ctrl.service.update({settingsId: item._id, _id: $ctrl.security.getCurrentCompanyId()}, function (result) {
              }, function (error) {
                console.log(error);
            });
        }
    }
}

angular.module('company.settings.page.component', [
    'company.settings.init.service',
    'company.settings.component'
])
.component('companySettingsPage', {
    controller: 'CompanySettingsPageCtrl'
})
.controller('CompanySettingsPageCtrl', CompanySettingsPageCtrl);
CompanySettingsPageCtrl.$inject = ['SettingsInitCtrlService', '$element'];
function CompanySettingsPageCtrl(SettingsInitCtrlService, $element) {
    console.log('CompanySettingsPageCtrl');

    var $ctrl = this;

    $ctrl.getSettingsTemplate = getSettingsTemplate;
    $ctrl.preInitSettings = preInitSettings;

    $ctrl = new SettingsInitCtrlService($ctrl, $element);

    function preInitSettings() {
        $ctrl.templateType = 'company';
    }

    function getSettingsTemplate() {
    return '<div class="tab-content with-white-bg with-big-margin-bottom margin-top-half with-padding">' +
                '<company-settings class="clearfix display-block"></company-settings>' +
            '</div>';
    }
}

angular.module('company.settings.component', [
    'apiServices.Companies',
    'services.sessionEventsService'
])
.component('companySettings', {
    bindings: {
        onClose: '&',
        inPopup:'@'
    },
    controller: 'CompanySettingsCtrl'
})
.controller('CompanySettingsCtrl', CompanySettingsCtrl);
CompanySettingsCtrl.$inject = ['ListItemTemplateFormCtrlService', 'ImgUploadInitService','CompaniesService', 'SessionEventsService', '$element'];
function CompanySettingsCtrl(ListItemTemplateFormCtrlService, ImgUploadInitService, service, SessionEventsService, $element) {
    console.log('CompanySettingsCtrl');
    var $ctrl = this;

    $ctrl.SessionEventsService = SessionEventsService;

    $ctrl.preInitOther = preInitOther;
    $ctrl.postInitOther = postInitOther;

    $ctrl.setTemplateData = setTemplateData;

    $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

    $ctrl.onImageUpdate = onImageUpdate;

    $ctrl = new ImgUploadInitService($ctrl, false);

    function preInitOther() {
        $ctrl.type = 'Edit';
        $ctrl.objectType = 'company';
        $ctrl.service = service;
        $ctrl.extraParam = {service: $ctrl.service};

        $ctrl.inPopup = $ctrl.inPopup === 'true' || $ctrl.inPopup === true;

        $ctrl.onSaveGeneral = onSaveGeneral;
    }

    function postInitOther(){
        $ctrl.service.getById($ctrl.security.getCurrentCompanyId(), 'settingsId logoId', function(company){
            $ctrl.initItem(company ? company : $ctrl.security.getCurrentCompany());

            if ($ctrl.item.name === 'My Company') {
                $ctrl.item.name = null;
            }
            setColumns();
            $ctrl.isLoaded = true;
            $ctrl.reloadTemplate();
        });
    }

    function updateCompany(item) {
        if (item) {
            $ctrl.security.updateCurrentCompany(item, $ctrl.SessionEventsService);
        }
    }

    function onImageUpdate(result) {
        if (!$ctrl.inPopup) {
            updateCompany($ctrl.item, false);
        }
    }

    function setColumns() {
        var columns = [];

        if (!$ctrl.inPopup || $ctrl.inPopup && !$ctrl.item.name) {
            columns.push({
                type: $ctrl.SBFieldTypesService.PropTypes.Field,
                prop: 'name',
                tabIndex: 1,
                tabNextIndex: 2,
                placeholder: 'Company Name…',
                name: 'Company',
                isRequired: true,
                icon:'company',
                iconLevel: 3
            });
        }

        if (!$ctrl.inPopup || $ctrl.inPopup && !$ctrl.item.address) {
            columns.push({
                type: $ctrl.SBFieldTypesService.PropTypes.Address,
                prop: 'address',
                tabIndex: 2,
                tabNextIndex: 3,
                placeholder: 'Company Address…',
                name: 'Address',
                fieldClass: 'address',
                icon:'pin',
                otherHtml: '<div class="wide-tooltip hide-ipad position-absolute" style="height: 0;left:100%;top:0"' +
                    'tooltip-placement="left" tooltip="The production company address will be displayed on call sheets and reports."' +
                    '><div style="right: -20px;top: 8px" class="sbf info blueish position-absolute" ' +
                    '>'+ $ctrl.LCS.getISBPath(4) +'</div></div>'
            });
        }

        columns.push({
            name: 'Avatar',
            prop: 'logo',
            type: $ctrl.SBFieldTypesService.PropTypes.Picture,
            order: 1,
            canEdit: true,
            showMobile: true,
            icon:'company',
            iconLevel: 3,
            withoutInitials: true,
            loadLater: false,
            collectionProp: 'companies',
            imgProp:'logo',
            isAvatarAttr: true,
            areaType: 'square',
            imgSize:   'medium80',
            defaultText: 'Upload Logo',
            showLabel : true,
            canUploadAttr: true,
        });

        $ctrl.columnsList = columns;
    }

    function setTemplateData() {
        $ctrl.icon = 'company';
        $ctrl.iconLevel = 3;
        $ctrl.withBtnDisabled = true;
        $ctrl.withFooterBtns = true;
        $ctrl.popupTitle = ($ctrl.inPopup ? 'Your Company':'Company Profile');
        $ctrl.btnText = 'Save';
        $ctrl.textAnalytics = $ctrl.popupTitle;
        if(!$ctrl.inPopup) {
            $ctrl.firstBtnCls = 'full-width';
        }
        $ctrl.subdesc = 'Company details will be displayed on <br class="hide-ipad"/>call sheets, emails and various pages.';
        $ctrl.modalBodyFormClass = 'company-settings-info';
    }

    function onSaveGeneral(result) {
        var item = result ? result.item : null;
        if(item){
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.company.Edit.success', 'success');
            updateCompany(item);
            if($ctrl.inPopup){
                $ctrl.onClose();
            }
        }
    }
}

angular.module('company.settings', [
    'company.settings.projects.page.component',
    'company.settings.billing.page.component',
    'company.settings.page.component',
    'company.settings.invoices.page.component'
]);

angular.module('company.settings.invoices.page.component',[
    'company.settings.init.service',
    'user.payment.init.controller.service'

])
.component('invoicesPage', {
    controller: 'InvoicesPageCtrl',
    bindings: {
        plans:'<',
        features: '<'
    }
})
.controller('InvoicesPageCtrl', InvoicesPageCtrl);
InvoicesPageCtrl.$inject = ['CompInitCtrlService', 'SettingsInitCtrlService', 'PaymentInitCtrlService', '$element'];
function InvoicesPageCtrl(CompInitCtrlService, SettingsInitCtrlService, PaymentInitCtrlService, $element) {
    console.log('InvoicesPageCtrl');
    var $ctrl = this;

    $ctrl = new CompInitCtrlService($ctrl);
    $ctrl.popupTitle = 'Billing History';

    $ctrl.getSettingsTemplate = getSettingsTemplate;

    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.templateType = 'company';
        $ctrl.withSignup = false;

        PaymentInitCtrlService.loadPayment($ctrl, next, false);

        function next() {
            var sub = $ctrl.subscription;
            if ($ctrl.subscription) {
                $ctrl.emailInfo = {
                    billingEmail: sub.billingEmail ? sub.billingEmail : (sub.createdBy ? sub.createdBy.email : null),
                    taxId: sub.taxId,
                    companyId: $ctrl.CPS.companyId
                };
            }

            $ctrl = new SettingsInitCtrlService($ctrl, $element);
        }
    }

    function getSettingsTemplate() {
return '<div class="tab-content with-white-bg with-big-margin-bottom margin-top-half with-padding">' +
            '<div class="spacing-top">' +
                '<div class="centered circled-svg-colored small76">' + $ctrl.LCS.getISBDiv('card', 3) + '</div>' +
                '<h3 class="subtitle text-center">' + $ctrl.popupTitle + '</h3>' +
            '</div>' +
            '<div class="centering spacing-bottom clearfix">' +
                '<invoices company-id="::$ctrl.CPS.companyId" class="clearfix display-block full-width position-relative"></invoices>' +
            '</div>' +
        '</div>';
    }
}


angular.module('apiConstants.devSetup.services', [
])
.service('DevSetupConstantsService', DevSetupConstantsService);
DevSetupConstantsService.$inject = [];
function DevSetupConstantsService() {
    var PropTypes = SBFieldTypesService.PropTypes,

    CompOptions = {
        hideFilters: true,
    };

    return {
        PropTypes: PropTypes,
        ViewProp: 'devSetupView',
        CompOptions: CompOptions,
    };
}

angular.module('user.devsetup', [
    'user.devsetup.routing'
]) ;

angular.module('user.devsetup.component', [
    'apiServices.DevSetups',
    'apiServices.OverviewBlocks',
    'services.sidebarConfigService',
    'apiConstants.devSetup.services'
])
.component('devsetupPage', {
    bindings: {
        item: '<'
    },
    controller: 'DevSetupCtrl',
}) 
.controller('DevSetupCtrl', DevSetupCtrl);
DevSetupCtrl.$inject = ['PageSimpleInitCtrlService', 'ImgUploadInitService', 'DevSetupsService','OverviewBlocksService', 'SidebarConfigService', 'TemplateCompileService', '$element', 'SBFieldMethods', 'DevSetupConstantsService', 'LCS'];
function DevSetupCtrl(PageSimpleInitCtrlService, ImgUploadInitService, DevSetupsService, OverviewBlocksService, SidebarConfigService, TemplateCompileService, $element, SBFieldMethods, constantsService, LCS) {

    constantsService = _.extend({}, constantsService);

    var $ctrl = this;

    $ctrl.LCS = LCS;
    $ctrl.OverviewBlocksService = OverviewBlocksService;
    $ctrl.SidebarConfigService = SidebarConfigService;
    $ctrl.BlocksSetupService = SidebarConfigService.BlocksSetupService;
    $ctrl.DevSetupsService = DevSetupsService;
    $ctrl.SBFieldMethods = SBFieldMethods;

    var copyOverviewBlocks;
    $ctrl.formHolderItem ={};
    $ctrl.title = 'Customization';
    $ctrl.hidePrint = true;

    $ctrl.SLACK_TYPES = {Contact: 1, NewUser: 2, Share: 3, Transaction: 4, Callsheet: 5};

    $ctrl.hasSidebarFilters = true;

    $ctrl.$onInit = $onInit;

    $ctrl.getPageTemplate = getPageTemplate;

    $ctrl = new PageSimpleInitCtrlService($ctrl, $element, {
        constantsService: constantsService
    });

    function $onInit() {
        if ($ctrl.item) {
            $ctrl.copyItem = _.clone($ctrl.item);
        }
        setCopy($ctrl.item);

        $ctrl.Colors = $ctrl.SBFieldMethods.Colors;
        $ctrl.Icons = $ctrl.SBFieldMethods.Icons.map(function (item) {
            return {id: item};
        });

        $ctrl.InfoTypes = {General: 1, Homepage: 2, App: 3};
        $ctrl.AttrTypes = {Color: 1, Image: 2, TopNavLinks: 3, SideNavLinks: 4, SlackSources: 5};

        $ctrl.Infos = {
            1: {
                subTitle: 'General',
                props: [{
                    name: 'Links',
                    form: 'GeneralLinks',
                    changedFields: ['linkColor', 'linkColorHover', 'linkAccentColor', 'linkAccentColorHover', 'checkboxColor'],
                    attributes: [{
                        label: 'Primary Link Color (Default)',
                        name: 'linkColor',
                        def: 'defaultLinkColor',
                        type: $ctrl.AttrTypes.Color
                    },
                        {
                            label: 'Primary Link Color (Hover)',
                            name: 'linkColorHover',
                            def: 'defaultLinkColorHover',
                            type: $ctrl.AttrTypes.Color
                        }, {
                            label: 'Accent Link Color (Default)',
                            name: 'linkAccentColor',
                            def: 'defaultLinkAccentColor',
                            type: $ctrl.AttrTypes.Color
                        }, {
                            label: 'Accent Link Color (Hover)',
                            name: 'linkAccentColorHover',
                            def: 'defaultLinkAccentColorHover',
                            type: $ctrl.AttrTypes.Color
                        }, {
                            label: 'Checkbox, Radio & Toggle Color',
                            name: 'checkboxColor',
                            def: 'defaultCheckboxColor',
                            type: $ctrl.AttrTypes.Color
                        }]
                }, {
                    name: 'Buttons',
                    form: 'GeneralButtons',
                    changedFields: ['btnPrimaryColor', 'btnPrimaryColorHover', 'btnAccentColor', 'btnAccentColorHover'],
                    attributes: [{
                        label: 'Primary Color (Default)',
                        name: 'btnPrimaryColor',
                        def: 'defaultBtnPrimaryColor',
                        type: $ctrl.AttrTypes.Color
                    }, {
                        label: 'Primary Color (Hover)',
                        name: 'btnPrimaryColorHover',
                        def: 'defaultBtnPrimaryColorHover',
                        type: $ctrl.AttrTypes.Color
                    }, {
                        label: 'Accent Color (Default)',
                        name: 'btnAccentColor',
                        def: 'defaultBtnAccentColor',
                        type: $ctrl.AttrTypes.Color
                    }, {
                        label: 'Accent Color (Hover)',
                        name: 'btnAccentColorHover',
                        def: 'defaultBtnAccentColorHover',
                        type: $ctrl.AttrTypes.Color
                    }, {
                        name: 'Slack Sources',//implement Add Links
                        form: 'SlackSources',
                        changedFields: ['slackSources'],
                        type: $ctrl.AttrTypes.SlackSources
                    }]
                }]
            },
            2: {
                subTitle: 'Homepage',
                props: [{
                    name: 'Logos',
                    form: 'HomepageLogos',
                    changedFields: ['logoTopLoggedOut', 'logoTopForm', 'logoTopEmail', 'favicon'],
                    attributes: [{
                        label: 'Wide Logo',
                        name: 'logoTopLoggedOut',
                        def: 'defaultLogoTopLoggedOut',
                        type: $ctrl.AttrTypes.Image,
                        tooltip: 'Display size: AUTOx27px<br/> Upload size: AUTOx54px',
                        width: 400
                    }, {
                        label: 'Square Logo (Forms & Emails)',
                        name: 'logoTopForm',
                        def: 'defaultLogoTopForm',
                        type: $ctrl.AttrTypes.Image,
                        tooltip: 'Display size: 70x70px<br/> Upload size: 140x140px',
                        width: 140
                    }, {
                        label: 'Wide Logo Top Email',
                        name: 'logoTopEmail',
                        def: 'defaultLogoTopEmail',
                        type: $ctrl.AttrTypes.Image,
                        tooltip: 'Display size: AUTOx22px<br/> Upload size: AUTOx44px',
                        width: 400
                    }, {
                        label: 'Favicon',
                        name: 'favicon',
                        def: 'defaultFavicon',
                        type: $ctrl.AttrTypes.Image,
                        tooltip: 'Display size: 34x34<br/> Upload size: 64x64',
                        width: 64
                    }]
                }, {
                    name: 'Navigation Style',
                    form: 'HomepageNavigation',
                    changedFields: ['navLoggedOutBgColor', 'linkNavLoggedOutColor', 'linkNavLoggedOutColorHover', 'linksTopLoggedOut'],
                    attributes: [{
                        label: 'Navigation Bar Color',
                        name: 'navLoggedOutBgColor',
                        def: 'defaultNavLoggedOutBgColor',
                        type: $ctrl.AttrTypes.Color
                    }, {
                        label: 'Link Color (Default)',
                        name: 'linkNavLoggedOutColor',
                        def: 'defaultLinkNavLoggedOutColor',
                        type: $ctrl.AttrTypes.Color
                    }, {
                        label: 'Link Color (Hover)',
                        name: 'linkNavLoggedOutColorHover',
                        def: 'defaultLinkNavLoggedOutColorHover',
                        type: $ctrl.AttrTypes.Color
                    }]
                }, {
                    name: 'Add Navigation Links',//implement Add Links
                    form: 'HomepageLinks',
                    changedFields: ['linksTopLoggedOut'],
                    type: $ctrl.AttrTypes.TopNavLinks
                }
                ]
            },
            3: {
                subTitle: 'App Navigation',
                props: [{
                    name: 'Navigation Bar',
                    form: 'AppNav',
                    changedFields: [
                        'logoTopLoggedIn', 'navTopLoggedInBgColor', 'navLoggedInBgColor', 'navLoggedInBgColorHover',
                        'subMenuLoggedInBgColor', 'linkNavBarColor', 'linkNavBarColorHover', 'linkSidebarColor', 'linkSidebarColorHover'],
                    attributes: [{
                        label: 'Square Logo',
                        name: 'logoTopLoggedIn',
                        def: 'defaultLogoTopLoggedIn',
                        type: $ctrl.AttrTypes.Image,
                        tooltip: 'Display size: 34x34px<br/> Upload size: 64x64px',
                        width: 64
                    }, {
                        label: 'Logo Background Color',
                        name: 'navTopLoggedInBgColor',
                        def: 'defaultNavTopLoggedInBgColor',
                        type: $ctrl.AttrTypes.Color
                    }, {
                        label: 'Navigation Bar Color',
                        name: 'navLoggedInBgColor',
                        def: 'defaultNavLoggedInBgColor',
                        type: $ctrl.AttrTypes.Color
                    }, {
                        label: 'Navigation Bar Color Hover',
                        name: 'navLoggedInBgColorHover',
                        def: 'defaultNavLoggedInBgColorHover',
                        type: $ctrl.AttrTypes.Color
                    }, {
                        label: 'SubMenu Background Color',
                        name: 'subMenuLoggedInBgColor',
                        def: 'defaultSubMenuLoggedInBgColor',
                        type: $ctrl.AttrTypes.Color
                    }, {
                        label: 'SubMenu Background Color (Hover)',
                        name: 'subMenuLoggedInBgColorHover',
                        def: 'defaultSubMenuLoggedInBgColorHover',
                        type: $ctrl.AttrTypes.Color
                    }, {
                        label: 'Navigation Link Color (Default)',
                        name: 'linkNavBarColor',
                        def: 'defaultLinkNavBarColor',
                        type: $ctrl.AttrTypes.Color
                    }, {
                        label: 'Navigation Link Color (Hover)',
                        name: 'linkNavBarColorHover',
                        def: 'defaultLinkNavBarColorHover',
                        type: $ctrl.AttrTypes.Color
                    }]
                }, {
                    name: 'Sidebars',
                    form: 'AppSidebar',
                    changedFields: ['linkSidebarColor', 'linkSidebarColorHover'],
                    attributes: [{
                        label: 'Sidebar Link Color (Default)',
                        name: 'linkSidebarColor',
                        def: 'defaultLinkSidebarColor',
                        type: $ctrl.AttrTypes.Color
                    }, {
                        label: 'Sidebar Link Color (Hover)',
                        name: 'linkSidebarColorHover',
                        def: 'defaultLinkSidebarColorHover',
                        type: $ctrl.AttrTypes.Color
                    }]
                },
                    {
                        name: 'Add SideBar Links and Overview Blocks for Projects',//implement Add Links
                        form: 'SideBarLinks',
                        type: $ctrl.AttrTypes.SideNavLinks
                    }]
            }
        };

        var stateParams = $ctrl.CPS.stateParams;
        if (stateParams.type) {
            try {
                $ctrl.selectedPane = parseInt(stateParams.type, 10);
            } catch (e) {
            }
        }

        if (!$ctrl.selectedPane || $ctrl.selectedPane > 3) {
            $ctrl.selectedPane = $ctrl.InfoTypes.General;
        }
        if ($ctrl.item) {
            if (!$ctrl.item.linksTopLoggedOut || $ctrl.item.linksTopLoggedOut && $ctrl.item.linksTopLoggedOut.length === 0) {
                $ctrl.item.linksTopLoggedOut = $ctrl.item.defaultLinksTopLoggedOut;
            }
            if (!$ctrl.item.linksTopLoggedOut) {
                $ctrl.item.linksTopLoggedOut = [];
            }
            if ($ctrl.item.linksTopLoggedOut.length === 0) {
                addLink();
            }
            if (!$ctrl.item.slackSources) {
                $ctrl.item.slackSources = [];
            }
            if ($ctrl.item.slackSources.length === 0) {
                addSlackSource();
            }
        }

        $ctrl.onSuccessUpdate = onSuccessUpdate;
        $ctrl.onErrorUpdate = onErrorUpdate;
        $ctrl.saveInfo = saveInfo;
        $ctrl.removeImage = removeImage;

        $ctrl.changePane = changePane;
        $ctrl.isPane = isPane;

        $ctrl.isFocus = isFocus;
        $ctrl.getFocus = getFocus;

        $ctrl.addLink = addLink;
        $ctrl.removeLink = removeLink;

        $ctrl.addSideLink = addSideLink;
        $ctrl.removeSideLink = removeSideLink;


        $ctrl.addSlackSource = addSlackSource;
        $ctrl.removeSlackSource = removeSlackSource;


        $ctrl.formHolder = {};

        loadOverview();

        $ctrl.onSimplePageInit({}, load);
    }

    function load(){
        console.log('onLoadDashboard');
        $ctrl.reloadPageTemplate(false, onPageLoaded);
    }

    function onPageLoaded(){
        $ctrl.onImageUpdate = onImageUpdate;
        $ctrl = new ImgUploadInitService($ctrl, false);

        if(typeof($ctrl.onPageLoadedOther) === 'function') {
            $ctrl.onPageLoadedOther();
        }
    }

    function getPageTemplate(){
        if(!$ctrl.item) {
        return '<div class="tab-content with-white-bg spacing margin-top-half">' +
                    '<h3 class="spacing-half-bottom">Invalid Permissions</h3>' +
                    '<div class="text-center">You are not authorized to modify this page.</div>' +
                '</div>';
        }

var el = '<nav class="filters on-top hide-print with-side-margin one-line-tooltip">' +
            '<div class="pull-left">' +
                ($ctrl.hideSidebar ? '' : ('<a data-type="toggleInnerSidebar" class="btn btn-small primary-faded without-text pull-left with-margin-right">' +
                   $ctrl.LCS.getISBDiv('sidebar-filled') +
                '</a>')) +
            '</div>' +
            '<span class="pull-left title with-margin-right">'+$ctrl.title+'</span>' +
        '</nav>' +

        '<div class="h-full side-table with-filters-above">' +
              '<div class="hide-print side-nav static h-full ' + ((!$ctrl.displaySidebar())? ' sb-hide' : '') + '>' +
                 '<div class="outtercontainer show-scrollbar-on-hover">' +
                    '<div class="innercontainer fancy-scrollbar sb-scrolling-monitor ultrathin">' +
                       '<div class="sidebarScrollingContainer">'+
                            ($ctrl.isInTreeModal ? '' : ('<div class="sidebar-toggle"><a class="btn btn-small transparent noborder smaller inline-block" data-type="toggleInnerSidebar">'+$ctrl.LCS.getISBDiv('angle-double-left', 2,'centered gray')+'</a></div>')) +
                            '<h3 class="text-left side-padding spacing-half-top">'+$ctrl.title+'</h3>' +
                            '<ul class="display-block">';

            for(var key in $ctrl.InfoTypes) {
                var v = $ctrl.InfoTypes[key];
                el += '<li>' +
                        '<a ng-click="$ctrl.changePane('+v+');$ctrl.setMainSideBar($event, true)" analytics-on analytics-action="'+key+'">' +
                            '<div class="li bulletted side-padding" ng-class="{active:$ctrl.isPane('+v+')}">'+
                                $ctrl.Infos[v].subTitle+
                            '</div>' +
                        '</a>' +
                      '</li>';
            }

                           el += '</ul>' +
                       '</div>' +
                    '</div>' +
                 '</div>' +
            '</div>' +
            '<div class="full-content with-fancy-scrollbar show-scrollbar-on-hover h-full">' +
                 '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper">' +
                    '<div>' +
                        '<div class="tab-content">';
                            for(var key in $ctrl.InfoTypes) {
                                el += '<div ng-if="$ctrl.isPane('+$ctrl.InfoTypes[key]+')" class="with-big-margin-bottom">' +
                                    getSectionTemplate($ctrl.InfoTypes[key]) +
                                '</div>';
                            }
                 el += '</div>' +
                    '</div>' +
                 '</div>' +
            '</div>' +
        '</div>';
        return el;
    }

    function getSectionTemplate(v){
        return '<div>' +
                '<div class="tab-content1 with-white-bg with-radius spacing-half-bottom margin-top-half" ng-repeat="prop in $ctrl.Infos['+v+'].props">' +
                     '<div class="spacing-half-bottom centering  margin-half spacing-bottom with-labels">' +
                        '<div class="spacing-top">' +
                            '<h3 class="subtitle text-center" ng-bind="prop.name"></h3>' +
                        '</div>' +
                        '<form name="$ctrl.formHolder.{{prop.form}}" id="colors" novalidate autocomplete="off" ng-class="{\'form-wrapper with-labels\':prop.type!=$ctrl.AttrTypes.SideNavLinks}">' +
            $ctrl.LCS.getErrorBlock() +
                            '<div ng-if="!(prop.type==$ctrl.AttrTypes.TopNavLinks || prop.type==$ctrl.AttrTypes.SideNavLinks)" ng-repeat="attr in prop.attributes">' +
                                 '<div class="form-group">' +
                                    '<label><span ng-bind="attr.label"></span> <a class="gray" ng-if="attr.tooltip" tooltip-placement-bottom tooltip-html="\'{{attr.tooltip}}\'">' +
            '<div class="wpadding inline-block">' +
            $ctrl.LCS.getISBDiv('info-circle', 4, 'gray') +
            '</div>' +
            '</a></label> <a ng-if="attr.type==$ctrl.AttrTypes.Image && $ctrl.item[attr.name]" ng-click="$ctrl.removeImage(prop, attr.name)" class="pull-right">Remove</a>' +
                                 '</div>' +
                                 '<div class="form-group">' +
                                    '<div ng-if="::attr.type==$ctrl.AttrTypes.Color" class="color-input"><span class="color-square" ng-style="{\'border\':$ctrl.item[attr.name].toLowerCase()==\'#ffffff\'?\'1px solid white\':\'\',\'background-color\':$ctrl.item[attr.name]?$ctrl.item[attr.name]:$ctrl.item[attr.def]}"></span><input placeholder="{{$ctrl.item[attr.def]}}" class="form-control with-underline" type="text" id="{{::attr.name}}" name="{{::attr.name}}" ng-model="$ctrl.item[attr.name]"></div>' +
'<sb-resizable-img ng-if="::attr.type==$ctrl.AttrTypes.Image" img-size="{{::attr.def}}" icon="add-img" img-prop="{{::attr.name}}" area-type="no-radius"  default-image="{{::$ctrl.item[attr.def]}}" size="::null" item="::$ctrl.item" ' +
           ($ctrl.canEdit ? 'can-upload-attr="true" collection-prop="devSetups" is-avatar-attr="true" ' : '') +
            '></sb-resizable-img>' +
                                 '</div>' +
                            '</div>' +
                            '<div ng-if="prop.type==$ctrl.AttrTypes.TopNavLinks" class="link-wrapper with-padding">' +
                                 '<table class="repeater-container shares list">' +
                                    '<tr class="line-item inrow with-underline" ng-repeat="link in $ctrl.item.linksTopLoggedOut" style="border-bottom-width:0">' +
                                        '<td class="col140">' +
                                             '<input tabindex="{{$ctrl.getFocus($index, 1)}}" placeholder="Name…" capitalize-first class="form-control with-underline switch-color" type="text" name="{{\'name\' + $index}}" ng-model="link.name" required ui-focus="$ctrl.isFocus($index, 1)">' +
                                             '<div ng-show="($ctrl.formHolderItem[prop.form][\'name\' + $index].$dirty || $ctrl.formHolderItem[prop.form+\'_attempted\']) && $ctrl.formHolderItem[prop.form][\'name\' + $index].$error.required" class="help-inline ng-hide lower">Name is required.</div>' +
                                        '</td>' +
                                        '<td>' +
                                             '<div class=" position-relative">' +
                                                '<input tabindex="{{$ctrl.getFocus($index, 1)}}" placeholder="URL…" class="form-controlwith-underline  switch-color" type="text" name="{{\'url\' + $index}}" ng-model="link.url" required>' +
                                                '<div ng-show="($ctrl.formHolderItem[prop.form][\'url\' + $index].$dirty || $ctrl.formHolderItem[prop.form+\'_attempted\']) && $ctrl.formHolderItem[prop.form][\'url\' + $index].$error.required" class="help-inline ng-hide lower">URL is required.</div>' +
                                             '</div>' +
                                        '</td>' +
                                        '<td class="remove-col with-no-padding col1">' +
                                             '<div class="remove with-hover with-dots"><a ng-click="$ctrl.removeLink($index)" class="editable-btn btn gray-light font-size-14" tooltip-placement="bottom" tooltip="Remove" style="position:absolute;top:16px;left:0"><span class="sbf cancel"></span></a></div>' +
                                        '</td>' +
                                    '</tr>' +
                                 '</table>' +
                                 '<div class="spacing-half-top">' +
                                    '<a class="small" ng-click="$ctrl.addLink()" ng-class="with-margin-right">+ Add Link</a>' +
                                 '</div>' +
                            '</div>' +
                            '<div ng-if="prop.type==$ctrl.AttrTypes.SideNavLinks" class="link-wrapper with-padding centering" style="width: 560px;padding-left: 40px">' +
                                 '<div class="repeater-container shares list">' +
                                    '<div class="row-schedule with-underline full-width" style="border-bottom-width:0;min-height: 35px" ng-if="$ctrl.overviewBlocks.length>0">' +
                                        '<div class="col46">&nbsp;</div>' +
                                        '<div class="grow-column form-group last padding-bottom-0">' +
                                             '<label>Menu Item</label>' +
                                        '</div>' +
                                    '</div>' +
                                    '<div ng-repeat="link in $ctrl.overviewBlocks">' +
                                        '<div ng-if="$index==1" class="row-schedule with-underline full-width" style="border-bottom-width:0">' +
                                             '<div class="col46">&nbsp;</div>' +
                                             '<div class="grow-column form-group last padding-bottom-0 spacing-half-top">' +
                                                '<label>SubMenu Items</label>' +
                                             '</div>' +
                                        '</div>' +
                                        '<div class="row-schedule with-underline full-width" style="border-bottom-width:0">' +
                                             '<div class="check hide-print">' +
                                                '<div ng-if="$index!=0" class="custom-checkbox inrow"><div class="col20 display-block position-relative"><label  tooltip="Open in new tab" tooltip-placement="bottom"><input type="checkbox" ng-checked="link.isBlank==true" ng-model="link.isBlank"><span></span></label></div>' +
                                                '</div>' +
                                             '</div>' +
                                             '<div class="col46">' +
                                                '<div class="position-relative"><sb-color-dropdown class="position-relative" ng-if="::!link.mainNav" init-list="::$ctrl.Colors" value="::link.color" with-uncheck="::true" style="top: -4px" on-change="$ctrl.colorChanged(result)"></sb-color-dropdown>' +
                                                '</div>' +
                                             '</div>' +
                                             '<div class="col200">' +
                                                '<div class="custom-icon-drp"><sb-icon-dropdown header="Change Icon" init-list="$ctrl.Icons" value="::link.icon" item-value="id" item-label="text" with-uncheck="true" class="position-relative" style="top: -4px; left: 5px;" on-change="$ctrl.onIconChanged(result)"></sb-icon-dropdown></div>' +
                                                '<input tabindex="{{$ctrl.getFocus($index, 1)}}" placeholder="Name…" capitalize-first class="form-control with-underline switch-color" type="text" name="name{{$index}}" ng-model="link.name" required ui-focus="$ctrl.isFocus($index, 1)" style="text-indent: 36px">' +
                                                '<div ng-show="($ctrl.formHolderItem[prop.form][\'name\' + $index].$dirty || $ctrl.formHolderItem[prop.form+\'_attempted\']) && $ctrl.formHolderItem[prop.form][\'name\' + $index].$error.required" class="help-inline ng-hide lower">Name is required.</div>' +
                                             '</div>' +
                                             '<div class="grow-column">' +
                                                '<div class="position-relative">' +
                                                    '<input tabindex="{{$ctrl.getFocus($index, 1)}}" placeholder="URL…" class="form-control with-underline switch-color" type="text" name="{{\'url\' + $index}}" ng-model="link.url" required>' +
                                                    '<div ng-show="($ctrl.formHolderItem[prop.form][\'url\' + $index].$dirty || $ctrl.formHolderItem[prop.form+\'_attempted\']) && $ctrl.formHolderItem[prop.form][\'url\' + $index].$error.required" class="help-inline ng-hide lower">URL is required.</div>' +
                                                '</div>' +
                                             '</div>' +
                                             '<div class="remove-col col40">' +
                                                '<div class="remove with-hover with-dots" ng-if="$ctrl.overviewBlocks.length===1||$ctrl.overviewBlocks.length>1&&!link.mainNav"><a ng-click="$ctrl.removeSideLink($index)" class="editable-btn btn gray-light font-size-14" tooltip-placement="bottom" tooltip="Remove" style="position:relative;top:6px;left:5px"><span class="sbf cancel"></span></a></div>' +
                                             '</div>' +
                                        '</div>' +
                                    '</div>' +
                                 '</div>' +
                                 '<div class="spacing-half-top">' +
                                    '<a style="padding-left: 50px" class="small" ng-click="$ctrl.addSideLink($event)" ng-class="with-margin-right">+ Add Link</a>' +
                                 '</div>' +
                            '</div>' +
                            '<div class="form-group field text-center spacing-half-top">' +
                                 '<button type="submit" class="btn btn-primary col345" ng-disabled="$ctrl.isUpdating || !$ctrl.formHolder[prop.form].$valid" ng-click="$ctrl.saveInfo(prop)" analytics-on analytics-action="Change Colors"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Apply</button>' +
                            '</div>' +
                        '</form>' +
                     '</div>' +
                '</div>' +
            '</div>';
    }

    function onSuccessUpdate(result, form) {
        $ctrl.formHolder[form].$setPristine();
        $ctrl.formHolder[form + '_attempted'] = false;
        //  $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.devSetup.' + form + '.success', 'success');
        $ctrl.LCS.timeout(function () {
            $ctrl.SBStateService.reloadPage();
        }, 200);
    }

    function onErrorUpdate(error, form) {
        $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'crud.devSetup.' + form + '.error');
        // $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.devSetup.save.error', 'error');
    }

    function saveInfo(prop) {
        var form = prop.form, data;
        $ctrl.error = null;
        $ctrl.formHolder[form + '_attempted'] = true;
        if (!$ctrl.formHolder[form] || !$ctrl.formHolder[form].$valid) {
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.devSetup.save.error.validation', 'error');
            return;
        }

        $ctrl.isUpdating = true;
        if (prop.type === $ctrl.AttrTypes.SideNavLinks) {
            //process updates
            //refresh rootoverview
            data = $ctrl.OverviewBlocksService.getChanges(['blocks'], {blocks: $ctrl.overviewBlocks}, {blocks: copyOverviewBlocks});
            if (data) {
                var blocks = $ctrl.overviewBlocks.map(function (item) {
                    if ($ctrl.overviewBlocks.length > 1 && item.mainNav) {
                        item.isSelectable = false;
                    }
                    delete item.$$hashKey;
                    return item;
                });
                $ctrl.OverviewBlocksService.updateCustom({overviewBlocks: blocks}, function (block) {
                    $ctrl.isUpdating = false;
                    copyOverviewBlocks = _.deepClone($ctrl.overviewBlocks);
                    var l = $ctrl.overviewBlocks.length;
                    if (l === 0) {
                        $ctrl.BlocksSetupService.customOverviewBlocks = null;
                    }
                    else {
                        if (!$ctrl.BlocksSetupService.customOverviewBlocks) {
                            $ctrl.BlocksSetupService.customOverviewBlocks = [];
                        }
                        for (var i = 0; i < l; i++) {
                            var el = $ctrl.overviewBlocks[i];
                            $ctrl.BlocksSetupService.customOverviewBlocks[el._id] = el;
                        }
                    }
                    $ctrl.SidebarConfigService.emitUpdateSidebar();

                }, onerror);
            }
        } else {
            data = $ctrl.DevSetupsService.getChanges(prop.changedFields, $ctrl.item, $ctrl.copyItem);
            if (data) {
                data._id = $ctrl.item._id;
                $ctrl.DevSetupsService.update(data, function (result) {
                    var item = result ? result.item : null;
                    $ctrl.isUpdating = false;
                    setCopy(item);
                    $ctrl.onSuccessUpdate(item, form);
                }, onerror);
            }
            else {
                $ctrl.isUpdating = false;
                //   $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.devSetup.'+form+'.success', 'success');
            }
        }

        function onerror(error) {
            $ctrl.isUpdating = false;
            $ctrl.onErrorUpdate(error, form);
        }
    }

    function changePane(sel) {
        if (sel !== $ctrl.selectedPane) {
            $ctrl.selectedPane = sel;
            $ctrl.CPS.setSearchFilter(sel, 'type');
        }
    }

    function isPane(sel) {
        return $ctrl.selectedPane === sel;
    }

    function loadOverview() {
        $ctrl.overviewBlocks = [];
        var cob = $ctrl.BlocksSetupService.customOverviewBlocks;
        if (cob) {
            for (var id in cob) {
                $ctrl.overviewBlocks.push(cob[id]);
            }
        }
        copyOverviewBlocks = _.deepClone($ctrl.overviewBlocks);
        if ($ctrl.overviewBlocks.length === 0) {
            addSideLink();
        }
    }

    function removeImage(prop, attr) {
        $ctrl.item[attr] = null;
        $ctrl.saveInfo(prop);
    }

    function onImageUpdate(result) {
        $ctrl.LCS.timeout(function () {
            $ctrl.SBStateService.reloadPage();
        }, 200);
    }

    function isFocus(index, val) {
        return getFocus(index, val) === $ctrl.focus;
    }

    function getFocus(index, val) {
        return index * 2 + val;
    }

    function addLink() {
        $ctrl.item.linksTopLoggedOut.push({
            name: null,
            url: null,
            isBtn: false,
            isBlank: true
        });

        $ctrl.focus = getFocus($ctrl.item.linksTopLoggedOut.length - 1, 1);
    }

    function removeLink(index) {
        $ctrl.item.linksTopLoggedOut.splice(index, 1);
    }

    function addSideLink(e) {
        $ctrl.preventDefault(e);
        var mainNav = $ctrl.overviewBlocks.length === 0;
        $ctrl.overviewBlocks.push($ctrl.OverviewBlocksService.convertResource({
            _id: new ObjectId().toString(),
            order: $ctrl.overviewBlocks.length + 1,
            mainNav: mainNav,
            parentNavId: mainNav ? null : _.find($ctrl.overviewBlocks, {mainNav: true})._id,
            isCustom: true,
            icon: $ctrl.Icons[0].id,
            color: $ctrl.Colors[0].id,
            isSelectable: true
        }));

        $ctrl.focus = getFocus($ctrl.overviewBlocks.length - 1, 1);
        /*
         name: String,
         url: String,
         shortName: String,
         */
    }

    function removeSideLink(index) {
        $ctrl.overviewBlocks.splice(index, 1);
    }

    function addSlackSource() {
        $ctrl.item.slackSources.push({
            type: $ctrl.SLACK_TYPES.NewUser,
            token: null,
            channel: null,
            //  icon: $ctrl.item.logoTopForm,
        });

        $ctrl.focus = getFocus($ctrl.item.linksTopLoggedOut.length - 1, 1);
    }

    function removeSlackSource(index) {
        $ctrl.slackSources.splice(index, 1);
    }

    function setCopy(item) {
        $ctrl.item = item;
        $ctrl.copyItem = _.deepClone($ctrl.item);
    }
}

angular.module('user.devsetup.routing', [
'user.devsetup.component'
])
.config(DevSetupRouting);

DevSetupRouting.$inject = ['$uiRouterProvider'];

function DevSetupRouting($uiRouter) {
    addStates($uiRouter, [{
        name: 'user.devSetup',
        url: '/devSetup?type',
        data: {
            minRole: 2,  minMemberType: 1,// only admins
            bodyClass: 'devSetup with-white-bg',
            title: 'App Configuration',
            hidePrint: true,
        },
        views: {
            loggedview: 'devsetupPage'
        },
        resolve: {
            item: DevSetupParam
        },
        reloadOnSearch: false
    }]);
}

DevSetupParam.$inject = ['DevSetupsService'];

function DevSetupParam(DevSetupsService) {
    return DevSetupsService.get(function (item) {
        return item;
    }, function (error) {
        return null;
    });
}

angular.module('user.settings', [
    'user.user-settings',
    'company.settings',
    'user.user-settings.routing'
]) ;

var userSettingsRoutingModule = angular.module('user.user-settings.routing', [
    'apiServices.Users',
    'apiServices.Companies',
    'services.persistenceService'
]);

UserSettingsRouting.$inject = ['$uiRouterProvider'];
CurrentUserParam.$inject = ['UsersService', 'security', 'CurrentProduct', '$transition$'];
EmailSettingsParam.$inject = ['EmailSettingsService', 'security'];

userSettingsRoutingModule.config(UserSettingsRouting);

function CurrentUserParam(UsersService, security, CurrentProduct, $transition$){
    var params = $transition$.params(),
        productId = params ? params.productId : null;
    if(!productId){CurrentProduct.broadcastProduct(null);}
    return UsersService.getById(security.getCurrentUserId(), "", function(result){
        return result ;
    }, function(error){
        return null;
    });
}

function EmailSettingsParam(EmailSettingsService, security) {
    return EmailSettingsService.getById(security.getCurrentUserId(), "", function (result) {
        return result;
    }, function (error) {
        return null;
    });
}

function UserSettingsRouting($uiRouter) {
    var usersParams = {
            item: CurrentUserParam
        },
        emailSettingsParams = {
            emailSettings: EmailSettingsParam
        },
        usersOnly = {
            minRole: 2, minMemberType: 0 // only users
        },
        ownersOnly = {
            minRole: 2, minMemberType: 2 // only owners
        },
        adminsOnly = {
            minRole: 2, minMemberType: 1 // only admins
        };

    addStates($uiRouter, [
        //user settings
        //addState('settings', 'Profile Settings', 'profile', '', 'user', null, usersParams);
        getState('profile-settings', 'My Profile', 'profileSettingsPage', 'profile', 'user', usersOnly, usersParams, true),
        getState('profile-reset-password', 'Change Password', 'changePasswordPage', 'change-password', 'user', usersOnly, usersParams, true),
        //getState('profile-email-settings', 'Email Settings', 'emailSettingsPage', 'email-settings', 'user', usersOnly, emailSettingsParams, true),

        //company settings
        getState('billing', 'Payment Methods', 'billingPage', 'billing', 'company', ownersOnly, {}, true),
        getState('invoices', 'Invoices', 'invoicesPage', 'invoices', 'company', ownersOnly, {}, true),

        getState('company-settings', 'Company Profile', 'companySettingsPage', 'company', 'company', adminsOnly, {}, true),
        getState('company-settings-projects', 'Project Defaults', 'companyProjectsSettingsPage', 'projects', 'company', adminsOnly, {}, true)

        // addState('company-settings-categories', 'Tagging Categories', 'categories', 'categories', 'company', 'GeneralTaggingCategoriesCtrl', []);
        // addState('company-settings-todocolumns', 'TodoColumns', 'todoColumns-settings', 'todo-columns', 'company', 'TodoColumnsCtrl', []);
        //   addState('company-settings-todopages', 'TodoPages', 'todoPages-settings', 'todo-pages', 'company', 'TodoPagesCtrl', []);
    ]);

    function getState(name, title, component, url, type, authorize, extraParam, withoutFilters) {
        return {
            name: 'user.' + name,
            data: _.extend({
                bodyClass: 'settings with-white-bg ' + (withoutFilters ? 'without-filters' : ''),
                title: title,
            }, authorize ? authorize : {}),
            views: {
                loggedview: component
            },
            resolve: getResolve(extraParam),
            url: '/settings' + (url !== ' ' ? ('/' + url) : '')
        };

        function getResolve(extraParam) {
            return _.extend({}, {
                templateType: function () {
                    return type;
                }
            }, extraParam);
        }
    }
}

angular.module('company.settings.init.service', [
    'profile.page.controller.service'
])
.service('SettingsInitCtrlService', SettingsInitCtrlService);
SettingsInitCtrlService.$inject = ['ProfilePageCtrlService'];
function SettingsInitCtrlService(ProfilePageCtrlService) {
    return function ($ctrl, $element, withFormTemplateCompileCtrlService) {
        var isNotPopup = true;

        $ctrl.preInitProfile = preInitProfile;
        $ctrl.getItemTemplate = getItemTemplate;

        return new ProfilePageCtrlService($ctrl, $element, withFormTemplateCompileCtrlService, isNotPopup);

        function preInitProfile() {
            if ($ctrl.preInitSettings) {
                $ctrl.preInitSettings();
            }
            if ($ctrl.getSettingsTemplate === undefined) {
                console.log('parent for SettingsInitCtrlService must define method getSettingsTemplate');
            }

            switch ($ctrl.templateType) {
                case 'company':
                    getSidebarInfoCompany();
                    break;

                case 'user':
                    getSidebarInfoUser();
                    break;

                case 'product':
                    getSidebarInfoProduct();
                    break;

                case 'dashboard':
                    getSidebarInfoDashboard();
                    break;
            }

            function getSidebarInfoDashboard() {
                $ctrl.sidebarTitle = 'Dashboard';
                $ctrl.sidebarLinks = $ctrl.SidebarConfigService.userDashboard;
            }

            function getSidebarInfoUser() {
                $ctrl.sidebarTitle = 'Profile Settings';
                $ctrl.sidebarLinks = $ctrl.SidebarConfigService.userSettings;
            }

            function getSidebarInfoCompany() {
                if (!$ctrl.sidebarLinks) {
                    $ctrl.sidebarLinks = $ctrl.SidebarConfigService.companySettings;
                }
                if (!$ctrl.sidebarTitle) {
                    $ctrl.sidebarTitle = 'Company Settings';
                }
            }

            function getSidebarInfoProduct() {
                if (!$ctrl.sidebarLinks) {
                    $ctrl.sidebarLinks = $ctrl.SidebarConfigService.productSettings;
                }
                if (!$ctrl.sidebarTitle) {
                    $ctrl.sidebarTitle = 'Project Settings';
                }
            }
        }

        function getItemTemplate() {
            if (typeof ($ctrl.setTemplateDataInit) === 'function') {
                $ctrl.setTemplateDataInit();
            }

            if ($ctrl.isPaymentFailed) {
                return $ctrl.getSettingsTemplate();
            }
            return $ctrl.getItemTemplateProfile();
        }

    }
}

angular.module('user.settings.change-password.page.component', [
    'user.settings.init.controller.service'
])
.component('changePasswordPage', {
    bindings: {
        item: '<',
    },
    controller: 'ChangePasswordPageCtrl'
})
.controller('ChangePasswordPageCtrl', ChangePasswordPageCtrl);

ChangePasswordPageCtrl.$inject = ['UserSettingsCtrlService', '$element'];

function ChangePasswordPageCtrl(UserSettingsCtrlService, $element){
    var $ctrl = this;

    $ctrl.setTemplateDataSettings = setTemplateDataSettings;
    $ctrl.getSettingsTemplate = getSettingsTemplate;
    $ctrl.getDataToUpdate = getDataToUpdate;

    $ctrl = new UserSettingsCtrlService($ctrl, $element);

    function setTemplateDataSettings() {
        $ctrl.formName = 'editUserPassword';
        $ctrl.icon = 'lock';
        $ctrl.popupTitle = 'Change Password';
    }

    function getDataToUpdate() {
        return {
            _id: $ctrl.item._id,
            changePassword: true,
            password: $ctrl.item.password
        };
    }

    function getSettingsTemplate() {
        return '<div class="tab-content with-white-bg with-padding margin-half h-full h-full-55">' +
                $ctrl.getPopupHeader()+
                '<div class="form-wrapper">' +
                    '<form name="$ctrl.formHolderItem[$ctrl.formName]" novalidate autocomplete="off" class="form-wrapper spacing-bottom">' +
                        '<div class="form-group sbfgroup field">' +
                            '<span class="sbf lock"></span>' +
                            '<input placeholder="New password…" class="form-control with-underline" type="password" id="password" name="password" ng-model="$ctrl.item.password" required>' +
                            '<label ng-show="$ctrl.item.password" class="with-label">Password</label>' +
                            '<div ng-show="($ctrl.formHolderItem[$ctrl.formName][\'password\'].$dirty || $ctrl.formHolderItem[$ctrl.formName+\'_attempted\']) && $ctrl.formHolderItem[$ctrl.formName][\'password\'].$error.required" class="help-inline ng-hide">Password is required.</div>' +
                            '<div ng-show="($ctrl.formHolderItem[$ctrl.formName][\'password\'].$dirty || $ctrl.formHolderItem[$ctrl.formName+\'_attempted\']) && $ctrl.formHolderItem[$ctrl.formName][\'password\'].$error.equal" class="help-inline ng-hide">Passwords do not match.</div>' +
                        '</div>' + 
                        '<div class="form-group sbfgroup field">' +
                            '<span class="sbf lock"></span>' +
                            '<input placeholder="Confirm password…" class="form-control with-underline" type="password" id="passwordRepeat" name="passwordRepeat" ng-model="$ctrl.item.passwordVerify" required validate-equals="$ctrl.item.password">' +
                            '<label ng-show="$ctrl.item.passwordVerify" class="with-label">Password</label>' +
                            '<div ng-show="($ctrl.formHolderItem[$ctrl.formName][\'passwordRepeat\'].$dirty || $ctrl.formHolderItem[$ctrl.formName+\'_attempted\']) && $ctrl.formHolderItem[$ctrl.formName][\'passwordRepeat\'].$error.required" class="help-inline ng-hide">Confirm password is required.</div>' +
                            '<div ng-show="($ctrl.formHolderItem[$ctrl.formName][\'password\'].$dirty || $ctrl.formHolderItem[$ctrl.formName+\'_attempted\']) && $ctrl.formHolderItem[$ctrl.formName][\'passwordRepeat\'].$error.equal" class="help-inline ng-hide">Passwords do not match.</div>' +
                        '</div>' + 
                        '<div class="form-group field text-center spacing-half-top">' +
                            '<button type="submit" class="btn btn-primary full-width" ng-disabled="$ctrl.isUpdating || !$ctrl.formHolderItem[$ctrl.formName].$valid" ng-click="$ctrl.save()" analytics-on analytics-action="Change Password"><span class="sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> Change Password</button>' +
                        '</div>' +
                    '</form>' +
                '</div>' +
            '</div>';
    }
}

angular.module('user.settings.email-settings.page.component', [
