])
.config(CastCalltimeRouting);

CastCalltimeRouting.$inject = ['$uiRouterProvider'];
InvitationParam.$inject = ['$transition$', 'CallsheetInvitationsService'];
ApproverParam.$inject = ['$transition$', 'ApprovalsService'];

function CastCalltimeRouting($uiRouter) {
    var parent = 'user.product.callsheet.';

    addStates($uiRouter, [
        {
            name: parent + 'confirm-invite',
            //url: '/confirm-callsheet/:invitationId/:cisId',
            url: '/confirm-callsheet/:invitationId',
            data: {
                bodyClass: 'callsheet-page view-mode no-sidebar confirm-invite ',
                title: 'Confirm Call Sheet'
            },
            views: {
                'bodyCallsheet': {
                    component: 'callsheetConfirmPage',
                }
            },
            resolve: {
                info: InvitationParam
            }
        },
        {
            name: parent + 'preview-recipient',
            url: '/preview-recipient/:invitationId',
            data: {
                bodyClass: 'callsheet-page view-mode ',
                title: 'Personalized Call Sheet'
            },
            views: {
                'bodyCallsheet': {
                    component: 'callsheetPreviewPage',
                }
            },
            resolve: {
                info: InvitationParam,
            }
        },
        {
            name: parent + 'view-shared',
            url: '/shared/:invitationId',
            data: {
                bodyClass: 'callsheet-page view-mode no-sidebar view-shared ',
                title: 'View Shared Call Sheet'
            },
            views: {
                'bodyCallsheet': {
                    component: 'callsheetSharedPage',
                }
            },
            resolve: {
                info: ApproverParam,
            }
        }]);
}

function ApproverParam($transition$, ApprovalsService) {
    console.log('CastCalltimeRouting - paramsShare');
    var params = $transition$.params(),
        id = params ? params.invitationId : null;
    if (!id) {
        return null;
    }
    return ApprovalsService.getById(id, "createdById", function (result) {
        return result;
    }, function (error) {
        return null;
    });
}

function InvitationParam($transition$, CallsheetInvitationsService) {
    console.log('CastCalltimeRouting - paramsInvite');
    var params = $transition$.params(), id = params ? params.invitationId : null;
    if (!id) {
        return null;
    }
    return CallsheetInvitationsService.getById(id, "castId createdById callsheetInvitationSentId", function (result) {
        return result;
    }, function (error) {
        return null;
    });
}


