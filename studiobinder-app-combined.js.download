function TempShotsService(ApiService, model) {
    var service = ApiService(model, {
        listType: 'isGroup',
        listField: 'shotsListId',
        withAutoBreaks: true,
        materialProps: ['logo'],
        fieldsUpdatedOnOrderChanged: ['shotNo', 'stripId',  'name', 'setupId', 'shotsCount',
            'estTime', 'prepTime', 'shootTime', 'duration',
            'time','endTime','timeComp','endTimeComp',  'date']
    });

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.getEditableFields = getEditableFields;

    service.updateSetup = updateSetup;
    service.addEmpty = addEmpty;

    return service;

    function getChangedFieldForUpdateOther() {
        return ['shotsCount', 'stripId', 'order','color', 'status', 'name', 'sceneNo', 'shotNo', 'customShotNo',  'subject', 'vfx','camera', 'size', 'types', 'movement', 'lens', 'frameRate', 'special', 'equipment', 'lighting', 'sound', 'location', 'locationId',
            'estTime', 'prepTime', 'shootTime', 'duration',
            'time', 'endTime', 'timeComp','endTimeComp',  'shotsListId', 'note', 'logo', 'logoId', 'logoRatio', 'commentsCount', 'setupId'];
    }

    function getEditableFields(type) {
        var def = ['name', 'time', 'endTime', 'timeComp','endTimeComp',
                'estTime', 'prepTime', 'shootTime', 'duration',
                'note'],
            el;
        switch (type) {
            case 0://$ctrl.stripTypes.Setup://to be updated on daybreak
                el = ['date', 'shotsCount'];
                break;

            case 1://$ctrl.stripTypes.Shot://to be updated on scene
                el = ['color', 'status',  'sceneNo', 'shotNo', 'customShotNo', 'subject',  'vfx', 'camera', 'size', 'types', 'movement', 'lens', 'frameRate', 'special', 'equipment', 'lighting', 'sound', 'location', 'logo'  ]; //'order'
                break;

            case 2: //$ctrl.stripTypes.Banner://to be updated on banner
                el = ['color'];
                break;
        }
        return [].concat(el, def);
    }

    function addEmpty(params, successcb, errorcb) {
        return service.postUrl('/add-empty', params, successcb, errorcb, true);
    }

    function updateSetup(params, successcb, errorcb) {
        return service.postUrl('/update-setup', params, successcb, errorcb);
    }

    function autoBreaks(params, successcb, errorcb){
        return service.postUrl( '/auto-breaks', params, successcb, errorcb);
    }

}

