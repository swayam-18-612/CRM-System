    }
}


angular.module('product.breakdowns.viewScene.popup.component', [
    'product.breakdowns.viewScene.controller.service'
])
.component('viewScenePopup', popupComponentParams('ViewScenePopupCtrl'))
.controller('ViewScenePopupCtrl', ViewScenePopupCtrl);

ViewScenePopupCtrl.$inject = ['ViewSceneCtrlService', '$element'];
function ViewScenePopupCtrl(ViewSceneCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.getItemPopupTemplate = getItemPopupTemplate;
    $ctrl.onLoadedScene = onLoadedScene;

    $ctrl = new ViewSceneCtrlService($ctrl, $element, $ctrl.isPopup);

    function onLoadedScene() {
        if (!$ctrl.isPopup) {
            return;
        }

        var modal = $ctrl.LCS.findClosestParent($ctrl.element, '.modal-dialog');
        if (modal) {
            $ctrl.LCS.replaceClass(modal, 'modal-lg', 'modal-xl h-full');
        }

       $ctrl.addRootWatcher('CLOSE_POPUP_VIEW_SCENE', function (){
           $ctrl.close();
       });
    }

    function getItemPopupTemplate() {
        $ctrl.withCloseBtn = true;
        return $ctrl.getItemPopupMSForm([{
            fCls: 'h-full with-no-padding with-no-margin',
            cls: 'compare-script h-full step',
            body: $ctrl.getBody(),
            fieldsetCls: 'h-full'
        }], 'h-full', false);
    }
}


