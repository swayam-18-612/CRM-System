NoDayBreaksPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', '$element'];
function NoDayBreaksPopupCtrl(ItemTemplateCompileCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.goToStripboard = goToStripboard;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.preInitOther = preInitOther;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitOther() {
        if (!$ctrl.extraParam) {
            $ctrl.extraParam = {};
        }
    }

    function setTemplateData() {
        $ctrl.icon = 'stripboard';
        $ctrl.iconLevel = 5;
        $ctrl.popupTitle = 'No Strips Have Been Added';

        $ctrl.withFooterBtns = true;
        $ctrl.btnText = 'Go To Stripboard';
        $ctrl.firstBtnMethod = 'goToStripboard';
    }

    function getPopupBodyContent() {
        return '<p class="text-center">There are no strips on your stripboard yet.</p>';
    }

    function goToStripboard(e) {
        $ctrl.preventDefault(e);
        $ctrl.closePopup();
        $ctrl.LCS.timeout(function () {
            if ($ctrl.extraParam.closeParent) {
                $ctrl.extraParam.closeParent();
            }
        }, 10);
        $ctrl.CPS.transitionTo('user.product.scheduling', $ctrl.CPS.currentProductPathParams());
    }
}

