.service('MaterialPageCtrlService', MaterialPageCtrlService);
MaterialPageCtrlService.$inject = ['PageSimpleInitCtrlService', 'MaterialInitCtrlService', 'MaterialConstantsService'];

function MaterialPageCtrlService(PageSimpleInitCtrlService, MaterialInitCtrlService, constantsService) {
    return function ($ctrl, $element) {
        console.log('MaterialPageCtrlService');

        $ctrl.isMaterial = true;
        $ctrl.withoutSidePadding = true;

        $ctrl.getTopFiltersBeforeTitle = getTopFiltersBeforeTitle;
        $ctrl.onFileUploadCompleteOther = onFileUploadCompleteOther;
        $ctrl.loadDirectory = loadDirectory;

        //to get the sidebar
        $ctrl.onFileLoaded = onFileLoaded;
        $ctrl.onImageEdited = onImageEdited;

        $ctrl.$onInit = $onInit;
        $ctrl.$onDestroy = $onDestroy;
        $ctrl.onPageLoaded = onPageLoaded;
        $ctrl.getPageTemplate = getPageTemplate;
        $ctrl.getDrpSettings = getDrpSettings;
        $ctrl.openDownload = openDownload;
        $ctrl.openVersions = openVersions;
        $ctrl.isWithSidebar = isWithSidebar;

        if (!$ctrl.isPopup) {
            $ctrl.getLeftButtons = getLeftButtons;
        }

        $ctrl = new PageSimpleInitCtrlService($ctrl, $element, {
            constantsService: _.extend({}, constantsService)
        });

        return $ctrl;

        function getLeftButtons() {
            return $ctrl.getListNavComments('$ctrl.material') +
                $ctrl.getDrpSettings();
        }

        function isWithSidebar() {
            return !$ctrl.isPopup;
        }

        function getDrpSettings() {
            var canview = $ctrl.material && $ctrl.material.active,
                canedit = canview && $ctrl.canEdit,
                canDownload = canview;
            $ctrl.liEvents = [];
        return '<div ng-show="$ctrl.material" dropdown class="pull-left position-relative dropdown dropdown-wrapper">' +
                    '<button id="btnSettings" type="button" class="btn btn-small primary-faded without-text dropdown-toggle with-margin-left" dropdown-toggle tooltip="More" tooltip-placement="bottom">' + $ctrl.LCS.getISBDiv('horizontal-dots', 3) + '</button>' +
                    '<div class="dropdown-menu side-menu fadeInDownLeft" role="menu" style="width: 212px;left: -175px">' +
                        '<ul class="listitems-selector with-checked">' +
                        (canedit ? (
                            addLi('Version History', 'openVersions', 'versions', false, false, false
                            )
                        ) : '') +
                        //to do
                        /*  (canDownload ? (
                              addLi('Download PDF', 'openDownload', 'download-pdf', false, false, canedit && "$ctrl.material && $ctrl.material.version && $ctrl.material.version.documentType") +
                           //   addLi('Download File', 'openDownload', 'download', false, false, canedit)
                            ) : '') +*/
                        '</ul>' +
                    '</div>' +
                '</div>';

            function addLi(n, m, i, isMobile, withBorderBottom, withBorderTop, cond) {
                $ctrl.liEvents.push(m);
                return '<li ' +
                    (cond ? ('ng-show="' + cond + '" ') : '') +
                    ((isMobile) ? ('ng-show="' + (isMobile ? '$ctrl.LCS.isMobileSize' : '') +
                        '"') : '') +
                    (withBorderBottom ? ' class="with-border-bottom"' : '') +
                    (withBorderTop ? ' class="with-border-top"' : '') +
                    '><a data-type="' + m + '" class="' + $ctrl.getBtnActionCls() + ' table-div full-width  ' +
                    'analytics-on analytics-action="' + n + '"><div class="col30">' + $ctrl.LCS.getISBDiv(i, 5, 'pull-left') + '</div> <div>' + n + '</div></a></li>';
            }
        }

        function onPageLoaded() {
            if (typeof ($ctrl.onPageLoadedOther) === 'function') {
                $ctrl.onPageLoadedOther();
            }

            if (typeof ($ctrl.onLoadedOther) === 'function') {
                $ctrl.onLoadedOther();
            }
        }

        function getTopFiltersBeforeTitle() {
            return '<div data-type="openVersions" class="' + $ctrl.getBtnActionCls() + ' with-cursor with-cursor col50 centered position-relative pull-left btnOpenVersions table-div margin-right10" analytics-on analytics-action="Open Versions" tooltip="Open Versions" tooltip-placement="bottom"><div class="size centering spacing-bottom margin-top-quarter version-label full-width">v <span class="txtVersion"></span></div><div class="sbf pull-right arrow-filled-down hide-print blue" ></div></div>';
        }

        function $onInit() {
            if (typeof ($ctrl.preInit) === 'function') {
                $ctrl.preInit();
            }
            $ctrl = new MaterialInitCtrlService($ctrl);

            $ctrl.onSimplePageInit({}, reload);
        }

        function $onDestroy() {
            $ctrl.onSimplePageDestroy();
            $ctrl.onMaterialInitDestroy();
        }

        function reload() {
            console.log('onreload');
            if (!$ctrl.materialId) {
                return done();
            }

            async.parallel({
                material: function (c) {
                    $ctrl.service.getById($ctrl.materialId, 'versionId', function (result) {
                        c(null, result);
                    }, function (err) {
                        console.log(err);
                        c(null, null);
                    });
                },
                breadcrumbs: function (c) {
                    $ctrl.service.getBreadcrumbs({
                        id: $ctrl.materialId
                    }, function (result) {
                        c(null, result);
                    }, function (err) {
                        console.log(err);
                        c(null, null);
                    });
                }
            }, onsuccess);

            function onsuccess(err, result) {
                onUpdateVersion(result);
                $ctrl.breadcrumbs = result.breadcrumbs || [];
                done();
                if ($ctrl.material && $ctrl.canEdit) {
                    $ctrl.addRootWatcher('UPDATE_FILE_VERSION', onUpdateVersion);
                }
            }

            function done() {
                $ctrl.reloadPageTemplate(false, $ctrl.onPageLoaded);
            }
        }

        function getPageTemplate() {
            if (!$ctrl.materialVersionId) {
                return '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
            }
            var doesntexist = !$ctrl.materialId || !$ctrl.material;
            if (!$ctrl.withoutSidePadding) {
                $ctrl.withoutSidePadding = doesntexist;
            }

            //if is on page show sidebar comments
            $ctrl.withComments = $ctrl.canComment && $ctrl.isPopup;

            return (doesntexist ? '' : $ctrl.getInitTopFilters()) +
                '<div class="tab-content text-center with-no-bg h-full margin-half-top ' + (doesntexist ? '' : 'with-filters ') + ($ctrl.withoutSidePadding ? 'without-side-padding' : '') + '" ng-class="{\'without-side-padding\':$ctrl.withoutSidePadding}">' +
                '<div class="h-full">' +
                '<material-viewer class="material-viewer" material-version-id="$ctrl.materialVersionId" material="$ctrl.material" with-comments="::$ctrl.withComments" can-upload="::$ctrl.canEdit" can-comment="::$ctrl.canComment" on-image-edited="$ctrl.onImageEdited(result)" editor-options="::$ctrl.editorOptions" on-file-loaded="$ctrl.onFileLoaded(version)"></material-viewer>' +
                '</div>' +
                '</div>';
        }

        function onFileLoaded(result) {
            console.log('onFileLoaded');
            if (!result) {
                return;
            }
            if (!$ctrl.withoutSidePadding) {
                $ctrl.withoutSidePadding = result.withoutSidePadding;
            }
        }

        function onImageEdited() {
            console.log('onImageEdited');
        }

        function loadDirectory(item) {
            if (item) {
                var params = {
                        productId: $ctrl.CPS.productId
                    },
                    rolePath = $ctrl.CPS.isCollaborator ? $ctrl.CPS.rolePaths.collabPath : $ctrl.CPS.rolePaths.currentUserPath;
                if (item.isFolder) {
                    params.parentId = item ? item._id : null;
                    $ctrl.CPS.transitionTo($ctrl.SBStateService.getCurrentStateName(),
                        $ctrl.CPS.currentPathParams(params, rolePath), {
                            reload: false,
                            notify: false,
                            location: true
                        });
                } else {
                    params.materialId = item._id;
                    if ($ctrl.CPS.isCollaborator) {
                        $ctrl.popupsService.open(null, $ctrl.popupsService.operations.singleMaterial, params, $ctrl.compOptions);
                    } else {
                        $ctrl.CPS.transitionTo('user.product.' + $ctrl.objectType, $ctrl.CPS.currentPathParams(params, rolePath));
                    }
                }
            }
        }

        function openVersions(e) {
            $ctrl.preventDefault(e);
            $ctrl.popupsService.teamAccess(function () {
                $ctrl.popupsService.open($ctrl.material, $ctrl.popupsService.operations.fileVersions, {
                    canEdit: $ctrl.canEdit
                }, $ctrl.compOptions);
            });
        }

        function onFileUploadCompleteOther(result) {
            console.log('onFileUploadCompleteOther');
            var el = result.item;
            if (el) {
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.version.upload.success', 'success', {name: el.name ? el.name : ''});
            }
            //  else  $ctrl.i18nNotifications.pushForCurrentRoute (null, 'crud.file.Create.error', 'error');
            $ctrl.material = el;
        }

        function onUpdateVersion(result) {
            $ctrl.material = result.material;
            if ($ctrl.material) {
                $ctrl.materialVersionId = $ctrl.material.versionId;
                $ctrl.title = $ctrl.material.version ? $ctrl.material.version.name : $ctrl.material.name;
            } else {
                $ctrl.materialVersionId = null;
                $ctrl.title = null;
            }
            $ctrl.LCS.timeout(function () {
                var el = $ctrl.element.querySelector('.txtVersion');
                if (el) {
                    el.innerText = $ctrl.material.version ? $ctrl.material.version.version : '';
                }
            }, 100);
        }

        function openDownload() {
            var item = $ctrl.material;
            if (!item) {
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.download.error', 'error');
                return;
            }
            $ctrl.popupsService.open(item, $ctrl.popupsService.operations.documentDownload, {
                itemTitle: 'Version',
                versionId: item._id,
                title: item.name,
                titlePage: item.titlePage,
                createdBy: item.createdBy
            }, $ctrl.compOptions);
        }
    }
}

angular.module('product.material.page.popup.component',[
    'product.material.page.controller.service'
])
.component('singleMaterialPopup', popupComponentParams('SingleMaterialPopupCtrl', true))
.controller('SingleMaterialPopupCtrl', SingleMaterialPopupCtrl);
SingleMaterialPopupCtrl.$inject = ['MaterialPageCtrlService', '$element'];
function SingleMaterialPopupCtrl(pageCtrlService, $element) {
    console.log('SingleMaterialPopupCtrl');
    var $ctrl = this;

    $ctrl.isPopup = true;
    $ctrl.popupInitParams = ['materialId'];

    $ctrl.preInit = initPopupParams;

    $ctrl = new pageCtrlService($ctrl, $element);

    function initPopupParams(){
        if ($ctrl.extraParam && $ctrl.popupInitParams) {
            _.each($ctrl.popupInitParams, function (prop) {
                $ctrl[prop] = $ctrl.extraParam[prop];
            });
        }
    }
}

angular.module('product.material.versions.component',[
    'list.ctrl',
    'apiPagination.MaterialVersions'
])
.component('fileVersionsPopup', popupComponentParams('FileVersionsPopupCtrl'))
.controller('FileVersionsPopupCtrl', FileVersionsPopupCtrl);
FileVersionsPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', 'MaterialVersionsPagination', 'ListInitService', '$element'];
function FileVersionsPopupCtrl(ItemTemplateCompileCtrlService, MaterialVersionsPagination, ListInitService, $element) {
    console.log('FileVersionsPopupCtrl');
    var $ctrl = this; //ListInitService inherits  CompInitCtrlService;

    $ctrl.isPopup = true;

    $ctrl.formHolder = {};

    $ctrl.rename = rename;
    $ctrl.getDownloadLink = getDownloadLink;
    $ctrl.view = view;
    $ctrl.removeVersion = removeVersion;
    $ctrl.getData = getData;
    $ctrl.makeCurrent = makeCurrent;

    $ctrl.preInit = preInit;
    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInit() {
        $ctrl = new ListInitService($ctrl, {
            list: new MaterialVersionsPagination(1000,
                ["name", "version", "createdById", "createdAt", 'path', 'current', 'materialId', 'contentVersionId'],
                ['name'],
                ['version', 'createdAt'],
                ['createdById']
            ),
            preloadAll: true,
            orders: {version: -1},
            withProperty: withProperty
        });

        $ctrl.getAll();
    }

    function setTemplateData() {
        $ctrl.icon = 'versions';
        $ctrl.iconLevel = 3;
        $ctrl.popupTitle = 'File Version History';
    }


    function view(item, e) {
        console.log('view script version');

        $ctrl.popupsService.open(item._id, $ctrl.popupsService.operations.materialViewer, {
            // withDownload: true,
            withComments: false,
            canComment: false,
            canUpload: false,
            withoutSidebar: true,
            withHeader: true
        }, null, null, function (result) {
            console.log('onSuccess');
        });
    }

    function getPopupBodyContent(){
return '<div ng-show="$ctrl.list.isLoaded" class="table-rewards scripts">' +
            '<div ng-show="$ctrl.list.items.length>0" ' +
    /*'infinite-scroll="$ctrl.list.nextPage()" ' +
    'infinite-scroll-disabled="$ctrl.list.busy" ' +
    'infinite-scroll-distance="1"' +*/
    '>' +
                '<div class="version-row centering " ng-class="{\'with-border-bottom\':listIndex!=$ctrl.list.items.length-1}" ng-repeat="(listIndex, item) in $ctrl.list.items track by item._id">' +
                    '<div class="file table-div full-width">' +
                        '<div class="centered padding-right10 col30 with-margin-right"><div ng-bind="\'v\'+item.version" class="mark-version file"></div></div>' +
                        '<div class="centered"' + ($ctrl.canEdit ?' ng-show="!item.rename"':'') + '>' +
                            '<a ng-bind="item.name" class="gray semibold"' +
    ' ng-click="$ctrl.view(item, $event)" ' +
    //' ng-click="$ctrl.getDownloadLink(item, $event)" ' +
    'analytics-on analytics-action="Download File Version" target="_self"></a>' +
                            '<div class="inline-block with-margin-left current" ng-if="item.current">Current</div>' +
                        '</div>' +
                        ($ctrl.canEdit ? ( '<form class="centered auto" ng-show="item.rename" name="$ctrl.formHolder.form{{::item._id}}" novalidate>' +
                            '<div class="text-center white thinner inline-block">' +
                                '<input placeholder="Version Name…" class="font-size-12 max-width300 form-control with-underline inline-block"  id="name{{::item._id}}" name="name{{::item._id}}" type="text" ng-model="item.name" select-on-click="true"/>' +
                                '<div ng-show="($ctrl.formHolderItem.formItem.name.$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem.formItem.name.$error.required" class="help-inline ng-hide text-left">Version name is required.</div>' +
                            '</div>' +
                            '<div class="inline-block with-margin-left">' +
                                '<button style="min-width: 60px;margin-right: 10px" type="submit" class="col60 btn primary smallbtn pull-left small-btns" ng-click="$ctrl.rename(item)">Save</button>' +
                                '<a class="cancelsmall" ng-click="item.rename = false">Cancel</a>' +
                            '</div>' +
                        '</form>') :'') +
                    '</div>' +
                    '<div class="uploadedinfo">Uploaded on {{::item.createdAt|amDateFormat:$ctrl.CPS.dateTimeFormat}} by {{::item.createdBy.name}}</div>' +
                    ($ctrl.canEdit ? ('<div>' +
                        '<a ng-if="!item.current" ng-click="$ctrl.makeCurrent(item)" analytics-on analytics-action="Make Current">Make Current</a>' +
                        '<div ng-if="!item.current" class="dot-container"><span class="dot-separator"></span></div>' +
                        '<a ng-click="item.rename = true">Rename</a>' +
                        '<div ng-if="!item.current" class="dot-container"><span class="dot-separator"></span></div>' +
                        '<a ng-if="!item.current" ng-click="item.confirmRemove = true">Remove Version</a>' +
                    '</div>' +
                    '<div class="layer" ng-show="item.confirmRemove">' +
                        '<div class="text-center white">Are you sure you want to remove this version?</div>' +
                        '<div class="text-center">' +
                            '<a class="margin-right-20" ng-click="$ctrl.removeVersion(item)">Remove</a>' +
                            '<a ng-click="item.confirmRemove = false">Cancel</a>' +
                        '</div>' +
                    '</div>' ):'')+
                '</div>' +
                '<loading-more ng-if="$ctrl.list.busy"></loading-more>' +
            '</div>' +
            '<loading-more ng-if="$ctrl.list.busy"></loading-more>' +
        '</div>' +
        '<preloader-center ng-if="!$ctrl.list.isLoaded" class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
    }

    function removeVersion(item) {
        $ctrl.error = null;
        $ctrl.service.delete(item, onsuccess, onerror);

        function onsuccess(el) {
            if (el.item) {
                el = el.item;
            }
            if ($ctrl.list && $ctrl.list.items) {
                $ctrl.list.removeElement(el);
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.version.Remove.success', 'success');
            }
        }

        function onerror(err) {
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.version.Remove.error', 'error');
        }
    }

    function getData(item) {
        var p = {
            versionId: item._id,
            id: item.materialId,
            type: $ctrl.objectType
        };

        if ($ctrl.extraParam) {
            for (var e in $ctrl.extraParam) {
                p[e] = $ctrl.extraParam[e];
            }
        }

        return p;
    }

    function makeCurrent(item) {
        var data = $ctrl.getData(item);
        $ctrl.service.makeCurrent(data, onsuccess, onerror);

        function onsuccess(result) {
            var el = result && result.material ? result.material : null;
            if (el) {
                //reset current
                $ctrl.list.replaceAllElementsProps({current: false});
                var v = el.versionId._id;
                el.version = el.versionId;
                el.version.createdById = $ctrl.CPS.user;
                el.versionId = v;
                if (el.version && $ctrl.list && $ctrl.list.items) {
                    $ctrl.list.replaceElement(el.version);
                }
                $ctrl.broadcastRoot('UPDATE_FILE_VERSION', result);

                if ($ctrl.onClose) {
                    $ctrl.onClose({result:result});
                }
            }
        }

        function onerror(err) {
            $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.version.makeCurrent.error', 'error');
        }
    }

    function rename(item) {
        $ctrl.formHolder['form' + item._id + '_attempted'] = true;
        var form = $ctrl.formHolder['form' + item._id];

        if (form && form.$valid) {
            $ctrl.isUpdating = true;

            $ctrl.service.update({
                _id: item._id,
                name: item.name
            }, onsuccess, onerror);
        }

        function onsuccess(result) {
            $ctrl.isUpdating = false;
            // $ctrl.list.items[index].name  = el.name ;
            item.rename = false;
        }

        function onerror(error) {
            $ctrl.isUpdating = false;
            $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.version.Edit.error', 'error');
        }
    }

    function getDownloadLink(item, e) {
        $ctrl.preventDefault(e);
        item.isDownloading = true;
        item.productId = $ctrl.CPS.productId;
        item.companyId = $ctrl.CPS.companyId;

        $ctrl.service.getDownloadLink({
            id: $ctrl.item._id,
            versionId: item._id,
            productId: item.productId,
            companyId: item.companyId,
        }, onsuccess, onerror);

        function onsuccess(link) {
            $ctrl.LCS.timeout(function () {
                item.isDownloading = false;
                $ctrl.SBStateService.assignUrl(link, null);
            }, 500);


            return false;
        }

        function onerror(err) {
            item.isDownloading = false;
            item.downloadLink = null;
        }
    }

    function withProperty() {
        return {
            companyId: $ctrl.CPS.companyId,
            productId: $ctrl.item.productId,
            materialId: $ctrl.item._id
        };
    }
}

angular.module('product.material.popup.component',[
    'product.material.viewer.controller.service'
])
.component('materialViewerPopup', popupComponentParams('MaterialViewerPopupCtrl'))
.controller('MaterialViewerPopupCtrl', MaterialViewerPopupCtrl);
MaterialViewerPopupCtrl.$inject = ['MaterialViewerCtrlService', '$element'];
function MaterialViewerPopupCtrl(MaterialViewerCtrlService, $element) {
    console.log('MaterialViewerPopupCtrl');
    var $ctrl = this;
    $ctrl.isPopup = true;
    $ctrl = new MaterialViewerCtrlService($ctrl, $element, $ctrl.isPopup);
}

angular.module('product.material.viewer.controller.service',[
    'apiServices.MaterialVersions',
    'components.fileUploader.uploader.service',
    'templateCompilePopup.controller.service'
])
.service('MaterialViewerCtrlService', MaterialViewerCtrlService);
MaterialViewerCtrlService.$inject = ['ItemTemplateCompileCtrlService'];
function MaterialViewerCtrlService(ItemTemplateCompileCtrlService) {
    return function ($ctrl, $element, isPopup) {
        console.log('MaterialViewerCtrlService');

        $ctrl.preInit = preInit;
        $ctrl.onLoaded = onLoaded;
        $ctrl.onDestroy = onDestroy;

        $ctrl.onImageEdited = onImageEdited;
        $ctrl.close = close;

        $ctrl.getItemTemplate = getItemTemplate;
        $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function preInit() {
            $ctrl.materialVersionId = $ctrl.item;
            if (!$ctrl.extraParam) {
                $ctrl.extraParam = {};
            }
            $ctrl.withComments = $ctrl.extraParam.withComments;
            $ctrl.withNext = $ctrl.extraParam.withNext;
            //$ctrl.withNext = false;
            $ctrl.currentList = _.clone($ctrl.extraParam.currentList);
            if($ctrl.currentList && $ctrl.currentList.withCommentsOnItem && $ctrl.currentList.todoPage) {//when  comes from dashboard activity
                $ctrl.todoPage = $ctrl.currentList.todoPage;
            }//comments are added to items
            $ctrl.canComment = $ctrl.withComments ? $ctrl.extraParam.canComment : false;
            $ctrl.editorOptions = $ctrl.extraParam.editorOptions;
            $ctrl.canUpload = $ctrl.extraParam.canUpload;
            $ctrl.withHeader = $ctrl.extraParam.withHeader;
            $ctrl.withoutSidebar = $ctrl.extraParam.withoutSidebar;
            $ctrl.withBack = $ctrl.extraParam.withBack;
            $ctrl.startWithLikes = $ctrl.extraParam.startWithLikes;
            $ctrl.isPreview = $ctrl.extraParam.isPreview === true;

            if($ctrl.withNext){
                $ctrl.LCS.addClass($ctrl.element, 'side-padding');
            }
        }

        function onImageEdited(result) {
            console.log('MaterialViewerCtrlService onImageEdited');
            console.log(result);
            if($ctrl.closePopup) {
                $ctrl.closePopup();
            }
            $ctrl.extraParam.onImageEdited(result);
        }

        function getItemTemplate() {
            var btnBack = '',
                topBar = $ctrl.isPreview ? ('<div class="text-center full-width material-popup-top-bar"><span>' + ($ctrl.isPreview ? 'Preview' : 'View') + ' <span class="italic">' + ($ctrl.material && $ctrl.material.name ? $ctrl.material.name : '') + '</span></span>' + btnBack + '</div>') : '';

            return ($ctrl.isPreview ? '' : topBar) +
                '<div class="modal-body h-full full-width ' + ($ctrl.isPreview ? 'material-popup-preview' : '') + '">' +
                    ($ctrl.isPreview ? topBar : '') +
                    getTable() +
                '</div>' +
                ($ctrl.isPreview ? '' : btnBack) ;

            function getTable() {
                if ($ctrl.isPreview || !$ctrl.withNext) {
                    return getViewer();
                }
        return '<div class="display-flex full-width h-full">' +
                    getArrow(true) +
                    '<div class="h-full full-width">' + getViewer() + '</div>' +
                    getArrow(false) +
                '</div>';

                function getArrow(isLeft) {
                    var v = getV(isLeft);
                    return '<div class="side-arrow hide-print one-line-tooltip large hide-ipad' + (isLeft ? '' : ' text-right') + '">' +
                        '<a class="' + v + ' table-div" tooltip="' + (isLeft ? 'Previous' : 'Next') + '" tooltip-placement="' + getV(!isLeft) + '">' +
                        '<div class="text-center centered">' + $ctrl.LCS.getISBDiv('arrow-' + v + '-big', 2, 'sbf40 gray') + '</div>' +
                        '</a>' +
                        '</div>';

                    function getV(isLeft) {
                        return isLeft ? 'left' : 'right';
                    }
                }

                function getViewer() {
                    return '<material-viewer class="material-viewer position-relative full-width h-full" is-in-modal="' + $ctrl.isPopup + '" with-comments="::$ctrl.withComments" with-details="::$ctrl.withDetails" current-list="::$ctrl.currentList" material-version-id="::$ctrl.materialVersionId" can-upload="::$ctrl.canUpload" can-comment="::$ctrl.canComment" start-with-likes="::$ctrl.startWithLikes" with-header="::$ctrl.withHeader" without-sidebar="::$ctrl.withoutSidebar" editor-options="::$ctrl.editorOptions" on-image-edited="$ctrl.onImageEdited(result)"' + ($ctrl.todoPage ? ' todo-page="::$ctrl.todoPage"' :'') + '></material-viewer>' +

                        '<button class="sbup-u-reset ' + ($ctrl.isPreview ? 'sbup-Dashboard-close' : 'sbup-Dashboard-close1') + ' sbup-DashboardItem-action" type="button" aria-label="Close Modal" title="Close Modal"><span aria-hidden="true">×</span></button>';
                }
            }
        }
        function close(e) {
            $ctrl.preventDefault(e);
            if($ctrl.closePopup) {
                $ctrl.closePopup();
            }
        }

        function onLoaded() {
            setPopupIndex();
            bind(true);
            try{
                $ctrl.element.focus();
            }catch(e){}
        }

        function onDestroy() {
            bind(false);
        }

        function bind(isBind) {
            if ($ctrl.withNext) {
                bindN('left', true);
                bindN('right', false);

                $ctrl.LCS.bindElementsClick(isBind, $ctrl.element, onKeydown, 'previewer', 'keydown');
            }

            b('button.sbup-u-reset', $ctrl.close);

            function bindN(cls, isPrevious) {
                b('a.' + cls, function (e) {
                    changeImg(e, isPrevious);
                });
            }

            function b(cls, m) {
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector(cls), m);
            }

            function onKeydown(e) {
                var code = e.keyCode || e.which;

                switch (code) {
                    case 37://left
                        changeImg(e, true);
                        break;

                    case 39://right
                        changeImg(e, false);
                        break;
                }
            }
        }

        function changeImg(e, isPrevious){
            console.log('changeImg');
            $ctrl.preventDefault(e);
            $ctrl.closePopup($ctrl.withNext ? {
                withNext: true,
                isPrevious: isPrevious
            } : null);
        }

        function setPopupIndex() {
            var index = $ctrl.extraParam ? $ctrl.extraParam.popupIndex : null;
            if (!index) {
                return;
            }
            var modal = $ctrl.LCS.findClosestParent($ctrl.element, '.modal');
            if (modal) {
                modal.style.zIndex = index + 2;
            }
            modal.nextElementSibling.style.zIndex = index + 1;
        }
    }
}

angular.module('product.material.routing',[
    'product.materialPage.component'
])
.config(MaterialRouting);
MaterialRouting.$inject = ['$uiRouterProvider'];
function MaterialRouting($uiRouter) {
    var listField = 'materialId';
    var params = {},
        path= 'material',
        url = 'library-file';
    if(listField) {
        params[listField] = {
            value: null,
            dynamic: true
        };
    }
    var resolve = {};
    resolve[listField] = MaterialIdParam;

    addStates($uiRouter, [{
        name: 'user.product.' + url,
        url: '/'+url+'/'+ (listField ? (':'+listField) : '')+'?' +
            'versionId&' +  getExtraRouteParams(),
        data: {
            bodyClass: 'with-sidebar-comments product-materials',
            title: 'File',
            overviewBlockType: path + 's',
        },
        views: {
            bodyWrapper: path + 'Page'
        },
        params: params,
        reloadOnSearch: false,

        resolve: resolve,
    }]);
}

MaterialIdParam.$inject = ['$transition$'];
function MaterialIdParam($transition$){
    return $transition$.params().materialId;
}

