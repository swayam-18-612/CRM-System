angular.module('user.payment.invoice.component', [
    'list.ctrl',
    'apiPagination.Invoices'
])
.component('invoices', {
    bindings: {
        companyId: '<?',
    },
    controller: 'InvoicesCtrl'
})
.controller('InvoicesCtrl', InvoicesCtrl);
InvoicesCtrl.$inject = ['TemplateCompileCompCtrlService', 'InvoicesPagination', 'ListInitService', 'DownloadExportService', '$element'];
function InvoicesCtrl( TemplateCompileCompCtrlService, InvoicesPagination, ListInitService, DownloadExportService, $element) {
    console.log('InvoicesCtrl');
    var $ctrl = this;

    $ctrl.DownloadExportService = DownloadExportService;

    $ctrl.btnId = 'btnDownload';

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInit = preInit;
    $ctrl.download =  download;
    $ctrl.getItemParams = getItemParams;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function getItemParams(item, other) {
        return $ctrl.CPS.currentPathParams(_.extend({invoiceId: item._id}, other));
    }
    function preInit() {
        $ctrl = new ListInitService($ctrl, {
            list: new InvoicesPagination(1000,
                ['createdAt', 'status', 'lineItems', 'total', 'currency', 'discount', 'paid', 'plan', 'number','date', 'stripeInvoiceUrl', 'stripeInvoicePDF', 'card', 'teamCount'],
                ['createdAt', 'createdAtT'],
                ['createdAt']
            ),
            preloadAll: true,
            orders : {createdAt: -1},
            withProperty: withProperty,
            onAllLoaded: onAllLoaded
        });

        $ctrl.getAll();
    }

    function withProperty() {
        return {companyId: $ctrl.CPS.companyId};
    }

    function onAllLoaded() {
        console.log('onAllLoaded');
        $ctrl.isAllLoaded = true;
        $ctrl.reloadTemplate();
    }

    function getItemTemplate() {
        if(!$ctrl.isAllLoaded) {
            return '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
        }
        var el = '';
        if(!$ctrl.list.items.length) {
            el = '<div class="h-full spacing-half with-body-padding table-div centered">' +
                '<div class="no-product with-white-bg centered text-center">' +
                // '<div class="centered circled-svg-colored small150">' + $ctrl.LCS.getISBDiv('card', 3) + '</div>' +
                '<h3 class="text-center">There are no invoices for this account yet.</h3>' +
                '</div>' +
                '</div>'
        } else {
          el =  '';
          _.each($ctrl.list.items, function (item) {
              if (item.plan || item.lineItems) {
                  var plan = item.plan ? item.plan : item.lineItems[0].plan,
                      planTeamCount = plan.teamCount;
                  if (!planTeamCount) {
                      var planx = _.find(getPlansData(), function (item) {
                          return item._id === plan.id;
                      });
                      if (planx) {
                          planTeamCount = planx.features.team ? planx.features.team.count : 1;
                      }
                  }

                  var add = item.teamCount - planTeamCount;
                  el += '<tr class="line-item inrow">' +
                      '<td class="col-md-2 col-sm-2">' + $ctrl.CPS.getCreatedAt(item.createdAt, 'MMM D, YYYY') + '</td>' +
                      '<td class="col-md-2 col-sm-2">' + (item.number || '') + '</td>' +
                      '<td class="col-md-2 col-sm-2">' +
                      '<div>' + plan.name + '</div>' +
                      (planTeamCount > 1 ? ('<div class="users">Base Users x ' + planTeamCount + '</div>') : '') +
                      (add > 0 ? ('<div class="users">Additional Users x ' + add + '</div>') : '') +
                      '</td>' +
                      '<td class="col-md-2 col-sm-2 text-center">' + (item.paid ? 'Paid' : 'Unpaid') + '</td>' +
                      //'<td class="col-md-2 col-sm-2 text-center"><span class="card card-icon" ng-style="{\'background-image\': \'url(\' +$ctrl.LCS.getImgUrl( (item.card.type ? (item.card.type.toLowerCase().replace(\' \', \'_\')) : \'card\') + \'.svg\') +\')\'}"><span ng-bind="::item.card.last4"></span></td>' +
                      '<td class="col-md-2 col-sm-2 text-center semibold">' +
                      '<a class="'+$ctrl.getBtnActionCls()+'" data-info="' + item._id + '" data-type="download" analytics-on analytics-action="Download PDF">' + $ctrl.LCS.getISBDiv('download-pdf', 5) + '</a>' +
                      '</td>' +
                      '</tr>';
              }
          });

            el  = '<table class="repeater-container list invoices">' +
                    '<tr class="line-item inrow header">' +
                        '<td class="col-md-2 col-sm-2">Date</td>' +
                        '<td class="col-md-2 col-sm-2">Invoice #</td>' +
                        '<td class="col-md-2 col-sm-2">Plan</td>' +
                        '<td class="col-md-2 col-sm-2 text-center">Price</td>' +
                        '<td class="col-md-2 col-sm-2 text-center">Status</td>' +
                        // '<td class="col-md-2 col-sm-2 text-center">CC</td>' +
                        '<td class="col-md-2 col-sm-2 text-center">&nbsp;</td>' +
                    '</tr>' +
                    el +
                '</table>';
        }

        return '<div>' + el + '</div>';
    }

    function download(id){
        var item = _.find($ctrl.list.items, {_id: id});
        if(!item){
            return;
        }
        var m = 'crud.invoice.download.',
            p = $ctrl.getItemParams(item, null);
        $ctrl.i18nNotifications.pushForCurrentRoute(null, m + 'success.general', 'success');
        $ctrl.DownloadExportService.downloadBlobFile($ctrl.service.download(p), p, onsuccess, onerror);

        function onsuccess(url, filename) {
            $ctrl.isUpdating = false;

            if ($ctrl.onClose) {
                $ctrl.onClose({result: 'cancel'});
            }
        }

        function onerror(err) {
            $ctrl.isUpdating = false;
            console.log("Could not get signed URL.");
            $ctrl.error = $ctrl.localizedMessages.getFromError(err, m + 'error');
        }
    }
}

angular.module('user.payment.component', [
    'user.payment.page.controller.service'
])
.component('paymentPage', {
    bindings: {
        withSignup: '<?'
    },
    controller: 'PaymentPageCtrl'
})
.controller('PaymentPageCtrl', PaymentPageCtrl);
//PaymentPageNewCtrlService
PaymentPageCtrl.$inject = ['PaymentPageCtrlService','$element'];

function PaymentPageCtrl(PaymentPageCtrlService, $element) {
    console.log('PaymentPageCtrl');

    var $ctrl = this;
    $ctrl = new PaymentPageCtrlService($ctrl, $element);
}

angular.module('user.payment.page.controller.service', [
    'user.payment.init.controller.service',
    'services.blocksSetup'
])
.service('PaymentPageCtrlService', PaymentPageCtrlService);
PaymentPageCtrlService.$inject = ['PaymentInitCtrlService', 'BlocksSetupService', 'TemplateCompileCompCtrlService'];
function PaymentPageCtrlService(PaymentInitCtrlService, BlocksSetupService, TemplateCompileCompCtrlService) {
    return function($ctrl, $element)  {
        console.log('PaymentPageCtrlService');
        $ctrl.PaymentInitCtrlService = PaymentInitCtrlService;
        $ctrl.BlocksSetupService = BlocksSetupService;

        var isDebug = false,//old layout when true -> for new pricing
            expandableHeight = 1,
            isChanging = false;

        $ctrl.isNewLayout = true;

        $ctrl.odometerOptions = {
            value: 0,
            format: '(,ddd).dddd',
            duration: 200
        };

        $ctrl.isCompanyTab = false;
        $ctrl.dontAutoloadTemplate = true;

        $ctrl.showProp = showProp;
        $ctrl.toggleComp = toggleComp;
        $ctrl.toggleInfo = toggleInfo;

        $ctrl.isComp = isComp;
        $ctrl.getTooltip = getTooltip;

        $ctrl.preInit = preInit;
        $ctrl.getItemTemplate = getItemTemplate;

        $ctrl.onLoaded = onLoaded;
        $ctrl.onDestroy = onDestroy;

        $ctrl.onUpdateSubscriptionOther = onUpdateSubscriptionOther;
        $ctrl.toggleMonthly = toggleMonthly;
        $ctrl.openFreePlan= openFreePlan;
        $ctrl.openUpgradePlan = openUpgradePlan;
        $ctrl.onScroll = onScroll;
        $ctrl.close = close;

        $ctrl = new ($ctrl.isPopup ? $ctrl.ItemTemplateCompileCtrlService : TemplateCompileCompCtrlService)($ctrl, $element);

        return $ctrl;

        function preInit() {
            // return $ctrl.CPS.transitionTo($ctrl.CPS.currentStateName.replace('public.', 'user.'), $ctrl.CPS.currentPathParams({}));
            $ctrl.PaymentInitCtrlService.loadPayment($ctrl, next, false);

            function next() {
                //start with company tab is selected plan is company or the comp par is set
                var stateParams = $ctrl.CPS.stateParams;
                $ctrl.solutions = _.sortBy(_.filter($ctrl.BlocksSetupService.getOverviewBlocksDataInfo(), function (item) {
                    return !item.isSolution && item.features;
                }), 'orderPlans');
                $ctrl.comp = stateParams && stateParams.comp ? stateParams.comp.toString() === '1' : null;
                if ($ctrl.comp) {
                    $ctrl.isCompanyTab = true;
                }

                initPlans();

                $ctrl.showMonthly = true;
                $ctrl.showIndividual = true;
                if ($ctrl.withSignup) {
                    $ctrl.onInnerSuccessLogin = onInnerSuccessLogin;
                }

                if ($ctrl.selectedPlan) {
                    $ctrl.showMonthly = $ctrl.selectedPlan.interval !== 'year';
                    $ctrl.showIndividual = !$ctrl.selectedPlan.isCompany;

                    if ($ctrl.selectedPlan.isCompany){
                        $ctrl.isCompanyTab = true;
                    }
                }

                $ctrl.reloadTemplate();

                function initPlans() {
                    $ctrl.freePlan = null;
                    $ctrl.entPlan = null;
                    var i;

                    if ($ctrl.plans) {
                        for (i = 0; i < $ctrl.plans.length; i++) {
                            if (!$ctrl.plans[i].amount) {
                                $ctrl.plans[i].amount = 0;
                                $ctrl.freePlan = $ctrl.plans[i];
                                $ctrl.plans.splice(i, 1);
                                break;
                            }
                        }

                        for (i = 0; i < $ctrl.plans.length; i++) {
                            if ($ctrl.plans[i].name === "Enterprise") {
                                $ctrl.entPlan = $ctrl.plans[i];
                                $ctrl.plans.splice(i, 1);
                                break;
                            }
                        }
                    }
                    $ctrl.showedPlans = loadPlans();

                    function loadPlans() {
                        var showedPlans = {},
                            activePlans = _.sortBy(_.filter($ctrl.plans, function (item) {
                                return item.active && !item.deleted;
                            }), 'amount').map(function (item){
                                loadFeatures(item);
                                return item;
                            });

                        process(false);
                        process(true);

                        function process(isYear) {
                            var sel = _.filter(activePlans, function (item) {
                                return (item.interval === 'year') === isYear;
                            });
                            _.each(sel, function (item, i) {
                                if(!isYear && i > 0) {
                                    item.previous = sel[i - 1].name;
                                }
                                var val = item.isCompany ? 'true' : 'false';
                                if (!showedPlans[val]) {
                                    showedPlans[val] = {};
                                }
                                if (isYear) {
                                    if(!showedPlans[val][item.refPlanId]) {
                                        showedPlans[val][item.refPlanId] = {};
                                    }
                                    showedPlans[val][item.refPlanId].year = item;
                                } else {
                                    if(!showedPlans[val][item._id]) {
                                        showedPlans[val][item._id] = {};
                                    }
                                    showedPlans[val][item._id].month = item;
                                }
                            });
                        }

                        loadFeatures($ctrl.entPlan);
                        showedPlans.true[$ctrl.entPlan._id] = {year: $ctrl.entPlan, month: $ctrl.entPlan};

                        loadFeatures($ctrl.freePlan);
                       // showedPlans.false[$ctrl.freePlan._id] = {year: $ctrl.freePlan, month: $ctrl.freePlan};

                        return showedPlans;
                    }

                    function loadFeatures(plan) {
                        var f = $ctrl.features;
                        if (!f) {
                            return;
                        }

                        var features = {};
                        if (plan.name === 'Enterprise') {
                            features[null] = [
                                {show: true,
                                    icon: "database",
                                    description: "On-demand team & storage",
                                    isEnt: true,
                                    order: 1,
                                    selected: true,
                                    title: 'Custom Team & Storage',
                                    tooltip: '<strong>Unlimited Users:</strong> Add or remove unlimited team members to your account. The pricing will adjust based on count. </br></br><strong>On-demand Storage:</strong> There are no storage limits on Enterprise plans. Your account will be charged by usage.'
                                },
                                {show: true,
                                    icon: "org-chart-tall",
                                    description: "Multi-team management",
                                    isEnt: true,
                                    order: 2,
                                    selected: true,
                                    title: 'Multi-team Management',
                                    tooltip: 'Team members have logins, and can administer full projects in your account.</br></br>Total team count is based on the plan.</br></br>Additional team members can be added at any point. User pricing varies by plan.'
                                },
                                {show: true,
                                    icon: "secure",
                                    description: "Enhanced security features",
                                    isEnt: true,
                                    order: 3,
                                    selected: true,
                                    title: 'Enhanced Security',
                                    tooltip: '<strong>Custom Subdomain:</strong> Login to StudioBinder from a dedicated URL.</br></br><strong>Dedicated Database & Storage:</strong> Your data and files are hosted in a dedicated cloud for added privacy.</br></br><strong>Scheduled Data Backups:</strong> Setup recurring data backups for total reliability.</br></br><strong>Single sign-on support:</strong> Users login with their work emails so the company has total control over their accounts.</br></br><strong>Custom Subdomain:</strong> Login from a dedicated URL (e.g.  production.organization.com)</br></br><strong>Multi-factor Authentication:</strong> Setup two-factor logins for added security.</br></br><strong>On-demand Watermarking:</strong> StudioBinder can setup custom watermarking on all generated PDFs that match your org.'
                                },
                                {show: true,
                                    icon: "whitelabeling",
                                    description: "Brand whitelabeling",
                                    isEnt: true,
                                    order: 4,
                                    selected: true,
                                    title: 'Brand Whitelabeling',
                                    tooltip: '<strong>Logo:</strong> Add your logos in the app navigation, login forms, reports, and email letterheads for a seamless experience.</br></br><strong>Brand Colors:</strong> Adjust UI colors and buttons to match your brand colors. </br></br><strong>Custom Navigation:</strong> Add custom app navigations to redirect to 3rd party pages.'
                                },
                                {show: true,
                                    icon: "human-support",
                                    description: "Priority support & onboarding",
                                    isEnt: true,
                                    order: 5,
                                    selected: true,
                                    title: 'Priority Support',
                                    tooltip: '<strong>Priority Support:</strong> Need to get quick access to for quick troubleshooting? Your account will get VIP live chat and phone support.</br></br><strong>Onboarding & Training:</strong> White glove onboarding and initial training to ensure the transition to StudioBinder is smooth, no matter your users’ skill level.'
                                },
                                /* {
                                     icon:"human-support", description: "API access", isEnt:true, order: 6,
                                     title:'API Access',
                                     tooltip:'Access StudioBinder’s public API to customize the experience to better fit your organization’s needs.'
                                 }*/
                            ];
                        }
                        else {
                            for (var j = 0; j < f.length; j++) {
                                var feature = angular.copy(f[j]),
                                    name = feature.name;
                                var item = plan.features[name];
                                var presetCounter = false;
                                if (plan.isCompany) {
                                    if (name === 'projects') {
                                        feature.show = true;
                                        feature.icon = 'project';
                                        feature.title = 'Unlimited Projects';
                                        feature.tooltip = 'There are no limits on the number of projects under a single company account.';
                                        feature.order = 1;
                                    }
                                    /*else if (name === 'collaborators') { //the new plans have only reviewers
                                        feature.show = true;
                                        feature.icon = 'circled-user';
                                        feature.description = 'Collaborators';
                                        feature.title = 'Unlimited Collaborators';
                                        feature.hasCounter = true;
                                        feature.count = null;
                                        presetCounter = true;
                                        feature.tooltip = 'Collaborators are individuals that are invited to access particular pages with customizable permissions to view, add comments & tasks.</br></br>Collaborators do not have access to the navigation. They only see the pages they’ve been invited to view.</br></br> Collaborators do not need to sign up for an account to access a page. </br></br>Collaborator access can be revoked by team members at any point.';
                                        feature.order = 2;
                                    }*/
                                    else if (name === 'fileStorage') {
                                        feature.icon = 'upload-to-cloud';
                                        feature.title = 'Online Storage';
                                        feature.tooltip = 'Upload files such as documents, images, and video. Files are conveniently contained within projects.</br></br>Total storage limits are based on the plan and apply to the entire account.';
                                        feature.order = 3;
                                    } else if (name === 'team') {
                                        feature.show = true;
                                        feature.icon = 'users';
                                        feature.title = 'Team Members';
                                        feature.tooltip = 'Team members have logins, and can adminster full projects in your account. </br></br> Total team count is based on the plan.</br></br> Additional team members can be added at any point. User pricing varies by plan.';
                                        feature.order = 4;
                                    } else {
                                        feature.show = false;
                                    }
                                }

                                feature.selected =  item && !item.hide;
                                if (item && !presetCounter) {
                                    feature.hasCounter = item.hasCounter;
                                    feature.count = item.count;
                                }

                                if (feature.show) {
                                    var id = (isDebug && plan.isCompany || !isDebug) ? null :
                                        (feature.overviewBlockId || null);
                                    if(!features[id]) {
                                        features[id] = [];
                                    }
                                    features[id].push(feature);
                                }
                            }
                        }

                        plan.planFeatures = features;
                    }

                }
            }
        }

        function getItemTemplate() {
    return ($ctrl.withCloseBtn && $ctrl.nonMobileCloseBtn ? $ctrl.nonMobileCloseBtn() : '') +
            '<div class="with-fancy-scrollbar h-full show-scrollbar-on-hover">' +
                '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper '+
                    ($ctrl.CPS.isAuthenticated? 'spacing-bottom' : '')+
                '"  >' +
                    '<div class="pricing-wrapper usecases'+($ctrl.isNewLayout?' newlayout':'')+'">' +
                        getTopNonLoggedIn() +
                        getPricingSection() +
                        getSolutionsDesc() +
                        '<pricing-faq></pricing-faq>' +
                        //'<pricing-more-details></pricing-more-details>' +
                        ($ctrl.LCS.isSB && !$ctrl.CPS.isAuthenticated ? '<footer class="footer footer_logged margin-top"></footer>' : '') +
                    '</div>' +
                '</div>' +
            '</div>';

            function getSolutionsDesc() {
                if(!$ctrl.isNewLayout){return;}
            return '<div class="solution-features'+($ctrl.isNewLayout?' newlayout':'')+'">' +
                         ($ctrl.isNewLayout?'':('<h3 class="center margin-bottom-half">Features</h3>')) +
                        getSolutions() +
                    '</div>';

                function getSolutions(){
                    return $ctrl.solutions.map(getSolution).join('');
                }

                function getSolution(sol) {
                    var planNames = [ 'Free', 'Starter', 'Indie', 'Professional'],
                        colCls = $ctrl.isNewLayout ? '' : 'col130';
            return '<div uib-accordion class="with-color centered solution-table ' +
                        //sol.pageClass +
                    '">' +
                        '<div class="header">' +
                             ($ctrl.isNewLayout ? '' : ('<div class="centered col50"><div class="centered circled-svg-colored small36">' + $ctrl.LCS.getISBDiv(sol.icon, sol.iconLevel) + '</div></div>')) +

                                '<div class="full-width name">' +(sol.namePlans?sol.namePlans:sol.name)+'</div>' +
                                '<div class="desc">' +(sol.descPlans?sol.descPlans:sol.desc)+'</div>' +
                ($ctrl.isNewLayout ? '' : getPlanNames()) +
                        '</div>' +
                        getSolFeatures() +
                    '</div>';

                    function getSolFeatures(){
                        return sol.features.map(function (feature) {
                        return '<div uib-accordion-group >' +
                                '<div class="question-wrap">'+
                                    '<div class="table-div full-width" uib-accordion-heading>' +
                                        '<div class="grow-column">' +
                                            '<span '+(feature.desc ? 'class="with-cursor" ':'') + 'tooltip="'+feature.desc+'" tooltip-placement="bottom">' + feature.name + '</span>' +
                                           // (feature.desc ? ('<span class="with-margin-left with-parenthesis">' + feature.desc + '</span>'):'')+
                                        '</div>' +
                                        getVals() +
                                    '</div>' +
                                    //'<div class="spacing-quarter-top">content</div>' +
                                '</div>' +
                            '</div>';

                            function getVals() {
                                var iconCls = $ctrl.isNewLayout ? 'size18 black' : 'size24';
                                return processList(feature.vals, function (val, i) {
                                    return '<div class="' + colCls + (i%2===1 ? ' gray' : '') +'">' +
                                        (val ? ('<div class="centered sbf success ' + iconCls + '"></div>') : '') + '</div>';
                                });
                            }
                        }).join('');
                    }

                    function getPlanNames() {
                        return processList(planNames, function (el) {
                            return '<div class="text-center ' + colCls + '">' + el + '</div>';
                        });
                    }

                    function processList(list, m){
                        var start = $ctrl.isNewLayout ? 1 : 0;
                        return  list.map(function (el, i){
                            return i >=start ? m(el, i) : '';
                        }).join('');
                    }
                }
            }

            function isCustomPlan(){
                return $ctrl.CPS.getSearchFilter('sbcustom') === 1;
            }

            function getTopNonLoggedIn() {
                if( $ctrl.CPS.isAuthenticated){return '';}
                return '<div>' +
                    '<div class="linearBg">' +
                    '<div class="container text-center">' +
                    '<div>' +
                    '<div class="clearfix banner-section">' +
                    '<div class="col-md-12 col-sm-12 col-xs-12">' +
                    '<h1 class="white wow slideInDown text-center" data-wow-delay="0.5s">A plan for every production</h1>' +
                    '<h2 class="white wow slideInDown text-center" data-wow-delay="0.4s">Free to use for as long as you want. No credit card required.</h2>' +
                    /*'<div class="text-center wow slideInDown spacing-half-top" data-wow-delay="0.3s" >' +
                    '<button type="button" analytics-on analytics-action="Get Started For Free" class="btn btn-primary btn-contact big btnFreePlan">Get Started For Free</button>' +
                    '</div>' +*/
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>';
            }

            function getPricingSection() {
                return '<section id="section-pricing" '+(isDebug ? '' : 'class="old-style"')+'>'+
                    '<div class="pricing-loggedin">' +
                    '<div class="tabbable spacing-bottom">' +
                    '<h1 class="spacing-half"><span class="tetiletop bold">A plan for every production</span></h1>' +
                    (isCustomPlan() ? ('<h3 class="spacing-half semibold schoolplans">School Plans</h3>') : '') +
                    getCompFilters()+
                    getMonthlyFilters() +
                    getPricingPlans() +
                   // getFree() +
                   // getSharing() +
                    '</div>' +
                    '</div>'+
                    '</section>';

                function getCompFilters(){
                    var cls = 'analytics-on analytics-category="pricing-type" class="btnComp type btn ';
                    return '<div class="text-center spacing-half-bottom centering">' +
                        '<div class="paymentCompanyButtons">' +
                        '<button data-company="false" analytics-action="View Small Team Pricing" ' + cls + 'left'+($ctrl.isComp() ? '' : ' active') + '">For Small Teams</button>' +
                        '<button data-company="true" analytics-action="View Organizations Pricing" ' + cls + 'right'+($ctrl.isComp() ? ' active' : '') + '">For Organizations</button>' +
                        '</div>' +
                        '</div>';
                }

                function getMonthlyFilters(){
                    return '<div class="text-center spacing-half-bottom margin-half-bottom">' +
                        '<div class="paymentButtons centering">' +
                        '<div data-monthly="true" class="type' + ($ctrl.showMonthly ? ' active' : '')+'">Monthly</div>' +
                        '<div class="custom-checkbox gray pull-left '+ $ctrl.pageClass +'"><label class="i-switch radiobtn">' +
                        '<input type="checkbox"' + ($ctrl.showMonthly ? ' ' : ' checked="checked"') + '><i></i>' +
                        '</label></div>' +
                        '<div data-monthly="false" class="type'+($ctrl.showMonthly ? '' : ' active')+'">Yearly</div>' +
                        '<span class="discountAnnual uppercase">(Save 15%)</span>' +
                        '</div>' +
                        '</div>';
                }

                function getPricingPlans(){
                    return '<div class="clearfix pricing-tables">' +
                        '<div class="pricing-bg"></div>'+
                        '<div class="anim-presentation">' +
                        get(false)+
                        get(true) +
                        '</div>' +
                        '</div>';

                    function get(isCompany) {
                        var el = getPlan({year: $ctrl.freePlan, month: $ctrl.freePlan});
                        _.each($ctrl.showedPlans[isCompany], function (p, i) {
                            el += getPlan(p);
                        });
                        return '<div><div data-company="' + isCompany + '" class="grid-plans anim-object ' +
                (isCompany ? ($ctrl.isCompanyTab ? 'front' : 'back') : ($ctrl.isCompanyTab ? 'back' : 'front')) + '">' + el + '</div></div>';

                        function getPlan(el){
                            var planM = el.month,
                                isEnt = planM._id===$ctrl.entPlan._id,
                                isFree = planM._id===$ctrl.freePlan._id,
                                name = planM.name;
                    return '<div data-id="' + planM._id + '" class="plan'+(isFree ? ' free-plan':'') + (planM.label ? ' best-value' :'') + '">' +
                                (planM.label ? ('<div class="corner">' + planM.label + '</div>'):'') +
                                '<div class="plan-bg"></div>' +
                                '<div class="plan-full">' +
                                    '<div class="head"><h2>' + name + '</h2></div>' +
                                    getDynamicProps(true, el, isCompany) +
                                    '<div class="plan-features"> ' +
                                        getCompTop() +
                                        //getFeatures() +
                                    '</div>' +
                                '</div>' +
                                '<div class="plan-mini">' +
                                    '<div class="header">' +
                                        '<h2>' + name + '</h2> ' +
                                        '<div>' + getDynamicProps(true, el, isCompany, true) + '</div>' +
                                    '</div>' +
                                    getBtn(true, el,isFree)  +
                                    getCounterProps1() +
                                '</div>' +

                                '<div class="plan-border"></div>' +
                            '</div>';


                            function getCounterProps1(){
                                var name = planM.name.replace('Yearly', '').trim();
                                var list = getList(),
                                    txtList = list ? [getTeamCount()].concat(list).map(function (u){
                                        return '<div class="table-div full-width"><div class="col20 centered padding-top-5 padding-bottom-5"><div class="sbf success size18 green"></div></div><div class="with-padding-left centered text-left font-size-15">'+u+'</div></div>';
                                    }).join('') : '';
                                return txtList ? ('<div class="margin-bottom-30 extra">' +
                                    '<div class="bold padding-bottom-10">' + getTitle() + '</div>' +
                                    txtList +
                                    '</div>') : '';

                                function getList() {
                                    switch (name) {
                                        case 'Starter':
                                            return ['Scriptwriting & Docs',
                                                'Breakdowns & Scheduling',
                                                'Mood Boards & Storyboards',
                                                'Shot Lists',
                                                'Tasks & Calendars',
                                                'Call Sheets'];

                                        case 'Indie':
                                            return ['Script Outlines',
                                                'Script Revisions',
                                                'Advanced Scheduling',
                                                'Image Editor & Arrows',
                                                'Contact Messaging',
                                                'Call Sheet Analytics'];

                                        case 'Professional':
                                            return ['Script Timing',
                                                'Episodic Scripts',
                                                'Shot List Scheduling',
                                                'Call Sheet Templates',
                                                'Autofilled Call Sheets',
                                                'Call Sheet Messaging'];
                                    }
                                    return null;
                                }

                                function getTitle(){
                                    switch (name) {
                                        case 'Starter':
                                            return 'Key features include:';
                                        case 'Indie':
                                            return 'Every Starter feature, plus:';
                                        case 'Professional':
                                            return 'Every Indie feature, plus:';
                                    }
                                    return null;
                                }
                            }

                            function getTeamCount() {
                                return (planM.features.team ? ('<span class="bold">' + (planM.features.team.count ? planM.features.team.count : '∞') + '</span> user' + (planM.features.team.count === 1 ? '' : 's')) : '');
                            }


                            function getCompTop(){
                                return isCompany ? (
                                   '<div class="description text-left bold italic margin-half">Includes all features plus…</div>' +
                                    '<div class="with-hr"></div>'
                                ) : '';
                            }

                            function getFeatures() {
                                var els = '',
                                    sol = [{_id: null}];
                                if(!isCompany){sol = sol.concat($ctrl.solutions);}
                                _.each(sol, function (sol, i) {

                                    els += getSolFeatures(sol, i);
                                });
                                return els;
                            }

                            function getSolFeatures(sol, i) {
                                var els = '',
                                features = _.sortBy(planM.planFeatures[sol._id], 'order'),
                                    withSolId = isDebug && sol._id,
                                hasFeatures = withSolId &&
                                    _.filter(features, function(f){return f.show && f.selected;}).length>0;

                                if(hasFeatures){
                                    els += '<div class="title table-div">' +
                                        '<div class="col40 centered"><div class="circled-svg-colored small30 colored '+sol.icon+'">' + $ctrl.LCS.getISBDiv(sol.icon,6, 'colored sbf14') + '</div></div>' +
                                        '<div class="centered">' +
                                        sol.name +
                                        (planM.previous ? ('<div class="other-info">All features from '+planM.previous+', plus…</div>') : '') +
                                        '</div>' +
                                        '</div>';
                                }
                                _.each(features, function (f, $index){
                                    var addDyn = !sol._id && !isCompany && $index === 1,
                                        color = sol._id ? (' style="color:'+sol.color+'"') : '',
                                        withInfo = (isCompany || !isCompany && (sol._id || !sol._id && $index > 1)) && f.tooltip;
                                    if(f.show && (f.selected || addDyn)){
                                        var desc = isCompany ? (!isEnt ? '' : 'Includes all features plus…') :
                                                (!isDebug ? '' : (planM.previous ? ('Everything in the '+planM.previous + ' plan, plus:') : (planM.name + ' plan includes:')));
                                        els += '<li class="collapsed ' +
                                            (f.hasCounter===true && !isCompany ? 'text-center ' : 'heigher ')+
                                            (sol._id ? 'sol ' : '') +
                                            (withInfo ? 'with-info ' : '') +
                                            ((isCompany || !isDebug || !sol._id) ? 'without-sol ':'') +
                                            '">' +
                                            (f.selected ? (
                                                '<div class="feature table-div full-width">' +
                                                ((!isCompany&&!f.hasCounter||isCompany) ? (
                                                    '<div class="'+(isCompany ? 'icon-col' : 'col10') + ' centered">' +
                                                    ((!isDebug || isCompany) ? $ctrl.LCS.getISBDiv(f.icon, 6, 'icon' + (!isDebug && !isCompany ?' gray':''), color) : ('<div '+color+' class="bullet">•</div>')) +
                                                    '</div>') : '') +
                                                //(!isCompany && !f.hasCounter ? ('<img class="img-small" src="'+$ctrl.imgPaths + 'solution-'+f.name + '.svg'+'"/>'):'') +
                                                '<div class="centered '+(!isCompany && f.hasCounter?'text-center':'text-left')+'">' +
                                                ((f.selected && f.hasCounter || f.unit) && !f.isEnt ? ('<span><strong>' + (f.selected && f.hasCounter ?(f.count ? f.count : 'Unlimited') : '') + '</strong>' + (f.unit?('<strong>'+f.unit+'</strong>'):'')+'</span>') : '') +
                                                '<span class="with-margin-left">'+f.description+'</span>' +
                                                (withInfo ?('<div class="sbf sbf14 plus pull-right with-cursor gray"></div>'):'') +
                                                '</div>' +
                                                '</div>' +
                                                (withInfo ? ('<div class="info expandable" style="height: '+expandableHeight+'px"><div>'+f.tooltip+'</div></div>') : '')
                                            ) : '') +
                                            //(addDyn ? (
                                                //((isCompany ||!isDebug) ? '' : getBtn(true, el,isFree)) +
                                                //getDynamicProps(true, el, isCompany)+
                                                //((isCompany || !isCompany && desc)? ('<div class="description text-left bold italic margin-half">' + desc + '</div>'):desc)
                                              //) : '') +
                                            '</li>';
                                    }
                                });

                                return (withSolId && hasFeatures || !withSolId) ? ('<ul class="item-list tooltip-bigger' +(i ===0 ?' dyn' : '')+ '">' + els + '</ul>') : '';
                            }
                        }
                    }
                }

            }
        }

        function toggleInfo(e){
            $ctrl.preventDefault(e);
            var li = $ctrl.LCS.findClosestParent(e.currentTarget, 'li') ;
            _.each($ctrl.element.querySelectorAll('.plan li:not(.collapsed)'), function (el) {
                if (el !== li) {
                    collapse(el);
                }
            });
            if($ctrl.LCS.hasClass(li, 'collapsed')){//is collapse
                expand(li);
            }else{
                collapse(li);
            }
            function collapse(li) {
                $ctrl.LCS.addClass(li, 'collapsed');
                var el = li.querySelector('.expandable');
                if(!el){return;}
                var sectionHeight = el.scrollHeight,
                    elementTransition = el.style.transition;

                el.style.transition = '';
                requestAnimationFrame(function() {
                    el.style.height = sectionHeight + 'px';
                    el.style.transition = elementTransition;
                    requestAnimationFrame(function() {
                        el.style.height = expandableHeight + 'px';
                    });
                });
            }

            function expand(li) {
                $ctrl.LCS.removeClass(li, 'collapsed');
                var el = li.querySelector('.expandable');
                if(!el){return;}
                var sectionHeight = el.scrollHeight;

                el.style.height = sectionHeight + 'px';

                $ctrl.LCS.bindElementListeners(true, el, function(e) {
                    $ctrl.LCS.bindElementListeners(false, el, arguments.callee, 'transitionend');
                    el.style.height = null;
                }, 'transitionend');
            }
        }

        function toggleMonthly(e) {
            console.log('toggleMonthly');

            $ctrl.preventDefault(e);
            $ctrl.showMonthly = !$ctrl.showMonthly;
            var input = e.currentTarget.querySelector('input');
            if ($ctrl.showMonthly) {
                input.removeAttribute('checked');
            } else {
                input.setAttribute('checked', 'checked');
            }
            _.each($ctrl.element.querySelectorAll('.paymentButtons .type'), function (el) {
                var isMonthly = el.getAttribute('data-monthly') === 'true';
                $ctrl.LCS[$ctrl.showMonthly === isMonthly ? 'addClass' : 'removeClass'](el, 'active');
            });
            updateDynamicProps();
        }

        function isComp() {
            return $ctrl.isCompanyTab === true;
        }

        function toggleComp(e) {
            $ctrl.preventDefault(e);
            var isCompanyTab = e.currentTarget.getAttribute('data-company') === 'true';

            if (!isChanging) {
                isChanging = true;
                $ctrl.isCompanyTab = isCompanyTab;
                var elname = ".anim-presentation .anim-object",
                    comp = $ctrl.element.querySelector(elname + '[data-company="'+true+'"]'),
                    indiv = $ctrl.element.querySelector(elname + '[data-company="'+false+'"]');

                _.each([comp, indiv], function (el) {
                    if (!el.style) {
                        el.style = {};
                    }
                    el.style.setProperty('animation', '');
                });

                _.each($ctrl.element.querySelectorAll('.paymentCompanyButtons .type'), function (el) {
                    var isCompany = el.getAttribute('data-company') === 'true';
                    $ctrl.LCS[isCompanyTab === isCompany ? 'addClass' : 'removeClass'](el, 'active');
                });

                $ctrl.LCS.timeout(function () {
                    if (isCompanyTab) {
                        swap(indiv, comp);
                    } else {
                        swap(comp, indiv);
                    }

                    isChanging = false;

                    reloadOdometers();

                    function swap(elOut, elIn) {
                        //send out (was in)
                        if ($ctrl.LCS.hasClass(elOut, 'front')) {
                            $ctrl.LCS.replaceClass(elOut, 'front', 'back');
                            if (!elOut.style) {
                                elOut.style = {};
                            }
                            elOut.style.setProperty('animation', 'fade-out-bottom 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0s 1 normal both');
                            //  elOut.css('animation', 'fade-out-bottom 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0s 1 normal both');
                        }
                        //send in (was out)
                        if ($ctrl.LCS.hasClass(elIn, 'back')) {
                            $ctrl.LCS.replaceClass(elIn, 'back', 'front');
                            if (!elOut.style) {
                                elIn.style = {};
                            }
                            elIn.style.setProperty('animation', 'fade-in-bottom 0.45s cubic-bezier(0.39, 0.575, 0.565, 1) 0s 1 normal both');
                            //  elIn.css('animation', 'fade-in-bottom 0.45s cubic-bezier(0.39, 0.575, 0.565, 1) 0s 1 normal both');
                        }
                    }
                }, 10);
            }
        }

        function showProp(f, plan) {
            return f.show !== false && f.hide !== true;
        }

        function getTooltip(f, isCompany) {
            return f ? ('<div class="title">' +
                (isCompany ? $ctrl.LCS.getISBDiv(f.icon, 6, 'green') :
                    (f.hasCounter ? '' : ('<div class="col-30 inline-block">' + $ctrl.LCS.getISBDiv(f.icon,6) + '</div>'))) +
                '<span class="padding-left10">' + (isCompany ? f.title : f.description) + '</span>' +
                '</div>' +
                '<div>' + f.tooltip + '</div>'
            ) : null;
        }

        function onInnerSuccessLogin(userId) {
            $ctrl.broadcastRoot('INNER_SUCCESS_LOGIN', userId);
            $ctrl.openCC();
            $ctrl.security.closePopup();
        }

        //based on $ctrl.selectedPlan._id & $ctrl.showMonthly
        function getDynamicProps(isInit, el, isCompany) {
            var isEnt = el.month._id===$ctrl.entPlan._id,
                isFree = el.month._id===$ctrl.freePlan._id,
                planM = isFree ? el.month : el[$ctrl.showMonthly?'month':'year'],
                amount = planM.amount;
    var d = '<div class="head">' +
                '<div class="price'+(isEnt ? ' ent':'')+'">' +
                    '<h3>' +
                    (isEnt ? ('Custom') : ('<span class="symbol pull-left">$</span><div class="odometer pull-left" init-value="'+amount+'" end-value="'+amount+'"></div><span class="symbolmo pull-left">/'+
                        //(isCompany ? '' : 'user/')+
                        'mo</span>'))+
                    '</h3>' +
                    '<div class="savings">'+
                        (isEnt ? ('For multiple departments'):
                        (planM.interval === 'year'?('<i>Save $'+$ctrl.getAnnualSavingsFormatted(el)+' a year</i>'):'')) +
                    '</div>' +
                '</div>' +
                //'<div class="props">' +
                 //getCounterProps() +
                //'</div>' +
                '<div class="desc">'+planM.description+'</div>'+
            '</div>';
            // +(isCompany ? getBtn(isInit, el,isFree) : '');
            return isInit ? ('<div class="dynamic-props clearfix">' + d + '</div>') : d;

            function getCounterProps(){
              return getTeamCount() +
                (planM.features.projects ? ('<span class="sep">|</span><span class="bold">' + (planM.features.projects.count?planM.features.projects.count : '∞') + '</span> project' + (planM.features.projects.count===1?'':'s')) : '') +
                (planM.features.fileStorage ? ('<span class="sep">|</span><span class="bold">' + (planM.features.fileStorage.count ? planM.features.fileStorage.count : '∞') + '</span> GB') : '');
            }
        }

        function getBtn(isInit, el, isFree){
            var planM = isFree ? el.month : el[$ctrl.showMonthly?'month':'year'],
                currentPlanId = planM._id,
                isEnt = el.month._id===$ctrl.entPlan._id,
                isSelected = $ctrl.selectedPlan && $ctrl.selectedPlan._id === currentPlanId;
            return (isSelected ?
                ('<div class="current-plan-wrapper"><span class="current-plan uppercase centered"><span class="check-mark sbf sbf24 pull-left with-margin-right"></span> <span>Current Plan</span></span></div>') :
                ('<button type="button" class="btnUpgrade btn btn-primary' + (isFree ? ' free' : '') +(isSelected ? ' selected' : '') + '" ' + 'analytics-on analytics-action="Sign Up for ' + planM.name + '"' + '>' + getBtnText(planM, {isEnt:isEnt}) + '</button>'));
        }

        function getBtnText(el, other){
            return (other && other.isEnt ? 'Learn More':
                (($ctrl.withSignup ? 'Sign Up for ' : isUpgrade() ? 'Upgrade to ' : 'Downgrade to ') + getShortPlanName(el.name)))
                //+'<span class="with-padding-left">➞</span>'
                ;

            function isUpgrade(){
                if(!$ctrl.selectedPlan || $ctrl.selectedPlan.name === 'Free'){return true;}
                if($ctrl.selectedPlan.interval === 'month' ){
                    return el.interval === 'year' ? true : (el.amount > $ctrl.selectedPlan.amount);
                } else{
                    return el.interval === 'month' ? false : (el.amount > $ctrl.selectedPlan.amount);
                }
            }

            function getShortPlanName(name) {
                name = name.replace(' Yearly', '');
                switch (name) {
                    case 'Professional':
                        return 'Pro';
                    case 'Production Company':
                        return 'Prod Comp';
                }
                return name;
            }
        }

        function onLoaded(){
            bind();

            updateDynamicFreeSection();
            updateDynamicProps();
            bind(true);

            if($ctrl.onLoadedOther) {
                $ctrl.onLoadedOther();
            }
        }

        function onDestroy(){
            bind(false);
            if($ctrl.onDestroyOther) {
                $ctrl.onDestroyOther();
            }
        }

        function onUpdateSubscriptionOther(){
            onLoaded();
        }

        function updateDynamicProps() {
            bind(false);
            var els = $ctrl.element.querySelectorAll('.anim-presentation .anim-object');
            _.each(els, function (anim) {
                var isCompany =  anim.getAttribute('data-company') === 'true',
                    plans = $ctrl.showedPlans[isCompany];
                for (var id in plans) {
                    var plan = plans[id],
                        els1 = anim.querySelectorAll('.plan[data-id="' + id + '"] .dynamic-props');
                    if (els1) {
                        _.each(els1, function (el1){
                            el1.innerHTML = getDynamicProps(false, plan, isCompany);
                        });
                    }
                }
                reloadOdometers(anim);
            });

            bind(true);

            function bind(isBind){
                processBind(isBind, '.btnUpgrade', $ctrl.openUpgradePlan, true);
            }
        }

        function reloadOdometers(anim) {
            if (!anim) {
                anim = $ctrl.element.querySelector('.anim-presentation .anim-object[data-company="' + ($ctrl.isCompanyTab ? 'true' : 'false') + '"]');
            }
            _.each(anim.querySelectorAll('.odometer'), function (el) {
                if (!el.odometer) {
                    el.odometer = new Odometer(_.extend({
                        el: el
                    }, $ctrl.odometerOptions));
                }
                el.odometer.update(parseInt(el.getAttribute('end-value'), 10));
            });
        }

        function updateDynamicFreeSection() {
            var isFree = $ctrl.selectedPlan && $ctrl.selectedPlan._id === $ctrl.freePlan._id,
                name = $ctrl.freePlan.name;

            if (!$ctrl.freePlanSection) {
                $ctrl.freePlanSection = $ctrl.element.querySelector('.enterprise-section #enterprise-plan');
            }

           if($ctrl.freePlanSection) {
               $ctrl.LCS[isFree ? 'addClass' : 'removeClass']($ctrl.freePlanSection, 'current-plan');
               $ctrl.freePlanSection.innerHTML = '<h3 class="center">' + name + ' Plan' + '</h3>' +
                   '<div class="center">' + $ctrl.freePlan.description + '</div>' +
                   '<div class="text-center spacing-half-top position-relative">' +
                   (isFree ? ('<span class="position-relative current-plan-wrapper"><span class="current-plan centered"><span class="check-mark sbf sbf24 pull-left with-margin-right"></span> <span>Current Plan</span></span></span>') : ('<button type="button" class="btn btn-primary btnFreePlan" analytics-on analytics-action="Sign Up for ' + name + '">' + getBtnText($ctrl.freePlan) + '</button>')) +
                   '</div>';
           }
        }

        function bind(isBind) {
            processBind(isBind, '.btnFreePlan', $ctrl.openFreePlan, true);
            processBind(isBind, '.btnOpen', $ctrl.openPermissionsPopup, true);
            processBind(isBind, '.paymentButtons .custom-checkbox', $ctrl.toggleMonthly);
            processBind(isBind, '.paymentCompanyButtons .btnComp', $ctrl.toggleComp, true);
            processBind(isBind, '.item-list.tooltip-bigger .feature', $ctrl.toggleInfo, true);

            $ctrl.pricingWrapperEl = $ctrl.element.querySelector('.pricing-wrapper');
            $ctrl.pricingEl = $ctrl.pricingWrapperEl ? $ctrl.pricingWrapperEl.querySelector('.pricing-tables') : null;
            if ($ctrl.pricingEl) {
                $ctrl.pricingElTop = $ctrl.pricingEl.offsetTop + ($ctrl.CPS.isAuthenticated ? 324 : 300);
            }

            bindScroller(isBind);

            function bindScroller(isBind) {
                if (isBind) {
                    b();
                }
                b(isBind);

                function b(isBind) {

                    if (!$ctrl.scrollerEl) {
                        $ctrl.scrollerEl = $ctrl.element.querySelector('.fancy-scrollbar');
                    }

                    if ($ctrl.scrollerEl) {
                        $ctrl.LCS.bindElementListeners(isBind, $ctrl.scrollerEl, $ctrl.onScroll, 'scroll', {
                            passive: true
                        });
                    }
                }
            }
        }

        function processBind(isBind, cls, m, isAll) {
            if(isBind){
                b();
            }
            b(isBind);

            function b(isBind){
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.element[isAll ? 'querySelectorAll' : 'querySelector'](cls), m);
            }
        }

        function onScroll(e) {
            //console.log('onScroll pageYOffset');
            var v = $ctrl.scrollerEl.scrollTop >= $ctrl.pricingElTop;
            $ctrl.LCS[v ? 'addClass' : 'removeClass']($ctrl.pricingWrapperEl, 'with-sticky');
            $ctrl.LCS[v ? 'addClass' : 'removeClass']($ctrl.pricingEl, 'with-sticky');
        }

        function openFreePlan(e) {
            $ctrl.preventDefault(e);
            $ctrl.openPayment($ctrl.freePlan, {
                showMonthly: true,
                isFree: true,
                withRelatedPlans: false,
                isAddSeats: false,
                onApplyPlan:onApplyPlan
            });
        }

        function openUpgradePlan(e) {
            var id = $ctrl.LCS.findClosestParent(e.currentTarget, '.plan').getAttribute('data-id'),
                isFreePlan = id === $ctrl.freePlan._id,
                plan = isFreePlan ? {month: $ctrl.freePlan} : $ctrl.showedPlans[$ctrl.isCompanyTab][id],
                p = {
                    onApplyPlan: onApplyPlan,
                    showMonthly: isFreePlan ? true : $ctrl.showMonthly
                };
            if ($ctrl.isPopup) {
                p.onSuccess = onSuccess;
            }
            $ctrl.openPayment(plan, p);

            function onSuccess(result) {
                console.log('onSuccess');
                $ctrl.onClose({result: result});
            }
        }

        function onApplyPlan(){
            $ctrl.close();
        }

        function close(e){
            $ctrl.preventDefault(e);
            if(!$ctrl.isPopup){return;}
            if (typeof ($ctrl.onClose) === 'function') {
                $ctrl.onClose({result: 'cancel'});
            }
        }
    }
}

angular.module('user.payment.init.controller.service', [
    'apiServices.Subscriptions',
    'apiServices.Products',
    'services.sessionService',
    'user.payment.upgradeWizard.component'
])
.service('PaymentInitCtrlService', PaymentInitCtrlService)
.service('PaymentInitCtrlService1', PaymentInitCtrlService1);

PaymentInitCtrlService.$inject = ['ScriptLoaderService', 'PaymentInitCtrlService1'];

function PaymentInitCtrlService(ScriptLoaderService,  PaymentInitCtrlService1) {
    return {loadPayment: loadPayment};

    function loadPayment($ctrl, next, withLoadSubscription){
        if($ctrl.isPaymentInitLoaded){
           // onsuccess();
            return;
        }

        if(withLoadSubscription) {
            $ctrl.withLoadSubscription = true;
            ScriptLoaderService.loadScript('stripe', {url: 'https://js.stripe.com/v2/'}, process);
        }else{
            process();
        }

        function process() {
            $ctrl = new PaymentInitCtrlService1($ctrl);
            $ctrl.getStarted(onsuccess);
        }

        function onsuccess(){
            console.log('loadPayment success');
            $ctrl.isPaymentInitLoaded = true;
            if(next) {
                next();
            }
        }
    }
}

PaymentInitCtrlService1.$inject = ['SubscriptionsService', 'ProductsService', 'Common', '$window'];
function PaymentInitCtrlService1(SubscriptionsService, ProductsService, Common, $window) {
    return function($ctrl) {

        $ctrl.SubscriptionsService = SubscriptionsService;
        $ctrl.ProductsService = ProductsService;
        $ctrl.currencyFormatter =  new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: 'USD',
            trimZeroFractions: true,
            minimumFractionDigits: 2,
            currencyDisplay: 'symbol',
        });
        console.log('PaymentInitCtrlService');

        if (!$ctrl.watchers) {
            console.warn('parent must pass $ctrl parameter to watchers');
        }
        $ctrl.plans =  _.sortBy(_.filter(getPlansData(), function (item) {
            return item.show === true;
        }), 'order');
        $ctrl.features = getPlanFeaturesData();
        initVars();
        $ctrl.imgPaths = $ctrl.LCS.imgPaths;

        if ($ctrl.plans === undefined) {
            console.warn('Parent for PaymentInitCtrl must define $ctrl.plans');
        }
        if ($ctrl.withSignup === undefined) {
            console.warn('Parent for PaymentInitCtrl must define $ctrl.withSignup');
        }
        if ($ctrl.popupsService === undefined) {
            console.warn('Parent for PaymentInitCtrl must define $ctrl.popupsService');
        }

        $ctrl.upgradePlan = null;

        $ctrl.info = {addCard: false, showCoupon: false, showEmail: false, showTaxId:false};

        $ctrl.isUpdating = false;

        $ctrl.formHolder = {};

        $ctrl.coupon = {
            isUpdating: false,
            valid: false,
            id: null
        };

        $ctrl.openCC = openCC;
        $ctrl.openPermissionsPopup = openPermissionsPopup;
        $ctrl.validateCoupon = validateCoupon;
        $ctrl.changeBillingEmail = changeBillingEmail;
        $ctrl.changeTaxId = changeTaxId;
        $ctrl.getCC = getCC;
        $ctrl.insertCC = insertCC;
        $ctrl.changeCard = changeCard;
        $ctrl.getMonthlyTotal = getMonthlyTotal;
        $ctrl.getAnnualSavings = getAnnualSavings;
        $ctrl.getAnnualSavingsFormatted = getAnnualSavingsFormatted;
        $ctrl.applyDiscount = applyDiscountS;
        // $ctrl.isFreePlan = isFreePlan;

        $ctrl.onUpdateSubscription = onUpdateSubscription;
        $ctrl.getCreditCardForm = getCreditCardForm;
        $ctrl.getPlanInfoForm = getPlanInfoForm;
        $ctrl.getCouponForm = getCouponForm;

        $ctrl.reloadSubscription = reloadSubscription;
        $ctrl.openPayment = openPayment;
        $ctrl.openUpgradeYearly = openUpgradeYearly;
        $ctrl.getStarted = getStarted;
        $ctrl.getFormattedCurrency = getFormattedCurrency;

        $ctrl.getIncludedTeamCount =  getIncludedTeamCount;
        $ctrl.getAdditionalTeamCount = getAdditionalTeamCount;

        $ctrl.openAddTeamSeats = openAddTeamSeats;

        return $ctrl;

        function isCustomPlan(){
            return $ctrl.CPS.getSearchFilter('sbcustom') === 1;
        }

        function openUpgradeYearly(e){
            $ctrl.preventDefault(e);
            $ctrl.openPayment($ctrl.currentPlan, {
                withRelatedPlans: true,
                showMonthly: false
            });
        }

        function getFormattedCurrency(p) {
            return $ctrl.currencyFormatter.format(p).replace('\$', '');// (price * 1.00).toFixed(2);
        }

        function getStarted(next) {
            if(!$ctrl.withLoadSubscription) {
                return onnext();
            }

            async.parallel({
                subscription: getSubscription,
                customer: getCustomer
            }, function (err, result) {
                var sc = $ctrl.subscription ? $ctrl.subscription.card : null,
                    cc = $ctrl.customer ? $ctrl.customer.card : null;
                if(cc && !sc || cc && sc && cc.last4 !== sc.last4){
                    $ctrl.SubscriptionsService.updateBillingInfo({
                        companyId: $ctrl.CPS.companyId,
                        card: loadCard(cc)
                    }, function (sub) {
                        $ctrl.subscription.card = sub.card;
                        setCouponValidation();
                        onnext();
                    });
                }else{
                    n();
                }

                function n() {
                    setCouponValidation();
                    onnext();
                }
            });

            function onnext() {
                $ctrl.SessionService.onUpdateSubscription($ctrl.watchers, $ctrl.onUpdateSubscription);
                goToNext(next);
            }
        }

        function openAddTeamSeats(quotaType, type, e) {
            if (!$ctrl.currentPlan) {
                console.log('wait for $ctrl.currentPlan to be set');
                return;
            }
            if ($ctrl.currentPlan.name === 'Free'){
                var qt = $ctrl.SessionService.getSubscriptionParams(quotaType);
                $ctrl.CPS.loadQuotaPopup(quotaType, function (){}, 0, null, $ctrl.compOptions, {e:e});
            }//is free plan doesn't have teams
            else {//if (!qt || !qt.remaining){
                $ctrl.openPayment($ctrl.currentPlan, {
                    showMonthly: $ctrl.currentPlan.interval === 'month',
                    isFree: false,
                    withRelatedPlans: true,
                    isAddSeats: true
                });
            }
        }

        function openPayment(el, options) {
            if (el && el.month && el.month._id === $ctrl.entPlan._id) {
                $window.open('https://www.studiobinder.com/enterprise', '_blank');
            } else {
                $ctrl.upgradePlan = options.isFree ?
                    {plans: {month: el}, showMonthly: true} :
                    {plans: options.withRelatedPlans ? getRelatedPlans(el) : el, showMonthly: options.showMonthly};
                $ctrl.upgradePlan.isAddSeats = options.isAddSeats;
                if ($ctrl.withSignup) {
                    $ctrl.popupsService.open($ctrl.security.Popups.SignUp, $ctrl.popupsService.operations.auth, {
                        upgradePlan: $ctrl.upgradePlan
                    });
                }else {
                    $ctrl.popupsService.ownerAccess(function () {
                        $ctrl.openCC(options.onSuccess);
                    });
                }
            }

            function getRelatedPlans(plan) {
                var plans = {}, name = plan.name, id = plan._id, refPlanId = plan.refPlanId, i, el,
                    x = isOldPlan('Old') || isOldPlan('Legacy');
                if (!x) {
                    plans[getInterval(plan)] = plan;
                } else { // get the monthly plan that is not old

                    for (i = 0; i < $ctrl.plans.length; i++) {
                        el = $ctrl.plans[i];
                        if (el.name.indexOf(x) !== -1 && id !== el._id) {
                            id = el._id;
                            refPlanId = el.refPlanId;
                            plans[getInterval(el)] = el;
                            break;
                        }
                    }
                }

                for (i = 0; i < $ctrl.plans.length; i++) {
                    el = $ctrl.plans[i];
                    if (el.refPlanId === id || el._id === refPlanId) {
                        plans[getInterval(el)] = el;
                        break;
                    }
                }

                return plans;

                function isOldPlan(prop){
                    return name.indexOf(' ' + prop) !== -1 ? name.substring(0, name.length - (prop.length + 1)) : null;
                }
            }

            function getInterval(plan) {
                return plan.interval === 'year' ? 'year' : 'month';
            }

        }

        function doCheckCustomer() {
            var checkFields = ['customer'];
            if (!$ctrl.previousFields) {
                $ctrl.previousFields = {};
            }
            for (var i = 0, l = checkFields.length; i < l; i++) {
                var field = checkFields[i];
                if (!angular.equals($ctrl[field], $ctrl.previousFields[field])) {
                    switch (field) {
                        case 'customer':
                            console.log(field + ' changed');
                            $ctrl.onLoadCustomer();
                            break;
                    }
                    $ctrl.previousFields[field] = angular.copy($ctrl[field]);
                }
            }
        }

        function setCouponValidation() {
            (function (timer, delay) {
                $ctrl.onValidateCoupon = onValidateCoupon;

                function onValidateCoupon() {
                    if (timer) {
                        $ctrl.LCS.cancelTimeout(timer);
                    }
                    timer = $ctrl.LCS.timeout($ctrl.validateCoupon, delay);
                }
            })(false, 500);
        }

        function initVars(sub) {
            if(sub) {
                $ctrl.subscription = sub;
            }else{
                $ctrl.currentPlan = $ctrl.CPS.currentPlan;
                $ctrl.subscription = $ctrl.CPS.subscription;
            }
            $ctrl.subFeatures = $ctrl.subscription ? $ctrl.subscription.features : null;
            $ctrl.selectedPlan = $ctrl.CPS.isAuthenticated ? ($ctrl.currentPlan != null ? $ctrl.currentPlan : $ctrl.freePlan) : $ctrl.freePlan;
        }

        function onUpdateSubscription(sub) {
            console.log('onUpdateSubscription');
            initVars(sub);

            if (sub && $ctrl.CPS.isAuthenticated) {
                getCustomer();
            }

            if($ctrl.onUpdateSubscriptionOther) {
                $ctrl.onUpdateSubscriptionOther(sub);
            }
        }

        function getSubscription(next, withBroadcast) {
           return $ctrl.SubscriptionsService.getSubscription($ctrl.CPS.companyId, function (subscription) {
                if (subscription) {
                    if(withBroadcast) {
                        $ctrl.SessionService.broadcastUpdateSubscription(subscription);
                        $ctrl.CPS.loadSubscription();
                    }else{
                        $ctrl.subscription = subscription;
                    }

                    goToNext(next);
                }
            },  function(error){
               console.log(error);
               goToNext(next);
           });
        }

        function getCustomer(next) {
            $ctrl.SubscriptionsService.getCustomer({companyId: $ctrl.CPS.companyId}, function (customer) {
                $ctrl.customer = customer;
                if ($ctrl.customer) {
                    $ctrl.oldCC = $ctrl.customer ? $ctrl.customer.card : null;
                    $ctrl.info.addCard = !$ctrl.oldCC;
                }
                goToNext(next);
            }, function (error) {
                $ctrl.customer = null;
                console.log(error);
                goToNext(next);
            });
        }

        function goToNext(next) {
            if (typeof (next) === 'function') {
                next();
            }
        }

        function openCC(onSuccess) {
            var plan = $ctrl.upgradePlan.plans[$ctrl.upgradePlan.showMonthly ? 'month' : 'year'];
            var isDowngrade = $ctrl.selectedPlan ? ($ctrl.selectedPlan.interval === 'year' && plan.interval === 'month' || //downgrade from annual to monthly
                $ctrl.selectedPlan.interval === plan.interval && $ctrl.selectedPlan.amount > plan.amount) : true,
            isFree = $ctrl.selectedPlan.name === 'Free';
            if (isDowngrade) { //downgrade
                ProductsService.getCount({
                    companyId: $ctrl.CPS.companyId
                }, function (result) {
                    onGetCount(result && result.count ? result.count : 0);
                }, function (err) {
                    console.log(err);
                    onGetCount(0);
                });

                function onGetCount(count) {
                    console.log('projects count = ' + count);
                    $ctrl.overQuota = [];
                    var x = $ctrl.subFeatures;
                    var isCustom = isCustomPlan();
                    for (var prop in plan.features) {
                        var el = plan.features[prop], xprop = x[prop];
                        if (el.hasCounter && el.isReplenishable !== true && el.count != null && xprop !== undefined && xprop !== null && xprop.used !== null) {
                            var used = prop === 'projects' ? count : xprop.used; //projects or team
                            if (el.count < used && !isCustom) {
                                var shortDesc = prop;
                                var filter = $ctrl.features ? _.find($ctrl.features, {name: prop}) : null;
                                if (filter) {
                                    shortDesc = filter.shortDesc.toLowerCase();
                                }
                                var isusers = prop === 'team';
                                if(!isusers || isusers && isFree) {
                                    $ctrl.overQuota.push({
                                        shortDesc: shortDesc,
                                        name: prop,
                                        total: el.count,
                                        used: used
                                    });
                                }
                            }
                        }
                    }

                    if ($ctrl.overQuota.length > 0) {
                        $ctrl.popupsService.open(null, $ctrl.popupsService.operations.downgradeQuotaExceeded, {
                            overQuota: $ctrl.overQuota,
                            upgradePlan: $ctrl.upgradePlan
                        });
                    } else {
                        openCCModal(isDowngrade, isCustom);
                    }
                }
            } else {
                openCCModal(isDowngrade);
            }

            function openCCModal(isDowngrade, isCustom) {
                $ctrl.popupsService.open(null, $ctrl.popupsService.operations.upgradeWizard, _.extend({
                    upgradePlan: $ctrl.upgradePlan.plans,
                    showMonthly: $ctrl.upgradePlan.showMonthly,
                    isDowngrade: isDowngrade,
                    customer: $ctrl.customer,
                    isAddSeats: $ctrl.upgradePlan.isAddSeats,
                    isCustom: isCustom,
                    tracking: $ctrl.extraParam ? $ctrl.extraParam.tracking : null
                }, $ctrl.extraParam && $ctrl.extraParam.popupIndex ? {
                    popupIndex: $ctrl.extraParam.popupIndex + 2
                } : null,
                    $ctrl.extraParam && $ctrl.extraParam.closeUpgradeOnSuccess ? {
                        closeOnSuccess: true,
                        onSuccess: onsuccess
                    } : null,
                ), $ctrl.compOptions);

                function onsuccess(result){
                    if($ctrl.extraParam && $ctrl.extraParam.closeOnSuccess){
                        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.subscription.success', 'success');

                        if($ctrl.extraParam && $ctrl.extraParam.closeUpgradeOnSuccess) {
                            onUpdateSubscription(result);
                        }

                        $ctrl.close();

                        if(typeof($ctrl.extraParam.onSuccess) === 'function'){
                            $ctrl.extraParam.onSuccess(result);
                        }
                    }
                }
            }
        }


        function openPermissionsPopup() {
            $ctrl.popupsService.open(null, $ctrl.popupsService.operations.sharePermissions);
        }

        function applyDiscount(coupon) {
            $ctrl.coupon.isUpdating = false;
            if (coupon && coupon.valid) {
                $ctrl.coupon = coupon;
                $ctrl.formHolder.coupon.coupon.$invalid = 'valid';
            } else {
                $ctrl.coupon.valid = false;
                $ctrl.coupon.discount = 0;
                if($ctrl.plan) {
                    $ctrl.plan.discounted = $ctrl.plan.amount;
                }
            }
            if($ctrl.recomputePrice){
                $ctrl.recomputePrice();
            }
        }

        function validateCoupon() {
            if (!$ctrl.coupon.isUpdating) {
                if ($ctrl.coupon.id) {
                    $ctrl.formHolder.coupon.attempted = true;
                    $ctrl.coupon.isUpdating = true;
                    $ctrl.SubscriptionsService.validateCoupon({
                        companyId: $ctrl.CPS.companyId,
                        coupon: $ctrl.coupon.id
                    }, function (coupon) {
                        applyDiscount(coupon);
                    }, function (error) {
                        $ctrl.coupon.isUpdating = false;
                        $ctrl.coupon.valid = false;

                        $ctrl.formHolder.coupon.coupon.$invalid = 'invalid';
                    });
                } else {
                    applyDiscount(null);
                }
            }
        }

        function changeBillingEmail(e) {
            $ctrl.preventDefault(e);
            if (!$ctrl.isUpdatingE) {
                $ctrl.formHolder.email.attempted = true;
                if ($ctrl.formHolder.email && $ctrl.formHolder.email.$valid) {
                    $ctrl.isUpdatingE = true;
                    $ctrl.SubscriptionsService.changeBillingEmail($ctrl.emailInfo, function (result) {
                        $ctrl.info.showEmail = false;
                        $ctrl.isUpdatingE = false;
                        $ctrl.subscription.billingEmail = $ctrl.emailInfo.billingEmail;

                        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.subscription.changeBillingEmail.success', 'success');
                    }, function (error) {
                        $ctrl.isUpdatingE = false;
                        $ctrl.formHolder.email.email.$invalid = $ctrl.localizedMessages.getFromError(error, 'crud.subscription.changeBillingEmail.error');
                    });
                }
            }
        }
        function changeTaxId(e) {
            $ctrl.preventDefault(e);
            if (!$ctrl.isUpdatingT) {
                $ctrl.formHolder.taxid.attempted = true;
                if ($ctrl.formHolder.taxid && $ctrl.formHolder.taxid.$valid) {
                    $ctrl.isUpdatingT = true;
                    $ctrl.SubscriptionsService.changeTaxId($ctrl.emailInfo, onsuccess, onError);
                }
            }

            function onsuccess(result) {
                $ctrl.info.showTaxId = false;
                $ctrl.isUpdatingT = false;
                $ctrl.subscription.taxId = $ctrl.emailInfo.taxId;

                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.subscription.changeTaxId.success', 'success');
            }

            function onError(error) {
                $ctrl.isUpdatingT = false;
                $ctrl.formHolder.taxid.taxId.$invalid = $ctrl.localizedMessages.getFromError(error, 'crud.subscription.changeTaxId.error');
            }
        }

        function getCC(form) {
            var exp = Common.parseExpiry(form.expiry.$modelValue);
            return {
                exp_month: exp.month,
                exp_year: exp.year,
                number: form.card.$modelValue,
                cvc: form.cvc.$modelValue
            };
        }

        function insertCC(next) {
            $ctrl.formHolder.card_attempted = true;
            var form = $ctrl.formHolder.card;
            if (form && form.$valid) {
                $ctrl.isUpdatingC = true;
                setKey();
                $window.Stripe.createToken($ctrl.getCC(form), onTokenCreated);
            }
            function setKey() {
                if (!$window.StripeKeySet) {
                    var stripe = $ctrl.LCS.API_CONFIGS.stripe;
                    if (stripe.enabled) {
                        $window.Stripe.setPublishableKey(!stripe.isLive ? stripe.testPublishableKey : stripe.livePublishableKey);
                    }
                    $window.StripeKeySet = true;
                }
            }

            function onTokenCreated(code, result) {
                if (result.error) {
                    $ctrl.isUpdatingC = false;
                    $ctrl.error = result.error.message;
                } else if (typeof (next) === 'function') {
                    next(result ? _.extend({tokenId: result.id}, loadCard(result.card)) : null);
                }
            }
        }

        function loadCard(card) {
            return card ? {
                id: card.id,
                country: card.country,
                last4: card.last4,
                expMonth: card.exp_month,
                expYear: card.exp_year,
                type: card.brand ? card.brand : card.type
            } : null;
        }

        function changeCard(e, onsuccess) {
            $ctrl.preventDefault(e);

            console.log('changeCard');
            $ctrl.error = null;
            if (!$ctrl.isUpdatingC && $ctrl.subscription) {
                $ctrl.insertCC(onInserted);
            }

            function onInserted(card) {
                $ctrl.SubscriptionsService.updateBillingInfo({
                    companyId: $ctrl.CPS.companyId,
                    card: card
                }, onUpdated, onError);
            }

            function onUpdated(sub) {
                $ctrl.isUpdatingC = false;
                if (!sub) {
                    $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.subscription.card.error');
                    return;
                }
                var form = $ctrl.formHolder.card;
                $ctrl.oldCC = {};
                $ctrl.oldCC.last4 = form.card.$modelValue.substring(form.card.$modelValue.length - 4);
                $ctrl.oldCC.type = form.card.$card.type;
                $ctrl.info.addCard = false;

                if (onsuccess && typeof (onsuccess) === 'function') {
                    onsuccess();
                } else {
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.subscription.card.save.success', 'success');
                }
            }

            function onError(err) {
                $ctrl.isUpdatingC = false;
                $ctrl.error = $ctrl.localizedMessages.getFromError(err ? (err.type.indexOf('Stripe') !== -1 ? err.raw.message : err.error) : null, 'crud.subscription.card.error');
            }
        }

        function getIncludedTeamCount(el, showMonthly){
            var p = el[showMonthly ? 'month' : 'year'];
            return p.features.team ? p.features.team.count : 1
        }

        function getAdditionalTeamCount(el, showMonthly){
            var team = getIncludedTeamCount(el, showMonthly);
            return team && el.teamCount && el.teamCount > team ? (el.teamCount - team) : 0;
        }

        function getMonthlyTotal(el, showMonthly) {
            var p = el[showMonthly ? 'month' : 'year'];
            if (!p) {
                return 0;
            }
            return $ctrl.getAdditionalTeamCount(el, showMonthly) * (p.amount_additional ? p.amount_additional : 0) + (p.amount ? p.amount : 0);
        }

        function getAnnualSavings(el) {
            return el && !el.showMonthly ? ($ctrl.getMonthlyTotal(el, true) - $ctrl.getMonthlyTotal(el, false)) * 12 : 0;
        }

        function getAnnualSavingsFormatted(el){
            return $ctrl.getFormattedCurrency(getAnnualSavings(el));
        }

        function applyDiscountS() {
            $ctrl.error = null;
            var coupon = $ctrl.coupon.id;
            $ctrl.formHolder.coupon.attempted = true;
            var form = $ctrl.formHolder.coupon;

            if (!$ctrl.isUpdatingD && form && form.$valid) {
                if (coupon) {
                    $ctrl.coupon.id = null;
                    $ctrl.isUpdatingD = true;

                    if ($ctrl.subscription) {
                        $ctrl.SubscriptionsService.applyDiscount({
                            companyId: $ctrl.CPS.companyId,
                            coupon: coupon
                        }, function (result) {
                            $ctrl.isUpdatingD = false;
                            if (result) {
                                $ctrl.reloadSubscription();
                                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.subscription.discount.success', 'success');
                                $ctrl.info.showCoupon = false;
                            } else {
                                $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.subscription.discount.error');
                            }
                            $ctrl.isUpdatingD = false;
                        }, function (err) {
                            $ctrl.isUpdatingD = false;
                            $ctrl.error = $ctrl.localizedMessages.getFromError(err.error, 'crud.subscription.discount.error');
                        });
                    }
                } else {
                    //insert coupon value
                }
            }
        }

        function reloadSubscription(next) {
            if (!$ctrl.CPS.companyId) {
                return goToNext(next);
            }

            return getSubscription(next, !($ctrl.extraParam && $ctrl.extraParam.closeUpgradeOnSuccess));
        }

        function updateOldCC() {
           /* '.wrapperPaymentDetails .orspan'
            '.wrapperPaymentDetails .btnCard'*/
        }
        function getCreditCardForm(showEmpty)  {
            $ctrl.oldCC = $ctrl.subscription.card;
            $ctrl.info.addCard = showEmpty || !$ctrl.oldCC;
           /* if(showEmpty) {
                $ctrl.showPencil = showEmpty;
            }*/
            return '<form name="$ctrl.formHolder.card" novalidate class="credit-card-form form-wrapper" autocomplete="off" novalidate>' +
                $ctrl.LCS.getErrorBlock() +
                    '<div ng-if="$ctrl.oldCC && !$ctrl.info.addCard" class="form-group field">' +
                        '<span ng-if="$ctrl.oldCC" class="card card-icon" ng-style="{\'background-image\':\'url(\'+$ctrl.LCS.getImgUrl(($ctrl.oldCC.type?($ctrl.oldCC.type.toLowerCase().replace(\' \',\'_\')):\'card\')+\'.svg\')+\')\'}">' +
                            '<span>⁕⁕⁕⁕ ⁕⁕⁕⁕ ⁕⁕⁕⁕ </span> <span ng-bind="$ctrl.oldCC.last4"></span>' +
                            '<a style="top:6px" ng-if="$ctrl.showPencil" ng-click="$ctrl.info.addCard=!$ctrl.info.addCard" class="with-hover location-edit-btn empty">' + $ctrl.LCS.getISBDiv('pencil', 2, 'sbf12') + '</a>' +
                        '</span>' +
                    '</div>' +
                    '<div ng-if="$ctrl.info.addCard || !$ctrl.oldCC" class="add-card">' +
                        '<div class="form-group field card card-icon" ng-style="{\'background-image\': \'url(\' + $ctrl.LCS.getImgUrl( ($ctrl.cardType ? $ctrl.cardType.replace(\' \', \'_\') : \'card\') + \'.svg\', false)+\')\',\'background-position\':\'0 center\' }">' +
                            '<input class="form-control with-underline" type="text" name="card" ng-model="$ctrl.card" placeholder="1234 5678 9012 3456" required payments-format="card" payments-validate="card" payments-type-model="$ctrl.cardType" style="text-indent:40px" ui-focus="true">' +
                            '<div class="help-inline" ng-show="($ctrl.formHolder.card.card.$dirty || $ctrl.formHolder.card_attempted) && $ctrl.formHolder.card.card.$error.required" class="help-inline ng-hide">Credit card number is required.</div>' +
                            '<div class="help-inline" ng-show="($ctrl.formHolder.card.card.$dirty || $ctrl.formHolder.card_attempted) && $ctrl.formHolder.card.card.$invalid">Invalid card number.</div>' +
                        '</div>' +
                        '<div class="form-group field margin-top-half" style="margin-bottom: 3px">' +
                            '<div class="input-group inline half pull-left">' +
                                '<input class="form-control with-underline" type="text" ng-model="$ctrl.expiry" placeholder="MM/YY" payments-format="expiry" payments-validate="expiry" name="expiry" required/>' +
                                '<div class="help-inline" ng-show="($ctrl.formHolder.card.expiry.$dirty || $ctrl.formHolder.card_attempted) && $ctrl.formHolder.card.expiry.$error.required" class="help-inline ng-hide">Expiration date is required.</div>' +
                                '<div class="help-inline" ng-show="($ctrl.formHolder.card.expiry.$dirty || $ctrl.formHolder.card_attempted) && $ctrl.formHolder.card.expiry.$invalid">Invalid expiration date.</div>' +
                            '</div>' +
                            '<div class="input-group inline half pull-right card card-icon" style="background-image: url(' + $ctrl.LCS.getImgUrl('cvc.svg', false)+'); background-position:0 center">' +
                                '<input class="form-control with-underline" ng-model="$ctrl.cvc" placeholder="CVC" payments-format="cvc" payments-validate="cvc" name="cvc" style="text-indent:40px"/>' +
                                '<div class="help-inline" ng-show="($ctrl.formHolder.card.cvc.$dirty || $ctrl.formHolder.card_attempted) && $ctrl.formHolder.card.cvc.$error.required" class="help-inline ng-hide">CVC is required.</div>' +
                                '<div class="help-inline" ng-show="($ctrl.formHolder.card.cvc.$dirty || $ctrl.formHolder.card_attempted) && $ctrl.formHolder.card.cvc.$invalid">Invalid CVC number.</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</form>';
        }
        
        function getPlanInfoForm() {
return '<div class="left-side plan" ng-class="{\'best-value\': $ctrl.currentPlan.label}">' +
        '<div class="head">' +
            '<h2 class="ng-binding">'+$ctrl.currentPlan.name+'</h2>' +
            '<div class="price">' +
                '<h3  class="' + (($ctrl.subscription.currentInvoice ? $ctrl.subscription.currentInvoice.total : $ctrl.subscription.amount).length > 4 ? 'smallerfont':'')+'">' +
                    '<span class="symbol">$</span>' +
                    '<span>'+($ctrl.subscription.currentInvoice ? $ctrl.subscription.currentInvoice.total : $ctrl.subscription.amount)+'</span>' +
                    '<span class="symbolmo">/<span>'+($ctrl.currentPlan.interval !=='year' ? 'mo':'yr')+'</span></span>' +
                '</h3>' +
    ($ctrl.subscription.currentInvoice.discount?('<div class="text-center appliedCoupon" class="text-center">$'+$ctrl.subscription.currentInvoice.discountAmount+' off</div>'):'') +
            '</div>' +
    ($ctrl.subFeatures.team.total>1 ? ('<div class="teamcount" ng-if="$ctrl.subFeatures.team.total>1">'+$ctrl.subFeatures.team.total+' users</div>') : '') +
    ($ctrl.currentPlan && $ctrl.currentPlan.interval!=='year' && $ctrl.subscription.currentInvoice ? ('<div class="nextpayment">Next payment on <span ng-bind="$ctrl.subscription.currentInvoice.endDate | amDateFormat : $ctrl.CPS.dateFormat"></span></div>'):'') +
        '</div>' +
    '</div>';
        }

        function getCouponForm() {
         return '<form class="form coupon form-wrapper" name="$ctrl.formHolder.coupon" autocomplete="off" novalidate>' +
                    '<div class="form-group last" ng-class="{\'displayBtn\': $ctrl.displayBtn}">' +
                        '<input class="form-control with-underline coupon" type="text" name="coupon" ng-model="$ctrl.coupon.id" placeholder="Offer Code (optional)" ng-keyup="$ctrl.onValidateCoupon()" ui-focus="true">' +
                        '<span class="validator sbf " ng-class="{\'check-semi success\':($ctrl.formHolder.coupon.coupon.$dirty || $ctrl.formHolder[\'coupon_attempted\']) && $ctrl.formHolder.coupon.coupon.$invalid == \'valid\', \'wrong insuccess\':($ctrl.formHolder.coupon.coupon.$dirty || $ctrl.formHolder[\'coupon_attempted\']) && $ctrl.formHolder.coupon.coupon.$invalid == \'invalid\', \'loadingicon animate-spin\': $ctrl.coupon.isUpdating}"></span>' +
                        '<button ng-if="$ctrl.displayBtn" ng-click="$ctrl.applyDiscount()" analytics-on analytics-action="Apply Coupon" class="btn card" ng-class="{\'disabled\': !(($ctrl.formHolder.coupon.coupon.$dirty || $ctrl.formHolder[\'coupon_attempted\']) && $ctrl.formHolder.coupon.coupon.$invalid == \'valid\') || $ctrl.isUpdatingD == true}" ng-disabled= "!(($ctrl.formHolder.coupon.coupon.$dirty || $ctrl.formHolder[\'coupon_attempted\']) && $ctrl.formHolder.coupon.coupon.$invalid == \'valid\') || $ctrl.isUpdatingD== true" type="submit">' +
                            '<svg ng-hide="$ctrl.isUpdatingD" width="20px" height="20px" viewBox="0 0 20 20" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:sketch="http://www.bohemiancoding.com/sketch/ns">' +
                                '<g ng-show="!$ctrl.isUpdatingD" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd" sketch:type="MSPage">' +
                                    '<g sketch:type="MSArtboardGroup" transform="translate(-768, -371)" fill="#59BDD6">' +
                                        '<path d="M778,371 C772.485909,371 768,375.485909 768,381 C768,386.514091 772.485909,391 778,391 C783.514091,391 788,386.514091 788,381 C788,375.485909 783.514091,371 778,371 L778,371 Z M779.290599,378.002368 C779.067387,378.021455 778.877319,378.15311 778.804091,378.339358 C778.730864,378.525606 778.787915,378.732269 778.950123,378.868342 L780.804823,380.497948 L773.601059,380.497948 C773.583149,380.497209 773.565209,380.497209 773.547299,380.497948 C773.342402,380.506351 773.158176,380.610173 773.064034,380.770296 C772.969891,380.930419 772.98014,381.12251 773.090917,381.274193 C773.201694,381.425877 773.396165,381.514102 773.601059,381.505627 L780.804823,381.505627 L778.941163,383.135233 C778.71601,383.33306 778.71601,383.653802 778.941163,383.851629 C779.166316,384.049457 779.531361,384.049457 779.756514,383.851629 L782.587844,381.356049 L783,381.001787 L782.587844,380.647525 L779.756514,378.151945 C779.635052,378.042598 779.463682,377.987582 779.290599,378.002368 L779.290599,378.002368 Z" id="Shape" sketch:type="MSShapeGroup"></path>' +
                                    '</g>' +
                                '</g>' +
                            '</svg>' +
                            '<span ng-show="$ctrl.isUpdatingD" class="pull-left sbf loadingicon animate-spin"></span>' +
                        '</button>' +
                    '</div>' +
                    '<div class="validator1 success ng-hide" ng-show="($ctrl.formHolder.coupon.coupon.$dirty || $ctrl.formHolder[\'coupon_attempted\']) && $ctrl.formHolder.coupon.coupon.$invalid === \'valid\'">Coupon valid. Apply now to get {{$ctrl.coupon.amountOff > 0 ? $ctrl.coupon.amountOff : ($ctrl.coupon.percentOff + \'%\')}} off for {{$ctrl.coupon.duration}} month{{$ctrl.coupon.duration!==1 ? \'s\' : \'\'}}.</div>' +
                '</form>';
        }
    }
}

angular.module('user.teamAdmin.access.component',[
    'user.payment.quota.service'
])
.component('teamAdminAccessPopup', popupComponentParams('TeamAdminAccessPopupCtrl'))
.controller('TeamAdminAccessPopupCtrl', TeamAdminAccessPopupCtrl);
TeamAdminAccessPopupCtrl.$inject =['QuotaCtrlPopupService', '$element'];

function TeamAdminAccessPopupCtrl(QuotaCtrlPopupService, $element) {
    var $ctrl = this;

    $ctrl.getOtherInfo = getOtherInfo;

    $ctrl = new QuotaCtrlPopupService($ctrl, $element);

    function getOtherInfo() {
        return {
            title: 'This feature can be accessed only by the company admins',
            desc: 'To access this feature, you’ll need to...',
            btn: 'View Company Plans'
        }
    }
}

