InvoicePreviewCtrl.$inject = ['TemplateCompileCompCtrlService', 'InvoicesService', '$element'];
function InvoicePreviewCtrl(TemplateCompileCompCtrlService, InvoicesService, $element) {
  var $ctrl = this;

  $ctrl.InvoicesService = InvoicesService;

  $ctrl.preInit = preInit;
  $ctrl.dontAutoloadTemplate = true;
  $ctrl.getItemTemplate = getItemTemplate;

  $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

  function preInit() {
    var stateParams = $ctrl.SBStateService.getCurrentStateParams();
    if(!stateParams.invoiceId){
      process();
    }else{
      $ctrl.reloadTemplate();
    }

    async.parallel([
        function (c){

        }, function (c){

        },
    ])

    $ctrl.InvoicesService.getById(stateParams.invoiceId, 'companyId createdById', function (invoice) {
      $ctrl.invoice = invoice;
      process();
    }, function (error) {
      process();
    });
    function process() {
      $ctrl.isLoaded = true;
      if ($ctrl.invoice) {
        $ctrl.company = $ctrl.invoice.companyId;
        $ctrl.createdBy = $ctrl.invoice.createdBy;
      }
      $ctrl.reloadTemplate();
    }
  }

  function getItemTemplate() {
    if (!$ctrl.isLoaded) {
      return '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
    }

    return '<div class="with-fancy-scrollbar h-full show-scrollbar-on-hover ng-scope">' +
        '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper flex-block">' +
        '<div class="tabbable spacing-bottom auth-cast margin-top-half">' +
        '<div class="form-wrapper long modal-content centered" ' +
        'style="margin-top: ' + ($ctrl.CPS.isAuthenticated ? '0' : '60px') + ';margin-bottom:' + ($ctrl.CPS.isAuthenticated.isAuthenticated ? '0' : '40px') + '">' +
        '<div>' +
        ($ctrl.invoice ? getValid() : getInvalid()) +
        '</div>' +
        '<div>' +
        '</div>' +
        '</div>' +
        '</div>';

    function getInvalid() {
      return '<h3 class="text-center spacing-half">This Invoice is <br/> Invalid or No Longer Available</h3>';
    }
  }
  
  function getValid() {
  return getStyle()+
        '<div class="width-100">' +
            '<div style="height:40px;" class="width-100">' +
              '<div style="height:4px; background-color:#131f57;" class="width-100 brand-color-header">' +
                '&nbsp;' +
              '</div>' +
            '</div>' +
          '</div>' +
        '<div style="margin-left:40px;margin-right:40px;overflow:hidden;min-height:700px">' +
          '<div class="mb20 flex-horizontal flex-justify flex-align-start width-100">' +
            '<div>' +
              '<div class="h1 mb20">Invoice</div>' +
              '<div class="mb20">' +
                '<table cellpadding="0" cellspacing="0" class="metadata">' +
                  '<tbody>' +
                      '<tr>' +
                        '<td>Invoice number</td>' +
                        '<td>'+$ctrl.invoice.number+'</td>' +
                      '</tr>' +
                      '<tr>' +
                        '<td>Date due</td>' +
                        '<td>'+$ctrl.invoice.date+'</td>' +
                      '</tr>' +
                  '</tbody>' +
                '</table>' +
              '</div>' +
            '</div>' +

            '<div class="brand-logo-container"><img class="logo-img brand-logo-img" src="'+$ctrl.LCS.getImgUrl('uploads/header-logo-logout-studiobinder.svg')+'"></div>' +

            '<div class="brand-logo-fallback-container hidden">' +
              '<div class="h1 logo-gray">' + $ctrl.LCS.API_CONFIGS.site.companyName + '</div>' +
            '</div>' +
          '</div>' +

          '<div class="flex-horizontal flex-align-start mb30 break-word">' +
              '<div class="width-50">' +
                '<div class="address-merchant-name bold">' +
                  'StudioBinder Inc.' +
                '</div>' +
                '<div class="address-lines">' +
                  '<div>'  + $ctrl.LCS.API_CONFIGS.site.address + '</div>' +
                '</div>' +
                '<div class="address-phone"></div>' +
                '<div>' + $ctrl.LCS.API_CONFIGS.site.email + '</div>' +
              '</div>' +

              '<div class="flex-horizontal width-50">' +
                '<div class="pr15 width-100">' +
                  '<div class="bold">Bill to</div>' +
                  '<div>' + ($ctrl.company.ownerName || '') + ' @ '+ $ctrl.company.name  + '</div>' +
                  '<div class="address-lines">' + '</div>' +
                  '<div class="address-phone">' + '</div>' +
                  '<div>' + $ctrl.company.email + '</div>' +
                '</div>' +
              '</div>' +
          '</div>' +

          '<div class="mb30">' +
            '<div class="h2">'+ $ctrl.invoice.amount +' due '+ $ctrl.invoice.date +'</div>' +
            '<div class="mt10 maintain-newlines"></div>' +
          '</div>' +

          '<table cellpadding="0" cellspacing="0" class="line-item-table mb30">' +
            '<tbody>' +

              '<tr class="table-headers">' +
                '<td class="width-50 center-valign">Description</td>' +
                '<td class="width-16point7 center-valign">Qty</td>' +
                '<td class="width-16point7 center-valign"><div class="line-height-1point3">Unit price</div></td>' +
                '<td class="width-0 center-valign">&nbsp;</td>' +
