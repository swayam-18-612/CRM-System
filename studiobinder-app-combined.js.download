angular.module('ctrl.popups.defaultPopup.controller', [
])
.controller('DefaultPopupCtrl', DefaultPopupCtrl);
DefaultPopupCtrl.$inject = getDefaultPopupParams().concat(['PopupsService']);

function getDefaultPopupParams(){
    return ['modalId', 'item', 'type', 'compOptions', 'extraParam'];
}

function DefaultPopupCtrl(modalId, item, type, compOptions, extraParam, PopupsService) {
    var $ctrl = this;
    $ctrl.popupsService = PopupsService;

    $ctrl.close = close;
    $ctrl.$onInit = $onInit;

    function $onInit() {
        $ctrl.type = type;
        $ctrl.compOptions = compOptions;
        $ctrl.extraParam = extraParam;
        $ctrl.item = item;
        $ctrl.modalId = modalId;
    }

    function close(result) {
        console.log('DefaultPopupCtrl :')
        console.log(result);
        $ctrl.popupsService.closePopup(result ? result : 'cancel', $ctrl.modalId);
    }
}

angular.module('ctrl.PopupsCtrl.generalItemEditPopup.component', [
    'ctrl.PopupsCtrl.generalItemEdit.service'
])
.component('generalItemEditPopup', popupComponentParams('GeneralItemEditPopupCtrl'))
.controller('GeneralItemEditPopupCtrl', GeneralItemEditPopupCtrl);
GeneralItemEditPopupCtrl.$inject = ['GeneralItemEditCtrlService', '$element'];
function GeneralItemEditPopupCtrl(GeneralItemEditCtrlService, $element) {
    var $ctrl = this;
    $ctrl.withLabel = true;

    $ctrl.isPopup = true;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);
}

angular.module('ctrl.PopupsCtrl.generalItemEdit.service', [
    'item.listTemplate.controller.service'
])
.service('GeneralItemEditCtrlService', GeneralItemEditCtrlService);
GeneralItemEditCtrlService.$inject = ['ListItemTemplateFormCtrlService'];
function GeneralItemEditCtrlService(ListItemTemplateFormCtrlService) {
    return function ($ctrl, $element, isPopup) {

        console.log('GeneralItemEditCtrlService');
        if(typeof($ctrl.setTemplateData) === 'function'){
            console.warn('parent for GeneralItemEditCtrlService must define $ctrl.preSetTemplateData');
        }

        $ctrl.setTemplateData = setTemplateData;

        $ctrl.preInitOther = preInitOther;
        $ctrl.postInitOther = postInitOther;

        $ctrl.getRowCols = getRowCols;
        $ctrl.getContentEditable = getContentEditable;

        $ctrl.getColumnsColor = getColumnsColor;
        $ctrl.setColorColumns = setColorColumns;
        $ctrl.setColorSettings = setColorSettings;

        $ctrl.getColumnDate = getColumnDate;
        $ctrl.getColumnByProp = getColumnByProp;

        $ctrl.getCondBlock = getCondBlock;
        $ctrl.getDrpRow = getDrpRow;
        $ctrl.getRowCheck = getRowCheck;
        $ctrl.getColumnColor = getColumnColor;
        $ctrl.setColorWithVersionAndDesc = setColorWithVersionAndDesc;
        $ctrl.getNotesColumn = getNotesColumn;
        $ctrl.getVersionColumn = getVersionColumn;
        $ctrl.getNameColumn = getNameColumn;
        if(!$ctrl.openProPopup) {
            $ctrl.openProPopup = openProPopup;
        }
        $ctrl.openProPopupInit = openProPopup;

        $ctrl.addF = addF;
        $ctrl.addT = addT;

        $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function addF(id, e) {
            $ctrl.add(e, false);
        }

        function addT(id, e) {
            $ctrl.add(e, true);
        }

        function openProPopup(quotaType, e, maxFreeItemsCount) {
            console.log('openProPopup');
            var quota = quotaType ? quotaType : ($ctrl.extraParam ? $ctrl.extraParam.quotaType : null);
            if (quota) {
                $ctrl.CPS.loadQuotaPopup(quotaType ? quotaType : $ctrl.extraParam.quotaType, function () {
                }, maxFreeItemsCount !== undefined && maxFreeItemsCount !== null ? maxFreeItemsCount : null, null, $ctrl.compOptions, {e: e});
            }
        }

        function preInitOther() {
            var props = ['Settings',
                'isTreeAdd', 'isDuplicate', 'itemTitle', 'itemIcon',
                'columnsList', 'columnImg', 'withCloseBtn'
            ].concat($ctrl.otherExtraParamProps);
            if($ctrl.extraParam) {
                _.each(props, function (prop){
                    var val = $ctrl.extraParam[prop];
                    if (val) {
                        $ctrl[prop] = val;
                    }
                });
            }
            if($ctrl.withLabel === undefined && $ctrl.LCS.isMobileSize){
                $ctrl.withLabel = true;
            }

            if(typeof($ctrl.preInitGeneral) === 'function'){
                $ctrl.preInitGeneral();
            }
        }

        function postInitOther() {
            $ctrl.selected = null;
            $ctrl.isEditPopup = true;
            $ctrl.clean = false;
            if ($ctrl.isDuplicate) {
                if(!$ctrl.dontDuplicateNameSet){
                    $ctrl.item.name = 'Copy of ' + ($ctrl.item.name ? $ctrl.LCS.convertHtmlToText($ctrl.item.name) : $ctrl.itemTitle);
                }
                $ctrl.icon = 'copy';
                $ctrl.iconLevel = 2;
            }

            $ctrl.add = add;

            if(typeof($ctrl.postInitGeneral) === 'function'){
                $ctrl.postInitGeneral();
            }
        }

        function add(e, clean) {
            $ctrl.preventDefault(e);
            $ctrl.CPS.loadQuotaPopup($ctrl.quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: getPageClass()}), {e:e});
            function process() {
                $ctrl.listItemUpdates = $ctrl.isNew ? null : $ctrl.getDataToUpdate();
                $ctrl.clean = clean;
                if (typeof ($ctrl.addGeneral) === 'function') {
                    $ctrl.addGeneral();
                }
                $ctrl.save();
            }
        }

        function setTemplateData() {
            $ctrl.withBtnDisabled = true;
            $ctrl.withFooterBtns = true;

            if(typeof($ctrl.preSetTemplateData) === 'function'){
                $ctrl.preSetTemplateData();
            }

            if(!$ctrl.icon) {
                $ctrl.icon = $ctrl.itemIcon;
            }

            if(!$ctrl.popupTitle) {
                $ctrl.popupTitle = ($ctrl.isNew ? ($ctrl.isDuplicate ? 'Duplicate' : 'Create New') : 'Edit') + ' ' + $ctrl.itemTitle;
            }

            if(!$ctrl.textAnalytics) {
                $ctrl.textAnalytics = $ctrl.removeHtmlTags($ctrl.popupTitle);
            }

            if ($ctrl.isNew && $ctrl.with2FooterBtns) {
                if(!$ctrl.firstBtnMethod) {
                    $ctrl.firstBtnMethod = 'addF';
                }

                if(!$ctrl.btnText) {
                    $ctrl.btnText = '<span>Save</span><span class="hide-ipad"> & Close</span>';
                }

                if(!$ctrl.btnText2) {
                    $ctrl.btnText2 = 'Save & Add Another';
                }

                if(!$ctrl.secBtnMethod) {
                    $ctrl.secBtnMethod = 'addT';
                }

                $ctrl.textAnalytics2 = $ctrl.removeHtmlTags($ctrl.textAnalytics);
            }else{
                if(!$ctrl.btnText) {
                    $ctrl.btnText = '<span>' + ($ctrl.isNew ? ($ctrl.isDuplicate ? 'Duplicate' : 'Create') : 'Save') + '<span><span class="hide-ipad"> ' + $ctrl.itemTitle + '</span>';
                }
            }
        }

        function getRowCols(list, width, withLabel, isMobile, params, cls) {
            return isMobile ? p('col100p') : ('<div class="clearfix ' + (cls || '') + '">' + p() + '</div>');

            function p(w) {
                return $ctrl.getPopupEditRow(list.map(function (field) {
                    var c = typeof (field) === 'string' ? $ctrl.getColumnByProp(field) : field;
                    return _.extend({}, c, {customDrpClass: true})
                }), w ? w : width, withLabel, isMobile, params);
            }
        }

        function getContentEditable(prop, isAll, other) {
            var c = $ctrl.getColumnByProp(prop, isAll);
            return c ? $ctrl.getPopupFormForSelectedCol(_.extend({}, c, other)) : '';
        }

        function getColumnByProp(prop) {
            return _.find($ctrl.columnsList, function(c){return c.prop === prop});
        }

        function getEClassAttr() {
            return ' form-control with-underline ' + getPageClass();
        }
        function getPageClass(){return $ctrl.pageClass ? ('page-class '+$ctrl.pageClass):'';}

        function getColumnDate(dateProp, name, withDateProp, otherProps) {
            if(!name){name = 'Start';}

            var d = 'date' + (withDateProp ? dateProp : ''),
                t = 'time' + (withDateProp ? dateProp : '');

            getDateSetup();

            $ctrl.maxDate = $ctrl.MomentService.getUtcDateNowNextYear();
            $ctrl.todayDate = $ctrl.MomentService.getUtcDateNow();

            var eClassAttr = getEClassAttr();

            return {
                multiDiv: [
                    _.extend({
                        formGroupClass:'with-padding-right input-group col180 with-padding-right ',
                        type: $ctrl.SBFieldTypesService.PropTypes.Date,
                        prop: d,
                        tabIndex: 2,
                        tabNextIndex: 3,
                        placeholder: 'Date',
                        eClassAttr: eClassAttr,
                        hasRemove: true,
                        enableTime: false,
                        dateFormat: 'ddd, MMM D, YYYY',//from moment
                        canEdit: true,
                        parentContainer:'.modal-dialog .modal-content',
                        // minDate: "::$ctrl.todayDate",
                        maxDate: "::$ctrl.maxDate",
                        defaultDate: "::$ctrl.todayDate",
                        withLabel: name + ' Date',
                        icon: 'date',
                        iconLevel: 6
                    }, otherProps),
                    _.extend({
                        formGroupClass:'input-group col100 with-padding-left ',
                        type: $ctrl.SBFieldTypesService.PropTypes.Time,
                        placeholder: 'Time',
                        prop: t,
                        tabIndex: 3,
                        tabNextIndex: 4,
                        eClassAttr: eClassAttr,
                        hasRemove: true,
                        parentContainer: true,
                        canEdit: true,

                        timeFormat: $ctrl.CPS.timeFormat,
                        withLabel: name + ' Time',
                        icon:'clock'
                    }, otherProps)
                ],
                formGroupClass: 'form-group field table-div full-width'
            }

            function getDateSetup(){

                if(!$ctrl.editableItemProps){$ctrl.editableItemProps = [];}
                if(_.find($ctrl.editableItemProps, d) === undefined){
                    $ctrl.editableItemProps.push(d);
                }
                if(_.find($ctrl.editableItemProps, t) === undefined){
                    $ctrl.editableItemProps.push(t);
                }

                if(!$ctrl.getOtherFormParams) {
                    $ctrl.getOtherFormParams = {};
                }

                $ctrl.getOtherFormParams[dateProp] = function (result){
                    //console.log('getOtherFormParams');
                    return onChangeDate(result, dateProp, withDateProp);
                }

                if(!$ctrl.item[d]){
                    $ctrl.item[d] = $ctrl.MomentService.getUtcMomentFromDateMoment($ctrl.MomentService.getUtcDateNow(), $ctrl.CPS.startTime);
                }
                if(!$ctrl.item[t]){
                    $ctrl.item[t] = $ctrl.MomentService.getUtcMomentFromTimeMoment($ctrl.item[d], $ctrl.CPS.startTime);
                }

                function onChangeDate(result, dateProp, withDateProp) {
                    var prop = result && result.prop ? result.prop : null;
                    var d = 'date' + (withDateProp ? dateProp : ''),
                        t = 'time' + (withDateProp ? dateProp : '');
                    //console.log('onChangeOther: ' + prop);
                    if (prop === d || prop === t) {
                        $ctrl.item[dateProp] = prop === d ?
                            $ctrl.MomentService.getUtcMomentFromDateMoment(result.selected.val, $ctrl.item[t]) :
                            $ctrl.MomentService.getUtcMomentFromDateMoment($ctrl.item[d], result.selected.val);
                    }
                }
            }
        }

        function getColumnColor(){
            return _.extend({
                type: $ctrl.SBFieldTypesService.PropTypes.Color,
                    prop: 'color',
                tabIndex: 1,
                tabNextIndex: 2,
                initListName: 'Colors',
                withUncheck: $ctrl.withUncheck,
                formGroupClass: 'col40 vbottom',
                //square: true,
                withoutLabelInPopup: true
            }, $ctrl.otherColumnColorProps);
        }

        function getColumnsColor(isLast, field, other){
            var m = other && other.withoutColor ? [] : [$ctrl.getColumnColor()];

            if(other){
                if(other.length > 0) {
                    m = m.concat(other);
                }else{
                    m.push(other);
                }
            }

            m.push(field ? field : getNameColumn(other));

            return {
                formGroupClass: 'form-group table-div full-width margin-half-top' + (isLast ? ' last' : ''),
                multiDiv: m
            };
        }

        function getNameColumn(other, props){
            return  _.extend({
                type: $ctrl.SBFieldTypesService.PropTypes.Field,
                prop: 'name',
                tabIndex: other ? 2 : 1,
                placeholder: $ctrl.itemTitle + ' name…',
                name: 'Name',
                isRequired: true,
                formGroupClass:  'thin with-padding-right',
                withoutLabelInPopup: true
            }, props);
        }

        function setColorSettings(){
            if($ctrl.withUncheck === undefined) {
                $ctrl.withUncheck = true;
            }
            if(!$ctrl.Colors) {
                $ctrl.Colors = $ctrl.SBFieldMethods.Colors;
            }
            if(!$ctrl.Settings) {
                $ctrl.Settings = {};
            }
            if(!$ctrl.Settings.Colors) {
                $ctrl.Settings.Colors = $ctrl.Colors;
            }
        }

        function setColorWithVersionAndDesc(withVersion, withoutColor){
            if($ctrl.notesProp === undefined){
                $ctrl.notesProp = 'description';
            }

            if($ctrl.versionProp === undefined){
                $ctrl.versionProp = 'version';
            }
            $ctrl.setColorColumns($ctrl.notesProp, false, null,
                withVersion ? $ctrl.getVersionColumn(withoutColor) : null
            );
        }

        function setColorColumns(notesProp, notLast, field, other) {
            $ctrl.setColorSettings();
            if(!$ctrl.columnsList){
                $ctrl.columnsList = [];
            }
            $ctrl.columnsList.push($ctrl.getColumnsColor(notLast ? false : (notesProp ? false : true), field, other));

            if(notesProp){
                $ctrl.columnsList.push($ctrl.getNotesColumn(notesProp));
            }
        }

        function getVersionColumn(withoutColor){
            return {
                type: $ctrl.SBFieldTypesService.PropTypes.Number,
                prop: $ctrl.versionProp,
                tabIndex: 1,
                placeholder: '#',
                formGroupClass: 'col40 thin with-padding-right',
                withoutLabelInPopup: true,
                eClassAttr: 'text-center ' + getEClassAttr(),
                otherClass: 'versionnumber',
                withoutColor: withoutColor
            }
        }
        function getNotesColumn(notesProp){
            return {
                name: 'Notes',
                prop: notesProp,
                type: $ctrl.SBFieldTypesService.PropTypes.Html,
                colCls: ' note-col',
                canHide: true,
                order: 7,
                canEdit: true,
                canSort: true,
                placeholder: 'Enter notes…',
                buttonsType: 1,
                withEllipsis: true,
                withBottomToolbar: true,
                icon: 'notes',
                iconLevel: 3,
                tabIndex: 2
            }
        }

        function getCondBlock(prop, txt, cols, cond, isLast, withoutCheck) {
            return getRowCheck(prop, txt, isLast) +
                '<div ng-if="$ctrl.item.' + prop + '"' + (isLast ? '' : ' class="margin-bottom"') + '>' +
                cols.map(function (index) {
                    return $ctrl.getDrpRow(index, 'margin-bottom-quarter', cond);
                }).join('') +
                '</div>';
        }

        function getDrpRow(index, cls, cond){
        return '<div class="form-group ' + (cls ? cls : '') + '"' +
                    (cond? (' ng-if="' + cond + '"') : '')+
                '>' +
                    '<div class="table-div full-width">' +
                        '<div class="thin padding-right10">' +
                            $ctrl.getPopupFormForSelectedCol($ctrl.columnsList[index]) +
                        '</div>' +
                    '</div>' +
                '</div>';
        }

        function getRowCheck(prop, txt, isLast){
        return '<div class="form-group field'+ (isLast ? ' last' : '') + '" ng-class="{\'margin-bottom-quarter\':$ctrl.item.'+prop+'}">' +
                    '<div class="custom-checkbox small with-label with-padding-right '+ getPageClass() +'"><label>' +
                        '<input type="checkbox" ng-checked="$ctrl.item.'+prop+'===true" ng-model="$ctrl.item.'+prop+'">' +
                        '<span><span>'+txt+'</span></span>' +
                    '</label></div>' +
                '</div>';
        }
    }
}

angular.module('ctrl.PopupsCtrl.merge.controller.service', [
    'ctrl.PopupsCtrl.generalItemEdit.service'
])
.service('MergeItemsCtrlService', MergeItemsCtrlService);
MergeItemsCtrlService.$inject = ['GeneralItemEditCtrlService'];
function MergeItemsCtrlService(GeneralItemEditCtrlService) {
    return function ($ctrl, $element, isPopup) {
        $ctrl.preInitGeneral = preInitGeneral;
        $ctrl.postInitGeneral = postInitGeneral;
        $ctrl.preSetTemplateData = preSetTemplateData;

        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, isPopup);

        return $ctrl;

        function preInitGeneral() {
            //$ctrl.startsFilled = true;

            $ctrl.item.selected = $ctrl.extraParam.selected;
            $ctrl.count = $ctrl.extraParam.selected ? $ctrl.extraParam.selected.length : 0;
            $ctrl.item[$ctrl.listField] = $ctrl.extraParam.currentListId;
            $ctrl.currentListId = $ctrl.extraParam.currentListId;

            if (typeof ($ctrl.preInitMerge) === 'function') {
                $ctrl.preInitMerge();
            }
        }

        function postInitGeneral(){
            $ctrl.onSave = onSave;
        }

        function preSetTemplateData() {
            $ctrl.icon = 'merge';
            $ctrl.btnText = '<span>Merge</span><span class="hide-ipad"> ' + $ctrl.count + ' ' + $ctrl.name + '</span>';
        }

        function onSave(result) {
            console.log('MergeItemsCtrlService:onSave');
            $ctrl.isUpdating = false;
            if(!result){return;}
            result.processMultiple = true;
            result.type = $ctrl.type;

            var id = $ctrl.elemType + '_' + $ctrl.currentListId;
            $ctrl.broadcastRoot('ADDED_MULTIPLE_' + id, result);
            $ctrl.broadcastRoot('MERGED_SELECTED_' + id, result);

            $ctrl.onClean();
        }
    }
}

angular.module('ctrl.PopupsCtrl.service.viewNotesPopup.component', [
    'product.contentEditorBubblePopup.controller.service'
])
    //for the notes filed on various groups
.component('viewNotesPopup', popupComponentParams('ViewNotesPopupCtrl'))
.controller('ViewNotesPopupCtrl', ViewNotesPopupCtrl);
ViewNotesPopupCtrl.$inject = ['ContentEditorBubbleCtrlService', '$element'];
function ViewNotesPopupCtrl(ContentEditorBubbleCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;
    $ctrl.hideTitle = true;
    $ctrl.withMarginBottomForSubtitle = true;

    $ctrl.onAdditionalInit = onAdditionalInit;

    $ctrl = new ContentEditorBubbleCtrlService($ctrl, $element, $ctrl.isPopup);

    function onAdditionalInit(){
        $ctrl.itemName = $ctrl.LCS.convertHtmlToText($ctrl.itemName);
        $ctrl.field = $ctrl.extraParam.field;
        $ctrl.customTitle = 'Notes for ' + $ctrl.itemName;
        $ctrl.subtitle = $ctrl.extraParam.subtitle;
        $ctrl.contentEditorCls = 'withborderbottom';
        $ctrl.withoutCustomOnSave = true;
    }
}


function getBasePopupTemplateByTag(tag, withoutCompOptions, cls, noTagAddon) {
    tag = tag + (noTagAddon?'':'-popup');
    return '<' + tag + ' ' +
        'modal-id="::$ctrl.modalId" ' +
        'item="::$ctrl.item" ' +
        'type="::$ctrl.type" ' +
        'extra-param="::$ctrl.extraParam" ' +
        (withoutCompOptions ? '' : 'comp-options="::$ctrl.compOptions" ') +
        'on-close="$ctrl.close(result, $ctrl.modalId)"' +
        'class="clearfix ' + tag + (cls ? (' ' + cls) : '') + '" ' +
        '></' + tag + '>';
}

