angular.module('components.featureFeedPost.directive', [
    'components.feed.sidebarFeed.model',
    'services.blocksSetupEvents'
])
.component('featureFeedPost',  {
    controller: 'FeatureFeedPostCtrl',
})
.controller('FeatureFeedPostCtrl', FeatureFeedPostCtrl);
FeatureFeedPostCtrl.$inject = ['TemplateCompileCompCtrlService', 'BlocksSetupEventsService', 'SidebarFeedModel', '$element'];
function FeatureFeedPostCtrl(TemplateCompileCompCtrlService, BlocksSetupEventsService, SidebarFeedModel, $element) {
    //console.log('FeatureFeedPostCtrl');
    var selectedIndex = -1;

    var $ctrl = this;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInit = preInit;
    $ctrl.postInit = postInit;
    $ctrl.onLoaded = onLoaded;

    $ctrl.selectItem = selectItem;
    $ctrl.isSelected = isSelected;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

     function preInit() {
         $ctrl.entries = null;
         $ctrl.title = 'Latest Posts';
         $ctrl = $.extend($ctrl, new SidebarFeedModel(new ObjectId().toString(), [
             {category: 'posts', title: 'Resources'},
         ], $ctrl.onLoaded));
     }

    function postInit() {
        $ctrl.loadSources();
    }

     function selectItem(i) {
        selectedIndex = i;
        var l = $ctrl.entries ? $ctrl.entries.length : 0;
        if (!l) {
            $ctrl.item = null;
            selectedIndex = -1;
            return;
        }
        if (selectedIndex >= l || selectedIndex < 0) {
            selectedIndex = 0;
        }
        $ctrl.item = $ctrl.entries[selectedIndex];
    }

     function isSelected(i) {
        return selectedIndex === i;
    }

    function getItemTemplate() {
        if(!$ctrl.isLoaded){return '<preloader-center class="preloader"></preloader-center>';}
        if(!$ctrl.entries){return '';}
        var list = $ctrl.entries.map(function (item, i) {
            return '<li><button ng-class="{\'with-primary-bg-before\':$ctrl.isSelected('+i+')}" ng-click=\'$ctrl.selectItem('+i+')\'></button></li>';
        }).join('');
        return '<div class="feed-entries">' +
            '<div class="table-div full-width spacing-half-bottom">' +
                '<div class="type text-left">'+$ctrl.title+'</div>' +
                '<ul class="progressdots">' + list + '</ul>' +
            '</div>' +
            '<tutorial-post ng-if="$ctrl.item" item="$ctrl.item" feed-id="::$ctrl.feedId" type="feature" on-open="$ctrl.open(feedId, item)"></tutorial-post>' +
        '</div>';
    }

    function onLoaded($ctrl) {
        //console.log('onLoaded');
        if(!$ctrl){return;}
        var feed = $ctrl.feeds && $ctrl.feeds.length > 0 ? $ctrl.feeds[0] : null,
            entries = feed ? feed.entries : null,
            l = entries && entries.length ? entries.length : 0;
        $ctrl.feedId = feed?feed.id:null;
        $ctrl.entries = l > 0 ? entries : null;
        $ctrl.selectItem($ctrl.getRandomIndex(l));
        $ctrl.reloadTemplate();
    }
}


var RandomNumber = (function () {
    function Random(Seed) {
        if (!Seed) {
            Seed = this.milliseconds();
        }
        this.SeedArray = [];
        for (var i = 0; i < 56; i++)
            this.SeedArray.push(0);
        var num = (Seed == -2147483648) ? 2147483647 : Math.abs(Seed);
        var num2 = 161803398 - num;
        this.SeedArray[55] = num2;
        var num3 = 1;
        for (var i_1 = 1; i_1 < 55; i_1++) {
            var num4 = 21 * i_1 % 55;
            this.SeedArray[num4] = num3;
            num3 = num2 - num3;
            if (num3 < 0) {
                num3 += 2147483647;
            }
            num2 = this.SeedArray[num4];
        }
        for (var j = 1; j < 5; j++) {
            for (var k = 1; k < 56; k++) {
                this.SeedArray[k] -= this.SeedArray[1 + (k + 30) % 55];
                if (this.SeedArray[k] < 0) {
                    this.SeedArray[k] += 2147483647;
                }
            }
        }
        this.inext = 0;
        this.inextp = 21;
        Seed = 1;
    }
    Random.prototype.milliseconds = function () {
        var str = new Date().valueOf().toString();
        return parseInt(str.substr(str.length - 6), 10);
    };
    Random.prototype.InternalSample = function () {
        var num = this.inext;
        var num2 = this.inextp;
        if (++num >= 56) {
            num = 1;
        }
        if (++num2 >= 56) {
            num2 = 1;
        }
        var num3 = this.SeedArray[num] - this.SeedArray[num2];
        if (num3 == 2147483647) {
            num3--;
        }
        if (num3 < 0) {
            num3 += 2147483647;
        }
        this.SeedArray[num] = num3;
        this.inext = num;
        this.inextp = num2;
        return num3;
    };
    Random.prototype.Sample = function () {
        return this.InternalSample() * 4.6566128752457969E-10;
    };
    Random.prototype.GetSampleForLargeRange = function () {
        var num = this.InternalSample();
        var flag = this.InternalSample() % 2 == 0;
        if (flag) {
            num = -num;
        }
        var num2 = num;
        num2 += 2147483646.0;
        return num2 / 4294967293.0;
    };
    Random.prototype.Next = function (minValue, maxValue) {
        if (!minValue && !maxValue)
            return this.InternalSample();
        var num = maxValue - minValue;
        if (num <= 2147483647) {
            return parseInt((this.Sample() * num + minValue).toFixed(0));
        }
        return this.GetSampleForLargeRange() * num + minValue;
    };
    Random.prototype.NextDouble = function () {
        return this.Sample();
    };
    Random.prototype.NextBytes = function (buffer) {
        for (var i = 0; i < buffer.length; i++) {
            buffer[i] = this.InternalSample() % 256;
        }
    };
    return Random;
}());

angular.module('components.feedList.service', [
    'services.sbHttp',
    'services.layoutConfigsService',
    'components.feedListEvents.service'
])
    .service('FeedListService', FeedListService);
FeedListService.$inject = ['SbHttpService', 'LCS', 'FeedListEventsService'];
function FeedListService(SbHttpService, LCS, FeedListEventsService) {
    var postfix = LCS.timestamp,//+'&feed=json';
        defaultSources = [
            {category: 'announcements', title: 'Announcements'},
            {category: 'featured', title: 'Product Updates'},
           // {category: 'posts', title: 'Resources'},
        ],
        r = new RandomNumber();

    var _this = this;
    _this.defaultSources = defaultSources;
    _this.onNewsFeedItemCountChanged = FeedListEventsService.onNewsFeedItemCountChanged;
    _this.onLoad = FeedListEventsService.onLoad;

    _this.get = function get(dirid, sources) {
        var tasks = [], count= 0;
        for(var feedId in sources){
            count ++;
            tasks.push(getFeed(feedId));
        }
        if(count>0){
            async.parallel(tasks, function(err, result){
                if(err){
                    console.log('feed list error');
                    console.log(err);
                }
                    console.log('feed async.parallel finished');
            });
        }

        function getFeed(feedId){
            return function (c) {
                var time = _this.getFeedTime(feedId);
                if(!time || moment().diff(moment(time,'MM/DD/YYYY'), 'days') > 2){
                    LCS.PersistenceService.remove('feed' + feedId);
                    _this.loadFeed(sources, feedId, function () {
                        onComplete(feedId, c);
                    });
                }else{
                    onComplete(feedId, c);
                }
            }

            function onComplete(feedId, c){
                var feed = _this.getFeed(feedId);
                if(feed){
                    FeedListEventsService.emitLoad(dirid, feed);
                }
                return c();
            }
        }
    }

    _this.loadFeed = function loadFeed(sources, id, onComplete) {
            var feed = sources[id];

            try {
                SbHttpService.axiosGet(feed.url, {}, processXml, onError);
            }
            catch (e) {
                console.log(e);
            }

            function onError(err) {
                console.log('Error in fetching the website');
                console.log(err);
            }

            function processXml(htmlTxt) {
                //console.log('FeedListService success');
                if (!htmlTxt) {
                    return onComplete(id);
                }

                var domParser = new DOMParser(),
                    doc = domParser.parseFromString(htmlTxt, 'text/html'),
                    channel = doc.querySelector('channel');

                var date = channel.querySelector('lastBuildDate'), newFeed;
                if (date) {
                    date = date.textContent ? date.textContent.trim() : date;
                    var oldDate = getFeedProp('date');
                    if (!oldDate || oldDate && new Date(date) > new Date(oldDate)) {
                        newFeed = true;
                        setFeedProp('date', date);
                    }
                }

                if (newFeed) {
                    processNewFeed();
                }

                onComplete(id);

                function processNewFeed() {
                    var oldEntries = getFeedProp('entries');
                    var entries = [], hasEntries;
                    var items = doc.querySelectorAll('item');
                    for (var j = 0, n = items.length; j < n; j++) {
                        processItem(entries, oldEntries, items[j]);
                    }

                    _this.setEntriesProp(sources, id, entries);

                    function processItem(entries, oldEntries, item) {
                        if (!item) {
                            return;
                        }
                        var entry = {};
                        processProp('app_title', 'title');
                        if (!entry.title) {
                            processProp('title');
                        }

                        processProp('linkurl');
                        processProp('imagelarge');
                        processProp('description');

                        if (entry.description) {
                            entry.description = entry.description.replace(']]>', '');
                        }

                        processProp('guid');
                        entry.id = entry.guid.replace('https://www.studiobinder.com/?p=', '');
                        delete entry.guid;

                        processProp('pubDate');

                        //processProp('summary', 'description');

                        var prop = item.querySelector('description');

                        if (prop) {
                            var div = angular.element('<div>' + prop.innerHTML + '</div>'), children = div.children();
                            var ank = children[0];
                            if (ank && ank.src) {
                                entry.image = ank.src;
                            }
                        }

                        if (oldEntries) {
                            var oldEntry = _.find(oldEntries, function (item) {
                                return item.id === entry.id;
                            });
                            if (oldEntry && oldEntry.open) {
                                entry.open = true;
                            }
                        }

                        entries.push(entry);

                        function processProp(el, name) {
                            var prop = item.querySelector(el);
                            if (prop) {
                                entry[name ? name : el] = prop.textContent.trim();
                            }
                        }
                    }
                }
            }

            function setFeedProp(prop, val) {
                _this.setFeedPropById(sources, id, prop, val);
            }

            function getFeedProp(prop) {
                return _this.getFeedPropById(id, prop);
            }
        }

    _this.open = function open(sources, feedId, item) {
        var entries = _this.getFeedPropById(feedId, 'entries');
        _.find(entries, function (entry) {
            if (item.id === entry.id) {
                entry.open = true;
            }
        });

        _this.setEntriesProp(sources, feedId, entries);
    }

    _this.getUnopened = function getUnopened(sources) {
        var count = _this._getUnopened(sources);
        _this.setNewFeedItemsCount(count);
        if (count > 0 && !LCS.getSetting('newsFeed')) {
          //dont auto open
           // LCS.setSetting('newsFeed', true);
        }
    }

    _this.getSources = function getSources(s) {
        var sources = {}, order;
        if (!s) {
            s = defaultSources
        }
        for (var i = 0, n = s.length; i < n; i++) {
            var el = s[i];
            addCategory(el.category, el.title);
        }
        return sources;

        function addCategory(category, title) {
            sources[category] = _.extend(_this.getCategoryPosts(category, title), {order: order ? (++order) : 1});
        }
    }

    _this.getCategoryPosts = function getCategoryPosts(category, title) {
        return {
            title: title,
            url: 'https://www.studiobinder.com/' + (category === 'posts' ? '' : ('tag/' + category + '/')) + 'feed/' + postfix,
            count: category === 'posts' ? 3 : 100
        };
    }

    _this.getRandomNumber = function getRandomNumber(l) {
        return r.Next(0, l); //returns an integer between range
    }

    _this.setEntriesProp = function setEntriesProp(sources, feedId, entries) {
        _this.setFeedPropById(sources, feedId, 'entries', entries.length > 0 ? entries : null);
        _this.setFeedPropById(sources, feedId, 'unopened', entries.length ? _.filter(entries, function (el) {
            return !el.open;
        }).length : 0);
    }

    //private
    _this.setFeedPropById = function setFeedPropById(sources, feedId, prop, val) {
        var feed = _this.getFeed(feedId);
        if (!feed) {
            feed = {};
            var sf = sources[feedId];
            feed = {id: feedId, title: sf.title, order: sf.order};
        }
        feed[prop] = val;
        _this.setFeed(feedId, feed);
    }

    _this.setNewFeedItemsCount = function setNewFeedItemsCount(val) {
        if (val !== _this.newFeedItemsCount) {
            _this.newFeedItemsCount = val;
            FeedListEventsService.emitNewsFeedItemsCountChanged(val);
        }
    }

    //private
    _this.getFeedPropById = function getFeedPropById(feedId, prop) {
        var feed = _this.getFeed(feedId);
        return feed ? feed[prop] : null;
    }

    //private
    _this._getUnopened = function _getUnopened(sources) {
        var count = 0;
        for (var feedId in sources) {
            var nc = _this.getFeedPropById(feedId, 'unopened');
            if (nc && nc > 0) {
                count += nc;
            }
        }
        return count;
    }
    //private
    _this.getFeed = function getFeed(feedId) {
        var feed = LCS.PersistenceService.get('feed' + feedId);
        return feed && feed.val ? feed.val : null;
    }

    _this.getFeedTime = function getFeedTime(feedId) {
        var feed = LCS.PersistenceService.get('feed' + feedId);
        return feed && feed.time ? feed.time : null;
    }

    //private
    _this.setFeed = function setFeed(feedId, val) {
        return LCS.PersistenceService.set('feed' + feedId, {
            time:  moment().format('MM/DD/YYYY'),
            val: val
        });
    }

}


angular.module('components.feedListEvents.service', [
])
.service('FeedListEventsService', FeedListEventsService);
FeedListEventsService.$inject = ['RootEventsService'];
function FeedListEventsService(RootEventsService) {
    var _this = this;

    _this.emitNewsFeedItemsCountChanged = function emitNewsFeedItemsCount(val) {
        RootEventsService.broadcastRoot('NEWSFEED_ITEMS_CONT_CHANGED', val);
    }

    _this.onNewsFeedItemCountChanged = function onNewsFeedItemCountChanged(method) {
        return RootEventsService.onDefaultEmitted('NEWSFEED_ITEMS_CONT_CHANGED', method);
    }

    _this.emitLoad = function emitLoad(id, val) {
        RootEventsService.broadcastRoot(_this.getFId(id), val);
    }

    _this.onLoad = function (id, method){
        return RootEventsService.onDefaultEmitted(_this.getFId(id), method);
    }

    _this.getFId = function getFId(id) {
        return 'FeedList_' + id;
    }

    return _this;
}

