//https://github.com/quilljs/quill/pull/2095/commits/95bf0634a769a41e928f26d362b0399ef9a46710
//https://github.com/quilljs/quill/pull/1049
//https://lingceng.github.io/blog/2018/03/28/custom-quill-dot-js-to-add-more-attributes-to-image/
//https://codepen.io/username8978/pen/jwgebb
//https://stackoverflow.com/questions/45359148/overlapping-inline-annotations-with-quill
//https://codepen.io/sainttushar/pen/yKLdOe
//https://embed.plnkr.co/GqPEPNGVsBSat9tklWpx/
//table: https://github.com/dost/quilljs-table/tree/master/quilljs-source-code
/*
Key	Action
Cmd+Z	Undo
Cmd+Y	Redo
Cmd+F	Search for text

Cmd+B	Bold
Cmd+I	Italic
Cmd+U	Underline
Cmd+E	Highlight
Cmd+L	Color

Cmd+Option+X	Strikethrough
Cmd+Shift+K	Insert hyperlink

Cmd+A	Select all
Cmd+P	Print

Option+C	Change line type to Character
Option+D	Change line type to Dialogue
Option+P	Change line type to Parens
Option+A	Change line type to Action
Option+S	Change line type to Scene
Option+H	Change line type to Audio
Option+T	Change line type to Transition
Option+X	Change line type to Text
Option+O	Change line type to Note
Option+V	Change line type to New Act/End Act/Lyrics
*/
/*
Rules

Action
    - Empty  - change type for same line
    - [Tab] Character
    - [Enter] Select Element (open drp ParTypes)
    - [Space] nothing
    - [Backspace] go to prev line
    - [Cmd][0] …
 -  Not Empty - add new line of type
    - [Tab] Action
    - [Enter] Action
    - [Cmd][0] …

Character
- Empty  - change type for same line
    - [Tab] Transition
    - [Enter] Select Element (open drp ParTypes)
    - [Space] (open drp CharAppend)
    - [Cmd][0] …

 -  Not Empty - add new line of type
    - [Tab] Parenthethical
    - [Enter] Dialogue
    - [Space]  default behavior
    - [Cmd][0] …

Parenthethical
- Empty  - change type for same line
    - [Tab] Dialogue
    - [Enter] Select Element (open drp ParTypes)
    - [Space] nothing
    - [Cmd][0] …

 -  Not Empty - add new line of type
    - [Tab] Dialogue
    - [Enter] Dialogue
    - [Space]  default behavior
    - [Cmd][0] …

Dialogue
- Empty - change type for same line
    - [Tab] Parenthethical
    - [Enter] Select Element (open drp ParTypes)
    - [Space] nothing
    - [Cmd][0] …

 -  Not Empty - add new line of type
    - [Tab] Parenthethical
    - [Enter] Action
    - [Space]  default behavior
    - [Cmd][0] …

Transition
- Empty - change type for same line
    - [Tab] Scene Heading
    - [Enter] Select Element (open drp ParTypes)
    - [Space]  (open drp Transitions)
    - [Cmd][0] …

 -  Not Empty - add new line of type
    - [Tab] Scene Heading
    - [Enter] Scene Heading
    - [Space]  default behavior
    - [Cmd][0] …
*/
/*// Cache: Our client rects are kept here, we can use this to clear them later.
var elemsWithBoundingRects = [];

window.sbGetBoundingClientRect = function( element ) {
    // Check if we already got the client rect before.
    if (!element._boundingClientRect) {
        //If not, get it then store it for future use.
        element._boundingClientRect = element.getBoundingClientRect();
        elemsWithBoundingRects.push( element );
    }
    return element._boundingClientRect;
};
var sbClearClientRects = function() {
    for (var i = 0, n=elemsWithBoundingRects.length; i < n; i++) {
        if (elemsWithBoundingRects[i]) {
            elemsWithBoundingRects[i]._boundingClientRect = null;
        }
    }
    elemsWithBoundingRects = [];
};
*/

angular.module('sb.fields.html.component', [
    'sb.fields.html.controller.service'
])
.component('sbHtml', sbFieldComponentParams('SbHtmlCtrl',{
    withBottomToolbar: '@',
    withNoToolbar: '@',
    withScriptFormat: '@',
    editorType: '@',
    buttonsType: '@',
    autofocus: '@',
    withVideo: '@',
    withSave: '@',
    withCancel: '@',
    wordCountProp: '@',
    saveOnKeydown: '@',
    saveOnEnter: '@',
    withFullHeight: '@',
    onItemUpdate: '&',
    focusOffset: '@'
}))
.controller('SbHtmlCtrl', SbHtmlCtrl);
SbHtmlCtrl.$inject = ['SbContentEditableCtrlService', '$element', '$attrs'];
function SbHtmlCtrl(SbContentEditableCtrlService, $element, $attrs) {
    var $ctrl = this;
    $ctrl.propType = 'Html';
    $ctrl = new SbContentEditableCtrlService($ctrl, $element, $attrs);
}

angular.module('sb.fields.html.controller.service', [
    'sb.fields.input.controller.service'
])
.service('SbContentEditableCtrlService', SbContentEditableCtrlService);
SbContentEditableCtrlService.$inject = ['SBInputFieldCtrlService', 'SBFieldTypesService'];
function SbContentEditableCtrlService(SBInputFieldCtrlService, SBFieldTypesService) {
    return function($ctrl, $element, $attrs, withoutTemplateScope){
        var Delta = Quill.import('delta');
        var deltaChanges = new Delta(), tempHtml;
        $ctrl.tempWordcount = 0;

        $ctrl.withoutPasteEvent = true; // trigger event from editor
        $ctrl.fieldSelector = '.ql-editor';
        $ctrl.toolbarWrapperClass = 'editortoolbar';
        $ctrl.propType = SBFieldTypesService.PropTypes['Html'];

        $ctrl.withCustomLoading = true;//to postpone init
        $ctrl.withBottomToolbar = true;
        $ctrl.withPredefEvents = true;

        if(!($ctrl.saveOnEnter === 'true' || $ctrl.saveOnEnter === true)) {
            $ctrl.disableEnterKey = true;
            $ctrl.saveOmCmdS = true;
            $ctrl.disableTabKey = true;
        }

        $ctrl.getItemTemplate = getItemTemplate;
        $ctrl.onContentChanged = onContentChanged;
        $ctrl.getInputValue = getInputValue;
        $ctrl.setDisplayValue = setDisplayValue;
        $ctrl.onEditorCreated = onEditorCreated;
        $ctrl.onCancel1 = onCancel1;
        $ctrl.onSave = onSave;
        $ctrl.onFieldBlur = onFieldBlur;
        $ctrl.onFieldFocus = onFieldFocus;
        $ctrl.onItemLoaded = onItemLoaded;
        $ctrl.$onDestroy = $onDestroy;
        $ctrl.onBodyClickOther = onBodyClickOther;
        $ctrl.setUpdatePropValue = setUpdatePropValue;

        $ctrl = new SBInputFieldCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

        function setUpdatePropValue(item) {
            item[$ctrl.prop] = angular.copy($ctrl.value);
            if($ctrl.wordCountProp){
                item[$ctrl.wordCountProp] = $ctrl.tempWordcount;
            }
        }
        function $onDestroy() {
            bind(false);
            $ctrl.onSBFieldDestroy();
        }

        function onItemLoaded(){
            bind(true);
        }

        function bind(isBind) {
            //is in popup
            var popup = $ctrl.LCS.findClosestParent($ctrl.element, '.modal-dialog');
            $ctrl.LCS.bindElementsClick(isBind, popup ? popup : $ctrl.LCS.bodyElement, onClick, 'lastClicked_'+$ctrl.elementId);
        }

        function onClick(e){
            //console.log('SbContentEditableCtrlService.lastClicked');
            $ctrl.LCS.lastElementClicked = e.target;
            if($ctrl.onBodyClickOther){
                $ctrl.onBodyClickOther();
            }
        }

        return $ctrl;

        function getItemTemplate() {
            //console.log('SbContentEditableCtrlService.getItemTemplate');
            tempHtml = $ctrl.value;
            $ctrl.withoutClose = $attrs.withoutClose === 'true' || $attrs.withoutClose === 'true';
            if(!$ctrl.editorType) {
                $ctrl.editorType = $attrs.isComplex ? 'bubble' : ('bubblesimple' + ($ctrl.withVideo ? 'video' : ''));
            }

            $ctrl.toolbarParentEl = $attrs.toolbarParentEl;

            var withNoToolbar = ($ctrl.withNoToolbar === true || $ctrl.withNoToolbar === 'true'),
                withFullHeight =$ctrl.withFullHeight === true || $ctrl.withFullHeight === 'true',
                withBottomToolbar = !withNoToolbar && ($ctrl.withBottomToolbar === true || $ctrl.withBottomToolbar === 'true');
            withBottomToolbar = !withNoToolbar && ($ctrl.withBottomToolbar === true || $ctrl.withBottomToolbar === 'true');
    // $attrs.eClassAttr ? $attrs.eClassAttr : null
            var cls = $ctrl.editorType === 'contactmessage' ? '' : ($ctrl.withoutClose && !withNoToolbar ? ' inline-editor ' : ' non-inline-editor ');
            return '<sb-editor ' +
                ($attrs.buttonsType ? ('buttons-type="' + $attrs.buttonsType + '" ') : '') +
                ($ctrl.editorType ? 'editor-type="' + $ctrl.editorType + '" ' : '') +
                (withNoToolbar? 'with-no-toolbar="true" ' : '') +
                ($ctrl.saveOnEnter ? 'save-on-enter="true" ' : '') +
                ($ctrl.withScriptFormat? 'with-script-format="true" ' : '') +
                (withBottomToolbar ? 'with-bottom-toolbar="true" ' : '') +
                ($ctrl.withSave ? 'with-save="true" ' : '') +
                ($ctrl.withCancel ? 'with-cancel="true" ' : '') +
                ($ctrl.focusOffset ? 'focus-offset="'+$ctrl.focusOffset+'" ' : '') +
                (withFullHeight ? 'with-full-height="true" ' : '') +
                ($ctrl.toolbarParentEl ? ('toolbar-parent-el="' + $ctrl.toolbarParentEl + '" ') : '') +

                ($ctrl.withScrollbar ? ('with-scrollbar="true"') : '') +
                 'class="sb-html ' + cls + '" ' +

                'content="::$ctrl.value" ' +
                'on-editor-created="$ctrl.onEditorCreated(editor)" ' +
                'on-content-changed="$ctrl.onContentChanged(editor, html, text, content, delta, oldDelta, source)" ' +
                //hide save  and cancel buttons
                //($ctrl.withoutClose ? '' : ('with-save="true" ' +'with-cancel="true" ')) +
                'on-cancel="$ctrl.onCancel1()" ' +
                'on-save="$ctrl.onSave(result)" ' +
                ($ctrl.canEdit ? (($ctrl.autofocus === 'true' || $ctrl.autofocus === true) ? 'autofocus="true" ' : '') : 'read-only="true" ') +
                '{{props}}></sb-editor>';
        }

        function onCancel1() {
            console.log('onCancel the editor');//close without save
            $ctrl.close();
            // tempHtml = $ctrl.prevValue;
            // save();
        }

        function onFieldBlur(e) {
            //console.log('SbContentEditableCtrlService.onFieldBlur');
            if($ctrl.withSave === 'true' || $ctrl.withSave){
                return;
            }
            var editor = $ctrl.element.querySelector('.sb-editor');
            if(!editor){
                return;
            }

            var isUploadEvent = editor.getAttribute('isUploadEvent') === 'true',
                relatedTarget = e ? e.relatedTarget : null;
            if(relatedTarget) {
                if ($ctrl.LCS.hasClass(relatedTarget, 'ql-clipboard')) {
                    $ctrl.isPasteEvent = true;
                } else if ($ctrl.LCS.hasClass(relatedTarget, 'ql-image')) {
                    editor.setAttribute('isUploadEvent', 'true');
                    isUploadEvent = true;
                }
            }

            if($ctrl.isPasteEvent || isUploadEvent){return;}

            //if a button on toolbar is pressed don't close the field
            if(relatedTarget){
                var t =  $ctrl.LCS.findClosestParent(relatedTarget, '.ql-toolbar'),
                    q = $ctrl.LCS.findClosestParent(t, '.sb-editor');
                if(t && q && editor.id !== q.id) {
                    return;
                }
            }

            if($ctrl.withoutClose){
                save(e);
            }else{
                $ctrl.LCS.timeout(function (){
                    if(!isInEl()){
                        save(e);
                    }
                }, 10);
            }
        }

        function save(e){
            setHtml(tempHtml);
            $ctrl.save(e, $ctrl.withoutClose ? false : true);
        }

        function onFieldFocus(e) {
            $ctrl.preventDefault(e);
           //console.log('onFieldFocus'); //dont save on blur
            //$ctrl.save(e, false);
            setInFocus(true);
        }

        function isInEl() {
            var cls = '.sb-html';
            return $ctrl.LCS.findClosestParent($ctrl.LCS.lastElementClicked, cls) === $ctrl.element.querySelector(cls);
        }

        function onBodyClickOther(){
            cancelFocus();
        }

        function cancelFocus(){
            //console.log('SbContentEditableCtrlService.cancelFocus');
            $ctrl.LCS.timeout(function () {//needs time to allow for on click
                if(!isInEl()) {
                    setInFocus(false);
                    $ctrl.onFieldBlur();
                }
            }, 10);
        }

        function setInFocus(isFocus) {
            //console.log('SbContentEditableCtrlService.setInFocus');
            if ($ctrl.withoutClose && $ctrl.LCS.hasClass($ctrl.element.parentElement, 'with-floating-toolbar')) {
                $ctrl.LCS[isFocus ? 'addClass' : 'removeClass']($ctrl.element.querySelector('.' + $ctrl.toolbarWrapperClass), 'infocus');
                $ctrl.isInFocus = isFocus;
            }
        }

        function onContentChanged(editor, html, text, content, delta, oldDelta, source) {
            //console.log('onContentChanged');
            if(editor.isPopupOpen){return;}
            deltaChanges = deltaChanges.compose(delta);
            if (tempHtml !== html) {
                setHtml(html);
                text =  text ? text.trim() : '';
                $ctrl.tempWordcount = text.length > 0 ? text.split(/\s+/).length : 0;

                if (editor.isPasteEvent) {
                    editor.isPasteEvent = false;
                    $ctrl.isPasteEvent = false;
                    $ctrl.onFieldBlur();
                }
                var result = {
                    result: {
                        prop: $ctrl.prop,
                        selected: {
                            field: $ctrl.prop,
                            val: tempHtml,
                            wordCount: $ctrl.tempWordcount
                        }
                    }
                };
                //avscripts update word count for audio
                if (($ctrl.saveOnKeydown === 'true' || $ctrl.saveOnKeydown === true) && $ctrl.wordCountProp && typeof ($ctrl.onItemUpdate) === 'function') {
                    $ctrl.onItemUpdate(result);
                }
            }
        }

        function getInputValue() {
            return tempHtml;
        }

        function setDisplayValue() {

        }

        function onEditorCreated() {
            //console.log('SbContentEditableCtrlService.onEditorCreated');
            $ctrl.withCustomLoading = false;
            $ctrl.onFieldTemplateLoaded();
            $ctrl.withCustomLoading = true;
        }

        function setHtml(v){
            //console.log('setHtml');
            tempHtml = v;
            if(tempHtml) {
                if(tempHtml.match(/<p><br><\/p>$/gi)){
                    tempHtml = tempHtml.replace(/<p><br><\/p>$/gi, '');
                }
                if ($ctrl.editorType === 'screenplay' && (tempHtml.toLowerCase() === '<p><br></p>' || tempHtml.toLowerCase() === '<p><br/></p>' || tempHtml.toLowerCase() === '</br>' || tempHtml.toLowerCase() === '<br>')) {
                    tempHtml = null;
                }
            }
        }

        function onSave(result) {
            //console.log('onSave');
            setHtml(result.html);
            $ctrl.save(null, true);
        }

        function toggleToolbar(show) {
            var toolbar = $ctrl.element.querySelector('.' + $ctrl.toolbarWrapperClass);
            if (toolbar) {
                $ctrl.LCS[show ? 'removeClass' : 'addClass'](toolbar, 'sb-hide');
            }
        }
    }
}

angular.module('sb.fields.inputInlinePopover.component', [
])
.component('sbInputInlinePopover', sbFieldComponentParams('SbInputInlinePopoverController',{}))
.controller('SbInputInlinePopoverController', SbInputInlinePopoverController);
SbInputInlinePopoverController.$inject =  ['SBInlinePopoverCtrlService', '$element', '$attrs'];
function SbInputInlinePopoverController(SBInlinePopoverCtrlService, $element, $attrs) {
    var $ctrl = this;
    $ctrl = new SBInlinePopoverCtrlService($ctrl, $element, $attrs);
}

 angular.module('sb.fields.locationInlinePopover.component', [
        'sb.fields.inputfield.service'

 ])
.component('sbLocationInlinePopover',  sbFieldComponentParams('SbLocationInlinePopoverController',{}))
.controller('SbLocationInlinePopoverController', SbLocationInlinePopoverController);
 SbLocationInlinePopoverController.$inject =  ['SBInlinePopoverCtrlService', '$element', '$attrs'];
function SbLocationInlinePopoverController(SBInlinePopoverCtrlService, $element, $attrs) {
    var $ctrl = this;
    $ctrl = new SBInlinePopoverCtrlService($ctrl, $element, $attrs);
    var lastVal;


    function getItemTemplate() {
        if (!$ctrl.inputType) {
            $ctrl.inputType = 'text';
        }
        if (!$ctrl.style) {
            $ctrl.style = {'min-height': '36px', 'padding-top': '9px'};
        }
        // Make a copy of the initial value to be able to reset it later
        lastVal = $ctrl.item;

        // Set a default fieldType
        if (!$ctrl.fieldType) {
            $ctrl.fieldType = 'text';
        }
        return '<input ' +
            'class="' +
            (  $ctrl.eClassAttr ? ($ctrl.eClassAttr + ' ') : '') +
            ($ctrl.fieldClass ? $ctrl.fieldClass : '') +
            '" ' +
            ($ctrl.placeholder ? (' placeholder="' + $ctrl.placeholder + '" ') : '') +
            ($ctrl.inputName ? (' name="' + $ctrl.inputName + '" ') : '') +
            ($ctrl.tabIndex ? (' tabindex="' + $ctrl.tabIndex + '" ') : '') +
            'type="' + ($ctrl.inputType ? $ctrl.placeholder : 'text') + ' ">' +
            '<div class="help-inline text-left ng-hide showValidator '+($ctrl.validatorClass?$ctrl.validatorClass:'')+'">'+$ctrl.validator+'</div>';
    }
}

angular.module('sb.fields.field.service', [
    'sb.fields.field.init.service'
])
    /*
     'without-close="true" ' +
    'element-id="'+$ctrl.item._id+'_address" ' +
    'value="::$ctrl.item.address" ' +
    'tab-index="2" ' +
    'tab-next-index="3" ' +
    'placeholder="Company Address…" ' +
    'field-class="with-underline address" ' +
    'on-change="$ctrl.onAddressChanged(result)" '+
     */
.service('SBFieldCtrlService', SBFieldCtrlService);
SBFieldCtrlService.$inject = ['SBFieldInitCtrlService'];
function SBFieldCtrlService( SBFieldInitCtrlService) {
    return function ($ctrl, $element, $attrs, withoutTemplateScope) {
        var timer, saveDelay = 500;

        $ctrl = new SBFieldInitCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

        $ctrl.onSBFieldInitCtrlService = onSBFieldInitCtrlService;

        if (!$ctrl.$onInit) {
            $ctrl.$onInit = $ctrl.onSBFieldInitCtrlService;
        }

        $ctrl.onBodyClick = onBodyClick;
        $ctrl.onInitFieldLoaded = onInitFieldLoaded;
        $ctrl.bindInitEvents = bindInitEvents;
        $ctrl.getInputValueInit = getInputValueInit;

        return $ctrl;

        function onSBFieldInitCtrlService() {
            //console.log('SBFieldCtrlService.onSBFieldInitCtrlService');
            if (!$ctrl.getInputValue) {
                $ctrl.getInputValue = getInputValueInit;
            }

            if (!$ctrl.setDisplayValue) {
                $ctrl.setDisplayValue = setDisplayValue;
            }

            if (!$ctrl.getItemTemplate) {
                console.warn('parent for SBFieldCtrlService must define $ctrl.getItemTemplate');
            }
            if (!$ctrl.onSBFieldInit) {
                console.warn('parent for SBFieldCtrlService must define $ctrl.onSBFieldInit');
            }
            $ctrl.onSBFieldInit();

            $ctrl.preventDefault = preventDefault;
            $ctrl.stopPropagation = stopPropagation;

            if ($ctrl.withPredefEvents) {
                if (!$ctrl.onFieldBlur) {
                    $ctrl.onFieldBlur = onFieldBlur;
                }

                if (!$ctrl.keyDownEvent) {
                    $ctrl.keyDownEvent = keyDownEvent;
                }
            }

            setInputContentProp();

            $ctrl.loadSBFiledInit();

            $ctrl.$element.on('$destroy', $ctrl.onSBFieldDestroy);
        }

        function bindInitEvents(isBind) {
            //console.log('bindFieldInitEvents: '+ $ctrl.elementId+': ' + isBind);
            if (isBind && $ctrl.inputField && !$ctrl.defaultEvents){
                $ctrl.defaultEvents = [
                    {el:$ctrl.inputField, event:'keyup', method: $ctrl.keyDownEvent},
                    {el:$ctrl.inputField, event:'paste', method: $ctrl.keyDownEvent},
                    {el:$ctrl.inputField, event:'blur', method: $ctrl.onFieldBlur},
                    {el:$ctrl.inputField, event:'focus', method: $ctrl.onFieldFocus},
                ];
            }

            if($ctrl.defaultEvents){
                _.each($ctrl.defaultEvents, function (ev) {
                    if (typeof (ev.method) === 'function') {
                        $ctrl.LCS.bindElementsClick(isBind, ev.el, ev.method, 'input_'+$ctrl.elementId, ev.event);
                    }
                });
            }

            if (typeof ($ctrl.bind) === 'function') {
                $ctrl.bind(isBind);
            }

            if($ctrl.tabIndex) {
                $ctrl.addRootWatcher('SET_FIELD_FOCUS_' + $ctrl.tabIndex, $ctrl.setFieldFocus);
            }

            bindBodyClick(isBind);
        }

        function bindBodyClick(isBind) {
            if ($ctrl.withBodyClick) {
                $ctrl.LCS.bindElementsClick(isBind, $ctrl.LCS.bodyElement, $ctrl.onBodyClick, $ctrl.elementId);
            }
        }

        function onBodyClick(e) { //for sb-phone
            console.log('onBodyClick');
            //if(  $ctrl.LCS.findClosestParent(e.target, '#body-wrapper') &&
            if( !$ctrl.LCS.findClosestParent(e.target, '.' + $ctrl.SBFieldTypesService.SBEditBlock)) {
                save(e,'EditableField.onBodyClick');
            }
        }

        function onFieldBlur(e) {
            //console.log('onFieldBlur');
            save(e,'EditableField.onFieldBlur');
        }

        function save(e, event) {
            //console.log(event + ' ' + $ctrl.prop);
            if ($ctrl.isValid(getInputValueInit())) {
                $ctrl.save(e, $ctrl.withoutClose ? false : true);
            } else if(event === 'EditableField.onBodyClick') {
                $ctrl.close(e);
            }

            function isValid(){
                return !$ctrl.invalidField || $ctrl.invalidField && Object.keys($ctrl.invalidField).length === 0;
            }
        }

        function onInitFieldLoaded() {
            //console.log('SBFieldCtrlService.onInitFieldLoaded');
            $ctrl.onRepeatFieldLoaded();

            if ($ctrl.onLoaded) {
                $ctrl.onLoaded();
            }
        }

        function setDisplayValue(val) {
            if($ctrl.inputField) {
                $ctrl.inputField[$ctrl.inputContentProp] = $ctrl.getDisplayValue(val).content;
            }
        }

        function getInputValueInit() {
            return $ctrl.inputField ? $ctrl.inputField[$ctrl.inputContentProp] : null;
        }

        function setInputContentProp() {
            switch ($ctrl.fieldSelector) {
                case 'input':
                case 'textarea':
                    $ctrl.inputContentProp = 'value';
                    break;
                case 'div':
                    $ctrl.inputContentProp = 'innerHTML';
            }
        }

        function keyDownEvent(e) {
            //console.log('keyDownEvent');
            var withClose = true;

            if (e.type === 'paste' ){
                $ctrl.isPasteEvent = true;
                if(!$ctrl.withoutPasteEvent) {
                    $ctrl.LCS.timeout(function () {
                        //console.log('save on paste');
                        $ctrl.save(e, withClose, true);
                    }, 1000);
                }
                return;
            }

            //save on cmdS
            if ($ctrl.saveOmCmdS && (e.ctrlKey || e.metaKey) && (e.which === 83 || e.which === 115)) {
                $ctrl.preventDefault(e);
                $ctrl.save(e, withClose, true);
                return;
            }

            switch (e.which) {
                case $ctrl.keymap.esc: //esc -> dont save and close
                    $ctrl.close(e);
                    break;

                case $ctrl.keymap.tab: //tab -> save and go to next
                    if ($ctrl.disableTabKey) {
                        return;
                    }
                    $ctrl.save(e, withClose, true);
                    break;

                case $ctrl.keymap.enter: //enter -> save and go to next index
                    if ($ctrl.disableEnterKey) {
                        return;
                    }
                    $ctrl.save(e, withClose, true);
                    break;

                default:
                    $ctrl.stopPropagation(e);
                    $ctrl.setTouchedField();
                    var l = $ctrl.element.querySelector('label'),
                        val = $ctrl.inputField.tagName === 'DIV' ? $ctrl.inputField.innerText : $ctrl.inputField.value;
                    if(val.trim() === ''){val = null;}
                    if(l) {
                        $ctrl.LCS[val ? 'removeClass' : 'addClass'](l, 'sb-hide');
                    }

                    if($attrs.saveOnKeydown === 'true' || $attrs.saveOnKeydown === true){
                        //console.log('saveOnKeydown');

                        if (timer) {
                            $ctrl.LCS.cancelTimeout(timer);
                        }
                        timer = $ctrl.LCS.timeout(process, saveDelay);

                        function process() {
                            $ctrl.save(e, false, false);
                        }
                    } else{
                        $ctrl.isValid(val, true);
                    }

                    if (typeof ($ctrl.onOtherKeyDownEvent) === 'function') {
                        $ctrl.onOtherKeyDownEvent(e);
                    }

                    break;
            }
        }

        function stopPropagation(e) {
            if (e && e.stopPropagation) {
                e.stopPropagation();
            }
        }

        function preventDefault(e) {
            $ctrl.LCS.preventDefault(e);
        }
    }
}


angular.module('sb.fields.field.init.service', [
    'sb.fields.types.service'
])
    /*
     'without-close="true" ' +
    'element-id="'+$ctrl.item._id+'_address" ' +
    'value="::$ctrl.item.address" ' +
    'tab-index="2" ' +
    'tab-next-index="3" ' +
    'placeholder="Company Address…" ' +
    'field-class="with-underline address" ' +
    'on-change="$ctrl.onAddressChanged(result)" '+
     */
    .service('SBFieldInitCtrlService', SBFieldInitCtrlService);
SBFieldInitCtrlService.$inject = ['CompInitCtrlService', 'TemplateCompileService', 'SBFieldTypesService'];
function SBFieldInitCtrlService(CompInitCtrlService, TemplateCompileService, SBFieldTypesService) {
    return function ($ctrl, $element, $attrs, withoutTemplateScope) {

        if (!$ctrl.$onDestroy) {
            $ctrl.$onDestroy = onSBFieldDestroy;
        }

        if (!$ctrl.compLoaded) {
            $ctrl = new CompInitCtrlService($ctrl);
        }

        $ctrl.keymap = {tab: 9, enter: 13, esc: 27, up: 38, down: 40, left: 37, right: 39};
        $ctrl.hotkeys = [$ctrl.keymap.tab, $ctrl.keymap.enter, $ctrl.keymap.esc, $ctrl.keymap.up, $ctrl.keymap.down];
        $ctrl.SBFieldTypesService = SBFieldTypesService;
        $ctrl.options = {};

        $ctrl.col = {
            type: $ctrl.propType
        };

        if (typeof($ctrl.save)!=='function')  {
            $ctrl.save = save;
        }

        if (typeof($ctrl.close)!=='function') {
            $ctrl.close = close;
        }
        if (typeof($ctrl.setUpdatePropValue)!=='function') {
            $ctrl.setUpdatePropValue = setUpdatePropValue;
        }
        $ctrl.setUpdatePropValueInit = setUpdatePropValue;
        if(typeof($ctrl.getExtendedEditChanges)!=='function'){$ctrl.getExtendedEditChanges = getExtendedEditChanges;}
        $ctrl.setTouchedField = setTouchedField;
        $ctrl.isValid = isValid;
        $ctrl.getDisplayValue = getDisplayValue;

        $ctrl.onSBFieldInit = onSBFieldInit;
        $ctrl.onSBFieldDestroy = onSBFieldDestroy;
        $ctrl.addRequiredValidatorOption = addRequiredValidatorOption;
        $ctrl.addMaxLengthValidatorOption = addMaxLengthValidatorOption;
        $ctrl.addMinLengthValidatorOption = addMinLengthValidatorOption;
        $ctrl.bindErrorEvents = bindErrorEvents;
        $ctrl.hasBoolAttribute = hasBoolAttribute;
        $ctrl.getItemId = getItemId;


        if (!$ctrl.onValueChanged) {
            $ctrl.onValueChanged = onValueChanged;
        }

        if (!$ctrl.onRepeatFieldLoaded) {
            $ctrl.onRepeatFieldLoaded = onRepeatFieldLoaded;
        }
        if(!$ctrl.setFieldFocus) {
            $ctrl.setFieldFocus = setFieldFocus;
        }
        if(!$ctrl.setPreviousValue){
            $ctrl.setPreviousValue = setPreviousValue;
        }
        return $ctrl;

        function getItemId() {
            var str = $ctrl.elementId ? $ctrl.elementId.split(['_']) : null;
            $ctrl.item = {};
            if (str) {
                $ctrl.prop = str[1];

                $ctrl.col.prop = $ctrl.prop;
                if (str.length === 3) {
                    $ctrl.objectType = str[2];
                }
            }
            $ctrl.origId = str && str[0] ? str[0] : undefined;
            if($ctrl.origId === 'undefined'){$ctrl.origId = undefined;}
            var id = get($ctrl.altId ? $ctrl.altId : $ctrl.origId);
            $ctrl.item._id = id;
            $ctrl.itemId = get($ctrl.origId);

            function get(id){
                if (id === 'undefined') {
                    return undefined;
                } else if (id === 'null') {
                    return null;
                }
                return id;
            }
        }

        function onSBFieldInit() {
           // console.log('onSBFieldInit');
            var txt = 'parent for SBFieldCtrlService ' + ($ctrl.element ? $ctrl.element.tagName :'') +' must define ';
            if (!$ctrl.onChange) {
                console.error(txt +' $ctrl.onChange');
            }
            if (!$ctrl.onCancel) {
                console.error(txt +' $ctrl.onCancel');
            }
            if (!$ctrl.setValue) {
                console.error(txt +' $ctrl.setValue');
            }
            if (!$ctrl.elementId) {
                console.error(txt +' $ctrl.elementId');
            }
            addPropsToCtrl();

            getItemId();

            $ctrl.prevValue = angular.copy($ctrl.value);

            $ctrl.$element = $element;
            $ctrl.element = $element[0];

            //has attribute focusDelay
            if($ctrl.focusDelay && typeof ($ctrl.focusDelay) === 'string'){
                $ctrl.focusDelay = 100;
            }

            if(!$ctrl.focusDelay){
                $ctrl.focusDelay = 0;
            }

            if (!$ctrl.getResult) {
                $ctrl.getResult = getResult;
            }

            if (!$ctrl.isSameValue) {
                $ctrl.isSameValue = isSameValue;
            }
            $ctrl.onFieldTemplateLoaded = onFieldTemplateLoaded;
            preInitField();

            $ctrl.loadSBFiledInit = loadSBFiledInit;
        }

        function addPropsToCtrl() {
            $ctrl.attrs = $attrs;
            var props = ['popoverContainer', 'parentContainer', 'placeholder', 'fieldClass', 'tabIndex', 'tabNextIndex', 'drpMenuCls', 'drpClassAttr', 'eClassAttr', 'cClassAttr', 'initListName', 'altId', 'origProp', 'did', 'canEdit','wrapperClass', 'focusDelay'];
            _.each(props, function (prop) {
                var val = $ctrl.attrs[prop];
                if(val === 'true'){val = true;}
                if(val === 'false'){val = false;}
                if (val !== undefined) {
                    $ctrl[prop] = val;
                }
            });


            if(!$ctrl.withoutClose) {
                $ctrl.withoutClose = $ctrl.hasBoolAttribute('withoutClose');
            }
            if(!$ctrl.withoutOpenedDrp) {
                $ctrl.withoutOpenedDrp = $ctrl.hasBoolAttribute('withoutOpenedDrp');
            }
            if($ctrl.withoutOpenedDrp === undefined) {
                $ctrl.withoutOpenedDrp = $ctrl.withoutClose;
            }
        }

        function preInitField() {
            //console.log('SBFieldInitCtrlService.preInitField ');
            var props = $ctrl.SBFieldTypesService.getDefaultFieldProps($ctrl.propType, $ctrl.attrs);
            if (props) {
                $ctrl.col = _.extend($ctrl.col, props);
            }

            if (!$ctrl.options) {
                $ctrl.options = {};
            }

            $ctrl.options.validators = {};

            if ($ctrl.col.isRequired) {
                $ctrl.addRequiredValidatorOption();
            }

            if ($ctrl.col.isMaxLength) {
                $ctrl.addMaxLengthValidatorOption($ctrl.col.isMaxLength);
            }

            if ($ctrl.col.isMinLength) {
                $ctrl.addMinLengthValidatorOption($ctrl.col.isMinLength);
            }

            if (typeof ($ctrl.preInitField) === 'function') {
                $ctrl.preInitField();
            }

            $ctrl.setPreviousValue();

            //don't load validator first time
            //$ctrl.isValid();
        }


        function loadSBFiledInit() {
            //console.log('SBFieldInitCtrlService.loadSBFiledInit');
            if (!$ctrl.templateCompile) {
                $ctrl.templateCompile = new TemplateCompileService($ctrl.$element, getItemTemplate, $ctrl, withoutTemplateScope);
            }
            $ctrl.templateCompile.loadTemplate(onLoaded);

            function onLoaded() {
                if ($ctrl.onFieldTemplateLoaded) {
                    $ctrl.onFieldTemplateLoaded();
                }
            }
        }

        function setPreviousValue(){
            $ctrl.previousValue = $ctrl.value ? (typeof($ctrl.value) === 'object' ? _.extend({}, _.clone($ctrl.value)) : angular.copy($ctrl.value)) : $ctrl.value;
        }

        function onRepeatFieldLoaded() {
            $ctrl.setDisplayValue();
        }

        function onSBFieldDestroy() {
            onBeforeCloseInit(true);

            if ($ctrl.bindInitEvents) {
                $ctrl.bindInitEvents(false);
            }

            if ($ctrl.templateCompile) {
                $ctrl.templateCompile.destroyNewScope();
            }
            $ctrl.removeWatchers();
        }

        function onFieldTemplateLoaded() {
            //console.log('onFieldTemplateLoaded');
            if ($ctrl.withCustomLoading) {
                return;
            }

            //console.log('SBFieldInitCtrlService.onInitFieldLoaded');
            $ctrl.inputField = $ctrl.element.querySelector($ctrl.fieldSelector);
            //  $ctrl.setDisplayValue();

            setAttributes();
            //todo what should be here???
            // $ctrl.getOptionsInit();

            if ($ctrl.onInitFieldLoaded) {
                $ctrl.onInitFieldLoaded();
            }

            if ($ctrl.bindInitEvents) {
                $ctrl.bindInitEvents(true);
            }

            if (!$ctrl.withoutClose && !$ctrl.withoutDefaultFocus) {
                if ($ctrl.inputField) {
                    $ctrl.LCS.editedField = {id: $ctrl.itemId, prop: $ctrl.prop};
                    $ctrl.setFieldFocus();
                }
            }
            $ctrl.addRootWatcher('CLOSE_EDITABLE_FIELD_' + $ctrl.itemId, onCloseGridEditableField);

            $ctrl.changedFields = ['value'];
            if ($ctrl.changedFieldsOther && $ctrl.changedFieldsOther.length > 0) {
                $ctrl.changedFields = $ctrl.changedFields.concat($ctrl.changedFieldsOther);
            }
            $ctrl.$onChanges = $onChanges;
        }

        function $onChanges(changes) {
            if (!changes) {
                return;
            }
            //console.log('SBFieldInitCtrlService.$onChanges');
            //console.log(changes);
            for (var i = 0, l = $ctrl.changedFields.length; i < l; i++) {
                var field = $ctrl.changedFields[i],
                    change = changes[field];
                if (change !== undefined && !angular.equals(change.currentValue, change.previousValue) && !change.isFirstChange()) {
                    if($ctrl.onChangesOther){
                        $ctrl.onChangesOther(changes);
                    }
                    if(field === 'value') {
                        updateValue();
                    }
                    break;
                }
            }
        }

        function setFieldFocus() {
            //console.log('setFieldFocus ' + $ctrl.tabIndex);
            if ($ctrl.inputField) {
                $ctrl.LCS.timeout(setselect, $ctrl.focusDelay);
            }
            function setselect() {
                $ctrl.inputField.focus();
                var val = $ctrl.inputField[$ctrl.inputField.tagName === 'DIV' ? 'innerText' : 'value'];
                if ($ctrl.withAutoSelect && val) {
                    $ctrl.inputField.select();
                }
            }
        }

        function updateValue() {
            //console.log('updateValue');
            $ctrl.setPreviousValue();
            $ctrl.onRepeatFieldLoaded();
        }

        function onValueChanged(newValue) {
            if (!$ctrl.isSameValue($ctrl.previousValue, newValue)) {// no change
                console.log('onValueChanged');
                $ctrl.value = newValue;
                updateValue();
            }
        }

        function onCloseGridEditableField(prop) {
            if (prop === $ctrl.prop) {
               // console.log('on CLOSE_GRID_EDITABLE_FIELD: ' + $ctrl.elementId);
                //todo need to close with save
                var withClose = true;
                $ctrl.save(null, withClose, true);
            }
        }

        function setAttributes() {
            $ctrl.id = 'sbE' + new ObjectId().toString();
            $ctrl.element.setAttribute('id', $ctrl.id);
            var attrs;
            try {
                var el = $ctrl.LCS.findClosestParent($ctrl.element, '.row-scheduleTemp');
                if(el) {
                    attrs = el.attributes;
                }
            } catch (e) {
            }
            if (attrs) {
                if (attrs.elemType) {
                    $ctrl.elemType = attrs['elem-type'];
                }
                if (attrs.itemTitle) {
                    $ctrl.itemTitle = attrs['item-title'];
                }
            }

            var cls = ($ctrl.eClassAttr ?  ($ctrl.eClassAttr + ' ') : '') +
                ($ctrl.fieldClass ? $ctrl.fieldClass : '');
            if (cls.trim() !== '') {
                $ctrl.LCS.addClass($ctrl.inputField, cls);
            }
            if ($ctrl.inputField){
                if($ctrl.tabIndex) {
                    $ctrl.inputField.setAttribute('tabindex', $ctrl.tabIndex);
                }

                if($ctrl.inputField.tagName === 'INPUT' && !$ctrl.canEdit){
                    $ctrl.inputField.setAttribute('readonly', 'readonly');
                }
            }
        }

        function getItemTemplate() {
            return $ctrl.getItemTemplate()
                .replace(/\{\{props\}\}/g, getDefaultProps())
                .replace(/\{\{id\}\}/g, 'formControl_' + $ctrl.elementId)
                .replace(/\{\{name\}\}/g, $ctrl.prop);

            /*  if (result.params) {
                  _.extend($ctrl.item, result.params);
              }*/

            function getDefaultProps() {
                //id name class placeholder placeholder required styleG
                return 'id="{{id}}" ' +
                      'name="'+($ctrl.col.inputName ? $ctrl.col.inputName : '{{name}}')+'"' +
                    'class="' + $ctrl.SBFieldTypesService.getEditFieldClass($ctrl.col.type) + ' ' +
                        ($ctrl.col.eClassAttr ? ($ctrl.col.eClassAttr + ' ') : '') +
                        ($ctrl.col.fieldClass ? $ctrl.col.fieldClass : '') +
                    '" ' +
                    ($ctrl.col.placeholder ? ('placeholder="' + ($ctrl.col.placeholder ? $ctrl.col.placeholder : $ctrl.SBFieldTypesService.getDefaultPlaceholder($ctrl.col.type)) + '" ') : '') +
                    ($ctrl.col.isRequired ? ('required="required" ') : '') +
                    ($ctrl.col.isMaxLength ? ('maxlength="'+$ctrl.col.isMaxLength+'" ') : '') +
                    ($ctrl.col.isMinLength ? ('minlength="'+$ctrl.col.isMinLength+'" ') : '') +
                    ($ctrl.col.styleG ? ('style="' + $ctrl.col.styleG + '" ') : '') +
                    ($ctrl.col.tabIndex ? ('tabindex="' + $ctrl.col.tabIndex + '" ') : '');
            }
        }

        function getDisplayValue(value) {
            return $ctrl.SBFieldTypesService.getSBFieldContentEdit($ctrl, value, $ctrl.col);
              //  $attrs.withoutClose === 'true' || $attrs.withoutClose === true);
        }

        function isSameValue(a1, a2) {
            if (a1 === undefined && a2 === undefined ||
                a1 === undefined && a2 === null) {
                return true;
            }
            return angular.equals(a1, a2);
        }

        function save(e, withClose, tabNext) {
            //console.log('save: '  + $ctrl.prop + withClose);
            $ctrl.preventDefault(e);
            $ctrl.setValue(function () {
                onInitSave(withClose, tabNext);
            });
        }

        function setUpdatePropValue(item) {
            item[$ctrl.prop] = angular.copy($ctrl.value);
        }

        function getExtendedEditChanges(item) {
            var e = {};
            $ctrl.setUpdatePropValue(e);
            return e;
        }

        //function onSave(
        function onInitSave(withClose, tabNext) {
            //console.log('SBFieldInitCtrlService.onInitSave ' + $ctrl.prop);
            removeErrors();
            if (!$ctrl.isValid($ctrl.value)) {
                return;
            }

            //console.log('previousValue=' + $ctrl.previousValue + ', newVal=' + $ctrl.value);
            if ($ctrl.isSameValue($ctrl.previousValue, $ctrl.value) && !$ctrl.forceSave) {// no change
                //console.log('same value ' + $ctrl.prop);
                if (withClose) {
                    closeAndCancel(withClose, false, tabNext);
                }
            } else {
                //console.log('start save ' + $ctrl.prop);
                if (!$ctrl.saveInProgress) {
                    $ctrl.saveInProgress = true;
                    $ctrl.setUpdatePropValue($ctrl.item);
                    var id = $ctrl.item._id;
                    if ($ctrl.service && id) {
                        var set = true;
                        if ($ctrl.service.withScriptId && !$ctrl.item.scriptId) {
                            if ($ctrl.CPS.scriptId) {
                                $ctrl.item.scriptId = $ctrl.CPS.scriptId;
                            } else {
                                console.warn('Parent for SBFieldCtrlService must define $ctrl.item.scriptId');
                                // $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.' + ($ctrl.objectType ? $ctrl.objectType : 'field') + '.Edit.error', 'error');
                                set = false;
                            }
                        }
                        if (set) {
                            //console.log('$ctrl.service.update');

                            $ctrl.service.update($ctrl.item, function (newRes) {
                                if ($ctrl.altId) {
                                    if (!newRes.updatesG) {
                                        newRes.updatesG = {};
                                    }
                                    if (!newRes.updatesG[$ctrl.service.collectionName]) {
                                        newRes.updatesG[$ctrl.service.collectionName] = {};
                                    }
                                    if (!newRes.updatesG[$ctrl.service.collectionName].set) {
                                        newRes.updatesG[$ctrl.service.collectionName].set = {};
                                    }
                                    if (!newRes.updatesG[$ctrl.service.collectionName].set[id]) {
                                        newRes.updatesG[$ctrl.service.collectionName].set[id] = {};
                                    }
                                    $ctrl.setUpdatePropValue(newRes.updatesG[$ctrl.service.collectionName].set[id]);
                                }
                                onSuccess(newRes);
                            }, onError);
                        }
                    } else {
                        if (!$ctrl.withoutClose) {
                            console.warn('Parent for SBFieldCtrlService must define $ctrl.service');
                        }
                        if ($ctrl.triggerUpdateOnSave) {
                            $ctrl.triggerUpdate(function () {
                                onSuccess({});
                            });
                        } else {
                            onSuccess(null);
                        }
                    }
                } else {
                    console.log('  save in progress ' + $ctrl.prop);
                    //  $ctrl.i18nNotifications.pushForCurrentRoute (null, 'crud.gridItem.success.nochanges', 'success' );
                    //  return false;
                }

                function onSuccess(newRes) {
                    $ctrl.setPreviousValue();
                    $ctrl.saveInProgress = false;
                    if (withClose) {
                        onBeforeCloseInit();
                    }
                    $ctrl.onChange(getResult(withClose, true, tabNext, newRes));
                }

                function onError(error) {
                    $ctrl.i18nNotifications.pushForCurrentRoute(error, 'crud.' + ($ctrl.objectType ? $ctrl.objectType : 'field') + '.Edit.error', 'error');
                    $ctrl.saveInProgress = false;
                    closeAndCancel(withClose, true);
                }
            }
        }

        function close(e) {
            $ctrl.preventDefault(e);
            closeAndCancel(true, false);
        }

        function closeAndCancel(withClose, withValue, tabNext) {
            //console.log('close editable field ' + $ctrl.prop);
            onBeforeCloseInit(true);
            var result = getResult(withClose, withValue, tabNext);
            $ctrl.onCancel(result);
            try {
                //console.log('broadcastRoot GRID_ITEM_FIELD_CLOSE_' + $ctrl.elemType + '_' + $ctrl.itemId);
                $ctrl.broadcastRoot('GRID_ITEM_FIELD_CLOSE_' + $ctrl.elemType + '_' + $ctrl.itemId, result.result);
            }catch (e){}
        }

        function onBeforeCloseInit(force) {
            if($ctrl.onBeforeClosePopover) {
                $ctrl.onBeforeClosePopover(force);
            }
            if ($ctrl.onBeforeClose) {
                $ctrl.onBeforeClose();
            }
            if (!force && $ctrl.withoutClose) {
                return;
            }
            $ctrl.bindErrorEvents();
        }

        function hasBoolAttribute(attr) {
            return $ctrl.attrs[attr] === 'true' || $ctrl.attrs[attr] === true;
        }

        function getResult(withClose, withValue, tabNext, newRes) {
            var res = {id: $ctrl.id, prop: $ctrl.prop};
            if (withValue) {
                if ($ctrl.origId !== undefined) {
                    res.editchanges = _.extend({_id: $ctrl.origId}, $ctrl.getExtendedEditChanges(newRes ? newRes.item : null));
                }

                res.selected = {
                    field: $ctrl.prop,
                    val: $ctrl.value
                };
                if ($ctrl.tempWordcount !== undefined) {
                    res.selected.wordCount = $ctrl.tempWordcount;
                }

                res.newRes = newRes;
            }

            if (withClose) {
                res.close = true;
            }

            if (tabNext && $ctrl.tabNextIndex && !($ctrl.LCS.isMobileSize || $ctrl.LCS.isTouchScreen)) {
                res.tabNextIndex = $ctrl.tabNextIndex;
            }

            return {result: res};
        }

        function isValid(v, isKeyDown) {
            var validators = $ctrl.options.validators;
            for (var prop in validators) {
                var validator = validators[prop];
                if((!isKeyDown || isKeyDown && !validator.skipOnKeyDown) && !isValidValidator(validator, v)) {
                    return process(false);
                }
            }

            return process(true);

            function process(isV) {
                if(typeof($ctrl.onValidation) === 'function'){
                    var result = {};
                    result[$ctrl.prop] = isV;
                    $ctrl.onValidation({result: result});
                }
                return isV;
            }
        }

        function isValidValidator(validator, v) {
            var cls = $ctrl.col.validatorClass,
                isValid = validator.method(v),
                 vCls = 'v' + validator.name;
            if(!$ctrl.invalidField){$ctrl.invalidField = {};}
            $ctrl.invalidField[vCls] = true;
            setValidField(isValid);
            if(!isValid) {
                if (!$ctrl.element.querySelector('.' + vCls)) {
                    $ctrl.LCS.appendChildFragment($ctrl.element,
                '<div class="' + vCls + ' help-inline text-left ' + (cls ? cls : '') + ' ' + validator.name + '">' +
                            '<div class="text-left pull-left">' + validator.message + '</div>' +
                            ($ctrl.withoutClose ? '' : ('<a class="clear-search pull-right sb-tooltip-bottom" data-tooltip="Cancel"><span class="sbf delete-circle"></span></a>')) +
                        '</div>'
                    );

                    if (!$ctrl.withoutClose) {
                        validator.el = $ctrl.element.querySelector('.clear-search');
                        bindErrorEvent(validator, isValid);
                    }
                }
            }else{
                _.each($ctrl.element.querySelectorAll('.' + vCls), function (el) {
                    if($ctrl.withoutClose){
                        bindErrorEvent(validator, isValid);
                    }
                    if(el && el.parentNode) {
                        el.parentNode.removeChild(el);
                    }
                    delete $ctrl.invalidField[vCls];
                });
            }

            return isValid;
        }

        function bindErrorEvent(validator, isBind) {
            var el = validator ? validator.el : null;
            if (el) {
                $ctrl.LCS.bindElementsClick(isBind, el, close);
                if (!isBind) {
                    if(el && el.parentNode) {
                        el.parentNode.removeChild(el);
                    }
                    validator.el = null;
                }
            }
        }

        function bindErrorEvents(isBind) {
            var vals = $ctrl.options.validators;
            for (var prop in vals) {
                bindErrorEvent(vals[prop], isBind);
            }
        }

        function removeErrors() {
            setValidField(true);
            bindErrorEvents();
            _.each($ctrl.element.querySelectorAll('.help-inline'), function (el) {
                if(el && el.parentNode) {
                    el.parentNode.removeChild(el);
                }
            });
        }

        function setValidField(isValid) {
            $ctrl.LCS[isValid ? 'removeClass' : 'addClass']($ctrl.inputField, 'ng-invalid');
        }

        function setTouchedField() {
            if(!$ctrl.isTouched) {
                $ctrl.isTouched = true;
                $ctrl.LCS.addClass($ctrl.inputField, 'ng-touched');
            }
        }

        function addRequiredValidatorOption() {
            $ctrl.options.validators.isRequired = {
                name: 'isRequired',
                message: 'This field cannot be empty',
                method: function (v) {
                    return v && v.length>0;
                }
            }
        }

        function addMaxLengthValidatorOption(val) {
            $ctrl.options.validators.isMaxLength = {
                name: 'isMaxLength',
                message: 'This field cannot have more than ' + val +' characters',
                method: function (v) {
                    return !v || v && v.length <= val;
                }
            }
        }

        function addMinLengthValidatorOption(val) {
            $ctrl.options.validators.isMinLength = {
                name: 'isMinLength',
                message: 'This field cannot have less than ' + val +' characters',
                method: function (v) {
                    return !v || v.length >= val;
                }
            }
        }
    }
}

