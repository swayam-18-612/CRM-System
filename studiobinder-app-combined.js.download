angular.module('product.settings.popup.component', [
    'product.settings.component'
])
.component('projectSettingsPopup', popupComponentParams('ProjectSettingsPopupCtrl'))
.controller('ProjectSettingsPopupCtrl', ProjectSettingsPopupCtrl) ;

ProjectSettingsPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', '$element'];
function ProjectSettingsPopupCtrl(ItemTemplateCompileCtrlService, $element) {
    console.log('ProjectSettingsPopupCtrl');
    var $ctrl =  this;

    $ctrl.isPopup = true;

    $ctrl.getItemPopupTemplate = getItemPopupTemplate;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function getItemPopupTemplate() {
        return $ctrl.getMobileBack() +
               '<project-settings on-close="$ctrl.onClose()" is-edit-callsheet="::$ctrl.extraParam.isEditCallsheet"></project-settings>';
    }
}


angular.module('product.settings.component', [
    'product.settings.init.controller',
    'apiServices.Products'
])
.component('projectSettings', {
    controller:'ProductSettingsCtrl',
    bindings: {
        isEditCallsheet: '<',
        onClose: '&'
    }
})
.controller('ProductSettingsCtrl', ProductSettingsCtrl);

ProductSettingsCtrl.$inject = ['ListItemTemplateFormCtrlService', 'ProductSettingsInitCtrlService', 'ProductsService', '$element'];
function ProductSettingsCtrl (ListItemTemplateFormCtrlService, ProductSettingsInitCtrlService, ProductsService, $element) {
    console.log('ProductSettingsCtrl');
    var $ctrl = this;

    $ctrl.ProductsService = ProductsService;

    $ctrl.onSettingsSave = onSettingsSave;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInitOther = preInitOther;
    $ctrl.postInitOther = postInitOther;

    $ctrl.dontAutoloadTemplate = false;

    $ctrl = new ListItemTemplateFormCtrlService($ctrl, $element);

    function preInitOther() {
        $ctrl.popupTitle = 'Project Defaults';
        $ctrl = new ProductSettingsInitCtrlService($ctrl, $element);
    }

    function postInitOther() {
        $ctrl.onSave = $ctrl.onProductSettingsSave;
    }

    function getItemTemplate() {
        return $ctrl.getProjectSectionForm();
    }

    function onSettingsSave(item) {
        console.log('ProductSettingsCtrl.onSettingsSave');
        $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.project.setting.success', 'success');

        $ctrl.CPS.product.settings = item;
        if ($ctrl.CPS.product.settingsId !== item._id) {
            $ctrl.ProductsService.update({
                settingsId: item._id,
                _id: $ctrl.CPS.product._id
            }, function (result) {
                var product = result ? result.item : {};
                    $ctrl.CPS.product.settingsId = product.settingsId;
                process();
            }, function (error) {
                console.log(error);
                process();
            });
        } else {
            process();
        }

        function process() {
            $ctrl.CurrentLocaleSettings.initProductSettings(item);
            $ctrl.CPS.loadCurrentLocale();
            $ctrl.CurrentProduct.broadcastProduct($ctrl.CPS.product);
            if(typeof($ctrl.onClose)==='function'){$ctrl.onClose();}


            if($ctrl.isEditCallsheet) {
                $ctrl.LCS.timeout(function () {
                    $ctrl.CPS.reloadCurrentState();
                }, 200);
            }
        }
    }
}


angular.module('product.settings.routing', [
    'product.settings.page.component'
])
.config(ProductSettingsRouting);
ProductSettingsRouting.$inject = ['$uiRouterProvider'];
function ProductSettingsRouting($uiRouter) {
   productPageRouting($uiRouter, {
         overviewBlockType: 'settings',
       pageComponent: 'projectSettings'
     }, {
         url: 'settings',
         permissions: 'useronly',

         title: 'Project Settings',
         bodyClass: 'settings without-filters with-white-bg'
     });
}

angular.module('apiConstants.shots.services', [
    'sb.fields.types.service',
    'apiConstants.shotsdef.services',
    'compOptions.shots.constant'
])
.service('ShotConstantsService', ShotConstantsService);
ShotConstantsService.$inject = ['SBFieldTypesService', 'ShotDefConstantsService', 'ShotsCompOptions'];
function ShotConstantsService(SBFieldTypesService, ShotDefConstantsService, compOptions) {
    var popupTemplate = getBasePopupTemplateByTag('shot-edit');
    var PropTypes = SBFieldTypesService.PropTypes,
        Options = {
            columns: ['13', '14', '3', '5', '7', '8', '9', '21'],
            view: 2, column: 3, ratio: 1, type: 1,
            orientation: 'landscape',

            showPrintViewModes: true,

            showPrintBgColor: true,
            showPrintBgCardColor: true,
            showPrintFontColor: true,
            showPrintBorderColor: true,
            dontExpandPrintGridSettings: true,
            printColumnsPerPage: 1,
            showPrintBorders: true
        },

        Settings = _.extend({
            Colors: SBFieldTypesService.SBFieldMethods.Colors,
            Columns: angular.copy(SBApiGridColumns['shots'](PropTypes))
        }, ShotDefConstantsService.getDrps()),

        Filters = [{value: true, text: 'Active'}, {value: false, text: 'Archived'}],

        TreeTypes = [
            {value: compOptions.treeTypeScriptList, text: 'Imported Scenes'},
            {value: compOptions.treeTypeCustomList, text: 'Custom Lists'}
        ],

        CompOptions = angular.copy(compOptions),

        ListTreeServiceParams = {
            maxLevel: 2,
            hideLevel0: true,
            startIndent: 0,
            withHarcodedAll: false,
            dontStartTreeWithAll: true,
            clickOnGroup: false,
            ungroupGroupOnTreeDelete: true,

            level0Name: 'All Shot Lists',
            preLoadingTableName: 'ShotsLists',

            moveInGroup: CompOptions.moveInGroup,
            hasTreeCopy: CompOptions.hasTreeCopy,
            hasTreeShare: CompOptions.hasTreeShare,
        },

        ListParams = {
            includeFields: ['listType', 'scriptId', 'stripId', 'type', 'order', 'name', 'sceneNo', 'shotNo', 'customShotNo', 'size', 'types', 'movement', 'lens', 'frameRate', 'subject', 'special', 'color', 'status', 'camera', 'equipment', 'logo', 'logoId', 'logoRatio', 'commentsCount', 'shotsListId',
                'lighting', 'sound', 'location', 'locationId',
                'estTime', 'prepTime', 'shootTime', 'duration',
                'time', 'endTime', 'vfx', 'note'],
            searchFields: ['name'],
            orderFields: ['order'],
            populate: ''
        },

        KeyboardServiceParams = {
            canCopy: ListTreeServiceParams.hasTreeCopy,
            canMove: ListTreeServiceParams.moveInGroup,
            selectOnlyOnCheckmark: false,
            hasSelectedClass: false,
            hasOverlayClass: true,
            //selectOnCtrl: true,
            fullscreenList: null,
        },

        PopupOperations = _.extend( {
            createShot: {
                type: 'Create',
                template: popupTemplate,
                size: 'medium',
                transp: ' ',
                backdrop: 'static'
            },

            updateShot: {
                type: 'Edit',
                template: popupTemplate,
                size: 'medium',
                transp: ' ',
                backdrop: 'static'
            },
            duplicateShot: {
                type: 'Duplicate',
                template: popupTemplate,
                size: 'medium',
                transp: ' ',
                backdrop: 'static'
            },
            createShotList: {
                type: 'Create',
                template: getBasePopupTemplateByTag('shot-group-item'),
                size: 'medium',
                transp: ' '
            },

            updateShotList: {
                type: 'Edit',
                template: getBasePopupTemplateByTag('shot-group-item'),
                size: 'medium',
                transp: ' '
            }
        }, ShotDefConstantsService.getPopups()),

        Hotkeys = [
            {key: 'e', desc: 'Edit selected shots', isCtrl: true},
            {key: 'c', desc: 'Copy selected shots', isCtrl: true},
            {key: 's', desc: 'Add shot under', isCtrl: true},
            {key: 'x', desc: 'Cut selected shots', isCtrl: true},
            {key: 'n', desc: 'Add note under', isCtrl: true},
            {key: 'v', desc: 'Paste selected shots', isCtrl: true},
            {key: 't', desc: 'Add setup under', isCtrl: true},
            {key: 'backspace', desc: 'Delete selected shots'}
        ],

        SidebarOptions = {
            addGroupPopupName: 'createShotList',
            editGroupPopupName: 'updateShotList',
            removeAdditionalMessage: ' and all the shots within it',
            ungroupAdditionalMessage: 'The ungrouped shot lists will be moved to <b>All Shots Lists</b>',
        };

    return {
        PropTypes: PropTypes,
        Settings: Settings,
        Options: Options,
        Filters: {Filters: Filters, TreeTypes: TreeTypes},
        ViewProp: 'shotView',

        CompOptions: CompOptions,
        ListTreeServiceParams: ListTreeServiceParams,
        ListParams: ListParams,
        KeyboardServiceParams: KeyboardServiceParams,

        PopupOperations: PopupOperations,
        Hotkeys: Hotkeys,
        SidebarOptions: SidebarOptions,
    };
}

