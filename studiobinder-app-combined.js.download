angular.module('product.contacts.adjustRoles.init.controller.service', [
    'apiConstants.product.contacts.services'
])
.service('AdjustRolesInitCtrlService', AdjustRolesInitCtrlService);
AdjustRolesInitCtrlService.$inject = ['ContactsConstantsService'];
function AdjustRolesInitCtrlService(ContactsConstantsService) {
    //positions, departments, contactListId,item, copyItem,type,defaultRole
    return function($ctrl) {
        console.log('AdjustRolesInitCtrlService');
        if(!$ctrl.extraParam) {
            console.warn('controller for AdjustRolesInitCtrlService must define extraParam');
        }else{
            $ctrl.departments = $ctrl.extraParam.departments;
            $ctrl.positions = $ctrl.extraParam.positions;
        }
        if(!$ctrl.positions){
            console.warn('extraParam parameters for AdjustRolesInitCtrlService must define positions');
        }
        if(!$ctrl.departments){
            console.warn('extraParam parameters for AdjustRolesInitCtrlService must define departments');
        }
        $ctrl.config = {
            optgroupField: 'depId',
            optgroupLabelField: 'name',
            valueField: 'posId',
            labelField: 'name',
            searchField: ['name', 'shortName'],

            optgroups: $ctrl.departments,
            optgroupValueField: 'depId',

            placeholder: 'Search for a position…',
            inputClass: 'selectize-input ' + $ctrl.pageClass + ' with-underline',
            maxItems: 1,
        };

        $ctrl.CastRoles = ContactsConstantsService.CastRoles;
        $ctrl.itemRoles = [];
        $ctrl.getRoleProp = getRoleProp;
        $ctrl.addRole = addRole;
        $ctrl.removeRole = removeRole;

        $ctrl.validCrewPositions = validCrewPositions;
        $ctrl.loadRoles = loadRoles;
        $ctrl.updateRoles = updateRoles;
        $ctrl.setDefault = $ctrl.isNew;
        $ctrl.changeRoleType = changeRoleType;
        $ctrl.getAddRoles = getAddRoles;

        $ctrl.preventDefault = preventDefault;
        $ctrl.loadRoles();

        return $ctrl;

        function changeRoleType(i, result) {
            $ctrl.itemRoles[i].type = result.selected.val;
        }

        function getRoleProp(type, prop) {
            if($ctrl.CastRoles) {
                for (var i = 0; i < $ctrl.CastRoles.length; i++) {
                    var p = $ctrl.CastRoles[i];
                    if (p.value === type) {
                        return p[prop];
                    }
                }
            }
            return null;
        }

        function addRole(e) {
            $ctrl.preventDefault(e);
            $ctrl.itemRoles.push({type: $ctrl.defaultRole ? $ctrl.defaultRole : 2});
        }

        function removeRole(e, index) {
            $ctrl.preventDefault(e);
            $ctrl.itemRoles.splice(index, 1);
        }

        function validCrewPositions(roles) {
            if (!roles) {
                return null;
            }
            for (var i = 0, n = roles.length; i < n; i++) {
                var r = roles[i];
                if (r.type === 2) {
                    if (!r.posId) {
                        return 'Please add positions to all assigned crew roles';
                    }
                }else{
                    if (!r.name) {
                        return 'Please set a role name to the assigned roles';
                    }
                }
            }
            return null;
        }

        function loadRoles() {
            console.log('loadRoles');
            $ctrl.itemRoles = clone($ctrl.service.getItemRoles($ctrl.item, $ctrl.productContactListId));
            $ctrl.initRoles = clone($ctrl.itemRoles);
            if (!$ctrl.itemRoles || $ctrl.itemRoles.length === 0) {
                $ctrl.addRole(null);
            }
            if($ctrl.productContactListId){//allow to overwrite default roles
                $ctrl.showSetDefault = true;
            }
        }

        function clone(roles){
            return roles ? JSON.parse(JSON.stringify(roles)) : roles;
        }

        function getPosition(posId) {
            var pos = $ctrl.positions;
            if (!pos || pos.length === 0) {
                return null;
            }
            for (var i = 0, l = pos.length; i < l; i++) {
                var el = pos[i];
                if (el.posId === parseInt(posId, 10)) {
                    return el;
                }
            }
            return null;
        }

        function updateRoles(roles, keepEmpty) {
            if (!roles || roles.length === 0) {
                return roles;
            }
            var pos = [];
            for (var i = roles.length - 1; i >= 0; i--) {
                var r = roles[i];
                if(r) {
                    delete r.$$hashKey;
                    if (r.type === 2) {
                        var l = getPosition(r.posId);
                        if (!l) {
                            if (!keepEmpty) {
                                roles.splice(i, 1);
                            }
                        } else {
                            r.posId = l.posId;
                            r.depId = l.depId;
                            //check if pos exists already in the list
                            var exists = false;
                            for (var j = 0; j < pos.length; j++) {
                                if (pos[j] === r.posId) {
                                    exists = true;
                                    roles.splice(i, 1);
                                }
                            }
                            if (!exists) {
                                pos.push(r.posId);
                            }
                        }
                    } else { // remove empty characters extras clients
                        if (!r.name) {
                            if (!keepEmpty) {
                                roles.splice(i, 1);
                            }
                        }
                    }
                }
            }
            return roles ? clone(roles) : roles;
        }

        function getAddRoles(cls, tabIndex) {
return '<div class="roles-wrapper '+(cls || '')+'">'+
            '<div>' +
             '<ul class="roles">' +
               '<li class="spacing-half-bottom line-item table-div full-width" ng-repeat="r in $ctrl.itemRoles">' +
                    '<div ng-if="$ctrl.CastRoles" class="col60" >' +
                       '<sb-dropdown ' +
                            'drp-class-attr="roleTypes" ' +
                            'without-close="true" ' +
                            'c-class-attr="type" ' +
                            'field-class="form-control with-underline '+$ctrl.pageClass+'" ' +
                            'init-list="::$ctrl.CastRoles" ' +
                            'value="::r.type" ' +
                            'item-label="text" ' +
                            'item-value="value" ' +
                            'tab-index="{{::' + tabIndex + '+$index*2}}" ' +
                            'tab-next-index="{{::' + tabIndex + '+$index*2+1}}" ' +
                            'on-change="$ctrl.changeRoleType($index, result)" ' +
                        '></sb-dropdown>' +
                    '</div>' +
                    '<div class="position-relative padding-left10 vbottom">' +
                       '<div ng-if="r.type !== 2">' +
                            '<input name="rolename_{{$index}}" id="rolename_{{$index}}" class="form-control with-underline '+$ctrl.pageClass+'" placeholder="{{$ctrl.getRoleProp(r.type, \'placeholder\')}}…" type="text" ng-model="r.name" required' +
    //' ui-focus="$ctrl.isSetFocus('+tabIndex+'+$index*2+1)" ng-focus="$ctrl.setFocus('+tabIndex+'+$index*2+1)"
    '>' +
                            '<div ng-show="($ctrl.formHolderItem.formItem[\'rolename_\'+$index].$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem.formItem[\'rolename_\'+$index].$error.required" class="help-inline ng-hide padding-left10">Please insert a role.</div>' +
                       '</div>' +
                       '<div ng-if="r.type===2">' +
                            '<sb-selectize config="::$ctrl.config" init-list=\'::$ctrl.positions\' ng-model="r.posId"></sb-selectize>' +
                            '<div ng-show="($ctrl.formHolderItem.formItem[\'rolename_\'+$index].$dirty || $ctrl.formHolderItem[\'formItem_attempted\']) && $ctrl.formHolderItem.formItem[\'rolename_\'+$index].$error.required" class="help-inline ng-hide padding-left10">Please insert a role.</div>' +
                       '</div>' +
                    '</div>' +
                    '<div class="remove-col col30">' +
                       '<a ng-hide="$index==0" ng-click="$ctrl.removeRole($event, $index)" class="editable-btn btn gray-light smaller with-hover" tooltip-placement="bottom" tooltip="Remove"><span class="sbf cancel pull-left"></span></a>' +
                    '</div>' +
               '</li>' +
            '</ul>' +
            '<div>' +
                '<a class="display-inline small semibold" ng-click="$ctrl.addRole($event)" ng-hide="$ctrl.itemRoles.length >= 5">' +
    $ctrl.LCS.getISBDiv('plus-circled', 2, 'pull-left with-margin-right') +
    ' Assign Another Role</a>' +
            '</div>' +
            '<div ng-if="$ctrl.productContactListId&&!$ctrl.isNew&&$ctrl.showSetDefault" class="spacing-half-top">' +
               '<div class="custom-checkbox small with-label padding-right-5 position-relative '+ $ctrl.pageClass +'" style="margin-top: 14px"><label>' +
                    '<input type="checkbox" ng-click="$ctrl.setDefault=$ctrl.setDefault===true?false:true" ng-checked="$ctrl.setDefault">' +
                    '<span>' +
                        '<span class="padding-left10 with-padding-right">Set as default role(s)</span> ' +
                        '<div class="sbf info blueish position-absolute" tooltip-placement="bottom" tooltip="'+$ctrl.tooltip+'">'+ $ctrl.LCS.getISBPath(3) +'</div>' +
                    '</span>' +
               '</label></div>' +
            '</div>' +
        '</div>' +
    '</div>';
        }

        function preventDefault(e) {
            $ctrl.LCS.preventDefault(e);
        }
    }
}

angular.module('apiConstants.product.contacts.services', [
