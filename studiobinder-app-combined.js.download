angular.module('user.payment.quota-exceeded.component', [
    'user.payment.quotaUpdated.service'
])
.component('quotaExceededPopup', popupComponentParams('QuotaExceededPopupCtrl'))
.controller('QuotaExceededPopupCtrl', QuotaExceededPopupCtrl);
QuotaExceededPopupCtrl.$inject =['QuotaUpdatedPopupCtrlService', '$element'];

function QuotaExceededPopupCtrl(QuotaUpdatedPopupCtrlService, $element) {
    var isOpen = false,
        $ctrl = this;

    $ctrl.getDetails = getDetails;
    $ctrl.getOtherInfo = getOtherInfo;
    $ctrl = new QuotaUpdatedPopupCtrlService($ctrl, $element);

    function getOtherInfo() {
        return {
            title: 'You’ve reached your <br/>' + $ctrl.featureName.toLowerCase() + ' limit '
        };
    }

    function getDetails() {
        var desc = ' by upgrading to the ' + $ctrl.nextPlan + ' plan (or higher).';
        switch ($ctrl.quotaType) {
            case 'team':
                return {
                    title: 'You’ve reached your </br> user limit',
                    desc: 'Upgrade to the ' + $ctrl.nextPlan + ' plan (or higher) to add more team seats to your account'
                };
            case 'fileStorage':
                return {
                    title: 'You’ve reached your <br/>storage limit',
                    desc: 'Add more storage' + desc
                };
            case 'projects':
                return {
                    title: 'You’ve reached your <br/>project limit',
                    desc: 'Create more projects' + desc,
                    //  'This '+$ctrl.itemTitle+' takes you over your <b>' + ($ctrl.item ? ($ctrl.item.total + ' ') : '') +'</b> '+ $ctrl.itemTitle+' limit. It’s time to upgrade.'

                    poster: null,
                    src: 'emptystate2.mp4',
                };

            case 'breakdowns':
                return {
                    title: 'You’ve reached your <br/>scene limit',
                    desc: 'Write or import unlimited scenes on the breakdowns page' + desc
                };
            case 'stripboard':
                return {
                    title: 'You’ve reached your <br/>scene limit',
                    desc: 'Write or import unlimited scenes on the stripboard page' + desc
                };

            case 'elements':
                return {
                    title: 'You’ve reached your <br/>element limit',
                    desc: 'Add unlimited elements and create full script breakdowns' + desc
                }
            case 'contacts':
                return {
                    title: 'You’ve reached your <br/>contact limit',
                    desc: 'Add unlimited contacts' + desc
                };
            case 'shotList':
                return {
                    title: 'You’ve reached your <br/>shot limit',
                    desc: 'Add unlimited shots to your shot lists and storyboards' + desc
                };

            case 'moodboard':
                return {
                    title: 'You’ve reached your <br/>images limit',
                    desc: 'Upload more photos' + desc
                };

            case 'storyboardList':
                return {
                    title: 'You’ve reached your <br/>storyboard limit',
                    desc: 'Create unlimited panels' + desc
                };
            case 'notes':
                return {
                    title: 'You’ve reached your <br/>note limit',
                    desc: 'Create and share unlimited notes with your team' + desc
                };
            case 'scriptwriting':
                return {
                    title: 'You’ve reached your <br/>screenplays limit',
                    desc: 'Create and share unlimited screenplays with your team' + desc
                };

            case 'calendar':
                return {
                    title: 'Upgrade to unlock<br/> Unlimited Calendars',
                    desc: 'Add unlimited calendar' + desc
                };

            case 'workflow':
                return {
                    title: 'You’ve reached your <br/>task card limit',
                    desc: 'Add unlimited task cards' + desc
                };

            case 'workflowColumns':
                return {
                    title: 'You’ve reached your <br/>column limit',
                    desc: 'Add unlimited columns' + desc
                };

            case 'locations':
                return {
                    title: 'You’ve reached your <br/>location limit',
                    desc: 'Add unlimited locations' + desc
                };

            case 'avscript':
                return {
                    title: 'You’ve reached your <br/>AV script limit',
                    desc: 'Add unlimited AV scripts' + desc
                };

            case 'avscriptRows':
                return {
                    title: 'You’ve reached your <br/>rows limit',
                    desc: 'Add unlimited rows' + desc
                };

            case 'avscriptSegments':
                return {
                    title: 'Upgrade to unlock<br/> Segments',
                    desc: 'Add structure to your scripts' + desc +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>'+
                                '<li>Keep script sections contained.</li>'+
                                '<li>Move segments for the ideal order.</li>' +
                                '<li>Duplicate segments to save time.</li>' +
                                '</ul>'
                        })
                };

            case 'avscriptVersions':
                return {
                    title: 'Upgrade to unlock <br/>AV Script Versions',
                    desc: 'Add unlimited versions' + desc +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>'+
                                '<li>Organize your progress into versions.</li>'+
                                '<li>Easily view and roll back changes.</li>' +
                                '<li>Everyone sees the latest version.</li>' +
                                '</ul>'
                        })
                };

            case 'avscriptEpisodic':
                return {
                    title: 'Upgrade to unlock <br/>Episodic Structure',
                    desc: 'Develop a series of AV scripts' + desc +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>'+
                                '<li>Organize scripts into series.</li>'+
                                '<li>Catalog episodes by season.</li>' +
                                '<li>Easily search your AV scripts.</li>' +
                                '</ul>'
                        })
                };

            case 'notesFolders':
                return {
                    title: 'Upgrade to unlock<br/> Folders',
                    desc: 'Organize your documents with folders' + desc +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>'+
                                '<li>Organize documents into folders.</li>'+
                                '<li>Create your ideal filing system.</li>' +
                                '<li>Folders are shareable.</li>' +
                                '</ul>'
                        })
                };
            case 'stripboardSchedules':
                return {
                    title: 'Upgrade to unlock<br/> Multiple Schedules',
                    desc: 'Add unlimited schedules' + desc +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>' +
                                '<li>Duplicate schedules for variations.</li>'+
                                '<li>Share variants with the team.</li>' +
                                '<li>Get feedback directly in the app.</li>' +
                                '</ul>'
                        })
                };

            //Advanced Boarding
            case 'storyboardAdvanced':
                return {
                    title: 'Upgrade to unlock<br/> Advanced Boarding',
                    desc:  'Adjust aspect ratios, panel details, and more' + desc +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>'+
                                '<li>Adjust aspect ratios.</li>'+
                                '<li>Add audio and video details.</li>' +
                                '<li>Export PDFs with custom styling.</li>' +
                                '</ul>'
                        })
                };
            case 'shotAdvanced':
                return {
                    title: 'Upgrade to unlock<br/> Advanced Shot Listing',
                    desc: 'Add shot numbers, aspect ratio & PDF builder' + desc +
                    $ctrl.getAccordion({
                        isOpen: isOpen,
                        title: 'Explore Features',
                        content: '<ul>'+
                            '<li>Add estimated prep & shoot times.</li>'+
                            '<li>Select the ideal aspect ratio.</li>' +
                            '<li>Advanced PDFs with custom layouts.</li>' +
                            '</ul>'
                    }),
                };
            case 'workflowAdvanced':
                return {
                    title: 'Upgrade to unlock<br/> Advanced Tasks',
                    desc: 'Add multiple checklists, attachments, etc.' + desc +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>' +
                                '<li>Add multiple checklists.</li>'+
                                '<li>Attach files or images.</li>' +
                                '<li>Select start dates and times.</li>' +
                                '</ul>'
                        })
                };

            //Groups
            case 'moodboardGroups':
                return {
                    title: 'Upgrade to unlock<br/> Mood Board Groups',
                    desc: 'Organize your mood boards into groups ' + desc +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>'+
                                '<li>Create custom mood board groups.</li>'+
                                '<li>Group by settings, props, etc.</li>' +
                                '<li>Arrange list of groups as needed.</li>' +
                                '</ul>'
                        })
                };
            case 'taskBoards':
                return {
                    title: 'Upgrade to unlock<br/> Unlimited Task Boards',
                    desc: 'Add unlimited task boards' + desc
                };

            //Custom Lists
            case 'contactLists':
                return {
                    title: 'Upgrade to unlock<br/> Custom Lists',
                    desc: 'Organize your contacts with custom lists ' +desc+
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>'+
                                '<li>Create custom lists for contacts.</li>'+
                                '<li>Easily duplicate or share lists.</li>' +
                                '<li>Advanced PDFs with custom layouts.</li>' +
                                '</ul>'
                        })
                };

            case 'callsheetGroups':
                return {
                    title: 'Upgrade to unlock<br/> Call Sheet Groups',
                    desc:  'Organize your call sheets into groups ' + desc
                };

            case 'elementsCategories':
                return {
                    title: 'Upgrade to unlock<br/> Custom Categories',
                    desc:  'Organize your elements into custom categories ' + desc
                };
        }
        return null;
    }
}


angular.module('user.payment.quota.service', [
    'user.payment.quota-exceeded.component',
    'user.payment.feature-unavailable.component',
    'user.payment.company-feature-unavailable.component',
])
.service('QuotaCtrlPopupService', QuotaCtrlPopupService);
QuotaCtrlPopupService.$inject =['ItemTemplateCompileCtrlService'];
function QuotaCtrlPopupService(ItemTemplateCompileCtrlService) {
    return function ($ctrl, $element){
        console.log('QuotaCtrlPopupService');
        var info;
        $ctrl.isPopup = true;
        $ctrl.btnText = 'View Plans';

        $ctrl.goToPrices = goToPrices;
        $ctrl.preInit = preInit;
        $ctrl.setTemplateData = setTemplateData;
        $ctrl.getPopupBodyContent = getPopupBodyContent;

        $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

        return $ctrl;

        function setTemplateData() {
            if(!$ctrl.getOtherInfo) {
                console.warn('Parent for QuotaCtrlPopupService must define $ctrl.getOtherInfo');
            }

            info = $ctrl.getOtherInfo();
            if(!info.icon) {
                info.icon = 'card';
                $ctrl.iconLevel = 3;
            }
            $ctrl.icon = info.icon;
            $ctrl.popupTitle = info.title;
            $ctrl.withFooterBtns = true;
            $ctrl.firstBtnMethod = 'goToPrices';
            $ctrl.btnText = info.btn;
            $ctrl.goToPricesT = goToPricesT;
        }

        function goToPricesT(id, e){
            $ctrl.goToPrices(e, true);
        }

        function getPopupBodyContent() {
            return '<p class="text-center medium-size">' + info.desc + '</p>';
        }

        function preInit() {
            var total = $ctrl.item ? $ctrl.item.total : '';
            $ctrl.details = {
                projects: {
                    title: "You've Reached the Project Limit",
                    desc: "This project takes you over your " + total + " project limit. It's time to upgrade. <br/>Premium plans start at only $20/mo.",
                    btn: $ctrl.btnText,
                    img: "project",
                    page: 'user.pricing'
                },
                attachments: {
                    title: "You've Reached the Attachments Limit",
                    desc: "This file takes you over your " + total + " storage limit. It's time to upgrade. <br/>Premium plans start at only $20/mo.",
                    btn: $ctrl.btnText,
                    img: "attach",
                    page: 'user.pricing'
                },
                team: {
                    title: "You've Reached the Teammates Limit",
                    desc: "This teammate takes you over your " + total + " teammates limit. It's time to upgrade. <br/>Premium plans start at only $20/mo.",
                    btn: $ctrl.btnText,
                    img: "team",
                    page: 'user.pricing'
                },
                collaborators: {
                    title: "You've Reached the Teammates Limit",
                    desc: "This teammate takes you over your " + total + " teammates limit. It's time to upgrade. <br/>Premium plans start at only $20/mo.",
                    btn: $ctrl.btnText,
                    img: "team",
                    page: 'user.pricing'
                },
                reviewers: {
                    title: "You've Reached the Teammates Limit",
                    desc: "This teammate takes you over your " + total + " teammates limit. It's time to upgrade. <br/>Premium plans start at only $20/mo.",
                    btn: $ctrl.btnText,
                    img: "team",
                    page: 'user.pricing'
                }
            };
        }

        function goToPrices(e, comp) {
            var params = $ctrl.CPS.currentPathParams();
            if (comp) {
                params.comp = 1;
            }
            $ctrl.CPS.transitionTo($ctrl.details[$ctrl.type] ? $ctrl.details[$ctrl.type].page : 'user.pricing', params);
            $ctrl.close(e);
        }
    }
}


angular.module('user.payment.quotaUpdated.service', [
    'user.payment.quotaUpdatedInit.service',
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'services.blocksSetup'
])
.service('QuotaUpdatedPopupCtrlService', QuotaUpdatedPopupCtrlService);
QuotaUpdatedPopupCtrlService.$inject =['GeneralItemEditCtrlService', 'QuotaUpdatedInitCtrlService', 'RouteCollaboratorsService'];
function QuotaUpdatedPopupCtrlService(GeneralItemEditCtrlService, QuotaUpdatedInitCtrlService, RouteCollaboratorsService) {
    return function ($ctrl, $element){
        console.log('QuotaUpdatedPopupCtrlService');

        $ctrl.RouteCollaboratorsService  = RouteCollaboratorsService;
        $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;

        $ctrl.isPopup = true;

        $ctrl.dontAutoloadTemplate = false;
        $ctrl.hideHeader = true;
        $ctrl.hideFooter = true;
        $ctrl.modalBodyFormClass = 'full-width';
        $ctrl.withFooterBtns = false;
        $ctrl.btnText = 'View Plans';

        $ctrl.getItemPopupTemplate = getItemPopupTemplate;
        $ctrl.preSetTemplateData = preSetTemplateData;

        $ctrl = new QuotaUpdatedInitCtrlService($ctrl, $element, GeneralItemEditCtrlService, $ctrl.isPopup);

        return $ctrl;

        function preSetTemplateData() {
            $ctrl.withCloseBtn = true;
        }

        function getItemPopupTemplate() {
            $ctrl.quotaType = $ctrl.extraParam.quotaType;

            $ctrl.recordClick($ctrl.TrackingEvents.OpenPopup);
            return $ctrl.getItemPopupMSForm([{
                body: getBody(getOtherInfo())
            }], 'quota-updated', false);
        }

        function getOtherInfo() {
            $ctrl.feature = $ctrl.getFeature($ctrl.quotaType);
            $ctrl.featureName = $ctrl.getFeatureName($ctrl.feature, $ctrl.quotaType);
            $ctrl.nextPlan = '<b>' + $ctrl.getNextPlanWithQuota() + '</b>';
            if ($ctrl.itemTitle) {
                $ctrl.itemTitle = $ctrl.itemTitle.toLowerCase();
            }
            var block = _.extend({}, $ctrl.BlocksSetupService.getBlockByType($ctrl.overviewBlockTypeNew || $ctrl.overviewBlockType), $ctrl.extraParam.hideButton ? {hideButton: true} : null);

            if (!block.type && $ctrl.feature.overviewBlockId && $ctrl.feature.overviewBlockId !== block._id) {
                block = $ctrl.BlocksSetupService.overviewBlocks[$ctrl.feature.overviewBlockId];
            }
            var details = typeof ($ctrl.getDetails) ? $ctrl.getDetails(block.hideButton) : null;

            var withImg = $ctrl.feature ? $ctrl.feature.withImg : false,
                withImgBlock = withImg || $ctrl.videoUrl;
            if (withImgBlock) {
                $ctrl.LCS.addClass($ctrl.element, 'with-img');
            }
            var b = $ctrl.BlocksSetupService.overviewBlocks[block.parentNavId];
            if(!b && block.parentNavId1){ //for taskboards
                b = $ctrl.BlocksSetupService.overviewBlocks[block.parentNavId1] ;
            }
            var src = $ctrl.src ? $ctrl.src : 'emptystate';
            return _.extend({}, block, {
                    parentBlockType: block.isSolution ? block.type : (b ? b.type : null),
                    btn: $ctrl.btnText,
                    name: $ctrl.feature ? $ctrl.feature.shortDesc : block.name,
                    isPro: true,
                    poster: src + '.jpg',
                    src:  src + '.mp4',
                    videoUrl: $ctrl.videoUrl,
                    imgPath: withImg ? $ctrl.feature.name : null,
                    withImgBlock: withImgBlock
                },
                !block.hideButton && typeof ($ctrl.getOtherInfo) === 'function' ? $ctrl.getOtherInfo() : '',
                details);
        }

        function getBody(block) {
            var pageClass =  $ctrl.pageClass ? $ctrl.pageClass : (block.pageClass ? block.pageClass : ''),
            img = block.withImgBlock ? ('plan-features/' +($ctrl.videoUrl ? (block.parentBlockType+'-bg') : block.imgPath)) :
                ( block.emptyStateImage ?  ('emptystate/' + block.type + '/emptystate') : ''),
            imgUrl = img ? $ctrl.LCS.getImgUrl(img + '.' + ($ctrl.videoUrl&&block.parentBlockType==='visualize'?'jpg':'png'),
            //    ($ctrl.LCS.webPEnabled ? 'webp':'png')
            null, true) : null;
        return '<div>' +
                    '<div class="empty-state">' +
                        '<div class="center">' +
                            '<div class="left centered">' +
                                '<div class="header">' +
                                    '<div class="circled-svg-colored small60 ' + pageClass  + '">' +
                                    (block.icon ? $ctrl.LCS.getISBDiv(block.icon, block.iconLevel, 'colored') : '') +
                                    '</div>' +
                                    '<div class="info">' +
                                        '<h3 class="infoh" style="color:' + (block.color || 'var(--primaryColor)') + '">' + block.name +
                                        (block.isPro ? '<span class="with-margin-left profeature">PRO</span>' : '') +
                                        '</h3>' +
                                (block.title ?  ('<div class="desc">' + block.title + '</div>') : '') +
                                    '</div>' +
                                '</div>' +
                        (block.desc ? ('<div class="body">'+ block.desc + '</div>') : '')  +
                        (!block.hideButton ? ('<div class="spacing-quarter-top text-left empty-buttons-div">' + (block.btns ? block.btns : getButtons()) + '</div>') : '') +
                            '</div>' +
                            '<div class="right centered '+(block.withImgBlock ? 'with-img' :'')+'" ' +
    (block.withImgBlock ? (' style="background-image: url(' + imgUrl + ')"') : '') + '>' +
                    (img && !$ctrl.videoUrl ? (block.imgPath ? ('<div>&nbsp;</div>' ): ('<img src="' +imgUrl + '"/>')) :
                            //'<iframe loading="lazy" src="' + block.videoUrl + '" width="{{$ctrl.isMobileView()?\'100%\':\'398\'}}" height="222" frameborder="0" webkitallowfullscreen mozallowfullscreen allowfullscreen></iframe>'
                            $ctrl.getVideo($ctrl, block)
                    ) +
                    '</div>' +
                '</div>' +
              '</div>' +
            '</div>';

            function getButtons() {
                return '<button class="btn btn-primary without-text btnPrice ' + pageClass +
                    (block.icon ? (' ' + block.icon) : '') + '" analytics-on analytics-action="onAction">' + block.btn + '</button>';
            }
        }
    }
}

angular.module('user.payment.upgradeWizard.component', [
    'apiServices.Plans',
    'apiServices.Subscriptions',
    'services.sessionService',
    'apiServices.QuotaTrackings',
    'user.payment.init.controller.service'
])
.component('upgradeWizardPopup', popupComponentParams('UpgradeWizardPopupCtrl'))
.controller('UpgradeWizardPopupCtrl', UpgradeWizardPopupCtrl);
UpgradeWizardPopupCtrl.$inject = ['ItemTemplateCompileCtrlService', 'SubscriptionsService', 'PaymentInitCtrlService', 'CompInitCtrlService', 'QuotaTrackingsService', 'RouteCollaboratorsService','Angularytics', '$element'];

function UpgradeWizardPopupCtrl(ItemTemplateCompileCtrlService, SubscriptionsService, PaymentInitCtrlService, CompInitCtrlService, QuotaTrackingsService, RouteCollaboratorsService, Angularytics, $element) {
    console.log('UpgradeWizardCtrl');
    var $ctrl = this;
    $ctrl.PaymentInitCtrlService = PaymentInitCtrlService;
    $ctrl.Angularytics = Angularytics;
    $ctrl.SubscriptionsService = SubscriptionsService;
    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
    $ctrl.QuotaTrackingsService = QuotaTrackingsService;

    $ctrl.isPopup = true;
    $ctrl = new CompInitCtrlService($ctrl);
    $ctrl.checkFields = [ 'coupon','plans'];
    $ctrl.previousFields={};
    $ctrl.PaymentTypes = [
        {value: true, text: 'Billed Monthly'},
        {value: false, text: 'Billed Annually'}
    ];

    $ctrl.showProRata = showProRata;
    $ctrl.shotTotalDue = shotTotalDue;
    $ctrl.getTotalInit = getTotalInit;
    $ctrl.getBaseInfo = getBaseInfo;
    $ctrl.getAdSeatInfo = getAdSeatInfo;
    $ctrl.getBaseAmount = getBaseAmount;
    $ctrl.getCouponDiscount = getCouponDiscount;
    $ctrl.getTotal = getTotal;
    $ctrl.getTotalDue = getTotalDue;

    $ctrl.applyPlan = applyPlan;
    $ctrl.goToTeam = goToTeam;
    $ctrl.isUpgradeDisabled = isUpgradeDisabled;
    $ctrl.mustRemoveTeam = mustRemoveTeam;
    $ctrl.isCurrentPlan = isCurrentPlan;

    $ctrl.changeMonthly = changeMonthly;
    $ctrl.goToProjects = goToProjects;
    $ctrl.recomputePrice = recomputePrice;
    $ctrl.onTeamCountChanged = onTeamCountChanged;
    $ctrl.preInit = preInit;
    $ctrl.toggleCoupon = toggleCoupon;
    $ctrl.toggleEditCard = toggleEditCard;

    $ctrl.dontAutoloadTemplate = true;
    $ctrl.getItemPopupTemplate = getItemPopupTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.isFullDiscount = isFullDiscount;
    $ctrl.getPriceForPlan = getPriceForPlan;

    $ctrl.TrackingEvents = {OpenPopup: 1, ViewPlans: 2, ViewUpgrade: 3, UpgradeError: 4, Upgraded: 5};
    $ctrl.recordClick = recordClick;
    $ctrl.getFeature = getFeature;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function recordClick(type, tracking) {
        console.log('recordClick');
        var quotaType = $ctrl.quotaType ? $ctrl.quotaType : (tracking ? tracking.quotaType : null);
        if (!quotaType) {
            return;
        }
        if (!tracking) {
            tracking = $ctrl.extraParam ? $ctrl.extraParam.tracking : null;
        }
        var stateName = $ctrl.CPS.currentStateName,

            todoPage = $ctrl.RouteCollaboratorsService.getTodoPages()[
                (stateName.indexOf('user.product.callsheet.') !== -1 || stateName.indexOf('user.product.callsheets-list')!== -1) ? 'user.product.callsheet.view' : stateName
                ],
            params = _.extend({
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.CPS.productId,
                todoPageId: todoPage ? todoPage._id : null,
                eventType: type,
                featureId: quotaType ? $ctrl.getFeature(quotaType)._id : null
            }, tracking);
        delete params.quotaType;

        $ctrl.QuotaTrackingsService.track(params, function (result) {

        });
    }

    function getPriceForPlan(){
        $ctrl.prices = getPricesVal();

        $ctrl.recomputePrice();
        return $ctrl.getTotalDue();

    }
    function setPopupIndex() {
        if ($ctrl.isPopupSet) {
            return;
        }

        var index = $ctrl.extraParam ? $ctrl.extraParam.popupIndex : null;
        if (!index) {
            return;
        }
        var modal = $ctrl.LCS.findClosestParent($ctrl.element, '.modal');
        if (modal) {
            modal.style.zIndex = index + 1;
        }


        var bg = modal.nextElementSibling;
        while(!bgset(bg)){
            bg = bg.nextElementSibling;
        }

        $ctrl.isPopupSet = true;

        function bgset(bg) {
            if(!bg){return true;}
            if (bg.classList.contains('modal-backdrop')) {
                bg.style.zIndex = index;
                return true;
            }
            return false;
        }
    }

    function getPlan(){
       return $ctrl.upgradePlan[$ctrl.upgradePlan.showMonthly ? 'month' : 'year'];
    }
    function preInit() {
        $ctrl.reloadTemplate();

        $ctrl.PaymentInitCtrlService.loadPayment($ctrl, next, true);

        function next() {
            console.log('on PaymentInitCtrlService');

            $ctrl.showPencil = true;
            $ctrl.whichForm = 1;

            var team = $ctrl.subFeatures && $ctrl.subFeatures.team ? $ctrl.subFeatures.team : null;
            $ctrl.usedTeamCount  = team && team.used ? team.used : 1;
            $ctrl.totalTeamCount = team && team.total ? team.total : 1;
            $ctrl.dontLoadPlans = true;
            $ctrl.showMonthly = $ctrl.extraParam.showMonthly;
            $ctrl.isDowngrade = $ctrl.extraParam.isDowngrade;
            $ctrl.customer = $ctrl.extraParam.customer;

            $ctrl.isTeamState = $ctrl.SBStateService.isCurrentState('user.team');
            $ctrl.isAddSeats = $ctrl.extraParam.isAddSeats;
            $ctrl.upgradePlan = $ctrl.extraParam.upgradePlan;

            $ctrl.upgradePlan.showMonthly = $ctrl.showMonthly;
            var plan = getPlan();

            $ctrl.upgradePlan.teamCount =  $ctrl.isDowngrade && plan.name === 'Free' ? 1 : $ctrl.totalTeamCount;

            $ctrl.popupTitle = ($ctrl.isDowngrade ? 'Downgrade' : 'Upgrade') + ' to ' + plan.name + ' Plan';

            $ctrl.prices = getPricesVal();

            $ctrl.recomputePrice();
            $ctrl.isLoaded = true;

            recordClickNow($ctrl.TrackingEvents.ViewUpgrade, plan);

            $ctrl.reloadTemplate();
        }
    }

    function onLoaded(){
        $ctrl.Angularytics.trackSubEvent('add_to_cart', $ctrl.security.getCurrentUserId(), $ctrl.SBStateService.getCurrentStateName(), null, {
            //event_vaue: 'add_to_cart',
            event_action: $ctrl.popupTitle
        });
        setPopupIndex();
    }

    function getPricesVal(){
        return {
            initTotal: getTotal($ctrl.upgradePlan.showMonthly),
            total: 0,
            totalAfterDiscount: 0,
            discounted: 0,
            annualSavings: 0,
            couponDuration: 1
        }
    }

    function onTeamCountChanged(val) {
        $ctrl.upgradePlan.teamCount =  val;
        $ctrl.recomputePrice();
    }

    function goToProjects(type, e) {
        goToPage('user.projects');
    }

    function goToTeam(type, e) {
        $ctrl.popupsService.teamAdminAccess(function () {
            goToPage('user.team');
        });
    }

    function goToPage(page) {
        $ctrl.close(null);
        $ctrl.CPS.transitionTo(page, $ctrl.CPS.currentPathParams());
    }

    function changeMonthly(result) {
        var newVal = result.selected.val;
        if (newVal !== $ctrl.upgradePlan.showMonthly) {
            $ctrl.upgradePlan.showMonthly = newVal;
            $ctrl.recomputePrice();
        }
    }

    function getTotal(showMonthly) {
        return $ctrl.getMonthlyTotal($ctrl.upgradePlan, showMonthly) * (showMonthly ? 1 : 12);
    }

    function recomputePrice() {
        var showMonthly = $ctrl.upgradePlan.showMonthly;
        if(!$ctrl.prices){return;}
        setMinMaxTeamCount(showMonthly);
        var monthly = $ctrl.getMonthlyTotal($ctrl.upgradePlan, showMonthly),//price for one month with annual discount
            months = showMonthly ? 1 : 12;
        $ctrl.prices.total = monthly * months; //total price

        $ctrl.prices.totalAfterDiscount = $ctrl.prices.total;
        if ($ctrl.coupon && $ctrl.coupon.valid) {
            $ctrl.prices.couponDuration = showMonthly ? 1 : ($ctrl.coupon.duration ? $ctrl.coupon.duration : 1);
            if ($ctrl.coupon.percentOff) {
                var monthlyDiscount = $ctrl.coupon.percentOff * monthly / 100;
                //how much is discounted for all months
                $ctrl.prices.discounted = ($ctrl.prices.couponDuration > months ? months : $ctrl.prices.couponDuration) * monthlyDiscount;
                $ctrl.prices.totalAfterDiscount = $ctrl.prices.total - $ctrl.prices.discounted;
            }
            else {//amount off
                $ctrl.prices.totalAfterDiscount = $ctrl.prices.total - $ctrl.coupon.amountOff;
                if($ctrl.prices.totalAfterDiscount < 0){
                    $ctrl.prices.totalAfterDiscount = 0;
                }
                $ctrl.prices.discounted = $ctrl.prices.total - $ctrl.prices.totalAfterDiscount;
            }
        }

        $ctrl.prices.annualSavings =  showMonthly ? 0 : $ctrl.getAnnualSavings($ctrl.upgradePlan);
        $ctrl.prices.totalDue = $ctrl.prices.totalAfterDiscount;

        setVisibility();

        function setVisibility(){

        }

        function setMinMaxTeamCount(showMonthly) {
            var plan = $ctrl.upgradePlan[showMonthly ? 'month' : 'year'], features = plan.features;
            $ctrl.prices.maxTeamCount = features.maxTeam ? features.maxTeam.count : (plan.isCompany ? 100 : 1);
            $ctrl.prices.minTeamCount = features.team ? features.team.count : 1;
            //should have at least minTeamCount
            if ($ctrl.prices.minTeamCount > $ctrl.upgradePlan.teamCount) {
                $ctrl.upgradePlan.teamCount = $ctrl.prices.minTeamCount;
            }
            //should have at most maxTeamCount
            if ($ctrl.upgradePlan.teamCount > $ctrl.prices.maxTeamCount) {
                $ctrl.upgradePlan.teamCount = $ctrl.prices.maxTeamCount;
            }
        }
    }


    function applyPlan(info, e) {
        $ctrl.formHolder.card_attempted = false;
        if ($ctrl.isUpdating) {return;}
        $ctrl.isUpdating = true;
        if($ctrl.upgradePlan.teamCount > $ctrl.prices.maxTeamCount){
            $ctrl.upgradePlan.teamCount = $ctrl.prices.maxTeamCount;
        }

        $ctrl.plan = getPlan();

        e.currentTarget.setAttribute('analytics-action', $ctrl.plan.name);

        $ctrl.error = null;
        if (isFullDiscount() || $ctrl.plan.name === 'Free' || !$ctrl.info.addCard){
            submitSubscription();
        } else {
            if (isValidCard()) {
                $ctrl.insertCC(submitSubscription);
            } else {
                $ctrl.error = 'Please fill in the required credit card info';
                $ctrl.isUpdating = false;
            }
        }

        function submitSubscription(card) {
            var subscription = {
                plan: $ctrl.plan._id,
                companyId: $ctrl.CPS.companyId,
            };
            if($ctrl.extraParam.isCustom){
                subscription.isCustom = true;
            }
            if (card) {
                subscription.card = card;
            }
            if ($ctrl.coupon && $ctrl.coupon.valid) {
                subscription.coupon = $ctrl.coupon.id;
            }
            subscription.metadata = {
                teamCount: $ctrl.upgradePlan.teamCount
            };

            $ctrl.SubscriptionsService.updateSubscription(subscription, onSuccess, onError);

            function onSuccess(newSub) {
                $ctrl.isUpdating = false;
                if (newSub) {
                    recordClickNow($ctrl.TrackingEvents.Upgraded, $ctrl.plan);
                    $ctrl.Angularytics.trackSubEvent(
                        ($ctrl.plan.name === 'Free' ? 'canceled' : ($ctrl.isDowngrade ? 'downgraded' : 'upgraded')) + ' subscription', $ctrl.security.getCurrentUserId(), $ctrl.SBStateService.getCurrentStateName(), null, {
                            event_action: $ctrl.plan.name + ' with ' + $ctrl.upgradePlan.teamCount + ' users'
                        });

                    $ctrl.reloadSubscription(onReload);

                    function onReload(res) {
                        $ctrl.whichForm = 2;
                        var type = newSub.subscriptionChange;
                        switch (type) {
                            case 'Upgrade':
                                $ctrl.whichForm = 2;
                                break;
                            case 'Downgrade':
                                $ctrl.whichForm = 3;
                                break;
                        }

                        if($ctrl.extraParam){
                            if($ctrl.extraParam.closeOnSuccess){
                                if(typeof ($ctrl.onClose) === 'function'){
                                    $ctrl.onClose();
                                }
                            } else{
                                //reload on payment page
                                $ctrl.SBStateService.reloadCurrentState();
                            }
                            if(typeof($ctrl.extraParam.onSuccess) === 'function'){
                                $ctrl.extraParam.onSuccess(subscription);
                            }
                        }
                        toggleTab();
                    }
                } else {
                    $ctrl.error = $ctrl.localizedMessages.getFromError(null, 'crud.subscription.error');
                    recordClickNow($ctrl.TrackingEvents.UpgradeError, $ctrl.plan);
                }
            }

            function onError (err) {
                $ctrl.isUpdating = false;
                $ctrl.error = $ctrl.localizedMessages.getFromError(err ? (err.type && err.type.indexOf('Stripe') !== -1 ? (err.raw ? err.raw.message : err.error) : err.error) : null, 'crud.subscription.error');
                recordClickNow($ctrl.TrackingEvents.UpgradeError, $ctrl.plan);
            }
        }
    }

    function recordClickNow(type, plan){
        if($ctrl.extraParam.tracking){
            $ctrl.recordClick(type, _.extend({
                    planId: plan ? plan._id : null
                }, $ctrl.extraParam.tracking));
        }
    }

    function getFeature(quotaType) {
        if (!$ctrl.planFeatures) {
            $ctrl.planFeatures = getPlanFeaturesData();
        }
        return $ctrl.planFeatures ? _.find($ctrl.planFeatures, {name: quotaType}) : null;
    }

    function isValidCard() {
        return $ctrl.formHolder && $ctrl.formHolder.card && $ctrl.formHolder.card.$valid &&
            $ctrl.formHolder.card.card && $ctrl.formHolder.card.card.$modelValue && $ctrl.formHolder.card.card.$valid &&
            $ctrl.formHolder.card.expiry && $ctrl.formHolder.card.expiry.$modelValue && $ctrl.formHolder.card.expiry.$valid &&
            $ctrl.formHolder.card.cvc && $ctrl.formHolder.card.cvc.$modelValue && $ctrl.formHolder.card.cvc.$valid;
    }


    function isUpgradeDisabled() {
        if ($ctrl.isCurrentPlan() || $ctrl.mustRemoveTeam() || $ctrl.isUpdating) {
            return true;
        }
        if (isFullDiscount()) {
            return false;
        }
        var plan = getPlan();
        return plan.name !== 'Free' && $ctrl.info.addCard && !isValidCard();
    }

    function isFullDiscount(){
        return $ctrl.coupon && !$ctrl.coupon.isUpdating &&
        $ctrl.coupon.percentOff === 100 &&
        ($ctrl.upgradePlan.showMonthly || !$ctrl.upgradePlan.showMonthly && $ctrl.coupon.duration >= 12);
    }

    function mustRemoveTeam() {
        return $ctrl.upgradePlan.teamCount < $ctrl.usedTeamCount;
    }

    function isCurrentPlan() {
        var interval = ($ctrl.upgradePlan.showMonthly ? 'month' : 'year');
        return $ctrl.totalTeamCount === $ctrl.upgradePlan.teamCount &&
            $ctrl.currentPlan && $ctrl.currentPlan.interval === interval && $ctrl.currentPlan._id === $ctrl.upgradePlan[interval]._id;
    }

    function toggleTab(){
        var cls = 'sb-hide';
        $ctrl.LCS.addClass($ctrl.element.querySelectorAll('.custom-tab:not(.'+cls+')'), cls);
        $ctrl.LCS.removeClass($ctrl.element.querySelector('.custom-tab[data-tab="' + $ctrl.whichForm + '"]'), cls);
    }

    function getItemPopupTemplate() {
        var el = '';

        if(!$ctrl.isLoaded){
            el += '<loading-more></loading-more>';
        } else{
            el += $ctrl.nonMobileCloseBtn() +
                $ctrl.getMobileBack()+
                '<div class="switch-container1 '+($ctrl.ignoreMissingWhich)+'">' +
                    getTab(1,
                        getHeader() +
                        '<div class="modal-body clearfix upgrade-popup font-general font-general-14">' +
                            ($ctrl.isAddSeats ? '' : getPlanNames()) +
                            seatsSection() +
                            getCardsSection() +
                            getSummary() +
                            getPrices() +
                        '</div>' +
                        getFooter()) +
                    getPlanUpgradedTab() +
                    getPlanDowngradedTab() +
                '</div>';
        }

        return '<div class="full-width">' + el + '</div>';

        function getTab(tab, content, withMax){
            return '<div data-tab="' + tab + '" class="custom-tab ' + (withMax ? 'spacing-big centering' : '') +
                ($ctrl.whichForm !== tab ? ' sb-hide' : '') + '"' +
                (withMax?' style="max-width: 560px"' : '') + '>' + content + '</div>';
        }

        function getHeader(){
            var title = ($ctrl.isAddSeats ? ('Add Team Seats' ) :
                    (($ctrl.isDowngrade ? 'Downgrade ' : 'Upgrade ')+
                        //'to ' + $ctrl.newPlan.name +' '
                        'Plan')),
            subtitle = $ctrl.isAddSeats ? ('<p class="spacing-half-bottom">Your account currently has ' +$ctrl.usedTeamCount+ ' user' + ($ctrl.usedTeamCount === 1?'':'s') + ' (including you)</p>' +
                '<p>Newly added seats are available immediately and are billed pro rata</p>'
        ) :($ctrl.isDowngrade ? 'You will immediately lose access to the features on your current plan as soon as you downgrade.' : '');
            return '<div class="modal-header clearfix spacing-half-bottom form-wrapper" style="max-width: 420px">' +
                '<div class="centered circled-svg-colored small76">'+$ctrl.LCS.getISBDiv('plans', 3)+'</div>' +
                '<h3 class="text-center">' + title + '</h3>' +
                (subtitle ? ('<div class="subheader-popup text-center centered">'+subtitle+'</div>') : '') +
                '</div>';
        }

        function seatsSection(){
            return '<div class="colmax440 form-wrapper">' +
                        '<div class="price-table with-border-bottom">' +
                            '<div class="semibold font-size-16">Total users on this plan' +
                                '<div class="col20 with-padding-left inline-block" tooltip-html="\'On this plan you can add a maximum of \' + $ctrl.prices.maxTeamCount + \' team members.\'" tooltip-placement="bottom">' + $ctrl.LCS.getISBDiv('info-circle', 4, 'gray', 'style="position:relative; top:3px"') + '</div>' +
                            '</div>' +
                            '<div>' +
                                '<stepper class="input-group spinner-input thinner pull-right" min="::$ctrl.prices.minTeamCount" max="::$ctrl.prices.maxTeamCount" value="$ctrl.upgradePlan.teamCount" on-updated="$ctrl.onTeamCountChanged(val)"></stepper>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                    '<div class="colmax440 form-wrapper wrapperRemoveTeam" ng-show="$ctrl.mustRemoveTeam()">' +
                        'All of your team seats are currently occupied.<br/> <a data-type="goToTeam" class="gray-light '+$ctrl.getBtnActionCls()+' margin-quarter display-block underlined"> Please remove {{$ctrl.usedTeamCount - $ctrl.upgradePlan.teamCount ==1 ? \'a\' : ($ctrl.usedTeamCount - $ctrl.upgradePlan.teamCount)}} teammate{{$ctrl.usedTeamCount - $ctrl.upgradePlan.teamCount ==1 ? \'\' : \'s\'}} first</a>' +
                    '</div>';
        }

        //todo finsih
        function getCardsSection() {
            return $ctrl.isDowngrade && getPlan().name === 'Free' ? '' :
                ('<div class="colmax440 form-wrapper wrapperPaymentDetails"><div class="semibold font-size-16 full-width spacing-bottom-14">Payment Details</div></div>' +
                    '<div class="colmax440 centered credit-card-section">' + $ctrl.getCreditCardForm() + '</div>' +
                    '<div class="wrapperCoupon colmax440 coupon form-wrapper spacing-bottom-14 ' + ($ctrl.showCoupon ? '' : 'sb-hide') + '">' + $ctrl.getCouponForm() + '</div>' +
                    '<div class="colmax440 form-wrapper semibold with-border-bottom">' +
                    '<a class="' + $ctrl.getBtnActionCls() + ' btnCard ' + ($ctrl.oldCC ? '' : 'sb-hide') + '" data-type="toggleEditCard">' + getCardText() + '</a>' +
                    '<span class="orspan light'+ ($ctrl.oldCC ? '' : ' sb-hide') + '"> | </span>' +
                    '<a class="' + $ctrl.getBtnActionCls() + ' btnCoupon" data-type="toggleCoupon"><span>' + getBtnCouponText() + '</span> Offer Code</a>' +
                    '</div>'
                );
        }
        function getSummary(){
      return '<div class="colmax440 form-wrapper">' +
                '<div class="semibold font-size-16 full-width margin-bottom-14">Updated Plan Summary</div>' +
                '<div class="price-table font-size-13 margin-bottom-14">' +
                   '<div>' +
                        '<span ng-bind="$ctrl.upgradePlan[$ctrl.upgradePlan.showMonthly?\'month\':\'year\'].name"></span> ' +
                        '<span class="validator1 gray with-padding-left" ng-bind="$ctrl.getBaseInfo()"></span>' +
                   '</div>' +
                   '<div class="text-center col100">$<span ng-bind="$ctrl.getBaseAmount()"></span></div>' +
               '</div>' +

                '<div class="price-table font-size-13 margin-bottom-14" ng-if="$ctrl.getAdSeatInfo()">' +
                   '<div>' +
                        '{{$ctrl.getAdditionalTeamCount($ctrl.upgradePlan, $ctrl.showMonthly)}} additional seat{{$ctrl.getAdditionalTeamCount($ctrl.upgradePlan, $ctrl.showMonthly)===1?\'\':\'s\'}}' +
                        '<span class="validator1 gray with-padding-left" ng-bind="$ctrl.getAdSeatInfo()"></span>' +
                    '</div>' +
                    '<div class="text-center col100">$<span ng-bind="$ctrl.getBaseAmount(true)"></span>' + '</div>' +
                '</div>' +
            '</div>';
        }

        function getPerMo(){
            return '';//'<span class="symbolmo">/{{$ctrl.upgradePlan.showMonthly?\'mo\':\'yr\'}}</span>';
        }

        function getPrices(){
    return '<div class="colmax440 form-wrapper font-size-13" ng-if="!$ctrl.upgradePlan.showMonthly">' +
                '<div class="price-table margin-bottom-14">' +
                    '<div>Annual Discount' +
                        '<span class="validator1 success with-padding-left">{{$ctrl.upgradePlan.year.yearly_discount}}% off every 12 months</span>' +
                    '</div>' +
                    '<div class="text-center col100">- $<span ng-bind="$ctrl.getFormattedCurrency($ctrl.prices.annualSavings)"></span></div>' +
                '</div>' +
           '</div>' +

           '<div class="colmax440 form-wrapper font-size-13">' +
             /*  '<div class="price-table semibold margin-bottom-half">' +
                   '<div>Total per <span ng-bind="$ctrl.upgradePlan.showMonthly?\'month\':\'year\'"></span></div>' +
                   '<div class="text-center col120">$<span ng-bind="$ctrl.getTotalInit()"></span></div>' +
               '</div>' +*/

                '<div class="price-table margin-bottom-half" ng-show="$ctrl.coupon.valid">' +
                    '<div>'+$ctrl.LCS.getISBDiv('coupon', 1, 'gray sbf14')+'<span class="with-padding-left">"{{$ctrl.coupon.id}}" Discount' + '</span><span class="validator1 success with-padding-left">{{$ctrl.coupon.amountOff > 0 ? $ctrl.coupon.amountOff : ($ctrl.coupon.percentOff + \'%\')}} off for {{$ctrl.prices.couponDuration}} month{{$ctrl.prices.couponDuration!==1 ? \'s\' : \'\'}}</span>' +
                    '</div>' +
                    '<div class="text-center col100">- $<span ng-bind="$ctrl.getCouponDiscount()"></span></div>' +
                '</div>' +


               '<div class="price-table"' +
                //' ng-show="$ctrl.shotTotalDue()"' +
                '>' +
                   '<div>' +
                       '<div class="plan-name full-width">Total due</div>' +
                   '</div>' +
                   '<div class="text-center col120 price-s medium"><span class="symbol">$</span><span class="amount" ng-bind="$ctrl.getTotalDue()"></span>' +
                   '</div>' +
               '</div>' +

               '<div class="price-table" ng-show="$ctrl.showProRata()">' +
                    '<div>' +
                        '<div class="plan-name full-width">'+
                           '<div class="italic font-size-11">All prices are in USD. Final amount billed pro-rata' +
                               '<div class="col20 with-padding-left inline-block" tooltip-html="\'This total will be adjusted when billed. We will credit the unused balance of your current billing period towards the new pricing\'" tooltip-placement="bottom">' +
                                    $ctrl.LCS.getISBDiv('info-circle', 4, 'gray', 'style="position:relative; top:3px"') +
                               '</div>' +
                           '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>';
        }

        function getFooter(){
        return '<div class="modal-footer clearfix semi-tall margin-top margin-bottom-0 padding-bottom-30">' +
                    '<div class="form-wrapper text-center">' +
                        '<button data-type="applyPlan" analytics-on analytics-action="Upgrade Plan" class="btn btn-primary uppercase ' + $ctrl.getBtnActionCls() + '" type="submit" ng-class="{\'disabled\': $ctrl.isUpgradeDisabled()}" ng-disabled="$ctrl.isUpgradeDisabled()"><span class="pull-left sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> ' + ($ctrl.isAddSeats ? 'Pay and Update Seats' : ($ctrl.isDowngrade ? 'Downgrade Now' : 'Upgrade Now')) + '</button>' +
                    '</div>' +
                    '<div class="secure-info text-center spacing-half-top">' +
                        '<p>' +
                            '<span class="lock sbf gray" style="position:relative;top:2px"></span> Secure credit card payment</br><span class="text-italic font-size-10">This is a secure 256-bit SSL encrypted payment<span class="with-padding-left with-padding-right">•</span>All plans are non-refundable</span>' +
                        '</p>' +
                    '</div>' +
                '</div>';
        }

        function getPlanNames(){
    return '<div class="colmax440 form-wrapper">' +
                '<div class="price-table with-border-bottom">' +
                    '<div class="plan-name"><span ng-bind="$ctrl.upgradePlan[$ctrl.upgradePlan.showMonthly?\'month\':\'year\'].name"></span> Plan</div>' +
                    '<div ng-show="$ctrl.upgradePlan[$ctrl.upgradePlan.showMonthly?\'month\':\'year\'].name != 0">' +
                        '<sb-dropdown class="pull-right"' +
                        'without-close="true" ' +
                        'drp-class-attr="payments-dropdown-menu" ' +
                        'c-class-attr="hover-underline opendrp autoheight paymenttypes" ' +
                        'item-label="text" '+
                        'item-value="value" '+
                        'init-list="::$ctrl.PaymentTypes" ' +
                        'value="::$ctrl.upgradePlan.showMonthly" ' +
                        'field-class="selected-text" ' +
                        'on-change="$ctrl.changeMonthly(result)"' +
                        '></sb-dropdown>' +
                        '<!--<div ng-if="isCurrentPlan()">Current Plan</div>-->' +
                    '</div>' +
                '</div>' +
            '</div>';
        }

        function getPlanUpgradedTab(){
            var content = '<subscription-confirmation class="display-block clearfix"></subscription-confirmation>' +
                    '<div>' + ($ctrl.isAddSeats ? getTeamSeatsUpdated() : getPlanUpdated()) + '</div>';
           return getTab(2, content, true);

            function getTeamSeatsUpdated() {
                return '<h3 class="bold">Your team seats have been updated!</h3>' +
                    '<p class="margin-bottom-30 text-center medium-size">We\'ve updated the total team seats on this account to <b>{{$ctrl.upgradePlan.teamCount}}</b> teammates.</p>' +
                    getActionBtn('goToTeam', 'View Team');
            }

            function getPlanUpdated() {
                return '<h3 class="bold">Plan Updated</h3>' +
                    '<p class="margin-bottom-30 text-center medium-size">Your plan has been upgraded to <b>{{::$ctrl.plan.name}}</b> plan.</p>' +
                    getActionBtn('goToProjects', 'View Projects');
            }
        }

        function getPlanDowngradedTab(){
            var content = '<subscription-confirmation></subscription-confirmation>'+
                '<h3 class="bold">Plan Updated</h3>' +
                '<p class="margin-bottom-quarter text-center medium-size">Your plan has been downgraded to <b>{{::$ctrl.plan.name}}</b>. </p>' +
                '<p class="margin-bottom-30 text-center medium-size">Your new plan will go into effect immediately <span ng-show="$ctrl.plan.name.toLowerCase()!==\'free\'">,<br/> and you\'ll be prorated the difference on your balance</span>.</p>' +
                getActionBtn('goToProjects', 'View Projects');
            return getTab(3, content, true);
        }
        function getActionBtn(type, txt) {
            return '<div class="form-wrapper text-center">' +
                '<button data-type="' + type + '"  analytics-on analytics-action="' + txt + '" class="btn btn-primary col250 ' + $ctrl.getBtnActionCls() + '" type="submit">' + txt + '</button>' +
                '</div>';
        }
    }

    function toggleCoupon(type, e){
        $ctrl.showCoupon = $ctrl.showCoupon ? false : true;

        var el = $ctrl.element.querySelector('.btnCoupon span');
        if (el) {
            el.innerText = getBtnCouponText();
        }
        el = $ctrl.element.querySelector('.wrapperCoupon');
        if (el) {
            $ctrl.LCS[$ctrl.showCoupon ? 'removeClass' : 'addClass'](el, 'sb-hide');
        }
    }

    function toggleEditCard(type, e) {
        $ctrl.info.addCard = !$ctrl.info.addCard;

        var el = $ctrl.element.querySelector('.wrapperPaymentDetails .btnCard');
        if (el) {
            el.innerText = getCardText();
        }
    }

    function getBtnCouponText() {
        return $ctrl.showCoupon ? 'Hide' : 'Add';
    }

    function getCardText(){
        return $ctrl.info.addCard ? 'Use card on file' : 'Edit Card';
    }

    function getCouponDiscount(){
        return $ctrl.getFormattedCurrency($ctrl.prices.discounted); // consider the yearly price
    }

    function getTotalDue(){
        return $ctrl.getFormattedCurrency($ctrl.prices.totalDue);
    }

    function getAmount(isAdditional, justOne){
        return getPlan()[isAdditional ? 'amount_additional' : 'amount'] * (isAdditional ? (justOne ? 1 : $ctrl.getAdditionalTeamCount($ctrl.upgradePlan, $ctrl.showMonthly)) : 1);
    }

    function getBaseAmount(isAdditional) {
        return $ctrl.getFormattedCurrency(getAmount(isAdditional) * ($ctrl.upgradePlan.showMonthly ? 1 : 12));
    }

    function getBaseInfo(){
        return getInfo($ctrl.getIncludedTeamCount($ctrl.upgradePlan, $ctrl.showMonthly), false);
    }

    function getAdSeatInfo() {
        var add = $ctrl.getAdditionalTeamCount($ctrl.upgradePlan, $ctrl.showMonthly);
        return add ? getInfo(add, true) : 0;
    }

    function getInfo(s, isAdditional) {
        return (isAdditional ? ('$' + $ctrl.getFormattedCurrency(getAmount(isAdditional, true)) + ' x ') : '') + s + ' user' + (s === 1 ? '' : 's') + ' x ' + ($ctrl.upgradePlan.showMonthly ? 1 : 12) + ' mo';
    }

    function getTotalInit(){
        return $ctrl.getFormattedCurrency(getCTotalInit());
    }

    function getCTotalInit(){
        return $ctrl.getMonthlyTotal($ctrl.upgradePlan, true) * ($ctrl.upgradePlan.showMonthly ? 1 : 12);
    }

    function shotTotalDue(){
        return getCTotalInit() !== $ctrl.prices.totalAfterDiscount;
    }

    function showProRata() {
        return $ctrl.currentPlan.name !== 'Free' && getPlan().name !== 'Free';
    }
}

angular.module('user.payment.pricingFaq.component', [
])
.component('pricingFaq', {
    bindings:{
        sectionClass: '@?'
    },
    controller: 'PricingFaqCtrl'
})
.controller('PricingFaqCtrl', PricingFaqCtrl);
PricingFaqCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];
function PricingFaqCtrl(TemplateCompileCompCtrlService, $element) {
    console.log('PricingFaqCtrl');
    var $ctrl = this;

    $ctrl.openPermissionsPopup = openPermissionsPopup;
    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl.preInit = preInit;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function openPermissionsPopup() {
        $ctrl.popupsService.open(null, $ctrl.popupsService.operations.permissions);
    }

    function preInit() {
        $ctrl.l = [{
            h: 'What’s the difference between collaborators and teammates?',
            c: '<i><strong>Collaborators</strong></i> can only see pages to which you invite them and are typically external crew, vendors or clients. <i><strong>Teammates</strong></i> are internal colleagues have access to all projects in your account and can create new projects.'
               //+ '<br/> If you’re enrolled in the <i>Professional</i> plan, you can invite Collaborators to a page with full “edit” permissions to make changes.' +
                //'<br><a class="'+$ctrl.getBtnActionCls()+'" data-type="openPermissionsPopup" analytics-on analytics-action="Open Permissions Popup">Learn more about sharing permissions here.</a>'
        }, {
            h: 'Do collaborators need to create an account?',
            c: 'Nope! You can share pages with anyone via a general “share” link or specifically invite collaborators, neither of which require any parties to sign up or log in.'
               //+ ' <a class="'+$ctrl.getBtnActionCls()+'" data-type="openPermissionsPopup" analytics-on analytics-action="Open Permissions Popup">Learn more about sharing here.</a>'
        }, {
            h: 'How can I add more teammates?',
            c: 'Our plans are priced per user (teammates). As the account owner, you are the only user when you sign up. You can add or remove team seats at any point via your “Teams” page, and your monthly payment will update itself after confirming. You can invite anyone to occupy a team seat or remove their access to the seat at any point. This is great for inviting external freelancers who will be working on a project for a fixed period of time.'
        }, {
            h: 'How do monthly and annual pricing differ?',
            c: 'When you enroll in a monthly plan, you are billed for the first month up-front and then again on the same date each month moving forward until you cancel. We offer a 15% discount on annual plans. When you enroll in an annual plan, you are billed for the first year up-front and then again on the same date each year moving forward until you cancel.'
        }, {
            h: 'Do you offer educational discounts for institutions that want to purchase multiple seats for students?',
            c: 'Yes, we are happy to support educational institutions and nonprofit organizations with a large discount. Simply reach out to us via the live chat bubble on the bottom-right side of the page, or contact us at <a href="mailto:support@studiobinder.com">support@studiobinder.com</a>'
        }, {
            h: 'Do you offer discounts to students?',
            c: 'Yes we do, so long as you’re actively enrolled in a school and logged in with your school email. Just sign in with your .edu email, and click on the live chat bubble on the bottom-right of the screen to inquire about any current specials. Student discounts may change from time to time.'
        }, {
            h: 'Do you offer a free trial or a free plan?',
            c: 'StudioBinder offers a “Free” plan that never expires so you can sign in without a credit card and explore without any risk. The Free plan is limited in various ways, but it’s there to give you a taste. If you like what you see, you can easily upgrade to a paid plan at any point and unlock StudioBinder’s full functionality. StudioBinder does not offer a free trial.'
        }];

        $ctrl.r = [{
            h: 'Can I upgrade my plan mid-cycle?',
            c: 'Of course! Your plan’s functionality will be updated immediately and the charge will be pro-rated so you are only billed for the cost of the new plan less the remaining unused amount from your current plan.'
        }, {
            h: 'Will my monthly subscription be renewed automatically?',
            c: 'Yes, your subscription will automatically renew until you downgrade back to the free tier or deactivate your account.'
        },
            {
                h: 'Can I cancel my pro subscription at any time?',
                c: 'Absolutely. You can downgrade back to a free tier at any time, and you will not be charged for the next month. Please note that you must cancel your subscription <i>before</i> the next billing cycle to avoid being charged for the next month\'s subscription fee. Cancellations will become effective right away and you will lose all premium functionality immediately.'
            }, {
                h: 'How do I downgrade my account back to “Free?”',
                c: 'You can downgrade back to the free tier via the <i>Billing</i> page of your account or this current page once you have no more than one project and have removed any additional teammates or other premium plan features.'
            }, {
                h: 'Do you offer refunds?',
                c: 'StudioBinder does not provide credit, refunds, or prorated billing for any subscription or plan.'
            // In such circumstance, you will continue to have access to your subscription until the end of the monthly or yearly billing cycle.
            }, {
                h: 'What’s the difference between downgrading to “Free” and deactivating my account?',
                c: 'Downgrading to a free plan will still keep your sign-in email active, and you can re-upgrade again down the road. On the other hand, if you deactivate your account, you will no longer be able to log in with that email again. All of your projects, call sheets, contacts and files will be removed and will be unretrievable. Deactivating an email is permanent and can not be undone. As a result, we recommend avoiding deactivations and instead downgrade to Free so you retain the option to sign in again down the road.'
            }, {
                h: 'How does StudioBinder keep my data safe?',
                c: 'We take the security of your media, data, contact details, and payment information very seriously. To that end, all media assets are securely encrypted on Amazon S3, all application data is transferred using 256-bit encryption through the same SSL protocol used on credit card forms online. All user data is backed up hourly, and we do not sell any user data with 3rd parties.'
            }
        ];
    }

    function getItemTemplate(){
    return '<div class="clearfix pricing-tables spacing-top pricing-faq">' +
                '<div class="enterprise-section">' +
                    '<div class="section-faq container unit-xs" uib-accordion close-others="true" style="max-width:1300px;width:100%">' +
                        '<h3 class="text-center bold">Frequently Asked Questions</h3>' +
                        '<div class="clearfix margin-top">' +
                            getQ($ctrl.l, 'half-column pull-left') +
                            getQ($ctrl.r, 'half-column pull-right') +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>';
    }

    function getQ(l, cls) {
        var el = '';
        _.each(l, function (q) {
            el += getBlock(q);
        });
        return '<div class="modal-accordion ' + (cls||'')+'" uib-accordion close-others="true">' + el + '</div>';
    }

    function getBlock(q) {
return '<div uib-accordion-group>' +
            '<div class="question-wrap">' +
                '<div uib-accordion-heading>'+q.h+'</div>' +
                '<div class="spacing-quarter-top">'+q.c+'</div>' +
            '</div>' +
        '</div>';
    }
}

angular.module('user.payment.pricingDetails.component', [
    'services.layoutConfigsService'
])
.component('pricingMoreDetails', {
    controller: 'PricingMoreDetailsController'
})
.controller('PricingMoreDetailsController', PricingMoreDetailsController);
PricingMoreDetailsController.$inject = ['TemplateCompileCompCtrlService', '$element'];
function PricingMoreDetailsController(TemplateCompileCompCtrlService, $element) {
    console.log('PricingMoreDetailsController');
    var $ctrl = this,
        withoutTemplateScope = true;
    $ctrl.btnContact = 'btnContact';

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function getItemTemplate() {
return '<section id="section-more-details" class="value-props-desc without-bottom white">' +
            '<div class="container">' +
                '<div class="clearfix">' +
                    '<h2 class="text-center">What’s Included?</h2>' +
                    '<hr class="small">' +
                '</div>' +
            '</div>' +
        '</section>' +
        '<section id="section-file-management" class="value-props-desc white">' +
            '<div class="container">' +
                '<div class="clearfix">' +
                    '<div class="half-column pull-left">' +
                        '<div class="wow bounceInLeft"><img class="img-responsive" src="'+getImg('backup-and-share-production-files-studiobinder.png')+'"></div>' +
                    '</div>' +
                    '<div class="half-column pull-right">' +
                        '<div class="wow bounceInRight">' +
                            '<div class="text with-padding-left">' +
                                '<h2>File Management</h2>' +
                                '<p>Our storage options provide you with one place to organize all of your production documents for easy retrieval down the road. Store documents like scripts, sides, storyboards, shot lists, W9 forms, deal memos, release forms, and more.</p>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</section>' +
        '<section id="section-shot-list" class="value-props-desc">' +
            '<div class="container">' +
                '<div class="clearfix">' +
                    '<div class="half-column pull-right">' +
                        '<div class="wow bounceInRight"><img style="max-width:450px" class="img-responsive" src="'+getImg('shot-list-template-and-storyboard-template-builder-create-online-using-studiobinder.png')+'"></div>' +
                    '</div>' +
                    '<div class="half-column pull-left">' +
                        '<div class="wow bounceInLeft">' +
                            '<div class="text with-padding-left">' +
                                '<h2>Shot Lists & Storyboarding</h2>' +
                                '<p>Add shots, specify details, customize columns, and upload images to create storyboards. Supports every aspect ratio from 4:3 to 2.39:1.</p>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</section>' +
        '<section id="section-sms-callsheet" class="value-props-desc white">' +
            '<div class="container">' +
                '<div class="clearfix">' +
                    '<div class="half-column pull-left">' +
                        '<div class="wow bounceInLeft"><img style="max-width:450px" class="img-responsive" src="'+getImg('sms-call-sheet-preview-pricing.png')+'"></div>' +
                    '</div>' +
                    '<div class="half-column pull-right">' +
                        '<div class="wow bounceInRight">' +
                            '<div class="text with-padding-left">' +
                                '<h2>Send Call Sheets as SMS</h2>' +
                                '<p>Ensure your call sheets are received and easily understood by sending call times as personalized text messages.</p>' +
                            '</div>' +
                        '</div>' +
                    '</div>' +
                '</div>' +
            '</div>' +
        '</section>' +
        '<section id="section-stripboard" class="value-props-desc without-bottom">' +
            '<div class="container">' +
                '<div class="clearfix">' +
                    '<div class="half-column pull-right">' +
                        '<div class="wow bounceInRight"><img style="max-width:450px" class="img-responsive" src="'+getImg('create-shooting-schedules-StudioBinder.png')+'"></div>' +
                    '</div>' +
                    '<div class="half-column pull-left">' +
