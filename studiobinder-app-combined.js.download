                                '<li>Adjust and revoke access permissions</li>' +
                                '<li>Track how many times a reviewer viewed a page</li>' +
                                '</ul>'
                        })
                };

            case 'reportsScript':
                return {
                    desc: (hideButton ? '' : (desc + 'generate script reports.')),
                };
        }

        function setBlock(){
            $ctrl.overviewBlockTypeNew = 'storyboards';
            $ctrl.pageClass = 'shotsPage';//'storyboardsPage';
        }
    }
}

angular.module('user.payment.lowQuota.component', [
