 angular.module('services.todoColumnsConfigsService', [
 ])
    .service('TodoColumnsConfigsService', TodoColumnsConfigsService);

TodoColumnsConfigsService.$inject = ['RootEventsService', 'TodoColumnsService'];
function TodoColumnsConfigsService(RootEventsService, TodoColumnsService) {
    var _this = this;

    init();

    _this.onUpdateTodoColumn = function onUpdateTodoColumn(result) {
        var item = result.item;
        var cols = _this.getTodoColumnsForProduct(item.productId),
            l = cols ? cols.length : 0;
        if (l > 0) {
            for (var i = 0; i < l; i++) {
                var el = cols[i];
                if (el._id === item._id) {
                    el.name = item.name;
                    el.order = item.order;
                    el.color = item.color;
                    cols[i] = el;
                }
            }

            _this.setTodoColumnsForProduct(item.productId, cols);
        }
    }

    _this.getTodoColumnsForProduct = function (productId) {
        if (!productId) {
            return null;
        }
        var cols = _this.getTodoColumns();
        return cols ? cols[productId] : null;
    }

    _this.getTodoColumnsForProductAsync = function (companyId, productId, next) {
        _this.reloadTodoColumns(companyId, function() {
            next(_this.getTodoColumnsForProduct(productId));
        });
    }

    _this.reloadTodoColumns = function reloadTodoColumns(companyId, next, force) {
        if (!companyId) {
           return set();
        }
        if(companyId !== _this.companyId || !_this.allTodoColumns || force) {
            init();
            TodoColumnsService.getAll({
                companyId: companyId,
                //productId: productId ? productId : null
            }, null, set, set);
        }else{
            if (typeof (next) === 'function') {
                next();
            }
        }

        function set(result) {
            var cols = {};
            if (!result) {
                result = [];
            }
            for (var i = 0; i < result.length; i++) {
                var el = result[i], id = el.productId;
                if (!cols[id]) {
                    cols[id] = [];
                }
                cols[id].push(el);
            }
            _this.setTodoColumns(cols, companyId);
            if (typeof (next) === 'function') {
                next();
            }
        }
    }

    _this.getTodoColumnById = function getTodoColumnById(productId, id) {
        var cols = _this.getTodoColumnsForProduct(productId);
        var l = cols ? cols.length : 0;
        for (var i = 0; i < l; i++) {
            var el = cols[i];
            if (el._id === id) {
                return el;
            }
        }
        return null;
    }
    _this.getTodoColumnByName = function getTodoColumnByName(productId, name) {
        var cols = _this.getTodoColumnsForProduct(productId);
        var l = cols ? cols.length : 0;
        for (var i = 0; i < l; i++) {
            var el = cols[i];
            if (el.name.indexOf('.'+name) !== -1) {
                return el;
            }
        }
        return null;
    }
    _this.getFirstTodoColumnId = function getFirstTodoColumnId(productId) {
        var cols = _this.getTodoColumnsForProduct(productId);
        return cols&&cols.length>0?cols[0]._id:null;
    }

    _this.getTodoColumns = function getTodoColumns() {
        return _this.allTodoColumns ? _this.allTodoColumns : null;
    }

    _this.setTodoColumns = function setTodoColumns(cols, companyId) {
        _this.companyId = companyId;
        _this.allTodoColumns = cols;
        if (cols) {
            RootEventsService.broadcastRoot('UPDATE_TODO_COLUMNS', cols);
        }
    }

    _this.setTodoColumnsForProduct = function(productId, cols) {
        var c = _this.getTodoColumns();
        if (!c) {
            c = {};
        }
        c[productId] = cols;

        if (!_this.allTodoColumns) {
            var c = {};
            c[productId] = cols;
        }

        _this.allTodoColumns = c;
    }

    return _this;



    function init() {
        _this.allTodoColumns = {};
        _this.companyId = null;
    }
}

angular.module('product.preLoading.activities.service', [
    'product.preLoading.resource.service',
