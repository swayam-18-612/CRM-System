            size: 'sm',
            transp: ' '
        },

        moveCalendar: {
            type: 'Move',
            template: getBasePopupTemplateByTag('calendar-move'),
            size: 'sm',
            transp: ' '
        },

        saveCalendarTemplate: {
            type: 'Create',
            template: getBasePopupTemplateByTag('calendar-template'),
            size: 'sm',
            transp: ' '
        },

        createCalendarRow: {
            type: 'Create',
            template: getBasePopupTemplateByTag('calendar-row'),
            size: 'sm',
            transp: ' '
        },
        updateCalendarRow: {
            type: 'Edit',
            template: getBasePopupTemplateByTag('calendar-row'),
            size: 'sm',
            transp: ' ',
        },
        createCalendarGroup: {
            type: 'Create',
            template: getBasePopupTemplateByTag('calendar-group'),
            size: 'sm',
            transp: ' '
        },
        updateCalendarGroup: {
            type: 'Edit',
            size: 'sm',
            transp: ' ',
            template: getBasePopupTemplateByTag('calendar-group'),
        },
    },

    Hotkeys = null,

    SidebarOptions = null;

    return {
        PropTypes: PropTypes,
        Settings: Settings,
        Options: Options,
        ViewProp: 'productCalendarView',

        CompOptions: CompOptions,
        ListTreeServiceParams: ListTreeServiceParams,
        ListParams: ListParams,
        KeyboardServiceParams: KeyboardServiceParams,

        SidebarOptions: SidebarOptions,
        PopupOperations: PopupOperations,
        Hotkeys: Hotkeys,

    };
}

