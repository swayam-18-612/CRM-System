angular.module('user.dashboardPage.widgets.component', [
    'group.container.block.controller.service',
    'apiConstants.widgets.services',
    'user.dashboardPage.widgetsGroup.component',
    'service.currentDashboard'
])
.component('dashboardWidgets', {
    controller: 'DashboardWidgetsCtrl'
})
.controller('DashboardWidgetsCtrl', DashboardWidgetsCtrl);
DashboardWidgetsCtrl.$inject = ['GroupContainerBlockCtrlService', 'CurrentDashboard', 'WidgetsConstantsService', '$element'];
function DashboardWidgetsCtrl(GroupContainerBlockCtrlService , CurrentDashboard, constantsService, $element) {
    console.log('DashboardWidgetsCtrl');
    var $ctrl = this;
    var source ='widgets';

    $ctrl.CurrentDashboard = CurrentDashboard;
    $ctrl.GroupContainerBlockCtrlService = GroupContainerBlockCtrlService;

    $ctrl.$onInit = $onInit;
    $ctrl.getParams = getParams;
    $ctrl.getGroupBodyAttrs = getGroupBodyAttrs;
    $ctrl.onPreloadedService =  onPreloadedService;
    $ctrl.onPostInit = onPostInit;

    function $onInit() {
        $ctrl.canEdit = true;

        $ctrl.block = 'dashboardwidgets';
        $ctrl.groupTag = $ctrl.block + '-group';
        $ctrl.smallPreloader = true;
        $ctrl.currentListId = null;

        $ctrl.constantsService = angular.copy(constantsService);
        $ctrl = new $ctrl.GroupContainerBlockCtrlService($ctrl, $element, $ctrl.constantsService);
    }

    function onPostInit() {
        $ctrl.CurrentDashboard.onDashboardChanged($ctrl.watchers, onDashboardChanged);
    }

    function onDashboardChanged(result){
        if(!result || result.source === source){return;}

        console.log('SBWidgetsGroupCtrl.onDashboardChanged');

        var changes = result ? result.changes : null;
        if(changes){
            _.each(['background'], function (prop){
                if(changes[prop] !== undefined) {
                    onCurrentTreeListChangedOther(result.item);
                }
            });
        }
    }

    function onCurrentTreeListChangedOther(list) {
        console.log('DashboardWidgetsCtrl.onCurrentTreeListChangedOther');
        $ctrl.broadcastRoot('BACKGROUND_COLOR_CHANGED_' + $ctrl.elemType, _.extend({},list, {_id:null}));
    }

    function onPreloadedService(err, result) {
        console.log('onPreloadedService');
        var list = $ctrl.preLoadingService.getObjectList($ctrl.preLoadingService.TblTypes[$ctrl.preLoadingTableName]);
        setDashboard(list && list.length > 0 ? list[0] : null);

        function setDashboard(item) {
            $ctrl.CurrentDashboard.setDashboard(item);
            $ctrl.item = $ctrl.CurrentDashboard.getDashboard();
            $ctrl.CurrentDashboard.preLoadingService = $ctrl.item ? $ctrl.preLoadingService : null;
            $ctrl.constantsService.Options.column = $ctrl.item.column;
                onCurrentTreeListChangedOther($ctrl.item);
        }
    }

    function getParams() {
        return {
            companyId: $ctrl.CPS.companyId,
            teamId: $ctrl.CPS.teamId
        }
    }

    function getGroupBodyAttrs() {
        return 'item="::$ctrl.item"';
    }
}

angular.module('user.dashboardPage.widgetsGroup.component', [
    'groupBlock.controller.service',
    'user.dashboardPage.widgets.item.grid.component',

    'apiPagination.Dashboards',
    'services.commentsSidebar',

    'user.dashboardPage.myTasks.component',
    'user.dashboardPage.myTeam.component',
    'user.dashboardPage.myActivity.component',
    'user.dashboardPage.myProjects.component',
    'user.dashboardPage.myCallsheets.component',
    'user.dashboardPage.myScratchpad.component',
    'user.dashboardPage.myComments.component'
])
.component('dashboardwidgetsGroup', groupBlockComponentParams('SBWidgetsGroupCtrl', {
    item: '<',
    onUpdated: '&'
}))
.controller('SBWidgetsGroupCtrl', SBWidgetsGroupCtrl);
/**
 * Dependency injection declaration for the SBWidgetsGroupCtrl controller.
 * This is used to specify the dependencies that need to be injected into the controller.
 * It ensures proper functioning during minification of the code.
 *
 * @type {Array<string>}
 */
SBWidgetsGroupCtrl.$inject = ['DashboardsPagination', 'GroupBlockInitCtrlService', 'CurrentDashboard', 'CommentsSidebarService', '$element'];
/**
 * Controller for managing widget groups in the interface.
 *
 * @param {Object} Pagination - The Pagination service for handling paginated lists.
 * @param {Object} GroupBlockInitCtrlService - Service for initializing group blocks in the controller.
 * @param {Object} CurrentDashboard - The current dashboard object containing dashboard details and widgets.
 * @param {Object} CommentsSidebarService - Service to manage the comments sidebar functionality.
 * @param {Object} $element - AngularJS element object, representing the DOM element this controller is associated with.
 * @return {void} This function constructs and initializes the SBWidgetsGroupCtrl controller.
 */
function SBWidgetsGroupCtrl(Pagination, GroupBlockInitCtrlService, CurrentDashboard, CommentsSidebarService, $element) {
    console.log('SBWidgetsGroupCtrl');
    var $ctrl = this;
    var source ='group';

    $ctrl.CurrentDashboard = CurrentDashboard;
    $ctrl.CommentsSidebarService = CommentsSidebarService;
    $ctrl.Pagination = Pagination;
    $ctrl.GroupBlockInitCtrlService = GroupBlockInitCtrlService;

   //$ctrl.settingsIcon = 'widgets';
    $ctrl.settingsName = 'Customize';
    $ctrl.settingsIcon = 'widgets';
    $ctrl.settingsNoTooltip = true;

    $ctrl.$onDestroy = $onDestroy;
    $ctrl.$onInit = $onInit;

    $ctrl.getInitList = getInitList;
    $ctrl.processGridViewItem = processGridViewItem;
    $ctrl.onPostloadGroup = onPostloadGroup;

    $ctrl.onBodyClick = onBodyClick;
    $ctrl.preProcessGroupItem = preProcessGroupItem;
    $ctrl.createNonNg = openSidebar;

    $ctrl.addNewItem = addNewItem;
    $ctrl.toggleWidgetSize = toggleWidgetSize;
    $ctrl.removeWidget = removeWidget;
    $ctrl.toggleDropdown = toggleDropdown;
    $ctrl.goToPage = goToPage;
    $ctrl.openPopup = openPopup;
    $ctrl.openEditSettings = openEditSettings;
    $ctrl.changeOrderServerSide = changeOrderServerSide;
    $ctrl.onCurrentTreeListChangedOther = onCurrentTreeListChangedOther;
    $ctrl.getBottomActions = getBottomActions;

    function $onInit() {
        $ctrl.canEdit = true;
        $ctrl.withFooter = false;
        $ctrl.customButtons = true;
        $ctrl.options = $ctrl.constantsService.Options;
        $ctrl.changedFields
        $ctrl = new $ctrl.GroupBlockInitCtrlService($ctrl, $element, $ctrl.Pagination, $ctrl.constantsService, null);
    }

    function $onDestroy(){
        bindBodyClick(false);
        $ctrl.onGroupBlocksDestroy();
    }

    function onPostloadGroup(){
        bindBodyClick(true);
        $ctrl.CurrentDashboard.onDashboardChanged($ctrl.watchers, onDashboardChanged);
    }

    function onDashboardChanged(result){
        if(!result || result.source === source){return;}

        console.log('SBWidgetsGroupCtrl.onDashboardChanged');

        var changes = result ? result.changes : null;
        if(changes){
            _.each(['widgets', 'background', 'column'], function (prop){
                switch(prop) {
                    case 'widgets':
                        if (changes[prop] && changes.added) {
                            $ctrl.item[prop] = changes[prop];
                            process(changes.added, 3);
                        }
                        break;

                    case 'background':
                        if (changes[prop] !== undefined) {
                            onCurrentTreeListChangedOther(result.item);
                        }
                        break;

                    case 'column':
                        var value = changes[prop];
                        if (value && $ctrl.options[prop] !== value) {
                            $ctrl.options[prop] = value;
                            $ctrl.filtersService.setOptions($ctrl.options);
                            $ctrl.item[prop] = changes[prop];

                            var p = {};
                            p[prop] = $ctrl.item[prop];
                            $ctrl.broadcastListFiltersColumn(value);

                            updateDashboard(p);

                        }
                        break;
                }
            });
        }
    }

    function onCurrentTreeListChangedOther(list) {
        console.log('SBWidgetsGroupCtrl.onCurrentTreeListChangedOther');
        $ctrl.broadcastRoot('BACKGROUND_COLOR_CHANGED_' + $ctrl.elemType, _.extend({},list, {_id:null}));
    }

    function bindBodyClick(isBind) {
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.LCS.bodyElement, $ctrl.onBodyClick, $ctrl.elementId);
    }

    function onBodyClick(e) { //for sb-phone
        //console.log('onBodyClick');
        _.each($ctrl.element.querySelectorAll('.' + $ctrl.itemSelector + ' .dropdown.open'), function (el){
            $ctrl.LCS.removeClass(el, 'open');
        });
    }

    function getInitList() {
        var items = $ctrl.item ? $ctrl.item.widgets : [];
        //order starts at 0
        return items ? _.filter(items.map(getItemInfo), function (item) {return item;}).map(function (item, i){return _.extend({order: i}, item)}) : [];
    }

    function getItemInfo(item){
        var col = getWidget(item);
        return col && !(col.adminOnly && !$ctrl.CPS.isOwnerOrAdmin)
            ? _.extend({}, col , item) : null;
    }

    function preProcessGroupItem (item){
        var col = getWidget(item);
        return col ? _.extend({}, col, item) : null;
    }

    function getWidget(item){
        return item ? _.find($ctrl.CurrentDashboard.Widgets, {_id: item._id}) : null
    }

    function getBottomActions(item) {
        return '<div class="ng-hide hide-print spacing text-center empty-state gray" ng-show="$ctrl.list.items.length===0">' +
            '<div class="empty-img centered position-relative"><svg xmlns="http://www.w3.org/2000/svg" width="60" height="40" xmlns:v="https://vecta.io/nano" preserveAspectRatio="xMidYMid meet" viewBox="0 0 60 40"><path d="M22.5 0h15A1.5 1.5 0 0 1 39 1.5v37a1.5 1.5 0 0 1-1.5 1.5h-15a1.5 1.5 0 0 1-1.5-1.5v-37A1.5 1.5 0 0 1 22.5 0zm-21 0h15A1.5 1.5 0 0 1 18 1.5V17a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 0 17V1.5A1.5 1.5 0 0 1 1.5 0zm0 21.5h15A1.5 1.5 0 0 1 18 23v15.5a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 0 38.5V23a1.5 1.5 0 0 1 1.5-1.5zM43.5 0h15A1.5 1.5 0 0 1 60 1.5V17a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 42 17V1.5A1.5 1.5 0 0 1 43.5 0zm0 21.5h15A1.5 1.5 0 0 1 60 23v15.5a1.5 1.5 0 0 1-1.5 1.5h-15a1.5 1.5 0 0 1-1.5-1.5V23a1.5 1.5 0 0 1 1.5-1.5z" fill-rule="evenodd"  ></path></svg></div>' +

            '<p class="empty-txt">No widgets have been added</p>' +
            '<a type="button" class="btn btn-small transparent navbtn col120 ' + $ctrl.getBtnActionCls() + '" data-type="createNonNg" analytics-on analytics-action="Add ' + $ctrl.itemTitle + '">'+$ctrl.LCS.getISBDiv('plus', 2, 'pull-left centered')+' <div>Add ' + $ctrl.itemTitle + '</div></a>'+
            '</div>';
    }

    function processGridViewItem(item) {
return '<div class="box-parent"><div class="h-full full-width with-fancy-scrollbar show-scrollbar-on-hover">' +
            '<div class="header table-div full-width">' +
                ($ctrl.dragHandleOnTheSide ? ('<div class="as-sortable-item-handle col25 centered text-center hide-print with-hover">' + $ctrl.LCS.getISBDiv('dd3-handle', 0, 'centered gray') + '</div>') : '') +
                '<div class="col60"><div class="circled-svg-colored small44 blue">' + $ctrl.LCS.getISBDiv(item.icon, item.iconLevel || 2) + '</div></div>' +
                '<div class="centered t1">' +
    (item.btnAction ? ('<a class="hover-underline ' + $ctrl.getClickEventName('goToPage') + '">'+
            item.title +'</a>') : item.title) +
                '</div>' +
                '<div class="centered text-right">' +
                    getAddNew() +
                    //getExpand() +
                '</div>' +
                getMore() +
            '</div>' +
            '<div class="body fancy-scrollbar vertical visible-scrollbar' +
                ($ctrl.withFooter && item.btnAction ? ' with-footer' : '') +
    (item.bodyCls ? (' ' + item.bodyCls) : '' ) +
            '">' + getGrid() + '</div>' +
    ($ctrl.withFooter ? (item.btnAction ? ('<div class="footer"><a class="gray-light-3 ' + $ctrl.getClickEventName('goToPage') + '">' + (item.moreText || 'Show more') + '</a></div>') : '') : '') +
        '</div></div>';

        function getGrid() {
            var tag = item.component; // 'sb-grid-view'
            return  '<' + tag + ' class="display-block clearfix" block="' + getBlock(item) + '"' +
                ($ctrl.canEdit ? ' can-edit="true"' : '') +
                ($ctrl.gridNested ? ' nested-level="1"' : '') +
                '></'+tag+'>'
        }

        function getAddNew() {
            return item.withAdd ? getBtn('plus', 'Add ' + item.itemTitle, 'addNewItem', 'col110 btnAdd') : '';
        }

        function getExpand(){
            return item.withPopup ? getBtn('cal-expand', null, 'openPopup') : '';
        }
        function getBtn(icon, name, ev, cls) {
            return '<button type="button" class="btn btn-small without-text transparent noborder with-hover ' + (cls||'') + ' ' + $ctrl.getClickEventName(ev) + '">' +
                $ctrl.LCS.getISBDiv(icon, 2, 'centered' + (name ? ' pull-left' : '')) +
                (name ? ('<span class="hide-mobile with-margin-left"> ' + name+'</span>') : '') +
                    '</button>';
        }
        function getMore() {
            var sizes = $ctrl.CurrentDashboard.WidgetSizes;
            return '<div class="dropdown dropdown-wrapper centered position-relative with-margin-left with-hover col40">' +
                '<button type="button" class="btn btn-small without-text transparent noborder dropdown-toggle with-hover ' + $ctrl.getClickEventName('toggleDropdown') + '" tooltip-placement="bottom" tooltip="More"><div class="centered sbf vertical-dots"></div></button>' +
                "<div class='dropdown-menu side-menu fadeInDownLeft widget-menu' role='menu'>" +
                '<div class="header-small clearfix with-side-padding30">View Mode</div>' +
                '<ul>' +
                sizes.map(function (size) {
                    return '<li class="' + (isSize(item, size) ? ' sb-hide' : '') +
                        (size.hideModile ? ' hide-ipad' : '') +
                        '"><a class="btn1 table-div full-width ' + $ctrl.getClickEventName('toggleWidgetSize') + '" analytics-on analytics-action="Toggle Widget ' + (size.n) + '" data-double="' + size.id + '"><div class="col30">' +
                        $ctrl.LCS.getISBDiv(size.i, 3) +
                        '</div><div>' + size.n + '</div></a></li>';
                }).join('') +
                '<li><a class="btn2 table-div full-width accent with-border-top ' + $ctrl.getClickEventName('removeWidget') + '" analytics-on analytics-action="Remove Widget"><div class="col30">' + $ctrl.LCS.getISBDiv('trash') + '</div><div>Remove Widget</div></a></li>' +
                '</ul>' +
                '</div>' +
                '</div>';
        }
    }

    function isSize(item, size) {
        return (!item.isDouble && !size.id) || (item.isDouble && size.id && item.isDouble === size.id);
    }
    
    function getBlock(item) {
        return item.component.replace('-','')
    }

    function addNewItem(item) {
        $ctrl.broadcastRoot('GROUP_BLOCK_' + getBlock(item) + '_ADD');
    }

    function openSidebar(){
        $ctrl.CommentsSidebarService.toggleComments($ctrl.componentId, $ctrl.LCS.SidebarTypes.News, true);
    }

    function toggleDropdown(item) {
        //console.log('toggleDropdown');
        var el = $ctrl.getItemEl(item._id, ' .dropdown');
        if (el) {
            $ctrl.LCS[$ctrl.LCS.hasClass(el, 'open') ? 'removeClass' : 'addClass'](el, 'open');
        }
    }

    function toggleWidgetSize(item, field, e) {
        //console.log('toggleWidgetSize');
        $ctrl.onBodyClick();
        process(item._id, 1, parseInt(e.currentTarget.getAttribute('data-double')));
    }

    function removeWidget(item) {
        //console.log('removeWidget');
        $ctrl.onBodyClick();
        process(item._id, 2);
    }

    function changeOrderServerSide(otherParams, ids, next) {
        process(otherParams.updates, 4);
    }

    function process(id, type, newVal) {
        var prop = 'widgets';
        if (next(type, id) && type !== 3) {
            var p = {};
            p[prop] = $ctrl.item[prop];
            updateDashboard(p);
        }

        function next(type, id) {
            if (!id) {
                return false;
            }
            var index = _.findIndex($ctrl.item.widgets, function (item) {
                return item && id === item._id;
            });
            if (type!== 4 && index === -1) {
                return false;
            }
            switch (type) {
                case 1:
                    var prevValue = $ctrl.item.widgets[index].isDouble || 0;
                    var isDouble = newVal;
                    $ctrl.item.widgets[index].isDouble = isDouble;
                    updateElement(id, 'isDouble', isDouble);
                    $ctrl.LCS.removeClass(getEl(prevValue), 'sb-hide');
                    var btnEl = getEl(newVal);
                    if (btnEl) {
                        $ctrl.LCS.addClass(btnEl, 'sb-hide');
                        //btnEl.querySelector('.txtSize').innerText = isDouble ? 'Full' : 'Double';
                        //$ctrl.LCS.replaceClass(btnEl.querySelector('.sbf'), isDouble ? 'cal-expand' : 'cal-collapse', isDouble ? 'cal-collapse' : 'cal-expand');
                        $ctrl.LCS.replaceClass($ctrl.getItemEl(id), 'double_1 double_2', isDouble ? ('double_' + isDouble) : '');

                        reload(false, id);
                    }

                    function getEl(v) {
                        return $ctrl.getItemEl(id, ' .btn' + type + '[data-double="' + v + '"]').parentElement;
                    }
                    break;

                case 2:
                    $ctrl.item.widgets.splice(index, 1);

                    //$ctrl.processElementsInit({removed: [id]});
                    $ctrl.list.removeElementByIndex(index);

                    _.each($ctrl.list.items, function (item, i) {
                        updateElement(item._id, 'order', i);
                    });
                    reload(false, id);
                    break;

                case 3:
                    if(_.find($ctrl.list.items, {_id:id})){
                        return false;
                    }
                    var item = _.extend(getItemInfo(_.find($ctrl.item.widgets, {_id: id})), {
                        order: ($ctrl.list.items.length > 0 ? _.max($ctrl.list.items, function (item) {
                            return item.order;
                        }).order : -1) + 1
                    });

                    //$ctrl.processElementsInit({added: [item]});
                    $ctrl.addInitItems([item], $ctrl.isNotCurrentList(item));
                    reload(true, id);
                    break;

                case 4:
                    var newOrder = id,
                        prop = 'order';
                    _.each($ctrl.list.items, function (item, i) {
                        var v = newOrder[item._id];
                        if(v !== undefined) {
                            updateElement(item._id, prop, v);
                        }
                    });
                    $ctrl.item.widgets = _.sortBy($ctrl.list.items, prop).map(function (item){
                        return _.find($ctrl.item.widgets, {_id: item._id});
                    });

                    reload(true);
                    break;
            }

            return true;

            function reload(isAdd, id) {
                if (isAdd) {
                    $ctrl.reloadMasonaryLayout(null, true);
                } else {
                    $ctrl.onListElementsUpdated(id, isAdd);
                }
            }

            function updateElement(id, prop, val) {
                var p = {};
                p[prop] = val;
                $ctrl.replaceElementProps(id, p, [prop], null, false);
            }
        }
    }

    function updateDashboard(changes) {
        $ctrl.CurrentDashboard.updateDashboard(changes, {source: source});
    }

    function goToPage(item, e) {
        if (!item) {
            return;
        }
        redirect(e, item.btnAction);
    }

    function redirect(e, name, params){
        var p = $ctrl.CPS.currentPathParams(params);
        if (e && e.shiftKey) {
            $ctrl.CPS.openInNewWindow(name, p);
        } else {
            $ctrl.CPS.transitionTo(name, p);
        }
    }

    function openPopup(item, e) {
        if(item.withPopup) {
            var str = item.component.split('-');
            str[1] = $ctrl.LCS.capitalizeFirst(str[1]);
            var n = str.join('');
            $ctrl.popupsService.open(item, $ctrl.popupsService.operations[n], null, $ctrl.compOptions,
                $ctrl.service, onSuccessPopup, $ctrl.getNotification);

            function onSuccessPopup() {
                //if updates have been maede reload the group?
             /*   var elemType = 'RECIPIENT';
                $ctrl.LCS.timeout(function () {
                    $ctrl.broadcastRoot('LOAD_GROUP' + '_' + elemType + '_' + 2 + '_' + callsheet._id, {
                        updatePreloadSettings: true,
                        forceReload: true
                    });
                }, 200);*/
            }
        }else {
            goToPage(item, e);
        }
    }

    function openEditSettings(){
        console.log('openEditSettings');
        $ctrl.CommentsSidebarService.toggleComments($ctrl.componentId, $ctrl.LCS.SidebarTypes.News, !$ctrl.CommentsSidebarService.getSidebarInfo().isOpen);
        //$ctrl.CurrentDashboard.openChangeBackgroundPopup($ctrl, null, onSuccess);

        function onSuccess(result) {
            console.log('onChangeBgSuccess');
            updateDashboard(result.editchanges, {withoutDBUpdate: true});
        }
    }
}


angular.module('apiConstants.widgets.services', [
    'sb.fields.types.service',
    'compOptions.widgets.constant'
])
    .service('WidgetsConstantsService', WidgetsConstantsService);
WidgetsConstantsService.$inject = ['SBFieldTypesService', 'WidgetsCompOptions'];
function WidgetsConstantsService(SBFieldTypesService, compOptions) {
    var PropTypes = SBFieldTypesService.PropTypes,
        Settings = {
            Columns: {
                "1": {
                    id: "1",
                    name: 'Name',
                    prop: 'name',
                    type: PropTypes.Field,
                    colCls: ' name-col',
                    order: 2,
                    canSort: true,
                    canEdit: false,
                    canChangeOnEdit: true,
                    canHide: false,
                    placeholder: 'Project name…',
                    grow: true,
                    showMobile: true,
                    isRequired: true,
                    icon: 'title',
                    tabIndex: 1,
                    tabNextIndex: 2,
                    isMaxLength: 30,
                    isMobileTitle: true,
                    withoutLabelInPopup: true,
                    isListTitle: true
                }
            }
        },

        CompOptions = angular.copy(compOptions),

        ListParams = {
            includeFields: ['widgets', 'notes', 'teamId'],
        },

        Options = {
            columns: ['1'],
            view: 3,
            column: 3
        },

        GroupSettings = {
            colType: 'widgets',

            gridItemClass: ' '
           // gridItemClass: 'product-detail-item-grid short-item-grid with-white-bg ',
            //groupItemTag: 'dashboardwidgets',
            //hideGridHeader: true
        }

    return {
        ViewProp: 'widgetsView',
        ListParams: ListParams,
        CompOptions: CompOptions,
        PropTypes: PropTypes,
        Options: Options,
        Settings: Settings,
        GroupSettings: GroupSettings
    };
}

