angular.module('product.overview.upgradeBanners.component',[
    'user.payment.quotaUpdatedInit.service',
    'components.animated-bg'
])
.component('productUpgradeBanners', {
    bindings: {
    },
    controller: 'ProductUpgradeBannersCtrl'
})
.controller('ProductUpgradeBannersCtrl', ProductUpgradeBannersCtrl);

ProductUpgradeBannersCtrl.$inject = ['TemplateCompileCompCtrlService', 'QuotaUpdatedInitCtrlService', '$element'];
function ProductUpgradeBannersCtrl (TemplateCompileCompCtrlService, QuotaUpdatedInitCtrlService, $element) {
    console.log('ProductUpgradeBannersCtrl');
    var $ctrl = this;

    $ctrl.preInit = preInit;
    $ctrl.toggle = toggle;

    $ctrl.getItemTemplate = getItemTemplate;

    $ctrl = new QuotaUpdatedInitCtrlService($ctrl, $element, TemplateCompileCompCtrlService);

    function preInit() {
        $ctrl.isNewFeature = true;
    }

    function getContainer(block){
        var withAnimatedBg = false;
return '<div class="empty-state new-feature '+block.name+(withAnimatedBg ? ' with-animated-bg' : false) + '">' +
            (withAnimatedBg ? '<animated-bg></animated-bg>' : '') +
            '<div class="center">' +
                '<div class="left centered ">' +
                    '<div class="col580">'+
                        '<div class="header">' +
                            '<div class="info">' +
                                '<h3 class="infoh" style="color:' + (block.color || 'var(--primaryColor)') + '">' + 'New Feature' + '</h3>' +
                                (block.title ?  ('<div class="desc">' + block.title + '</div>') : '') +
                            '</div>' +
                        '</div>' +
                        (block.desc ? ('<div class="body">'+ block.desc + '</div>') : '')  +
                        (!block.hideButton ? ('<div class="spacing-quarter-top text-left empty-buttons-div">' + (block.btns ? block.btns : getButtons()) + '</div>') : '') +
                    '</div>' +
                '</div>' +
                '<div class="right centered">' +
                    getBtn(block.name) +
                    getVideo($ctrl, block, true) +
                '</div>' +
            '</div>' +
        '</div>';

        function getVideo($ctrl, block, isIFrame){
            var p = 'emptystate/' + block.type + '/emptystate.';
            return isIFrame && block.videoUrl ?
                ('<div class="video-anime"><iframe width="462" height="260" frameBorder="0" webkitallowfullscreen="" mozallowfullscreen="" allowfullscreen="" src="' + block.videoUrl + '" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope" referrerPolicy="strict-origin-when-cross-origin"></iframe></div>') :
                ('<video class="video-anime wide" muted playsinline autoplay="autoplay" loop="loop" poster="' + $ctrl.LCS.getImgUrl(p + 'jpg') + '"><source src="' + $ctrl.LCS.getVideoUrl(p + 'mp4') + '" type="video/mp4"></video>');

        }

        function getButtons() {
            var hasQuotaType = $ctrl.CPS.hasQuotaType(block.name),
            quota = ' data-quota="' + block.name + '"';
            return '<button class="btn btn40 btnPrice btn-primary without-text with-margin-right'+(hasQuotaType ? ' sb-hide':'')+'"' + quota + ' analytics-on analytics-action="onAction">Enable Feature</button>'+
                '<button class="btn btn40 btnLearn without-text' +
              //  (hasQuotaType ? ' btn-primary' : '') +
                (hasQuotaType ? ' sb-hide':'') +
                '"' + quota + ' analytics-on analytics-action="onAction">Learn More</button>';
        }
    }

    function getItemTemplate() {
        var block = getBlock();
        if (showBanner(block)) {
            return '<div class="tab-content tabbable product-dashboard on-boarding container">' +
                '<div class="onboarding unit-xs" ng-class="{\'full-width\':($ctrl.LCS.getWindowWidth()>=1024)}">' + getContainer(block) + '</div>' +
                '</div>';
        }
    }

    function getBtn(prop) {
        return '<a class="btn btnToggle btn-small without-text with-margin-left" ng-click="$ctrl.toggle($event, \''+prop+'\')" tooltip="Close" tooltip-placement="bottom"><div class="sbf cancel inline-block"></div></a>';
    }

    function showBanner(block){
        if(!block){return false;}
        var  prop = $ctrl.LCS.getSetting(getProp(block.name)),
            hideBlock = prop === 'true' || prop === true;
        if(!hideBlock) {
            var exp = block.exp ? $ctrl.CPS.MomentService.getTimestamp($ctrl.CPS.MomentService.getMomentFromString(block.exp)) : null,
                isExp = exp && exp < $ctrl.CPS.MomentService.getTimestamp();
            return !isExp;
        }
        return false;
    }

    function toggle(e, prop) {
        $ctrl.preventDefault(e);
        $ctrl.LCS.setSetting(getProp(prop), true);
        var parent = $ctrl.element.querySelector('.onboarding');

        var hasOthers = false;

        var block = hasOthers ? {}: null;
        if (showBanner(block)) { //show next banner
            $ctrl.LCS.appendChildFragment(parent, getContainer(block), true);
        } else {
            $ctrl.LCS.addClass($ctrl.element.querySelector('.on-boarding'), 'sb-hide');
        }
    }

    function getProp(prop) {
        return 'hide' + prop;
    }

    function getBlock() {
        var p = {
            name: 'storyboardArrows',
            title: 'Introducing Storyboard Arrows',
            desc: 'Add storyboard-style arrows to any image with a drag-and-drop interface.\n Instantly communicate camera and subject movements.',
            pageClass: 'page-class shotsPage',
            exp:  '2024-01-16T00:00:00.000Z'
        };
        var f = $ctrl.getFeature(p.name);
        if (f) {
            p.videoUrl = f.videoUrl;
        }
        return p;
    }
}

