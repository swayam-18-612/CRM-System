FeatureUnavailablPopupCtrl.$inject =['QuotaUpdatedPopupCtrlService', '$element'];

function FeatureUnavailablPopupCtrl(QuotaUpdatedPopupCtrlService, $element) {

    var $ctrl = this;

    $ctrl.getDetails = getDetails;
    $ctrl.getOtherInfo = getOtherInfo;

    $ctrl = new QuotaUpdatedPopupCtrlService($ctrl, $element);

    function getOtherInfo( ){
        return {
            title: 'Upgrade to unlock <br/>'+ $ctrl.featureName
        }
    }

    function getDetails(hideButton) {
        var isOpen = hideButton === true;
        var desc = 'Upgrade to the ' + $ctrl.nextPlan + ' plan to ';
        switch ($ctrl.quotaType) {
            case 'team':
                return {
                    title: 'Your plan doesn’t support Teams',
                    desc: 'Upgrade to the '+$ctrl.nextPlan+' plan (or higher) to start adding team seats to your account.'
                };

            case 'pdfBuilder':
                return {
                    desc: desc + 'create customizable PDFs.' +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>'+
                                '<li>Adjust display details</li>'+
                                '<li>Customize layouts and styles</li>' +
                                '<li>Export PDFs across StudioBinder</li>' +
                                '</ul>'
                        })
                };

            case 'advancedPdfBuilder':
                return {
                    desc: desc + 'unlock more PDF features.' +
                        $ctrl.getAccordion({
                            isOpen: isOpen,
                            title: 'Explore Features',
                            content: '<ul>' +
                                '<li>Style front and back covers</li>' +
                                '<li>Adjust company letterhead and footers</li>' +
                                '<li>Secure PDFs with watermarks</li>' +
                                '</ul>'
                        })
                };

            //Screenwriting
            //Title Page Designer
            case 'scriptTitlePage':
                return {
