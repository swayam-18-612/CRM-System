angular.module('apiPagination.ApiPagination', [
])

.factory('ApiPagination', ApiPaginationFactory);
ApiPaginationFactory.$inject = ['i18nNotifications'];

function ApiPaginationFactory(i18nNotifications) {
    return function (service) {
        var Pagination = function (pageSize, includeFields, searchFields, orderFields, populate, defaultOrder, defaultOrderDir) {
            this.pageSize = pageSize;
            this.filters = {deleted: false};
            this.orderFields = orderFields ? orderFields : {};
            this.defaultOrder = defaultOrder ? defaultOrder : 'order';
            this.defaultOrderDir = defaultOrderDir ? defaultOrderDir : 1;
            this.orders = {};
            this.includeFields = includeFields ? includeFields : null;
            this.busy = false;
            this.currentPage = 0;
            this.noMoreDataToLoad = false;
            this.isLoaded = false;

            this.items = [];
            this.totalCount = 0;
            this.search = '';
            this.searchFields = searchFields ? searchFields : null;
            this.populate = populate ? populate : null;
            this.allIds = [];
            this.lastUpdated = null;
            this.withoutResourceObject = true;

            this.service = service;
        };

        Pagination.prototype.getNewItemOrder = function (listName) {
            var _this = this;
            if (!listName) {
                listName = 'items';
            }

            //order starts at 0
            return (_this[listName] && _this[listName].length > 0 ? _.max(_this[listName], function (item) {
                return item.order;
            }).order : -1) + 1;
        }

        Pagination.prototype.getTotal = function (listName) {
            return this['totalCount' + (listName === 'items' ? '' : listName)] || 0;
        }

        Pagination.prototype.setTotal = function (val, listName) {
            this['totalCount' + (listName === 'items' ? '' : listName)] = val;
        }

        Pagination.prototype.incrementTotal = function (listName) {
            var _this = this;
            _this.setTotal(_this.getTotal(listName) + 1, listName);
        }

        Pagination.prototype.decrementTotal = function (listName) {
            var _this = this;
            _this.setTotal(_this.getTotal(listName) - 1, listName);
        }

        Pagination.prototype.getService = function () {
            return service;
        };

        Pagination.prototype.setCollectionName = function (collectionName) {
            this.collectionName = collectionName;
        };

        Pagination.prototype.insertElement = function (el, insertAfter, listName) {
            var _this = this;
            if (!listName) {
                listName = 'items';
            }
            if (_this.getElementIndexById(el) !== -1) {
                return;
            }
            if (insertAfter) {
                _this[listName].push(el);
            } else {
                _this[listName].splice(0, 0, el);
            }
            _this.incrementTotal(listName);
        };

        Pagination.prototype.getInsertElementIndex = function (el, listName) {
            var _this = this;
            if (!listName) {
                listName = 'items';
            }
            var l = _this[listName].length;
            if (l === 0) {
                return 0;
            } else {
                var items = [].concat(_this[listName]);
                items.push(el);
                var order, dir ;
                if(Object.keys(_this.orders).length === 0 ){
                    order = _this.defaultOrder;
                    dir = _this.defaultOrderDir;
                }else{
                    for(var prop in _this.orders){
                        order = prop;
                        dir = _this.orders[prop];
                    }
                }
                items = _.sortBy(items, order);
                if(dir === -1) {
                    items = items.reverse();
                }
                return _.findIndex(items, {_id: el._id});
            }
        };

        Pagination.prototype.insertElementAtIndex = function (el, index, listName) {
            var _this = this;
            if (!listName) {
                listName = 'items';
            }
            if (_this.getElementIndexById(el, listName) !== -1) {
                return;
            }

            var total = _this.getTotal(listName);
            if (index === null || index === undefined || typeof (index) !== 'number' || index >= total) {
                _this[listName].push(el);
            } else if (index === 0) {
                _this[listName].unshift(el); //insert at the begining
            } else {
                _this[listName].splice(index, 0, el);
            }
            _this.setTotal(total + 1, listName);
        };

        Pagination.prototype.insertElementByOrder = function (el, listName) {
            var _this = this;
            if (!listName) {
                listName = 'items';
            }
            var l = _this[listName].length;
            if (l === 0) {
                _this[listName].push(el);
            } else {
                if (_this.getElementIndexById(el, listName) !== -1) {
                    return;
                }
                var after = 0,
                    order = _this[listName].defaultOrder;
                for (var i = 0; i < l; i++) {
                    var o = _this[listName][i][order];
                    after = i;
                    if (el[order] >= o) {
                        break;
                    }
                }
                if (after < l - 1) {
                    if (after === 0) {
                        _this[listName].unshift(el);
                    } else {
                        _this[listName].splice(after, 0, el);
                    }
                } else if (after === l - 1) {
                    _this[listName].push(el);
                }
            }
            _this.incrementTotal(listName);
        };

        Pagination.prototype.setList = function (list, listName) {
            if (!listName) {
                listName = 'items';
            }
            var _this = this;
            _this.clearParams(listName);
            var l = list.length && list.length > 0 ? list.length : 0;
            _this.removeAll(listName);
            _this[listName] = l > 0 ? [].concat(list) : [];
            _this.setTotal(l, listName);
            _this.currentPage = 1;
            _this.noMoreDataToLoad = true;
            _this.isLoaded = true;
            _this.busy = false;
            if (_this.onLoaded) {
                _this.onLoaded(_this.noMoreDataToLoad);
            }
        };

        Pagination.prototype.removeAll = function (listName) {
            var _this = this;
            if (!listName) {
                listName = 'items';
            }
            _this[listName].length = 0;
            _this.setTotal(0, listName);
        };

        Pagination.prototype.removeElement = function (el, listName) {
            if (!listName) {
                listName = 'items';
            }
            var _this = this, found, items = _this[listName];
            var f, l = items.length;
            for (var i = l - 1; i >= 0; i--) {
                f = items[i];
                if (f && f._id === el._id) {
                    _this.removeElementByIndex(i, listName);
                    found = true;
                }
            }
            return found;
        };

        Pagination.prototype.addElements = function (els, listName) {
            var _this = this;
            if (!listName) {
                listName = 'items';
            }
            var l = els && els.length > 0 ? els.length : 0;
            for (var i = 0; i < l; i++) {
                var el = els[i];
                if (el && _.find(_this[listName], {_id: el._id}) === undefined) {
                    _this[listName].push(els[i]);
                    _this.incrementTotal(listName);
                }
            }
        };

        Pagination.prototype.removeElementsByIds = function (ids, listName) {
            var _this = this;
            if (!listName) {
                listName = 'items';
            }
            var f, l = _this[listName].length;
            for (var i = l - 1; i >= 0; i--) {
                f = _this[listName][i];
                if (f && ids.indexOf(f._id) !== -1) {
                    _this.removeElementByIndex(i, listName);
                }
            }
            return f;
        };

        Pagination.prototype.getElementById = function (id, listName) {
            if (!listName) {
                listName = 'items';
            }
            return this.getElementBlockById(id, listName).item;
        };

        Pagination.prototype.getElementBlockById = function (id, listName) {
            var _this = this;
            if (!listName) {
                listName = 'items';
            }
            var l = _this[listName].length;
            for (var i = 0; i < l; i++) {
                var el = _this[listName][i];
                if (el && el._id === id) {
                    return {item: el, index: i};
                }
            }
            return {item: null, index: -1};
        };

        Pagination.prototype.getElementIndexById = function (id, listName) {
            if (!listName) {
                listName = 'items';
            }
            return this.getElementBlockById(id, listName).index;
        };

        Pagination.prototype.getElementByIndex = function (index, listName) {
            var _this = this;
            if (!listName) {
                listName = 'items';
            }
            if (index < _this.getTotal(listName)) {
                return _this[listName][index];
            }
            return null;
        };

        Pagination.prototype.removeElementByIndex = function (index, listName) {
            if (!listName) {
                listName = 'items';
            }
            var _this = this;
            _this[listName].splice(index, 1);
            _this.decrementTotal(listName);
        };

        Pagination.prototype.replaceElement = function (el, listName) {
            var _this = this;
            if (!el) {
                return;
            }
            if (!listName) {
                listName = 'items';
            }
            var block = _this.getElementBlockById(el._id, listName),
                index = block.index;
            if (index === -1) {
                return;
            }

            var item = block.item,
                createdBy = item.createdBy,
                createdById = item.createdById;

            if (typeof (createdBy) === 'object' && createdBy != null) {
                el.createdBy = createdBy;
                el.createdById = createdById;
            }

            _this[listName].splice(index, 1, angular.copy(el));

        };

        //todo not yet used . reqas more work
        Pagination.prototype.replaceElementsByProp = function (prop, val, listName) {
            var _this = this;
            if (!listName) {
                listName = 'items';
            }
            if (!prop || !val || val[prop] === undefined) {
                return;
            }
            _.each(_this[listName], function (item) {
                var propVal = val[prop];
                if (!angular.equals(item[prop], propVal)) {
                    var data = {};
                    data[prop] = propVal;
                    _this.replaceElementProps(item._id, data, listName);
                }
            });
        };

        Pagination.prototype.replaceElementProps = function (id, props, listName) {
            var _this = this;
            if (!listName) {
                listName = 'items';
            }
            var block = _this.getElementBlockById(id, listName),
                index = block.index;
            if (index === -1) {
                return;
            }

            var item = block.item;
            var ni = getChangedItem(angular.copy(item), props);

            if (!ni) {
                return;
            }
            _this[listName].splice(index, 1, ni);
        };

        Pagination.prototype.replaceElementChildProps = function (id, child, props, listName) {
            if (!listName) {
                listName = 'items';
            }
            var _this = this,
                block = _this.getElementBlockById(id, listName),
                index = block.index;
            if (index === -1) {
                return;
            }

            var item = block.item,
                ni1 = angular.copy(item),
                ni = getChangedItem(ni1 ? ni1[child] : null, props);

            if (!ni) {
                return;
            }

            ni1[child] = ni;
            _this[listName].splice(index, 1, ni1);
        };

        function getChangedItem(ni, props) {
            var changed;
            if (!ni) {
                return;
            }

            if (typeof (ni.runConversions) === 'function') {
                changed = ni.replaceElementProps(props);
            } else {
                for (var prop in props) {
                    if (!angular.equals(ni[prop], props[prop])) {
                        ni[prop] = props[prop];
                        changed = true;
                    }
                }
            }
            return changed ? ni : null;
        }

        Pagination.prototype.replaceAllElementsProps = function (props, listName) {
            if (!listName) {
                listName = 'items';
            }
            var _this = this;
            if (!_this[listName]) {
                return;
            }
            _.each(_this[listName], function (el) {
                _this.replaceElementProps(el._id, props, listName);
            });
        };

        Pagination.prototype.refreshItems = function (listName) {
            if (!listName) {
                listName = 'items';
            }
            var _this = this,
                n = _this[listName] && _this[listName].length ? _this[listName].length : 0;
            if (!n) {
                return;
            }
            for (var i = 0; i < n; i++) {
                _this[listName].splice(i, 1, angular.copy(_this[listName][i]));
            }
        };

        Pagination.prototype.isAsc = function (prop) {
            var _this = this;
            return _this.orders[prop] === 1;
        };

        Pagination.prototype.clearParams = function (listName) {
            if (!listName) {
                listName = 'items';
            }
            var _this = this;
            _this.currentPage = 0;
            _this.noMoreDataToLoad = false;
            _this.isLoaded = false;
            _this.busy = false;
            _this.setTotal(0, listName);
            _this.search = '';
            _this.removeAll(listName);
            return _this;
        }

        Pagination.prototype.reload = function (listName) {
            if (!listName) {
                listName = 'items';
            }
            var _this = this;
            if (!_this.busy) {
                _this.clearParams(listName);
                /*{ name: { $regex: /acme.*corp/, $options: 'i',*/
                _this.nextPage(null, null, null, listName);
            }
        };

        Pagination.prototype.updateFilters = function (filters, orders, search) {
            var _this = this;
            var changed = false;
            if (_this.filters && _this.filters != null && _this.filters != filters) {
                _this.filters = filters;
                changed = true;
            }

            if (_this.orders && _this.orders != null && _this.orders != orders) {
                _this.orders = orders;
                changed = true;
            }

            if (search && _this.search != search) {
                _this.search = search;
                if (_this.search != null && _this.search !== '' && _this.searchFields != null) {
                    _this.filters.$or = [];
                    _.each(_this.searchFields, function (f) {
                        var el = {};
                        el[f] = {'$regex': _this.search, '$options': 'i'};
                        _this.filters.$or.push(el);
                    });
                }
                changed = true;
            }
            if (!_this.filtersSet) {
                _this.filtersSet = true;
            }
            return changed;
        };

        Pagination.prototype.getIds = function (filters, orders, search, selectAllMethod) {
            var _this = this;
            var changed = _this.updateFilters(filters, orders, search);
            if (changed) {
                _this.service.queryAllIds(_this.filters, _this.orders, _this.fillIds, _this.onError, _this);
                _this.selectAllMethod = selectAllMethod;
            }
        };

        Pagination.prototype.load = function (filters, orders, search, listName) {
            if (!listName) {
                listName = 'items';
            }
            var _this = this;
            var changed = _this.updateFilters(filters, orders, search);
            if (changed) {
                _this.reload(listName);
            }
        };

        Pagination.prototype.changeFilter = function (name, val, listName) {
            if (!listName) {
                listName = 'items';
            }
            var _this = this;
            for (var prop in _this.filters) {
                if (name === prop && _this.filters[prop] != val) {
                    _this.filters[prop] = val;
                    _this.reload(listName);
                }
            }
        };

        Pagination.prototype.changeOrder = function (prop, type, sortOrder, itemSort, $ctrl, listName) {
            if (!listName) {
                listName = 'items';
            }
            var _this = this;
            if(_this.orders) {
                for (var p in _this.orders) {
                    if (prop === p) {
                        //use first the order provided
                        _this.orders[p] = sortOrder ? sortOrder : (_this.orders[p] === -1 ? 1 : -1);
                        return onSuccess();
                    }
                }
            }
            _this.orders = {};
            _this.orders[prop] = sortOrder ? sortOrder : 1;

            if (_this[listName].length === 0) {
                return [];
            }

            return onSuccess();

            function onSuccess() {
                var s = prop.split('.'),
                    l = s.length,
                    order = _this.orders[prop],
                    list = _this[listName], items;

                //for currentId on elements page
                if(s.length === 1 && type === 8) {
                    for (var i = 0; i < list.length; i++) {
                        var p = list[i] ? list[i][prop] : null,
                            v;
                        if (p) {
                            v = parseInt(p, 10);
                        }
                        list[i][prop + 'X'] = v ? v : p;
                    }

                    prop = prop + 'X';
                }

                var sortItem = function (item) {
                    var v = itemSort(item, prop, type, $ctrl);
                    return v && v.v ? v.v : get(item);
                };
                //s.length === 1 ? prop : sortItem
                items = _.sortBy(list, sortItem);

                if(order === -1){
                    items = items.reverse();
                }

                _this[listName] = items;

                console.log('changeOrder: sort by '+prop  + (order === -1 ? ' desc' : ' asc'));

                function get(a) {
                    var v;
                    if (l <= 1) {
                        v = a ? a[prop] : null;
                    } else {
                        v = a && a[s[0]] ? a[s[0]][s[1]] : null;
                    }
                    return v;

                    //return (v === null || v === undefined) ? 1000 : v;
                }
            }
        };

        Pagination.prototype.onError = function (error, status, headers, config) {
            Pagination.prototype.busy = false;
            i18nNotifications.pushForCurrentRoute(error, 'crud.pagination.load.error', 'error');
        };

        /*
        Pagination.prototype.onLoaded = function (noMoreDataToLoad) {

        };

        Pagination.prototype.intermediaryProcessing = function (items) {

        };*/

        Pagination.prototype.fillItems = function (result, status, headers, config, _this, listName) {
            if (!listName) {
                listName = 'items';
            }
            _this.setTotal(result.count ? result.count : 0, listName);
            var items = result.docs;
            if (_this.intermediaryProcessing) {
                items = _this.intermediaryProcessing(items);
            }
            var count = items && items.length > 0 ? items.length : 0;
            if (count) {
                for (var i = 0; i < count; i++) {
                    _this.items.push(_this.dontconvert ? items[i] : _this.service.convertResource(items[i]));
                }

                if (result.pages === result.page) {
                    _this.noMoreDataToLoad = true;
                }
            } else {
                _this.currentPage = 0;
                _this.noMoreDataToLoad = true;
            }
            _this.lastUpdated = new Date().toDateString();
            _this.busy = false;
            _this.isLoaded = true;
            if (_this.onLoaded) {
                _this.onLoaded(_this.noMoreDataToLoad);
            }
        };

        Pagination.prototype.nextPage = function (filters, orders, search, listName) {
            var _this = this;
            if (_this.busy) {
                return;
            }
            if (_this.noMoreDataToLoad) {
                _this.currentPage = 0;
                return;
            }

            if (!_this.filtersSet) {
                _this.updateFilters(filters, orders, search);
            }

            _this.currentPage = _this.currentPage + 1;
            _this.busy = true;
            _this.service.queryPaged(_this.filters, _this.pageSize, _this.currentPage, _this.orders, _this.includeFields, _this.populate, _this.fillItems, _this.onError, _this.withoutResourceObject, _this);
        };

        Pagination.prototype.fillIds = function (result, status, headers, config, additionalParam) {
            var _this = additionalParam;
            _this.allIds = result;
            _this.selectAllMethod(result);
        };

        return Pagination;

        function splice(_this, index, item) {
            if (index === 0) {
                _this.items.unshift(item);
            } else {
                _this.items.splice(index, 0, item);
            }
        }
    }
}

angular.module('apiServices.http.service', [
    'apiServices.dexie.service'
])
.factory('ResourceHttpService', ResourceHttpService);
ResourceHttpService.$inject = ['StateHeadersService','API_CONFIGS','$http', 'DexieService'];
function ResourceHttpService(StateHeadersService, API_CONFIGS, $http, DexieService) {
    return function() {
        var Configs = API_CONFIGS(),
            dataApi = Configs.dataApi;

        var service = {
            pageSize: 20000 //Configs.pageSize || 20000
        };
        service.collectionName = null;
        service.convertResource = function () {
            return null;
        };

        service.$get = getServiceMethod;
        service.$post = postServiceMethod;
        service.$put = putServiceMethod;
        service.$delete = deleteServiceMethod;
        service.queryPaged = queryPaged;
        service.queryAndPopulate = queryAndPopulate;
        service.queryAllIds = queryAllIds;
        service.$queryIncluded = $queryIncluded;
        service.getCount = getCount;
        service.query = query;
        service.getActive = getActive;

        service.$insert = $insert;
        service.$update = $update;
        service.delete = deletex;
        service.archive = archive;
        service.activate = activate;
        service.getById = getById;
        service.$getAll = $getAll;

        service.postUrl = postUrl;
        service.putUrl = putUrl;
        service.getUrl = getUrl;

        service.getPostPath = getPostPath;
        return service;

        function getPostPath() {
            return '/' + service.collectionName;
        }
        function $insert (data, successcb, errorcb) {
            return service.$post(getApiPath(), data, successcb, errorcb, true);
        }

        function $update(data, successcb, errorcb) {
            return service.$put(getApiPath() + "/" + data._id, data, successcb, errorcb);
        }

        function deletex(data, successcb, errorcb) {
            return service.$delete(getApiPath() + "/" + data._id, data, successcb, errorcb, true);
        }
        function archive(data, successcb, errorcb) {
            return service.$put(getApiPath() + "/" + data._id,  _.extend(data, {active:false}), successcb, errorcb);
        }

        function activate(data, successcb, errorcb) {
            return service.$put(getApiPath() + "/" + data._id, _.extend(data, {active:true}), successcb, errorcb);
        }
        //ex: populate =  "castId productId createdById"
        function getById(id, populate, successcb, errorcb) {
            var data = {};
            if (populate) {
                data.p = populate;
            }
            return service.$get(getApiPath() + "/getById/" + id, data, successcb, errorcb);
        }

        function $getAll(query, pageSize, populate, successcb, errorcb, withoutResourceObject) {
            return service.queryPaged(query, pageSize ? pageSize : service.pageSize, 0, null, null, populate, successcb, errorcb, withoutResourceObject);
        }

        function getUrl(url, data, successcb, errorcb){
            return service.$get(service.getPostPath(data) + url, {}, successcb, errorcb);
        }

        function postUrl(url, data, successcb, errorcb, withoutResourceObject){
            return service.$post(service.getPostPath(data) + url, data, successcb, errorcb, withoutResourceObject);
        }

        function putUrl(url, data, successcb, errorcb, withoutResourceObject) {
            return service.$put(service.getPostPath(data) + url, data, successcb, errorcb, withoutResourceObject);
        }

        function getApiPath() {
            return dataApi + "/" + service.collectionName;
        }
        /*
         q=<query> - restrict results by the specified JSON query
         c=true - return the result count for this query
         f=<set of fields> - specify the set of fields to include or exclude in each document (1 - include; 0 - exclude)
         fo=true - return a single document from the result set (same as findOne() using the mongo shell
         s=<sort order> - specify the order in which to sort each specified field (1- ascending; -1 - descending)
         sk=<num results to skip> - specify the number of results to skip in the result set; useful for paging
         l=<limit> - specify the limit for the number of results (default is 10000)
         */
        function queryPaged(queryJson, pageSize, pageNo, sortingFields, includeFields, populate, successcb, errorcb, withoutResourceObject, additionalParam, path) {
            if (queryJson == null) {
                queryJson = {};
            }

            var params = {};
            params.q = JSON.stringify(queryJson);

            if (pageNo != null) {
                params.page = pageNo;
            }

            params.l = pageSize ? pageSize : service.pageSize;

            if (sortingFields != null) {
                params.s = JSON.stringify(sortingFields);
            }

            if (includeFields != null) {
                var include = {};
                for (var i = 0; i < includeFields.length; i++) {
                    include[includeFields[i]] = 1;
                }
                params.f = JSON.stringify(include);
            }

            if (populate != null) {
                params.populate = populate;
            }
            return getServiceMethod( path ? path :(getApiPath() + '/query'), params, successcb, errorcb, withoutResourceObject, additionalParam);
        }

        function queryAndPopulate(queryJson, pageSize, populate, successcb, errorcb, withoutResourceObject) {
            return service.queryPaged(queryJson, pageSize, 0, null, null, populate, successcb, errorcb, withoutResourceObject);
        }

        function queryAllIds(queryJson, sortingFields, successcb, errorcb, additionalParam) {
            if (queryJson == null) {
                queryJson = {};
            }
            var params = {q: JSON.stringify(queryJson)};
            if (sortingFields != null) {
                params.s = JSON.stringify(sortingFields);
            }

            return getServiceMethod(getApiPath() + "/getAllIds", params, successcb, errorcb, true, additionalParam);
        }

        function $queryIncluded(queryJson, includeFields, successcb, errorcb, withoutResourceObject, additionalParam) {
            var params = {};
            if (queryJson != null) {
                params.q = JSON.stringify(queryJson);
            }

            var include = {};
            if (includeFields != null) {
                for (var i = 0; i < includeFields.length; i++) {
                    include[includeFields[i]] = 1;
                }
                params.f = JSON.stringify(include);
            }

            return getServiceMethod(getApiPath() + '/query', params, successcb, errorcb, withoutResourceObject, additionalParam);
        }

        function getCount(filters, successcb, errorcb) {
            var params = {};
            var f = filters != null ? filters : {};
            params.q = JSON.stringify(f);
            params.c = true;

            return getServiceMethod(getApiPath() + '/query', params, successcb, errorcb, true, null);
        }

        function query(queryJson, successcb, errorcb, withoutResourceObject) {
            return queryPaged(queryJson, null, null, null, null, null, successcb, errorcb, withoutResourceObject);
        }

        function getActive(successcb, errorcb) {
            return $queryIncluded({active: true}, null, successcb, errorcb, true);
        }

        /***/

        function onSuccess(response, successcb, errorcb, withoutResourceObject, additionalParam) {
            var scb = successcb || onSuccessOrError;

            if (response && response.data) {
                var result = response.data;
                if (!withoutResourceObject) {
                    if (result instanceof Array) {
                        result = processArray(result);
                    }
                    else if (result.docs) {
                        result.docs = processArray(result.docs);
                    }
                    else {
                        var item = result.item;
                        if (item) {
                            result.item = service.convertResource(item);
                        }
                        else {
                            result = service.convertResource(result);
                        }
                    }
                }

                return scb(result, response.status, response.headers, response.config, additionalParam);
            } else {
                return onError(response, errorcb);
            }
        }

        function processArray(list) {
            var r = [];
            for (var i = 0; i < list.length; i++) {
                r.push(service.convertResource(list[i]));
            }
            return r;
        }

        function onSuccessOrError(response, status, headers, config) {
            return response;
        }

        function onError(response, errorcb) {
            var ecb = errorcb || angular.noop;
            var data = response.data;
            if (typeof(ecb) === 'function') {
                return ecb(data, response.status, response.headers, response.config);
            }
            else if (data.message) {
                console.log(data.message);
            }
        }


        function thenServiceMethod(method, url, data, successcb, errorcb, withoutResourceObject, additionalParam) {
            var headers = angular.copy(StateHeadersService.stateHeaders ? StateHeadersService.stateHeaders : StateHeadersService.getHttpHeaders());
            headers['x-collection'] = service.collectionName;
            headers['x-transaction-id'] = new Date().getTime();
            if(!headers['Content-Type']){
                headers['Content-Type'] = 'application/json';
            }

            var params = {
                headers: headers,
                method: method,
                url: url
            };

            params[method === 'GET' ? 'params' : 'data'] = data;

            if(service.withScriptId ){
                processX('scriptId', 'x-script-id');
            }

            if(service.withCallsheetId ){
                processX('callsheetId', 'x-callsheet-id');
            }

            return $http(params)
                .then(function (response) {
                    return onSuccess(response, successcb, errorcb, withoutResourceObject, additionalParam);
                })
                .catch(function (response) {
                    return onError(response, errorcb);
                });

            function processX(prop, xProp){
                if( !headers[xProp]){
                    if( data[prop]){
                        headers[xProp] = data[prop];
                    }else if(data.q){
                        if(data.q[prop]) {
                            headers[xProp] = data.q[prop];
                        }else{
                            try{
                                headers[xProp] = JSON.parse(data.q)[prop];
                            }catch(e){
                            }
                        }
                    }
                    if(!headers[xProp]){
                        console.error('thenServiceMethod: request must set '+prop);
                    }
                }
            }
        }

        function getServiceMethod(url, data, successcb, errorcb, withoutResourceObject, additionalParam) {
            return thenServiceMethod('GET', url, data, successcb, errorcb, withoutResourceObject, additionalParam);
        }

        function postServiceMethod(url, data, successcb, errorcb, withoutResourceObject, additionalParam) {
            return thenServiceMethod('POST', url, data, successcb, errorcb, withoutResourceObject, additionalParam);
        }

        function putServiceMethod(url, data, successcb, errorcb, withoutResourceObject, additionalParam) {
            return thenServiceMethod('PUT', url, data, successcb, errorcb, withoutResourceObject, additionalParam);
        }

        function deleteServiceMethod(url, data, successcb, errorcb, withoutResourceObject, additionalParam) {
            return thenServiceMethod('DELETE', url, data, successcb, errorcb, withoutResourceObject, additionalParam);
        }
    }
}

angular.module('apiServices.ApiService', [
    'apiServices.http.service',
    'apiServices.paths.service',
    'resources.Users'
])
.factory('ApiService', ApiService);
ApiService.$inject = ['ResourceHttpService', 'Users'];
function ApiService(ResourceHttpService, Users) {
    /*{
            listType: listType,
            listField: listField,
        }*/
    return function (model, params) {
        var fieldsForBG =  ['color', 'background', 'backgroundId', 'sideColors'];
        var service = ResourceHttpService();
        service.fieldsUpdatedOnOrderChanged = ['order'];
        service.model = model;
        service.Users = Users;

        if(params) {
            _.each(['listType', 'listField', 'materialProps',
                'withCallsheetId', 'withScriptId', 'withAutoBreaks', 'customBGForList'], function (p) {
                if (params[p]) {
                    service[p] = params[p];
                }
            });
            if (params.fieldsUpdatedOnOrderChanged) {
                service.fieldsUpdatedOnOrderChanged = service.fieldsUpdatedOnOrderChanged.concat(params.fieldsUpdatedOnOrderChanged);
            }
        }

        service.convertResource = convertResource;
        service.collectionName = model.collectionName;
        service.collectionType = model.collectionType ? model.collectionType  : model.collectionName;

        service.getChangedFieldForUpdate = getChangedFieldForUpdate;
        //   console.log('ApiService: '+service.collectionName);
        service.getCollectionName = getCollectionName;
        service.getAll = getAllInit;
        service.getAllInit = getAllInit;

        service.getForUser = getForUser;
        service.search = search;
        service.insert = insert;
        service.update = update;
        service.move = move;
        service.compareObjects = compareObjects;
        service.getChanges = getChangesInit;
        service.getChangesInit = getChangesInit;
        service.getChangesForced = getChangesForced;
        service.convertResourceSimple = convertResourceSimple;

        if(service.customBGForList){
            if(!service.materialProps){
                service.materialProps = [];
            }
            var prop = 'background';
            if(!_.find(service.materialProps, function (p){return prop === p;})) {
                service.materialProps.push(prop);
            }
        }

        if (service.listType) {
            if (service.listType === 'isListOptions') {
                service.setOptions = setOptions;
                service.getListOptions = getListOptions;
            }
            if (service.listType === 'isGroup' ||
                service.listType === 'isListRecursive') {
                if (service.listField) {
                    service.fieldsUpdatedOnOrderChanged.push(service.listField);
                }
                service.clipboardProcessing = clipboardProcessing;
                service.removeAll = removeAll;
                service.like = like;
            }
            if (service.listType === 'isList' ||
                service.listType === 'isListRecursive') {
                service.fieldsUpdatedOnOrderChanged.push('parentId');
                service.getWithCounters = getWithCounters;
                service.duplicate = duplicate;
                service.onDuplicate = onDuplicate;
            }

            if (service.listType === 'isGroup' ||
                service.listType === 'isList' ||
                service.listType === 'isListRecursive') {
                service.updateSelected = updateSelected;
                service.printSelected = printSelected;
                service.downloadPrintUrl = downloadPrintUrl;
                service.loadPrint = loadPrint;
                service.updateOrder = updateOrder;
            }

            if (service.listType === 'isListRecursive' && !service.listField) {
                service.listField = 'parentId';
            }

            if (service.withAutoBreaks) {
                service.autoBreaks = autoBreaks;
                service.sortStrips = sortStrips;
                service.getDayBreaks = getDayBreaks;
            }
        }

        service.getUserObject = getUserObject;

        return service;

        function getUserObject(item, prop){
            if (service.Users) {
                var propId = prop + 'Id',
                    propName = prop + 'Name',
                    v = item[propId];
                if (v && typeof (v) === "object") {
                    item[prop] = new service.Users(v);
                    item[propId] = v._id;
                    item[propName] = v.name;
                }
            }
            return item;
        }

        function autoBreaks(params, successcb, errorcb){
            return service.postUrl( '/auto-breaks', params, successcb, errorcb);
        }

        function sortStrips(params, successcb, errorcb){
            return service.postUrl('/auto-sort', params, successcb, errorcb);
        }

        function getDayBreaks(params, successcb, errorcb){
            return service.postUrl('/get-day-breaks', params, successcb, errorcb);
        }

        function getListOptions(params, next) {
            service.query(params, function (res) {
                next(res && res.docs && res.docs.length > 0 ? res.docs[0].options : null);
            }, function (error) {
                next(null);
            });
        }

        function getWithCounters(params, successcb, errorcb){
            return service.postUrl('/all-with-counters', params, function (res) {
                if(res.items && res.items.length>0){
                    res.items = res.items.map(function (item) {
                        return item ? service.convertResource(item) : null;
                    });
                }
                if(typeof(service.onGetListsWithCounters) === 'function'){
                    service.onGetListsWithCounters(res);
                }

                return successcb(res);
            }, errorcb, true);
        }

        function duplicate(params, successcb, errorcb) {
            return service.postUrl('/duplicate', params, function (res) {
                successcb(service.onDuplicate ? service.onDuplicate(res) : res);
            }, errorcb);
        }

        function move(params, successcb, errorcb) {
            return service.postUrl('/move', params , successcb, errorcb);
        }
        function like(params, successcb, errorcb) {
            return service.postUrl('/like', params , successcb, errorcb);
        }
        function updateSelected(params, successcb, errorcb) {
            return service.putUrl('/update-selected', params, successcb, errorcb, true);
        }
        function printSelected(params, successcb, errorcb) {
            return service.putUrl('/print-selected', params, successcb, errorcb, true);
        }

        function downloadPrintUrl(params) {
            return service.getPostPath(params) + '/download-print';
        }

        function loadPrint(params, successcb, errorcb) {
            return service.postUrl('/load-print/'+params.printId, params, successcb, errorcb, true);
        }

        function clipboardProcessing(params, successcb, errorcb){
            return service.postUrl('/clipboard-processing', params, successcb, errorcb, true);
        }

        function removeAll(params, successcb, errorcb){
            return service.postUrl('/remove-all', params, successcb, errorcb);
        }

        function updateOrder(params, successcb, errorcb) {
            return service.postUrl('/update-order', {updates: params}, successcb, errorcb, true);
        }

        function convertResourceSimple(item) {
            if (!item) {
                return null;
            }
            if(service.listType === 'isList' || service.listType === 'isListRecursive') {
                if (item.type === undefined) {
                    item.type = 6;
                }
                if (item.parentId === undefined) {
                    item.parentId = null;
                }
                if (item.isFolder === undefined) {
                    item.isFolder = false;
                }
            }
            return item;
        }
        function convertResource(item) {
            if (!item) {
                return null;
            }

            item = service.convertResourceSimple(item);

            item = service.getUserObject(item, 'createdBy');
            item = service.getUserObject(item, 'updatedBy');

            if(service.listType === 'isList' || service.listType === 'isListRecursive'){
                if (item.nodes && item.nodes.length > 0) {
                    item.nodes = item.nodes.map(function (item) {
                        if (item && typeof(item.getType) !== 'function') {
                            item = service.convertResource(item);
                        }
                        return item;
                    });
                }
            }

            if(service.materialProps){
                _.each(service.materialProps, function (prop){
                    model.loadImageProp(item, prop);
                });
            }

            if(params && typeof(params.convertOtherResources) === 'function'){
                item = params.convertOtherResources(item);
            }

            return item ? (typeof(item.getType) === 'function' ? item : new model(item)) : null;
        }

        function setOptions(params, successcb, errorcb) {
            return service.putUrl('/set', params, successcb, errorcb);
        }

        function onDuplicate(res) {
            if (res && res.addded && res.addded.length > 0) {
                var total = 0;
                res.addded = res.items.map(function (item) {
                    if (item && item.total) {
                        total += item.total;
                    }
                    return item ? service.convertResource(item) : null;
                });
                if (res.item) {
                    res.item.count = total;
                }
            }
            return res;
        }

        function getChangedFieldForUpdate() {
            var l = [];
            switch (service.listType) {
                case 'isListOptions':
                    l.push('options');
                    break;

                case 'isList':
                case 'isGroup':
                case 'isListRecursive':
                    l.push('name');
                    l.push('order');
                    if (service.listField) {
                        l.push(service.listField);
                    }
                    break;
            }
            if (typeof (service.getChangedFieldForUpdateOther) === 'function') {
                if (service.customBGForList) {
                    l = l.concat(fieldsForBG);
                }
                return _.union(l, service.getChangedFieldForUpdateOther());
            }
            return l;
        }

        function getCollectionName() {
            return service.collectionName;
        }

        function getForUser(params, pageSize, populate, successcb, errorcb) {
            if(pageSize){
                params.l = pageSize;
            }
            if(populate){
                params.populate = populate;
            }
            return service.postUrl('/get-for-user', params, successcb, errorcb);
        }

        function getAllInit(query, pageSize, populate, successcb, errorcb, withoutResourceObject) {
            return service.$getAll(query, pageSize, populate, function (result) {
                return successcb(result.docs || []);
            }, errorcb, withoutResourceObject);
        }

        function search(query, populate, successcb, errorcb, withoutResourceObject) {
            return service.$search(query, populate, function (result) {
                return successcb(result.docs);
            }, errorcb, withoutResourceObject);
        }
        function insert(data, successcb, errorcb) {
            return service.$insert(data, successcb, errorcb);
        }

        function update(data, successcb, errorcb) {
            return service.$update(data, successcb, errorcb);
        }

        function compareObjects(s, t, dontCompareHashKey, initprop) {
            if (!s && !t || s == null && t == null) {
                //console.log("two objects are both null");
                return true;
            }

            if (s == null && t != null || s != null && t == null || typeof s !== typeof t) {
                //console.log("two objects not the same type");
                return false;
            }

            if (typeof s !== "object") {
                return s === t;
            }

            //compare to moment times
            if (s._isAMomentObject && t._isAMomentObject) {
                if (initprop === 'time' || initprop === 'calltime' ||
                    initprop === 'pickup' || initprop === 'onset' || initprop === 'costumes' || initprop === 'hmu' || initprop === 'wrap' ||
                    initprop === 'endTime') {
                    return s.hours() === t.hours() && s.minutes() === t.minutes();
                } else {
                    return s.date() === t.date() && s.month() === t.month() && s.year() === t.year() && s.hours() === t.hours() && s.minutes() === t.minutes();
                }
            }

            for (var prop in s) {
                if (dontCompareHashKey === true && prop === '$$hashKey') {

                } else {
                    if (s.hasOwnProperty(prop)) {
                        if (t.hasOwnProperty(prop)) {
                            if (!service.compareObjects(s[prop], t[prop], dontCompareHashKey, prop)) {
                                //console.log("property " + prop + " does not match");
                                return false;
                            }
                        } else {
                            //console.log("second object does not have property " + prop);
                            return false;
                        }
                    }
                }
            }
            // now verify that t doesn't have any properties
            // that are missing from s
            for (prop in t) {
                if (dontCompareHashKey === true && prop === '$$hashKey') {

                } else {
                    if (t.hasOwnProperty(prop)) {
                        if (!s.hasOwnProperty(prop)) {
                            //console.log("first object does not have property " + prop);
                            return false;
                        }
                    }
                }
            }
            return true;
        }


        function getChangesForced(changedFields, item) {
            return getChangesInit(changedFields, item, null, false, true);
        }

        function getChangesInit(changedFields, item, copyItem, dontCompareHashKey, forceUpdate) {
            var data = {};
            var propchanged = 0, j;
            for (var i = 0, l = changedFields.length; i < l; i++) {
                var aresame = true;
                var prop = changedFields[i],
                hasProp = _.has(item, prop),
                canProcess = false;
                if (dontCompareHashKey === true && prop === '$$hashKey') {
                } else {
                    var oldval = null, newval = null;
                    var props = prop.split('.'), m = props.length;
                    if (prop.indexOf('.') !== -1) {
                        if (!forceUpdate) {
                            var t = copyItem ? copyItem[props[0]] : null;
                            if(t){
                                t = t[props[1]];
                                if(t && m === 3){
                                    t = t[props[2]];
                                }
                            }
                            oldval = t;
                        }

                        if(hasProp) { // has . in prop ex. item[x.y]
                            /*newval = {};
                            var v = item[prop];
                            if (m === 2) {
                                newval[props[1]] = v;
                            } else if (m === 3) {
                                newval[props[1]] = {};
                                newval[props[1]][props[2]] = v;
                            }*/
                            newval = item[prop];
                            canProcess = true;
                        }else {
                            for (j = 0; j < m; j++) {
                                var p = props[j];
                                if(j === 0) {
                                    if (!_.has(item, p)) {
                                        newval = null;
                                        break;
                                    } else {
                                        newval = item[p];
                                        canProcess = true;
                                    }
                                }else if(newval){
                                    if (!_.has(newval, p)) {
                                        newval = null;
                                        break;
                                    } else {
                                        newval = newval[p];
                                        canProcess = true;
                                    }
                                }
                            }
                        }
                    } else {
                        if(hasProp) {
                            newval = item[prop];
                            if (!forceUpdate) {
                                oldval = copyItem && (copyItem[prop] || copyItem[prop] === false || copyItem[prop] === 0) ? copyItem[prop] : null;
                            }
                            canProcess = true;
                        }
                    }
                    if(canProcess) {
                        if (forceUpdate) {
                            process(prop, newval);
                        } else if (oldval != newval) {
                            if (oldval != null && newval != null &&
                                typeof (oldval) === 'object' && typeof (newval) === 'object') {
                                if (oldval.length !== undefined && newval.length !== undefined) {//if they're both arrays compare their properties
                                    if (oldval.length !== newval.length) {
                                        aresame = false;
                                    } else {
                                        for (j = 0; j < oldval.length; j++) {
                                            if (!service.compareObjects(oldval[j], newval[j], dontCompareHashKey)) {
                                                aresame = false;
                                                break;
                                            }
                                        }
                                    }
                                } else {
                                    aresame = service.compareObjects(oldval, newval, dontCompareHashKey, prop);
                                }
                            } else {
                                aresame = false;
                            }
                            if (!aresame) {
                                process(prop, newval);
                            }
                        }
                    }

                    function process(prop, newval){
                        data[prop] = newval;

                       /* if(m === 1) {
                            data[prop] = newval;
                        }else if(m === 2){

                            if(!data[props[0]]){
                                data[props[0]] = {};
                            }
                            data[props[0]][props[1]] = newval;
                        }*/
                        propchanged++;
                    }
                }
            }
            if (propchanged === 0) {
                data = null;
            }

            return data;
        }
    };
}

angular.module('security.crypto.service', [])
.factory('CryptoService', CryptoService);
CryptoService.$inject = [];
function CryptoService() {
    var algName = "AES-GCM",
        length = 256, shortLength = 128,
        isExtractableKey = false,
        options = ["encrypt", "decrypt"],
        crypto = window.crypto;

    function CryptoService() {
        var CryptoResource = function(key){
            this.key = key;
        };

        CryptoResource.getKey = function(){
            return this.key;
        };

        CryptoResource.isKey = function(key){
            return key && this.key == key;
        };

        CryptoResource.setKey = function (onSuccess, onError) {
            var _this = this;
            if(_this.key)onSuccess();
            else generateKey(function (key) {
                _this.key = key;
                onSuccess();
            }, onError);
        };

        CryptoResource.encrypt = function (data, onSuccess, onError) {
            process(this, encrypt, data, onSuccess, onError);
        };

        CryptoResource.decrypt = function (data, onSuccess, onError) {
            process(this, decrypt, data, onSuccess, onError);
        };

        return CryptoResource;

        function process(_this, method, data, onSuccess, onError) {
            if(_this.key) method(_this.key, data, onSuccess, onError);
            else {_this.setKey(function () {
                method(_this.key, data, onSuccess, onError);
            }, onError);}
        }
    }

    return CryptoService;

    //AES-GCM - generateKey
    function generateKey(onSuccess, onError) {
        crypto.subtle.generateKey(
            {
                name: algName,
                length: length, //can be  128, 192, or 256
            },
            isExtractableKey, //whether the key is extractable (i.e. can be used in exportKey)
            options //can "encrypt", "decrypt", "wrapKey", or "unwrapKey"
        ).then(onSuccess)//returns key
         .catch(onError); // param error
    }

    //AES-GCM - importKey
    function importKey(onSuccess, onError) {
        crypto.subtle.importKey(
            "jwk", //can be "jwk" or "raw"
            {   //this is an example jwk key, "raw" would be an ArrayBuffer
                kty: "oct",
                k: "Y0zt37HgOx-BY7SQjYVmrqhPkO44Ii2Jcb9yydUDPfE",
                alg: "A256GCM",
                ext: true,
            },
            {   //this is the algorithm options
                name: algName,
            },
            isExtractableKey, //whether the key is extractable (i.e. can be used in exportKey)
            options //can "encrypt", "decrypt", "wrapKey", or "unwrapKey"
        ).then(onSuccess)//returns the symmetric key
            .catch(onError); // param error
    }

    //AES-GCM - exportKey
    function exportKey(key, onSuccess, onError) {
        crypto.subtle.exportKey(
            "jwk", //can be "jwk" or "raw"
            key //extractable must be true
        ).then(onSuccess)//returns the exported key data
         .catch(onError); // param error
    }

    //AES-GCM - encrypt
    function encrypt(key, data, onSuccess, onError) {
        crypto.subtle.encrypt(
            {
                name: algName,

                //Don't re-use initialization vectors!
                //Always generate a new iv every time your encrypt!
                //Recommended to use 12 bytes length
                iv: crypto.getRandomValues(new Uint8Array(12)),

                //Additional authentication data (optional)
                additionalData: ArrayBuffer,

                //Tag length (optional)
                tagLength: shortLength, //can be 32, 64, 96, 104, 112, 120 or 128 (default)
            },
            key, //from generateKey or importKey above
            data //ArrayBuffer of data you want to encrypt
        ).then(function (encrypted) {
            //returns an ArrayBuffer containing the encrypted data
            onSuccess(new Uint8Array(encrypted));
        })//returns an ArrayBuffer containing the encrypted data
            .catch(onError); // param error
    }

    //AES-GCM - decrypt
    function decrypt(key, encrypted, onSuccess, onError) {
        crypto.subtle.decrypt(
            {
                name: algName,
                iv: ArrayBuffer(12), //The initialization vector you used to encrypt
                additionalData: ArrayBuffer, //The addtionalData you used to encrypt (if any)
                tagLength: shortLength, //The tagLength you used to encrypt (if any)
            },
            key, //from generateKey or importKey above
            encrypted //ArrayBuffer of the data
        ).then(function (decrypted) {
            onSuccess(new Uint8Array(decrypted)); //returns an ArrayBuffer containing the decrypted data
        }).catch(onError);
    }

    //AES-GCM - wrapKey
    function wrapKey(wrappingKey, key, onSuccess, onError) {
        crypto.subtle.wrapKey(
            "jwk", //can be "jwk", "raw", "spki", or "pkcs8"
            key, //the key you want to wrap, must be able to export to above format
            wrappingKey, //the AES-GCM key with "wrapKey" usage flag
            {   //these are the wrapping key's algorithm options
                name: algName,

                //Don't re-use initialization vectors!
                //Always generate a new iv every time your encrypt!
                //Recommended to use 12 bytes length
                iv: crypto.getRandomValues(new Uint8Array(12)),

                //Additional authentication data (optional)
                additionalData: ArrayBuffer,

                //Tag length (optional)
                tagLength: shortLength, //can be 32, 64, 96, 104, 112, 120 or 128 (default)
            }
        ).then(function (wrappedKey) {
            onSuccess(new Uint8Array(wrappedKey)); //returns an ArrayBuffer containing the encrypted data
        }).catch(onError);
    }

    //AES-GCM - unwrapKey
    function unwrapKey(wrappingKey, wrappedKey, onSuccess, onError) {
        crypto.subtle.unwrapKey(
            "jwk", //"jwk", "raw", "spki", or "pkcs8" (whatever was used in wrapping)
            wrappedKey, //the key you want to unwrap
            wrappingKey, //the AES-GCM key with "unwrapKey" usage flag
            {   //these are the wrapping key's algorithm options
                name: algName,
                iv: ArrayBuffer(12), //The initialization vector you used to encrypt
                additionalData: ArrayBuffer, //The addtionalData you used to encrypt (if any)
                tagLength: shortLength, //The tagLength you used to encrypt (if any)
            },
            {    //this what you want the wrapped key to become (same as when wrapping)
                name: "AES-CBC",
                length: length
            },
            isExtractableKey, //whether the key is extractable (i.e. can be used in exportKey)
            options //the usages you want the unwrapped key to have
        ).then(onSuccess)//returns a key object
         .catch(onError);
    }
}

    /*

    window.AESGCM = {
        name: "AES-GCM",
        length: 256,
    }
    window.crypto.subtle.generateKey(AESGCM, false, ["encrypt", "decrypt"])
        .then(function(key){
            var iv = window.crypto.getRandomValues(new Uint8Array(12));
