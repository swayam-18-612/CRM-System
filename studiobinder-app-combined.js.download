angular.module('dropdowns.sbRadio.menu.component', [
])

.component('sbRadioDropdownMenu', {
    bindings: {
        withUncheck: '<',

        drpClassAttr: '@?',
        fixedHeight: '@',

        labelField: '<',
        valueField: '<',

        header: '<',
        showColorName: '<',
        onSelect: '&',
        //variables:
        hasCustom: '<',
        list: '<',
        value: '<',
    } ,
    controller: 'SBRadioDrpMenuCtrl',
})
.controller('SBRadioDrpMenuCtrl', SBRadioDrpMenuCtrl);

SBRadioDrpMenuCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];

function SBRadioDrpMenuCtrl(TemplateCompileCompCtrlService, $element) {
    console.log('SBRadioDrpMenuCtrl');
    var $ctrl = this,
    withoutTemplateScope = true;

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;
    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

    function preInit() {
        $ctrl.itemClass = 'select-row';
    }

    function getItemTemplate() {
        var el = "<div class='dropdown-menu selectabledropdown radio-dropdown " + ($ctrl.fixedHeight ? "fixedHeight " : '') + ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '') + "'><div>";

        if ($ctrl.list) {
            el += "<div class='clearfix'>";

            for (var prop in $ctrl.list) {
                el += "<div class='md-radio-group column'>";
                _.each($ctrl.list[prop], function (item) {
                    el += '<div>';

                    var lab = item[$ctrl.labelField].substring(0, $ctrl.truncate);
                    if (item.isHeader) {
                        //class: (prop<$ctrl.columns && !item.withoutPadding?'with-margin-right':'')
                        el += "<div class='header'>" + lab + "</div>";
                    } else {
                        el += "<div class='"+$ctrl.itemClass+" item md-radio-button' data-id='" + item[$ctrl.valueField] + "'>" +
                            getMd() +
                            "<div class='md-label namex'>" + lab + "</div>" +
                            "</div>";
                    }

                    el += '</div>';
                });

                el += "</div>";
            }

            el += "</div>";
        }

        if ($ctrl.hasCustom) {
           el += "<div class='clearfix separatorline spacing-half margin-top-half custom-drp-ul bottom'>" +
                    "<div class='md-radio-group'>" +
                        "<div id='customCheck' class='"+$ctrl.itemClass+" md-radio-button' data-id='custom'>" +
                            getMd(true) +
                            "<div style='padding-left:24px'>" +
                                "<input id='customItemText' class='form-control thin with-underline font-size-12' placeholder='Custom " + ($ctrl.placeholder ? $ctrl.placeholder : '') + "'/>" +
                            "</div>" +
                        "</div>" +
                    "</div>" +
                "</div>";
        }

        el +=  getSaveBtns() +
            '</div></div>';

        return el;

        function getMd(isCustom) {
    return "<div class='md-container md-ink-ripple " + (isCustom ? 'special' : '') + "'>" +
                "<div class='md-off'></div>" +
                "<div class='md-on'></div>" +
                "<div class='md-ripple-container'></div>" +
            "</div>";
        }
    }

    function onLoaded() {
        setSelected();
        bind(true);
    }

    function bind(isBind) {
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelectorAll('.'+$ctrl.itemClass), select);

        if ($ctrl.hasCustom) {
            var el = $ctrl.element.querySelector('#customItemText');
            $ctrl.LCS.bindElementsClick(isBind, el, onCustom, 'cstmbtn', 'focus');
            $ctrl.LCS.bindElementsClick(isBind, el, onCustomKey, 'cstmbtn', 'keyup paste');
          //  if(isBind) {el.focus();}
        }
    }

    function select(e) {
        $ctrl.preventDefault(e);
        console.log('select');
        selectRow(e, e.currentTarget.getAttribute('data-id'));
    }

    function onCustom(e) {
        console.log('onCustom');
        //  console.log('onCustomKeydown: ' + this.value)
        selectRow(e, 'custom');
    }

    function onCustomKey(e) {
        console.log('onCustomKey paste');
        selectRow(e, 'custom', true);
    }

    function selectRow(e, id, isTyping) {
        var isCustom = id === 'custom',
            same = $ctrl.value === id || $ctrl.value && $ctrl.value[$ctrl.valueField] === 'custom' && isCustom;
        if (same&&!isTyping) {
            if ($ctrl.withUncheck) {
                $ctrl.value = null;
            }
        } else {
            if (id === 'custom') {
                var el = $ctrl.element.querySelector('#customItemText');
                $ctrl.value = {id: 'custom', name: el.value ? el.value : null};
                el.focus();
            } else {
                $ctrl.value = id;
            }
        }

        setSelected(isTyping);

        $ctrl.onSelect({result: {value: $ctrl.prevValue, e: e, withClose: !isCustom}});
        if(isCustom){e.stopPropagation();}
    }

    function setSelected(isTyping) {
        var active = 'md-checked';
        var id = isCustomProp() ? 'custom' : $ctrl.value,
            previousId = $ctrl.prevValue && $ctrl.prevValue.id === 'custom' ? 'custom' : $ctrl.prevValue;
        if (id === previousId && !$ctrl.withUncheck) {
            return;
        }
        if (previousId) {
            set(previousId, false);
        }
        if (id) {
            set(id, true);
        }

        if (isCustomProp()) {
            $ctrl.LCS.addClass($ctrl.element.querySelector('#customCheck'), active);

            var el = $ctrl.element.querySelector('#customItemText');
            el.value = $ctrl.value.name;
        }

        $ctrl.prevValue = angular.copy($ctrl.value);

        function set(id, isAdd){
            $ctrl.LCS[isAdd? 'addClass':'removeClass']($ctrl.element.querySelector('.'+$ctrl.itemClass + '[data-id="' + id + '"] '), active);
        }
    }

    function onDestroy() {
        console.log('$onDestroy');
        bind(false);
    }

    function isCustomProp() {
        return $ctrl.value && typeof ($ctrl.value) === 'object' && $ctrl.value[$ctrl.valueField] === 'custom';
    }

    function getSaveBtns() {
        return ($ctrl.withSaveOnTouchScreen ? ('<div class="divBtnSave spacing-half full-width">' +
            '<button id="btnSaveDrp" class="btn primary smallbtn small-btns" type="button" analytics-on analytics-action="Save"> <span class="sbf"></span> Save</button>' +
            //'<span class="orsmall">or</span>' +
            //'<a id="btnCloseDrp" class="cancelsmall">Cancel</a>' +
            '</div>') : '');
    }
}

angular.module('dropdowns.sbRadioDropdown.component', [
    'dropdowns.sbRadio.menu.component',
    'dropdowns.drpnonclosed.controller.service'
])
.component('sbRadioDropdown', sbFieldComponentParams('SBRadioDrpCtrl', {
    initList: '<',
    withUncheck: '@?',
    hasCustom:'@?',
    minWidth:'@?'
}, getSBDropdownTemplate()))
.controller('SBRadioDrpCtrl', SBRadioDrpCtrl);

SBRadioDrpCtrl.$inject = ['SBFieldTypesService', 'SBDrpNonClosedCtrlService', '$element', '$attrs'];
function SBRadioDrpCtrl(SBFieldTypesService, SBDrpNonClosedCtrlService, $element, $attrs) {

    var withoutTemplateScope = true;

    var $ctrl = this;

    $ctrl.menuTag = 'sb-radio-dropdown-menu';
    $ctrl.propType = SBFieldTypesService.PropTypes.Radio;
    $ctrl.generateDrpMenuContent = generateDrpMenuContent;
    $ctrl.initDrp = initDrp;

    $ctrl.setInputField = false;
    $ctrl = new SBDrpNonClosedCtrlService($ctrl, $element, $attrs, withoutTemplateScope);

    function initDrp() {
        if($ctrl.dontClosePopoverOnClick === undefined ){
            $ctrl.dontClosePopoverOnClick = '.custom-drp-ul.bottom';
        }
        $ctrl.valueField = 'id';

        $ctrl.withUncheck = $ctrl.withUncheck === 'true' || $ctrl.withUncheck === true;
        $ctrl.hasCustom = $ctrl.hasCustom === 'true' || $ctrl.hasCustom === true;
    }

    function generateDrpMenuContent() {
        return {
            $ctrl: {
                withUncheck: $ctrl.withUncheck,
                hasCustom: $ctrl.hasCustom,
                labelField: $ctrl.labelField,
                valueField: $ctrl.valueField,
                list: $ctrl.colListItems,
                value: angular.copy($ctrl.value),
                onSelect: $ctrl.onSelect,
            },
            template: ($ctrl.fixedHeight ? ("fixed-height='true' ") : '') +
                "label-field='::$ctrl.labelField' " +
                "value-field='::$ctrl.valueField' " +
                "list='::$ctrl.list' " +
                "value='::$ctrl.value' " +
                "on-select='$ctrl.onSelect(result)' " +
                "has-custom='::$ctrl.hasCustom' " +
                "with-uncheck='::$ctrl.withUncheck'"
        };
    }
}

angular.module('dropdowns.rate.dropdown.component', [
    'dropdowns.drpMenu.controller.service'
])
.controller('SBRateDrpMenuCtrl', SBRateDrpMenuCtrl)
.component('sbRateDropdownMenu', {
    bindings:{
        header: '@',
        drpClassAttr:'@',
        withSaveOnTouchScreen:'@',
        isContactRate: '@',
        hasRemove:'@',
        removeText: '@',
        labelField: '@',
        valueField: '@',
        value: '<', //{t: , v:}
        onSelect: '&'
    },
    controller: 'SBRateDrpMenuCtrl'
});
SBRateDrpMenuCtrl.$inject = ['SBDrpMenuCtrlService', '$element'];
function SBRateDrpMenuCtrl(SBDrpMenuCtrlService, $element) {
    console.log('SBRateDrpMenuCtrl');
    var $ctrl = this,
        stepD = 15, stepN = 1;

    $ctrl.remove = remove;
    $ctrl.checkSetDefault = checkSetDefault;

    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.preInit = preInit;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;

    $ctrl = new SBDrpMenuCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.isContactRate = $ctrl.isContactRate === true || $ctrl.isContactRate === 'true';

        if (!$ctrl.header) {
            $ctrl.header = 'Assign ' + ($ctrl.isContactRate ? 'Contact ' : '') + 'Rate';
        }
        $ctrl.list = $ctrl.SBFieldMethods.PaymentRates;
        $ctrl.tabIndex = 10000;
        $ctrl.rate = 0;
        if ($ctrl.value) {
            if ($ctrl.value.v) {
                $ctrl.rate = $ctrl.value.v;
            }
            if ($ctrl.value.t) {
                $ctrl.selectedId = $ctrl.value.t;
            }
        }
        $ctrl.prevValue = angular.copy($ctrl.value);

        if (!$ctrl.currency) {
            $ctrl.currency = '$';
        }
    }

    function onLoaded() {
        $ctrl.inputRateNEl = $ctrl.element.querySelector('#inputRateN');
        $ctrl.inputRateDEl = $ctrl.element.querySelector('#inputRateD');
        $ctrl.rateDrpInputEl = $ctrl.element.querySelector('#inputDrp');
        $ctrl.drpTypesEl = $ctrl.element.querySelector('#drpTypes');

        $ctrl.colNEl = $ctrl.element.querySelector('.colN');
        $ctrl.colDEl = $ctrl.element.querySelector('.colD');

        updateInputs();
        setSelected(null, $ctrl.selectedId, true);

        bind(true);

        $ctrl.LCS.timeout(function () {
            $ctrl.inputRateNEl.focus();
        }, 100);
    }

    function getDecimals(n){
        var ns = n ? String(n) : '';
       return ns.indexOf('.') === -1 ? 0 :
            parseInt(ns.split('.')[1], 10);
           // Math.ceil(n * 100 % 100 / 100 * 100);
    }

    function getNumber(n){
        return Math.floor(n);
    }

    function pad(value, noPad) {
        //var str = value && angular.isDefined(value) ? value.toString() : '';
        //return str && str.length < 2 && !noPad ? ('0' + str) : str;
        return value === null ? '' : (angular.isDefined(value) && value.toString().length < 2 && !noPad ? ('0' + value) : (value ? value.toString() : '0'));

    }

    function getItemTemplate() {
var s = '<div class="sep inline-block '+($ctrl.CPS.currencySymbolInFront ? 'with-padding-right' : 'with-padding-left')+'">'+$ctrl.CPS.currencySymbol+'</div>';

return '<div class="dropdown-menu selectabledropdown selector-dropdown with-overflow ' + ($ctrl.drpClassAttr ? $ctrl.drpClassAttr : '') +'">' +
            '<div class="margin-top-30 margin-bottom-30">' +
                ($ctrl.header ? ('<div class="header-small clearfix">' + $ctrl.header + '</div>') : '') +
                '<div class="timepicker rate-dropdown">' +
                    '<div class="table-div">' +
                        ($ctrl.CPS.currencySymbolInFront ? s : '') +
                        '<div class="inline-block col90 form-group colN">' +
                            '<input id="inputRateN" class="height40 time-control form-control with-underline inline-block full-width" tabindex="1001" type="number" maxlength="9">' +
                        '</div>' +
    '<div class="sep tall inline-block col20 text-center">'+$ctrl.CPS.currencyDecimalsSeparator+'</div>' +
    '<div class="inline-block with-padding-right col50 form-group colD">' +
        '<input id="inputRateD" class="height40 time-control time-control form-control with-underline inline-block full-width" tabindex="1002" type="text" maxlength="2">' +
    '</div>' +
    '<div class="text-left colDrp inline-block position-relative col120 vbottom">' +
                            '<div class="height40 type wrap-dd-select with-underline">' +
                                '<div class="selected">' +
                                    '<input id="inputDrp" class="dropdown-sel-text with-cursor selected selected-text with-underline full-width" readonly="readonly" tabindex="1003">' +
                                '</div>' +
                            '</div>' +
                            getDrpTypes() +
                        '</div>' +
                        ($ctrl.CPS.currencySymbolInFront ? '' : s) +
                        getBtns() +
                    '</div>' +
                    setDefaultBtns() +
                '</div>' +
            '</div>' +
        '</div>' +
        $ctrl.getSaveBtns() +
    '</div>';
    }

    function setDefaultBtns(){
        return $ctrl.isContactRate ? (
        '<div>' +
            '<div class="custom-checkbox small with-label" id="btnSetDefault" style="padding-right: 5px;margin-top: 14px">' +
                '<label>' +
                    '<input type="checkbox" ' + ($ctrl.setDefault ? 'checked="checked" ' : '') + '>' +
                    '<span>' +
                        '<span class="font-size14 padding-left10 with-padding-right pull-left">Set as default rate</span> ' +
                        '<div class="pull-left">' +
                            '<div class="padding inline-block" tooltip-placement="bottom" tooltip="This will become the default rate for this contact on future projects.">' +
                                $ctrl.LCS.getISBDiv('info-circle', 4, 'gray') +
                           '</div>' +
                        '</div>' +
                    '</span>' +
                '</label>' +
            '</div>' +
        '</div>') : '';
    } 

    function getDrpTypes() {
        var el = "<ul id='drpTypes' class='dropdown-menu customdropdown sb-hide col150' style='left: -48px'>";
        var i = 0;
        _.each($ctrl.list, function (item) {
            var val = item[$ctrl.labelField].substring(0, $ctrl.truncate);
            el += "<li>";
            if (item.isHeader) {
                el += "<div class='header dropdown-item font-size-12 semibold'><span class='with-ellipsis'>" + val + "</span></div>"
            } else {
                el += "<a data-id='" + item[$ctrl.valueField] + "' data-index='" + (i++) + "'>";
                if (item.color || item.image) {
                    el += "<div class='circle-container-10 big'><div class='circle' style='" +
                        (item.color ? ('background-color:' + item.color + ';border-color:' + item.color) : '') +
                        (item.image ? (';background-image:' + $ctrl.LCS.imgPaths + item.image) : '') +
                        "'></div></div>";
                }
                el += "<div><span class='with-ellipsis'>" + val + "</span></div>" +
                    "</a>";
            }

            el += "</li>";
        });

        el += "</ul>";
        return el;
    }

    function getBtns() {
        return $ctrl.hasRemove ? '<a id="btnRemove" class="btn btn-small primary-faded-gray without-text with-margin-left-16 with-margin-top-8" tabindex="1003">'+$ctrl.LCS.getISBDiv('trash')+'</a>' :'';
    }

    function bind(isBind) {
        bindRateInputEvents(isBind);
        bindDrpField(isBind);
        bindDrpTypes(isBind);

        $ctrl.bindEl(isBind, '#btnRemove', $ctrl.remove);
        $ctrl.bindEl(isBind, '#btnSetDefault', $ctrl.checkSetDefault);
        $ctrl.bindSave(isBind);
    }

    function checkSetDefault(e) {
        $ctrl.preventDefault(e);
        if(!$ctrl.isContactRate){return;}
        var el = $ctrl.element.querySelector('#btnSetDefault input');
        if (!$ctrl.setDefault) {
            el.setAttribute('checked', 'checked');
        } else {
            el.removeAttribute('checked');
        }
        $ctrl.setDefault = $ctrl.setDefault ? false : true;
        onChange(false);
    }

    function remove(e) {
        $ctrl.preventDefault(e);
        var el = e.target;
        el.setAttribute('disabled', 'disabled');
        refresh(null, true, {v: null, t: null});
    }

    function bindRateInputEvents(isBind) {
        var evname = 'keyup paste';

        $ctrl.LCS.bindElementsClick(isBind, $ctrl.inputRateNEl, onInputRateNKeydown, null, evname);
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.inputRateNEl, onInputRateNBlur, null, 'blur');

        $ctrl.LCS.bindElementsClick(isBind, $ctrl.inputRateDEl, onInputRateDKeydown, null, evname);
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.inputRateDEl, onInputRateDBlur, null, 'blur');

        $ctrl.LCS.bindElementsClick(isBind, $ctrl.inputRateDEl, onMouseDecimalsInputEl, null, 'mousewheel wheel');
    }

    function bindDrpField(isBind) {
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.rateDrpInputEl, onDrpKeydown, null, 'keyup');
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.rateDrpInputEl, onDrpFocus, null, 'focus');
    }

    function onMouseDecimalsInputEl(e) {
        isScrollingUp(e) ? incrementD() : decrementD();
        $ctrl.preventDefault(e);
    }

    function onInputRateNKeydown(e) {
        if(e.meta){
            e.stopPropagation();
            return;
        }
        switch (e.which) {
            case 37: //left
            case 39://right

                e.stopPropagation();
                break;
            case 9: // tab
                $ctrl.preventDefault(e);
                $ctrl.inputRateNEl.blur();
                    $ctrl.inputRateDEl.select();
                break;

            case 27: //esc
            case 13: //enter
                $ctrl.inputRateNEl.blur();
                onEnter(e);
                break;

            case 38: //up
                $ctrl.preventDefault(e);
                incrementN();
                break;

            case 40: //up
                $ctrl.preventDefault(e);
                decrementN();
                break;

            default:
                e.stopPropagation();
                if(isValid(e)) {
                    $ctrl.LCS.timeout(function () {
                        $ctrl.rateN = $ctrl.inputRateNEl.value === '' ? 0 : parseInt($ctrl.inputRateNEl.value,10);
                        updateN(e);
                    }, 0);
                }
                break;
        }
    }

    function onInputRateDKeydown(e) {
        if(e.meta) {
            e.stopPropagation();
            return;
        }
        switch (e.which) {
            case  37: //left
            case  39://right
                e.stopPropagation();
                break;
            case 9: // tab
                $ctrl.preventDefault(e);
                $ctrl.inputRateDEl.blur();
                    toggleDrp(e, true);
                break;

            case 27: //esc
            case 13: //enter  + tab next index
                $ctrl.inputRateDEl.blur();
                onEnter(e);
                break;

            case 38: //up
                $ctrl.preventDefault(e);
                incrementD();
                break;

            case 40: //up
                $ctrl.preventDefault(e);
                decrementD();
                break;

            default:
                if(isValid(e)) {
                    $ctrl.LCS.timeout(function () {
                        var d = $ctrl.inputRateDEl.value === '' ? '00' : $ctrl.inputRateDEl.value,
                        v = parseInt(d,10);
                        $ctrl.rateD = d.length === 2 && d[0] === '0' ? d : padD(v);
                        updateD(e);
                    }, 0);
                }
                e.stopPropagation();
                break;
        }
    }

    function onEnter(e) {
        $ctrl.preventDefault(e);
        refresh(null, true, null);
    }

    function onDrpFocus(e) {
        toggleDrp(e, true);
    }

    function onDrpKeydown(e) {
        switch (e.which) {
            case 27: //esc
                toggleDrp(e, false);
                break;

            case  9: //tab -> make it save first and go next
            case 13: //enter  + tab next index
                if (!$ctrl.isSOpen) {
                    toggleDrp(e, true);
                } else {
                    onChange(true);
                }
                break;

            case 40: // down
                if (!$ctrl.isSOpen) {
                    toggleDrp(e, true);
                } else {
                    downHighlighted(e);
                }
                break;

            case 38: // up
                if (!$ctrl.isSOpen) {
                    toggleDrp(e, true);
                } else {
                    decrementHighlighted(e);
                }
                break;
        }

        function decrementHighlighted(e) {
            $ctrl.preventDefault(e);
            setSelected(null, $ctrl.selectedId === 1 ? $ctrl.list.length : ($ctrl.selectedId - 1), true);
        }

        function downHighlighted(e) {
            $ctrl.preventDefault(e);
            setSelected(null, ($ctrl.selectedId === $ctrl.list.length) ? 1 : ($ctrl.selectedId + 1), true);
        }
    }

    function bindDrpTypes(isBind) {
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.drpTypesEl.querySelectorAll('a'), select);
    }

    function select(e) {
        setSelected(e, e.currentTarget.getAttribute('data-id'));
        onChange(false);
    }

    function onChange(withClose) {
        refresh(null, withClose, null);
    }

    function incrementD() {inD(stepD);}

    function decrementD() {inD(-stepD);}

    function incrementN() {iN(stepN);}

    function decrementN() {iN(-stepN);}

    function iN(s) {
        $ctrl.rateN = getNFromTemplate() + s;
        setr();
    }

    function inD(s) {
        var max = 100, n = getNFromTemplate(), d = getDFromTemplate(), dif = d + s, vd = 0;
        if(dif < 0){
            vd = max + dif;
            $ctrl.rateN = n - 1;
        }else if(dif >= max){
            vd = dif - max;
            $ctrl.rateN = n + 1;
        }else{
            vd = dif;
        }
        $ctrl.rateD = padD(vd);
        setr();
    }

    function setr() {
        setRate();
        refresh(null, false, null);
        updateInputs();
    }

    function isScrollingUp(e) {
        if (e.originalEvent) {
            e = e.originalEvent;
        }
        //pick correct delta variable depending on event
        var delta = (e.wheelDelta) ? e.wheelDelta : -e.deltaY;
        return (e.detail || delta > 0);
    }

    function isValid(e) {
        // Handle paste
        if (e.type === 'paste') {
            key = e.clipboardData.getData('text/plain');
        } else if(e.keyCode === 8) {//backspace
            return true;
        }else{
            // Handle key press
            var key = e.keyCode || e.which;
            key = 96 <= key <= 105 ? parseInt(e.key, 10) : String.fromCharCode(key);
        }
        var regex = /[0-9]|\./;
        if( !regex.test(key) ) {
            e.returnValue = false;
            if(e.preventDefault) {
                e.preventDefault();
            }
            return false;
        }
        return true;
    }

    function onInputRateNBlur(e) {
        console.log('onInputRateNBlur');
        if (modelIsEmpty()) {
            makeValid();
        } else if ($ctrl.rateN === null || $ctrl.rateN === '') {
            invalidate(true, undefined, undefined);
        } else if (!$ctrl.invalidN && $ctrl.rateN < 10) {
            $ctrl.rateN = pad($ctrl.rateN, true);
            updateN(e);
        }
    }

    function onInputRateDBlur(e) {
        console.log('onInputRateDBlur');
        if (modelIsEmpty()) {
            makeValid();
        } else if ($ctrl.rateD === null || $ctrl.rateD === '') {
            invalidate(undefined, true, undefined);
        }
    }

    function updateN() {
        updateNAndD('n');
    }

    function updateD(e) {
        updateNAndD('d');
    }

    function getNFromTemplate() {
        return parseInt($ctrl.rateN, 10);
    }

    function getDFromTemplate() {
        var d = parseInt($ctrl.rateD, 10);
        return (d >= 0 && d < 100) ? d : undefined;
    }

    function padD(d) {
        if(d===null || d === undefined){return null;}
        var v = d.toString();
        return v.length < 2 ? (d + '0') : v;
    }

    function updateNAndD(keyChange) {
        var n = getNFromTemplate(),
            d = getDFromTemplate();
        if (angular.isDefined(d) && angular.isDefined(n)) {
            setRate();
            refresh(keyChange, false, null);
        } else {
            invalidate(keyChange === 'n' ? true : undefined, keyChange === 'd' ? true : undefined, undefined);
        }
    }

    function setRate() {
        $ctrl.rate = getNFromTemplate() +
            parseFloat(getDFromTemplate() * 0.01).toPrecision(15) * 1.0;
    }

    function setSelected(e, id, withoutToggle) {
        var item;
        if (id !== undefined && id !== null) {
            if (typeof (id) !== 'string') {
                id = id.toString();
            }

            item = _.find($ctrl.list, function (item) {
                return item[$ctrl.valueField].toString() === id;
            });
        }
        if (!item) {
            item = $ctrl.list[0];
        }
        $ctrl.selectedId = item[$ctrl.valueField];

        $ctrl.rateDrpInputEl.value = item[$ctrl.labelField];

        if ($ctrl.prevDrp) {
            $ctrl.LCS.removeClass(getItemById($ctrl.prevDrp), 'active');
        }
        if ($ctrl.selectedId) {
            $ctrl.LCS.addClass(getItemById($ctrl.selectedId), 'active');
        }
        $ctrl.prevDrp = $ctrl.selectedId;

        if(!withoutToggle) {
            toggleDrp(e, false);
        }
    }

    function toggleDrp(e, show) {
        $ctrl.preventDefault(e);
        $ctrl.LCS[show ? 'removeClass' : 'addClass']($ctrl.drpTypesEl, 'sb-hide');
        $ctrl.isSOpen = show;
    }

    function onDestroy() {
        bind(false);
    }

    function setFieldsValidity(invalidN, invalidD) {
        if (angular.isDefined(invalidN) && $ctrl.invalidN !== invalidN) {
            $ctrl.invalidN = invalidN;
            setValidField($ctrl.inputRateNEl, $ctrl.invalidN)
            setValidField($ctrl.colNEl, $ctrl.invalidN, 'has-error');
        }

        if (angular.isDefined(invalidD) && $ctrl.invalidD !== invalidD) {
            $ctrl.invalidD = invalidD;
            setValidField($ctrl.inputRateDEl, $ctrl.invalidD);
            setValidField($ctrl.colDEl, $ctrl.invalidD, 'has-error');
        }
    }

    function invalidate(invalidN, invalidD) {
        // setViewValue(null);
        setFieldsValidity(invalidN, invalidD);
    }

    function setValidField(field, isValid, cls) {
        $ctrl.LCS[isValid ? 'removeClass' : 'addClass'](field, cls ? cls : 'ng-invalid');
    }

    function makeValid() {
        setFieldsValidity(true, true);
    }

    // Call internally when we know that model is valid.
    function refresh(keyboardChange, withClose, predef) {
        setViewValue(predef);
        makeValid();
        updateTemplate(keyboardChange);
        $ctrl.onSelect({result: {value: $ctrl.value, withClose: withClose, setDefault: $ctrl.setDefault}});
    }

    function setViewValue(predef) {
        $ctrl.value = predef ? predef : {
            v: $ctrl.rate,
            t: parseInt($ctrl.selectedId,10)
        };
    }

    function updateInputs() {
        updateTemplate();
        $ctrl.inputRateNEl.value = $ctrl.rateN;
        $ctrl.inputRateDEl.value = $ctrl.rateD;
    }

    function updateTemplate(keyboardChange) {
        $ctrl.rateN = pad(getNumber($ctrl.rate), true);
        if (keyboardChange !== 'd') {
            $ctrl.rateD = padD(getDecimals($ctrl.rate));
        }
    }

    function modelIsEmpty() {
        return ($ctrl.rateD === null || $ctrl.rateD === '') && ($ctrl.rateN === null || $ctrl.rateN === '');
    }

    function getItemById(id) {
        return $ctrl.element.querySelector("li a[data-id='" + id + "']");
    }
}

angular.module('dropdowns.rate.component', [
    'dropdowns.rate.dropdown.component',
    'dropdowns.contactRate.controller.service'
])
.component('sbRateDropdown', sbFieldComponentParams('SbRateCtrl', {
    removeText:'@?',
    hasRemove: '@?',
    minWidth:'@?',
    labelField:'@?',
    valueField:'@?',
},  getSBDropdownTemplate()))
.controller('SbRateCtrl', SbRateCtrl);
SbRateCtrl.$inject = ['SBContactRateCtrlService', '$element', '$attrs'];
function SbRateCtrl(SBContactRateCtrlService, $element, $attrs) {
    console.log('SbRateCtrl');
    var $ctrl = this;
