angular.module('product.preLoading.materials.service', [
    'product.preLoading.resource.service',
    'apiServices.Materials'
])
 .service('MaterialsLoadingService', MaterialsLoadingService);

MaterialsLoadingService.$inject = ['PreloadingResourceService', 'MaterialsService'];
function MaterialsLoadingService(PreloadingResourceService, objectService) {
    var service = new PreloadingResourceService(objectService, {
        name: 'Materials',
        preloadPopulate: 'createdById versionId'
    });

    service.childService = service;

    service.advancedGroupFilters = advancedGroupFilters;

    return service;

    //show all items
    function advancedGroupFilters(groupFilters, type, tableParams){
        if(typeof(groupFilters)==='function'){return groupFilters;}

        var dup = _.clone(groupFilters);
        if(type !== 'getListCount'){
            delete dup.isFolder;
        }
        return dup;
    }
}

addMoSePa('Materials', 'materials', TempMaterialsService, {
    modelMethod: MaterialsFactory,
    serviceInjectList:['MaterialVersions', 'Collaborators'],
    serviceInjectMod:[
        'resources.MaterialVersions',
        'resources.Collaborators'
    ]
});

function MaterialsFactory(ApiResource) {
    var model = ApiResource(SBApiCollections.Materials);

    model.getTypes = getTypes;
    model.getType = function  () {
        return 'folder';
    };
    model.prototype.getType = function () {
        return this.isFolder ? 'folder' : 'file';
    };

    return model;


    function getTypes() {
        return [{value: 1, text: 'Releases', color: '#B9C5D2'},
            {value: 2, text: 'Callsheets', color: '#F4BC0B'},
            {value: 3, text: 'Confirmed', color: '#27CE94'}];
    }
}

function TempMaterialsService(ApiService, model, MaterialVersions, Collaborators) {
    var service = ApiService(model, {
        listType: 'isListRecursive',
        convertOtherResources: convertOtherResources
    });

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;
    service.getDownloadLink = getDownloadLink;
    service.getBreadcrumbs = getBreadcrumbs;
    service.duplicate = duplicate;
    service.search = search;
    service.updateVersionMeta = updateVersionMeta;
    service.updateMovieStillsMeta = updateMovieStillsMeta;
    //service.getAll = getAll;

    return service;

    function convertOtherResources(item) {
        if (item.versionId && typeof (item.versionId) === 'object') {
            item.version = new MaterialVersions(item.versionId);
            item.versionId = item.versionId._id;
        }

        if (item.collaborators && item.collaborators.length > 0) {
            item.collaborators = item.collaborators.map(function (item) {
                if (item && typeof (item.getType) !== 'function') {
                    item = new Collaborators(item);
                }

                return item;
            });
        }
        return item;
    }
    function getChangedFieldForUpdateOther() {
        return ['name','parentId', 'order', 'notes', 'tags', 'parentArchivedId'  ];
    }

    function getDownloadLink(params, onsuccess, onerror) {
        var path = (params.isAnonCallsheet ? '/anon' : '') + service.getPostPath(params) + '/download/' + params.id + '/' + params.versionId;
        return postUrlFull(path, params, function (res) {
            return onsuccess(res ? res.signed_request : null);
        }, onerror);
    }

    function getBreadcrumbs(data, successcb, errorcb) {
        return service.postUrl('/breadcrumbs/' + data.id, data, successcb, errorcb);
    }

    function updateVersionMeta(data, successcb, errorcb) {
        return service.postUrl('/update-version-meta/' + data.versionId, data, successcb, errorcb);
    }

    function updateMovieStillsMeta(data, successcb, errorcb) {
        return service.postUrl('/update-movie-stills-meta/' + data.versionId, data, successcb, errorcb);
    }

    function duplicate(params, successcb, errorcb) {
        return service.postUrl('/duplicate', params, function (res) {
            if (res.addded && res.addded.length > 0) {
                var total = 0;
                res.addded = res.items.map(function (item) {
                    if (item && item.total) {
                        total += item.total;
                    }
                    return item ? service.convertResource(item) : null;
                });
                if (res.item) {
                    res.item.count = total;
                }
            }
            return successcb(res);
        }, errorcb);
    }

    function getAll(query, pageSize, populate, successcb, errorcb) {
        return service.$getAll(query, pageSize, populate, function (result) {
            var docs = result.docs,
                users = result.users;
            if (users) {
                docs = docs.map(function (item) {
                    if (item.collaborators) {
                        item.collaborators = item.collaborators.map(function (el) {
                            var userId = el ? el.userId : null;
                            if (userId) {
                                var user = _.find(users, function (el1) {
                                    return el1._id === userId;
                                });
                                if (user) {
                                    el.user = new service.Users(user);
                                    el.userId = userId;
                                }
                            }

                            return el;
                        });
                    }
                    return item;
                });
            }
            return successcb(docs);
        }, errorcb);
    }


    function postUrlFull(url, data, successcb, errorcb, withoutResourceObject) {
        return service.$post(url, data, successcb, errorcb, withoutResourceObject);
    }

    function search(query, pageSize, page, successcb, errorcb, withoutResourceObject) {
        return service.queryPaged(query, pageSize, page ? page : 0, null, null, null, successcb, errorcb, withoutResourceObject, null, service.getPostPath(query) + '/search');
    }
}

addMoSePa('MaterialVersions', 'materialVersions', TempMaterialVersionsService,{
    serviceInjectList: ['ResourcePathsService', 'MaterialMetadatas', 'Materials'],
    serviceInjectMod: [
        'apiServices.paths.service',
        'resources.MaterialMetadatas',
        'resources.Materials'
    ]
});

function TempMaterialVersionsService(ApiService,model, ResourcePathsService, MaterialMetadatas, Materials) {
    var service = ApiService(model, {
        listType: 'isGroup',
        convertOtherResources: convertOtherResources
    });

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;

    service.makeCurrent = makeCurrent;
    service.getDownloadLink = getDownloadLink;

    return service;

    function getChangedFieldForUpdateOther(){
        return ['name'];
    }

    function makeCurrent(data, successcb, errorcb) {
        var path = ResourcePathsService.getMaterialsPath(data);
        return postUrl(path + '/change-version/'+ data.id+'/'+data.versionId, data, successcb, errorcb);
    }

    function getDownloadLink(params, onsuccess, onerror) {
        var path = (params.isAnonCallsheet ? '/anon' :'') + ResourcePathsService.getMaterialsPath() + '/download/' + params.id + '/' + params.versionId;
        return postUrl(path, params, function(res){
            return onsuccess(res ? res.signed_request : null);
        }, onerror);
    }

    function postUrl(url, data, successcb, errorcb, withoutResourceObject){
        return service.$post(url, data, successcb, errorcb, withoutResourceObject);
    }

    function convertOtherResources(item) {
        if (item.materialMetadataId && typeof(item.materialMetadataId) === 'object') {
            item.materialMetadata = new MaterialMetadatas(item.materialMetadataId);
            item.materialMetadataId = item.materialMetadataId._id;
        }
        if (item.materialId && typeof(item.materialId) === 'object') {
            item.material = new Materials(item.materialId);
            item.materialId = item.materialId._id;
        }

        if (item.contentVersionId && typeof(item.contentVersionId) === 'object') {
            item.contentVersion = new model(item.contentVersionId);
            item.contentVersionId = item.contentVersionId._id;
        }

        item = service.getUserObject(item, 'createdBy');

        return item;
    }
}

