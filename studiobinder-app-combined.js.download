function LowQuotaPopupCtrl (ItemTemplateCompileCtrlService, $element) {
    console.log('LowQuotaPopupCtrl');
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.save = save;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function setTemplateData() {
        $ctrl.icon = 'card';
        $ctrl.iconLevel = 3;
        $ctrl.popupTitle = 'Quota Exceeded!';
        $ctrl.withFooterBtns = true;
        $ctrl.firstBtnCls = 'medium';
        $ctrl.btnText = 'Upgrade';
        $ctrl.textAnalytics = $ctrl.popupTitle;
    }

    function getPopupBodyContent() {
    return '<div class="spacing side-margins">' +
                '<subscription-confirmation></subscription-confirmation>'+
                '<h3 class="bold text-center">Upgrade your plan to keep on sending call sheets</h3>' +
                '<p class="medium-size">To send more call sheets and unlock more functionality, upgrade your account now.</p>' +
            '</div>';
    }

    function save() {
        $ctrl.closePopup();
        $ctrl.SBStateService.openInNewWindow('user.pricing', $ctrl.CPS.currentPathParams());
    }
}


