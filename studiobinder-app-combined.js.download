angular.module('user.taskBoardsPage.service', [
    'apiServices.TaskBoards',
    'apiServices.TodoCards',
    'apiConstants.taskBoards.services',

    'product.taskBoard.single.popup.component',

    'product.taskBoard.component',

    'page.tree.simple.controller.service',
    'page.tree.simple.controller.service.injector',
])

.constant('TaskBoardsPageCtrlServiceInjectors', {
    pageCtrlService: 'PageTreeSimpleCtrlService',
    constantsService: 'TaskBoardsConstantsService',
    listsService: 'TaskBoardsService',
    service: 'TodoCardsService'
})

.service('TaskBoardsPageCtrlService', TaskBoardsPageCtrlService);
TaskBoardsPageCtrlService.$inject = ['PageTreeSimpleCtrlServiceInjector', 'TaskBoardsPageCtrlServiceInjectors'];
function TaskBoardsPageCtrlService(pageCtrlServiceInjector, pageInjectors) {
    return function ($ctrl, $element, printPageParams) {
        console.log('TaskBoardsPageCtrlService');

        $ctrl.treePopoverTemplateOtherInFront = true;
        $ctrl.treePopoverTemplateEditInFront = true;
        $ctrl.taskBoardRemoveMessage = 'This teammate will also be unassigned from all task cards that he was previously assigned to, on this board.';
        $ctrl.currentZoomedTable = '.swimlane-wrapper';

        $ctrl.getParams = getParams;
        $ctrl.getGroupContainer = getGroupContainer;
        $ctrl.isActiveList = isActiveList;
        $ctrl.getIsArchieved = getIsArchieved;
        $ctrl.getRightButtons = getRightButtons;
        $ctrl.onPageTreeInitOther = onPageTreeInitOther;
        $ctrl.onChangeTeam = onChangeTeam;
        $ctrl.onCancelChangeTeam = onCancelChangeTeam;
        $ctrl.getCustomizeHideCond = getCustomizeHideCond;
        $ctrl.isNotEmptyGroupState = isNotEmptyGroupState;
        $ctrl.checkShowAddNewItem = checkShowAddNewItem;
        $ctrl.isWithSidebar = isWithSidebar;
        $ctrl.getPageTreeListPopupExtraParam = getPageTreeListPopupExtraParam;
        $ctrl.canChangeEdit = canChangeEdit;

        $ctrl.onCurrentTreeListChangedOther1 = onCurrentTreeListChangedOther1;
        $ctrl.onGetTreeFilters = onGetTreeFilters;

        $ctrl = new pageCtrlServiceInjector($ctrl, $element, pageInjectors, printPageParams);

        return $ctrl;

        function getPageTreeListPopupExtraParam(){
            return {
                withBgImg : true,
                withBgGradient : true,
                quotaTypeLayout: 'workflowLayout'
            }
        }

        function isWithSidebar(){
            return true;
        }

        function checkShowAddNewItem(){
            return false;
        }

        function isNotEmptyGroupState(){
            return true;
        }

        function onPageTreeInitOther(){
            $ctrl.isOnProduct = false;
            $ctrl.team = $ctrl.SessionService.getSetting('team');//get company team
            $ctrl.SessionService.onUpdateTeam($ctrl.watchers, function (){
                $ctrl.team = $ctrl.SessionService.getSetting('team');//get company team
            });

            setFilters();
        }

        function setFilters(){
            if(!$ctrl.element){return;}
            var teamId = $ctrl.element.getAttribute('team-id');
            if(teamId){
                $ctrl.teamId = teamId;
                $ctrl.getTreeFilters = getTreeFilters;
            }
        }

        function getTreeFilters(item) {
            return item.teamIds && _.find(item.teamIds, function(id){return id === $ctrl.teamId;});
        }

        function getCustomizeHideCond(){
            return true;
        }

        function getRightButtons(cond) {
            if (!$ctrl.showCollabsInListNav || !$ctrl.CPS.isAuthenticated) {
                return '';
            }
    return '<div class="display-block pull-right collaborators-wrap" ng-if="' +
                (cond ? cond : '$ctrl.listTreeService.active.selectedListId') +
            '">' +
                '<sb-assign-team element-id="elementid_teamIds_taskBoard" class="without-underline without-arrow" service="::$ctrl.listsService" on-change="$ctrl.onChangeTeam(result)" on-cancel="$ctrl.onCancelChangeTeam(result)" value="$ctrl.taskBoardTeamIds" c-class-attr="without-underline without-arrow" e-class-attr=" hover-underline" placeholder="Assign Team…" parent-container="true" init-list-name="team" with-count="true" max-count="5" circle-size="smaller" can-change-edit="$ctrl.canChangeEdit()" init-list="::$ctrl.initList ? $ctrl.initList : $ctrl.team" is-assign="true" without-default-focus="true" header-selected="Assigned to Task Board" show-member-type="true" display-default-members="true" team-label="Unassigned Team Members" current-id="' + $ctrl.CPS.teamId + '" ' +
                //if one is not admin can remove self only
                (isMember() ? (' can-remove-current="true"'):'') +
                'remove-message="::$ctrl.taskBoardRemoveMessage" ' +
                'drp-class-attr="drp-taller" ' +
                '></sb-assign-team>' +
            '</div>';
        }

        function canChangeEdit() {
            var l = $ctrl.listTreeService.active ? $ctrl.listTreeService.active.selectedList : null;
            return l && l.active && ($ctrl.CPS.isOwnerOrAdmin || l.createdById === $ctrl.CPS.userId) ? true : false;
        }

        function isMember(){
            return $ctrl.CPS.memberType < $ctrl.security.MemberTypes.Admin;
        }

        function onCancelChangeTeam(result){
            console.log('onCancelChangeTeam');
        }

        function onChangeTeam(result){
            console.log('onChangeTeam');
            var selected = result.selected,
                item = _.clone($ctrl.listTreeService.active.selectedList),
                copyItem = _.clone(item);

            if (selected) {
                var s = selected.field.split('.');
                if (s.length === 1) {
                    item[selected.field] = selected.val;
                } else if (s.length === 2) {
                    if (!item[s[0]]) {
                        item[s[0]] = {};
                    }
                    item[s[0]][s[1]] = selected.val;
                }
            }

            var listsService = $ctrl.listTreeService.listsService,
                listItemUpdates = getDataToUpdate(listsService, ['teamIds']);
            if (listItemUpdates) {
                if (item.companyId) {
                    listItemUpdates.companyId = item.companyId;
                }
                listItemUpdates._id = item._id;
                listsService.update(listItemUpdates, oncustomsave, oncustomerror);
            }

            function oncustomsave(result) {
                console.log('oncustomsave');
                var teamIds = result.item.teamIds
                $ctrl.broadcastRoot('TASKBOARD_TEAM_UPDATED_' + result.item._id, result.item.teamIds);
                $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_TREE', result);

                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.objectType + '.Update.success', 'success');

                if(isMember() &&   !_.find(teamIds, function (id){return id === $ctrl.CPS.teamId;})){
                    //simulate removal
                    $ctrl.listTreeService.onInitRemovedItem({
                        item:  _.extend({}, item, {deleted:true}),
                        removed: [item._id],
                        treeType: item.type,
                        type: $ctrl.objectType
                    });
                }
            }

            function oncustomerror(error){
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.' + $ctrl.objectType + '.Update.error', 'error');
            }

            function getDataToUpdate(service, itemChangedFields) {
                if (item && service) {
                    var data = service.getChanges(itemChangedFields, item, copyItem, $ctrl.compareWithoutKeys);
                    if (data) {
                        data._id = item._id;
                    }
                    if ($ctrl.passMoreData) {
                        data = $ctrl.passMoreData(data);
                    }
                    return data;
                }
                return null;
            }
        }

        function onCurrentTreeListChangedOther1(){
            $ctrl.taskBoardTeamIds = $ctrl.listTreeService && $ctrl.listTreeService.active && $ctrl.listTreeService.active.selectedList ?
                _.clone($ctrl.listTreeService.active.selectedList.teamIds) : null;
        }


        function getIsArchieved(){
            return $ctrl.getIsArchievedInit()|| isActiveList();
        }

        function getParams() {
            var params = {
                companyId: $ctrl.CPS.companyId,
                productId: $ctrl.isOnProduct ? $ctrl.CPS.productId : null
            };
            params[$ctrl.listField] = $ctrl.listTreeService.transitionList ? $ctrl.listTreeService.transitionList._id : null;

            return params;
        }

        function isActiveList(){
            return $ctrl.canEdit && (!$ctrl.withActiveTree ||
                $ctrl.withActiveTree && $ctrl.listTreeService && $ctrl.listTreeService.transitionList && $ctrl.listTreeService.transitionList.active);
        }

        function getGroupContainer(){
            console.log('getGroupContainer');
            return '<task-board class="display-table-cell full-width" ng-if="$ctrl.listTreeService.active.selectedListId" ' +
                'can-edit="$ctrl.isActiveList()" ' +
                'is-on-product="::$ctrl.isOnProduct" ' +
                'tree-type="::$ctrl.treeType" ' +
                'task-board="::$ctrl.listTreeService.active.selectedList" ' + // taskBoard gets updated
                'on-get-tree-filters="$ctrl.onGetTreeFilters(result)"' +
                '></task-board>';
        }

        function onGetTreeFilters(result){
            return typeof($ctrl.getTreeFilters) === 'function' ? $ctrl.getTreeFilters(result) : null;
        }
    }
}

