        {action:'sendMessage', txt:'Send Mail', icon:'mail', isAccent:false, actionTooltip:'Send email to'}
    ];

    $ctrl.getTopFiltersTitle = getTopFiltersTitle;
    $ctrl.getDrpSettingsOther = getDrpSettingsOther;
    $ctrl.checkShowAddNewItem = checkShowAddNewItem;

    $ctrl = new CallsheetRecipientsPageCtrlService($ctrl, $element, constantsService);

    function checkShowAddNewItem() {
        return false;
    }

    function getDrpSettingsOther() {
    return '<li ng-show="$ctrl.isActiveFilter()">' +
                '<a class="' + $ctrl.getActionBtn() + ' fixed-layout table-div" data-type="goToEdit">' +
                    '<div class="col30 with-margin-right">'+$ctrl.LCS.getISBDiv('design')+'</div>' +
                    '<div><div class="with-ellipsis">Edit Call Sheet</div></div>' +
                '</a>' +
            '</li>';
    }

    function getTopFiltersTitle() {
return '<div class="btnTopFilters position-relative dropdown dropdown-wrapper pull-left" dropdown auto-close="outsideClick">' +
            '<button id="btnFilters" type="button" class="btn btn-small without-text transparent noborder dropdown-toggle semibold with-bg" dropdown-toggle>' +
                '<span class="txt pull-left">Confirmations</span> <span class="sbf down-arrow pull-right"></span>' +
            '</button>' +
            '<div class="dropdown-menu side-menu fadeInDownLeft drpProjectsFilter" dropdown-menu role="menu" aria-labelledby="btnTopFilters">' +
                '<ul class="listitems-selector with-checked">' +
                    '<li><a class="' + $ctrl.getBtnActionCls() + '" data-type="goToView">' + get('View Call Sheet') + '</a></li>' +
                    '<li><a class="' + $ctrl.getBtnActionCls() + ' active" data-type="goToStats">' + get('Confirmations') + '</a></li>' +
                '</ul>' +
            '</div>' +
        '</div>';

        function get(t){
            return '<div class="with-padding-right with-ellipsis">'+t+'</div>' +
                '<div class="checkmark centered">'+$ctrl.LCS.getISBDiv('check-mark', null, 'primary')+ '</div>';
        }
    }
}


