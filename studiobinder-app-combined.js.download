        canHide: true,
        showMobile: false,
        isMobileSubtitle: true
    };

    var Settings = {
        Columns: Columns
    },

        ListParams = {
            includeFields: ['createdAt', 'status', 'title', 'productId', 'companyId', 'startDate', 'generalNote', 'callsheetSentId', 'castCount', 'callsheetsListId', 'order'],
            searchFields: ['title'],
            orderFields: ['order', 'createdBy.name', 'createdAt', 'startDate'],
            populate: 'createdById callsheetSentId',
            defaultOrder: 'startDate',
            defaultOrderDir: -1
        },

        Options = {
            columns: ['1', '2', '3', '3.1','5', '6'],
            view: 2
        },

        GroupSettings = {
            colType: 'myCallsheets',
            gridItemClass: 'short-item-grid ',
            groupItemTag: 'mycallsheet',
            hideGridHeader: true
        },

        CompOptions = angular.copy(compOptions);

    return {
        GroupSettings: GroupSettings,
        PropTypes: PropTypes,
        Settings: Settings,
        Options: Options,
        ViewProp: 'myCallsheetsView',
        ListParams: ListParams,

        CompOptions: CompOptions
    };
}

