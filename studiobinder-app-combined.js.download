ScheduleEditPopupCtrl.$inject = ['ScheduleEditPopupCtrlService', 'SBFieldTypesService', '$element'];
function ScheduleEditPopupCtrl(ScheduleEditPopupCtrlService, SBFieldTypesService, $element) {
    var $ctrl = this;
    var PropTypes = SBFieldTypesService.PropTypes;

    $ctrl.onInitOther = onInitOther;
    $ctrl.getContent = getContent;

    $ctrl = new ScheduleEditPopupCtrlService($ctrl, $element);

    function onInitOther() {
        $ctrl.objectType = 'schedule';

        $ctrl.cleanParamType = $ctrl.item.type;
        $ctrl.modalBodyFormClass = 'med2 ' + ($ctrl.canEdit && $ctrl.LCS.isMobileSize? 'mobile-editable-form' : '');
        if($ctrl.item.isDuplicate) {
            $ctrl.isDuplicate = true;
            delete $ctrl.item.isDuplicate;
        }
        //dont populate day break automatically
     /*   if($ctrl.item.type === $ctrl.SceneTypes.DayBreak && !$ctrl.item.time){
            $ctrl.item.time = $ctrl.CPS.startTime;
        }*/
    }

    function getContent() {
        var withLabel = true,
            isMobile = $ctrl.LCS.isMobileSize;
        switch ($ctrl.item.type) {
            case $ctrl.SceneTypes.Scene:
                return $ctrl.getScene(withLabel, isMobile);
            case $ctrl.SceneTypes.Banner:
                return getBanner();
            case $ctrl.SceneTypes.DayBreak:
                return getDayBreak();
        }

        function getDayBreak() {
            return getRow(['date', 'time'], 'col50p pull-left', null, 'margin-top-half') +
              '<div class="table-div full-width ">' +
                $ctrl.getContentEditable('note', true, {
                    type: PropTypes.Field,
                    name: 'Description',
                    placeholder: 'Short description (optional)…'
                }) +
                '</div>';
        }

        function getBanner() {
            return getFirstRow() +

                getRow(['note'], 'full-width', {
                    name: 'Description',
                    placeholder: 'Short description (optional)…'
                }) +
                getRow(['prepTime', 'shootTime', 'estTime'], 'col33p pull-left');
        }

        function getFirstRow(){
            var isAll = true;
        return '<div class="form-group table-div full-width margin-bottom">' +
                    $ctrl.getContentEditable('color', isAll, {
                        default: $ctrl.LCS.bannerColor
                    }) +
                    $ctrl.getContentEditable('name', isAll, {
                        withoutLabelInPopup: true,
                        type: PropTypes.Field,
                        isRequired: true,
                        placeholder: 'Add banner (e.g. Company Move, Meal Break'
                    }) +
                '</div>';
        }

        function getRow(l, width, other, cls) {
            return $ctrl.getRowCols(l, width, withLabel, isMobile, other, cls);
        }
    }
}


angular.module('product.scheduling.item.edit.controller.service', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'product.script.saveContentToScriptAndSync.controller.service'
])
.service('ScheduleEditPopupCtrlService', ScheduleEditPopupCtrlService);
ScheduleEditPopupCtrlService.$inject = ['GeneralItemEditCtrlService', 'SaveContentToScriptAndSyncCtrlService'];
function ScheduleEditPopupCtrlService(GeneralItemEditCtrlService, SaveContentToScriptAndSyncCtrlService) {

    return function ($ctrl, $element) {
        $ctrl.isPopup = true;

        console.log('ScheduleEditPopupCtrlService');
        var sceneprops = ['scene', 'sceneType', 'dayTime', 'stripLocationId'];
        $ctrl.otherExtraParamProps = ['canEdit', 'currentListId', 'isScheduling', 'scriptLoadingService', 'index', 'sceneNo', 'listTreeService', 'service'];

        $ctrl.pagesProp = 'pagesDisplay';
        $ctrl.SceneTypes = {Scene: 1, DayBreak: 0, Banner: 2};

        $ctrl.withUncheck = true;
        $ctrl.withLabel = true;

        $ctrl.getScene = getScene;

        $ctrl.onChangeOther = onChangeOther;

        $ctrl.preInitGeneral = preInitGeneral;
        $ctrl.postInitGeneral = postInitGeneral;

        $ctrl.onLoaded = onLoaded;
        $ctrl.preSetTemplateData = preSetTemplateData;
        $ctrl.getPopupBodyContent = getPopupBodyContent;

        $ctrl.isValidFormOther = isValidFormOther;
        $ctrl.onChangeStripLocation = onChangeStripLocation;
        $ctrl.passMoreData = passMoreData;

        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

        $ctrl.onConfirm = onConfirm;
        $ctrl.confirmPopupEdit = confirmPopupEdit;

        return $ctrl;

        function postInitGeneral(){
            if($ctrl.withPageReload) {
                $ctrl.onSave = $ctrl.onSave1;
            }
        }

        function preInitGeneral() {
             $ctrl.withPageReload = $ctrl.item.type === 1;
             if($ctrl.withPageReload){
                $ctrl = new SaveContentToScriptAndSyncCtrlService($ctrl, $ctrl.CurrentProduct.getProduct().script);
             }
            preloadSettings();

            $ctrl.stripId = $ctrl.isScheduling && $ctrl.item.type === $ctrl.SceneTypes.Scene ? $ctrl.item.stripId : $ctrl.item._id;

            $ctrl.itemChangedFields = $ctrl.extraParam.changedFields;

            var index = _.findIndex($ctrl.columnsList, {prop: 'stripLocationId'});
            $ctrl.columnsList[index].onChange = "$ctrl.onChangeStripLocation(result)";
            $ctrl.columnsList[index].withoutStripId = true;

            if ($ctrl.isScheduling && $ctrl.item.type === $ctrl.SceneTypes.Banner) {
                $ctrl.setColorSettings();
                $ctrl.columnsList.push($ctrl.getColumnColor());
            }

            if ($ctrl.onInitOther) {
                $ctrl.onInitOther();
            }

            if (!$ctrl.service) {
                console.warn('Parent for ScheduleEditPopupCtrlService must define $ctrl.service');
            }

            if (!$ctrl.objectType) {
                console.warn('Parent for ScheduleEditPopupCtrlService must define $ctrl.objectType');
            }
        }

        function preloadSettings() {
            $ctrl.Settings = _.extend({}, $ctrl.Settings, $ctrl.scriptLoadingService.preloadSettings());
        }

        function onChangeOther(result) {
            if (result && result.newRes) {
                var field = result && result.selected && result.selected.field ? result.selected.field : null;
                if (field === 'locationIds' || field === 'stripLocationId' || field === 'characterIds') {
                    console.log('onChangeOther');
                    preloadSettings();
                    broadcastRoot(result);
                }
            }
        }

        function onLoaded() {
            if ($ctrl.item.type !== 0) {
                $ctrl.setFocus($ctrl.extraParam.focus ? $ctrl.extraParam.focus : 1);
            }

            $ctrl.getItemById = getItemById;
        }

        function getItemById() {
            return $ctrl.item;
        }

        function broadcastRoot(result, isNew) {
            $ctrl.broadcastRoot((isNew ? 'ADDED' : 'UPDATED') + '_' + $ctrl.elemType + "_ITEM", result);
        }

        function onConfirm() {
            $ctrl.isUpdating = false;
            $ctrl.save();
        }

        function preSetTemplateData() {

            $ctrl.firstBtnMethod = 'confirmPopupEdit';

            if (typeof ($ctrl.preSetTemplateDataOther) === 'function') {
                $ctrl.preSetTemplateDataOther();
            }

            var itemTitle = 'Details',
                isDay = $ctrl.item.type === $ctrl.SceneTypes.DayBreak;
            $ctrl.itemTitle = $ctrl.item.type === $ctrl.SceneTypes.Scene ? itemTitle :
                (isDay ? 'Day Break' : 'Banner');

            $ctrl.icon = $ctrl.item.type === $ctrl.SceneTypes.Scene ? 'pencil' :
                (isDay ? 'daybreak' : 'banner');
            if (isDay) {
                $ctrl.iconLevel = 3;
            }
            // $ctrl.icon = ($ctrl.item.type===$ctrl.SceneTypes.Scene?'scene':($ctrl.item.type === $ctrl.SceneTypes.DayBreak?'daybreak':'banner'));
            $ctrl.popupTitle = ((!$ctrl.item._id ? 'Add New' : 'Edit') + ' ' + $ctrl.itemTitle);
            $ctrl.subtitle = $ctrl.item.miniTitle;
            $ctrl.modalBodyFormClass = 'med2 ' + ($ctrl.canEdit && $ctrl.LCS.isMobileSize ? 'mobile-editable-form' : '');
            $ctrl.firstBtnCls = 'max-width200';
            $ctrl.withCloseBtn = true;
        }

        function isValidFormOther() {
            console.log('isValidFormOther');
            if (!$ctrl.isNew) {
                $ctrl.listItemUpdates = $ctrl.getDataToUpdate();
                if (!$ctrl.listItemUpdates) {
                    return true;
                }
                var sceneChanged = Object.keys($ctrl.listItemUpdates).indexOf('scene') !== -1;
                if (sceneChanged) {
                    var scene = $ctrl.listItemUpdates.scene;
                    if (scene) {
                        scene = getS(scene);
                        var strip = _.find($ctrl.scriptLoadingService.getStrips(), function (el) {
                            return el._id !== $ctrl.item._id && getS(el.scene)===scene;
                        });
                        if (strip) {
                            $ctrl.error = 'Scene # ' + scene + ' is already used in another scene';
                            return false;
                        }
                    }
                }
            }
            return true;

            function getS(scene){
                return scene ? (typeof(scene) !== 'string' ? scene.toString() : scene).toUpperCase() : undefined;
            }
        }

        function getPopupBodyContent() {
            return $ctrl.getContent();
        }

        function getScene(withLabel, isMobile) {
            return getRow(['scene', 'sceneType', 'dayTime'], 'col33p pull-left') +
                getRow(['stripLocationId'], 'full-width') +
                getRow(['note'], 'full-width') +
                getRow(['characterIds', 'locationIds'], 'col50p pull-left') +
                getRow([$ctrl.pagesProp, 'storyDay'], 'col50p pull-left') +
                getRow(['prepTime', 'shootTime', 'estTime'], 'col33p pull-left');

            function getRow(l, cls) {
                return $ctrl.getRowCols(l, cls, withLabel, isMobile);
            }
        }

        function onChangeStripLocation(result) {
            if (result) {
                var changed;
                if (result.selected && result.selected.field === 'stripLocationId' && $ctrl.item.stripLocationId !== result.selected.val) {
                    $ctrl.item.stripLocationId = result.selected.val;
                    changed = true;
                } else if (result.value && $ctrl.item.stripLocationId !== result.value) {
                    $ctrl.item.stripLocationId = result.value;
                    changed = true;
                }

                if (changed) {
                    $ctrl.Settings = _.extend({}, $ctrl.Settings, $ctrl.scriptLoadingService.preloadSettings());
                    $ctrl.item.stripLocation = _.find($ctrl.Settings.stripLocations, {_id: $ctrl.item.stripLocationId});
                    if ($ctrl.item.stripLocation) {
                        console.log('onChangeStripLocation. changed: ' + $ctrl.item.stripLocation.name);
                    }
                }
            }
        }

        function passMoreData(data) {
            console.log('passMoreData');

            if (!$ctrl.hasScenePropChanges) {
                return data;
            }

            var likeOnScript = false;
            $ctrl.item = $ctrl.itemWithUpdatedSceneContent($ctrl.item, $ctrl.item.isOmitted, likeOnScript);
            $ctrl.item.miniTitle = $ctrl.SBFieldMethods.getMiniTitle($ctrl.item);
            $ctrl.item.sceneText = $ctrl.SBFieldMethods.getSceneText($ctrl.item);

            var title = 'Scene ' + $ctrl.item.sceneText + '  •  ' + $ctrl.item.miniTitle;
            $ctrl.scriptNote = title + ' has been ' + ($ctrl.isNew ? 'added ' : 'edited ');

            $ctrl.updateSceneContent = true;
            if ($ctrl.updateSceneContent && $ctrl.otherData.content) {
                _.each(['stripLocation', 'miniTitle', 'name'].concat(sceneprops), function (prop) {
                    delete data[prop];
                    delete $ctrl.otherData[prop];
                });
            }

            return _.extend(data,
                $ctrl.otherData,
                getUpdatedSceneContent(),
                $ctrl.CPS.scriptId ? {scriptId: $ctrl.CPS.scriptId} : null);

            function getUpdatedSceneContent() {
                console.log('getUpdatedSceneContent');
                var page = $ctrl.BlocksSetupService.getCurrentTodoPage().text;
                $ctrl.isNewStrip = false;

                return $ctrl.updateSceneContent ? $ctrl.getOtherData({
                    notes: getNotes(),
                    summary: ($ctrl.isNew ? 'add' : 'edit') + 'details|' + page
                }) : null;

                function getNotes() {
                    var miniTitle = '<span class="semibold">Sc. ' + ($ctrl.item.sceneText ? ($ctrl.item.sceneText + '. ') : '') +
                        ($ctrl.item.name ? $ctrl.item.name : '') + '</span>';
                    return 'Scene details were ' + ($ctrl.isNew ? 'added' : 'modified') + ' on <span class="semibold">' + page + '</span> page: ' + miniTitle;
                }
            }
        }

        function confirmPopupEdit(e) {
            $ctrl.preventDefault(e);

            $ctrl.otherData = $ctrl.service.getChanges([$ctrl.pagesProp].concat($ctrl.service.getChangedFieldForUpdate()), $ctrl.item, $ctrl.copyItem);


            if ($ctrl.isNew && !$ctrl.otherData) {
                $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.gridItem.success.nochanges');
                return;
            }

            $ctrl.hasScenePropChanges = false;

            if($ctrl.otherData) {
                var pages = $ctrl.otherData[$ctrl.pagesProp];
                if (pages !== undefined) {
                    $ctrl.item.pagesCustom = pages === $ctrl.item.pages ? null : pages;
                }
            }

            if ($ctrl.service.getChanges(sceneprops, $ctrl.item, $ctrl.copyItem)) {
                $ctrl.hasScenePropChanges = true;
                $ctrl.confirmPopup(e);
            } else {
                $ctrl.onConfirm();
            }
        }
    }
}

angular.module('product.scheduling.item.remove.component', [
    'product.breakdowns.item.process.controller.service'
])
    //not used
.component('removeSchedulingPopup', popupComponentParams('RemoveSchedulingPopupCtrl'))
.controller('RemoveSchedulingPopupCtrl', RemoveSchedulingPopupCtrl);
RemoveSchedulingPopupCtrl.$inject = ['ProcessBreakdownsPopupCtrlService', '$element'];
function RemoveSchedulingPopupCtrl(ProcessBreakdownsPopupCtrlService, $element) {
    var $ctrl = this;

    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.preSetTemplateDataOther = preSetTemplateDataOther;
    $ctrl.removeO = removeO;
    $ctrl = new ProcessBreakdownsPopupCtrlService($ctrl, $element);

    function preSetTemplateDataOther() {
        $ctrl.icon = 'trash';
        $ctrl.popupTitle = 'Permanently Remove All Strips…';
        $ctrl.popupSubtitle = 'Please note this can not be undone';
        $ctrl.firstBtnMethod = 'removeAll';
        $ctrl.btnText = '<span>Remove</span><span class="hide-ipad"> Strips</span>';
    }

    function getPopupBodyContent() {
    return '<div class="form-wrapper">' +
                ($ctrl.item.type === 1 ? ('<p>The associated shot list and shots will also be removed</p>') : '') +
                '<div class="centering col170">' + $ctrl.removeOptions.map(getItem).join('') +'</div>' +
            '</div>';

    function getItem(p){
        return'<div class="custom-checkbox small with-label padding-right-5 margin-top-15">' +
            '<label>' +
'<input type="checkbox" data-type="removeO" data-info="'+p.id+'" '+(isChecked(p.id) ? 'checked="checked "' : '') +($ctrl.removeOption[4] && p.id<4 ? 'disabled="disabled"' : '') + '>' +
            '<span>' +
            '<span class="padding-left10 font-size-14">' + p.text + '</span> ' +
            (p.tooltip ? ('<div class="wpadding inline-block" tooltip-placement="top" tooltip="'+p.tooltip+'">' + $ctrl.LCS.getISBDiv('info-circle', 4, 'gray') + '</div>') : '') +
            '</span>' +
            '</label>' +
            '</div>';
    }
    }

    function removeO(id, e){
        $ctrl.removeOption[id] = $ctrl.removeOption[id] ? false : true;
    }
    function isChecked(id){
       return $ctrl.removeOption[id] || $ctrl.removeOption[4];
    }
}

