function DepartmentConstantsService(SBFieldTypesService, compOptions) {
    var popoup = getBasePopupTemplateByTag('position-edit'),
        PropTypes = SBFieldTypesService.PropTypes,

        Options = {
            columns: ['1', '2'],
            view: 2
        },

        Settings = {
            Columns: angular.copy(SBApiGridColumns['departments'](PropTypes))
        },

        Filters = [],

        CompOptions = angular.copy(compOptions),

        ListTreeServiceParams = {

            maxLevel: 1,
            hideLevel0: true,
            withHarcodedAll: true,
            dontStartTreeWithAll: true,

            level0Name: 'All Positions',
            // cachedListName: 'departmentsList',
            preLoadingTableName: 'Departments',

            withLabelAfter: 'Departments',

        },

        ListParams = {
            includeFields: ['name', 'shortName', 'order', 'depId'],
            searchFields: ['name'],
            orderFields: ['order', 'name'],
            populate: ''
        },

        KeyboardServiceParams = {
            canCopy: false,
            canMove: ListTreeServiceParams.moveInGroup,
        },

        PopupOperations = {
            createPosition: {
                type: 'Create',
                template: popoup,
                size: 'sm',
                transp: ' '
            },

            updatePosition: {
                type: 'Edit',
                template: popoup,
                size: 'sm',
                transp: ' '
            },

            duplicatePosition: {
                type: 'Duplicate',
                template: popoup,
                size: 'sm',
            },
        },

        Hotkeys = null,

        SidebarOptions = {
            removeAdditionalMessage: ' and all the positions within it',
        };

    return {
        Settings: Settings,
        Options: Options,
        Filters: {Filters: Filters},
        ViewProp: 'departmentView',

        CompOptions: CompOptions,
        ListTreeServiceParams: ListTreeServiceParams,
        ListParams: ListParams,
        KeyboardServiceParams: KeyboardServiceParams,

        PopupOperations: PopupOperations,
        Hotkeys: Hotkeys,
        SidebarOptions: SidebarOptions,
    };
}

