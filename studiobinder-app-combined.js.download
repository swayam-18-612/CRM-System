angular.module('ctrl.PopupsCtrl.tree.list.popup.component.service', [
    'apiServices.Settings',
    'apiServices.Companies',
    'imgupload.init.service',
    'sbaveragecolor.service',
    'item.edit.controller.service',
    'ctrl.PopupsCtrl.select.color.popup.component'
])
.service('TreeListEditCtrlService', TreeListEditCtrlService);
TreeListEditCtrlService.$inject = ['GeneralItemEditCtrlService', 'CompaniesService', 'SettingsService', 'ImgUploadInitService', 'SBAverageColorService', 'SBColorService'];
function TreeListEditCtrlService(GeneralItemEditCtrlService, CompaniesService, SettingsService, ImgUploadInitService, SBAverageColorService, SBColorService) {
    return function ($ctrl, $element, isPopup) {

        $ctrl.SBColorService = SBColorService;
        $ctrl.SBAverageColorService = SBAverageColorService;
        $ctrl.ImgUploadInitService = ImgUploadInitService;
        $ctrl.SettingsService = SettingsService;
        $ctrl.CompaniesService = CompaniesService;

        $ctrl.isPopup = isPopup;
        $ctrl.isTreeListEditCtrlService = true;

        $ctrl.delayBroadcast = true;
        $ctrl.hiddenCls = 'opacity0';

        var has2Steps = false;

        $ctrl.onSaveAfter = onSaveAfter;
        $ctrl.preInitGeneral = preInitGeneral;
        $ctrl.preSetTemplateData = preSetTemplateData;
        $ctrl.getItemPopupTemplate = getItemPopupTemplate;

        $ctrl.onSaveGeneral = onSaveGeneral;

        $ctrl.setWithImage = setWithImage;
        $ctrl.msFormOnNext = msFormOnNext;
        $ctrl.selectImage = selectImage;
        $ctrl.selectColor = selectColor;
        $ctrl.setCustomColor = setCustomColor;
        $ctrl.preview = preview;
        $ctrl.onDestroy = onDestroy;
        $ctrl.onLoaded = onLoaded;
        $ctrl.getDataToUpdate = getDataToUpdate;
        // $ctrl.dontAutoloadTemplate = true;
        $ctrl.removeCompanyColor = removeCompanyColor;

        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

        return $ctrl;

        function removeCompanyColor(c, e) {
            console.log('removeCompanyColor');
            var el = e.currentTarget;
            saveCompanySetting(c, true, function () {
                $ctrl.LCS.removeElement($ctrl.LCS.findClosestParent(el, '.thumb-sm'));
            });
        }

        function preInitGeneral() {
            if (!$ctrl.isLoaded) {
                $ctrl.CompaniesService.getById($ctrl.security.getCurrentCompanyId(), 'settingsId', onCompanyLoaded);
            }

            function onCompanyLoaded(company) {
                console.log('onCompanyLoaded');
                $ctrl.company = company ? company : $ctrl.security.getCurrentCompany();
                getCompanyColors();
                $ctrl.isLoaded = true;
                preinint();
                $ctrl.reloadTemplate();
            }

            function preinint() {

                // $ctrl.type = 'Edit';


                $ctrl = _.extend($ctrl, $ctrl.extraParam);

                //check if is current
                if (!$ctrl.bgFolder) {
                    $ctrl.bgFolder = 'taskboard-backgrounds';
                }
                if (!$ctrl.codeName) {
                    $ctrl.codeName = 'backgrounds';
                }
                //$ctrl.quotaTypeLayout = $ctrl.quotaTypeLayout ? $ctrl.quotaTypeLayout : 'taskboard-backgrounds';

                //load based on name

                if (!$ctrl.service) {
                    console.warn('Parent for TreeListEditCtrlService must define $ctrl.service');
                }

                loadPredefColors();

                var state = $ctrl.SBStateService.currentState.name;
                $ctrl.hasSideBarInit = $ctrl.LCS.hasInnerSidebar(state);

                var show = !$ctrl.item._id || $ctrl.currentList && $ctrl.currentList._id === $ctrl.item._id;
                if ($ctrl.item.step === 'step2') {
                    $ctrl.step = 'isedit2';
                }

                $ctrl.item = setImgProps($ctrl.item);

                //$ctrl.icon = 'workflow';
                // $ctrl.nameForList = 'Board';

                $ctrl.setDefaultColumns(false, $ctrl.customDescForList);

                //needs more work
                var prop = 'backgroundImg';

                $ctrl.columnsList.push({
                    name: 'Avatar',
                    prop: prop,
                    imgProp: prop,
                    collectionProp: $ctrl.service.collectionName,
                    type: $ctrl.SBFieldTypesService.PropTypes.Picture,
                    order: 1,
                    canEdit: true,
                    showMobile: true,
                    icon: 'img-storyboard',
                    iconLevel: 3,
                    withoutInitials: true,
                    withoutBgColor: true,
                    loadLater: false,
                    imgSize: 'test',
                    defaultText: '',
                    showLabel: true,
                    canUploadAttr: true,
                    areaType: 'square',
                    codeName: $ctrl.codeName
                    //cantEditInPopup: true
                });
            }
        }

        function getCompanyColors() {
            if (!$ctrl.companySettings) {
                $ctrl.companySettings = $ctrl.company ? $ctrl.company.settings : $ctrl.CurrentLocaleSettings.getCompanySettings();
            }
            $ctrl.companyColors = $ctrl.companySettings ? $ctrl.companySettings.colors : null;

            if ($ctrl.companyColors) {
                $ctrl.companyColorsObj = _.filter($ctrl.companyColors.map(getObjFromcolor), function (item) {
                    return item;
                });
            }
        }

        function preSetTemplateData() {
            $ctrl.modalBodyFormClass = 'longest';
            $ctrl.withCloseBtn = true;
        }

        function onLoaded() {
            if (!$ctrl.isLoaded) {
                return;
            }
            if ($ctrl.canEdit && $ctrl.withBgImg) {
                $ctrl.onImageUpdate = onImageUpdate;
                $ctrl = new $ctrl.ImgUploadInitService($ctrl, false);
            }

            if ($ctrl.item.backgroundImgId) {
                setUploadedImageActive(true);
            }

            bindOverlay(true);

            $ctrl.setFocus();
        }

        function bindOverlay(isBind) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('.image-container.overlay'), selectUploadedImg);
        }

        function getDataToUpdate() {
            var data = $ctrl.getDataToUpdateInit(),
                hasQuota = $ctrl.CPS.hasQuotaType($ctrl.quotaTypeLayout);
            //check if is not image
            if (hasQuota || !data ||
                !hasQuota && data && (!data.background || !$ctrl.SBColorService.isImage(data.background))
            ) {
                return data;
            }

            $ctrl.CPS.loadQuotaPopup($ctrl.quotaTypeLayout, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}));

            return null;

            function process() {

            }
        }

        function selectUploadedImg(e) {
            if (!$ctrl.LCS.findClosestParent(e.target, '[type="button"]')) {
                $ctrl.preventDefault(e);
                setUploadedImageActive(true);
            }
        }

        function onSaveGeneral(result) {
            if ($ctrl.step === 'isnew1') {
                if (result) {
                    result.withoutClose = true;
                }
                $ctrl.step = 'isnew2';
                return true;
            }
        }

        function msFormOnNext(e) {
            if ($ctrl.msFormOnNextInit(e)) {
                return addBoard();
            }

            function addBoard() {
                if (has2Steps) {
                    $ctrl.step = 'isnew1';
                    return $ctrl.save();
                }
            }
        }

        function onSaveAfter(result) {
            console.log('onSaveAfter');
            $ctrl.item._id = result.item._id;

            $ctrl.copyItem = _.clone($ctrl.item);
            $ctrl.type = 'Edit';
            //$ctrl.SBStateService.reloadPage();

            saveCompanySetting($ctrl.item.background);

            if ($ctrl.extraParam && typeof ($ctrl.extraParam.onSuccess) === 'function') {
                $ctrl.extraParam.onSuccess(result);
            }
        }

        function saveCompanySetting(v, isRemove, next) {
            if (!v || isPredefColor(v) || $ctrl.SBColorService.isGradient(v) || $ctrl.SBColorService.isImage(v)) {
                return;
            }

            getCompanyColors();
            var m = isRemove ? removeCompanyColor : addCompanyColor;
            if (!m(v)) {
                return;
            }

            // add color in grid
            var settingsId = $ctrl.companySettings ? $ctrl.companySettings._id : null;
            $ctrl.SettingsService[settingsId ? 'update' : 'insert'](_.extend({
                companyId: $ctrl.CPS.companyId,
                productId: null,
                colors: $ctrl.companyColors
            }, settingsId ? {_id: settingsId} : null), oncustomsave, $ctrl.onCustomError);

            function oncustomsave(result) {
                var item = result ? result.item : null
                $ctrl.CurrentLocaleSettings.initCompanySettings(item);
                $ctrl.CPS.loadCurrentLocale();
                if (next) {
                    next(result);
                }
            }

            function addCompanyColor(v) {
                if (!$ctrl.companyColors) {
                    $ctrl.companyColors = [];
                    $ctrl.companyColorsMapped = [];
                    $ctrl.companyColorsObj = [];
                }
                if ($ctrl.companyColors.indexOf(v) !== -1) {
                    return false;
                }
                $ctrl.companyColors.push(v);
                $ctrl.companyColorsObj.push(getObjFromcolor(v));
                return true;
            }

            function removeCompanyColor(v) {
                var index = $ctrl.companyColors.indexOf(v);
                if (index === -1) {
                    return false;
                }
                if ($ctrl.companyColors) {
                    $ctrl.companyColors.splice(index, 1);
                }
                if ($ctrl.companyColorsObj) {
                    $ctrl.companyColorsObj.splice(index, 1);
                }
                return true;
            }
        }

        function getWithoutToggle() {
            return (($ctrl.withBgImg ? 1 : 0) + ($ctrl.withBgGradient ? 1 : 0) + ($ctrl.withBgColor ? 1 : 0)) === 1;
        }

        function getItemPopupTemplate() {
            if (!$ctrl.isLoaded) {
                return '';
            }
            var l = [],
                isStep2 = $ctrl.step === 'isedit2';
            if ($ctrl.isNew || $ctrl.isDuplicate) {
                has2Steps = true;
            }

            if (!isStep2) {
                l.push({
                    btn: getFirstStepBtn(),
                    fCls: 'transparent',
                    //cls: 'maxwidth550',
                    body: getFirstBody(),
                    headerInfo: {
                        icon: $ctrl.icon,
                        iconLevel: $ctrl.iconLevel,
                        title: (has2Steps ? 'Name Your ' : 'Rename ') + $ctrl.nameForList,
                    }
                });
            }

            if (has2Steps || isStep2) {
                l.push({
                    btn: getSecStepBtn(),
                    body: getSecBody(),
                    headerInfo: {
                        //icon: $ctrl.icon,
                        //iconLevel: $ctrl.iconLevel,
                        title: '<span class="hide-ipad">Select </span>' + $ctrl.nameForList + ' Background',
                        // subtitle: $ctrl.item ? $ctrl.item.name : ''
                    }
                });
            }


            return $ctrl.getItemPopupMSForm(l, 'with-small', false);

            function getFirstStepBtn() {
                var action = getBtnName() + ' ' + $ctrl.itemTitle;
                return has2Steps ?
                    ('<button data-required="true" class="max-width300 btn btn-primary nextbtn page-class ' + ($ctrl.pageClass || '') +
                        //' ' + $ctrl.getBtnActionCls() +
                        '" ' +
                        $ctrl.getAnalytics(action) +
                        //data-type="addBoard"
                        'ng-disabled="' + $ctrl.disabledText + '" ng-class="{\'disabled\':' + $ctrl.disabledText + '}" type="button">' + action + '</button>') :

                    getBtn();

                function getBtn() {
                    return '<button class="max-width300 btn btn-primary submitbtn ' + $ctrl.pageClass + ' ' + $ctrl.getBtnActionCls() + '" type="submit" data-type="save" ' +
                        $ctrl.getAnalytics(action) +
                        'ng-disabled="' + $ctrl.disabledText + '" ng-class="{\'disabled\':' + $ctrl.disabledText + '}"> ' +
                        '<span class="sbf loadingicon animate-spin" ng-show="$ctrl.isUpdating===true"></span> <span>' + (getBtnName() + '</span><span class="hide-ipad"> ' + $ctrl.itemTitle + '</span>') + '</button>';
                }

                function getBtnName() {
                    return ($ctrl.isNew ? 'Create' : ($ctrl.isDuplicate ? 'Duplicate' : 'Save'));
                }
            }

            function getFirstBody() {
                return '<div class="centering max-width-424" >' +
                    getRow('name') +
                    ($ctrl.customDescForList ? getRow('description') : '') +
                    '</div>' +
                    (has2Steps ? ('<ul class="progressdots hide-ipad ' + $ctrl.pageClass + '">' +
                        '<li><button class="with-primary-bg-before active"></button></li>' +
                        '<li><button class="nextbtn" data-required="true" ng-disabled="$ctrl.isBtnDisabled()"></button></li>' +
                        '</ul>') : '');
            }

            function getSecStepBtn() {
                return '<button class="max-width300 btn btn-primary submitbtn ' + $ctrl.pageClass + ' ' + $ctrl.getBtnActionCls() + '" type="submit" data-type="save" ' +
                    $ctrl.getAnalytics('Save ' + $ctrl.itemTitle) +
                    'ng-disabled="' + $ctrl.disabledText + '" ng-class="{\'disabled\':' + $ctrl.disabledText + '}"> <span class="sbf loadingicon animate-spin pull-left" ng-show="$ctrl.isUpdating===true"></span> <span>Save</span><span class="hide-ipad"> ' + $ctrl.itemTitle + '</span></button>';
            }

            function getSecBody() {
                return getSecContent() + (has2Steps ? getUl() : '');

                function getUl() {
                    return '';//hide bullets on sec step
                    return '<ul class="progressdots hide-ipad ' + $ctrl.pageClass + '">' +
                        '<li><button class="previousbtn"></button></li>' +
                        '<li><button class="with-primary-bg-before active"></button></li>' +
                        '</ul>';
                }
            }

            function getRow(prop, cls, other) {
                return $ctrl.getRowCols([_.find($ctrl.columnsList, {prop: prop})], cls, true, $ctrl.LCS.isMobileSize, other);
            }

            function getSecContent() {
                var withoutToggle = getWithoutToggle(),
                    showColors = !withoutToggle || withoutToggle && !$ctrl.withBgImg,
                    showImages = !withoutToggle || withoutToggle && $ctrl.withBgImg;
                return '<div class="secontent">' +
                    getHeader() +
                    (showColors ? getContent(false) : '') +
                    (showImages ? getContent(true) : '') +
                    '</div>' +
                    '<div class="wrapper-img" style="position:absolute;width:0;height:0;opacity:0;overflow:hidden"></div>';

                function getHeader() {
                    if (!$ctrl.withBgImg || withoutToggle) {
                        return '';
                    }

                    var txt1 = get('Background Color'),
                        txt2 = get('Background Image');
                    return '<div class="margin-bottom-20 text-center table-div centered">' +
                        '<div class="inline-block with-padding-right">' + txt1 + '</div>' +
                        getCheck(null, true) +
                        '<div class="inline-block with-padding-left">' + txt2 + '</div>' +
                        ($ctrl.CPS.hasQuotaType($ctrl.quotaTypeLayout) ? '' : '<span class="profeature with-margin-left">Pro</span>') +
                        '</div>';
                }

                function get(txt) {
                    return '<span class="header thin semibold">' + txt + '</span>';
                }

                function getCheck(txt, withImage, content) {
                    var isChecked = withImage === $ctrl.item.withImage;
                    return '<div class="custom-checkbox small with-label  switch inline-block col30 ' + ($ctrl.pageClass || '') + ' ' + $ctrl.getBtnActionCls() +
                        '" data-type="setWithImage" data-info="' + withImage + '"><label class="i-switch radiobtn">' +
                        '<input type="checkbox" ' + (isChecked ? 'checked="checked" ' : '') + '>' +
                        '<i></i>' +
                        '<span class="header thin"><span class="semibold">&nbsp; ' + (txt || '') + '</span>' +
                        '</label></div>';
                }

                function getContent(isImage) {
                    var isChecked = isImage === $ctrl.item.withImage,
                        content = getTable(isImage);
                    return '<div class="full-width clearfix wrapper-img ' + (isChecked ? '' : 'sb-hide') + '" data-type="' + isImage + '">' + content + '</div>';
                }

                function getTable(isImage) {
                    var val = $ctrl.item[getProp(isImage)];
                    return '<div class="fancy-scrollbar ultrathin" style="max-height:' + ($ctrl.withBgImg ? '300' : '302') + 'px;padding-left:5px;margin-right:-20px;padding-right:25px;">' +
                        '<div class="show-scrollbar-on-hover">' +
                        '<div class="custom-grid-wrapper small60 margin-top-quarter ' + getTableCls(isImage) + '"' + (isImage ? 'data-image="true"' : '') + ' >' +
                        (isImage ? $ctrl.getPopupFormForSelectedCol(_.find($ctrl.columnsList, {prop: 'backgroundImg'})) : '') +
                        getValuesList(isImage).map(getColumn).join('') +
                        '</div>' +
                        '</div>' +
                        '</div>';

                    function getColumn(item, i) {
                        var src = getImg(item, isImage);
                        return '<div class="' + $ctrl.getBtnActionCls() + ' with-cursor thumb-sm with-radius-square' +
                            (isImage ? ' with-img ' : (item.v === '#FFFFFF' ? ' with-bg' : '')) +
                            (item.isCustom ? ' with-transition ' : '') +
                            (isSelected(item) ? ' active ' : '') + '" data-type="' + (isImage ? 'selectImage' : (item.isCustom ? 'setCustomColor' : 'selectColor')) + '" data-info="' + i + '">' +
                            (isImage ? ('<img class="imgwrap resized-wrapped" src="' + src + '">' + getOver()) :
                                ('<div class="imgwrap resized-wrapped withImgBg"' +
                                    (item.isCustom ? '' : (' style="' + ($ctrl.SBColorService.isGradient(src) ? 'background-image' : 'background-color') + ':' + src + '"')) +
                                    '>' + getOver() + '</div>')) +
                            '</div>';

                        function getLabel() {
                            return isImage ? '' : ('<div class="' + (item.isBlack ? '' : 'white ') + 'font-general-12 semibold labelx"' +
                                //(item.isCustom ? 'style="margin-top"10px"' : '') +
                                '>' +
                                (item.isCustom ? $ctrl.LCS.getISBDiv('plus-circled', 2, 'sbf30 blue') : '') +
                                (item.isCustom ? ('<div class="full-width text-center">' + item.n + '</div>') : item.n) +
                                (item.withDelete ? ('<div class="sbf cancel with-transition ' + (item.isBlack ? 'gray ' : 'white ') + $ctrl.getBtnActionCls() + '" data-type="removeCompanyColor" data-info="' + item.v + '"></div>') : '') +
                                '</div>'
                            );
                        }

                        function getOver() {
                            return '<div class="overtxt">' + getLabel() + (item.isCustom ? '' : getBtnPreview(item.isCustom)) + '</div>';
                        }
                    }

                    function isSelected(item) {
                        return val ? val === item.v : item.isDefault;
                    }
                }

                function getBtnPreview(isAddCustom) {
                    return '<button class="btn btn-small primary-faded previewBtn with-transition ' + $ctrl.getBtnActionCls() + '" data-type="preview"  analytics-on analytics-action="' + ('Project ' + ($ctrl.isNew ? 'Created' : ($ctrl.isDuplicate ? 'Duplicated' : 'Saved'))) + '">' + (isAddCustom ? 'Select Color' : 'Preview') + '</button>';
                }

                function getImg(item, isImage) {
                    return item.v ? (isImage ? getImgUrl(item.v) : item.v) : item.d;
                    //https://devimgs.studiobinder.com/580e85847e7982164664e844/resize-uploaded-image?f=taskboard-backgrounds/studiobinder-callsheet-logo1.png&w=400
                }
            }
        }

        function preview(info, e) {
            console.log('preview');
            var isImage = selectPreview(e),
                el = e.currentTarget,
                isAddCustom = el.getAttribute('data-type') === 'setCustomColor',
                txt = el.innerHTML;

            if (!isImage) {
                return processPreview(true, isAddCustom);
            }
            // give some time for image to load on the page -> meanwhile keep the popup opened  and add loading on preview btn
            el.innerHTML = '<span class="sbf loadingicon animate-spin font10"></span> <span>Loading…</span>';
            $ctrl.LCS.timeout(function () {
                el.innerHTML = txt;
                processPreview(true, isAddCustom);
            }, 100);
        }

        function setPreview(withPreview) {
            if ($ctrl.withPreview === withPreview) {
                return;
            }

            $ctrl.withPreview = withPreview;
            if (withPreview) {
                setSidebar();
                setModalAndBackdrop();
            } else {
                setModalAndBackdrop();
                setSidebar();
            }

            return true;

            function setModalAndBackdrop() {
                setOpacity('.modal', 'opacity', withPreview); //modal
                setOpacity('.modal', 'opacity', withPreview, true); //modal-backdrop

                function setOpacity(cls, name, isHidden, sibling) {
                    var el = $ctrl.LCS.findClosestParent($ctrl.element, cls);
                    if (el) {
                        if (sibling) {
                            el = el.nextSibling;
                        }
                        $ctrl.LCS[isHidden ? 'addClass' : 'removeClass'](el, $ctrl.hiddenCls);
                    }
                }

                function processStyle() {
                    setProp('.modal', 'opacity', withPreview ? 0 : 1); //modal
                    setProp('.modal', 'opacity', withPreview ? 0 : 0.92, true); //modal-backdrop

                    function setProp(cls, name, val, sibling) {
                        var el = $ctrl.LCS.findClosestParent($ctrl.element, cls);
                        if (el) {
                            if (sibling) {
                                el = el.nextSibling;
                            }
                            if (!el.style) {
                                el.style = {};
                            }
                            if (typeof (el.style.setProperty) === 'function') {
                                el.style.setProperty(name, val);
                            }
                        }
                    }
                }
            }

            function setSidebar() {
                var state = $ctrl.SBStateService.currentState.name,
                    hasSideBar = $ctrl.LCS.hasInnerSidebar(state);
                if ((withPreview && hasSideBar) || (!withPreview && !hasSideBar && $ctrl.hasSideBarInit)) {
                    $ctrl.LCS.toggleInnerSidebar(state);
                }

                $ctrl.LCS[withPreview ? 'addClass' : 'removeClass']($ctrl.LCS.bodyElement.querySelector('.comments-sidebar'), 'sb-hide');

            }
        }

        function processPreview(withPreview, isAddCustom) {
            console.log('processPreview');
            if (withPreview) {
                if (setPreview(withPreview)) {
                    bind(withPreview);
                }
            } else {
                bind(withPreview);
                setPreview(withPreview);
            }

            function bind(isBind) {
                var isb = isBind && !$ctrl.isPreviewBinded;
                if (isb || !isBind && $ctrl.isPreviewBinded) {
                    var cls = 'sb-previewbg-wrapper',
                        el = getEl();
                    if (isb) {
                        if (!el) {
                            var zIndex = 11000020;
                            $ctrl.LCS.appendChildFragment($ctrl.LCS.bodyElement, '<div class="' + cls + '" style="z-index:' + zIndex + '">' +
                                (isAddCustom ? '' : ('<div class="sb-previewbg-note">Press any key to exit the preview mode</div><input type="text" style="opacity:0;position:absolute;bottom:-300px;left:-300px;">')) +
                                '</div>');

                            if (isAddCustom) {
                                //open a new popup
                                $ctrl.popupsService.open(null, $ctrl.popupsService.operations.selectColor, {
                                    popupIndex: zIndex + 10,
                                    onConfirm: onConfirm,
                                    onColorChange: onColorChange,
                                    onClose: onClose
                                }, $ctrl.compOptions);

                                function onColorChange(color) {
                                    console.log('onColorChange: ' + color);
                                    var isPreview = true;
                                    setSelectedColor(false, isPreview, {v: color});
                                }

                                function onConfirm(sel) {
                                    console.log('onConfirm');
                                    setSelectedColor(false, false, sel);
                                    $ctrl.save();

                                    $ctrl.broadcastRoot('HIDE_MOBILE_DETAILS');
                                    $ctrl.close();
                                    onClose();
                                }

                                function onClose() {
                                    revertPreview(false);
                                }
                            } else {
                                $ctrl.LCS.timeout(function () {
                                    var wrapper = getEl();
                                    if (wrapper) {
                                        $ctrl.LCS.bindElementsClick(isBind, wrapper, revertPreview, 'preview-click');
                                        var input = wrapper.querySelector('input');
                                        if (input) {
                                            input.focus();
                                            $ctrl.LCS.bindElementsClick(isBind, input, revertPreview, 'preview-keydown', 'keydown');
                                        }
                                    }
                                }, 200);
                            }
                        }
                    } else if (el) {
                        $ctrl.LCS.removeElement(el);
                    }

                    $ctrl.isPreviewBinded = isBind;

                    function getEl() {
                        return $ctrl.LCS.bodyElement.querySelector('.' + cls);
                    }
                }
            }
        }

        function revertPreview(e) {
            console.log('revertPreview');
            $ctrl.preventDefault(e);

            if ($ctrl.isPreview) {
                $ctrl.isPreview = false;
                processPreview(false);
                onCurrentTreeListChangedOther({removePreview: true});
            }
        }

        function getImgUrl(v) {
            return $ctrl.security.resizeUploadedImg(v, {width: 400});
        }

        function setWithImage(info, e) {
            var val = !$ctrl.item.withImage;//(info === 'true' || info === true);
            if ($ctrl.item.withImage !== val) {
                set($ctrl.item.withImage, false);
                $ctrl.item.withImage = val;
                set($ctrl.item.withImage, true);
            }

            function set(val, setChecked) {
                var el = $ctrl.element.querySelector('.custom-checkbox[data-type="setWithImage"][data-info="' + val + '"] input');
                if (el) {
                    if (setChecked) {
                        el.setAttribute('checked', 'checked');
                    } else {
                        el.removeAttribute('checked');
                    }
                }
                $ctrl.LCS[setChecked ? 'removeClass' : 'addClass']($ctrl.element.querySelector('.wrapper-img[data-type="' + val + '"]'), 'sb-hide');
            }
        }

        function getTableCls(isImage) {
            return 'table-' + (isImage ? 'images' : 'colors');
        }

        function selectImage(id, e) {
            console.log('selectImg');
            processSelected(true, id, false);
        }

        function selectColor(id, e) {
            console.log('selectColor');
            processSelected(false, id, false);
        }

        function setCustomColor(id, e) {
            console.log('setCustomColor');
            processSelected(false, id, true, true);
            preview(true, e);
        }

        function selectPreview(e) {
            var el = $ctrl.LCS.findClosestParent(e.currentTarget, '.thumb-sm'),
                isImage;
            if (el) {
                var id = el.getAttribute('data-info');
                isImage = el.getAttribute('data-type') === 'selectImage';
                processSelected(isImage, id, true);
            }
            return isImage;
        }

        function setActive(isImage, isActive, id) {
            var el = $ctrl.element.querySelectorAll('.' + getTableCls(isImage) + ' .thumb-sm' +
                (isActive ? '' : '.active') +
                (isActive ? ('[data-info="' + id + '"]') : '')
            );
            $ctrl.LCS[isActive ? 'addClass' : 'removeClass'](el, 'active');
            return el;
        }

        function processSelected(isImage, id, isPreview, isCustom) {
            var index = parseInt(id, 10);

            if (!isPreview || isPreview && isCustom) {
                setActive(isImage, false);
                setActive(isImage, true, index);
            }

            var sel = getValuesList(isImage)[index];

            if (!isPreview && !sel) {
                return;
            }
            setSelectedColor(isImage, isPreview, sel);

            return sel ? sel.v : null;
        }

        function setSelectedColor(isImage, isPreview, sel) {
            if (isPreview) {
                //$ctrl.previewItem = updateVals(isImage, _.clone($ctrl.item), sel);
                $ctrl.isPreview = true;
                onCurrentTreeListChangedOther(_.extend(updateVals(isImage, _.clone($ctrl.item), sel), {isPreview: $ctrl.isPreview}));
            } else {
                $ctrl.item = updateVals(isImage, $ctrl.item, sel);
            }
        }

        function onCurrentTreeListChangedOther(result) {
            $ctrl.onCurrentTreeListChangedOther(result);
        }

        function updateVals(isImage, item, sel) {
            item[getProp(isImage)] = sel.v;
            //item[getProp(!isImage)] = null; //propfor img and gradient is the same
            //item.sideColors = isImage ? {isPredef: true} : $ctrl.SBAverageColorService.getColorsFromColor(item.color);
            item.backgroundId = null;

            return setImgProps(item);
        }

        function getProp(isImage) {
            return 'background';
            //return isImage ? 'background' : 'color';
        }

        function setImgProps(item, isReverse) {
            // item.background ? true : false;
            var from = isReverse ? 'backgroundImg' : 'background',
                to = isReverse ? 'background' : 'backgroundImg',
                val = item[from],
                valId = item[from + 'Id'];

            // is not gradient or color
            item.withImage = getWithoutToggle() ? $ctrl.withBgImg === true : (val ? $ctrl.SBColorService.isImage(val) === true : false); //is not gradient

            item[to] = valId ? val : null;
            item[to + 'Id'] = valId ? valId : null;

            return item;
        }

        function setUploadedImageActive(set) {
            var isImage = true;
            setActive(isImage, false);
            if (set) {//is remove img otherwise
                $ctrl.LCS.addClass($ctrl.element.querySelector('.sb-resizable-img .thumb-sm'), 'active');
            }
        }

        function onImageUpdate(updatedItem) {
            console.log('onImageUpdate');
            setUploadedImageActive(updatedItem && updatedItem.backgroundImgId);

            $ctrl.item = setImgProps($ctrl.item, true);
        }

        function getValuesList(isImage) {
            var type = 'Values' + (isImage ? 'Img' : ''), l = [];
            if (!$ctrl[type]) {
                if (!isImage) {
                    if ($ctrl.selectCustomColor) {
                        l.push({n: 'Add Custom Color', v: 'custom', isCustom: true, isBlack: true});
                    }

                    l.push({
                        n: 'Default',
                        v: null,
                        d: 'radial-gradient(circle at 50% 50%, #E6E6E6 0%, #F5F5F5 50%)',
                        isBlack: true,
                        isDefault: true
                    });

                    getCompanyColors();
                    var f = $ctrl.companyColorsObj;
                    if (f) {
                        l = l.concat(f);
                    }
                }

                l = l.concat(isImage ? $ctrl.PredefBgs : $ctrl.PredefColors);

                $ctrl[type] = l;
            }

            return $ctrl[type];
        }

        function getObjFromcolor(v) {
            if (v.indexOf('#') === -1 || v.indexOf('/') !== -1) {
                return null;
            }
            return {n: $ctrl.SBColorService.getColorName(v), v: v, withDelete: true, isBlack: tinycolor(v).isLight()};
        }

        function isPredefColor(c) {
            return _.find($ctrl.PredefColors, {v: c});
        }

        function onDestroy() {
            bindOverlay(false);
            revertPreview();
        }

        function loadPredefColors() {
            if (!$ctrl.PredefColors) {
                $ctrl.PredefColors = [];
                if ($ctrl.withBgGradient) {
                    $ctrl.PredefColors = $ctrl.PredefColors.concat($ctrl.SBColorService.PredefGradients);
                }
                if ($ctrl.withBgColor) {
                    $ctrl.PredefColors = $ctrl.PredefColors.concat($ctrl.SBColorService.PredefColors);
                }
            }

            //files are on s3 https://devapps3.studiobinder.com/uploads/taskboard-backgrounds/adomas-aleno--ySLeov8m_8.webp and resized with
            //https://devimgs.studiobinder.com/580e85847e7982164664e844/resize-uploaded-image?f=taskboard-backgrounds/adomas-aleno--ySLeov8m_8.webp&w=400
            if (!$ctrl.PredefBgs && $ctrl.withBgImg) {
                $ctrl.PredefBgs = $ctrl.SBColorService.PredefBgs;
            }
        }

        function getColorsFromImg(src, final) {
            var img = new Image();
            img.onload = onSuccess;
            img.onerror = onError;
            img.crossOrigin = 'Anonymous';
            img.src = src;

            function onSuccess(result) {
                $ctrl.item.sideColors = $ctrl.SBAverageColorService.getColorsFromImg(img);
                final(src);
            }

            function onError(err) {
                //console.log(err);
                final(null);
            }
        }

        /* function setSideColors() {
            if(isPreview){return;}
            var thumb = set(true, index),
                img = isImage && thumb ? thumb.querySelector('.imgwrap') : null;
            //item.sideColors = isImage && img ? $ctrl.SBAverageColorService.getColorsFromImg(img) : null;
        }*/
    }
}

angular.module('product.preLoading.init.group.service', [
])
.service('InitGroupLoadingService', InitGroupLoadingService);

function InitGroupLoadingService() {
    return function (Tbl, isInit, parentRel, TblTypes, other) {
        var Resource = function (params) {
            console.log('ScriptLoadingFactory constr');
            var _this = this;

            if(other){_this = _.extend(_this, other);}

            _this.allParams = {};
            for (var tableType in Tbl) {
                var loadingService = Tbl[tableType].loadingService;
                var initCols = Tbl[tableType].tableParamsColsInit ? Tbl[tableType].tableParamsColsInit : loadingService.tableParamsColsInit;
                Tbl[tableType].id = loadingService.table;
                Tbl[tableType].tableType = tableType;

                if (!Tbl[tableType].listField && loadingService.listField) {
                    Tbl[tableType].listField = loadingService.listField;
                }

                var tableParams = {};
                _.each(initCols, function (col) {
                    tableParams[col] = params[col];
                });
                _this.allParams[tableType] = tableParams;
            }
            _this.TblTypes = TblTypes;

            _this.Tbl = Tbl;
            _this.Ops = {
                Create: 'Create',
                Edit: 'Edit',
                Remove: 'Remove',
                Archive: 'Archive',
                Activate: 'Activate'
            };
            _this.isInit = isInit;
            _this.parentRel = parentRel;
            return _this;
        };

        Resource.prototype.updateListFieldForTables = function(listFieldForTables) {
            var _this = this;
            if (listFieldForTables) {
                for (var tableType in Tbl) {
                    var listField = listFieldForTables[tableType];
                    if (listField) {
                        _this.Tbl[tableType].listField = listField;
                    }
                }
            }
        };

        Resource.prototype.getChildListByType = function(tableType, type, listId, groupFilters, groupOrder, groupPopulate) {
            var _this = this,
                table = _this.Tbl[tableType],
                childService = table.loadingService.childService;
            return childService.getChildListByType(_this.getTableParamsForService(childService), type, listId, groupFilters, groupOrder, groupPopulate);
        };

        Resource.prototype.getTableParams = function (table) {
            return getAllParams(this, table);
        };
        Resource.prototype.getTableParamsForService = function (el) {
            return getAllParams(this, el);
        };

        function getAllParams(_this, table){
            return _this.allParams[table.tableType];
        }

        Resource.prototype.onTreeNodeMethod = function (tableType, method, result) {
            var _this = this,
                table = _this.Tbl[tableType],
                childListField = _this.Tbl[table.loadingService.childService.tableType].listField;

            table.loadingService[method](_this.getTableParams(table), result, childListField);

            _this.processTablesUpdatesG(result);
        }

        Resource.prototype.updateItem = function (tableType, item) {
            var _this = this,
                table = _this.Tbl[tableType];
            return table.loadingService.updateItem(_this.getTableParams(table), item);
        };

        Resource.prototype.removeManyIds = function (tableType, ids) {
            var _this = this,
            table = _this.Tbl[tableType];
            return table.loadingService.removeManyIds(_this.getTableParams(table), ids);
        };

     /*   Resource.prototype.removeMany = function (table, items) {
            var _this = this;
            return table.loadingService.removeMany(_this.getTableParams(table), items);
        };*/

        Resource.prototype.processCachedElementInit = function (el, cacheType, changedFields, tableType, isChildTable) {
            if (!tableType) {return;}
            return this[isChildTable ? 'modifyChild' : 'modify'](tableType, el, cacheType, changedFields);
        }

        Resource.prototype.updateMany = function (tableType, updates) {
            var _this = this,
                table = _this.Tbl[tableType];
            return table.loadingService.updateMany(_this.getTableParams(table), updates);
        };

        Resource.prototype.modify = function (tableType, item, actionType, changedFields) {
            var _this = this,
            table = _this.Tbl[tableType];
            return table.loadingService.modify(_this.getTableParams(table), item, actionType, changedFields);
        };

        Resource.prototype.modifyChild = function(tableType, item, actionType, changedFields) {
            var _this = this,
                table = _this.Tbl[tableType],
                childService = table.loadingService.childService;
            if(childService){
               return childService.modify(_this.getTableParamsForService(childService), item, actionType, changedFields);
            }
        };

        Resource.prototype.getObjectList = function (tableType, query, order, populate) {
            var _this = this,
            table = _this.Tbl[tableType];
            //console.log('InitGroupLoadingService. getObjectList ' + table.tableType + ' ' + getSBTimestamp());
            return table.loadingService.getObjectList(_this.getTableParams(table), query, order, populate);
        };

        Resource.prototype.getObjectService = function (tableType) {
            var _this = this,
            table = _this.Tbl[tableType];
            return table.loadingService.getObjectService();
        };

        Resource.prototype.getList = function (tableType, query, orderProp, populate) {
            var _this = this,
                table = _this.Tbl[tableType];
            //console.log('InitGroupLoadingService. getList ' + table.tableType + ' ' + getSBTimestamp())
            return table.loadingService.getList(_this.getTableParams(table), query, orderProp, populate);
        };

        Resource.prototype.getListIds = function (tableType, query, orderProp, populate) {
            var _this = this,
                table = _this.Tbl[tableType];
            return table.loadingService.getListIds(_this.getTableParams(table), query, orderProp, populate);
        };

        Resource.prototype.getListCount = function (tableType, query, orderProp) {
            var _this = this,
            table = _this.Tbl[tableType];
            return table.loadingService.getListCount(_this.getTableParams(table), query, orderProp);
        };

        Resource.prototype.getChildListByType = function (tableType, type, listId, groupFilters, groupOrder, groupPopulate) {
            var _this = this,
                table = _this.Tbl[tableType],
                child = table.loadingService.childService,
                childListField = _this.Tbl[child.tableType].listField;

            return child.getListByType(_this.getTableParamsForService(child), type, listId, groupFilters, groupOrder, groupPopulate, childListField);
        };

        Resource.prototype.getById = function (tableType, id, settings) {
            var _this = this,
                table = _this.Tbl[tableType];
            return table.loadingService.getById(_this.getTableParams(table), id, settings);
        };

        Resource.prototype.getByIdFromTable = function (table, id) {
            var _this = this;
            return table.loadingService.getById(_this.getTableParams(table), id);
        };

        Resource.prototype.getPreById = function (tableType, id, settings) {
            var _this = this,
                table = _this.Tbl[tableType];
            return table.loadingService.getPreById(_this.getTableParams(table), id, settings);
        };

        Resource.prototype.sortList = function (list, orderProp) {
            var Tbl = this.Tbl;
            for(var tableType in Tbl){
                return Tbl[tableType].loadingService.sortList(list, orderProp);
            }
        };

        Resource.prototype.preloadTables = function(next, selected) {
            var _this = this;
            if(_this.parentRel) {

                preloadTablesWithParent(_this, next);
            }else{
                preloadTables(_this, next, selected);
            }
        };
        Resource.prototype.load = function(next, otherParams) {
            var _this = this;
            return _this.preloadTables(next) ;
        };

        Resource.prototype.processTablesUpdatesG = function (result) {
            if(!result || result.dontProcessG || result.processMultipleDelayed){
                return;
            }
            var _this = this,
                updatesG = result.updatesG;
            if (!updatesG) {
                return;
            }

            for (var collection in updatesG) {
                var table = _this.getTableForCollection(collection);
                if(table) {
                    table.loadingService.processTableUpdates(_this.getTableParams(table), updatesG[table.loadingService.getCollection()]);
                }else{
                    console.log('Table for collection ' + collection + ' is not defined in this preLoadingService instance');
                }
            }

            delete result.updatesG;
        };

        Resource.prototype.loadTablesFromData = function (result) {
            console.log('ScriptLoadingFactory loadTables');
            var _this = this, prop;
            for (prop in result) {
                var type = isLoadedTable(prop);
                var table = getTable(prop, type);
                if (type === 1) {
                    var ids = result[table.id + 'Ids'];
                    if (ids.length > 0) {
                        var objs = result[table.id + 'Objs'];
                        var data = objs ? ids.map(function (id) {
                            return objs[id];
                        }) : null;
                        var loadingService = table.loadingService;
                        if (loadingService && data) {
                            loadingService.initTable(_this.getTableParams(table), data);
                        }
                    }
                } else if (type === 3) {
                    //categories is an array so convert to objs
                    //tagging scenes is an array so convert to objs
                    //todo
                    _this.preInitTable(table.loadingService, result, _this.getTableParams(table));
                }
            }

            function isLoadedTable(prop) {
                if (prop === 'taggingElementIds' || prop === 'stripIds') {
                    return 1;
                } else if (prop === 'taggingElementObjs' || prop === 'stripObjs') {
                    return 2;
                } else if (prop === 'taggingScenes' || prop === 'taggingCategories' || prop === 'schedules') {
                    return 3;
                }
                return 0;
            }

            function getTable(prop, type) {
                if (type === 3) {
                    if (prop === 'taggingCategories') {
                        return _this.Tbl[_this.TblTypes.TaggingCategories];
                    } else if (prop === 'taggingScenes') {
                        return _this.Tbl[_this.TblTypes.TaggingScenes];
                    } else if (prop === 'stripSchedules') {
                        return _this.Tbl[_this.TblTypes.StripSchedules];
                    }
                } else {
                    return getTableProp(_this, prop.substring(0, prop.length - 3));//has Ids or Obj at the end
                }
            }
        };

        Resource.prototype.preInitTable = function (loadingService, result, p) {
            if (!result || !loadingService) {
                return;
            }
            loadingService.initTable(p, result[loadingService.getCollection()]);
        };

        Resource.prototype.getTableForCollection = function (collection) {
            var _this = this;
            return getTableProp(_this, getTableName(collection));

            function getTableName(name) {
                if (name.substring(name.length - 3, 3) === 'ies') {
                    return name.substring(0, name.length - 3) + 'y';
                }
                switch (name) {
                    case 'team':
                    case 'cast':
                        return name;
                    default:
                        return name.substring(0, name.length - 1);
                }
            }
        };

        Resource.prototype.loadAndInitTable = function (tableType, pageSize, populate, c, method, processParams, useInit) {
            var _this = this,
                table = _this.Tbl[tableType],
                params = _this.getTableParams(table),
                params1 = typeof(processParams) === 'function' ? processParams(params) : params;

            _this.getObjectService(tableType)[method ? method : 'getAll'](params1, pageSize, populate, onsuccess, onerror);

            function onsuccess(list) {
                var hasDocs = list && list.docs;
                table.loadingService.initTable(useInit ? params : params1, hasDocs ? list.docs : list);
                return c(null, hasDocs ? list : null);
            }

            function onerror(err) {
                console.log(err);
                return c();
            }
        };

        return Resource;

        function preloadTablesWithParent(_this, next) {
            console.log('preloadTablesWithParent init');
            loadInitTables(_this, [_this.Tbl[_this.parentRel.parent]], null, null, function () {
                if (_this.parentRel.parent !== _this.parentRel.child) {
                    var child = _this.Tbl[_this.parentRel.child];
                    if(child.withoutLoad){
                        next();
                    } else{
                        tLoadInitTables(_this, [child], next);
                    }
                } else {
                    next();
                }
            });
        }

        function preloadTables(_this, next, selected) {
            console.log('ProductsLoadingService init');
            var TblList = [];
            if(selected){
                _.each(selected, function (tableType) {
                    TblList.push(_this.Tbl[tableType]);
                })
            }else{
                for(var tableType in _this.Tbl){
                    var table = _this.Tbl[tableType];
                    if(!table.withoutLoad){
                        TblList.push(table);
                    }
                }
            }
            tLoadInitTables(_this, TblList, next);
        }

        function tLoadInitTables(_this, TblList, next) {
            loadInitTables(_this, TblList, _this.isInit, function (__this, process) {
                var beforeProcessed = _this.beforeTablesProcessed;
                if (typeof (beforeProcessed) === 'function') {
                    beforeProcessed(__this);
                }
                process();
            }, next);
        }

        function loadInitTables(_this, TblList, isInit, after, next) {
            console.log('loadInitTables');
            if (_this[isInit] && !_this.clearCacheOnReload) {
                return next();
            }

            var tasks = {}, params={};
            _.each(TblList, function (table) {
                if(table){
                    var p = table.loadingService.getLoadTableTaskParams(_this.getTableParams(table));
                    params[table.id] = p;
                    _.extend(tasks, table.loadingService.loadTableTask(p));
                }else{
                    console.log( 'loadInitTables error for table ' + table.id);
                }
            });

            async.parallel(tasks, function (err, result) {
                _.each(TblList, function (table) {
                    if(table){
                        _this.preInitTable(table.loadingService, result, params[table.id] );
                    }else{
                        console.log('loadInitTables invalid loadingService : '+ table.id)
                    }
                });

                if (typeof (after) === 'function') {
                    after(_this, process)
                } else {
                    process();
                }

                function process() {
                    _this[isInit] = true;

                    if (typeof (next) === 'function') {
                        next();
                    }
                }
            });
        }

        function getTableProp(_this, table) {
            for (var tableType in _this.Tbl) {
                var res = _this.Tbl[tableType];
                if (table === res.id) {
                    return res;
                }
            }
            return null;
        }
    }
}

angular.module('product.preLoading.resource.init.service', [
    'product.preLoading.tables.service',
    'services.listSorting','sceneNumber.service'
])
.service('PreloadingResourceInitService', PreloadingResourceInitService);
PreloadingResourceInitService.$inject = ['PreloadingTablesService', 'ListSortingService', 'SceneNumberService'];

function PreloadingResourceInitService( PreloadingTablesService, ListSortingService, SceneNumberService) {
    console.log('ResourceLoadServiceInit constr');
    var _this = this;
    _this.getList = getList;
    _this.sortList = sortList;
    _this.getListCount = getListCount;
    _this.initTable = initTable;
    _this.processObjProps = processObjProps;
    _this.insertMany = insertMany;
    _this.updateMany = updateMany;
    _this.updateItem = updateItem;
    _this.removeManyIds = removeManyIds;
    _this.removeMany = removeMany;
    _this.setObjectById = setObjectById;
    _this.getObjectById = getObjectById;
    _this.getObjectIds = getObjectIds;
    _this.getCollection = getCollection;
    _this.getNewSceneNumber = SceneNumberService.getNewSceneNumber;
    _this.getListIds = getListIds;

    return _this;

    function getListCount(tableParams, tableType, query, orderProp) {
        return getListIds(tableParams, tableType, query, orderProp,true);
    }

    function getListIds(tableParams, tableType, query, orderProp, isCount) {
        var list = getPreprocessList(tableParams, tableType, query, orderProp, isCount);
        if (!isCount) {
            return list ? list.map(function (item) {
                return item._id;
            }) : [];
        } else {
            return list && list.length > 0 ? list.length : 0;
        }
    }

    function sortList(list, orderProp) {
       return ListSortingService.sortList(list, orderProp ? orderProp : {order: 1});
    }

    function getList(tableParams, tableType, query, orderProp, populate, map) {
       // console.log('PreloadingResourceInitService.getList ' + tableType +': ' + getSBTimestamp())
        var list = getPreprocessList(tableParams, tableType, query, orderProp, false);
       //console.log('PreloadingResourceInitService.after sort ' + getSBTimestamp());
        if (typeof (map) === 'function') {
            list = list.map(map);
        }
       //console.log('PreloadingResourceInitService.after map ' + getSBTimestamp());
        return list;
    }


    function getPreprocessList(tableParams, tableType, query, orderProp, isCount) {
        var ids = _this.getObjectIds(tableParams, tableType);
        if (!ids) {
            ids = [];
        }
        if (!query && isCount) {
            return ids;
        }
        var list = ids.map(function (id) {
            return getObjectById(tableParams, tableType, id);
        });

        if (query) {list = _.filter(list, query);}

        return sortList(list, orderProp);
    }

    function filterList(list, query) {
        if (!query) {
            return list;
        }
        if (typeof (query) === 'function') {
            return process(query);
        }
        var str = '';
        for (var prop in query) {
            var p = prop.split('.'), val = query[prop];
            if (p.length === 2) {
                str += 'var p=item.' + p[0] + ';' +
                    'if(!p){return false;}' +
                    'if(item.' + prop + '.' + p[1] + '!==val;';
                return
            } else {
                str += 'return item.' + prop + '===val;'
            }
        }
        return (str && str.trim() !== '') ? eval('(function(el) {' + str + 'return true;})') : null;


        function process(filter) {
            return _.filter(list, filter);
        }
    }

    function insertItem(tableParams, tableType, item) {
        if (!item) {
            return;
        }
        var id = item ? item._id : undefined;
        if (id === undefined) {
            return item;
        }
        addObjectId(tableParams, tableType, id);

        return processObjProps(tableParams, tableType, item);
    }

    function updateItem(tableParams, tableType, el) {
        var id = el ? el._id : undefined;
        if (id === undefined) {
            return el;
        }
        var item = getObjectById(tableParams, tableType, id);
        if (!item) {
            return null;
        }

        for (var prop in el) {
            var str = prop.split('.');
            if(str.length>1){
                if(!item[str[0]]){item[str[0]] = {};}
                item[str[0]][str[1]] = el[prop];
            }else {
                item[prop] = el[prop];
            }
        }

        return processObjProps(tableParams, tableType, item);
    }

    function processObjProps(tableParams, tableType, item) {
        /* for (var prop in item) {
             var p = item[prop];
             switch (type) {
                 case _this.TableTypes.TaggingElements:
                     if (prop === 'currentReferenceIds') {
                         if (item.type === 3) { //stripLocation
                             item.currentReferences = p && p.length > 0 ? p.map(function (id) {
                                 return _this.locationObjs[id];
                             }) : null;
                         }
                     }
                     break;
                 case _this.TableTypes.Strips:
                     if (prop === 'locationIds') {
                         item.locations = p && p.length > 0 ? p.map(function (id) {
                             return _this.locationObjs[id];
                         }) : null;
                     }
                     break;
                 case _this.TableTypes.TaggingScenes:
                     if (prop === 'locationIds') {
                         item.locations = p && p.length > 0 ? p.map(function (id) {
                             return _this.locationObjs[id];
                         }) : null;
                     }
                     break;
             }
         }*/

        if (item) {
            /*
            if (type === _this.TableTypes.Strips) {
                _this.stripContentObjs.item._id] = item.content ? item.content : null;
                delete item.content;
            }*/
            setObjectById(tableParams, tableType, item._id, item)
        }

        return getObjectById(tableParams, tableType, item._id);
    }

    function insertMany(tableParams, tableType, els) { //els array of els
        if (!els || els.length === 0) {
            return;
        }
        return els.map(function (el) {
            return insertItem(tableParams, tableType, el);
        });
    }

    function updateMany(tableParams, tableType, updates) { //updste ={elId:{}, }
        if (!updates) {
            return;
        }
        for (var id in updates) {
            var props = updates[id];
            if (props) {
                updateItem(tableParams, tableType, _.extend({_id: id}, props));
            }
        }
    }

    function removeManyIds(tableParams, tableType, removedIds) {
        if (!removedIds || removedIds.length === 0) {
            return;
        }
        var ids = _this.getObjectIds(tableParams, tableType);
        for (var i = ids.length - 1; i >= 0; i--) {
            var id = ids[i];
            if (_.find(removedIds, function(id1){return id1 === id;})) {
                removeObjectById(tableParams, tableType, id);
            }
        }
        return removedIds.length;
    }

    function removeMany(tableParams, tableType, list) {
        return list && list.length > 0 ? removeManyIds(tableParams, tableType, list.map(function (item) {
            return item ? item._id : null;
        })) : null;
    }

    function getCollection(name) { //tableType
        if (name[name.length - 1] === 'y') {
            return name.substring(0, name.length - 1) + 'ies';
        }
        switch (name) {
            case 'team':
            case 'cast':
                return name;
            default:
                return name + 's';
        }
    }

    //used
    function getObjectById(tableParams, tableType, id) {
        var objs = getObjects(tableParams, tableType);
        return objs ? angular.copy(objs[id]) : undefined;
    }

    function initTable(tableParams, tableType, data) {
        PreloadingTablesService.initTable(tableParams, tableType, data);
        return _this.insertMany(tableParams, tableType, data);
    }

    //internally
    function getObjects(tableParams, tableType) {
        return PreloadingTablesService.getObjects(tableParams, tableType) || {};
    }

    function getObjectIds(tableParams, tableType) {
        return PreloadingTablesService.getObjectIds(tableParams, tableType) || [];
    }

    function addObjectId(tableParams, tableType, id) {
        return PreloadingTablesService.addObjectId(tableParams, tableType, id);
    }

    function setObjectById(tableParams, tableType, id, val) {
        return PreloadingTablesService.setObjectById(tableParams, tableType, id, val);
    }

    function removeObjectById(tableParams, tableType, id) {
        return PreloadingTablesService.removeObjectById(tableParams, tableType, id);
    }
}

angular.module('product.preLoading.tables.service', [
])
.service('PreloadingTablesService', PreloadingTablesService);

var PreloadingTables;

function PreloadingTablesService() {
    console.log('PreloadingTablesService constr');
    var _this = this;
    var tables = {};
    PreloadingTables = tables;
    _this.initTable = initTable;
    _this.getObjects = getObjects;
    _this.getObjectIds = getObjectIds;
    _this.addObjectId = addObjectId;
    _this.setObjectById = setObjectById;
    _this.removeObjectById = removeObjectById;

    _this.removeTableById = removeTableById;
    _this.getObjectById = getObjectById;

    return _this;

    function removeTableById(tableParams, tableType) {
        var el = tables[getObjKey(tableParams, tableType)];
        if(el){
            delete tables[getObjKey(tableParams, tableType)];
            return true;
        }
        return false;
    }
    function setObjectById(tableParams, tableType, id, val) {
        tables[getObjKey(tableParams, tableType)][id] = val;
    }

    function getObjects(tableParams, tableType) {
        return tables[getObjKey(tableParams, tableType)];
    }

    function getObjectById(tableParams, tableType, id) {
        try {
            return getObjects(tableParams, tableType)[id];
        } catch (e) {
            return null;
        }
    }

    function getObjectIds(tableParams, tableType) {
        return tables[getIdsKey(tableParams, tableType)];
    }

    function removeObjectById(tableParams, tableType, id) {
        var i = getObjectIds(tableParams, tableType).indexOf(id);
        if (i !== -1) {
            tables[getIdsKey(tableParams, tableType)].splice(i, 1);
        }
        var el = tables[getObjKey(tableParams, tableType)][id];
        delete tables[getObjKey(tableParams, tableType)][id];
        return el;
    }

    function addObjectId(tableParams, tableType, id) {
        var ids = getObjectIds(tableParams, tableType);
        if(!ids){
            console.log('addObjectId: ' + tableType);
            console.log(tableParams);
        }
        if(!ids){
            initTable(tableParams, tableType);
        }

        if (!ids || ids&&ids.indexOf(id) === -1) {
            tables[getIdsKey(tableParams, tableType)].push(id);
        }
    }

    function initTable(tableParams, tableType) {
        tables[getIdsKey(tableParams, tableType)] = [];
        tables[getObjKey(tableParams, tableType)] = {};
    }

    function getIdsKey(tableParams, tableType) {
        return getTableParamsId(tableParams, tableType) + 'Ids';
    }

    function getObjKey(tableParams, tableType) {
        return getTableParamsId(tableParams, tableType) + 'Objs';
    }

    function getTableParamsId(params, tableType) {
        return params.companyId + '_' +
            (params.productId ? params.productId : null) + '_' +
            (params.scriptId ? params.scriptId : null) + '_' +
            (params.callsheetId ? params.callsheetId : null) + '_' +
            (params.type ? params.type : null) + '_' +
            (params.todoCardId ? params.todoCardId : null) + '_' +
            (params.uId ? params.uId : null) + '_' +
            (params.documentId ? params.documentId : null) + '_' +
            (params.taskBoardId ? params.taskBoardId : null) + '_' +
            tableType + '_';
    }
}

angular.module('product.preLoading.resource.service', [
    'product.preLoading.resource.init.service'
])
.service('PreloadingResourceService', PreloadingResourceService);
PreloadingResourceService.$inject = ['PreloadingResourceInitService'];
function PreloadingResourceService(PreloadingResourceInitService ) {

    return function (objectService, params) {
        //console.log('PreloadingResourceService constr');
        var _this = this;
        _this.tableParamsColsInit = ['companyId', 'productId'];
        _this.Ops = {
            Create: 'Create',
            Edit: 'Edit',
            Remove: 'Remove',
            Archive: 'Archive',
            Activate: 'Activate'
        };

        _this.service = PreloadingResourceInitService;
        _this.objectService = objectService;

        if (_this.objectService.listField) {
            _this.listField = objectService.listField;
        }
        _this.getObjectService = getObjectService;
        _this.getCollection = getCollection;

        _this.table = getTableName();

        if (params) {
            for (var prop in params) {
                _this[prop] = params[prop];
            }
        }

        if(!_this.tableType) {
            _this.tableType = getTableType();
        }

        _this.insertItem = insertItem;
        _this.updateItem = updateItem;
        _this.removeItem = removeItem;
        _this.modify = modify;

        _this.insertMany = insertMany;
        _this.updateMany = updateMany;
        _this.removeManyIds = removeManyIds;
        _this.removeMany = removeMany;

        _this.getById = getById;
        _this.getPreById = getPreById;
        _this.getList = getList;
        _this.getObjectList = getObjectList;
        _this.getListIds = getListIds;
        _this.sortList = sortList;
        _this.getListCount = getListCount;
        _this.getListByType = getListByType;
        _this.processTableUpdates = processTableUpdates;

        _this.loadTableTask = loadTableTask;
        _this.getLoadTableTaskParams = getLoadTableTaskParams;
        _this.initTable = initTable;


        //wrapper for object service class
        _this.clipboardProcessing = clipboardProcessing;

        _this.onTreeNodeDuplicated = onTreeNodeDuplicated;
        _this.onTreeNodeAdded = onTreeNodeAdded;
        _this.onTreeNodeUpdated = onTreeNodeUpdated;
        _this.onTreeNodeRemoved = onTreeNodeRemoved;
        _this.onTreeNodeArchived = onTreeNodeArchived;
        _this.onTreeNodeActivated = onTreeNodeActivated;
        _this.processUpdateInfo = processUpdateInfo;

        return _this;

        function processUpdateInfo(tableParams, result, op) {
            if (result) {
                if (result.item) {
                    _this.modify(tableParams, result.item, op);
                }
                if (result.added && result.added.length > 0) {
                    _.each(result.added, function (item) {
                        _this.modify(tableParams, item, _this.Ops.Create);
                    });
                }
                if (result.updates) {
                    _this.updateMany(tableParams, result.updates);
                }
            }
        }
        function onTreeNodeDuplicated(tableParams, result) {
            processUpdateInfo(tableParams, result, _this.Ops.Create);
        }

        function onTreeNodeAdded(tableParams, result) {
            processUpdateInfo(tableParams, result, _this.Ops.Create);
        }

        function onTreeNodeUpdated(tableParams, result) {
            processUpdateInfo(tableParams, result, _this.Ops.Edit);
        }

        function onTreeNodeArchived(tableParams, result) {
            processUpdateInfo(tableParams, result, _this.Ops.Archive);
        }
        function onTreeNodeActivated(tableParams, result) {
            processUpdateInfo(tableParams, result, _this.Ops.Activate);
        }
        function onTreeNodeRemoved(tableParams, result, childListField) {
            var ids = result.removed;
            if (ids) {
                _this.removeManyIds(tableParams, ids);
            }

            //todo recursion for folders with lists
            //remove all included folders
            //add removed to ids

            //remove all children
            var child = _this.service.childService;
            if (child && !result.ungroup) {
                var childIdsCount = child.getListIds(tableParams, function (item) {
                    return ids.indexOf(item[childListField ? childListField : child.listField]) !== -1;
                }, null, true);
                if (childIdsCount > 0) {
                    child.removeManyIds(tableParams, ids);
                }
            }
        }

        function clipboardProcessing(params, onsuccess, onerror) {
            _this.getObjectService().clipboardProcessing(params, function (result) {
                //update some cached
            }, onerror);
        }

        function modify(tableParams, item, actionType, changedFields) {
            //console.log('modify cache ' + actionType + ' ' + item._id);
            switch (actionType) {
                case _this.Ops.Create:
                    return _this.insertItem(tableParams, item);

                case _this.Ops.Edit:
                case _this.Ops.Archive:
                case _this.Ops.Activate:
                    var updates = {_id: item._id},
                        edit;
                    if (actionType === _this.Ops.Edit) {
                        var service = _this.getObjectService();
                        if (!changedFields) {
                            changedFields = service.getChangedFieldForUpdate();
                        }
                        var data = service.getChangesForced(changedFields, item);
                        if(data){
                            updates = _.extend(updates, data);
                            edit = true;
                        }
                    } else {
                        updates.active = actionType === _this.Ops.Activate;
                        edit = true;
                    }
                    return edit ? _this.updateItem(tableParams, updates) : null;

                case _this.Ops.Remove:
                    return _this.removeItem(tableParams, item);

                default:
                    return null;
            }
        }
        function sortList(list, orderProp) {
            return _this.service.sortList(list, orderProp);
        }

        function getObjectService() {
            return _this.objectService;
        }

        function insertItem(tableParams, el) {
            return insertMany(tableParams, [el])[0];
        }

        function updateItem(tableParams, el) {
            return _this.service.updateItem(tableParams, _this.tableType, el);
        }

        function removeItem(tableParams, el) {
            return removeMany(tableParams, [el])[0];
        }

        function insertMany(tableParams, list) {
            if(list && list.length>0){
                var l = _this.service.insertMany(tableParams, _this.tableType, list.map(_this.objectService.convertResourceSimple));
                return list.map(_this.objectService.convertResource);
            }
            return null;
        }

        function updateMany(tableParams, updates) {
            return _this.service.updateMany(tableParams, _this.tableType, updates);
        }

        function removeManyIds(tableParams, listIds) {
            return _this.service.removeManyIds(tableParams, _this.tableType, listIds);
        }

        function removeMany(tableParams, list) {
            return _this.service.removeMany(tableParams, _this.tableType, list);
        }

        function getPreById(tableParams, id, settings) {
            return _this.service.getObjectById(tableParams, _this.tableType, id, settings);
        }

        function getById(tableParams, id, settings) {
            return _this.getPreById(tableParams, id, settings);
        }

        function getListIds(tableParams, query, orderProp) {
            return _this.service.getListIds(tableParams, _this.tableType, query, orderProp);
        }

        function getListByType(tableParams, type, listId, groupFiltersInit, groupOrder, groupPopulate, listField) {
            var _this = this;
            var groupFilters = groupFiltersInit ? _.clone(groupFiltersInit) : {};
            if (_this.service) {
                if(!listField){listField = _this.listField;}
                if(listField && listId !== undefined) {
                    if(!groupFilters){groupFilters = {};}
                    groupFilters[listField] = listId;
                }
                if (!groupOrder) {
                    groupOrder = {};
                    groupOrder['order'] = 1;
                }
                if(groupFilters && typeof(_this.advancedGroupFilters) === 'function'){
                    groupFilters = _this.advancedGroupFilters(groupFilters, type, tableParams);
                }

                //console.log('getListByType: listId:' + listId + '; childListField: ' + listField + '; groupFilters');
                //console.log(groupFilters);

                //type =  'getListCount' : 'getList'  'getListCount' : 'getObjectList'
                return _this[type](tableParams, groupFilters, groupOrder, groupPopulate);
            }
            return type === 'getListCount' ? 0 : null;
        }

        function getListCount(tableParams, groupFilters, orderProp) {
            return _this.service.getListCount(tableParams, _this.tableType, groupFilters, orderProp);
        }

        function getList(tableParams, query, orderProp, populate) {
            return getObjectList1(_this, tableParams, query, orderProp, populate, false);
        }

        function getObjectList(tableParams, query, orderProp, populate) {
            //  console.log('PreloadingResourceService.getList ' +_this.tableType + ' ' + getSBTimestamp());
            return getObjectList1(_this, tableParams, query, orderProp, populate, true);
        }

        function getObjectList1(_this, tableParams, query, orderProp, populate, withResourceObject) {
            return _this.service.getList(tableParams, _this.tableType, query, orderProp, populate, withResourceObject ? function (item) {
                if(!item){return null;}
                //console.log('PreloadingResourceService.processItem ');// + getSBTimestamp());
                return _this.objectService.convertResource(typeof(_this.preprocessForList) === 'function' ? _this.preprocessForList(item, {populate: populate, tableParams: tableParams}) : item);
            } : null);
        }

        function loadTableTask(params) {
            var task = {},
                withoutResourceObject = false;
            task[_this.getCollection()] = function (callback) {
                var s = _this.getObjectService(),
                    method = (typeof (s.getAllForPreloading) === 'function') ? s.getAllForPreloading : s.getAll;
                method(params, null, _this.preloadPopulate ? _this.preloadPopulate : null, function (result) {
                    callback(null, result);
                }, callback, withoutResourceObject);
            };
            return task;
        }

        function getLoadTableTaskParams(params) {
            return params;
        }

        function getCollectionFromService() {
            return _this.getObjectService().collectionName;
        }

        function getCollectionTypeFromService() {
            return _this.getObjectService().collectionType;
        }

        function getTableName() {
            var name = getCollectionFromService();
            if (name.substring(name.length - 3, 3) === 'ies') {
                return name.substring(0, name.length - 3) + 'y';
            }
            switch (name) {
                case 'team':
                case 'cast':
                    return name;
                default:
                    return name.substring(0, name.length - 1);
            }
        }

        function getTableType() {
            var name = getCollectionTypeFromService();
            return name.substring(0, 1).toUpperCase() + name.substring(1, name.length);
        }

        function getCollection() {
            var name = _this.table;
            if (name[name.length - 1] === 'y') {
                return name.substring(0, name.length - 1) + 'ies';
            }
            switch (name) {
                case 'team':
                case 'cast':
                    return name;
                default:
                    return name + 's';
            }
        }

        function processTableUpdates(tableParams, updates) {
            if (updates) {
                _.each(['add', 'del', 'archive', 'activate', 'set'], function (prop1) {
                    var info = updates[prop1];
                    if (info) {
                        switch (prop1) {
                            case 'add':
                                _.each(info, function (item) {
                                    _this.insertItem(tableParams, item);
                                });
                                break;

                            case 'del':
                                _this.removeManyIds(tableParams, info);
                                break;

                            case 'archive':
                            case 'activate':
                                _.each(info, function (id) {
                                    _this.updateItem(tableParams, _.extend({_id: id}, {
                                        active: !(prop1 === 'archive')
                                    }));
                                });
                                break;

                            case 'set':
                                for (var id in info) {
                                    var item = info[id];
                                    if (item) {
                                        _this.updateItem(tableParams, _.extend({_id: id}, item));
                                    }
                                }
                                break;
                        }
                    }
                });
            }
        }

        function initTable(tableParams, list) {
            if(list && list.length>0) {
                return _this.service.initTable(tableParams, _this.tableType, list.map(_this.objectService.convertResourceSimple));
            }
        }
    }
}

angular.module('product.print.page.controller.service', [
    'product.print.page.popup.component',
    'product.print.sidebar.component',
    'product.print.coverpage.component',
    'service.scriptConvert',
    'services.downloadExport',
    'services.blocksSetup',
    'service.scriptConvert',
    'services.layoutConfigsService',
    'sb.fields.types.service'
])
.service('PagePrintCtrlService', PagePrintCtrlService);
PagePrintCtrlService.$inject = ['$q', 'DownloadExportService', 'BlocksSetupService', 'ScriptConvertService', 'SBFieldTypesService'];
function PagePrintCtrlService($q, DownloadExportService, BlocksSetupService, ScriptConvertService, SBFieldTypesService) {
  return function($ctrl, $element){
    console.log('PagePrintCtrlService');
      $ctrl.ScriptConvertService = ScriptConvertService;
      $ctrl.BlocksSetupService = BlocksSetupService;
      $ctrl.DownloadExportService = DownloadExportService;
      $ctrl.SBFieldTypesService = SBFieldTypesService;

      $ctrl.PrintingFormat = PrintingFormat;

      var isDebug = false,//;$ctrl.LCS.API_CONFIGS.debugger && $ctrl.LCS.API_CONFIGS.debugger.enabled && $ctrl.LCS.API_CONFIGS.debugger.isDev,
            fitWindow = false, //used if to scale
            unit = 'mm',
            timer,
            fontSizeMin = 7,
            delayTimeout = 20,//> delayTimeout from sb editor which is 210 by default
            gridGapPX = 10,
            offsetbottomPx =  gridGapPX + 10,
            betweenpagesPX = 20,
            pageBreakAfterCls = 'page-break-after',
            observerOptions = {
                childList: true,
                subtree: true
            };
      $ctrl.treeNodeClass= '.tree-node.tree-node-content';
      $ctrl.headerCls = 'header-info';
      $ctrl.footerCls = 'bottompage';
      $ctrl.pagesCls = 'pageTotal';

      $ctrl.isGridItemLoaded = {};
      $ctrl.printTableCls = 'printtable';

      $ctrl.isPrintLayout  = true;
      $ctrl.withSidebarRight = true;
      $ctrl.hideSidebar = true;
      $ctrl.withoutTopFilters = true;
      $ctrl.preChangeColumn = preChangeColumn;
      $ctrl.download = download;
      $ctrl.getScriptInfo = getScriptInfo;
      $ctrl.getSidebarRight = getSidebarRight;
      $ctrl.getPageTemplate = getPageTemplate;
      $ctrl.closePopup = closePopup;

      if(typeof($ctrl.onPageLoaded) === 'function') {
          $ctrl.onPageLoadedOther = onPageLoaded;
      }else {
          $ctrl.onPageLoaded = onPageLoaded;
      }

      $ctrl.getHeader = getHeader;

      if(!$ctrl.getHeaderTitle){
          $ctrl.getHeaderTitle = getHeaderTitle;
      }

      $ctrl.onSidebarChanges = onSidebarChanges;

      $ctrl.getCompanyInfo = getCompanyInfo;

      $ctrl.onInitPagePrint = onInitPagePrint;

      $ctrl.onDestroy = onDestroy;

      addClass(true);

      return $ctrl;

      function addClass(isBind){
          $ctrl.LCS[isBind ? 'addClass' : 'removeClass']($ctrl.LCS.bodyElement, 'print-modal-open');
      }
      function processGroups(m){
          if ($ctrl.groups) {
              for(var id in $ctrl.groups){
                  m($ctrl.groups[id]);
              }
          }
      }

      function onDestroy(){
          addClass(false);

          processGroups(function (group){
              if(group && group.observer) {
                  group.observer.disconnect();
              }
          });
      }

      function resetGrids() {
          console.log('resetGrids');
          $ctrl.selectedListsIds = {};
          if($ctrl.selectedParams.isItemsOnly) { //breakdowns
              processList(null);
          } else {
              var exists = $ctrl.selectedParams.lists && $ctrl.selectedParams.lists.length > 0;
              if (!exists && $ctrl.CPS.SBStateService.getCurrentStateName().indexOf('print') === -1 &&
                  !($ctrl.selectedParams.items && $ctrl.selectedParams.items.length > 0)) {//print page with no items and no lists
                  if($ctrl.listTreeService) {
                      $ctrl.selectedParams.lists = $ctrl.listTreeService.active && $ctrl.listTreeService.active.selectedList ? $ctrl.listTreeService.active.selectedList.nodes.map(function (n) {
                          return n._id;
                      }) : null;
                  }
                  exists = hasLists();
              }

              if (exists) {
                  _.each($ctrl.selectedParams.lists, processList);
              }
          }

          function processList(id) {
                  $ctrl.isGridItemLoaded[id] = false;
                  setListLoaded(id, false);
          }
      }

      function hasLists() {
          return $ctrl.selectedParams.lists && $ctrl.selectedParams.lists.length > 0;
      }

      function gridLoaded(id) {
          setListLoaded(id, true);

          var loaded = true;
          for (var prop in $ctrl.selectedListsIds) {
              if (!$ctrl.selectedListsIds[prop]) {
                  loaded = false;
                  break;
              }
          }
          return loaded;
      }

      function setListLoaded(id, val){
          $ctrl.selectedListsIds['g_' + id] = val;
      }

      function closePopup(result, id){
          if($ctrl.printPageParams && $ctrl.printPageParams.onClose) {
              $ctrl.printPageParams.onClose({result: result, id: id});
          }
      }

      function checkGridView(view){
          return view === 3;
      }

      function onInitPagePrint() {
          console.log('PagePrintCtrlService.$onInit');
          if($ctrl.listTreeService) {
              $ctrl.listTreeService.inTransition = false;
          }
          var p = {
              canEdit: false,
              withoutTopFilters: $ctrl.withoutTopFilters,
              isPrintLayout: $ctrl.isPrintLayout,
              hideSidebar: $ctrl.hideSidebar,
              has2Sidebars: false,
              withGridView: true
          };

          if(!$ctrl.selectedParams){
              $ctrl.selectedParams = {};
          }

          if ($ctrl.selectedParams.lists && $ctrl.selectedParams.lists.length > 0) {
              p.printedLists = $ctrl.selectedParams.lists;
          }

          if ($ctrl.selectedParams.items) {
              p.printedItems = $ctrl.selectedParams.items;
          }

          resetGrids();

          if($ctrl.selectedParams.initPrintOptions) {
              p.initPrintOptions = $ctrl.selectedParams.initPrintOptions;
          }
          if (!$ctrl.printPageParams) {
              $ctrl.printPageParams = $ctrl.printPageParamsInit;
          }
          if (!$ctrl.printPageParams.constantsService) {
              $ctrl.printPageParams.constantsService = {};
          }
          $ctrl.printPageParams.constantsService.CompOptions = _.extend({}, $ctrl.printPageParams.constantsService.CompOptions, p);

          if(typeof($ctrl.getOtherPrintPageParams) === 'function') {
              $ctrl.printPageParams = _.extend($ctrl.printPageParams, $ctrl.getOtherPrintPageParams());
          }
          /*if(selectedParams) {
              if (selectedParams.lists) {
                  $ctrl.lists = selectedParams.lists.map(function (id) {
                      var l = $ctrl.listTreeService.getNodeById(id);
                      if(selectedParams.items && selectedParams.items[id]){
                        //  selectedParams.items[id]
                      }
                      //l.values =
                      return l;
                  });
              }
              if (selectedParams.items) {
                  $ctrl.items = selectedParams.items;
              }
          }*/

          $ctrl = new $ctrl.printPageParams.pageCtrlService($ctrl, $element, $ctrl.printPageParams);

          setOptionsStr();
          setItemValue($ctrl.item);

          setStyleGAndWait(next);

          function next() {
               if ($ctrl.onInitOther) {
                  $ctrl.onInitOther();
              }
              $ctrl.addRootWatcher('LIST_FILTERS_COLUMNS' + getPrefix() + '_' + $ctrl.elemType, onColumnsChanged);

              $ctrl.addRootWatcher('GRID_ITEM_PRINT_LOADED', function (result){
                  //console.log('GRID_ITEM_PRINT_LOADED ' + result._id);
                  onGridItemLoaded(result.el);
              });

              $ctrl.addRootWatcher('GRID_PRINT_ITEMS_LOADED', function (currentListId){
                  //console.log('GRID_PRINT_ITEMS_LOADED' + currentListId);
                  onGridItemsLoaded(currentListId);
              });

              $ctrl.addRootWatcher('GRID_PRINT_LOADED_INIT', function (currentListId){
                  //console.log('GRID_PRINT_LOADED_INIT' + currentListId);
                  onGridLoadedInit(currentListId);
              });
          }

          function setOptionsStr(){
              //console.log('setOptionsStr');

              var options = $ctrl.printPageParams && $ctrl.printPageParams.pageOptions ? $ctrl.printPageParams.pageOptions : null,
                  filtersService = null;
              if($ctrl.listTreeService){
                  filtersService = $ctrl.listTreeService.filtersService;
                  if(options){
                      filtersService.setOptions(options);
                      $ctrl.listTreeService.options = options;
                  }
              }

              options = filtersService ? (filtersService.options || filtersService.Options) : null;

              var view = options && options.view ? options.view : 2,
                  ratio = $ctrl.isMasonary ? 15 : (options && options.ratio ? parseInt(options.ratio, 10) : 1),
                  type = options && options.type ? parseInt(options.type, 10) : 1,
                  isGridView = checkGridView(view),
                  showPageBreakAfterList = false; //hasLists()
var defaultC = 3;
              $ctrl.item = {
                  showViewModes: options && options.showPrintViewModes,
                  view: view, //3 is grid and 2 is list
                  ratio: ratio,
                  type: type,
                  hideGridSettings: options && options.hidePrintGridSettings,

                  column: options ? (options.printColumn ? parseInt(options.printColumn, 10) : (options.column ? parseInt(options.column, 10) : defaultC)) : defaultC,
                  dontExpandGridSettings: options && options.dontExpandPrintGridSettings,

                  showGroupHeadersOnTopOfPage: !isGridView,

                  fontSize: options && options.printFontSize ? parseInt(options.printFontSize, 10) : 12,
                  hideFontSizes: options && options.hidePrintFontSizes,

                  isColor: true,

                  defaultBgColor: '#FFFFFF',
                  showBgColor: options && options.showPrintBgColor !== undefined ? options.showPrintBgColor : isGridView,


                  defaultBgCardColor: $ctrl.isMasonary ? '#F2F2F2' : 'transparent',
                  showBgCardColor: options && options.showPrintBgCardColor !== undefined ? options.showPrintBgCardColor : isGridView,

                  defaultFontColor: '#000000',
                  showFontColor: options && options.showPrintFontColor !== undefined ? options.showPrintFontColor : isGridView,

                  defaultBorderColor: $ctrl.isMasonary ? '#F2F2F2' : '#000000',
                  showBorderColor: options && options.showPrintBorderColor !== undefined ? options.showPrintBorderColor : isGridView,

                  itemsBorder: true,
                  showBorders: options && options.showPrintBorders,

                  withIcons: true,
                  showIcons: options && options.showPrintIcons,

                  groupHeadersOnTopOfPage: false,

                  withPageNumbers: true,

                  showPageBreakAfterList: showPageBreakAfterList,
                  withPageBreakAfterList: true,

                  orientation: options && options.orientation || 'portrait',
                  format: 'letter',
                  pageMargins: 1,
                  columnMargins: 0,
                  withHeader: true,

                  scale: 1,
                  emulateMediaType: 'print',
                  gridGap: options && options.printGridGap !== undefined ? options.printGridGap : gridGapPX
                  /*leaftHeader: null,
                  rightHeader: null,
                  watermark: null,
                  filename: null,
                  password: null*/
              };

              setWatermarkText();

              if(!$ctrl.item.bgColor) {
                  $ctrl.item.bgColor = $ctrl.item.defaultBgColor;
              }
              if(!$ctrl.item.bgCardColor) {
                  $ctrl.item.bgCardColor = $ctrl.item.defaultBgCardColor;
              }
              if(!$ctrl.item.borderColor) {
                  $ctrl.item.borderColor = $ctrl.item.defaultBorderColor;
              }
              if(!$ctrl.item.fontColor) {
                  $ctrl.item.fontColor = $ctrl.item.defaultFontColor;
              }

              _.each(['FrontCover', 'BackCover'], function (prop){
                  setCoverInfo(prop, false);
              });

              setGridViewInfo();

              setFonts($ctrl.item.column);

              $ctrl.item = setDefaultMargins($ctrl.item, _.find($ctrl.PrintingFormat, {id: $ctrl.item.format}));

              if($ctrl.printPageParams.otherItem) {
                  $ctrl.item = _.extend($ctrl.item, $ctrl.printPageParams.otherItem);
              }

              if($ctrl.initPrintOptions) {
                  $ctrl.item = _.extend($ctrl.item, $ctrl.initPrintOptions);
              }

              if(filtersService && filtersService.listCols) {
                  $ctrl.item.columns = filtersService.listCols.map(function (c){return c.id;});
              }

              var options1 = _.extend({}, $ctrl.item);
              $ctrl.filtersService.setOptions(options1);
              if($ctrl.listTreeService) {
                  $ctrl.listTreeService.filtersService = filtersService;
                  $ctrl.listTreeService.options = options1;
              }
              $ctrl.optionsStr = JSON.stringify($ctrl.item);
          }
      }

      function setWatermarkText(){
          $ctrl.item.watermark =  $ctrl.CPS.hasQuotaType('pdfBuilder') ? '' : 'StudioBinder Trial';
      }

      function getPrefix(){
          return '_PRINT_LAYOUT';
      }

      function onGridLoadedInit(currentListId, columnsChanged){
          //console.log('onGridLoadedInit:' + currentListId);
          if (!$ctrl.isGridItemLoaded[currentListId]) {
              setRecompute(true);
              $ctrl.colsW = {}; $ctrl.colsWPrefront = 0;
             var headers = $ctrl.element.querySelectorAll('.row-schedule.header');
             _.each(headers, function (header, j) {
                 var cols = _.filter(header.children, function (c) {
                     return !$ctrl.LCS.hasClass(c, 'sb-hide') &&
                         !$ctrl.LCS.hasClass(c, 'ng-hide') &&
                         !$ctrl.LCS.hasClass(c, 'hide-print')//status col on shotlist
                         //&& !$ctrl.LCS.hasClass(c, 'prefront')
                         ;
                 });
                 //set class for h
                 var index = 1, l = cols.length, noG = true;
                 _.each(cols, function (c, i) {
                     //prefront
                      if($ctrl.LCS.hasClass(c, 'prefront')){
                         $ctrl.colsWPrefront += c.offsetWidth || parseInt(window.getComputedStyle(c, null).width, 10);
                     }

                     if (columnsChanged) {
                         c.className = c.className.replace(/ rc_.*/g, '');
                     }
                     var id = c.getAttribute('print-id');
                     c.printId = id;
                     c.index = index;
                     $ctrl.LCS.addClass(c, getColCls(getColId(id)));

                     if (j === 0) {
                         if (c.className.indexOf('grow-column') !== -1) {
                             noG = false;
                         }

                           setDefaultCol(c, noG && i === l - 1);
                     }

                     index++;
                 });
             });

              $ctrl.isGridItemLoaded[currentListId] = true;
          }
      }

      function onGridItemLoaded(cols) {
          //console.log('onGridItemLoaded:');
          if ($ctrl.columnsChanged) {
              if ($ctrl.isGridItemLoaded) {
                  for (var listId in $ctrl.isGridItemLoaded) {
                      onGridLoadedInit(listId, $ctrl.columnsChanged);
                  }
                  setColW(false, cols, false);
              }
              $ctrl.columnsChanged = false;
          }
      }

      function onGridItemsLoaded(currentListId) {
          //console.log('onGridItemsLoaded:' + currentListId);
          if (gridLoaded(currentListId)) {
              //ifPredef params in receiving data from server
              setCSSParams({
                  force: true,
                  item: $ctrl.item
              });
          }
      }

      function onPageLoaded() {
          //console.log('onPageLoaded');
          if ($ctrl.allInfoLoaded) {
              //see if nec
              /*setItemValue($ctrl.item);
              //make sidebar disabled while processing
              $ctrl.sidebarDisabled = true;
              setStyleGAndWait(function (){
                  $ctrl.sidebarDisabled = false;
              });*/

              var withRepeat = true;
              loadGroups(withRepeat);
          }

          function loadGroups(withRepeat) {
              if (withRepeat) {
                  return;
              }
              var el = $ctrl.element.querySelector('.' + $ctrl.wrapperGroupsCls),
                  isFullHeight = true;
              if (el) {
                  $ctrl.LCS.appendChildFragment(el, $ctrl.getGroupsContent(false, isFullHeight), true);

                  if ($ctrl.listTreeService) {
                      $ctrl.listTreeService.inTransition = false;

                      if ($ctrl.listTreeService.active && $ctrl.listTreeService.active.selectedList && $ctrl.listTreeService.active.selectedList.nodes) {
                          _.each($ctrl.listTreeService.active.selectedList.nodes, function (list) {
                              broadcastTreeListChanged(list, 'PagePrintCtrlService.onPageLoaded');
                          });
                      }
                  }
              }
          }
      }

      function broadcastTreeListChanged(list, from){
          $ctrl.CurrentTreeListService.broadcastTreeListChanged(getTreeChangedParams(), $ctrl.elemType, list, from);

          function getTreeChangedParams() {
              return {
                  isCommentsSidebar: $ctrl.isCommentsSidebar,
                  isPrintLayout: $ctrl.isPrintLayout,
                  isInTreeModal: $ctrl.isInTreeModal
              }
          }
      }

      function setDefaultMargins(item, f) {
          _.each(['Top', 'Bottom', 'Left', 'Right'], function (m) {
              var prop = 'margin' + m;
              if (!item['withCustomMargin' + m]) {
                  item[prop] = f['m' + m[0]]; //margin in mm
              }
          });
          return item;
      }

      function setItemValue(item) {
          $ctrl.item = process();

          function process() {
              var f = _.find(PrintingFormat, {id: item.format}),
                  o = item.orientation,
                  m = item.pageMargins;

              item.f = f;
              item.viewportSize = _.extend({}, f, {
                  w: o === 'portrait' ? f.w : f.h,
                  h: o === 'portrait' ? f.h : f.w
              }, m === 0 ? {mT: 0, mR: 0, mB: 0, mL: 0} :
                  (m === 1 ? {mT: f.mT, mR: f.mR, mB: f.mB, mL: f.mL} : null));

              item = setDefaultMargins(item, f);

              //work with height in pixels. easy to compute
              item.remainingHPX = getMMinPx(item.viewportSize.h - item.marginTop - item.marginBottom) -
                  (checkGridView($ctrl.item.view) ? 0 : offsetbottomPx);//FOR GRID ACCOUNT FOR LAST BORDER BOTTOM FOR A ROW

              item.viewportSize.maxWMM = item.viewportSize.w - item.marginRight - item.marginLeft;
              item.viewportSize.maxWPX = mmToPx(item.viewportSize.maxWMM);
              return item;
          }
      }

      function hasColumns() {
          return checkGridView($ctrl.item.view) && $ctrl.item.column > 1;
      }

