.config(TeamInviteRouting);

TeamInviteRouting.$inject = ['$uiRouterProvider'];
function TeamInviteRouting($uiRouter) {
    var url = 'team-invite/:invitationId';
    addStates($uiRouter, [{
        name: 'public.team-invite',
        url: url,
        data: {
            bodyClass: 'team-invite no-sidebar',
            title: 'Accept Team Invite'
        },
        views: {
            publicview: 'teamInvitePage'
        },
    }, {
        name: 'user.team-invite',
        url: '/' + url,
        data: {
            bodyClass: 'team-invite no-sidebar',
            title: 'Accept Team Invite'
        },
        views: {
            loggedview: 'teamInvitePage'
        }
    }]);
}

