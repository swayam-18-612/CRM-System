                                // toggle on/off authorship colors
                                commentObj_1.enable(!commentObj_1.isEnabled);
                                if (commentsClick) {
                                    commentsClick();
                                }
                            });
                            var addCommentBtn = document.querySelector('button.ql-comments-add');
                            LCS.bindElementListeners(true, addCommentBtn, function () {
                                range = quill.getSelection();
                                // nothing is selected
                                if (!range || range.length === 0) {
                                    commentAddClick(null);
                                    return;
                                }
                                commentAddClick(addComment);
