function getDayColor(id, hide) {
    return id ? {text: 'rgba(0,0,0,0.75)', border: 'rgba(0,0,0,0.09)', cls: 'isday',
        id: id, hide: hide} : null;
}

function getNightColor(id, hide) {
    return id ? {text: "#fff", border: 'rgba(255,255,255,0.3)', cls: 'isnight',
        id: id, hide: hide} : null;
}

