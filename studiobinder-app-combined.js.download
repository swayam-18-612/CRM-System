angular.module('gantt.smartEvent.factory', [])
    .factory('ganttSmartEvent', ganttSmartEventFactory);
function ganttSmartEventFactory() {
    // Auto released the binding when the scope is destroyed. Use if an event is registered on another element than the scope.

    function smartEvent($scope, $element, event, fn) {
        $scope.$on('$destroy', function() {
            $element.unbind(event, fn);
        });

        return {
            bindOnce: function() {
                $element.one(event, fn);
            },
            bind: function() {
                $element.bind(event, fn);
            },
            unbind: function() {
                $element.unbind(event, fn);
            }
        };
    }

    return smartEvent;
}
angular.module('gantt.sortable.directive', [
    'ang-drag-drop'
])
.directive('ganttSortable', ganttSortableDirective);
ganttSortableDirective.$inject = ['ganttUtils', '$compile'];

// Provides the row sort functionality to any Gantt row
// Uses the sortableState to share the current row
function ganttSortableDirective(utils, $compile) {
    return {
        restrict: 'E',
        require: '^gantt',
        scope: {
            enabled: '=?'
        },
        link: function(scope, element, attrs, ganttCtrl) {
            var api = ganttCtrl.gantt.api;

            // Load options from global options attribute.
            if (scope.options && typeof(scope.options.sortable) === 'object') {
                for (var option in scope.options.sortable) {
                    scope[option] = scope.options.sortable[option];
                }
            }

            if (scope.enabled === undefined) {
                scope.enabled = true;
            }

            api.directives.on.new(scope, function(directiveName, rowScope, rowElement) {
                if (directiveName === 'ganttRowLabel'){
                    if (rowElement.attr('drag') === undefined){
                        rowScope.checkDraggable = function () {
                            var rowSortable = rowScope.row.model.sortable;

                            if (typeof(rowSortable) === 'boolean') {
                                rowSortable = {enabled: rowSortable};
                            }

                            return utils.firstProperty([rowSortable], 'enabled', scope.enabled);
                        };

                        rowScope.dropChannels = function () {
                            var model = rowScope.row.model;
                            var channels = model.dropChannels;
                            //milestone can accept group if has no parent
                            if(model.data && model.data.type === 4 && !model.data.parentId)channels +=',group';
                            return channels;
                        };

                        rowScope.dragChannel = function () {
                            return rowScope.row.model.dragChannel;
                        };

                        rowScope.onDropSuccess = function ($event, index) {
                            rowScope.$evalAsync();
                        };

                        rowScope.onDropFailure = function ($event, index, array) {
                            rowScope.$evalAsync();
                        };

                        var RowTypes = {Product:1, Group:3, Milestone:4};
                        rowScope.onDrop = function (e, rowId) {
                            //row where the moving happens

                            var row = rowScope.row.rowsManager.rowsMap[rowId];
                            if (row !== rowScope) {
                           /* //call the ondrop method from the row
                             row.model.onDrop(row.model, rowScope.row.model, function(updates){
                                    rowScope.row.rowsManager.moveRow(row, rowScope.row, updates);
                                    rowScope.$evalAsync();
                                });*/
                                rowScope.row.rowsManager.moveRow(row, rowScope.row, e.shiftKey);
                                rowScope.$evalAsync();
                            }
                        };

                        /* rowScope.dropValidateHandler = function ($drop, $event, $data) {
                        dont allow moving them between products

                             if ($data === 'Mike (Locked)') {
                                 return false;
                             }
                             if ($drop.element[0] === $event.srcElement.parentNode) {
                                 // Don't allow moving to same container
                                 return false;
                             }
                             return true;
                         };*/

                        //handles the droppings
                        rowElement.attr('drop-channel', '{{dropChannels()}}');
                        rowElement.attr('ui-on-drop', 'onDrop($event, $data.id)');
                        //rowElement.attr('drop-validate', 'dropValidateHandler($drop, $event, $data)');

                        //handles the drag
                        rowElement.attr('ui-draggable', '{{checkDraggable()}}');
                        rowElement.attr('on-drop-success', 'onDropSuccess($event, $index)');
                        rowElement.attr('on-drop-failure', 'onDropFailure($event, $index)');
                        rowElement.attr('drag-channel', '{{dragChannel()}}');

                        rowElement.attr('drag', 'row.model');

                        $compile(rowElement)(rowScope);
                    }
                }
            });
        }
    };
}

angular.module('gantt.task.directive', [])
    .directive('ganttTask',ganttTaskDirective);
ganttTaskDirective.$inject = ['GanttDirectiveBuilder', 'GanttMoment'];
function ganttTaskDirective(Builder, GanttMoment) {

    var builder = new Builder('ganttTask');
    builder.controller = function($scope, $element) {
        $scope.task.$element = $element;
        $scope.task.$scope = $scope;

        $scope.getTaskContent = function() {
            if ($scope.task.model.content !== undefined) {
                return $scope.task.model.content;
            }
            return $scope.task.rowsManager.gantt.options.value('taskContent');
        };

        $scope.simplifyMoment = GanttMoment.simplifyMoment;

        $scope.$watchGroup(['simplifyMoment(task.model.from)', 'simplifyMoment(task.model.to)'], function() {
            $scope.task.updatePosAndSize();
        });
    };
    return builder.build();
}
angular.module('gantt.task.factory', [])
    .factory('GanttTask',GanttTaskFactory);
GanttTaskFactory.$inject = ['GanttMoment'];
function GanttTaskFactory(GanttMoment) {
    var Task = function(row, model) {
        this.rowsManager = row.rowsManager;
        this.row = row;
