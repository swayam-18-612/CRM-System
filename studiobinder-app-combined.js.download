CallsheetPageEditCtrl.$inject = ['CallsheetsService', 'CallsheetInitActionsCtrlService', 'CallsheetPageEditCtrlService', '$element'];
function CallsheetPageEditCtrl(CallsheetsService, CallsheetInitActionsCtrlService, CallsheetPageEditCtrlService, $element) {
    console.log('CallsheetPageEditCtrl');
    var $ctrl = this;
    $ctrl.CallsheetsService = CallsheetsService;

    $ctrl.btnTopSendCls = 'btnTopSend';

    $ctrl.getBtnText = getBtnText;
    $ctrl.uiOnParamsChanged = uiOnParamsChanged;
    $ctrl.onInitPageEdit = onInitPageEdit;
    $ctrl.getPageTemplate = getPageTemplate;
    $ctrl.onPageLoaded = onPageLoaded;
    $ctrl.onNext = onNext;

    $ctrl.onDestroy = onDestroy;

    $ctrl = new CallsheetInitActionsCtrlService($ctrl);
    $ctrl = new CallsheetPageEditCtrlService($ctrl, $element);

    $ctrl.toggleCallsheetSidebar = $ctrl.LCS.toggleCallsheetSidebar;

    function onDestroy(){
        $ctrl.bindActions(false);
    }

    function onInitPageEdit() {
        $ctrl.mode = $ctrl.CPS.stateParams[$ctrl.modeField];
        $ctrl.bindActions(true);

        $ctrl.LCS.addClass($ctrl.element, 'callsheet-edit-page');
        $ctrl.divTopContent = $ctrl.element.querySelector('#divTopContent');
        $ctrl.initPage(angular.element($ctrl.divTopContent));
    }

    function uiOnParamsChanged(changedParams) {
        console.log('CallsheetPageEditCtrl.uiOnParamsChanged');
        if(changedParams) {
            var mode = changedParams[$ctrl.modeField];
            if (mode !== undefined && mode !== $ctrl.mode) {
                $ctrl.mode = mode;
                $ctrl.reloadCallheetPage();
            }
        }
    }

    function getPageTemplate() {
        switch ($ctrl.mode) {
            case $ctrl.Modes.Edit:
                $ctrl.isEditCallsheet = true;
                return '<callsheet-edit ' +
                'class="callsheet-edit side-table clearfix h-full" ' +
                'ng-class="{\'with-sidebar\':$ctrl.hasSidebar()}" ' +
                'pre-loading-service="::$ctrl.preLoadingService"' +
                '></callsheet-edit>';

            case $ctrl.Modes.Recipients:
                $ctrl.isEditCallsheet = false;
                return '<callsheet-recipients ' +
                'class="callsheet-recipients display-block clearfix h-full groups-tree-page with-tree with-printable-list" ' +
                'callsheet-id="::$ctrl.callsheetId" ' +
                'add-callsheet-recipients="$ctrl.addCallsheetRecipients(filterRole)" ' +
                'pre-loading-service="::$ctrl.preLoadingService" ' +
                '></callsheet-recipients>';

            case $ctrl.Modes.Preview:
                $ctrl.isEditCallsheet = false;
                return '<callsheet-view ' +
                'page-type="edit" ' +
                'class="with-filters-above" ' +
                'is-different-user="::false" ' +
                'show-more-menu-links="::$true" ' +
                'with-aproval="::true" ' +
                'get-counters="::false" ' +
                'view-inline-mode-buttons="::true" ' +
                'pre-loading-service="::$ctrl.preLoadingService" ' +
                '></callsheet-view>';
        }
    }

    function onPageLoaded() {
        bind(true);

        $ctrl.LCS.removeClass($ctrl.element.querySelectorAll('.topnavcallsheet li'), 'active');
        $ctrl.LCS.addClass($ctrl.element.querySelector('.topnavcallsheet li[data-mode="' + $ctrl.mode + '"]'), 'active');

        var el1 = $ctrl.element.querySelector('.' + $ctrl.btnTopSendCls);
        if (el1) {
            var el = el1.querySelector('.text');
            if (el) {
                var txt = getBtnText();
                el.innerText = txt;
                el.parentElement.setAttribute('analytics-action', txt);
            }
            el = el1.querySelector('.sbf');
            if (el) {
                $ctrl.LCS.replaceClass(el, $ctrl.mode === $ctrl.Modes.Preview ? 'show-ipad forward-arrow' : 'paper-plane', $ctrl.mode === $ctrl.Modes.Preview ? 'paper-plane' : 'show-ipad forward-arrow');
            }
        }

        var m = $ctrl.mode === $ctrl.Modes.Edit ? 'removeClass' : 'addClass';
        $ctrl.LCS[m]($ctrl.element.querySelector('.sidebar-toggle'), 'sb-hide');
        $ctrl.LCS[m]($ctrl.element.querySelector('.goBack'), 'sb-hide');

        if (typeof ($ctrl.onPageLoadedOther) === 'function') {
            $ctrl.onPageLoadedOther();
        }
    }

    function getBtnText(){
        return $ctrl.mode === $ctrl.Modes.Preview ? 'Send Call Sheet' : 'Next';
    }

    function bind(isBind) {
        if(isBind) {
            bind(false);
        }

        var cls = '.' + $ctrl.btnTopSendCls;
        if(!$ctrl.btnTopSend) {
            $ctrl.btnTopSend = $ctrl.element.querySelector(cls);
        }

        if(!$ctrl.btnTopSend) {
            var parent = $ctrl.LCS.findClosestParent($ctrl.element, '.callsheet-edit-page');
            if (parent) {
                $ctrl.btnTopSend = parent.querySelector(cls);
            }
        }

        $ctrl.LCS.bindElementsClick(isBind, $ctrl.btnTopSend, onNext);
    }

    function onNext(e) {
        switch ($ctrl.mode) {
            case $ctrl.Modes.Edit:
                $ctrl.goToRecipients(e); break;

            case $ctrl.Modes.Recipients:
                $ctrl.goToPreview(e); break;

            case $ctrl.Modes.Preview:
                $ctrl.goToSend(e);
                break;
        }
    }
}

angular.module('product.callsheet.page.edit.service', [
    'product.callsheet.page.init.controller.service'
])
.service('CallsheetPageEditCtrlService', CallsheetPageEditCtrlService);
CallsheetPageEditCtrlService.$inject = ['CallsheetPageInitCtrlService'];
function CallsheetPageEditCtrlService(CallsheetPageInitCtrlService) {
    return function($ctrl, $element) {
        console.log('CallsheetPageEditCtrlService');

        $ctrl.$element = $element;
        $ctrl.element = $ctrl.$element[0];

        $ctrl.addCallsheetRecipients = addCallsheetRecipients;

        $ctrl.$onInit = $onInit;
        $ctrl.$onDestroy = $onDestroy;

        $ctrl = new CallsheetPageInitCtrlService($ctrl, $element);

        return $ctrl;

        function $onInit() {
            if ($ctrl.onInitPageEdit) {
                $ctrl.onInitPageEdit();
            }

            if(!$ctrl.getPageTemplate) {
                console.warn('Parent for CallsheetPageEditCtrlService must define method $ctrl.getPageTemplate');
            }
            $ctrl.addRootWatcher('ADD_CALLSHEET_RECIPIENTS', $ctrl.addCallsheetRecipients);
        }

        function $onDestroy() {
            $ctrl.onSimplePageDestroy();
            if($ctrl.onDestroy){
                $ctrl.onDestroy();
            }
        }

        function addCallsheetRecipients(filterRole) {
            var productContactListId = $ctrl.CPS.product ? $ctrl.CPS.product.contactListId : null;
            if (productContactListId) {
                filterRole = (filterRole ? (filterRole === 'CrewAndUnassigned' ? 2 : filterRole) : 'All').toString();
                console.log('ADD_CALLSHEET_RECIPIENTS: ' + filterRole);

                $ctrl.popupsService.open(null, $ctrl.popupsService.operations.addCallsheetRecipients, {
                    hideSidebarToggleOnDesktop: false,
                    callsheet: angular.copy($ctrl.CurrentProduct.getCallsheet()),
                    productContactListId: productContactListId,
                    preLoadingService: $ctrl.preLoadingService,
                    filterRole: filterRole,
                    isEditCallsheet: $ctrl.isEditCallsheet
                }, null, null, function (result) { //use compOptions from the constantsservice
                    // $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.callsheetInvitations.Add Recipients.success', 'success', {name: 'this'});
                });
            }
        }
    }
}

