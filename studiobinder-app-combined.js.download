angular.module('product.documents.group.component',[
    'product.documents.controller.service'
])
.component('documentGroup', treeGroupComponentParams( 'DocumentGroupCtrl', {
    onLoadDirectory: '&',
    documentId: '<',
    withDocumentInline: '<'
}))
.controller('DocumentGroupCtrl', DocumentGroupCtrl);
DocumentGroupCtrl.$inject = ['DocumentGroupCtrlService', '$element'];
function DocumentGroupCtrl(DocumentGroupCtrlService, $element) {
    var $ctrl = this;
    $ctrl = new DocumentGroupCtrlService($ctrl, $element);
}

angular.module('product.documents.controller.service',[
    'apiPagination.Documents',
    'product.documents.item.edit.component',
    'product.documents.item.grid.component',
    'product.material.fileStats.service'
])
.service('DocumentGroupCtrlService', DocumentGroupCtrlService);
DocumentGroupCtrlService.$inject = ['DocumentsPagination', 'TreeGroupInitCtrlService', 'FileStatsService', 'RouteCollaboratorsService'];
function DocumentGroupCtrlService(Pagination, TreeGroupInitCtrlService, FileStatsService, RouteCollaboratorsService) {
    return function ($ctrl, $element){
        $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
        $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;

        $ctrl.additionalMessageRemove = 'You will lose all the folders and files inside.';
        $ctrl.getExtension = FileStatsService.getExtension;
        $ctrl.getNewParams = getNewParams;
        $ctrl.loadDirectory = loadDirectory;
        $ctrl.onAdded = onAdded;

        $ctrl.processGridViewItem = processGridViewItem;
        $ctrl.processListItemColumn = processListItemColumn;

        $ctrl.getInlineActions = getInlineActions;
        $ctrl.getSharePageName = getSharePageName;
        $ctrl.getNewPopupParamsOther = getNewPopupParamsOther;
        $ctrl.showSelectCondition = showSelectCondition;

        $ctrl.canShowShareInMore = canShowShareInMore;

        $ctrl.getMorePopoverTemplateOther = getMorePopoverTemplateOther;
        $ctrl.saveAsTemplate = saveAsTemplate;
        $ctrl.importTemplate = importTemplate;

        $ctrl.$onInit = $onInit;

        $ctrl.afterProcessUpdatesOther = afterProcessUpdatesOther;

        $ctrl.getGroupName = getGroupName;
        $ctrl.getGroupIcon = getGroupIcon;
        $ctrl.getItemImageSize = getItemImageSize;

        $ctrl.getDescBlock = getDescBlock;
        $ctrl.showDescBlock = showDescBlock;
        $ctrl.getClsColOther = getClsColOther;
        $ctrl.getEditPopupColumnsCond = getEditPopupColumnsCond;
        $ctrl.showColumnOther = showColumnOther;
        $ctrl.hasSortableForItemOther = hasSortableForItemOther;
        $ctrl.canDuplicate = canDuplicate;
        $ctrl.onListNameChangedOher = onListNameChangedOher;

        return $ctrl;

        function onListNameChangedOher(item){
            updateParentNameForAll(item);
        }

        function canDuplicate (item){  //on avscripts page can duplicate only avscripts / not seasons
            return ($ctrl.withDuplicateGroupItem || $ctrl.keyboardService.canCopy) && ($ctrl.treeType === 3 && !item.isFolder || $ctrl.treeType !== 3);
        }

        function isInSeries(item) {
            if(!item){item = $ctrl.currentList;}
            return item && item.isFolder && (item.l === 1 || item.parentId === null);
        }

        function isInSeason(item) {
            if(!item){item = $ctrl.currentList;}
            return item && item.isFolder && (item.l === 2 || item.parentId !== null);
        }

        function hasSortableForItemOther(){
            //series cant be sortable
            return $ctrl.treeType === 3 && !isInSeries();
        }

        function getEditPopupColumnsCond(c, item) {
            return $ctrl.treeType === 3 ?
                                   // series                                                        //season               //av script
            (isInSeries(item) ? (c.prop !== 'prefix' && c.prop !== 'epNo') : (isInSeason(item) ?  (c.prop !== 'epNo' ) : (c.prop !== 'prefix' && c.prop !== 'logo' && c.prop!=='logoId'))) : true;
        }

        function showColumnOther(item, c, isHeader, isMobile, notTextOnly) {
            // dont show episode on series
            var isSeries = isInSeries();
            return !($ctrl.treeType === 3 && ((isSeries || $ctrl.currentListId === 'All') && c.prop === 'epNo' || isSeries && c.prop === 'createdAt'));
        }

        function getClsColOther(c, isLast, isHeader){
            return $ctrl.treeType === 3 ? ($ctrl.currentListId === 'All' ? ' all' : (isInSeries() ? ' series ' : (isInSeason() ? ' season ' : ''))) : '';
        }

        function showDescBlock() {
            return $ctrl.treeType === 3;
        }

        function getDescBlock() {
            var prop = 'description';
            return $ctrl.currentList.isFolder && $ctrl.treeType === 3 && $ctrl.currentList[prop] ?  ('<div class="display-block desc sb-prop-list-description">' + ($ctrl.currentList[prop] || '') + '</div>') : '';
        }

        function getGroupName(list, inside){
            return getLevel(list, inside) ? $ctrl.nameForList : $ctrl.nameForGroup;
        }

        function getGroupIcon(list, inside){
            return getLevel(list, inside) ? $ctrl.iconForList : $ctrl.iconForGroup;
        }

        function getLevel(list, inside) {
            var l = list ? list : $ctrl.currentList;
            return l && ((l.l ? l.l : (l.parentId === null ? 1 : 2)) + (inside ? 1 : 0)) === 2;
        }

        function afterProcessUpdatesOther(result, initResult) {
            console.log('afterProcessUpdatesOther');
            if ($ctrl.currentListId !== 'All') {
                return;
            }

            if (result.type === 1) {//move
                var u = result.updates;
                if(u){
                    for (var id in u){
                        $ctrl.list.replaceElementProps(id, u[id]);
                    }
                }
            }
        }

        function $onInit() {
            //for list sort by folder first, and then alph
            if($ctrl.treeType === 3) {
                $ctrl.loweFilterClass = 'with-posters-list-header';
                var p = isInSeries() ?  {
                    treeDefaultOrder: ['isFolder', 'prefix'],
                    treeDefaultOrderDir: 1
                }: (isInSeason() ? {
                    treeDefaultOrder: ['order'],
                    treeDefaultOrderDir: 1
                } : {
                    treeDefaultOrder: 'updatedAtT',
                    treeDefaultOrderDir: -1
                })
                $ctrl.compOptions = JSON.stringify(_.extend(JSON.parse($ctrl.compOptions), p));
                $ctrl.defaultOrder = p.treeDefaultOrder;
                $ctrl.defaultOrderDir = p.treeDefaultOrderDir;
                $ctrl.onListChangedProps = ['description', 'prefix', 'logo', 'logoId', 'customEpNo', 'epNo'];
            }

            if($ctrl.withDocumentInline) {
                $ctrl.withoutGroupSorting = true;
                $ctrl.onReloadGroupTemplateOther = onReloadGroupTemplateOther;
            }
            if($ctrl.canEdit) {
                $ctrl.withShare = true;
            }
            $ctrl.filtersClass = 'small';
            $ctrl.hideCounter = $ctrl.hideGroupCounter;

            $ctrl = new TreeGroupInitCtrlService($ctrl, $element, Pagination, false);

            $ctrl.parentId = $ctrl.currentListId;

            if($ctrl.canEdit){
                $ctrl.onUpdated = onUpdated;

                if($ctrl.treeType !== 2){
                    $ctrl.addRootWatcher('RENAME_GROUP_DOCUMENT_ITEM', onRenameDocument);
                    $ctrl.addRootWatcher('REMOVED_DOCUMENT_TREE', onRemovedTree);
                }

                if($ctrl.withDocumentInline) {
                    $ctrl.addRootWatcher('RENAME_DOCUMENTVERSION_ITEM', onRename);
                    $ctrl.addRootWatcher('DESCCHANGED_DOCUMENTVERSION_ITEM', onDescChanged);
                    $ctrl.addRootWatcher('UPLOADED_DOCUMENTVERSION_ITEM', onUploaded);

                    $ctrl.addRootWatcher('ADDED_DOCUMENTTEMPLATE_ITEM', onAddedDocumentTemplate);
                }
            }
        }

        function canShowShareInMore(item, isMobile) {
           // return  item && !item.isFolder;
            return item && !item.isFolder && (item.type === 3 || $ctrl.CPS.companyId === $ctrl.LCS.API_CONFIGS.SBPredefCompanyId);
        }

        function getNewPopupParamsOther() {
            return {onLoadDirectory: loadDirectory};
        }

        function onDescChanged(result) {
            console.log('onDescChanged');
            var item = result.item ? result.item : result;
            result = {item: item};
            var v = item.version;
            if (v) {
                result.editchanges = {
                    _id: item._id,
                    version: {
                        _id: v._id,
                        contentVersionId: v.contentVersionId,
                        description: v.description,
                        updatedAt: v.updatedAt,
                        updatedAtT: v.updatedAtT
                    }
                };
                $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + "_ITEM", result);
            }
        }

        function replaceElementDetails(item){
            if(item) {
                $ctrl.list.replaceElementProps(item._id, getChanges(item));
            }
        }

        function getChanges(item) {
            var id= item._id,
                v = item.version;

            if (!v) {
                return {_id: id, name: item.name};
            }

            var c = {
                _id: id,
                name: v.name,
                updatedAt: v.updatedAt,
                updatedAtT: v.updatedAtT,
                'version.name': v.name,
                'version.description': v.description,
                'version.contentVersionId': v.contentVersionId
            };

            if (v.updatedAt) {
                c['version.updatedAt'] = v.updatedAt;
                c['version.updatedAtT'] = v.updatedAtT;
            }

            return c;
        }

        function onUpdated(result){
            console.log('onUpdated');
            if ($ctrl.withDocumentInline) {
                var item = result ? result.item : null;
                var v = item ? item.version : null;
                if (v) {
                    replaceElementDetails(item);
                }
                $ctrl.changeOrder($ctrl.listParams.defaultOrder, $ctrl.SBFieldMethods.PropTypes.Number,
                    $ctrl.listParams.defaultOrderDir);
            }
        }

        function onRenameDocument(result1, result){
            $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result1);
            var updated = updateParentNameForAll(result1.item);
            if(!updated) {
                $ctrl.LCS.timeout(function () {
                    $ctrl.broadcastRoot('RENAMED_NOTE', result);
                }, 100);
            }
        }

        function updateParentNameForAll(list) {
            if ($ctrl.treeType === 3 && $ctrl.currentListId === 'All') {
                if (list) {
                    //is series
                    if (list.parentId === null) {
                        _.each($ctrl.list.items, function (item) {
                            var p, p2;
                            if (item.parentId === list._id) { // file in series
                                 p2 = list; //series
                            } else {//file in season
                                var season = $ctrl.listTreeService.getNodeById(item.parentId);
                                if(season && season.parentId === list._id){
                                     p2 = list;
                                     p = season;
                                }
                            }
                            update(p, p2, item);
                        });
                    } else { //is season
                        _.each($ctrl.list.items, function (item) {
                            var p, p2;
                            if (item.parentId === list._id) { // file in season
                                p  = list; //series
                                p2 = $ctrl.listTreeService.getNodeById(item.parentId);
                                update(p, p2, item);
                            }
                        });
                    }
                    return true;
                }
            }

            function update(p, p2, item) {
                $ctrl.list.replaceElementProps(item._id, {
                    parentName: getParentName(p, p2)
                });
            }
        }

        function onRemovedTree(result){
            if($ctrl.currentListId === 'All' && result.ungroup){
                var id = result.item ? result.item._id : null;
                if(id) {
                    _.each(_.filter($ctrl.list.items, {parentId: id}), function (item) {
                        $ctrl.list.replaceElementProps(item._id, {
                            parentId: null
                        });
                    });
                }
            }
        }

        function onRename(result){
            console.log('onRename');
            if(result) {  //item {_id, versionId, name} is document
                var item = result.item,
                    id = item._id;

                if (!$ctrl.initEls) {
                    $ctrl.initEls = {};
                    if (!$ctrl.initEls[id]) {
                        $ctrl.initEls[id] = $ctrl.list.getElementById(id);
                    }
                }

                if (result.update) {
                    if (!$ctrl.isUpdating) {
                        $ctrl.isUpdating = true;
                        $ctrl.service.update(_.extend({
                            actiontype: 'rename',
                            companyId: $ctrl.CPS.companyId,
                            productId: $ctrl.CPS.productId
                        }, item), onSave, onError);
                    }
                } else {
                    replaceElementDetails(item);
                }

                function onSave(result1) {
                    var item1 = result1 ? result1.item : null;
                    if (!item1 || item1.name !== item.name) {
                        onError();
                    }else{
                        $ctrl.isUpdating = false;
                        result1.eventType = 'CHANGED_FIELD';
                        result1.editchanges = getChanges(item1);
                        $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result1);
                        $ctrl.broadcastRoot('RENAMED_NOTE', result);
                    }
                }

                function onError() {
                    $ctrl.isUpdating = false;
                    $ctrl.list.replaceElementProps(id, $ctrl.initEls[id]);
                }
            }
        }

        function getSharePageName(list) {
            return 'user.product.document' + (list.isFolder ? 's' : '');
        }

        function onReloadGroupTemplateOther(){
           console.log ('onReloadGroupTemplateOther');
            //if there is no doc selected select the first one in the folder
            var id = $ctrl.SBStateService.getSearchFilter('documentId'),
            item = id ? _.find($ctrl.list.items, {_id: id}) : null;
            if(!item && $ctrl.list.items.length > 0) {
                item = $ctrl.list.items[0];
            }
            loadDirectory(item);
        }

        function loadDirectory(item, justAdded) {
            console.log('loadDirectory');
            $ctrl.documentId = item ? item._id : null;

            if($ctrl.withDocumentInline && $ctrl.documentId === $ctrl.prevDocumentId) {
                return 'issame';
            }

            $ctrl.SBStateService.setSearchFilter($ctrl.documentId, 'documentId');
            $ctrl.LCS.timeout(function () {
                setActive($ctrl.prevDocumentId, false);
                setActive($ctrl.documentId, true);

                $ctrl.prevDocumentId = $ctrl.documentId;
                $ctrl.onLoadDirectory({item: item});
            }, justAdded ? 600 : 100);

            function setActive(id, isActive){
                console.log('setActive: ' + id + ',' + isActive);
                if(id){
                    $ctrl.LCS[isActive ? 'addClass' : 'removeClass']($ctrl.element.querySelector('.document-item-grid[data-id="' + id + '"] .row-schedule'), 'selected');
                }
            }
        }

        function onUploaded(result) {
            console.log('documentGroup. on Uploaded');
            var item = result ? (result.document ? result.document : (result.item ? result.item : null)) : null;
            onAdded(item ? {item: $ctrl.service.convertResource(item)} : null);
            $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.Upload.success', 'success');
            //increment color
            /*var item = result && (result.item ? result.item : (result.document ? result.document : null));
            item = item && item.versionId ? $ctrl.service.convertResource(item.versionId) : null;
            var params = {color:getNextColor() };
            $ctrl.service.update(_.extend({_id:item._id},params), function(result) {
                if(result){
                    insertItem(_.extend(item, params));
                    $ctrl.i18nNotifications.pushForCurrentRoute(null, 'crud.documentVersion.Upload.success', 'success');
                }
            }, function(err){
                $ctrl.i18nNotifications.pushForCurrentRoute(err, 'crud.documentVersion.Upload.error', 'error');
            });*/
        }

        function processGridViewItem(item) {
            return processItemView(true, item);
        }

        function processListItemColumn(item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
            return processItemView(false, item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails);
        }

        function processItemView(isGrid, item, canEdit, c, cls, isFirst, isLast, textOnly, isMobile, isMobileRowDetails) {
            if(!isGrid && !c){return '';}
          //  var item=$ctrl.item;
            var el = '',
             version = !item.isFolder ? item.version : null,
             versionId = version ?  version.version : null,
             classD = item ? (item.type === 1 ? 'document1-filled' : (item.type === 2 ? 'screenplays' : 'avscripts')) : '',
             shortExt = version ? (version.type === 1 ? 'sbdoc' : (version.type === 2 ? 'sbx' : 'sbav')) : '',
             itemName = item.name, //version ? version.name : item.name,
             itemTooltip = itemName && itemName.length > 40 ? itemName.replace(/\'/g,"\\'") : null,
             ext = item.isFolder ? 0 : ($ctrl.getExtension(item.name).length + 1),
             updatedAt = item.isFolder ? item.updatedAt : (item.version ? (item.version.updatedAt ? item.version.updatedAt : item.version.createdAt)  : null),
             collabProp = 'collaboratorIds',
             currentTodoPage = $ctrl.BlocksSetupService.getCurrentTodoPage(),
             todoPage = item.isFolder ? currentTodoPage : $ctrl.BlocksSetupService.getTodoPageById(currentTodoPage.filePageId), //share file
             collabIdsCol = _.extend({}, $ctrl.getColumnByProp(collabProp), {
                canEdit: item.createdById === $ctrl.CPS.userId || $ctrl.CPS.memberType >= $ctrl.security.MemberTypes.Admin,
                showOnlyCounter: !$ctrl.isGridView && !$ctrl.withDocumentInline,
                uId: item._id,
                list: item
            }, $ctrl.withDocumentInline ? {
                icon:'small24',
                colCls : 'full-width team-members'
            } : {
                 todoPageId: todoPage._id
            }),
            withclick = ($ctrl.isActiveFilter() || $ctrl.withDocumentInline) ? ('no-drag with-cursor ' + $ctrl.getClickEventName('loadDirectory')) : '';

            itemTooltip = itemTooltip ? ('tooltip-placement="bottom" tooltip="' + itemTooltip + '" ') : '';
            updatedAt =  updatedAt ?  updatedAt.format('MMM D, YYYY') : '';
            var iconG = $ctrl.LCS.getISBDiv(item.isFolder ? $ctrl.getGroupIcon(item) : classD, 8, 'mini-icon'),
                shortExtG = item.isFolder ? $ctrl.getGroupName(item) : shortExt;

            if (isGrid) {
                collabIdsCol.circleSize = 'smaller';
        return '<div class="full-width logoimg">' +
                    '<div class="table-div fixed-layout full-width top-table centered ' + (item.type === 3 && withclick ? withclick : '') + '">' +
                        (item.type === 3 && item.isFolder ?  getLogo(item) : ('<div class="text-center centered">' + getColIcon()+ '</div>')) +
                    '</div>' +
                    $ctrl.getCustomCheckbox(true) +
                    '<div class="table-div fixed-layout full-width bottom-table white-bg">' +
                        '<div class="grow-column center-cont-text centered col-title  ">' +
                            '<div class="table-div wrap no-drag fixed-layout">' +
                                (versionId && versionId > 1 ? ('<div class="version-label">v' + versionId + '</div>') : '') +
                                '<div class="title1 with-padding-left with-padding-right centered with_underline ' + withclick + '">' +
                                    '<div class="with-ellipsis" ' + itemTooltip + '>' + getName() + '</div>' +
                                   // '<div class="'+$ctrl.getViewEditElemSelector('updatedAt')+'">'+item.updatedAt+'</div>' +
                                '</div>'+
                            '</div>' +
                        '</div>' +
                        ($ctrl.treeType === 3 ? '' : ('<div class="centered col30 no-drag">' + getC(collabIdsCol, null) + '</div>')) +
                        ($ctrl.canEdit ? ('<div class="side-col centered">' + $ctrl.getMoreBtnTemplate(false, item, isMobile) + '</div>') : '') +
                    '</div>' +
                '</div>';
            }
            else{
                switch (c.prop) {
                    case 'name':
                        el += (($ctrl.withDocumentInline || item.type === 3 ) ? '' : getFolder()) +
                            '<div class="folder-name-col one-line-tooltip grow-column ">' +
                                '<div class="full-width ' + withclick + '">' +
                                    getV() +
                                    '<div class="title1 ' + (withclick ? 'with_underline ' : '') + ($ctrl.withDocumentInline ? 'full-width bold title-color' : 'inline-block') + '" ' + itemTooltip + '>' + getName() + '</div>' +
                                '</div>' +
                                getUnder() +
                                getNote('description', textOnly)+
                                getParentName() +

                                //todo bring back collaborators selector
                                //($ctrl.withDocumentInline ? ('<div class="margin-top-quarter team-members">' + getC(collabIdsCol, 'no-trigger') + '</div>') : '') +
                            '</div>';
                        break;

                        //episode
                    case 'epNo' :
                        if($ctrl.currentList === 'All' || isInSeason()) {
                            var type = $ctrl.filtersService.options.type,
                                cs = $ctrl.getColumnByProp('customEpNo', true),
                                canE = canEdit && !isMobile,
                                isCustom = isCustomEp();
                            var p = $ctrl.listTreeService.getNodeById(item.parentId);
                            el += '<div class="' + $ctrl.getClsCol(c) + '">' +
                                    '<div class="calendar-box">' +
                                        '<div data-parent="' + item.parentId + '" class="calendar-bottom text-center uppercase ' + (p.prefix ? '' : 'sb-hide') + '">' + p.prefix + '</div>' +
                                        '<div class="calendar-top text-center shotnoprop">' +
                                            'E' +
                                //item.order +
                                            '<span class="'+$ctrl.getViewEditElemSelector((!canE && isCustom) ? 'customShotNo' : c.prop) + ' ' + (canE && isCustom ? 'sb-hide' : '') + '">' + $ctrl.SBFieldMethods.getShotNo(item, type, c.prop) + '</span>' +
                                            (canE ? getEdCol(cs, 'shotnoc ' + (isCustom ? '' : 'sb-hide')) : '') +
                                  '</div>' +
                                    '</div>' +
                                '</div>';
                        }
                        break;

                    case 'logo' :
                        el += item.type === 3 ? (item.isFolder ? getLogo(item, withclick) : getFolder(withclick)): '';
                        break;

                    case 'createdAt' :
                        el += item.type === 3 && isInSeries() ? '' : get(c);
                        break;

                    default:
                        el += $ctrl.withDocumentInline ? '' : get(c);
                        break;
                }
            }

            return el;

            function getName(){//' | '
               return (isInSeries() && !item.isFolder ? ('<span class="with-vertical-line ' + $ctrl.SBFieldTypesService.getViewEditElemSelector('epNo', true, $ctrl.canEdit) + '">' + (item.epNo ? item.epNo : '') + '</span>') :
                        (isInSeason(item) ? ('<span class="with-dash-line ' + $ctrl.getViewEditElemSelector('prefix') + '">' + (item.prefix ? item.prefix : '') + '</span>') : '')
                ) +
                '<span class="' + $ctrl.getViewEditElemSelector('name') + '">' + itemName + '</span>';
            }

            function getEdCol(c, cls) {
                return '<div class="shortfield shot-block pull-left ' + cls + '">' +
                  $ctrl.getDisplayItemCol(item, _.extend({}, c, {
                    canEdit: canEdit,
                    fieldClass: c.fieldClass,
                    eClassAttr: (c.eClassAttr||'') + ' bold',
                    editableContainerClass: 'without-height-padding bold',
                }), null, canEdit, textOnly, isMobile, isMobileRowDetails) +
                    '</div>';
            }

            function isCustomEp() {
                return $ctrl.filtersService.options.type && $ctrl.filtersService.options.type.toString() === '3';
            }

            function getLogo(item, withclick) {
                var c1 = $ctrl.getColumnByProp('logo', true);
                return c1 ? get($ctrl.getImageTemplate(item, _.extend({}, c1, {
                    icon: $ctrl.getGroupIcon(item),
                    imgSize: $ctrl.getImgSizeInit()
                }))) : '';

                function get(c) {
                    return '<div class="storylogo no-drag ' + ($ctrl.isGridView ? '' : c1.colCls)  + (withclick ? (' with-cursor ' + withclick) : '') +
                        '"><div class="stretchy-wrapper"><div>' + c + '</div></div></div>';
                }
            }

            function getV() {
                return (!$ctrl.withDocumentInline && versionId > 1 ? ('<div class="version-label inline-block with-margin-right">v' + (versionId ? versionId : '') + '</div>') : '')
            }

            function getNote(prop, textOnly, isCenter, other) {
                if(item.type !== 3){return '';}
                var n = $ctrl.getColumnByProp(prop),
                    isNote = other && other.isNote;
                if (!n) {
                    return '';
                }

                var v = get(_.extend({}, n, {
                    hideEmptyContent: true,
                    fieldClass: n.fieldClass
                }, other), ' ');

                if ($ctrl.isPrintLayout && !v) {
                    return '';
                }

                return textOnly ? v : (n ? ('<div class="full-width ' + (isNote ? 'padding-top-5' : 'subtitle') +
                    (isCenter ? ' text-center' : '') +
                    '">' +
                    (isNote ? '<div class="bold padding-top-8">NOTE: </div>' : '') + v + '</div>') : '');
            }

            function getColIcon (){
                return (item.isFolder ? ('<div class="folder-icon centered large ' + $ctrl.folderIcon + '"><div class="text-center folder-inner-icon">' +  $ctrl.LCS.getISBDiv(item.icon? item.icon : 8, 3) + '</div></div>') :
                    ('<div class="large file-icon centered docmodal-'+item.type +'">' + iconG + '<div class="text">' + shortExtG + '</div></div>'))
            }

            function getC(c, cls) {
                return $ctrl.getDisplayItemCol(item, c, cls, canEdit, textOnly, isMobile, isMobileRowDetails);
            }

            function getFolder(withclick) {
                var smallcol = $ctrl.treeType === 3 && item.isFolder,
                    icon = smallcol ? $ctrl.LCS.getISBDiv($ctrl.getGroupIcon(item), 3, 'sbf28 orange') : getFolderIcon(item);
                return '<div class="folder-col with-padding hide-print text-center ' + $ctrl.getClsColOther() +
                    (withclick ? (' with-cursor ' + withclick) : '') +
                    '" ' +
                    '>' + icon + '</div>';
            }

            function getFolderIcon(item, cls, icon) {
                var i = $ctrl.LCS.getISBDiv(item.icon ? item.icon : (icon ? icon : $ctrl.getGroupIcon(item)), item.iconLevel ? item.iconLevel : 3);
                return item.isFolder && (item.isInline || $ctrl.treeType !== 3) ? ('<div class="centered col24 ' + (cls ? cls : ' ') + '">' + i + '</div>') :
                    ('<div class="text-center file-icon centered docmodal-' + item.type +
                        ($ctrl.currentListId === 'All' && $ctrl.treeType === 3 ? ' all' : '') +
                        '">' + iconG + '<div class="text">' + shortExtG + '</div></div>');
            }

            function getUnder() {
                return $ctrl.withDocumentInline ? (((canEdit || !canEdit && item.version && item.version.description) ? ('<div class="full-width description subname with-ellipsis ' + $ctrl.getViewEditElemSelector('version.description') + '">' + (item.version && item.version.description ? item.version.description : '') + '</div>') : '')) : '';
            }

            function getParentName() {
                var res = $ctrl.currentListId === 'All' && item.parentId ? getParentInfo(item.parentId, false) : null,
                    icon = item.type === 3 ? $ctrl.getGroupIcon(res ? (res.p2 ? res.p2 : res.p) : null) : 'folder';
                return canEdit || !canEdit && p ? ('<div class="parentName margin-top-6 full-width' + (res && res.p ? '' : ' sb-hide') + '">' +
                    getFolderIcon({
                        isInline: true,
                        isFolder: true,
                        type: $ctrl.treeType
                    }, 'smaller pull-left', icon + ' gray') +
                    '<div class="centered subname margin-top-0 pull-left ' + $ctrl.getViewEditElemSelector('parentName') + '">' + (res && res.n ? res.n : '') + '</div>' +
                '</div>') : '';
            }

            function get(c, cls1) {
                return $ctrl.getDisplayItemCol(item, c.prop === collabProp ? collabIdsCol : c, cls1 ? cls1 : cls, canEdit, textOnly, isMobile, isMobileRowDetails);
            }
        }

        function getParentName(p, p2){
            return (p2 ? p2.name : '') + (p2 && p ? ' • ' : '') + (p ? p.name : '');
        }

        function getParentInfo(parentId, onlyName) {
            var p = $ctrl.listTreeService.getNodeById(parentId),
                p2 = p && p.parentId ? $ctrl.listTreeService.getNodeById(p.parentId) : null,
                n = getParentName(p, p2);
            return onlyName ? n : {p: p, p2: p2, n: n};
        }

        function getNewParams(after, type, items) {
            var max, isAvscript = $ctrl.treeType === 3;
            if (isAvscript) { //avscript
                max = items && items.length > 0 ? (parseInt(_.max(items, function (x) {
                    return parseInt(x.epNo, 10);
                }).epNo, 10) + 1) : 1;
            }
            return _.extend({
                type: $ctrl.treeType,
                name: 'New ' + $ctrl.itemTitle + (isAvscript ? (max === 1 ? '' : (' ' + max)) : ''),
            }, isAvscript ? {epNo: max} : null);
        }

        function getInlineActions(isHeader, item) {
            //todo bring back file share
            return '';

            return $ctrl.canEdit && !$ctrl.withDocumentInline ? (
                '<div ' + (isHeader ? 'ng-if="!$ctrl.isGridView" ' : '') + 'class="col110 hide-print hide-ipad with-hover text-center no-drag">' +
                (isHeader ? '' : ('<button type="button" class="btn btn-small transparent ' + $ctrl.getClickEventName('share') + '" analytics-on analytics-action="Open Share">' +
                    $ctrl.LCS.getISBDiv('link', 2, 'pull-left gray') +
                    ' Share</button>')) +
                '</div>'
            ) : '';
        }

        function showSelectCondition() {
            return $ctrl.showSelectConditionInit() && !$ctrl.withDocumentInline;
        }

        function onAdded(result){
            console.log('DocumentGroupCtrl.onAdded');
             var item = result ? result.item : null;
            if(item.item) {item = item.item;}
            if (item) {
                if(item.version && item.version.contentVersionId &&
                typeof (item.version.contentVersionId) !== 'string'){
                    item.version.contentVersion = item.version.contentVersionId;
                    item.version.contentVersionId = item.version.contentVersion._id;
                }
                var issame = loadDirectory(item, true);
                if(issame === 'issame'){//new version uploaded
                    $ctrl.broadcastRoot('CHANGE_DOCUMENTVERSION', item.versionId);
                }
            }
        }

        function saveAsTemplate(item, info, e){
            console.log('DocumentGroupCtrl.saveAsTemplate');
            //planFetatures testmode
            var quotaType = item.type === 1 ? 'notesTemplates' : (item.type === 3 && $ctrl.LCS.isDebugMode ?
                 'avscriptTemplates' : null);
            $ctrl.CPS.loadQuotaPopup(quotaType, process, null, null, $ctrl.compOptions || JSON.stringify({pageClass: $ctrl.pageClass}), {e:e});

            function process() {
                $ctrl.popupsService.open({
                    companyId: item.companyId,
                    productId: item.productId,
                    versionId: item.versionId,
                }, $ctrl.popupsService.operations.saveDocumentTemplate, {
                    itemTitle: (item.type === 3 ? 'AV Script ' : 'Document') + ' template'
                }, $ctrl.compOptions);
            }
        }

        function importTemplate(item){
            console.log('DocumentGroupCtrl.importTemplate');
            /* $ctrl.broadcastRoot('DUPLICATE_FROM_TOP_' + $ctrl.elemType + '_TREE', {
                 item: item ? item : $ctrl.listTreeService.active.selectedList,
                 dataParam: {isTemplate: true}
             });*/
        }

        function onAddedDocumentTemplate(){
            console.log('DocumentGroupCtrl.onAddedDocumentTemplate');
        }

        function getMorePopoverTemplateOther(item, isMobile) {
            //return '';

            return item.type === 1 ?  ( //for documents only
                  $ctrl.getSideMenuLi({
                    type: 'saveAsTemplate',
                    action: 'Save as Template',
                    icon: 'star'
                })
                /*+ $ctrl.getSideMenuLi({
                    type: 'importTemplate',
                    action: 'Import Template',
                    icon: 'upload-2',
                    iconLevel: 3
                })*/
            ) : '';
        }

        function getItemImageSize(isMobile){
            return $ctrl.treeType === 3 && isMobile ? 'smaller' : 'storyboard1';
        }
    }
}

angular.module('product.documents.item.grid.component', [])
.component('documentItemGrid',itemGridComponentParams(null,'DocumentGridItemCtrl'))
.controller('DocumentGridItemCtrl',DocumentGridItemCtrl);
DocumentGridItemCtrl.$inject = ['RouteCollaboratorsService', 'GridItemGroupInitCtrlService', 'DocumentsService', '$element'];
function DocumentGridItemCtrl(RouteCollaboratorsService, GridItemGroupInitCtrlService, service, $element) {
    var $ctrl = this;
    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;

    var collaboratorIdsProp = 'collaboratorIds';

    $ctrl.withUncheck = true;
    $ctrl.bindingNames = ['share', 'loadDirectory', 'getDownloadLink', 'saveAsTemplate', 'importTemplate'];

    $ctrl.getExtension = service.getExtension;
    $ctrl.updateEditableItemPropsAll = updateEditableItemPropsAll;
    $ctrl.getColFromProp = getColFromProp; //for editable field
    $ctrl.postInitItem = postInitItem;

    $ctrl = new GridItemGroupInitCtrlService($ctrl, $element);
 
    function postInitItem() {
        if (!$ctrl.isPrintLayout && $ctrl.canEdit) {
            var c = getColFromProp(collaboratorIdsProp);
            if (!c) {
                return;
            }

            $ctrl.removeWatcher($ctrl.uIdRootWatcher);
            $ctrl.uIdRootWatcher = $ctrl.addRootWatcher('UPDATE_ITEM_COLLABORATORS_' + $ctrl.item._id, onUpdateItemCollaborators);
            $ctrl.removeWatcher($ctrl.uPIdRootWatcher);
            $ctrl.uPIdRootWatcher = $ctrl.addRootWatcher('UPDATE_PARENT_COLLABORATORS', onUpdateItemCollaborators);
        }
    }

    //todo move in group - > update collaboratorsIDs - > and trigger update for txt
    function onUpdateItemCollaborators(result1) {
        console.log('UPDATE_ITEM_COLLABORATORS');
        var c = getColFromProp(collaboratorIdsProp);
        if (!c) {
            return;
        }
        var el = $ctrl.element.querySelector('.' + $ctrl.SBFieldTypesService.getPropMark(collaboratorIdsProp) + ' a div');
        if (!el) {
            return;
        }

        var result = $ctrl.SBFieldMethods.getCollaboratorsForList($ctrl, $ctrl.item._id, c.todoPageId);
        if (result && result.membersCountTxt) {
            if(c.showOnlyCounter) {
                el.innerText = result.membersCountTxt;
            }
        }
    }

    function getColFromProp(prop) {
        var c = $ctrl.getColFromPropInit(prop);
        if(!c){return null;}
        if (c.type !== $ctrl.SBFieldTypesService.PropTypes.Collaborators) {
            return c;
        }
        var todoPage = $ctrl.RouteCollaboratorsService.todoPage,
            todoPageId = todoPage._id;
        //todo check some more
        if(todoPage.type === 3 && todoPage.filePageId && !$ctrl.item.isFolder){
            todoPageId = todoPage.filePageId;
        }
        var c1 = _.extend({}, c, {
            canEdit: $ctrl.item.createdById === $ctrl.CPS.userId || $ctrl.CPS.memberType >= $ctrl.security.MemberTypes.Admin,
            showOnlyCounter: !$ctrl.isGridView,
            list: $ctrl.item,
            uId: $ctrl.item._id,                //isparent                              //is child
            todoPageId: todoPageId
        });
        $ctrl.list = $ctrl.item;
        if ($ctrl.isGridView) {
            c1.circleSize = 'smaller';
        }
        return c1;
    }

    function updateEditableItemPropsAll(changes) {
        //console.log('updateEditableItemPropsAll');
        var prop = 'version.description';
        if($ctrl.item.version && $ctrl.hasPropChanged(changes, prop)) {
            $ctrl.element.querySelector('.' + $ctrl.SBFieldTypesService.getPropMark(prop)).innerText = $ctrl.item.version.description || '';
        }

        if ($ctrl.element.getAttribute('current-list-id-inherited') === 'All'){
            var name = null;
            if($ctrl.hasPropChanged(changes, $ctrl.listField)) {
                var p = $ctrl.item.parentId ? $ctrl.preLoadingService.getById($ctrl.preloadingType, $ctrl.item.parentId) : null;
                name = p ? p.name : '';
            }else if($ctrl.hasPropChanged(changes, 'parentName')) {
                var p = $ctrl.item.parentId ? $ctrl.preLoadingService.getById($ctrl.preloadingType, $ctrl.item.parentId) : null;
              name = $ctrl.item.parentName;
            }
            if(name !== null) {
                var el = $ctrl.element.querySelector('.parentName');
                if (el) {
                    $ctrl.LCS[p ? 'removeClass' : 'addClass'](el, 'sb-hide');
                    el.querySelector('.' + $ctrl.SBFieldTypesService.getPropMark('parentName')).innerText = p ? p.name : '';
                }
            }
        }
    }
}

