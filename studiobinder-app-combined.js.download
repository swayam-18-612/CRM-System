        $ctrl.searchGroupItems = $ctrl[$ctrl.ALL_ITEMS];

        $ctrl.searchEmptyIcon = $ctrl.LCS.getISBStripboard();
        $ctrl.searchEmptyText = 'No scenes match this search';

        $ctrl.getSearchItemLi = getSearchItemLi;
        $ctrl.getSelectedSearch = getSelectedSearch;
        $ctrl.isSelectedSearch = isSelectedSearch;

        $ctrl = new GroupSearchDrpCtrlService($ctrl, hasGroupSearchDrp);

        return $ctrl;

        function getSearchItemLi(item) {
            return $ctrl.SBFieldMethods.getMiniStripRowSchedule(item, item.active);
        }

        function getSelectedSearch(){
            return 'Scene <span ng-bind="$ctrl.item.scene?$ctrl.SBFieldMethods.getSceneText($ctrl.item):\'#…\'"></span>';
        }

        function isSelectedSearch(item){
            return $ctrl.stripId === item._id;
        }
    }
}


