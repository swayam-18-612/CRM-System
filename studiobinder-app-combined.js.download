])
.service('ActivitiesLoadingService', ActivitiesLoadingService);

ActivitiesLoadingService.$inject = ['PreloadingResourceService', 'ActivitiesService'];
function ActivitiesLoadingService(PreloadingResourceService, objectService) {
    return new PreloadingResourceService(objectService, {
        name: 'Activities',
        preloadPopulate: 'createdById',
        tableParamsColsInit: ['companyId']
    });
