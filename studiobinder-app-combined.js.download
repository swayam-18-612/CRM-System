angular.module('product.shots.item.edit.component', [
    'product.shots.item.edit.controller.service'
])
.component('shotEditPopup', popupComponentParams('ShotEditPopupCtrl'))
.controller('ShotEditPopupCtrl', ShotEditPopupCtrl);
ShotEditPopupCtrl.$inject = ['ShotEditPopupCtrlService', '$element'];
function ShotEditPopupCtrl(ShotEditPopupCtrlService, $element) {
    console.log('ShotEditPopupCtrl');
    var $ctrl = this;

    $ctrl.preInitGeneralOther = preInitGeneralOther;
    $ctrl.preSetTemplateDataOther = preSetTemplateDataOther;
    $ctrl.getPopupBodyContent = getPopupBodyContent;

    $ctrl = new ShotEditPopupCtrlService($ctrl, $element);

    function preInitGeneralOther() {
        if(!$ctrl.setupTypeName) {
            $ctrl.setupTypeName = 'Setup';
        }
        if(!$ctrl.setupTypeIcon) {
            $ctrl.setupTypeIcon = 'camera-setup';
        }
        if(!$ctrl.bannerTypeName) {
            $ctrl.bannerTypeName = 'Banner';
        }

        if(!$ctrl.bannerTypeIcon) {
            $ctrl.bannerTypeIcon = 'banner';
        }
        $ctrl.itemname = ($ctrl.item.type === $ctrl.ShotTypes.Shot ? $ctrl.itemTitle : ($ctrl.item.type === $ctrl.ShotTypes.Banner ? $ctrl.bannerTypeName : $ctrl.setupTypeName));
    }
    function preSetTemplateDataOther(){
        $ctrl.icon = ($ctrl.item.type === $ctrl.ShotTypes.Shot ? $ctrl.itemIcon : ($ctrl.item.type === $ctrl.ShotTypes.Banner ? $ctrl.bannerTypeIcon : $ctrl.setupTypeIcon));
        $ctrl.iconLevel = ($ctrl.item.type === $ctrl.ShotTypes.Shot ? $ctrl.iconLevel : 4);
    }

    function getPopupBodyContent() {
        var isMobile = $ctrl.LCS.isMobileSize;
        switch ($ctrl.item.type) {
            case $ctrl.ShotTypes.Shot: return getShot();
            case $ctrl.ShotTypes.Banner: return getBanner();
            case $ctrl.ShotTypes.Setup: return getBreak();
        }

        function getFirstRow(withShotNo, p){
            var isAll = true;
    return '<div class="form-group table-div full-width min-height-80 margin-bottom-40">' +
                 $ctrl.getContentEditable('color', isAll) +
                 $ctrl.getContentEditable('name', isAll, p ? {placeholder: p } : p) +
            '</div>';
        }

        function getBanner() {
            return getFirstRow(false, 'e.g. Load In or Meal Break') +
                getNote() +
                getRow(['prepTime', 'shootTime', 'estTime'], 'col33p pull-left no-margin-bottom');
        }

        function getBreak() {
            return getNote() +
                getRow([
                    // 'date',
                    'time'], 'full-width no-margin-bottom'//'col50p pull-left'
                )
        }

        function getNote(isLast){
            return getRow(['note'], 'full-width min-height-40' + (isLast ? ' no-margin-bottom' : ''), {
                withoutLabelInPopup: false,
                placeholder: 'Short description (optional)…',
                name: 'Description',

                withBottomToolbar: true
            });
        }

        function getShot() {
            var def = p(_.filter($ctrl.columnsList, function (c) {return $ctrl.columnsVisible.indexOf(c.id) !== -1;})),
                restCols = _.filter($ctrl.columnsList, function (c) {return $ctrl.columnsVisible.indexOf(c.id) === -1;}),
                rest = p(restCols),

               el = '<div class="clearfix">' +
                        getFirstRow(true) +
                    '</div>' +

                    (def ? ('<div class="clearfix">' + def +'</div>') : '');

            if(rest) {
             el += '<div ng-show="$ctrl.show">' + rest + '</div>' +

                    '<div class="clearfix">' +
                        '<a class="new-side" ng-click =\'$ctrl.show = $ctrl.show?false:true\'>' +
                        '<div class="sbf pull-left" ng-class="{true:\'arrow-up\', false:\'arrow-down\'}[$ctrl.show == true]" style="margin-right:4px"></div>' +
                        ' <div ng-bind="($ctrl.show?\'Less\' :\'More\')+\' Options\'"></div></a>' +
                    '</div>';
            }

            return el;

            function p(init) {
                var el = '', t = [], j = 0, notesC;
                for (var i = 0, n = init.length; i < n; i++) {
                    var c = init[i];
                    if(c.type === $ctrl.SBFieldTypesService.PropTypes.HtmlTooltip){
                        notesC = c;
                    }else if (c.prop !== 'name' &&
                        c.prop !== 'date' &&
                        c.prop !== 'color' &&
                        c.prop !== 'shotNo' &&
                        c.prop !== 'time' &&
                        c.prop !== 'endTime') {
                        t.push(c);
                        if(j === 1 || i === n-1){
                            j = 0;
                            el += getRow(t, 'col50p pull-left');
                            t = [];
                        }else{
                            j++;
                        }
                    }
                }
                if(notesC){
                    el += getRow([notesC.prop], 'full-width min-height-40 no-margin-bottom', {
                        hideIconOnEdit : true,
                        withBottomToolbar: true
                    });
                }
                return el;
            }
        }

        function getRow(l, cls, other) {
            return $ctrl.getRowCols(l, cls, $ctrl.withLabel, isMobile, other);
        }
    }
}

angular.module('product.shots.item.edit.controller.service', [
    'ctrl.PopupsCtrl.generalItemEdit.service'
])
.service('ShotEditPopupCtrlService', ShotEditPopupCtrlService);
ShotEditPopupCtrlService.$inject = ['GeneralItemEditCtrlService'];
function ShotEditPopupCtrlService(GeneralItemEditCtrlService) {
    return function($ctrl, $element){
        console.log('ShotEditPopupCtrlService');
        $ctrl.isPopup = true;
        
        $ctrl.otherExtraParamProps = ['canEdit', 'currentListId', 'isScheduling', 'scriptLoadingService', 'index', 'sceneNo', 'listTreeService', 'service'];

        $ctrl.ShotTypes = {Shot: 1, Setup: 0, Banner: 2};
        $ctrl.withUncheck = true;

        $ctrl.preSetTemplateData = preSetTemplateData;

        $ctrl.preInitGeneral = preInitGeneral;
        $ctrl.postInitGeneral = postInitGeneral;
        $ctrl.onLoaded = onLoaded;
        $ctrl.getItemType = getItemType;

        $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

        return $ctrl;

        function getItemType(item){
            if(!item){return '';}
            switch (item.type){
                case 0: return $ctrl.setupTypeName;
                case 1: return $ctrl.itemTitle.toLowerCase();
                case 2: return 'banner';
            }
            return '';
        }

        function preInitGeneral() {
            $ctrl.withLabel = true;
            var options = $ctrl.filtersService.options;
            $ctrl.cleanParamType = $ctrl.item.type;

            $ctrl.withCloseBtn = true;

            $ctrl.parentName = $ctrl.extraParam.parent.name;

            if($ctrl.elemType === 'SHOT') {
                $ctrl.setColorSettings();
                $ctrl.columnsList.push($ctrl.getColumnColor());
            }

            $ctrl.columnsVisible = [];

            addC(options.type && options.type.toString() === '3', 'customShotNo', null);
            addC($ctrl.extraParam.treeType === $ctrl.treeTypeCustomList ,'sceneNo', {placeholder: 'Scene #'});

            $ctrl.columnsVisible = $ctrl.columnsVisible.concat(options.columns);

            //todo: enable if characters and locations are used
            //preloadSettings();

            $ctrl.onSaveGeneral = onSaveGeneral;
            if($ctrl.preInitGeneralOther) {
                $ctrl.preInitGeneralOther();
            }
        }

        function addC(cond, prop, other){
            if(!cond){return;}
            var c = _.extend({},
                _.find($ctrl.filtersService.ColumnsList, {prop: prop}), _.extend({
                    canEdit: $ctrl.canEdit,
                    notInModal: false
                }, other));
            $ctrl.columnsList.unshift(c);
            $ctrl.columnsVisible.unshift(c.id);
        }

        function preloadSettings() {
            $ctrl.Settings = _.extend({}, $ctrl.Settings, $ctrl.scriptLoadingService.preloadSettings());
        }

        function postInitGeneral() {
            if ($ctrl.isNew) {
                $ctrl.item.sceneNo = $ctrl.sceneNo;
            }else if (!$ctrl.sceneNo && $ctrl.item && $ctrl.item.sceneNo) {
                $ctrl.sceneNo = $ctrl.item.sceneNo;
            }
        }

        function onLoaded() {
            if($ctrl.canEdit) {
                setFocus();
            }
        }

        function setFocus() {
            var order = $ctrl.extraParam.field;
            if (!order) {
                order = 7;
            }
            if (order) {
                $ctrl.setFocus(order, true);
            }
          //  $ctrl.element.querySelector('#name').focus();
        }

        //todo see if needed
        function onSaveGeneral(result) {
            setFocus();
        }

        function preSetTemplateData() {
            if(!$ctrl.itemname){$ctrl.itemname = $ctrl.itemTitle;}
            var action = ($ctrl.isNew ? 'Add' : 'Save');
            $ctrl.popupTitle =  ($ctrl.isNew ? 'Add' : 'Edit') + ' ' + $ctrl.itemname;
                // + ($ctrl.sceneNo ? (' for Scene ' + $ctrl.sceneNo) : '');
            $ctrl.subtitle = $ctrl.parentName;
            if($ctrl.subtitle){$ctrl.subtitle = $ctrl.subtitle.replace('|', '<span class="gray-lighter">|</span>');}
            $ctrl.textAnalytics = action + ' ' + $ctrl.itemname;
            $ctrl.btnText = '<span>' + action + '</span>' + '<span class="hide-ipad"> ' + $ctrl.itemname+'</span>';
            if ($ctrl.isNew) {
                $ctrl.with2FooterBtns = $ctrl.CPS.hasQuotaType('shotList');
            }
            $ctrl.modalBodyFormClass = 'med2';
            if(typeof($ctrl.preSetTemplateDataOther) === 'function'){
                $ctrl.preSetTemplateDataOther();
            }
        }
    }
}

angular.module('product.shots.item.remove.component', [
