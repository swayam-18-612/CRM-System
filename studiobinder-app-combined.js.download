GroupDrpFiltersCtrl.$inject = ['FiltersCtrlService', '$element'];
function GroupDrpFiltersCtrl(FiltersCtrlService, $element) {
    var $ctrl = this;
    $ctrl.element = $element[0];
    console.log('GroupDrpFiltersCtrl');

    $ctrl.hideFilters = false; //hide page filter and display the group filters
    $ctrl.filtersClass = 'small';

    $ctrl.select = select;
    $ctrl.$onInit = $onInit;
    $ctrl.$onDestroy = $onDestroy;

    function $onInit() {
        if(!$ctrl.drpClassAttr){$ctrl.drpClassAttr = 'drpProjectsFilter'}
        $ctrl = new FiltersCtrlService($ctrl);
        if (!$ctrl.filterProp) {
            $ctrl.filterProp = $ctrl.filtersService.DefaultFilterProp;
        }
        if ($ctrl.selectedFilter !== undefined) {
            $ctrl.filtersService[$ctrl.filterProp] = $ctrl.selectedFilter;
        }

        $ctrl.elBtnFilters = $ctrl.element.querySelector('#btnFilters');
        if ($ctrl.elBtnFilters && $ctrl.selectedClass) {
            $ctrl.LCS.addClass($ctrl.elBtnFilters, $ctrl.selectedClass);
        }

        $ctrl.elText = $ctrl.element.querySelector('#btnFilters .txt');
        $ctrl.elList = $ctrl.element.querySelector('.listitems-selector');
        $ctrl.F = $ctrl.getFilters($ctrl.filterProp);

        var el = '';
        _.each($ctrl.F, function (item) {
          el += '<li>' +
                    '<a data-id="' + item.value + '">' +
                        '<div class="with-padding-right with-ellipsis">'+getText(item, true)+'</div>' +
                        '<div class="checkmark centered">'+$ctrl.LCS.getISBDiv('check-mark', null, 'primary')+'</div>' +
                    '</a>' +
                '</li>';
        });
        $ctrl.LCS.appendChildFragment($ctrl.elList, el);

        setSelected();
        bind(true);
    }

    function bind(isBind) {
        if($ctrl.elList) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.elList.querySelectorAll('a'), select);
        }
    }

    function select(e) {
        selectById(e.currentTarget.getAttribute('data-id'));
    }

    function selectById(id) {
        var item = _.find($ctrl.F, function (item) {
            return (item.value === undefined ? 'undefined' : (item.value === null ? 'null' : item.value.toString())) === id;
        });
        if (item) {
            $ctrl.selectedId = id;
            $ctrl.selectedText = getText(item);
            $ctrl.changeFilter(item.value, $ctrl.filterProp);
            check();
        }
    }

    function setSelected() {
        var item = _.find($ctrl.F, function (item) {
            return $ctrl.filtersService[$ctrl.filterProp] === item.value;
        });
        if (item) {
            $ctrl.selectedId = item.value;
            $ctrl.selectedText = getText(item);
            check();
        }
    }

    function check() {
        set($ctrl.prevSelectedId, false);
        set($ctrl.selectedId, true);

        $ctrl.prevSelectedId = $ctrl.selectedId;

        if ($ctrl.prevText) {
            $ctrl.LCS.removeClass($ctrl.elSelIcon, $ctrl.prevText);
        }

        if ($ctrl.elText && $ctrl.selectedText !== $ctrl.prevText) {
            $ctrl.elText.textContent = $ctrl.selectedText;
        }
        $ctrl.prevText = $ctrl.selectedText;

        function set(id, isAdd) {
            if ($ctrl.elList) {
                $ctrl.LCS[isAdd ? 'addClass' : 'removeClass']($ctrl.elList.querySelector("li a[data-id='" + id + "']"), 'active');
            }
        }
    }

    function $onDestroy() {
        $ctrl.removeWatchers();
        bind();
    }

    function getText(item, isFull) {
        var t = item.text,
            t1 = $ctrl.ext!==undefined ?  $ctrl.ext : (isFull ? ( $ctrl.itemTitle + 's') :  ($ctrl.LCS.isMobileSize ? '' : ( $ctrl.itemTitle + 's')));
        return t + (t.indexOf(t1) === -1 ? (' ' + t1) : '');
    }
}

angular.module('filters.init.component',[
    'filters.groupDrp.component',
    'filters.groupZoom.component',
    'filters.controller.service'
])
.component('groupViewFilters', {
    bindings: {
        isPrintLayout: '<',
        isInTreeModal: '<',
        cls:'@',
        elemType: '@',
        title: '@',
        filtersService: '<',
        viewFilters:'<'
    },

    controller: 'GroupFiltersCtrl'
})

.controller('GroupFiltersCtrl', GroupFiltersCtrl);

GroupFiltersCtrl.$inject = ['TemplateCompileCompCtrlService', 'FiltersCtrlService', '$element'];
function GroupFiltersCtrl(TemplateCompileCompCtrlService, FiltersCtrlService, $element) {
    console.log('GroupFiltersCtrl');
    var $ctrl = this;

    $ctrl.name = 'View Type';
    $ctrl.btnId = 'btnColumns';

    $ctrl.shotFilters = {
        p: 'view',

    }
    $ctrl.defaultFilters = {
        p: 'view',
        f: 'ViewModes'
    };

    $ctrl.columnFilters = {
        p: 'column',
        f: 'ColumnsPerRow'
    };

    $ctrl.LayoutTypes = {columnsLayout: 1, printLayout: 2, shotsLayout:3};

    $ctrl.preInit = preInit;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;
    $ctrl.onLoaded = onLoaded;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
       // 'shotsLayout'

        //Default
        //Larger Images
        //Text Only


        $ctrl.isForPrint = $ctrl.isPrintLayout || $ctrl.viewFilters === 'printLayout';
        $ctrl.filters = getFilter($ctrl.isForPrint);

        $ctrl = new FiltersCtrlService($ctrl);
        $ctrl.dontAutoloadTemplate = $ctrl.filtersService.isOptionsInit ? false : true;

        $ctrl.addRootWatcher('FILTERS_OPTIONS_SET' + getPrefix() + '_' + $ctrl.filtersService.filtersServiceId, $ctrl.reloadTemplate);

        $ctrl.addRootWatcherSimple($ctrl.LCS.onIsMobileSizeChanged(onIsMobileSizeChanged));
    }

    function getPrefix(){
        return ($ctrl.isPrintLayout ? '_PRINT_LAYOUT' : '') +
            ($ctrl.isInTreeModal ? '_TREE_MODAL' : '');
    }

    function getItemTemplate(){
return '<div dropdown class="position-relative dropdown dropdown-wrapper">' +
            '<button id="'+$ctrl.btnId+'" type="button" class="btn btn-small primary-faded without-text dropdown-toggle long" dropdown-toggle><div class="pull-left sbf ic"><span class="sbp p1"></span><span class="sbp p2"></span></div> <div class="sbf blue pull-right arrow-filled-down"></div></button>' +
            '<div class="dropdown-menu side-menu fadeInDownLeft drpProjectsFilter2" role="menu">' +
                '<div class="header-small clearfix with-side-padding30">'+$ctrl.name+'</div>'+
                '<ul class="listitems-selector with-checked">'+ getItems() + '</ul>' +
            '</div>'+
        '</div>';
    }

    function getItems() {
        var el = '', f;
            if($ctrl.isForPrint){
                f = getFilter(false);
                add(f.p, getL(f)[0]); //ListView
            }
            f = getFilter($ctrl.isForPrint || $ctrl.viewFilters === 'columnsLayout');
            _.each(getL(f), function (item){
                add(f.p, item);
            });
        return el;

        function add(prop, item) {
            if(!item.isHeader) {
              el += '<li>' +
                        '<a class="table-div full-width" data-id="' + item.id + '_'+prop+'">' +
                  (prop==='column' ? '' :
                            ('<div class="col30">' + $ctrl.LCS.getISBDiv(item.icon, item.iconLevel ?item.iconLevel:2 ) + '</div>')) +
                            '<div class="with-ellipsis with-padding-right">' + item.name.replace('Frame', 'Column') + '</div>' +
                            '<div class="checkmark">' + $ctrl.LCS.getISBDiv('check-mark', null, 'primary') + '</div>' +
                        '</a>' +
                    '</li>';
            }
        }
    }

    function getFilter(isForPrint){
        return isForPrint ? $ctrl.columnFilters : $ctrl.defaultFilters;
    }

    function getL(filters){
        return $ctrl.filtersService.Settings[filters.f];
    }

    function setSelected() {
        var isGrid = $ctrl.filtersService.checkGridView(),
            l = $ctrl.isForPrint ? [isGrid ? $ctrl.filters : $ctrl.defaultFilters, isGrid ? $ctrl.defaultFilters : $ctrl.filters]
        : [$ctrl.filters];
        if(!set(l[0])){
            if($ctrl.isForPrint) {
                set(l[1]);
            }
        }

        function set(f) {
            var item = _.find(getL(f), function (item) {
                return $ctrl.filtersService.hasProp(item.id, f.p);
            });
            return setSel(f.p, item, false);
        }
    }

    function selectById(id, prop, isSet) {
        var item = _.find(getL(prop==='column' ? $ctrl.columnFilters : $ctrl.defaultFilters), function (item) {
                return item.id.toString() === id.toString();
            });
        return setSel(prop, item, isSet);
    }

    function setSel(prop, item, withSet){
        if(item){
            $ctrl.selectedId = item.id + '_' + prop;
            $ctrl.selectedIcon = item.icon;
            if(withSet) {
                $ctrl.changeProp(null, item.id, prop);
            }
            check();
            return true;
        }
        return false;
    }

    function onLoaded() {
        $ctrl.elSelIcon = $ctrl.element.querySelector('#'+$ctrl.btnId+' .sbf.ic');
        $ctrl.elList = $ctrl.element.querySelector('.listitems-selector');
        setSelected();
        bind(true);
        if($ctrl.cls) {
            $ctrl.LCS.addClass($ctrl.element.querySelector('.dropdown-menu'), $ctrl.cls);
        }
    }

    function bind(isBind) {
        if(!$ctrl.elList){return;}
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.elList.querySelectorAll('a'), select);
    }

    function select(e) {
        var str = e.currentTarget.getAttribute('data-id').split('_');
        selectById(str[0], str[1], true);
    }

    function check() {
        set($ctrl.prevSelectedId, false);
        setI($ctrl.prevIcon, false);

        set($ctrl.selectedId, true);
        setI($ctrl.selectedIcon, true);

        $ctrl.prevSelectedId = $ctrl.selectedId;
        $ctrl.prevIcon = $ctrl.selectedIcon;

        function set(val, isAdd){
            if(val) {
                $ctrl.LCS[isAdd ? 'addClass' : 'removeClass']($ctrl.elList.querySelector("li a[data-id='" + val + "']"), 'active');
            }
        }

        function setI(val, isAdd){
            if(($ctrl.viewFilters !== 'columnsLayout' ||
               $ctrl.viewFilters === 'columnsLayout' && isAdd && val === 'storyboard-grid') && val) {
                $ctrl.LCS[isAdd ? 'addClass' : 'removeClass']($ctrl.elSelIcon, val);
            }
        }
    }

    function onDestroy() {
        bind(false);
    }

    function onIsMobileSizeChanged(isMobileSize) {
        //console.log('onIsMobileSizeChanged');
        //set one column grid view mode for noListModeOnMobile -> storyboard and grid vie
        if (isMobileSize){
            var isSet = true,
                prop = 'view',
                v = $ctrl.filtersService.noListModeOnMobile ? 3 : 2;

            if($ctrl.selectedId !== (v + '_' + prop)) {
                selectById(v, prop, isSet);
            }

            v = 1;
            prop = 'column';
            if($ctrl.filtersService.noListModeOnMobile){
                selectById(v, prop, isSet);
            }
        }
    }
}

angular.module('filters.groupZoom.component',[
    'filters.controller.service'
])
.component('groupZoomFilters', {
    bindings: {
        isPrintLayout: '<',
        isInTreeModal: '<',
        elemType: '@',
        currentZoomedTable: '@',
        filtersService: '<',
    },
