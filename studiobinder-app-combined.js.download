    return builder.build();
}
angular.module('gantt.header.factory', [])
    .factory('GanttHeader', GanttHeaderFactory);
GanttHeaderFactory.$inject = ['GanttHeaderColumns'];
function GanttHeaderFactory(HeaderColumns) {
