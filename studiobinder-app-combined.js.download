angular.module('public.others', [
    'public.others.routing'
]);
angular.module('public.others.component', [
    'public.home.controller.service'
])
.component('others', {
    controller:'OthersController',
    bindings: {
        type: '<'
    }
})
.controller('OthersController', OthersController);
OthersController.$inject = ['HomeCtrlService', '$element'];
function OthersController(HomeCtrlService, $element) {
    var $ctrl = this;

    $ctrl.getHomeTemplate = getHomeTemplate;

    $ctrl = new HomeCtrlService($ctrl, $element, true);

    function getHomeTemplate() {
        var template = '';
        switch ($ctrl.type) {
            case '404':
                return '<h1 class="text-center spacing">Page Not Found</h1>' +
                    '<p class="spacing-bottom text-center" style="margin-left:24px;margin-right: 24px">We\'re sorry, but this page is not available anymore.<br/> Go back to our <a analytics-category=\'Page 404\' analytics-on analytics-action=\'Go Home\' href="/">homepage</a> to learn more about StudioBinder.</p>';

            case '405':
                return '<h1 class="text-center spacing">Page Not Found</h1>' +
                    '<p class="spacing-bottom text-center" style="margin-left:24px;margin-right: 24px">We\'re sorry, but this page is not available anymore.<br/> Go back to our <a analytics-category=\'Page 405\' analytics-on analytics-action=\'Go Home\' href="/">homepage</a> to learn more about StudioBinder.</p>';

            case 'access-denied':
                return '<h1 class="text-center spacing">Unauthorized</h1>' +
                    '<p class="spacing-bottom text-center" style="margin-left:24px;margin-right: 24px">We\'re sorry, but this invite is not available anymore.<br/> Go back to our <a analytics-category=\'Access Denied\' analytics-on analytics-action=\'Go Home\' href="/">homepage</a> to learn more about StudioBinder.</p>';
        }
        return template;
    }
}

