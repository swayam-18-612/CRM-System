angular.module('components.printButton.controller.service', [
    'components.sbPrintPdfViewer'
])
.service('PrintButtonCtrlService', PrintButtonCtrlService);
PrintButtonCtrlService.$inject = [ 'TemplateCompileCompCtrlService'];
 function PrintButtonCtrlService(TemplateCompileCompCtrlService) {
     return function ($ctrl, $element) {
        var withoutTemplateScope = true;

         if (!$ctrl.getItemTemplate) {
             console.warn('Parent for PrintButtonCtrlService must define method getItemTemplate');
         }

         var pdfViewerId = 'sbPdfViewer';

         $ctrl.openPrintPopup = openPrintPopup;
         $ctrl.preInit = preInit;
         $ctrl.onDestroy = onDestroy;
         $ctrl.onLoaded = onLoaded;

         $ctrl = new TemplateCompileCompCtrlService($ctrl, $element, withoutTemplateScope);

         return $ctrl;

         function preInit() {
             $ctrl.btnTextS = $ctrl.btnText ? $ctrl.btnText : 'Print';
             $ctrl.btnClassS = $ctrl.btnClass || '';

             var options = {}, //$ctrl.options???
                 InchInPixels = 96,
                 LetterViewport = {width: 816, height: 1056},
                 PortraitViewport = 'portrait',
                 setup = {
                     viewportSize: _.extend({deviceScaleFactor: 3}, options.viewportSize ? options.viewportSize : LetterViewport),
                     orientation: options.orientation ? options.orientation : PortraitViewport,

                     mT: options.mT ? options.mT : InchInPixels,
                     mB: options.mB ? options.mB : InchInPixels,
                     mL: options.mL ? options.mL : 0,
                     mR: options.mR ? options.mR : 0,
                 };

             setup.contentHeight = setup.viewportSize.height - setup.mT - setup.mB; //864
         }

         function removeUploader() {
             if ($ctrl.compilePrintView) {
                 $ctrl.compilePrintView.destroyNewScope();
             }
         }

         function onDestroy() {
             bind(false);

             removeUploader();
         }

         function onLoaded() {
             if($ctrl.customPrint) {
                 bind(true);
                 $ctrl.addRootWatcher('REMOVE_PRINT_POPUP', removeUploader);
             }
         }

         function bind(isBind) {
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.LCS.bodyElement, onPrintKey, 'print', 'keydown');
            $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('#btnPrint'), print);
         }

         function print(e) {
             $ctrl.preventDefault(e);
             if(typeof($ctrl.onPrint) === 'function') {
                 $ctrl.onPrint();
             }
         }

         //todo bring these back and improve
         function onPrintKey(e) {
             console.log('onPrintKey');
             if (e && (e.keyCode === 80) && (e.metaKey || e.ctrlKey) ) {

                 print(e);

                 $ctrl.preventDefault(e);
                 $ctrl.openPrintPopup();
             }
         }

         function openPrintPopup() {
             if($ctrl.LCS.bodyElement.querySelector('#' + pdfViewerId)){
                 return;
             }
             if (!$ctrl.options) {
                 $ctrl.options = {};
             }
             if (!$ctrl.options.metadata) {
                 $ctrl.options.metadata = generateMetadata();
             }

             if (!$ctrl.compilePrintView) {
                 $ctrl.compilePrintView = new $ctrl.TemplateCompileService(angular.element($ctrl.LCS.bodyElement), getPdfViewerTemplate, $ctrl);
             }

             $ctrl.compilePrintView.loadTemplate(onLoaded);

             function onLoaded() {

             }

             function getPdfViewerTemplate() {
                 return '<sb-print-pdf-viewer id="' + pdfViewerId + '" options="::$ctrl.options"></sb-print-pdf-viewer>';
             }

             function generateMetadata() {
                 $ctrl.product = $ctrl.CurrentProduct.getProduct();
                 return {
                     title: 'Title', //PRoject NAme
                     subject: 'This is the subject', //pageNAme
                     author: 'James Hall', //userNAme
                     //  keywords: 'generated, javascript, web 2.0, ajax',
                     creator: 'MEEE' //companyName
                 };
             }
         }

         function evalPageLength(setup) {
             console.log('evaluate');

             var ContentHeight = setup.contentHeight,
                 LineHeight = setup.fontSize,
                 OneEightHeight = ContentHeight / 8,
                 LinesPerPage = 52,
                 LinesPerPageThreshold = LinesPerPage,
                 sceneClass = SBScriptEditorClass+'0'; //for now always move to next page
             // 3;//setup.contentHeight / LineHeight; //54lines - > final draft has about 52

             var divs = [], pages = [], pageLengths = {}, strips = [], //{},
                 els = document.querySelectorAll('.scene-wrapper > div'), l = els.length;
             if (l > 0) {
                 var currentPage = addNewPage(),
                     currentScene = {stripId: 0, page: 1};
                 for (var i = 0; i < l; i++) {
                     var el = els[i];
                     var node = {id: el.getAttribute('id'), height: getBlockHeight(el)};
                     var nLines = node.height / LineHeight;
                     var remainingLinesPerPage = LinesPerPage - currentPage.lines;
                     if (remainingLinesPerPage > nLines) { //can fit the entire block
                         setNodePage();
                     } else {
                         if (remainingLinesPerPage < LinesPerPageThreshold) { //if there are less then thr -> move the block on next page
                             addPageBreakBefore(el); //add page break before node
                             currentPage = addNewPage(currentPage); //add new page
                             setNodePage();
                         } else {
                             var nodeLinesOnCurrentPage = remainingLinesPerPage;
                             var nodeLinesOnNextPage = nLines - remainingLinesPerPage;
                             //break block on 2 pages : toDO
                         }
                     }

                     function setNodePage() {
                         currentPage.lines += nLines;
                         node.page = currentPage.id;
                     }

                     if (el.classList.contains(sceneClass)) {
                         var stripId = el.getAttribute('data-strip'),
                             isFirstScene = currentScene.stripId === 0;
                         node.isScene = true;
                         node.stripId = stripId;
                         if (isFirstScene && i > 0) { //set the strip id for prev strips to be the first strip
                             for (var j = 0; j < i; j++) {
                                 divs[j].stripId = stripId;
                             }
                         }
                         currentScene = {
                             stripId: stripId,
                             page: isFirstScene ? 1 : node.page
                         };
                         strips[stripId] = currentScene;
                         //if is first than take page number as one otherwise take first number from  the scene node
                         strips.push(currentScene);
                     }
                     node.stripId = currentScene.stripId; //currentScene.stripId;
                     divs.push(node);
                 }
                 //compute scene page length
                 if (divs && divs.length > 0) {
                     //for(var stripId in strips){
                     for (var i = 0, n = strips.length; i < n; i++) {
                         var strip = strips[i]
                         var stripId = strip.stripId;
                         var pagesX = {}, h = 0;
                         for (var j = 0, m = divs.length; j < m; j++) {
                             var node = divs[j];
                             if (node.stripId === stripId) {
                                 var pg = node.page;
                                 if (!pagesX[pg]) {
                                     pagesX[pg] = 0;
                                 }
                                 pagesX[pg] += node.height;
                             }
                         }
                         for (var pg in pagesX) {
                             h += pagesX[pg];
                         }
                         //stripid is string -> not nec to use ScriptUtils.setObjsById
                         pageLengths[stripId] = {pages: getEights(h), page: strip.page};
                     }

                     function getEights(ph) {
                         return ph ? (Math.ceil(ph / OneEightHeight) * 0.125) : 0;
                     }
                 }
             }
             /* var r = {pageLengths:pageLengths};
             if (l > 0) {
                 var content = document.querySelector('.scene-wrapper').innerHTML;
                 if (content) {
                     r.content = content;
                     console.log(content);
                 }
             }*/
             return {pageLengths: pageLengths};

             function addNewPage(currentPage) {
                 var newPage = {id: (currentPage ? currentPage.id : 0) + 1, height: 0, lines: 0};
                 pages.push(newPage);
                 return newPage;
             }

             function insertNodeBefore(node, newN) {
                 if (node.previousSibling) {
                     node.parentNode.insertBefore(newN, node.previousSibling);
                 }
             }

             function addPageBreakBefore(el, isAfter) {
                 var method = isAfter ? insertNodeBefore : insertNodeAfter,
                     newEl = document.createElement('div');
                 newEl.className = 'page-break';
                 method(el, newEl);
             }

             function insertNodeAfter(node, newN) {
                 if (node.nextSibling) {
                     node.parentNode.insertBefore(newN, node.nextSibling);
                 }
             }

             function getBlockHeight(el) {
                 var height = el.getBoundingClientRect().height, style = window.getComputedStyle(el);
                 // height: element height + vertical padding & borders
                 // now we just need to add vertical margins
                 height = ["top", "bottom"]
                     .map(function (side) {
                         return parseInt(style['margin-' + side], 10);
                     })
                     .reduce(function (total, side) {
                         return total + side;
                     }, height);
                 return height;
             }
         }
     }
 }

