FooterUnloggedCtrl.$inject = ['TemplateCompileCompCtrlService', '$element'];
function FooterUnloggedCtrl(TemplateCompileCompCtrlService, $element) {
    var $ctrl = this;

    $ctrl.preInit = preInit;
    $ctrl.onLoaded = onLoaded;
    $ctrl.getItemTemplate = getItemTemplate;
    $ctrl.onDestroy = onDestroy;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        $ctrl.imgPaths = $ctrl.LCS.imgPaths;
        $ctrl.wwwUrl = $ctrl.LCS.wwwUrl;
        $ctrl.year = (new Date()).getFullYear();
    }

    function onLoaded() {
        bind(true);
    }

    function onDestroy() {
        bind(false);
    }

    function bind(isBind) {
        $ctrl.LCS.bindElementsClick(isBind, $ctrl.element.querySelector('#aContact'), openContactPopup, 'footer-contact');
    }

    function getItemTemplate() {
        return '<div class="spacing-double">' +
            '<div class="spacing">' +
                '<div class="centering">' +
                    '<a href="'+$ctrl.wwwUrl+'"><img style="height:32px" class="img-responsive grayscale" src="'+$ctrl.imgPaths+'studiobinder-footer.svg"/></a>' +
                    '<div class="footer-bottom text-center spacing-half-bottom">' +
                        /* 'Design + Code by <a class="white" target="_blank" href="http://leanometry.com" analytics-category="Footer" analytics-on analytics-action="Leanometry">Leanometry</a><br/>' */
                        '<span class="small">&copy;'+$ctrl.year+' StudioBinder Inc.</span>' +
                    '</div>' +
                '</div>' +
            '</div>' +
            '<div class="clearfix">' +
                '<div class="pull-left">' +
                    '<ul class="feed-left">' +
                        '<li><h3>Learn More</h3></li>' +
                        '<li>' +
                            '<a href="/pricing" analytics-category="Footer" analytics-on analytics-action="Pricing & Plans">Pricing & Plans</a>' +
                        '</li>' +
                        '<li>' +
                            '<a id="aContact" analytics-category="Footer" analytics-on analytics-action="Header Contact" >Contact</a>' +
                        '</li>' +
                    '</ul>' +
                '</div>' +
                '<div class="pull-left">' +
                    '<ul class="feed-left">' +
                        '<li><h3>About</h3></li>' +
                        '<li>' +
                            '<a target="_blank" href="'+$ctrl.wwwUrl+'/blog" analytics-category="Footer" analytics-on analytics-action="Blog">Blog</a>' +
                        '</li>' +
                        '<!--    <li>' +
                                '<a href="" analytics-category="Footer" analytics-on analytics-action="Press Kit">Press Kit</a>' +
                            '</li>   -->' +
                    '</ul>' +
                '</div>' +
                '<div class="pull-left">' +
                    '<ul class="feed-left">' +
                        '<li><h3>Support</h3></li>' +
                        '<li>' +
                            '<a target="_blank" href="https://support.studiobinder.com" analytics-category="Footer" analytics-on analytics-action="Help Center" >Help Center</a>' +
                        '</li>' +
                        '<li>' +
                            '<a target="_blank" href="'+$ctrl.wwwUrl+'/tos" analytics-category="Footer" analytics-on analytics-action="Terms of Service">Terms of Service</a>' +
                        '</li>' +
                        '<li>' +
                            '<a target="_blank" href="'+$ctrl.wwwUrl+'/privacy" analytics-category="Footer" analytics-on analytics-action="Privacy Policy">Privacy Policy</a>' +
                        '</li>' +
                    '</ul>' +
                '</div>' +
            '</div>' +
        '</div>';
    }

    function openContactPopup(e) {
        $ctrl.preventDefault(e);
        $ctrl.popupsService.open(null, $ctrl.popupsService.operations.contactUs);
    }
}

angular.module('user.layoutUnlogged.component', [
