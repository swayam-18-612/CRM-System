addMoSePa('Contacts', 'cast', TempContactsService, {
    modelMethod: ContactsFactory,
    serviceInjectList: ['ContactProfiles', 'ContactsConstantsService'],
    serviceInjectMod:[
        'resources.ContactProfiles',
        'apiConstants.product.contacts.services'
    ]
});

function ContactsFactory(ApiResource) {
    var model = ApiResource(SBApiCollections.Contacts, 'contacts');

    model.prototype.getName = function () {
        return (this.name ? this.name : this.email);//+ ' (' + this.order + ')';
    };

    return model;
}

function TempContactsService(ApiService, model, ContactProfiles, ContactsConstantsService) {
    var service = ApiService(model, {
        listType: 'isGroup',
        listField: 'contactListId',

        fieldsUpdatedOnOrderChanged: ['orderLists'],
        convertOtherResources: convertOtherResources
    });
    service.ContactProfiles = ContactProfiles;
    service.ContactsConstantsService = ContactsConstantsService;
    service.ContactTypes= ContactsConstantsService.ContactTypes;
    service.CastRoles= ContactsConstantsService.CastRoles;

    service.getChangedFieldForUpdateOther = getChangedFieldForUpdateOther;

    service.validateEmail = validateEmail;
    service.deleteBulk = deleteBulk;
    service.addContactsToList = addContactsToList;
    service.addEmailContacts = addEmailContacts;
    service.search = search;
   // service.searchContactsNotInList = searchContactsNotInList;
   // service.searchProjectContacts = searchProjectContacts;
    service.delete = deletex;
    service.sendMessage = sendMessage;

    service.validateNumber = validateNumber;
    service.getContactsByTable = getContactsByTable;
    service.getEditableFields = getEditableFields;

    service.getType = getType;
    service.getExistingLists = getExistingLists;
    service.getItemRoles = getItemRoles;
    service.getItemRate = getItemRate;
    service.getCastForCurrentUser = getCastForCurrentUser;

    return service;

    function getItemRoles(item, contactListId) {
        var roles = item.roles ? item.roles : [];
        if (!contactListId) {
            return roles;
        }
        //inherit from parent if there are no roles in project list
        var list = item.contactLists ? item.contactLists['c_' + contactListId] : null;
        return list && list.roles ? list.roles : [];
        //return list && list.roles && list.roles.length > 0 ? list.roles : roles;
    }

    function getItemRate(item, contactListId) {
        var rate = item.rate ? item.rate : [];
        if (!contactListId) {
            return rate;
        }
        //inherit from parent if there are no rate in project list
        var list = item.contactLists ? item.contactLists['c_' + contactListId] : null;
        return list && list.rate ? list.rate : [];
        //return list && list.rate && list.rate.length > 0 ? list.rate : rate;
    }

    function getExistingLists(item) {
        var existing = [];
        var lists = item.contactLists;
        if (lists) {
            for (var prop in lists) {
                existing.push(prop.split('_')[1]);
            }
        }

        return existing;
    }

    function getType() {
        return 'contact';
    }
    function convertOtherResources(item) {
        if (item.userId && typeof(item.user) === 'object') {
            item.user = new service.Users(item.userId);
            item.user = item.userId._id;
        }
        if (item.profileId && typeof(item.profileId) === 'object') {
            item.profile = new ContactProfiles(item.profileId);
            item.profileId = item.profileId._id;
        }
        if (item.castId && typeof(item.castId) === 'object') {
            item.cast = new model(item.castId);
            item.castId = item.castId._id;
        }

        model.loadImageProp(item, 'profilePictureURL');
        return item;
    }

    function getEditableFields(){
        return ['name', 'profilePictureURL', 'phone', 'email', 'note', 'roles', 'rate', 'contactLists'];
    }

    function getChangedFieldForUpdateOther(){
        return ['note', 'email', 'phone', 'name', 'orderLists', 'roles', 'contactLists', 'profilePictureURL', 'profilePictureURLId', 'rate'];
    }

    function validateEmail( email, successcb, errorcb ) {
        var params = {email: email};
        return service.postUrl('/validate-email', params, successcb, errorcb);
    }

    function deleteBulk(params, successcb, errorcb ) {
        return service.postUrl('/remove-selected', params, successcb, errorcb, true);
    }

    function addContactsToList(params, successcb, errorcb ) {
        return service.postUrl('/add-contacts-to-list', params, successcb, errorcb, true);
    }

    function addEmailContacts(data , successcb, errorcb ) {
        return service.postUrl('/add-email-contacts', data, successcb, errorcb, true);
    }

    //not used
    function search(params, successcb, errorcb) {
        return service.postUrl('/search-all', params, successcb, errorcb);
    }

    function deletex(params,successcb, errorcb){
        return service.postUrl('/remove-selected', params, function(result){
            return successcb(result && result.length > 0 ? {item: result[0], type: 'contact'} : null);
        }, errorcb, true);
    }

    function updateRate(data, successcb, errorcb) {
        return service.postUrl( '/update-rate', data,  successcb, errorcb, true);
    }

    function getCastForCurrentUser(params, successcb, errorcb) {
        return service.postUrl('/get-cast-for-current-user', params,  successcb, errorcb, true);
    }

    function sendMessage(data, successcb, errorcb) {
        return service.$post('/send-contact-message', data, successcb, errorcb);
    }

    function validateNumber(data, successcb, errorcb) {
        return service.$post('/sms/validate-number', data, successcb, errorcb);
    }

    //groupFilters
    function getContactsByTable(q, type, tableParams) {
        var str = '',  productContactListId,
            callsheetId = q.callsheetId;
        if (callsheetId) {
            delete q.callsheetId;
            if(q.isCallsheetInvitation){
                delete q.isCallsheetInvitation;
            }else {
                productContactListId = q.productContactListId ? q.productContactListId : null;
                if (!productContactListId) {
                    return false;
                }
                var contactIds = q.contactIds;
                if (contactIds) {
                    var txt = contactIds.map(function (id) {
                        return '"' + id + '"';
                    }).join(',');
                    str += 'if(_.contains([' + txt + '], el._id)){return false;}';
                }
                delete q.contactIds;
            }
            delete q.productContactListId;
        }else{
            productContactListId = q.productContactListId ? q.productContactListId : null;
        }
        processRoles(productContactListId);
        // if(str){console.log(str);}
        return (str&&str.trim() !== '') ? eval('(function(el) {'+str+'return true;})') : null;

        function processRoles(productContactListId){
            var  roles,
                depId = q.depId;
            if (q.contactListId && q.contactListId.length > 12) {//custom list
                //custom lists must be added
                isInList(q.contactListId);
            } else {
                if (productContactListId) {
                    isInList(productContactListId);
                }
                roles = q.contactListId;
                if (roles === 'All') {
                    roles = null;
                }
            }

            if (roles) {
                if (productContactListId) {
                    str += 'var list=el.contactLists?el.contactLists.c_' + productContactListId + ':null;'
                }
                str += 'var roles=' + (productContactListId ? '(list?list:el)' : 'el') + '.roles;';
                if (productContactListId) {//if roles are not defined for product use default roles
                    str += 'if(list && !roles){roles = el.roles;}';
                }
                if (roles === 'Unassigned') {
                    str += 'if(roles){return false;}';
                } else {
                    str += 'if(!roles){return false;}';
                    str += 'var match=_.filter(roles,function(item){' +
                        'return item.type.toString()==="' + roles + '"' + (roles === '2' ? (depId === undefined ? '' : ('&&' + (depId === 0 ? '!item.depId' : 'item.depId===' + depId))) : '') + ';' +
                        '});' +
                        //  'console.log(match.length);'
                        'if(!match||match.length===0){return false;}';
                }
            }
        }

        function isInList(listId){
            str += 'var list=el.contactLists?el.contactLists.c_' + listId + ':null;if(!list){return false;}';
        }
    }

    function sortCrew(data, cast, contactListId, depId, done, withPositions) {
        var newresult = {}, hasCustom = false,
            depIds = [], posIds = [], castList = {}, unassigned = [];

        _.each(cast, function (item) {
            var id = item._id,
                r = (contactListId ? item.contactLists['c_' + contactListId] : item).roles;
            if (r && r.length > 0) {
                for (var i = 0, l = r.length; i < l; i++) {
                    var el = r[i];
                    if (el.type === 2) {
                        //get new or old
                        var dId = el.depId, pId = el.posId;
                        if (dId) {
                            //check if dep and pos are to be added to the list
                            if (_.find(depIds, function (d) {
                                return d === dId;
                            }) === undefined) {
                                var isNull = depId === undefined || depId === null;
                                if (isNull || !isNull && (depId === dId)) {
                                    depIds.push(dId);
                                }
                                posIds.push(pId);
                            } else if (_.find(posIds, function (d) {
                                return d === pId;
                            }) === undefined) {
                                posIds.push(pId);
                            }
                            // add the new cast to result list
                            if (!newresult['d_' + dId]) {
                                newresult['d_' + dId] = [];
                            }
                            newresult['d_' + dId].push({posId: pId, id: id});
                        } else { //custom
                            if (!newresult.d_0) {
                                hasCustom = true;
                                newresult.d_0 = [];
                            }
                            newresult.d_0.push({posId: 0, id: id});
                        }
                    }
                }
            } else {//unassigned
                if (_.find(unassigned, function (d) {
                    return d === id;
                }) === undefined) {
                    unassigned.push(id);
                }
            }
            castList[id] = item;
        });

        //get deps & pos
        if (depId !== 0) {
            var departments = result2.departments && result2.departments.length > 0 ? result2.departments : [], //sorted
                positions = result2.positions && result2.positions.length > 0 ? result2.positions : [];

            //add custom position from previous app versioning
            if (hasCustom && (depId === undefined || depId === null)) {
                departments.push({_id: 0, depId: 0, name: 'Custom'});
            }

            //deal with positions
            var k = 0;
            _.each(departments, function (dep) {
                var pos = newresult['d_' + dep.depId];
                if (pos && pos.length > 0) {
                    if (dep.depId !== 0) {
                        //get positions
                        var processPos = function (i) {
                            var posId = pos[j].posId;
                            pos[j].position = _.find(positions, function (p) {
                                return p.posId === posId;
                            });
                        };
                        for (var j = 0, l = pos.length; j < l; j++) {
                            processPos(i);
                        }

                        //sort positions
                        pos = pos.sort(function (a, b) {
                            if (!a.position || !a.position.order) {
                                a.order = 0;
                            } else {
                                a.order = a.position.order;
                            }
                            if (!b.position || !b.position.order) {
                                b.order = 0;
                            } else {
                                b.order = b.position.order;
                            }
                            return a.order - b.order;
                        });
                    }
                }

                var newpos = [];
                var processNewPos = function (id) {
                    if (_.find(newpos, function (n) {
                        return n === id;
                    }) === undefined) {
                        newpos.push(id);
                    }
                };
                for (var i = 0, x = pos ? pos.length : 0; i < x; i++) {
                    processNewPos(pos[i].id);
                }

                departments[k] = {
                    type: 'position', id: dep.depId, name: dep.name, pos: newpos
                    //, oldpos:pos
                };
                k++;
            });

            //unassigned department
            if (unassigned.length > 0) {
                departments.push({type: 'position', id: -1, name: 'Miscellaneous', pos: unassigned});
            }

            var result = {
                deps: departments,
                items: castList,
                count: cast.length
            };

            if (withPositions) {
                result.pos = positions;
            }

            return done(null, result);
        } else {
            var pos = newresult['d_' + 0];
            for (var i = 0, l = pos.length; i < l; i++) {
                pos[i] = pos[i].id;
            }
            return done(null, {
                deps: [{type: 'position', id: 0, name: 'Custom', pos: pos}],
                items: castList,
                count: pos.length
            });
        }
    }

    //todo : remove if not necessary anymore
    function onprocess(err, q) {
        qs.q = q;

        function onQuery(err, result) {
            if (err) {
                console.log(err);
            }

            var cast = result && result.docs && result.docs.length > 0 ? getProcessedCast(result.docs) : null,
                isprocess = cast && cast.length > 0 && (roles === 2 || roles === 'CrewAndUnassigned');

            if (!isprocess ) {
                return onsuccess(null,cast);
            }

            sortCrew(data, cast, contactListId, depId, onsuccess);

            function onsuccess(err, newcast) {
                result.docs = newcast;
                return next(null, result);
            }

            function getProcessedCast(items) {
                if(items && items.length>0){
                    return items.map(function(itemx) {
                        var item = itemx._doc ? itemx._doc : itemx ;
                        //adjust new dep info for backward compatibiliuty
                        var r = item.roles, rl = r && r.length > 0 ? r.length : 0;
                        if (rl) {
                            for (var i = 0; i < rl; i++) {
                                var el = r[i];
                                if (el.type === 2) {
                                    if (el.newDepId) {
                                        item.roles[i].depId = el.newDepId;
                                    }
                                    delete item.roles[i].newDepId;
                                    if (el.newPosId) {
                                        item.roles[i].posId = el.newPosId;
                                    }
                                    delete item.roles[i].newPosId;
                                }
                            }
                        }
                        var cl = item.contactLists;
                        if(cl) {
                            for (var clId in cl) {
                                var r = cl[clId] ? cl[clId].roles : null, rl = r && r.length > 0 ? r.length : 0;
                                if (rl) {
                                    for (var i = 0; i < rl; i++) {
                                        var el = r[i];
                                        if (el.type === 2) {
                                            //get new or old
                                            var dId = el.depId, pId = el.posId;
                                            if (el.newDepId) {
                                                dId = el.newDepId;
                                                item.contactLists[clId].roles[i].depId = dId;
                                            }
                                            delete item.contactLists[clId].roles[i].newDepId;
                                            if (el.newPosId) {
                                                pId = el.newPosId;
                                                item.contactLists[clId].roles[i].posId = pId;
                                            }
                                            delete item.contactLists[clId].roles[i].newPosId;
                                        }
                                    }
                                }
                            }
                        }

                        return item;
                    });
                }
                return null;
            }
        }
    }
}

