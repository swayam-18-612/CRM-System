ProductEditPopupCtrl.$inject = ['GeneralItemEditCtrlService', 'CustomizeOverviewBlocksCtrlService', '$element'];
function ProductEditPopupCtrl(GeneralItemEditCtrlService, CustomizeOverviewBlocksCtrlService, $element) {
    var $ctrl = this;

    $ctrl.isPopup = true;

    $ctrl.disabledText = '$ctrl.isUpdating===true||$ctrl.isBtnDisabled()';

    $ctrl.btnToggleCls = 'drpProjectFeatures';
    $ctrl.btnToggleText = 'Project Features (Recommended)';

    $ctrl.changeProductType = changeProductType;

    $ctrl.isGroup = isGroup;
    $ctrl.changeGroup = changeGroup;

    $ctrl.getItemPopupTemplate = getItemPopupTemplate;
    $ctrl.postInitGeneral = postInitGeneral;
    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl.preSetTemplateData = preSetTemplateData;
    $ctrl.saveNonNg = saveNonNg;
    $ctrl.isChecked = isChecked;
    $ctrl.toggleImportScript = toggleImportScript;

    //$ctrl.columnsList = $ctrl.getScheduleColumns([]);

    $ctrl.toggleFeatures = toggleFeatures;
    $ctrl.changeProductTypeId = changeProductTypeId;
    $ctrl.msFormOnNext = msFormOnNext;
    $ctrl.setWithImport = setWithImport;

