angular.module('user.team.routing', [
    'user.teamPage.component'
])
.config(TeamRouting);

TeamRouting.$inject = ['$uiRouterProvider', 'TeamCompOptions'];

function TeamRouting($uiRouter, compOptions) {
    var overviewBlockType = compOptions.overviewBlockType,
        listField = compOptions.listField,
        defaultListFieldValue = compOptions.defaultListFieldValue || 'All',
        params = {};

    if(listField) {
        params[listField] = {
            value: defaultListFieldValue,
            dynamic: true
        };
    }

    var stateInfo = _.extend({
        url: '/' + overviewBlockType + (listField ? ('/:' + listField) : '')+'?addSeats',
        data: {
            minRole: 2,
            minMemberType: 1,// only admins
            bodyClass: 'team',
            withPrint: true,
            hasTree: true,
            title: 'Users',
            overviewBlockType: overviewBlockType,
        }
    }, params ? {params: params} : null);

    addStates($uiRouter, [
        _.extend({}, stateInfo, {
            name: 'user.' + overviewBlockType,
            views: {
                loggedview: 'teamPage'
            },
        }),
        _.extend({}, stateInfo, {
            name: 'user.product.' + overviewBlockType,
            views: {
                bodyWrapper: 'productTeamPage'
            }
        })
    ]);
}


