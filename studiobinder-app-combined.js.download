}

angular.module('product.workflow.page.init.controller.service', [
    'product.workflow.block.controller.service',
    'product.workflow.group.popup.component',
    'product.workflow.sidebar.component',
    'product.workflow.tree.remove.popup.component'
])
.service('WorkflowPageInitCtrlService', WorkflowPageInitCtrlService);
WorkflowPageInitCtrlService.$inject = ['WorkflowBlockCtrlService', 'TopNavCalendarService', 'CPS'];
function WorkflowPageInitCtrlService(WorkflowBlockCtrlService, TopNavCalendarService, CPS) {
    return function ($ctrl, $element, constantsService) {
        $ctrl.CPS = CPS;
        $ctrl.topNavApi = TopNavCalendarService;

        $ctrl.$element = $element;
        $ctrl.element = $ctrl.$element[0];

        if(!$ctrl.treeTag) {
            $ctrl.treeTag = 'workflow';
        }

        //$ctrl.hasLists = hasLists;

        if(!$ctrl.onAddItemBtn) {
            $ctrl.onAddItemBtn = onAddItemBtn;
        }

        if(!$ctrl.getPageContent) {
            $ctrl.getPageContent = getPageContent;
        }
        if (!$ctrl.$onInit) {
            $ctrl.$onInit = onInit;
        }

        $ctrl.clearTaskFilters = clearTaskFilters;

        return $ctrl;

        function onInit() {
            if (typeof ($ctrl.onPreInit) === 'function') {
                $ctrl.onPreInit();
            }
            if (!$ctrl.getFiltered) {
                $ctrl.getFiltered = getFiltered;
            }

            if (!$ctrl.getTopFilters) {
                $ctrl.getTopFilters = getTopFilters;
            }

            if (!$ctrl.getListNavComments) {
                $ctrl.getListNavComments = getListNavComments;
            }

            if (!$ctrl.getPageTemplate) {
                $ctrl.getPageTemplate = getPageTemplate;
            }

            if(!$ctrl.productId){
                $ctrl.productId = $ctrl.CPS.productId;
            }

            if($ctrl.withoutEmptyStateOnTree !== undefined){
                constantsService.CompOptions.withoutEmptyStateOnTree = $ctrl.withoutEmptyStateOnTree;
            }
            $ctrl = new WorkflowBlockCtrlService($ctrl, constantsService, {
                isCurrentPage: true,
                tasksFilter: 2,
                tabTasks: 'tasks',
                isWorkflowTree: true
            });

            if (typeof ($ctrl.onPostInit) === 'function') {
                $ctrl.onPostInit();
            }

            $ctrl.loadPageGroup();
        }

        function onAddItemBtn(e) {
            console.log('onAddItemBtn');
            $ctrl.preventDefault(e);
            $ctrl.broadcastRoot('ADD_COLUMN_' + $ctrl.elemType, {e: e});
        }

        function getFiltered(newVal, oldVal) {
            console.log('startSearch: ' + newVal);
        }

        function getPageTemplate() {
            if (!$ctrl.allInfoLoaded) {
                return '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
            }

            return $ctrl.getInitTopFilters() +
                //consider only $ctrl.selectedFilter lists
                $ctrl.getPageContent() +
                $ctrl.getEmptyStateBlock(null, ($ctrl.withActiveTree ? 'true' : ''));


        }

        function getPageContent(withEmptyState) {

            var hasLists = $ctrl.withoutEmptyStateOnTree ? 'true' : ('$ctrl.hasLists(' + ($ctrl.withActiveTree ? 'true' : '') + ')');
        return '<div class="with-filters with-fancy-scrollbar h-full" ng-class="{\'dark-mode\': $ctrl.isDarkMode}"' +
                    ($ctrl.withoutEmptyStateOnTree ? '' : (' ng-show="' + hasLists + '" ')) +
                '>' +
                    '<div class="fancy-scrollbar scrollable-content h-full first-scrolling-wrapper">' +
                        $ctrl.getSidebar('clearfix display-block h-full') +
                    '</div>' +
                '</div>' +
                (withEmptyState && !$ctrl.withoutEmptyStateOnTree ? $ctrl.getEmptyStateBlock(null, ($ctrl.withActiveTree ? 'true' : '')) : '');
        }

        function getTopFilters() {
            //$ctrl.getDrpSelectedFilters('tabTasks') +
            //$ctrl.getDrpSelectedFilters('tasksFilter', null, {cls: $ctrl.tabTasks === 'comments' ?'': 'sb-hide'}) +
            return '<div class="pull-left title with-margin-right h-full">' + $ctrl.title + '</div>' +
                //$ctrl.getTopFiltersTitle() +
                //($ctrl.tabTasks === 'comments' ? '' : $ctrl.getDrpSelectedFilters()) + //active vs archived
                    '<div class="pull-right">' +
                        '<button class="btn btn-small filtersx white '+$ctrl.getBtnActionCls()+'" ng-show="$ctrl.topNavApi.hasTaskFilters()" data-type="clearTaskFilters"><div class="sbf filter pull-left"></div> Filtering is on <div class="sbf cancel pull-right"></div></button>' +
                        $ctrl.getListNavComments() +
                    '</div>';
        }

        function clearTaskFilters(){
            if($ctrl.topNavApi) {
                $ctrl.topNavApi.clearTaskFilters();
            }
        }

        function getListNavComments() {
            var isPage = true;
            return getBtn('filters', isPage) +
                ($ctrl.CPS.productId ? (
                    ($ctrl.CPS.isAuthenticated ? getBtn('archived', isPage) : '')
                    //getBtn('comments', isPage) ////add calendar comments if on calendar page
                ) : '');

            function getBtn(type, isPage) {
                return '<comments-button type="' + type + '" btn-cls="btn btn-small primary-faded without-text with-margin-left pull-right" page="' + isPage + '"></comments-button>';
            }
        }
    }
}

angular.module('product.workflow.group.popup.component', [
    'item.edit.controller.service'
])
.component('todoColumnEditPopup', popupComponentParams('TodoColumnEditPopupCtrl'))
.controller('TodoColumnEditPopupCtrl', TodoColumnEditPopupCtrl);
TodoColumnEditPopupCtrl.$inject = ['GeneralItemEditCtrlService', '$element'];
function TodoColumnEditPopupCtrl(GeneralItemEditCtrlService, $element) {
    console.log('TodoColumnEditPopupCtrl');
    var $ctrl = this;
    
    $ctrl.isPopup = true;

    $ctrl.getPopupFormOther = getPopupFormOther;
    $ctrl.onSaveAfter = onSaveAfter;
    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl.selectColor = selectColor;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneral() {
        $ctrl.icon = 'workflow';
        $ctrl = _.extend($ctrl, $ctrl.extraParam);
    }

    function getPopupFormOther(){
        return '<label class="header thin clearfix margin-top-30">Select Color</label>'+
            getColorsFormOther();
    }

    function getColorsFormOther() {
        var el = '';
        //'<label class="header thin clearfix margin-top-30">Board Color</label>' +
        _.each($ctrl.colors, get);
        return '<div class="custom-wrapper colors-wrapper circled larger margin-top-10">' + el + '</div>';

        function get(c) {
            el += '<div class="custom-checkbox inrow ' + $ctrl.pageClass + '">' +
                '<div class="' + $ctrl.getBtnActionCls() + ' customitem" style="background-color:' + c + '" data-type="selectColor" data-info="' + c + '"><label><input type="checkbox"' + (isSelectedColor(c) ? ' checked="checked"' : '') + '><span></span><span></span></label></div>' +
                '</div>';
        }
    }
    function isSelectedColor(c) {
        return $ctrl.item.color === c;
    }

    function selectColor(c) {
        $ctrl.prevColor = $ctrl.item.color;
        if (!$ctrl.prevColor || $ctrl.prevColor && $ctrl.prevColor !== c) {
            $ctrl.item.color = c;
            set($ctrl.prevColor, false);
            set(c, true);
        }

        function set(id, isChecked) {
            if (!id) {
                return;
            }
            var check = $ctrl.element.querySelector('.custom-wrapper.colors-wrapper .customitem[data-info="' + id + '"] input');
            if (isChecked) {
                check.setAttribute('checked', 'checked');
            } else {
                check.removeAttribute('checked');
            }
        }
    }

    function onSaveAfter(){
        console.log('onSaveAfter');
        $ctrl.SBStateService.reloadPage();
    }
}

angular.module('product.workflow.item.edit.popup.component',[
    'item.grid.edit.group.templatePopup.controller.service',
    'item.edit.controller.service',
    'product.workflow.item.grid.component',
    'services.todoColumnsConfigsService',
    'services.blocksSetup',
    'item.field.edit.controller.service',
    'templateCompilePopup.controller.service',
    'product.workflow.item.init.controller.service'
])
.component('updateTaskCardPopup', popupComponentParams('UpdateTaskCardPopupCtrl'))
.controller('UpdateTaskCardPopupCtrl', UpdateTaskCardPopupCtrl);
UpdateTaskCardPopupCtrl.$inject = ['RouteCollaboratorsService', 'ItemTemplateCompileCtrlService', 'WorkflowConstantsService', 'FiltersService', 'TodoCardGridItemInitCtrlService', 'TodoColumnsConfigsService', 'ItemFieldEditCtrlService', '$element'];
function UpdateTaskCardPopupCtrl (RouteCollaboratorsService, ItemTemplateCompileCtrlService, WorkflowConstantsService, FiltersService, TodoCardGridItemInitCtrlService, TodoColumnsConfigsService, ItemFieldEditCtrlService, $element) {

    var $ctrl = this;

    $ctrl.FiltersService = FiltersService;
    $ctrl.RouteCollaboratorsService = RouteCollaboratorsService;
    $ctrl.BlocksSetupService = $ctrl.RouteCollaboratorsService.BlocksSetupService;

    $ctrl.WorkflowConstantsService = WorkflowConstantsService;
    $ctrl.TodoCardGridItemInitCtrlService = TodoCardGridItemInitCtrlService;
    $ctrl.TodoColumnsConfigsService = TodoColumnsConfigsService;

    $ctrl.isPopup = true;

    $ctrl.dontAutoloadTemplate = true;
    $ctrl.editableItemProps = ['name', 'description', 'todoColumnId', 'stats', 'teamIds', 'color', 'icon', 'startDate', 'dueDate'];

    $ctrl.setExtraProps = setExtraProps;
    $ctrl.onChange = function(){};
    $ctrl.onSave1 = onSave1;

    $ctrl.setTemplateData = setTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.preInit = preInit;
    $ctrl.onPreloadCompileTemplate = onPreloadCompileTemplate;
    $ctrl.getColumnByProp = getColumnByProp;
    $ctrl.setEditableField = setEditableField;
    $ctrl.close = close;
    $ctrl.closeEditableField = closeEditableField;
    $ctrl.onActions = onActions;
    $ctrl.showExtendedViewDescription = showExtendedViewDescription;
    $ctrl.saveDescription = saveDescription;
    $ctrl.cancelSaveDescription = cancelSaveDescription;

    $ctrl = new ItemTemplateCompileCtrlService($ctrl, $element, $ctrl.isPopup);

    function showExtendedViewDescription() {
        console.log('showExtendedViewDescription');
        $ctrl.broadcastRoot('TOGGLE_TASKCARD_EXTENDED_DESC_' + $ctrl.item._id);
    }

    function saveDescription() {
        console.log('saveDescription');
        $ctrl.broadcastRoot('SB_EDITOR_FIELD_SAVE');
    }
    function cancelSaveDescription() {
        console.log('cancelSaveDescription');
        $ctrl.broadcastRoot('SB_EDITOR_FIELD_CANCEL');
    }
    function setTemplateData() {
        $ctrl.withCloseBtn = true;
        $ctrl.modalBodyClass = 'todocardpopup without-padding-xs '+ ($ctrl.isDarkMode ? 'dark-mode' : '');
        $ctrl.modalBodyFormClass = 'with-row-schedules';
    }

    function preInit() {
        $ctrl.rowLoadNow = true;
        $ctrl.isInModal = true;
        //for taskboards set todoPageId to workflow page to allow for backwards compatibility
        var todoPage = $ctrl.extraParam && $ctrl.extraParam.todoPage ? $ctrl.extraParam.todoPage :
                ($ctrl.isTaskBoards ? $ctrl.BlocksSetupService.getTodoPageByName('.workflow') : $ctrl.BlocksSetupService.getCurrentTodoPage()),
            pageName = todoPage ? todoPage.name : null;

        $ctrl.isCalendarPage = pageName === 'user.product.calendar' || pageName === 'user.calendar';
        $ctrl.isWorkflow = pageName === 'user.product.workflow';

        $ctrl.compOptionsExtended = {
            isInModal: true,
            tasksFilter: 0,
            elemType: 'TASKCARD',
            currentListId: null,
            isWorkflow: $ctrl.isWorkflow,
            isCalendarPage: $ctrl.isCalendarPage,
            isTaskBoards: $ctrl.isTaskBoards,
            isScriptPage: $ctrl.isScriptPage
        };

        if($ctrl.item && !$ctrl.item.active){
            $ctrl.canEdit = false;
        }

        $ctrl.getGridItemTemplate = getGridItemTemplate;

        if (!$ctrl.extraParam) {
            $ctrl.extraParam = {};
        }
        if (!$ctrl.service && $ctrl.extraParam.service) {
            $ctrl.service = $ctrl.extraParam.service;
        }

        if($ctrl.extraParam.uIdList){
            $ctrl.uIdList = $ctrl.extraParam.uIdList;
        }

        $ctrl.onGridItemActions = $ctrl.extraParam.onGridItemActions;

        $ctrl.preLoadingTableName = 'TodoCards';
        $ctrl.preLoadingService = $ctrl.extraParam.preLoadingService;

        $ctrl.filtersService = $ctrl.extraParam.filtersService ? $ctrl.extraParam.filtersService : new $ctrl.FiltersService($ctrl.WorkflowConstantsService);

        $ctrl.Colors = $ctrl.SBFieldMethods.Colors;

        //$ctrl.CPS.productId
        if($ctrl.extraParam.Settings){
            $ctrl.Settings = $ctrl.extraParam.Settings;
        }

        if(!$ctrl.Settings) {
            $ctrl.Settings = _.extend({}, $ctrl.filtersService.Settings, $ctrl.TodoCardGridItemInitCtrlService.getExtendedSettingsParams($ctrl));
        }

        if($ctrl.extraParam.otherSettings){ // my tasks
            $ctrl.Settings = _.extend({}, $ctrl.Settings, $ctrl.extraParam.otherSettings);
        }

        $ctrl.currentListId = $ctrl.extraParam.currentListId!==undefined ? $ctrl.extraParam.currentListId :  $ctrl.item[$ctrl.listField];
    }

    //at the end of $onInit for TemplateCompileCompCtrlService
    function onPreloadCompileTemplate() {
        if ($ctrl.Settings.todoColumns) {
            return onFinish();
        }

        $ctrl.reloadTemplate(); //is loaded = false;
        $ctrl.TodoColumnsConfigsService.getTodoColumnsForProductAsync($ctrl.CPS.companyId, $ctrl.item.productId, function (todoColumns) {
            $ctrl.Settings.todoColumns = todoColumns;
            onFinish();
        });

        function onFinish() {
            $ctrl.isLoaded = true;
            $ctrl.Settings.Columns = _.extend({}, $ctrl.TodoCardGridItemInitCtrlService.getColumns($ctrl, $ctrl.Settings.Columns, $ctrl.getColumnDate));

            $ctrl.columnsList = $ctrl.Settings.Columns;
            $ctrl.reloadTemplate();//is loaded  = true
        }
    }

    function setExtraProps() {
        return {
            elemType: $ctrl.elemType,
        }
    }

    function getPopupBodyContent() {
        if(!$ctrl.isLoaded){return '<preloader-center class="clearfix display-block preloader"></preloader-center>';}
        return '<taskcard-item-grid ' +
                ($ctrl.extraParam && $ctrl.extraParam.maxAddedCount ? 'max-added-count="::$ctrl.extraParam.maxAddedCount" ' : '') +
                'class="full-with taskcard-item-grid" ' +
                'style="border:none" ' +
                'can-edit="::'+$ctrl.canEdit+'" ' +
                'with-sortable="::false" ' +
                'selected-filter="::'+$ctrl.item.active+'" ' +

                'comp-options="::$ctrl.compOptions" ' +
                'service="::$ctrl.service" ' +
                'img-observer-service="::null" ' +
                'row-observer-service="::null" ' +
                'pre-loading-service="::$ctrl.preLoadingService" '  +

                'list-settings="::$ctrl.Settings" ' +
                'columns-list="::$ctrl.columnsList" ' +

                'item="::$ctrl.item" ' +

                'on-actions="$ctrl.onActions(result)" ' +
                'on-get-template="$ctrl.getGridItemTemplate(item)" ' +
                ($ctrl.onImageLoaded ? 'on-image-loaded="$ctrl.onImageLoaded(result)" ' : '')+

                'on-save="$ctrl.onSave1(result)" ' +

                'current-list-id="' + $ctrl.currentListId +'" ' +

                'is-grid-view="::false" ' +
                'is-mobile-layout="::false" ' +
                //'current-list-id="5a2210dad0755ff07ababe5a" ' +
                'data-id="'+$ctrl.item._id+'" ' +
                'is-in-modal="::true" ' +
                'row-load-now="::$ctrl.rowLoadNow"'+
                'on-close="$ctrl.close(result)" '+
                '></taskcard-item-grid>';
    }

    function onActions(result) {
        //console.log('onActions');
        if (result.type === 'setEditableField' || result.type === 'closeEditableField') {
            if(result.item) {
                $ctrl[result.type](result.item);
            }
        } else if (typeof ($ctrl.onGridItemActions) === 'function') {
            $ctrl.onGridItemActions({result: result});
        }
    }

    function setEditableField(data){
        //console.log('setEditableField');
        closeField($ctrl.editableField, 'set');
        $ctrl.editableField = data;
        //console.log('current editableField = '+$ctrl.editableField.id+', ' + $ctrl.editableField.prop);
    }

    function closeEditableField(data){
        //console.log('closeEditableField');
        if( data && $ctrl.editableField &&
            data.id === $ctrl.editableField.id &&
            data.prop === $ctrl.editableField.prop){
            $ctrl.editableField = null;
        }
        if($ctrl.triggerClose){
            //needs time to display in the grid
            $ctrl.LCS.timeout(function (){
                $ctrl.onClose();
            }, 1200);
        }
    }

    function closeField(field, type){
        if(field) {
            //console.log('closing editableField = '+field.id+', ' + field.prop);
            $ctrl.broadcastRoot('CLOSE_ROW_EDITABLE_FIELD_' + field.id, field.prop);
        }
    }

    function onSave1(result) {
        //console.log('onSave1');
        if(result.custom){

        }
    }

    function getGridItemTemplate(item) {
        console.log('updateTaskCardPopup.getGridItemTemplate');
        return $ctrl.TodoCardGridItemInitCtrlService.getGridItemTemplate(item, $ctrl);
    }

    function getColumnByProp(prop, searchAllColumns) {
        return _.find($ctrl.columnsList, function(c){return c.prop === prop});
    }

    function close(result) {
        $ctrl.isInModal = false;
        if ($ctrl.onClose) {
            if($ctrl.editableField) {
                $ctrl.triggerClose = true;
            } else{
                $ctrl.onClose();
            }
        }
    }
}

angular.module('product.workflow.tasksReorder.popup', [
    'ctrl.PopupsCtrl.generalItemEdit.service',
    'sb.sortable.service'
])
    .component('tasksReorderPopup', popupComponentParams('TasksReorderPopupCtrl'))
    .controller('TasksReorderPopupCtrl', TasksReorderPopupCtrl);
TasksReorderPopupCtrl.$inject = ['GeneralItemEditCtrlService', 'TasksService', 'SortInitService', 'SBSortableService', '$element'];
function TasksReorderPopupCtrl(GeneralItemEditCtrlService, service, SortInitService, SBSortableService, $element) {
    var $ctrl = this;

    $ctrl.SBSortableService = SBSortableService;

    $ctrl.isPopup = true;
    $ctrl.withCloseBtn = true;

    $ctrl.preInitGeneral = preInitGeneral;
    $ctrl.preSetTemplateData = preSetTemplateData;
    $ctrl.getPopupBodyContent = getPopupBodyContent;
    $ctrl.onLoaded = onLoaded;
    $ctrl.onDestroy = onDestroy;

    $ctrl = new GeneralItemEditCtrlService($ctrl, $element, $ctrl.isPopup);

    function preInitGeneral() {
        $ctrl.service = service;
        $ctrl.elemType = 'TASK';
        $ctrl.objectType = 'task';
        $ctrl.setups = $ctrl.extraParam.setups;

        $ctrl.sortableContainmentCls = 'sortableContainmentLayout';
        $ctrl.sortableGrid = 'tasksreorder' + $ctrl.optionsProp;
        $ctrl.firstBtnMethod = 'updateOrder';

        $ctrl.updateOrder = updateOrder;
        $ctrl = new SortInitService($ctrl);
    }

    function preSetTemplateData() {
        $ctrl.popupTitle =  $ctrl.extraParam.popupTitle ? $ctrl.extraParam.popupTitle : 'Reorder Checklists';
        $ctrl.btnText = '<span>Apply </span><span class="hide-ipad"> Changes</span>';
        $ctrl.icon = 'transition rotate';
        $ctrl.iconLevel = 5;
    }


    function getPopupBodyContent() {
        var items = $ctrl.setups.map(function (item){
      return  '<li data-id="' + item._id + '" class="dd-item as-sortable-item active">' +
                    '<div class="row-schedule without-hover full-width">'   +
                        '<div class="as-sortable-item-handle col25 centered text-center hide-print">' + $ctrl.LCS.getISBDiv('dd3-handle', 0, 'centered gray') + '</div>' +
                       '<div class="info centered grow-column"><span class="itemTitle">' + item.name + '</span></div>' +
                    '</div>' +
                '</li>';
            }).join('');

        return '<div id="' + $ctrl.sortableGrid + '" class="tree-node" current-list-id="null" data-id="null">' +
                    '<div class="dd full-width callsheetLayout '+ $ctrl.sortableContainmentCls + '" data-currentlistid="null">' +
                        '<ul class="flex-wrap">' + items + '</ul>' +
                    '</div>' +
                '</div>';
    }

    function onLoaded(){
        initSortableService();
    }

    function initSortableService(){
        var sortableContainmentCls = $ctrl.sortableContainmentCls ? ('.' + $ctrl.sortableContainmentCls) : ($ctrl.sortableGrid ? ('#' + $ctrl.sortableGrid) : '');

        $ctrl.sortableService = new $ctrl.SBSortableService($ctrl.element, {
            currentListId: $ctrl.currentListId,
            elemType: $ctrl.elemType,

            sortableContainerCls: $ctrl.sortableContainerCls,
            sortableContainmentCls: sortableContainmentCls,
            containerPositioning: 'relative',//optional param.
            scrollableParentCls: $ctrl.scrollableParentCls ? $ctrl.scrollableParentCls : sortableContainmentCls,
        }, {isDragula: true});

        $ctrl.sortableService.addContainer($ctrl.element, {
            sortableGrid: $ctrl.sortableGrid
        });
    }

    function updateOrder(e) {
        $ctrl.preventDefault(e);
        console.log('TasksReorderPopupCtrl.updateOrder');
        var setups = [];
        var els = $ctrl.element.querySelectorAll('li');
        _.each(els, function (el, i){
            setups.push({_id: el.getAttribute('data-id'), order: i + 1});
        });
        $ctrl.onClose({result: _.sortBy(setups, 'order')});
    }

    function onDestroy() {
        if($ctrl.sortableService){
            $ctrl.sortableService.destroy();
        }
    }
}

angular.module('product.workflow.tree.remove.popup.component', [
