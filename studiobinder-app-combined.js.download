angular.module('product.breakdowns.assignElementsPopup.controller.service', [
    'sb.fields.popovers.assignElements.init.controller.service.component'
])
.service('AssignElementsPopupCtrlService', AssignElementsPopupCtrlService);
AssignElementsPopupCtrlService.$inject = ['AssignStripInitCtrlService', 'ListItemPopupTemplateCtrlService'];
function AssignElementsPopupCtrlService(AssignStripInitCtrlService, ListItemPopupTemplateCtrlService) {
    return function($ctrl, $element){
        $ctrl.hasCustomTemplate = true;
        $ctrl.drpMenuCls = 'multiple-locations-menu';

        if($ctrl.initPopupElements) {
            $ctrl.initPopupElements();
        }else{
            console.log('Parent for AssignElementsPopupCtrlService must define method initPopupElements');
        }

        $ctrl.getPopupBodyContent = getPopupBodyContent;
        $ctrl.preInitOther = preInitOther;
        $ctrl.onApplyChanges = onApplyChanges;

        $ctrl = new AssignStripInitCtrlService($ctrl);
        $ctrl = new ListItemPopupTemplateCtrlService($ctrl, $element);

        return $ctrl;

        function preInitOther() {
         //   $ctrl.service = service;
            if (!$ctrl.extraParam) {
                $ctrl.extraParam = {};
            }

            $ctrl.stripIds = $ctrl.extraParam.selected;
            $ctrl.scriptLoadingService = $ctrl.extraParam.scriptLoadingService;
            $ctrl.initList = $ctrl.extraParam.initList;
            $ctrl.list = angular.copy($ctrl.initList);
            $ctrl.value = null;
        }

        function getPopupBodyContent() {
            return "<" + $ctrl.menuTag + " " +
                "class='display-block clearfix " + $ctrl.drpMenuCls + "' " +
                "id='" + ($ctrl.drpMenuId ? $ctrl.drpMenuId : '') + "' " +
                "elemtype='" + $ctrl.elemtype + "' " +
                ($ctrl.pageClass ? ("page-class='" + $ctrl.pageClass + "' ") : '')+
                "strip-ids='::$ctrl.stripIds' " +

                "script-loading-service='::$ctrl.scriptLoadingService' " +

                "list='::$ctrl.list' " +
                "value='::$ctrl.value' " +

                "on-select='$ctrl.onSelect(result)' " +
                "on-apply-changes='$ctrl.onApplyChanges(result)' " +
                ($ctrl.isPopup ? 'is-popup="true"' : '') +
                "></" + $ctrl.menuTag + ">";
        }

        function onApplyChanges(result) {
            console.log('onApplyChanges');
            //trigger strip updates for characters update
            if($ctrl.elemtype === 'character'){
                if($ctrl.stripIds.length>0) {
                    result.editchangesList = $ctrl.stripIds.map(function (stripId) {
                        return get(stripId, {characterIds: $ctrl.scriptLoadingService.getStripById(stripId).characterIds});
                    });
                }
            } else {//locations
                var strips = result ? result.withStripChanges : null;
                if(strips) {
                    //result.settings = $ctrl.scriptLoadingService.preloadSettings();
                    var l = [];
                    for (var stripId in strips) {
                        //var strip = $ctrl.scriptLoadingService.getStripById(id, result.settings),
                        //    prop = $ctrl.elemtype + 'Ids';
                        // editchanges[$ctrl.elemtype + 's'] = strip[$ctrl.elemtype + 's'];
                        l.push(get(stripId, strips[stripId]));
                    }
                    result.editchangesList = l;
                }
            }

            if(result.editchangesList){
                delete result.withStripChanges;
                $ctrl.broadcastRoot('UPDATED_' + $ctrl.elemType + '_ITEM', result);
                $ctrl.broadcastRoot('CLEAR_SELECTED_ROWS_' + $ctrl.elemType);
            }

            function get(stripId, other) {
                return _.extend({_id: $ctrl.extraParam.isScheduling ? $ctrl.extraParam.matchings['s_' + stripId] : stripId}, other);
            }

            $ctrl.broadcastRoot('CLEAR_SELECTED_ROWS_' + $ctrl.elemType);
            $ctrl.closePopup();
        }
    }
}


