]);
angular.module('user.team.accept-invite.component', [
    'apiServices.TeamInvitations'
])
.component('teamInvitePage', {
    controller: 'AcceptTeamInviteCtrl',
})
.controller('AcceptTeamInviteCtrl',AcceptTeamInviteCtrl);
AcceptTeamInviteCtrl.$inject = ['TemplateCompileCompCtrlService', 'TeamInvitationsService', '$element'];
function AcceptTeamInviteCtrl(TemplateCompileCompCtrlService, TeamInvitationsService, $element) {
    var $ctrl = this;
    $ctrl.TeamInvitationsService = TeamInvitationsService;

    $ctrl.title = 'Team Invite';

    $ctrl.goToDashboard = goToDashboard;
    $ctrl.acceptInvite = acceptInvite;

    $ctrl.getItemTemplate= getItemTemplate;
    $ctrl.preInit = preInit;

    $ctrl.dontAutoloadTemplate = true;

    $ctrl = new TemplateCompileCompCtrlService($ctrl, $element);

    function preInit() {
        console.log('AcceptTeamInviteCtrl');
        var stateParams = $ctrl.SBStateService.getCurrentStateParams(),
        val= stateParams.invitationId;
        if(!val){
            process();
        }else{
            $ctrl.reloadTemplate();
        }

        $ctrl.TeamInvitationsService.getById(val, null, function (invitation) {
            $ctrl.invitation = invitation;
            process();
        }, function (error) {
            process();
        });
        function process() {
            $ctrl.isLoaded = true;
            if ($ctrl.invitation) {
                $ctrl.company = $ctrl.invitation.company;
                $ctrl.createdBy = $ctrl.invitation.createdBy;

                if (!$ctrl.CPS.isAuthenticated) {
                    $ctrl.titles = {
                        t1: "Sign Up or Login <br/>to accept the invite.",
                        t2: "Sign Up or Login <br/>to accept the invite.",
                        showLogo: false,
                        btn1: 'Login & Accept Invite',
                        btn2: 'Sign Up & Accept Invite',
                        logo: 'company'
                    };
                    $ctrl.user = {
                        name: $ctrl.invitation.name,
                        email: $ctrl.invitation.email
                    };

                    $ctrl.modalType = 2;

                    /* $ctrl.CPS.SessionService.onUpdateTeam($ctrl.watchers, function (){
                         $ctrl.acceptInvite(null);
                     });*/
                }
            }
            $ctrl.reloadTemplate();
        }
    }

    function getItemTemplate() {
        if (!$ctrl.isLoaded) {
            return '<preloader-center class="preloader ' + ($ctrl.pageClass || '') + '"></preloader-center>';
        }

return '<div class="with-fancy-scrollbar h-full show-scrollbar-on-hover ng-scope">' +
            '<div class="fancy-scrollbar vertical visible-scroll scrollable-content h-full first-scrolling-wrapper flex-block">' +
                '<div class="tabbable spacing-bottom auth-cast margin-top-half">' +
                    '<div class="form-wrapper long modal-content centered" ' +
        'style="margin-top: '+($ctrl.CPS.isAuthenticated?'0':'60px')+';margin-bottom:'+($ctrl.CPS.isAuthenticated.isAuthenticated?'0':'40px')+'">' +
                        '<div>' +
                       ($ctrl.invitation? ($ctrl.invitation.status === 2 ? getAccepted() : getValid()) : getInvalid()) +
                        '</div>' +
                    '<div>' +
                '</div>' +
            '</div>' +
        '</div>';

         function getInvalid() {
return '<h3 class="text-center spacing-half">This Team Invitation is <br/> Invalid or No Longer Available</h3>';
         }

         function getAccepted() {
        return getLogo() +
                '<h3 class="text-center spacing-half">Invitation Accepted</h3>' +
                '<div class="form-group clearfix text-center spacing-bottom">' +
                    '<a class="' + $ctrl.getBtnActionCls() + ' btn btn-primary" data-type="goToDashboard" analytics-on analytics-action="Go to Account">Go to Dashboard</a>' +
                '</div>';
         }

         function getValid() {
             return ($ctrl.CPS.isAuthenticated ? getLogo(): '') +
                 '<div class="spacing-half centering" style="padding-left:30px;padding-right:30px">' +
                    '<div class="form-wrapper small table-div full-width" >' +
                        '<div class="centered col50">' + $ctrl.security.getUserImageComponent('$ctrl.createdBy', 'small') + '</div>' +
                        '<div class="centered font-size-14" style="line-height: 18px">' +
                            '<span class="semibold">' + $ctrl.createdBy.getFullName() + '</span> invited you to become a teammate of <span class="semibold">' + $ctrl.company.name + '.</span>' +
                        '</div>' +
                    '</div>' +
                '</div>' +

                  (!$ctrl.CPS.isAuthenticated ?
                        ('<div>' +
                            '<div class="spacing-quart-top" style="background-color: #EBEFF2"></div>' +
                            '<auth modal-type="$ctrl.modalType" title="::$ctrl.titles" user="::$ctrl.user"></auth>' +
                        '</div>'):
                        ('<div class="form-wrapper small">' +
                            $ctrl.LCS.getErrorBlock() +
                            '<div class="form-group clearfix text-center spacing-bottom">' +
                                '<button class="' + $ctrl.getBtnActionCls() + ' btn btn-primary full-width" ng-class="{\'disabled\': $ctrl.isUpdating}" ng-disabled="$ctrl.isUpdating===true" type="submit" data-type="acceptInvite" analytics-on analytics-action="Accept Invite\'">' +
                                    '<span class="sbf pull-left loadingicon animate-spin" ng-show="$ctrl.isUpdating"></span> Accept Invite' +
                                '</button>' +
                            '</div>' +
                        '</div>')
                  );
         }

        function getLogo() {
        return '<div class="modal-header clearfix">' +
                    '<div><div class="centered circled-svg-colored small76 ' + ($ctrl.pageClass ? $ctrl.pageClass : '') + '">'+
                        $ctrl.LCS.getISBDiv('company', 3) +
                    '</div></div>' +
                '</div>';
        }
    }

    function goToDashboard(team) {
        var params = team ? {
            teamId: team._id,
            companyId: team.companyId
        } : $ctrl.CPS.currentPathParams();
        params.role = $ctrl.CPS.rolePaths.currentUserPath;
        $ctrl.SBStateService.assignUrl($ctrl.CPS.getStateHref('user.dashboard', params), 100);
    }

    function acceptInvite( ) {
        $ctrl.TeamInvitationsService.acceptInvite({
            invitationId: $ctrl.invitation._id
        }, function (result) {
            $ctrl.isUpdating = false;
            $ctrl.i18nNotifications.pushForNextRoute(null, 'team.accepted-invite.success', 'success');
            $ctrl.goToDashboard(result.team);
        }, function (error) {
            $ctrl.isUpdating = false;
            $ctrl.error = $ctrl.localizedMessages.getFromError(error, 'team.accepted-invite.error');
        });
    }
}

angular.module('user.team.accept-invite.routing', [
